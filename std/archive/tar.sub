;; Tar archives, read from whole buffers: POSIX ustar, with pax extended headers for long paths and sizes, and GNU's long
;; names. tar-next! gives each entry in turn: a file with its bytes, a directory, or another kind, with its path.
(require-unqualified host/fs)

(provide tar-reader tar-entry tar-reader-init! tar-next! tar-kind tar-file tar-directory tar-other tar-unpack!)

(enum tar-kind [tar-file 1] tar-directory tar-other)

(struct tar-entry [kind tar-kind] [path string] [bytes (slice u8)])
(struct tar-reader [data (slice u8)] [at u32])

(define (tar-reader-init! [r (ptr tar-reader)] [data (slice u8)])
  (set! (-> r data) data)
  (set! (-> r at) 0))

;; An entry's path is in a or the data, and a file's bytes are in the data.
(define (tar-next! [a (ptr arena)] [r (ptr tar-reader)] [e (ptr tar-entry)] [found (ptr bool)] [err (ptr buffer)])
  -> bool
  (let ([long string] [sized #f] [given-size u64 0])
    (set! (@ found) #f)
    (while #t
      (let* ([data (-> r data)] [at (-> r at)] [left (- (-> data length) at)] [h (slice u8)] [size u64 0] [type u8 0]
             [body (slice u8)] [next u64 0])
        (when (== left 0) (return #t))
        (when (< left 512) (return (bad! err "the archive is cut short")))
        (set! h (slice data at (+ at 512)))
        (when (zeros? h) (return #t))
        (unless (summed? h) (return (bad! err "a header's checksum is wrong")))
        (unless (octal h 124 12 (& size)) (return (bad! err "a header's size is not a number")))
        (when sized (set! size given-size))
        (when (> size (cast u64 (- left 512))) (return (bad! err "an entry runs past the end of the archive")))
        (set! body (slice data (+ at 512) (+ at 512 (cast u32 size))))
        (set! next (+ (cast u64 at) 512 (* (/ (+ size 511) 512) 512)))
        (set! (-> r at) (if (> next (cast u64 (-> data length))) (-> data length) (cast u32 next)))
        (set! type (@ h 156))
        (cond [(== type #\x)
               (unless (pax! a body (& long) (& sized) (& given-size)) (return (bad! err "a pax header is not key=value records")))]
              [(or (== type #\g) (== type #\K)) (begin)]
              [(== type #\L) (set! long (cast string (copy a (until-zero body))))]
              [else
               (set! (-> e kind) (cond [(or (== type #\0) (== type 0) (== type #\7)) tar-file]
                                       [(== type #\5) tar-directory]
                                       [else tar-other]))
               (set! (-> e path) (if (> (-> long length) 0) long (header-path a h)))
               (set! (-> e bytes) (if (== (-> e kind) tar-file) body (slice body 0 0)))
               (set! (@ found) #t)
               (return #t)])))))

(define (tar-unpack! [a (ptr arena)] [data (slice u8)] [dir string] [err (ptr buffer)]) -> bool
  (let ([r tar-reader] [e tar-entry] [found #t] [top ""] [one #t] [why error] [reason (make-buffer)])
    (tar-reader-init! (& r) data)
    (while found
      (unless (tar-next! a (& r) (& e) (& found) (& reason))
        (buffer-add-string! err "not a tar archive: ")
        (buffer-add! err (buffer-bytes (& reason)))
        (buffer-free! (& reason))
        (return #f))
      (when (and found (!= (-> e kind) tar-other))
        (let ([p (cleaned (-> e path))])
          (when (> (-> p length) 0)
            (when (== (-> top length) 0) (set! top (first-part p)))
            (unless (or (and (== p top) (== (-> e kind) tar-directory)) (inside-top? p top)) (set! one #f))))))
    (buffer-free! (& reason))
    (tar-reader-init! (& r) data)
    (set! found #t)
    (while found
      (tar-next! a (& r) (& e) (& found) err)
      (when (and found (!= (-> e kind) tar-other))
        (let ([p (cleaned (-> e path))])
          (when (and one (> (-> top length) 0)) (set! p (if (== p top) "" (slice p (+ (-> top length) 1)))))
          (when (> (-> p length) 0)
            (let ([full (under a dir p)])
              (when (or (and (== (-> e kind) tar-directory) (not (fs-make-dir full (& why))))
                        (and (== (-> e kind) tar-file)
                             (not (and (fs-make-dir (up-to-last-slash full) (& why))
                                       (fs-write-file full (-> e bytes) (& why))))))
                (buffer-add-string! err p)
                (buffer-add-string! err ": ")
                (buffer-add-string! err (error-text (& why)))
                (error-free! (& why))
                (return #f)))))))
    #t))

(define (cleaned [p string]) -> string
  (let ([s p])
    (while (and (>= (-> s length) 2) (== (slice s 0 2) "./")) (set! s (slice s 2)))
    (while (and (> (-> s length) 0) (== (@ s (- (-> s length) 1)) #\/)) (set! s (slice s 0 (- (-> s length) 1))))
    (if (== s ".") "" s)))

(define (first-part [p string]) -> string
  (let ([i u32 0])
    (while (and (< i (-> p length)) (!= (@ p i) #\/)) (+= i 1))
    (slice p 0 i)))

(define (inside-top? [p string] [top string]) -> bool
  (and (> (-> p length) (-> top length)) (== (slice p 0 (-> top length)) top) (== (@ p (-> top length)) #\/)))

(define (under [a (ptr arena)] [dir string] [p string]) -> string
  (let ([out (new a u8 (+ (-> dir length) 1 (-> p length)))])
    (memcpy (-> out items) (-> dir bytes) (-> dir length))
    (set! (@ out (-> dir length)) #\/)
    (memcpy (+ (-> out items) (-> dir length) 1) (-> p bytes) (-> p length))
    (cast string out)))

(define (up-to-last-slash [p string]) -> string
  (let ([i (-> p length)])
    (while (and (> i 0) (!= (@ p (- i 1)) #\/)) (-= i 1))
    (if (<= i 1) "/" (slice p 0 (- i 1)))))

(define (bad! [err (ptr buffer)] [why string]) -> bool
  (buffer-add-string! err why)
  #f)

(define (zeros? [h (slice u8)]) -> bool
  (for ([i u32 0]) (< i (-> h length)) (+= i 1) (when (!= (@ h i) 0) (return #f)))
  #t)

(define (summed? [h (slice u8)]) -> bool
  (let ([want u64 0] [unsigned u64 0] [signed i64 0])
    (unless (octal h 148 8 (& want)) (return #f))
    (for ([i u32 0]) (< i 512) (+= i 1)
      (let ([b (if (and (>= i 148) (< i 156)) (cast u32 32) (cast u32 (@ h i)))])
        (+= unsigned (cast u64 b))
        (+= signed (if (>= b 128) (- (cast i64 b) 256) (cast i64 b)))))
    (or (== want unsigned) (== (cast i64 want) signed))))

(define (octal [h (slice u8)] [at u32] [n u32] [into (ptr u64)]) -> bool
  (let ([v u64 0] [i at] [end (+ at n)])
    (while (and (< i end) (== (@ h i) 32)) (+= i 1))
    (while (and (< i end) (>= (@ h i) #\0) (<= (@ h i) #\7))
      (set! v (+ (* v 8) (cast u64 (- (@ h i) #\0))))
      (+= i 1))
    (when (and (< i end) (!= (@ h i) 0) (!= (@ h i) 32)) (return #f))
    (set! (@ into) v)
    #t))

(define (decimal [s string] [into (ptr u64)]) -> bool
  (let ([v u64 0])
    (when (or (== (-> s length) 0) (> (-> s length) 18)) (return #f))
    (for ([i u32 0]) (< i (-> s length)) (+= i 1)
      (let ([c (@ s i)])
        (unless (and (>= c #\0) (<= c #\9)) (return #f))
        (set! v (+ (* v 10) (cast u64 (- c #\0))))))
    (set! (@ into) v)
    #t))

(define (pax! [a (ptr arena)] [body (slice u8)] [path (ptr string)] [sized (ptr bool)] [size (ptr u64)]) -> bool
  (let ([at u32 0])
    (while (< at (-> body length))
      (let ([n u32 0] [i at] [eq u32 0] [end u32 0])
        (while (and (< i (-> body length)) (>= (@ body i) #\0) (<= (@ body i) #\9) (< n 100000000))
          (set! n (+ (* n 10) (cast u32 (- (@ body i) #\0))))
          (+= i 1))
        (when (or (== i at) (>= i (-> body length)) (!= (@ body i) 32) (< n (+ (- i at) 2)) (> n (- (-> body length) at)))
          (return #f))
        (set! end (+ at n))
        (when (!= (@ body (- end 1)) 10) (return #f))
        (set! eq (+ i 1))
        (while (and (< eq (- end 1)) (!= (@ body eq) #\=)) (+= eq 1))
        (when (>= eq (- end 1)) (return #f))
        (let ([key (cast string (slice body (+ i 1) eq))] [value (cast string (slice body (+ eq 1) (- end 1)))])
          (cond [(== key "path") (set! (@ path) (copy a value))]
                [(== key "size")
                 (unless (decimal value size) (return #f))
                 (set! (@ sized) #t)]))
        (set! at end)))
    #t))

(define (header-path [a (ptr arena)] [h (slice u8)]) -> string
  (let ([name (until-zero (slice h 0 100))] [prefix (until-zero (slice h 345 500))])
    (if (and (== (cast string (slice h 257 263)) "ustar\x00;") (> (-> prefix length) 0))
        (let ([out (new a u8 (+ (-> prefix length) 1 (-> name length)))])
          (memcpy (-> out items) (-> prefix items) (-> prefix length))
          (set! (@ out (-> prefix length)) #\/)
          (memcpy (+ (-> out items) (-> prefix length) 1) (-> name items) (-> name length))
          (cast string out))
        (cast string (copy a name)))))

(define (until-zero [s (slice u8)]) -> (slice u8)
  (let ([i u32 0])
    (while (and (< i (-> s length)) (!= (@ s i) 0)) (+= i 1))
    (slice s 0 i)))
