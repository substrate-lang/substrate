;; Sorting slices. (sort! items (a b) body ...) sorts the slice items in place. body says whether the item a goes before
;; the item b. Equal items keep their order.
(require-unqualified std/meta/generic)

(provide sort!)

(define-generic ((merge-sort! T) [items (slice T)] [before? (closure (T T) -> bool)])
  (let ([n (-> items length)])
    (when (> n 1)
      (let* ([spare (new 0 T n)] [from items] [to spare] [width u32 1])
        (while (< width n)
          (let ([lo u32 0])
            (while (< lo n)
              (let* ([mid (+ lo (if (< width (- n lo)) width (- n lo)))]
                     [hi (+ mid (if (< width (- n mid)) width (- n mid)))]
                     [i lo] [j mid])
                (for ([k u32 lo]) (< k hi) (+= k 1)
                  (if (and (< i mid) (or (== j hi) (not (before? (@ from j) (@ from i)))))
                      (begin (set! (@ to k) (@ from i)) (+= i 1))
                      (begin (set! (@ to k) (@ from j)) (+= j 1))))
                (set! lo hi))))
          (let ([sorted from]) (set! from to) (set! to sorted))
          (set! width (if (< width (- n width)) (* width 2) n)))
        (unless (== (-> from items) (-> items items)) (memcpy (-> items items) (-> from items) (* n (sizeof T))))
        (free (-> spare items))))))

(begin-for-syntax
  (require-unqualified compiler/macros)
  (require-unqualified std/meta/type-info)
  (require-unqualified std/meta/derive)

  (define (sort-form [s datum]) -> datum
    (syntax-match s
      [(_ items ((? identifier? a) (? identifier? b)) body0 body ...)
       #`(let ([the-items #,items]) (sort-items #,s the-items #,a #,b #,body0 #,@body))]
      [_ (raise-syntax-error 'sort! "expected (sort! items (a b) body ...)" s)]))

  (define (sort-items-form [s datum]) -> datum
    (syntax-match s
      [(_ form items a b body ...)
       (let ([t (variable-type items)])
         (unless (and (pair? t) (== (car t) 'slice))
           (raise-syntax-error 'sort! (format-message "expected a slice, not ~s" `(,(type-datum t))) form))
         (let ([u (type-syntax (cadr t))])
           #`((merge-sort! #,u) #,items (lambda ([#,a #,u] [#,b #,u]) -> bool #,@body))))])))

(define-syntax sort! sort-form)
(define-syntax sort-items sort-items-form)
