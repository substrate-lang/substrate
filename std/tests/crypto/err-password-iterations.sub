;; Hashing a password with more iterations than a stored string may hold traps.
(require-unqualified password std/crypto/password)

(define job password-job)

(define (done [j (ptr password-job)]))

(define (main)
  (set! (-> job iterations) 100000001)
  (password-hash! (& job) "x" done))

(test err-password-iterations #:traps "password: more than 100000000 iterations" (main))
