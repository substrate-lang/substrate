;; HMAC-SHA256 on RFC 4231's cases, HKDF on RFC 5869's, PBKDF2 on RFC 7914's, and the comparison.
(require-unqualified tests std/test/test)
(require-unqualified hmac std/crypto/hmac)

(define (show [b (slice u8)])
  (let ([pair (array u8 2)])
    (for ([i u32 0]) (< i (-> b length)) (+= i 1)
      (set! (@ pair 0) (@ "0123456789abcdef" (>> (@ b i) 4)))
      (set! (@ pair 1) (@ "0123456789abcdef" (bit-and (@ b i) 15)))
      (print-bytes pair 2)))
  (printf "\n"))

(define (filled [n u32] [byte u8]) -> (slice u8)
  (let ([p (cast (ptr u8) (malloc n))])
    (memset p byte n)
    (slice p n)))

(define (counting [n u32] [from u32]) -> (slice u8)
  (let ([p (cast (ptr u8) (malloc n))])
    (for ([i u32 0]) (< i n) (+= i 1) (set! (@ p i) (cast u8 (+ from i))))
    (slice p n)))

(define (text [s string]) -> (slice u8) (cast (slice u8) s))

(define (mac [key (slice u8)] [data (slice u8)] [n u32])
  (let ([out (array u8 32)])
    (hmac-of key data (slice out))
    (show (slice out n))))

(define (hkdf [secret (slice u8)] [salt (slice u8)] [info (slice u8)] [n u32])
  (let ([out (cast (ptr u8) (malloc n))])
    (hkdf! secret salt info (slice out n))
    (show (slice out n))))

(define (pbkdf2 [password string] [salt string] [iterations u32])
  (let ([out (array u8 64)])
    (pbkdf2! (text password) (text salt) iterations (slice out))
    (show (slice out))))

(define (main)
  (mac (filled 20 #x0b) (text "Hi There") 32)
  (mac (text "Jefe") (text "what do ya want for nothing?") 32)
  (mac (filled 20 #xaa) (filled 50 #xdd) 32)
  (mac (counting 25 1) (filled 50 #xcd) 32)
  (mac (filled 20 #x0c) (text "Test With Truncation") 16)
  (mac (filled 131 #xaa) (text "Test Using Larger Than Block-Size Key - Hash Key First") 32)
  (mac (filled 131 #xaa) (text (cat-text)) 32)
  (hkdf (filled 22 #x0b) (counting 13 0) (counting 10 #xf0) 42)
  (hkdf (counting 80 0) (counting 80 #x60) (counting 80 #xb0) 82)
  (hkdf (filled 22 #x0b) (text "") (text "") 42)
  (pbkdf2 "passwd" "salt" 1)
  (pbkdf2 "Password" "NaCl" 80000)
  (printf "equal: ~a ~a ~a\n" (hmac-equal? (text "abc") (text "abc")) (hmac-equal? (text "abc") (text "abd"))
          (hmac-equal? (text "abc") (text "ab"))))

(define (cat-text) -> string
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "This is a test using a larger than block-size key and a larger than block-size data. ")
    (buffer-add-string! (& b) "The key needs to be hashed before being used by the HMAC algorithm.")
    (buffer-string (& b))))

(test hmac (expect-output-file "hmac.out" (main)))
