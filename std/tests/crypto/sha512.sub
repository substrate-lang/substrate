;; SHA-512 over the standard vectors, at once and in pieces.
(require-unqualified std/test/test)
(require-unqualified std/crypto/sha512)

(define (show [digest (ptr u8)])
  (let ([pair (array u8 2)])
    (for ([i u32 0]) (< i 64) (+= i 1)
      (set! (@ pair 0) (@ "0123456789abcdef" (>> (@ digest i) 4)))
      (set! (@ pair 1) (@ "0123456789abcdef" (bit-and (@ digest i) 15)))
      (print-bytes pair 2)))
  (printf "\n"))

(define (digest-of [s string])
  (let ([out (array u8 64)])
    (sha512-of (cast (slice u8) s) (slice out))
    (show out)))

(define (main)
  (digest-of "")
  (digest-of "abc")
  (digest-of "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
  (digest-of
   "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu")
  (digest-of "The quick brown fox jumps over the lazy dog")
  (let ([s sha512] [out (array u8 64)] [a (array u8 1000)])
    (memset a 97 1000)
    (sha512-init! (& s))
    (for ([i u32 0]) (< i 1000) (+= i 1) (sha512-add! (& s) (slice a)))
    (sha512-end! (& s) (slice out))
    (show out)
    (sha512-init! (& s))
    (sha512-add! (& s) (cast (slice u8) "The quick brown fox "))
    (sha512-add! (& s) (cast (slice u8) "j"))
    (sha512-add! (& s) (cast (slice u8) "umps over the lazy dog"))
    (sha512-end! (& s) (slice out))
    (show out)
    (sha512-init! (& s))
    (for ([i u32 0]) (< i 1000) (+= i 1)
      (let ([k (% i 97)])
        (sha512-add! (& s) (slice a k))
        (sha512-add! (& s) (slice (slice a) k))))
    (sha512-end! (& s) (slice out))
    (show out)))

(test sha512 (expect-output-file "sha512.out" (main)))
