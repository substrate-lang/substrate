(require-unqualified tests std/test/test)
(require-unqualified build std/test/build)

(define (twice [n i32]) -> i32 (* n 2))

(test expect (expect (< (twice 2) 5)))

(test expect-equal-numbers
  (expect-equal (twice 21) 42)
  (expect-equal (cast u64 7) 7)
  (expect-equal 0.5 (/ 1.0 2.0)))

(test expect-equal-characters (expect-equal (@ "hello" 1) #\e))

(test expect-equal-booleans (expect-equal (> (twice 3) 5) #t))

(test expect-equal-strings (expect-equal (slice "a test" 2) "test"))

(test expect-output (expect-output "4\n6\n" (printf "~a~n" (twice 2)) (printf "~a~n" (twice 3))))

(test expect-output-file (expect-output-file "counted.out" (for ([i i32 1]) (<= i 3) (+= i 1) (printf "~a~n" i))))

(test expect-compile-error (expect-compile-error "fail/arity.sub" "twice takes 1 argument, got 2"))

(test expect-run (expect-run "programs/echo.sub" #:args ("one" "two") #:stdin "typed" #:output "one two\ntyped"))

(test expect-run-grants (expect-run "programs/read.sub" #:grants ("-R=programs") #:output "read 9 bytes"))

(test expect-run-fails (expect-run "programs/exit.sub" #:fails "leaving with 3"))

(test traps #:traps "divide by zero" (let ([zero i32 0]) (printf "~a~n" (/ 1 zero))))

(test ignored #:ignore (expect #f))
