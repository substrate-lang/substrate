(require-unqualified stdin host/node/stdin)
(require-unqualified stream host/stream)

(define reader stream-reader)

(define (read [r (ptr stream-reader)]) (printf "~n~a" (buffer-string (& (-> r bytes)))))

(define (main)
  (let ([args (host-args)])
    (for ([i u32 0]) (< i (-> args length)) (+= i 1) (printf "~a~a" (if (== i 0) "" " ") (@ args i)))
    (stream-read-all! (& reader) (stdin-stream) read)))
