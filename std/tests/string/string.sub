;; std/string: searching, trimming, and building in an arena and on the heap.
(require-unqualified std/test/test)
(require-unqualified std/string)

(define (searching)
  (printf "~a ~a ~a ~a\n" (string-prefix? "substrate" "sub") (string-prefix? "sub" "substrate")
          (string-prefix? "abc" "") (string-prefix? "abc" "abd"))
  (printf "~a ~a ~a\n" (string-suffix? "main.sub" ".sub") (string-suffix? "sub" "main.sub") (string-suffix? "abc" ""))
  (printf "~a ~a ~a\n" (string-index "a,b,c" #\,) (string-index "abc" #\,) (string-index "" #\,))
  (printf "~a ~a ~a ~a\n" (string-find "a, b, c" ", ") (string-find "abc" "bcd") (string-find "abc" "")
          (string-find "" "a"))
  (printf "~a ~a ~a ~a\n" (string-contains? "hello" "ll") (string-contains? "hello" "lo!") (string-contains? "" "")
          (string-contains? "abc" "abc")))

(define (trimming)
  (printf "[~a] [~a] [~a]\n" (string-trim " \t a b \r\n") (string-trim-left "  a b  ") (string-trim-right "  a b  "))
  (printf "[~a] [~a]\n" (string-trim "   ") (string-trim ""))
  (printf "~a ~a ~a ~a ~a ~a\n" (char-numeric? #\0) (char-numeric? #\9) (char-numeric? #\a) (char-whitespace? #\space)
          (char-whitespace? #\return) (char-whitespace? #\x)))

(define (appending)
  (let ([a (make-arena)])
    (printf "~a [~a] ~a\n" (string-append (& a) "sub" "str" "ate") (string-append (& a)) (string-append (& a) "one"))
    (printf "~a [~a] ~a\n" (string-join (& a) (slice (array-of string "a" "b" "c")) ", ")
            (string-join (& a) (slice (array-of string)) ", ") (string-join (& a) (slice (array-of string "x")) ", "))
    (arena-free (& a))))

(define (show [pieces (slice string)])
  (printf "~a:" (-> pieces length))
  (for ([i u32 0]) (< i (-> pieces length)) (+= i 1) (printf " [~a]" (@ pieces i)))
  (printf "\n"))

(define (splitting)
  (let ([a (make-arena)])
    (show (string-split (& a) "a,b,,c" ","))
    (show (string-split (& a) ",a," ","))
    (show (string-split (& a) "a::b" "::"))
    (show (string-split (& a) "abc" ""))
    (show (string-split (& a) "" ","))
    (arena-free (& a))))

(define (replacing)
  (let ([a (make-arena)])
    (printf "~a ~a ~a ~a\n" (string-replace (& a) "a-b-c" "-" "+") (string-replace (& a) "aaa" "aa" "b")
            (string-replace (& a) "abc" "" "x") (string-replace (& a) "abc" "b" ""))
    (arena-free (& a))))

(define (on-the-heap)
  (let ([s (string-append 0 "on " "the " "heap")] [pieces (string-split 0 "x y" " ")])
    (printf "~a ~a ~a\n" s (@ pieces 0) (@ pieces 1))
    (free (-> s bytes))
    (free (-> pieces items))))

(test searching (expect-output "#t #f #t #f\n#t #f #t\n1 3 0\n1 3 0 0\n#t #f #t #t\n" (searching)))

(test trimming (expect-output "[a b] [a b  ] [  a b]\n[] []\n#t #t #f #t #t #f\n" (trimming)))

(test appending (expect-output "substrate [] one\na, b, c [] x\n" (appending)))

(test splitting (expect-output "4: [a] [b] [] [c]\n3: [] [a] []\n2: [a] [b]\n1: [abc]\n1: []\n" (splitting)))

(test replacing (expect-output "a+b+c ba abc ac\n" (replacing)))

(test on-the-heap (expect-output "on the heap x y\n" (on-the-heap)))
