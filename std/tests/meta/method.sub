;; Operations and their methods: for a struct, for each instance of a generic type, from another module, and through a
;; typedef.
(require-unqualified std/test/test)
(require-unqualified std/meta/method)
(require-unqualified std/vector)
(require-unqualified "fixtures/shapes.sub")
(require-unqualified "fixtures/circles.sub")

(define-methods total)

(typedef numbers (vector u32))

(define-method (total [v (ptr numbers)]) -> u32 (let ([sum u32 0]) (vector-each ([x v]) (+= sum (@ x))) sum))

(struct plank [length u32])

(typedef board plank)

(define-method (area [b (ptr board)]) -> u32 (-> b length))

(test methods
  (let ([s (square #:side 3)] [c (circle #:radius 2)] [t (tile string)] [n (tile u8)])
    (set! (-> t width) 5)
    (set! (-> n width) 1)
    (expect-equal (area (& s)) 9)
    (expect-equal (area (& c)) 12)
    (expect-equal (area (& t)) 25)
    (expect-equal (area (& n)) 1)
    (expect-equal (describe (& s)) "a square")))

(test typedef-methods
  (let ([ns numbers] [b (plank #:length 7)])
    (vector-push! (& ns) 4)
    (vector-push! (& ns) 5)
    (expect-equal (total (& ns)) 9)
    (expect-equal (area (& b)) 7)
    (vector-free! (& ns))))
