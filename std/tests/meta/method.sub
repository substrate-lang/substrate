;; Operations and their methods: for a struct, for each instance of a generic type, and from another module.
(require-unqualified std/test/test)
(require-unqualified "fixtures/shapes.sub")
(require-unqualified "fixtures/circles.sub")

(test methods
  (let ([s (square #:side 3)] [c (circle #:radius 2)] [t (tile string)] [n (tile u8)])
    (set! (-> t width) 5)
    (set! (-> n width) 1)
    (expect-equal (area (& s)) 9)
    (expect-equal (area (& c)) 12)
    (expect-equal (area (& t)) 25)
    (expect-equal (area (& n)) 1)
    (expect-equal (describe (& s)) "a square")))
