;; Generic types: a template with two parameters, a variant, a type that points to its own kind, a type function whose
;; definer is a macro, an alias that names an instance and makes its literals, a type from another module whose field
;; is another instance, an instance in a macro's code, and an instance that a macro gets from two modules.
(require-unqualified std/test/test)
(require-unqualified std/meta/method)
(require-unqualified std/meta/type)
(require-unqualified compiler/macros)
(require-unqualified std/vector)
(require-unqualified "fixtures/boxes.sub")
(require-unqualified "fixtures/phases.sub")
(begin-for-syntax (require-unqualified compiler/macros) (require-unqualified std/meta/type-info) (require-unqualified std/vector))

(define-type (pair A B)
  (struct [first A] [second B])
  (define (-swapped [p (ptr (pair A B))]) -> (pair B A)
    (let ([q (pair B A)])
      (set! (-> q first) (-> p second))
      (set! (-> q second) (-> p first))
      q)))

(define-type (option T)
  (variant [some [value T]] [none])
  (define (-or [o (ptr (option T))] [fallback T]) -> T
    (match o [(.some v) v] [.none fallback])))

(typedef maybe-text (option string))

(define-type (chain T)
  (struct [value T] [next (ptr (chain T))])
  (define (-length [c (ptr (chain T))]) -> u32
    (let ([n u32 0] [at c])
      (while (!= at 0)
        (+= n 1)
        (set! at (-> at next)))
      n)))

(define-macro (cell-definer s)
  (syntax-match s
    [(_ f name t) #`(struct #,name [value #,t] [taken bool])]))

(define-type cell cell-definer)

(define-macro (counted s)
  (let ([v (vector i32)])
    (for/each ([x (cdr (syntax->list s))]) (vector-push! (& v) 1))
    (datum->syntax s (make-integer (vector-count (& v))) s)))

(define-methods [swapped -swapped] [chain-length -length] [option-or -or])

(typedef point (pair i32 i32))

(test template
  (let ([p (pair i32 string)])
    (set! (-> p first) 7)
    (set! (-> p second) "seven")
    (let ([q (swapped (& p))])
      (expect-equal (-> q first) "seven")
      (expect-equal (-> q second) 7)
      (expect-equal (sizeof (pair i32 string)) 12))))

(test variant
  (let ([a (option i32) (.some 5)] [b (option i32) .none] [t (maybe-text .some "text")])
    (expect-equal (option-or (& a) 0) 5)
    (expect-equal (option-or (& b) 7) 7)
    (expect-equal (option-or (& t) "") "text")
    (set! a .none)
    (expect-equal (option-or (& a) 1) 1)))

(test own-kind
  (let ([a (chain u8)] [b (chain u8)])
    (set! (-> a next) (& b))
    (expect-equal (chain-length (& a)) 2)))

(test definer
  (let ([c (cell f64)])
    (set! (-> c value) 2.5)
    (expect-equal (-> c value) 2.5)
    (expect-equal (-> c taken) #f)))

(test alias
  (let ([p (point #:first 3 #:second 4)] [q (pair i32 i32)])
    (set! q p)
    (expect-equal (-> (swapped (& q)) second) 3)))

(test nested
  (let ([b (box point)] [p point])
    (set! (-> p second) 2)
    (box-add! (& b) p)
    (set! (-> p second) 4)
    (box-add! (& b) p)
    (expect-equal (vector-count (& (-> b cells))) 2)
    (expect-equal (-> (vector-at (& (-> b cells)) 1) value second) 4)))

(test compile-time
  (let ([v (vector i32)])
    (vector-push! (& v) (counted a b c))
    (expect-equal (@ (vector-at (& v) 0)) 3)
    (vector-free! (& v))))

(test phases (expect-equal (listed-count) 1))
