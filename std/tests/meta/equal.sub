(require-unqualified tests std/test/test)
(require-unqualified eq std/meta/equal)
(struct point [x i32] [y i32])
(struct named [name string] [at point] [tags (slice u8)] [grid (array u16 3)] [next (ptr named)])
(variant shape [circle [r f64]] [poly [w i32] [h i32]] [dot])
(struct #:forall (T) pair [a T] [b T])
(variant #:forall (T) maybe [none] [some [value T]])

(test numbers-and-strings
  (expect (equal? 3 3))
  (expect (not (equal? 3 4)))
  (expect (equal? 3 3.0))
  (expect (equal? "ab" (string-copy "ab"))))

(test structs
  (expect (equal? (point #:x 1 #:y 2) (point #:x 1 #:y 2)))
  (expect (not (equal? (point #:x 1 #:y 2) (point #:x 1 #:y 3)))))

(test fields-by-content
  (let ([a named] [b named])
    (set! (-> a name) "n")
    (set! (-> b name) (string-copy "n"))
    (set! (-> a tags) (cast (slice u8) "ab"))
    (set! (-> b tags) (cast (slice u8) (string-copy "ab")))
    (expect (equal? a b))
    (set! (@ (-> b grid) 1) 7)
    (expect (not (equal? a b)))))

(test pointers-by-address
  (let ([a named] [b named])
    (set! (-> a next) (& a))
    (set! (-> b next) (& b))
    (expect (not (equal? a b)))))

(test arrays
  (let ([xs (array u16 3)] [ys (array u16 3)])
    (expect (equal? xs ys))
    (set! (@ ys 2) 1)
    (expect (not (equal? xs ys)))))

(test variants
  (expect (equal? (circle 1.0) (circle 1.0)))
  (expect (not (equal? (circle 1.0) (circle 2.0))))
  (expect (not (equal? (circle 1.0) (poly 1 2))))
  (expect (equal? (dot) (dot))))

(test generic-structs
  (expect (equal? (pair #:a 1 #:b 2) (pair #:a 1 #:b 2)))
  (expect (not (equal? (pair #:a 1 #:b 2) (pair #:a 1 #:b 3))))
  (expect (equal? (pair #:a (point #:x 1 #:y 2) #:b (point #:x 3 #:y 4)) (pair #:a (point #:x 1 #:y 2) #:b (point #:x 3 #:y 4))))
  (expect (not (equal? (pair #:a (pair #:a 1 #:b 2) #:b (pair #:a 3 #:b 4)) (pair #:a (pair #:a 1 #:b 2) #:b (pair #:a 3 #:b 5))))))

(test generic-variants
  (let ([a (maybe i32) (some 1)] [b (maybe i32) (some 1)] [c (maybe i32) (none)])
    (expect (equal? a b))
    (expect (not (equal? a c)))
    (expect (equal? c c))))
