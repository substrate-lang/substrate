;; Generic types and functions, counts as their arguments, writers, and the layouts that macros read.
(require-unqualified std/test/test)
(require-unqualified std/meta/generic)
(require-unqualified compiler/macros)
(require-unqualified std/vector)
(require-unqualified "fixtures/boxes.sub")
(require-unqualified "fixtures/phases.sub")
(require-unqualified "fixtures/largest.sub")
(begin-for-syntax (require-unqualified compiler/macros) (require-unqualified std/meta/type-info) (require-unqualified std/vector))

(define-generic (pair A B)
  (struct [first A] [second B]))

(define-generic ((swapped A B) [p (ptr (pair A B))]) -> (pair B A)
  (let ([q (pair B A)])
    (set! (-> q first) (-> p second))
    (set! (-> q second) (-> p first))
    q))

(define-generic (option T)
  (variant [some [value T]] [none]))

(define-generic ((option-or T) [o (ptr (option T))] [fallback T]) -> T
  (match o [(.some v) v] [.none fallback]))

(typedef maybe-text (option string))

(define-generic (chain T)
  (struct [value T] [next (ptr (chain T))]))

(define-generic ((chain-length T) [c (ptr (chain T))]) -> u32
  (let ([n u32 0] [at c])
    (while (!= at 0)
      (+= n 1)
      (set! at (-> at next)))
    n))

(define-macro (cell-writer s)
  (syntax-match s
    [(_ f name t) #`(struct #,name [value #,t] [taken bool])]))

(define-generic cell cell-writer)

(define-macro (counted s)
  (let ([v (vector i32)])
    (for/each ([x (cdr (syntax->list s))]) (vector-push! (& v) 1))
    (datum->syntax s (make-integer (vector-count (& v))) s)))

(const size i32 4)

(define-generic (ring T [N u32])
  (struct [items (array T N)] [count u32]))

(define-generic ((ring-capacity T [N u32]) [r (ptr (ring T N))]) -> u32 N)

(define-generic ((gcd T) [a T] [b T]) -> T (if (== b 0) a ((gcd T) b (% a b))))

(define-macro (layout-text s) (syntax-match s [(_ t) (datum->syntax s (format "~s" `(,(type-layout t))) s)]))

(typedef point (pair i32 i32))

(test template
  (let ([p (pair i32 string)])
    (set! (-> p first) 7)
    (set! (-> p second) "seven")
    (let ([q ((swapped i32 string) (& p))])
      (expect-equal (-> q first) "seven")
      (expect-equal (-> q second) 7)
      (expect-equal (sizeof (pair i32 string)) 12))))

(test variant
  (let ([a (option i32) (.some 5)] [b (option i32) .none] [t (maybe-text .some "text")])
    (expect-equal ((option-or i32) (& a) 0) 5)
    (expect-equal ((option-or i32) (& b) 7) 7)
    (expect-equal ((option-or string) (& t) "") "text")
    (set! a .none)
    (expect-equal ((option-or i32) (& a) 1) 1)))

(test own-kind
  (let ([a (chain u8)] [b (chain u8)])
    (set! (-> a next) (& b))
    (expect-equal ((chain-length u8) (& a)) 2)))

(test writer
  (let ([c (cell f64)])
    (set! (-> c value) 2.5)
    (expect-equal (-> c value) 2.5)
    (expect-equal (-> c taken) #f)))

(test alias
  (let ([p (point #:first 3 #:second 4)] [q (pair i32 i32)])
    (set! q p)
    (expect-equal (-> ((swapped i32 i32) (& q)) second) 3)))

(test instance-literal
  (let ([p ((pair i32 string) #:first 7 #:second "seven")] [o ((option i32) .some 5)])
    (expect-equal (-> p second) "seven")
    (expect-equal ((option-or i32) (& o) 0) 5)
    (expect-output "((option i32) .some 5)" (printf "~s" o))))

(test nested
  (let ([b (box point)] [p point])
    (set! (-> p second) 2)
    ((box-add! point) (& b) p)
    (set! (-> p second) 4)
    ((box-add! point) (& b) p)
    (expect-equal (vector-count (& (-> b cells))) 2)
    (expect-equal (-> (vector-at (& (-> b cells)) 1) value second) 4)))

(test compile-time
  (let ([v (vector i32)])
    (vector-push! (& v) (counted a b c))
    (expect-equal (@ (vector-at (& v) 0)) 3)
    (vector-free! (& v))))

(test phases (expect-equal (listed-count) 1))

(test count
  (let ([r (ring i32 4)] [s (ring i32 size)])
    (set! (-> r count) 3)
    (set! s r)
    (expect-equal (sizeof (ring i32 4)) 20)
    (expect-equal (sizeof (array u8 size)) 4)
    (expect-equal ((ring-capacity i32 size) (& s)) 4)
    (expect-equal (-> s count) 3)))

(test generic
  (let ([xs (slice (array-of i32 3 9 4))] [f (largest i32)])
    (expect-equal ((largest i32) xs) 9)
    (expect-equal ((largest f64) (slice (array-of f64 1.5 0.5))) 1.5)
    (expect-equal (f xs) 9)
    (expect-equal ((gcd u32) 12 18) 6)
    (expect-equal (generic-largest) (largest i32))))

(test layout
  (expect-equal (layout-text (pair i32 i32)) "(8 4 ((first . 0) (second . 4)))")
  (expect-equal (layout-text (ring u8 16)) "(20 4 ((items . 0) (count . 16)))")
  (expect-equal (layout-text (option f64)) "(16 8 ((some (value . 8)) (none)))"))
