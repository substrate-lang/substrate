;; A macro that gets (vector i32) from two modules at phase 1, for type.sub: counting.sub's macro code makes one, and
;; listed.sub's function gives one.
(require-unqualified compiler/macros)
(require-unqualified "counting.sub")
(begin-for-syntax (require-unqualified compiler/macros) (require-unqualified std/vector) (require-unqualified "listed.sub"))

(provide listed-count)

(define-macro (listed-count s)
  (let ([w (vector i32)])
    (set! w (listed))
    (datum->syntax s (make-integer (vector-count (& w))) s)))
