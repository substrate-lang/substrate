;; A type with a method for shapes.sub's area, and a method that shapes.sub's square gets from here, for method.sub.
(require-unqualified std/meta/method)
(require-unqualified "shapes.sub")

(provide circle)

(struct circle [radius u32])

(define-method (area [c (ptr circle)]) -> u32 (* 3 (-> c radius) (-> c radius)))

(define-method (describe [s (ptr square)]) -> string "a square")
