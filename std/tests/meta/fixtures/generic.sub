;; A generic function, and its instance for i32 as a value, for type.sub.
(require-unqualified std/meta/type)

(provide largest generic-largest)

(define-generic ((largest T) [xs (slice T)]) -> T
  (let ([best (@ xs 0)])
    (for ([i u32 1]) (< i (-> xs length)) (+= i 1)
      (when (> (@ xs i) best) (set! best (@ xs i))))
    best))

(define (generic-largest) -> (fn ((slice i32)) -> i32) (largest i32))
