;; (box T), which holds a vector of (cell T), for generic.sub.
(require-unqualified std/meta/generic)
(require-unqualified std/vector)

(provide box box-add!)

(define-generic (cell T) (struct [value T]))

(define-generic (box T)
  (struct [cells (vector (cell T))]))

(define-generic ((box-add! T) [b (ptr (box T))] [x T])
  (let ([c (vector-add! (& (-> b cells)))]) (set! (-> c value) x)))
