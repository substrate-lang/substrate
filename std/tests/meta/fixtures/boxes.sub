;; (box T), which holds a vector of (cell T), for type.sub.
(require-unqualified std/meta/type)
(require-unqualified std/meta/method)
(require-unqualified std/vector)

(provide box box-add!)

(define-type (cell T) (struct [value T]))

(define-type (box T)
  (struct [cells (vector (cell T))])
  (define (-add! [b (ptr (box T))] [x T])
    (let ([c (vector-add! (& (-> b cells)))]) (set! (-> c value) x))))

(define-methods [box-add! -add!])
