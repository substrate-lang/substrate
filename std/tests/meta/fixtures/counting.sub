;; A macro that uses a (vector i32) while it expands, for phases.sub.
(require-unqualified compiler/macros)
(begin-for-syntax (require-unqualified compiler/macros) (require-unqualified std/vector))

(provide count-of)

(define-macro (count-of s)
  (let ([v (vector i32)])
    (for/each ([x (cdr (syntax->list s))]) (vector-push! (& v) 1))
    (datum->syntax s (make-integer (vector-count (& v))) s)))
