;; A type function's instance cannot hold a global.
(require-unqualified std/meta/type)
(require-unqualified compiler/macros)
(begin-for-syntax (require-unqualified compiler/macros))
(define-macro (counter-definer s)
  (syntax-match s [(_ f name t) #`(begin (struct #,name [value #,t]) (define the-count u32 0))]))
(define-type counter counter-definer)
(define (main) -> i32 (let ([c (counter i32)]) 0))
