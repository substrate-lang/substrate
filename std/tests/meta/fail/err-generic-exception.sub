;; A generic type's instance cannot declare an exception.
(require-unqualified std/meta/generic)
(require-unqualified compiler/macros)
(begin-for-syntax (require-unqualified compiler/macros))
(define-macro (guarded-writer s)
  (syntax-match s [(_ f name t) #`(begin (struct #,name [value #,t]) (exception oops i32))]))
(define-generic guarded guarded-writer)
(define (main) -> i32 (let ([g (guarded i32)]) 0))
