(require-unqualified std/test/build)

(test err-equal-types (expect-compile-error "fail/err-equal-types.sub" "err-equal-types.sub:4:31: error: equal?: compares values of one type, not point and string"))
(test err-equal-union (expect-compile-error "fail/err-equal-union.sub" "err-equal-union.sub:4:56: error: equal?: cannot compare bits"))
(test err-generic-count (expect-compile-error "fail/err-generic-count.sub" "err-generic-count.sub:4:26: error: box: takes 1 argument, not 2"))
(test err-generic-alone (expect-compile-error "fail/err-generic-alone.sub" "err-generic-alone.sub:4:25: error: box is a generic type: give it types, as in (box T)"))
(test err-generic-forms (expect-compile-error "fail/err-generic-forms.sub" "err-generic-forms.sub:3:44: error: define-generic: expected one struct, union, variant or enum form without a name"))
(test err-generic-instance (expect-compile-error "fail/err-generic-instance.sub" "err-generic-instance.sub:3:40: error: * takes numbers, not i32 and string\n  in: (* 2 x)\n  from: (twice string) at err-generic-instance.sub:4:26"))
(test err-generic-state (expect-compile-error "fail/err-generic-state.sub" "err-generic-state.sub:6:70: error: an instance of a generic type or function cannot define a global, since each module that makes the instance has its own copy"))
(test err-generic-exception (expect-compile-error "fail/err-generic-exception.sub" "err-generic-exception.sub:6:70: error: an instance of a generic type or function cannot define an exception, since each module that makes the instance has its own copy"))
(test err-generic-not-count (expect-compile-error "fail/err-generic-not-count.sub" "err-generic-not-count.sub:4:26: error: ring: N is a u32, not i32"))
(test err-generic-not-type (expect-compile-error "fail/err-generic-not-type.sub" "err-generic-not-type.sub:4:26: error: ring: T is a type, not 4"))
(test err-generic-count-range (expect-compile-error "fail/err-generic-count-range.sub" "err-generic-count-range.sub:4:26: error: ring: integer -1 does not fit in u32"))
(test err-generic-count-large (expect-compile-error "fail/err-generic-count-large.sub" "err-generic-count-large.sub:4:26: error: ring: integer 18446744073709551615 does not fit in u32"))
(test err-generic-param (expect-compile-error "fail/err-generic-param.sub" "err-generic-param.sub:3:25: error: define-generic: expected a type's name, or [name type] for a count of an integer type"))
(test err-generic-value (expect-compile-error "fail/err-generic-value.sub" "err-generic-value.sub:4:31: error: (ring i32 4) is a type, not a value"))
(test err-generic-type (expect-compile-error "fail/err-generic-type.sub" "err-generic-type.sub:4:25: error: (first i32) is a function, not a type"))
