(require-unqualified std/test/build)

(test err-equal-types (expect-compile-error "fail/err-equal-types.sub" "err-equal-types.sub:4:31: error: equal?: compares values of one type, not point and string"))
(test err-equal-union (expect-compile-error "fail/err-equal-union.sub" "err-equal-union.sub:4:56: error: equal?: cannot compare bits"))
(test err-type-count (expect-compile-error "fail/err-type-count.sub" "err-type-count.sub:4:26: error: box: takes 1 argument, not 2"))
(test err-type-alone (expect-compile-error "fail/err-type-alone.sub" "err-type-alone.sub:4:25: error: box is a type function: give it types, as in (box T)"))
(test err-type-global (expect-compile-error "fail/err-type-global.sub" "err-type-global.sub:3:41: error: define-type: expected a struct, union, variant or enum form without a name, or a function whose name starts with -"))
(test err-type-instance (expect-compile-error "fail/err-type-instance.sub" "err-type-instance.sub:3:81: error: * takes numbers, not i32 and string\n  in: (* 2 (-> b value))\n  from: (box string) at err-type-instance.sub:4:25"))
(test err-type-state (expect-compile-error "fail/err-type-state.sub" "err-type-state.sub:6:70: error: an instance of a type function or generic function cannot define a global, since each module that makes the instance has its own copy"))
(test err-type-exception (expect-compile-error "fail/err-type-exception.sub" "err-type-exception.sub:6:70: error: an instance of a type function or generic function cannot define an exception, since each module that makes the instance has its own copy"))
(test err-type-not-count (expect-compile-error "fail/err-type-not-count.sub" "err-type-not-count.sub:4:26: error: ring: N is a u32, not i32"))
(test err-type-not-type (expect-compile-error "fail/err-type-not-type.sub" "err-type-not-type.sub:4:26: error: ring: T is a type, not 4"))
(test err-type-count-range (expect-compile-error "fail/err-type-count-range.sub" "err-type-count-range.sub:4:26: error: ring: integer -1 does not fit in u32"))
(test err-type-param (expect-compile-error "fail/err-type-param.sub" "err-type-param.sub:3:22: error: define-type: expected a type's name, or [name type] for a count of an integer type"))
(test err-type-value (expect-compile-error "fail/err-type-value.sub" "err-type-value.sub:4:31: error: (ring i32 4) is a type, not a value"))
(test err-generic-type (expect-compile-error "fail/err-generic-type.sub" "err-generic-type.sub:4:25: error: (first i32) is a function, not a type"))
