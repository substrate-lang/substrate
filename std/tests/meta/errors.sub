(require-unqualified std/test/build)

(test err-equal-types (expect-compile-error "fail/err-equal-types.sub" "err-equal-types.sub:4:31: error: equal?: compares values of one type, not point and string"))
(test err-equal-union (expect-compile-error "fail/err-equal-union.sub" "err-equal-union.sub:4:56: error: equal?: cannot compare bits"))
(test err-type-count (expect-compile-error "fail/err-type-count.sub" "err-type-count.sub:4:26: error: box: takes 1 type, not 2"))
(test err-type-alone (expect-compile-error "fail/err-type-alone.sub" "err-type-alone.sub:4:25: error: box is a type function: give it types, as in (box T)"))
(test err-type-global (expect-compile-error "fail/err-type-global.sub" "err-type-global.sub:3:41: error: define-type: expected a struct, union, variant or enum form without a name, or a function whose name starts with -"))
(test err-type-instance (expect-compile-error "fail/err-type-instance.sub" "err-type-instance.sub:3:81: error: * takes numbers, not i32 and string\n  in: (* 2 (-> b value))\n  from: (box string) at err-type-instance.sub:4:25"))
(test err-type-state (expect-compile-error "fail/err-type-state.sub" "err-type-state.sub:6:70: error: a type function's instance cannot define a global, since each module that makes the instance has its own copy"))
(test err-type-exception (expect-compile-error "fail/err-type-exception.sub" "err-type-exception.sub:6:70: error: a type function's instance cannot define an exception, since each module that makes the instance has its own copy"))
