(require-unqualified std/test/test)
(struct point [x i32] [y i32])
(struct #:forall (T) pair [a T] [b T])
(define g f64 1.5)
(define (f [a i32]) -> i32 a)

(begin-for-syntax
  (require-unqualified compiler/macros)
  (require-unqualified std/meta/type-info)
  (define (type-of-form [s datum]) -> datum
    (syntax-match s
      [(_ x) (let ([t (variable-type x)]) (datum->syntax s (if (== t 0) '"none" (format "~s" `(,(type-datum t)))) s))])))

(define-syntax type-of type-of-form)

(test locals
  (let* ([p (point #:x 1 #:y 2)] [n 3] [s "x"] [q (ptr point) 0] [xs (array u8 4)] [ys (slice u8) (slice xs)])
    (expect-equal (type-of p) "point")
    (expect-equal (type-of n) "i32")
    (expect-equal (type-of s) "string")
    (expect-equal (type-of q) "(ptr point)")
    (expect-equal (type-of xs) "(array u8 4)")
    (expect-equal (type-of ys) "(slice u8)")))

(test module-level
  (expect-equal (type-of g) "f64")
  (expect-equal (type-of f) "(fn (i32) i32)")
  (expect-equal (type-of point) "none"))

(test bound-value (let ([t (+ 1 1.5)]) (expect-equal (type-of t) "f64")))

(test instance (let ([b (pair #:a (point #:x 1 #:y 2) #:b (point #:x 3 #:y 4))]) (expect-equal (type-of b) "(pair point)")))
