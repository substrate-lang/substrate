;; Vectors: pushing and reading, zeroed new items, popping, reserving, each item in turn, and a vector type from another
;; module.
(require-unqualified std/test/test)
(require-unqualified std/vector)
(require-unqualified "fixtures/points.sub")

(define-vector numbers u32)
(define-vector names string)

(test push-and-read
  (let ([v numbers])
    (for ([i u32 0]) (< i 100) (+= i 1) (vector-push! (& v) (* i i)))
    (expect-equal (vector-count (& v)) 100)
    (expect-equal (@ (vector-at (& v) 99)) 9801)
    (expect-equal (-> (vector-items (& v)) length) 100)
    (expect-equal (@ (vector-items (& v)) 10) 100)
    (vector-free! (& v))
    (expect-equal (vector-count (& v)) 0)))

(test add-zeroes
  (let ([v points])
    (vector-push! (& v) (point #:x 1 #:y 2))
    (let ([p (vector-add! (& v))])
      (expect-equal (-> p x) 0)
      (set! (-> p x) 7))
    (expect-equal (-> (vector-at (& v) 0) y) 2)
    (expect-equal (-> (vector-at (& v) 1) x) 7)
    (vector-free! (& v))))

(test pop-and-clear
  (let ([v names])
    (vector-push! (& v) "a")
    (vector-push! (& v) "b")
    (expect-equal (vector-pop! (& v)) "b")
    (expect-equal (vector-count (& v)) 1)
    (vector-clear! (& v))
    (expect-equal (vector-count (& v)) 0)
    (vector-free! (& v))))

(test reserve
  (let ([v numbers])
    (vector-reserve! (& v) 1000)
    (expect-equal (-> v room) 1024)
    (expect-equal (vector-count (& v)) 0)
    (vector-free! (& v))))

(test each
  (let ([v numbers] [sum u32 0] [last u32 0])
    (for ([i u32 1]) (<= i 10) (+= i 1) (vector-push! (& v) i))
    (vector-each ([x (& v)]) (+= sum (@ x)))
    (vector-each ([x i (& v)]) (set! last i))
    (expect-equal sum 55)
    (expect-equal last 9)
    (vector-free! (& v))))

(define (three) -> u32 3)

(test err-vector-index #:traps "index 3 is out of range for length 3"
  (let ([v numbers])
    (for ([i u32 0]) (< i 3) (+= i 1) (vector-push! (& v) i))
    (vector-at (& v) (three))))

(test err-vector-empty #:traps "vector-pop!: the vector is empty" (let ([v numbers]) (vector-pop! (& v))))
