;; A vector of points made in its own module, for vector.sub.
(require-unqualified std/vector)

(provide point two-points)

(struct point [x i32] [y i32])

(define (two-points) -> (vector point)
  (let ([v (vector point)])
    (vector-push! (& v) (point #:x 1 #:y 2))
    (vector-push! (& v) (point #:x 3 #:y 4))
    v))
