;; std/sort's sort! on numbers, strings and structs, with equal items and with slices of every length up to 40.
(require-unqualified std/test/test)
(require-unqualified std/sort)
(require-unqualified std/vector)

(struct entry [name string] [rank u32])

(test numbers
  (let ([xs (array-of i32 5 -2 9 0 3)])
    (sort! (slice xs) (a b) (< a b))
    (expect-equal (@ xs 0) -2)
    (expect-equal (@ xs 1) 0)
    (expect-equal (@ xs 2) 3)
    (expect-equal (@ xs 3) 5)
    (expect-equal (@ xs 4) 9)
    (sort! (slice xs) (a b) (> a b))
    (expect-equal (@ xs 0) 9)
    (expect-equal (@ xs 4) -2)))

(test strings
  (let ([v (vector string)])
    (vector-push! (& v) "pear")
    (vector-push! (& v) "apple")
    (vector-push! (& v) "fig")
    (sort! (vector-items (& v)) (a b) (< a b))
    (expect-equal (@ (vector-at (& v) 0)) "apple")
    (expect-equal (@ (vector-at (& v) 1)) "fig")
    (expect-equal (@ (vector-at (& v) 2)) "pear")
    (vector-free! (& v))))

(test equal-items-keep-their-order
  (let ([v (vector entry)])
    (vector-push! (& v) (entry #:name "c" #:rank 2))
    (vector-push! (& v) (entry #:name "a" #:rank 1))
    (vector-push! (& v) (entry #:name "d" #:rank 2))
    (vector-push! (& v) (entry #:name "b" #:rank 1))
    (sort! (vector-items (& v)) (x y) (< (-> x rank) (-> y rank)))
    (expect-equal (-> (vector-at (& v) 0) name) "a")
    (expect-equal (-> (vector-at (& v) 1) name) "b")
    (expect-equal (-> (vector-at (& v) 2) name) "c")
    (expect-equal (-> (vector-at (& v) 3) name) "d")
    (vector-free! (& v))))

(test every-length
  (let ([v (vector u32)] [ok #t])
    (for ([n u32 0]) (<= n 40) (+= n 1)
      (vector-clear! (& v))
      (for ([i u32 0]) (< i n) (+= i 1) (vector-push! (& v) (% (* i 7919) 31)))
      (sort! (vector-items (& v)) (a b) (< a b))
      (for ([i u32 1]) (< i n) (+= i 1)
        (when (> (@ (vector-at (& v) (- i 1))) (@ (vector-at (& v) i))) (set! ok #f))))
    (expect ok)
    (vector-free! (& v))))
