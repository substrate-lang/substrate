;; Wire: each kind of value as bytes in the postcard 1.x wire format, a message read back and written again, and bytes
;; that are not a message refused with where.
(require-unqualified std/test/test)
(require-unqualified std/encoding/wire)
(require-unqualified "fixtures/point.sub")

(struct numbers [a u8] [b i8] [c u16] [d u32] [e u64] [f i16] [g i32] [h i64] [x f32] [y f64] [t bool])
(struct texts [s string] [empty string] [none (ptr u16)] [some (ptr u16)] [list (slice i32)] [fixed (array u8 3)])
(variant shape [blank] [circle [at point] [r f64]] [path [points (slice point)] [closed bool]])
(struct scene [name string] [shapes (slice shape)] [focus (ptr shape)] [grid (array (array i8 2) 2)])
(struct one-bool [on bool])
(struct one-u16 [n u16])
(struct one-u64 [n u64])
(struct one-text [s string])
(struct one-option [p (ptr u8)])

(wire numbers texts scene one-bool one-u16 one-u64 one-text one-option)

(define (hex [b (ptr buffer)])
  (let ([digits "0123456789abcdef"])
    (for ([i u32 0]) (< i (-> b length)) (+= i 1)
      (let ([c (cast u32 (@ (-> b bytes) i))])
        (when (> i 0) (printf " "))
        (printf "~a~a" (slice digits (>> c 4) (+ (>> c 4) 1)) (slice digits (bit-and c 15) (+ (bit-and c 15) 1)))))
    (printf "\n")
    (set! (-> b length) 0)))

(define (point-at [x i32] [y i32]) -> point
  (let ([p point])
    (set! (-> p x) x)
    (set! (-> p y) y)
    p))

(define (refused [ok bool] [err (ptr wire-error)])
  (if ok (printf "read\n") (printf "~a at ~a\n" (error-text (& (-> err error))) (-> err offset))))

(define (main)
  (let ([b (make-buffer)] [again (make-buffer)] [a (make-arena)] [n numbers] [t texts] [s scene] [back scene]
        [err wire-error] [seven u16 7] [ints (array i32 3)] [shapes (array shape 3)] [pts (array point 2)]
        [ob one-bool] [ou one-u16] [o64 one-u64] [ot one-text] [oo one-option] [f shape])
    (set! (-> n a) 255) (set! (-> n b) -1) (set! (-> n c) 300) (set! (-> n d) 4294967295)
    (set! (-> n e) 18446744073709551615) (set! (-> n f) -32768) (set! (-> n g) -64) (set! (-> n h) -9223372036854775808)
    (set! (-> n x) 1.0) (set! (-> n y) -0.0) (set! (-> n t) #t)
    (numbers.wire-write! (& b) (& n))
    (hex (& b))

    (set! (@ ints 0) 1) (set! (@ ints 1) -1) (set! (@ ints 2) 64)
    (set! (-> t s) "hé") (set! (-> t empty) "") (set! (-> t none) 0) (set! (-> t some) (& seven))
    (set! (-> t list) (slice ints 3))
    (set! (@ (-> t fixed) 0) 9) (set! (@ (-> t fixed) 1) 8) (set! (@ (-> t fixed) 2) 7)
    (texts.wire-write! (& b) (& t))
    (hex (& b))

    (set! (@ pts 0) (point-at 1 2)) (set! (@ pts 1) (point-at -3 4))
    (set! (@ shapes 0) (blank)) (set! (@ shapes 1) (circle (point-at 5 -6) 0.5)) (set! (@ shapes 2) (path (slice pts 2) #t))
    (set! (-> s name) "scène") (set! (-> s shapes) (slice shapes 3)) (set! (-> s focus) (& (@ shapes 1)))
    (set! (@ (@ (-> s grid) 0) 0) 1) (set! (@ (@ (-> s grid) 0) 1) -2) (set! (@ (@ (-> s grid) 1) 0) -3)
    (set! (@ (@ (-> s grid) 1) 1) 4)
    (scene.wire-write! (& b) (& s))
    (printf "scene: ")
    (hex (& b))
    (scene.wire-write! (& b) (& s))
    (if (scene.wire-read (& a) (buffer-bytes (& b)) (& back) (& err))
        (begin
          (scene.wire-write! (& again) (& back))
          (printf "read ~a, ~a shapes, focus ~a, grid ~a ~a ~a ~a, same bytes ~a\n" (-> back name) (-> back shapes length)
                  (match (-> back focus) [(circle at r) (-> at y)] [_ 0])
                  (@ (@ (-> back grid) 0) 0) (@ (@ (-> back grid) 0) 1) (@ (@ (-> back grid) 1) 0) (@ (@ (-> back grid) 1) 1)
                  (== (buffer-string (& b)) (buffer-string (& again)))))
        (refused #f (& err)))

    (refused (one-u16.wire-read (& a) (slice (array-of u8) 0) (& ou) (& err)) (& err))
    (refused (one-bool.wire-read (& a) (slice (array-of u8 2) 1) (& ob) (& err)) (& err))
    (refused (one-bool.wire-read (& a) (slice (array-of u8 1 0) 2) (& ob) (& err)) (& err))
    (refused (one-u16.wire-read (& a) (slice (array-of u8 128 128 128 1) 4) (& ou) (& err)) (& err))
    (refused (one-u16.wire-read (& a) (slice (array-of u8 128 128 4) 3) (& ou) (& err)) (& err))
    (refused (one-u16.wire-read (& a) (slice (array-of u8 255 255 3) 3) (& ou) (& err)) (& err))
    (refused (one-u64.wire-read (& a) (slice (array-of u8 255 255 255 255 255 255 255 255 255 2) 10) (& o64) (& err)) (& err))
    (refused (one-text.wire-read (& a) (slice (array-of u8 1 255) 2) (& ot) (& err)) (& err))
    (refused (one-text.wire-read (& a) (slice (array-of u8 5 97) 2) (& ot) (& err)) (& err))
    (refused (one-option.wire-read (& a) (slice (array-of u8 2 7) 2) (& oo) (& err)) (& err))
    (refused (shape.wire-read (& a) (slice (array-of u8 9) 1) (& f) (& err)) (& err))
    (arena-free (& a))))

(test wire (expect-output-file "wire.out" (main)))
