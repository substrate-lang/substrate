;; JSON: text parsed and written back, compact and indented; errors with their line and column; values read, built and
;; changed; a tree copied to another arena and compared; the token reader, with a value skipped; and lookups in nothing.
(require-unqualified std/test/test)
(require-unqualified std/encoding/json)

(define (write [v (ptr json-value)] [indent string])
  (let ([b (make-buffer)])
    (json-write! (& b) v indent)
    (printf "~a\n" (buffer-string (& b)))
    (buffer-free! (& b))))

(define (parse [a (ptr arena)] [text string]) -> (ptr json-value)
  (let* ([err json-error] [v (json-parse a text (& err))])
    (when (== v 0) (printf "~a:~a: ~a\n" (-> err line) (-> err column) (-> err message)))
    v))

(define sample string
  "{\"a\": [1, 2.50, -0, 1E5, 12345678901234567890, -1.5e-7], \"b\": {\"c\": null, \"d\": true, \"e\": false},
    \"s\": \"q\\\"b\\\\s\\/n\\n\\u0041\\u00e9\\ud83d\\ude00\\u0000\", \"empty\": [], \"none\": {}}")

(define errors (array string 19)
  (array-of string "" "   " "[1,]" "{\"a\":1,}" "[1 2]" "{\"a\" 1}" "{1:2}" "[01]" "[1.]" "[-]" "[\"a\nb\"]"
            "[\"\\x\"]" "[\"\\ud800\"]" "[\"\\u12\"]" "[tru]" "[1] x" "[[" "{\"a\":" "[1,\n 2,\n x]"))

(define (errors!)
  (let ([a (make-arena)] [b (make-buffer)])
    (for ([i 0]) (< i 19) (+= i 1) (parse (& a) (@ errors i)))
    (parse (& a) "\"abc")
    (buffer-add-string! (& b) "[\"")
    (buffer-add-byte! (& b) 255)
    (buffer-add-string! (& b) "\"]")
    (parse (& a) (buffer-string (& b)))
    (set! (-> b length) 0)
    (for ([i 0]) (< i 1001) (+= i 1) (buffer-add-byte! (& b) #\[))
    (parse (& a) (buffer-string (& b)))
    (buffer-free! (& b))
    (arena-free (& a))))

(define (reads!)
  (let* ([a (make-arena)] [i i64 0] [x f64 0] [t bool #f] [s string]
         [doc (parse (& a) "{\"id\": 9007199254740993, \"f\": 1.5, \"s\": \"a\\u0000b\", \"t\": true, \"dup\": 1,
                            \"dup\": 2, \"list\": [10, 20, 30], \"big\": 9223372036854775808}")])
    (printf "id ~a ~a\n" (json-as-i64 (json-get doc "id") (& i)) i)
    (printf "big as i64 ~a\n" (json-as-i64 (json-get doc "big") (& i)))
    (printf "f ~a ~a, as i64 ~a\n" (json-as-f64 (json-get doc "f") (& x)) x (json-as-i64 (json-get doc "f") (& i)))
    (printf "s ~a ~a\n" (json-as-string (json-get doc "s") (& s)) (-> s length))
    (printf "t ~a ~a\n" (json-as-bool (json-get doc "t") (& t)) t)
    (write (json-get doc "dup") "")
    (printf "list ~a: " (json-count (json-get doc "list")))
    (write (json-at (json-get doc "list") 1) "")
    (printf "missing ~a ~a ~a\n" (json-get doc "nothing") (json-at (json-get doc "list") 3) (json-get (json-get doc "f") "x"))
    (arena-free (& a))))

(define (builds!)
  (let ([a (make-arena)] [o (json-object 0 0)] [ns (json-array 0 0)] [text (array-of u8 #\a 1 #\b 31 255)])
    (json-add! (& a) (& o) "name" (json-string "Ada"))
    (json-push! (& a) (& ns) (json-number 1e21 ""))
    (json-push! (& a) (& ns) (json-number -1e-7 ""))
    (json-push! (& a) (& ns) (json-number 0.1 ""))
    (json-push! (& a) (& ns) (json-number -0.0 ""))
    (json-push! (& a) (& ns) (json-number 123456789012345680000.0 ""))
    (json-push! (& a) (& ns) (json-number (/ 0.0 0.0) ""))
    (json-push! (& a) (& ns) (json-number 5e-324 ""))
    (json-push! (& a) (& ns) (json-number 0.000001 ""))
    (json-add! (& a) (& o) "numbers" ns)
    (json-add! (& a) (& o) "bytes" (json-string (cast string (slice text))))
    (write (& o) "")
    (json-replace! (& a) (& o) "name" (json-string "Grace"))
    (json-remove-at! (json-get (& o) "numbers") 0)
    (json-insert! (& a) (json-get (& o) "numbers") 0 (json-boolean #t))
    (json-replace-at! (& a) (json-get (& o) "numbers") 1 (json-null))
    (printf "~a ~a ~a\n" (json-remove! (& o) "bytes") (json-remove! (& o) "bytes") (json-insert! (& a) (& o) 0 (json-null)))
    (write (& o) "\t")
    (arena-free (& a))))

(define (copies!)
  (let* ([a (make-arena)] [b (make-arena)] [doc (parse (& a) sample)] [copy (json-copy (& b) doc)])
    (arena-free (& a))
    (write copy "")
    (printf "equal ~a\n" (json-equal? copy (parse (& b) sample)))
    (json-replace! (& b) (json-get copy "b") "d" (json-boolean #f))
    (printf "equal ~a\n" (json-equal? copy (parse (& b) sample)))
    (arena-free (& b))))

(define token-names (array string 12)
  (array-of string "error" "end" "[" "]" "{" "}" "key" "string" "number" "true" "false" "null"))

(define (tokens!)
  (let ([r json-reader] [t json-token])
    (json-reader-start! (& r) "{\"a\": [1, \"x\", {\"b\": null}], \"c\": [true], \"d\": -2.5e3}")
    (while #t
      (set! t (json-next! (& r)))
      (printf "~a" (@ token-names (cast u32 t)))
      (cond [(or (== t json-token-key) (== t json-token-string)) (printf " ~a" (-> r token))]
            [(== t json-token-number) (printf " ~a" (-> r number))])
      (printf "\n")
      (when (or (== t json-token-end) (== t json-token-error)) (break))
      (when (and (== t json-token-key) (== (-> r token) "c")) (printf "skipped ~a\n" (json-skip! (& r)))))
    (json-reader-free! (& r))))

(define (main)
  (let ([a (make-arena)])
    (write (parse (& a) sample) "")
    (write (parse (& a) sample) "  ")
    (write (parse (& a) "\xFEFF; [1]") "")
    (arena-free (& a)))
  (errors!)
  (reads!)
  (builds!)
  (copies!)
  (tokens!))

(test json (expect-output-file "json.out" (main)))

(test missing
  (let* ([a (make-arena)] [v (parse (& a) sample)] [nothing (json-get (json-get v "none") "x")] [s string] [n i64 0]
         [f f64 0.0] [b #f])
    (expect-equal (cast u32 nothing) 0)
    (expect-equal (cast u32 (json-get nothing "y")) 0)
    (expect-equal (cast u32 (json-at nothing 0)) 0)
    (expect-equal (json-count nothing) 0)
    (expect (not (json-as-string nothing (& s))))
    (expect (not (json-as-i64 nothing (& n))))
    (expect (not (json-as-f64 nothing (& f))))
    (expect (not (json-as-bool nothing (& b))))))
