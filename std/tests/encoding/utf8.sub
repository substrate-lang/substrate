;; utf-8? on sequences of one to four bytes, and on each kind of malformed text.
(require-unqualified tests std/test/test)
(require-unqualified utf8 std/encoding/utf8)

(define (check [n u32] [a u32] [b u32] [c u32] [d u32])
  (let ([p (array u8 4)])
    (set! (@ p 0) (cast u8 a))
    (set! (@ p 1) (cast u8 b))
    (set! (@ p 2) (cast u8 c))
    (set! (@ p 3) (cast u8 d))
    (printf "~a" (utf-8? (slice p n)))))

(define (main)
  (check 0 0 0 0 0)
  (check 2 104 105 0 0)
  (check 2 #xC3 #xA9 0 0)
  (check 3 #xE2 #x82 #xAC 0)
  (check 4 #xF0 #x9F #x98 #x80)
  (check 4 #xF4 #x8F #xBF #xBF)
  (printf " ")
  (check 2 #xC0 #xAF 0 0)
  (check 3 #xED #xA0 #x80 0)
  (check 4 #xF4 #x90 #x80 #x80)
  (check 1 #x80 0 0 0)
  (check 2 #xE2 #x82 0 0)
  (check 1 #xFF 0 0 0)
  (printf "\n"))

(test utf8 (expect-output "#t#t#t#t#t#t #f#f#f#f#f#f" (main)))
