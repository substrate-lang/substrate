;; Base64 over the RFC 4648 vectors, every byte value, and malformed text; then base64url.
(require-unqualified std/test/test)
(require-unqualified std/encoding/base64)

(define (url-both [s string])
  (let ([e (make-buffer)] [d (make-buffer)])
    (base64url-encode! (& e) (cast (slice u8) s))
    (printf "url ~s -> ~a -> ~a ~s\n" s (buffer-string (& e)) (base64url-decode! (& d) (buffer-string (& e)))
            (buffer-string (& d)))
    (buffer-free! (& e))
    (buffer-free! (& d))))

(define (url-malformed [s string])
  (let ([d (make-buffer)])
    (printf "url \"~a\": ~a\n" s (base64url-decode! (& d) s))
    (buffer-free! (& d))))

(define (both [s string])
  (let ([e (make-buffer)] [d (make-buffer)])
    (base64-encode! (& e) (cast (slice u8) s))
    (printf "~s -> ~a -> ~a ~s\n" s (buffer-string (& e)) (base64-decode! (& d) (buffer-string (& e))) (buffer-string (& d)))
    (buffer-free! (& e))
    (buffer-free! (& d))))

(define (malformed [s string])
  (let ([d (make-buffer)])
    (printf "\"~a\": ~a\n" s (base64-decode! (& d) s))
    (buffer-free! (& d))))

(define (main)
  (both "")
  (both "f")
  (both "fo")
  (both "foo")
  (both "foob")
  (both "fooba")
  (both "foobar")
  (let ([all (array u8 256)] [e (make-buffer)] [d (make-buffer)])
    (for ([i u32 0]) (< i 256) (+= i 1) (set! (@ all i) i))
    (base64-encode! (& e) (slice all))
    (printf "all: ~a ~a ~a\n" (-> e length) (base64-decode! (& d) (buffer-string (& e))) (-> d length))
    (printf "same: ~a\n" (== (memcmp (-> d bytes) all 256) 0)))
  (malformed "Zg=")
  (malformed "Z")
  (malformed "Zm9=v")
  (malformed "Zm9v=")
  (malformed "Zm9v*")
  (malformed "Zm9vYg==Zg==")
  (url-both "")
  (url-both "f")
  (url-both "fo")
  (url-both "foo")
  (let ([b (array u8 3)] [e (make-buffer)])
    (set! (@ b 0) #xfb)
    (set! (@ b 1) #xff)
    (set! (@ b 2) #xbf)
    (base64url-encode! (& e) (slice b))
    (printf "url fb ff bf -> ~a\n" (buffer-string (& e))))
  (let ([all (array u8 256)] [e (make-buffer)] [d (make-buffer)])
    (for ([i u32 0]) (< i 256) (+= i 1) (set! (@ all i) i))
    (base64url-encode! (& e) (slice all))
    (printf "url all: ~a ~a ~a\n" (-> e length) (base64url-decode! (& d) (buffer-string (& e))) (-> d length))
    (printf "url same: ~a\n" (== (memcmp (-> d bytes) all 256) 0)))
  (url-malformed "Zg==")
  (url-malformed "Z")
  (url-malformed "Zh")
  (url-malformed "Zm+v"))

(test base64 (expect-output-file "base64.out" (main)))
