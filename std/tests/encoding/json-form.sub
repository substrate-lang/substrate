;; The json form: each kind of value written, a message read back and written again, and the reading rules: unknown
;; keys skipped, a repeated key's last value kept, a missing field refused unless a pointer, integers exact.
(require-unqualified std/test/test)
(require-unqualified std/encoding/json)
(require-unqualified "fixtures/point.sub")

(struct numbers [a u8] [b i8] [c u16] [d u32] [e u64] [f i16] [g i32] [h i64] [x f32] [y f64] [z f64] [w f64] [t bool])
(struct texts [s string] [none (ptr u16)] [some (ptr u16)] [list (slice i32)] [fixed (array u8 3)])
(variant shape [blank] [circle [at point] [r f64]] [path [points (slice point)] [closed bool]])
(struct scene [name string] [shapes (slice shape)] [focus (ptr shape)])
(struct small [a u8] [b i64] [x f32])

(json numbers texts scene small)

(define (point-at [x i32] [y i32]) -> point
  (let ([p point])
    (set! (-> p x) x)
    (set! (-> p y) y)
    p))

(define (shown [b (ptr buffer)])
  (printf "~a\n" (buffer-string b))
  (set! (-> b length) 0))

(define (refused [err (ptr json-error)]) (printf "~a:~a: ~a\n" (-> err line) (-> err column) (-> err message)))

(define (read-scene [a (ptr arena)] [b (ptr buffer)] [text string])
  (let ([s scene] [err json-error])
    (if (scene.json-read a text (& s) (& err))
        (begin (scene.json-write! b (& s)) (shown b))
        (refused (& err)))))

(define (read-small [a (ptr arena)] [b (ptr buffer)] [text string])
  (let ([s small] [err json-error])
    (if (small.json-read a text (& s) (& err))
        (begin (small.json-write! b (& s)) (shown b))
        (refused (& err)))))

(define (main)
  (let ([b (make-buffer)] [again (make-buffer)] [a (make-arena)] [n numbers] [t texts] [s scene] [back scene]
        [err json-error] [seven u16 7] [ints (array i32 3)] [shapes (array shape 3)] [pts (array point 2)])
    (set! (-> n a) 255) (set! (-> n b) -128) (set! (-> n c) 65535) (set! (-> n d) 4294967295)
    (set! (-> n e) 18446744073709551615) (set! (-> n f) -32768) (set! (-> n g) -2147483648)
    (set! (-> n h) -9223372036854775808) (set! (-> n x) 0.1) (set! (-> n y) -0.0) (set! (-> n z) (/ 0.0 0.0))
    (set! (-> n w) (/ 1.0 0.0)) (set! (-> n t) #f)
    (numbers.json-write! (& b) (& n))
    (shown (& b))

    (set! (@ ints 0) 1) (set! (@ ints 1) -1) (set! (@ ints 2) 64)
    (set! (-> t s) "line\n\"q\" é") (set! (-> t none) 0) (set! (-> t some) (& seven)) (set! (-> t list) (slice ints 3))
    (set! (@ (-> t fixed) 0) 9) (set! (@ (-> t fixed) 1) 8) (set! (@ (-> t fixed) 2) 7)
    (texts.json-write! (& b) (& t))
    (shown (& b))

    (set! (@ pts 0) (point-at 1 2)) (set! (@ pts 1) (point-at -3 4))
    (set! (@ shapes 0) (blank)) (set! (@ shapes 1) (circle (point-at 5 -6) 0.5)) (set! (@ shapes 2) (path (slice pts 2) #t))
    (set! (-> s name) "scène") (set! (-> s shapes) (slice shapes 3)) (set! (-> s focus) (& (@ shapes 1)))
    (scene.json-write! (& b) (& s))
    (if (scene.json-read (& a) (buffer-string (& b)) (& back) (& err))
        (begin
          (scene.json-write! (& again) (& back))
          (printf "same text ~a\n" (== (buffer-string (& b)) (buffer-string (& again)))))
        (refused (& err)))
    (shown (& b))

    (read-scene (& a) (& b) "{\"name\": \"n\", \"shapes\": [], \"extra\": {\"deep\": [1, {\"x\": null}]}, \"name\": \"m\"}")
    (read-scene (& a) (& b) "{\"shapes\": []}")
    (read-scene (& a) (& b) "{\"name\": \"n\", \"shapes\": [\"square\"]}")
    (read-scene (& a) (& b) "{\"name\": \"n\", \"shapes\": [{\"blank\": {}}]}")
    (read-scene (& a) (& b) "{\"name\": \"n\", \"shapes\": [{\"circle\": {\"at\": {\"x\": 1, \"y\": 2}, \"r\": 3}, \"blank\": 1}]}")
    (read-scene (& a) (& b) "{\"name\": \"n\", \"shapes\": [[]]}")
    (read-scene (& a) (& b) "{\"name\": \"n\", \"shapes\": [}")
    (read-scene (& a) (& b) "{\"name\": \"n\", \"shapes\": []} x")
    (read-scene (& a) (& b) "{\"name\": 1, \"shapes\": []}")

    (read-small (& a) (& b) "{\"a\": 255, \"b\": -9223372036854775808, \"x\": 0.1}")
    (read-small (& a) (& b) "{\"a\": 1.5, \"b\": 0, \"x\": 0}")
    (read-small (& a) (& b) "{\"a\": 1e2, \"b\": 0, \"x\": 0}")
    (read-small (& a) (& b) "{\"a\": -1, \"b\": 0, \"x\": 0}")
    (read-small (& a) (& b) "{\"a\": 256, \"b\": 0, \"x\": 0}")
    (read-small (& a) (& b) "{\"a\": 0, \"b\": 9223372036854775808, \"x\": 0}")
    (read-small (& a) (& b) "{\"a\": \"1\", \"b\": 0, \"x\": 0}")
    (read-small (& a) (& b) "{\"a\": 0, \"b\": 0, \"x\": null}")
    (let ([ts texts])
      (unless (texts.json-read (& a) "{\"s\": \"\", \"list\": [], \"fixed\": [1, 2]}" (& ts) (& err)) (refused (& err)))
      (unless (texts.json-read (& a) "{\"s\": \"\", \"list\": [], \"fixed\": [1, 2, 3, 4]}" (& ts) (& err)) (refused (& err)))
      (when (texts.json-read (& a) "{\"s\": \"\", \"list\": [], \"fixed\": [1, 2, 3], \"some\": null}" (& ts) (& err))
        (texts.json-write! (& b) (& ts))
        (shown (& b))))
    (arena-free (& a))))

(test json-form (expect-output-file "json-form.out" (main)))
