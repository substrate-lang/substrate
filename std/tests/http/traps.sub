(require-unqualified std/http)
(require-unqualified std/http/websocket)

;; Closing a WebSocket with 1006, a code that is never sent, traps.
(define w ws-connection)

(test err-close-code #:traps "ws: a close code that cannot be sent" (ws-close! (& w) 1006))

;; Writing a header whose value has a line break traps.
(test err-header #:traps "http: a header whose name is not a token or whose value has a control byte"
  (let ([b (make-buffer)])
    (http-write-header! (& b) "location" "/a\r\nset-cookie: x=1")))

;; Writing a status of 1000 traps.
(test err-status #:traps "http: a status outside 100 to 999"
  (let ([b (make-buffer)])
    (http-write-status! (& b) 1000)))
