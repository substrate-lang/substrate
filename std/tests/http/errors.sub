(require-unqualified std/test/build)

(test err-form-field (expect-compile-error "fail/err-form-field.sub" "err-form-field.sub:4:24: error: form: this field's type has no form encoding"))
(test err-form-variant (expect-compile-error "fail/err-form-variant.sub" "err-form-variant.sub:6:7: error: form: expected a struct type"))
(test err-route-conflict (expect-compile-error "fail/err-route-conflict.sub" "err-route-conflict.sub:11:3: error: routes: GET /{y}/b and GET /a/{x} overlap, and neither is more specific"))
(test err-route-handler (expect-compile-error "fail/err-route-handler.sub" "err-route-handler.sub:9:14: error: expected u32, got string"))
(test err-route-json (expect-compile-error "fail/err-route-json.sub" "err-route-json.sub:12:3: error: routes: this route needs point.json-read, which (json point) defines: write it before the routes"))
(test err-route-same (expect-compile-error "fail/err-route-same.sub" "err-route-same.sub:11:3: error: routes: GET /a/{y:u16} matches the same requests as GET /a/{x:u16}"))
(test err-route-type (expect-compile-error "fail/err-route-type.sub" "err-route-type.sub:9:16: error: routes: a parameter's type is string or an integer type"))
