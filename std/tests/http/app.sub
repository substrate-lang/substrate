;; Apps through the test client. A route gets its app with 200, a path that moved gets a 301, and a missing one gets
;; the app with 404. A file stays a file. A path under a second app's path goes to that app, which reads it from its
;; own path on. A redirect keeps the path of a mount above the files. A page with a render goes out as it writes the
;; page, or as built when it writes nothing.
(require-unqualified std/test/test)
(require-unqualified std/http)
(require-unqualified std/http/server)
(require-unqualified std/http/test)
(require-unqualified std/http/static)
(require-unqualified std/http/routable)
(require-unqualified std/http/route)

(routable place #:missing lost
  [home ()]
  [user ("users" [id u64] "")])

(routable inner #:missing gone
  [top ()]
  [item ("items" [n u32] "")]
  [#:moved ("index.html") top])

(define server http-server)
(define files http-files)
(define apps (array http-app 2))
(define pages (array http-page 1))
(define t http-test)

(define (handle [r (ptr http-request)]) (http-static! r (& files)))

(routes mounted
  [#:mount ("site") handle])

(define (got-with [h (fn ((ptr http-request)))] [target string]) -> i32
  (set! (-> files root) "tests/http/files")
  (set! (@ apps 0) (http-app #:path "/" #:page "page.html" #:routes place.url-check))
  (set! (@ apps 1) (http-app #:path "/dir/" #:page "dir/index.html" #:routes inner.url-check))
  (set! (-> files apps) (slice apps))
  (set! (-> server handle) h)
  (expect (http-test! (& t) (& server) "GET" target (slice (array-of string "accept" "*/*")) (cast (slice u8) "")))
  (http-test-status (& t)))

(define (got [target string]) -> i32 (got-with handle target))

(test app
  (expect-equal (got "/users/7/") 200)
  (expect-equal (http-test-header (& t) "content-type") "text/html; charset=utf-8")
  (expect-equal (cast string (http-test-body (& t))) "<p>page</p>\n")
  (expect-equal (got "/") 200)
  (expect-equal (got "/users/7?tab=2") 301)
  (expect-equal (http-test-header (& t) "location") "/users/7/?tab=2")
  (expect-equal (got "/nope") 404)
  (expect-equal (http-test-header (& t) "cache-control") "no-cache")
  (expect-equal (cast string (http-test-body (& t))) "<p>page</p>\n")
  (expect-equal (got "/digits.txt") 200)
  (expect-equal (http-test-header (& t) "content-type") "text/plain; charset=utf-8")
  (expect-equal (got "/.hidden") 404)
  (expect-equal (cast string (http-test-body (& t))) "not found")
  (expect-equal (got "/dir/items/3/") 200)
  (expect-equal (cast string (http-test-body (& t))) "<p>index</p>\n")
  (expect-equal (got "/dir/items/3?x=1") 301)
  (expect-equal (http-test-header (& t) "location") "/dir/items/3/?x=1")
  (expect-equal (got "/dir/items/3/x") 404)
  (expect-equal (cast string (http-test-body (& t))) "<p>index</p>\n")
  (expect-equal (got-with mounted "/site/users/7?tab=2") 301)
  (expect-equal (http-test-header (& t) "location") "/site/users/7/?tab=2")
  (expect-equal (got-with mounted "/site/dir/items/3") 301)
  (expect-equal (http-test-header (& t) "location") "/site/dir/items/3/")
  (expect-equal (got-with mounted "/site/dir/items/3/") 200)
  (expect-equal (got "/dir/nope") 404)
  (expect-equal (cast string (http-test-body (& t))) "<p>index</p>\n")
  (expect-equal (got "/elsewhere") 404)
  (expect-equal (cast string (http-test-body (& t))) "<p>page</p>\n")
  (http-test-free! (& t)))

;; An app path without a final slash traps, and the request that reaches it fails with 500.
(test app-path
  (set! (-> files root) "tests/http/files")
  (set! (@ apps 0) (http-app #:path "/notes" #:page "page.html" #:routes place.url-check))
  (set! (-> files apps) (slice apps 1))
  (set! (-> server handle) handle)
  (expect (http-test! (& t) (& server) "GET" "/notes/7/" (slice (array-of string "accept" "*/*")) (cast (slice u8) "")))
  (expect-equal (http-test-status (& t)) 500)
  (http-test-free! (& t)))

;; So does an app path that a URL would write differently.
(test app-path-written
  (set! (-> files root) "tests/http/files")
  (set! (@ apps 0) (http-app #:path "/my notes/" #:page "page.html" #:routes place.url-check))
  (set! (-> files apps) (slice apps 1))
  (set! (-> server handle) handle)
  (expect (http-test! (& t) (& server) "GET" "/my%20notes/7/" (slice (array-of string "accept" "*/*")) (cast (slice u8) "")))
  (expect-equal (http-test-status (& t)) 500)
  (http-test-free! (& t)))

;; The page of the app at /dir/: an item's number, nothing at the top, and gone where no route matches.
(define (dir-page [r (ptr http-request)] [out (ptr buffer)] [page string] [mount string] [to (ptr buffer)]) -> u32
  (let* ([a (make-arena)] [v inner]
         [read (inner.url-read (& a) (-> r target) (slice mount 0 (- (-> mount length) 1)) (& v) to)])
    (match v
      [(item n)
       (buffer-add-string! out "<p>item ")
       (write-digits out (cast u64 n) 10)
       (buffer-add-string! out "</p>")]
      [gone (buffer-add-string! out "<p>gone</p>")]
      [_ (begin)])
    (arena-free (& a))
    read))

(define (got-rendered-with [h (fn ((ptr http-request)))] [target string]) -> i32
  (set! (@ pages 0) (http-page #:path "dir/index.html" #:render dir-page))
  (set! (-> files pages) (slice pages))
  (let ([status (got-with h target)])
    (set! (-> files pages) (slice pages 0))
    status))

(define (got-rendered [target string]) -> i32 (got-rendered-with handle target))

(test pages
  (expect-equal (got-rendered "/dir/items/3/") 200)
  (expect-equal (http-test-header (& t) "content-type") "text/html; charset=utf-8")
  (expect-equal (http-test-header (& t) "cache-control") "no-cache")
  (expect-equal (cast string (http-test-body (& t))) "<p>item 3</p>")
  (expect-equal (got-rendered "/dir/") 200)
  (expect-equal (cast string (http-test-body (& t))) "<p>index</p>\n")
  (expect-equal (got-rendered "/dir/nope") 404)
  (expect-equal (cast string (http-test-body (& t))) "<p>gone</p>")
  (expect-equal (got-rendered "/dir/index.html") 301)
  (expect-equal (http-test-header (& t) "location") "/dir/")
  (expect-equal (got-rendered-with mounted "/site/dir/index.html") 301)
  (expect-equal (http-test-header (& t) "location") "/site/dir/")
  (expect-equal (got-rendered "/dir/items/3?x=1") 301)
  (expect-equal (http-test-header (& t) "location") "/dir/items/3/?x=1")
  (expect-equal (got-rendered "/") 200)
  (expect-equal (cast string (http-test-body (& t))) "<p>page</p>\n")
  (http-test-free! (& t)))
