;; Writing a header whose value has a line break traps.
(require-unqualified http std/http)

(define (main)
  (let ([b (make-buffer)])
    (http-write-header! (& b) "location" "/a\r\nset-cookie: x=1")))

(test err-header #:traps "http: a header whose name is not a token or whose value has a control byte" (main))
