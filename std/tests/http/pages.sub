;; Pages through the test client. A page with a render goes out as the render writes it, or as built when it writes
;; nothing, however the page is reached: as a file, as a directory's index.html, or sent by a fallback for a path that
;; names no file. A redirect keeps the path of a mount above the files. Without a fallback, such a path is not found.
(require-unqualified std/test/test)
(require-unqualified std/http)
(require-unqualified std/http/server)
(require-unqualified std/http/test)
(require-unqualified std/http/static)
(require-unqualified std/http/routable)
(require-unqualified std/http/route)
(require-unqualified std/http/url)
(require-unqualified std/string)

(routable inner #:missing gone
  [top ()]
  [item ("items" [n u32] "")]
  [#:moved ("index.html") top])

(define server http-server)
(define files http-files)
(define pages (array http-page 1))
(define none (fn ((ptr http-request) (ptr http-files)) -> bool))
(define t http-test)

(define (handle [r (ptr http-request)]) (http-static! r (& files)))

(routes mounted
  [#:mount ("site") handle])

;; The page of /dir/: an item's number, nothing at the top, and gone where no route matches.
(define (dir-page [r (ptr http-request)] [out (ptr buffer)] [page string] [to (ptr buffer)]) -> u32
  (let* ([a (make-arena)] [v inner] [read (inner.url-read (& a) (-> r target) "/dir" (& v) to)])
    (match v
      [(item n)
       (buffer-add-string! out "<p>item ")
       (write-digits out (cast u64 n) 10)
       (buffer-add-string! out "</p>")]
      [gone (buffer-add-string! out "<p>gone</p>")]
      [_ (begin)])
    (arena-free (& a))
    read))

;; The page of /dir/ for a path under /dir/ that names no file.
(define (dir-fallback [r (ptr http-request)] [f (ptr http-files)]) -> bool
  (unless (string-prefix? (url-path (-> r target)) "/dir/") (return #f))
  (http-send-file! r f "dir/index.html")
  #t)

(define (got [h (fn ((ptr http-request)))] [target string] [rendering bool] [falling bool]) -> i32
  (set! (-> files root) "tests/http/files")
  (set! (@ pages 0) (http-page #:path "dir/index.html" #:render dir-page))
  (set! (-> files pages) (slice pages (if rendering 1 0)))
  (set! (-> files fallback) (if falling dir-fallback none))
  (set! (-> server handle) h)
  (expect (http-test! (& t) (& server) "GET" target (slice (array-of string "accept" "*/*")) (cast (slice u8) "")))
  (http-test-status (& t)))

(test pages
  (expect-equal (got handle "/dir/" #t #f) 200)
  (expect-equal (cast string (http-test-body (& t))) "<p>index</p>\n")
  (expect-equal (got handle "/dir/index.html" #t #f) 301)
  (expect-equal (http-test-header (& t) "location") "/dir/")
  (expect-equal (got mounted "/site/dir/index.html" #t #f) 301)
  (expect-equal (http-test-header (& t) "location") "/site/dir/")
  (expect-equal (got handle "/page.html" #t #f) 200)
  (expect-equal (cast string (http-test-body (& t))) "<p>page</p>\n")
  (expect-equal (got handle "/dir/items/3/" #t #f) 404)
  (expect-equal (cast string (http-test-body (& t))) "not found")
  (http-test-free! (& t)))

(test fallback
  (expect-equal (got handle "/dir/items/3/" #t #t) 200)
  (expect-equal (http-test-header (& t) "content-type") "text/html; charset=utf-8")
  (expect-equal (http-test-header (& t) "cache-control") "no-cache")
  (expect-equal (cast string (http-test-body (& t))) "<p>item 3</p>")
  (expect-equal (got handle "/dir/nope" #t #t) 404)
  (expect-equal (cast string (http-test-body (& t))) "<p>gone</p>")
  (expect-equal (got handle "/dir/items/3?x=1" #t #t) 301)
  (expect-equal (http-test-header (& t) "location") "/dir/items/3/?x=1")
  (expect-equal (got mounted "/site/dir/items/3" #t #t) 301)
  (expect-equal (http-test-header (& t) "location") "/site/dir/items/3/")
  (expect-equal (got handle "/dir/any/path" #f #t) 200)
  (expect-equal (cast string (http-test-body (& t))) "<p>index</p>\n")
  (expect-equal (got handle "/elsewhere" #t #t) 404)
  (expect-equal (cast string (http-test-body (& t))) "not found")
  (expect-equal (got handle "/.hidden" #t #t) 404)
  (expect-equal (got handle "/digits.txt" #t #t) 200)
  (expect-equal (http-test-header (& t) "content-type") "text/plain; charset=utf-8")
  (http-test-free! (& t)))
