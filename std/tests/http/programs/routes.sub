;; Routes through the test client: precedence, typed and rest parameters, queries and bodies with their refusals, 404,
;; 405, HEAD, redirects to clean paths and final slashes, and handlers' URLs.
(require-unqualified events host/events)
(require-unqualified http std/http)
(require-unqualified server std/http/server)
(require-unqualified test std/http/test)
(require-unqualified json std/encoding/json)
(require-unqualified form std/http/form)
(require-unqualified route std/http/route)

(struct listing [page u32] [tag (ptr string)])
(struct package [name string] [version u32])
(struct login [user string] [password string] [remember bool])

(json package)
(form listing login)

(define (said [r (ptr http-request)] [text string]) (http-answer-text! r 200 text))

(define (told [r (ptr http-request)] [b (ptr buffer)])
  (http-answer-text! r 200 (buffer-string b))
  (buffer-free! b))

(define (home [r (ptr http-request)]) (said r "home"))
(define (new-page [r (ptr http-request)]) (said r "the new package page"))

(define (show-package [r (ptr http-request)] [name string] [q (ptr listing)])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) name)
    (buffer-add-string! (& b) " page ")
    (write-digits (& b) (-> q page) 10)
    (unless (== (-> q tag) 0)
      (buffer-add-string! (& b) " tag ")
      (buffer-add-string! (& b) (@ (-> q tag))))
    (told r (& b))))

(define (show-version [r (ptr http-request)] [name string] [version u32])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) name)
    (buffer-add-string! (& b) " version ")
    (write-digits (& b) version 10)
    (told r (& b))))

(define (upload [r (ptr http-request)] [name string] [version u32] [bytes (slice u8)])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "uploaded ")
    (buffer-add-string! (& b) (cast string bytes))
    (buffer-add-string! (& b) " as ")
    (buffer-add-string! (& b) name)
    (told r (& b))))

(define (create [r (ptr http-request)] [p (ptr package)])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "created ")
    (package.json-write! (& b) p)
    (told r (& b))))

(define (sign-in [r (ptr http-request)] [l (ptr login)])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) (-> l user))
    (buffer-add-string! (& b) (if (-> l remember) " signed in, remembered" " signed in"))
    (told r (& b))))

(define (file [r (ptr http-request)] [path string]) (said r path))

(define (by-id [r (ptr http-request)] [id u64])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "item ")
    (write-digits (& b) id 10)
    (told r (& b))))

(define (by-name [r (ptr http-request)] [name string]) (said r name))

(define (offset [r (ptr http-request)] [n i32]) (said r (if (< n 0) "a negative offset" "an offset")))

(define (docs [r (ptr http-request)]) (said r "the docs"))
(define (ping [r (ptr http-request)]) (said r "pong"))
(define (ping-head [r (ptr http-request)]) (http-answer-text! r 204 ""))

(routes app
  [GET () home]
  [GET ("packages" "new") new-page]
  [GET ("packages" [name string]) show-package (query listing)]
  [GET ("packages" [name string] "versions" [version u32]) show-version]
  [PUT ("packages" [name string] "versions" [version u32]) upload (body) (limit 10)]
  [POST ("packages") create (json package)]
  [POST ("login") sign-in (form login)]
  [GET ("files" [path string ...]) file]
  [GET ("items" [id u64]) by-id]
  [GET ("items" [name string]) by-name]
  [GET ("offset" [n i32]) offset]
  [GET ("docs" "") docs]
  [HEAD ("ping") ping-head]
  [GET ("ping") ping])

(define server http-server)
(define t http-test)
(define none (slice string) 0)

(define (header [name string])
  (let ([value (http-test-header (& t) name)])
    (unless (== (-> value length) 0) (printf " ~a ~a" name value))))

(define (sent [method string] [target string] [type string] [body string])
  (if (== (-> type length) 0)
      (http-test! (& t) (& server) method target none (cast (slice u8) body))
      (http-test! (& t) (& server) method target (slice (array-of string "content-type" type)) (cast (slice u8) body)))
  (printf "~a ~a: ~a" method target (http-test-status (& t)))
  (header "allow")
  (header "location")
  (when (== method "HEAD") (header "content-length"))
  (printf " ~s\n" (cast string (http-test-body (& t)))))

(define (got [target string]) (sent "GET" target "" ""))

(define (multipart) -> string
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "--b\r\ncontent-disposition: form-data; name=user\r\n\r\nbo\r\n")
    (buffer-add-string! (& b) "--b\r\ncontent-disposition: form-data; name=password\r\n\r\ny\r\n--b--\r\n")
    (buffer-string (& b))))

(define (url [b (ptr buffer)])
  (printf "url ~a\n" (buffer-string b))
  (set! (-> b length) 0))

(define (main)
  (let ([b (make-buffer)])
    (set! (-> server handle) app)
    (got "/")
    (got "/packages/new")
    (got "/packages/substrate?page=2&tag=x")
    (got "/packages/substrate?tag=x")
    (got "/packages/sub%20strate/versions/3")
    (got "/packages/x/versions/abc")
    (sent "PUT" "/packages/x/versions/3" "" "hello")
    (sent "PUT" "/packages/x/versions/3" "" "hello world")
    (sent "DELETE" "/packages/x/versions/3" "" "")
    (sent "POST" "/packages" "application/json; charset=utf-8" "{\"name\": \"a\", \"version\": 2}")
    (sent "POST" "/packages" "application/vnd.x+json" "{\"name\": \"a\", \"version\": -2}")
    (sent "POST" "/packages" "text/plain" "{}")
    (sent "POST" "/login" "application/x-www-form-urlencoded" "user=ann&password=x&remember=on")
    (sent "POST" "/login" "multipart/form-data; boundary=b" (multipart))
    (sent "POST" "/login" "application/x-www-form-urlencoded" "user=ann")
    (got "/files/a/b%20c/d")
    (got "/items/42")
    (got "/items/abc")
    (got "/offset/-5")
    (got "/docs?x=1")
    (sent "POST" "/docs?x=1" "" "")
    (got "/a/../packages//new")
    (sent "HEAD" "/packages/new" "" "")
    (sent "HEAD" "/ping" "" "")
    (got "/ping")
    (got "/nothing/here")
    (sent "POST" "/docs/" "" "")
    (http-test-free! (& t))
    (home.url! (& b))
    (url (& b))
    (show-version.url! (& b) "a b/c" 7)
    (url (& b))
    (file.url! (& b) "x y/z")
    (url (& b))
    (docs.url! (& b))
    (url (& b))
    (offset.url! (& b) -3)
    (url (& b))
    (by-id.url! (& b) 18446744073709551615)
    (url (& b))
    (buffer-free! (& b))))

