;; Compression through the test client: whole answers, ones left as they are, pieces, event streams, files whole and
;; piped, a range, HEAD, a 304, weak ETags, and Accept-Encoding's weights.
(require-unqualified host/events)
(require-unqualified host/fs)
(require-unqualified std/http)
(require-unqualified std/http/server)
(require-unqualified std/http/test)
(require-unqualified std/http/conditional)
(require-unqualified std/http/static)
(require-unqualified std/http/sse)
(require-unqualified std/compress/gzip)
(provide main)

(define server http-server)
(define t http-test)
(define files http-files)
(define stream sse-stream)
(define text buffer)

(define (lines! [b (ptr buffer)] [n u32])
  (for ([i u32 0]) (< i n) (+= i 1)
    (buffer-add-string! b "item ")
    (write-digits b (cast u64 (% (* i i) 997)) 10)
    (buffer-add-string! b " group ")
    (write-digits b (cast u64 (% i 17)) 10)
    (buffer-add-byte! b #\newline)))

(define (answer! [r (ptr http-request)] [type string] [body (slice u8)])
  (http-respond! r 200)
  (http-header! r "content-type" type)
  (http-send! r body))

(define (handle [r (ptr http-request)])
  (let ([target (-> r target)] [all (buffer-bytes (& text))])
    (cond [(== target "/text") (answer! r "text/plain; charset=utf-8" all)]
          [(== target "/short") (answer! r "text/plain; charset=utf-8" (slice all 0 1000))]
          [(== target "/png") (answer! r "image/png" all)]
          [(== target "/encoded")
           (http-respond! r 200)
           (http-header! r "content-type" "text/plain")
           (http-header! r "content-encoding" "br")
           (http-send! r all)]
          [(== target "/kept")
           (http-respond! r 200)
           (http-header! r "content-type" "application/json")
           (http-header! r "cache-control" "public, no-transform")
           (http-send! r all)]
          [(== target "/pieces")
           (http-respond! r 200)
           (http-header! r "content-type" "text/plain")
           (for ([i u32 0]) (< i 3) (+= i 1) (http-write! r (slice all (* i 10000) (* (+ i 1) 10000))))
           (http-finish! r)]
          [(or (== target "/events") (== target "/zipped-events"))
           (set! (-> stream compress) (== target "/zipped-events"))
           (when (sse-accept! (& stream) r)
             (for ([i u32 0]) (< i 50) (+= i 1) (sse-send! (& stream) "" "" "{\"item\": 1, \"group\": \"blue\"}"))
             (sse-close! (& stream)))]
          [(== target "/note")
           (unless (http-conditional! r "\"v1\"" 0.0) (answer! r "text/html" all))]
          [else (http-static! r (& files))])))

(define (header [name string])
  (let ([value (http-test-header (& t) name)])
    (unless (== (-> value length) 0) (printf " [~a: ~a]" name value))))

(define (shown [t (ptr http-test)] [what string])
  (let ([body (http-test-body t)] [out (make-buffer)])
    (printf "~a: ~a" what (http-test-status t))
    (header "content-encoding")
    (header "vary")
    (header "transfer-encoding")
    (header "accept-ranges")
    (header "content-range")
    (when (> (-> (http-test-header t "content-length") length) 0) (printf " [content-length]"))
    (let ([etag (http-test-header t "etag")])
      (unless (== (-> etag length) 0)
        (printf " [etag ~a]" (if (and (>= (-> etag length) 2) (== (slice etag 0 2) "W/")) "weak" "strong"))))
    (if (== (http-test-header t "content-encoding") "gzip")
        (let* ([why error] [ok (gunzip! (& out) body 10000000 (& why))])
          (printf " gunzipped: ~a, ~a bytes, smaller: ~a\n" (if ok "no error" (error-text (& why))) (-> out length)
                  (< (-> body length) (-> out length))))
        (printf " ~a bytes\n" (-> body length)))
    (buffer-free! (& out))))

(define (ask [method string] [target string] [accept string] [more string])
  (let ([list (array string 4)] [n u32 0])
    (unless (== (-> accept length) 0)
      (set! (@ list 0) "accept-encoding")
      (set! (@ list 1) accept)
      (set! n 2))
    (unless (== (-> more length) 0)
      (let ([k u32 0])
        (while (!= (@ more k) #\:) (+= k 1))
        (set! (@ list n) (slice more 0 k))
        (set! (@ list (+ n 1)) (http-trimmed (slice more (+ k 1))))
        (+= n 2)))
    (http-test! (& t) (& server) method target (slice list n) (cast (slice u8) ""))
    (let ([what (make-buffer)])
      (buffer-add-string! (& what) method)
      (buffer-add-byte! (& what) #\space)
      (buffer-add-string! (& what) target)
      (buffer-add-string! (& what) " (")
      (buffer-add-string! (& what) accept)
      (unless (== (-> more length) 0)
        (buffer-add-string! (& what) "; ")
        (buffer-add-string! (& what) more))
      (buffer-add-byte! (& what) #\))
      (shown (& t) (buffer-string (& what)))
      (buffer-free! (& what)))))

(define (piped [t (ptr http-test)])
  (shown t "GET /large.txt piped (gzip)")
  (http-test-free! t)
  (fs-remove (-> files root) #t 0))

(define (main [scratch string])
  (let ([dir string] [path (make-buffer)] [large (make-buffer)])
    (set! text (make-buffer))
    (lines! (& text) 2000)
    (set! (-> server compress) 6)
    (set! (-> server handle) handle)
    (fs-make-temp-dir scratch "gzip" "" (& dir) 0)
    (set! (-> files root) dir)
    (buffer-add-string! (& path) dir)
    (buffer-add-string! (& path) "/text.txt")
    (fs-write-file (buffer-string (& path)) (buffer-bytes (& text)) 0)
    (lines! (& large) 20000)
    (set! (-> path length) 0)
    (buffer-add-string! (& path) dir)
    (buffer-add-string! (& path) "/large.txt")
    (fs-write-file (buffer-string (& path)) (buffer-bytes (& large)) 0)
    (printf "the text: ~a bytes, the large file: ~a bytes\n" (-> text length) (-> large length))
    (ask "GET" "/text" "gzip" "")
    (ask "GET" "/text" "" "")
    (ask "GET" "/text" "gzip;q=0" "")
    (ask "GET" "/text" "identity" "")
    (ask "GET" "/text" "*" "")
    (ask "GET" "/text" "gzip;q=0, *" "")
    (ask "GET" "/text" "br, gzip;q=0.5" "")
    (ask "GET" "/text" "x-gzip" "")
    (ask "GET" "/text" "deflate, br" "")
    (ask "HEAD" "/text" "gzip" "")
    (ask "GET" "/short" "gzip" "")
    (ask "GET" "/png" "gzip" "")
    (ask "GET" "/encoded" "gzip" "")
    (ask "GET" "/kept" "gzip" "")
    (ask "GET" "/pieces" "gzip" "")
    (ask "GET" "/events" "gzip" "")
    (ask "GET" "/zipped-events" "gzip" "")
    (ask "GET" "/zipped-events" "" "")
    (ask "GET" "/note" "gzip" "")
    (ask "GET" "/note" "gzip" "if-none-match: W/\"v1\"")
    (ask "GET" "/text.txt" "gzip" "")
    (ask "GET" "/text.txt" "gzip" "range: bytes=0-99")
    (buffer-free! (& path))
    (buffer-free! (& large))
    (http-test-later! (& t) (& server) "GET" "/large.txt" (slice (array-of string "accept-encoding" "gzip"))
                      (cast (slice u8) "") piped)))
