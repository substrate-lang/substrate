;; Answers in pieces through the test client: chunks, declared lengths met, short and overrun, HEAD, 204, HTTP/1.0,
;; streams, a write after the answer, a trap mid-answer, and a client that leaves.
(require-unqualified host/events)
(require-unqualified host/modules/timer)
(require-unqualified host/fs)
(require-unqualified std/http)
(require-unqualified std/http/server)
(require-unqualified std/http/test)
(require-unqualified std/string)
(provide main)

(struct delay [head event-head] [request (ptr http-request)])

(define server http-server)
(define t http-test)
(define late delay)
(define zero i32 0)
(define none (slice string) 0)

(define (piece [r (ptr http-request)] [s string]) -> bool (http-write! r (cast (slice u8) s)))

(define (later [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([r (-> (cast (ptr delay) tag) request)])
    (piece r "b")
    (http-finish! r)))

(define (left [r (ptr http-request)])
  (printf "gone: ~a, and a write gives ~a\n" (-> r target) (piece r "x"))
  (http-finish! r))

(define (handle [r (ptr http-request)])
  (let ([path (-> r target)])
    (http-respond! r 200)
    (cond [(== path "/pieces")
           (piece r "one,")
           (piece r "two,")
           (http-finish! r)]
          [(== path "/sized")
           (http-length! r 8)
           (piece r "four")
           (piece r "four")
           (http-finish! r)]
          [(== path "/short")
           (http-length! r 10)
           (piece r "abc")
           (http-finish! r)]
          [(== path "/long")
           (http-length! r 2)
           (piece r "abc")]
          [(== path "/empty")
           (http-respond! r 204)
           (piece r "dropped")
           (http-finish! r)]
          [(== path "/later")
           (piece r "a")
           (set! (-> late request) r)
           (timer-after 1.0 (& late))]
          [(== path "/file")
           (let ([h u32 0] [s u32 0])
             (fs-open-file "tests/http/served/files/hello.txt" fs-read-flag (& h) 0)
             (fs-read-stream h 0 0 (& s) 0)
             (http-send-stream! r s -1))]
          [(== path "/twice")
           (http-send-text! r "once")
           (piece r "again")]
          [(== path "/trap")
           (piece r "a")
           (set! (-> r on-gone) left)
           (piece r (if (== (/ 1 zero) 0) "no" "no"))]
          [(== path "/leave")
           (piece r "a")
           (set! (-> r on-gone) left)]
          [else (http-answer-text! r 404 "not found")])))

(define (trapped [r (ptr http-request)] [why string])
  (printf "trapped: ~a ~a: ~a\n" (-> r method) (-> r target) (slice why 0 (string-index why #\newline))))

(define (header [name string])
  (let ([value (http-test-header (& t) name)])
    (unless (== (-> value length) 0) (printf " ~a ~a" name value))))

(define (shown [what string])
  (printf "~a: ~a ~s" what (http-test-status (& t)) (cast string (http-test-body (& t))))
  (header "transfer-encoding")
  (header "content-length")
  (header "connection")
  (printf "\n"))

(define (sent [method string] [target string])
  (unless (http-test! (& t) (& server) method target none 0) (printf "no answer yet: "))
  (shown target))

(define (came-later [t (ptr http-test)])
  (shown "/later")
  (http-test-later! t (& server) "GET" "/file" none 0 came-file))

(define (came-file [t (ptr http-test)])
  (shown "/file")
  (http-test-later! t (& server) "GET" "/twice" none 0 came-twice))

(define (came-twice [t (ptr http-test)])
  (shown "/twice")
  (http-test-later! t (& server) "GET" "/long" none 0 came-long))

(define (came-long [t (ptr http-test)])
  (shown "/long")
  (http-test-later! t (& server) "GET" "/trap" none 0 came-trap))

(define (came-trap [t (ptr http-test)])
  (shown "/trap")
  (sent "GET" "/leave")
  (http-test-free! t))

(define (main)
  (set! (-> late head handle) later)
  (set! (-> server handle) handle)
  (set! (-> server on-trap) trapped)
  (sent "GET" "/pieces")
  (sent "HEAD" "/pieces")
  (sent "GET" "/sized")
  (sent "GET" "/short")
  (sent "GET" "/empty")
  (unless (http-test-raw! (& t) (& server) (cast (slice u8) "GET /pieces HTTP/1.0\r\n\r\n") #f) (printf "no answer: "))
  (shown "HTTP/1.0")
  (http-test-later! (& t) (& server) "GET" "/later" none 0 came-later))
