;; Gzipped copies through the test client: a file with name.gz beside it, answered with the copy when the request takes
;; gzip and with the file when not, its validators, a range, HEAD, a file with no copy, and http-hashed-cache's paths.
(require-unqualified host/events)
(require-unqualified host/fs)
(require-unqualified std/http)
(require-unqualified std/http/server)
(require-unqualified std/http/test)
(require-unqualified std/http/static)
(require-unqualified std/compress/deflate)
(require-unqualified std/compress/gzip)
(provide main)

(define server http-server)
(define t http-test)
(define files http-files)
(define zipped-tag buffer)
(define plain-tag buffer)

(define (handle [r (ptr http-request)]) (http-static! r (& files)))

(define (written! [dir string] [name string] [b (slice u8)])
  (let ([path (make-buffer)])
    (buffer-add-string! (& path) dir)
    (buffer-add-byte! (& path) #\/)
    (buffer-add-string! (& path) name)
    (fs-write-file (buffer-string (& path)) b 0)
    (buffer-free! (& path))))

(define (header [name string])
  (let ([value (http-test-header (& t) name)])
    (unless (== (-> value length) 0) (printf " [~a: ~a]" name value))))

(define (ask [method string] [target string] [headers (slice string)])
  (http-test! (& t) (& server) method target headers (cast (slice u8) ""))
  (let ([body (http-test-body (& t))] [out (make-buffer)] [why error])
    (printf "~a ~a" method target)
    (for ([i u32 0]) (< i (-> headers length)) (+= i 2)
      (printf " ~a=~a" (@ headers i) (if (== (@ headers i) "if-none-match") "ETAG" (@ headers (+ i 1)))))
    (printf ": ~a" (http-test-status (& t)))
    (header "content-type")
    (header "content-encoding")
    (header "content-length")
    (header "accept-ranges")
    (header "vary")
    (header "cache-control")
    (if (and (> (-> body length) 0) (== (http-test-header (& t) "content-encoding") "gzip"))
        (printf " gunzipped to ~a bytes\n" (if (gunzip! (& out) body 1000000 (& why)) (-> out length) 0))
        (printf " ~a bytes\n" (-> body length)))
    (buffer-free! (& out))))

(define (main [scratch string])
  (let ([dir string] [text (make-buffer)] [zipped (make-buffer)] [d deflater] [none (slice (cast (ptr string) 0) 0)]
        [gzip (slice (array-of string "accept-encoding" "gzip"))] [tagged (array string 4)])
    (fs-make-temp-dir scratch "zipped" "" (& dir) 0)
    (for ([i u32 0]) (< i 200) (+= i 1) (buffer-add-string! (& text) "console.log('line');\n"))
    (deflater-init! (& d) 9)
    (gzip! (& d) (& zipped) (buffer-bytes (& text)) "")
    (written! dir "app.js" (buffer-bytes (& text)))
    (written! dir "app.js.gz" (buffer-bytes (& zipped)))
    (written! dir "plain.txt" (buffer-bytes (& text)))
    (set! (-> files root) dir)
    (set! (-> server handle) handle)
    (ask "GET" "/app.js" none)
    (buffer-add-string! (& plain-tag) (http-test-header (& t) "etag"))
    (ask "GET" "/app.js" gzip)
    (buffer-add-string! (& zipped-tag) (http-test-header (& t) "etag"))
    (printf "the tags differ: ~a\n" (!= (buffer-string (& plain-tag)) (buffer-string (& zipped-tag))))
    (set! (@ tagged 0) "accept-encoding")
    (set! (@ tagged 1) "gzip")
    (set! (@ tagged 2) "if-none-match")
    (set! (@ tagged 3) (buffer-string (& zipped-tag)))
    (ask "GET" "/app.js" (slice tagged))
    (set! (@ tagged 3) (buffer-string (& plain-tag)))
    (ask "GET" "/app.js" (slice tagged))
    (ask "GET" "/app.js" (slice (array-of string "accept-encoding" "gzip" "range" "bytes=0-4")))
    (ask "GET" "/app.js" (slice (array-of string "range" "bytes=0-4")))
    (ask "HEAD" "/app.js" gzip)
    (ask "GET" "/app.js" (slice (array-of string "accept-encoding" "gzip;q=0")))
    (ask "GET" "/app.js.gz" none)
    (ask "GET" "/plain.txt" gzip)
    (let ([paths (array-of string "0123456789abcdef/host/web/start.mjs" "assets/0123456789abcdef/sprites.png"
                           "assets/sprites.png" "0123456789ABCDEF/start.mjs" "0123456789abcde/start.mjs"
                           "0123456789abcdef" "index.html")])
      (for ([i u32 0]) (< i 7) (+= i 1) (printf "~s: ~s\n" (@ paths i) (http-hashed-cache (@ paths i)))))
    (http-test-free! (& t))
    (fs-remove dir #t 0)))
