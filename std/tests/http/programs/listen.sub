;; A server listening on ::, every address, reached over IPv4, whose client's address comes as 1.2.3.4 rather than
;; ::ffff:1.2.3.4, and over IPv6; then a second server on its port, which fails because the port is in use.
(require-unqualified host/events)
(require-unqualified host/stream)
(require-unqualified host/node/net)
(require-unqualified std/http)
(require-unqualified std/http/server)
(provide main)

(struct side [head event-head] [to string] [in (array u8 1024)] [got buffer])

(define server http-server)
(define other http-server)
(define c side)

(define (handle [r (ptr http-request)]) (http-answer-text! r 200 (http-request-address r)))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (cond [(== kind net-connected)
         (stream-write-text id "GET / HTTP/1.1\r\nhost: x\r\nconnection: close\r\n\r\n")
         (stream-read! id (slice (-> c in)))]
        [(and (== kind stream-read) (> value 0))
         (buffer-add! (& (-> c got)) (slice (-> c in) (cast u32 value)))
         (stream-read! id (slice (-> c in)))]
        [(or (== kind stream-read) (== kind stream-failed) (== kind net-failed))
         (let* ([got (buffer-string (& (-> c got)))] [i u32 0])
           (while (and (< (+ i 4) (-> got length)) (!= (slice got i (+ i 4)) "\r\n\r\n")) (+= i 1))
           (printf "over ~a: ~a\n" (-> c to) (if (< (+ i 4) (-> got length)) (slice got (+ i 4)) "no answer")))
         (stream-close id)
         (set! (-> c got length) 0)
         (if (== (-> c to) "127.0.0.1")
             (begin
               (set! (-> c to) "::1")
               (net-connect (-> server port) "::1" #f (& c) 0 0))
             (begin
               (set! (-> other host) "::")
               (set! (-> other listening) taken)
               (http-serve! (& other) (-> server port) handle 0)))]))

(define (listening [s (ptr http-server)])
  (if (== (-> s port) 0)
      (printf "not listening: ~a\n" (error-text (& (-> s problem))))
      (net-connect (-> s port) "127.0.0.1" #f (& c) 0 0)))

(define (taken [s (ptr http-server)])
  (if (== (-> s port) 0)
      (printf "a second server on its port: ~a\n"
              (if (== (-> s problem code) error-in-use) "in use" (error-text (& (-> s problem)))))
      (begin
        (printf "a second server on its port: listening\n")
        (http-server-close! s)))
  (http-server-close! (& server)))

(define (main)
  (set! (-> c head handle) heard)
  (set! (-> c to) "127.0.0.1")
  (set! (-> c got) (make-buffer))
  (set! (-> server host) "::")
  (set! (-> server listening) listening)
  (http-serve! (& server) 0 handle 0))
