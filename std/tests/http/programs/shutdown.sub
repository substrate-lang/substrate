;; Shutdown with four clients, each ended its own way: idle, mid-request, on an event stream, on a WebSocket; a later
;; client is refused.
(require-unqualified events host/events)
(require-unqualified stream host/stream)
(require-unqualified net host/node/net)
(require-unqualified timer host/modules/timer)
(require-unqualified http std/http)
(require-unqualified server std/http/server)
(require-unqualified sse std/http/sse)
(require-unqualified ws std/http/websocket)
(provide main)

(struct side [head event-head] [stream u32] [in (array u8 4096)] [got buffer] [ended bool])

(struct later [head event-head] [request (ptr http-request)])

(define server http-server)
(define idle side)
(define slow side)
(define events side)
(define sock side)
(define late side)
(define delay later)
(define es sse-stream)
(define socket ws-connection)
(define left u32 6)
(define shut bool #f)
(define refused bool #f)
(define stream-told bool #f)
(define socket-code i32 0)
(define close-code i32 0)

;; ---- the server ----

(define (answer-slow [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (http-answer-text! (-> delay request) 200 "slow"))

(define (stream-closed [s (ptr sse-stream)]) (set! stream-told #t))

(define (socket-closed [w (ptr ws-connection)] [code i32])
  (set! socket-code code)
  (one-done!))

(define (handle [r (ptr http-request)])
  (let ([path (-> r target)])
    (cond [(== path "/slow")
           (set! (-> delay request) r)
           (timer-after 1000.0 (& delay))]
          [(== path "/events")
           (when (sse-accept! (& es) r)
             (set! (-> es on-closed) stream-closed)
             (sse-send! (& es) "" "" "open"))]
          [(== path "/ws")
           (when (ws-accept! (& socket) r "") (set! (-> socket on-closed) socket-closed))]
          [else (http-answer-text! r 200 "ok")])))

(define (stopped [s (ptr http-server)]) (one-done!))

;; ---- the clients ----

(define (got [s (ptr side)]) -> string (buffer-string (& (-> s got))))

(define (has? [s (ptr side)] [text string]) -> bool
  (let ([g (got s)] [n (-> text length)])
    (for ([i u32 0]) (<= (+ i n) (-> g length)) (+= i 1) (when (== (slice g i (+ i n)) text) (return #t)))
    #f))

(define (one-done!)
  (-= left 1)
  (when (== left 0)
    (printf "idle: closed ~a\n" (-> idle ended))
    (printf "slow: answered ~a, with connection: close ~a\n" (has? (& slow) "slow") (has? (& slow) "connection: close"))
    (printf "events: the stream's end came ~a, and the server's code was told ~a\n" (has? (& events) "\r\n0\r\n\r\n")
            stream-told)
    (printf "websocket: closed with ~a, which the server's code was told: ~a\n" close-code socket-code)
    (printf "a client after the shutdown: refused ~a\n" refused)
    (printf "the server: stopped\n")))

(define (connect! [s (ptr side)]) (net-connect (-> server port) "127.0.0.1" #f s 0))

(define (ready [s (ptr side)])
  (cond [(and (== s (& idle)) (has? s "ok")) (connect! (& slow))]
        [(and (== s (& events)) (has? s "data: open") (== (-> sock stream) 0)) (connect! (& sock))]
        [(and (== s (& sock)) (== close-code 0) (> (-> sock got length) 0) (has? s "\r\n\r\n"))
         (let* ([g (got s)] [i u32 0])
           (while (and (< i (-> g length)) (!= (@ g i) 136)) (+= i 1))
           (cond [(< (+ i 3) (-> g length))
                  (set! close-code (bit-or (<< (cast i32 (@ g (+ i 2))) 8) (cast i32 (@ g (+ i 3)))))
                  (stream-write (-> s stream) (slice (array-of u8 136 130 0 0 0 0 3 233) 8))]
                 [(not shut)
                  (set! shut #t)
                  (http-server-shutdown! (& server) 5000.0 stopped)
                  (connect! (& late))]))]))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([s (cast (ptr side) tag)])
    (cond [(== kind net-connected)
           (set! (-> s stream) id)
           (stream-read! id (slice (-> s in)))
           (cond [(== s (& slow))
                  (stream-write-text id "GET /slow HTTP/1.1\r\nhost: 127.0.0.1\r\n\r\n")
                  (connect! (& events))]
                 [(== s (& events)) (stream-write-text id "GET /events HTTP/1.1\r\nhost: 127.0.0.1\r\n\r\n")]
                 [(== s (& sock))
                  (stream-write-text id "GET /ws HTTP/1.1\r\nhost: 127.0.0.1\r\nupgrade: websocket\r\n")
                  (stream-write-text id "connection: upgrade\r\nsec-websocket-version: 13\r\n")
                  (stream-write-text id "sec-websocket-key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n")]
                 [(== s (& late)) (printf "a client after the shutdown: connected\n")]
                 [else (stream-write-text id "GET / HTTP/1.1\r\nhost: 127.0.0.1\r\n\r\n")])]
          [(== kind net-failed)
           (free (-> (events-take) items))
           (set! refused #t)
           (one-done!)]
          [(and (== kind stream-read) (> value 0))
           (buffer-add! (& (-> s got)) (slice (-> s in) (cast u32 value)))
           (ready s)
           (stream-read! id (slice (-> s in)))]
          [(or (== kind stream-read) (== kind stream-failed))
           (set! (-> s ended) #t)
           (stream-close id)
           (unless (== s (& sock)) (one-done!))])))

(define (listening [s (ptr http-server)]) (connect! (& idle)))

(define (main)
  (for ([i u32 0]) (< i 5) (+= i 1)
    (let ([s (@ (array-of (ptr side) (& idle) (& slow) (& events) (& sock) (& late)) i)])
      (set! (-> s head handle) heard)
      (set! (-> s got) (make-buffer))))
  (set! (-> delay head handle) answer-slow)
  (set! (-> server idle-timeout) 10000.0)
  (set! (-> server listening) listening)
  (http-serve! (& server) 0 handle))
