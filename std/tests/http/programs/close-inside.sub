;; A handler that closes its own server over a socket: its connection ends once the parser is done with it, and a
;; client that comes after is refused.
(require-unqualified host/events)
(require-unqualified host/stream)
(require-unqualified host/node/net)
(require-unqualified std/http)
(require-unqualified std/http/server)
(provide main)

(struct side [head event-head] [in (array u8 1024)] [got u32])

(define server http-server)
(define c side)
(define after side)

(define (handle [r (ptr http-request)])
  (http-server-close! (& server))
  (http-answer-text! r 200 "closed")
  (printf "server: closed from a handler, which goes on\n"))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([s (cast (ptr side) tag)])
    (cond [(and (== s (& after)) (== kind net-failed))
           (free (-> (events-take) items))
           (printf "a client after: refused\n")]
          [(== kind net-connected)
           (stream-write-text id "GET /quit HTTP/1.1\r\nhost: 127.0.0.1\r\n\r\n")
           (stream-read! id (slice (-> s in)))]
          [(and (== kind stream-read) (> value 0))
           (+= (-> s got) (cast u32 value))
           (stream-read! id (slice (-> s in)))]
          [(or (== kind stream-read) (== kind stream-failed))
           (printf "client: the connection ended\n")
           (stream-close id)
           (net-connect (-> server port) "127.0.0.1" #f (& after) 0)])))

(define (listening [s (ptr http-server)]) (net-connect (-> s port) "127.0.0.1" #f (& c) 0))

(define (main)
  (set! (-> c head handle) heard)
  (set! (-> after head handle) heard)
  (set! (-> server listening) listening)
  (http-serve! (& server) 0 handle))
