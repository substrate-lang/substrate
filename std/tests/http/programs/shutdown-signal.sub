;; A server shut down by SIGTERM, given 300 ms to finish, with a WebSocket whose client never answers the close: the
;; close comes with 1001, the server ends the WebSocket once the time is up, then stops and exits.
(require-unqualified host/events)
(require-unqualified host/stream)
(require-unqualified host/node/net)
(require-unqualified host/node/process)
(require-unqualified std/http)
(require-unqualified std/http/server)
(require-unqualified std/http/websocket)

(struct side [head event-head] [in (array u8 1024)] [upgraded bool])

(define server http-server)
(define socket ws-connection)
(define c side)
(define child event-head)

(define (closed [w (ptr ws-connection)] [code i32]) (printf "server: the websocket ended, ~a\n" code))

(define (handle [r (ptr http-request)]) (when (ws-accept! (& socket) r "") (set! (-> socket on-closed) closed)))

(define (stopped [s (ptr http-server)])
  (printf "server: stopped\n")
  (host-exit 0 ""))

(define (exited [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32]) (return))

(define (term!)
  (let ([pid (make-buffer)] [id u32 0])
    (write-digits (& pid) (cast u64 (process-pid)) 10)
    (process-spawn "kill" (slice (array-of string "-TERM" (buffer-string (& pid)))) 0 (& child) (& id) 0)))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (cond [(and (== source net-source) (== kind net-connected))
         (stream-write-text id "GET / HTTP/1.1\r\nhost: 127.0.0.1\r\nupgrade: websocket\r\nconnection: upgrade\r\n")
         (stream-write-text id "sec-websocket-version: 13\r\nsec-websocket-key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n")
         (stream-read! id (slice (-> c in)))]
        [(and (== kind stream-read) (> value 0))
         (cond [(not (-> c upgraded))
                (set! (-> c upgraded) #t)
                (printf "client: upgraded\n")
                (term!)]
               [(== (@ (-> c in) 0) 136)
                (printf "client: the server's close came, ~a, and is not answered\n"
                        (bit-or (<< (cast i32 (@ (-> c in) 2)) 8) (cast i32 (@ (-> c in) 3))))])
         (stream-read! id (slice (-> c in)))]))

(define (listening [s (ptr http-server)]) (let ([id u32 0]) (net-connect (-> s port) "127.0.0.1" #f (& c) (& id) 0)))

(define (main)
  (set! (-> c head handle) heard)
  (set! (-> child handle) exited)
  (set! (-> server listening) listening)
  (http-stop-on-signals! (& server) 300.0 stopped)
  (http-serve! (& server) 0 handle 0))
