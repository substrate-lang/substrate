;; An HTTP server over TLS with the granted certificate, asked for a file by a connection that trusts it.
(require-unqualified events host/events)
(require-unqualified stream host/stream)
(require-unqualified net host/node/net)
(require-unqualified http std/http)
(require-unqualified server std/http/server)

(struct client [head event-head] [parser http-parser] [in (array u8 4096)])

(define server http-server)
(define asking client)

(define (handle [r (ptr http-request)])
  (printf "server: ~a ~a\n" (-> r method) (-> r target))
  (http-respond! r 200)
  (http-header! r "content-type" "text/plain")
  (http-send-text! r "secure hello\n"))

(define (head [p (ptr http-parser)]) (printf "client: ~a\n" (-> p head status)))

(define (body [p (ptr http-parser)] [b (slice u8)])
  (printf "client: ")
  (host-write 1 b))

(define (end [p (ptr http-parser)])
  (printf "client: end\n")
  (http-server-close! (& server)))

(define (client-heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([c (cast (ptr client) tag)])
    (cond [(and (== source net-source) (== kind net-connected))
           (stream-write-text id "GET /hello.txt HTTP/1.1\r\nHost: localhost\r\n\r\n")
           (stream-read! id (slice (-> c in)))]
          [(and (== source net-source) (== kind net-failed))
           (let ([why (events-take-text)])
             (printf "client: failed ~a: ~a\n" value why)
             (free (-> why bytes)))]
          [(and (== kind stream-read) (> value 0))
           (http-feed! (& (-> c parser)) (slice (-> c in) (cast u32 value)))
           (stream-read! id (slice (-> c in)))]
          [(== kind stream-read) (stream-close id)]
          [(== kind stream-failed)
           (let ([why (events-take-text)])
             (printf "client: stream failed ~a: ~a\n" value why)
             (free (-> why bytes)))])))

(define (listening [s (ptr http-server)])
  (printf "listening\n")
  (net-connect (-> s port) "127.0.0.1" #t (& asking) 0))

(define (main)
  (set! (-> asking head handle) client-heard)
  (http-parser-init! (& (-> asking parser)) (cast (ptr void) (& asking)) head body end)
  (set! (-> server secure) #t)
  (set! (-> server listening) listening)
  (http-serve! (& server) 0 handle))
