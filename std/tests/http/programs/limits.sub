;; A server that allows one connection and 200 ms for a head closes a second connection at once, and the first, which
;; sends nothing, after 200 ms.
(require-unqualified events host/events)
(require-unqualified stream host/stream)
(require-unqualified net host/node/net)
(require-unqualified http std/http)
(require-unqualified server std/http/server)
(provide main)

(struct side [head event-head] [name string] [in (array u8 64)])

(define server http-server)
(define a side)
(define b side)

(define (handle [r (ptr http-request)]) (printf "server: a request\n"))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([s (cast (ptr side) tag)])
    (cond [(and (== source net-source) (== kind net-connected))
           (printf "~a: connected\n" (-> s name))
           (stream-read! id (slice (-> s in)))
           (when (== s (& a)) (net-connect (-> server port) "127.0.0.1" #f (& b) 0))]
          [(and (== source net-source) (== kind net-failed))
           (let ([why (events-take-text)])
             (printf "~a: failed ~a: ~a\n" (-> s name) value why)
             (free (-> why bytes)))]
          [(and (== kind stream-read) (> value 0)) (printf "~a: ~a bytes\n" (-> s name) value)]
          [(== kind stream-read)
           (printf "~a: end\n" (-> s name))
           (stream-close id)
           (when (== s (& a)) (http-server-close! (& server)))]
          [(== kind stream-failed)
           (let ([why (events-take-text)])
             (printf "~a: stream failed ~a: ~a\n" (-> s name) value why)
             (free (-> why bytes)))])))

(define (listening [s (ptr http-server)])
  (printf "listening\n")
  (net-connect (-> s port) "127.0.0.1" #f (& a) 0))

(define (main)
  (set! (-> a head handle) heard)
  (set! (-> a name) "a")
  (set! (-> b head handle) heard)
  (set! (-> b name) "b")
  (set! (-> server head-timeout) 200.0)
  (set! (-> server most) 1)
  (set! (-> server listening) listening)
  (http-serve! (& server) 0 handle))
