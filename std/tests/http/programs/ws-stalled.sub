;; A WebSocket client that sends but never reads: the server stops reading it, pings it, and ends it.
(require-unqualified host/events)
(require-unqualified host/stream)
(require-unqualified host/node/net)
(require-unqualified host/modules/timer)
(require-unqualified host/modules/clock)
(require-unqualified std/http)
(require-unqualified std/http/server)
(require-unqualified std/http/websocket)
(provide main)

(struct side [head event-head] [stream u32] [sent u32])

(define server http-server)
(define socket ws-connection)
(define c side)
(define tick event-head)
(define big (ptr u8) 0)
(define ended bool #f)
(define accepted f64 0.0)

(define (closed [w (ptr ws-connection)] [code i32])
  (set! ended #t)
  (printf "server: the websocket ended, ~a, ~a\n" code
          (if (and (> (-> c sent) 0) (>= (- (clock-monotonic) accepted) 200.0))
              "once its ping went unanswered, after the client sent messages it could not read"
              "too soon"))
  (stream-close (-> c stream))
  (http-server-close! (& server)))

(define (handle [r (ptr http-request)])
  (when (ws-accept! (& socket) r "")
    (set! accepted (clock-monotonic))
    (set! (-> socket ping) 200.0)
    (set! (-> socket on-closed) closed)
    (set! (-> socket on-drained) more)))

(define (more [w (ptr ws-connection)])
  (while (== (ws-send! w (slice big 1048576) ws-binary) 0) (begin)))

(define (ticked [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (unless ended
    (when (== (-> c sent) 0) (more (& socket)))
    (stream-write (-> c stream) (slice (array-of u8 129 129 1 2 3 4 121) 7))
    (+= (-> c sent) 1)
    (if (< (-> c sent) 60)
        (timer-after 50.0 (& tick))
        (printf "the websocket is still open after 3 s\n"))))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (and (== source net-source) (== kind net-connected))
    (set! (-> c stream) id)
    (stream-write-text id "GET / HTTP/1.1\r\nhost: 127.0.0.1\r\nupgrade: websocket\r\nconnection: upgrade\r\n")
    (stream-write-text id "sec-websocket-version: 13\r\nsec-websocket-key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n")
    (timer-after 100.0 (& tick))))

(define (listening [s (ptr http-server)]) (net-connect (-> s port) "127.0.0.1" #f (& c) 0))

(define (main)
  (set! big (cast (ptr u8) (calloc 1048576 1)))
  (set! (-> c head handle) heard)
  (set! (-> tick handle) ticked)
  (set! (-> server listening) listening)
  (http-serve! (& server) 0 handle))
