"/a/b" "x=1?y"
"/a" ""
"a%20b%2fc" -> "a b/c"
"a+b" -> "a b"
"a+b" -> "a+b"
"100%25 %zz %4 %" -> "100% %zz %4 %"
"%e2%82%ac" -> "€"
"/" -> (0)
"/a" -> "a" (0)
"/a/" -> "a" "" (0)
