;; Routes as a type: paths and URLs read into values, with their parameters and queries, a mounted table, the paths that
;; move, miss or cannot be read, paths read after a base, and each value's target written back.
(require-unqualified std/test/test)
(require-unqualified std/http/form)
(require-unqualified std/http/routable)

(struct search-query [q string] [page (ptr u32)])

(form search-query)

(routable chapter #:missing no-chapter
  [contents ()]
  [page ([n u32] "")]
  [find ("find" "") (query search-query)])

(routable place #:missing lost
  [home ()]
  [snake ("snake" "")]
  [user ("users" [id u64] "")]
  [step ("steps" [n i8])]
  [doc ("docs" [path string ...])]
  [search ("search" "") (query search-query)]
  [manual ("manual") (mount chapter)]
  [#:moved ("play" "snake" "") snake]
  [#:moved ("u" [id u64]) user])

(define a arena)

(define (searched [query (ptr search-query)])
  (printf "~s ~a" (-> query q) (if (== (-> query page) 0) 0 (@ (-> query page)))))

(define (shown [p (ptr place)])
  (match p
    [home (printf "home")]
    [snake (printf "snake")]
    [(user id) (printf "user ~a" id)]
    [(step n) (printf "step ~a" n)]
    [(doc path) (printf "doc ~s" path)]
    [(search query) (printf "search ") (searched (& query))]
    [(manual at)
     (printf "manual ")
     (match (& at)
       [contents (printf "contents")]
       [(page n) (printf "page ~a" n)]
       [(find query) (printf "find ") (searched (& query))]
       [no-chapter (printf "no chapter")])]
    [lost (printf "lost")]))

(define (read-under [base string] [url string])
  (let ([p place lost] [to (make-buffer)] [written (make-buffer)])
    (if (== base "") (printf "~s -> " url) (printf "~s in ~s -> " url base))
    (case (place.url-read (& a) url base (& p) (& to))
      [(0) (printf "found ")]
      [(1) (printf "moved to ~s, " (buffer-string (& to)))]
      [(2) (printf "missing ")]
      [else (printf "bad ")])
    (shown (& p))
    (place.url-write! (& written) (& p))
    (printf ", written ~s, checked ~a\n" (buffer-string (& written)) (place.url-check (& a) url base 0))
    (buffer-free! (& to))
    (buffer-free! (& written))))

(define (read [url string]) (read-under "" url))

(define (main)
  (read "/")
  (read "/snake/")
  (read "/users/7/")
  (read "/steps/-3")
  (read "/docs/a/b%20c/d")
  (read "/search/?q=cats&page=2")
  (read "/search/?q=a%26b")
  (read "http://example.com/users/12/?x=1#top")
  (read "/snake")
  (read "/users/7?x=1")
  (read "/a/../snake/")
  (read "/play/snake/")
  (read "/u/9?x=1")
  (read "/nope")
  (read "/users/x/")
  (read "/steps/200")
  (read "/search/?page=2")
  (read "nope")
  (read "/manual/")
  (read "/manual/3/?x=1")
  (read "/manual/3")
  (read "/manual")
  (read "/manual/a/")
  (read "/manual/find/?q=x")
  (read "/manual/find/?page=2")
  (read-under "/app" "/app/")
  (read-under "/app" "/app/users/7/")
  (read-under "/app" "http://example.com/app/manual/3/?x=1")
  (read-under "/app" "/app/users/7?x=1")
  (read-under "/app" "/app/a/../snake/")
  (read-under "/app" "/app/play/snake/")
  (read-under "/app" "/app/manual/3")
  (read-under "/app" "/app/manual")
  (read-under "/app" "/app/manual/a/")
  (read-under "/app" "/users/7/")
  (read-under "/app" "/app")
  (read-under "/app" "/apps/users/7/")
  (read-under "/app" "/app/../snake/")
  (arena-free (& a)))

(test routable (expect-output-file "routable.out" (main)))
