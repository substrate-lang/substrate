;; Routes as a type: paths and URLs read into values, with their parameters and queries, the paths that move, miss or
;; cannot be read, and each value's target written back.
(require-unqualified std/test/test)
(require-unqualified std/http/form)
(require-unqualified std/http/routable)

(struct search-query [q string] [page (ptr u32)])

(form search-query)

(routable place #:missing lost
  [home ()]
  [snake ("snake" "")]
  [user ("users" [id u64] "")]
  [step ("steps" [n i8])]
  [doc ("docs" [path string ...])]
  [search ("search" "") (query search-query)]
  [#:moved ("play" "snake" "") snake]
  [#:moved ("u" [id u64]) user])

(define a arena)

(define (shown [p (ptr place)])
  (match p
    [home (printf "home")]
    [snake (printf "snake")]
    [(user id) (printf "user ~a" id)]
    [(step n) (printf "step ~a" n)]
    [(doc path) (printf "doc ~s" path)]
    [(search query) (printf "search ~s ~a" (-> query q) (if (== (-> query page) 0) 0 (@ (-> query page))))]
    [lost (printf "lost")]))

(define (read [url string])
  (let ([p place lost] [to (make-buffer)] [written (make-buffer)])
    (printf "~s -> " url)
    (case (place.url-read (& a) url (& p) (& to))
      [(0) (printf "found ")]
      [(1) (printf "moved to ~s, " (buffer-string (& to)))]
      [(2) (printf "missing ")]
      [else (printf "bad ")])
    (shown (& p))
    (place.url-write! (& written) (& p))
    (printf ", written ~s, checked ~a\n" (buffer-string (& written)) (place.url-check (& a) url 0))
    (buffer-free! (& to))
    (buffer-free! (& written))))

(define (main)
  (read "/")
  (read "/snake/")
  (read "/users/7/")
  (read "/steps/-3")
  (read "/docs/a/b%20c/d")
  (read "/search/?q=cats&page=2")
  (read "/search/?q=a%26b")
  (read "http://example.com/users/12/?x=1#top")
  (read "/snake")
  (read "/users/7?x=1")
  (read "/a/../snake/")
  (read "/play/snake/")
  (read "/u/9?x=1")
  (read "/nope")
  (read "/users/x/")
  (read "/steps/200")
  (read "/search/?page=2")
  (read "nope")
  (arena-free (& a)))

(test routable (expect-output-file "routable.out" (main)))
