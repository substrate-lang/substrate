;; Routes that overlap with neither more specific are refused.
(require-unqualified std/http)
(require-unqualified std/http/server)
(require-unqualified std/http/route)

(define (f [r (ptr http-request)] [x string]) (http-finish! r))
(define (g [r (ptr http-request)] [y string]) (http-finish! r))

(routes app
  [GET ("a" [x string]) f]
  [GET ([y string] "b") g])

(define (main) (begin))
