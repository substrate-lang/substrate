;; A route that reads JSON into a type needs the type's json definitions first.
(require-unqualified std/http)
(require-unqualified std/http/server)
(require-unqualified std/encoding/json)
(require-unqualified std/http/route)

(struct point [x i32] [y i32])

(define (f [r (ptr http-request)] [p (ptr point)]) (http-finish! r))

(routes app
  [POST ("points") f (json point)])

(define (main) (begin))
