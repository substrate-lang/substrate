;; A route that reads JSON into a type needs the type's json definitions first.
(require-unqualified http std/http)
(require-unqualified server std/http/server)
(require-unqualified json std/encoding/json)
(require-unqualified route std/http/route)

(struct point [x i32] [y i32])

(define (f [r (ptr http-request)] [p (ptr point)]) (http-finish! r))

(routes app
  [POST ("points") f (json point)])

(define (main) (begin))
