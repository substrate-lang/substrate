;; Two routes that match the same requests are refused.
(require-unqualified std/http)
(require-unqualified std/http/server)
(require-unqualified std/http/route)

(define (f [r (ptr http-request)] [x u16]) (http-finish! r))
(define (g [r (ptr http-request)] [y u16]) (http-finish! r))

(routes app
  [GET ("a" [x u16]) f]
  [GET ("a" [y u16]) g])

(define (main) (begin))
