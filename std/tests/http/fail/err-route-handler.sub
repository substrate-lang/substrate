;; A handler that does not take what its route gives is a type error.
(require-unqualified http std/http)
(require-unqualified server std/http/server)
(require-unqualified route std/http/route)

(define (f [r (ptr http-request)] [n u32]) (http-finish! r))

(routes app
  [GET ("a" [name string]) f])

(define (main) (begin))
