;; A route that overlaps a mount must be within the mount's path.
(require-unqualified std/http)
(require-unqualified std/http/server)
(require-unqualified std/http/route)

(define (f [r (ptr http-request)] [x string]) (http-finish! r))
(define (g [r (ptr http-request)]) (http-finish! r))

(routes app
  [GET ([x string] "users") f]
  [#:mount ("api") g])

(define (main) (begin))
