;; multipart/form-data: boundaries, parts, files and their names, a nameless part, an empty file, and malformed bodies.
(require-unqualified tests std/test/test)
(require-unqualified http std/http)
(require-unqualified multipart std/http/multipart)

(define a arena)

(define (boundary [content-type string]) (printf "~s -> ~s\n" content-type (multipart-boundary (& a) content-type)))

(define (lines [parts (slice string)]) -> (slice u8)
  (let ([b (make-buffer)])
    (for ([i u32 0]) (< i (-> parts length)) (+= i 1)
      (buffer-add-string! (& b) (@ parts i))
      (buffer-add-string! (& b) "\r\n"))
    (buffer-bytes (& b))))

(define (parsed [body (slice u8)])
  (let ([parts (slice multipart-part)] [why string])
    (unless (multipart-parse (& a) body "XyZ" (& parts) (& why))
      (printf "refused: ~a\n" why)
      (return))
    (printf "~a parts\n" (-> parts length))
    (for ([i u32 0]) (< i (-> parts length)) (+= i 1)
      (let ([p (+ (-> parts items) i)])
        (printf "~s file ~a ~s ~s: ~s\n" (-> p name) (-> p file) (-> p filename) (-> p type)
                (cast string (-> p bytes)))))))

(define (main)
  (boundary "multipart/form-data; boundary=abc")
  (boundary "Multipart/Form-Data ; charset=utf-8; BOUNDARY=\"a b\\\"c\"")
  (boundary "text/plain; boundary=abc")
  (boundary "multipart/form-data")
  (printf "~s\n" (http-media-parameter (& a) "text/plain;charset=utf-8 ; format=flowed" "format"))
  (printf "~a ~a\n" (http-media-type? " Application/JSON ; charset=utf-8" "application/json")
          (http-media-type? "application/jsonx" "application/json"))
  (parsed (lines (slice (array-of string
                   "a preamble" "--XyZ"
                   "Content-Disposition: form-data; name=\"title\"" "" "Hello, world"
                   "--XyZ  "
                   "content-disposition: form-data; name=\"upload\"; filename=\"C:\\\\docs\\\\notes.txt\""
                   "Content-Type: text/plain; charset=utf-8" "" "line one" "line two"
                   "--XyZ"
                   "Content-Disposition: form-data; name=\"photo\"; filename=\"x\"; filename*=UTF-8''caf%C3%A9.png"
                   "Content-Type: image/png" "" "PNG"
                   "--XyZ"
                   "Content-Disposition: attachment; filename=\"no-name.txt\"" "" "skipped"
                   "--XyZ"
                   "Content-Disposition: form-data; name=\"empty\"; filename=\"\""
                   "Content-Type: application/octet-stream" "" ""
                   "--XyZ--" "an epilogue"))))
  (parsed (lines (slice (array-of string "--XyZ" "" "no head" "--XyZ--"))))
  (parsed (lines (slice (array-of string "--XyZ--"))))
  (parsed (lines (slice (array-of string "nothing here"))))
  (parsed (lines (slice (array-of string "--XyZ" "Content-Disposition: form-data; name=\"a\"" "" "never closed"))))
  (parsed (lines (slice (array-of string "--XyZ" "Content-Disposition: form-data; name=\"a\""))))
  (parsed (lines (slice (array-of string "--XyZ junk"))))
  (arena-free (& a)))

(test multipart (expect-output-file "multipart.out" (main)))
