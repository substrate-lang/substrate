;; Hash maps: setting and reading, keys the map does not hold, string keys, growing, removing keys from runs of
;; neighbors, each key and value in turn, and pointer keys.
(require-unqualified std/test/test)
(require-unqualified std/hash-map)

(struct point [x i32] [y i32])

(test set-and-ref
  (let ([m (hash-map u32 i32)])
    (hash-map-set! (& m) 5 -50)
    (hash-map-set! (& m) 0 7)
    (hash-map-set! (& m) 5 -55)
    (expect-equal (hash-map-ref (& m) 5) -55)
    (expect-equal (hash-map-ref (& m) 0) 7)
    (expect-equal (hash-map-ref (& m) 6) 0)
    (expect-equal (hash-map-find (& m) 6) 0)
    (expect-equal (hash-map-count (& m)) 2)
    (hash-map-free! (& m))))

(test strings
  (let ([m (hash-map string point)] [key (string-copy "two")])
    (hash-map-set! (& m) "one" (point #:x 1 #:y 1))
    (hash-map-set! (& m) key (point #:x 2 #:y 4))
    (expect-equal (-> (hash-map-find (& m) "two") y) 4)
    (set! (-> (hash-map-find (& m) "one") x) 9)
    (expect-equal (-> (hash-map-ref (& m) "one") x) 9)
    (hash-map-free! (& m))))

(test grow-and-remove
  (let ([m (hash-map i64 u64)] [ok #t])
    (for ([i i64 0]) (< i 1000) (+= i 1) (hash-map-set! (& m) (* i 7) (cast u64 (* i i))))
    (for ([i i64 0]) (< i 1000) (+= i 2) (expect (hash-map-remove! (& m) (* i 7))))
    (expect (not (hash-map-remove! (& m) 0)))
    (expect-equal (hash-map-count (& m)) 500)
    (for ([i i64 0]) (< i 1000) (+= i 1)
      (let ([p (hash-map-find (& m) (* i 7))])
        (if (== (% i 2) 0)
            (when (!= p 0) (set! ok #f))
            (when (or (== p 0) (!= (@ p) (cast u64 (* i i)))) (set! ok #f)))))
    (expect ok)
    (hash-map-clear! (& m))
    (expect-equal (hash-map-count (& m)) 0)
    (expect-equal (hash-map-ref (& m) 7) 0)
    (hash-map-free! (& m))))

(test each
  (let ([m (hash-map u8 u32)] [keys u32 0] [values u32 0])
    (for ([i u32 1]) (<= i 10) (+= i 1) (hash-map-set! (& m) (cast u8 i) (* i 100)))
    (hash-map-each ([k v (& m)])
      (+= keys k)
      (+= values (@ v))
      (set! (@ v) 0))
    (expect-equal keys 55)
    (expect-equal values 5500)
    (expect-equal (hash-map-ref (& m) 3) 0)
    (hash-map-free! (& m))))

(test pointers
  (let ([m (hash-map (ptr point) bool)] [a point] [b point])
    (hash-map-set! (& m) (& a) #t)
    (expect (hash-map-ref (& m) (& a)))
    (expect (not (hash-map-ref (& m) (& b))))
    (hash-map-free! (& m))))
