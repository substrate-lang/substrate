;; The tar reader on the archives tests/run.sh makes with GNU tar in each of its formats, and on data that is not tar or is
;; cut short.
(require-unqualified host/fs)
(require-unqualified std/archive/tar)
(provide main)

(define (base-of [p string]) -> string
  (let ([i (-> p length)])
    (while (and (> i 0) (!= (@ p (- i 1)) #\/)) (-= i 1))
    (slice p i)))

(define (show [file string])
  (let ([bytes (slice u8)] [why error] [a (make-arena)] [r tar-reader] [e tar-entry] [err (make-buffer)] [got i32 1])
    (printf "~a:\n" (base-of file))
    (unless (fs-read-file file (& bytes) (& why))
      (printf "  ~a\n" (error-text (& why)))
      (return))
    (tar-reader-init! (& r) bytes)
    (while (== got 1)
      (set! got (tar-next! (& a) (& r) (& e) (& err)))
      (when (== got 1)
        (cond [(and (== (-> e kind) tar-file) (> (-> e bytes length) 0))
               (printf "  file ~a, ~a bytes: ~a\n" (-> e path) (-> e bytes length)
                       (cast string (slice (-> e bytes) 0 (- (-> e bytes length) 1))))]
              [(== (-> e kind) tar-file) (printf "  file ~a, ~a bytes\n" (-> e path) (-> e bytes length))]
              [(== (-> e kind) tar-directory) (printf "  directory ~a\n" (-> e path))]
              [else (printf "  other ~a\n" (-> e path))])))
    (when (< got 0) (printf "  ~a\n" (buffer-string (& err))))
    (arena-free (& a))
    (buffer-free! (& err))
    (free (-> bytes items))))

(define (main [files (slice string)])
  (for ([i u32 0]) (< i (-> files length)) (+= i 1) (show (@ files i))))
