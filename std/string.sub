;; Searching, trimming and building strings. Positions count bytes. A search that finds nothing gives the string's
;; length. The builders take an arena first, where 0 means the heap. string-split keeps empty pieces, and its pieces
;; share the string's bytes. char-numeric? and char-whitespace? test ASCII bytes.
(provide string-prefix? string-suffix? string-contains? string-index string-find string-trim string-trim-left
         string-trim-right string-append string-join string-split string-replace char-numeric? char-whitespace?)

;; ---- searching ----

(define (string-prefix? [s string] [prefix string]) -> bool
  (and (>= (-> s length) (-> prefix length)) (== (slice s 0 (-> prefix length)) prefix)))

(define (string-suffix? [s string] [suffix string]) -> bool
  (and (>= (-> s length) (-> suffix length)) (== (slice s (- (-> s length) (-> suffix length))) suffix)))

(define (string-index [s string] [byte u8]) -> u32
  (for ([i u32 0]) (< i (-> s length)) (+= i 1)
    (when (== (@ s i) byte) (return i)))
  (-> s length))

(define (string-find [s string] [part string]) -> u32
  (let ([n (-> part length)])
    (for ([i u32 0]) (<= (+ i n) (-> s length)) (+= i 1)
      (when (== (slice s i (+ i n)) part) (return i)))
    (-> s length)))

(define (string-contains? [s string] [part string]) -> bool
  (or (== (-> part length) 0) (< (string-find s part) (-> s length))))

;; ---- trimming ----

(define (char-numeric? [c u32]) -> bool (and (>= c #\0) (<= c #\9)))

(define (char-whitespace? [c u32]) -> bool (or (== c #\space) (and (>= c #\tab) (<= c #\return))))

(define (string-trim-left [s string]) -> string
  (let ([i u32 0])
    (while (and (< i (-> s length)) (char-whitespace? (@ s i))) (+= i 1))
    (slice s i)))

(define (string-trim-right [s string]) -> string
  (let ([n (-> s length)])
    (while (and (> n 0) (char-whitespace? (@ s (- n 1)))) (-= n 1))
    (slice s 0 n)))

(define (string-trim [s string]) -> string (string-trim-left (string-trim-right s)))

;; ---- building ----

(define (copied! [out (slice u8)] [at u32] [s string]) -> u32
  (memcpy (+ (-> out items) at) (-> s bytes) (-> s length))
  (+ at (-> s length)))

(define (occurrences [s string] [part string]) -> u32
  (let ([n (-> part length)] [count u32 0] [i u32 0])
    (when (> n 0)
      (while (<= (+ i n) (-> s length))
        (if (== (slice s i (+ i n)) part) (begin (+= count 1) (+= i n)) (+= i 1))))
    count))

(define (string-join [a (ptr arena)] [strings (slice string)] [separator string]) -> string
  (let ([n u32 0] [count (-> strings length)])
    (for ([i u32 0]) (< i count) (+= i 1) (+= n (-> (@ strings i) length)))
    (when (> count 1) (+= n (* (- count 1) (-> separator length))))
    (let ([out (new a u8 n)] [at u32 0])
      (for ([i u32 0]) (< i count) (+= i 1)
        (when (> i 0) (set! at (copied! out at separator)))
        (set! at (copied! out at (@ strings i))))
      (cast string out))))

(define (string-split [a (ptr arena)] [s string] [separator string]) -> (slice string)
  (let ([n (-> separator length)] [out (new a string (+ (occurrences s separator) 1))]
        [k u32 0] [start u32 0] [i u32 0])
    (when (> n 0)
      (while (<= (+ i n) (-> s length))
        (if (== (slice s i (+ i n)) separator)
            (begin (set! (@ out k) (slice s start i)) (+= k 1) (+= i n) (set! start i))
            (+= i 1))))
    (set! (@ out k) (slice s start))
    out))

(define (string-replace [a (ptr arena)] [s string] [from string] [to string]) -> string
  (let* ([n (-> from length)] [count (occurrences s from)]
         [out (new a u8 (+ (- (-> s length) (* count n)) (* count (-> to length))))] [at u32 0] [start u32 0] [i u32 0])
    (when (> n 0)
      (while (<= (+ i n) (-> s length))
        (if (== (slice s i (+ i n)) from)
            (begin (set! at (copied! out at (slice s start i))) (set! at (copied! out at to)) (+= i n) (set! start i))
            (+= i 1))))
    (copied! out at (slice s start))
    (cast string out)))

(begin-for-syntax
  (require-unqualified compiler/macros)

  (define (string-append-form [s datum]) -> datum
    (syntax-match s
      [(_ a part ...) #`(string-join #,a (slice (array-of string #,@part)) "")]
      [_ (raise-syntax-error 'string-append "expected (string-append arena string ...)" s)])))

(define-syntax string-append string-append-form)
