;; The parts of a request's target: its path and query, percent-decoding and encoding, a path's segments, and the
;; application/x-www-form-urlencoded format of queries and form bodies, after the WHATWG URL Standard. It also finds a
;; URL's origin, target and fragment, and resolves a reference against a URL.
(provide url-pair url-path url-query url-unescape url-segments url-add-clean! url-add-segment! url-add-form-value!
         url-form-parse url-form-value url-origin url-target url-fragment url-resolve)

(struct url-pair [name string] [value string])

(define (url-path [target string]) -> string
  (let ([i u32 0])
    (while (and (< i (-> target length)) (!= (@ target i) #\?)) (+= i 1))
    (slice target 0 i)))

(define (url-query [target string]) -> string
  (let ([i u32 0])
    (while (and (< i (-> target length)) (!= (@ target i) #\?)) (+= i 1))
    (if (< i (-> target length)) (slice target (+ i 1)) "")))

(define (escape? [s string] [i u32]) -> bool
  (and (== (@ s i) #\%) (< (+ i 2) (-> s length))
       (>= (digit-value (@ s (+ i 1)) 16) 0) (>= (digit-value (@ s (+ i 2)) 16) 0)))

;; s with its percent-escapes decoded, and its pluses as spaces when plus is set, into the arena; s when it has none. A
;; % without two hex digits after it stays.
(define (url-unescape [a (ptr arena)] [s string] [plus bool]) -> string
  (let ([n (-> s length)] [plain #t])
    (for ([i u32 0]) (< i n) (+= i 1)
      (when (or (escape? s i) (and plus (== (@ s i) #\+))) (set! plain #f)))
    (when plain (return s))
    (let ([p (new a u8 n)] [i u32 0] [k u32 0])
      (while (< i n)
        (cond [(escape? s i)
               (set! (@ p k) (+ (* 16 (digit-value (@ s (+ i 1)) 16)) (digit-value (@ s (+ i 2)) 16)))
               (+= i 3)]
              [(and plus (== (@ s i) #\+))
               (set! (@ p k) 32)
               (+= i 1)]
              [else
               (set! (@ p k) (@ s i))
               (+= i 1)])
        (+= k 1))
      (cast string (slice p 0 k)))))

;; A path's segments after its first slash, decoded into the arena: "/" has none, and a final slash gives an empty last
;; segment. It returns 1 when a segment is . or .., or empty before the end, and -1 when the path does not start with a
;; slash.
(define (url-segments [a (ptr arena)] [path string] [to (ptr (slice string))]) -> i32
  (let ([n (-> path length)] [count u32 1] [k u32 0] [start u32 1] [unclean #f])
    (set! (@ to) 0)
    (when (or (== n 0) (!= (@ path 0) #\/)) (return -1))
    (when (== n 1) (return 0))
    (for ([i u32 1]) (< i n) (+= i 1) (when (== (@ path i) #\/) (+= count 1)))
    (let ([items (new a string count)])
      (for ([i u32 1]) (<= i n) (+= i 1)
        (when (or (== i n) (== (@ path i) #\/))
          (let ([s (url-unescape a (slice path start i) #f)])
            (when (or (== s ".") (== s "..") (and (== (-> s length) 0) (< i n))) (set! unclean #t))
            (set! (@ items k) s)
            (+= k 1)
            (set! start (+ i 1)))))
      (set! (@ to) (slice items 0 k))
      (if unclean 1 0))))

;; The path the segments name, resolved as Go's path.Clean does, keeping a final slash.
(define (url-add-clean! [b (ptr buffer)] [segments (slice string)])
  (let* ([n (-> segments length)] [kept (new 0 u32 (+ n 1))] [k u32 0]
         [last (if (> n 0) (@ segments (- n 1)) "x")] [slash (or (== last "") (== last ".") (== last ".."))])
    (for ([i u32 0]) (< i n) (+= i 1)
      (let ([s (@ segments i)])
        (cond [(or (== s "") (== s ".")) (begin)]
              [(== s "..") (when (> k 0) (-= k 1))]
              [else
               (set! (@ kept k) i)
               (+= k 1)])))
    (when (== k 0) (buffer-add-byte! b #\/))
    (for ([j u32 0]) (< j k) (+= j 1)
      (buffer-add-byte! b #\/)
      (url-add-segment! b (@ segments (@ kept j))))
    (when (and slash (> k 0)) (buffer-add-byte! b #\/))
    (free (-> kept items))))

(define hex-digits string "0123456789ABCDEF")

(define (add-escape! [b (ptr buffer)] [c u8])
  (buffer-add-byte! b #\%)
  (buffer-add-byte! b (@ hex-digits (cast u32 (>> c 4))))
  (buffer-add-byte! b (@ hex-digits (cast u32 (bit-and c 15)))))

(define (alphanumeric? [c u8]) -> bool
  (or (and (>= c #\a) (<= c #\z)) (and (>= c #\A) (<= c #\Z)) (and (>= c #\0) (<= c #\9))))

;; s as one path segment, escaped as Go's PathEscape does.
(define (url-add-segment! [b (ptr buffer)] [s string])
  (for ([i u32 0]) (< i (-> s length)) (+= i 1)
    (let ([c (@ s i)])
      (if (or (alphanumeric? c)
              (case c [(#\- #\. #\_ #\~ #\! #\$ #\& #\' #\( #\) #\* #\+ #\, #\; #\= #\: #\@) #t] [else #f]))
          (buffer-add-byte! b c)
          (add-escape! b c)))))

;; s as a name or value of the urlencoded format.
(define (url-add-form-value! [b (ptr buffer)] [s string])
  (for ([i u32 0]) (< i (-> s length)) (+= i 1)
    (let ([c (@ s i)])
      (cond [(or (alphanumeric? c) (== c #\*) (== c #\-) (== c #\.) (== c #\_)) (buffer-add-byte! b c)]
            [(== c 32) (buffer-add-byte! b #\+)]
            [else (add-escape! b c)]))))

;; An urlencoded string's pairs, decoded into the arena.
(define (url-form-parse [a (ptr arena)] [s string]) -> (slice url-pair)
  (let ([n (-> s length)] [count u32 1] [k u32 0] [start u32 0])
    (for ([i u32 0]) (< i n) (+= i 1) (when (== (@ s i) #\&) (+= count 1)))
    (let ([pairs (new a url-pair count)])
      (for ([i u32 0]) (<= i n) (+= i 1)
        (when (or (== i n) (== (@ s i) #\&))
          (when (> i start)
            (let ([part (slice s start i)] [e u32 0])
              (while (and (< e (-> part length)) (!= (@ part e) #\=)) (+= e 1))
              (set! (-> (@ pairs k) name) (url-unescape a (slice part 0 e) #t))
              (set! (-> (@ pairs k) value) (url-unescape a (if (< e (-> part length)) (slice part (+ e 1)) "") #t))
              (+= k 1)))
          (set! start (+ i 1))))
      (slice pairs 0 k))))

;; The value of the first pair with the name.
(define (url-form-value [pairs (slice url-pair)] [name string] [to (ptr string)]) -> bool
  (for ([i u32 0]) (< i (-> pairs length)) (+= i 1)
    (when (== (-> (+ (-> pairs items) i) name) name)
      (set! (@ to) (-> (+ (-> pairs items) i) value))
      (return #t)))
  #f)

;; ---- URLs ----

;; The index of the colon that ends url's scheme, or 0 when url has no scheme.
(define (scheme-end [url string]) -> u32
  (let ([n (-> url length)])
    (unless (and (> n 0) (alphanumeric? (@ url 0)) (not (and (>= (@ url 0) #\0) (<= (@ url 0) #\9)))) (return 0))
    (for ([i u32 1]) (< i n) (+= i 1)
      (let ([c (@ url i)])
        (cond [(== c #\:) (return i)]
              [(not (or (alphanumeric? c) (== c #\+) (== c #\-) (== c #\.))) (return 0)])))
    0))

;; The index where url's path starts, after its scheme and authority.
(define (path-start [url string]) -> u32
  (let ([s (scheme-end url)] [n (-> url length)])
    (cond [(and (> s 0) (< (+ s 2) n) (== (@ url (+ s 1)) #\/) (== (@ url (+ s 2)) #\/))
           (let ([i (+ s 3)])
             (while (and (< i n) (!= (@ url i) #\/) (!= (@ url i) #\?) (!= (@ url i) #\#)) (+= i 1))
             i)]
          [(> s 0) (+ s 1)]
          [else 0])))

(define (fragment-start [url string]) -> u32
  (let ([i u32 0])
    (while (and (< i (-> url length)) (!= (@ url i) #\#)) (+= i 1))
    i))

(define (query-start [url string]) -> u32
  (let ([i u32 0] [f (fragment-start url)])
    (while (and (< i f) (!= (@ url i) #\?)) (+= i 1))
    i))

(define (url-origin [url string]) -> string (slice url 0 (path-start url)))

(define (url-target [url string]) -> string (slice url (path-start url) (fragment-start url)))

(define (url-fragment [url string]) -> string
  (let ([f (fragment-start url)]) (if (< f (-> url length)) (slice url (+ f 1)) "")))

;; Writes path, which starts with a slash, without its . and .. segments, as RFC 3986 removes them.
(define (add-without-dots! [b (ptr buffer)] [path string])
  (let* ([n (-> path length)] [starts (new 0 u32 (+ n 1))] [ends (new 0 u32 (+ n 1))] [k u32 0] [start u32 1]
         [dot #f])
    (for ([i u32 1]) (<= i n) (+= i 1)
      (when (or (== i n) (== (@ path i) #\/))
        (let ([part (slice path start i)])
          (set! dot (or (== part ".") (== part "..")))
          (cond [(== part ".") (begin)]
                [(== part "..") (when (> k 0) (-= k 1))]
                [else
                 (set! (@ starts k) start)
                 (set! (@ ends k) i)
                 (+= k 1)]))
        (set! start (+ i 1))))
    (for ([j u32 0]) (< j k) (+= j 1)
      (buffer-add-byte! b #\/)
      (buffer-add-string! b (slice path (@ starts j) (@ ends j))))
    (when (or (== k 0) dot) (buffer-add-byte! b #\/))
    (free (-> starts items))
    (free (-> ends items))))

;; url-resolve resolves ref against base into the arena. An absolute ref stays as it is, and any other ref gives the URL
;; that it names from base.
(define (url-resolve [a (ptr arena)] [base string] [ref string]) -> string
  (when (> (scheme-end ref) 0) (return (copy a ref)))
  (let* ([b (make-buffer)] [s (scheme-end base)] [p (path-start base)] [q (query-start base)] [f (fragment-start base)]
         [rp (query-start ref)] [out string])
    (cond [(and (>= (-> ref length) 2) (== (@ ref 0) #\/) (== (@ ref 1) #\/))
           (buffer-add-string! (& b) (slice base 0 (if (> s 0) (+ s 1) 0)))
           (buffer-add-string! (& b) ref)]
          [(== (-> ref length) 0) (buffer-add-string! (& b) (slice base 0 f))]
          [(== (@ ref 0) #\#)
           (buffer-add-string! (& b) (slice base 0 f))
           (buffer-add-string! (& b) ref)]
          [(== (@ ref 0) #\?)
           (buffer-add-string! (& b) (slice base 0 q))
           (buffer-add-string! (& b) ref)]
          [else
           (let ([path (make-buffer)])
             (buffer-add-string! (& b) (slice base 0 p))
             (if (== (@ ref 0) #\/)
                 (buffer-add-string! (& path) (slice ref 0 rp))
                 (let ([dir (slice base p q)] [last u32 0])
                   (for ([i u32 0]) (< i (-> dir length)) (+= i 1) (when (== (@ dir i) #\/) (set! last (+ i 1))))
                   (if (== last 0) (buffer-add-byte! (& path) #\/) (buffer-add-string! (& path) (slice dir 0 last)))
                   (buffer-add-string! (& path) (slice ref 0 rp))))
             (add-without-dots! (& b) (buffer-string (& path)))
             (buffer-free! (& path))
             (buffer-add-string! (& b) (slice ref rp)))])
    (set! out (copy a (buffer-string (& b))))
    (buffer-free! (& b))
    out))
