;; Sessions in a signed cookie, after Flask's: the session's bytes, the second they were signed, and an HMAC-SHA256 of
;; both, each in base64url and joined by dots, as itsdangerous signs. A client can read its session but not change it.
;; The first of the keys signs, and any of them is accepted, so that keys can be rotated; each signs through a key
;; HKDF derives for sessions. The session form, (session T ...), gives each struct type T with a json form a reader
;; and a writer of a session holding it: T.session-read, which reads into the request's arena, and T.session-write!.
(require-unqualified host/modules/clock)
(require-unqualified std/crypto/hmac)
(require-unqualified std/encoding/base64)
(require-unqualified std/encoding/json)
(require-unqualified "http.sub")
(require-unqualified "server.sub")
(require-unqualified "cookie.sub")

(provide session http-sessions http-session-read http-session-write! http-session-clear!)

;; keys are secrets, the newest first, and an empty one signs nothing and accepts nothing. name is the cookie's,
;; "session" when empty, and max-age how many seconds a session lasts, 31 days when 0. The cookie is HttpOnly,
;; SameSite=Lax, for the path /, and Secure over https.
(struct http-sessions [keys (slice string)] [name string] [max-age i64])

(define (name-of [s (ptr http-sessions)]) -> string (if (== (-> s name length) 0) "session" (-> s name)))

(define (max-age-of [s (ptr http-sessions)]) -> i64 (if (== (-> s max-age) 0) 2678400 (-> s max-age)))

(define (signed! [secret string] [text string] [mac (slice u8)])
  (let ([key (array u8 32)])
    (hkdf! (cast (slice u8) secret) 0 (cast (slice u8) "substrate session") (slice key))
    (hmac-of (slice key) (cast (slice u8) text) mac)))

(define (now-seconds) -> u64 (cast u64 (/ (clock-now) 1000.0)))

;; http-session-read gives the session's bytes, in the request's arena, when the cookie is signed by one of the keys
;; and has not expired.
(define (http-session-read [s (ptr http-sessions)] [r (ptr http-request)] [into (ptr (slice u8))]) -> bool
  (let* ([value (http-request-cookie r (name-of s))] [n (-> value length)] [first u32 n] [second u32 n]
         [b (make-buffer)] [mac (array u8 32)] [ok #f] [at u64 0])
    (for ([i u32 0]) (< i n) (+= i 1)
      (when (== (@ value i) #\.)
        (set! first second)
        (set! second i)))
    (when (or (>= first n) (== (+ second 1) n)) (return #f))
    (when (and (base64url-decode! (& b) (slice value (+ second 1))) (== (-> b length) 32))
      (for ([k u32 0]) (and (not ok) (< k (-> s keys length))) (+= k 1)
        (unless (== (-> (@ (-> s keys) k) length) 0)
          (signed! (@ (-> s keys) k) (slice value 0 second) (slice mac))
          (set! ok (hmac-equal? (slice mac) (buffer-bytes (& b)))))))
    (set! (-> b length) 0)
    (set! ok (and ok (base64url-decode! (& b) (slice value (+ first 1) second)) (== (-> b length) 8)))
    (when ok
      (for ([i u32 0]) (< i 8) (+= i 1) (set! at (bit-or (<< at 8) (cast u64 (@ (-> b bytes) i)))))
      (set! ok (and (<= at (+ (now-seconds) 60)) (<= (cast i64 (- (now-seconds) at)) (max-age-of s)))))
    (set! (-> b length) 0)
    (set! ok (and ok (base64url-decode! (& b) (slice value 0 first))))
    (when ok (set! (@ into) (copy (& (-> r arena)) (buffer-bytes (& b)))))
    (buffer-free! (& b))
    ok))

(define (cookie! [s (ptr http-sessions)] [r (ptr http-request)] [value string] [max-age i64])
  (let ([c http-cookie])
    (set! (-> c name) (name-of s))
    (set! (-> c value) value)
    (set! (-> c path) "/")
    (set! (-> c domain) "")
    (set! (-> c max-age) max-age)
    (set! (-> c secure) (http-request-https? r))
    (set! (-> c http-only) #t)
    (set! (-> c same-site) http-same-site-lax)
    (http-set-cookie! r (& c))))

;; http-session-write! sets the session's cookie to the bytes, signed now, before the request is answered. A session
;; too large for a cookie traps.
(define (http-session-write! [s (ptr http-sessions)] [r (ptr http-request)] [bytes (slice u8)])
  (let ([b (make-buffer)] [at (array u8 8)] [mac (array u8 32)] [now (now-seconds)])
    (when (or (== (-> s keys length) 0) (== (-> (@ (-> s keys) 0) length) 0))
      (host-trap "http: sessions without a key"))
    (for ([i u32 0]) (< i 8) (+= i 1) (set! (@ at i) (cast u8 (>> now (* 8 (- 7 i))))))
    (base64url-encode! (& b) bytes)
    (buffer-add-byte! (& b) #\.)
    (base64url-encode! (& b) (slice at))
    (signed! (@ (-> s keys) 0) (buffer-string (& b)) (slice mac))
    (buffer-add-byte! (& b) #\.)
    (base64url-encode! (& b) (slice mac))
    (cookie! s r (buffer-string (& b)) (max-age-of s))
    (buffer-free! (& b))))

(define (http-session-clear! [s (ptr http-sessions)] [r (ptr http-request)]) (cookie! s r "" -1))

(begin-for-syntax
  (require-unqualified compiler/macros)
  (require-unqualified std/meta/derive)

  (define (session-form [s datum]) -> datum (derive s 'session '"session-read" definitions))

  (define (definitions [t datum] [info datum]) -> datum
    (unless (== (car info) 'struct) (raise-syntax-error 'session "expected a struct type" t))
    (unless (== (identifier-binding-kind (derive-name t '"json-read")) 'function)
      (raise-syntax-error 'session "this type needs a json form, which (json T) defines: write it first" t))
    `(,#`(define (#,(derive-name t '"session-read") [s (ptr http-sessions)] [r (ptr http-request)] [v (ptr #,t)])
           -> bool
           (let ([bytes (slice u8)])
             (and (http-session-read s r (& bytes))
                  (#,(derive-name t '"json-read") (& (-> r arena)) (cast string bytes) v 0))))
      ,#`(define (#,(derive-name t '"session-write!") [s (ptr http-sessions)] [r (ptr http-request)] [v (ptr #,t)])
           (let ([b (make-buffer)])
             (#,(derive-name t '"json-write!") (& b) v)
             (http-session-write! s r (buffer-bytes (& b)))
             (buffer-free! (& b)))))))

(define-syntax session session-form)
