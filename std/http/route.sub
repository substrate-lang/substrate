;; Routes after Go's ServeMux, written as s-expressions with typed parameters. (routes name [METHOD (segment ...)
;; handler option ...] ... [#:mount (segment ...) handler] ...) defines name, a handler for http-serve!. A segment is a
;; string; [name type], of type string or an integer type; or, last, [name string ...], the rest of the path. "" last is
;; the empty segment after a final slash. The handler gets the request, the parameters, then a pointer to what (query T)
;; reads, then a pointer to what (json T) or (form T) reads or the bytes (body) reads; (limit n) bounds the body. A
;; mount takes requests of every method whose paths are under its own. Before its handler runs, the mount's part of the
;; path moves from the request's target to the request's base. The handler gets the request and the parameters, and it
;; can be another table of routes. The most specific route wins, and two routes that overlap are refused when neither
;; is more specific. A handler's first route defines handler.url!, which writes the route's path within its table.
;; Redirects put the request's base in front of that path.
(require-unqualified "http.sub")
(require-unqualified "server.sub")
(require-unqualified "url.sub")
(require-unqualified "multipart.sub")
(require-unqualified "form.sub")
(require-unqualified "paths.sub")
(require-unqualified std/encoding/json)

(provide routes)

(define no-parts (slice multipart-part) 0)

(define (route-slashed [a (ptr arena)] [segments (slice string)]) -> (slice string)
  (let* ([n (-> segments length)] [items (new a string (+ n 1))])
    (for ([i u32 0]) (< i n) (+= i 1) (set! (@ items i) (@ segments i)))
    (set! (@ items n) "")
    items))

(define (route-moved! [r (ptr http-request)] [path string])
  (let ([b (make-buffer)] [target (-> r target)])
    (buffer-add-string! (& b) (-> r base))
    (buffer-add-string! (& b) path)
    (when (< (-> (url-path target) length) (-> target length))
      (buffer-add-byte! (& b) #\?)
      (buffer-add-string! (& b) (url-query target)))
    (http-redirect! r (if (or (== (-> r method) "GET") (== (-> r method) "HEAD")) 301 308) (buffer-string (& b)))
    (buffer-free! (& b))))

(define (route-clean! [r (ptr http-request)] [segments (slice string)])
  (let ([b (make-buffer)])
    (url-add-clean! (& b) segments)
    (route-moved! r (buffer-string (& b)))
    (buffer-free! (& b))))

(define (route-slash! [r (ptr http-request)])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) (url-path (-> r target)))
    (buffer-add-byte! (& b) #\/)
    (route-moved! r (buffer-string (& b)))
    (buffer-free! (& b))))
(define (route-mount! [r (ptr http-request)] [n u32])
  (let* ([t (-> r target)] [i (path-after (url-path t) n)] [b (make-buffer)])
    (buffer-add-string! (& b) (-> r base))
    (buffer-add-string! (& b) (slice t 0 i))
    (set! (-> r base) (copy (& (-> r arena)) (buffer-string (& b))))
    (set! (-> r target) (slice t i))
    (buffer-free! (& b))))

;; allowed holds the methods of the routes matching the path.
(define (route-miss! [r (ptr http-request)] [allowed u32] [methods (slice string)] [get u32] [head u32])
  (when (== allowed 0)
    (http-answer-text! r 404 "not found")
    (return))
  (let ([b (make-buffer)] [all (if (!= (bit-and allowed get) 0) (bit-or allowed head) allowed)])
    (for ([i u32 0]) (< i (-> methods length)) (+= i 1)
      (when (!= (bit-and all (<< 1 i)) 0)
        (when (> (-> b length) 0) (buffer-add-string! (& b) ", "))
        (buffer-add-string! (& b) (@ methods i))))
    (http-respond! r 405)
    (http-header! r "allow" (buffer-string (& b)))
    (http-header! r "content-type" "text/plain; charset=utf-8")
    (http-send-text! r "method not allowed")
    (buffer-free! (& b))))

(define (route-refused! [r (ptr http-request)] [err (ptr form-error)])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "field ")
    (buffer-add-string! (& b) (-> err field))
    (buffer-add-string! (& b) ": ")
    (buffer-add-string! (& b) (error-text (& (-> err error))))
    (http-answer-text! r 400 (buffer-string (& b)))
    (error-free! (& (-> err error)))
    (buffer-free! (& b))))

(define (route-json-refused! [r (ptr http-request)] [err (ptr json-error)])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "json at ")
    (write-digits (& b) (-> err line) 10)
    (buffer-add-byte! (& b) #\:)
    (write-digits (& b) (-> err column) 10)
    (buffer-add-string! (& b) ": ")
    (buffer-add-string! (& b) (error-text (& (-> err error))))
    (http-answer-text! r 400 (buffer-string (& b)))
    (error-free! (& (-> err error)))
    (buffer-free! (& b))))

(define (route-typed? [r (ptr http-request)] [json bool]) -> bool
  (let* ([type (http-media-type (http-request-header r "content-type"))] [n (-> type length)]
         [ok (if json
                 (or (http-same? type "application/json")
                     (and (> n 17) (http-same? (slice type 0 12) "application/")
                          (http-same? (slice type (- n 5)) "+json")))
                 (or (http-same? type "application/x-www-form-urlencoded") (http-same? type "multipart/form-data")))])
    (unless ok (http-answer-text! r 415 "unsupported media type"))
    ok))

(define (route-form-fields [r (ptr http-request)] [body (slice u8)] [pairs (ptr (slice url-pair))]
                           [parts (ptr (slice multipart-part))]) -> bool
  (let* ([a (& (-> r arena))] [t (http-request-header r "content-type")] [why error])
    (set! (@ pairs) 0)
    (set! (@ parts) 0)
    (if (http-media-type? t "multipart/form-data")
        (or (multipart-parse a body (multipart-boundary a t) parts (& why))
            (begin
              (http-answer-text! r 400 (error-text (& why)))
              (error-free! (& why))
              #f))
        (begin (set! (@ pairs) (url-form-parse a (cast string body))) #t))))

;; ---- the routes form ----

(begin-for-syntax
  (require-unqualified compiler/macros)
  (require-unqualified "segments.sub")

  (define context datum 0)
  (define methods datum nil)
  (define starts datum nil)
  (define counter u32 0)

  (define (literal [d datum]) -> datum (datum->syntax #'here d 0))
  (define (number [n i64]) -> datum (literal (make-integer n)))
  (define (fail [where datum] [message string]) -> datum (raise-syntax-error 'routes message where))

  (define (fresh [base datum]) -> datum
    (+= counter 1)
    (datum->syntax #'here (string->symbol (format-message "~a~a" `(,base ,(make-integer counter)))) 0))

  ;; A name in the form's scope, after the identifier x.
  (define (named [x datum] [suffix datum]) -> datum
    (datum->syntax context (string->symbol (format-message "~a~a" `(,(syntax-e x) ,suffix))) context))

  ;; ---- reading the table ----

  ;; A route is (route index method segments handler options syntax given). Its segments are as segments.sub reads
  ;; them, and given is the path as the route writes it.
  (define (route-index [r datum]) -> datum (list-ref r 1))
  (define (route-method [r datum]) -> datum (list-ref r 2))
  (define (route-segments [r datum]) -> datum (list-ref r 3))
  (define (route-handler [r datum]) -> datum (list-ref r 4))
  (define (route-options [r datum]) -> datum (list-ref r 5))
  (define (route-syntax [r datum]) -> datum (list-ref r 6))
  (define (route-given [r datum]) -> datum (list-ref r 7))
  (define (option [r datum] [word datum]) -> datum
    (let ([o (assq word (route-options r))]) (if (== o 0) 0 (cdr o))))

  (define (parse-route [e datum] [k u32]) -> datum
    (let ([l (syntax->list e)])
      (unless (and (!= l 0) (>= (length l) 3) (identifier? (car l)) (!= (syntax->list (cadr l)) 0)
                   (identifier? (caddr l)))
        (fail e "expected [METHOD (segment ...) handler option ...]"))
      `(route ,(make-integer k) ,(syntax-e (car l)) ,(segments-read 'routes (cadr l)) ,(caddr l)
              ,(parse-options (cdddr l) e) ,e ,(cadr l))))

  ;; A mount is (mount segments handler syntax given).
  (define (mount-segments [m datum]) -> datum (list-ref m 1))
  (define (mount-handler [m datum]) -> datum (list-ref m 2))
  (define (mount-syntax [m datum]) -> datum (list-ref m 3))
  (define (mount-given [m datum]) -> datum (list-ref m 4))

  (define rest-name datum 0)

  (define (matched [m datum]) -> datum (append (mount-segments m) `((rest ,rest-name ,(mount-syntax m)))))

  (define (parse-mount [e datum]) -> datum
    (let ([l (syntax->list e)])
      (unless (and (!= l 0) (== (length l) 3) (!= (syntax->list (cadr l)) 0) (identifier? (caddr l)))
        (fail e "expected [#:mount (segment ...) handler]"))
      (let ([read (segments-read 'routes (cadr l))])
        (unless (segments-mountable? read)
          (fail (cadr l) "a mount's path needs a segment, and it cannot end with the rest of a path or a final slash"))
        `(mount ,read ,(caddr l) ,e ,(cadr l)))))

  (define (parse-options [l datum] [where datum]) -> datum
    (let ([out nil] [bodies 0])
      (for/each ([o l])
        (let ([parts (syntax->list o)])
          (unless (and (!= parts 0) (pair? parts) (identifier? (car parts)))
            (fail o "expected an option: (query T), (json T), (form T), (body) or (limit n)"))
          (let ([word (syntax-e (car parts))])
            (when (!= (assq word out) 0) (fail o "a route can have each option once"))
            (cond [(and (or (== word 'query) (== word 'json) (== word 'form)) (== (length parts) 2)
                        (identifier? (cadr parts)))
                   (unless (== word 'query) (+= bodies 1))
                   (set! out (cons (cons word (cadr parts)) out))]
                  [(and (== word 'body) (== (length parts) 1))
                   (+= bodies 1)
                   (set! out (cons (cons word o) out))]
                  [(and (== word 'limit) (== (length parts) 2) (integer? (syntax-e (cadr parts)))
                        (> (integer-value (syntax-e (cadr parts))) 0)
                        (<= (integer-value (syntax-e (cadr parts))) 4294967295))
                   (set! out (cons (cons word (cadr parts)) out))]
                  [else (fail o "expected an option: (query T), (json T), (form T), (body) or (limit n)")]))))
      (when (> bodies 1) (fail where "a route reads its body one way: with (json T), (form T) or (body)"))
      (when (and (!= (assq 'limit out) 0) (== bodies 0))
        (fail where "(limit n) bounds a body, which (json T), (form T) or (body) reads"))
      out))

  ;; ---- conflicts ----

  ;; The route as Go writes its patterns, with each parameter's type.
  (define (route-text [r datum]) -> string
    (format-message "~a ~a" `(,(route-method r) ,(string->datum (segments-text (route-segments r))))))

  (define (mount-text [m datum]) -> string
    (format-message "#:mount ~a" `(,(string->datum (segments-text (mount-segments m))))))

  (define (check-conflicts! [rs datum] [ms datum])
    (segments-check! 'routes
                     (for/list ([r rs])
                       `(,(route-method r) ,(route-segments r) ,(route-syntax r) ,(string->datum (route-text r))))
                     'requests)
    (segments-check! 'routes
                     (for/list ([m ms]) `(mount ,(matched m) ,(mount-syntax m) ,(string->datum (mount-text m))))
                     'requests)
    (for/each ([m ms])
      (for/each ([r rs])
        (when (and (segments-overlap? (route-segments r) (matched m))
                   (not (segments-within? (route-segments r) (matched m))))
          (fail (mount-syntax m)
                (format-message "~a and ~a overlap, and neither is more specific"
                                `(,(string->datum (route-text r)) ,(string->datum (mount-text m)))))))))

  ;; ---- code ----

  (define (bit [m datum]) -> datum
    (let ([i i64 0] [l methods])
      (while (!= (car l) m)
        (set! l (cdr l))
        (+= i 1))
      (number (<< 1 i))))

  (define (start-of [r datum]) -> datum (list-ref starts (cast u32 (integer-value (route-index r)))))

  (define (shape [r datum]) -> datum (for/list ([s (route-segments r)]) (segments-key s)))

  (define (leaf-code [rs datum] [r datum]) -> datum
    (let ([names (for/list ([p (params r)]) (car p))] [m (route-method r)]
          [head (ormap (lambda ([o datum]) -> bool (and (== (route-method o) 'HEAD) (equal? (shape o) (shape r)))) rs)])
      #`(begin
          (when probe (return #t))
          (when (== method #,(bit m)) (#,(start-of r) r #,@names) (return #t))
          #,@(if (and (== m 'GET) (not head))
                 `(,#`(when (== method #,(bit 'HEAD)) (#,(start-of r) r #,@names) (return #t)))
                 nil)
          (set! (@ allowed) (bit-or (@ allowed) #,(bit m))))))

  (define (params [r datum]) -> datum (segments-params (route-segments r)))

  (define (formals [ps datum]) -> datum (for/list ([p ps]) #`[#,(car p) #,(literal (cdr p))]))

  ;; t.what, which must be bound before the routes.
  (define (derived [t datum] [what datum] [form datum] [where datum]) -> datum
    (let ([d (datum->syntax t (string->symbol (format-message "~a.~a" `(,(syntax-e t) ,what))) t)])
      (unless (== (identifier-binding-kind d) 'function)
        (fail where (format-message "this route needs ~a, which (~a ~a) defines: write it before the routes"
                                    `(,(syntax-e d) ,form ,(syntax-e t)))))
      d))

  (define (handler-call [handler datum] [values datum] [last datum]) -> datum #`(#,handler r #,@values #,@last))

  ;; A route's start and, when it reads a body, the struct its values wait in and the function given the body.
  (define (route-definitions [r datum]) -> datum
    (let* ([ps (params r)] [handler (route-handler r)] [query (option r 'query)] [json (option r 'json)]
           [form (option r 'form)] [body (option r 'body)] [limit (option r 'limit)] [where (route-syntax r)]
           [q (fresh 'q)] [e (fresh 'e)] [args (fresh 'args)] [given (fresh 'given)] [read (fresh 'read)]
           [value (fresh 'value)] [values (append (for/list ([p ps]) (car p)) (if (== query 0) nil `(,q)))]
           [reads (or (!= json 0) (!= form 0) (!= body 0))]
           [ending (if reads
                       #`(begin
                           #,@(if (== body 0)
                                  `(,#`(unless (route-typed? r #,(literal (boolean (!= json 0)))) (return)))
                                  nil)
                           (let ([#,args (new (& (-> r arena)) #,given)])
                             #,@(for/list ([x values]) #`(set! (-> #,args #,x) #,x))
                             (set! (-> r route) (cast (ptr void) #,args))
                             (http-read-body! r #,(if (== limit 0) (number 0) limit) #,read)))
                       (handler-call handler values nil))]
           [start #`(define (#,(start-of r) [r (ptr http-request)] #,@(formals ps))
                      #,(if (== query 0)
                            ending
                            #`(let ([#,q (new (& (-> r arena)) #,query)]
                                    [#,e form-error])
                                (unless (#,(derived query '"form-read" 'form where) (& (-> r arena))
                                         (url-form-parse (& (-> r arena)) (url-query (-> r target))) no-parts #,q
                                         (& #,e))
                                  (return (route-refused! r (& #,e))))
                                #,ending)))])
      (if (not reads)
          `(,start)
          `(,#`(struct #,given #,@(formals ps) #,@(if (== query 0) nil `(,#`[#,q (ptr #,query)])))
            ,#`(define (#,read [r (ptr http-request)] [bytes (slice u8)])
                 (let* ([#,args (cast (ptr #,given) (-> r route))] #,@(for/list ([x values]) #`[#,x (-> #,args #,x)]))
                   #,(cond [(!= body 0) (handler-call handler values `(,#'bytes))]
                           [(!= json 0)
                            #`(let ([#,value (new (& (-> r arena)) #,json)]
                                    [#,e json-error])
                                (unless (#,(derived json '"json-read" 'json where) (& (-> r arena)) (cast string bytes)
                                         #,value (& #,e))
                                  (return (route-json-refused! r (& #,e))))
                                #,(handler-call handler values `(,value)))]
                           [else
                            #`(let ([#,value (new (& (-> r arena)) #,form)]
                                    [#,e form-error] [pairs (slice url-pair)] [parts (slice multipart-part)])
                                (unless (route-form-fields r bytes (& pairs) (& parts)) (return))
                                (unless (#,(derived form '"form-read" 'form where) (& (-> r arena)) pairs parts #,value
                                         (& #,e))
                                  (return (route-refused! r (& #,e))))
                                #,(handler-call handler values `(,value)))])))
            ,start))))

  (define (builder-code [r datum]) -> datum
    #`(define (#,(named (route-handler r) '".url!") [b (ptr buffer)] #,@(formals (params r)))
        (path-write! b #,(route-given r))))

  (define (mount-code [m datum]) -> datum
    #`(begin
        (when probe (return #t))
        (route-mount! r #,(number (length (mount-segments m))))
        (#,(mount-handler m) r #,@(for/list ([p (segments-params (mount-segments m))]) (car p)))
        (return #t)))

  (define (mount-builder [m datum]) -> datum
    #`(define (#,(named (mount-handler m) '".url!") [b (ptr buffer)] #,@(formals (segments-params (mount-segments m))))
        (path-write! b #,(mount-given m))))

  (define (routes-form [s datum]) -> datum
    (syntax-match s
      [(_ (? identifier? name) entry ...)
       (set! context s)
       (set! rest-name (fresh 'rest))
       (let ([rs nil] [ms nil] [k u32 0] [matcher (fresh 'match)] [built nil] [builders nil])
         (for/each ([e entry])
           (let ([l (syntax->list e)])
             (if (and (!= l 0) (pair? l) (== (syntax-e (car l)) '#:mount))
                 (set! ms (cons (parse-mount e) ms))
                 (begin
                   (set! rs (cons (parse-route e k) rs))
                   (+= k 1)))))
         (set! rs (reverse rs))
         (set! ms (reverse ms))
         (check-conflicts! rs ms)
         (set! methods nil)
         (for/each ([r rs])
           (when (== (memq (route-method r) methods) 0) (set! methods (append methods `(,(route-method r))))))
         (when (== (memq 'HEAD methods) 0) (set! methods (append methods '(HEAD))))
         (when (> (length methods) 31) (fail s "a table of routes can have at most 31 methods"))
         (set! starts (for/list ([r rs]) (fresh 'start)))
         (for/each ([r rs])
           (unless (!= (memq (syntax-e (route-handler r)) built) 0)
             (set! built (cons (syntax-e (route-handler r)) built))
             (set! builders (cons (builder-code r) builders))))
         (for/each ([m ms])
           (unless (!= (memq (syntax-e (mount-handler m)) built) 0)
             (set! built (cons (syntax-e (mount-handler m)) built))
             (set! builders (cons (mount-builder m) builders))))
         #`(begin
             #,@(apply-append (for/list ([r rs]) (route-definitions r)))
             (define (#,matcher [r (ptr http-request)] [segments (slice string)] [method u32] [allowed (ptr u32)]
                                [probe bool]) -> bool
               (path-match segments (& (-> r arena))
                 #,@(for/list ([x rs]) #`[#,(route-given x) #,(leaf-code rs x)])
                 #,@(for/list ([m ms])
                      #`[(#,@(syntax->list (mount-given m)) [#,rest-name string ...]) #,(mount-code m)]))
               #f)
             (define (#,name [r (ptr http-request)])
               (let ([segments (slice string)] [allowed u32 0]
                     [method u32 (cond #,@(for/list ([m methods])
                                            #`[(== (-> r method) #,(literal (string->datum (symbol->string m))))
                                               #,(bit m)])
                                       [else 0])])
                 (case (url-segments (& (-> r arena)) (url-path (-> r target)) (& segments))
                   [(-1) (http-answer-text! r 400 "bad request")]
                   [(1) (route-clean! r segments)]
                   [else
                    (cond [(#,matcher r segments method (& allowed) #f) (begin)]
                          [(!= allowed 0)
                           (route-miss! r allowed
                                        (slice (array-of string #,@(for/list ([m methods])
                                                                     (literal (string->datum (symbol->string m))))))
                                        #,(if (!= (memq 'GET methods) 0) (bit 'GET) (number 0)) #,(bit 'HEAD))]
                          [(and (> (-> segments length) 0) (!= (@ segments (- (-> segments length) 1)) "")
                                (#,matcher r (route-slashed (& (-> r arena)) segments) 0 (& allowed) #t))
                           (route-slash! r)]
                          [else (http-answer-text! r 404 "not found")])])))
             #,@(reverse builders)))]
      [_ (fail s "expected (routes name [METHOD (segment ...) handler option ...] ... [#:mount (segment ...) handler] ...)")]))

  (define (apply-append [ls datum]) -> datum
    (let ([out nil])
      (for/each ([l ls]) (set! out (append out l)))
      out)))

(define-syntax routes routes-form)
