;; A module's documentation from its source, read and never run: its header, language, requires and exports, each module
;; named as the compiler finds it, and its items. Its language's doc-forms say which forms define what (the language
;; form's module's, or its language's, else compiler/substrate.sub's); an item is every form defining one name, with its
;; kind, its forms as written less what doc-forms leave out, the comment above each, its section and whether it is
;; exported.
;;
;; In a pattern, NAME is the defined name, _ what a form's text leaves out, a capitalized symbol anything, X ... any
;; number of X and . REST a list's rest. Kinds with a meaning here: within (FORM), requires (MODULE), exports (EXPORT),
;; reexports and renamed (NAME as AS).
(require-unqualified macros compiler/macros)
(require-unqualified rt compiler/roots)
(require-unqualified rd compiler/reader)
(require-unqualified fs host/fs)
(require-unqualified paths std/package/path)

(provide module-doc module-header name-of reached doc-name doc-header doc-language doc-requires doc-reexports doc-items
         item-name item-kind item-public? item-as item-section item-forms form-text form-comment first-sentence)

(define (doc-name [d datum]) -> datum (car d))
(define (doc-header [d datum]) -> datum (cadr d))
(define (doc-language [d datum]) -> datum (caddr d))
(define (doc-requires [d datum]) -> datum (cadddr d))
(define (doc-reexports [d datum]) -> datum (list-ref d 4))
(define (doc-items [d datum]) -> datum (list-ref d 5))

(define (item-name [i datum]) -> datum (car i))
(define (item-kind [i datum]) -> datum (cadr i))
(define (item-public? [i datum]) -> bool (equal? (caddr i) (boolean #t)))
(define (item-as [i datum]) -> datum (cadddr i))
(define (item-section [i datum]) -> datum (list-ref i 4))
(define (item-forms [i datum]) -> datum (list-ref i 5))

(define (form-text [f datum]) -> datum (car f))
(define (form-comment [f datum]) -> datum (cadr f))

;; ---- modules ----

(define (name-of [id datum]) -> datum
  (let ([s (datum->string id)]) (if (ends? s ".sub") (string->datum (slice s 0 (- (-> s length) 4))) id)))

(define (identity-of [spec datum] [from datum]) -> datum
  (let ([id datum 0])
    (try (set! id (module-identity spec from))
         [catch compile-error (message blamed loc) (set! id 0)])
    id))

(define (text-of [id datum]) -> string
  (let ([b (slice u8)] [why string]) (if (< (fs-read-file (datum->string (host-file id)) (& b) (& why)) 0) "" (cast string b))))

(define (forms-of [text string] [id datum]) -> datum (program-forms (read-all text (string->symbol (datum->string id)))))

;; reached gives paths and those of the modules in the root label that their requires and language forms reach.
(define (reached [label datum] [paths datum]) -> datum
  (let ([out nil] [todo paths] [prefix (format "~a/" (cons label nil))])
    (while (pair? todo)
      (let ([p (car todo)])
        (set! todo (cdr todo))
        (when (and (== (member p out) 0) (ends? (datum->string p) ".sub"))
          (let* ([id (format "~a~a" `(,prefix ,p))] [forms datum nil] [sources datum nil] [r datum 0])
            (set! out (cons p out))
            (try (set! forms (forms-of (text-of id) id))
                 [catch compile-error (message blamed loc) (set! forms nil)])
            (set! sources (sources-in forms nil))
            (while (pair? sources)
              (set! r (identity-of (car sources) id))
              (when (and (!= r 0) (starts? (datum->string r) (datum->string prefix)))
                (set! todo (cons (string->datum (slice (datum->string r) (-> (datum->string prefix) length))) todo)))
              (set! sources (cdr sources)))))))
    (reverse out)))

(define (sources-in [forms datum] [out datum]) -> datum
  (while (pair? forms)
    (let ([l (syntax->list (car forms))])
      (when (and (!= l 0) (pair? l) (identifier? (car l)))
        (let ([head (syntax-e (car l))])
          (cond [(or (equal? head 'begin) (equal? head 'begin-for-syntax)) (set! out (sources-in (cdr l) out))]
                [(and (!= (memq head '(require require-unqualified language)) 0) (pair? (cdr l)) (pair? (cddr l))
                      (module-source? (caddr l)))
                 (set! out (cons (caddr l) out))]))))
    (set! forms (cdr forms)))
  out)

(define (module-header [id datum]) -> datum
  (let ([s (source-of (text-of id))] [h (make-buffer)] [d datum 0])
    (header-of (& s) (& h))
    (set! d (string->datum (buffer-string (& h))))
    (buffer-free! (& h))
    d))

;; ---- languages ----

(define descriptions datum nil)

(define (description-of [forms datum] [from datum]) -> datum
  (let ([spec (language-of forms)] [id datum 0])
    (if (== spec 0)
        (described (language-path))
        (begin
          (set! id (identity-of spec from))
          (if (== id 0) 0 (described id))))))

(define (described [id datum]) -> datum
  (let ([known (assoc id descriptions)] [info fs-info] [forms datum 0] [d datum 0] [spec datum 0] [next datum 0])
    (unless (== known 0) (return (cdr known)))
    (when (and (== (fs-stat (datum->string (host-file id)) (& info) 0) 0) (== (-> info kind) fs-file))
      (set! forms (forms-of (text-of id) id))
      (set! d (doc-forms-of forms))
      (set! spec (language-of forms))
      (when (and (== d 0) (!= spec 0))
        (set! next (identity-of spec id))
        (unless (== next 0) (set! d (described next)))))
    (set! descriptions (cons (cons id d) descriptions))
    d))

(define (doc-forms-of [forms datum]) -> datum
  (while (pair? forms)
    (let ([l (splice-list (car forms))])
      (when (and (pair? l) (head? (car l) 'define-syntax) (pair? (cdr l)) (head? (cadr l) 'doc-forms) (pair? (cddr l)))
        (let ([q (splice-list (caddr l))])
          (when (and (pair? q) (head? (car q) 'quote-syntax) (pair? (cdr q))) (return (syntax->datum (cadr q)))))))
    (set! forms (cdr forms)))
  0)

(define (language-of [forms datum]) -> datum
  (let ([l (if (pair? forms) (splice-list (car forms)) 0)])
    (if (and (pair? l) (head? (car l) 'language) (pair? (cdr l)) (pair? (cddr l))) (caddr l) 0)))

(define (head? [s datum] [name datum]) -> bool (and (identifier? s) (equal? (syntax-e s) name)))

;; ---- patterns ----

(define (match-form [patterns datum] [form datum]) -> datum
  (let ([ps patterns] [i u32 0])
    (while (pair? ps)
      (let* ([entry (car ps)]
             [b (if (and (pair? entry) (pair? (cdr entry)) (not (export-kind? (car entry)))) (match-one (cadr entry) form nil) 0)])
        (unless (== b 0) (return `(,(car entry) ,(make-integer i) ,(reverse b)))))
      (set! ps (cdr ps))
      (+= i 1))
    0))

(define (export-kind? [kind datum]) -> bool (or (equal? kind 'renamed) (equal? kind 'reexports)))

(define (matching [patterns datum] [kind datum] [stx datum]) -> datum
  (while (pair? patterns)
    (let ([entry (car patterns)])
      (when (and (pair? entry) (pair? (cdr entry)) (equal? (car entry) kind))
        (let ([b (match-one (cadr entry) stx nil)]) (unless (== b 0) (return b)))))
    (set! patterns (cdr patterns)))
  0)

(define (match-one [pat datum] [stx datum] [binds datum]) -> datum
  (cond [(symbol? pat)
         (cond [(or (equal? pat '_) (variable? pat))
                (if (and (equal? pat 'NAME) (not (identifier? stx))) 0 (cons (cons pat stx) binds))]
               [(head? stx pat) binds]
               [else 0])]
        [(or (pair? pat) (null? pat))
         (let ([e (splice-list stx)]) (if (or (pair? e) (null? e)) (match-seq pat e binds) 0))]
        [(equal? (syntax->datum stx) pat) binds]
        [else 0]))

(define (match-seq [pat datum] [items datum] [binds datum]) -> datum
  (cond [(null? pat) (if (null? items) binds 0)]
        [(symbol? pat)
         (let ([b binds])
           (when (equal? pat '_)
             (while (pair? items)
               (set! b (cons (cons '_ (car items)) b))
               (set! items (cdr items))))
           b)]
        [(and (pair? (cdr pat)) (equal? (cadr pat) '...))
         (let* ([rest (cddr pat)] [k (pairs rest)] [n (pairs items)] [b binds])
           (when (< n k) (return 0))
           (for ([i u32 0]) (< i (- n k)) (+= i 1)
             (set! b (match-one (car pat) (car items) b))
             (when (== b 0) (return 0))
             (set! items (cdr items)))
           (match-seq rest items b))]
        [(pair? items)
         (let ([b (match-one (car pat) (car items) binds)]) (if (== b 0) 0 (match-seq (cdr pat) (cdr items) b)))]
        [else 0]))

(define (variable? [p datum]) -> bool
  (let ([s (symbol->string p)]) (and (> (-> s length) 0) (>= (@ s 0) #\A) (<= (@ s 0) #\Z))))

(define (pairs [l datum]) -> u32
  (let ([n u32 0])
    (while (pair? l)
      (+= n 1)
      (set! l (cdr l)))
    n))

(define (bound [binds datum] [var datum]) -> datum
  (while (pair? binds)
    (when (equal? (car (car binds)) var) (return (cdr (car binds))))
    (set! binds (cdr binds)))
  0)

(define (all-bound [binds datum] [var datum]) -> datum
  (filter (lambda ([s datum]) -> bool (!= s 0))
          (map (lambda ([b datum]) -> datum (if (equal? (car b) var) (cdr b) 0)) binds)))

;; ---- the source's text ----

(struct source [text string] [chars (slice u32)] [lines (slice u32)])

(define (source-of [text string]) -> source
  (let ([s source] [chars (make-buffer)] [lines (make-buffer)] [i u32 0])
    (buffer-add-u32! (& lines) 0)
    (while (< i (-> text length))
      (let ([c (@ text i)])
        (buffer-add-u32! (& chars) i)
        (when (== c 10) (buffer-add-u32! (& lines) (+ i 1)))
        (+= i (cond [(< c 128) 1] [(< c 224) 2] [(< c 240) 3] [else 4]))))
    (buffer-add-u32! (& chars) (-> text length))
    (set! (-> s text) text)
    (set! (-> s chars) (slice (cast (ptr u32) (-> chars bytes)) (/ (-> chars length) 4)))
    (set! (-> s lines) (slice (cast (ptr u32) (-> lines bytes)) (/ (-> lines length) 4)))
    s))

(define (byte-at [s (ptr source)] [pos u32]) -> u32
  (if (< pos (-> s chars length)) (@ (-> s chars) pos) (-> s text length)))

(define (line [s (ptr source)] [n u32]) -> string
  (if (or (== n 0) (> n (-> s lines length)))
      ""
      (let* ([start (@ (-> s lines) (- n 1))]
             [end (if (< n (-> s lines length)) (- (@ (-> s lines) n) 1) (-> s text length))])
        (trimmed (slice (-> s text) start (if (< end start) start end))))))

(define (trimmed [t string]) -> string
  (let ([i u32 0] [j (-> t length)])
    (while (and (< i j) (or (== (@ t i) 32) (== (@ t i) 9))) (+= i 1))
    (while (and (> j i) (or (== (@ t (- j 1)) 32) (== (@ t (- j 1)) 9) (== (@ t (- j 1)) 13))) (-= j 1))
    (slice t i j)))

(define (comment? [t string]) -> bool (and (starts? t ";;") (not (section? t))))

(define (section? [t string]) -> bool (and (starts? t ";; ----") (ends? t "----") (> (-> t length) 15)))

(define (comment-text [t string]) -> string
  (let ([s (slice t 2)]) (if (starts? s " ") (slice s 1) s)))

(define (header-of [s (ptr source)] [into (ptr buffer)]) -> u32
  (let ([n u32 1] [end u32 0])
    (while (and (<= n (-> s lines length)) (== (-> (line s n) length) 0)) (+= n 1))
    (while (and (<= n (-> s lines length)) (comment? (line s n)))
      (when (> (-> into length) 0) (buffer-add-byte! into 10))
      (buffer-add-string! into (comment-text (line s n)))
      (set! end n)
      (+= n 1))
    end))

(define (comment-above [s (ptr source)] [n u32] [after u32]) -> datum
  (let ([first n] [b (make-buffer)] [d datum 0])
    (while (and (> first (+ after 1)) (comment? (line s (- first 1)))) (-= first 1))
    (for ([k u32 first]) (< k n) (+= k 1)
      (when (> (-> b length) 0) (buffer-add-byte! (& b) 10))
      (buffer-add-string! (& b) (comment-text (line s k))))
    (set! d (string->datum (buffer-string (& b))))
    (buffer-free! (& b))
    d))

(define (section-at [s (ptr source)] [n u32]) -> datum
  (let ([k n])
    (while (> k 1)
      (-= k 1)
      (let ([t (line s k)]) (when (section? t) (return (string->datum (trimmed (slice t 7 (- (-> t length) 4))))))))
    '""))

;; ---- forms as written ----

(define (written [s (ptr source)] [stx datum] [cut datum]) -> datum
  (let ([b (make-buffer)] [d datum 0] [loc (syntax-srcloc stx)])
    (write-form! (& b) s stx cut (if (== loc 0) 0 (-> loc col)))
    (set! d (string->datum (buffer-string (& b))))
    (buffer-free! (& b))
    d))

(define (write-form! [b (ptr buffer)] [s (ptr source)] [stx datum] [cut datum] [base u32])
  (let* ([loc (syntax-srcloc stx)] [e (splice-list stx)]
         [from (if (== loc 0) 0 (byte-at s (-> loc pos)))] [to (if (== loc 0) 0 (byte-at s (+ (-> loc pos) (-> loc span))))])
    (cond [(== loc 0) (buffer-add-string! b (datum->string (format "~s" (cons (syntax->datum stx) nil))))]
          [(and (or (pair? e) (null? e)) (> to from) (or (== (@ (-> s text) from) #\() (== (@ (-> s text) from) #\[)))
           (let ([prev datum 0])
             (buffer-add-byte! b (cast i32 (@ (-> s text) from)))
             (while (pair? e)
               (when (== (memq (car e) cut) 0)
                 (unless (== prev 0) (gap! b s prev (car e) base))
                 (write-form! b s (car e) cut base)
                 (set! prev (car e)))
               (set! e (cdr e)))
             (unless (or (null? e) (== prev 0))
               (gap! b s prev e base)
               (buffer-add-string! b ". ")
               (write-form! b s e cut base))
             (buffer-add-byte! b (cast i32 (@ (-> s text) (- to 1)))))]
          [else (buffer-add-string! b (slice (-> s text) from to))])))

(define (gap! [b (ptr buffer)] [s (ptr source)] [prev datum] [next datum] [base u32])
  (let* ([p (syntax-srcloc prev)] [n (syntax-srcloc next)] [broken #f]
         [from (if (== p 0) 0 (byte-at s (+ (-> p pos) (-> p span))))] [to (if (== n 0) 0 (byte-at s (-> n pos)))])
    (for ([i u32 from]) (< i to) (+= i 1) (when (== (@ (-> s text) i) 10) (set! broken #t)))
    (if broken
        (begin
          (buffer-add-byte! b 10)
          (for ([i u32 base]) (< i (-> n col)) (+= i 1) (buffer-add-byte! b 32)))
        (buffer-add-byte! b 32))))

;; ---- a module's documentation ----

(define (module-doc [id datum]) -> datum
  (let* ([text (text-of id)] [forms (forms-of text id)] [patterns (description-of forms id)] [s (source-of text)]
         [h (make-buffer)] [after (header-of (& s) (& h))] [header (string->datum (buffer-string (& h)))]
         [language '""] [requires nil] [exports nil] [reexports nil] [found nil] [todo forms])
    (buffer-free! (& h))
    (while (pair? todo)
      (let* ([f (car todo)] [l (splice-list f)] [m (if (== patterns 0) 0 (match-form patterns f))])
        (set! todo (cdr todo))
        (cond [(and (pair? l) (head? (car l) 'language) (pair? (cdr l)) (pair? (cddr l)))
               (set! language (named (& s) (caddr l) id))]
              [(== m 0) (begin)]
              [(equal? (car m) 'within) (set! todo (append (all-bound (caddr m) 'FORM) todo))]
              [(equal? (car m) 'requires)
               (let ([module (bound (caddr m) 'MODULE)])
                 (unless (== module 0) (set! requires (cons (named (& s) module id) requires))))]
              [(equal? (car m) 'exports)
               (for-each (lambda ([x datum])
                           (let ([r (matching patterns 'renamed x)])
                             (cond [(identifier? x)
                                    (set! exports (cons (cons (symbol->string-datum (syntax-e x)) '"") exports))]
                                   [(!= (matching patterns 'reexports x) 0) (set! reexports (cons (written (& s) x nil) reexports))]
                                   [(and (!= r 0) (identifier? (bound r 'NAME)) (identifier? (bound r 'AS)))
                                    (set! exports (cons (cons (symbol->string-datum (syntax-e (bound r 'NAME)))
                                                              (symbol->string-datum (syntax-e (bound r 'AS))))
                                                        exports))]
                                   [else (set! reexports (cons (written (& s) x nil) reexports))])))
                         (all-bound (caddr m) 'EXPORT))]
              [else
               (let ([id (bound (caddr m) 'NAME)] [loc (syntax-srcloc f)])
                 (unless (or (== id 0) (== loc 0))
                   (set! found (cons `(,(symbol->string-datum (syntax-e id)) ,(cadr m)
                                       ,(symbol->string-datum (car m))
                                       ,(written (& s) f (all-bound (caddr m) '_))
                                       ,(comment-above (& s) (-> loc line) after)
                                       ,(section-at (& s) (-> loc line)))
                                     found))))])))
    `(,(name-of id) ,header ,language ,(reverse requires) ,(reverse reexports) ,(items-of (reverse found) exports))))

(define (named [s (ptr source)] [spec datum] [from datum]) -> datum
  (let ([id (identity-of spec from)]) (if (== id 0) (written s spec nil) (name-of id))))

(define (symbol->string-datum [x datum]) -> datum (string->datum (symbol->string x)))

(define (items-of [found datum] [exports datum]) -> datum
  (let ([names nil] [out nil])
    (for-each (lambda ([f datum]) (when (== (member (car f) names) 0) (set! names (cons (car f) names)))) found)
    (for-each (lambda ([n datum])
                (let* ([fs (sort (filter (lambda ([f datum]) -> bool (equal? (car f) n)) found)
                                 (lambda ([a datum] [b datum]) -> bool (< (integer-value (cadr a)) (integer-value (cadr b)))))]
                       [first (car (filter (lambda ([f datum]) -> bool (equal? (car f) n)) found))]
                       [e (assoc n exports)])
                  (set! out (cons `(,n ,(caddr (car fs)) ,(boolean (!= e 0)) ,(if (== e 0) '"" (cdr e)) ,(list-ref first 5)
                                   ,(map (lambda ([f datum]) -> datum `(,(cadddr f) ,(list-ref f 4))) fs))
                                out))))
              (reverse names))
    (reverse out)))

(define (first-sentence [header datum]) -> datum
  (let* ([t (datum->string header)] [i u32 0] [b (make-buffer)] [d datum 0])
    (while (and (< i (-> t length))
                (not (and (== (@ t i) #\.) (or (== (+ i 1) (-> t length)) (== (@ t (+ i 1)) 32) (== (@ t (+ i 1)) 10)))))
      (buffer-add-byte! (& b) (if (== (@ t i) 10) 32 (cast i32 (@ t i))))
      (+= i 1))
    (when (< i (-> t length)) (buffer-add-byte! (& b) #\.))
    (set! d (string->datum (buffer-string (& b))))
    (buffer-free! (& b))
    d))
