;; The documentation of a root, a package or a root of the toolchain, from its label, its modules and its public
;; modules. Each module has its documentation, with the package it is private to when it is private. Each directory has
;; an index: the header of its main module, then its public modules and subdirectories, each with the first sentence of
;; its header, then its private modules. The root's main module is label.sub.
(require-unqualified compiler/macros)
(require-unqualified "doc.sub")
(require-unqualified compiler/path)

(provide root-doc directory-index owner-of)

(define (root-doc [label datum] [modules datum] [public datum]) -> datum
  (let* ([docs (map (lambda ([r datum]) -> datum `(,r ,(module-doc (identity-in label r)) ,(owner-of label public r))) modules)]
         [heads (map (lambda ([e datum]) -> datum `(,(car e) ,(doc-name (cadr e)) ,(doc-header (cadr e)) ,(caddr e))) docs)])
    `(,label ,docs ,(map (lambda ([dir datum]) -> datum (index-of label (datum->string dir) heads)) (directories modules)))))

;; directory-index gives a directory's index, reading only the headers of its modules.
(define (directory-index [label datum] [dir string] [modules datum] [public datum]) -> datum
  (index-of label dir
            (map (lambda ([r datum]) -> datum
                   (let ([id (identity-in label r)]) `(,r ,(name-of id) ,(module-header id) ,(owner-of label public r))))
                 (filter (lambda ([r datum]) -> bool (or (== (-> dir length) 0) (path-within? #f (datum->string r) dir))) modules))))

(define (owner-of [label datum] [public datum] [rel datum]) -> datum (if (== (member rel public) 0) label '""))

(define (identity-in [label datum] [rel datum]) -> datum (format "~a/~a" `(,label ,rel)))

(define (index-of [label datum] [dir string] [heads datum]) -> datum
  (let ([name (if (== (-> dir length) 0) label (format "~a/~a" `(,label ,(string->datum dir))))]
        [modules nil] [private nil] [subdirs nil])
    (for-each (lambda ([h datum])
                (let* ([r (datum->string (car h))] [sub (child-of dir r)] [entry (cons (cadr h) (first-sentence (caddr h)))])
                  (when (== (parent-in r) dir)
                    (if (equal? (cadddr h) '"") (set! modules (cons entry modules)) (set! private (cons entry private))))
                  (when (and (> (-> sub length) 0) (== (member (string->datum sub) subdirs) 0))
                    (set! subdirs (cons (string->datum sub) subdirs)))))
              heads)
    `(,name ,(header-in (main-of label dir) heads)
      ,(append (reverse modules)
               (map (lambda ([s datum]) -> datum
                      (cons (format "~a/~a/" `(,label ,s)) (first-sentence (header-in (main-of label (datum->string s)) heads))))
                    (reverse subdirs)))
      ,(reverse private))))

(define (main-of [label datum] [dir string]) -> datum
  (if (== (-> dir length) 0) (format "~a.sub" `(,label)) (format "~a/~a.sub" `(,(string->datum dir) ,(string->datum (path-base #f dir))))))

(define (header-in [rel datum] [heads datum]) -> datum
  (let ([h (assoc rel heads)]) (if (== h 0) '"" (caddr h))))

(define (directories [rels datum]) -> datum
  (let ([out (cons '"" nil)])
    (for-each (lambda ([r datum])
                (let ([d (datum->string r)] [i u32 0])
                  (while (< i (-> d length))
                    (when (== (@ d i) #\/)
                      (let ([dir (string->datum (slice d 0 i))]) (when (== (member dir out) 0) (set! out (cons dir out)))))
                    (+= i 1))))
              rels)
    (sort out (lambda ([x datum] [y datum]) -> bool (< (datum->string x) (datum->string y))))))

(define (child-of [dir string] [rel string]) -> string
  (let ([i (if (== (-> dir length) 0) 0 (+ (-> dir length) 1))])
    (unless (or (== (-> dir length) 0) (path-within? #f rel dir)) (return ""))
    (while (and (< i (-> rel length)) (!= (@ rel i) #\/)) (+= i 1))
    (if (== i (-> rel length)) "" (slice rel 0 i))))

(define (parent-in [rel string]) -> string
  (let ([i (-> rel length)])
    (while (and (> i 0) (!= (@ rel (- i 1)) #\/)) (-= i 1))
    (if (== i 0) "" (slice rel 0 (- i 1)))))
