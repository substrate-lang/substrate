;; Documentation as HTML pages, one per module and one per directory, at each one's name under the output directory: a
;; module's page has its items under the module's sections, public then private, with a sidebar of them by kind; a
;; directory's lists its modules and directories, the private modules below. Pages link to each other, and a type's
;; name in a signature links to where the type is defined.
(require-unqualified macros compiler/macros)
(require-unqualified doc "doc.sub")
(require-unqualified html std/html)
(require-unqualified paths std/package/path)

(provide html-files)

;; module-page takes the names of the documented modules, for each type a signature may name the module defining it,
;; and the package the module is private to, if it is.
(define (module-page [d datum] [names datum] [types datum] [owner datum]) -> datum
  (let* ([b (make-buffer)] [name (datum->string (doc-name d))] [dir (directory-of name)] [items (doc-items d)]
         [public (filter (lambda ([i datum]) -> bool (item-public? i)) items)]
         [private (filter (lambda ([i datum]) -> bool (not (item-public? i))) items)] [s datum 0])
    (started! (& b) name dir name)
    (classed! (& b) "div" "page")
    (line! (& b))
    (classed! (& b) "aside" "items")
    (line! (& b))
    (sidebar! (& b) public)
    (unless (null? private)
      (heading! (& b) "h2" "part" "private")
      (sidebar! (& b) private))
    (closed! (& b) "aside")
    (tag! (& b) "main")
    (line! (& b))
    (heading! (& b) "h1" "" name)
    (paragraphs! (& b) (doc-header d))
    (meta! (& b) d dir names owner)
    (part! (& b) public dir name types)
    (unless (null? private)
      (heading! (& b) "h2" "part" "private")
      (part! (& b) private dir name types))
    (closed! (& b) "main")
    (closed! (& b) "div")
    (finished! (& b))
    (set! s (string->datum (buffer-string (& b))))
    (buffer-free! (& b))
    s))

;; html-files gives the files of roots' documentation, each path with its page: index.html listing the roots, each module's
;; and each directory's page at its name, and style.css.
(define (html-files [roots datum]) -> datum
  (let ([docs nil] [names nil] [labels nil] [rs roots] [es datum 0] [is datum 0] [out nil])
    (while (pair? rs)
      (set! labels (cons (car (car rs)) labels))
      (set! docs (append docs (cadr (car rs))))
      (set! rs (cdr rs)))
    (set! names (map (lambda ([e datum]) -> datum (doc-name (cadr e))) docs))
    (set! es docs)
    (while (pair? es)
      (let ([d (cadr (car es))])
        (set! out (cons (cons (format "~a.html" `(,(doc-name d))) (module-page d names (types-for d docs) (caddr (car es)))) out)))
      (set! es (cdr es)))
    (set! rs roots)
    (while (pair? rs)
      (set! is (caddr (car rs)))
      (while (pair? is)
        (set! out (cons (cons (format "~a/index.html" `(,(car (car is)))) (index-page (car is))) out))
        (set! is (cdr is)))
      (set! rs (cdr rs)))
    (set! out (cons (cons '"index.html" (top-page (reverse labels))) out))
    (reverse (cons (cons '"style.css" (string->datum page-style)) out))))

;; types-for gives each type a signature in a module may name, its own and those of the modules it requires, with the
;; module that defines it.
(define (types-for [d datum] [docs datum]) -> datum
  (let ([out nil] [ms (cons (doc-name d) (doc-requires d))] [es datum 0] [is datum 0])
    (while (pair? ms)
      (set! es docs)
      (while (pair? es)
        (when (equal? (doc-name (cadr (car es))) (car ms))
          (set! is (doc-items (cadr (car es))))
          (while (pair? is)
            (when (equal? (item-kind (car is)) '"type") (set! out (cons (cons (item-name (car is)) (car ms)) out)))
            (set! is (cdr is))))
        (set! es (cdr es)))
      (set! ms (cdr ms)))
    (reverse out)))

(define (index-page [index datum]) -> datum
  (let* ([b (make-buffer)] [name (datum->string (car index))] [s datum 0])
    (started! (& b) name name name)
    (classed! (& b) "main" "index")
    (line! (& b))
    (heading! (& b) "h1" "" name)
    (paragraphs! (& b) (cadr index))
    (entries! (& b) name (caddr index))
    (unless (null? (cadddr index))
      (heading! (& b) "h2" "part" "private")
      (entries! (& b) name (cadddr index)))
    (closed! (& b) "main")
    (finished! (& b))
    (set! s (string->datum (buffer-string (& b))))
    (buffer-free! (& b))
    s))

(define (entries! [b (ptr buffer)] [name string] [entries datum])
  (classed! b "table" "entries")
  (line! b)
  (for-each (lambda ([e datum])
              (let ([n (datum->string (car e))])
                (tag! b "tr")
                (tag! b "td")
                (linked! b (link name (if (ends? n "/") (joined n "index.html") (joined n ".html"))) n)
                (html-close! b "td")
                (element! b "td" "" (datum->string (cdr e)))
                (closed! b "tr")))
            entries)
  (closed! b "table"))

(define (top-page [labels datum]) -> datum
  (let ([b (make-buffer)] [s datum 0])
    (started! (& b) "documentation" "" "")
    (classed! (& b) "main" "index")
    (line! (& b))
    (classed! (& b) "table" "entries")
    (line! (& b))
    (for-each (lambda ([l datum])
                (tag! (& b) "tr")
                (tag! (& b) "td")
                (linked! (& b) (joined (datum->string l) "/index.html") (datum->string l))
                (html-close! (& b) "td")
                (closed! (& b) "tr"))
              labels)
    (closed! (& b) "table")
    (closed! (& b) "main")
    (finished! (& b))
    (set! s (string->datum (buffer-string (& b))))
    (buffer-free! (& b))
    s))

;; ---- the page ----

(define (started! [b (ptr buffer)] [title string] [dir string] [path string])
  (buffer-add-string! b "<!doctype html>\n")
  (html-open! b "html")
  (html-attribute! b "lang" "en")
  (html-opened! b)
  (line! b)
  (tag! b "head")
  (line! b)
  (html-open! b "meta")
  (html-attribute! b "charset" "utf-8")
  (html-opened! b)
  (line! b)
  (html-open! b "meta")
  (html-attribute! b "name" "viewport")
  (html-attribute! b "content" "width=device-width, initial-scale=1")
  (html-opened! b)
  (line! b)
  (heading! b "title" "" title)
  (html-open! b "link")
  (html-attribute! b "rel" "stylesheet")
  (html-attribute! b "href" (link dir "style.css"))
  (html-opened! b)
  (line! b)
  (closed! b "head")
  (tag! b "body")
  (line! b)
  (classed! b "nav" "crumbs")
  (linked! b (link dir "index.html") "documentation")
  (let ([start u32 0])
    (for ([i u32 0]) (<= i (-> path length)) (+= i 1)
      (when (and (> (-> path length) 0) (or (== i (-> path length)) (== (@ path i) #\/)))
        (html-text! b " / ")
        (if (== i (-> path length))
            (html-text! b (slice path start i))
            (linked! b (link dir (joined-path (slice path 0 i) "index.html")) (slice path start i)))
        (set! start (+ i 1)))))
  (closed! b "nav"))

(define (finished! [b (ptr buffer)])
  (closed! b "body")
  (closed! b "html"))

(define (paragraphs! [b (ptr buffer)] [text datum])
  (let ([t (datum->string text)] [start u32 0])
    (for ([i u32 0]) (<= i (-> t length)) (+= i 1)
      (when (or (== i (-> t length)) (and (== (@ t i) 10) (< (+ i 1) (-> t length)) (== (@ t (+ i 1)) 10)))
        (when (> i start)
          (tag! b "p")
          (for ([k u32 start]) (< k i) (+= k 1)
            (if (== (@ t k) 10) (buffer-add-byte! b 32) (html-text! b (slice t k (+ k 1)))))
          (closed! b "p"))
        (set! start (+ i 2))))))

(define (meta! [b (ptr buffer)] [d datum] [dir string] [names datum] [owner datum])
  (unless (and (equal? owner '"") (equal? (doc-language d) '"") (null? (doc-requires d)) (null? (doc-reexports d)))
    (classed! b "dl" "meta")
    (line! b)
    (unless (equal? owner '"")
      (element! b "dt" "" "private to")
      (tag! b "dd")
      (element! b "code" "" (datum->string owner))
      (closed! b "dd"))
    (unless (equal? (doc-language d) '"")
      (element! b "dt" "" "language")
      (tag! b "dd")
      (named! b (doc-language d) dir names)
      (closed! b "dd"))
    (unless (null? (doc-requires d))
      (element! b "dt" "" "requires")
      (tag! b "dd")
      (for-each (lambda ([r datum]) (named! b r dir names) (html-text! b " ")) (doc-requires d))
      (closed! b "dd"))
    (unless (null? (doc-reexports d))
      (element! b "dt" "" "re-exports")
      (tag! b "dd")
      (for-each (lambda ([r datum]) (element! b "code" "" (datum->string r)) (html-text! b " ")) (doc-reexports d))
      (closed! b "dd"))
    (closed! b "dl")))

(define (named! [b (ptr buffer)] [name datum] [dir string] [names datum])
  (if (== (member name names) 0)
      (element! b "code" "" (datum->string name))
      (begin
        (html-open! b "a")
        (html-attribute! b "href" (link dir (joined (datum->string name) ".html")))
        (html-opened! b)
        (element! b "code" "" (datum->string name))
        (html-close! b "a"))))

;; ---- items ----

(define (sidebar! [b (ptr buffer)] [items datum])
  (let ([kinds nil])
    (for-each (lambda ([i datum]) (when (== (member (item-kind i) kinds) 0) (set! kinds (cons (item-kind i) kinds)))) items)
    (set! kinds (reverse kinds))
    (while (pair? kinds)
      (heading! b "h2" "" (datum->string (car kinds)))
      (tag! b "ul")
      (line! b)
      (let ([is items])
        (while (pair? is)
          (when (equal? (item-kind (car is)) (car kinds))
            (tag! b "li")
            (linked! b (joined "#" (datum->string (item-name (car is)))) (datum->string (item-name (car is))))
            (closed! b "li"))
          (set! is (cdr is))))
      (closed! b "ul")
      (set! kinds (cdr kinds)))))

(define (part! [b (ptr buffer)] [items datum] [dir string] [module string] [types datum])
  (let ([section '""])
    (for-each (lambda ([i datum])
                (unless (or (equal? (item-section i) section) (equal? (item-section i) '""))
                  (heading! b "h3" "section" (datum->string (item-section i))))
                (set! section (item-section i))
                (item! b i dir module types))
              items)))

(define (item! [b (ptr buffer)] [i datum] [dir string] [module string] [types datum])
  (html-open! b "section")
  (html-attribute! b "class" "item")
  (html-attribute! b "id" (datum->string (item-name i)))
  (html-opened! b)
  (line! b)
  (tag! b "h4")
  (element! b "code" "" (datum->string (item-name i)))
  (html-text! b " ")
  (classed! b "span" "kind")
  (html-text! b (datum->string (item-kind i)))
  (unless (equal? (item-as i) '"")
    (html-text! b ", exported as ")
    (element! b "code" "" (datum->string (item-as i))))
  (html-close! b "span")
  (closed! b "h4")
  (for-each (lambda ([f datum])
              (tag! b "pre")
              (tag! b "code")
              (signature! b (datum->string (form-text f)) dir module types (datum->string (item-name i)))
              (html-close! b "code")
              (closed! b "pre")
              (paragraphs! b (form-comment f)))
            (item-forms i))
  (closed! b "section"))

(define (signature! [b (ptr buffer)] [t string] [dir string] [module string] [types datum] [own string])
  (let ([i u32 0])
    (while (< i (-> t length))
      (let ([c (@ t i)] [start i])
        (cond [(== c 34)
               (+= i 1)
               (while (and (< i (-> t length)) (!= (@ t i) 34)) (+= i (if (== (@ t i) #\\) 2 1)))
               (when (< i (-> t length)) (+= i 1))
               (html-text! b (slice t start i))]
              [(delimiter? c)
               (html-text! b (slice t i (+ i 1)))
               (+= i 1)]
              [else
               (while (and (< i (-> t length)) (not (delimiter? (@ t i)))) (+= i 1))
               (let ([e (assoc (string->datum (slice t start i)) types)])
                 (if (or (== e 0) (and (== (slice t start i) own) (== (datum->string (cdr e)) module)))
                     (html-text! b (slice t start i))
                     (linked! b (joined (if (== (datum->string (cdr e)) module) "" (link dir (joined (datum->string (cdr e)) ".html")))
                                        (joined "#" (slice t start i)))
                              (slice t start i))))])))))

(define (delimiter? [c u8]) -> bool
  (or (== c 32) (== c 10) (== c 9) (== c #\() (== c #\)) (== c #\[) (== c #\]) (== c 34) (== c #\;) (== c 39) (== c 96)
      (== c #\,)))

;; ---- elements ----

(define (tag! [b (ptr buffer)] [element string])
  (html-open! b element)
  (html-opened! b))

(define (classed! [b (ptr buffer)] [element string] [class string])
  (html-open! b element)
  (html-attribute! b "class" class)
  (html-opened! b))

(define (element! [b (ptr buffer)] [element string] [class string] [text string])
  (if (== (-> class length) 0) (tag! b element) (classed! b element class))
  (html-text! b text)
  (html-close! b element))

(define (heading! [b (ptr buffer)] [element string] [class string] [text string])
  (element! b element class text)
  (line! b))

(define (linked! [b (ptr buffer)] [href string] [text string])
  (html-open! b "a")
  (html-attribute! b "href" href)
  (html-opened! b)
  (html-text! b text)
  (html-close! b "a"))

(define (closed! [b (ptr buffer)] [element string])
  (html-close! b element)
  (line! b))

(define (line! [b (ptr buffer)]) (buffer-add-byte! b 10))

;; ---- paths ----

(define (directory-of [name string]) -> string
  (let ([i (-> name length)])
    (while (and (> i 0) (!= (@ name (- i 1)) #\/)) (-= i 1))
    (if (== i 0) "" (slice name 0 (- i 1)))))

;; link gives the path from the directory dir to the file to, both under the output directory, which "" is.
(define (link [dir string] [to string]) -> string
  (let ([d dir] [t to] [out (make-buffer)])
    (while (and (> (-> d length) 0) (< (slash-in t) (-> t length)) (== (slice d 0 (slash-in d)) (slice t 0 (slash-in t))))
      (set! d (after-slash d))
      (set! t (after-slash t)))
    (when (> (-> d length) 0)
      (buffer-add-string! (& out) "../")
      (for ([i u32 0]) (< i (-> d length)) (+= i 1) (when (== (@ d i) #\/) (buffer-add-string! (& out) "../"))))
    (buffer-add-string! (& out) t)
    (buffer-string (& out))))

(define (slash-in [p string]) -> u32
  (let ([i u32 0])
    (while (and (< i (-> p length)) (!= (@ p i) #\/)) (+= i 1))
    i))

(define (after-slash [p string]) -> string (if (< (slash-in p) (-> p length)) (slice p (+ (slash-in p) 1)) ""))

(define (joined [x string] [y string]) -> string
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) x)
    (buffer-add-string! (& b) y)
    (buffer-string (& b))))

(define page-style string
  ":root { color-scheme: light dark; --fg: #1f2328; --bg: #ffffff; --muted: #59636e; --line: #d1d9e0; --code: #f6f8fa; --link: #0969da; }
@media (prefers-color-scheme: dark) { :root { --fg: #e6edf3; --bg: #0d1117; --muted: #9198a1; --line: #3d444d; --code: #151b23; --link: #4493f8; } }
* { box-sizing: border-box; }
body { margin: 0; font: 15px/1.55 system-ui, -apple-system, sans-serif; color: var(--fg); background: var(--bg); }
a { color: var(--link); text-decoration: none; }
a:hover { text-decoration: underline; }
code, pre { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
.crumbs { padding: 10px 24px; border-bottom: 1px solid var(--line); font-family: ui-monospace, Menlo, monospace; font-size: 14px; }
.page { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 32px; max-width: 1180px; padding: 0 24px; }
aside.items { position: sticky; top: 0; align-self: start; max-height: 100vh; overflow: auto; padding: 16px 0 32px; font-size: 13px; }
aside h2 { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); margin: 14px 0 4px; }
aside h2.part { color: var(--fg); border-top: 1px solid var(--line); padding-top: 12px; }
aside ul { list-style: none; margin: 0; padding: 0; }
aside li { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: ui-monospace, Menlo, monospace; }
main { padding: 8px 0 64px; min-width: 0; }
main.index { max-width: 1000px; padding: 8px 24px 64px; }
h1 { font-family: ui-monospace, Menlo, monospace; font-size: 24px; margin: 16px 0 8px; }
h2.part { margin: 40px 0 0; padding-top: 16px; border-top: 2px solid var(--line); font-size: 18px; }
h3.section { margin: 32px 0 0; padding-bottom: 4px; border-bottom: 1px solid var(--line); font-size: 16px; }
h4 { margin: 22px 0 6px; font-size: 15px; }
.kind { color: var(--muted); font-weight: normal; font-size: 13px; margin-left: 6px; }
pre { background: var(--code); padding: 10px 12px; border-radius: 6px; overflow-x: auto; font-size: 13px; line-height: 1.45; margin: 6px 0; }
.meta { display: grid; grid-template-columns: max-content 1fr; gap: 2px 16px; font-size: 14px; }
.meta dt { color: var(--muted); }
.meta dd { margin: 0; }
table.entries { border-collapse: collapse; }
table.entries td { padding: 5px 20px 5px 0; vertical-align: top; }
table.entries td:first-child { white-space: nowrap; font-family: ui-monospace, Menlo, monospace; font-size: 14px; }
@media (max-width: 760px) { .page { grid-template-columns: 1fr; } aside.items { position: static; max-height: none; } }
")
