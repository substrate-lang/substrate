;; Documentation as HTML: a page for each module and each directory. A module's page lists its items by section, public
;; items first, with a sidebar of them by kind. A directory's page lists its modules, private ones last. Type names in
;; signatures link to their definitions. Each page is a tree std/html writes.
(require-unqualified compiler/macros)
(require-unqualified "doc.sub")
(require-unqualified std/html)
(require-unqualified compiler/path)
(require-unqualified std/string)

(provide html-files)

;; html-files gives the files to write, each a path and its content: index.html, a page for each module and directory,
;; and style.css.
(define (html-files [roots datum]) -> datum
  (let ([docs nil] [names nil] [labels nil] [rs roots] [es datum 0] [is datum 0] [out nil])
    (while (pair? rs)
      (set! labels (cons (car (car rs)) labels))
      (set! docs (append docs (cadr (car rs))))
      (set! rs (cdr rs)))
    (set! names (map (lambda ([e datum]) -> datum (doc-name (cadr e))) docs))
    (set! es docs)
    (while (pair? es)
      (let ([d (cadr (car es))])
        (set! out (cons (cons (format "~a.html" `(,(doc-name d))) (module-page d names (types-for d docs) (caddr (car es)))) out)))
      (set! es (cdr es)))
    (set! rs roots)
    (while (pair? rs)
      (set! is (caddr (car rs)))
      (while (pair? is)
        (set! out (cons (cons (format "~a/index.html" `(,(car (car is)))) (index-page (car is))) out))
        (set! is (cdr is)))
      (set! rs (cdr rs)))
    (set! out (cons (cons '"index.html" (top-page (reverse labels))) out))
    (reverse (cons (cons '"style.css" (string->datum page-style)) out))))

;; types-for gives the types a module's signatures may name, from the module and the modules it requires, each with the
;; module that defines it.
(define (types-for [d datum] [docs datum]) -> datum
  (let ([out nil] [ms (cons (doc-name d) (doc-requires d))] [es datum 0] [is datum 0])
    (while (pair? ms)
      (set! es docs)
      (while (pair? es)
        (when (equal? (doc-name (cadr (car es))) (car ms))
          (set! is (doc-items (cadr (car es))))
          (while (pair? is)
            (when (equal? (item-kind (car is)) '"type") (set! out (cons (cons (item-name (car is)) (car ms)) out)))
            (set! is (cdr is))))
        (set! es (cdr es)))
      (set! ms (cdr ms)))
    (reverse out)))

;; ---- pages ----

;; module-page makes the page of module d. names lists the documented modules, types comes from types-for, and owner is
;; the package d is private to, or "".
(define (module-page [d datum] [names datum] [types datum] [owner datum]) -> datum
  (let* ([name (datum->string (doc-name d))] [dir (directory-of name)] [items (doc-items d)]
         [public (filter (lambda ([i datum]) -> bool (item-public? i)) items)]
         [private (filter (lambda ([i datum]) -> bool (not (item-public? i))) items)])
    (page name dir name
          `((div ((class "page"))
                 (aside ((class "items")) ,@(sidebar public) ,@(privately private (sidebar private)))
                 (main (h1 ,(doc-name d)) ,@(paragraphs (doc-header d)) ,@(meta d dir names owner)
                       ,@(part public dir name types) ,@(privately private (part private dir name types))))))))

(define (index-page [index datum]) -> datum
  (let ([name (datum->string (car index))])
    (page name name name
          `((main ((class "index")) (h1 ,(car index)) ,@(paragraphs (cadr index)) ,(entries name (caddr index))
                  ,@(privately (cadddr index) (cons (entries name (cadddr index)) nil)))))))

(define (top-page [labels datum]) -> datum
  (page "documentation" "" ""
        `((main ((class "index"))
                (table ((class "entries"))
                       ,@(map (lambda ([l datum]) -> datum (row (linked (format "~a/index.html" (cons l nil)) l) 0)) labels))))))

(define (page [title string] [dir string] [path string] [body datum]) -> datum
  (let ([b (make-buffer)] [s datum 0])
    (buffer-add-string! (& b) "<!doctype html>\n")
    (html-tree! (& b) `(html ((lang "en"))
                             (head (meta ((charset "utf-8")))
                                   (meta ((name "viewport") (content "width=device-width, initial-scale=1")))
                                   (title ,(string->datum title))
                                   (link ((rel "stylesheet") (href ,(string->datum (link dir "style.css"))))))
                             (body (nav ((class "crumbs")) ,@(crumbs dir path)) ,@body)))
    (set! s (string->datum (buffer-string (& b))))
    (buffer-free! (& b))
    s))

(define (crumbs [dir string] [path string]) -> datum
  (let ([out (cons (linked (string->datum (link dir "index.html")) '"documentation") nil)] [start u32 0])
    (for ([i u32 0]) (<= i (-> path length)) (+= i 1)
      (when (and (> (-> path length) 0) (or (== i (-> path length)) (== (@ path i) #\/)))
        (set! out (cons (if (== i (-> path length))
                            (string->datum (slice path start i))
                            (linked (string->datum (link dir (path-joined #f (slice path 0 i) "index.html"))) (string->datum (slice path start i))))
                        (cons '" / " out)))
        (set! start (+ i 1))))
    (reverse out)))

(define (paragraphs [text datum]) -> datum
  (let ([t (datum->string text)] [start u32 0] [out nil])
    (for ([i u32 0]) (<= i (-> t length)) (+= i 1)
      (when (or (== i (-> t length)) (and (== (@ t i) #\newline) (< (+ i 1) (-> t length)) (== (@ t (+ i 1)) #\newline)))
        (when (> i start) (set! out (cons `(p ,(string->datum (slice t start i))) out)))
        (set! start (+ i 2))))
    (reverse out)))

(define (meta [d datum] [dir string] [names datum] [owner datum]) -> datum
  (let ([rows nil])
    (unless (equal? owner '"") (set! rows `((dt "private to") (dd ,(code owner)))))
    (unless (equal? (doc-language d) '"")
      (set! rows (append rows `((dt "language") (dd ,(named (doc-language d) dir names))))))
    (unless (null? (doc-requires d))
      (set! rows (append rows `((dt "requires") (dd ,@(separated (map (lambda ([r datum]) -> datum (named r dir names)) (doc-requires d))))))))
    (unless (null? (doc-reexports d))
      (set! rows (append rows `((dt "re-exports") (dd ,@(separated (map (lambda ([r datum]) -> datum (code r)) (doc-reexports d))))))))
    (if (null? rows) nil `((dl ((class "meta")) ,@rows)))))

(define (entries [name string] [es datum]) -> datum
  `(table ((class "entries"))
          ,@(map (lambda ([e datum]) -> datum
                   (row (linked (string->datum (link name (entry-page (datum->string (car e))))) (car e)) (cdr e)))
                 es)))

(define (entry-page [n string]) -> string
  (if (string-suffix? n "/") (string-append 0 n "index.html") (string-append 0 n ".html")))

(define (row [first datum] [second datum]) -> datum (if (== second 0) `(tr (td ,first)) `(tr (td ,first) (td ,second))))

(define (privately [items datum] [trees datum]) -> datum (if (null? items) nil (cons '(h2 ((class "part")) "private") trees)))

(define (named [name datum] [dir string] [names datum]) -> datum
  (if (== (member name names) 0) (code name) (linked (string->datum (link dir (string-append 0 (datum->string name) ".html"))) (code name))))

(define (linked [href datum] [child datum]) -> datum `(a ((href ,href)) ,child))

(define (code [x datum]) -> datum `(code ,x))

(define (separated [l datum]) -> datum (if (or (null? l) (null? (cdr l))) l (cons (car l) (cons '" " (separated (cdr l))))))

;; ---- items ----

(define (sidebar [items datum]) -> datum
  (let ([kinds nil] [out nil] [is datum 0] [links nil])
    (for-each (lambda ([i datum]) (when (== (member (item-kind i) kinds) 0) (set! kinds (cons (item-kind i) kinds)))) items)
    (set! kinds (reverse kinds))
    (while (pair? kinds)
      (set! links nil)
      (set! is items)
      (while (pair? is)
        (when (equal? (item-kind (car is)) (car kinds))
          (set! links (cons `(li ,(linked (format "#~a" (cons (item-name (car is)) nil)) (item-name (car is)))) links)))
        (set! is (cdr is)))
      (set! out (append out `((h2 ,(car kinds)) (ul ,@(reverse links)))))
      (set! kinds (cdr kinds)))
    out))

(define (part [items datum] [dir string] [module string] [types datum]) -> datum
  (let ([section '""] [out nil])
    (for-each (lambda ([i datum])
                (unless (or (equal? (item-section i) section) (equal? (item-section i) '""))
                  (set! out (cons `(h3 ((class "section")) ,(item-section i)) out)))
                (set! section (item-section i))
                (set! out (cons (item i dir module types) out)))
              items)
    (reverse out)))

(define (item [i datum] [dir string] [module string] [types datum]) -> datum
  (let ([forms nil] [fs (item-forms i)])
    (while (pair? fs)
      (set! forms (append forms (cons `(pre ,(cons 'code (signature (datum->string (form-text (car fs))) dir module types
                                                                     (datum->string (item-name i)))))
                                      (paragraphs (form-comment (car fs))))))
      (set! fs (cdr fs)))
    `(section ((class "item") (id ,(item-name i)))
              (h4 ,(code (item-name i)) " "
                  (span ((class "kind")) ,(item-kind i)
                        ,@(if (equal? (item-as i) '"") nil (cons '", exported as " (cons (code (item-as i)) nil)))))
              ,@forms)))

;; signature gives the text of a form as a tree's children, with each type name linked to its definition.
(define (signature [t string] [dir string] [module string] [types datum] [own string]) -> datum
  (let ([i u32 0] [from u32 0] [out nil])
    (while (< i (-> t length))
      (let ([c (@ t i)] [start i])
        (cond [(== c #\")
               (+= i 1)
               (while (and (< i (-> t length)) (!= (@ t i) #\")) (+= i (if (== (@ t i) #\\) 2 1)))
               (when (< i (-> t length)) (+= i 1))]
              [(delimiter? c) (+= i 1)]
              [else
               (while (and (< i (-> t length)) (not (delimiter? (@ t i)))) (+= i 1))
               (let ([e (assoc (string->datum (slice t start i)) types)])
                 (unless (or (== e 0) (and (== (slice t start i) own) (== (datum->string (cdr e)) module)))
                   (set! out (cons (linked (string->datum (string-append 0 (if (== (datum->string (cdr e)) module) "" (link dir (string-append 0 (datum->string (cdr e)) ".html")))
                                                                           "#" (slice t start i)))
                                           (string->datum (slice t start i)))
                                   (cons (string->datum (slice t from start)) out)))
                   (set! from i)))])))
    (reverse (cons (string->datum (slice t from (-> t length))) out))))

(define (delimiter? [c u8]) -> bool
  (or (== c #\space) (== c #\newline) (== c #\tab) (== c #\() (== c #\)) (== c #\[) (== c #\]) (== c #\") (== c #\;) (== c #\') (== c #\`)
      (== c #\,)))

;; ---- paths ----

(define (directory-of [name string]) -> string
  (let ([i (-> name length)])
    (while (and (> i 0) (!= (@ name (- i 1)) #\/)) (-= i 1))
    (if (== i 0) "" (slice name 0 (- i 1)))))

;; link gives the path from directory dir to file to, both relative to the output directory.
(define (link [dir string] [to string]) -> string
  (let ([d dir] [t to] [out (make-buffer)])
    (while (and (> (-> d length) 0) (< (slash-in t) (-> t length)) (== (slice d 0 (slash-in d)) (slice t 0 (slash-in t))))
      (set! d (after-slash d))
      (set! t (after-slash t)))
    (when (> (-> d length) 0)
      (buffer-add-string! (& out) "../")
      (for ([i u32 0]) (< i (-> d length)) (+= i 1) (when (== (@ d i) #\/) (buffer-add-string! (& out) "../"))))
    (buffer-add-string! (& out) t)
    (buffer-string (& out))))

(define (slash-in [p string]) -> u32
  (let ([i u32 0])
    (while (and (< i (-> p length)) (!= (@ p i) #\/)) (+= i 1))
    i))

(define (after-slash [p string]) -> string (if (< (slash-in p) (-> p length)) (slice p (+ (slash-in p) 1)) ""))

(define page-style string
  ":root { color-scheme: light dark; --fg: #1f2328; --bg: #ffffff; --muted: #59636e; --line: #d1d9e0; --code: #f6f8fa; --link: #0969da; }
@media (prefers-color-scheme: dark) { :root { --fg: #e6edf3; --bg: #0d1117; --muted: #9198a1; --line: #3d444d; --code: #151b23; --link: #4493f8; } }
* { box-sizing: border-box; }
body { margin: 0; font: 15px/1.55 system-ui, -apple-system, sans-serif; color: var(--fg); background: var(--bg); }
a { color: var(--link); text-decoration: none; }
a:hover { text-decoration: underline; }
code, pre { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
.crumbs { padding: 10px 24px; border-bottom: 1px solid var(--line); font-family: ui-monospace, Menlo, monospace; font-size: 14px; }
.page { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 32px; max-width: 1180px; padding: 0 24px; }
aside.items { position: sticky; top: 0; align-self: start; max-height: 100vh; overflow: auto; padding: 16px 0 32px; font-size: 13px; }
aside h2 { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); margin: 14px 0 4px; }
aside h2.part { color: var(--fg); border-top: 1px solid var(--line); padding-top: 12px; }
aside ul { list-style: none; margin: 0; padding: 0; }
aside li { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: ui-monospace, Menlo, monospace; }
main { padding: 8px 0 64px; min-width: 0; }
main.index { max-width: 1000px; padding: 8px 24px 64px; }
h1 { font-family: ui-monospace, Menlo, monospace; font-size: 24px; margin: 16px 0 8px; }
h2.part { margin: 40px 0 0; padding-top: 16px; border-top: 2px solid var(--line); font-size: 18px; }
h3.section { margin: 32px 0 0; padding-bottom: 4px; border-bottom: 1px solid var(--line); font-size: 16px; }
h4 { margin: 22px 0 6px; font-size: 15px; }
.kind { color: var(--muted); font-weight: normal; font-size: 13px; margin-left: 6px; }
pre { background: var(--code); padding: 10px 12px; border-radius: 6px; overflow-x: auto; font-size: 13px; line-height: 1.45; margin: 6px 0; }
.meta { display: grid; grid-template-columns: max-content 1fr; gap: 2px 16px; font-size: 14px; }
.meta dt { color: var(--muted); }
.meta dd { margin: 0; }
table.entries { border-collapse: collapse; }
table.entries td { padding: 5px 20px 5px 0; vertical-align: top; }
table.entries td:first-child { white-space: nowrap; font-family: ui-monospace, Menlo, monospace; font-size: 14px; }
@media (max-width: 760px) { .page { grid-template-columns: 1fr; } aside.items { position: static; max-height: none; } }
")
