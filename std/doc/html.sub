;; Documentation as HTML pages, one per module and one per directory, at each one's name under the output directory: a
;; module's page has its items under the module's sections, public then private, with a sidebar of them by kind; a
;; directory's lists its modules and directories. Pages link to each other, and a type's name in a signature links to
;; where the type is defined.
(require-unqualified macros compiler/macros)
(require-unqualified doc "doc.sub")
(require-unqualified html std/web/html)
(require-unqualified paths std/package/path)

(provide module-page index-page top-page page-style)

;; module-page takes the names of the documented modules, and for each type a signature may name, the module defining
;; it.
(define (module-page [d datum] [names datum] [types datum]) -> datum
  (let* ([b (make-buffer)] [name (datum->string (doc-name d))] [dir (directory-of name)] [items (doc-items d)]
         [public (filter (lambda ([i datum]) -> bool (item-public? i)) items)]
         [private (filter (lambda ([i datum]) -> bool (not (item-public? i))) items)] [s datum 0])
    (opened! (& b) name dir name)
    (buffer-add-string! (& b) "<div class=\"page\">\n<aside class=\"items\">\n")
    (sidebar! (& b) public)
    (unless (null? private)
      (buffer-add-string! (& b) "<h2 class=\"part\">private</h2>\n")
      (sidebar! (& b) private))
    (buffer-add-string! (& b) "</aside>\n<main>\n<h1>")
    (html-escape! (& b) name #f)
    (buffer-add-string! (& b) "</h1>\n")
    (paragraphs! (& b) (doc-header d))
    (meta! (& b) d dir names)
    (part! (& b) public dir name types)
    (unless (null? private)
      (buffer-add-string! (& b) "<h2 class=\"part\">private</h2>\n")
      (part! (& b) private dir name types))
    (buffer-add-string! (& b) "</main>\n</div>\n")
    (closed! (& b))
    (set! s (string->datum (buffer-string (& b))))
    (buffer-free! (& b))
    s))

(define (index-page [index datum]) -> datum
  (let* ([b (make-buffer)] [name (datum->string (car index))] [s datum 0])
    (opened! (& b) name name name)
    (buffer-add-string! (& b) "<main class=\"index\">\n<h1>")
    (html-escape! (& b) name #f)
    (buffer-add-string! (& b) "</h1>\n")
    (paragraphs! (& b) (cadr index))
    (buffer-add-string! (& b) "<table class=\"entries\">\n")
    (for-each (lambda ([e datum])
                (let ([n (datum->string (car e))])
                  (buffer-add-string! (& b) "<tr><td><a href=\"")
                  (buffer-add-string! (& b) (link name (if (ends? n "/") (joined n "index.html") (joined n ".html"))))
                  (buffer-add-string! (& b) "\">")
                  (html-escape! (& b) n #f)
                  (buffer-add-string! (& b) "</a></td><td>")
                  (html-escape! (& b) (datum->string (cdr e)) #f)
                  (buffer-add-string! (& b) "</td></tr>\n")))
              (caddr index))
    (buffer-add-string! (& b) "</table>\n</main>\n")
    (closed! (& b))
    (set! s (string->datum (buffer-string (& b))))
    (buffer-free! (& b))
    s))

(define (top-page [labels datum]) -> datum
  (let ([b (make-buffer)] [s datum 0])
    (opened! (& b) "documentation" "" "")
    (buffer-add-string! (& b) "<main class=\"index\">\n<table class=\"entries\">\n")
    (for-each (lambda ([l datum])
                (buffer-add-string! (& b) "<tr><td><a href=\"")
                (buffer-add-string! (& b) (datum->string l))
                (buffer-add-string! (& b) "/index.html\">")
                (html-escape! (& b) (datum->string l) #f)
                (buffer-add-string! (& b) "</a></td></tr>\n"))
              labels)
    (buffer-add-string! (& b) "</table>\n</main>\n")
    (closed! (& b))
    (set! s (string->datum (buffer-string (& b))))
    (buffer-free! (& b))
    s))

;; ---- the page ----

(define (opened! [b (ptr buffer)] [title string] [dir string] [path string])
  (buffer-add-string! b "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n")
  (buffer-add-string! b "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>")
  (html-escape! b title #f)
  (buffer-add-string! b "</title>\n<link rel=\"stylesheet\" href=\"")
  (buffer-add-string! b (link dir "style.css"))
  (buffer-add-string! b "\">\n</head>\n<body>\n<nav class=\"crumbs\"><a href=\"")
  (buffer-add-string! b (link dir "index.html"))
  (buffer-add-string! b "\">documentation</a>")
  (let ([start u32 0])
    (for ([i u32 0]) (<= i (-> path length)) (+= i 1)
      (when (and (> (-> path length) 0) (or (== i (-> path length)) (== (@ path i) #\/)))
        (buffer-add-string! b " / ")
        (if (== i (-> path length))
            (html-escape! b (slice path start i) #f)
            (begin
              (buffer-add-string! b "<a href=\"")
              (buffer-add-string! b (link dir (joined-path (slice path 0 i) "index.html")))
              (buffer-add-string! b "\">")
              (html-escape! b (slice path start i) #f)
              (buffer-add-string! b "</a>")))
        (set! start (+ i 1)))))
  (buffer-add-string! b "</nav>\n"))

(define (closed! [b (ptr buffer)]) (buffer-add-string! b "</body>\n</html>\n"))

(define (paragraphs! [b (ptr buffer)] [text datum])
  (let ([t (datum->string text)] [start u32 0])
    (for ([i u32 0]) (<= i (-> t length)) (+= i 1)
      (when (or (== i (-> t length)) (and (== (@ t i) 10) (< (+ i 1) (-> t length)) (== (@ t (+ i 1)) 10)))
        (when (> i start)
          (buffer-add-string! b "<p>")
          (for ([k u32 start]) (< k i) (+= k 1)
            (if (== (@ t k) 10) (buffer-add-byte! b 32) (html-escape! b (slice t k (+ k 1)) #f)))
          (buffer-add-string! b "</p>\n"))
        (set! start (+ i 2))))))

(define (meta! [b (ptr buffer)] [d datum] [dir string] [names datum])
  (unless (and (equal? (doc-language d) '"") (null? (doc-requires d)) (null? (doc-reexports d)))
    (buffer-add-string! b "<dl class=\"meta\">\n")
    (unless (equal? (doc-language d) '"")
      (buffer-add-string! b "<dt>language</dt><dd>")
      (named! b (doc-language d) dir names)
      (buffer-add-string! b "</dd>\n"))
    (unless (null? (doc-requires d))
      (buffer-add-string! b "<dt>requires</dt><dd>")
      (for-each (lambda ([r datum]) (named! b r dir names) (buffer-add-byte! b 32)) (doc-requires d))
      (buffer-add-string! b "</dd>\n"))
    (unless (null? (doc-reexports d))
      (buffer-add-string! b "<dt>re-exports</dt><dd>")
      (for-each (lambda ([r datum])
                  (buffer-add-string! b "<code>")
                  (html-escape! b (datum->string r) #f)
                  (buffer-add-string! b "</code> "))
                (doc-reexports d))
      (buffer-add-string! b "</dd>\n"))
    (buffer-add-string! b "</dl>\n")))

(define (named! [b (ptr buffer)] [name datum] [dir string] [names datum])
  (let ([page (page-of name names)])
    (if (== page 0)
        (begin
          (buffer-add-string! b "<code>")
          (html-escape! b (datum->string name) #f)
          (buffer-add-string! b "</code>"))
        (begin
          (buffer-add-string! b "<a href=\"")
          (buffer-add-string! b (link dir (joined (datum->string page) ".html")))
          (buffer-add-string! b "\"><code>")
          (html-escape! b (datum->string name) #f)
          (buffer-add-string! b "</code></a>")))))

;; page-of gives the documented module a name stands for, as a name for a directory stands for its main module.
(define (page-of [name datum] [names datum]) -> datum
  (let ([alias (string->datum (joined-path (datum->string name) (base-of (datum->string name))))])
    (cond [(!= (member name names) 0) name]
          [(!= (member alias names) 0) alias]
          [else 0])))

;; ---- items ----

(define (sidebar! [b (ptr buffer)] [items datum])
  (let ([kinds nil])
    (for-each (lambda ([i datum]) (when (== (member (item-kind i) kinds) 0) (set! kinds (cons (item-kind i) kinds)))) items)
    (set! kinds (reverse kinds))
    (while (pair? kinds)
      (buffer-add-string! b "<h2>")
      (html-escape! b (datum->string (car kinds)) #f)
      (buffer-add-string! b "</h2>\n<ul>\n")
      (let ([is items])
        (while (pair? is)
          (when (equal? (item-kind (car is)) (car kinds))
            (buffer-add-string! b "<li><a href=\"#")
            (html-escape! b (datum->string (item-name (car is))) #t)
            (buffer-add-string! b "\">")
            (html-escape! b (datum->string (item-name (car is))) #f)
            (buffer-add-string! b "</a></li>\n"))
          (set! is (cdr is))))
      (buffer-add-string! b "</ul>\n")
      (set! kinds (cdr kinds)))))

(define (part! [b (ptr buffer)] [items datum] [dir string] [module string] [types datum])
  (let ([section '""])
    (for-each (lambda ([i datum])
                (unless (or (equal? (item-section i) section) (equal? (item-section i) '""))
                  (buffer-add-string! b "<h3 class=\"section\">")
                  (html-escape! b (datum->string (item-section i)) #f)
                  (buffer-add-string! b "</h3>\n"))
                (set! section (item-section i))
                (item! b i dir module types))
              items)))

(define (item! [b (ptr buffer)] [i datum] [dir string] [module string] [types datum])
  (buffer-add-string! b "<section class=\"item\" id=\"")
  (html-escape! b (datum->string (item-name i)) #t)
  (buffer-add-string! b "\">\n<h4><code>")
  (html-escape! b (datum->string (item-name i)) #f)
  (buffer-add-string! b "</code> <span class=\"kind\">")
  (html-escape! b (datum->string (item-kind i)) #f)
  (unless (equal? (item-as i) '"")
    (buffer-add-string! b ", exported as <code>")
    (html-escape! b (datum->string (item-as i)) #f)
    (buffer-add-string! b "</code>"))
  (buffer-add-string! b "</span></h4>\n")
  (for-each (lambda ([f datum])
              (buffer-add-string! b "<pre><code>")
              (signature! b (datum->string (form-text f)) dir module types (datum->string (item-name i)))
              (buffer-add-string! b "</code></pre>\n")
              (paragraphs! b (form-comment f)))
            (item-forms i))
  (buffer-add-string! b "</section>\n"))

(define (signature! [b (ptr buffer)] [t string] [dir string] [module string] [types datum] [own string])
  (let ([i u32 0])
    (while (< i (-> t length))
      (let ([c (@ t i)] [start i])
        (cond [(== c 34)
               (+= i 1)
               (while (and (< i (-> t length)) (!= (@ t i) 34)) (+= i (if (== (@ t i) #\\) 2 1)))
               (when (< i (-> t length)) (+= i 1))
               (html-escape! b (slice t start i) #f)]
              [(delimiter? c)
               (html-escape! b (slice t i (+ i 1)) #f)
               (+= i 1)]
              [else
               (while (and (< i (-> t length)) (not (delimiter? (@ t i)))) (+= i 1))
               (let ([e (assoc (string->datum (slice t start i)) types)])
                 (if (or (== e 0) (and (== (slice t start i) own) (== (datum->string (cdr e)) module)))
                     (html-escape! b (slice t start i) #f)
                     (begin
                       (buffer-add-string! b "<a href=\"")
                       (unless (== (datum->string (cdr e)) module)
                         (buffer-add-string! b (link dir (joined (datum->string (cdr e)) ".html"))))
                       (buffer-add-byte! b #\#)
                       (html-escape! b (slice t start i) #t)
                       (buffer-add-string! b "\">")
                       (html-escape! b (slice t start i) #f)
                       (buffer-add-string! b "</a>"))))])))))

(define (delimiter? [c u8]) -> bool
  (or (== c 32) (== c 10) (== c 9) (== c #\() (== c #\)) (== c #\[) (== c #\]) (== c 34) (== c #\;) (== c 39) (== c 96)
      (== c #\,)))

;; ---- paths ----

(define (directory-of [name string]) -> string
  (let ([i (-> name length)])
    (while (and (> i 0) (!= (@ name (- i 1)) #\/)) (-= i 1))
    (if (== i 0) "" (slice name 0 (- i 1)))))

;; link gives the path from the directory dir to the file to, both under the output directory, which "" is.
(define (link [dir string] [to string]) -> string
  (let ([d dir] [t to] [out (make-buffer)])
    (while (and (> (-> d length) 0) (< (slash-in t) (-> t length)) (== (slice d 0 (slash-in d)) (slice t 0 (slash-in t))))
      (set! d (after-slash d))
      (set! t (after-slash t)))
    (when (> (-> d length) 0)
      (buffer-add-string! (& out) "../")
      (for ([i u32 0]) (< i (-> d length)) (+= i 1) (when (== (@ d i) #\/) (buffer-add-string! (& out) "../"))))
    (buffer-add-string! (& out) t)
    (buffer-string (& out))))

(define (slash-in [p string]) -> u32
  (let ([i u32 0])
    (while (and (< i (-> p length)) (!= (@ p i) #\/)) (+= i 1))
    i))

(define (after-slash [p string]) -> string (if (< (slash-in p) (-> p length)) (slice p (+ (slash-in p) 1)) ""))

(define (joined [x string] [y string]) -> string
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) x)
    (buffer-add-string! (& b) y)
    (buffer-string (& b))))

(define page-style string
  ":root { color-scheme: light dark; --fg: #1f2328; --bg: #ffffff; --muted: #59636e; --line: #d1d9e0; --code: #f6f8fa; --link: #0969da; }
@media (prefers-color-scheme: dark) { :root { --fg: #e6edf3; --bg: #0d1117; --muted: #9198a1; --line: #3d444d; --code: #151b23; --link: #4493f8; } }
* { box-sizing: border-box; }
body { margin: 0; font: 15px/1.55 system-ui, -apple-system, sans-serif; color: var(--fg); background: var(--bg); }
a { color: var(--link); text-decoration: none; }
a:hover { text-decoration: underline; }
code, pre { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
.crumbs { padding: 10px 24px; border-bottom: 1px solid var(--line); font-family: ui-monospace, Menlo, monospace; font-size: 14px; }
.page { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 32px; max-width: 1180px; padding: 0 24px; }
aside.items { position: sticky; top: 0; align-self: start; max-height: 100vh; overflow: auto; padding: 16px 0 32px; font-size: 13px; }
aside h2 { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); margin: 14px 0 4px; }
aside h2.part { color: var(--fg); border-top: 1px solid var(--line); padding-top: 12px; }
aside ul { list-style: none; margin: 0; padding: 0; }
aside li { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: ui-monospace, Menlo, monospace; }
main { padding: 8px 0 64px; min-width: 0; }
main.index { max-width: 1000px; padding: 8px 24px 64px; }
h1 { font-family: ui-monospace, Menlo, monospace; font-size: 24px; margin: 16px 0 8px; }
h2.part { margin: 40px 0 0; padding-top: 16px; border-top: 2px solid var(--line); font-size: 18px; }
h3.section { margin: 32px 0 0; padding-bottom: 4px; border-bottom: 1px solid var(--line); font-size: 16px; }
h4 { margin: 22px 0 6px; font-size: 15px; }
.kind { color: var(--muted); font-weight: normal; font-size: 13px; margin-left: 6px; }
pre { background: var(--code); padding: 10px 12px; border-radius: 6px; overflow-x: auto; font-size: 13px; line-height: 1.45; margin: 6px 0; }
.meta { display: grid; grid-template-columns: max-content 1fr; gap: 2px 16px; font-size: 14px; }
.meta dt { color: var(--muted); }
.meta dd { margin: 0; }
table.entries { border-collapse: collapse; }
table.entries td { padding: 5px 20px 5px 0; vertical-align: top; }
table.entries td:first-child { white-space: nowrap; font-family: ui-monospace, Menlo, monospace; font-size: 14px; }
@media (max-width: 760px) { .page { grid-template-columns: 1fr; } aside.items { position: static; max-height: none; } }
")
