;; Documentation as text. A module reads like a header file: its name, header comment, owner, language, requires and
;; re-exports, then its public items and its private items under its section labels. A directory lists its modules,
;; private ones last.
(require-unqualified macros compiler/macros)
(require-unqualified doc "doc.sub")

(provide module-text item-text index-text text-files)

(define (module-text [d datum] [owner datum]) -> datum
  (let ([b (make-buffer)] [items (doc-items d)] [s datum 0])
    (commented! (& b) (doc-name d))
    (unless (equal? (doc-header d) '"") (commented! (& b) (doc-header d)))
    (unless (equal? owner '"") (listed! (& b) "private to " (cons owner nil)))
    (unless (equal? (doc-language d) '"") (listed! (& b) "language " (cons (doc-language d) nil)))
    (unless (null? (doc-requires d)) (listed! (& b) "requires " (doc-requires d)))
    (unless (null? (doc-reexports d)) (listed! (& b) "re-exports " (doc-reexports d)))
    (part! (& b) (filter (lambda ([i datum]) -> bool (item-public? i)) items))
    (let ([private (filter (lambda ([i datum]) -> bool (not (item-public? i))) items)])
      (unless (null? private)
        (buffer-add-string! (& b) "\n;; ==== private ====\n")
        (part! (& b) private)))
    (set! s (string->datum (buffer-string (& b))))
    (buffer-free! (& b))
    s))

(define (item-text [i datum]) -> datum
  (let ([b (make-buffer)] [s datum 0])
    (item! (& b) i)
    (set! s (string->datum (buffer-string (& b))))
    (buffer-free! (& b))
    s))

(define (part! [b (ptr buffer)] [items datum])
  (let ([section '""])
    (for-each (lambda ([i datum])
                (unless (or (equal? (item-section i) section) (equal? (item-section i) '""))
                  (buffer-add-string! b "\n;; ---- ")
                  (buffer-add-string! b (datum->string (item-section i)))
                  (buffer-add-string! b " ----\n"))
                (set! section (item-section i))
                (buffer-add-byte! b 10)
                (item! b i))
              items)))

(define (item! [b (ptr buffer)] [i datum])
  (unless (equal? (item-as i) '"")
    (buffer-add-string! b ";; exported as ")
    (buffer-add-string! b (datum->string (item-as i)))
    (buffer-add-byte! b 10))
  (for-each (lambda ([f datum])
              (unless (equal? (form-comment f) '"") (commented! b (form-comment f)))
              (buffer-add-string! b (datum->string (form-text f)))
              (buffer-add-byte! b 10))
            (item-forms i)))

(define (commented! [b (ptr buffer)] [text datum])
  (let ([t (datum->string text)] [start u32 0])
    (for ([i u32 0]) (<= i (-> t length)) (+= i 1)
      (when (or (== i (-> t length)) (== (@ t i) 10))
        (buffer-add-string! b (if (== i start) ";;" ";; "))
        (buffer-add-string! b (slice t start i))
        (buffer-add-byte! b 10)
        (set! start (+ i 1))))))

(define (listed! [b (ptr buffer)] [what string] [l datum])
  (buffer-add-string! b ";; ")
  (buffer-add-string! b what)
  (while (pair? l)
    (buffer-add-string! b (datum->string (car l)))
    (when (pair? (cdr l)) (buffer-add-byte! b 32))
    (set! l (cdr l)))
  (buffer-add-byte! b 10))

(define (index-text [name datum] [header datum] [entries datum] [private datum]) -> datum
  (let ([b (make-buffer)] [width u32 0] [s datum 0])
    (commented! (& b) name)
    (unless (equal? header '"") (commented! (& b) header))
    (buffer-add-byte! (& b) 10)
    (for-each (lambda ([e datum]) (when (> (-> (datum->string (car e)) length) width) (set! width (-> (datum->string (car e)) length))))
              (append entries private))
    (entries! (& b) entries width)
    (unless (null? private)
      (buffer-add-string! (& b) "\n;; ==== private ====\n\n")
      (entries! (& b) private width))
    (set! s (string->datum (buffer-string (& b))))
    (buffer-free! (& b))
    s))

(define (entries! [b (ptr buffer)] [entries datum] [width u32])
  (for-each (lambda ([e datum])
              (let ([n (datum->string (car e))])
                (buffer-add-string! b n)
                (unless (equal? (cdr e) '"")
                  (for ([i u32 (-> n length)]) (< i (+ width 2)) (+= i 1) (buffer-add-byte! b 32))
                  (buffer-add-string! b (datum->string (cdr e))))
                (buffer-add-byte! b 10)))
            entries))

;; text-files gives the files to write, each a path and its text: index.txt, and one for each module and directory.
(define (text-files [roots datum]) -> datum
  (let ([out nil] [rs roots] [es datum 0] [is datum 0])
    (set! out (cons (cons '"index.txt"
                          (index-text '"documentation" '"" (map (lambda ([r datum]) -> datum (cons (format "~a/" `(,(car r))) '"")) roots)
                                      nil))
                    nil))
    (while (pair? rs)
      (set! es (cadr (car rs)))
      (while (pair? es)
        (set! out (cons (cons (format "~a.txt" `(,(doc-name (cadr (car es))))) (module-text (cadr (car es)) (caddr (car es)))) out))
        (set! es (cdr es)))
      (set! is (caddr (car rs)))
      (while (pair? is)
        (set! out (cons (cons (format "~a/index.txt" `(,(car (car is)))) (index-text (car (car is)) (cadr (car is)) (caddr (car is)) (cadddr (car is))))
                        out))
        (set! is (cdr is)))
      (set! rs (cdr rs)))
    (reverse out)))
