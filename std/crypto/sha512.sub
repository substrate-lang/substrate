               #x431d67c49c100d4c #x4cc5d4becb3e42b6 #x597f299cfc657e2a #x5fcb6fab3ad6faec #x6c44198c4a475817))

(define (rotr [x u64] [n u64]) #:inline -> u64 (bit-or (>> x n) (<< x (- 64 n))))

(define (word [p (ptr u8)]) #:inline -> u64
  (let ([w u64 0])
    (for ([i u32 0]) (< i 8) (+= i 1) (set! w (bit-or (<< w 8) (cast u64 (@ p i)))))
    w))

(define (compress! [s (ptr sha512)] [p (ptr u8)])
  (let ([w (array u64 80)]
        [a (@ (-> s state) 0)] [b (@ (-> s state) 1)] [c (@ (-> s state) 2)] [d (@ (-> s state) 3)]
        [e (@ (-> s state) 4)] [f (@ (-> s state) 5)] [g (@ (-> s state) 6)] [hh (@ (-> s state) 7)])
    (for ([i u32 0]) (< i 16) (+= i 1) (set! (@ w i) (word (+ p (* i 8)))))
    (for ([i u32 16]) (< i 80) (+= i 1)
      (let ([x (@ w (- i 15))] [y (@ w (- i 2))])
        (set! (@ w i) (+ (@ w (- i 16)) (bit-xor (rotr x 1) (rotr x 8) (>> x 7)) (@ w (- i 7))
                         (bit-xor (rotr y 19) (rotr y 61) (>> y 6))))))
    (for ([i u32 0]) (< i 80) (+= i 1)
      (let* ([t1 (+ hh (bit-xor (rotr e 14) (rotr e 18) (rotr e 41)) (bit-xor (bit-and e f) (bit-and (bit-not e) g))
                    (@ k i) (@ w i))]
             [t2 (+ (bit-xor (rotr a 28) (rotr a 34) (rotr a 39)) (bit-xor (bit-and a b) (bit-and a c) (bit-and b c)))])
        (set! hh g)
        (set! g f)
        (set! f e)
        (set! e (+ d t1))
        (set! d c)
        (set! c b)
        (set! b a)
        (set! a (+ t1 t2))))
    (+= (@ (-> s state) 0) a)
    (+= (@ (-> s state) 1) b)
    (+= (@ (-> s state) 2) c)
    (+= (@ (-> s state) 3) d)
    (+= (@ (-> s state) 4) e)
    (+= (@ (-> s state) 5) f)
    (+= (@ (-> s state) 6) g)
    (+= (@ (-> s state) 7) hh)))

(define (sha512-init! [s (ptr sha512)])
  (set! (@ (-> s state) 0) #x6a09e667f3bcc908)
  (set! (@ (-> s state) 1) #xbb67ae8584caa73b)
  (set! (@ (-> s state) 2) #x3c6ef372fe94f82b)
  (set! (@ (-> s state) 3) #xa54ff53a5f1d36f1)
  (set! (@ (-> s state) 4) #x510e527fade682d1)
  (set! (@ (-> s state) 5) #x9b05688c2b3e6c1f)
  (set! (@ (-> s state) 6) #x1f83d9abfb41bd6b)
  (set! (@ (-> s state) 7) #x5be0cd19137e2179)
  (set! (-> s filled) 0)
  (set! (-> s length) 0))

(define (sha512-add! [s (ptr sha512)] [b (slice u8)])
  (let ([p (-> b items)] [n (-> b length)] [i u32 0])
    (+= (-> s length) (cast u64 n))
    (when (> (-> s filled) 0)
      (while (and (< i n) (< (-> s filled) 128))
        (set! (@ (-> s block) (-> s filled)) (@ p i))
        (+= (-> s filled) 1)
        (+= i 1))
      (when (== (-> s filled) 128)
        (compress! s (-> s block))
        (set! (-> s filled) 0)))
    (while (<= (+ i 128) n)
      (compress! s (+ p i))
      (+= i 128))
    (while (< i n)
      (set! (@ (-> s block) (-> s filled)) (@ p i))
      (+= (-> s filled) 1)
      (+= i 1))))

;; into takes the 64 bytes of the digest.
(define (sha512-end! [s (ptr sha512)] [into (slice u8)])
  (let ([bits (* (-> s length) 8)])
    (set! (@ (-> s block) (-> s filled)) 128)
    (+= (-> s filled) 1)
    (when (> (-> s filled) 112)
      (while (< (-> s filled) 128)
        (set! (@ (-> s block) (-> s filled)) 0)
        (+= (-> s filled) 1))
      (compress! s (-> s block))
      (set! (-> s filled) 0))
    (while (< (-> s filled) 120)
      (set! (@ (-> s block) (-> s filled)) 0)
      (+= (-> s filled) 1))
    (for ([i u32 0]) (< i 8) (+= i 1)
      (set! (@ (-> s block) (+ 120 i)) (cast u8 (>> bits (cast u64 (* 8 (- 7 i)))))))
    (compress! s (-> s block))
    (for ([i u32 0]) (< i 8) (+= i 1)
      (let ([h (@ (-> s state) i)])
        (for ([j u32 0]) (< j 8) (+= j 1)
          (set! (@ into (+ (* i 8) j)) (cast u8 (>> h (cast u64 (* 8 (- 7 j)))))))))))

(define (sha512-of [b (slice u8)] [into (slice u8)])
  (let ([s sha512])
    (sha512-init! (& s))
    (sha512-add! (& s) b)
    (sha512-end! (& s) into)))
