;; Passwords stored as PHC strings of PBKDF2-SHA256, $pbkdf2-sha256$i=ITERATIONS$SALT$HASH in Base64 without padding,
;; worked out in a worker. password-hash! gives done a new password's string in result, after the job's iterations,
;; 600000 when 0. password-verify! tells done in ok whether a password matches a stored string; one that cannot be read
;; takes as long and does not match. Jobs run in order; if the worker ends, each waiting job ends without a result.
(require-unqualified host/events)
(require-unqualified host/modules/random)
(require-unqualified host/worker)
(require-unqualified "hmac.sub")
(require-unqualified std/encoding/base64)

(provide password-job password-hash! password-verify! password-job-free!)

(const default-iterations u32 600000)
(const most-iterations u64 100000000)

(struct password-job [user (ptr void)] [iterations u32] [result buffer] [ok bool] [verify bool] [readable bool]
  [password buffer] [salt (array u8 16)] [expected buffer] [next (ptr password-job)] [done (fn ((ptr password-job)))])

(define first (ptr password-job) 0)
(define last (ptr password-job) 0)
(define running u32 0)
(define listener event-head)

;; ---- the worker's side ----

;; A request is the iterations in 4 bytes, little-endian, the salt's length in a byte, the salt and the password; the
;; answer is the 32-byte key.
(define (requested [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (== kind worker-message)
    (let* ([m (events-take)] [p (-> m items)] [key (array u8 32)]
           [iterations (bit-or (cast u32 (@ p 0)) (<< (cast u32 (@ p 1)) 8) (<< (cast u32 (@ p 2)) 16)
                               (<< (cast u32 (@ p 3)) 24))]
           [n (cast u32 (@ p 4))])
      (pbkdf2! (slice (+ p (+ 5 n)) (- (-> m length) (+ 5 n))) (slice (+ p 5) n) iterations (slice key))
      (memset p 0 (-> m length))
      (free p)
      (worker-send 0 (slice key)))))

(define (password-worker) (event-handler! worker-source requested))

;; ---- the program's side ----

(define (wipe! [b (ptr buffer)])
  (memset (-> b bytes) 0 (-> b length))
  (buffer-free! b))

(define (send-first!)
  (let ([j first] [b (make-buffer)] [n (-> first iterations)])
    (for ([i u32 0]) (< i 4) (+= i 1) (buffer-add-byte! (& b) (cast u8 (>> n (* 8 i)))))
    (buffer-add-byte! (& b) 16)
    (buffer-add! (& b) (slice (-> j salt)))
    (buffer-add! (& b) (buffer-bytes (& (-> j password))))
    (worker-send running (buffer-bytes (& b)))
    (wipe! (& b))))

(define (start! [j (ptr password-job)] [done (fn ((ptr password-job)))])
  (set! (-> j done) done)
  (set! (-> j next) 0)
  (set! (-> j result) (make-buffer))
  (set! (-> j ok) #f)
  (if (== last 0) (set! first j) (set! (-> last next) j))
  (set! last j)
  (when (== first j)
    (when (== running 0)
      (let ([why error] [id u32 0])
        (set! (-> listener handle) answered)
        (unless (worker-start password-worker 0 0 (& listener) (& id) (& why)) (host-trap (error-text (& why))))
        (set! running id)))
    (send-first!)))

(define (unpadded! [b (ptr buffer)] [bytes (slice u8)])
  (base64-encode! b bytes)
  (while (== (@ (-> b bytes) (- (-> b length) 1)) 61) (-= (-> b length) 1)))

(define (finish! [key (slice u8)])
  (let ([j first])
    (set! first (-> j next))
    (when (== first 0)
      (set! last 0)
      (worker-stop running)
      (set! running 0))
    (wipe! (& (-> j password)))
    (if (-> j verify)
        (set! (-> j ok) (and (-> j readable) (hmac-equal? key (buffer-bytes (& (-> j expected))))))
        (let ([b (& (-> j result))])
          (buffer-add-string! b "$pbkdf2-sha256$i=")
          (write-digits b (-> j iterations) 10)
          (buffer-add-byte! b 36)
          (unpadded! b (slice (-> j salt)))
          (buffer-add-byte! b 36)
          (unpadded! b key)))
    (unless (== first 0) (send-first!))
    ((-> j done) j)))

(define (failed!)
  (set! running 0)
  (while (!= first 0)
    (let ([j first])
      (set! first (-> j next))
      (when (== first 0) (set! last 0))
      (wipe! (& (-> j password)))
      ((-> j done) j))))

(define (answered [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (and (== id running) (!= first 0))
    (let ([m (events-take)])
      (cond [(== kind worker-message) (finish! m)]
            [(or (== kind worker-ended) (and (== kind worker-done) (> (-> m length) 0))) (failed!)])
      (free (-> m items)))))

(define (password-hash! [j (ptr password-job)] [password string] [done (fn ((ptr password-job)))])
  (when (> (cast u64 (-> j iterations)) most-iterations) (host-trap "password: more than 100000000 iterations"))
  (when (== (-> j iterations) 0) (set! (-> j iterations) default-iterations))
  (set! (-> j verify) #f)
  (set! (-> j expected) (make-buffer))
  (set! (-> j password) (make-buffer))
  (buffer-add-string! (& (-> j password)) password)
  (random-fill (slice (-> j salt)))
  (start! j done))

;; read! takes the iterations, salt and hash from a stored string, or returns #f.
(define (read! [j (ptr password-job)] [stored string]) -> bool
  (let ([parts (array string 5)] [n u32 0] [start u32 0] [count u64 0] [salt (make-buffer)] [ok #f])
    (for ([i u32 0]) (<= i (-> stored length)) (+= i 1)
      (when (or (== i (-> stored length)) (== (@ stored i) 36))
        (when (== n 5) (return #f))
        (set! (@ parts n) (slice stored start i))
        (+= n 1)
        (set! start (+ i 1))))
    (set! ok (and (== n 5) (== (@ parts 0) "") (== (@ parts 1) "pbkdf2-sha256") (>= (-> (@ parts 2) length) 3)
                  (== (slice (@ parts 2) 0 2) "i=") (digits? (slice (@ parts 2) 2) 10)
                  (digits-integer (slice (@ parts 2) 2) 10 #f (& count)) (>= count 1) (<= count most-iterations)
                  (padded-decode! (& salt) (@ parts 3)) (== (-> salt length) 16)
                  (padded-decode! (& (-> j expected)) (@ parts 4)) (== (-> j expected length) 32)))
    (when ok
      (set! (-> j iterations) (cast u32 count))
      (memcpy (-> j salt) (-> salt bytes) 16))
    (buffer-free! (& salt))
    ok))

(define (padded-decode! [b (ptr buffer)] [text string]) -> bool
  (let ([t (make-buffer)] [ok #f])
    (buffer-add-string! (& t) text)
    (while (!= (% (-> t length) 4) 0) (buffer-add-byte! (& t) 61))
    (set! ok (base64-decode! b (buffer-string (& t))))
    (buffer-free! (& t))
    ok))

(define (password-verify! [j (ptr password-job)] [password string] [stored string] [done (fn ((ptr password-job)))])
  (set! (-> j verify) #t)
  (set! (-> j expected) (make-buffer))
  (set! (-> j readable) (read! j stored))
  (unless (-> j readable)
    (set! (-> j iterations) default-iterations)
    (memset (-> j salt) 0 16))
  (set! (-> j password) (make-buffer))
  (buffer-add-string! (& (-> j password)) password)
  (start! j done))

(define (password-job-free! [j (ptr password-job)])
  (buffer-free! (& (-> j result)))
  (buffer-free! (& (-> j expected))))
