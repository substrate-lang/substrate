;; SHA-256 (FIPS 180-4), over bytes added in pieces or given at once.
(provide sha256 sha256-init! sha256-add! sha256-end! sha256-of)

(struct sha256 [state (array u32 8)] [block (array u8 64)] [filled u32] [length u64])

(define k (array u32 64)
  (array-of u32 #x428a2f98 #x71374491 #xb5c0fbcf #xe9b5dba5 #x3956c25b #x59f111f1 #x923f82a4 #xab1c5ed5
               #xd807aa98 #x12835b01 #x243185be #x550c7dc3 #x72be5d74 #x80deb1fe #x9bdc06a7 #xc19bf174
               #xe49b69c1 #xefbe4786 #x0fc19dc6 #x240ca1cc #x2de92c6f #x4a7484aa #x5cb0a9dc #x76f988da
               #x983e5152 #xa831c66d #xb00327c8 #xbf597fc7 #xc6e00bf3 #xd5a79147 #x06ca6351 #x14292967
               #x27b70a85 #x2e1b2138 #x4d2c6dfc #x53380d13 #x650a7354 #x766a0abb #x81c2c92e #x92722c85
               #xa2bfe8a1 #xa81a664b #xc24b8b70 #xc76c51a3 #xd192e819 #xd6990624 #xf40e3585 #x106aa070
               #x19a4c116 #x1e376c08 #x2748774c #x34b0bcb5 #x391c0cb3 #x4ed8aa4a #x5b9cca4f #x682e6ff3
               #x748f82ee #x78a5636f #x84c87814 #x8cc70208 #x90befffa #xa4506ceb #xbef9a3f7 #xc67178f2))

(define (rotr [x u32] [n u32]) #:inline -> u32 (bit-or (>> x n) (<< x (- 32 n))))

(define (word [p (ptr u8)]) #:inline -> u32
  (bit-or (<< (cast u32 (@ p 0)) 24) (<< (cast u32 (@ p 1)) 16) (<< (cast u32 (@ p 2)) 8) (cast u32 (@ p 3))))

(define (compress! [s (ptr sha256)] [p (ptr u8)])
  (let ([w (array u32 64)]
        [a (@ (-> s state) 0)] [b (@ (-> s state) 1)] [c (@ (-> s state) 2)] [d (@ (-> s state) 3)]
        [e (@ (-> s state) 4)] [f (@ (-> s state) 5)] [g (@ (-> s state) 6)] [hh (@ (-> s state) 7)])
    (for ([i u32 0]) (< i 16) (+= i 1) (set! (@ w i) (word (+ p (* i 4)))))
    (for ([i u32 16]) (< i 64) (+= i 1)
      (let ([x (@ w (- i 15))] [y (@ w (- i 2))])
        (set! (@ w i) (+ (@ w (- i 16)) (bit-xor (rotr x 7) (rotr x 18) (>> x 3)) (@ w (- i 7))
                         (bit-xor (rotr y 17) (rotr y 19) (>> y 10))))))
    (for ([i u32 0]) (< i 64) (+= i 1)
      (let* ([t1 (+ hh (bit-xor (rotr e 6) (rotr e 11) (rotr e 25)) (bit-xor (bit-and e f) (bit-and (bit-not e) g))
                    (@ k i) (@ w i))]
             [t2 (+ (bit-xor (rotr a 2) (rotr a 13) (rotr a 22)) (bit-xor (bit-and a b) (bit-and a c) (bit-and b c)))])
        (set! hh g)
        (set! g f)
        (set! f e)
        (set! e (+ d t1))
        (set! d c)
        (set! c b)
        (set! b a)
        (set! a (+ t1 t2))))
    (+= (@ (-> s state) 0) a)
    (+= (@ (-> s state) 1) b)
    (+= (@ (-> s state) 2) c)
    (+= (@ (-> s state) 3) d)
    (+= (@ (-> s state) 4) e)
    (+= (@ (-> s state) 5) f)
    (+= (@ (-> s state) 6) g)
    (+= (@ (-> s state) 7) hh)))

(define (sha256-init! [s (ptr sha256)])
  (set! (@ (-> s state) 0) #x6a09e667)
  (set! (@ (-> s state) 1) #xbb67ae85)
  (set! (@ (-> s state) 2) #x3c6ef372)
  (set! (@ (-> s state) 3) #xa54ff53a)
  (set! (@ (-> s state) 4) #x510e527f)
  (set! (@ (-> s state) 5) #x9b05688c)
  (set! (@ (-> s state) 6) #x1f83d9ab)
  (set! (@ (-> s state) 7) #x5be0cd19)
  (set! (-> s filled) 0)
  (set! (-> s length) 0))

(define (sha256-add! [s (ptr sha256)] [b (slice u8)])
  (let ([p (-> b items)] [n (-> b length)] [i u32 0])
    (+= (-> s length) (cast u64 n))
    (when (> (-> s filled) 0)
      (while (and (< i n) (< (-> s filled) 64))
        (set! (@ (-> s block) (-> s filled)) (@ p i))
        (+= (-> s filled) 1)
        (+= i 1))
      (when (== (-> s filled) 64)
        (compress! s (-> s block))
        (set! (-> s filled) 0)))
    (while (<= (+ i 64) n)
      (compress! s (+ p i))
      (+= i 64))
    (while (< i n)
      (set! (@ (-> s block) (-> s filled)) (@ p i))
      (+= (-> s filled) 1)
      (+= i 1))))

;; into takes the 32 bytes of the digest.
(define (sha256-end! [s (ptr sha256)] [into (slice u8)])
  (let ([bits (* (-> s length) 8)])
    (set! (@ (-> s block) (-> s filled)) 128)
    (+= (-> s filled) 1)
    (when (> (-> s filled) 56)
      (while (< (-> s filled) 64)
        (set! (@ (-> s block) (-> s filled)) 0)
        (+= (-> s filled) 1))
      (compress! s (-> s block))
      (set! (-> s filled) 0))
    (while (< (-> s filled) 56)
      (set! (@ (-> s block) (-> s filled)) 0)
      (+= (-> s filled) 1))
    (for ([i u32 0]) (< i 8) (+= i 1)
      (set! (@ (-> s block) (+ 56 i)) (cast u8 (>> bits (* 8 (- 7 i))))))
    (compress! s (-> s block))
    (for ([i u32 0]) (< i 8) (+= i 1)
      (let ([h (@ (-> s state) i)])
        (set! (@ into (* i 4)) (cast u8 (>> h 24)))
        (set! (@ into (+ (* i 4) 1)) (cast u8 (>> h 16)))
        (set! (@ into (+ (* i 4) 2)) (cast u8 (>> h 8)))
        (set! (@ into (+ (* i 4) 3)) (cast u8 h))))))

(define (sha256-of [b (slice u8)] [into (slice u8)])
  (let ([s sha256])
    (sha256-init! (& s))
    (sha256-add! (& s) b)
    (sha256-end! (& s) into)))
