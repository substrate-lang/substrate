;; HMAC (RFC 2104) with SHA-256, and what is built on it: HKDF (RFC 5869), which derives keys from a secret, and
;; PBKDF2 (RFC 8018), which derives them from a password.
(require-unqualified sha256 "sha256.sub")

(provide hmac hmac-init! hmac-add! hmac-end! hmac-of hmac-equal? hkdf! pbkdf2!)

(struct hmac [inner sha256] [outer sha256])

(define (hmac-init! [m (ptr hmac)] [key (slice u8)])
  (let ([pad (array u8 64)] [digest (array u8 32)] [k key])
    (when (> (-> key length) 64)
      (sha256-of key (slice digest))
      (set! k (slice digest)))
    (memset pad 0 64)
    (memcpy pad (-> k items) (-> k length))
    (for ([i u32 0]) (< i 64) (+= i 1) (set! (@ pad i) (bit-xor (@ pad i) #x36)))
    (sha256-init! (& (-> m inner)))
    (sha256-add! (& (-> m inner)) (slice pad))
    (for ([i u32 0]) (< i 64) (+= i 1) (set! (@ pad i) (bit-xor (@ pad i) #x6a)))
    (sha256-init! (& (-> m outer)))
    (sha256-add! (& (-> m outer)) (slice pad))))

(define (hmac-add! [m (ptr hmac)] [b (slice u8)]) (sha256-add! (& (-> m inner)) b))

;; into takes the 32 bytes of the code.
(define (hmac-end! [m (ptr hmac)] [into (slice u8)])
  (let ([digest (array u8 32)])
    (sha256-end! (& (-> m inner)) (slice digest))
    (sha256-add! (& (-> m outer)) (slice digest))
    (sha256-end! (& (-> m outer)) into)))

(define (hmac-of [key (slice u8)] [b (slice u8)] [into (slice u8)])
  (let ([m hmac])
    (hmac-init! (& m) key)
    (hmac-add! (& m) b)
    (hmac-end! (& m) into)))

;; hmac-equal? takes time that depends only on the lengths.
(define (hmac-equal? [a (slice u8)] [b (slice u8)]) -> bool
  (let ([d u8 0])
    (when (!= (-> a length) (-> b length)) (return #f))
    (for ([i u32 0]) (< i (-> a length)) (+= i 1) (set! d (bit-or d (bit-xor (@ a i) (@ b i)))))
    (== d 0)))

;; hkdf! fills out, at most 8160 bytes, with keys from the secret, the salt and info, which names their use.
(define (hkdf! [secret (slice u8)] [salt (slice u8)] [info (slice u8)] [out (slice u8)])
  (let ([key (array u8 32)] [t (array u8 32)] [m hmac] [n (array u8 1)] [done u32 0])
    (when (> (-> out length) 8160) (host-trap "hkdf: more than 8160 bytes"))
    (hmac-of salt secret (slice key))
    (set! (@ n 0) 0)
    (while (< done (-> out length))
      (hmac-init! (& m) (slice key))
      (when (> (@ n 0) 0) (hmac-add! (& m) (slice t)))
      (hmac-add! (& m) info)
      (+= (@ n 0) 1)
      (hmac-add! (& m) (slice n))
      (hmac-end! (& m) (slice t))
      (let ([take (if (< (- (-> out length) done) 32) (- (-> out length) done) 32)])
        (memcpy (+ (-> out items) done) t take)
        (+= done take)))))

(define (pbkdf2! [password (slice u8)] [salt (slice u8)] [iterations u32] [out (slice u8)])
  (let ([base hmac] [m hmac] [u (array u8 32)] [t (array u8 32)] [index (array u8 4)] [block u32 0] [done u32 0])
    (hmac-init! (& base) password)
    (while (< done (-> out length))
      (+= block 1)
      (for ([i u32 0]) (< i 4) (+= i 1) (set! (@ index i) (cast u8 (>> block (* 8 (- 3 i))))))
      (memcpy (& m) (& base) (sizeof hmac))
      (hmac-add! (& m) salt)
      (hmac-add! (& m) (slice index))
      (hmac-end! (& m) (slice u))
      (memcpy t u 32)
      (for ([i u32 1]) (< i iterations) (+= i 1)
        (memcpy (& m) (& base) (sizeof hmac))
        (hmac-add! (& m) (slice u))
        (hmac-end! (& m) (slice u))
        (for ([j u32 0]) (< j 32) (+= j 1) (set! (@ t j) (bit-xor (@ t j) (@ u j)))))
      (let ([take (if (< (- (-> out length) done) 32) (- (-> out length) done) 32)])
        (memcpy (+ (-> out items) done) t take)
        (+= done take)))))
