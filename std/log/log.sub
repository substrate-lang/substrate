;; Logs after Go's log/slog: an entry is a level, a message and attributes, written as one line of key=value text or
;; JSON when its level is at least the logger's. A text value is quoted when it needs to be; a byte that would break the
;; line is escaped as JSON escapes it, and one that is not UTF-8 is written as U+FFFD.
(require-unqualified host/modules/clock)
(require-unqualified std/encoding/utf8)

(provide logger log-entry log-debug log-info log-warn log-error log-default log! log-value! log-begin! log-string!
         log-int! log-float! log-bool! log-end!)

(const log-debug i32 -4)
(const log-info i32 0)
(const log-warn i32 4)
(const log-error i32 8)

;; level is the least level written, log-info when 0; json writes JSON lines; lines go to write when it is set, or else
;; to fd, stderr when 0.
(struct logger [level i32] [json bool] [fd i32] [write (fn ((ptr logger) (slice u8)))])

;; An entry that log-begin! does not start, for its level, takes no attributes and writes nothing.
(struct log-entry [logger (ptr logger)] [line buffer] [valid bool])

(define log-default logger)

(define (level-name [level i32]) -> string
  (cond [(< level log-info) "DEBUG"] [(< level log-warn) "INFO"] [(< level log-error) "WARN"] [else "ERROR"]))

(define (two! [b (ptr buffer)] [n i64])
  (buffer-add-byte! b (+ #\0 (cast i32 (/ n 10))))
  (buffer-add-byte! b (+ #\0 (cast i32 (% n 10)))))

;; time! writes the time, in RFC 3339 to the millisecond in UTC.
(define (time! [b (ptr buffer)] [ms f64])
  (let* ([all (cast i64 ms)] [seconds (/ all 1000)] [days (/ seconds 86400)] [rest (% seconds 86400)]
         [z (+ days 719468)] [era (/ z 146097)] [doe (- z (* era 146097))]
         [yoe (/ (- (+ (- doe (/ doe 1460)) (/ doe 36524)) (/ doe 146096)) 365)]
         [doy (- doe (- (+ (* 365 yoe) (/ yoe 4)) (/ yoe 100)))] [mp (/ (+ (* 5 doy) 2) 153)]
         [day (+ (- doy (/ (+ (* 153 mp) 2) 5)) 1)] [month (if (< mp 10) (+ mp 3) (- mp 9))]
         [year (+ yoe (* era 400) (if (<= month 2) 1 0))] [milli (% all 1000)])
    (write-digits b (cast u64 year) 10)
    (buffer-add-byte! b #\-)
    (two! b month)
    (buffer-add-byte! b #\-)
    (two! b day)
    (buffer-add-byte! b #\T)
    (two! b (/ rest 3600))
    (buffer-add-byte! b #\:)
    (two! b (/ (% rest 3600) 60))
    (buffer-add-byte! b #\:)
    (two! b (% rest 60))
    (buffer-add-byte! b #\.)
    (buffer-add-byte! b (+ #\0 (cast i32 (/ milli 100))))
    (two! b (% milli 100))
    (buffer-add-byte! b #\Z)))

(define (plain? [s string]) -> bool
  (when (== (-> s length) 0) (return #f))
  (for ([i u32 0]) (< i (-> s length)) (+= i 1)
    (let ([c (@ s i)]) (when (or (<= c #\space) (>= c #\delete) (== c #\=) (== c #\") (== c #\\)) (return #f))))
  #t)

(define (quoted! [b (ptr buffer)] [s string])
  (let ([i u32 0] [bytes (cast (slice u8) s)])
    (buffer-add-byte! b #\")
    (while (< i (-> s length))
      (let ([c (@ s i)] [n u32 1])
        (cond [(or (== c #\") (== c #\\))
               (buffer-add-byte! b #\\)
               (buffer-add-byte! b c)]
              [(== c #\newline) (buffer-add-string! b "\\n")]
              [(== c #\return) (buffer-add-string! b "\\r")]
              [(== c #\tab) (buffer-add-string! b "\\t")]
              [(or (< c #\space) (== c #\delete))
               (buffer-add-string! b "\\u00")
               (buffer-add-byte! b (@ "0123456789abcdef" (>> c 4)))
               (buffer-add-byte! b (@ "0123456789abcdef" (bit-and c 15)))]
              [(< c 128) (buffer-add-byte! b c)]
              [else
               (set! n (utf-8-length bytes i))
               (if (== n 0)
                   (begin
                     (buffer-add-string! b "\\ufffd")
                     (set! n 1))
                   (buffer-add! b (slice bytes i (+ i n))))])
        (+= i n)))
    (buffer-add-byte! b #\")))

(define (key! [e (ptr log-entry)] [key string])
  (let ([b (& (-> e line))])
    (if (-> e logger json)
        (begin
          (when (> (-> b length) 1) (buffer-add-byte! b #\,))
          (quoted! b key)
          (buffer-add-byte! b #\:))
        (begin
          (when (> (-> b length) 0) (buffer-add-byte! b #\space))
          (if (plain? key) (buffer-add-string! b key) (quoted! b key))
          (buffer-add-byte! b #\=)))))

(define (log-string! [e (ptr log-entry)] [key string] [value string])
  (when (-> e valid)
    (key! e key)
    (if (or (-> e logger json) (not (plain? value)))
        (quoted! (& (-> e line)) value)
        (buffer-add-string! (& (-> e line)) value))))

(define (log-int! [e (ptr log-entry)] [key string] [value i64])
  (when (-> e valid)
    (key! e key)
    (when (< value 0) (buffer-add-byte! (& (-> e line)) #\-))
    (write-digits (& (-> e line)) (cast u64 (if (< value 0) (- 0 value) value)) 10)))

;; log-float! writes a value that is not a finite number as null in JSON, and in text as NaN, +Inf or -Inf.
(define (log-float! [e (ptr log-entry)] [key string] [value f64])
  (when (-> e valid)
    (key! e key)
    (let ([b (& (-> e line))])
      (cond [(and (== value value) (!= value (/ 1.0 0.0)) (!= value (/ -1.0 0.0))) (write-flonum b value)]
            [(-> e logger json) (buffer-add-string! b "null")]
            [(!= value value) (buffer-add-string! b "NaN")]
            [else (buffer-add-string! b (if (> value 0.0) "+Inf" "-Inf"))]))))

(define (log-bool! [e (ptr log-entry)] [key string] [value bool])
  (when (-> e valid)
    (key! e key)
    (buffer-add-string! (& (-> e line)) (if value "true" "false"))))

;; log-begin! starts an entry, with the time, the level and the message, and returns #f when the level is below the
;; logger's.
(define (log-begin! [e (ptr log-entry)] [l (ptr logger)] [level i32] [message string]) -> bool
  (set! (-> e logger) l)
  (set! (-> e line) (make-buffer))
  (set! (-> e valid) (>= level (-> l level)))
  (when (-> e valid)
    (when (-> l json) (buffer-add-byte! (& (-> e line)) #\{))
    (key! e "time")
    (when (-> l json) (buffer-add-byte! (& (-> e line)) #\"))
    (time! (& (-> e line)) (clock-now))
    (when (-> l json) (buffer-add-byte! (& (-> e line)) #\"))
    (log-string! e "level" (level-name level))
    (log-string! e "msg" message))
  (-> e valid))

(define (log-end! [e (ptr log-entry)])
  (when (-> e valid)
    (when (-> e logger json) (buffer-add-byte! (& (-> e line)) #\}))
    (buffer-add-byte! (& (-> e line)) #\newline)
    (if (== (-> e logger write) 0)
        (host-write (if (== (-> e logger fd) 0) 2 (-> e logger fd)) (buffer-bytes (& (-> e line))))
        ((-> e logger write) (-> e logger) (buffer-bytes (& (-> e line)))))
    (set! (-> e valid) #f))
  (buffer-free! (& (-> e line))))

(begin-for-syntax
  (require-unqualified compiler/macros)
  (require-unqualified std/meta/type-info)

  (define (log-form [s datum]) -> datum
    (syntax-match s
      [(_ l level message attribute ...)
       #`(let ([e log-entry])
           (when (log-begin! (& e) #,l #,level #,message) #,@(attributes attribute))
           (log-end! (& e)))]
      [_ (raise-syntax-error 'log! "expected (log! logger level message key value ...)" s)]))

  (define (attributes [as datum]) -> datum
    (cond [(null? as) nil]
          [(null? (cdr as)) (raise-syntax-error 'log! "this key has no value" (car as))]
          [else (cons #`(log-value! (& e) #,(car as) #,(cadr as)) (attributes (cddr as)))]))

  (define (log-value-form [s datum]) -> datum
    (syntax-match s
      [(_ e key value) #`(let ([to #,e] [k #,key] [v #,value]) (log-typed! to k v #,value))]
      [_ (raise-syntax-error 'log-value! "expected (log-value! entry key value)" s)]))

  (define (log-typed-form [s datum]) -> datum
    (syntax-match s
      [(_ e key v value)
       (let ([t (variable-type v)])
         (cond [(== t 'string) #`(log-string! #,e #,key #,v)]
               [(== t 'bool) #`(log-bool! #,e #,key #,v)]
               [(!= (memq t '(f32 f64)) 0) #`(log-float! #,e #,key (cast f64 #,v))]
               [(!= (memq t '(i8 u8 i16 u16 i32 u32 i64 u64)) 0) #`(log-int! #,e #,key (cast i64 #,v))]
               [else (raise-syntax-error 'log! (datum->string (format "a value is a string, a number or a boolean, not ~s"
                                                                       `(,(type-datum t))))
                                         value)]))])))

(define-syntax log! log-form)
(define-syntax log-value! log-value-form)
(define-syntax log-typed! log-typed-form)
