;; Hash maps: tables from keys to values, on the heap. (hash-map K V) maps keys of type K, which are integers, bools,
;; enums, pointers or strings, to values of type V, and its zero value is empty. hash-map-set! sets a key's value.
;; hash-map-ref gives the value, or V's zero value when the map does not hold the key, and hash-map-find gives a
;; pointer to it, or 0. hash-map-remove!, hash-map-count, hash-map-clear! and hash-map-free! take a pointer to a map
;; too, and hash-map-each runs its body for each key and a pointer to its value. A string key keeps the string's
;; bytes where they are: the map does not copy them. Growing moves the values, so a pointer to one lasts until the map
;; next grows.
(require-unqualified std/meta/method)
(require-unqualified std/meta/type)

(provide hash-map hash-map-ref hash-map-find hash-map-set! hash-map-remove! hash-map-count hash-map-clear!
         hash-map-free! hash-map-each)

(begin-for-syntax
  (require-unqualified compiler/macros)
  (require-unqualified std/meta/type-info)

  (define (key-hash-form [s datum]) -> datum
    (syntax-match s
      [(_ k)
       (let ([t (variable-type k)])
         (cond [(== t 'string) #`(hash-bytes (cast (slice u8) #,k))]
               [(or (and (symbol? t) (== (memq t '(f32 f64)) 0)) (and (pair? t) (== (car t) 'ptr))
                    (and (identifier? t) (let ([info (type-info t)]) (and (!= info 0) (== (car info) 'enum)))))
                #`(cast u64 #,k)]
               [else (raise-syntax-error 'hash-map (format-message "keys are integers, bools, enums, pointers or strings, not ~s"
                                                                   `(,(type-datum t)))
                                         k)]))]))

  (define (hash-map-each-form [s datum]) -> datum
    (syntax-match s
      [(_ (((? identifier? k) (? identifier? v) m)) body0 body ...)
       #`(let ([the-map #,m])
           (for ([i u32 0]) (< i (-> the-map room)) (+= i 1)
             (let ([slot (+ (-> the-map slots) i)])
               (when (-> slot full)
                 (let ([#,k (-> slot key)] [#,v (& (-> slot value))]) #,body0 #,@body)))))]
      [_ (raise-syntax-error 'hash-map-each "expected (hash-map-each ([key value map]) body ...)" s)])))

(define-syntax key-hash key-hash-form)

(define-type (hash-map-slot K V)
  (struct [key K] [value V] [full bool]))

(define-type (hash-map K V)
  (struct [slots (ptr (hash-map-slot K V))] [count u32] [room u32] [shift u32])
  (define (-home [m (ptr (hash-map K V))] [k K]) #:inline -> u32
    (cast u32 (>> (* (key-hash k) 11400714819323198485) (-> m shift))))
  (define (-slot [m (ptr (hash-map K V))] [k K]) #:inline -> u32
    (when (== (-> m room) 0) (return 0))
    (let ([mask (- (-> m room) 1)] [i (-home m k)])
      (while (-> (+ (-> m slots) i) full)
        (when (== (-> (+ (-> m slots) i) key) k) (return i))
        (set! i (bit-and (+ i 1) mask)))
      (-> m room)))
  (define (-find [m (ptr (hash-map K V))] [k K]) #:inline -> (ptr V)
    (let ([i (-slot m k)]) (if (== i (-> m room)) 0 (& (-> (+ (-> m slots) i) value)))))
  (define (-ref [m (ptr (hash-map K V))] [k K]) #:inline -> V
    (let ([p (-find m k)] [none V]) (if (== p 0) none (@ p))))
  (define (-set! [m (ptr (hash-map K V))] [k K] [v V])
    (when (>= (* 4 (+ (-> m count) 1)) (* 3 (-> m room))) (-grow! m))
    (let* ([mask (- (-> m room) 1)] [i (-home m k)] [s (+ (-> m slots) i)])
      (while (-> s full)
        (when (== (-> s key) k)
          (set! (-> s value) v)
          (return))
        (set! i (bit-and (+ i 1) mask))
        (set! s (+ (-> m slots) i)))
      (set! (-> s key) k)
      (set! (-> s value) v)
      (set! (-> s full) #t)
      (+= (-> m count) 1)))
  (define (-grow! [m (ptr (hash-map K V))])
    (let ([old (-> m slots)] [n (-> m room)])
      (set! (-> m room) (if (== n 0) 8 (* 2 n)))
      (set! (-> m shift) (if (== n 0) 61 (- (-> m shift) 1)))
      (set! (-> m slots) (cast (ptr (hash-map-slot K V)) (calloc (-> m room) (sizeof (hash-map-slot K V)))))
      (set! (-> m count) 0)
      (for ([i u32 0]) (< i n) (+= i 1)
        (let ([s (+ old i)]) (when (-> s full) (-set! m (-> s key) (-> s value)))))
      (free old)))
  (define (-remove! [m (ptr (hash-map K V))] [k K]) -> bool
    (let ([i (-slot m k)] [j u32 0] [h u32 0] [mask (- (-> m room) 1)] [slots (-> m slots)])
      (when (== i (-> m room)) (return #f))
      (set! j i)
      (while #t
        (set! j (bit-and (+ j 1) mask))
        (unless (-> (+ slots j) full) (break))
        (set! h (-home m (-> (+ slots j) key)))
        (unless (if (<= i j) (and (< i h) (<= h j)) (or (< i h) (<= h j)))
          (set! (@ (+ slots i)) (@ (+ slots j)))
          (set! i j)))
      (set! (-> (+ slots i) full) #f)
      (-= (-> m count) 1)
      #t))
  (define (-count [m (ptr (hash-map K V))]) -> u32 (-> m count))
  (define (-clear! [m (ptr (hash-map K V))])
    (when (!= (-> m room) 0) (memset (-> m slots) 0 (* (-> m room) (sizeof (hash-map-slot K V)))))
    (set! (-> m count) 0))
  (define (-free! [m (ptr (hash-map K V))])
    (free (-> m slots))
    (set! (-> m slots) 0)
    (set! (-> m count) 0)
    (set! (-> m room) 0)
    (set! (-> m shift) 0)))

(define-syntax hash-map-each hash-map-each-form)
(define-methods [hash-map-ref -ref] [hash-map-find -find] [hash-map-set! -set!] [hash-map-remove! -remove!]
                [hash-map-count -count] [hash-map-clear! -clear!] [hash-map-free! -free!])
