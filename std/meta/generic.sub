;; Generic types and functions, which take types as parameters.
;;
;; (define-generic (name param ...) form) defines a generic type. form is a struct, union, variant or enum form without
;; a name. A param is a name for a type, or [n type] for a count of an integer type. The type (name arg ...) is an
;; instance: form with each param standing for its arg. A count's arg is an integer literal or a constant. An instance is
;; the same type in every module that writes it.
;;
;; (define-generic ((name param ...) [x type] ...) -> result body ...) defines a generic function. Its params work as a
;; generic type's do. A call (name arg ...) finds the params from the types of its args. (name type ...) is the instance
;; for those types, so ((name type ...) arg ...) calls it with its params named.
;;
;; (define-generic name writer) defines a generic type whose instances the macro writer writes. For (name arg ...), the
;; compiler expands (writer name instance arg ...). The expansion defines a type named instance, and it can also define
;; functions for that type.
;;
;; Each instance of a generic type records the generic type and args it comes from. instance-origin in
;; std/meta/type-info reads them.
(provide define-generic)

(begin-for-syntax
  (require-unqualified compiler/macros)
  (require-unqualified "type-info.sub")

  (define (define-generic-form [s datum]) -> datum
    (syntax-match s
      [(_ (((? identifier? name) param ...) formal ...) rest ...)
       (for/each ([p param]) (param! p))
       (for/each ([f formal]) (formal! f))
       (let ([writer (datum->syntax #'here (syntax-e name) name)])
         #`(begin
             (define-syntax #,writer (quote-syntax (substrate-function-writer function-instance (#,@param) (#,@formal) #,@rest)))
             (define-syntax #,name generic-call-form #'#,writer)))]
      [(_ ((? identifier? name) param ...) form ...)
       (for/each ([p param]) (param! p))
       (let ([bad datum (cond [(null? form) s] [(not (type-form? (car form))) (car form)]
                              [(pair? (cdr form)) (cadr form)] [else 0])])
         (unless (== bad 0)
           (raise-syntax-error 'define-generic "expected one struct, union, variant or enum form without a name" bad)))
       #`(define-syntax #,name (quote-syntax (substrate-type-writer type-instance (#,@param) #,(car form))))]
      [(_ (? identifier? name) (? identifier? writer))
       #`(define-syntax #,name (quote-syntax (substrate-type-writer written-instance #,writer)))]
      [_ (raise-syntax-error
          'define-generic
          "expected (define-generic (name param ...) form), (define-generic ((name param ...) [x type] ...) body ...) or (define-generic name writer)"
          s)]))

  (define (param! [p datum])
    (syntax-match p
      [(? identifier? x) (built-in! x)]
      [((? identifier? x) (? identifier? t))
       (when (== (memq (syntax-e t) counts) 0) (raise-syntax-error 'define-generic param-text p))
       (built-in! x)]
      [_ (raise-syntax-error 'define-generic param-text p)]))

  (define (built-in! [x datum])
    (unless (== (memq (syntax-e x) built-ins) 0)
      (raise-syntax-error 'define-generic (format-message "~a is a built-in type, so it cannot name a param" `(,(syntax-e x))) x)))

  (define (formal! [f datum])
    (syntax-match f
      [((? identifier? x) t) (begin)]
      [_ (raise-syntax-error 'define-generic "expected [x type]" f)]))

  (define param-text string "expected a type's name, or [name type] for a count of an integer type")

  (define counts datum '(i8 u8 i16 u16 i32 u32 i64 u64))

  (define built-ins datum '(void i8 u8 i16 u16 i32 u32 i64 u64 f32 f64 exnref bool string))

  (define (type-form? [f datum]) -> bool
    (let ([l (syntax->list f)])
      (and (!= l 0) (pair? l) (identifier? (car l)) (!= (memq (syntax-e (car l)) '(struct union variant enum)) 0)
           (or (null? (cdr l)) (not (identifier? (cadr l)))))))

  ;; ---- instances ----

  (define (type-instance-form [s datum]) -> datum
    (syntax-match s
      [(_ f name arg ...)
       (syntax-match (syntax-local-value f)
         [(_ _ (param ...) form)
          (arguments! f param arg)
          (let ([l (syntax->list form)])
            #`(begin
                #,@(param-definitions param arg)
                #,(datum->syntax form (cons (car l) (cons name (cdr l))) form)
                (#%fact #,name #'(instance-of #,f #,@arg))))])]))

  (define (written-instance-form [s datum]) -> datum
    (syntax-match s
      [(_ f name arg ...)
       (syntax-match (syntax-local-value f)
         [(_ _ writer) #`(begin (#,writer #,f #,name #,@arg) (#%fact #,name #'(instance-of #,f #,@arg)))])]))

  (define (function-instance-form [s datum]) -> datum
    (syntax-match s
      [(_ f name arg ...)
       (syntax-match (syntax-local-value f)
         [(_ _ (param ...) (formal ...) rest ...)
          (arguments! f param arg)
          #`(begin #,@(param-definitions param arg) (define (#,name #,@formal) #,@rest))])]))

  ;; An instance's params: a typedef for each type and a const for each count.
  (define (param-definitions [params datum] [args datum]) -> datum
    (for/list ([p params] [a args])
      (syntax-match p
        [(? identifier? x) #`(typedef #,x #,a)]
        [(x t) #`(const #,x #,t #,a)])))

  (define (arguments! [f datum] [params datum] [args datum])
    (unless (== (length params) (length args))
      (raise-syntax-error (syntax-e f) (count-text (length params) (length args)) f))
    (for/each ([p params] [a args])
      (let ([n (syntax-e a)])
        (syntax-match p
          [(? identifier? x)
           (when (integer? n) (raise-syntax-error (syntax-e f) (format-message "~a is a type, not ~a" `(,(syntax-e x) ,n)) f))]
          [(x t)
           (unless (integer? n)
             (raise-syntax-error (syntax-e f) (format-message "~a is a ~a, not ~s" `(,(syntax-e x) ,(syntax-e t) ,(type-datum a))) f))
           (unless (fits? n (syntax-e t))
             (raise-syntax-error (syntax-e f) (format-message "integer ~a does not fit in ~a" `(,n ,(syntax-e t))) f))]))))

  (define (count-text [n u32] [m u32]) -> string
    (format-message "takes ~a argument~a, not ~a" `(,(make-integer n) ,(if (== n 1) '"" '"s") ,(make-integer m))))

  (define (fits? [n datum] [t datum]) -> bool
    (let ([v (integer-value n)] [m (cast u64 (integer-value n))])
      (if (integer-negative? n)
          (case t [('i8) (>= v -128)] [('i16) (>= v -32768)] [('i32) (>= v -2147483648)] [('i64) #t] [else #f])
          (case t
            [('u8) (<= m 255)] [('i8) (<= m 127)] [('u16) (<= m 65535)] [('i16) (<= m 32767)]
            [('u32) (<= m 4294967295)] [('i32) (<= m 2147483647)] [('i64) (<= m 9223372036854775807)]
            [else #t]))))

  ;; ---- calls ----

  ;; A generic function's name.
  (define (generic-call-form [writer datum] [s datum]) -> datum
    (let* ([v (syntax->list (syntax-local-value writer))] [params (syntax->list (caddr v))]
           [formals (syntax->list (cadddr v))] [l (syntax->list s)])
      (when (== l 0)
        (raise-syntax-error 0 (format-message "needs args, or types as in ~a" `(,(generic-shape writer params))) s))
      (cond [(and (== (length (cdr l)) (length params)) (type-args? params (cdr l))) #`(#,writer #,@(cdr l))]
            [(== (length (cdr l)) (length formals)) (inferred writer params formals s (cdr l))]
            [else (raise-syntax-error (syntax-e writer) (count-text (length formals) (length (cdr l))) s)])))

  (define (generic-shape [writer datum] [params datum]) -> datum (cons (syntax-e writer) (param-names params)))

  ;; A call that finds its params from the types of its args.
  (define (inferred [writer datum] [params datum] [formals datum] [s datum] [args datum]) -> datum
    (let ([names (param-names params)] [decided nil] [last i32 -1] [i i32 0])
      (for/each ([f formals] [a args])
        (let ([ps (mentioned (formal-type f) names)])
          (when (and (not (literal-arg? a)) (ormap (lambda ([p datum]) -> bool (== (memq p decided) 0)) ps))
            (when (== (variable-type-of a) 0) (set! last i))
            (set! decided (append ps decided))))
        (+= i 1))
      (if (< last 0)
          (solved writer params formals s args args)
          (let* ([n i32 0]
                 [xs (for/list ([a args])
                       (+= n 1)
                       (if (and (<= n (+ last 1)) (not (lasting-arg? a)))
                           (datum->syntax #'here (string->symbol (format-message "the-arg~a" `(,(make-integer n)))) a)
                           a))])
            #`(let (#,@(for/list ([x xs] [a args] #:when (not (equal? x a))) #`[#,x #,a]))
                (generic-solved #,writer #,s #,@(for/list ([x xs] [a args]) #`(#,x #,a))))))))

  (define (generic-solved-form [s datum]) -> datum
    (syntax-match s
      [(_ writer form (x a) ...)
       (let ([v (syntax->list (syntax-local-value writer))])
         (solved writer (syntax->list (caddr v)) (syntax->list (cadddr v)) form x a))]))

  (define (solved [writer datum] [params datum] [formals datum] [s datum] [args datum] [blamed datum]) -> datum
    (let ([names (param-names params)] [env nil])
      (for/each ([f formals] [a args] [b blamed])
        (let ([p (formal-type f)])
          (when (and (not (literal-arg? a)) (ormap (lambda ([n datum]) -> bool (== (assq n env) 0)) (mentioned p names)))
            (let ([t (variable-type-of a)])
              (unless (== t 0)
                (let ([e (match-type p t env params)])
                  (when (== e 0)
                    (raise-syntax-error (syntax-e writer) (format-message "expected ~s, not ~s" `(,(syntax->datum p) ,(shown t))) b))
                  (set! env e)))))))
      (for/each ([f formals] [a args])
        (let ([p (formal-type f)] [d (literal-type a)])
          (when (and (!= d 0) (identifier? p) (!= (memq (syntax-e p) names) 0) (== (assq (syntax-e p) env) 0))
            (set! env (cons (cons (syntax-e p) d) env)))))
      (let ([callee #`(#,writer #,@(for/list ([n names])
                                     (let ([b (assq n env)])
                                       (when (== b 0)
                                         (raise-syntax-error (syntax-e writer)
                                                             (format-message "cannot tell what ~a is from the args: name the types, as in (~a arg ...)"
                                                                             `(,n ,(generic-shape writer params)))
                                                             s))
                                       (type-of-datum (cdr b)))))])
        #`(#,(datum->syntax callee (syntax-e callee) s) #,@args))))

  (define (type-args? [params datum] [args datum]) -> bool
    (let ([ok #t])
      (for/each ([p params] [a args]) (unless (if (identifier? p) (type-arg? a) (count-arg? a)) (set! ok #f)))
      ok))

  (define (type-arg? [a datum]) -> bool
    (syntax-match a
      [(? identifier? x) (or (!= (memq (syntax-e x) built-ins) 0) (named-type? x))]
      [('slice t) (type-arg? t)]
      [((? identifier? h) _ ...) (or (!= (memq (syntax-e h) '(ptr array fn closure)) 0) (type-writer? h))]
      [_ #f]))

  (define (count-arg? [a datum]) -> bool (or (integer? (syntax-e a)) (!= (constant-value a) 0)))

  (define (named-type? [x datum]) -> bool
    (and (== (identifier-binding-kind x) 'compile-time-value)
         (syntax-match (syntax-local-value x) [('substrate-struct . _) #t] [('substrate-typedef . _) #t] [_ #f])))

  (define (type-writer? [x datum]) -> bool
    (and (identifier? x) (== (identifier-binding-kind x) 'compile-time-value)
         (syntax-match (syntax-local-value x) [('substrate-type-writer . _) #t] [_ #f])))

  ;; A constant's value, or 0.
  (define (constant-value [n datum]) -> datum
    (if (and (identifier? n) (== (identifier-binding-kind n) 'macro))
        (syntax-match (syntax-local-value n) [('#%form 'constant ('cast _ c)) (syntax-e c)] [_ 0])
        0))

  (define (literal-arg? [a datum]) -> bool
    (let ([d (syntax-e a)])
      (or (integer? d) (flonum? d) (char? d) (boolean? d) (string? d)
          (and (symbol? d) (!= (undotted d) 0))
          (and (pair? d) (identifier? (car d)) (!= (undotted (syntax-e (car d))) 0)))))

  ;; Whether a keeps its value while the args after it run.
  (define (lasting-arg? [a datum]) -> bool
    (or (literal-arg? a)
        (and (identifier? a) (== (identifier-binding-kind a) 'function))
        (and (not (identifier? a)) (!= (variable-type-of a) 0))))

  ;; The type a literal has when nothing else gives it one, or 0 for a case.
  (define (literal-type [a datum]) -> datum
    (let ([d (syntax-e a)])
      (cond [(or (integer? d) (char? d)) 'i32]
            [(flonum? d) 'f64]
            [(boolean? d) 'bool]
            [(string? d) 'string]
            [else 0])))

  ;; The type of a variable or (& variable), as the checker holds it, or 0.
  (define (variable-type-of [a datum]) -> datum
    (let ([l (if (identifier? a) 0 (syntax->list a))])
      (cond [(identifier? a)
             (if (== (memq (identifier-binding-kind a) '(variable function)) 0) 0 (syntax-local-type a))]
            [(and (!= l 0) (== (length l) 2) (identifier? (car l)) (free-identifier=? (car l) #'&) (identifier? (cadr l)))
             (let ([t (variable-type-of (cadr l))])
               (cond [(== t 0) 0] [(== (identifier-binding-kind (cadr l)) 'function) t] [else `(ptr ,t)]))]
            [else 0])))

  (define (formal-type [f datum]) -> datum (cadr (syntax->list f)))

  (define (param-names [params datum]) -> datum
    (for/list ([p params]) (syntax-e (if (identifier? p) p (car (syntax->list p))))))

  (define (param-kind [name datum] [params datum]) -> datum
    (let ([kind datum 0])
      (for/each ([p params])
        (if (identifier? p)
            (when (== (syntax-e p) name) (set! kind 'type))
            (when (== (syntax-e (car (syntax->list p))) name) (set! kind 'count))))
      kind))

  ;; The params that the type p mentions.
  (define (mentioned [p datum] [names datum]) -> datum
    (let ([e (syntax-e p)])
      (cond [(symbol? e) (if (== (memq e names) 0) nil (cons e nil))]
            [(pair? e) (for/fold ([acc nil]) ([x (syntax->list p)]) (append (mentioned x names) acc))]
            [else nil])))

  ;; ---- matching types ----

  ;; env with what each param in the type p stands for in the type t, as the checker holds it, or 0 if they do not match.
  (define (match-type [p datum] [t datum] [env datum] [params datum]) -> datum
    (let ([e (syntax-e p)])
      (cond
        [(== env 0) 0]
        [(symbol? e)
         (let ([kind (param-kind e params)])
           (cond [(== kind 'type) (bound-to e t env)]
                 [(== kind 'count) 0]
                 [(or (== e 'void) (!= (memq e built-ins) 0)) (if (== e t) env 0)]
                 [(same-named? p t) env]
                 [else 0]))]
        [(pair? e)
         (let* ([l (syntax->list p)] [h (if (and (!= l 0) (identifier? (car l))) (syntax-e (car l)) 0)])
           (cond
             [(== h 0) 0]
             [(and (!= (memq h '(ptr slice)) 0) (== (length l) 2) (pair? t) (== (car t) h)) (match-type (cadr l) (cadr t) env params)]
             [(and (== h 'array) (== (length l) 3) (pair? t) (== (car t) 'array))
              (match-count (caddr l) (caddr t) (match-type (cadr l) (cadr t) env params) params)]
             [(and (!= (memq h '(fn closure)) 0) (pair? t) (== (car t) h)) (match-function l t env params)]
             [(type-writer? (car l)) (match-instance l t env params)]
             [else 0]))]
        [else 0])))

  (define (bound-to [name datum] [t datum] [env datum]) -> datum
    (let ([b (assq name env)])
      (cond [(== b 0) (cons (cons name t) env)]
            [(equal? (cdr b) t) env]
            [else 0])))

  (define (same-named? [p datum] [t datum]) -> bool
    (and (== (identifier-binding-kind p) 'compile-time-value)
         (syntax-match (syntax-local-value p)
           [('substrate-struct . _) (and (pair? t) (!= (memq (car t) '(struct enum)) 0) (equal? (cadr t) (identifier-name p)))]
           [('substrate-typedef u) (equal? (syntax->datum u) t)]
           [_ #f])))

  (define (match-count [n datum] [m datum] [env datum] [params datum]) -> datum
    (let ([e (syntax-e n)] [c (constant-value n)])
      (cond [(== env 0) 0]
            [(and (symbol? e) (== (param-kind e params) 'count)) (bound-to e m env)]
            [(integer? e) (if (equal? e m) env 0)]
            [(!= c 0) (if (equal? c m) env 0)]
            [else 0])))

  (define (match-function [l datum] [t datum] [env datum] [params datum]) -> datum
    (let ([ps (syntax->list (cadr l))] [r (if (== (length l) 4) (cadddr l) 0)] [e env])
      (if (or (== ps 0) (!= (length ps) (length (cadr t))) (not (or (== (length l) 2) (== (length l) 4))))
          0
          (begin
            (for/each ([q ps] [u (cadr t)]) (set! e (match-type q u e params)))
            (cond [(== e 0) 0]
                  [(== r 0) (if (== (caddr t) 'void) e 0)]
                  [else (match-type r (caddr t) e params)])))))

  (define (match-instance [l datum] [t datum] [env datum] [params datum]) -> datum
    (let ([o (if (and (pair? t) (!= (memq (car t) '(struct enum)) 0)) (instance-origin (name-identifier (cadr t))) 0)] [e env])
      (if (or (== o 0) (not (free-identifier=? (car o) (car l))) (!= (length (cdr o)) (length (cdr l))))
          0
          (begin
            (for/each ([q (cdr l)] [a (cdr o)])
              (set! e (if (integer? (syntax-e a)) (match-count q (syntax-e a) e params) (match-type q (written-type a) e params))))
            e))))

  ;; An instance's arg, as the compiler writes it, as a type as the checker holds it.
  (define (written-type [a datum]) -> datum
    (let ([e (syntax-e a)])
      (if (symbol? e)
          (if (!= (memq e built-ins) 0)
              e
              (syntax-match (if (== (identifier-binding-kind a) 'compile-time-value) (syntax-local-value a) 0)
                [('substrate-typedef u) (syntax->datum u)]
                [('substrate-struct n fs k nums) `(enum ,(identifier-name a) ,(syntax-e n))]
                [('substrate-struct n fs k) `(struct ,(identifier-name a) ,(syntax-e n))]
                [_ 0]))
          (let ([l (syntax->list a)])
            (case (syntax-e (car l))
              [('ptr 'slice) `(,(syntax-e (car l)) ,(written-type (cadr l)))]
              [('array) `(array ,(written-type (cadr l)) ,(syntax-e (caddr l)))]
              [('fn 'closure)
               `(,(syntax-e (car l)) ,(for/list ([u (syntax->list (cadr l))]) (written-type u))
                 ,(if (== (length l) 4) (written-type (cadddr l)) 'void))]
              [else 0])))))

  ;; A type as the checker holds it, as an error shows it.
  (define (shown [t datum]) -> datum
    (cond [(symbol? t) t]
          [(!= (memq (car t) '(struct enum)) 0) (type-datum (caddr t))]
          [(!= (memq (car t) '(ptr slice)) 0) `(,(car t) ,(shown (cadr t)))]
          [(== (car t) 'array) `(array ,(shown (cadr t)) ,(caddr t))]
          [(!= (memq (car t) '(fn closure)) 0)
           `(,(car t) ,(for/list ([u (cadr t)]) (shown u)) ,@(if (== (caddr t) 'void) nil `(-> ,(shown (caddr t)))))]
          [else t]))

  ;; A type as the checker holds it, or a count, as syntax.
  (define (type-of-datum [t datum]) -> datum
    (cond [(or (integer? t) (symbol? t)) (datum->syntax #'here t 0)]
          [(!= (memq (car t) '(struct enum)) 0) (syntax-local-introduce (name-identifier (cadr t)))]
          [(!= (memq (car t) '(ptr slice)) 0) #`(#,(datum->syntax #'here (car t) 0) #,(type-of-datum (cadr t)))]
          [(== (car t) 'array) #`(array #,(type-of-datum (cadr t)) #,(datum->syntax #'here (caddr t) 0))]
          [(!= (memq (car t) '(fn closure)) 0)
           #`(#,(datum->syntax #'here (car t) 0) (#,@(for/list ([u (cadr t)]) (type-of-datum u)))
              #,@(if (== (caddr t) 'void) nil (cons (datum->syntax #'here '-> 0) (cons (type-of-datum (caddr t)) nil))))]
          [else (datum->syntax #'here t 0)])))

(define-syntax define-generic define-generic-form)
(define-syntax type-instance type-instance-form)
(define-syntax written-instance written-instance-form)
(define-syntax function-instance function-instance-form)
(define-syntax generic-solved generic-solved-form)

;; doc-forms tells sub doc which of these forms define what (std/doc/doc.sub).
(define-syntax doc-forms
  (quote-syntax
   ((function (define-generic ((NAME PARAM ...) PARAM ...) -> RESULT _ ...))
    (function (define-generic ((NAME PARAM ...) PARAM ...) _ ...))
    (type (define-generic (NAME PARAM ...) TYPE))
    (type (define-generic NAME WRITER)))))
