(provide equal?)

(begin-for-syntax
  (require-unqualified macros compiler/macros)
  (require-unqualified meta "type-info.sub")

  (define counter u32 0)

  (define (fresh [base datum]) -> datum
    (+= counter 1)
    (datum->syntax #'here (string->symbol (format-message "~a~a" `(,base ,(make-integer counter)))) 0))

  (define (equal-form [s datum]) -> datum
    (syntax-match s
      [(_ a b)
       (let ([x (if (array? a) a #'x)] [y (if (array? b) b #'y)])
         #`(let (#,@(if (array? a) nil (cons #`[x #,a] nil)) #,@(if (array? b) nil (cons #`[y #,b] nil)))
             (equal-values? #,x #,y #,s)))]
      [_ (raise-syntax-error 'equal? "expected (equal? a b)" s)]))

  (define (array? [e datum]) -> bool
    (and (identifier? e) (let ([t (variable-type e)]) (and (pair? t) (== (car t) 'array)))))

  (define (equal-values-form [s datum]) -> datum
    (syntax-match s
      [(_ x y form)
       (let ([t (variable-type x)] [u (variable-type y)])
         (unless (or (and (number? t) (number? u)) (equal? (type-datum t) (type-datum u)))
           (raise-syntax-error 'equal? (datum->string (format "compares values of one type, not ~s and ~s" `(,(type-datum t) ,(type-datum u))))
                               form))
         (compared form t x y))]))

  (define (number? [t datum]) -> bool (!= (memq t '(i8 u8 i16 u16 i32 u32 i64 u64 f32 f64)) 0))

  (define (compared [s datum] [t datum] [x datum] [y datum]) -> datum
    (cond [(symbol? t) #`(== #,x #,y)]
          [(identifier? t) (compared-type s t x y)]
          [(== (car t) 'ptr) #`(== #,x #,y)]
          [(== (car t) 'slice)
           (compared-elements s (cadr t) x y #`(-> #,x length) #`(== (-> #,x length) (-> #,y length)))]
          [(== (car t) 'array) (compared-elements s (cadr t) x y (datum->syntax #'here (caddr t) 0) #'#t)]
          [else (cannot s t)]))

  (define (compared-elements [s datum] [et datum] [x datum] [y datum] [n datum] [same datum]) -> datum
    (let ([i (fresh 'i)] [k (fresh 'same)])
      #`(let ([#,k #,same] [#,i u32 0])
          (while (and #,k (< #,i #,n))
            (set! #,k #,(compared s et #`(@ #,x #,i) #`(@ #,y #,i)))
            (+= #,i 1))
          #,k)))

  (define (compared-type [s datum] [t datum] [x datum] [y datum]) -> datum
    (let ([info (type-info t)])
      (cond [(and (!= info 0) (== (car info) 'struct))
             #`(and #t #,@(for/list ([f (caddr info)]) (compared s (cdr f) #`(-> #,x #,(car f)) #`(-> #,y #,(car f)))))]
            [(and (!= info 0) (== (car info) 'variant)) (compared-cases s (caddr info) x y)]
            [else (cannot s t)])))

  (define (compared-cases [s datum] [cases datum] [x datum] [y datum]) -> datum
    #`(match #,x
        #,@(for/list ([c cases])
             (let ([as (for/list ([f (cdr c)]) (fresh 'a))])
               #`[#,(pattern (car c) as)
                  (match #,y
                    #,@(for/list ([d cases])
                         (let ([bs (for/list ([f (cdr d)]) (fresh 'b))])
                           (if (== (syntax-e (car d)) (syntax-e (car c)))
                               #`[#,(pattern (car d) bs)
                                  (and #t #,@(for/list ([f (cdr c)] [a as] [b bs]) (compared s (cdr f) a b)))]
                               #`[#,(pattern (car d) bs) #f]))))]))))

  (define (pattern [n datum] [xs datum]) -> datum (if (null? xs) n #`(#,n #,@xs)))

  (define (cannot [s datum] [t datum]) -> datum
    (raise-syntax-error 'equal? (datum->string (format "cannot compare ~s" `(,(type-datum t)))) s)))

(define-syntax equal? equal-form)
(define-syntax equal-values? equal-values-form)
