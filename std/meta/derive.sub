;; Deriving definitions from types: a form's types and the types they reach, each given its definitions once.
(require-unqualified compiler/macros)
(require-unqualified "type-info.sub")

(provide derive derive-name derive-want! derive-fresh type-syntax)

(define context datum 0)
(define marker datum 0)
(define wanted datum nil)
(define counter u32 0)

;; derive expands s, (who type ...), to the definitions code gives each type and the types they reach.
(define (derive [s datum] [who datum] [marker-name datum] [code (fn (datum datum) -> datum)]) -> datum
  (syntax-match s
    [(_ (? identifier? t) ...)
     (set! context s)
     (set! marker marker-name)
     (set! wanted nil)
     (for/each ([x t]) (derive-want! x))
     (let ([out nil] [i u32 0])
       (while (< i (length wanted))
         (let* ([u (list-ref wanted i)] [info (type-info u)])
           (when (or (== info 0) (== (car info) 'union)) (raise-syntax-error who "expected a struct or variant type" u))
           (unless (null? (cadddr info)) (raise-syntax-error who "expected a type without parameters" u))
           (set! out (append out (code u info))))
         (+= i 1))
       #`(begin #,@out))]
    [_ (raise-syntax-error who "expected a type" s)]))

;; t's definition named what, as type.what in the form's scope.
(define (derive-name [t datum] [what datum]) -> datum
  (datum->syntax context (string->symbol (format-message "~a.~a" `(,(syntax-e t) ,what))) context))

(define (derive-want! [t datum])
  (unless (or (!= (identifier-binding-kind (derive-name t marker)) 0)
              (ormap (lambda ([u datum]) -> bool (== (syntax-e u) (syntax-e t))) wanted))
    (set! wanted (append wanted (cons t nil)))))

(define (derive-fresh [base datum]) -> datum
  (+= counter 1)
  (datum->syntax #'here (string->symbol (format-message "~a~a" `(,base ,(make-integer counter)))) 0))

;; A type-info type as the type it is.
(define (type-syntax [type datum]) -> datum
  (cond [(symbol? type) (datum->syntax #'here type 0)]
        [(identifier? type) type]
        [(identifier? (car type)) #`(#,(car type) #,@(for/list ([u (cdr type)]) (type-syntax u)))]
        [(== (car type) 'array) #`(array #,(type-syntax (cadr type)) #,(datum->syntax #'here (caddr type) 0))]
        [(== (car type) 'other) (cadr type)]
        [else #`(#,(datum->syntax #'here (car type) 0) #,(type-syntax (cadr type)))]))
