;; Generic types and functions. (define-type (name param ...) form ...) makes name a type function: (name arg ...) is a
;; type wherever a type can be written. A param is a type's name, or [n type] for a count of an integer type, and its arg
;; is a type, or an integer literal or constant. The forms are the type's struct, union, variant or enum form, which has
;; no name, and its functions, whose names start with -. An instance is the forms with each param replaced by its arg.
;; It gets a name of its own, and -push! becomes that name followed by -push!, which std/meta/method's operations call.
;; An instance is one type in every module. (define-type name definer) makes name a type function whose instances the
;; macro definer writes: (definer name instance arg ...) defines the type instance and its functions.
;; (define-generic ((name param ...) [x type] ...) -> result body ...) makes name a generic function: (name arg ...) is
;; the function that the body defines for those args, one function in every module, so ((name arg ...) value ...) calls
;; it.
(provide define-type define-generic)

(begin-for-syntax
  (require-unqualified compiler/macros)
  (require-unqualified "type-info.sub")

  (define (define-type-form [s datum]) -> datum
    (syntax-match s
      [(_ ((? identifier? name) param ...) form ...)
       (for/each ([p param]) (param! 'define-type p))
       (for/each ([f form])
         (unless (or (type-form? f) (function-name f))
           (raise-syntax-error 'define-type "expected a struct, union, variant or enum form without a name, or a function whose name starts with -" f)))
       (unless (== (length (for/list ([f form] #:when (type-form? f)) f)) 1)
         (raise-syntax-error 'define-type "expected one struct, union, variant or enum form without a name" s))
       #`(define-syntax #,name (quote-syntax (substrate-type-function template-instance (#,@param) #,@form)))]
      [(_ (? identifier? name) (? identifier? definer))
       #`(define-syntax #,name (quote-syntax (substrate-type-function #,definer)))]
      [_ (raise-syntax-error 'define-type "expected (define-type (name param ...) form ...) or (define-type name definer)" s)]))

  (define (define-generic-form [s datum]) -> datum
    (syntax-match s
      [(_ (((? identifier? name) param ...) formal ...) rest ...)
       (for/each ([p param]) (param! 'define-generic p))
       #`(define-syntax #,name (quote-syntax (substrate-generic-function generic-instance (#,@param) (#,@formal) #,@rest)))]
      [_ (raise-syntax-error 'define-generic "expected (define-generic ((name param ...) [x type] ...) -> result body ...)" s)]))

  (define (param! [who datum] [p datum])
    (syntax-match p
      [(? identifier? x) (begin)]
      [((? identifier? x) (? identifier? t)) (when (== (memq (syntax-e t) counts) 0) (raise-syntax-error who param-text p))]
      [_ (raise-syntax-error who param-text p)]))

  (define param-text string "expected a type's name, or [name type] for a count of an integer type")

  (define counts datum '(i8 u8 i16 u16 i32 u32 i64 u64))

  (define (type-form? [f datum]) -> bool
    (let ([l (syntax->list f)])
      (and (!= l 0) (pair? l) (identifier? (car l)) (!= (memq (syntax-e (car l)) '(struct union variant enum)) 0)
           (or (null? (cdr l)) (not (identifier? (cadr l)))))))

  ;; A template's function: its name, which starts with -, or 0.
  (define (function-name [f datum]) -> datum
    (syntax-match f
      [('define ((? identifier? name) . _) . _)
       (let ([s (symbol->string (syntax-e name))]) (if (and (> (-> s length) 1) (== (@ s 0) #\-)) (syntax-e name) 0))]
      [_ 0]))

  (define (template-instance-form [s datum]) -> datum
    (syntax-match s
      [(_ f name type ...)
       (syntax-match (syntax-local-value f)
         [(_ _ (param ...) form ...)
          (arguments! f param type)
          (let ([names (param-names param)] [own (for/list ([g form] #:when (!= (function-name g) 0)) (function-name g))])
            #`(begin #,@(for/list ([g form]) (instantiated g names type name own (type-form? g)))))])]))

  (define (generic-instance-form [s datum]) -> datum
    (syntax-match s
      [(_ f name arg ...)
       (syntax-match (syntax-local-value f)
         [(_ _ (param ...) (formal ...) rest ...)
          (arguments! f param arg)
          (let ([names (param-names param)])
            #`(define (#,name #,@(for/list ([x formal]) (instantiated x names arg name nil #f)))
                #,@(for/list ([x rest]) (instantiated x names arg name nil #f))))])]))

  ;; Checks the args against the params: a type for a type's name, and an integer that fits for [n type].
  (define (arguments! [f datum] [params datum] [args datum])
    (unless (== (length params) (length args))
      (raise-syntax-error (syntax-e f) (format-message "takes ~a argument~a, not ~a"
                                                       `(,(make-integer (length params)) ,(if (== (length params) 1) '"" '"s")
                                                         ,(make-integer (length args))))
                          f))
    (for/each ([p params] [a args])
      (let ([n (syntax-e a)])
        (syntax-match p
          [(? identifier? x)
           (when (integer? n) (raise-syntax-error (syntax-e f) (format-message "~a is a type, not ~a" `(,(syntax-e x) ,n)) f))]
          [(x t)
           (unless (integer? n)
             (raise-syntax-error (syntax-e f) (format-message "~a is a ~a, not ~s" `(,(syntax-e x) ,(syntax-e t) ,(type-datum a))) f))
           (unless (fits? n (syntax-e t))
             (raise-syntax-error (syntax-e f) (format-message "integer ~a does not fit in ~a" `(,n ,(syntax-e t))) f))]))))

  (define (fits? [n datum] [t datum]) -> bool
    (let ([v (integer-value n)] [m (cast u64 (integer-value n))])
      (if (integer-negative? n)
          (case t [('i8) (>= v -128)] [('i16) (>= v -32768)] [('i32) (>= v -2147483648)] [('i64) #t] [else #f])
          (case t
            [('u8) (<= m 255)] [('i8) (<= m 127)] [('u16) (<= m 65535)] [('i16) (<= m 32767)]
            [('u32) (<= m 4294967295)] [('i32) (<= m 2147483647)] [('i64) (<= m 9223372036854775807)]
            [else #t]))))

  (define (param-names [params datum]) -> datum (for/list ([p params]) (if (identifier? p) p (car (syntax->list p)))))

  (define (instantiated [x datum] [params datum] [types datum] [name datum] [own datum] [named bool]) -> datum
    (if (identifier? x)
        (let ([i (position-of (syntax-e x) params)])
          (cond [(>= i 0) (list-ref types i)]
                [(!= (memq (syntax-e x) own) 0) (method-name name (syntax-e x))]
                [else x]))
        (let ([l (syntax->list x)])
          (if (or (== l 0) (null? l))
              x
              (let ([parts (for/list ([y l]) (instantiated y params types name own #f))])
                (datum->syntax x (if named (cons (car parts) (cons name (cdr parts))) parts) x))))))

  (define (position-of [s datum] [ids datum]) -> i32
    (let ([i 0] [l ids])
      (while (pair? l)
        (when (== (syntax-e (car l)) s) (return i))
        (+= i 1)
        (set! l (cdr l)))
      -1)))

(define-syntax define-type define-type-form)
(define-syntax define-generic define-generic-form)
(define-syntax template-instance template-instance-form)
(define-syntax generic-instance generic-instance-form)
