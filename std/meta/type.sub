;; Generic types. (define-type (name param ...) form ...) makes name a type function: (name type ...) is a type
;; wherever a type can be written. The forms are the type's struct or union form, which has no name, and its functions,
;; whose names start with -. An instance is the forms with each param replaced by its type. It gets a name of its own,
;; and -push! becomes that name followed by -push!, which std/meta/method's operations call. An instance is one type in
;; every module. (define-type name definer) makes name a type function whose instances the macro definer writes:
;; (definer name instance type ...) defines the type instance and its functions.
(provide define-type)

(begin-for-syntax
  (require-unqualified compiler/macros)
  (require-unqualified "type-info.sub")

  (define (define-type-form [s datum]) -> datum
    (syntax-match s
      [(_ ((? identifier? name) (? identifier? param) ...) form ...)
       (for/each ([f form])
         (unless (or (type-form? f) (function-name f))
           (raise-syntax-error 'define-type "expected a struct or union form without a name, or a function whose name starts with -" f)))
       (unless (== (length (for/list ([f form] #:when (type-form? f)) f)) 1)
         (raise-syntax-error 'define-type "expected one struct or union form without a name" s))
       #`(define-syntax #,name (quote-syntax (substrate-type-function template-instance (#,@param) #,@form)))]
      [(_ (? identifier? name) (? identifier? definer))
       #`(define-syntax #,name (quote-syntax (substrate-type-function #,definer)))]
      [_ (raise-syntax-error 'define-type "expected (define-type (name param ...) form ...) or (define-type name definer)" s)]))

  (define (type-form? [f datum]) -> bool
    (let ([l (syntax->list f)])
      (and (!= l 0) (pair? l) (identifier? (car l)) (!= (memq (syntax-e (car l)) '(struct union)) 0)
           (or (null? (cdr l)) (not (identifier? (cadr l)))))))

  ;; A template's function: its name, which starts with -, or 0.
  (define (function-name [f datum]) -> datum
    (syntax-match f
      [('define ((? identifier? name) . _) . _)
       (let ([s (symbol->string (syntax-e name))]) (if (and (> (-> s length) 1) (== (@ s 0) #\-)) (syntax-e name) 0))]
      [_ 0]))

  (define (template-instance-form [s datum]) -> datum
    (syntax-match s
      [(_ f name type ...)
       (syntax-match (syntax-local-value f)
         [(_ _ (param ...) form ...)
          (unless (== (length param) (length type))
            (raise-syntax-error (syntax-e f) (format-message "takes ~a type~a, not ~a"
                                                             `(,(make-integer (length param)) ,(if (== (length param) 1) '"" '"s")
                                                               ,(make-integer (length type))))
                                f))
          (let ([own (for/list ([g form] #:when (!= (function-name g) 0)) (function-name g))])
            #`(begin #,@(for/list ([g form]) (instantiated g param type name own (type-form? g)))))])]))

  (define (instantiated [x datum] [params datum] [types datum] [name datum] [own datum] [named bool]) -> datum
    (if (identifier? x)
        (let ([i (position-of (syntax-e x) params)])
          (cond [(>= i 0) (list-ref types i)]
                [(!= (memq (syntax-e x) own) 0) (method-name name (syntax-e x))]
                [else x]))
        (let ([l (syntax->list x)])
          (if (or (== l 0) (null? l))
              x
              (let ([parts (for/list ([y l]) (instantiated y params types name own #f))])
                (datum->syntax x (if named (cons (car parts) (cons name (cdr parts))) parts) x))))))

  (define (position-of [s datum] [ids datum]) -> i32
    (let ([i 0] [l ids])
      (while (pair? l)
        (when (== (syntax-e (car l)) s) (return i))
        (+= i 1)
        (set! l (cdr l)))
      -1)))

(define-syntax define-type define-type-form)
(define-syntax template-instance template-instance-form)
