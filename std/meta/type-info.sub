;; Types as data at compile time, for macros that write code from a type's fields.
(require-unqualified compiler/macros)

(provide type-info variable-type type-layout type-datum type-syntax instance-origin dotted undotted case-code)

;; type-info gives (kind name items), where kind is struct, union, variant or enum. It gives 0 when t names none of
;; these. A struct's or union's items are (field . type), a variant's items are (case (field . type) ...), and an enum's
;; items are (case). A type is i8 to u64, f32, f64, bool or string, (ptr type), (slice type), (array type n), a
;; struct's, union's, variant's or enum's identifier, or (other type).
(define (type-info [t datum]) -> datum
  (syntax-match (binding-of t)
    [('substrate-struct name (item ...) kind . _)
     (let ([k (syntax-e kind)])
       `(,k ,name ,(for/list ([i item]) (if (!= (memq k '(variant enum)) 0) (case-info i) (field-info i)))))]
    [('substrate-typedef u) (let ([d (parsed-type (syntax->datum u))]) (if (identifier? d) (type-info d) 0))]
    [_ 0]))

(define (binding-of [t datum]) -> datum
  (if (and (identifier? t) (== (identifier-binding-kind t) 'compile-time-value)) (syntax-local-value t) 0))

(define (case-info [c datum]) -> datum
  (let ([l (syntax->list c)]) (cons (car l) (for/list ([f (cdr l)]) (field-info f)))))

(define (field-info [f datum]) -> datum
  (let ([l (syntax->list f)]) (cons (car l) (type-of (cadr l)))))

(define scalars datum '(i8 u8 i16 u16 i32 u32 i64 u64 f32 f64 bool string))

(define (type-of [t datum]) -> datum
  (syntax-match t
    [(? identifier? x)
     (if (!= (memq (syntax-e x) scalars) 0)
         (syntax-e x)
         (syntax-match (binding-of x)
           [('substrate-struct . _) x]
           [('substrate-typedef u) (parsed-type (syntax->datum u))]
           [_ `(other ,t)]))]
    [('ptr u) `(ptr ,(type-of u))]
    [('slice u) `(slice ,(type-of u))]
    [('array u n) `(array ,(type-of u) ,(count-of n))]
    [('quote u) (parsed-type (syntax->datum u))]
    [_ `(other ,t)]))

(define (count-of [n datum]) -> datum
  (syntax-match (if (and (identifier? n) (== (identifier-binding-kind n) 'macro)) (syntax-local-value n) 0)
    [('#%form 'constant ('cast _ c)) (syntax-e c)]
    [_ (syntax-e n)]))

(define (variable-type [x datum]) -> datum
  (let ([t (syntax-local-type x)]) (if (== t 0) 0 (parsed-type t))))

;; The size, alignment and field offsets of the type t, as (size alignment offsets). For a struct or union, offsets
;; is ((field . offset) ...). For a variant, it is ((case (field . offset) ...) ...). For any other type, it is ().
(define (type-layout [t datum]) -> datum
  (let ([d (if (and (pair? t) (== (car t) 'other)) (cadr t) t)])
    (syntax-local-layout (if (syntax? d) d (datum->syntax #'here d 0)))))

(define (type-datum [t datum]) -> datum
  (let ([d (syntax->datum (datum->syntax #'here t 0))]) (written-type (if (and (pair? d) (== (car d) 'other)) (cadr d) d))))

(define (written-type [d datum]) -> datum
  (cond [(pair? d) (cons (written-type (car d)) (written-type (cdr d)))]
        [(and (symbol? d) (== (@ (symbol->string d) 0) #\()) (unqualified d)]
        [else d]))

(define (unqualified [name datum]) -> datum
  (let ([s (symbol->string name)] [b (make-buffer)] [start u32 0] [out datum 0])
    (for ([i u32 0]) (< i (-> s length)) (+= i 1)
      (let ([c (@ s i)])
        (if (== c #\:)
            (set! (-> b length) start)
            (begin
              (buffer-add-byte! (& b) c)
              (when (or (== c #\() (== c #\space)) (set! start (-> b length)))))))
    (set! out (string->symbol (buffer-string (& b))))
    (buffer-free! (& b))
    out))

(define (dotted [n datum]) -> datum
  (datum->syntax n (string->symbol (format-message ".~a" `(,(syntax-e n)))) n))

(define (undotted [s datum]) -> datum
  (let ([t (symbol->string s)]) (if (and (> (-> t length) 1) (== (@ t 0) #\.)) (string->symbol (slice t 1)) 0)))

(define (case-code [c datum] [xs datum]) -> datum (if (null? xs) (dotted c) #`(#,(dotted c) #,@xs)))

;; A type in type-info's form, turned into the type's syntax.
(define (type-syntax [type datum]) -> datum
  (cond [(symbol? type) (datum->syntax #'here type 0)]
        [(identifier? type) type]
        [(== (car type) 'array) #`(array #,(type-syntax (cadr type)) #,(datum->syntax #'here (caddr type) 0))]
        [(== (car type) 'other) (cadr type)]
        [else #`(#,(datum->syntax #'here (car type) 0) #,(type-syntax (cadr type)))]))

;; The generic type and arguments that the type named t is an instance of, as (generic arg ...), or 0. std/meta/generic
;; records them as a fact about each instance.
(define (instance-origin [t datum]) -> datum
  (let ([found datum 0])
    (for/each ([f (syntax-local-facts t)])
      (let ([l (if (syntax? (caddr f)) (syntax->list (caddr f)) 0)])
        (when (and (!= l 0) (pair? l) (identifier? (car l)) (== (syntax-e (car l)) 'instance-of)) (set! found (cdr l)))))
    found))

;; A type as the checker holds it.
(define (parsed-type [d datum]) -> datum
  (cond [(and (symbol? d) (!= (memq d scalars) 0)) d]
        [(and (pair? d) (!= (memq (car d) '(ptr slice)) 0)) `(,(car d) ,(parsed-type (cadr d)))]
        [(and (pair? d) (== (car d) 'array)) `(array ,(parsed-type (cadr d)) ,(caddr d))]
        [(and (pair? d) (!= (memq (car d) '(struct enum)) 0)) (name-identifier (cadr d))]
        [else `(other ,d)]))
