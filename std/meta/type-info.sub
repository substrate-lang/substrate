;; Types as data at compile time, for macros that write code from a type's fields.
(require-unqualified compiler/macros)

(provide type-info variable-type type-datum)

;; (kind name items parameters), kind struct, union or variant, or 0 when t names none. A struct's or union's items are
;; (field . type), a variant's (case (field . type) ...). A type is i8 to u64, f32, f64, bool or string, (ptr type),
;; (slice type), (array type n), a struct's, union's or variant's identifier, (identifier type ...) for one with
;; parameters, or (other type). For (identifier type ...), the items have those types in place of the parameters, and the
;; parameters are ().
(define (type-info [t datum]) -> datum
  (let ([instance (pair? t)])
    (syntax-match (binding-of (if instance (car t) t))
      [('substrate-struct name (item ...) kind (p ...) . _)
       (let ([k (syntax-e kind)] [env (if instance (for/list ([q p] [a (cdr t)]) (cons (syntax-e q) a)) nil)])
         `(,k ,name ,(for/list ([i item]) (if (== k 'variant) (case-info i env) (field-info i env)))
           ,(if instance nil p)))]
      [('substrate-typedef u)
       (let ([d (parsed-type (syntax->datum u))])
         (if (or (identifier? d) (and (pair? d) (identifier? (car d)))) (type-info d) 0))]
      [_ 0])))

(define (binding-of [t datum]) -> datum
  (if (and (identifier? t) (== (identifier-binding-kind t) 'compile-time-value)) (syntax-local-value t) 0))

(define (case-info [c datum] [env datum]) -> datum
  (let ([l (syntax->list c)]) (cons (car l) (for/list ([f (cdr l)]) (field-info f env)))))

(define (field-info [f datum] [env datum]) -> datum
  (let ([l (syntax->list f)]) (cons (car l) (type-of (cadr l) env))))

(define scalars datum '(i8 u8 i16 u16 i32 u32 i64 u64 f32 f64 bool string))

(define (type-of [t datum] [env datum]) -> datum
  (syntax-match t
    [(? identifier? x)
     (cond [(!= (memq (syntax-e x) scalars) 0) (syntax-e x)]
           [(!= (assq (syntax-e x) env) 0) (cdr (assq (syntax-e x) env))]
           [else (syntax-match (binding-of x)
                   [('substrate-struct _ _ _ () . _) x]
                   [('substrate-typedef u) (parsed-type (syntax->datum u))]
                   [_ `(other ,t)])])]
    [('ptr u) `(ptr ,(type-of u env))]
    [('slice u) `(slice ,(type-of u env))]
    [('array u n) `(array ,(type-of u env) ,(syntax-e n))]
    [('quote u) (parsed-type (syntax->datum u))]
    [((? identifier? h) a ...)
     (syntax-match (binding-of h)
       [('substrate-struct _ _ _ (p ...) . _)
        (if (and (pair? p) (== (length p) (length a))) `(,h ,@(for/list ([u a]) (type-of u env))) `(other ,t))]
       [_ `(other ,t)])]
    [_ `(other ,t)]))

(define (variable-type [x datum]) -> datum
  (let ([t (syntax-local-type x)]) (if (== t 0) 0 (parsed-type t))))

(define (type-datum [t datum]) -> datum
  (let ([d (syntax->datum (datum->syntax #'here t 0))]) (if (and (pair? d) (== (car d) 'other)) (cadr d) d)))

;; A type as the checker holds it.
(define (parsed-type [d datum]) -> datum
  (cond [(and (symbol? d) (!= (memq d scalars) 0)) d]
        [(and (pair? d) (!= (memq (car d) '(ptr slice)) 0)) `(,(car d) ,(parsed-type (cadr d)))]
        [(and (pair? d) (== (car d) 'array)) `(array ,(parsed-type (cadr d)) ,(caddr d))]
        [(and (pair? d) (memq (car d) '(struct enum)) (null? (cdddr d))) (name-identifier (cadr d))]
        [(and (pair? d) (== (car d) 'struct)) `(,(name-identifier (cadr d)) ,@(for/list ([a (cadddr d)]) (parsed-type a)))]
        [else `(other ,d)]))
