;; Operations, whose function the type of their first argument picks, as a method call's does. (define-methods operation
;; ...) defines each operation. (operation x arg ...) calls the method that x's type has for the operation, for x a
;; pointer to a named type. (define-method ((operation param ...) [x (ptr type)] ...) body ...) gives type a method for
;; the operation, defined as a generic function of std/meta/generic, and (define-method (operation [x (ptr type)] ...)
;; body ...) gives it one defined as a function. type is a struct, union, variant or enum, or a generic type with its
;; params, as in (ptr (vector T)), for a method of each of its instances. A method is a fact about its type, so a module
;; can give methods to another module's types, and every module that requires it sees them.
(require-unqualified "generic.sub")

(provide define-methods define-method)

(begin-for-syntax
  (require-unqualified compiler/macros)
  (require-unqualified "type-info.sub")

  (define (define-methods-form [s datum]) -> datum
    (syntax-match s
      [(_ (? identifier? op) ...) #`(begin #,@(for/list ([o op]) #`(define-syntax #,o operation-form #'#,o)))]
      [_ (raise-syntax-error 'define-methods "expected (define-methods operation ...)" s)]))

  (define (operation-form [op datum] [s datum]) -> datum
    (syntax-match s
      [(_ x arg ...)
       (if (and (identifier? x) (!= (variable-type x) 0))
           (operation-call op s x arg)
           #`(let ([the-receiver #,x]) (operation-called #,op #,s the-receiver #,@arg)))]
      [_ (raise-syntax-error 0 "expected a pointer to a named type" s)]))

  (define (operation-called-form [s datum]) -> datum
    (syntax-match s [(_ op form x arg ...) (operation-call op form x arg)]))

  (define (operation-call [op datum] [form datum] [x datum] [args datum]) -> datum
    (let ([t (variable-type x)] [name (syntax-e op)])
      (unless (and (pair? t) (== (car t) 'ptr) (identifier? (cadr t)))
        (raise-syntax-error name (format-message "expected a pointer to a named type, not ~s" `(,(type-datum t))) form))
      (let ([m (method-of op (cadr t))])
        (when (== m 0) (raise-syntax-error name (format-message "~a has no method for ~a" `(,(type-datum (cadr t)) ,name)) form))
        #`(#,m #,x #,@args))))

  ;; The method for the operation op on the type named t, or on the generic type that t is an instance of. It is 0 when
  ;; there is none.
  (define (method-of [op datum] [t datum]) -> datum
    (let ([m (method-in op t)] [o datum 0])
      (when (== m 0)
        (set! o (instance-origin t))
        (unless (== o 0) (set! m (method-in op (car o)))))
      m))

  (define (method-in [op datum] [t datum]) -> datum
    (let ([found datum 0])
      (for/each ([f (syntax-local-facts t)])
        (let ([l (if (syntax? (caddr f)) (syntax->list (caddr f)) 0)])
          (when (and (!= l 0) (== (length l) 3) (identifier? (car l)) (== (syntax-e (car l)) 'method)
                     (free-identifier=? (cadr l) op))
            (set! found (caddr l)))))
      found))

  (define (define-method-form [s datum]) -> datum
    (syntax-match s
      [(_ (((? identifier? op) param ...) x0 x ...) rest ...)
       (let* ([t (owner x0)] [f (method-name op t)])
         #`(begin (define-generic ((#,f #,@param) #,x0 #,@x) #,@rest)
                  (#%fact #,t #'(method #,op #,f))))]
      [(_ ((? identifier? op) x0 x ...) rest ...)
       (let* ([t (owner x0)] [f (method-name op t)])
         #`(begin (define (#,f #,x0 #,@x) #,@rest)
                  (#%fact #,t #'(method #,op #,f))))]
      [_ (raise-syntax-error
          'define-method
          "expected (define-method ((operation param ...) [x (ptr type)] ...) body ...) or (define-method (operation [x (ptr type)] ...) body ...)"
          s)]))

  ;; A method's own name, as in vector.vector-push!, which only the method's fact refers to.
  (define (method-name [op datum] [t datum]) -> datum
    (syntax-local-introduce
     (datum->syntax op (string->symbol (format-message "~a.~a" `(,(syntax-e t) ,(syntax-e op)))) op)))

  ;; The type, or the generic type, that a method's first param points to. A typedef gives the type it names.
  (define (owner [x datum]) -> datum
    (syntax-match x
      [(_ ('ptr (? identifier? t)))
       (syntax-match (if (== (identifier-binding-kind t) 'compile-time-value) (syntax-local-value t) 0)
         [('substrate-typedef u)
          (let ([d (syntax->datum u)])
            (if (and (pair? d) (!= (memq (car d) '(struct enum)) 0)) (name-identifier (cadr d)) (owner-error x)))]
         [_ t])]
      [(_ ('ptr ((? identifier? g) _ ...))) g]
      [_ (owner-error x)]))

  (define (owner-error [x datum]) -> datum
    (raise-syntax-error 'define-method "expected [x (ptr type)] first, for a named type or a generic type with its params" x)))

(define-syntax define-methods define-methods-form)
(define-syntax define-method define-method-form)
(define-syntax operation-called operation-called-form)

;; doc-forms tells sub doc which of these forms define what (std/doc/doc.sub).
(define-syntax doc-forms
  (quote-syntax
   ((function (define-method ((NAME PARAM ...) PARAM ...) -> RESULT _ ...))
    (function (define-method ((NAME PARAM ...) PARAM ...) _ ...))
    (function (define-method (NAME PARAM ...) -> RESULT _ ...))
    (function (define-method (NAME PARAM ...) _ ...)))))
