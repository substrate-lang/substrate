;; Operations that pick their function by the type of their first argument, as method calls do. (method form suffix x
;; arg ...) calls the function that x's type and the suffix name, for x a pointer to a named type: with suffix -push!
;; and x a (ptr points), points-push!. form is the operation's own form, for errors.
(provide method)

(begin-for-syntax
  (require-unqualified compiler/macros)
  (require-unqualified "type-info.sub")

  (define (method-form [s datum]) -> datum
    (syntax-match s
      [(_ form suffix x arg ...) #`(let ([the-receiver #,x]) (method-call #,form #,suffix the-receiver #,@arg))]))

  (define (method-call-form [s datum]) -> datum
    (syntax-match s
      [(_ form suffix x arg ...)
       (let ([t (variable-type x)] [op (syntax-e (car (syntax->list form)))])
         (unless (and (pair? t) (== (car t) 'ptr) (identifier? (cadr t)))
           (raise-syntax-error op (datum->string (format "expected a pointer to a named type, not ~s" `(,(type-datum t))))
                               form))
         (let ([name (cadr t)])
           #`(#,(datum->syntax name (string->symbol (format-message "~a~a" `(,(syntax-e name) ,(syntax-e suffix)))) name)
              #,x #,@arg)))])))

(define-syntax method method-form)
(define-syntax method-call method-call-form)
