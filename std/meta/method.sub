;; Operations that pick their function by the type of their first argument, as method calls do. (method form suffix x
;; arg ...) calls the function whose name is x's type followed by the suffix, for x a pointer to a named type. With
;; suffix -push! and x a (ptr points), it calls points-push!. form is the operation's own form, for errors.
;; (define-methods [operation suffix] ...) defines each operation as a macro that calls method with its suffix.
;; method-name in std/meta/type-info gives the function's name, for macros that define the functions.
(provide method define-methods)

(begin-for-syntax
  (require-unqualified compiler/macros)
  (require-unqualified "type-info.sub")

  (define (method-form [s datum]) -> datum
    (syntax-match s
      [(_ form suffix x arg ...) #`(let ([the-receiver #,x]) (method-call #,form #,suffix the-receiver #,@arg))]))

  (define (method-call-form [s datum]) -> datum
    (syntax-match s
      [(_ form suffix x arg ...)
       (let ([t (variable-type x)] [op (syntax-e (car (syntax->list form)))])
         (unless (and (pair? t) (== (car t) 'ptr) (identifier? (cadr t)))
           (raise-syntax-error op (datum->string (format "expected a pointer to a named type, not ~s" `(,(type-datum t))))
                               form))
         (let* ([name (method-name (cadr t) (syntax-e suffix))] [f (datum->syntax name (syntax-e name) form)])
           (when (== (identifier-binding-kind f) '#f)
             (raise-syntax-error op (format-message "~a has no ~a" `(,(syntax-e (cadr t)) ,(syntax-e f))) form))
           #`(#,f #,x #,@arg)))]))

  (define (operation-form [suffix datum] [s datum]) -> datum
    (syntax-match s
      [(_ x arg ...) #`(method #,s #,(datum->syntax s suffix s) #,x #,@arg)]
      [_ (raise-syntax-error 0 "expected a pointer to a named type" s)]))

  (define (define-methods-form [s datum]) -> datum
    (syntax-match s
      [(_ ((? identifier? op) (? identifier? suffix)) ...)
       #`(begin #,@(for/list ([o op] [x suffix]) #`(define-syntax #,o operation-form '#,x)))]
      [_ (raise-syntax-error 'define-methods "expected (define-methods [operation suffix] ...)" s)])))

(define-syntax method method-form)
(define-syntax method-call method-call-form)
(define-syntax define-methods define-methods-form)
