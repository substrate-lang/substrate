;; Drawing on a <canvas> element: rectangles, paths, circles, text, images and transforms. The calls write into the
;; page's patches (patches.sub) between canvas-begin! and canvas-end!, and a call made outside them draws nothing.
(require-unqualified std/web/patches)

(provide canvas-begin! canvas-end! canvas-drawing?
         canvas-fill-style! canvas-stroke-style! canvas-line-width! canvas-global-alpha!
         canvas-fill-rect! canvas-stroke-rect! canvas-clear-rect!
         canvas-begin-path! canvas-move-to! canvas-line-to! canvas-arc! canvas-close-path! canvas-fill-path!
         canvas-stroke-path! canvas-fill-circle! canvas-draw-line!
         canvas-set-font! canvas-text-align! canvas-text-baseline! canvas-fill-text!
         canvas-load-image! canvas-draw-sprite!
         canvas-translate! canvas-rotate! canvas-scale! canvas-save-state! canvas-restore-state!)

(define drawing u32 0)
(define begun u32 0)

(define (canvas-begin! [node u32])
  (words! (slice (array-of u32 13 node 0)))
  (set! drawing (-> (dom-patches) length))
  (set! begun (dom-flushes)))

(define (canvas-end!)
  (when (canvas-drawing?)
    (let* ([b (dom-patches)] [count (cast (ptr u32) (+ (-> b bytes) (- drawing 4)))])
      (set! (@ count) (/ (- (-> b length) drawing) 4))))
  (set! drawing 0))

(define (canvas-drawing?) -> bool (and (!= drawing 0) (== begun (dom-flushes))))

(define (command! [op u32]) -> bool
  (if (canvas-drawing?)
      (begin
        (words! (slice (array-of u32 op)))
        #t)
      #f))

(define (words! [w (slice u32)]) (buffer-add! (dom-patches) (slice (cast (ptr u8) (-> w items)) (* 4 (-> w length)))))

(define (numbers! [v (slice f32)]) (buffer-add! (dom-patches) (slice (cast (ptr u8) (-> v items)) (* 4 (-> v length)))))

(define (text! [s string])
  (let ([copy (cast (ptr u8) (dom-frame-alloc (-> s length)))])
    (memcpy copy (-> s bytes) (-> s length))
    (words! (slice (array-of u32 (cast u32 copy) (-> s length))))))

(define (plain! [op u32]) (command! op))
(define (one! [op u32] [a f64]) (when (command! op) (numbers! (slice (array-of f32 (cast f32 a))))))
(define (two! [op u32] [a f64] [b f64]) (when (command! op) (numbers! (slice (array-of f32 (cast f32 a) (cast f32 b))))))
(define (four! [op u32] [a f64] [b f64] [c f64] [d f64])
  (when (command! op) (numbers! (slice (array-of f32 (cast f32 a) (cast f32 b) (cast f32 c) (cast f32 d))))))
(define (named! [op u32] [s string]) (when (command! op) (text! s)))

(define (canvas-fill-style! [color string]) (named! 2 color))
(define (canvas-stroke-style! [color string]) (named! 3 color))
(define (canvas-line-width! [w f64]) (one! 4 w))
(define (canvas-global-alpha! [a f64]) (one! 23 a))

(define (canvas-fill-rect! [x f64] [y f64] [w f64] [h f64]) (four! 5 x y w h))
(define (canvas-stroke-rect! [x f64] [y f64] [w f64] [h f64]) (four! 6 x y w h))
(define (canvas-clear-rect! [x f64] [y f64] [w f64] [h f64]) (four! 1 x y w h))

(define (canvas-begin-path!) (plain! 7))
(define (canvas-move-to! [x f64] [y f64]) (two! 8 x y))
(define (canvas-line-to! [x f64] [y f64]) (two! 9 x y))
(define (canvas-arc! [x f64] [y f64] [radius f64] [start f64] [end f64])
  (when (command! 10)
    (numbers! (slice (array-of f32 (cast f32 x) (cast f32 y) (cast f32 radius) (cast f32 start) (cast f32 end))))))
(define (canvas-close-path!) (plain! 11))
(define (canvas-fill-path!) (plain! 12))
(define (canvas-stroke-path!) (plain! 13))

(define (canvas-fill-circle! [x f64] [y f64] [radius f64])
  (canvas-begin-path!)
  (canvas-arc! x y radius 0.0 6.283185307179586)
  (canvas-fill-path!))

(define (canvas-draw-line! [x1 f64] [y1 f64] [x2 f64] [y2 f64])
  (canvas-begin-path!)
  (canvas-move-to! x1 y1)
  (canvas-line-to! x2 y2)
  (canvas-stroke-path!))

(define (canvas-set-font! [font string]) (named! 14 font))
(define (canvas-text-align! [align string]) (named! 16 align))
(define (canvas-text-baseline! [baseline string]) (named! 17 baseline))
(define (canvas-fill-text! [text string] [x f64] [y f64])
  (when (command! 15)
    (text! text)
    (numbers! (slice (array-of f32 (cast f32 x) (cast f32 y))))))

(define next-image u32 1)

(define (canvas-load-image! [path string]) -> u32
  (if (canvas-drawing?)
      0
      (let ([id next-image])
        (+= next-image 1)
        (dom-image! id path)
        id)))

(define (canvas-draw-sprite! [image u32] [cell-width f64] [cell-height f64] [frame u32] [x f64] [y f64] [flip bool])
  (when (command! 24)
    (words! (slice (array-of u32 image frame (if flip 1 0))))
    (numbers! (slice (array-of f32 (cast f32 cell-width) (cast f32 cell-height) (cast f32 x) (cast f32 y))))))

(define (canvas-translate! [x f64] [y f64]) (two! 20 x y))
(define (canvas-rotate! [angle f64]) (one! 21 angle))
(define (canvas-scale! [x f64] [y f64]) (two! 22 x y))
(define (canvas-save-state!) (plain! 18))
(define (canvas-restore-state!) (plain! 19))
