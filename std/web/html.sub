;; HTML text: characters escaped for a page's text, and for an attribute's value too when attribute is set.
(provide html-escape!)

(define (html-escape! [b (ptr buffer)] [s string] [attribute bool])
  (for ([i u32 0]) (< i (-> s length)) (+= i 1)
    (let ([c (@ s i)])
      (cond [(== c #\&) (buffer-add-string! b "&amp;")]
            [(== c #\<) (buffer-add-string! b "&lt;")]
            [(== c #\>) (buffer-add-string! b "&gt;")]
            [(and attribute (== c 34)) (buffer-add-string! b "&quot;")]
            [else (buffer-add-byte! b (cast i32 c))]))))
