;; Packs of files for a page's host, which subhost-web.mjs unpacks: each file's name and bytes follow their lengths as
;; little-endian u32s, in name order.
(require-unqualified fs host/fs)

(provide pack-files)

;; pack-files packs the files under the paths, given from dir, into out; when it fails, err says why.
(define (pack-files [dir string] [paths (slice string)] [out string] [err (ptr buffer)]) -> bool
  (let ([names (make-buffer)] [pack (make-buffer)] [ok #t])
    (for ([i u32 0]) (and ok (< i (-> paths length))) (+= i 1)
      (set! ok (add! dir (string-copy (@ paths i)) (& names) err)))
    (let ([ns (cast (ptr string) (-> names bytes))] [n (/ (-> names length) (sizeof string))])
      (for ([k u32 0]) (and ok (< k n)) (+= k 1)
        (let* ([name (@ ns k)] [full (joined dir name)] [why string] [bytes (slice u8)])
          (if (< (fs-read-file full (& bytes) (& why)) 0)
              (set! ok (failed! err "cannot read " why))
              (begin
                (buffer-add-u32! (& pack) (-> name length))
                (buffer-add-string! (& pack) name)
                (buffer-add-u32! (& pack) (-> bytes length))
                (buffer-add! (& pack) bytes)
                (free (-> bytes items))))
          (free (-> full bytes))))
      (when ok
        (let ([why string])
          (when (< (fs-write-file out (buffer-bytes (& pack)) (& why)) 0) (set! ok (failed! err "cannot write " why)))))
      (for ([k u32 0]) (< k n) (+= k 1) (free (-> (@ ns k) bytes))))
    (buffer-free! (& names))
    (buffer-free! (& pack))
    ok))

(define (joined [dir string] [name string]) -> string
  (let ([b (make-buffer)])
    (unless (== dir ".")
      (buffer-add-string! (& b) dir)
      (buffer-add-byte! (& b) 47))
    (buffer-add-string! (& b) name)
    (buffer-string (& b))))

(define (failed! [err (ptr buffer)] [what string] [why string]) -> bool
  (buffer-add-string! err what)
  (buffer-add-string! err why)
  (free (-> why bytes))
  #f)

;; add! adds name, owned here, or the files under it, to names in name order.
(define (add! [dir string] [name string] [names (ptr buffer)] [err (ptr buffer)]) -> bool
  (let* ([full (joined dir name)] [why string] [info fs-info] [ok #t])
    (cond [(< (fs-stat full (& info) (& why)) 0)
           (set! ok (failed! err "cannot read " why))
           (free (-> name bytes))]
          [(== (-> info kind) fs-directory)
           (let ([listed (slice string)])
             (if (< (fs-list full (& listed) (& why)) 0)
                 (set! ok (failed! err "cannot read " why))
                 (begin
                   (for ([j u32 0]) (and ok (< j (-> listed length))) (+= j 1)
                     (set! ok (add! dir (joined name (@ listed j)) names err)))
                   (free (-> listed items))))
             (free (-> name bytes)))]
          [else
           (let* ([n (/ (-> names length) (sizeof string))] [i n])
             (buffer-add! names (slice (cast (ptr u8) (& name)) (sizeof string)))
             (let ([ns (cast (ptr string) (-> names bytes))])
               (while (and (> i 0) (< name (@ ns (- i 1))))
                 (set! (@ ns i) (@ ns (- i 1)))
                 (-= i 1))
               (set! (@ ns i) name)))])
    (free (-> full bytes))
    ok))
