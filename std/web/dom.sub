;; The document: the host module "dom" and the patches that patches.sub writes. dom-flush! sends the patches. A read
;; takes a node and a name that walks from it through the document's objects: a property's name, or names joined by
;; dots. dom-event stands for the current event. A read gives a number, with true as 1, or text, and the text lasts
;; until the patches are sent. An empty name reads the value that the node number holds, such as a call's result. dom-is
;; says whether the name leads to another node: (dom-is node dom-document "activeElement") says whether the node has the
;; focus. A name means the browser's own property, even where a form's control or a document's element has that name.
;; dom-call-now! calls a method at once, so the call sees the document as reads do, without the patches not yet sent.
;; dom-call-number and dom-call-text do the same and give the call's result. dom-call-node gives a fresh node number
;; that holds the result, and dom-read-node gives a fresh number that holds what a name leads to, such as the event's
;; target. dom-forget-node! forgets such a number. dom-element gives the number of the element with an id, or 0.
;; dom-form-data takes a name that leads to a form, and it gives the query that the form submits, as the browser
;; writes it for a GET. dom-form-data-with adds the submitter that a node number holds, such as the submitter of a
;; submit event.
(require-unqualified host-dom host/web/dom)
(require-unqualified patches "patches.sub")

(provide (all-from-out host-dom) (except-out (all-from-out patches) dom-call-into! dom-read-into!) dom-flush!
         dom-read-number dom-read-text dom-is dom-call-now! dom-call-number dom-call-text dom-call-node dom-read-node
         dom-element dom-form-data dom-form-data-with)

(import read-number "dom" "read_number" (i32 i32 i32 -> f64))
(import read-text "dom" "read_text" (i32 i32 i32 i32 -> i32))
(import is "dom" "is" (i32 i32 i32 i32 -> i32))
(import form-data "dom" "form_data" (i32 i32 i32 i32 i32 -> i32))

(define (dom-flush!)
  (let* ([b (dom-patches)] [n (-> b length)])
    (when (> n 0)
      (set! (-> b length) 0)
      (dom-apply (cast i32 (-> b bytes)) n))
    (dom-discard!)))

(define (kept-text [p (ptr u8)] [n u32]) -> string
  (let ([copy (cast (ptr u8) (dom-frame-alloc n))])
    (memcpy copy p n)
    (free p)
    (cast string (slice copy n))))

(define (dom-read-number [node u32] [path string]) -> f64
  (read-number (cast i32 node) (cast i32 (-> path bytes)) (cast i32 (-> path length))))

(define (dom-read-text [node u32] [path string]) -> string
  (let* ([n u32 0]
         [p (read-text (cast i32 node) (cast i32 (-> path bytes)) (cast i32 (-> path length)) (cast i32 (& n)))])
    (kept-text (cast (ptr u8) p) n)))

(define (dom-is [node u32] [from u32] [path string]) -> bool
  (!= (is (cast i32 node) (cast i32 from) (cast i32 (-> path bytes)) (cast i32 (-> path length))) 0))

;; ---- at once ----

(define (at-once! [mark u32])
  (let ([b (dom-patches)])
    (dom-apply (cast i32 (+ (-> b bytes) mark)) (- (-> b length) mark))
    (set! (-> b length) mark)))

(define (dom-call-now! [node u32] [method string] [arguments (slice dom-value)])
  (let ([mark (-> (dom-patches) length)])
    (dom-call-with! node method arguments)
    (at-once! mark)))

(define (kept-call [node u32] [method string] [arguments (slice dom-value)] [into u32]) -> u32
  (let ([mark (-> (dom-patches) length)])
    (dom-call-into! node method arguments into)
    (at-once! mark)
    into))

(define spare u32 0)

(define (spare-node) -> u32
  (when (== spare 0) (set! spare (dom-new-node!)))
  spare)

(define (dom-call-number [node u32] [method string] [arguments (slice dom-value)]) -> f64
  (dom-read-number (kept-call node method arguments (spare-node)) ""))

(define (dom-call-text [node u32] [method string] [arguments (slice dom-value)]) -> string
  (dom-read-text (kept-call node method arguments (spare-node)) ""))

(define (dom-call-node [node u32] [method string] [arguments (slice dom-value)]) -> u32
  (kept-call node method arguments (dom-new-node!)))

(define (dom-read-node [node u32] [path string]) -> u32
  (let ([mark (-> (dom-patches) length)] [n (dom-new-node!)])
    (dom-read-into! node path n)
    (at-once! mark)
    n))

(define (dom-element [id string]) -> u32
  (let ([n (dom-call-node dom-document "getElementById" (dom-values (dom-text id)))])
    (if (== (dom-read-number n "nodeType") 0.0)
        (begin (dom-forget-node! n) 0)
        n)))

(define (form-query [node u32] [path string] [submitter i32]) -> string
  (let* ([n u32 0]
         [p (form-data (cast i32 node) (cast i32 (-> path bytes)) (cast i32 (-> path length)) submitter
                       (cast i32 (& n)))])
    (kept-text (cast (ptr u8) p) n)))

(define (dom-form-data [node u32] [path string]) -> string (form-query node path -1))

(define (dom-form-data-with [node u32] [path string] [submitter u32]) -> string
  (form-query node path (cast i32 submitter)))
