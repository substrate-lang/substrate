;; The page: the host module "dom" and the patches that patches.sub writes. dom-flush! sends the patches. A read takes a
;; node, such as dom-document or dom-event, and a name that walks from it through the page's objects: a property's
;; name, or names joined by dots. It gives a number, with true as 1, or text, which lasts until the patches are sent.
;; dom-is says whether a node is the document's element of a name, such as activeElement or pointerLockElement, and
;; dom-event-call calls a method of the current event.
(require-unqualified host-dom host/web/dom)
(require-unqualified patches "patches.sub")

(provide (all-from-out host-dom) (all-from-out patches) dom-flush! dom-element dom-read-number dom-read-text dom-is
         dom-event-call)

(import read-number "dom" "read_number" (i32 i32 i32 -> f64))
(import read-text "dom" "read_text" (i32 i32 i32 i32 -> i32))
(import is "dom" "is" (i32 i32 i32 -> i32))
(import event-call "dom" "event_call" (i32 i32 ->))

;; The node number of the element with this id, or 0 when no element has it.
(define (dom-element [id string]) -> u32
  (let ([n (dom-new-node!)])
    (if (== (dom-bind-element (cast i32 (-> id bytes)) (cast i32 (-> id length)) (cast i32 n)) 0) 0 n)))

(define (dom-flush!)
  (let* ([b (dom-patches)] [n (-> b length)])
    (when (> n 0)
      (set! (-> b length) 0)
      (dom-apply (cast i32 (-> b bytes)) n))
    (dom-discard!)))

(define (dom-read-number [node u32] [path string]) -> f64
  (read-number (cast i32 node) (cast i32 (-> path bytes)) (cast i32 (-> path length))))

(define (dom-read-text [node u32] [path string]) -> string
  (let* ([n u32 0]
         [p (cast (ptr u8) (read-text (cast i32 node) (cast i32 (-> path bytes)) (cast i32 (-> path length)) (cast i32 (& n))))]
         [copy (cast (ptr u8) (dom-frame-alloc n))])
    (memcpy copy p n)
    (free p)
    (cast string (slice copy n))))

(define (dom-is [node u32] [name string]) -> bool
  (!= (is (cast i32 node) (cast i32 (-> name bytes)) (cast i32 (-> name length))) 0))

(define (dom-event-call [method string]) (event-call (cast i32 (-> method bytes)) (cast i32 (-> method length))))
