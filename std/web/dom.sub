;; The document: the host module "dom" and the patches that patches.sub writes. dom-flush! sends the patches. A read
;; takes a name that walks from a node, or from the current event, through the document's objects: a property's name, or
;; names joined by dots. It gives a number, with true as 1, or text. The text lasts until the patches are sent. dom-is
;; and dom-event-is also take a node, and say whether the name leads to it. (dom-is node dom-document "activeElement")
;; says whether the node has the focus. dom-event-call calls a method of the current event.
(require-unqualified host-dom host/web/dom)
(require-unqualified patches "patches.sub")

(provide (all-from-out host-dom) (all-from-out patches) dom-flush! dom-element dom-event-number dom-event-text
         dom-event-call dom-event-is dom-read-number dom-read-text dom-is)

(import event-number "dom" "event_number" (i32 i32 -> f64))
(import event-text "dom" "event_text" (i32 i32 i32 -> i32))
(import event-call "dom" "event_call" (i32 i32 ->))
(import event-is "dom" "event_is" (i32 i32 i32 -> i32))
(import read-number "dom" "read_number" (i32 i32 i32 -> f64))
(import read-text "dom" "read_text" (i32 i32 i32 i32 -> i32))
(import is "dom" "is" (i32 i32 i32 i32 -> i32))

(define (dom-element [id string]) -> u32
  (let ([n (dom-new-node!)])
    (if (== (dom-bind-element (cast i32 (-> id bytes)) (cast i32 (-> id length)) (cast i32 n)) 0) 0 n)))

(define (dom-flush!)
  (let* ([b (dom-patches)] [n (-> b length)])
    (when (> n 0)
      (set! (-> b length) 0)
      (dom-apply (cast i32 (-> b bytes)) n))
    (dom-discard!)))

(define (kept-text [p (ptr u8)] [n u32]) -> string
  (let ([copy (cast (ptr u8) (dom-frame-alloc n))])
    (memcpy copy p n)
    (free p)
    (cast string (slice copy n))))

(define (dom-event-number [path string]) -> f64 (event-number (cast i32 (-> path bytes)) (cast i32 (-> path length))))

(define (dom-event-text [path string]) -> string
  (let* ([n u32 0] [p (event-text (cast i32 (-> path bytes)) (cast i32 (-> path length)) (cast i32 (& n)))])
    (kept-text (cast (ptr u8) p) n)))

(define (dom-event-call [method string]) (event-call (cast i32 (-> method bytes)) (cast i32 (-> method length))))

(define (dom-read-number [node u32] [path string]) -> f64
  (read-number (cast i32 node) (cast i32 (-> path bytes)) (cast i32 (-> path length))))

(define (dom-read-text [node u32] [path string]) -> string
  (let* ([n u32 0]
         [p (read-text (cast i32 node) (cast i32 (-> path bytes)) (cast i32 (-> path length)) (cast i32 (& n)))])
    (kept-text (cast (ptr u8) p) n)))

(define (dom-event-is [node u32] [path string]) -> bool
  (!= (event-is (cast i32 node) (cast i32 (-> path bytes)) (cast i32 (-> path length))) 0))

(define (dom-is [node u32] [from u32] [path string]) -> bool
  (!= (is (cast i32 node) (cast i32 from) (cast i32 (-> path bytes)) (cast i32 (-> path length))) 0))
