;; The page: the host module "dom" and the patches that patches.sub writes. dom-flush! sends the patches, and
;; dom-event-text and dom-event-truths read the current event.
(require-unqualified host-dom host/web/dom)
(require-unqualified patches "patches.sub")

(provide (all-from-out host-dom) (all-from-out patches) dom-flush! dom-event-text dom-event-truths)

(define (dom-flush!)
  (let* ([b (dom-patches)] [n (-> b length)])
    (when (> n 0)
      (set! (-> b length) 0)
      (dom-apply (cast i32 (-> b bytes)) n))
    (dom-discard!)))

;; The current event's text: its target's value when which is 0, or its key when which is 1.
(define (dom-event-text [which u32]) -> string
  (let* ([n u32 0] [s (cast (ptr u8) (if (== which 0) (dom-event-value (cast i32 (& n))) (dom-event-key (cast i32 (& n)))))]
         [p (cast (ptr u8) (dom-frame-alloc n))])
    (memcpy p s n)
    (free s)
    (cast string (slice p n))))

(define (dom-event-truths) -> u32 (cast u32 (dom-event-flags)))
