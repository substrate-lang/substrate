;; WebGPU from a program: the commands of gpu-commands.sub, sent to the host module "gpu" (host/web/gpu.sub) in
;; batches. gpu-begin! starts a batch with the tag that its events go to, and gpu-send! sends it. The commands must be
;; sent, or dropped with gpu-commands-done!, before the next batch begins.
(require-unqualified host-gpu host/web/gpu)
(require-unqualified commands "gpu-commands.sub")

(provide (all-from-out host-gpu) (all-from-out commands) gpu-begin! gpu-send!)

(define batch-tag (ptr void) 0)
(define batch-begun bool #f)

(define (gpu-begin! [tag (ptr void)])
  (when (> (-> (gpu-commands) length) 0) (host-trap "gpu: a batch began while commands were waiting to be sent"))
  (set! batch-tag tag)
  (set! batch-begun #t))

(define (gpu-send!)
  (unless batch-begun (host-trap "gpu: gpu-send! was called without gpu-begin!"))
  (set! batch-begun #f)
  (let ([b (gpu-commands)])
    (when (> (-> b length) 0) (gpu-apply (buffer-bytes b) batch-tag)))
  (gpu-commands-done!))
