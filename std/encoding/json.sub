;; JSON (RFC 8259): values after cJSON's, in an arena; a token reader after Go's Decoder.Token; writing as JavaScript's
;; JSON.stringify writes, but -0 as -0; and the json form, a type's writer and reader after serde's derive.
(require-unqualified utf8 "utf8.sub")

(provide json json-value json-null json-boolean json-number json-string json-array json-object json-member json-error
         json-parse json-write! json-get json-at json-count json-as-i64 json-as-f64 json-as-string json-as-bool
         json-push! json-add! json-insert! json-replace! json-replace-at! json-remove! json-remove-at! json-copy
         json-equal? json-reader json-reader-start! json-reader-free! json-next! json-skip!
         json-token-error json-token-end json-token-start-array json-token-end-array json-token-start-object
         json-token-end-object json-token-key json-token-string json-token-number json-token-true json-token-false
         json-token-null)

(variant json-value
  [json-null]
  [json-boolean [value bool]]
  [json-number [value f64] [text string]]
  [json-string [text string]]
  [json-array [items (slice json-value)] [room u32]]
  [json-object [members (slice json-member)] [room u32]])

(struct json-member [key string] [value json-value])

(struct json-error [message string] [offset u32] [line u32] [column u32])

;; ---- the token reader ----

(const json-token-error u32 0)
(const json-token-end u32 1)
(const json-token-start-array u32 2)
(const json-token-end-array u32 3)
(const json-token-start-object u32 4)
(const json-token-end-object u32 5)
(const json-token-key u32 6)
(const json-token-string u32 7)
(const json-token-number u32 8)
(const json-token-true u32 9)
(const json-token-false u32 10)
(const json-token-null u32 11)

;; What may come next, after Go's tokenState.
(const top-value u32 0)
(const top-end u32 1)
(const array-start u32 2)
(const array-value u32 3)
(const array-comma u32 4)
(const object-start u32 5)
(const object-key u32 6)
(const object-colon u32 7)
(const object-value u32 8)
(const object-comma u32 9)
(const failed u32 10)

(const depth-limit u32 1000)

(struct json-reader [text string] [at u32] [state u32] [depth u32] [kinds (array u8 1000)] [token string] [number f64]
        [scratch buffer] [error json-error])

(define (json-reader-start! [r (ptr json-reader)] [text string])
  (set! (-> r text) text)
  (set! (-> r at) (if (and (>= (-> text length) 3) (== (@ text 0) 239) (== (@ text 1) 187) (== (@ text 2) 191)) 3 0))
  (set! (-> r state) top-value)
  (set! (-> r depth) 0)
  (set! (-> r token) "")
  (set! (-> r number) 0.0)
  (set! (-> r scratch) (make-buffer))
  (set! (-> r error message) "")
  (set! (-> r error offset) 0)
  (set! (-> r error line) 0)
  (set! (-> r error column) 0))

(define (json-reader-free! [r (ptr json-reader)]) (buffer-free! (& (-> r scratch))))

(define (json-next! [r (ptr json-reader)]) -> u32
  (let ([s (-> r state)] [c (space! r)])
    (cond [(or (== s array-value) (== s object-value))
           (cond [(== c #\,)
                  (+= (-> r at) 1)
                  (set! c (space! r))
                  (set! s (if (== s array-value) array-comma object-comma))]
                 [(== c (if (== s array-value) #\] #\})) (+= (-> r at) 1) (return (close! r))]
                 [(== c 256) (return (ended! r))]
                 [else (return (fail! r (if (== s array-value) "expected , or ]" "expected , or }")))])]
          [(== s object-key)
           (unless (== c #\:) (return (if (== c 256) (ended! r) (fail! r "expected : after a key"))))
           (+= (-> r at) 1)
           (set! c (space! r))
           (set! s object-colon)]
          [(== s top-end) (return (if (== c 256) json-token-end (fail! r "text after the value")))]
          [(== s failed) (return json-token-error)])
    (cond [(or (== s object-start) (== s object-comma))
           (cond [(== c #\")
                  (+= (-> r at) 1)
                  (if (string! r)
                      (begin (set! (-> r state) object-key) json-token-key)
                      json-token-error)]
                 [(and (== c #\}) (== s object-start)) (+= (-> r at) 1) (close! r)]
                 [(== c #\}) (fail! r "a comma before }")]
                 [(== c 256) (ended! r)]
                 [else (fail! r "a key must be a string")])]
          [(and (== c #\]) (== s array-start)) (+= (-> r at) 1) (close! r)]
          [(and (== c #\]) (== s array-comma)) (fail! r "a comma before ]")]
          [else (value! r c)])))

(define (json-skip! [r (ptr json-reader)]) -> bool
  (let ([d (-> r depth)] [t (json-next! r)])
    (when (or (== t json-token-start-array) (== t json-token-start-object))
      (while (> (-> r depth) d)
        (when (== (json-next! r) json-token-error) (return #f))))
    (and (!= t json-token-error) (!= t json-token-end) (!= t json-token-end-array) (!= t json-token-end-object))))

(define (space! [r (ptr json-reader)]) -> u32
  (let ([p (-> r text bytes)] [i (-> r at)] [end (-> r text length)] [c u32 0])
    (while (< i end)
      (set! c (@ p i))
      (unless (or (== c 32) (== c 10) (== c 13) (== c 9))
        (set! (-> r at) i)
        (return c))
      (+= i 1))
    (set! (-> r at) i)
    256))

(define (value! [r (ptr json-reader)] [c u32]) -> u32
  (cond [(== c #\")
         (+= (-> r at) 1)
         (if (string! r) (after-value! r json-token-string) json-token-error)]
        [(or (== c #\-) (and (>= c #\0) (<= c #\9))) (if (number! r) (after-value! r json-token-number) json-token-error)]
        [(== c #\[) (open! r 1 json-token-start-array)]
        [(== c #\{) (open! r 2 json-token-start-object)]
        [(== c #\t) (word! r "true" json-token-true)]
        [(== c #\f) (word! r "false" json-token-false)]
        [(== c #\n) (word! r "null" json-token-null)]
        [(== c 256) (if (== (-> r depth) 0) (fail! r "the text has no value") (ended! r))]
        [else (fail! r "expected a value")]))

(define (word! [r (ptr json-reader)] [w string] [t u32]) -> u32
  (let ([end (+ (-> r at) (-> w length))])
    (if (and (<= end (-> r text length)) (== (memcmp (+ (-> r text bytes) (-> r at)) (-> w bytes) (-> w length)) 0))
        (begin
          (set! (-> r at) end)
          (after-value! r t))
        (fail! r "expected a value"))))

(define (after-value! [r (ptr json-reader)] [t u32]) -> u32
  (set! (-> r state) (cond [(== (-> r depth) 0) top-end]
                           [(== (@ (-> r kinds) (- (-> r depth) 1)) 1) array-value]
                           [else object-value]))
  t)

(define (open! [r (ptr json-reader)] [kind u32] [t u32]) -> u32
  (when (== (-> r depth) depth-limit) (return (fail! r "nested too deeply")))
  (set! (@ (-> r kinds) (-> r depth)) kind)
  (+= (-> r depth) 1)
  (+= (-> r at) 1)
  (set! (-> r state) (if (== kind 1) array-start object-start))
  t)

(define (close! [r (ptr json-reader)]) -> u32
  (-= (-> r depth) 1)
  (after-value! r (if (== (@ (-> r kinds) (-> r depth)) 1) json-token-end-array json-token-end-object)))

(define (ended! [r (ptr json-reader)]) -> u32
  (fail! r (if (== (@ (-> r kinds) (- (-> r depth) 1)) 1) "the text ends inside an array" "the text ends inside an object")))

(define (fail! [r (ptr json-reader)] [message string]) -> u32
  (let ([p (-> r text bytes)] [line u32 1] [from u32 0])
    (for ([i u32 0]) (< i (-> r at)) (+= i 1)
      (when (== (@ p i) 10)
        (+= line 1)
        (set! from (+ i 1))))
    (set! (-> r error message) message)
    (set! (-> r error offset) (-> r at))
    (set! (-> r error line) line)
    (set! (-> r error column) (+ (- (-> r at) from) 1))
    (set! (-> r state) failed)
    json-token-error))

(define (reject! [r (ptr json-reader)] [message string]) -> bool (fail! r message) #f)

(define (string! [r (ptr json-reader)]) -> bool
  (let ([p (-> r text bytes)] [start (-> r at)] [i (-> r at)] [end (-> r text length)] [c u32 0] [k u32 0])
    (while (< i end)
      (set! c (@ p i))
      (cond [(== c #\")
             (set! (-> r token) (cast string (slice (+ p start) (- i start))))
             (set! (-> r at) (+ i 1))
             (return #t)]
            [(== c #\\) (return (escaped! r start i))]
            [(< c 32)
             (set! (-> r at) i)
             (return (reject! r "a control character in a string"))]
            [(< c 128) (+= i 1)]
            [else
             (set! k (utf-8-length (cast (slice u8) (-> r text)) i))
             (when (== k 0)
               (set! (-> r at) i)
               (return (reject! r "invalid UTF-8 in a string")))
             (+= i k)]))
    (set! (-> r at) i)
    (reject! r "the text ends inside a string")))

;; escaped! is string! for a string with escapes, from its first one at i, unescaped into the reader's scratch.
(define (escaped! [r (ptr json-reader)] [start u32] [i u32]) -> bool
  (let ([p (-> r text bytes)] [end (-> r text length)] [b (& (-> r scratch))] [c u32 0] [k u32 0] [u i32 0] [low i32 0])
    (set! (-> b length) 0)
    (buffer-add! b (slice (+ p start) (- i start)))
    (while (< i end)
      (set! c (@ p i))
      (cond [(== c #\")
             (set! (-> r token) (buffer-string b))
             (set! (-> r at) (+ i 1))
             (return #t)]
            [(== c #\\)
             (set! (-> r at) i)
             (when (>= (+ i 1) end) (return (reject! r "the text ends inside a string")))
             (set! c (@ p (+ i 1)))
             (if (== c #\u)
                 (begin
                   (set! u (hex4 (slice (-> r text) (+ i 2))))
                   (when (< u 0) (return (reject! r "invalid \\u escape")))
                   (+= i 6)
                   (when (and (>= u #xDC00) (<= u #xDFFF)) (return (reject! r "a lone surrogate in a \\u escape")))
                   (when (and (>= u #xD800) (<= u #xDBFF))
                     (set! low (if (and (< (+ i 1) end) (== (@ p i) #\\) (== (@ p (+ i 1)) #\u)) (hex4 (slice (-> r text) (+ i 2))) -1))
                     (unless (and (>= low #xDC00) (<= low #xDFFF)) (return (reject! r "a lone surrogate in a \\u escape")))
                     (set! u (+ #x10000 (<< (- u #xD800) 10) (- low #xDC00)))
                     (+= i 6))
                   (buffer-add-utf-8! b (cast u32 u)))
                 (begin
                   (set! k (escape-byte c))
                   (when (== k 0) (return (reject! r "invalid escape")))
                   (buffer-add-byte! b k)
                   (+= i 2)))]
            [(< c 32)
             (set! (-> r at) i)
             (return (reject! r "a control character in a string"))]
            [(< c 128)
             (buffer-add-byte! b c)
             (+= i 1)]
            [else
             (set! k (utf-8-length (cast (slice u8) (-> r text)) i))
             (when (== k 0)
               (set! (-> r at) i)
               (return (reject! r "invalid UTF-8 in a string")))
             (buffer-add! b (slice (+ p i) k))
             (+= i k)]))
    (set! (-> r at) i)
    (reject! r "the text ends inside a string")))

(define (escape-byte [c u32]) -> u32
  (case c
    [(34 92 47) c]
    [(98) 8]
    [(102) 12]
    [(110) 10]
    [(114) 13]
    [(116) 9]
    [else 0]))

(define (hex4 [s string]) -> i32
  (let ([v 0] [d 0])
    (when (< (-> s length) 4) (return -1))
    (for ([j u32 0]) (< j 4) (+= j 1)
      (set! d (digit-value (@ s j) 16))
      (when (< d 0) (return -1))
      (set! v (+ (* v 16) d)))
    v))

(define (digit? [c u32]) -> bool (and (>= c #\0) (<= c #\9)))

;; number! reads -?(0|[1-9][0-9]*)(.[0-9]+)?([eE][+-]?[0-9]+)?, its value by the prelude's decimal-flonum.
(define (number! [r (ptr json-reader)]) -> bool
  (let ([p (-> r text bytes)] [start (-> r at)] [i (-> r at)] [j (-> r at)] [end (-> r text length)] [c u32 0]
        [small (array u8 64)] [ds (ptr u8) 0] [nd 0] [fraction 0] [e 0] [negative #f] [e-negative #f])
    (while (and (< j end) (or (digit? (@ p j)) (== (@ p j) #\.) (== (@ p j) #\e) (== (@ p j) #\E) (== (@ p j) #\+)
                              (== (@ p j) #\-)))
      (+= j 1))
    (set! ds (if (<= (- j start) 64)
                 small
                 (begin
                   (set! (-> r scratch length) 0)
                   (buffer-add! (& (-> r scratch)) (slice (+ p start) (- j start)))
                   (-> r scratch bytes))))
    (when (== (@ p i) #\-)
      (set! negative #t)
      (+= i 1))
    (cond [(and (< i j) (== (@ p i) #\0))
           (set! (@ ds 0) 0)
           (set! nd 1)
           (+= i 1)]
          [(and (< i j) (digit? (@ p i)))
           (while (and (< i j) (digit? (@ p i)))
             (set! (@ ds nd) (- (@ p i) #\0))
             (+= nd 1)
             (+= i 1))]
          [else (return (reject! r "invalid number"))])
    (when (and (< i j) (== (@ p i) #\.))
      (+= i 1)
      (unless (and (< i j) (digit? (@ p i))) (return (reject! r "invalid number")))
      (while (and (< i j) (digit? (@ p i)))
        (set! (@ ds nd) (- (@ p i) #\0))
        (+= nd 1)
        (+= fraction 1)
        (+= i 1)))
    (when (and (< i j) (or (== (@ p i) #\e) (== (@ p i) #\E)))
      (+= i 1)
      (when (and (< i j) (or (== (@ p i) #\+) (== (@ p i) #\-)))
        (set! e-negative (== (@ p i) #\-))
        (+= i 1))
      (unless (and (< i j) (digit? (@ p i))) (return (reject! r "invalid number")))
      (while (and (< i j) (digit? (@ p i)))
        (when (< e 100000) (set! e (+ (* e 10) (- (@ p i) #\0))))
        (+= i 1)))
    (unless (== i j) (return (reject! r "invalid number")))
    (set! (-> r number) (decimal-flonum (slice ds nd) (- (if e-negative (- e) e) fraction) negative))
    (set! (-> r token) (cast string (slice (+ p start) (- j start))))
    (set! (-> r at) j)
    #t))

;; ---- parsing ----

(define (arena-text [a (ptr arena)] [s string]) -> string
  (let* ([n (-> s length)] [q (cast (ptr u8) (arena-alloc a n))])
    (memcpy q (-> s bytes) n)
    (cast string (slice q n))))

(define (json-parse [a (ptr arena)] [text string] [err (ptr json-error)]) -> (ptr json-value)
  (let ([r json-reader] [values (make-buffer)] [members (make-buffer)] [starts (array u32 1000)]
        [root (ptr json-value) 0] [t u32 0] [v json-value (json-null)] [k u32 0] [m json-member] [placed #f])
    (json-reader-start! (& r) text)
    (while #t
      (set! t (json-next! (& r)))
      (set! placed #t)
      (cond [(== t json-token-start-array)
             (set! (@ starts (- (-> r depth) 1)) (/ (-> values length) (sizeof json-value)))
             (set! placed #f)]
            [(== t json-token-start-object)
             (set! (@ starts (- (-> r depth) 1)) (/ (-> members length) (sizeof json-member)))
             (set! placed #f)]
            [(== t json-token-key)
             (set! (-> m key) (arena-text a (-> r token)))
             (set! (-> m value) (json-null))
             (buffer-add! (& members) (slice (cast (ptr u8) (& m)) (sizeof json-member)))
             (set! placed #f)]
            [(== t json-token-string) (set! v (json-string (arena-text a (-> r token))))]
            [(== t json-token-number) (set! v (json-number (-> r number) (arena-text a (-> r token))))]
            [(== t json-token-true) (set! v (json-boolean #t))]
            [(== t json-token-false) (set! v (json-boolean #f))]
            [(== t json-token-null) (set! v (json-null))]
            [(== t json-token-end-array)
             (set! k (- (/ (-> values length) (sizeof json-value)) (@ starts (-> r depth))))
             (set! v (json-array (slice (cast (ptr json-value) (block a (-> values bytes) (@ starts (-> r depth)) k
                                                                      (sizeof json-value)))
                                        k)
                                 k))
             (set! (-> values length) (* (@ starts (-> r depth)) (sizeof json-value)))]
            [(== t json-token-end-object)
             (set! k (- (/ (-> members length) (sizeof json-member)) (@ starts (-> r depth))))
             (set! v (json-object (slice (cast (ptr json-member) (block a (-> members bytes) (@ starts (-> r depth)) k
                                                                       (sizeof json-member)))
                                         k)
                                  k))
             (set! (-> members length) (* (@ starts (-> r depth)) (sizeof json-member)))]
            [(== t json-token-end) (break)]
            [else
             (when (!= err 0) (set! (@ err) (-> r error)))
             (set! root 0)
             (break)])
      (when placed
        (cond [(== (-> r depth) 0)
               (set! root (cast (ptr json-value) (arena-alloc a (sizeof json-value))))
               (set! (@ root) v)]
              [(== (@ (-> r kinds) (- (-> r depth) 1)) 1)
               (buffer-add! (& values) (slice (cast (ptr u8) (& v)) (sizeof json-value)))]
              [else
               (set! (-> (cast (ptr json-member) (+ (-> members bytes) (- (-> members length) (sizeof json-member)))) value)
                     v)])))
    (json-reader-free! (& r))
    (buffer-free! (& values))
    (buffer-free! (& members))
    root))

;; The k items of size bytes from index from of bytes, copied into a, or 0 for none.
(define (block [a (ptr arena)] [bytes (ptr u8)] [from u32] [k u32] [size u32]) -> (ptr void)
  (if (== k 0)
      0
      (memcpy (arena-alloc a (* k size)) (+ bytes (* from size)) (* k size))))

;; ---- writing ----

;; A newline and indent as many times as the deepest line written yet needs.
(struct padding [bytes buffer] [indent string])

(define (json-write! [b (ptr buffer)] [v (ptr json-value)] [indent string])
  (if (== (-> indent length) 0)
      (write-value! b v 0 0)
      (let ([pad padding])
        (set! (-> pad bytes) (make-buffer))
        (buffer-add-byte! (& (-> pad bytes)) 10)
        (set! (-> pad indent) indent)
        (write-value! b v (& pad) 0)
        (buffer-free! (& (-> pad bytes))))))

(define (write-value! [b (ptr buffer)] [v (ptr json-value)] [pad (ptr padding)] [depth u32])
  (match v
    [0 (buffer-add-string! b "null")]
    [(json-null) (buffer-add-string! b "null")]
    [(json-boolean x) (buffer-add-string! b (if x "true" "false"))]
    [(json-number x text) (if (> (-> text length) 0) (buffer-add-string! b text) (write-number! b x))]
    [(json-string text) (write-text! b text)]
    [(json-array items room)
     (let ([p (-> items items)] [n (-> items length)])
       (if (== n 0)
           (buffer-add-string! b "[]")
           (begin
             (buffer-add-byte! b #\[)
             (for ([i u32 0]) (< i n) (+= i 1)
               (when (> i 0) (buffer-add-byte! b #\,))
               (line! b pad (+ depth 1))
               (write-value! b (+ p i) pad (+ depth 1)))
             (line! b pad depth)
             (buffer-add-byte! b #\]))))]
    [(json-object members room)
     (let ([p (-> members items)] [n (-> members length)])
       (if (== n 0)
           (buffer-add-string! b "{}")
           (begin
             (buffer-add-byte! b #\{)
             (for ([i u32 0]) (< i n) (+= i 1)
               (let ([m (+ p i)])
                 (when (> i 0) (buffer-add-byte! b #\,))
                 (line! b pad (+ depth 1))
                 (write-text! b (-> m key))
                 (if (== pad 0) (buffer-add-byte! b #\:) (buffer-add-string! b ": "))
                 (write-value! b (& (-> m value)) pad (+ depth 1))))
             (line! b pad depth)
             (buffer-add-byte! b #\}))))]))

(define (line! [b (ptr buffer)] [pad (ptr padding)] [depth u32])
  (unless (== pad 0)
    (let ([need (+ 1 (* depth (-> pad indent length)))])
      (while (< (-> pad bytes length) need) (buffer-add-string! (& (-> pad bytes)) (-> pad indent)))
      (buffer-add! b (slice (-> pad bytes bytes) need)))))

;; write-number! writes x as JavaScript's Number::toString does, but -0 as -0.
(define (write-number! [b (ptr buffer)] [x f64])
  (when (or (!= x x) (== x (/ 1.0 0.0)) (== x (/ -1.0 0.0)))
    (buffer-add-string! b "null")
    (return))
  (when (== x 0.0)
    (buffer-add-string! b (if (== (f64-bits x) 0) "0" "-0"))
    (return))
  (let* ([ds (array u8 24)] [(digits k) (shortest-digits (fabs x) #f (slice ds))] [n (cast i32 (-> digits length))])
    (when (< x 0.0) (buffer-add-byte! b #\-))
    (cond [(and (<= n k) (<= k 21))
           (buffer-add! b digits)
           (for ([i n]) (< i k) (+= i 1) (buffer-add-byte! b #\0))]
          [(and (> k 0) (<= k 21))
           (buffer-add! b (slice digits 0 (cast u32 k)))
           (buffer-add-byte! b #\.)
           (buffer-add! b (slice digits (cast u32 k)))]
          [(and (> k -6) (<= k 0))
           (buffer-add-string! b "0.")
           (for ([i k]) (< i 0) (+= i 1) (buffer-add-byte! b #\0))
           (buffer-add! b digits)]
          [else
           (buffer-add-byte! b (@ digits 0))
           (when (> n 1)
             (buffer-add-byte! b #\.)
             (buffer-add! b (slice digits 1)))
           (buffer-add-byte! b #\e)
           (buffer-add-byte! b (if (>= k 1) #\+ #\-))
           (write-digits b (cast u64 (if (>= k 1) (- k 1) (- 1 k))) 10)])))

;; write-text! writes bytes as a JSON string, escaped as JSON.stringify escapes, and an invalid UTF-8 byte as �.
(define (write-text! [b (ptr buffer)] [s string])
  (let ([p (-> s bytes)] [n (-> s length)] [i u32 0] [run u32 0] [c u32 0] [k u32 0])
    (buffer-add-byte! b #\")
    (while (< i n)
      (set! c (@ p i))
      (if (and (>= c 32) (< c 128) (!= c #\") (!= c #\\))
          (+= i 1)
          (begin
            (set! k (if (>= c 128) (utf-8-length (cast (slice u8) s) i) 0))
            (if (!= k 0)
                (+= i k)
                (begin
                  (buffer-add-string! b (slice s run i))
                  (if (>= c 128) (buffer-add-string! b "\\ufffd") (escape! b c))
                  (+= i 1)
                  (set! run i))))))
    (buffer-add-string! b (slice s run i))
    (buffer-add-byte! b #\")))

(define (escape! [b (ptr buffer)] [c u32])
  (buffer-add-byte! b #\\)
  (case c
    [(34 92) (buffer-add-byte! b c)]
    [(8) (buffer-add-byte! b #\b)]
    [(12) (buffer-add-byte! b #\f)]
    [(10) (buffer-add-byte! b #\n)]
    [(13) (buffer-add-byte! b #\r)]
    [(9) (buffer-add-byte! b #\t)]
    [else
     (buffer-add-string! b "u00")
     (buffer-add-byte! b (+ 48 (>> c 4)))
     (buffer-add-byte! b (let ([d (bit-and c 15)]) (if (< d 10) (+ 48 d) (+ 87 d))))]))

;; ---- reading values ----

(define (json-get [v (ptr json-value)] [key string]) -> (ptr json-value)
  (let ([i (member-index v key)])
    (match v
      [(json-object members room) (if (< i 0) 0 (& (-> (@ members (cast u32 i)) value)))]
      [_ 0])))

;; The index of the last member of v with key, or -1.
(define (member-index [v (ptr json-value)] [key string]) -> i32
  (match v
    [(json-object members room)
     (let ([i (-> members length)])
       (while (> i 0)
         (-= i 1)
         (when (== (-> (@ members i) key) key) (return (cast i32 i))))
       -1)]
    [_ -1]))

(define (json-at [v (ptr json-value)] [i u32]) -> (ptr json-value)
  (match v
    [(json-array items room) (if (< i (-> items length)) (& (@ items i)) 0)]
    [_ 0]))

(define (json-count [v (ptr json-value)]) -> u32
  (match v
    [(json-array items room) (-> items length)]
    [(json-object members room) (-> members length)]
    [_ 0]))

;; json-as-i64 reads a number written as an integer, exactly from its text, as serde_json's as_i64.
(define (json-as-i64 [v (ptr json-value)] [to (ptr i64)]) -> bool
  (match v
    [(json-number x text)
     (let* ([n (-> text length)] [negative (and (> n 0) (== (@ text 0) #\-))] [digits (slice text (if negative 1 0))]
            [k u64 0])
       (and (> n 0) (digits? digits 10) (digits-integer digits 10 negative (& k)) (or negative (<= k 9223372036854775807))
            (begin
              (set! (@ to) (cast i64 k))
              #t)))]
    [_ #f]))

(define (json-as-f64 [v (ptr json-value)] [to (ptr f64)]) -> bool
  (match v
    [(json-number x text)
     (set! (@ to) x)
     #t]
    [_ #f]))

(define (json-as-string [v (ptr json-value)] [to (ptr string)]) -> bool
  (match v
    [(json-string text)
     (set! (@ to) text)
     #t]
    [_ #f]))

(define (json-as-bool [v (ptr json-value)] [to (ptr bool)]) -> bool
  (match v
    [(json-boolean x)
     (set! (@ to) x)
     #t]
    [_ #f]))

;; ---- building and changing values ----

;; own! copies the bytes of the string or number at v into a.
(define (own! [a (ptr arena)] [v (ptr json-value)])
  (match v
    [(json-number x text) (when (> (-> text length) 0) (set! text (arena-text a text)))]
    [(json-string text) (set! text (arena-text a text))]
    [_ (begin)]))

(define (json-push! [a (ptr arena)] [array (ptr json-value)] [v json-value]) -> bool
  (json-insert! a array (json-count array) v))

(define (json-insert! [a (ptr arena)] [array (ptr json-value)] [i u32] [v json-value]) -> bool
  (match array
    [(json-array items room)
     (let ([p (-> items items)] [count (-> items length)])
       (when (> i count) (return #f))
       (when (== count room)
         (set! room (if (== room 0) 4 (* 2 room)))
         (let ([q (cast (ptr json-value) (arena-alloc a (* room (sizeof json-value))))])
           (when (> count 0) (memcpy q p (* count (sizeof json-value))))
           (set! p q)))
       (memcpy (+ p i 1) (+ p i) (* (- count i) (sizeof json-value)))
       (set! (@ (+ p i)) v)
       (own! a (+ p i))
       (set! items (slice p (+ count 1))))
     #t]
    [_ #f]))

(define (json-add! [a (ptr arena)] [object (ptr json-value)] [key string] [v json-value]) -> bool
  (match object
    [(json-object members room)
     (let ([p (-> members items)] [count (-> members length)])
       (when (== count room)
         (set! room (if (== room 0) 4 (* 2 room)))
         (let ([q (cast (ptr json-member) (arena-alloc a (* room (sizeof json-member))))])
           (when (> count 0) (memcpy q p (* count (sizeof json-member))))
           (set! p q)))
       (let ([m (+ p count)])
         (set! (-> m key) (arena-text a key))
         (set! (-> m value) v)
         (own! a (& (-> m value))))
       (set! members (slice p (+ count 1))))
     #t]
    [_ #f]))

(define (json-replace! [a (ptr arena)] [object (ptr json-value)] [key string] [v json-value]) -> bool
  (let ([p (json-get object key)])
    (when (== p 0) (return #f))
    (set! (@ p) v)
    (own! a p)
    #t))

(define (json-replace-at! [a (ptr arena)] [array (ptr json-value)] [i u32] [v json-value]) -> bool
  (let ([p (json-at array i)])
    (when (== p 0) (return #f))
    (set! (@ p) v)
    (own! a p)
    #t))

(define (json-remove! [object (ptr json-value)] [key string]) -> bool
  (let ([i (member-index object key)])
    (match object
      [(json-object members room)
       (when (< i 0) (return #f))
       (let ([p (-> members items)] [count (-> members length)] [k (cast u32 i)])
         (memcpy (+ p k) (+ p k 1) (* (- count k 1) (sizeof json-member)))
         (set! members (slice p (- count 1))))
       #t]
      [_ #f])))

(define (json-remove-at! [array (ptr json-value)] [i u32]) -> bool
  (match array
    [(json-array items room)
     (let ([p (-> items items)] [count (-> items length)])
       (when (>= i count) (return #f))
       (memcpy (+ p i) (+ p i 1) (* (- count i 1) (sizeof json-value)))
       (set! items (slice p (- count 1))))
     #t]
    [_ #f]))

(define (json-copy [a (ptr arena)] [v (ptr json-value)]) -> (ptr json-value)
  (let ([out (cast (ptr json-value) (arena-alloc a (sizeof json-value)))])
    (copy-into! a out v)
    out))

(define (copy-into! [a (ptr arena)] [out (ptr json-value)] [v (ptr json-value)])
  (if (== v 0) (set! (@ out) (json-null)) (set! (@ out) (@ v)))
  (match out
    [(json-array items room)
     (let* ([count (-> items length)] [p (cast (ptr json-value) (arena-alloc a (* count (sizeof json-value))))])
       (for ([i u32 0]) (< i count) (+= i 1) (copy-into! a (+ p i) (& (@ items i))))
       (set! items (slice p count))
       (set! room count))]
    [(json-object members room)
     (let* ([count (-> members length)] [p (cast (ptr json-member) (arena-alloc a (* count (sizeof json-member))))])
       (for ([i u32 0]) (< i count) (+= i 1)
         (let ([m (& (@ members i))] [q (+ p i)])
           (set! (-> q key) (arena-text a (-> m key)))
           (copy-into! a (& (-> q value)) (& (-> m value)))))
       (set! members (slice p count))
       (set! room count))]
    [_ (own! a out)]))

(define (json-equal? [x (ptr json-value)] [y (ptr json-value)]) -> bool
  (match x
    [0 (== y 0)]
    [(json-null) (match y [(json-null) #t] [_ #f])]
    [(json-boolean p) (match y [(json-boolean q) (== p q)] [_ #f])]
    [(json-number p pt) (match y [(json-number q qt) (== p q)] [_ #f])]
    [(json-string p) (match y [(json-string q) (== p q)] [_ #f])]
    [(json-array p pr)
     (match y
       [(json-array q qr)
        (unless (== (-> p length) (-> q length)) (return #f))
        (for ([i u32 0]) (< i (-> p length)) (+= i 1) (unless (json-equal? (& (@ p i)) (& (@ q i))) (return #f)))
        #t]
       [_ #f])]
    [(json-object p pr)
     (match y
       [(json-object q qr)
        (unless (== (-> p length) (-> q length)) (return #f))
        (for ([i u32 0]) (< i (-> p length)) (+= i 1)
          (let ([m (& (@ p i))] [o (& (@ q i))])
            (unless (json-equal? (& (-> m value)) (if (== (-> m key) (-> o key)) (& (-> o value)) (json-get y (-> m key))))
              (return #f))))
        #t]
       [_ #f])]))

;; ---- reading into types ----

(define (expect! [r (ptr json-reader)] [t u32] [want u32] [message string]) -> bool
  (cond [(== t want) #t]
        [(== t json-token-error) #f]
        [else (reject! r message)]))

(define (take-unsigned! [r (ptr json-reader)] [t u32] [most u64] [to (ptr u64)]) -> bool
  (and (expect! r t json-token-number "expected a number")
       (or (and (digits? (-> r token) 10) (digits-integer (-> r token) 10 #f to) (<= (@ to) most))
           (reject! r "expected an integer within the field's type"))))

(define (take-signed! [r (ptr json-reader)] [t u32] [least i64] [most i64] [to (ptr i64)]) -> bool
  (unless (expect! r t json-token-number "expected a number") (return #f))
  (let* ([negative (== (@ (-> r token) 0) #\-)] [digits (slice (-> r token) (if negative 1 0))] [k u64 0])
    (or (and (digits? digits 10) (digits-integer digits 10 negative (& k))
             (if negative (>= (cast i64 k) least) (<= k (cast u64 most)))
             (begin (set! (@ to) (cast i64 k)) #t))
        (reject! r "expected an integer within the field's type"))))

(define (take-float! [r (ptr json-reader)] [t u32] [to (ptr f64)]) -> bool
  (and (expect! r t json-token-number "expected a number")
       (begin (set! (@ to) (-> r number)) #t)))

(define (take-bool! [r (ptr json-reader)] [t u32] [to (ptr bool)]) -> bool
  (cond [(== t json-token-true) (set! (@ to) #t) #t]
        [(== t json-token-false) (set! (@ to) #f) #t]
        [else (expect! r t json-token-true "expected true or false")]))

(define (take-text! [r (ptr json-reader)] [a (ptr arena)] [t u32] [to (ptr string)]) -> bool
  (and (expect! r t json-token-string "expected a string")
       (begin (set! (@ to) (arena-text a (-> r token))) #t)))

(define (end-of-text! [r (ptr json-reader)]) -> bool (== (json-next! r) json-token-end))

(define (finish! [r (ptr json-reader)] [ok bool] [err (ptr json-error)]) -> bool
  (when (and (not ok) (!= err 0)) (set! (@ err) (-> r error)))
  (json-reader-free! r)
  ok)

(define (put-signed! [b (ptr buffer)] [n i64])
  (if (< n 0)
      (begin (buffer-add-byte! b #\-) (write-digits b (- 0 (cast u64 n)) 10))
      (write-digits b (cast u64 n) 10)))

;; ---- the json form ----

(begin-for-syntax
  (require-unqualified macros compiler/macros)
  (require-unqualified derive std/meta/derive)

  (define unsigned-limits datum '((u8 255) (u16 65535) (u32 4294967295) (u64 18446744073709551615)))
  (define signed-limits datum
    '((i8 -128 127) (i16 -32768 32767) (i32 -2147483648 2147483647) (i64 -9223372036854775808 9223372036854775807)))

  (define (literal [d datum]) -> datum (datum->syntax #'here d 0))

  (define (json-form [s datum]) -> datum (derive s 'json '"json-write!" definitions))

  (define (definitions [t datum] [info datum]) -> datum
    (if (== (car info) 'struct) (struct-code t (caddr info)) (variant-code t (caddr info))))

  (define (name-text [x datum]) -> datum (literal (string->datum (symbol->string (syntax-e x)))))

  ;; A field's or case's name as a JSON string.
  (define (quoted [x datum]) -> datum
    (let ([b (make-buffer)] [s (symbol->string (syntax-e x))] [d datum 0])
      (buffer-add-byte! (& b) #\")
      (for ([i u32 0]) (< i (-> s length)) (+= i 1)
        (when (or (== (@ s i) #\") (== (@ s i) #\\)) (buffer-add-byte! (& b) #\\))
        (buffer-add-byte! (& b) (@ s i)))
      (buffer-add-byte! (& b) #\")
      (set! d (string->datum (buffer-string (& b))))
      (buffer-free! (& b))
      d))

  (define (struct-code [t datum] [fields datum]) -> datum
    `(,#`(define (#,(derive-name t '"json-write!") [b (ptr buffer)] [v (ptr #,t)])
           #,@(object-write fields (for/list ([f fields]) #`(-> v #,(car f)))))
      ,#`(define (#,(derive-name t '"json-read-from!") [r (ptr json-reader)] [a (ptr arena)] [token u32] [v (ptr #,t)]) -> bool
           #,(object-read #`token fields (for/list ([f fields]) #`(-> v #,(car f))))
           #t)
      ,(entry t)))

  (define (variant-code [t datum] [cases datum]) -> datum
    (let ([writes nil] [names nil] [objects nil])
      (for/each ([c cases])
        (let ([xs (for/list ([f (cdr c)]) (derive-fresh 'f))])
          (if (null? (cdr c))
              (begin
                (set! writes (cons #`[(#,(car c)) (buffer-add-string! b #,(literal (quoted (car c))))] writes))
                (set! names (cons #`[(== (-> r token) #,(name-text (car c))) (set! (@ v) (#,(car c)))] names)))
              (begin
                (set! writes (cons #`[(#,(car c) #,@xs)
                                      (buffer-add-string! b #,(literal (format "{~a:" `(,(quoted (car c))))))
                                      #,@(object-write (cdr c) xs)
                                      (buffer-add-byte! b #\})]
                                   writes))
                (set! objects (cons #`[(== (-> r token) #,(name-text (car c)))
                                       (let (#,@(for/list ([f (cdr c)] [x xs]) #`[#,x #,(type-syntax (cdr f))]))
                                         #,(object-read #`(json-next! r) (cdr c) xs)
                                         (set! (@ v) (#,(car c) #,@xs)))]
                                    objects))))))
      `(,#`(define (#,(derive-name t '"json-write!") [b (ptr buffer)] [v (ptr #,t)])
             (match v #,@(reverse writes)))
        ,#`(define (#,(derive-name t '"json-read-from!") [r (ptr json-reader)] [a (ptr arena)] [token u32] [v (ptr #,t)]) -> bool
             (cond [(== token json-token-string)
                    (cond #,@(reverse names)
                          [else (return (reject! r "unknown case"))])]
                   [(== token json-token-start-object)
                    (unless (expect! r (json-next! r) json-token-key "expected a case") (return #f))
                    (cond #,@(reverse objects)
                          [else (return (reject! r "unknown case"))])
                    (unless (expect! r (json-next! r) json-token-end-object "expected one case") (return #f))]
                   [else (return (expect! r token json-token-string "expected a case"))])
             #t)
        ,(entry t))))

  (define (entry [t datum]) -> datum
    #`(define (#,(derive-name t '"json-read") [a (ptr arena)] [text string] [v (ptr #,t)] [err (ptr json-error)]) -> bool
        (let ([r json-reader])
          (json-reader-start! (& r) text)
          (finish! (& r) (and (#,(derive-name t '"json-read-from!") (& r) a (json-next! (& r)) v) (end-of-text! (& r))) err))))

  (define (optional? [type datum]) -> bool (and (pair? type) (== (car type) 'ptr)))

  ;; Code writing an object's fields from their places.
  (define (object-write [fields datum] [places datum]) -> datum
    (if (null? fields)
        `(,#`(buffer-add-string! b "{}"))
        (let ([out nil] [first #t])
          (for/each ([f fields] [p places])
            (set! out (cons #`(buffer-add-string! b #,(literal (format "~a~a:" `(,(if first '"{" '",") ,(quoted (car f))))))
                            out))
            (set! out (cons (write-code (cdr f) p (car f)) out))
            (set! first #f))
          (reverse (cons #`(buffer-add-byte! b #\}) out)))))

  ;; Code reading an object, whose first token is token, into its fields' places.
  (define (object-read [token datum] [fields datum] [places datum]) -> datum
    (let ([seen (derive-fresh 'seen)] [k (derive-fresh 'k)] [n (literal (make-integer (if (null? fields) 1 (length fields))))]
          [i 0] [arms nil] [checks nil] [defaults nil])
      (for/each ([f fields] [p places])
        (let ([index (literal (make-integer i))] [u (derive-fresh 'u)])
          (set! arms (cons #`[(== (-> r token) #,(name-text (car f)))
                              (let ([#,u (json-next! r)]) #,(read-code (cdr f) p (car f) u))
                              (set! (@ #,seen #,index) #t)]
                           arms))
          (if (optional? (cdr f))
              (set! defaults (cons #`(set! #,p 0) defaults))
              (set! checks (cons #`(unless (@ #,seen #,index)
                                     (return (reject! r #,(literal (format "missing field ~a" `(,(syntax-e (car f))))))))
                                 checks))))
        (+= i 1))
      #`(let ([#,seen (array bool #,n)] [#,k u32 0])
          (memset #,seen 0 #,n)
          #,@(reverse defaults)
          (unless (expect! r #,token json-token-start-object "expected an object") (return #f))
          (while #t
            (set! #,k (json-next! r))
            (cond [(== #,k json-token-end-object) (break)]
                  [(!= #,k json-token-key) (return #f)]
                  #,@(reverse arms)
                  [else (unless (json-skip! r) (return #f))]))
          #,@(reverse checks))))

  ;; Code writing the value at place p, of the field where.
  (define (write-code [type datum] [p datum] [where datum]) -> datum
    (cond [(symbol? type)
           (cond [(!= (assq type unsigned-limits) 0) #`(write-digits b (cast u64 #,p) 10)]
                 [(!= (assq type signed-limits) 0) #`(put-signed! b (cast i64 #,p))]
                 [(== type 'f32) #`(write-number! b (cast f64 #,p))]
                 [(== type 'f64) #`(write-number! b #,p)]
                 [(== type 'bool) #`(buffer-add-string! b (if #,p "true" "false"))]
                 [else #`(write-text! b #,p)])]
          [(identifier? type) (derive-want! type) #`(#,(derive-name type '"json-write!") b (& #,p))]
          [(== (car type) 'ptr)
           #`(if (== #,p 0) (buffer-add-string! b "null") #,(write-code (cadr type) #`(@ #,p) where))]
          [(or (== (car type) 'slice) (== (car type) 'array))
           (let ([i (derive-fresh 'i)] [n (if (== (car type) 'slice) #`(-> #,p length) (literal (caddr type)))])
             #`(begin (buffer-add-byte! b #\[)
                      (for ([#,i u32 0]) (< #,i #,n) (+= #,i 1)
                        (when (> #,i 0) (buffer-add-byte! b #\,))
                        #,(write-code (cadr type) #`(@ #,p #,i) where))
                      (buffer-add-byte! b #\])))]
          [else (raise-syntax-error 'json "this field's type has no JSON form" where)]))

  ;; Code reading into place p, of the field where, the value whose first token is u.
  (define (read-code [type datum] [p datum] [where datum] [u datum]) -> datum
    (cond [(symbol? type)
           (let ([unsigned (assq type unsigned-limits)] [signed (assq type signed-limits)] [n (derive-fresh 'n)])
             (cond [(!= unsigned 0)
                    #`(let ([#,n u64 0])
                        (unless (take-unsigned! r #,u #,(literal (cadr unsigned)) (& #,n)) (return #f))
                        (set! #,p (cast #,(literal type) #,n)))]
                   [(!= signed 0)
                    #`(let ([#,n i64 0])
                        (unless (take-signed! r #,u #,(literal (cadr signed)) #,(literal (caddr signed)) (& #,n)) (return #f))
                        (set! #,p (cast #,(literal type) #,n)))]
                   [(== type 'f32)
                    #`(let ([#,n f64 0.0]) (unless (take-float! r #,u (& #,n)) (return #f)) (set! #,p (cast f32 #,n)))]
                   [(== type 'f64) #`(unless (take-float! r #,u (& #,p)) (return #f))]
                   [(== type 'bool) #`(unless (take-bool! r #,u (& #,p)) (return #f))]
                   [else #`(unless (take-text! r a #,u (& #,p)) (return #f))]))]
          [(identifier? type)
           (derive-want! type)
           #`(unless (#,(derive-name type '"json-read-from!") r a #,u (& #,p)) (return #f))]
          [(== (car type) 'ptr)
           (let ([q (derive-fresh 'q)] [e (type-syntax (cadr type))])
             #`(if (== #,u json-token-null)
                   (set! #,p 0)
                   (let ([#,q (cast (ptr #,e) (arena-alloc a (sizeof #,e)))])
                     #,(read-code (cadr type) #`(@ #,q) where u)
                     (set! #,p #,q))))]
          [(== (car type) 'slice)
           (let ([items (derive-fresh 'items)] [count (derive-fresh 'count)] [room (derive-fresh 'room)] [w (derive-fresh 'w)]
                 [more (derive-fresh 'more)] [e (type-syntax (cadr type))])
             #`(let ([#,items (ptr #,e) 0] [#,count u32 0] [#,room u32 0] [#,w u32 0])
                 (unless (expect! r #,u json-token-start-array "expected an array") (return #f))
                 (while #t
                   (set! #,w (json-next! r))
                   (when (== #,w json-token-end-array) (break))
                   (when (== #,count #,room)
                     (set! #,room (if (== #,room 0) 4 (* 2 #,room)))
                     (let ([#,more (cast (ptr #,e) (arena-alloc a (* #,room (sizeof #,e))))])
                       (when (> #,count 0) (memcpy #,more #,items (* #,count (sizeof #,e))))
                       (set! #,items #,more)))
                   #,(read-code (cadr type) #`(@ #,items #,count) where w)
                   (+= #,count 1))
                 (set! #,p (slice #,items #,count))))]
          [(== (car type) 'array)
           (let ([i (derive-fresh 'i)] [w (derive-fresh 'w)] [n (literal (caddr type))]
                 [message (literal (format "expected an array of ~a items" `(,(caddr type))))])
             #`(let ([#,w u32 0])
                 (unless (expect! r #,u json-token-start-array "expected an array") (return #f))
                 (for ([#,i u32 0]) (< #,i #,n) (+= #,i 1)
                   (set! #,w (json-next! r))
                   (when (== #,w json-token-end-array) (return (reject! r #,message)))
                   #,(read-code (cadr type) #`(@ #,p #,i) where w))
                 (unless (expect! r (json-next! r) json-token-end-array #,message) (return #f))))]
          [else (raise-syntax-error 'json "this field's type has no JSON form" where)])))

(define-syntax json json-form)
