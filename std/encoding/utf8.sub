;; UTF-8 (RFC 3629). utf-8? rejects overlong forms, surrogates and values beyond U+10FFFF; utf-8-length is the length
;; of the sequence that starts with b's byte i, a byte of 128 or more, or 0 when there is none.
(provide utf-8? utf-8-length)

(define (utf-8? [b (slice u8)]) -> bool
  (let ([p (-> b items)] [n (-> b length)] [i u32 0] [k u32 0])
    (while (< i n)
      (if (< (@ p i) 128)
          (+= i 1)
          (begin
            (set! k (utf-8-length b i))
            (when (== k 0) (return #f))
            (+= i k))))
    #t))

(define (utf-8-length [b (slice u8)] [i u32]) -> u32
  (let* ([p (-> b items)] [n (-> b length)] [c (cast u32 (@ p i))] [k u32 0] [lo u32 128] [hi u32 191])
    (cond [(< c 194) (return 0)]
          [(< c 224) (set! k 1)]
          [(< c 240) (set! k 2) (when (== c 224) (set! lo 160)) (when (== c 237) (set! hi 159))]
          [(< c 245) (set! k 3) (when (== c 240) (set! lo 144)) (when (== c 244) (set! hi 143))]
          [else (return 0)])
    (when (>= (+ i k) n) (return 0))
    (for ([j u32 1]) (<= j k) (+= j 1)
      (let ([d (cast u32 (@ p (+ i j)))])
        (when (or (< d lo) (> d hi)) (return 0))
        (set! lo 128)
        (set! hi 191)))
    (+ k 1)))
