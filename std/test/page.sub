;; Tests of web programs in the simulated browser (substrate/host/web/simulated). with-page builds a program and opens
;; its page; finders describe the page's elements; actions, reads and expectations work on them as a user would.
(require-unqualified pages host/node/page)
(require-unqualified build "build.sub")
(require-unqualified tests "test.sub")
(require-unqualified paths "../package/path.sub")

(provide with-page page finder by-css by-text by-text-containing by-role by-label by-test-id within nth page-click!
         page-click-at! page-type! page-press! page-key-down! page-key-up! page-focus! page-fire! page-advance!
         page-text page-html page-attribute page-attribute? page-value page-checked? page-count page-drawing
         page-console page-show page-show-drawing expect-text expect-html expect-value expect-attribute
         expect-no-attribute expect-checked expect-count expect-missing page-opened page-closed! page-expect)

(struct page [id u32])

(struct finder [code string])

;; ---- finders ----

(define (field! [b (ptr buffer)] [s string])
  (buffer-add-string! b s)
  (buffer-add-byte! b 0))

(define (number! [b (ptr buffer)] [n u32])
  (write-digits b (cast u64 n) 10)
  (buffer-add-byte! b 0))

(define (finder-of [kind string] [text string]) -> finder
  (let ([b (make-buffer)])
    (field! (& b) kind)
    (field! (& b) text)
    (finder #:code (buffer-string (& b)))))

(define (by-css [selector string]) -> finder (finder-of "css" selector))

(define (by-text [text string]) -> finder (finder-of "text" text))

(define (by-text-containing [text string]) -> finder (finder-of "text-containing" text))

;; An element by its role and accessible name; the name "" matches any.
(define (by-role [role string] [name string]) -> finder
  (let ([b (make-buffer)])
    (field! (& b) "role")
    (field! (& b) role)
    (field! (& b) name)
    (finder #:code (buffer-string (& b)))))

(define (by-label [text string]) -> finder (finder-of "label" text))

(define (by-test-id [id string]) -> finder (finder-of "test-id" id))

(define (within [outer finder] [inner finder]) -> finder
  (let ([b (make-buffer)])
    (field! (& b) "within")
    (buffer-add-string! (& b) (-> outer code))
    (buffer-add-string! (& b) (-> inner code))
    (finder #:code (buffer-string (& b)))))

;; The nth element of those that finder finds, counting from 1.
(define (nth [of finder] [n u32]) -> finder
  (let ([b (make-buffer)])
    (field! (& b) "nth")
    (buffer-add-string! (& b) (-> of code))
    (number! (& b) n)
    (finder #:code (buffer-string (& b)))))

;; ---- requests ----

(define (request-of [kind string] [f finder]) -> buffer
  (let ([b (make-buffer)])
    (field! (& b) kind)
    (buffer-add-string! (& b) (-> f code))
    b))

(define (sent [p page] [b (ptr buffer)]) -> string
  (let ([answer string] [why string] [code i32 0])
    (set! code (page-request (-> p id) (buffer-string b) (& answer) (& why)))
    (buffer-free! b)
    (when (< code 0) (throw test-failed why))
    answer))

(define (asked [p page] [kind string] [f finder]) -> string (let ([b (request-of kind f)]) (sent p (& b))))

(define (asked-with [p page] [kind string] [f finder] [text string]) -> string
  (let ([b (request-of kind f)])
    (field! (& b) text)
    (sent p (& b))))

(define (told [p page] [kind string] [text string]) -> string
  (let ([b (make-buffer)])
    (field! (& b) kind)
    (field! (& b) text)
    (sent p (& b))))

(define (page-opened [path string] [markup string] [message string]) -> page
  (let* ([dir (program-built path message)] [source (parent-of path)]
         [assets (if (== (-> source length) 0) "assets" (joined-path source "assets"))] [why string]
         [id (page-open dir markup assets (& why))])
    (when (== id 0) (throw test-failed (lines-joined message why)))
    (page #:id id)))

(define (page-closed! [p page]) (page-close (-> p id)))

(define (lines-joined [a string] [b string]) -> string
  (let ([out (make-buffer)])
    (buffer-add-string! (& out) a)
    (buffer-add-byte! (& out) 10)
    (buffer-add-string! (& out) b)
    (buffer-string (& out))))

;; ---- actions ----

(define (page-click! [p page] [f finder]) (asked p "click" f))

;; A click at x, y within the element.
(define (page-click-at! [p page] [f finder] [x u32] [y u32])
  (let ([b (request-of "click" f)])
    (number! (& b) x)
    (number! (& b) y)
    (sent p (& b))))

(define (page-type! [p page] [f finder] [text string]) (asked-with p "type" f text))

;; A key pressed and let go: a key's name or one character, after any of Shift+, Control+, Alt+ and Meta+.
(define (page-press! [p page] [key string]) (told p "press" key))

(define (page-key-down! [p page] [key string]) (told p "key-down" key))

(define (page-key-up! [p page] [key string]) (told p "key-up" key))

(define (page-focus! [p page] [f finder]) (asked p "focus" f))

(define (page-fire! [p page] [f finder] [event string]) (asked-with p "fire" f event))

;; The page's clock moved ms ahead, its timers and animation frames running on the way.
(define (page-advance! [p page] [ms u32])
  (let ([b (make-buffer)])
    (field! (& b) "advance")
    (number! (& b) ms)
    (sent p (& b))))

;; ---- reads ----

(define (page-text [p page] [f finder]) -> string (asked p "text" f))

(define (page-html [p page] [f finder]) -> string (asked p "html" f))

(define (page-attribute [p page] [f finder] [name string]) -> string (asked-with p "attribute" f name))

(define (page-attribute? [p page] [f finder] [name string]) -> bool (== (asked-with p "has-attribute" f name) "true"))

(define (page-value [p page] [f finder]) -> string (asked p "value" f))

(define (page-checked? [p page] [f finder]) -> bool (== (asked p "checked" f) "true"))

(define (page-count [p page] [f finder]) -> u32
  (let ([n u64 0])
    (digits-integer (asked p "count" f) 10 #f (& n))
    (cast u32 n)))

;; The commands of the canvas's last drawing, one to a line.
(define (page-drawing [p page] [f finder]) -> string (asked p "drawing" f))

(define (page-console [p page]) -> string
  (let ([b (make-buffer)])
    (field! (& b) "console")
    (sent p (& b))))

(define (page-show [p page] [f finder]) (printf "~a\n" (page-html p f)))

(define (page-show-drawing [p page] [f finder]) (printf "~a\n" (page-drawing p f)))

;; ---- expectations ----

(define (page-expect [p page] [kind string] [f finder] [fields (slice string)] [message string])
  (let ([b (request-of kind f)] [answer string] [why string] [code i32 0])
    (for ([i u32 0]) (< i (-> fields length)) (+= i 1) (field! (& b) (@ fields i)))
    (set! code (page-request (-> p id) (buffer-string (& b)) (& answer) (& why)))
    (buffer-free! (& b))
    (when (< code 0) (throw test-failed (lines-joined message why)))))

(define (count-text [n u32]) -> string
  (let ([b (make-buffer)])
    (write-digits (& b) (cast u64 n) 10)
    (buffer-string (& b))))

(begin-for-syntax
  (require-unqualified macros compiler/macros)

  (define (literal [d datum]) -> datum (datum->syntax #'here d 0))

  (define (message-of [s datum]) -> datum
    (let ([parts (syntax->list s)])
      (literal (format (if (> (length parts) 3) "~a:~a: (~a ~s ~s ...)" "~a:~a: (~a ~s ~s)")
                       `(,(syntax-source s) ,(syntax-line s) ,(syntax-e (car parts)) ,(syntax->datum (cadr parts))
                         ,(syntax->datum (caddr parts)))))))

  (define (path-of [s datum] [file datum]) -> datum
    #`(test-path #,(literal (string->datum (symbol->string (syntax-source s)))) #,file))

  (define (text? [x datum]) -> bool (string? (syntax-e x)))

  (define (no-fields) -> datum #`(slice (cast (ptr string) 0) 0))

  (define (with-page-form [s datum]) -> datum
    (syntax-match s
      [(_ ((? identifier? p) (? text? file) options ...) body ...)
       (let ([markup (literal '"")] [l options])
         (while (pair? l)
           (unless (and (keyword? (syntax-e (car l))) (pair? (cdr l)) (text? (cadr l)))
             (raise-syntax-error 'with-page "expected a keyword and a text" (car l)))
           (if (== (keyword->string (syntax-e (car l))) "page")
               (set! markup (path-of s (cadr l)))
               (raise-syntax-error 'with-page "the option is #:page" (car l)))
           (set! l (cddr l)))
         #`(let ([#,p (page-opened #,(path-of s file) #,markup
                                   #,(literal (format "~a:~a: (with-page (~s ~s) ...)"
                                                      `(,(syntax-source s) ,(syntax-line s) ,(syntax->datum p) ,(syntax-e file)))))])
             (try (begin #,@body (begin)) [catch-all (page-closed! #,p) (rethrow)])
             (page-closed! #,p)))]
      [_ (raise-syntax-error 'with-page "expected (with-page (name \"program.sub\" [#:page \"page.html\"]) body ...)" s)]))

  (define (expect-text-form [s datum]) -> datum
    (syntax-match s
      [(_ p f text) #`(page-expect #,p "expect-text" #,f (slice (array-of string #,text)) #,(message-of s))]
      [_ (raise-syntax-error 'expect-text "expected (expect-text page finder \"text\")" s)]))

  (define (expect-html-form [s datum]) -> datum
    (syntax-match s
      [(_ p f html) #`(page-expect #,p "expect-html" #,f (slice (array-of string #,html)) #,(message-of s))]
      [_ (raise-syntax-error 'expect-html "expected (expect-html page finder \"html\")" s)]))

  (define (expect-value-form [s datum]) -> datum
    (syntax-match s
      [(_ p f value) #`(page-expect #,p "expect-value" #,f (slice (array-of string #,value)) #,(message-of s))]
      [_ (raise-syntax-error 'expect-value "expected (expect-value page finder \"value\")" s)]))

  (define (expect-attribute-form [s datum]) -> datum
    (syntax-match s
      [(_ p f name value)
       #`(page-expect #,p "expect-attribute" #,f (slice (array-of string #,name #,value)) #,(message-of s))]
      [_ (raise-syntax-error 'expect-attribute "expected (expect-attribute page finder \"name\" \"value\")" s)]))

  (define (expect-no-attribute-form [s datum]) -> datum
    (syntax-match s
      [(_ p f name) #`(page-expect #,p "expect-no-attribute" #,f (slice (array-of string #,name)) #,(message-of s))]
      [_ (raise-syntax-error 'expect-no-attribute "expected (expect-no-attribute page finder \"name\")" s)]))

  (define (expect-checked-form [s datum]) -> datum
    (syntax-match s
      [(_ p f on)
       #`(page-expect #,p "expect-checked" #,f (slice (array-of string (if #,on "true" "false"))) #,(message-of s))]
      [_ (raise-syntax-error 'expect-checked "expected (expect-checked page finder #t-or-#f)" s)]))

  (define (expect-count-form [s datum]) -> datum
    (syntax-match s
      [(_ p f n) #`(page-expect #,p "expect-count" #,f (slice (array-of string (count-text #,n))) #,(message-of s))]
      [_ (raise-syntax-error 'expect-count "expected (expect-count page finder n)" s)]))

  (define (expect-missing-form [s datum]) -> datum
    (syntax-match s
      [(_ p f) #`(page-expect #,p "expect-missing" #,f #,(no-fields) #,(message-of s))]
      [_ (raise-syntax-error 'expect-missing "expected (expect-missing page finder)" s)])))

(define-syntax with-page with-page-form)
(define-syntax expect-text expect-text-form)
(define-syntax expect-html expect-html-form)
(define-syntax expect-value expect-value-form)
(define-syntax expect-attribute expect-attribute-form)
(define-syntax expect-no-attribute expect-no-attribute-form)
(define-syntax expect-checked expect-checked-form)
(define-syntax expect-count expect-count-form)
(define-syntax expect-missing expect-missing-form)
