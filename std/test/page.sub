;; The browsers that browser tests open (browser.sub), driven over the DevTools protocol (std/browser/devtools.sub) in
;; the run's Chromium, which substrate test starts and whose address it gives in SUBSTRATE_DEVTOOLS. Each page has a
;; browser context of its own and runs page/install.js before its own scripts; its requests for the site's files and
;; for page/agent.mjs, which reads and checks the page from inside, are answered here. A test's server runs on a worker,
;; and the page reaches only the site, the answers the test gives, and the server's host. A request for the agent is a
;; list of texts, its kind first, as agent.mjs reads it. A failure fails the test with the step of with-browser's body
;; it happened in and the last lines of the page's console.
(require-unqualified host/fs)
(require-unqualified host/node/env)
(require-unqualified host/worker)
(require-unqualified host/modules/clock)
(require-unqualified "../encoding/json.sub")
(require-unqualified "../encoding/base64.sub")
(require-unqualified "../http/url.sub")
(require-unqualified "../package/path.sub")
(require-unqualified "../browser/devtools.sub")

(provide page page-open page-close page-step! page-stepped page-ask page-act! page-check page-click! page-click-at!
         page-hover! page-wheel! page-type! page-press! page-key! page-move-mouse! page-resize! page-go! page-reload!
         page-traversed! page-console page-choose-files! page-downloaded page-pixels page-screenshot page-respond!)

(exception page-failed string)

(struct download [guid string] [name string] [state string])

(struct answer [url string] [status u32] [body string])

(struct page [context string] [target string] [session string] [sessions buffer] [downloads-dir string]
             [site string] [server u32] [server-host string] [answers buffer] [downloads buffer] [lines buffer]
             [thrown bool] [errors buffer] [chosen (slice string)] [choosing bool] [held u32] [mouse-x f64]
             [mouse-y f64] [home string] [documents u32] [stops u32] [landed string] [unreachable string]
             [restored bool])

(struct point [x f64] [y f64] [locked bool])

(define origin string "http://localhost")
(define reserved string "/.substrate-testing/")
(define install string (include-text "page/install.js"))
(define connection devtools)
(define connected bool #f)
(define pages buffer)
(define opened u32 0)
(define work arena)
(define step string "")

;; (guarded page body ...) runs the body and fails the test if the body fails. Either way, it then frees the replies
;; the body read.
(begin-for-syntax
  (require-unqualified compiler/macros)

  (define (guarded-form [s datum]) -> datum
    (syntax-match s
      [(_ b body ...)
       #`(begin
           (try (begin #,@body (uncaught! #,b))
             [catch page-failed (why)
               (arena-free (& work))
               (failed! #,b why)])
           (arena-free (& work)))]
      [_ (raise-syntax-error 'guarded "expected (guarded page body ...)" s)])))

(define-syntax guarded guarded-form)

;; ---- opening and closing ----

(define (page-open [dir string] [url string] [address string] [server (fn ())] [b (ptr (ptr page))] [err (ptr error)])
  -> bool
  (let ([ok #t])
    (set! (@ b) 0)
    (try (set! (@ b) (opened! dir url address server))
      [catch page-failed (why) (set! ok (error-fail! err error-other why))])
    (arena-free (& work))
    ok))

(define (page-close [b (ptr page)])
  (closed! b)
  (arena-free (& work)))

(define (opened! [dir string] [url string] [address string] [server (fn ())]) -> (ptr page)
  (unless connected
    (let ([why error])
      (unless (devtools-connect (& connection) address heard 0 (& why)) (throw page-failed (error-text (& why))))
      (set! connected #t)))
  (let ([b (new 0 page)])
    (+= opened 1)
    (set! (-> b site) (kept (absolute dir)))
    (buffer-add-u32! (& pages) (cast u32 b))
    (try (set-up! b url server)
      [catch page-failed (why)
        (closed! b)
        (throw page-failed why)])
    b))

(define (set-up! [b (ptr page)] [url string] [server (fn ())])
  (let ([base (if (== (cast u32 server) 0) "http://localhost/index.html" (served-from! b server))] [p (params-of)]
        [r (ptr json-value) 0] [start string] [dir string])
    (param-bool! (& p) "disposeOnDetach" #t)
    (set! r (call "Target.createBrowserContext" (params-text (& p)) ""))
    (set! (-> b context) (kept (text-at r "browserContextId")))
    (set! p (params-of))
    (param-string! (& p) "url" "about:blank")
    (param-string! (& p) "browserContextId" (-> b context))
    (set! r (call "Target.createTarget" (params-text (& p)) ""))
    (set! (-> b target) (kept (text-at r "targetId")))
    (set! p (params-of))
    (param-string! (& p) "targetId" (-> b target))
    (param-bool! (& p) "flatten" #t)
    (set! r (call "Target.attachToTarget" (params-text (& p)) ""))
    (set! (-> b session) (kept (text-at r "sessionId")))
    (set! dir (joined-path (scratch) (cat "downloads-" (digits opened))))
    (fs-make-dir dir 0)
    (set! (-> b downloads-dir) dir)
    (set! start (kept (resolved b url base)))
    (set! (-> b home) (origin-of start))
    (page-call b "Fetch.enable" "{\"patterns\":[{\"urlPattern\":\"*\"}]}")
    (page-call b "Runtime.enable" "")
    (page-call b "Page.enable" "")
    (page-call b "Page.setInterceptFileChooserDialog" "{\"enabled\":true}")
    (page-call b "Target.setAutoAttach" "{\"autoAttach\":true,\"waitForDebuggerOnStart\":true,\"flatten\":true}")
    (page-call b "Emulation.setFocusEmulationEnabled" "{\"enabled\":true}")
    (page-call b "Emulation.setDeviceMetricsOverride" "{\"width\":1280,\"height\":800,\"deviceScaleFactor\":1,\"mobile\":false}")
    (set! p (params-of))
    (param-string! (& p) "source" install)
    (page-call b "Page.addScriptToEvaluateOnNewDocument" (params-text (& p)))
    (set! p (params-of))
    (param-raw! (& p) "permissions" "[\"clipboardReadWrite\",\"clipboardSanitizedWrite\"]")
    (param-string! (& p) "browserContextId" (-> b context))
    (call "Browser.grantPermissions" (params-text (& p)) "")
    (set! p (params-of))
    (param-string! (& p) "behavior" "allowAndName")
    (param-string! (& p) "downloadPath" (native-path (absolute dir)))
    (param-string! (& p) "browserContextId" (-> b context))
    (param-bool! (& p) "eventsEnabled" #t)
    (call "Browser.setDownloadBehavior" (params-text (& p)) "")
    (set! p (params-of))
    (param-string! (& p) "url" start)
    (loaded! b "Page.navigate" (params-text (& p)))))

(define (closed! [b (ptr page)])
  (let ([all (opened-pages)] [r (ptr json-value) 0] [p (params-of)])
    (for ([i u32 0]) (< i (-> all length)) (+= i 1)
      (when (== (@ all i) (cast u32 b))
        (memcpy (cast (ptr u8) (+ (-> all items) i)) (cast (ptr u8) (+ (-> all items) (+ i 1))) (* (- (-> all length) (+ i 1)) 4))
        (-= (-> pages length) 4)
        (break)))
    (when (and connected (> (-> b context length) 0))
      (param-string! (& p) "browserContextId" (-> b context))
      (devtools-call (& connection) (& work) "Target.disposeBrowserContext" (params-text (& p)) "" (& r) 0))
    (when (> (-> b downloads-dir length) 0) (fs-remove (-> b downloads-dir) #t 0))
    (unless (== (-> b server) 0) (worker-stop (-> b server)))
    (when (and connected (== (-> pages length) 0))
      (devtools-close (& connection))
      (set! connected #f))))

;; ---- a test's server ----

(define server-head event-head)

(define (unheard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32]) (begin))

;; Starts the server on a worker with the site's directory as its argument, and gives the first line it prints, its
;; address, with index.html after it.
(define (served-from! [b (ptr page)] [server (fn ())]) -> string
  (let ([o worker-options] [why error] [line (make-buffer)] [said (make-buffer)] [until (+ (clock-monotonic) 60000.0)])
    (worker-options-init! (& o))
    (set! (-> o output) #t)
    (set! (-> server-head handle) unheard)
    (unless (worker-start server (cast (slice u8) (-> b site)) (& o) (cast (ptr void) (& server-head)) (& (-> b server))
                          (& why))
      (throw page-failed (error-text (& why))))
    (while #t
      (let ([left (- until (clock-monotonic))] [value i32 0] [bytes (slice u8)] [kind i32 0] [ended string ""])
        (when (<= left 0.0) (throw page-failed "the server did not print its address within 60 s"))
        (set! kind (worker-wait (-> b server) (cast u32 left) (& value) (& bytes)))
        (cond [(== kind (cast i32 worker-stdout))
               (buffer-add! (& line) bytes)
               (let ([text (buffer-string (& line))])
                 (for ([i u32 0]) (< i (-> text length)) (+= i 1)
                   (when (== (@ text i) 10)
                     (let ([address (trimmed (slice text 0 i))])
                       (set! (-> b server-host) (kept (host-of (origin-of address))))
                       (return (cat address "index.html"))))))]
              [(== kind (cast i32 worker-stderr)) (buffer-add! (& said) bytes)]
              [(and (== kind (cast i32 worker-done)) (> (-> bytes length) 0)) (set! ended (cast string bytes))]
              [(== kind (cast i32 worker-ended))
               (set! ended (if (> (-> bytes length) 0) (cast string bytes) (cat "exit " (signed-digits value))))
               (set! (-> b server) 0)]
              [(== kind 0) (throw page-failed "the server did not print its address within 60 s")]
              [(== kind -1)
               (set! (-> b server) 0)
               (set! ended "it stopped")])
        (when (> (-> ended length) 0)
          (let ([out (make-buffer)] [tail (trimmed (buffer-string (& said)))])
            (buffer-add-string! (& out) "the server ended before printing its address: ")
            (buffer-add-string! (& out) ended)
            (when (> (-> tail length) 0)
              (buffer-add-byte! (& out) 10)
              (buffer-add-string! (& out) (if (> (-> tail length) 4000) (slice tail (- (-> tail length) 4000) (-> tail length)) tail)))
            (throw page-failed (buffer-string (& out)))))))
    ""))

;; ---- failures ----

(define (page-step! [s string]) (set! step s))

(define (page-stepped [why string]) -> string (if (== (-> step length) 0) why (cat (cat step "\n") why)))

(define (failed! [b (ptr page)] [why string]) (throw test-failed (page-stepped (with-console b why))))

;; A request fails when the page has thrown an error that nothing caught.
(define (uncaught! [b (ptr page)])
  (let ([errors (strings-in (& (-> b errors)))])
    (when (> (-> errors length) 0)
      (let ([first (@ errors 0)])
        (set! (-> b errors length) 0)
        (throw page-failed (cat "the page has an uncaught error: " (slice first 10 (-> first length))))))))

;; ---- reads and checks ----

(define (page-ask [b (ptr page)] [request (slice string)]) -> string
  (let ([out string]) (guarded b (set! out (kept (agent-text b request)))) out))

(define (page-check [b (ptr page)] [request (slice string)] [message string])
  (try (begin
         (retried b request)
         (uncaught! b))
    [catch page-failed (why)
      (arena-free (& work))
      (let ([m (cat (cat message "\n") (with-console b why))]) (throw test-failed (if (== step message) m (page-stepped m))))])
  (arena-free (& work)))

(define (page-console [b (ptr page)]) -> string
  (let ([out string])
    (guarded b
      (agent b (one-field "settle"))
      (set! out (lines-text b)))
    out))

(define (page-downloaded [b (ptr page)] [name string]) -> string
  (let ([out string]) (guarded b (set! out (cast string (downloaded b name)))) out))

(define (page-pixels [b (ptr page)] [f (slice string)] [x u32] [y u32] [width u32] [height u32]) -> (slice u8)
  (let ([out (slice u8)] [asked (make-buffer)])
    (pushed-text! (& asked) "pixels")
    (pushed-all! (& asked) f)
    (pushed-text! (& asked) (digits x))
    (pushed-text! (& asked) (digits y))
    (pushed-text! (& asked) (digits width))
    (pushed-text! (& asked) (digits height))
    (guarded b (set! out (decoded (text-at (agent b (strings-in (& asked))) "pixels"))))
    out))

(define (page-screenshot [b (ptr page)]) -> (slice u8)
  (let ([out (slice u8)])
    (guarded b
      (agent b (one-field "settle"))
      (set! out (decoded (text-at (page-call b "Page.captureScreenshot" "{\"format\":\"png\"}") "data"))))
    out))

;; ---- what a user does ----

;; An action finishes once the page settles, and follows the page if it goes to another page.
(struct mark [documents u32] [stops u32])

(define (marked [b (ptr page)]) -> mark (mark #:documents (-> b documents) #:stops (-> b stops)))

;; An action counts as done when it fails because the page went on to another page.
(define (act-failed! [b (ptr page)] [m mark] [why string])
  (when (and (== (-> b documents) (-> m documents)) (not (navigated-away? why))) (throw page-failed why)))

(define (page-act! [b (ptr page)] [request (slice string)])
  (guarded b
    (let ([m (marked b)])
      (try (retried b request) [catch page-failed (why) (act-failed! b m why)])
      (followed! b m))))

(define (page-click! [b (ptr page)] [f (slice string)] [button string] [count u32])
  (guarded b
    (let ([m (marked b)])
      (try (clicked! b (pointed b f (none)) button count) [catch page-failed (why) (act-failed! b m why)])
      (followed! b m))))

(define (page-click-at! [b (ptr page)] [f (slice string)] [x u32] [y u32])
  (guarded b
    (let ([m (marked b)] [at (make-buffer)])
      (pushed-text! (& at) (digits x))
      (pushed-text! (& at) (digits y))
      (try (clicked! b (pointed b f (strings-in (& at))) "left" 1) [catch page-failed (why) (act-failed! b m why)])
      (followed! b m))))

(define (page-hover! [b (ptr page)] [f (slice string)])
  (guarded b
    (let ([m (marked b)])
      (try (let ([at (pointed b f (none))]) (unless (-> at locked) (moved! b (-> at x) (-> at y))))
        [catch page-failed (why) (act-failed! b m why)])
      (followed! b m))))

(define (page-wheel! [b (ptr page)] [f (slice string)] [dx i32] [dy i32])
  (guarded b
    (let ([m (marked b)])
      (try (let* ([found (pointed b f (none))] [p (params-of)]
                  [x (if (-> found locked) (-> b mouse-x) (-> found x))] [y (if (-> found locked) (-> b mouse-y) (-> found y))])
             (param-string! (& p) "type" "mouseWheel")
             (param-number! (& p) "x" x)
             (param-number! (& p) "y" y)
             (param-number! (& p) "deltaX" (cast f64 dx))
             (param-number! (& p) "deltaY" (cast f64 dy))
             (param-number! (& p) "modifiers" (cast f64 (-> b held)))
             (page-call b "Input.dispatchMouseEvent" (params-text (& p)))
             (set! (-> b mouse-x) x)
             (set! (-> b mouse-y) y))
        [catch page-failed (why) (act-failed! b m why)])
      (followed! b m))))

(define (page-type! [b (ptr page)] [f (slice string)] [text string])
  (guarded b
    (let ([m (marked b)] [focus (make-buffer)] [i u32 0])
      (pushed-text! (& focus) "focus")
      (pushed-all! (& focus) f)
      (try (begin
             (retried b (strings-in (& focus)))
             (while (< i (-> text length))
               (let ([n (code-point-length (@ text i))])
                 (pressed! b (if (== (@ text i) 10) "Enter" (slice text i (+ i n))) 0)
                 (+= i n))))
        [catch page-failed (why) (act-failed! b m why)])
      (followed! b m))))

(define (page-press! [b (ptr page)] [key string])
  (guarded b
    (let ([m (marked b)])
      (try (let* ([held u32 0] [name (key-of key (& held))]) (pressed! b name held))
        [catch page-failed (why) (act-failed! b m why)])
      (followed! b m))))

(define (page-key! [b (ptr page)] [key string] [down bool])
  (guarded b
    (let* ([m (marked b)] [held u32 0] [name (key-of key (& held))] [bit (modifier-bit name)])
      (when (> bit 0) (set! (-> b held) (if down (bit-or (-> b held) bit) (bit-and (-> b held) (bit-not bit)))))
      (try (key! b (if down "keyDown" "keyUp") name (bit-or (-> b held) held))
        [catch page-failed (why) (act-failed! b m why)])
      (followed! b m))))

(define (page-move-mouse! [b (ptr page)] [dx i32] [dy i32])
  (guarded b
    (let ([m (marked b)])
      (+= (-> b mouse-x) (cast f64 dx))
      (+= (-> b mouse-y) (cast f64 dy))
      (try (moved! b (-> b mouse-x) (-> b mouse-y)) [catch page-failed (why) (act-failed! b m why)])
      (followed! b m))))

(define (page-resize! [b (ptr page)] [width u32] [height u32])
  (guarded b
    (let ([p (params-of)])
      (param-number! (& p) "width" (cast f64 width))
      (param-number! (& p) "height" (cast f64 height))
      (param-number! (& p) "deviceScaleFactor" 1.0)
      (param-bool! (& p) "mobile" #f)
      (page-call b "Emulation.setDeviceMetricsOverride" (params-text (& p)))
      (agent b (one-field "settle")))))

(define (page-go! [b (ptr page)] [url string])
  (guarded b
    (let ([p (params-of)])
      (param-string! (& p) "url" (resolved b url (agent-text b (one-field "url"))))
      (loaded! b "Page.navigate" (params-text (& p))))))

(define (page-reload! [b (ptr page)]) (guarded b (loaded! b "Page.reload" "")))

(define (page-traversed! [b (ptr page)] [delta i32])
  (guarded b
    (let* ([m (marked b)] [h (page-call b "Page.getNavigationHistory" "")] [entries (json-get h "entries")]
           [at (+ (cast i32 (number-at h "currentIndex")) delta)] [p (params-of)])
      (when (or (< at 0) (>= at (cast i32 (json-count entries))))
        (throw page-failed (if (< delta 0) "there is no page to go back to" "there is no page to go forward to")))
      (param-number! (& p) "entryId" (number-at (json-at entries (cast u32 at)) "id"))
      (try (page-call b "Page.navigateToHistoryEntry" (params-text (& p)))
        [catch page-failed (why) (act-failed! b m why)])
      (reached! b (cast f64 at))
      (followed! b m))))

(define (reached! [b (ptr page)] [index f64])
  (let ([until (+ (clock-monotonic) 30000.0)])
    (while (!= (number-at (page-call b "Page.getNavigationHistory" "") "currentIndex") index)
      (when (>= (clock-monotonic) until)
        (throw page-failed "the page did not reach that entry of its history within 30 s"))
      (devtools-pump (& connection) 20.0))))

(define (page-choose-files! [b (ptr page)] [paths (slice string)])
  (guarded b
    (let ([out (make-buffer)] [info fs-info] [why error])
      (for ([i u32 0]) (< i (-> paths length)) (+= i 1)
        (unless (fs-stat (@ paths i) (& info) (& why)) (throw page-failed (error-text (& why))))
        (pushed-text! (& out) (native-path (absolute (@ paths i)))))
      (set! (-> b chosen) (strings-in (& out)))
      (set! (-> b choosing) #t))))

(define (page-respond! [b (ptr page)] [url string] [status u32] [body string])
  (guarded b
    (let ([a (answer #:url (kept (resolved b url (agent-text b (one-field "url")))) #:status status #:body (kept body))])
      (buffer-add! (& (-> b answers)) (slice (cast (ptr u8) (& a)) (sizeof answer))))))

;; followed settles the page and, when it has started going to another page, waits for that page's program to start.
;; A page of another site only has to settle, and a navigation that ends without a new page, as a download does, ends
;; the wait.
(define (followed! [b (ptr page)] [m mark])
  (let ([leaving #f] [until f64 0.0])
    (try (set! leaving (== (agent-text b (one-field "settle")) "leaving")) [catch page-failed (why) (act-failed! b m why) (set! leaving #t)])
    (when (and (not leaving) (== (-> b documents) (-> m documents))) (return))
    (set! until (+ (clock-monotonic) 30000.0))
    (while (== (-> b documents) (-> m documents))
      (when (!= (-> b stops) (-> m stops)) (return))
      (when (>= (clock-monotonic) until)
        (throw page-failed (cat "the page did not reach the page it went to within 30 s\n" (lines-text b))))
      (devtools-pump (& connection) 20.0))
    (when (> (-> b unreachable length) 0)
      (throw page-failed (cat (cat "the page went to " (-> b unreachable)) ", which the browser cannot open")))
    (if (== (origin-of (-> b landed)) (-> b home))
        (begin
          (set! (-> b thrown) #f)
          (when (-> b restored) (evaluated b "window.ready = true"))
          (started! b))
        (agent b (one-field "settle")))))

;; The point to click on the element that the finder f finds. When offset has an x and a y, the point is that far into
;; the element.
(define (pointed [b (ptr page)] [f (slice string)] [offset (slice string)]) -> point
  (let ([asked (make-buffer)] [v (ptr json-value) 0] [locked #f])
    (pushed-text! (& asked) "point")
    (pushed-all! (& asked) f)
    (pushed-all! (& asked) offset)
    (set! v (retried b (strings-in (& asked))))
    (json-as-bool (json-get v "locked") (& locked))
    (point #:x (number-at v "x") #:y (number-at v "y") #:locked locked)))

;; clicked moves the mouse to the point and clicks the button count times, each click counting up from 1. A locked
;; pointer stays where it is.
(define (clicked! [b (ptr page)] [at point] [button string] [count u32])
  (let ([x (if (-> at locked) (-> b mouse-x) (-> at x))] [y (if (-> at locked) (-> b mouse-y) (-> at y))])
    (unless (-> at locked) (moved! b x y))
    (for ([n u32 1]) (<= n count) (+= n 1)
      (pressed-mouse! b "mousePressed" x y button (if (== button "right") 2 1) n)
      (pressed-mouse! b "mouseReleased" x y button 0 n))
    (set! (-> b mouse-x) x)
    (set! (-> b mouse-y) y)))

(define (moved! [b (ptr page)] [x f64] [y f64])
  (let ([p (params-of)])
    (param-string! (& p) "type" "mouseMoved")
    (param-number! (& p) "x" x)
    (param-number! (& p) "y" y)
    (param-number! (& p) "modifiers" (cast f64 (-> b held)))
    (page-call b "Input.dispatchMouseEvent" (params-text (& p)))
    (set! (-> b mouse-x) x)
    (set! (-> b mouse-y) y)))

(define (pressed-mouse! [b (ptr page)] [type string] [x f64] [y f64] [button string] [buttons u32] [count u32])
  (let ([p (params-of)])
    (param-string! (& p) "type" type)
    (param-number! (& p) "x" x)
    (param-number! (& p) "y" y)
    (param-string! (& p) "button" button)
    (param-number! (& p) "buttons" (cast f64 buttons))
    (param-number! (& p) "clickCount" (cast f64 count))
    (param-number! (& p) "modifiers" (cast f64 (-> b held)))
    (page-call b "Input.dispatchMouseEvent" (params-text (& p)))))

;; ---- keys ----

(define (key-name? [k string]) -> bool
  (let ([names (slice (array-of string "Enter" "Tab" "Escape" "Backspace" "Delete" "Insert" "Home" "End" "PageUp"
                                "PageDown" "ArrowUp" "ArrowDown" "ArrowLeft" "ArrowRight" "Shift" "Control" "Alt" "Meta"
                                "CapsLock" "ContextMenu" "F1" "F2" "F3" "F4" "F5" "F6" "F7" "F8" "F9" "F10" "F11" "F12"))])
    (for ([i u32 0]) (< i (-> names length)) (+= i 1) (when (== (@ names i) k) (return #t)))
    #f))

(define (modifier-bit [name string]) -> u32
  (cond [(== name "Shift") 8] [(== name "Control") 2] [(== name "Alt") 1] [(== name "Meta") 4] [else 0]))

;; key-of reads a key written as page-press! takes it. It gives the key and adds the modifiers written before it to
;; held.
(define (key-of [spec string] [held (ptr u32)]) -> string
  (let ([rest spec] [going #t] [key string])
    (when (== (-> spec length) 0) (throw page-failed (cat (quoted spec) " is not a key")))
    (while going
      (set! going #f)
      (for ([m u32 0]) (< m 4) (+= m 1)
        (let ([name (@ (slice (array-of string "Shift" "Control" "Alt" "Meta")) m)])
          (when (and (> (-> rest length) (+ (-> name length) 1)) (starts? rest name) (== (@ rest (-> name length)) #\+))
            (set! (@ held) (bit-or (@ held) (modifier-bit name)))
            (set! rest (slice rest (+ (-> name length) 1) (-> rest length)))
            (set! going #t)
            (break)))))
    (set! key (if (== rest "Space") " " rest))
    (unless (or (key-name? key) (single? key))
      (throw page-failed (cat (quoted spec) " is not a key: a key is a name such as Enter, or one character")))
    (if (and (!= (bit-and (@ held) 8) 0) (== (-> key length) 1) (>= (@ key 0) #\a) (<= (@ key 0) #\z))
        (let ([b (make-buffer)])
          (buffer-add-byte! (& b) (- (cast i32 (@ key 0)) 32))
          (buffer-string (& b)))
        key)))

(define (pressed! [b (ptr page)] [name string] [held u32])
  (let ([order (slice (array-of string "Shift" "Control" "Alt" "Meta"))] [mods (-> b held)])
    (for ([i u32 0]) (< i 4) (+= i 1)
      (let ([m (@ order i)])
        (when (and (!= (bit-and held (modifier-bit m)) 0) (!= name m))
          (set! mods (bit-or mods (modifier-bit m)))
          (key! b "keyDown" m mods))))
    (key! b "keyDown" name mods)
    (key! b "keyUp" name mods)
    (for ([i u32 4]) (> i 0) (-= i 1)
      (let ([m (@ order (- i 1))])
        (when (and (!= (bit-and held (modifier-bit m)) 0) (!= name m))
          (set! mods (bit-and mods (bit-not (modifier-bit m))))
          (key! b "keyUp" m mods))))))

(define (key! [b (ptr page)] [type string] [name string] [mods u32])
  (let* ([text (cond [(== name "Enter") "\r"] [(single? name) name] [else ""])]
         [typing (and (== type "keyDown") (> (-> text length) 0) (== (bit-and mods 7) 0))] [p (params-of)])
    (param-string! (& p) "type" (if (and (== type "keyDown") (not typing)) "rawKeyDown" type))
    (param-string! (& p) "key" name)
    (param-string! (& p) "code" (code-of name))
    (param-number! (& p) "windowsVirtualKeyCode" (cast f64 (key-code name)))
    (param-number! (& p) "modifiers" (cast f64 mods))
    (when typing
      (param-string! (& p) "text" text)
      (param-string! (& p) "unmodifiedText" text))
    (page-call b "Input.dispatchKeyEvent" (params-text (& p)))))

(define (code-of [key string]) -> string
  (let ([c (if (== (-> key length) 1) (@ key 0) 0)])
    (cond [(or (and (>= c #\a) (<= c #\z)) (and (>= c #\A) (<= c #\Z)))
           (let ([b (make-buffer)])
             (buffer-add-string! (& b) "Key")
             (buffer-add-byte! (& b) (if (>= c #\a) (- (cast i32 c) 32) (cast i32 c)))
             (buffer-string (& b)))]
          [(and (>= c #\0) (<= c #\9)) (cat "Digit" key)]
          [(== key " ") "Space"]
          [(key-name? key) key]
          [(== key "-") "Minus"] [(== key "=") "Equal"] [(== key "[") "BracketLeft"] [(== key "]") "BracketRight"]
          [(== key "\\") "Backslash"] [(== key ";") "Semicolon"] [(== key "'") "Quote"] [(== key ",") "Comma"]
          [(== key ".") "Period"] [(== key "/") "Slash"] [(== key "`") "Backquote"]
          [else ""])))

(define (key-code [key string]) -> u32
  (let ([c (if (== (-> key length) 1) (@ key 0) 0)] [n u64 0])
    (cond [(== key "Enter") 13] [(== key "Tab") 9] [(== key "Escape") 27] [(== key "Backspace") 8] [(== key "Delete") 46]
          [(== key "Insert") 45] [(== key "Home") 36] [(== key "End") 35] [(== key "PageUp") 33] [(== key "PageDown") 34]
          [(== key "ArrowLeft") 37] [(== key "ArrowUp") 38] [(== key "ArrowRight") 39] [(== key "ArrowDown") 40]
          [(== key "Shift") 16] [(== key "Control") 17] [(== key "Alt") 18] [(== key "Meta") 91] [(== key "CapsLock") 20]
          [(== key "ContextMenu") 93] [(== key " ") 32] [(== key "-") 189] [(== key "=") 187] [(== key "[") 219]
          [(== key "]") 221] [(== key "\\") 220] [(== key ";") 186] [(== key "'") 222] [(== key ",") 188]
          [(== key ".") 190] [(== key "/") 191] [(== key "`") 192]
          [(and (>= c #\a) (<= c #\z)) (- (cast u32 c) 32)]
          [(or (and (>= c #\A) (<= c #\Z)) (and (>= c #\0) (<= c #\9))) (cast u32 c)]
          [(and (> (-> key length) 1) (== (@ key 0) #\F) (digits-integer (slice key 1 (-> key length)) 10 #f (& n))
                (>= n 1) (<= n 12))
           (+ 111 (cast u32 n))]
          [else 0])))

(define (single? [s string]) -> bool (and (> (-> s length) 0) (== (code-point-length (@ s 0)) (-> s length))))

(define (code-point-length [first u8]) -> u32
  (cond [(< first #x80) 1] [(< first #xE0) 2] [(< first #xF0) 3] [else 4]))

;; ---- the page ----

(define (started! [b (ptr page)])
  (let ([until (+ (clock-monotonic) 30000.0)] [going #t])
    (while going
      (let ([state (ptr json-value) 0] [code i64 0] [reason string])
        (try (set! state (evaluated b "window.ready === true ? [typeof window.ended === 'number' ? window.ended : 0, window.endReason || ''] : null"))
          [catch page-failed (why) (set! state 0)])
        (cond [(== (json-count state) 2)
               (json-as-i64 (json-at state 0) (& code))
               (json-as-string (json-at state 1) (& reason))
               (if (== code 0)
                   (set! going #f)
                   (throw page-failed (cat (cat (ending code reason) "\n") (lines-text b))))]
              [(-> b thrown) (throw page-failed (cat "the page did not start\n" (lines-text b)))]
              [(>= (clock-monotonic) until) (throw page-failed (cat "the page did not start within 30 s\n" (lines-text b)))]
              [else (devtools-pump (& connection) 20.0)]))))
  (agent b (one-field "settle")))

(define (loaded! [b (ptr page)] [method string] [parameters string])
  (try (evaluated b "window.ready = false") [catch page-failed (why) (begin)])
  (set! (-> b thrown) #f)
  (set! (-> b errors length) 0)
  (let ([refusal (text-at (page-call b method parameters) "errorText")])
    (when (> (-> refusal length) 0) (throw page-failed (cat "the browser cannot open the page: " refusal))))
  (started! b))

;; Asks the agent in the page to carry out the request, and gives its answer.
(define (agent [b (ptr page)] [request (slice string)]) -> (ptr json-value)
  (let ([e (make-buffer)] [answer (ptr json-value) 0] [ok #f])
    (buffer-add-string! (& e) "import(")
    (quoted! (& e) (cat reserved "agent.mjs"))
    (buffer-add-string! (& e) ").then((a) => a.request([")
    (for ([i u32 0]) (< i (-> request length)) (+= i 1)
      (when (> i 0) (buffer-add-byte! (& e) #\,))
      (quoted! (& e) (@ request i)))
    (buffer-add-string! (& e) "]))")
    (set! answer (evaluated b (buffer-string (& e))))
    (json-as-bool (json-get answer "ok") (& ok))
    (unless ok (throw page-failed (text-at answer "message")))
    (json-get answer "value")))

(define (agent-text [b (ptr page)] [request (slice string)]) -> string (value-text (agent b request)))

;; retried repeats a request for up to 5 seconds until the page can answer it, since a real browser takes its own time.
;; A request that a navigation interrupts is not repeated, since it may have done what it does.
(define (retried [b (ptr page)] [request (slice string)]) -> (ptr json-value)
  (let ([until (+ (clock-monotonic) 5000.0)] [v (ptr json-value) 0] [done #f])
    (while (not done)
      (try (begin
             (set! v (agent b request))
             (set! done #t))
        [catch page-failed (why)
          (when (or (>= (clock-monotonic) until) (navigated-away? why)) (throw page-failed why))])
      (unless done (devtools-pump (& connection) 20.0)))
    v))

(define (evaluated [b (ptr page)] [expression string]) -> (ptr json-value)
  (let ([p (params-of)] [r (ptr json-value) 0])
    (param-string! (& p) "expression" expression)
    (param-bool! (& p) "awaitPromise" #t)
    (param-bool! (& p) "returnByValue" #t)
    (set! r (page-call b "Runtime.evaluate" (params-text (& p))))
    (let ([ex (json-get r "exceptionDetails")]) (unless (== ex 0) (throw page-failed (described ex))))
    (json-get (json-get r "result") "value")))

;; Resolves url against base, as the page would.
(define (resolved [b (ptr page)] [url string] [base string]) -> string
  (let ([e (make-buffer)])
    (buffer-add-string! (& e) "new URL(")
    (quoted! (& e) url)
    (buffer-add-string! (& e) ", ")
    (quoted! (& e) base)
    (buffer-add-string! (& e) ").href")
    (value-text (evaluated b (buffer-string (& e))))))

(define (downloaded [b (ptr page)] [name string]) -> (slice u8)
  (let ([until (+ (clock-monotonic) 5000.0)])
    (while #t
      (let ([all (cast (ptr download) (-> b downloads bytes))] [n (/ (-> b downloads length) (sizeof download))])
        (for ([i u32 0]) (< i n) (+= i 1)
          (let ([d (+ all i)] [bytes (slice u8)] [why error])
            (when (and (== (-> d name) name) (== (-> d state) "completed"))
              (unless (fs-read-file (joined-path (-> b downloads-dir) (-> d guid)) (& bytes) (& why))
                (throw page-failed (error-text (& why))))
              (return bytes)))))
      (when (>= (clock-monotonic) until) (throw page-failed (cat (cat "no file named " (quoted name)) " was downloaded")))
      (devtools-pump (& connection) 20.0))
    (slice (cast (ptr u8) 0) 0)))

;; ---- events ----

(define (heard [d (ptr devtools)] [method string] [p (ptr json-value)] [session string])
  (cond [(== method "Browser.downloadWillBegin")
         (let ([b (page-of-target (text-at p "frameId"))])
           (unless (== b 0)
             (let ([w (download #:guid (kept (text-at p "guid")) #:name (kept (text-at p "suggestedFilename"))
                                #:state "inProgress")])
               (buffer-add! (& (-> b downloads)) (slice (cast (ptr u8) (& w)) (sizeof download))))))]
        [(== method "Browser.downloadProgress") (progressed! (text-at p "guid") (text-at p "state"))]
        [else
         (let ([b (page-of-session session)])
           (unless (== b 0)
             (cond [(== method "Target.attachedToTarget")
                    (let ([child (kept (text-at p "sessionId"))])
                      (pushed-text! (& (-> b sessions)) child)
                      (devtools-send d "Runtime.enable" "" child)
                      (devtools-send d "Runtime.runIfWaitingForDebugger" "" child))]
                   [(== method "Fetch.requestPaused") (served! b p session)]
                   [(== method "Runtime.consoleAPICalled")
                    (let ([args (json-get p "args")] [line (make-buffer)])
                      (for ([i u32 0]) (< i (json-count args)) (+= i 1)
                        (when (> i 0) (buffer-add-byte! (& line) 32))
                        (buffer-add-string! (& line) (console-text (json-at args i))))
                      (pushed-text! (& (-> b lines)) (buffer-string (& line))))]
                   [(== method "Runtime.exceptionThrown")
                    (let ([line (cat "uncaught: " (described (json-get p "exceptionDetails")))])
                      (pushed-text! (& (-> b lines)) line)
                      (set! (-> b thrown) #t)
                      (pushed-text! (& (-> b errors)) line))]
                   [(== method "Page.fileChooserOpened") (chose! b (number-at p "backendNodeId"))]
                   [(== method "Page.frameNavigated")
                    (let ([frame (json-get p "frame")])
                      (when (== (json-get frame "parentId") 0)
                        (+= (-> b documents) 1)
                        (set! (-> b restored) (== (text-at p "type") "BackForwardCacheRestore"))
                        (set! (-> b landed) (kept (text-at frame "url")))
                        (set! (-> b unreachable) (kept (text-at frame "unreachableUrl")))))]
                   [(== method "Page.frameStoppedLoading")
                    (when (== (text-at p "frameId") (-> b target)) (+= (-> b stops) 1))])))]))

(define (progressed! [guid string] [state string])
  (let ([all (opened-pages)])
    (for ([i u32 0]) (< i (-> all length)) (+= i 1)
      (let* ([b (cast (ptr page) (@ all i))] [ds (cast (ptr download) (-> b downloads bytes))]
             [n (/ (-> b downloads length) (sizeof download))])
        (for ([j u32 0]) (< j n) (+= j 1)
          (when (== (-> (+ ds j) guid) guid) (set! (-> (+ ds j) state) (kept state))))))))

;; served answers a page's request with, in order: the agent's modules, a test's answers, the site's files, with a
;; directory's index.html for a path that ends with a slash, and for a site opened through a test's server, whatever
;; listens on the server's host. Any other request fails.
(define (served! [b (ptr page)] [p (ptr json-value)] [session string])
  (let* ([request (text-at p "requestId")] [href (text-at (json-get p "request") "url")] [from (origin-of href)]
         [a (make-arena)] [path (url-unescape (& a) (path-of-url href) #f)] [found (answer-of b href)]
         [module (if (starts? path reserved) (agent-module (slice path (-> reserved length) (-> path length))) "")])
    (cond [(> (-> module length) 0) (fulfilled! session request 200 "text/javascript" (cast (slice u8) module) #f)]
          [(!= found 0) (fulfilled! session request (-> found status) (type-of path) (cast (slice u8) (-> found body)) #t)]
          [(== from origin)
           (let ([named (make-buffer)] [bytes (slice u8)])
             (buffer-add-string! (& named) path)
             (when (== (@ path (- (-> path length) 1)) #\/) (buffer-add-string! (& named) "index.html"))
             (let* ([file (buffer-string (& named))] [full (resolved-path (-> b site) (slice file 1 (-> file length)))])
               (if (and (within? full (-> b site)) (fs-read-file full (& bytes) 0))
                   (fulfilled! session request 200 (type-of file) bytes #f)
                   (fulfilled! session request 404 "text/plain" (cast (slice u8) "not found") #f)))
             (buffer-free! (& named)))]
          [(and (> (-> b server-host length) 0) (== (host-of from) (-> b server-host)))
           (let ([q (params-of)])
             (param-string! (& q) "requestId" request)
             (devtools-send (& connection) "Fetch.continueRequest" (params-text (& q)) session))]
          [else
           (let ([q (params-of)])
             (param-string! (& q) "requestId" request)
             (param-string! (& q) "errorReason" "Failed")
             (devtools-send (& connection) "Fetch.failRequest" (params-text (& q)) session))])
    (arena-free (& a))))

(define (fulfilled! [session string] [request string] [status u32] [type string] [body (slice u8)] [anyone bool])
  (let ([q (params-of)] [encoded (make-buffer)] [headers (make-buffer)])
    (buffer-add-byte! (& encoded) 34)
    (base64-encode! (& encoded) body)
    (buffer-add-byte! (& encoded) 34)
    (buffer-add-string! (& headers) "[{\"name\":\"Content-Type\",\"value\":")
    (quoted! (& headers) type)
    (buffer-add-string! (& headers) "},{\"name\":\"Cache-Control\",\"value\":\"no-store\"}")
    (when anyone (buffer-add-string! (& headers) ",{\"name\":\"Access-Control-Allow-Origin\",\"value\":\"*\"}"))
    (buffer-add-byte! (& headers) #\])
    (param-string! (& q) "requestId" request)
    (param-number! (& q) "responseCode" (cast f64 status))
    (param-raw! (& q) "body" (buffer-string (& encoded)))
    (param-raw! (& q) "responseHeaders" (buffer-string (& headers)))
    (devtools-send (& connection) "Fetch.fulfillRequest" (params-text (& q)) session)
    (buffer-free! (& encoded))))

;; A file picker that opened gives the files the test chose, or else is cancelled.
(define (chose! [b (ptr page)] [node f64])
  (let ([q (params-of)] [a (make-arena)] [r (ptr json-value) 0] [why error])
    (param-number! (& q) "backendNodeId" node)
    (if (-> b choosing)
        (let ([files (make-buffer)])
          (set! (-> b choosing) #f)
          (buffer-add-byte! (& files) #\[)
          (for ([i u32 0]) (< i (-> b chosen length)) (+= i 1)
            (when (> i 0) (buffer-add-byte! (& files) #\,))
            (quoted! (& files) (@ (-> b chosen) i)))
          (buffer-add-byte! (& files) #\])
          (param-raw! (& q) "files" (buffer-string (& files)))
          (unless (devtools-call (& connection) (& a) "DOM.setFileInputFiles" (params-text (& q)) (-> b session) (& r) (& why))
            (pushed-text! (& (-> b lines)) (cat "files: " (error-text (& why))))))
        (if (devtools-call (& connection) (& a) "DOM.resolveNode" (params-text (& q)) (-> b session) (& r) (& why))
            (let ([p (params-of)])
              (param-string! (& p) "objectId" (text-at (json-get r "object") "objectId"))
              (param-string! (& p) "functionDeclaration" "function () { this.dispatchEvent(new Event('cancel')); }")
              (unless (devtools-call (& connection) (& a) "Runtime.callFunctionOn" (params-text (& p)) (-> b session) (& r) (& why))
                (pushed-text! (& (-> b lines)) (cat "files: " (error-text (& why))))))
            (pushed-text! (& (-> b lines)) (cat "files: " (error-text (& why))))))
    (error-free! (& why))
    (arena-free (& a))))

;; ---- helpers ----

(define (call [method string] [parameters string] [session string]) -> (ptr json-value)
  (let ([r (ptr json-value) 0] [why error])
    (unless (devtools-call (& connection) (& work) method parameters session (& r) (& why))
      (throw page-failed (error-text (& why))))
    r))

(define (page-call [b (ptr page)] [method string] [parameters string]) -> (ptr json-value)
  (call method parameters (-> b session)))

;; The errors Chromium gives for a request to a page that a navigation has replaced.
(define (navigated-away? [why string]) -> bool
  (or (contains? why "Execution context was destroyed") (contains? why "Cannot find context with specified id")
      (contains? why "Inspected target navigated or closed")))

(define (ending [code i64] [reason string]) -> string
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "the program ended with ")
    (when (< code 0) (buffer-add-byte! (& b) #\-))
    (write-digits (& b) (cast u64 (if (< code 0) (- 0 code) code)) 10)
    (when (> (-> reason length) 0)
      (buffer-add-string! (& b) ": ")
      (buffer-add-string! (& b) (first-line reason)))
    (buffer-string (& b))))

(define (described [d (ptr json-value)]) -> string
  (let ([description (text-at (json-get d "exception") "description")])
    (if (> (-> description length) 0) (first-line description) (text-at d "text"))))

(define (with-console [b (ptr page)] [why string]) -> string
  (let ([lines (strings-in (& (-> b lines)))] [out (make-buffer)])
    (buffer-add-string! (& out) why)
    (when (> (-> lines length) 0)
      (buffer-add-string! (& out) "\n  the console ends with:")
      (for ([i u32 (if (> (-> lines length) 10) (- (-> lines length) 10) 0)]) (< i (-> lines length)) (+= i 1)
        (buffer-add-string! (& out) "\n    ")
        (buffer-add-string! (& out) (@ lines i))))
    (buffer-string (& out))))

(define (lines-text [b (ptr page)]) -> string
  (let ([lines (strings-in (& (-> b lines)))] [out (make-buffer)])
    (for ([i u32 0]) (< i (-> lines length)) (+= i 1)
      (when (> i 0) (buffer-add-byte! (& out) 10))
      (buffer-add-string! (& out) (@ lines i)))
    (buffer-string (& out))))

;; A console argument as the console shows it.
(define (console-text [a (ptr json-value)]) -> string
  (let ([v (json-get a "value")])
    (if (!= v 0)
        (value-text v)
        (let ([u (text-at a "unserializableValue")]) (if (> (-> u length) 0) u (text-at a "description"))))))

(define (value-text [v (ptr json-value)]) -> string
  (match v
    [0 ""]
    [(json-null) "null"]
    [(json-boolean x) (if x "true" "false")]
    [(json-number x text) text]
    [(json-string text) text]
    [_ (let ([b (make-buffer)]) (json-write! (& b) v "") (buffer-string (& b)))]))

(define (text-at [v (ptr json-value)] [key string]) -> string
  (let ([s string]) (if (json-as-string (json-get v key) (& s)) s "")))

(define (number-at [v (ptr json-value)] [key string]) -> f64
  (let ([n f64 0.0]) (if (json-as-f64 (json-get v key) (& n)) n 0.0)))

(define (decoded [text string]) -> (slice u8)
  (let ([b (make-buffer)])
    (unless (base64-decode! (& b) text) (throw page-failed "the browser gave bytes that are not Base64"))
    (buffer-bytes (& b))))

(define (none) -> (slice string) (slice (cast (ptr string) 0) 0))

(define (one-field [s string]) -> (slice string)
  (let ([b (make-buffer)]) (pushed-text! (& b) s) (strings-in (& b))))

(define (answer-of [b (ptr page)] [href string]) -> (ptr answer)
  (let ([all (cast (ptr answer) (-> b answers bytes))] [n (/ (-> b answers length) (sizeof answer))])
    (for ([i u32 0]) (< i n) (+= i 1) (when (== (-> (+ all i) url) href) (return (+ all i))))
    0))

(define (opened-pages) -> (slice u32) (slice (cast (ptr u32) (-> pages bytes)) (/ (-> pages length) 4)))

(define (page-of-target [target string]) -> (ptr page)
  (let ([all (opened-pages)])
    (for ([i u32 0]) (< i (-> all length)) (+= i 1)
      (when (== (-> (cast (ptr page) (@ all i)) target) target) (return (cast (ptr page) (@ all i)))))
    0))

(define (page-of-session [session string]) -> (ptr page)
  (let ([all (opened-pages)])
    (for ([i u32 0]) (< i (-> all length)) (+= i 1)
      (let ([b (cast (ptr page) (@ all i))])
        (when (== (-> b session) session) (return b))
        (let ([children (strings-in (& (-> b sessions)))])
          (for ([j u32 0]) (< j (-> children length)) (+= j 1) (when (== (@ children j) session) (return b))))))
    0))

;; The agent's modules, which the page imports from /.substrate-testing/.
(define (agent-module [name string]) -> string
  (cond [(== name "agent.mjs") (include-text "page/agent.mjs")]
        [(== name "find.mjs") (include-text "page/find.mjs")]
        [(== name "requests.mjs") (include-text "page/requests.mjs")]
        [(== name "logs.mjs") (include-text "page/logs.mjs")]
        [else ""]))

(define (scratch) -> string (let ([s string]) (env-get "SUBSTRATE_SCRATCH" (& s) 0) s))

(define (absolute [path string]) -> string
  (let ([here string]) (fs-cwd (& here) 0) (resolved-path here path)))

;; The scheme, host and port of an absolute URL.
(define (origin-of [u string]) -> string
  (let ([i u32 0])
    (while (and (< (+ i 2) (-> u length)) (not (and (== (@ u i) #\:) (== (@ u (+ i 1)) #\/) (== (@ u (+ i 2)) #\/))))
      (+= i 1))
    (when (>= (+ i 2) (-> u length)) (return u))
    (+= i 3)
    (while (and (< i (-> u length)) (!= (@ u i) #\/) (!= (@ u i) #\?) (!= (@ u i) #\#)) (+= i 1))
    (slice u 0 i)))

;; The host of an origin, without its scheme or port.
(define (host-of [o string]) -> string
  (let ([start u32 0] [end u32 0])
    (while (and (< (+ start 2) (-> o length)) (not (and (== (@ o start) #\:) (== (@ o (+ start 1)) #\/))))
      (+= start 1))
    (set! start (if (< (+ start 2) (-> o length)) (+ start 3) 0))
    (set! end start)
    (if (and (< end (-> o length)) (== (@ o end) #\[))
        (while (and (< end (-> o length)) (!= (@ o end) #\])) (+= end 1))
        (while (and (< end (-> o length)) (!= (@ o end) #\:)) (+= end 1)))
    (slice o start (if (and (< end (-> o length)) (== (@ o end) #\])) (+ end 1) end))))

;; The path of an absolute URL, without its query or fragment.
(define (path-of-url [u string]) -> string
  (let* ([start (-> (origin-of u) length)] [end start])
    (while (and (< end (-> u length)) (!= (@ u end) #\?) (!= (@ u end) #\#)) (+= end 1))
    (if (== start end) "/" (slice u start end))))

(define (type-of [path string]) -> string
  (let ([dot (-> path length)] [ext string])
    (for ([i u32 0]) (< i (-> path length)) (+= i 1)
      (cond [(== (@ path i) #\.) (set! dot i)] [(== (@ path i) #\/) (set! dot (-> path length))]))
    (set! ext (lowered (slice path dot (-> path length))))
    (cond [(== ext ".html") "text/html"] [(or (== ext ".mjs") (== ext ".js")) "text/javascript"]
          [(== ext ".json") "application/json"] [(== ext ".css") "text/css"] [(== ext ".wasm") "application/wasm"]
          [(== ext ".png") "image/png"] [(== ext ".gif") "image/gif"] [(or (== ext ".jpg") (== ext ".jpeg")) "image/jpeg"]
          [(== ext ".webp") "image/webp"] [(== ext ".bmp") "image/bmp"] [(== ext ".svg") "image/svg+xml"]
          [(== ext ".wav") "audio/wav"] [(== ext ".mp3") "audio/mpeg"] [(== ext ".ogg") "audio/ogg"]
          [(== ext ".txt") "text/plain"] [else "application/octet-stream"])))

(define (lowered [s string]) -> string
  (let ([b (make-buffer)])
    (for ([i u32 0]) (< i (-> s length)) (+= i 1)
      (let ([c (@ s i)]) (buffer-add-byte! (& b) (cast i32 (if (and (>= c #\A) (<= c #\Z)) (+ c 32) c)))))
    (buffer-string (& b))))

(define (first-line [s string]) -> string
  (let ([i u32 0]) (while (and (< i (-> s length)) (!= (@ s i) 10)) (+= i 1)) (slice s 0 i)))

(define (trimmed [s string]) -> string
  (let ([start u32 0] [end (-> s length)])
    (while (and (< start end) (<= (@ s start) 32)) (+= start 1))
    (while (and (> end start) (<= (@ s (- end 1)) 32)) (-= end 1))
    (slice s start end)))

(define (contains? [s string] [part string]) -> bool
  (for ([i u32 0]) (<= (+ i (-> part length)) (-> s length)) (+= i 1)
    (when (== (slice s i (+ i (-> part length))) part) (return #t)))
  #f)

(define (quoted [s string]) -> string (let ([b (make-buffer)]) (quoted! (& b) s) (buffer-string (& b))))

(define (quoted! [b (ptr buffer)] [s string]) (let ([v (json-string s)]) (json-write! b (& v) "")))

(define (cat [a string] [b string]) -> string
  (let ([out (make-buffer)])
    (buffer-add-string! (& out) a)
    (buffer-add-string! (& out) b)
    (buffer-string (& out))))

(define (digits [n u32]) -> string (let ([b (make-buffer)]) (write-digits (& b) (cast u64 n) 10) (buffer-string (& b))))

(define (signed-digits [n i32]) -> string
  (let ([b (make-buffer)])
    (when (< n 0) (buffer-add-byte! (& b) #\-))
    (write-digits (& b) (cast u64 (if (< n 0) (- 0 n) n)) 10)
    (buffer-string (& b))))

(define (kept [s string]) -> string (let ([b (make-buffer)]) (buffer-add-string! (& b) s) (buffer-string (& b))))

(define (pushed-text! [b (ptr buffer)] [s string]) (buffer-add! b (slice (cast (ptr u8) (& s)) (sizeof string))))

(define (pushed-all! [b (ptr buffer)] [all (slice string)])
  (for ([i u32 0]) (< i (-> all length)) (+= i 1) (pushed-text! b (@ all i))))

(define (strings-in [b (ptr buffer)]) -> (slice string)
  (slice (cast (ptr string) (-> b bytes)) (/ (-> b length) (sizeof string))))
