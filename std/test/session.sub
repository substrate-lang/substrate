;; Sessions in tests. run-session runs a file one form at a time, as sub eval does, using the toolchain, module map and
;; cache that substrate test gives each test. It writes each failed form's error to stderr, without the backtrace.
(require-unqualified compiler/macros)
(require-unqualified compiler/expander)
(require-unqualified compiler/roots)
(require-unqualified host/node/env)
(require-unqualified std/package/path)
(provide run-session)

(define (reported [e datum])
  (let ([s (datum->string e)] [start u32 0])
    (for ([i u32 0]) (<= i (-> s length)) (+= i 1)
      (when (or (== i (-> s length)) (== (@ s i) 10))
        (unless (and (>= (- i start) 4) (== (slice s start (+ start 4)) "    "))
          (host-write 2 (slice (cast (slice u8) s) start (if (< i (-> s length)) (+ i 1) i))))
        (set! start (+ i 1))))))

(define (setting [name string]) -> string (let ([value string]) (env-get name (& value) 0) value))

(define (run-session [file string])
  (let ([map (string->datum (setting "SUBSTRATE_MODULE_MAP"))])
    (set-toolchain-directory! (string->datum (setting "SUBSTRATE_TOOLCHAIN")))
    (install-core!)
    (set-module-map-text! (file-text map) map)
    (set-cache-directory! (string->datum (setting "SUBSTRATE_CACHE")))
    (set-display-directory! (string->datum (parent-of file)))
    (session-open! '"session")
    (session-eval-file! 0 (string->datum file) (lambda ([e datum]) (reported e)))))
