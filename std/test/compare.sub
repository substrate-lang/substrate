;; Comparing texts for tests.

(provide trimmed output-differs! lines-of)

(define (output-differs! [got string] [expected string] [message string])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) message)
    (diff! (& b) expected got)
    (throw test-failed (buffer-string (& b)))))

(define (trimmed [text string]) -> string
  (let ([n (-> text length)]) (while (and (> n 0) (== (@ text (- n 1)) #\newline)) (-= n 1)) (slice text 0 n)))

(define (diff! [b (ptr buffer)] [expected string] [got string])
  (let* ([xs (lines-of expected)] [ys (lines-of got)] [n (-> xs length)] [m (-> ys length)])
    (buffer-add-string! b "\n--- expected\n+++ got")
    (if (or (> n 4000) (> m 4000))
        (begin
          (for ([i u32 0]) (< i n) (+= i 1) (diff-line! b 1 (@ xs i)))
          (for ([j u32 0]) (< j m) (+= j 1) (diff-line! b 2 (@ ys j))))
        (let ([t (new 0 u32 (* (+ n 1) (+ m 1)))] [w (+ m 1)] [kinds (new 0 u8 (+ n m))] [texts (new 0 string (+ n m))]
              [k u32 0] [i u32 0] [j u32 0] [skipped #f])
          (for ([a u32 n]) (> a 0) (-= a 1)
            (for ([c u32 m]) (> c 0) (-= c 1)
              (set! (@ t (+ (* (- a 1) w) (- c 1)))
                    (if (== (@ xs (- a 1)) (@ ys (- c 1)))
                        (+ (@ t (+ (* a w) c)) 1)
                        (let ([down (@ t (+ (* a w) (- c 1)))] [right (@ t (+ (* (- a 1) w) c))])
                          (if (> down right) down right))))))
          (while (or (< i n) (< j m))
            (cond [(and (< i n) (< j m) (== (@ xs i) (@ ys j)))
                   (set! (@ kinds k) 0)
                   (set! (@ texts k) (@ xs i))
                   (+= i 1)
                   (+= j 1)]
                  [(and (< i n) (or (== j m) (>= (@ t (+ (* (+ i 1) w) j)) (@ t (+ (* i w) (+ j 1))))))
                   (set! (@ kinds k) 1)
                   (set! (@ texts k) (@ xs i))
                   (+= i 1)]
                  [else
                   (set! (@ kinds k) 2)
                   (set! (@ texts k) (@ ys j))
                   (+= j 1)])
            (+= k 1))
          (for ([p u32 0]) (< p k) (+= p 1)
            (if (or (!= (@ kinds p) 0) (changed-near? kinds k p))
                (begin
                  (when skipped (buffer-add-string! b "\n  ..."))
                  (set! skipped #f)
                  (diff-line! b (@ kinds p) (@ texts p)))
                (set! skipped #t)))
          (free (-> t items))
          (free (-> kinds items))
          (free (-> texts items))))
    (free (-> xs items))
    (free (-> ys items))))

(define (changed-near? [kinds (slice u8)] [k u32] [p u32]) -> bool
  (for ([q u32 (if (> p 2) (- p 2) 0)]) (and (< q k) (<= q (+ p 2))) (+= q 1)
    (when (!= (@ kinds q) 0) (return #t)))
  #f)

;; kind is 0 for a line in both texts, 1 for one only in expected and 2 for one only in got.
(define (diff-line! [b (ptr buffer)] [kind u32] [line string])
  (buffer-add-string! b (cond [(== kind 1) "\n- "] [(== kind 2) "\n+ "] [else "\n  "]))
  (buffer-add-string! b line))

(define (lines-of [text string]) -> (slice string)
  (let ([n u32 0] [start u32 0] [k u32 0])
    (for ([i u32 0]) (< i (-> text length)) (+= i 1) (when (== (@ text i) #\newline) (+= n 1)))
    (when (and (> (-> text length) 0) (!= (@ text (- (-> text length) 1)) #\newline)) (+= n 1))
    (let ([out (new 0 string (+ n 1))])
      (for ([i u32 0]) (<= i (-> text length)) (+= i 1)
        (when (or (== i (-> text length)) (== (@ text i) #\newline))
          (when (or (< start i) (< i (-> text length)))
            (set! (@ out k) (slice text start i))
            (+= k 1))
          (set! start (+ i 1))))
      (slice out 0 k))))
