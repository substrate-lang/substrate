;; Comparing texts for tests: a difference shown as lines, and the failure that shows it.

(provide contains? trimmed output-differs! lines-of)

(define (contains? [s string] [part string]) -> bool
  (for ([i u32 0]) (<= (+ i (-> part length)) (-> s length)) (+= i 1)
    (when (== (slice s i (+ i (-> part length))) part) (return #t)))
  #f)

(define (output-differs! [got string] [expected string] [message string])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) message)
    (diff! (& b) expected got)
    (throw test-failed (buffer-string (& b)))))

;; trimmed leaves out the newlines at the end of text, which an output file may have or not.
(define (trimmed [text string]) -> string
  (let ([n (-> text length)]) (while (and (> n 0) (== (@ text (- n 1)) 10)) (-= n 1)) (slice text 0 n)))

;; diff! writes the lines of expected and got that differ, as - and + lines with two lines of context, after the longest
;; common subsequence of lines. Past 4000 lines on a side it writes both texts whole.
(define (diff! [b (ptr buffer)] [expected string] [got string])
  (let* ([xs (lines-of expected)] [ys (lines-of got)] [n (-> xs length)] [m (-> ys length)])
    (buffer-add-string! b "\n--- expected\n+++ got")
    (if (or (> n 4000) (> m 4000))
        (begin
          (for ([i u32 0]) (< i n) (+= i 1) (diff-line! b 1 (@ xs i)))
          (for ([j u32 0]) (< j m) (+= j 1) (diff-line! b 2 (@ ys j))))
        (let ([t (cast (ptr u32) (calloc (* (+ n 1) (+ m 1)) 4))] [w (+ m 1)]
              [kinds (cast (ptr u8) (malloc (+ n m)))] [texts (cast (ptr string) (malloc (* (+ n m) (sizeof string))))]
              [k u32 0] [i u32 0] [j u32 0] [skipped #f])
          (for ([a u32 n]) (> a 0) (-= a 1)
            (for ([c u32 m]) (> c 0) (-= c 1)
              (set! (@ t (+ (* (- a 1) w) (- c 1)))
                    (if (== (@ xs (- a 1)) (@ ys (- c 1)))
                        (+ (@ t (+ (* a w) c)) 1)
                        (let ([down (@ t (+ (* a w) (- c 1)))] [right (@ t (+ (* (- a 1) w) c))])
                          (if (> down right) down right))))))
          (while (or (< i n) (< j m))
            (cond [(and (< i n) (< j m) (== (@ xs i) (@ ys j)))
                   (set! (@ kinds k) 0)
                   (set! (@ texts k) (@ xs i))
                   (+= i 1)
                   (+= j 1)]
                  [(and (< i n) (or (== j m) (>= (@ t (+ (* (+ i 1) w) j)) (@ t (+ (* i w) (+ j 1))))))
                   (set! (@ kinds k) 1)
                   (set! (@ texts k) (@ xs i))
                   (+= i 1)]
                  [else
                   (set! (@ kinds k) 2)
                   (set! (@ texts k) (@ ys j))
                   (+= j 1)])
            (+= k 1))
          (for ([p u32 0]) (< p k) (+= p 1)
            (if (or (!= (@ kinds p) 0) (changed-near? kinds k p))
                (begin
                  (when skipped (buffer-add-string! b "\n  ..."))
                  (set! skipped #f)
                  (diff-line! b (@ kinds p) (@ texts p)))
                (set! skipped #t)))
          (free (cast (ptr u8) t))
          (free kinds)
          (free (cast (ptr u8) texts))))
    (free (cast (ptr u8) (-> xs items)))
    (free (cast (ptr u8) (-> ys items)))))

(define (changed-near? [kinds (ptr u8)] [k u32] [p u32]) -> bool
  (for ([q u32 (if (> p 2) (- p 2) 0)]) (and (< q k) (<= q (+ p 2))) (+= q 1)
    (when (!= (@ kinds q) 0) (return #t)))
  #f)

;; kind is 0 for a line in both texts, 1 for one only in expected and 2 for one only in got.
(define (diff-line! [b (ptr buffer)] [kind u32] [line string])
  (buffer-add-string! b (cond [(== kind 1) "\n- "] [(== kind 2) "\n+ "] [else "\n  "]))
  (buffer-add-string! b line))

;; lines-of splits text at newlines; a final newline ends the last line.
(define (lines-of [text string]) -> (slice string)
  (let ([n u32 0] [start u32 0] [k u32 0])
    (for ([i u32 0]) (< i (-> text length)) (+= i 1) (when (== (@ text i) 10) (+= n 1)))
    (when (and (> (-> text length) 0) (!= (@ text (- (-> text length) 1)) 10)) (+= n 1))
    (let ([out (cast (ptr string) (malloc (* (+ n 1) (sizeof string))))])
      (for ([i u32 0]) (<= i (-> text length)) (+= i 1)
        (when (or (== i (-> text length)) (== (@ text i) 10))
          (when (or (< start i) (< i (-> text length)))
            (set! (@ out k) (slice text start i))
            (+= k 1))
          (set! start (+ i 1))))
      (slice out k))))
