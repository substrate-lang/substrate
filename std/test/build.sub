;; Building programs during a test: expect-compile-error, and program-write!, which with-browser uses to build sites.
;; build-ready! gives the compiler the test program's toolchain, module map and cache, once.
(require-unqualified compiler/macros)
(require-unqualified compiler/expander)
(require-unqualified compiler/roots)
(require-unqualified compiler/main)
(require-unqualified host/fs)
(require-unqualified host/node/env)
(require-unqualified "../package/path.sub")
(require-unqualified "test.sub")
(require-unqualified "compare.sub")
(require-unqualified "../string.sub")

(provide expect-compile-error program-write! build-ready!)

(define ready bool #f)
(define directory string)

(define (build-ready!)
  (unless ready
    (set! ready #t)
    (let ([why error] [toolchain string] [map-file string] [cache string])
      (unless (fs-cwd (& directory) (& why)) (throw test-failed (error-text (& why))))
      (env-get "SUBSTRATE_TOOLCHAIN" (& toolchain) 0)
      (env-get "SUBSTRATE_MODULE_MAP" (& map-file) 0)
      (env-get "SUBSTRATE_CACHE" (& cache) 0)
      (set-toolchain-directory! (string->datum toolchain))
      (install-core!)
      (let ([map (string->datum map-file)]) (set-module-map-text! (file-text map) map))
      (set-cache-directory! (string->datum cache)))))

;; Builds the program at path into out, both relative to the package's directory, with the test program's module map
;; and cache. Returns #f with the compile error in err if it does not compile.
(define (program-write! [path string] [out string] [strip bool] [err (ptr buffer)]) -> bool
  (build-ready!)
  (let ([full (resolved-path directory path)] [to (resolved-path directory out)])
    (set-display-directory! (string->datum (parent-of full)))
    (fs-remove to #t 0)
    (try (begin (write-program! 0 (string->datum full) (string->datum to) strip) #t)
         [catch compile-error (message blamed loc)
           (write-error err message blamed loc)
           #f])))

(define (compile-error-check [path string] [text string] [message string])
  (let ([err (make-buffer)])
    (when (program-write! path (joined-path (joined-path (scratch-directory) "programs") (program-name path)) #f
                          (& err))
      (failure! message "the file compiled"))
    (unless (string-contains? (buffer-string (& err)) text) (failure! message (text-of "its compile error is\n" (buffer-string (& err)))))
    (buffer-free! (& err))))

(define (failure! [message string] [detail string]) (throw test-failed (text-of (text-of message "\n") detail)))

(define (text-of [a string] [b string]) -> string
  (let ([out (make-buffer)])
    (buffer-add-string! (& out) a)
    (buffer-add-string! (& out) b)
    (buffer-string (& out))))

(define (program-name [path string]) -> string
  (let ([name (if (string-suffix? path ".sub") (slice path 0 (- (-> path length) 4)) path)])
    (while (string-prefix? name "../") (set! name (slice name 3 (-> name length))))
    name))

;; ---- the form ----

(begin-for-syntax
  (require-unqualified compiler/macros)

  (define (literal [d datum]) -> datum (datum->syntax #'here d 0))

  (define (message-of [s datum] [first datum]) -> datum
    (literal (format "~a:~a: (~a ~s ...)" `(,(syntax-source s) ,(syntax-line s) ,(syntax-e (car (syntax->list s))) ,(syntax->datum first)))))

  (define (path-of [s datum] [file datum]) -> datum
    #`(test-path #,(literal (string->datum (symbol->string (syntax-source s)))) #,file))

  (define (text? [x datum]) -> bool (string? (syntax-e x)))

  (define (expect-compile-error-form [s datum]) -> datum
    (syntax-match s
      [(_ (? text? file) (? text? text))
       #`(compile-error-check #,(path-of s file) #,text #,(message-of s file))]
      [_ (raise-syntax-error 'expect-compile-error "expected (expect-compile-error \"path\" \"text\")" s)])))

(define-syntax expect-compile-error expect-compile-error-form)
