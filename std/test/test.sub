;; The test runner, and expect-output and expect-output-file. A test with #:worker or #:grants runs on a worker of its
;; own, with the program's grants or the ones listed, and ends as a program does; #:output and #:output-file check all
;; that a test printed.
(require-unqualified fs host/fs)
(require-unqualified events host/events)
(require-unqualified timer host/modules/timer)
(require-unqualified clock host/modules/clock)
(require-unqualified gr host/grants)
(require-unqualified worker host/worker)
(require-unqualified compare "compare.sub")

(provide run-tests expect-output expect-output-file test-option test-flag? test-path scratch-directory test-skipped
         compare-output! compare-output-file!)

;; ---- the runner ----

;; A test that throws test-skipped counts as skipped, for the reason it gives.
(exception test-skipped string)

(struct entry [module string] [name string] [line u32] [skip string] [traps string] [worker bool]
              [grants (slice (slice string))] [output string] [output-file string] [run (fn ())])

(define entries (ptr entry) 0)
(define entry-count u32 0)
(define entry-room u32 0)

(define (add-test! [module string] [name string] [line u32] [ignored bool] [traps string] [platforms string]
                   [worker bool] [grants (slice (slice string))] [output string] [output-file string] [run (fn ())])
  (when (== entry-count entry-room)
    (set! entry-room (if (== entry-room 0) 64 (* entry-room 2)))
    (set! entries (cast (ptr entry) (realloc (cast (ptr void) entries) (* entry-room (sizeof entry))))))
  (let ([e (& (@ entries entry-count))])
    (set! (-> e module) module)
    (set! (-> e name) name)
    (set! (-> e line) line)
    (set! (-> e skip) (let ([why (not-here platforms)]) (if (or (> (-> why length) 0) (not ignored)) why "ignored")))
    (set! (-> e traps) traps)
    (set! (-> e worker) worker)
    (set! (-> e grants) (kept-clauses grants))
    (set! (-> e output) output)
    (set! (-> e output-file) output-file)
    (set! (-> e run) run))
  (+= entry-count 1))

;; The clauses on the heap, since a test on a worker reads them after main has returned.
(define (kept-clauses [clauses (slice (slice string))]) -> (slice (slice string))
  (when (== (-> clauses length) 0) (return clauses))
  (let ([out (cast (ptr (slice string)) (malloc (* (-> clauses length) (sizeof (slice string)))))])
    (for ([i u32 0]) (< i (-> clauses length)) (+= i 1)
      (let* ([c (@ clauses i)] [items (cast (ptr string) (malloc (* (-> c length) (sizeof string))))])
        (for ([j u32 0]) (< j (-> c length)) (+= j 1) (set! (@ items j) (@ c j)))
        (set! (@ out i) (slice items (-> c length)))))
    (slice out (-> clauses length))))

(define system string "")

;; Why a test with these marks does not run here, or "" when it does. A test that names systems runs only on those, and
;; one marked #:webgpu does not run without Chromium (--no-chromium) or with --no-webgpu.
(define (not-here [marks string]) -> string
  (when (== (-> marks length) 0) (return ""))
  (when (== (-> system length) 0) (set! system (host-os)))
  (let ([start u32 0] [systems #f] [on-one #f] [webgpu #f])
    (for ([i u32 0]) (<= i (-> marks length)) (+= i 1)
      (when (or (== i (-> marks length)) (== (@ marks i) #\space))
        (let ([p (slice marks start i)])
          (cond [(== p "webgpu") (set! webgpu #t)]
                [else
                 (set! systems #t)
                 (when (or (== p system) (and (== p "unix") (!= system "windows") (!= system "web"))) (set! on-one #t))]))
        (set! start (+ i 1))))
    (cond [(and systems (not on-one)) "only on other systems"]
          [(and webgpu (test-flag? "--no-chromium")) "need Chromium"]
          [(and webgpu (test-flag? "--no-webgpu")) "left out by --no-webgpu"]
          [else ""])))

(define (test-flag? [flag string]) -> bool
  (let ([args (host-args)])
    (for ([i u32 0]) (< i (-> args length)) (+= i 1) (when (== (@ args i) flag) (return #t)))
    #f))

(define arguments (slice string))
(define package-name string "")
(define running-file string "")
(define verbose bool #f)
(define ignored-only bool #f)
(define capturing bool #t)

(define (options!)
  (set! arguments (host-args))
  (set! package-name (test-option "--name"))
  (set! running-file (test-option "--running"))
  (for ([i u32 0]) (< i (-> arguments length)) (+= i 1)
    (let ([a (@ arguments i)])
      (cond [(== a "-v") (set! verbose #t)]
            [(== a "--ignored") (set! ignored-only #t)]
            [(== a "--nocapture") (set! capturing #f)]))))

(define (valued? [a string]) -> bool
  (or (== a "--name") (== a "--toolchain") (== a "--chromium") (== a "--chromium-args") (== a "--map") (== a "--cache")
      (== a "--scratch") (== a "--running")))

(define (flag? [a string]) -> bool
  (or (== a "-v") (== a "--ignored") (== a "--nocapture") (== a "--check-cache") (== a "--no-webgpu") (== a "--no-chromium")))

(define (test-option [name string]) -> string
  (let ([args (host-args)])
    (for ([i u32 0]) (< (+ i 1) (-> args length)) (+= i 1) (when (== (@ args i) name) (return (@ args (+ i 1)))))
    ""))

(define (scratch-directory) -> string
  (let ([d string] [why string])
    (when (< (fs-make-temp-dir (test-option "--scratch") "" "" (& d) (& why)) 0) (throw test-failed why))
    d))

(define (selected? [e (ptr entry)]) -> bool
  (let ([any #f] [i u32 0])
    (while (< i (-> arguments length))
      (let ([a (@ arguments i)])
        (cond [(valued? a) (+= i 1)]
              [(flag? a) (begin)]
              [else
               (set! any #t)
               (when (or (contains? (-> e name) a) (contains? (-> e module) a)) (return #t))]))
      (+= i 1))
    (not any)))

(define next u32 0)
(define current u32 0)
(define passed u32 0)
(define failed u32 0)
(define skip-reasons (array string 16))
(define skip-counts (array u32 16))
(define skip-kinds u32 0)
(define started f64 0.0)
(define captured buffer)
(define resume event-head)
(define handlers u32 0)

(define (run!)
  (options!)
  (trap-handler! trapped)
  (set! (-> resume handle) resumed)
  (set! started (clock-monotonic))
  (run-from! 0))

(define (run-from! [i u32])
  (set! next i)
  (while (< next entry-count)
    (set! current next)
    (+= next 1)
    (let ([e (& (@ entries current))])
      (cond [(not (selected? e)) (begin)]
            [(== (-> (-> e skip) length) 0) (when (and (not ignored-only) (run-one! e)) (return))]
            [(and (== (-> e skip) "ignored") ignored-only) (when (run-one! e) (return))]
            [else (skipped! e (-> e skip))])))
  (finish!))

;; Whether the test goes on, on a worker, after run-one! returns.
(define (run-one! [e (ptr entry)]) -> bool
  (when (> (-> running-file length) 0)
    (let ([b (make-buffer)])
      (buffer-add-string! (& b) (-> e module))
      (buffer-add-byte! (& b) #\:)
      (write-digits (& b) (-> e line) 10)
      (buffer-add-byte! (& b) 32)
      (buffer-add-string! (& b) (-> e name))
      (fs-write-file running-file (buffer-bytes (& b)) 0)
      (buffer-free! (& b))))
  (set! (-> captured length) 0)
  (when (-> e worker) (return (worker-started! e)))
  (set! handlers (trap-handler-count))
  (when (or capturing (> (-> e output length) 0) (> (-> e output-file length) 0)) (output-to! (& captured)))
  (try (begin
         ((-> e run))
         (output-to! 0)
         (ended! e))
       [catch test-failed (message)
         (output-to! 0)
         (failed! e message)]
       [catch test-skipped (why)
         (output-to! 0)
         (skipped! e why)])
  (trap-handlers-keep! handlers)
  #f)

;; A test that ran to its end passes if it expected no trap and printed what it should.
(define (ended! [e (ptr entry)])
  (if (> (-> (-> e traps) length) 0)
      (failed! e (trap-expected (-> e traps)))
      (begin
        (cond [(> (-> e output length) 0)
               (compare-output! (buffer-string (& captured)) (-> e output) (where-of e "#:output"))]
              [(> (-> e output-file length) 0)
               (compare-output-file! (buffer-string (& captured)) (-> e module) (-> e output-file)
                                     (where-of e "#:output-file"))])
        (passed! e))))

(define (where-of [e (ptr entry)] [what string]) -> string
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) (-> e module))
    (buffer-add-byte! (& b) #\:)
    (write-digits (& b) (-> e line) 10)
    (buffer-add-string! (& b) ": ")
    (buffer-add-string! (& b) what)
    (buffer-string (& b))))

;; ---- tests on workers ----

;; A test on a worker is its own function run as the worker's, where a failure traps (compiler/checker.sub).
(define watched event-head)
(define watched-entry (ptr entry) 0)

(define (worker-started! [e (ptr entry)]) -> bool
  (let ([o worker-options] [why string])
    (worker-options-init! (& o))
    (set! (-> o output) #t)
    (set! (-> o ends) #t)
    (set! (-> o args) (host-args))
    (when (> (-> e grants length) 0)
      (set! (-> o grants) (make-grants))
      (for ([i u32 0]) (< i (-> e grants length)) (+= i 1)
        (let ([c (@ (-> e grants) i)] [items (make-buffer)])
          (for ([j u32 1]) (< j (-> c length)) (+= j 1) (pushed! (& items) (scratch-placed (@ c j))))
          (unless (grants-add! (& (-> o grants)) (@ c 0) (strings-in (& items)) (& why))
            (failed! e why)
            (return #f)))))
    (set! watched-entry e)
    (set! (-> watched handle) heard)
    (when (== (worker-start (-> e run) (slice (cast (ptr u8) 0) 0) (& o) (cast (ptr void) (& watched)) (& why)) 0)
      (failed! e why)
      (return #f))
    #t))

(define (heard [source u32] [kind u32] [w u32] [tag (ptr void)] [value i32])
  (let ([data (events-take-text)])
    (cond [(or (== kind worker-stdout) (== kind worker-stderr))
           (buffer-add-string! (& captured) data)
           (unless capturing (host-write (if (== kind worker-stderr) 2 1) (cast (slice u8) data)))]
          [(== kind worker-ended) (worker-ended! value data)])
    (free (-> data bytes))))

(define (worker-ended! [code i32] [reason string])
  (let ([e watched-entry] [report (make-buffer)])
    (buffer-add-string! (& report) "error: ")
    (buffer-add-string! (& report) reason)
    (buffer-add-byte! (& report) 10)
    (when (ends-with? (buffer-string (& captured)) (buffer-string (& report)))
      (-= (-> captured length) (-> report length)))
    (buffer-free! (& report))
    (cond [(< code 0)
           (if (and (> (-> (-> e traps) length) 0) (contains? reason (-> e traps)))
               (passed! e)
               (failed! e (without-runner reason)))]
          [(!= code 0)
           (let ([b (make-buffer)])
             (buffer-add-string! (& b) "the test ended with exit code ")
             (write-digits (& b) (cast u64 code) 10)
             (failed! e (buffer-string (& b))))]
          [else (try (ended! e) [catch test-failed (message) (failed! e message)])])
    (run-from! next)))

(define (scratch-placed [text string]) -> string
  (let ([b (make-buffer)] [i u32 0])
    (while (< i (-> text length))
      (if (and (<= (+ i 8) (-> text length)) (== (slice text i (+ i 8)) "$SCRATCH"))
          (begin
            (buffer-add-string! (& b) (test-option "--scratch"))
            (+= i 8))
          (begin
            (buffer-add-byte! (& b) (cast i32 (@ text i)))
            (+= i 1))))
    (buffer-string (& b))))

(define (ends-with? [s string] [end string]) -> bool
  (and (>= (-> s length) (-> end length)) (== (slice s (- (-> s length) (-> end length)) (-> s length)) end)))

(define (pushed! [b (ptr buffer)] [s string]) (buffer-add! b (slice (cast (ptr u8) (& s)) (sizeof string))))

(define (strings-in [b (ptr buffer)]) -> (slice string)
  (slice (cast (ptr string) (-> b bytes)) (/ (-> b length) (sizeof string))))

(define (trap-expected [traps string]) -> string
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "the test ended without the trap it expects, with the message ")
    (write-string (& b) traps)
    (buffer-string (& b))))

(define (trapped [why string])
  (trap-handlers-keep! handlers)
  (output-to! 0)
  (let ([e (& (@ entries current))])
    (if (and (> (-> (-> e traps) length) 0) (contains? why (-> e traps))) (passed! e) (failed! e (without-runner why))))
  (timer-after 0.0 (cast (ptr void) (& resume))))

(define (without-runner [why string]) -> string
  (let ([ls (lines-of why)] [b (make-buffer)])
    (for ([i u32 0]) (< i (-> ls length)) (+= i 1)
      (unless (contains? (@ ls i) " std/test/test.sub:")
        (when (> (-> b length) 0) (buffer-add-byte! (& b) 10))
        (buffer-add-string! (& b) (@ ls i))))
    (free (cast (ptr u8) (-> ls items)))
    (buffer-string (& b))))

(define (resumed [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32]) (run-from! next))

(define (passed! [e (ptr entry)])
  (+= passed 1)
  (when verbose (printf "ok ~a:~a ~a~n" (-> e module) (-> e line) (-> e name))))

(define (skipped! [e (ptr entry)] [why string])
  (let ([k u32 0])
    (while (and (< k skip-kinds) (!= (@ skip-reasons k) why)) (+= k 1))
    (when (and (== k skip-kinds) (< k 16))
      (set! (@ skip-reasons k) why)
      (+= skip-kinds 1))
    (when (< k 16) (set! (@ skip-counts k) (+ (@ skip-counts k) 1))))
  (when verbose
    (if (== why "ignored")
        (printf "ignored ~a:~a ~a~n" (-> e module) (-> e line) (-> e name))
        (printf "skipped ~a:~a ~a: ~a~n" (-> e module) (-> e line) (-> e name) why))))

(define (failed! [e (ptr entry)] [message string])
  (+= failed 1)
  (printf "FAIL ~a:~a ~a~n" (-> e module) (-> e line) (-> e name))
  (indented message "  ")
  (when (> (-> captured length) 0)
    (printf "  output:~n")
    (indented (buffer-string (& captured)) "    ")))

(define (indented [text string] [prefix string])
  (let ([start u32 0])
    (for ([i u32 0]) (<= i (-> text length)) (+= i 1)
      (when (or (== i (-> text length)) (== (@ text i) 10))
        (when (< start i) (printf "~a~a~n" prefix (slice text start i)))
        (when (and (== start i) (< i (-> text length))) (printf "~n"))
        (set! start (+ i 1))))))

(define (finish!)
  (output-to! 0)
  (let ([tenths (cast u64 (nearbyint (/ (- (clock-monotonic) started) 100.0)))])
    (printf "~a: ~a passed" package-name passed)
    (when (> failed 0) (printf ", ~a failed" failed))
    (for ([k u32 0]) (< k skip-kinds) (+= k 1) (printf ", ~a ~a" (@ skip-counts k) (@ skip-reasons k)))
    (printf " (~a.~a s)~n" (/ tenths 10) (% tenths 10)))
  (host-exit (if (> failed 0) 1 0)))

;; ---- printed output ----

(define (compare-output! [got string] [expected string] [message string])
  (unless (== (trimmed got) (trimmed expected))
    (output-differs! got expected message)))

(define (compare-output-file! [got string] [module string] [file string] [message string])
  (let ([why string] [bytes (slice u8)] [path (test-path module file)])
    (when (< (fs-read-file path (& bytes) (& why)) 0)
      (let ([b (make-buffer)])
        (buffer-add-string! (& b) message)
        (buffer-add-byte! (& b) 10)
        (buffer-add-string! (& b) why)
        (throw test-failed (buffer-string (& b)))))
    (unless (== (trimmed got) (trimmed (cast string bytes))) (output-differs! got (cast string bytes) message))
    (free (-> bytes items))))

(define (test-path [module string] [file string]) -> string
  (let ([start u32 0] [end u32 0] [b (make-buffer)])
    (for ([i u32 0]) (< i (-> module length)) (+= i 1)
      (when (== (@ module i) #\/)
        (when (== start 0) (set! start (+ i 1)))
        (set! end (+ i 1))))
    (buffer-add-string! (& b) (slice module start (if (< end start) start end)))
    (buffer-add-string! (& b) file)
    (buffer-string (& b))))

;; ---- the forms ----

(begin-for-syntax
  (require-unqualified macros compiler/macros)

  (define (literal [d datum]) -> datum (datum->syntax #'here d 0))

  (define (run-tests-form [s datum]) -> datum
    (let ([adds nil])
      (for/each ([m (cdr (syntax->list s))])
        (let ([found nil])
          (for/each ([name (syntax-local-module-provides m)])
            (let ([text (symbol->string name)])
              (when (and (> (-> text length) 6) (== (slice text 0 6) "%test-"))
                (let* ([id (datum->syntax m (string->symbol (format-message "~a:~a" `(,(syntax-e m) ,name))) m)]
                       [fact (test-fact (syntax-local-facts id))])
                  (when (pair? fact)
                    (set! found (cons (cons fact id) found)))))))
          (for/each ([f (sort found (lambda ([a datum] [b datum]) -> bool
                                      (< (integer-value (caddr (car a))) (integer-value (caddr (car b))))))])
            (let ([info (cdr (car f))])
              (set! adds (cons #`(add-test! #,(literal (car (car f))) #,(literal (car info)) #,(literal (cadr info))
                                            #,(literal (caddr info)) #,(literal (cadddr info)) #,(literal (list-ref info 4))
                                            #,(literal (list-ref info 5)) #,(grants-code (list-ref info 6))
                                            #,(literal (list-ref info 7)) #,(literal (list-ref info 8)) #,(cdr f))
                               adds))))))
      #`(begin #,@(reverse adds) (run!))))

  (define (grants-code [clauses datum]) -> datum
    (let ([codes nil])
      (for/each ([c clauses])
        (let ([texts nil])
          (for/each ([t c]) (set! texts (cons (literal t) texts)))
          (set! codes (cons #`(slice (array-of string #,@(reverse texts))) codes))))
      (if (null? clauses)
          #'(slice (cast (ptr (slice string)) 0) 0)
          #`(slice (array-of (slice string) #,@(reverse codes))))))

  (define (test-fact [facts datum]) -> datum
    (for/each ([f facts])
      (let ([v (caddr f)])
        (when (and (pair? v) (== (car v) 'test))
          (return (cons (string->datum (symbol->string (car f))) (cdr v))))))
    nil)

  (define (message-of [s datum] [first datum]) -> datum
    (literal (format "~a:~a: (~a ~s ...)" `(,(syntax-source s) ,(syntax-line s) ,(syntax-e (car (syntax->list s))) ,(syntax->datum first)))))

  (define (expect-output-form [s datum]) -> datum
    (syntax-match s
      [(_ text body ...) (captured-code s #`(compare-output! got #,text #,(message-of s text)) body)]
      [_ (raise-syntax-error 'expect-output "expected (expect-output \"text\" body ...)" s)]))

  (define (expect-output-file-form [s datum]) -> datum
    (syntax-match s
      [(_ file body ...)
       (unless (string? (syntax-e file)) (raise-syntax-error 'expect-output-file "expected a file's path as text" file))
       (captured-code s #`(compare-output-file! got #,(module-of s) #,file #,(message-of s file))
                      body)]
      [_ (raise-syntax-error 'expect-output-file "expected (expect-output-file \"path\" body ...)" s)]))

  (define (captured-code [s datum] [compare datum] [body datum]) -> datum
    #`(let ([b (make-buffer)])
        (let ([before (output-to! (& b))])
          #,@body
          (output-to! before)
          (let ([got (buffer-string (& b))]) #,compare)
          (buffer-free! (& b)))))

  (define (module-of [s datum]) -> datum (literal (string->datum (symbol->string (syntax-source s))))))

(define-syntax run-tests run-tests-form)
(define-syntax expect-output expect-output-form)
(define-syntax expect-output-file expect-output-file-form)
