;; Tests of web programs in Chromium. with-browser builds a site, as substrate site does, and opens it in the run's
;; Chromium (page.sub). Finders pick out elements, and actions, reads and expectations use them as a user would. A
;; package whose tests open browsers says (browser) in its tests clause, and substrate test then starts Chromium.
;;
;; Chromium runs headless with WebGPU enabled; SUBSTRATE_CHROMIUM_ARGS adds arguments, separated by spaces. Tests marked
;; #:webgpu need Chromium to draw WebGPU canvases, and --no-webgpu leaves them out. On Linux, headless Chromium draws
;; them only on its software GPU: --enable-unsafe-swiftshader --enable-features=Vulkan --use-vulkan=swiftshader
;; --use-angle=vulkan
(require-unqualified host/fs)
(require-unqualified host/node/env)
(require-unqualified "page.sub")
(require-unqualified "test.sub")
(require-unqualified "build.sub")
(require-unqualified "../package/manifest.sub")
(require-unqualified "../package/site.sub")
(require-unqualified "../package/path.sub")
(require-unqualified "../http/url.sub")

(provide with-browser browser finder by-css by-text by-text-containing by-role by-label by-test-id within nth
         browser-click! browser-click-at! browser-right-click! browser-double-click! browser-hover! browser-wheel!
         browser-select! browser-resize! browser-advance-until! browser-type! browser-press! browser-key-down! browser-key-up!
         browser-focus! browser-move-mouse! browser-fire! browser-advance! browser-go! browser-reload!
         browser-choose-files! browser-respond! browser-storage-set! browser-clipboard-set! browser-text browser-html
         browser-attribute browser-attribute? browser-value browser-checked? browser-count browser-drawing
         browser-drawn? browser-url browser-storage-get browser-clipboard-get browser-downloaded browser-sounds
         browser-console browser-show browser-show-drawing expect-text expect-html expect-value expect-attribute
         expect-no-attribute expect-checked expect-count expect-missing expect-drawn browser-opened browser-closed!
         browser-expect browser-choose-files-at! browser-pixels browser-box browser-screenshot element-box expect-pixel
         %browser-step!)

(struct browser [page (ptr page)])

;; A finder is the texts that describe it to the page (page/find.mjs): its kind, then what it looks for.
(struct finder [texts (slice string)])

(struct element-box [x f64] [y f64] [width f64] [height f64])

;; ---- finders ----

(define (by-css [selector string]) -> finder (finder-of "css" selector))

(define (by-text [text string]) -> finder (finder-of "text" text))

(define (by-text-containing [text string]) -> finder (finder-of "text-containing" text))

;; Finds elements by role and accessible name. An empty name matches any name.
(define (by-role [role string] [name string]) -> finder
  (let ([out (make-buffer)])
    (pushed! (& out) "role")
    (pushed! (& out) role)
    (pushed! (& out) name)
    (finder #:texts (strings-in (& out)))))

(define (by-label [text string]) -> finder (finder-of "label" text))

(define (by-test-id [id string]) -> finder (finder-of "test-id" id))

(define (within [outer finder] [inner finder]) -> finder
  (let ([out (make-buffer)])
    (pushed! (& out) "within")
    (pushed-all! (& out) (-> outer texts))
    (pushed-all! (& out) (-> inner texts))
    (finder #:texts (strings-in (& out)))))

;; The nth of the elements that finder finds, counting from 1.
(define (nth [of finder] [n u32]) -> finder
  (let ([out (make-buffer)])
    (pushed! (& out) "nth")
    (pushed-all! (& out) (-> of texts))
    (pushed! (& out) (count-text n))
    (finder #:texts (strings-in (& out)))))

(define (finder-of [kind string] [text string]) -> finder
  (let ([out (make-buffer)])
    (pushed! (& out) kind)
    (pushed! (& out) text)
    (finder #:texts (strings-in (& out)))))

;; A request to the page: its kind, the finder's texts, then the request's other texts.
(define (asking [kind string] [f finder] [more (slice string)]) -> (slice string)
  (let ([out (make-buffer)])
    (pushed! (& out) kind)
    (pushed-all! (& out) (-> f texts))
    (pushed-all! (& out) more)
    (strings-in (& out))))

(define (told [kind string] [more (slice string)]) -> (slice string)
  (let ([out (make-buffer)])
    (pushed! (& out) kind)
    (pushed-all! (& out) more)
    (strings-in (& out))))

(define (one [s string]) -> (slice string)
  (let ([out (make-buffer)]) (pushed! (& out) s) (strings-in (& out))))

(define (two [a string] [b string]) -> (slice string)
  (let ([out (make-buffer)])
    (pushed! (& out) a)
    (pushed! (& out) b)
    (strings-in (& out))))

(define (none) -> (slice string) (slice (cast (ptr string) 0) 0))

;; ---- opening ----

(define (%browser-step! [s string]) (page-step! s))

(define (browser-opened [spec string] [html string] [url string] [args (slice string)] [server (fn ())] [message string])
                        -> browser
  (let ([address string])
    (unless (env-get "SUBSTRATE_DEVTOOLS" (& address) 0)
      (throw test-failed (lines-joined message "a test that opens a browser needs (browser) in the tests clause of its package's package.sub")))
    (when (== (-> address length) 0) (throw test-skipped "need Chromium"))
    (let* ([dir (site-built spec html message)] [why string] [p (page-open dir (with-args url args) address server (& why))])
      (when (== (cast u32 p) 0) (throw test-failed (lines-joined message why)))
      (browser #:page p))))

;; Adds args to url as arg parameters, which a site passes to its program as its arguments.
(define (with-args [url string] [args (slice string)]) -> string
  (let ([b (make-buffer)] [query #f])
    (buffer-add-string! (& b) url)
    (for ([i u32 0]) (< i (-> url length)) (+= i 1) (when (== (@ url i) #\?) (set! query #t)))
    (for ([i u32 0]) (< i (-> args length)) (+= i 1)
      (buffer-add-string! (& b) (if (or query (> i 0)) "&arg=" "?arg="))
      (url-add-form-value! (& b) (@ args i)))
    (buffer-string (& b))))

(struct built [spec string] [html string] [dir string])

(define made buffer)

;; Builds spec's site in the test's scratch directory, once per test.
(define (site-built [spec string] [html string] [message string]) -> string
  (let* ([all (cast (ptr built) (-> made bytes))] [n (/ (-> made length) (sizeof built))]
         [base (base-of spec)] [name (if (ends? base ".sub") (slice base 0 (- (-> base length) 4)) base)]
         [dir (joined-path (joined-path (scratch-directory) "sites") name)] [info fs-info] [err (make-buffer)]
         [b built])
    (for ([i u32 0]) (< i n) (+= i 1)
      (let ([m (& (@ all i))])
        (when (and (== (-> m spec) spec) (== (-> m html) html)) (return (-> m dir)))
        (when (== (-> m dir) dir) (set! dir (numbered dir n)))))
    (let ([p (planned spec name message)])
      (when (> (-> html length) 0) (set! (-> p html) html))
      (unless (site-write! (& p) dir (toolchain) (& err))
        (throw test-failed (lines-joined message (buffer-string (& err)))))
      (unless (and (== (fs-stat (-> p program) (& info) 0) 0) (== (-> info kind) fs-directory))
        (unless (program-write! (-> p program) (joined-path dir "program") (& err))
          (throw test-failed (lines-joined message (buffer-string (& err)))))))
    (set! b (built #:spec spec #:html html #:dir dir))
    (buffer-add! (& made) (slice (cast (ptr u8) (& b)) (sizeof built)))
    dir))

;; spec is the name of a site the package declares, or else the path of a program.
(define (planned [spec string] [name string] [message string]) -> site-plan
  (let ([p site-plan] [a (make-arena)] [here string] [why string] [err (make-buffer)])
    (when (< (fs-cwd (& here) (& why)) 0) (throw test-failed (lines-joined message why)))
    (if (site-named? spec)
        (unless (site-declared (& a) here spec (& p) (& err)) (throw test-failed (lines-joined message (buffer-string (& err)))))
        (set! p (site-plan #:name name #:program (resolved-path here spec) #:html ""
                           #:files (slice (cast (ptr site-files) 0) 0) #:base here)))
    p))

(define (toolchain) -> string (let ([t string]) (env-get "SUBSTRATE_TOOLCHAIN" (& t) 0) t))

(define (numbered [dir string] [n u32]) -> string
  (let ([out (make-buffer)])
    (buffer-add-string! (& out) dir)
    (buffer-add-byte! (& out) #\-)
    (write-digits (& out) (cast u64 n) 10)
    (buffer-string (& out))))

(define (browser-closed! [b browser]) (page-close (-> b page)))

;; Saves a PNG of the browser's window as build/test/screenshots/name.png in the package, and gives that path.
(define (browser-screenshot [b browser] [name string]) -> string
  (let* ([dir "build/test/screenshots"] [file (make-buffer)] [why string] [png (page-screenshot (-> b page))])
    (buffer-add-string! (& file) name)
    (buffer-add-string! (& file) ".png")
    (let ([path (joined-path dir (buffer-string (& file)))])
      (when (or (< (fs-make-dir dir (& why)) 0) (< (fs-write-file path png (& why)) 0))
        (throw test-failed (page-stepped why)))
      path)))

(define (lines-joined [a string] [b string]) -> string
  (let ([out (make-buffer)])
    (buffer-add-string! (& out) a)
    (buffer-add-byte! (& out) 10)
    (buffer-add-string! (& out) b)
    (buffer-string (& out))))

;; ---- actions ----

(define (browser-click! [b browser] [f finder]) (page-click! (-> b page) (-> f texts) "left" 1))

;; Clicks at x, y within the element.
(define (browser-click-at! [b browser] [f finder] [x u32] [y u32]) (page-click-at! (-> b page) (-> f texts) x y))

(define (browser-right-click! [b browser] [f finder]) (page-click! (-> b page) (-> f texts) "right" 1))

(define (browser-double-click! [b browser] [f finder]) (page-click! (-> b page) (-> f texts) "left" 2))

(define (browser-hover! [b browser] [f finder]) (page-hover! (-> b page) (-> f texts)))

;; Turns the mouse wheel over the element, by dx and dy pixels.
(define (browser-wheel! [b browser] [f finder] [dx i32] [dy i32]) (page-wheel! (-> b page) (-> f texts) dx dy))

;; Chooses the option of a select element whose text is option.
(define (browser-select! [b browser] [f finder] [option string]) (page-act! (-> b page) (asking "select" f (one option))))

;; Makes the browser's window width by height CSS pixels.
(define (browser-resize! [b browser] [width u32] [height u32]) (page-resize! (-> b page) width height))

(define (browser-type! [b browser] [f finder] [text string]) (page-type! (-> b page) (-> f texts) text))

;; Presses and releases a key, given as a key's name or one character after any of Shift+, Control+, Alt+ and Meta+.
(define (browser-press! [b browser] [key string]) (page-press! (-> b page) key))

(define (browser-key-down! [b browser] [key string]) (page-key! (-> b page) key #t))

(define (browser-key-up! [b browser] [key string]) (page-key! (-> b page) key #f))

(define (browser-focus! [b browser] [f finder]) (page-act! (-> b page) (asking "focus" f (none))))

;; Moves the mouse by dx, dy over the element that has locked the pointer, or else over the document's body.
(define (browser-move-mouse! [b browser] [dx i32] [dy i32]) (page-move-mouse! (-> b page) dx dy))

(define (browser-fire! [b browser] [f finder] [event string]) (page-act! (-> b page) (asking "fire" f (one event))))

;; Moves the browser's clock ms ahead, running its timers and animation frames on the way.
(define (browser-advance! [b browser] [ms u32]) (page-ask (-> b page) (told "advance" (one (count-text ms)))))

;; Goes to url, relative to the browser's URL, and starts the program again.
(define (browser-go! [b browser] [url string]) (page-go! (-> b page) url))

;; Reloads the page, keeping its storage, history and clipboard.
(define (browser-reload! [b browser]) (page-reload! (-> b page)))

(define (browser-choose-files-at! [b browser] [paths (slice string)]) (page-choose-files! (-> b page) paths))

;; Answers fetches of url with status and body.
(define (browser-respond! [b browser] [url string] [status u32] [body string]) (page-respond! (-> b page) url status body))

(define (browser-storage-set! [b browser] [key string] [value string])
  (page-ask (-> b page) (told "storage-set" (two key value))))

(define (browser-clipboard-set! [b browser] [text string]) (page-ask (-> b page) (told "clipboard-set" (one text))))

;; ---- reads ----

(define (browser-text [b browser] [f finder]) -> string (page-ask (-> b page) (asking "text" f (none))))

(define (browser-html [b browser] [f finder]) -> string (page-ask (-> b page) (asking "html" f (none))))

(define (browser-attribute [b browser] [f finder] [name string]) -> string
  (page-ask (-> b page) (asking "attribute" f (one name))))

(define (browser-attribute? [b browser] [f finder] [name string]) -> bool
  (== (page-ask (-> b page) (asking "has-attribute" f (one name))) "true"))

(define (browser-value [b browser] [f finder]) -> string (page-ask (-> b page) (asking "value" f (none))))

(define (browser-checked? [b browser] [f finder]) -> bool (== (page-ask (-> b page) (asking "checked" f (none))) "true"))

(define (browser-count [b browser] [f finder]) -> u32
  (let ([n u64 0])
    (digits-integer (page-ask (-> b page) (asking "count" f (none))) 10 #f (& n))
    (cast u32 n)))

;; The commands of the canvas's last drawing, one per line.
(define (browser-drawing [b browser] [f finder]) -> string (page-ask (-> b page) (asking "drawing" f (none))))

;; Whether the canvas's last drawing contains the commands in lines, consecutively and in order.
(define (browser-drawn? [b browser] [f finder] [lines string]) -> bool
  (== (page-ask (-> b page) (asking "drawn" f (one lines))) "true"))

(define (browser-url [b browser]) -> string (page-ask (-> b page) (told "url" (none))))

(define (browser-storage-get [b browser] [key string]) -> string (page-ask (-> b page) (told "storage-get" (one key))))

;; The text on the browser's clipboard, with its line breaks as \n on every system.
(define (browser-clipboard-get [b browser]) -> string (page-ask (-> b page) (told "clipboard-get" (none))))

;; The contents of the file the program saved as name.
(define (browser-downloaded [b browser] [name string]) -> string (page-downloaded (-> b page) name))

;; The sounds the program started, stopped and finished, one per line.
(define (browser-sounds [b browser]) -> string (page-ask (-> b page) (told "sounds" (none))))

(define (browser-console [b browser]) -> string (page-console (-> b page)))

;; The RGBA pixels of a rectangle of the canvas that f finds, row by row: what a 2D canvas holds, or the last frame
;; drawn on a WebGPU canvas.
(define (browser-pixels [b browser] [f finder] [x u32] [y u32] [width u32] [height u32]) -> (slice u8)
  (page-pixels (-> b page) (-> f texts) x y width height))

;; Where the element that f finds is in the window, in CSS pixels.
(define (browser-box [b browser] [f finder]) -> element-box
  (let ([text (page-ask (-> b page) (asking "box" f (none)))] [n (array f64 4)] [k u32 0] [start u32 0])
    (for ([i u32 0]) (<= i (-> text length)) (+= i 1)
      (when (and (< k 4) (or (== i (-> text length)) (== (@ text i) 32)))
        (set! (@ n k) (decimal (slice text start i)))
        (+= k 1)
        (set! start (+ i 1))))
    (element-box #:x (@ n 0) #:y (@ n 1) #:width (@ n 2) #:height (@ n 3))))

;; Parses a number written with three decimals, such as -12.345.
(define (decimal [s string]) -> f64
  (let* ([negative (and (> (-> s length) 0) (== (@ s 0) #\-))] [dot (if negative 1 0)] [whole u64 0] [part u64 0])
    (while (and (< dot (-> s length)) (!= (@ s dot) #\.)) (+= dot 1))
    (digits-integer (slice s (if negative 1 0) dot) 10 #f (& whole))
    (when (< (+ dot 1) (-> s length)) (digits-integer (slice s (+ dot 1) (-> s length)) 10 #f (& part)))
    (let ([v (+ (cast f64 whole) (/ (cast f64 part) 1000.0))]) (if negative (- 0.0 v) v))))

(define (browser-show [b browser] [f finder]) (printf "~a\n" (browser-html b f)))

(define (browser-show-drawing [b browser] [f finder]) (printf "~a\n" (browser-drawing b f)))

;; ---- expectations ----

(define (browser-expect [b browser] [kind string] [f finder] [fields (slice string)] [message string])
  (page-check (-> b page) (asking kind f fields) message))

(define (count-text [n u32]) -> string
  (let ([out (make-buffer)])
    (write-digits (& out) (cast u64 n) 10)
    (buffer-string (& out))))

(define (pushed! [b (ptr buffer)] [s string]) (buffer-add! b (slice (cast (ptr u8) (& s)) (sizeof string))))

(define (pushed-all! [b (ptr buffer)] [all (slice string)])
  (for ([i u32 0]) (< i (-> all length)) (+= i 1) (pushed! b (@ all i))))

(define (strings-in [b (ptr buffer)]) -> (slice string)
  (slice (cast (ptr string) (-> b bytes)) (/ (-> b length) (sizeof string))))

(begin-for-syntax
  (require-unqualified compiler/macros)

  (define (literal [d datum]) -> datum (datum->syntax #'here d 0))

  (define (message-of [s datum]) -> datum
    (let ([parts (syntax->list s)])
      (literal (format (if (> (length parts) 3) "~a:~a: (~a ~s ~s ...)" "~a:~a: (~a ~s ~s)")
                       `(,(syntax-source s) ,(syntax-line s) ,(syntax-e (car parts)) ,(syntax->datum (cadr parts))
                         ,(syntax->datum (caddr parts)))))))

  ;; A body form's location and start, as message-of gives them.
  (define (step-of [s datum]) -> datum
    (let ([parts (syntax->list s)])
      (cond [(and (!= parts 0) (>= (length parts) 3)) (message-of s)]
            [else (literal (format "~a:~a: ~s" `(,(syntax-source s) ,(syntax-line s) ,(syntax->datum s))))])))

  (define (path-of [s datum] [file datum]) -> datum
    #`(test-path #,(literal (string->datum (symbol->string (syntax-source s)))) #,file))

  (define (text? [x datum]) -> bool (string? (syntax-e x)))

  (define (no-fields) -> datum #`(slice (cast (ptr string) 0) 0))

  ;; Whether spec is a site's name rather than a path, by the same rule as substrate site.
  (define (named? [spec datum]) -> bool
    (let* ([text (datum->string spec)] [n (-> text length)])
      (for ([i u32 0]) (< i n) (+= i 1) (when (or (== (@ text i) #\/) (== (@ text i) #\\)) (return #f)))
      (not (and (>= n 4) (== (slice text (- n 4) n) ".sub")))))

  (define (with-browser-form [s datum]) -> datum
    (syntax-match s
      [(_ ((? identifier? b) (? text? file) options ...) body ...)
       (let ([html (literal '"")] [url (literal '"")] [args (no-fields)] [server #'(cast (fn ()) 0)] [l options])
         (while (pair? l)
           (unless (and (keyword? (syntax-e (car l))) (pair? (cdr l)))
             (raise-syntax-error 'with-browser "expected a keyword and its value" (car l)))
           (let ([k (keyword->string (syntax-e (car l)))] [v (cadr l)])
             (cond [(and (== k "html") (text? v)) (set! html (path-of s v))]
                   [(and (== k "url") (text? v)) (set! url v)]
                   [(== k "args") (set! args (arguments v))]
                   [(== k "server") (set! server v)]
                   [else (raise-syntax-error 'with-browser "the options are #:html \"file\", #:url \"url\", #:args and #:server function" (car l))]))
           (set! l (cddr l)))
         #`(let ([#,b (browser-opened #,(if (named? (syntax-e file)) file (path-of s file)) #,html #,url #,args #,server
                                      #,(literal (format "~a:~a: (with-browser (~s ~s) ...)"
                                                         `(,(syntax-source s) ,(syntax-line s) ,(syntax->datum b)
                                                           ,(syntax-e file)))))])
             (try (begin #,@(for/list ([f body]) #`(begin (%browser-step! #,(step-of f)) #,f)) (begin))
               [catch-all (browser-closed! #,b) (rethrow)])
             (%browser-step! "")
             (browser-closed! #,b)))]
      [_ (raise-syntax-error 'with-browser "expected (with-browser (name \"site or program.sub\" [#:html \"index.html\"] [#:url \"url\"] [#:args (\"argument\" ...)]
                                       [#:server function]) body ...)" s)]))

  ;; The program's arguments from #:args: either a list of strings, or an expression that gives a slice of strings.
  (define (arguments [v datum]) -> datum
    (syntax-match v
      [() (no-fields)]
      [((? text? a) ...) #`(slice (array-of string #,@(syntax->list v)))]
      [_ v]))

  ;; (browser-choose-files! browser "path" ...) sets the files that the next file picker gives. The paths are relative
  ;; to the test.
  (define (choose-files-form [s datum]) -> datum
    (syntax-match s
      [(_ b (? text? file) ...)
       (let ([paths (for/list ([f (cddr (syntax->list s))]) (path-of s f))])
         #`(browser-choose-files-at! #,b #,(if (null? paths) (no-fields) #`(slice (array-of string #,@paths)))))]
      [_ (raise-syntax-error 'browser-choose-files! "expected (browser-choose-files! browser \"path\" ...)" s)]))

  (define (expect-text-form [s datum]) -> datum
    (syntax-match s
      [(_ b f text) #`(browser-expect #,b "expect-text" #,f (slice (array-of string #,text)) #,(message-of s))]
      [_ (raise-syntax-error 'expect-text "expected (expect-text browser finder \"text\")" s)]))

  (define (expect-html-form [s datum]) -> datum
    (syntax-match s
      [(_ b f html) #`(browser-expect #,b "expect-html" #,f (slice (array-of string #,html)) #,(message-of s))]
      [_ (raise-syntax-error 'expect-html "expected (expect-html browser finder \"html\")" s)]))

  (define (expect-value-form [s datum]) -> datum
    (syntax-match s
      [(_ b f value) #`(browser-expect #,b "expect-value" #,f (slice (array-of string #,value)) #,(message-of s))]
      [_ (raise-syntax-error 'expect-value "expected (expect-value browser finder \"value\")" s)]))

  (define (expect-attribute-form [s datum]) -> datum
    (syntax-match s
      [(_ b f name value)
       #`(browser-expect #,b "expect-attribute" #,f (slice (array-of string #,name #,value)) #,(message-of s))]
      [_ (raise-syntax-error 'expect-attribute "expected (expect-attribute browser finder \"name\" \"value\")" s)]))

  (define (expect-no-attribute-form [s datum]) -> datum
    (syntax-match s
      [(_ b f name) #`(browser-expect #,b "expect-no-attribute" #,f (slice (array-of string #,name)) #,(message-of s))]
      [_ (raise-syntax-error 'expect-no-attribute "expected (expect-no-attribute browser finder \"name\")" s)]))

  (define (expect-checked-form [s datum]) -> datum
    (syntax-match s
      [(_ b f on)
       #`(browser-expect #,b "expect-checked" #,f (slice (array-of string (if #,on "true" "false"))) #,(message-of s))]
      [_ (raise-syntax-error 'expect-checked "expected (expect-checked browser finder #t-or-#f)" s)]))

  (define (expect-count-form [s datum]) -> datum
    (syntax-match s
      [(_ b f n) #`(browser-expect #,b "expect-count" #,f (slice (array-of string (count-text #,n))) #,(message-of s))]
      [_ (raise-syntax-error 'expect-count "expected (expect-count browser finder n)" s)]))

  (define (expect-drawn-form [s datum]) -> datum
    (syntax-match s
      [(_ b f lines) #`(browser-expect #,b "expect-drawn" #,f (slice (array-of string #,lines)) #,(message-of s))]
      [_ (raise-syntax-error 'expect-drawn "expected (expect-drawn browser finder \"lines\")" s)]))

  (define (expect-pixel-form [s datum]) -> datum
    (syntax-match s
      [(_ b f x y rgba)
       #`(browser-expect #,b "expect-pixel" #,f (slice (array-of string (count-text #,x) (count-text #,y) #,rgba)) #,(message-of s))]
      [_ (raise-syntax-error 'expect-pixel "expected (expect-pixel browser finder x y \"r,g,b,a\")" s)]))

  ;; (browser-advance-until! browser finder "text" ms) moves the clock ahead, a frame at a time, until the element's
  ;; text is text, and fails when it is not after ms.
  (define (advance-until-form [s datum]) -> datum
    (syntax-match s
      [(_ b f text ms)
       #`(browser-expect #,b "advance-until" #,f (slice (array-of string #,text (count-text #,ms))) #,(message-of s))]
      [_ (raise-syntax-error 'browser-advance-until! "expected (browser-advance-until! browser finder \"text\" ms)" s)]))

  (define (expect-missing-form [s datum]) -> datum
    (syntax-match s
      [(_ b f) #`(browser-expect #,b "expect-missing" #,f #,(no-fields) #,(message-of s))]
      [_ (raise-syntax-error 'expect-missing "expected (expect-missing browser finder)" s)])))

(define-syntax with-browser with-browser-form)
(define-syntax browser-choose-files! choose-files-form)
(define-syntax expect-text expect-text-form)
(define-syntax expect-html expect-html-form)
(define-syntax expect-value expect-value-form)
(define-syntax expect-attribute expect-attribute-form)
(define-syntax expect-no-attribute expect-no-attribute-form)
(define-syntax expect-checked expect-checked-form)
(define-syntax expect-count expect-count-form)
(define-syntax expect-pixel expect-pixel-form)
(define-syntax expect-missing expect-missing-form)
(define-syntax browser-advance-until! advance-until-form)
(define-syntax expect-drawn expect-drawn-form)
