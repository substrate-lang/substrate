(package std
  (version "0.9.0")
  (substrate "0.9.0")
  (exports archive/tar compress/deflate compress/gzip compress/inflate crypto/hmac crypto/password crypto/sha1
           crypto/sha256 crypto/sha512 doc/doc doc/html doc/root doc/text encoding/base64 encoding/json encoding/utf8
           encoding/wire html/html http/checks http/conditional http/cookie http/form http/http http/multipart
           http/route http/server http/session http/sse http/sse-client http/static http/test http/token http/url
           http/websocket log/log meta/derive meta/equal meta/type-info package/files package/hash package/manifest
           package/map package/pack package/path package/read package/site package/store test/browser test/build
           test/test)
  (tests "tests/archive/*.sub" "tests/compress/*.sub" "tests/crypto/*.sub" "tests/encoding/*.sub" "tests/http/*.sub"
         "tests/log/*.sub" "tests/meta/*.sub" "tests/test/*.sub"
         (grants (all read) (env "JSON_TEST_SUITE") (net "127.0.0.1" "[::]" "[::1]"))))
