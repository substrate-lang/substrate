;; Vectors: growable arrays of one type, on the heap. (vector T) is a vector of T, and its zero value is an empty
;; vector. vector-count, vector-items, vector-at, vector-at-unchecked, vector-add!, vector-push!, vector-pop!,
;; vector-remove!, vector-clear!, vector-reserve! and vector-free! take a pointer to a vector. vector-each runs its body
;; for each item. vector-remove! takes out the item at an index and moves the later items down. Growing may move the
;; items, so a pointer to an item lasts only until the vector next grows.
(require-unqualified std/meta/method)
(require-unqualified std/meta/type)

(provide vector vector-count vector-items vector-at vector-at-unchecked vector-add! vector-push! vector-pop!
         vector-remove! vector-clear! vector-reserve! vector-free! vector-each)

(define-type (vector T)
  (struct [items (ptr T)] [count u32] [room u32])
  (define (-count [v (ptr (vector T))]) #:inline -> u32 (-> v count))
  (define (-items [v (ptr (vector T))]) -> (slice T) (slice (-> v items) (-> v count)))
  (define (-at [v (ptr (vector T))] [i u32]) -> (ptr T) (& (@ (slice (-> v items) (-> v count)) i)))
  (define (-at-unchecked [v (ptr (vector T))] [i u32]) #:inline -> (ptr T) (+ (-> v items) i))
  (define (-reserve! [v (ptr (vector T))] [n u32])
    (when (> n (-> v room))
      (let ([room u64 (if (== (-> v room) 0) 4 (cast u64 (-> v room)))])
        (while (< room (cast u64 n)) (set! room (* room 2)))
        (let ([bytes (* room (cast u64 (sizeof T)))])
          (set! (-> v items) (cast (ptr T) (realloc (-> v items) (if (< bytes 2147483584) (cast u32 bytes) 2147483584))))
          (set! (-> v room) (cast u32 room))))))
  (define (-push! [v (ptr (vector T))] [x T]) #:inline
    (when (== (-> v count) (-> v room)) (-reserve! v (+ (-> v count) 1)))
    (set! (@ (+ (-> v items) (-> v count))) x)
    (+= (-> v count) 1))
  (define (-add! [v (ptr (vector T))]) -> (ptr T)
    (when (== (-> v count) (-> v room)) (-reserve! v (+ (-> v count) 1)))
    (let ([p (+ (-> v items) (-> v count))])
      (memset p 0 (sizeof T))
      (+= (-> v count) 1)
      p))
  (define (-pop! [v (ptr (vector T))]) #:inline -> T
    (when (== (-> v count) 0) (host-trap "vector-pop!: the vector is empty"))
    (-= (-> v count) 1)
    (@ (+ (-> v items) (-> v count))))
  (define (-remove! [v (ptr (vector T))] [i u32]) -> T
    (let ([x (@ (-at v i))])
      (memcpy (+ (-> v items) i) (+ (-> v items) (+ i 1)) (* (- (-> v count) (+ i 1)) (sizeof T)))
      (-= (-> v count) 1)
      x))
  (define (-clear! [v (ptr (vector T))]) (set! (-> v count) 0))
  (define (-free! [v (ptr (vector T))])
    (free (-> v items))
    (set! (-> v items) 0)
    (set! (-> v count) 0)
    (set! (-> v room) 0)))

(begin-for-syntax
  (require-unqualified compiler/macros)

  (define (vector-each-form [s datum]) -> datum
    (syntax-match s
      [(_ (((? identifier? x) v)) body0 body ...)
       #`(let ([the-vector #,v])
           (for ([i u32 0]) (< i (vector-count the-vector)) (+= i 1)
             (let ([#,x (vector-at-unchecked the-vector i)]) #,body0 #,@body)))]
      [(_ (((? identifier? x) (? identifier? i) v)) body0 body ...)
       #`(let ([the-vector #,v])
           (for ([#,i u32 0]) (< #,i (vector-count the-vector)) (+= #,i 1)
             (let ([#,x (vector-at-unchecked the-vector #,i)]) #,body0 #,@body)))]
      [_ (raise-syntax-error
          'vector-each "expected (vector-each ([item vector]) body ...) or (vector-each ([item index vector]) body ...)" s)])))

(define-syntax vector-each vector-each-form)
(define-methods [vector-count -count] [vector-items -items] [vector-at -at] [vector-at-unchecked -at-unchecked]
                [vector-add! -add!] [vector-push! -push!] [vector-pop! -pop!] [vector-remove! -remove!]
                [vector-clear! -clear!] [vector-reserve! -reserve!] [vector-free! -free!])
