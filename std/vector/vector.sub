;; Vectors: growable arrays of one type, on the heap. (vector T) is a vector of T, and its zero value is an empty
;; vector. vector-instance below writes each vector type together with its functions. vector-count, vector-items,
;; vector-at, vector-at-unchecked, vector-add!, vector-push!, vector-pop!, vector-remove!, vector-clear!, vector-reserve!
;; and vector-free! take a pointer to a vector, and each calls that vector type's function (std/meta/method).
;; vector-each runs its body for each item. vector-remove! takes out the item at an index and moves the later items
;; down. Growing may move the items, so a pointer to an item lasts only until the vector next grows.
(require-unqualified std/meta/generic)
(require-unqualified std/meta/method)

(provide vector vector-count vector-items vector-at vector-at-unchecked vector-add! vector-push! vector-pop!
         vector-remove! vector-clear! vector-reserve! vector-free! vector-each)

(begin-for-syntax
  (require-unqualified compiler/macros)
  (require-unqualified std/meta/type-info)

  (define (vector-instance-form [s datum]) -> datum
    (syntax-match s
      [(_ f name t)
       (let ([count (method-name name '-count)] [items (method-name name '-items)] [at (method-name name '-at)]
             [at-unchecked (method-name name '-at-unchecked)] [reserve (method-name name '-reserve!)]
             [push (method-name name '-push!)] [add (method-name name '-add!)] [pop (method-name name '-pop!)]
             [remove (method-name name '-remove!)] [clear (method-name name '-clear!)] [free! (method-name name '-free!)])
         #`(begin
             (struct #,name [items (ptr #,t)] [count u32] [room u32])
             (define (#,count [v (ptr #,name)]) #:inline -> u32 (-> v count))
             (define (#,items [v (ptr #,name)]) -> (slice #,t) (slice (-> v items) (-> v count)))
             (define (#,at [v (ptr #,name)] [i u32]) -> (ptr #,t) (& (@ (slice (-> v items) (-> v count)) i)))
             (define (#,at-unchecked [v (ptr #,name)] [i u32]) #:inline -> (ptr #,t) (+ (-> v items) i))
             (define (#,reserve [v (ptr #,name)] [n u32])
               (when (> n (-> v room))
                 (let ([room u64 (if (== (-> v room) 0) 4 (cast u64 (-> v room)))])
                   (while (< room (cast u64 n)) (set! room (* room 2)))
                   (let ([bytes (* room (cast u64 (sizeof #,t)))])
                     (set! (-> v items)
                           (cast (ptr #,t) (realloc (-> v items) (if (< bytes 2147483584) (cast u32 bytes) 2147483584))))
                     (set! (-> v room) (cast u32 room))))))
             (define (#,push [v (ptr #,name)] [x #,t]) #:inline
               (when (== (-> v count) (-> v room)) (#,reserve v (+ (-> v count) 1)))
               (set! (@ (+ (-> v items) (-> v count))) x)
               (+= (-> v count) 1))
             (define (#,add [v (ptr #,name)]) -> (ptr #,t)
               (when (== (-> v count) (-> v room)) (#,reserve v (+ (-> v count) 1)))
               (let ([p (+ (-> v items) (-> v count))])
                 (memset p 0 (sizeof #,t))
                 (+= (-> v count) 1)
                 p))
             (define (#,pop [v (ptr #,name)]) #:inline -> #,t
               (when (== (-> v count) 0) (host-trap "vector-pop!: the vector is empty"))
               (-= (-> v count) 1)
               (@ (+ (-> v items) (-> v count))))
             (define (#,remove [v (ptr #,name)] [i u32]) -> #,t
               (let ([x (@ (#,at v i))])
                 (memcpy (+ (-> v items) i) (+ (-> v items) (+ i 1)) (* (- (-> v count) (+ i 1)) (sizeof #,t)))
                 (-= (-> v count) 1)
                 x))
             (define (#,clear [v (ptr #,name)]) (set! (-> v count) 0))
             (define (#,free! [v (ptr #,name)])
               (free (-> v items))
               (set! (-> v items) 0)
               (set! (-> v count) 0)
               (set! (-> v room) 0))))]
      [(_ f name t ...)
       (raise-syntax-error (syntax-e f) (format-message "takes 1 argument, not ~a" `(,(make-integer (length t)))) f)]))

  (define (vector-each-form [s datum]) -> datum
    (syntax-match s
      [(_ (((? identifier? x) v)) body0 body ...)
       #`(let ([the-vector #,v])
           (for ([i u32 0]) (< i (vector-count the-vector)) (+= i 1)
             (let ([#,x (vector-at-unchecked the-vector i)]) #,body0 #,@body)))]
      [(_ (((? identifier? x) (? identifier? i) v)) body0 body ...)
       #`(let ([the-vector #,v])
           (for ([#,i u32 0]) (< #,i (vector-count the-vector)) (+= #,i 1)
             (let ([#,x (vector-at-unchecked the-vector #,i)]) #,body0 #,@body)))]
      [_ (raise-syntax-error
          'vector-each "expected (vector-each ([item vector]) body ...) or (vector-each ([item index vector]) body ...)" s)])))

(define-syntax vector-instance vector-instance-form)
(define-generic vector vector-instance)
(define-syntax vector-each vector-each-form)
(define-methods [vector-count -count] [vector-items -items] [vector-at -at] [vector-at-unchecked -at-unchecked]
                [vector-add! -add!] [vector-push! -push!] [vector-pop! -pop!] [vector-remove! -remove!]
                [vector-clear! -clear!] [vector-reserve! -reserve!] [vector-free! -free!])
