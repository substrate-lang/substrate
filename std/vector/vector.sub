;; Vectors: growable arrays of one type, on the heap. (define-vector name type) declares the type name, whose zero value
;; is an empty vector, and its functions name-count, name-items, name-at, name-at-unchecked, name-add!, name-push!,
;; name-pop!, name-clear!, name-reserve! and name-free!. vector-count, vector-at and the others call the function of
;; their first argument's type, and vector-each runs its body for each item. Growing may move the items, so a pointer
;; to an item lasts until the vector next grows.
(require-unqualified std/meta/method)

(provide define-vector vector-count vector-items vector-at vector-at-unchecked vector-add! vector-push! vector-pop!
         vector-clear! vector-reserve! vector-free! vector-each)

(begin-for-syntax
  (require-unqualified compiler/macros)

  (define (named [base datum] [suffix datum]) -> datum
    (datum->syntax base (string->symbol (format-message "~a~a" `(,(syntax-e base) ,suffix))) base))

  (define (define-vector-form [s datum]) -> datum
    (syntax-match s
      [(_ (? identifier? name) t)
       (let ([count (named name '-count)] [items (named name '-items)] [at (named name '-at)]
             [at-unchecked (named name '-at-unchecked)] [add (named name '-add!)] [push (named name '-push!)]
             [pop (named name '-pop!)] [clear (named name '-clear!)] [reserve (named name '-reserve!)]
             [free! (named name '-free!)])
         #`(begin
             (struct #,name [items (ptr #,t)] [count u32] [room u32])
             (define (#,count [v (ptr #,name)]) -> u32 (-> v count))
             (define (#,items [v (ptr #,name)]) -> (slice #,t) (slice (-> v items) (-> v count)))
             (define (#,at [v (ptr #,name)] [i u32]) -> (ptr #,t) (& (@ (slice (-> v items) (-> v count)) i)))
             (define (#,at-unchecked [v (ptr #,name)] [i u32]) -> (ptr #,t) (+ (-> v items) i))
             (define (#,reserve [v (ptr #,name)] [n u32])
               (when (> n (-> v room))
                 (let ([room u64 (if (== (-> v room) 0) 4 (cast u64 (-> v room)))])
                   (while (< room (cast u64 n)) (set! room (* room 2)))
                   (let ([bytes (* room (cast u64 (sizeof #,t)))])
                     (set! (-> v items)
                           (cast (ptr #,t) (realloc (-> v items) (if (< bytes 2147483584) (cast u32 bytes) 2147483584))))
                     (set! (-> v room) (cast u32 room))))))
             (define (#,push [v (ptr #,name)] [x #,t])
               (when (== (-> v count) (-> v room)) (#,reserve v (+ (-> v count) 1)))
               (set! (@ (+ (-> v items) (-> v count))) x)
               (+= (-> v count) 1))
             (define (#,add [v (ptr #,name)]) -> (ptr #,t)
               (when (== (-> v count) (-> v room)) (#,reserve v (+ (-> v count) 1)))
               (let ([p (+ (-> v items) (-> v count))])
                 (memset p 0 (sizeof #,t))
                 (+= (-> v count) 1)
                 p))
             (define (#,pop [v (ptr #,name)]) -> #,t
               (when (== (-> v count) 0) (host-trap "vector-pop!: the vector is empty"))
               (-= (-> v count) 1)
               (@ (+ (-> v items) (-> v count))))
             (define (#,clear [v (ptr #,name)]) (set! (-> v count) 0))
             (define (#,free! [v (ptr #,name)])
               (free (-> v items))
               (set! (-> v items) 0)
               (set! (-> v count) 0)
               (set! (-> v room) 0))))]
      [_ (raise-syntax-error 'define-vector "expected (define-vector name type)" s)]))

  (define (vector-each-form [s datum]) -> datum
    (syntax-match s
      [(_ (((? identifier? x) v)) body0 body ...)
       #`(let ([the-vector #,v])
           (for ([i u32 0]) (< i (vector-count the-vector)) (+= i 1)
             (let ([#,x (vector-at-unchecked the-vector i)]) #,body0 #,@body)))]
      [(_ (((? identifier? x) (? identifier? i) v)) body0 body ...)
       #`(let ([the-vector #,v])
           (for ([#,i u32 0]) (< #,i (vector-count the-vector)) (+= #,i 1)
             (let ([#,x (vector-at-unchecked the-vector #,i)]) #,body0 #,@body)))]
      [_ (raise-syntax-error
          'vector-each "expected (vector-each ([item vector]) body ...) or (vector-each ([item index vector]) body ...)" s)]))

  (define (operation [s datum] [suffix datum]) -> datum
    (syntax-match s
      [(_ x arg ...) #`(method #,s #,(datum->syntax s suffix s) #,x #,@arg)]
      [_ (raise-syntax-error (syntax-e (car (syntax->list s))) "expected a pointer to a vector" s)]))

  (define (count-form [s datum]) -> datum (operation s '-count))
  (define (items-form [s datum]) -> datum (operation s '-items))
  (define (at-form [s datum]) -> datum (operation s '-at))
  (define (at-unchecked-form [s datum]) -> datum (operation s '-at-unchecked))
  (define (add-form [s datum]) -> datum (operation s '-add!))
  (define (push-form [s datum]) -> datum (operation s '-push!))
  (define (pop-form [s datum]) -> datum (operation s '-pop!))
  (define (clear-form [s datum]) -> datum (operation s '-clear!))
  (define (reserve-form [s datum]) -> datum (operation s '-reserve!))
  (define (free-form [s datum]) -> datum (operation s '-free!)))

(define-syntax define-vector define-vector-form)
(define-syntax vector-count count-form)
(define-syntax vector-items items-form)
(define-syntax vector-at at-form)
(define-syntax vector-at-unchecked at-unchecked-form)
(define-syntax vector-add! add-form)
(define-syntax vector-push! push-form)
(define-syntax vector-pop! pop-form)
(define-syntax vector-clear! clear-form)
(define-syntax vector-reserve! reserve-form)
(define-syntax vector-free! free-form)
(define-syntax vector-each vector-each-form)
