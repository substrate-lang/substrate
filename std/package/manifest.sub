;; Manifests: a package's package.sub, or a program's first form:
;;   (package name (version "major.minor.patch") (substrate "major.minor.patch") (exports module ...)
;;     (dependencies (name (path "directory") (hash "sha256:hex")) (name (url "address") (hash "sha256:hex")) ...)
;;     (tests "path" ... (browser))
;;     (sites (name "program.sub" (html "file.html") (files "/dir" (from "directory") "path" ...)) ...))
;; The substrate clause gives the oldest substrate the package builds with. (substrate "0.10.0") also takes later 0.10
;; releases, and (substrate "1.2.0") takes later 1.x releases. Every clause but version is optional, and so are a path
;; dependency's hash and a site's html and files. A files part gives the program the files matching its paths, from its
;; from directory, under the directory it names; * matches any text in a name and ** any directories. (from name)
;; takes them from the directory that name stands for in a require: a dependency, std, compiler or host. (browser) says
;; that the package's tests open browsers with std/test/browser.sub.
(require-unqualified "read.sub")
(require-unqualified host/fs)
(require-unqualified "path.sub")

(provide manifest dependency declared-site site-files manifest-read manifest-of-program manifest-find package-holding
         package-name? full-hash? version-before? version-compatible?)

(struct dependency [name string] [path string] [url string] [hash string] [line u32] [column u32])
(struct site-files [dir string] [from string] [root string] [patterns (slice string)])
(struct declared-site [name string] [program string] [html string] [files (slice site-files)] [line u32] [column u32])
(struct manifest [name string] [version string] [major u32] [substrate string] [exports (slice string)]
                 [dependencies (slice dependency)] [tests (slice string)]
                 [test-browser bool] [sites (slice declared-site)])

(define default-tests (array string 1))

(define (manifest-read [a (ptr arena)] [file string] [m (ptr manifest)] [err (ptr buffer)]) -> bool
  (let* ([forms (slice data)] [e data-error]
         [ok (cond [(not (read-forms a file #f (& forms) (& e) err)) #f]
                   [(!= (-> e line) 0) (failed! err file (-> e line) (-> e column) (error-text (& (-> e error))))]
                   [(!= (-> forms length) 1) (failed! err file 1 1 "a package.sub holds one form, (package ...)")]
                   [else (manifest-of file (& (@ forms 0)) a m err)])])
    (error-free! (& (-> e error)))
    ok))

(define (manifest-of-program [a (ptr arena)] [file string] [m (ptr manifest)] [found (ptr bool)] [err (ptr buffer)])
  -> bool
  (let ([text (slice u8)] [why error] [forms (slice data)] [e data-error] [ok #t])
    (set! (@ found) #f)
    (unless (fs-read-file file (& text) (& why))
      (buffer-add-string! err "cannot read ")
      (buffer-add-string! err (error-text (& why)))
      (error-free! (& why))
      (return #f))
    (cond [(!= (data-head a (cast string text)) "package") (begin)]
          [(not (data-read a (cast string text) #t (& forms) (& e)))
           (set! ok (failed! err file (-> e line) (-> e column) (error-text (& (-> e error)))))]
          [(manifest-of file (& (@ forms 0)) a m err) (set! (@ found) #t)]
          [else (set! ok #f)])
    (error-free! (& (-> e error)))
    (free (-> text items))
    ok))

;; manifest-find finds the manifest for the program in file, given from /. found is 1 for the program's own manifest,
;; 2 for the nearest package.sub above it, whose directory goes into dir, and 0 when there is none.
(define (manifest-find [a (ptr arena)] [file string] [m (ptr manifest)] [dir (ptr buffer)] [found (ptr i32)]
                       [err (ptr buffer)]) -> bool
  (let ([own #f] [d string])
    (set! (@ found) 0)
    (unless (manifest-of-program a file m (& own) err) (return #f))
    (when own
      (set! (@ found) 1)
      (return #t))
    (set! d (package-holding a (parent-of file)))
    (when (> (-> d length) 0)
      (unless (manifest-read a (joined-path d "package.sub") m err) (return #f))
      (set! (@ found) 2)
      (buffer-add-string! dir d))
    #t))

(define (package-holding [a (ptr arena)] [dir string]) -> string
  (let ([d dir] [info fs-info] [found ""])
    (while (> (-> d length) 0)
      (when (and (fs-stat (joined-path d "package.sub") (& info) 0) (== (-> info kind) fs-file))
        (set! found (copy a d))
        (break))
      (set! d (if (root-path? d) "" (parent-of d))))
    found))

(define (read-forms [a (ptr arena)] [file string] [first bool] [into (ptr (slice data))] [e (ptr data-error)]
                    [err (ptr buffer)]) -> bool
  (let ([text (slice u8)] [why error])
    (set! (-> e line) 0)
    (unless (fs-read-file file (& text) (& why))
      (buffer-add-string! err "cannot read ")
      (buffer-add-string! err (error-text (& why)))
      (error-free! (& why))
      (return #f))
    (unless (data-read a (cast string text) first into e)
      (when (== (-> e line) 0) (set! (-> e line) 1)))
    (free (-> text items))
    #t))

(define (failed! [err (ptr buffer)] [file string] [line u32] [column u32] [message string]) -> bool
  (buffer-add-string! err file)
  (buffer-add-byte! err #\:)
  (write-digits err (cast u64 line) 10)
  (buffer-add-byte! err #\:)
  (write-digits err (cast u64 column) 10)
  (buffer-add-string! err ": ")
  (buffer-add-string! err message)
  #f)

(define (failed-at! [err (ptr buffer)] [file string] [d (ptr data)] [message string]) -> bool
  (match d
    [(data-list items line column) (failed! err file line column message)]
    [(data-symbol text line column) (failed! err file line column message)]
    [(data-string text line column) (failed! err file line column message)]))

(define (symbol-of [d (ptr data)]) -> string (match d [(data-symbol text line column) text] [_ ""]))

(define (string-of [d (ptr data)] [into (ptr string)]) -> bool
  (match d
    [(data-string text line column) (set! (@ into) text) #t]
    [_ #f]))

(define (items-of [d (ptr data)]) -> (slice data) (match d [(data-list items line column) items] [_ (slice (cast (ptr data) 0) 0)]))

(define (list-of? [d (ptr data)] [head string] [n u32]) -> bool
  (let ([items (items-of d)])
    (and (== (-> items length) n) (== (symbol-of (& (@ items 0))) head))))

(define (package-name? [s string]) -> bool
  (when (or (== (-> s length) 0) (< (@ s 0) #\a) (> (@ s 0) #\z) (== s "host") (== s "compiler")) (return #f))
  (for ([i u32 1]) (< i (-> s length)) (+= i 1)
    (let ([c (@ s i)])
      (unless (or (and (>= c #\a) (<= c #\z)) (and (>= c #\0) (<= c #\9)) (== c #\-)) (return #f))))
  #t)

(define (version-major [s string]) -> i64
  (let ([parts u32 0] [digits u32 0] [major i64 0] [n i64 0])
    (for ([i u32 0]) (<= i (-> s length)) (+= i 1)
      (if (or (== i (-> s length)) (== (@ s i) #\.))
          (begin
            (when (== digits 0) (return -1))
            (when (== parts 0) (set! major n))
            (+= parts 1)
            (set! digits 0)
            (set! n 0))
          (let ([c (@ s i)])
            (when (or (< c #\0) (> c #\9) (and (== digits 1) (== n 0)) (> digits 8)) (return -1))
            (set! n (+ (* n 10) (cast i64 (- c #\0))))
            (+= digits 1))))
    (if (== parts 3) major -1)))

;; version-before? is whether version a comes before version b, both major.minor.patch. No version comes before "".
(define (version-before? [a string] [b string]) -> bool
  (let ([i u32 0] [j u32 0])
    (for ([k u32 0]) (< k 3) (+= k 1)
      (let ([x (version-part a (& i))] [y (version-part b (& j))])
        (when (!= x y) (return (< x y)))))
    #f))

(define (version-compatible? [a string] [b string]) -> bool
  (let ([i u32 0] [j u32 0])
    (when (== (-> b length) 0) (return #t))
    (for ([k u32 0]) (< k 2) (+= k 1)
      (let ([x (version-part a (& i))] [y (version-part b (& j))])
        (when (!= x y) (return #f))
        (when (!= y 0) (break))))
    (not (version-before? a b))))

(define (version-part [s string] [at (ptr u32)]) -> i64
  (let ([n i64 0])
    (while (and (< (@ at) (-> s length)) (!= (@ s (@ at)) #\.))
      (set! n (+ (* n 10) (cast i64 (- (@ s (@ at)) #\0))))
      (+= (@ at) 1))
    (+= (@ at) 1)
    n))

(define (manifest-of [file string] [f (ptr data)] [a (ptr arena)] [m (ptr manifest)] [err (ptr buffer)]) -> bool
  (let ([items (items-of f)] [versioned #f] [needed #f] [exported #f] [listed #f] [tested #f] [sited #f] [major i64 0])
    (set! (-> m substrate) "")
    (set! (-> m exports) (slice (cast (ptr string) 0) 0))
    (set! (-> m dependencies) (slice (cast (ptr dependency) 0) 0))
    (set! (@ default-tests 0) "tests/*.sub")
    (set! (-> m tests) (slice default-tests 1))
    (set! (-> m test-browser) #f)
    (set! (-> m sites) (slice (cast (ptr declared-site) 0) 0))
    (unless (and (>= (-> items length) 2) (== (symbol-of (& (@ items 0))) "package"))
      (return (failed-at! err file f "expected (package name (version \"major.minor.patch\") (dependencies ...))")))
    (set! (-> m name) (symbol-of (& (@ items 1))))
    (unless (package-name? (-> m name))
      (return (failed-at! err file (& (@ items 1))
                          "a package's name is lowercase letters, digits and -, from a letter, and not host or compiler")))
    (for ([i u32 2]) (< i (-> items length)) (+= i 1)
      (let ([c (& (@ items i))])
        (cond [(and (list-of? c "version" 2) (not versioned))
               (unless (string-of (& (@ (items-of c) 1)) (& (-> m version)))
                 (return (failed-at! err file c "a version is a string, as (version \"1.2.0\")")))
               (set! major (version-major (-> m version)))
               (when (< major 0) (return (failed-at! err file c "a version is major.minor.patch, as (version \"1.2.0\")")))
               (set! (-> m major) (cast u32 major))
               (set! versioned #t)]
              [(and (list-of? c "substrate" 2) (not needed))
               (unless (and (string-of (& (@ (items-of c) 1)) (& (-> m substrate))) (>= (version-major (-> m substrate)) 0))
                 (return (failed-at! err file c "a substrate version is major.minor.patch, as (substrate \"0.9.0\")")))
               (set! needed #t)]
              [(and (> (-> (items-of c) length) 0) (== (symbol-of (& (@ (items-of c) 0))) "exports") (not exported))
               (unless (exports-of file c a m err) (return #f))
               (set! exported #t)]
              [(and (> (-> (items-of c) length) 0) (== (symbol-of (& (@ (items-of c) 0))) "dependencies") (not listed))
               (unless (dependencies-of file c a m err) (return #f))
               (set! listed #t)]
              [(and (> (-> (items-of c) length) 0) (== (symbol-of (& (@ (items-of c) 0))) "tests") (not tested))
               (unless (tests-of file c a m err) (return #f))
               (set! tested #t)]
              [(and (> (-> (items-of c) length) 0) (== (symbol-of (& (@ (items-of c) 0))) "sites") (not sited))
               (unless (sites-of file c a m err) (return #f))
               (set! sited #t)]
              [else
               (return (failed-at! err file c
                                   "a package's clauses are (version ...), (substrate ...), (exports ...), (dependencies ...), (tests ...) and (sites ...), each at most once"))])))
    (if versioned #t (failed-at! err file f "the package has no (version \"major.minor.patch\")"))))

(define (exports-of [file string] [c (ptr data)] [a (ptr arena)] [m (ptr manifest)] [err (ptr buffer)]) -> bool
  (let* ([items (items-of c)] [n (- (-> items length) 1)] [es (new a string n)])
    (for ([i u32 0]) (< i n) (+= i 1)
      (let ([d (& (@ items (+ i 1)))])
        (set! (@ es i) (symbol-of d))
        (unless (module-name? (@ es i))
          (return (failed-at! err file d "an export is the name of a module in the package, as text or lib/value")))
        (for ([k u32 0]) (< k i) (+= k 1)
          (when (== (@ es k) (@ es i)) (return (failed-at! err file d "this export is given twice"))))))
    (set! (-> m exports) es)
    #t))

(define (tests-of [file string] [c (ptr data)] [a (ptr arena)] [m (ptr manifest)] [err (ptr buffer)]) -> bool
  (let* ([items (items-of c)] [n u32 0] [ts (new a string (-> items length))])
    (for ([i u32 1]) (< i (-> items length)) (+= i 1)
      (let ([d (& (@ items i))])
        (cond [(and (list-of? d "browser" 1) (not (-> m test-browser))) (set! (-> m test-browser) #t)]
              [(and (string-of d (& (@ ts n))) (module-name? (@ ts n)) (not (starts? (@ ts n) "/"))) (+= n 1)]
              [else
               (return (failed-at! err file d
                                   "a test module is a path in the package, with * for any text, as \"tests/*.sub\", and (browser) comes at most once"))])))
    (when (> n 0) (set! (-> m tests) (slice ts 0 n)))
    #t))

(define (sites-of [file string] [c (ptr data)] [a (ptr arena)] [m (ptr manifest)] [err (ptr buffer)]) -> bool
  (let* ([items (items-of c)] [n (- (-> items length) 1)]
         [ss (new a declared-site n)])
    (for ([i u32 0]) (< i n) (+= i 1)
      (let* ([d (& (@ items (+ i 1)))] [parts (items-of d)] [s (& (@ ss i))] [groups (new a site-files (-> parts length))]
             [g u32 0])
        (set! (-> s html) "")
        (match d [(data-list p line column) (set! (-> s line) line) (set! (-> s column) column)] [_ (begin)])
        (unless (and (>= (-> parts length) 2) (package-name? (symbol-of (& (@ parts 0))))
                     (string-of (& (@ parts 1)) (& (-> s program))) (> (-> s program length) 0))
          (return (failed-at! err file d site-form)))
        (set! (-> s name) (symbol-of (& (@ parts 0))))
        (for ([k u32 0]) (< k i) (+= k 1)
          (when (== (-> (@ ss k) name) (-> s name)) (return (failed-at! err file d "this site's name is given twice"))))
        (for ([k u32 2]) (< k (-> parts length)) (+= k 1)
          (let ([p (& (@ parts k))])
            (cond [(and (list-of? p "html" 2) (== (-> s html length) 0) (string-of (& (@ (items-of p) 1)) (& (-> s html)))
                        (> (-> s html length) 0))
                   (begin)]
                  [(and (> (-> (items-of p) length) 0) (== (symbol-of (& (@ (items-of p) 0))) "files"))
                   (unless (files-of file p a (& (@ groups g)) err) (return #f))
                   (+= g 1)]
                  [else (return (failed-at! err file p site-form))])))
        (set! (-> s files) (slice groups 0 g))))
    (set! (-> m sites) ss)
    #t))

(define (files-of [file string] [c (ptr data)] [a (ptr arena)] [f (ptr site-files)] [err (ptr buffer)]) -> bool
  (let* ([items (items-of c)] [k u32 2] [n u32 0] [ps (new a string (-> items length))])
    (set! (-> f from) "")
    (set! (-> f root) "")
    (unless (and (>= (-> items length) 3) (string-of (& (@ items 1)) (& (-> f dir))) (starts? (-> f dir) "/"))
      (return (failed-at! err file c files-form)))
    (when (list-of? (& (@ items 2)) "from" 2)
      (let ([given (& (@ (items-of (& (@ items 2))) 1))])
        (set! (-> f root) (symbol-of given))
        (unless (or (> (-> f root length) 0) (string-of given (& (-> f from))))
          (return (failed-at! err file c files-form))))
      (set! k 3))
    (for ([i u32 k]) (< i (-> items length)) (+= i 1)
      (unless (and (string-of (& (@ items i)) (& (@ ps n))) (> (-> (@ ps n) length) 0))
        (return (failed-at! err file (& (@ items i)) files-form)))
      (+= n 1))
    (when (== n 0) (return (failed-at! err file c files-form)))
    (set! (-> f patterns) (slice ps 0 n))
    #t))

(define site-form string
  "a site is (name \"program.sub\" (html \"file.html\") (files \"/dir\" \"path\" ...) ...), and the parts after the program are optional")

(define files-form string
  "a site's files are (files \"/dir\" (from \"directory\") \"path\" ...) or (files \"/dir\" (from name) \"path\" ...), where from is optional, and in a path * matches any text in a name and ** matches any directories")

(define (module-name? [s string]) -> bool
  (let ([start u32 0])
    (for ([i u32 0]) (<= i (-> s length)) (+= i 1)
      (when (or (== i (-> s length)) (== (@ s i) #\/))
        (when (or (== i start) (== (slice s start i) ".") (== (slice s start i) "..")) (return #f))
        (set! start (+ i 1))))
    #t))

(define (dependencies-of [file string] [c (ptr data)] [a (ptr arena)] [m (ptr manifest)] [err (ptr buffer)]) -> bool
  (let* ([items (items-of c)] [n (- (-> items length) 1)]
         [ds (new a dependency n)])
    (for ([i u32 0]) (< i n) (+= i 1)
      (let* ([d (& (@ items (+ i 1)))] [parts (items-of d)] [dep (& (@ ds i))])
        (set! (-> dep path) "")
        (set! (-> dep url) "")
        (set! (-> dep hash) "")
        (match d [(data-list p line column) (set! (-> dep line) line) (set! (-> dep column) column)] [_ (begin)])
        (set! (-> dep name) (if (> (-> parts length) 0) (symbol-of (& (@ parts 0))) ""))
        (unless (package-name? (-> dep name)) (return (failed-at! err file d dependency-form)))
        (for ([k u32 0]) (< k i) (+= k 1)
          (when (== (-> (@ ds k) name) (-> dep name)) (return (failed-at! err file d "this dependency's name is given twice"))))
        (for ([k u32 1]) (< k (-> parts length)) (+= k 1)
          (let ([p (& (@ parts k))])
            (cond [(and (list-of? p "path" 2) (== (-> dep path length) 0) (string-of (& (@ (items-of p) 1)) (& (-> dep path)))
                        (> (-> dep path length) 0))
                   (begin)]
                  [(and (list-of? p "url" 2) (== (-> dep url length) 0) (string-of (& (@ (items-of p) 1)) (& (-> dep url)))
                        (> (-> dep url length) 0))
                   (begin)]
                  [(and (list-of? p "hash" 2) (== (-> dep hash length) 0) (string-of (& (@ (items-of p) 1)) (& (-> dep hash)))
                        (> (-> dep hash length) 0))
                   (begin)]
                  [else (return (failed-at! err file p dependency-form))])))
        (when (or (== (> (-> dep path length) 0) (> (-> dep url length) 0))
                  (and (> (-> dep url length) 0) (== (-> dep hash length) 0)))
          (return (failed-at! err file d dependency-form)))
        (when (and (> (-> dep url length) 0) (not (or (starts? (-> dep url) "http://") (starts? (-> dep url) "https://"))))
          (return (failed-at! err file d "a dependency's url starts with http:// or https://")))
        (when (and (> (-> dep url length) 0) (not (full-hash? (-> dep hash))))
          (return (failed-at! err file d "a url's hash is sha256: and 64 hex digits, as substrate hash prints it")))))
    (set! (-> m dependencies) ds)
    #t))

(define dependency-form string
  "a dependency is (name (path \"directory\") (hash \"sha256:hex\")), the hash optional, or (name (url \"address\") (hash \"sha256:hex\"))")

(define (full-hash? [s string]) -> bool
  (unless (and (== (-> s length) 71) (starts? s "sha256:")) (return #f))
  (for ([i u32 7]) (< i 71) (+= i 1)
    (let ([c (@ s i)]) (unless (or (and (>= c #\0) (<= c #\9)) (and (>= c #\a) (<= c #\f))) (return #f))))
  #t)
