;; Packs of files for a page's host, which subhost-web.mjs unpacks: each file's name and bytes follow their lengths as
;; little-endian u32s, in name order.
(require-unqualified host/fs)

(provide pack-files pack-add! pack-write!)

(struct packed-file [name string] [path string])

(define (pack-files [dir string] [paths (slice string)] [out string] [err (ptr buffer)]) -> bool
  (let ([files (make-buffer)])
    (and (pack-add! (& files) dir paths "" err) (pack-write! (& files) out err))))

;; pack-add! adds the files at paths, relative to dir, to files. A file is named by its path under at, or by its path
;; alone when at is "". A directory adds the files under it.
(define (pack-add! [files (ptr buffer)] [dir string] [paths (slice string)] [at string] [err (ptr buffer)]) -> bool
  (let ([ok #t])
    (for ([i u32 0]) (and ok (< i (-> paths length))) (+= i 1)
      (set! ok (add! dir (string-copy (@ paths i)) at files err)))
    ok))

;; pack-write! writes files to out as a pack, then frees them.
(define (pack-write! [files (ptr buffer)] [out string] [err (ptr buffer)]) -> bool
  (let ([pack (make-buffer)] [ok #t] [fs (cast (ptr packed-file) (-> files bytes))]
        [n (/ (-> files length) (sizeof packed-file))])
    (for ([k u32 0]) (and ok (< k n)) (+= k 1)
      (let ([name (-> (@ fs k) name)] [why error] [bytes (slice u8)])
        (if (not (fs-read-file (-> (@ fs k) path) (& bytes) (& why)))
            (set! ok (failed! err "cannot read " (& why)))
            (begin
              (buffer-add-u32! (& pack) (-> name length))
              (buffer-add-string! (& pack) name)
              (buffer-add-u32! (& pack) (-> bytes length))
              (buffer-add! (& pack) bytes)
              (free (-> bytes items))))))
    (when ok
      (let ([why error])
        (unless (fs-write-file out (buffer-bytes (& pack)) (& why)) (set! ok (failed! err "cannot write " (& why))))))
    (for ([k u32 0]) (< k n) (+= k 1)
      (free (-> (-> (@ fs k) name) bytes))
      (free (-> (-> (@ fs k) path) bytes)))
    (buffer-free! files)
    (buffer-free! (& pack))
    ok))

(define (joined [dir string] [name string]) -> string
  (let ([b (make-buffer)])
    (unless (== dir ".")
      (buffer-add-string! (& b) dir)
      (buffer-add-byte! (& b) 47))
    (buffer-add-string! (& b) name)
    (buffer-string (& b))))

(define (failed! [err (ptr buffer)] [what string] [why (ptr error)]) -> bool
  (buffer-add-string! err what)
  (buffer-add-string! err (error-text why))
  (error-free! why)
  #f)

(define (add! [dir string] [name string] [at string] [files (ptr buffer)] [err (ptr buffer)]) -> bool
  (let* ([full (joined dir name)] [why error] [info fs-info] [ok #t])
    (cond [(not (fs-stat full (& info) (& why)))
           (set! ok (failed! err "cannot read " (& why)))
           (free (-> name bytes))
           (free (-> full bytes))]
          [(== (-> info kind) fs-directory)
           (let ([listed (slice string)])
             (if (not (fs-list full (& listed) (& why)))
                 (set! ok (failed! err "cannot read " (& why)))
                 (begin
                   (for ([j u32 0]) (and ok (< j (-> listed length))) (+= j 1)
                     (set! ok (add! dir (joined name (@ listed j)) at files err)))
                   (free (-> listed items))))
             (free (-> name bytes))
             (free (-> full bytes)))]
          [else
           (let* ([f (packed-file #:name (named at name) #:path full)] [n (/ (-> files length) (sizeof packed-file))]
                  [i n])
             (buffer-add! files (slice (cast (ptr u8) (& f)) (sizeof packed-file)))
             (let ([fs (cast (ptr packed-file) (-> files bytes))])
               (while (and (> i 0) (< (-> f name) (-> (@ fs (- i 1)) name)))
                 (set! (@ fs i) (@ fs (- i 1)))
                 (-= i 1))
               (set! (@ fs i) f)))])
    ok))

(define (named [at string] [name string]) -> string
  (if (== (-> at length) 0)
      name
      (let ([full (joined (if (== (@ at (- (-> at length) 1)) #\/) (slice at 0 (- (-> at length) 1)) at) name)])
        (free (-> name bytes))
        full)))
