;; The module map the compiler takes for a program in a package. It has a root for the package and for each package its
;; dependencies reach, with the names each one uses and its rules: its exports, or its one file, and the packages inside
;; it. Every module may name std: the std a package depends on, or else the package at std. A pinned dependency's hash is
;; checked, and a package that depends on itself is refused. Packages with the same name and the same contents share a
;; root, and other packages get roots of their own. A package that says (one-copy) gets a single root instead. Every
;; package that depends on it gets the newest version that any package depends on. Each other version must be compatible
;; with that one, by the rule of the substrate clause, or the map is refused. When the newest version comes with
;; different contents, the program's own package or dependency decides which to use, and without one the map is refused.
(require-unqualified "manifest.sub")
(require-unqualified "hash.sub")
(require-unqualified "files.sub")
(require-unqualified host/fs)
(require-unqualified "path.sub")
(require-unqualified "store.sub")

(provide package-map package-root)

(struct package-root [name string] [dir string] [file string] [substrate string] [exports (slice string)])

(struct reached [m (ptr manifest)] [r package-root] [deps (ptr (ptr reached))] [label string] [hash string] [open bool]
                [used bool] [next (ptr reached)])

(struct graph [first (ptr reached)] [last (ptr reached)])

(define (package-map [a (ptr arena)] [dir string] [file string] [m (ptr manifest)] [std string] [store string] [testing bool]
                     [into (ptr buffer)] [roots (ptr buffer)] [err (ptr buffer)]) -> bool
  (let ([g graph] [sm manifest] [s (ptr reached) 0])
    (set! (-> g first) 0)
    (set! (-> g last) 0)
    (when (== (visit! a (normal-path a dir) file m store (& g) err) 0) (return #f))
    (unless (one-copied! a (& g) err) (return #f))
    (unless (or (!= (named (& g) "std") 0) (== (-> std length) 0))
      (let ([std-file (joined-path std "package.sub")] [ok #f])
        (set! ok (dependency-manifest-read a std-file (& sm) err))
        (free (-> std-file bytes))
        (unless (and ok (!= (visit! a (normal-path a std) "" (& sm) store (& g) err) 0)) (return #f))))
    (unless (labeled! a (& g) err) (return #f))
    (set! s (-> g first))
    (while (!= s 0)
      (when (first-labeled? (& g) s) (emit! a s (and testing (== s (-> g first))) into roots))
      (set! s (-> s next)))
    (set! s (named (& g) "std"))
    (when (!= s 0)
      (buffer-add-string! into "(uses (std ")
      (buffer-add-string! into (-> s label))
      (buffer-add-string! into "))\n"))
    #t))

(define (named [g (ptr graph)] [name string]) -> (ptr reached)
  (let ([s (-> g first)])
    (while (!= s 0)
      (when (== (-> s m name) name) (return s))
      (set! s (-> s next)))
    0))

(define (at [g (ptr graph)] [dir string]) -> (ptr reached)
  (let ([s (-> g first)])
    (while (!= s 0)
      (when (and (same-path? (-> s r dir) dir) (== (-> s r file length) 0)) (return s))
      (set! s (-> s next)))
    0))

(define (visit! [a (ptr arena)] [dir string] [file string] [m (ptr manifest)] [store string] [g (ptr graph)]
                [err (ptr buffer)]) -> (ptr reached)
  (let* ([deps (-> m dependencies)] [n (-> deps length)]
         [dirs (new a string n)] [ms (new a manifest n)] [me (new a reached)] [other (ptr reached) 0])
    (set! (-> me m) m)
    (set! (-> me r dir) dir)
    (set! (-> me r file) file)
    (set! (-> me r substrate) (-> m substrate))
    (set! (-> me deps) (-> (new a (ptr reached) n) items))
    (set! (-> me hash) "")
    (set! (-> me open) #t)
    (set! (-> me used) #f)
    (set! (-> me next) 0)
    (if (== (-> g last) 0) (set! (-> g first) me) (set! (-> g last next) me))
    (set! (-> g last) me)
    (unless (or (> (-> file length) 0) (exports-of! a dir m (& (-> me r)) err)) (return 0))
    (for ([i u32 0]) (< i n) (+= i 1)
      (let* ([d (& (@ deps i))] [given (-> d path)] [sub string] [info fs-info])
        (if (> (-> d url length) 0)
            (set! (@ dirs i) (store-entry a store (-> d hash)))
            (let ([full (if (absolute-path? given) (string-copy given) (joined-path dir given))])
              (set! (@ dirs i) (normal-path a full))
              (free (-> full bytes))))
        (when (and (> (-> d url length) 0)
                   (or (not (fs-stat (@ dirs i) (& info) 0)) (!= (-> info kind) fs-directory)))
          (buffer-add-string! err (-> d name))
          (buffer-add-string! err ", from ")
          (buffer-add-string! err (-> d url))
          (buffer-add-string! err ", is not fetched")
          (return 0))
        (when (and (== (-> d url length) 0) (within? dir store) (not (within? (@ dirs i) dir)))
          (buffer-add-string! err "the fetched package ")
          (buffer-add-string! err (-> m name))
          (buffer-add-string! err " depends on ")
          (buffer-add-string! err given)
          (buffer-add-string! err ", outside it")
          (return 0))
        (set! sub (joined-path (@ dirs i) "package.sub"))
        (unless (dependency-manifest-read a sub (& (@ ms i)) err)
          (free (-> sub bytes))
          (return 0))
        (free (-> sub bytes))
        (unless (pinned? (@ dirs i) (-> d hash) err) (return 0))))
    (for ([i u32 0]) (< i n) (+= i 1)
      (set! other (at g (@ dirs i)))
      (cond [(== other 0)
             (set! other (visit! a (@ dirs i) "" (& (@ ms i)) store g err))
             (when (== other 0) (return 0))]
            [(-> other open)
             (buffer-add-string! err "the package ")
             (buffer-add-string! err (-> other m name))
             (buffer-add-string! err " depends on itself")
             (return 0)])
      (set! (@ (-> me deps) i) other))
    (set! (-> me open) #f)
    me))

(define (labeled! [a (ptr arena)] [g (ptr graph)] [err (ptr buffer)]) -> bool
  (let ([s (-> g first next)])
    (while (!= s 0)
      (unless (or (not (shared-name? g s)) (hashed! a s err)) (return #f))
      (set! s (-> s next)))
    (set! s (-> g first))
    (while (!= s 0)
      (set! (-> s label) (if (or (== s (-> g first)) (one-kind? g s)) (-> s m name) (hash-label a s)))
      (set! s (-> s next)))
    #t))

(define (shared-name? [g (ptr graph)] [s (ptr reached)]) -> bool
  (let ([t (-> g first)])
    (while (!= t 0)
      (when (and (!= t s) (== (-> t m name) (-> s m name))) (return #t))
      (set! t (-> t next)))
    #f))

(define (one-kind? [g (ptr graph)] [s (ptr reached)]) -> bool
  (let ([t (-> g first)])
    (while (!= t 0)
      (when (and (!= t s) (== (-> t m name) (-> s m name)) (or (== t (-> g first)) (!= (-> t hash) (-> s hash))))
        (return #f))
      (set! t (-> t next)))
    #t))

(define (hashed! [a (ptr arena)] [s (ptr reached)] [err (ptr buffer)]) -> bool
  (let ([b (make-buffer)] [ok #f])
    (set! ok (package-hash (-> s r dir) (& b) err))
    (when ok (set! (-> s hash) (kept a (buffer-string (& b)))))
    (buffer-free! (& b))
    ok))

(define (hash-label [a (ptr arena)] [s (ptr reached)]) -> string
  (let ([b (make-buffer)] [out string])
    (buffer-add-string! (& b) (-> s m name))
    (buffer-add-byte! (& b) #\@)
    (buffer-add-string! (& b) (slice (-> s hash) 7 19))
    (set! out (kept a (buffer-string (& b))))
    (buffer-free! (& b))
    out))

(define (first-labeled? [g (ptr graph)] [s (ptr reached)]) -> bool
  (let ([t (-> g first)])
    (while (!= t s)
      (when (== (-> t label) (-> s label)) (return #f))
      (set! t (-> t next)))
    #t))

(define (emit! [a (ptr arena)] [s (ptr reached)] [testing bool] [into (ptr buffer)] [roots (ptr buffer)])
  (let ([deps (-> s m dependencies)])
    (set! (-> s r name) (-> s label))
    (buffer-add! roots (slice (cast (ptr u8) (& (-> s r))) (sizeof package-root)))
    (buffer-add-string! into "(root ")
    (buffer-add-string! into (-> s label))
    (buffer-add-byte! into #\space)
    (add-quoted! into (-> s r dir))
    (buffer-add-string! into " (uses")
    (for ([i u32 0]) (< i (-> deps length)) (+= i 1)
      (buffer-add-string! into " (")
      (buffer-add-string! into (-> (@ deps i) name))
      (buffer-add-byte! into #\space)
      (buffer-add-string! into (-> (@ (-> s deps) i) label))
      (buffer-add-byte! into #\)))
    (buffer-add-byte! into #\))
    (rules! into (& (-> s r)))
    (unless (> (-> s r file length) 0) (nested! a into (-> s r dir)))
    (when testing (buffer-add-string! into " (test)"))
    (buffer-add-string! into ")\n")))

;; ---- one copy ----

(define (one-copied! [a (ptr arena)] [g (ptr graph)] [err (ptr buffer)]) -> bool
  (let ([s (-> g first)])
    (while (!= s 0)
      (if (and (shared-name? g s) (one-copy? g (-> s m name)))
          (begin
            (unless (merged! a g (-> s m name) err) (return #f))
            (pruned! g)
            (set! s (-> g first)))
          (set! s (-> s next))))
    #t))

(define (one-copy? [g (ptr graph)] [name string]) -> bool
  (let ([s (-> g first)])
    (while (!= s 0)
      (when (and (== (-> s m name) name) (-> s m one-copy)) (return #t))
      (set! s (-> s next)))
    #f))

(define (merged! [a (ptr arena)] [g (ptr graph)] [name string] [err (ptr buffer)]) -> bool
  (let ([root (-> g first)] [best (ptr reached) 0] [s (-> g first)])
    (while (!= s 0)
      (when (== (-> s m name) name)
        (when (and (== (-> s hash length) 0) (not (hashed! a s err))) (return #f))
        (when (or (== best 0) (version-before? (-> best m version) (-> s m version))
                  (and (== (-> s m version) (-> best m version)) (chosen? root s) (not (chosen? root best))))
          (set! best s)))
      (set! s (-> s next)))
    (set! s (-> g first))
    (while (!= s 0)
      (when (and (== (-> s m name) name) (!= (-> s hash) (-> best hash)))
        (cond [(== s root)
               (return (said! err (slice (array-of string name " has one copy in a program, but " (dependent g best)
                                                   " depends on " name " " (-> best m version)
                                                   ", which is newer than the program's own " name " "
                                                   (-> root m version)))))]
              [(not (version-compatible? (-> best m version) (-> s m version)))
               (return (said! err (slice (array-of string name " has one copy in a program, but " (dependent g best)
                                                   " depends on " name " " (-> best m version) " and " (dependent g s)
                                                   " depends on " name " " (-> s m version)
                                                   ", which are not compatible"))))]
              [(and (== (-> s m version) (-> best m version)) (not (and (chosen? root best) (not (chosen? root s)))))
               (return (said! err (slice (array-of string name " has one copy in a program, but " (dependent g best)
                                                   " and " (dependent g s) " depend on different contents of " name
                                                   " " (-> best m version)
                                                   ". The program can choose one by depending on it"))))]))
      (set! s (-> s next)))
    (set! s (-> g first))
    (while (!= s 0)
      (for ([i u32 0]) (< i (-> s m dependencies length)) (+= i 1)
        (when (== (-> (@ (-> s deps) i) m name) name) (set! (@ (-> s deps) i) best)))
      (set! s (-> s next)))
    #t))

(define (chosen? [root (ptr reached)] [t (ptr reached)]) -> bool
  (when (== t root) (return #t))
  (for ([i u32 0]) (< i (-> root m dependencies length)) (+= i 1) (when (== (@ (-> root deps) i) t) (return #t)))
  #f)

(define (dependent [g (ptr graph)] [t (ptr reached)]) -> string
  (let ([s (-> g first)])
    (while (!= s 0)
      (for ([i u32 0]) (< i (-> s m dependencies length)) (+= i 1)
        (when (== (@ (-> s deps) i) t) (return (-> s m name))))
      (set! s (-> s next)))
    (-> t m name)))

(define (said! [err (ptr buffer)] [parts (slice string)]) -> bool
  (for ([i u32 0]) (< i (-> parts length)) (+= i 1) (buffer-add-string! err (@ parts i)))
  #f)

(define (pruned! [g (ptr graph)])
  (let ([s (-> g first)] [last (ptr reached) 0])
    (while (!= s 0)
      (set! (-> s used) #f)
      (set! s (-> s next)))
    (used! (-> g first))
    (set! s (-> g first))
    (while (!= s 0)
      (when (-> s used)
        (if (== last 0) (set! (-> g first) s) (set! (-> last next) s))
        (set! last s))
      (set! s (-> s next)))
    (set! (-> last next) 0)
    (set! (-> g last) last)))

(define (used! [s (ptr reached)])
  (unless (-> s used)
    (set! (-> s used) #t)
    (for ([i u32 0]) (< i (-> s m dependencies length)) (+= i 1) (used! (@ (-> s deps) i)))))

(define (pinned? [dir string] [pin string] [err (ptr buffer)]) -> bool
  (let ([h (make-buffer)] [ok #t])
    (when (== (-> pin length) 0) (return #t))
    (set! ok (package-hash dir (& h) err))
    (when (and ok (!= (buffer-string (& h)) pin))
      (buffer-add-string! err "the package at ")
      (buffer-add-string! err dir)
      (buffer-add-string! err " has the hash ")
      (buffer-add-string! err (buffer-string (& h)))
      (buffer-add-string! err ", not the one its dependency pins, ")
      (buffer-add-string! err pin)
      (set! ok #f))
    (buffer-free! (& h))
    ok))

(define (exports-of! [a (ptr arena)] [dir string] [m (ptr manifest)] [r (ptr package-root)] [err (ptr buffer)]) -> bool
  (let ([es (make-buffer)] [ok #f])
    (set! ok (package-exports a dir m (& es) err))
    (set! (-> r exports) (under a dir (& es)))
    (buffer-free! (& es))
    ok))

(define (under [a (ptr arena)] [dir string] [b (ptr buffer)]) -> (slice string)
  (let* ([n (/ (-> b length) (sizeof string))] [ps (cast (ptr string) (-> b bytes))] [out (new a string n)])
    (for ([i u32 0]) (< i n) (+= i 1)
      (let ([full (joined-path dir (@ ps i))])
        (set! (@ out i) (normal-path a full))
        (free (-> full bytes))))
    out))

(define (rules! [b (ptr buffer)] [r (ptr package-root)])
  (if (> (-> r file length) 0)
      (begin
        (buffer-add-string! b " (file ")
        (add-quoted! b (-> r file))
        (buffer-add-byte! b #\)))
      (paths! b " (exports" (-> r dir) (-> r exports))))

(define (nested! [a (ptr arena)] [b (ptr buffer)] [dir string])
  (let ([found (make-buffer)])
    (package-tree a dir (cast (ptr buffer) 0) (& found))
    (let ([ps (cast (ptr nested-package) (-> found bytes))] [n (/ (-> found length) (sizeof nested-package))])
      (when (> n 0)
        (buffer-add-string! b " (packages")
        (for ([i u32 0]) (< i n) (+= i 1)
          (buffer-add-string! b " (")
          (buffer-add-string! b (-> (@ ps i) name))
          (buffer-add-byte! b #\space)
          (add-quoted! b (-> (@ ps i) path))
          (buffer-add-byte! b #\)))
        (buffer-add-byte! b #\))))
    (buffer-free! (& found))))

(define (paths! [b (ptr buffer)] [head string] [dir string] [ps (slice string)])
  (buffer-add-string! b head)
  (for ([i u32 0]) (< i (-> ps length)) (+= i 1)
    (buffer-add-byte! b #\space)
    (add-quoted! b (slice (@ ps i) (+ (-> dir length) 1))))
  (buffer-add-byte! b #\)))

(define (add-quoted! [b (ptr buffer)] [s string])
  (buffer-add-byte! b #\")
  (for ([i u32 0]) (< i (-> s length)) (+= i 1)
    (let ([c (@ s i)])
      (when (or (== c #\") (== c #\\)) (buffer-add-byte! b #\\))
      (buffer-add-byte! b (cast i32 c))))
  (buffer-add-byte! b #\"))

