;; The module map the compiler takes for a program in a package: a root for the package and for each package its
;; dependencies reach, with the names each uses, and each package's exports and files for sub's module check. A pinned
;; dependency's hash is checked, and two packages with one name, and a package that depends on itself, are refused.
(require-unqualified manifest "manifest.sub")
(require-unqualified hash "hash.sub")
(require-unqualified files "files.sub")
(require-unqualified fs host/fs)
(require-unqualified paths "path.sub")
(require-unqualified stores "store.sub")

(provide package-map package-root)

(struct seen [name string] [dir string] [open bool] [next (ptr seen)])

(struct package-root [name string] [dir string] [file string] [exports (slice string)] [files (slice string)])

(define (package-map [a (ptr arena)] [dir string] [file string] [m (ptr manifest)] [store string] [into (ptr buffer)]
                     [roots (ptr buffer)] [err (ptr buffer)]) -> bool
  (let ([visited (ptr seen) 0])
    (root! a dir file m store into roots err (& visited))))

(define (root! [a (ptr arena)] [dir string] [file string] [m (ptr manifest)] [store string] [into (ptr buffer)]
               [roots (ptr buffer)] [err (ptr buffer)] [visited (ptr (ptr seen))]) -> bool
  (let* ([deps (-> m dependencies)] [n (-> deps length)]
         [dirs (cast (ptr string) (arena-alloc a (* n (sizeof string))))]
         [ms (cast (ptr manifest) (arena-alloc a (* n (sizeof manifest))))]
         [me (cast (ptr seen) (arena-alloc a (sizeof seen)))] [other (ptr seen) 0] [r package-root])
    (set! (-> me name) (-> m name))
    (set! (-> me dir) dir)
    (set! (-> me open) #t)
    (set! (-> me next) (@ visited))
    (set! (@ visited) me)
    (set! (-> r name) (-> m name))
    (set! (-> r dir) dir)
    (set! (-> r file) file)
    (set! (-> r exports) (slice (cast (ptr string) 0) 0))
    (set! (-> r files) (slice (cast (ptr string) 0) 0))
    (unless (or (> (-> file length) 0) (files-of! a dir m (& r) err)) (return #f))
    (buffer-add! roots (slice (cast (ptr u8) (& r)) (sizeof package-root)))
    (buffer-add-string! into "(root ")
    (buffer-add-string! into (-> m name))
    (buffer-add-byte! into 32)
    (add-quoted! into dir)
    (buffer-add-string! into " (uses")
    (for ([i u32 0]) (< i n) (+= i 1)
      (let* ([d (& (@ deps i))] [given (-> d path)] [sub string] [info fs-info])
        (if (> (-> d url length) 0)
            (set! (@ dirs i) (store-entry a store (-> d hash)))
            (let ([full (if (and (> (-> given length) 0) (== (@ given 0) #\/)) (string-copy given) (joined-path dir given))])
              (set! (@ dirs i) (normal-path a full))
              (free (-> full bytes))))
        (when (and (> (-> d url length) 0)
                   (or (!= (fs-stat (@ dirs i) (& info) 0) 0) (!= (-> info kind) fs-directory)))
          (buffer-add-string! err (-> d name))
          (buffer-add-string! err ", from ")
          (buffer-add-string! err (-> d url))
          (buffer-add-string! err ", is not fetched")
          (return #f))
        (when (and (== (-> d url length) 0) (within? dir store) (not (within? (@ dirs i) dir)))
          (buffer-add-string! err "the fetched package ")
          (buffer-add-string! err (-> m name))
          (buffer-add-string! err " depends on ")
          (buffer-add-string! err given)
          (buffer-add-string! err ", outside it")
          (return #f))
        (set! sub (joined-path (@ dirs i) "package.sub"))
        (unless (manifest-read a sub (& (@ ms i)) err)
          (free (-> sub bytes))
          (return #f))
        (free (-> sub bytes))
        (unless (pinned? (@ dirs i) (-> d hash) err) (return #f))
        (buffer-add-string! into " (")
        (buffer-add-string! into (-> d name))
        (buffer-add-byte! into 32)
        (buffer-add-string! into (-> (@ ms i) name))
        (buffer-add-byte! into #\))))
    (buffer-add-string! into "))\n")
    (for ([i u32 0]) (< i n) (+= i 1)
      (set! other (@ visited))
      (while (and (!= other 0) (!= (-> other name) (-> (@ ms i) name))) (set! other (-> other next)))
      (cond [(== other 0) (unless (root! a (@ dirs i) "" (& (@ ms i)) store into roots err visited) (return #f))]
            [(!= (-> other dir) (@ dirs i))
             (buffer-add-string! err "two packages are named ")
             (buffer-add-string! err (-> other name))
             (buffer-add-string! err ": ")
             (buffer-add-string! err (-> other dir))
             (buffer-add-string! err " and ")
             (buffer-add-string! err (@ dirs i))
             (return #f)]
            [(-> other open)
             (buffer-add-string! err "the package ")
             (buffer-add-string! err (-> other name))
             (buffer-add-string! err " depends on itself")
             (return #f)]))
    (set! (-> me open) #f)
    #t))

(define (pinned? [dir string] [pin string] [err (ptr buffer)]) -> bool
  (let ([h (make-buffer)] [ok #t])
    (when (== (-> pin length) 0) (return #t))
    (set! ok (package-hash dir (& h) err))
    (when (and ok (!= (buffer-string (& h)) pin))
      (buffer-add-string! err "the package at ")
      (buffer-add-string! err dir)
      (buffer-add-string! err " has the hash ")
      (buffer-add-string! err (buffer-string (& h)))
      (buffer-add-string! err ", not the one its dependency pins, ")
      (buffer-add-string! err pin)
      (set! ok #f))
    (buffer-free! (& h))
    ok))

(define (files-of! [a (ptr arena)] [dir string] [m (ptr manifest)] [r (ptr package-root)] [err (ptr buffer)]) -> bool
  (let ([fs (make-buffer)] [es (make-buffer)] [ok #f])
    (set! ok (package-files a dir m (& fs) (& es) err))
    (set! (-> r files) (under a dir (& fs)))
    (set! (-> r exports) (under a dir (& es)))
    (buffer-free! (& fs))
    (buffer-free! (& es))
    ok))

(define (under [a (ptr arena)] [dir string] [b (ptr buffer)]) -> (slice string)
  (let* ([n (/ (-> b length) (sizeof string))] [ps (cast (ptr string) (-> b bytes))]
         [out (cast (ptr string) (arena-alloc a (* n (sizeof string))))])
    (for ([i u32 0]) (< i n) (+= i 1)
      (let ([full (joined-path dir (@ ps i))])
        (set! (@ out i) (normal-path a full))
        (free (-> full bytes))))
    (slice out n)))

(define (add-quoted! [b (ptr buffer)] [s string])
  (buffer-add-byte! b #\")
  (for ([i u32 0]) (< i (-> s length)) (+= i 1)
    (let ([c (@ s i)])
      (when (or (== c #\") (== c #\\)) (buffer-add-byte! b #\\))
      (buffer-add-byte! b (cast i32 c))))
  (buffer-add-byte! b #\"))

