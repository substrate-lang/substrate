;; The module map the compiler takes for a program in a package: a root for the package and for each package its
;; dependencies reach, with the names each uses, and (compiler-memory) for each the program trusts. A pinned dependency's
;; hash is checked, and two packages with one name are refused.
(require-unqualified manifest "manifest.sub")
(require-unqualified hash "hash.sub")

(provide package-map package-root package-use normal-path)

(struct seen [name string] [dir string] [next (ptr seen)])

;; A name a package uses: its own name for the dependency, the dependency's package, and whether it marks it (trusted).
(struct package-use [name string] [package string] [trusted bool])

;; A package of the map: its name, its directory from /, its only file when it is one file, or "", the names it uses,
;; and whether the program trusts it.
(struct package-root [name string] [dir string] [file string] [uses (slice package-use)] [trusted bool])

;; package-map adds the module map for the package with manifest m at dir, from /, to into, and a package-root for each
;; of its packages to roots: file is the package's only file when it is one file, or "". It adds a
;; (root name "directory" (uses (name package) ...)) form for the package and each one its dependencies reach, with
;; (compiler-memory) for each the program trusts. When it fails, err says why.
(define (package-map [a (ptr arena)] [dir string] [file string] [m (ptr manifest)] [into (ptr buffer)]
                     [roots (ptr buffer)] [err (ptr buffer)]) -> bool
  (let ([visited (ptr seen) 0] [rs (ptr package-root) 0] [n u32 0])
    (unless (root! a dir file m roots err (& visited)) (return #f))
    (set! rs (cast (ptr package-root) (-> roots bytes)))
    (set! n (/ (-> roots length) (sizeof package-root)))
    (trust! rs n)
    (for ([i u32 0]) (< i n) (+= i 1) (root-form! into (& (@ rs i))))
    #t))

;; trust! marks the packages the program trusts: each its own manifest marks (trusted), and each package these depend
;; on. A dependency's own (trusted) marks nothing, so that no package brings code of its choosing into the compiler's
;; memory.
(define (trust! [rs (ptr package-root)] [n u32])
  (let ([changed #t] [uses (-> rs uses)])
    (for ([k u32 0]) (< k (-> uses length)) (+= k 1)
      (when (-> (@ uses k) trusted) (trusted! rs n (-> (@ uses k) package))))
    (while changed
      (set! changed #f)
      (for ([i u32 0]) (< i n) (+= i 1)
        (when (-> (@ rs i) trusted)
          (set! uses (-> (@ rs i) uses))
          (for ([k u32 0]) (< k (-> uses length)) (+= k 1)
            (when (trusted! rs n (-> (@ uses k) package)) (set! changed #t))))))))

;; trusted! marks the package named name, giving whether it was not marked before.
(define (trusted! [rs (ptr package-root)] [n u32] [name string]) -> bool
  (for ([i u32 0]) (< i n) (+= i 1)
    (let ([r (& (@ rs i))])
      (when (and (== (-> r name) name) (not (-> r trusted)))
        (set! (-> r trusted) #t)
        (return #t))))
  #f)

(define (root-form! [into (ptr buffer)] [r (ptr package-root)])
  (buffer-add-string! into "(root ")
  (buffer-add-string! into (-> r name))
  (buffer-add-byte! into 32)
  (add-quoted! into (-> r dir))
  (buffer-add-string! into " (uses")
  (for ([k u32 0]) (< k (-> r uses length)) (+= k 1)
    (buffer-add-string! into " (")
    (buffer-add-string! into (-> (@ (-> r uses) k) name))
    (buffer-add-byte! into 32)
    (buffer-add-string! into (-> (@ (-> r uses) k) package))
    (buffer-add-byte! into #\)))
  (buffer-add-byte! into #\))
  (when (-> r trusted) (buffer-add-string! into " (compiler-memory)"))
  (buffer-add-string! into ")\n"))

(define (root! [a (ptr arena)] [dir string] [file string] [m (ptr manifest)] [roots (ptr buffer)] [err (ptr buffer)]
               [visited (ptr (ptr seen))]) -> bool
  (let* ([deps (-> m dependencies)] [n (-> deps length)]
         [dirs (cast (ptr string) (arena-alloc a (* n (sizeof string))))]
         [ms (cast (ptr manifest) (arena-alloc a (* n (sizeof manifest))))]
         [uses (cast (ptr package-use) (arena-alloc a (* n (sizeof package-use))))]
         [me (cast (ptr seen) (arena-alloc a (sizeof seen)))] [other (ptr seen) 0] [r package-root])
    (set! (-> me name) (-> m name))
    (set! (-> me dir) dir)
    (set! (-> me next) (@ visited))
    (set! (@ visited) me)
    (for ([i u32 0]) (< i n) (+= i 1)
      (let* ([d (& (@ deps i))] [given (-> d path)]
             [full (if (and (> (-> given length) 0) (== (@ given 0) #\/)) (string-copy given) (joined-path dir given))]
             [sub string] [u (& (@ uses i))])
        (set! (@ dirs i) (normal-path a full))
        (free (-> full bytes))
        (set! sub (joined-path (@ dirs i) "package.sub"))
        (unless (manifest-read a sub (& (@ ms i)) err)
          (free (-> sub bytes))
          (return #f))
        (free (-> sub bytes))
        (unless (pinned? (@ dirs i) (-> d hash) err) (return #f))
        (set! (-> u name) (-> d name))
        (set! (-> u package) (-> (@ ms i) name))
        (set! (-> u trusted) (-> d trusted))))
    (set! (-> r name) (-> m name))
    (set! (-> r dir) dir)
    (set! (-> r file) file)
    (set! (-> r uses) (slice uses n))
    (set! (-> r trusted) #f)
    (buffer-add! roots (slice (cast (ptr u8) (& r)) (sizeof package-root)))
    (for ([i u32 0]) (< i n) (+= i 1)
      (set! other (@ visited))
      (while (and (!= other 0) (!= (-> other name) (-> (@ ms i) name))) (set! other (-> other next)))
      (cond [(== other 0) (unless (root! a (@ dirs i) "" (& (@ ms i)) roots err visited) (return #f))]
            [(!= (-> other dir) (@ dirs i))
             (buffer-add-string! err "two packages are named ")
             (buffer-add-string! err (-> other name))
             (buffer-add-string! err ": ")
             (buffer-add-string! err (-> other dir))
             (buffer-add-string! err " and ")
             (buffer-add-string! err (@ dirs i))
             (return #f)]))
    #t))

(define (pinned? [dir string] [pin string] [err (ptr buffer)]) -> bool
  (let ([h (make-buffer)] [ok #t])
    (when (== (-> pin length) 0) (return #t))
    (set! ok (package-hash dir (& h) err))
    (when (and ok (!= (buffer-string (& h)) pin))
      (buffer-add-string! err "the package at ")
      (buffer-add-string! err dir)
      (buffer-add-string! err " has the hash ")
      (buffer-add-string! err (buffer-string (& h)))
      (buffer-add-string! err ", not the one its dependency pins, ")
      (buffer-add-string! err pin)
      (set! ok #f))
    (buffer-free! (& h))
    ok))

(define (add-quoted! [b (ptr buffer)] [s string])
  (buffer-add-byte! b #\")
  (for ([i u32 0]) (< i (-> s length)) (+= i 1)
    (let ([c (@ s i)])
      (when (or (== c #\") (== c #\\)) (buffer-add-byte! b #\\))
      (buffer-add-byte! b (cast i32 c))))
  (buffer-add-byte! b #\"))

;; normal-path gives a path from / without . or .. parts, in a.
(define (normal-path [a (ptr arena)] [path string]) -> string
  (let ([parts (make-buffer)] [out (make-buffer)] [start u32 0] [n u32 0] [p string] [s string])
    (for ([i u32 0]) (<= i (-> path length)) (+= i 1)
      (when (or (== i (-> path length)) (== (@ path i) #\/))
        (set! p (slice path start i))
        (cond [(or (== (-> p length) 0) (== p ".")) (begin)]
              [(== p "..") (when (> n 0) (-= n 1) (set! (-> parts length) (* n (sizeof string))))]
              [else (buffer-add! (& parts) (slice (cast (ptr u8) (& p)) (sizeof string))) (+= n 1)])
        (set! start (+ i 1))))
    (for ([i u32 0]) (< i n) (+= i 1)
      (buffer-add-byte! (& out) #\/)
      (buffer-add-string! (& out) (@ (cast (ptr string) (-> parts bytes)) i)))
    (when (== n 0) (buffer-add-byte! (& out) #\/))
    (set! s (cast string (slice (cast (ptr u8) (arena-alloc a (-> out length))) (-> out length))))
    (memcpy (-> s bytes) (-> out bytes) (-> out length))
    (buffer-free! (& parts))
    (buffer-free! (& out))
    s))
