;; A package's files: the modules it exports, name.sub and those its (exports ...) names, and the files they reach
;; through the requires their source writes, by a path or by the package's name, found as the compiler finds them. A
;; file required but missing is still one of them; one reached through a link is refused.
(require-unqualified macros compiler/macros)
(require-unqualified rt compiler/roots)
(require-unqualified manifest "manifest.sub")
(require-unqualified paths "path.sub")
(require-unqualified fs host/fs)

(provide package-files package-exports files-from linked?)

(define (package-files [a (ptr arena)] [dir string] [m (ptr manifest)] [files (ptr buffer)] [exports (ptr buffer)]
                       [err (ptr buffer)]) -> bool
  (and (package-exports a dir m exports err) (files-from a dir (-> m name) exports files err)))

(define (package-exports [a (ptr arena)] [dir string] [m (ptr manifest)] [exports (ptr buffer)] [err (ptr buffer)]) -> bool
  (let ([d (string->datum dir)] [entry (make-buffer)] [p string] [ok #t])
    (buffer-add-string! (& entry) (-> m name))
    (buffer-add-string! (& entry) ".sub")
    (set! p (kept a (buffer-string (& entry))))
    (buffer-free! (& entry))
    (when (file-in? dir p) (added! exports p))
    (for ([i u32 0]) (and ok (< i (-> m exports length))) (+= i 1)
      (set! p (kept a (datum->string (named-file d (string->datum (@ (-> m exports) i))))))
      (cond [(not (file-in? dir p))
             (buffer-add-string! err "the package ")
             (buffer-add-string! err (-> m name))
             (buffer-add-string! err " exports ")
             (buffer-add-string! err (@ (-> m exports) i))
             (buffer-add-string! err ", which is not one of its modules")
             (set! ok #f)]
            [(not (holds? exports p)) (added! exports p)]))
    ok))

;; files-from gives the files of the package label in dir that the files in starts reach, starts among them.
(define (files-from [a (ptr arena)] [dir string] [label string] [starts (ptr buffer)] [files (ptr buffer)]
                    [err (ptr buffer)]) -> bool
  (let ([d (string->datum dir)] [todo (make-buffer)] [p string] [ok #t])
    (buffer-add! (& todo) (buffer-bytes starts))
    (while (and ok (> (-> todo length) 0))
      (set! p (popped! (& todo)))
      (unless (holds? files p)
        (added! files p)
        (cond [(linked? dir p)
               (buffer-add-string! err p)
               (buffer-add-string! err " goes through a link in the package ")
               (buffer-add-string! err label)
               (buffer-add-string! err ", which packages do not allow")
               (set! ok #f)]
              [(and (ends? p ".sub") (file-in? dir p))
               (try (let ([rs (written-requires d (string->datum label) (string->datum p))])
                      (while (pair? rs)
                        (added! (& todo) (kept a (datum->string (car rs))))
                        (set! rs (cdr rs))))
                    [catch compile-error (message blamed loc)
                     (write-error err message blamed loc)
                     (when (and (> (-> err length) 0) (== (@ (-> err bytes) (- (-> err length) 1)) 10)) (-= (-> err length) 1))
                     (set! ok #f)])])))
    (buffer-free! (& todo))
    ok))

(define (linked? [dir string] [p string]) -> bool
  (let ([info fs-info] [found #f])
    (for ([i u32 1]) (and (not found) (<= i (-> p length))) (+= i 1)
      (when (or (== i (-> p length)) (== (@ p i) #\/))
        (let ([full (joined-path dir (slice p 0 i))])
          (set! found (and (== (fs-lstat full (& info) 0) 0) (== (-> info kind) fs-link)))
          (free (-> full bytes)))))
    found))

(define (file-in? [dir string] [p string]) -> bool
  (let ([full (joined-path dir p)] [info fs-info] [found #f])
    (set! found (and (== (fs-stat full (& info) 0) 0) (== (-> info kind) fs-file)))
    (free (-> full bytes))
    found))

(define (kept [a (ptr arena)] [s string]) -> string
  (let ([out (cast string (slice (cast (ptr u8) (arena-alloc a (-> s length))) (-> s length)))])
    (memcpy (-> out bytes) (-> s bytes) (-> s length))
    out))

(define (added! [b (ptr buffer)] [p string]) (buffer-add! b (slice (cast (ptr u8) (& p)) (sizeof string))))

(define (holds? [b (ptr buffer)] [p string]) -> bool
  (let ([ps (cast (ptr string) (-> b bytes))])
    (for ([i u32 0]) (< i (/ (-> b length) (sizeof string))) (+= i 1) (when (== (@ ps i) p) (return #t)))
    #f))

(define (popped! [b (ptr buffer)]) -> string
  (let ([n (/ (-> b length) (sizeof string))])
    (set! (-> b length) (* (- n 1) (sizeof string)))
    (@ (cast (ptr string) (-> b bytes)) (- n 1))))
