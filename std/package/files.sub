;; A package's files are the files under its directory. Its build/ directory, .git directories, links, and the packages
;; inside it, which are directories with their own package.sub, are left out. When a git repository tracks the package's
;; package.sub, only the files git tracks count. A package exports name.sub, if it has one, and the modules its
;; (exports ...) clause names.
(require-unqualified compiler/macros)
(require-unqualified compiler/roots)
(require-unqualified "manifest.sub")
(require-unqualified "git.sub")
(require-unqualified "path.sub")
(require-unqualified host/fs)

(provide package-files package-exports package-tree tracked-files nested-package)

(struct nested-package [name string] [path string])

(define (package-files [a (ptr arena)] [dir string] [files (ptr buffer)] [err (ptr buffer)]) -> bool
  (tracked-files a dir "package.sub" files err))

;; tracked-files adds the files package-tree finds. When a git repository tracks dir's marker file, it adds only the files
;; git tracks. It gives #f when it cannot read git's index.
(define (tracked-files [a (ptr arena)] [dir string] [marker string] [files (ptr buffer)] [err (ptr buffer)]) -> bool
  (let ([all (make-buffer)] [nested (make-buffer)] [tracked (make-buffer)] [marked #f] [ok #f])
    (package-tree a dir (& all) (& nested))
    (set! ok (git-tracked a dir marker (& tracked) (& marked) err))
    (let ([ps (cast (ptr string) (-> all bytes))] [ts (cast (ptr string) (-> tracked bytes))]
          [t (/ (-> tracked length) (sizeof string))])
      (for ([i u32 0]) (and ok (< i (/ (-> all length) (sizeof string)))) (+= i 1)
        (when (or (not marked) (listed? ts t (@ ps i))) (added! files (@ ps i)))))
    (buffer-free! (& all))
    (buffer-free! (& nested))
    (buffer-free! (& tracked))
    ok))

(define (listed? [ts (ptr string)] [n u32] [p string]) -> bool
  (let ([lo u32 0] [hi n])
    (while (< lo hi)
      (let ([mid (/ (+ lo hi) 2)])
        (cond [(== (@ ts mid) p) (return #t)]
              [(< (@ ts mid) p) (set! lo (+ mid 1))]
              [else (set! hi mid)])))
    #f))

;; package-tree adds the paths of dir's files, relative to dir, to files unless files is 0, and the name and path of each
;; package inside dir to nested.
(define (package-tree [a (ptr arena)] [dir string] [files (ptr buffer)] [nested (ptr buffer)])
  (tree! a dir "" files nested))

(define (tree! [a (ptr arena)] [dir string] [rel string] [files (ptr buffer)] [nested (ptr buffer)])
  (let ([here (if (== (-> rel length) 0) dir (joined-path dir rel))] [names (slice string)])
    (when (fs-list here (& names) 0)
      (for ([i u32 0]) (< i (-> names length)) (+= i 1)
        (let* ([n (@ names i)] [r (if (== (-> rel length) 0) (kept a n) (kept-joined a rel n))] [full (joined-path dir r)]
               [info fs-info])
          (when (and (not (and (== (-> rel length) 0) (== n "build"))) (!= n ".git") (fs-lstat full (& info) 0))
            (cond [(== (-> info kind) fs-file) (when (!= files 0) (added! files r))]
                  [(== (-> info kind) fs-directory)
                   (let ([own (joined-path full "package.sub")] [m manifest] [err (make-buffer)] [p nested-package])
                     (if (and (fs-stat own (& info) 0) (== (-> info kind) fs-file))
                         (begin
                           (set! (-> p name) (if (manifest-read a own (& m) (& err)) (-> m name) (kept a n)))
                           (set! (-> p path) r)
                           (buffer-add! nested (slice (cast (ptr u8) (& p)) (sizeof nested-package))))
                         (tree! a dir r files nested))
                     (buffer-free! (& err))
                     (free (-> own bytes)))]))
          (free (-> full bytes)))))
    (unless (== (-> rel length) 0) (free (-> here bytes)))))

(define (package-exports [a (ptr arena)] [dir string] [m (ptr manifest)] [exports (ptr buffer)] [err (ptr buffer)]) -> bool
  (let ([d (string->datum dir)] [entry (make-buffer)] [p string])
    (buffer-add-string! (& entry) (-> m name))
    (buffer-add-string! (& entry) ".sub")
    (set! p (kept a (buffer-string (& entry))))
    (buffer-free! (& entry))
    (when (file-in? dir p) (added! exports p))
    (for ([i u32 0]) (< i (-> m exports length)) (+= i 1)
      (set! p (kept a (datum->string (named-file d (string->datum (@ (-> m exports) i))))))
      (unless (file-in? dir p)
        (buffer-add-string! err "the package ")
        (buffer-add-string! err (-> m name))
        (buffer-add-string! err " exports ")
        (buffer-add-string! err (@ (-> m exports) i))
        (buffer-add-string! err ", which is not one of its modules")
        (return #f))
      (unless (holds? exports p) (added! exports p)))
    #t))

(define (file-in? [dir string] [p string]) -> bool
  (let ([full (joined-path dir p)] [info fs-info] [found #f])
    (set! found (and (fs-stat full (& info) 0) (== (-> info kind) fs-file)))
    (free (-> full bytes))
    found))

(define (kept-joined [a (ptr arena)] [rel string] [n string]) -> string
  (let* ([j (joined-path rel n)] [out (kept a j)])
    (free (-> j bytes))
    out))

(define (added! [b (ptr buffer)] [p string]) (buffer-add! b (slice (cast (ptr u8) (& p)) (sizeof string))))

(define (holds? [b (ptr buffer)] [p string]) -> bool
  (let ([ps (cast (ptr string) (-> b bytes))])
    (for ([i u32 0]) (< i (/ (-> b length) (sizeof string))) (+= i 1) (when (== (@ ps i) p) (return #t)))
    #f))
