;; Data in Substrate's syntax, as package.sub holds it: lists in ( ) or [ ], symbols and strings, with the comments and
;; string escapes of Substrate's reader, read into an arena.
(provide data data-list data-symbol data-string data-error data-read data-head)

(variant data
  [data-list [items (slice data)] [line u32] [column u32]]
  [data-symbol [text string] [line u32] [column u32]]
  [data-string [text string] [line u32] [column u32]])

(struct data-error [message string] [line u32] [column u32])

(struct data-reader [text string] [at u32] [line u32] [column u32] [arena (ptr arena)] [error (ptr data-error)])

(define (data-read [a (ptr arena)] [text string] [first bool] [into (ptr (slice data))] [err (ptr data-error)]) -> bool
  (let ([r data-reader] [forms (make-buffer)] [d data (data-symbol "" 0 0)])
    (set! (-> r text) text)
    (set! (-> r at) 0)
    (set! (-> r line) 1)
    (set! (-> r column) 1)
    (set! (-> r arena) a)
    (set! (-> r error) err)
    (while #t
      (unless (skip-space! (& r))
        (buffer-free! (& forms))
        (return #f))
      (when (>= (-> r at) (-> text length)) (break))
      (unless (read-one! (& r) (& d))
        (buffer-free! (& forms))
        (return #f))
      (buffer-add! (& forms) (slice (cast (ptr u8) (& d)) (sizeof data)))
      (when first (break)))
    (set! (@ into) (slice (cast (ptr data) (copied a (buffer-bytes (& forms)))) (/ (-> forms length) (sizeof data))))
    (buffer-free! (& forms))
    #t))

(define (data-head [a (ptr arena)] [text string]) -> string
  (let ([r data-reader] [e data-error] [start u32 0])
    (set! (-> r text) text)
    (set! (-> r at) 0)
    (set! (-> r line) 1)
    (set! (-> r column) 1)
    (set! (-> r arena) a)
    (set! (-> r error) (& e))
    (unless (and (skip-space! (& r)) (more? (& r)) (or (== (here (& r)) #\() (== (here (& r)) #\[))) (return ""))
    (advance! (& r))
    (unless (skip-space! (& r)) (return ""))
    (set! start (-> r at))
    (while (and (more? (& r)) (not (delimiter? (here (& r))))) (advance! (& r)))
    (slice text start (-> r at))))

(define (copied [a (ptr arena)] [b (slice u8)]) -> (ptr u8)
  (let ([p (cast (ptr u8) (arena-alloc a (-> b length)))])
    (memcpy p (-> b items) (-> b length))
    p))

(define (here [r (ptr data-reader)]) -> u32 (@ (-> r text) (-> r at)))

(define (more? [r (ptr data-reader)]) -> bool (< (-> r at) (-> r text length)))

(define (advance! [r (ptr data-reader)])
  (let ([c (here r)])
    (cond [(== c 10) (+= (-> r line) 1) (set! (-> r column) 1)]
          [(!= (bit-and c 192) 128) (+= (-> r column) 1)])
    (+= (-> r at) 1)))

(define (after [r (ptr data-reader)]) -> u32
  (if (< (+ (-> r at) 1) (-> r text length)) (@ (-> r text) (+ (-> r at) 1)) 0))

(define (skip-space! [r (ptr data-reader)]) -> bool
  (let ([d data (data-symbol "" 0 0)])
    (while (more? r)
      (let ([c (here r)])
        (cond [(== c 59) (while (and (more? r) (!= (here r) 10)) (advance! r))]
              [(or (== c 32) (and (>= c 9) (<= c 13))) (advance! r)]
              [(and (== c #\#) (== (after r) #\|)) (unless (skip-block! r) (return #f))]
              [(and (== c #\#) (== (after r) 59))
               (advance! r)
               (advance! r)
               (unless (skip-space! r) (return #f))
               (when (and (more? r) (not (read-one! r (& d)))) (return #f))]
              [else (break)])))
    #t))

(define (skip-block! [r (ptr data-reader)]) -> bool
  (let ([line (-> r line)] [column (-> r column)] [depth u32 1])
    (advance! r)
    (advance! r)
    (while (> depth 0)
      (unless (more? r) (return (failed! r "this comment is not closed" line column)))
      (cond [(and (== (here r) #\|) (== (after r) #\#)) (advance! r) (advance! r) (-= depth 1)]
            [(and (== (here r) #\#) (== (after r) #\|)) (advance! r) (advance! r) (+= depth 1)]
            [else (advance! r)]))
    #t))

(define (delimiter? [c u32]) -> bool
  (or (== c 32) (and (>= c 9) (<= c 13)) (== c #\() (== c #\)) (== c #\[) (== c #\]) (== c #\") (== c 59)))

(define (failed! [r (ptr data-reader)] [message string] [line u32] [column u32]) -> bool
  (set! (-> r error message) message)
  (set! (-> r error line) line)
  (set! (-> r error column) column)
  #f)

(define (read-one! [r (ptr data-reader)] [into (ptr data)]) -> bool
  (let ([line (-> r line)] [column (-> r column)] [c (here r)])
    (cond [(== c #\() (read-list! r #\) line column into)]
          [(== c #\[) (read-list! r #\] line column into)]
          [(or (== c #\)) (== c #\])) (failed! r "this closes no list" line column)]
          [(== c #\") (read-string! r line column into)]
          [else
           (let ([start (-> r at)])
             (while (and (more? r) (not (delimiter? (here r)))) (advance! r))
             (set! (@ into) (data-symbol (cast string (slice (copied (-> r arena) (cast (slice u8) (slice (-> r text) start (-> r at))))
                                                             (- (-> r at) start)))
                                         line column))
             #t)])))

(define (read-list! [r (ptr data-reader)] [close u32] [line u32] [column u32] [into (ptr data)]) -> bool
  (let ([items (make-buffer)] [d data (data-symbol "" 0 0)])
    (advance! r)
    (while #t
      (unless (skip-space! r)
        (buffer-free! (& items))
        (return #f))
      (unless (more? r)
        (buffer-free! (& items))
        (return (failed! r "this list is not closed" line column)))
      (when (== (here r) close)
        (advance! r)
        (break))
      (unless (read-one! r (& d))
        (buffer-free! (& items))
        (return #f))
      (buffer-add! (& items) (slice (cast (ptr u8) (& d)) (sizeof data))))
    (set! (@ into) (data-list (slice (cast (ptr data) (copied (-> r arena) (buffer-bytes (& items))))
                                     (/ (-> items length) (sizeof data)))
                              line column))
    (buffer-free! (& items))
    #t))

(define (read-string! [r (ptr data-reader)] [line u32] [column u32] [into (ptr data)]) -> bool
  (let ([b (make-buffer)] [c u32 0])
    (advance! r)
    (while #t
      (unless (more? r)
        (buffer-free! (& b))
        (return (failed! r "this string is not closed" line column)))
      (set! c (here r))
      (cond [(== c #\") (advance! r) (break)]
            [(== c #\\)
             (let ([l (-> r line)] [k (-> r column)])
               (advance! r)
               (set! c (if (more? r) (here r) 0))
               (cond [(== c #\n) (buffer-add-byte! (& b) 10)]
                     [(== c #\t) (buffer-add-byte! (& b) 9)]
                     [(== c #\r) (buffer-add-byte! (& b) 13)]
                     [(== c #\0) (buffer-add-byte! (& b) 0)]
                     [(or (== c #\") (== c #\\)) (buffer-add-byte! (& b) (cast i32 c))]
                     [(and (== c #\x) (hex-escape! r (& b))) (begin)]
                     [else
                      (buffer-free! (& b))
                      (return (failed! r "a string's escapes are \\\", \\\\, \\n, \\t, \\r, \\0, and \\x with hex digits and ;" l k))])
               (advance! r))]
            [else (buffer-add-byte! (& b) (cast i32 c)) (advance! r)]))
    (set! (@ into) (data-string (cast string (slice (copied (-> r arena) (buffer-bytes (& b))) (-> b length))) line column))
    (buffer-free! (& b))
    #t))

(define (hex-escape! [r (ptr data-reader)] [b (ptr buffer)]) -> bool
  (let ([n u32 0] [digits u32 0] [h i32 0])
    (advance! r)
    (while (and (more? r) (!= (here r) 59))
      (set! h (hex-value (here r)))
      (when (or (< h 0) (> n 1114111)) (return #f))
      (set! n (+ (* n 16) (cast u32 h)))
      (+= digits 1)
      (advance! r))
    (unless (and (more? r) (> digits 0) (<= n 1114111) (or (< n 55296) (> n 57343))) (return #f))
    (buffer-add-utf-8! b n)
    #t))

(define (hex-value [c u32]) -> i32
  (cond [(and (>= c #\0) (<= c #\9)) (cast i32 (- c #\0))]
        [(and (>= c #\a) (<= c #\f)) (cast i32 (+ (- c #\a) 10))]
        [(and (>= c #\A) (<= c #\F)) (cast i32 (+ (- c #\A) 10))]
        [else -1]))
