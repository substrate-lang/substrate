;; Sites: directories that a static server can serve. A site holds index.html, the web host, the program, and
;; files.pack with the files the site declares. It also holds the assets from beside the program, and assets.list lists
;; them. The program reads the declared files as files and loads the assets by URL. When a site has a base, its page
;; starts with <base href="base">. A site can mount other sites. Each mounted site goes in the directory of its path,
;; and its base is that path under the mounting site's base. site-parts gives the site and the sites it mounts, each
;; with its directory and base. site-write! writes all of them except their programs, which the plans name by their
;; source files. The caller builds each program into its part's program directory and then finishes each part with
;; site-finish! (below), as cmd/sub/declared.sub and std/test/browser.sub do. Files from a name need the program's
;; module map in compiler/roots, so both callers load it first. A written site's .site file holds its program's path
;; and its base, which site-base reads.
(require-unqualified compiler/macros)
(require-unqualified compiler/roots)
(require-unqualified host/fs)
(require-unqualified std/crypto/sha256)
(require-unqualified std/compress/deflate)
(require-unqualified std/compress/gzip)
(require-unqualified "manifest.sub")
(require-unqualified "pack.sub")
(require-unqualified "path.sub")
(require-unqualified "../string.sub")

(provide site-plan site-mount site-part site-parts site-declared site-planned! site-write! site-finish! site-base)

(struct site-mount [path string] [plan (ptr site-plan)])
(struct site-plan [name string] [program string] [html string] [files (slice site-files)] [base string]
  [url-base string] [mounts (slice site-mount)])
(struct site-part [plan (ptr site-plan)] [out string] [url-base string])

(exception site-failed string)

(define (kind-of [path string]) -> fs-kind
  (let ([info fs-info]) (fs-stat path (& info) 0) (-> info kind)))

(define (made! [path string])
  (let ([why error]) (unless (fs-make-dir path (& why)) (throw site-failed (error-text (& why))))))

(define (copied! [from string] [to string])
  (let ([why error]) (unless (fs-copy from to (& why)) (throw site-failed (error-text (& why))))))

(define (names-in [dir string]) -> (slice string)
  (let ([names (slice string)] [why error])
    (unless (fs-list dir (& names) (& why)) (throw site-failed (error-text (& why))))
    names))

(define (written! [path string] [b (slice u8)])
  (let ([why error]) (unless (fs-write-file path b (& why)) (throw site-failed (error-text (& why))))))

(define (strings-of [b (ptr buffer)]) -> (slice string)
  (slice (cast (ptr string) (-> b bytes)) (/ (-> b length) (sizeof string))))

(define (added! [b (ptr buffer)] [s string]) (buffer-add! b (slice (cast (ptr u8) (& s)) (sizeof string))))

(define (sorted! [ps (slice string)])
  (for ([i u32 1]) (< i (-> ps length)) (+= i 1)
    (let ([s (@ ps i)] [j i])
      (while (and (> j 0) (< s (@ ps (- j 1))))
        (set! (@ ps j) (@ ps (- j 1)))
        (-= j 1))
      (set! (@ ps j) s))))

(define (copy-tree! [from string] [to string] [base string] [files (ptr buffer)])
  (let ([names (names-in from)])
    (made! to)
    (for ([i u32 0]) (< i (-> names length)) (+= i 1)
      (let* ([name (@ names i)] [f (joined-path from name)] [t (joined-path to name)] [b (joined-path base name)])
        (if (== (kind-of f) fs-directory)
            (copy-tree! f t b files)
            (begin
              (copied! f t)
              (buffer-add! files (slice (cast (ptr u8) (& b)) (sizeof string)))))))))

(define (copy-modules! [from string] [to string])
  (let ([names (names-in from)])
    (for ([i u32 0]) (< i (-> names length)) (+= i 1)
      (let ([name (@ names i)])
        (when (and (string-suffix? name ".mjs") (== (kind-of (joined-path from name)) fs-file))
          (copied! (joined-path from name) (joined-path to name)))))))

;; Reads the plan of the site called name from the package in dir into p, or returns #f with the reason in err.
(define (site-declared [a (ptr arena)] [dir string] [name string] [p (ptr site-plan)] [err (ptr buffer)]) -> bool
  (let ([m manifest])
    (unless (manifest-read a (joined-path dir "package.sub") (& m) err) (return #f))
    (when (site-planned! a dir (& m) name p) (return #t))
    (buffer-add-string! err (string-append 0 "site: the package " (-> m name) " has no site " name))
    #f))

(define (site-planned! [a (ptr arena)] [dir string] [m (ptr manifest)] [name string] [p (ptr site-plan)]) -> bool
  (for ([i u32 0]) (< i (-> m sites length)) (+= i 1)
    (let ([s (& (@ (-> m sites) i))])
      (when (== (-> s name) name)
        (let ([mounts (new a site-mount (-> s mounts length))])
          (for ([k u32 0]) (< k (-> s mounts length)) (+= k 1)
            (let ([plan (new a site-plan)])
              (site-planned! a dir m (-> (@ (-> s mounts) k) site) plan)
              (set! (@ mounts k) (site-mount #:path (-> (@ (-> s mounts) k) path) #:plan plan))))
          (set! (@ p 0) (site-plan #:name name #:program (resolved-path dir (-> s program))
                                   #:html (if (== (-> s html length) 0) "" (resolved-path dir (-> s html)))
                                   #:files (-> s files) #:base dir #:url-base (-> s url-base) #:mounts mounts)))
        (return #t))))
  #f)

(define (parts! [into (ptr buffer)] [p (ptr site-plan)] [out string] [url-base string])
  (let ([part (site-part #:plan p #:out out #:url-base url-base)])
    (buffer-add! into (slice (cast (ptr u8) (& part)) (sizeof site-part))))
  (for ([i u32 0]) (< i (-> p mounts length)) (+= i 1)
    (let ([m (& (@ (-> p mounts) i))])
      (parts! into (-> m plan) (joined-path out (slice (-> m path) 1 (- (-> m path length) 1)))
              (string-append 0 (if (== (-> url-base length) 0) "/" url-base) (slice (-> m path) 1))))))

(define (site-parts [a (ptr arena)] [p (ptr site-plan)] [out string]) -> (slice site-part)
  (let* ([b (make-buffer)] [n u32 0] [parts (slice site-part)])
    (parts! (& b) p out (-> p url-base))
    (set! n (/ (-> b length) (sizeof site-part)))
    (set! parts (new a site-part n))
    (memcpy (cast (ptr u8) (-> parts items)) (-> b bytes) (-> b length))
    (buffer-free! (& b))
    parts))

(define (kept! [into (ptr buffer)] [path string])
  (let ([ps (cast (ptr string) (-> into bytes))] [n (/ (-> into length) (sizeof string))])
    (for ([i u32 0]) (< i n) (+= i 1) (when (== (@ ps i) path) (return)))
    (buffer-add! into (slice (cast (ptr u8) (& path)) (sizeof string)))))

;; Collects the paths under base that match parts k onward; rel is the part of the path matched so far.
(define (matched! [base string] [rel string] [parts (slice string)] [k u32] [into (ptr buffer)])
  (let ([here (if (== (-> rel length) 0) base (joined-path base rel))])
    (cond [(== k (-> parts length)) (when (!= (kind-of here) fs-none) (kept! into rel))]
          [(== (@ parts k) "**")
           (matched! base rel parts (+ k 1) into)
           (when (== (kind-of here) fs-directory)
             (let ([names (names-in here)])
               (for ([i u32 0]) (< i (-> names length)) (+= i 1)
                 (when (== (kind-of (joined-path here (@ names i))) fs-directory)
                   (matched! base (child rel (@ names i)) parts k into)))))]
          [(string-contains? (@ parts k) "*")
           (when (== (kind-of here) fs-directory)
             (let ([names (names-in here)])
               (for ([i u32 0]) (< i (-> names length)) (+= i 1)
                 (when (matches? (@ names i) (@ parts k)) (matched! base (child rel (@ names i)) parts (+ k 1) into)))))]
          [else (matched! base (child rel (@ parts k)) parts (+ k 1) into)])))

(define (child [rel string] [name string]) -> string (if (== (-> rel length) 0) name (joined-path rel name)))

(define (parts-of [pattern string]) -> (slice string)
  (let ([out (make-buffer)] [start u32 0])
    (for ([i u32 0]) (<= i (-> pattern length)) (+= i 1)
      (when (or (== i (-> pattern length)) (== (@ pattern i) #\/))
        (when (> i start)
          (let ([part (slice pattern start i)]) (buffer-add! (& out) (slice (cast (ptr u8) (& part)) (sizeof string)))))
        (set! start (+ i 1))))
    (slice (cast (ptr string) (-> out bytes)) (/ (-> out length) (sizeof string)))))

(define (root-directory [p (ptr site-plan)] [name string]) -> string
  (let ([dir datum '#f])
    (try (set! dir (named-directory (string->datum (-> p program)) (string->datum name)))
         [catch compile-error (message blamed loc) (set! dir '#f)])
    (unless (string? dir)
      (throw site-failed (string-append 0 "site: (from " name ") names nothing that the site's program can require")))
    (datum->string dir)))

(define (packed! [p (ptr site-plan)] [g (ptr site-files)] [files (ptr buffer)])
  (let ([base (cond [(> (-> g root length) 0) (root-directory p (-> g root))]
                    [(== (-> g from length) 0) (-> p base)]
                    [else (resolved-path (-> p base) (-> g from))])]
        [found (make-buffer)] [err (make-buffer)])
    (for ([i u32 0]) (< i (-> g patterns length)) (+= i 1)
      (let ([before (-> found length)])
        (matched! base "" (parts-of (@ (-> g patterns) i)) 0 (& found))
        (when (== (-> found length) before)
          (throw site-failed (string-append 0 "site: nothing in " base " matches " (@ (-> g patterns) i))))))
    (unless (pack-add! files base (slice (cast (ptr string) (-> found bytes)) (/ (-> found length) (sizeof string)))
                       (-> g dir) (& err))
      (throw site-failed (buffer-string (& err))))))

;; Writes p's site into out, replacing any site already there, with the web host from the toolchain. Returns #f with
;; the reason in err if it fails.
(define (site-write! [p (ptr site-plan)] [out string] [toolchain string] [err (ptr buffer)]) -> bool
  (let* ([a (make-arena)] [parts (site-parts (& a) p out)] [ok #t])
    (try (for ([i u32 0]) (< i (-> parts length)) (+= i 1)
           (let ([part (& (@ parts i))]) (site-written! (-> part plan) (-> part out) (-> part url-base) toolchain)))
         [catch site-failed (why)
          (buffer-add-string! err why)
          (set! ok #f)])
    (arena-free (& a))
    ok))

(define (based! [path string] [url-base string])
  (let* ([html (cast string (read! path))] [b (make-buffer)] [lower (found html "<!doctype")]
         [doctype (if (< lower 0) (found html "<!DOCTYPE") lower)] [at u32 0])
    (when (>= (found html "<base") 0)
      (throw site-failed "site: the page has a base element, and the site gives a base too"))
    (when (== doctype 0)
      (set! at (cast u32 (found html ">")))
      (+= at 1)
      (when (and (< at (-> html length)) (== (@ html at) #\newline)) (+= at 1)))
    (buffer-add-string! (& b) (slice html 0 at))
    (buffer-add-string! (& b) "<base href=\"")
    (buffer-add-string! (& b) url-base)
    (buffer-add-string! (& b) "\">\n")
    (buffer-add-string! (& b) (slice html at (-> html length)))
    (written! path (buffer-bytes (& b)))
    (buffer-free! (& b))
    (free (-> html bytes))))

(define (site-written! [p (ptr site-plan)] [out string] [url-base string] [toolchain string])
  (let ([list (make-buffer)] [files (make-buffer)] [packed (make-buffer)] [err (make-buffer)] [why error])
    (when (and (!= (kind-of out) fs-none)
               (or (!= (kind-of out) fs-directory)
                   (and (> (-> (names-in out) length) 0) (!= (kind-of (joined-path out ".site")) fs-file))))
      (throw site-failed (string-append 0 "site: " out " is not a site, so it is not replaced")))
    (when (and (!= (kind-of out) fs-none) (not (fs-remove out #t (& why)))) (throw site-failed (error-text (& why))))
    (made! (joined-path out "host/modules"))
    (made! (joined-path out "host/web"))
    (written! (joined-path out ".site") (cast (slice u8) (string-append 0 (-> p program) "\n" url-base "\n")))
    (let ([assets (joined-path (parent-of (-> p program)) "assets")] [found (make-buffer)])
      (when (== (kind-of assets) fs-directory)
        (copy-tree! assets (joined-path out "assets") "assets" (& found))
        (let ([ps (strings-of (& found))])
          (sorted! ps)
          (for ([i u32 0]) (< i (-> ps length)) (+= i 1)
            (buffer-add-string! (& list) (@ ps i))
            (buffer-add-byte! (& list) #\newline)))))
    (written! (joined-path out "assets.list") (buffer-bytes (& list)))
    (for ([i u32 0]) (< i (-> p files length)) (+= i 1) (packed! p (& (@ (-> p files) i)) (& packed)))
    (unless (pack-write! (& packed) (joined-path out "files.pack") (& err)) (throw site-failed (buffer-string (& err))))
    (copy-modules! (joined-path toolchain "host") (joined-path out "host"))
    (copy-modules! (joined-path toolchain "host/modules") (joined-path out "host/modules"))
    (copy-modules! (joined-path toolchain "host/web") (joined-path out "host/web"))
    (copied! (if (== (-> p html length) 0) (joined-path toolchain "host/web/index.html") (-> p html))
             (joined-path out "index.html"))
    (unless (== (-> url-base length) 0) (based! (joined-path out "index.html") url-base))
    (when (== (kind-of (-> p program)) fs-directory)
      (copy-tree! (-> p program) (joined-path out "program") "" (& files)))))

;; site-base gives the base of the site written in dir, or "" when dir holds no site or its site has no base.
(define (site-base [dir string]) -> string
  (let ([b (slice u8)] [base ""])
    (when (fs-read-file (joined-path dir ".site") (& b) 0)
      (let* ([s (cast string b)] [start (string-index s #\newline)] [end (+ start 1)])
        (while (and (< end (-> s length)) (!= (@ s end) #\newline)) (+= end 1))
        (when (< (+ start 1) end) (set! base (string-copy (slice s (+ start 1) end))))
        (free (-> b items))))
    base))

;; ---- finishing ----

;; Finishing a site keeps index.html and the assets where they are. It moves the host, the program, files.pack and
;; assets.list into a directory named by a hash of their paths and bytes, the first 16 hex digits of a SHA-256. Each
;; asset also gets a copy in a directory named by its own hash, and assets.list gives each copy's path after a tab. A
;; server can cache all of these for good, as http-hashed-cache in std/http/static.sub does. index.html loads the
;; program from its new directory and preloads the program's files. A file gets a gzipped copy, name.gz, when gzip
;; shrinks it to nine tenths of its size or less. The sites mounted inside it are finished on their own.

(define (site-finish! [out string] [err (ptr buffer)]) -> bool
  (try (begin (site-finished! out) #t)
       [catch site-failed (why)
        (buffer-add-string! err why)
        #f]))

(define (read! [path string]) -> (slice u8)
  (let ([b (slice u8)] [why error])
    (unless (fs-read-file path (& b) (& why)) (throw site-failed (error-text (& why))))
    b))

(define (renamed! [from string] [to string])
  (let ([why error]) (unless (fs-rename from to (& why)) (throw site-failed (error-text (& why))))))

(define (slashed [a string] [b string]) -> string (if (== (-> a length) 0) b (string-append 0 a "/" b)))

(define (walked! [dir string] [rel string] [into (ptr buffer)])
  (let ([names (names-in dir)])
    (for ([i u32 0]) (< i (-> names length)) (+= i 1)
      (let ([f (joined-path dir (@ names i))] [r (slashed rel (@ names i))])
        (if (== (kind-of f) fs-directory) (walked! f r into) (added! into r))))))

(define (hex! [b (ptr buffer)] [bytes (slice u8)])
  (let ([digits "0123456789abcdef"])
    (for ([i u32 0]) (< i (-> bytes length)) (+= i 1)
      (buffer-add-byte! b (@ digits (>> (cast u32 (@ bytes i)) 4)))
      (buffer-add-byte! b (@ digits (bit-and (cast u32 (@ bytes i)) 15))))))

(define (code-name [out string] [paths (slice string)]) -> string
  (let ([s sha256] [digest (array u8 32)] [name (make-buffer)] [size (make-buffer)])
    (sha256-init! (& s))
    (for ([i u32 0]) (< i (-> paths length)) (+= i 1)
      (let ([b (read! (joined-path out (@ paths i)))])
        (set! (-> size length) 0)
        (buffer-add-byte! (& size) 0)
        (buffer-add-u32! (& size) (-> b length))
        (sha256-add! (& s) (cast (slice u8) (@ paths i)))
        (sha256-add! (& s) (buffer-bytes (& size)))
        (sha256-add! (& s) b)
        (free (-> b items))))
    (sha256-end! (& s) (slice digest))
    (hex! (& name) (slice (slice digest) 0 8))
    (buffer-free! (& size))
    (buffer-string (& name))))

(define (found [s string] [part string]) -> i64
  (let ([i (string-find s part)]) (if (< i (-> s length)) (cast i64 i) -1)))

(define (found-before [s string] [part string] [before u32]) -> i64
  (let ([i before])
    (while (> i 0)
      (-= i 1)
      (when (and (<= (+ i (-> part length)) before) (== (slice s i (+ i (-> part length))) part))
        (return (cast i64 i))))
    -1))

(define (url-safe? [c u8]) -> bool
  (or (and (>= c #\a) (<= c #\z)) (and (>= c #\A) (<= c #\Z)) (and (>= c #\0) (<= c #\9))
      (== c #\-) (== c #\_) (== c #\.) (== c #\!) (== c #\~) (== c #\*) (== c #\') (== c #\() (== c #\))))

;; url! escapes each part of a path as encodeURIComponent does in the web host (subhost-web.mjs).
(define (url! [b (ptr buffer)] [path string])
  (let ([digits "0123456789ABCDEF"])
    (for ([i u32 0]) (< i (-> path length)) (+= i 1)
      (let ([c (@ path i)])
        (if (or (url-safe? c) (== c #\/))
            (buffer-add-byte! b c)
            (begin
              (buffer-add-byte! b #\%)
              (buffer-add-byte! b (@ digits (>> (cast u32 c) 4)))
              (buffer-add-byte! b (@ digits (bit-and (cast u32 c) 15)))))))))

(define (link! [b (ptr buffer)] [name string] [path string])
  (buffer-add-string! b "<link rel=\"preload\" href=\"")
  (buffer-add-string! b name)
  (buffer-add-byte! b #\/)
  (url! b path)
  (buffer-add-string! b "\" as=\"fetch\" crossorigin>\n"))

(define (finished-html! [out string] [name string] [fetched (slice string)])
  (let* ([path (joined-path out "index.html")] [html (cast string (read! path))] [at (found html "host/web/start.mjs")]
         [tag (if (< at 0) -1 (found-before html "<script" (cast u32 at)))] [b (make-buffer)])
    (when (< tag 0)
      (throw site-failed "site: the page has no script that loads host/web/start.mjs, which starts the site's program"))
    (buffer-add-string! (& b) (slice html 0 (cast u32 tag)))
    (for ([i u32 0]) (< i (-> fetched length)) (+= i 1) (link! (& b) name (@ fetched i)))
    (buffer-add-string! (& b) (slice html (cast u32 tag) (cast u32 at)))
    (buffer-add-string! (& b) name)
    (buffer-add-byte! (& b) #\/)
    (buffer-add-string! (& b) (slice html (cast u32 at) (-> html length)))
    (written! path (buffer-bytes (& b)))
    (buffer-free! (& b))
    (free (-> html bytes))))

(define (zipped! [dir string] [d (ptr deflater)])
  (let ([names (names-in dir)])
    (for ([i u32 0]) (< i (-> names length)) (+= i 1)
      (let ([name (@ names i)] [f (joined-path dir (@ names i))])
        (cond [(== (kind-of f) fs-directory)
               (unless (== (kind-of (joined-path f ".site")) fs-file) (zipped! f d))]
              [(or (== name ".site") (string-suffix? name ".gz")) (begin)]
              [else
               (let ([b (read! f)] [z (make-buffer)])
                 (gzip! d (& z) b "")
                 (when (<= (* (cast u64 (-> z length)) 10) (* (cast u64 (-> b length)) 9))
                   (written! (string-append 0 f ".gz") (buffer-bytes (& z))))
                 (free (-> b items))
                 (buffer-free! (& z)))])))))

(define (hash-of [b (slice u8)]) -> string
  (let ([digest (array u8 32)] [name (make-buffer)])
    (sha256-of b (slice digest))
    (hex! (& name) (slice (slice digest) 0 8))
    (buffer-string (& name))))

(define (hashed-assets! [out string])
  (let ([listed (cast string (read! (joined-path out "assets.list")))] [b (make-buffer)] [start u32 0])
    (for ([i u32 0]) (<= i (-> listed length)) (+= i 1)
      (when (or (== i (-> listed length)) (== (@ listed i) #\newline))
        (when (> i start)
          (let* ([path (slice listed start i)] [bytes (read! (joined-path out path))] [hash (hash-of bytes)] [k i])
            (while (and (> k start) (!= (@ listed (- k 1)) #\/)) (-= k 1))
            (let ([dir (joined-path (joined-path out "assets") hash)] [name (slice listed k i)])
              (made! dir)
              (written! (joined-path dir name) bytes)
              (buffer-add-string! (& b) path)
              (buffer-add-byte! (& b) #\tab)
              (buffer-add-string! (& b) (slashed "assets" (slashed hash name)))
              (buffer-add-byte! (& b) #\newline))
            (free (-> bytes items))))
        (set! start (+ i 1))))
    (written! (joined-path out "assets.list") (buffer-bytes (& b)))
    (buffer-free! (& b))
    (free (-> listed bytes))))

(define (site-finished! [out string])
  (let ([paths (make-buffer)] [fetched (make-buffer)] [d deflater])
    (hashed-assets! out)
    (walked! (joined-path out "host") "host" (& paths))
    (walked! (joined-path out "program") "program" (& paths))
    (added! (& paths) "files.pack")
    (added! (& paths) "assets.list")
    (sorted! (strings-of (& paths)))
    (let* ([name (code-name out (strings-of (& paths)))] [code (joined-path out name)])
      (made! code)
      (renamed! (joined-path out "host") (joined-path code "host"))
      (renamed! (joined-path out "program") (joined-path code "program"))
      (renamed! (joined-path out "files.pack") (joined-path code "files.pack"))
      (renamed! (joined-path out "assets.list") (joined-path code "assets.list"))
      (walked! (joined-path code "program") "program" (& fetched))
      (added! (& fetched) "files.pack")
      (added! (& fetched) "assets.list")
      (sorted! (strings-of (& fetched)))
      (finished-html! out name (strings-of (& fetched)))
      (deflater-init! (& d) 9)
      (zipped! out (& d))
      (deflater-free! (& d)))))
