;; Sites: directories that a static server can serve. A site holds index.html, the web host, the program, files.pack
;; with the files the site declares, and the assets beside the program, which it serves and lists in assets.list. The
;; program reads only the declared files as files, and loads assets by URL. site-write! writes all of it except a
;; program given as a file, which the caller builds into the site's program directory, as cmd/sub/site.sub and
;; std/test/browser.sub do. site-release! makes a written site a release (below).
(require-unqualified host/fs)
(require-unqualified std/crypto/sha256)
(require-unqualified std/compress/deflate)
(require-unqualified std/compress/gzip)
(require-unqualified "manifest.sub")
(require-unqualified "pack.sub")
(require-unqualified "path.sub")

(provide site-plan site-named? site-declared site-write! site-release!)

(struct site-plan [name string] [program string] [html string] [files (slice site-files)] [base string])

(exception site-failed string)

(define (joined [a string] [b string]) -> string
  (let ([out (make-buffer)])
    (buffer-add-string! (& out) a)
    (buffer-add-string! (& out) b)
    (buffer-string (& out))))

(define (kind-of [path string]) -> fs-kind
  (let ([info fs-info]) (fs-stat path (& info) 0) (-> info kind)))

(define (made! [path string])
  (let ([why error]) (unless (fs-make-dir path (& why)) (throw site-failed (error-text (& why))))))

(define (copied! [from string] [to string])
  (let ([why error]) (unless (fs-copy from to (& why)) (throw site-failed (error-text (& why))))))

(define (names-in [dir string]) -> (slice string)
  (let ([names (slice string)] [why error])
    (unless (fs-list dir (& names) (& why)) (throw site-failed (error-text (& why))))
    names))

(define (written! [path string] [b (slice u8)])
  (let ([why error]) (unless (fs-write-file path b (& why)) (throw site-failed (error-text (& why))))))

(define (strings-of [b (ptr buffer)]) -> (slice string)
  (slice (cast (ptr string) (-> b bytes)) (/ (-> b length) (sizeof string))))

(define (added! [b (ptr buffer)] [s string]) (buffer-add! b (slice (cast (ptr u8) (& s)) (sizeof string))))

(define (sorted! [ps (slice string)])
  (for ([i u32 1]) (< i (-> ps length)) (+= i 1)
    (let ([s (@ ps i)] [j i])
      (while (and (> j 0) (< s (@ ps (- j 1))))
        (set! (@ ps j) (@ ps (- j 1)))
        (-= j 1))
      (set! (@ ps j) s))))

(define (copy-tree! [from string] [to string] [base string] [files (ptr buffer)])
  (let ([names (names-in from)])
    (made! to)
    (for ([i u32 0]) (< i (-> names length)) (+= i 1)
      (let* ([name (@ names i)] [f (joined-path from name)] [t (joined-path to name)] [b (joined-path base name)])
        (if (== (kind-of f) fs-directory)
            (copy-tree! f t b files)
            (begin
              (copied! f t)
              (buffer-add! files (slice (cast (ptr u8) (& b)) (sizeof string)))))))))

(define (copy-modules! [from string] [to string])
  (let ([names (names-in from)])
    (for ([i u32 0]) (< i (-> names length)) (+= i 1)
      (let ([name (@ names i)])
        (when (and (ends? name ".mjs") (== (kind-of (joined-path from name)) fs-file))
          (copied! (joined-path from name) (joined-path to name)))))))

(define (site-named? [spec string]) -> bool
  (for ([i u32 0]) (< i (-> spec length)) (+= i 1) (when (or (== (@ spec i) #\/) (== (@ spec i) #\\)) (return #f)))
  (not (ends? spec ".sub")))

;; Reads the plan of the site called name from the package in dir into p, or returns #f with the reason in err.
(define (site-declared [a (ptr arena)] [dir string] [name string] [p (ptr site-plan)] [err (ptr buffer)]) -> bool
  (let ([m manifest])
    (unless (manifest-read a (joined-path dir "package.sub") (& m) err) (return #f))
    (for ([i u32 0]) (< i (-> m sites length)) (+= i 1)
      (let ([s (& (@ (-> m sites) i))])
        (when (== (-> s name) name)
          (set! (@ p 0) (site-plan #:name name #:program (resolved-path dir (-> s program))
                                   #:html (if (== (-> s html length) 0) "" (resolved-path dir (-> s html)))
                                   #:files (-> s files) #:base dir))
          (return #t))))
    (buffer-add-string! err (joined (joined (joined "site: the package " (-> m name)) " has no site ") name))
    #f))

(define (star? [s string]) -> bool
  (for ([i u32 0]) (< i (-> s length)) (+= i 1) (when (== (@ s i) #\*) (return #t)))
  #f)

(define (kept! [into (ptr buffer)] [path string])
  (let ([ps (cast (ptr string) (-> into bytes))] [n (/ (-> into length) (sizeof string))])
    (for ([i u32 0]) (< i n) (+= i 1) (when (== (@ ps i) path) (return)))
    (buffer-add! into (slice (cast (ptr u8) (& path)) (sizeof string)))))

;; Collects the paths under base that match parts k onward; rel is the part of the path matched so far.
(define (matched! [base string] [rel string] [parts (slice string)] [k u32] [into (ptr buffer)])
  (let ([here (if (== (-> rel length) 0) base (joined-path base rel))])
    (cond [(== k (-> parts length)) (when (!= (kind-of here) fs-none) (kept! into rel))]
          [(== (@ parts k) "**")
           (matched! base rel parts (+ k 1) into)
           (when (== (kind-of here) fs-directory)
             (let ([names (names-in here)])
               (for ([i u32 0]) (< i (-> names length)) (+= i 1)
                 (when (== (kind-of (joined-path here (@ names i))) fs-directory)
                   (matched! base (child rel (@ names i)) parts k into)))))]
          [(star? (@ parts k))
           (when (== (kind-of here) fs-directory)
             (let ([names (names-in here)])
               (for ([i u32 0]) (< i (-> names length)) (+= i 1)
                 (when (matches? (@ names i) (@ parts k)) (matched! base (child rel (@ names i)) parts (+ k 1) into)))))]
          [else (matched! base (child rel (@ parts k)) parts (+ k 1) into)])))

(define (child [rel string] [name string]) -> string (if (== (-> rel length) 0) name (joined-path rel name)))

(define (parts-of [pattern string]) -> (slice string)
  (let ([out (make-buffer)] [start u32 0])
    (for ([i u32 0]) (<= i (-> pattern length)) (+= i 1)
      (when (or (== i (-> pattern length)) (== (@ pattern i) #\/))
        (when (> i start)
          (let ([part (slice pattern start i)]) (buffer-add! (& out) (slice (cast (ptr u8) (& part)) (sizeof string)))))
        (set! start (+ i 1))))
    (slice (cast (ptr string) (-> out bytes)) (/ (-> out length) (sizeof string)))))

(define (packed! [p (ptr site-plan)] [g (ptr site-files)] [files (ptr buffer)])
  (let ([base (if (== (-> g from length) 0) (-> p base) (resolved-path (-> p base) (-> g from)))] [found (make-buffer)]
        [err (make-buffer)])
    (for ([i u32 0]) (< i (-> g patterns length)) (+= i 1)
      (let ([before (-> found length)])
        (matched! base "" (parts-of (@ (-> g patterns) i)) 0 (& found))
        (when (== (-> found length) before)
          (throw site-failed (joined (joined (joined "site: nothing in " base) " matches ") (@ (-> g patterns) i))))))
    (unless (pack-add! files base (slice (cast (ptr string) (-> found bytes)) (/ (-> found length) (sizeof string)))
                       (-> g dir) (& err))
      (throw site-failed (buffer-string (& err))))))

;; Writes p's site into out, replacing any site already there, with the web host from the toolchain. Returns #f with
;; the reason in err if it fails.
(define (site-write! [p (ptr site-plan)] [out string] [toolchain string] [err (ptr buffer)]) -> bool
  (try (begin (site-written! p out toolchain) #t)
       [catch site-failed (why)
        (buffer-add-string! err why)
        #f]))

(define (site-written! [p (ptr site-plan)] [out string] [toolchain string])
  (let ([list (make-buffer)] [files (make-buffer)] [packed (make-buffer)] [err (make-buffer)] [why error])
    (when (and (!= (kind-of out) fs-none)
               (or (!= (kind-of out) fs-directory)
                   (and (> (-> (names-in out) length) 0) (!= (kind-of (joined-path out ".site")) fs-file))))
      (throw site-failed (joined (joined "site: " out) " is not a site, so it is not replaced")))
    (when (and (!= (kind-of out) fs-none) (not (fs-remove out #t (& why)))) (throw site-failed (error-text (& why))))
    (made! (joined-path out "host/modules"))
    (made! (joined-path out "host/web"))
    (written! (joined-path out ".site") (cast (slice u8) (joined (-> p program) "\n")))
    (let ([assets (joined-path (parent-of (-> p program)) "assets")] [found (make-buffer)])
      (when (== (kind-of assets) fs-directory)
        (copy-tree! assets (joined-path out "assets") "assets" (& found))
        (let ([ps (strings-of (& found))])
          (sorted! ps)
          (for ([i u32 0]) (< i (-> ps length)) (+= i 1)
            (buffer-add-string! (& list) (@ ps i))
            (buffer-add-byte! (& list) 10)))))
    (written! (joined-path out "assets.list") (buffer-bytes (& list)))
    (for ([i u32 0]) (< i (-> p files length)) (+= i 1) (packed! p (& (@ (-> p files) i)) (& packed)))
    (unless (pack-write! (& packed) (joined-path out "files.pack") (& err)) (throw site-failed (buffer-string (& err))))
    (copy-modules! (joined-path toolchain "host") (joined-path out "host"))
    (copy-modules! (joined-path toolchain "host/modules") (joined-path out "host/modules"))
    (copy-modules! (joined-path toolchain "host/web") (joined-path out "host/web"))
    (copied! (if (== (-> p html length) 0) (joined-path toolchain "host/web/index.html") (-> p html))
             (joined-path out "index.html"))
    (when (== (kind-of (-> p program)) fs-directory)
      (copy-tree! (-> p program) (joined-path out "program") "" (& files)))))

;; ---- releases ----

;; A release keeps index.html and the assets in place, and moves the host, the program, files.pack and assets.list into
;; a directory named by the first 16 hex digits of the SHA-256 of their paths and bytes. Each asset also gets a copy in
;; a directory named by its own hash, and assets.list gives the copy as its URL. A server can then cache all of these
;; for good, as std/http/static.sub's http-hashed-cache does. index.html loads the program from its directory, with
;; preload links for the scripts and files it starts with. A file that gzip shrinks to nine tenths or less gets a
;; gzipped copy, name.gz.

;; site-release! makes the site written in out a release, or returns #f with the reason in err.
(define (site-release! [out string] [err (ptr buffer)]) -> bool
  (try (begin (site-released! out) #t)
       [catch site-failed (why)
        (buffer-add-string! err why)
        #f]))

(define (read! [path string]) -> (slice u8)
  (let ([b (slice u8)] [why error])
    (unless (fs-read-file path (& b) (& why)) (throw site-failed (error-text (& why))))
    b))

(define (renamed! [from string] [to string])
  (let ([why error]) (unless (fs-rename from to (& why)) (throw site-failed (error-text (& why))))))

(define (slashed [a string] [b string]) -> string (if (== (-> a length) 0) b (joined (joined a "/") b)))

(define (listed? [b (ptr buffer)] [s string]) -> bool
  (let ([ps (strings-of b)])
    (for ([i u32 0]) (< i (-> ps length)) (+= i 1) (when (== (@ ps i) s) (return #t)))
    #f))

;; walked! adds the paths of the files under dir to into, as rel and their paths under dir joined by slashes.
(define (walked! [dir string] [rel string] [into (ptr buffer)])
  (let ([names (names-in dir)])
    (for ([i u32 0]) (< i (-> names length)) (+= i 1)
      (let ([f (joined-path dir (@ names i))] [r (slashed rel (@ names i))])
        (if (== (kind-of f) fs-directory) (walked! f r into) (added! into r))))))

(define (hex! [b (ptr buffer)] [bytes (slice u8)])
  (let ([digits "0123456789abcdef"])
    (for ([i u32 0]) (< i (-> bytes length)) (+= i 1)
      (buffer-add-byte! b (@ digits (>> (cast u32 (@ bytes i)) 4)))
      (buffer-add-byte! b (@ digits (bit-and (cast u32 (@ bytes i)) 15))))))

;; release-name hashes each file's path, a zero byte, its size in four bytes and its bytes, in path order.
(define (release-name [out string] [paths (slice string)]) -> string
  (let ([s sha256] [digest (array u8 32)] [name (make-buffer)] [size (make-buffer)])
    (sha256-init! (& s))
    (for ([i u32 0]) (< i (-> paths length)) (+= i 1)
      (let ([b (read! (joined-path out (@ paths i)))])
        (set! (-> size length) 0)
        (buffer-add-byte! (& size) 0)
        (buffer-add-u32! (& size) (-> b length))
        (sha256-add! (& s) (cast (slice u8) (@ paths i)))
        (sha256-add! (& s) (buffer-bytes (& size)))
        (sha256-add! (& s) b)
        (free (-> b items))))
    (sha256-end! (& s) (slice digest))
    (hex! (& name) (slice (slice digest) 0 8))
    (buffer-free! (& size))
    (buffer-string (& name))))

(define (leb! [b (slice u8)] [at (ptr u32)]) -> u32
  (let ([n u32 0] [shift u32 0] [more #t])
    (while (and more (< (@ at) (-> b length)))
      (let ([x (cast u32 (@ b (@ at)))])
        (+= (@ at) 1)
        (set! n (bit-or n (<< (bit-and x 127) shift)))
        (set! more (!= (bit-and x 128) 0))
        (+= shift 7)))
    n))

(define (limits! [b (slice u8)] [at (ptr u32)])
  (let ([flags (leb! b at)])
    (leb! b at)
    (when (!= (bit-and flags 1) 0) (leb! b at))))

;; wasm-imports! adds to into the names of the modules that a wasm module imports from, as slices of its bytes.
(define (wasm-imports! [b (slice u8)] [into (ptr buffer)])
  (let ([at u32 8])
    (while (< at (-> b length))
      (let* ([id (@ b at)] [size (begin (+= at 1) (leb! b (& at)))] [end (+ at size)])
        (when (== id 2)
          (for ([k u32 (leb! b (& at))]) (> k 0) (-= k 1)
            (let* ([n (leb! b (& at))] [module (cast string (slice b at (+ at n)))])
              (+= at n)
              (let ([field (leb! b (& at))]) (+= at field))
              (let ([kind (@ b at)])
                (+= at 1)
                (cond [(== kind 0) (leb! b (& at))]
                      [(== kind 1) (+= at 1) (limits! b (& at))]
                      [(== kind 2) (limits! b (& at))]
                      [(== kind 3) (+= at 2)]
                      [(== kind 4) (+= at 1) (leb! b (& at))]))
              (added! into module)))
          (return))
        (set! at end)))))

;; The module a line of a script imports from, when it is a file beside the script: x in import ... from './x'.
(define (imported [line string]) -> string
  (let ([from " from '"] [at u32 0])
    (unless (starts? line "import ") (return ""))
    (while (and (<= (+ at (-> from length)) (-> line length)) (!= (slice line at (+ at (-> from length))) from))
      (+= at 1))
    (when (> (+ at (-> from length)) (-> line length)) (return ""))
    (let* ([start (+ at (-> from length))] [end start])
      (while (and (< end (-> line length)) (!= (@ line end) 39)) (+= end 1))
      (let ([spec (slice line start end)]) (if (or (starts? spec "./") (starts? spec "../")) spec "")))))

;; beside gives the path of spec, a module name relative to the script at path, both with slashes.
(define (beside [path string] [spec string]) -> string
  (let ([k (-> path length)] [parts (make-buffer)] [start u32 0] [out (make-buffer)])
    (while (and (> k 0) (!= (@ path (- k 1)) #\/)) (-= k 1))
    (let ([whole (joined (slice path 0 k) spec)])
      (for ([i u32 0]) (<= i (-> whole length)) (+= i 1)
        (when (or (== i (-> whole length)) (== (@ whole i) #\/))
          (let ([part (slice whole start i)])
            (cond [(or (== (-> part length) 0) (== part ".")) (begin)]
                  [(== part "..") (when (> (-> parts length) 0) (-= (-> parts length) (sizeof string)))]
                  [else (added! (& parts) part)]))
          (set! start (+ i 1))))
      (let ([ps (strings-of (& parts))])
        (for ([i u32 0]) (< i (-> ps length)) (+= i 1)
          (when (> i 0) (buffer-add-byte! (& out) #\/))
          (buffer-add-string! (& out) (@ ps i))))
      (buffer-free! (& parts))
      (free (-> whole bytes))
      (buffer-string (& out)))))

;; scripted! adds the script at path under dir to into, with the scripts it imports, each once.
(define (scripted! [dir string] [path string] [into (ptr buffer)])
  (unless (listed? into path)
    (added! into path)
    (let ([text (cast string (read! (joined-path dir path)))] [start u32 0])
      (for ([i u32 0]) (<= i (-> text length)) (+= i 1)
        (when (or (== i (-> text length)) (== (@ text i) 10))
          (let ([spec (imported (slice text start i))])
            (when (> (-> spec length) 0) (scripted! dir (beside path spec) into)))
          (set! start (+ i 1))))
      (free (-> text bytes)))))

;; The scripts index.html preloads: those start.mjs loads, and the host modules that the program's wasm modules
;; import, with the scripts those load.
(define (preloaded-scripts [code string]) -> (slice string)
  (let ([scripts (make-buffer)] [names (cast string (read! (joined-path code "program/program")))] [start u32 0])
    (scripted! code "host/web/start.mjs" (& scripts))
    (for ([i u32 0]) (<= i (-> names length)) (+= i 1)
      (when (or (== i (-> names length)) (== (@ names i) 10))
        (when (> i start)
          (let ([b (read! (joined-path code (joined (joined "program/" (slice names start i)) ".wasm")))]
                [imports (make-buffer)])
            (wasm-imports! b (& imports))
            (let ([ms (strings-of (& imports))])
              (for ([k u32 0]) (< k (-> ms length)) (+= k 1)
                (let ([web (joined (joined "host/web/" (@ ms k)) ".mjs")]
                      [shared (joined (joined "host/modules/" (@ ms k)) ".mjs")])
                  (cond [(== (kind-of (joined-path code web)) fs-file) (scripted! code web (& scripts))]
                        [(== (kind-of (joined-path code shared)) fs-file) (scripted! code shared (& scripts))]))))
            (free (-> b items))
            (buffer-free! (& imports))))
        (set! start (+ i 1))))
    (free (-> names bytes))
    (strings-of (& scripts))))

(define (found [s string] [part string]) -> i64
  (for ([i u32 0]) (<= (+ i (-> part length)) (-> s length)) (+= i 1)
    (when (== (slice s i (+ i (-> part length))) part) (return (cast i64 i))))
  -1)

(define (found-before [s string] [part string] [before u32]) -> i64
  (let ([i before])
    (while (> i 0)
      (-= i 1)
      (when (and (<= (+ i (-> part length)) before) (== (slice s i (+ i (-> part length))) part))
        (return (cast i64 i))))
    -1))

;; url-safe? tells whether encodeURIComponent leaves the byte as it is.
(define (url-safe? [c u8]) -> bool
  (or (and (>= c #\a) (<= c #\z)) (and (>= c #\A) (<= c #\Z)) (and (>= c #\0) (<= c #\9))
      (== c 45) (== c 95) (== c 46) (== c 33) (== c 126) (== c 42) (== c 39) (== c 40) (== c 41)))

;; url! adds path to b with each part escaped as encodeURIComponent would, as the web host asks for the files.
(define (url! [b (ptr buffer)] [path string])
  (let ([digits "0123456789ABCDEF"])
    (for ([i u32 0]) (< i (-> path length)) (+= i 1)
      (let ([c (@ path i)])
        (if (or (url-safe? c) (== c #\/))
            (buffer-add-byte! b c)
            (begin
              (buffer-add-byte! b 37)
              (buffer-add-byte! b (@ digits (>> (cast u32 c) 4)))
              (buffer-add-byte! b (@ digits (bit-and (cast u32 c) 15)))))))))

(define (link! [b (ptr buffer)] [rel string] [name string] [path string] [fetched bool])
  (buffer-add-string! b "<link rel=\"")
  (buffer-add-string! b rel)
  (buffer-add-string! b "\" href=\"")
  (buffer-add-string! b name)
  (buffer-add-byte! b #\/)
  (url! b path)
  (buffer-add-string! b (if fetched "\" as=\"fetch\" crossorigin>\n" "\">\n")))

;; released-html! points index.html's start.mjs at the directory name, and adds the preload links before its script.
(define (released-html! [out string] [name string] [scripts (slice string)] [fetched (slice string)])
  (let* ([path (joined-path out "index.html")] [html (cast string (read! path))] [at (found html "host/web/start.mjs")]
         [tag (if (< at 0) -1 (found-before html "<script" (cast u32 at)))] [b (make-buffer)])
    (when (< tag 0)
      (throw site-failed "site: index.html has no script that loads host/web/start.mjs, so it cannot be released"))
    (buffer-add-string! (& b) (slice html 0 (cast u32 tag)))
    (for ([i u32 0]) (< i (-> scripts length)) (+= i 1) (link! (& b) "modulepreload" name (@ scripts i) #f))
    (for ([i u32 0]) (< i (-> fetched length)) (+= i 1) (link! (& b) "preload" name (@ fetched i) #t))
    (buffer-add-string! (& b) (slice html (cast u32 tag) (cast u32 at)))
    (buffer-add-string! (& b) name)
    (buffer-add-byte! (& b) #\/)
    (buffer-add-string! (& b) (slice html (cast u32 at) (-> html length)))
    (written! path (buffer-bytes (& b)))
    (buffer-free! (& b))
    (free (-> html bytes))))

;; zipped! writes beside each file under dir its gzipped copy, name.gz, when that is at most nine tenths of its size.
(define (zipped! [dir string] [d (ptr deflater)])
  (let ([names (names-in dir)])
    (for ([i u32 0]) (< i (-> names length)) (+= i 1)
      (let ([name (@ names i)] [f (joined-path dir (@ names i))])
        (cond [(== (kind-of f) fs-directory) (zipped! f d)]
              [(or (== name ".site") (ends? name ".gz")) (begin)]
              [else
               (let ([b (read! f)] [z (make-buffer)])
                 (gzip! d (& z) b "")
                 (when (<= (* (cast u64 (-> z length)) 10) (* (cast u64 (-> b length)) 9))
                   (written! (joined f ".gz") (buffer-bytes (& z))))
                 (free (-> b items))
                 (buffer-free! (& z)))])))))

(define (hash-of [b (slice u8)]) -> string
  (let ([digest (array u8 32)] [name (make-buffer)])
    (sha256-of b (slice digest))
    (hex! (& name) (slice (slice digest) 0 8))
    (buffer-string (& name))))

;; hashed-assets! copies each asset that assets.list lists into a directory named by its own hash, as assets/HASH/name,
;; and writes the list again with each copy's path after a tab.
(define (hashed-assets! [out string])
  (let ([listed (cast string (read! (joined-path out "assets.list")))] [b (make-buffer)] [start u32 0])
    (for ([i u32 0]) (<= i (-> listed length)) (+= i 1)
      (when (or (== i (-> listed length)) (== (@ listed i) 10))
        (when (> i start)
          (let* ([path (slice listed start i)] [bytes (read! (joined-path out path))] [hash (hash-of bytes)] [k i])
            (while (and (> k start) (!= (@ listed (- k 1)) #\/)) (-= k 1))
            (let ([dir (joined-path (joined-path out "assets") hash)] [name (slice listed k i)])
              (made! dir)
              (written! (joined-path dir name) bytes)
              (buffer-add-string! (& b) path)
              (buffer-add-byte! (& b) 9)
              (buffer-add-string! (& b) (slashed "assets" (slashed hash name)))
              (buffer-add-byte! (& b) 10))
            (free (-> bytes items))))
        (set! start (+ i 1))))
    (written! (joined-path out "assets.list") (buffer-bytes (& b)))
    (buffer-free! (& b))
    (free (-> listed bytes))))

(define (site-released! [out string])
  (let ([paths (make-buffer)] [fetched (make-buffer)] [d deflater])
    (hashed-assets! out)
    (walked! (joined-path out "host") "host" (& paths))
    (walked! (joined-path out "program") "program" (& paths))
    (added! (& paths) "files.pack")
