;; Paths, as the package library and sub use them.
(provide joined-path normal-path kept within? parent-of base-of starts? ends?)

(define (joined-path [a string] [b string]) -> string
  (let ([out (make-buffer)])
    (buffer-add-string! (& out) a)
    (unless (and (> (-> a length) 0) (== (@ a (- (-> a length) 1)) #\/)) (buffer-add-byte! (& out) #\/))
    (buffer-add-string! (& out) b)
    (buffer-string (& out))))

(define (normal-path [a (ptr arena)] [path string]) -> string
  (let ([parts (make-buffer)] [out (make-buffer)] [start u32 0] [n u32 0] [p string] [s string])
    (for ([i u32 0]) (<= i (-> path length)) (+= i 1)
      (when (or (== i (-> path length)) (== (@ path i) #\/))
        (set! p (slice path start i))
        (cond [(or (== (-> p length) 0) (== p ".")) (begin)]
              [(== p "..") (when (> n 0) (-= n 1) (set! (-> parts length) (* n (sizeof string))))]
              [else (buffer-add! (& parts) (slice (cast (ptr u8) (& p)) (sizeof string))) (+= n 1)])
        (set! start (+ i 1))))
    (for ([i u32 0]) (< i n) (+= i 1)
      (buffer-add-byte! (& out) #\/)
      (buffer-add-string! (& out) (@ (cast (ptr string) (-> parts bytes)) i)))
    (when (== n 0) (buffer-add-byte! (& out) #\/))
    (set! s (cast string (slice (cast (ptr u8) (arena-alloc a (-> out length))) (-> out length))))
    (memcpy (-> s bytes) (-> out bytes) (-> out length))
    (buffer-free! (& parts))
    (buffer-free! (& out))
    s))

(define (kept [a (ptr arena)] [s string]) -> string
  (let ([out (cast string (slice (cast (ptr u8) (arena-alloc a (-> s length))) (-> s length)))])
    (memcpy (-> out bytes) (-> s bytes) (-> s length))
    out))

(define (within? [path string] [dir string]) -> bool
  (and (> (-> dir length) 0) (> (-> path length) (-> dir length)) (== (slice path 0 (-> dir length)) dir)
       (or (== dir "/") (== (@ path (-> dir length)) #\/))))

(define (parent-of [p string]) -> string
  (let ([i (-> p length)])
    (while (and (> i 1) (!= (@ p (- i 1)) #\/)) (-= i 1))
    (if (<= i 1) "/" (slice p 0 (- i 1)))))

(define (base-of [p string]) -> string
  (let ([i (-> p length)])
    (while (and (> i 0) (!= (@ p (- i 1)) #\/)) (-= i 1))
    (slice p i)))

(define (starts? [s string] [prefix string]) -> bool
  (and (>= (-> s length) (-> prefix length)) (== (slice s 0 (-> prefix length)) prefix)))

(define (ends? [s string] [suffix string]) -> bool
  (and (>= (-> s length) (-> suffix length)) (== (slice s (- (-> s length) (-> suffix length))) suffix)))
