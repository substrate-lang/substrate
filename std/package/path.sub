;; Paths, as the package library and sub use them, by the host's rules (compiler/path.sub).
(require-unqualified compiler/path)

(provide joined-path normal-path native-path resolved-path absolute-path? relative-path same-path? root-path? kept within?
         parent-of base-of matches?)

(define (joined-path [a string] [b string]) -> string (path-joined (path-windows?) a b))

(define (normal-path [a (ptr arena)] [p string]) -> string (kept a (path-normal (path-windows?) p)))

(define (native-path [p string]) -> string (path-native (path-windows?) p))

;; p made absolute from the directory dir, and normal.
(define (resolved-path [dir string] [p string]) -> string (path-resolved (path-windows?) dir p))

(define (absolute-path? [p string]) -> bool (path-absolute? (path-windows?) p))

(define (relative-path [dir string] [p string]) -> string (path-relative (path-windows?) dir p))

(define (same-path? [a string] [b string]) -> bool (path-same? (path-windows?) a b))

(define (root-path? [p string]) -> bool (path-same? (path-windows?) (path-parent (path-windows?) p) p))

(define (kept [a (ptr arena)] [s string]) -> string (copy a s))

(define (within? [p string] [dir string]) -> bool (path-within? (path-windows?) p dir))

(define (parent-of [p string]) -> string (path-parent (path-windows?) p))

(define (base-of [p string]) -> string (path-base (path-windows?) p))

;; Reports whether name matches pattern, where * matches any text.
(define (matches? [name string] [pattern string]) -> bool
  (let ([i u32 0] [j u32 0] [star i32 -1] [mark u32 0])
    (while (< i (-> name length))
      (cond [(and (< j (-> pattern length)) (== (@ pattern j) #\*))
             (set! star (cast i32 j))
             (set! mark i)
             (+= j 1)]
            [(and (< j (-> pattern length)) (== (@ pattern j) (@ name i)))
             (+= i 1)
             (+= j 1)]
            [(>= star 0)
             (set! j (cast u32 (+ star 1)))
             (+= mark 1)
             (set! i mark)]
            [else (return #f)]))
    (while (and (< j (-> pattern length)) (== (@ pattern j) #\*)) (+= j 1))
    (== j (-> pattern length))))
