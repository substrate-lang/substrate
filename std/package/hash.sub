;; A package's hash: the SHA-256 of a line for each of its files (files.sub), in path order, of the file's SHA-256 in
;; hex, two spaces and its path, then a line for each of its dependencies, in its manifest's order, of the dependency's
;; hash, two spaces and its name; written sha256:hex. A url dependency's hash is the one its manifest pins. A directory's
;; hash has a line for each of its files, found as a package's are with its marker in place of package.sub.
(require-unqualified sha256 std/crypto/sha256)
(require-unqualified fs host/fs)
(require-unqualified manifest "manifest.sub")
(require-unqualified files "files.sub")
(require-unqualified paths "path.sub")

(provide package-hash directory-hash)

(struct waiting [name string] [dir string] [next (ptr waiting)])

(define (package-hash [dir string] [into (ptr buffer)] [err (ptr buffer)]) -> bool
  (let ([a (make-arena)] [ok #f])
    (set! ok (hash! (& a) dir 0 into err))
    (arena-free (& a))
    ok))

(define (hash! [a (ptr arena)] [given string] [w (ptr waiting)] [into (ptr buffer)] [err (ptr buffer)]) -> bool
  (let ([dir string] [why string] [o w] [m manifest] [paths (make-buffer)] [lines (make-buffer)] [digest (array u8 32)]
        [ok #t] [me (cast (ptr waiting) (arena-alloc a (sizeof waiting)))])
    (when (< (fs-real-path given (& dir) (& why)) 0) (return (cannot! err why)))
    (while (and (!= o 0) (!= (-> o dir) dir)) (set! o (-> o next)))
    (when (!= o 0)
      (buffer-add-string! err "the package ")
      (buffer-add-string! err (-> o name))
      (buffer-add-string! err " depends on itself")
      (free (-> dir bytes))
      (return #f))
    (let ([file (joined-path dir "package.sub")])
      (set! ok (manifest-read a file (& m) err))
      (free (-> file bytes)))
    (set! (-> me name) (if ok (-> m name) ""))
    (set! (-> me dir) dir)
    (set! (-> me next) w)
    (when ok (set! ok (package-files a dir (& paths) err)))
    (let ([n (/ (-> paths length) (sizeof string))] [ps (cast (ptr string) (-> paths bytes))])
      (when ok
        (sorted! ps n)
        (for ([i u32 0]) (and ok (< i n)) (+= i 1) (set! ok (file-line! dir (@ ps i) (& lines) err)))))
    (when ok
      (let ([deps (-> m dependencies)])
        (for ([i u32 0]) (and ok (< i (-> deps length))) (+= i 1)
          (let* ([d (& (@ deps i))] [path (-> d path)]
                 [at (if (and (> (-> path length) 0) (== (@ path 0) #\/)) (string-copy path) (joined-path dir path))])
            (if (> (-> d url length) 0)
                (buffer-add-string! (& lines) (-> d hash))
                (set! ok (hash! a at me (& lines) err)))
            (when ok
              (buffer-add-string! (& lines) "  ")
              (buffer-add-string! (& lines) (-> d name))
              (buffer-add-byte! (& lines) 10))
            (free (-> at bytes))))))
    (when ok
      (sha256-of (buffer-bytes (& lines)) (slice digest))
      (buffer-add-string! into "sha256:")
      (add-hex! into (slice digest)))
    (buffer-free! (& paths))
    (buffer-free! (& lines))
    (free (-> dir bytes))
    ok))

(define (directory-hash [dir string] [marker string] [into (ptr buffer)] [err (ptr buffer)]) -> bool
  (let ([a (make-arena)] [paths (make-buffer)] [lines (make-buffer)] [digest (array u8 32)] [ok #f])
    (set! ok (tracked-files (& a) dir marker (& paths) err))
    (let ([n (/ (-> paths length) (sizeof string))] [ps (cast (ptr string) (-> paths bytes))])
      (when ok
        (sorted! ps n)
        (for ([i u32 0]) (and ok (< i n)) (+= i 1) (set! ok (file-line! dir (@ ps i) (& lines) err)))))
    (when ok
      (sha256-of (buffer-bytes (& lines)) (slice digest))
      (buffer-add-string! into "sha256:")
      (add-hex! into (slice digest)))
    (buffer-free! (& paths))
    (buffer-free! (& lines))
    (arena-free (& a))
    ok))

(define (file-line! [dir string] [path string] [lines (ptr buffer)] [err (ptr buffer)]) -> bool
  (let ([full (joined-path dir path)] [bytes (slice u8)] [why string] [digest (array u8 32)] [ok #t])
    (if (< (fs-read-file full (& bytes) (& why)) 0)
        (set! ok (cannot! err why))
        (begin
          (sha256-of bytes (slice digest))
          (add-hex! lines (slice digest))
          (buffer-add-string! lines "  ")
          (buffer-add-string! lines path)
          (buffer-add-byte! lines 10)
          (free (-> bytes items))))
    (free (-> full bytes))
    ok))

(define (cannot! [err (ptr buffer)] [why string]) -> bool
  (buffer-add-string! err "cannot read ")
  (buffer-add-string! err why)
  (free (-> why bytes))
  #f)

(define (add-hex! [b (ptr buffer)] [bytes (slice u8)])
  (for ([i u32 0]) (< i (-> bytes length)) (+= i 1)
    (buffer-add-byte! b (cast i32 (@ "0123456789abcdef" (>> (@ bytes i) 4))))
    (buffer-add-byte! b (cast i32 (@ "0123456789abcdef" (bit-and (@ bytes i) 15))))))

(define (sorted! [ps (ptr string)] [n u32])
  (for ([i u32 1]) (< i n) (+= i 1)
    (let ([s (@ ps i)] [j i])
      (while (and (> j 0) (< s (@ ps (- j 1))))
        (set! (@ ps j) (@ ps (- j 1)))
        (-= j 1))
      (set! (@ ps j) s))))
