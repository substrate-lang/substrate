;; A package's hash, as Go hashes a module: the SHA-256 of a line for each file, in path order, of the file's SHA-256
;; in hex, two spaces and its path; written sha256:hex. Dot-files, build/ and packages inside the package are left out,
;; and links are not followed.
(require-unqualified sha256 std/crypto/sha256)
(require-unqualified fs host/fs)

(provide package-hash joined-path)

;; package-hash adds the hash of the package at dir to into; when it fails, err says why.
(define (package-hash [dir string] [into (ptr buffer)] [err (ptr buffer)]) -> bool
  (let ([paths (make-buffer)] [lines (make-buffer)] [digest (array u8 32)] [ok #f])
    (set! ok (files! dir "" (& paths) err))
    (let ([n (/ (-> paths length) (sizeof string))] [ps (cast (ptr string) (-> paths bytes))])
      (when ok
        (sorted! ps n)
        (for ([i u32 0]) (and ok (< i n)) (+= i 1)
          (let ([full (joined-path dir (@ ps i))] [bytes (slice u8)] [why string])
            (if (< (fs-read-file full (& bytes) (& why)) 0)
                (set! ok (cannot! err full why))
                (begin
                  (sha256-of bytes (slice digest))
                  (add-hex! (& lines) (slice digest))
                  (buffer-add-string! (& lines) "  ")
                  (buffer-add-string! (& lines) (@ ps i))
                  (buffer-add-byte! (& lines) 10)
                  (free (-> bytes items))))
            (free (-> full bytes)))))
      (for ([i u32 0]) (< i n) (+= i 1) (free (-> (@ ps i) bytes))))
    (when ok
      (sha256-of (buffer-bytes (& lines)) (slice digest))
      (buffer-add-string! into "sha256:")
      (add-hex! into (slice digest)))
    (buffer-free! (& paths))
    (buffer-free! (& lines))
    ok))

;; joined-path gives a/b, newly allocated.
(define (joined-path [a string] [b string]) -> string
  (let ([out (make-buffer)])
    (buffer-add-string! (& out) a)
    (unless (and (> (-> a length) 0) (== (@ a (- (-> a length) 1)) #\/)) (buffer-add-byte! (& out) #\/))
    (buffer-add-string! (& out) b)
    (buffer-string (& out))))

(define (cannot! [err (ptr buffer)] [path string] [why string]) -> bool
  (buffer-add-string! err "cannot read ")
  (buffer-add-string! err why)
  (free (-> why bytes))
  #f)

(define (add-hex! [b (ptr buffer)] [bytes (slice u8)])
  (for ([i u32 0]) (< i (-> bytes length)) (+= i 1)
    (buffer-add-byte! b (cast i32 (@ "0123456789abcdef" (>> (@ bytes i) 4))))
    (buffer-add-byte! b (cast i32 (@ "0123456789abcdef" (bit-and (@ bytes i) 15))))))

;; files! adds the paths, from dir, of the package's files in the directory at path, from dir too.
(define (files! [dir string] [path string] [into (ptr buffer)] [err (ptr buffer)]) -> bool
  (let ([here (if (== (-> path length) 0) (string-copy dir) (joined-path dir path))] [names (slice string)] [why string]
        [ok #t])
    (when (< (fs-list here (& names) (& why)) 0)
      (cannot! err here why)
      (free (-> here bytes))
      (return #f))
    (for ([i u32 0]) (and ok (< i (-> names length))) (+= i 1)
      (let* ([name (@ names i)] [rel (if (== (-> path length) 0) (string-copy name) (joined-path path name))]
             [full (joined-path dir rel)] [info fs-info] [kept #f])
        (cond [(or (== (@ name 0) #\.) (and (== (-> path length) 0) (== name "build"))) (begin)]
              [(< (fs-lstat full (& info) (& why)) 0) (set! ok (cannot! err full why))]
              [(== (-> info kind) fs-file)
               (buffer-add! into (slice (cast (ptr u8) (& rel)) (sizeof string)))
               (set! kept #t)]
              [(and (== (-> info kind) fs-directory) (not (holds-package? full))) (set! ok (files! dir rel into err))])
        (unless kept (free (-> rel bytes)))
        (free (-> full bytes))))
    (free (-> names items))
    (free (-> here bytes))
    ok))

(define (holds-package? [dir string]) -> bool
  (let ([p (joined-path dir "package.sub")] [info fs-info] [found #f])
    (set! found (and (== (fs-lstat p (& info) 0) 0) (== (-> info kind) fs-file)))
    (free (-> p bytes))
    found))

(define (sorted! [ps (ptr string)] [n u32])
  (for ([i u32 1]) (< i n) (+= i 1)
    (let ([s (@ ps i)] [j i])
      (while (and (> j 0) (< s (@ ps (- j 1))))
        (set! (@ ps j) (@ ps (- j 1)))
        (-= j 1))
      (set! (@ ps j) s))))
