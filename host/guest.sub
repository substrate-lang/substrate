;; Guests: running another program in a sandbox, from Substrate.

(provide guest-source guest-start guest-send guest-send-text guest-stop guest-error
         guest-message guest-stdout guest-stderr guest-done guest-ended)

(import start "guest" "start" (i32 i32 i32 -> i32))
(import send "guest" "send" (i32 i32 i32 -> i32))
(import stop "guest" "stop" (i32 ->))

(const guest-source u32 3)
(const guest-message u32 1)
(const guest-stdout u32 2)
(const guest-stderr u32 3)
(const guest-done u32 4)
(const guest-ended u32 5)

(define (guest-start [spec (ptr u8)] [tag (ptr void)]) -> u32
  (cast u32 (start (cast i32 spec) (cast i32 (strlen spec)) (cast i32 tag))))

(define (guest-send [g u32] [p (ptr u8)] [n u32]) -> i32 (send (cast i32 g) (cast i32 p) (cast i32 n)))

(define (guest-send-text [g u32] [s (ptr u8)]) -> i32 (guest-send g s (strlen s)))

(define (guest-stop [g u32]) (stop (cast i32 g)))

(define (guest-error) -> (ptr u8)
  (let* ([p (cast (ptr u8) (malloc 1024))] [n (host-error-message p 1023)])
    (set! (@ p n) 0)
    p))
