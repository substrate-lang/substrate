;; HTTP requests: the host module "fetch". A request's id is also the stream of its response's body. Headers are
;; strings, each name followed by its value. A head event's value is the status, and its bytes are the headers as
;; entries.
(provide fetch-source fetch-head fetch-failed fetch-start fetch-get)

(import start "fetch" "start" (i32 i32 i32 i32 i32 i32 i32 i32 i32 -> i32))

(const fetch-source u32 6)
(const fetch-head u32 1)
(const fetch-failed u32 2)

(define (fetch-start [method string] [url string] [headers (slice string)] [body (slice u8)] [tag (ptr void)]) -> u32
  (let ([b (make-buffer)] [id u32 0])
    (buffer-add-entries! (& b) headers)
    (set! id (cast u32 (start (cast i32 (-> method bytes)) (cast i32 (-> method length)) (cast i32 (-> url bytes))
                              (cast i32 (-> url length)) (cast i32 (-> b bytes)) (cast i32 (-> b length))
                              (cast i32 (-> body items)) (cast i32 (-> body length)) (cast i32 tag))))
    (buffer-free! (& b))
    id))

(define (fetch-get [url string] [tag (ptr void)]) -> u32 (fetch-start "GET" url 0 0 tag))
