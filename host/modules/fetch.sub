;; HTTP requests: the host module "fetch", answered as events. A request's id is its response body's stream.
;; start takes the method, the URL, headers as entries, a name then its value, each ended by a zero, and the body.
;; Events: head 1 (value: the status, bytes: the headers as such entries), failed 2 (value: the error code).
(provide fetch-source fetch-head fetch-failed fetch-start fetch-get)

(import start "fetch" "start" (i32 i32 i32 i32 i32 i32 i32 i32 i32 -> i32))

(const fetch-source u32 6)
(const fetch-head u32 1)
(const fetch-failed u32 2)

(define (fetch-start [method (ptr u8)] [url (ptr u8)] [headers (ptr u8)] [n u32] [body (ptr u8)] [m u32] [tag (ptr void)])
  -> u32
  (cast u32 (start (cast i32 method) (cast i32 (strlen method)) (cast i32 url) (cast i32 (strlen url)) (cast i32 headers)
                   (cast i32 n) (cast i32 body) (cast i32 m) (cast i32 tag))))

(define (fetch-get [url (ptr u8)] [tag (ptr void)]) -> u32 (fetch-start "GET" url "" 0 "" 0 tag))
