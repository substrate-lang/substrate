;; WebSocket clients: the host module "websocket". websocket-connect takes options, or 0 for the defaults: the
;; subprotocols to offer and the headers to send, as entries, each header's name followed by its value; a page cannot
;; send headers. An open event's bytes are the subprotocol the server chose, empty for none. A message event's value is
;; websocket-text or websocket-binary, which websocket-send also takes.
(provide websocket-source websocket-open websocket-message websocket-closed websocket-failed websocket-drained
         websocket-text websocket-binary websocket-options websocket-options-init! websocket-connect websocket-send
         websocket-send-text websocket-close)

(import connect "websocket" "connect" (i32 i32 i32 i32 i32 i32 i32 i32 -> i32))
(import send "websocket" "send" (i32 i32 i32 i32 -> i32))
(import close "websocket" "close" (i32 i32 ->))

(const websocket-source u32 7)
(const websocket-open u32 1)
(const websocket-message u32 2)
(const websocket-closed u32 3)
(const websocket-failed u32 4)
(const websocket-drained u32 5)
(const websocket-text i32 1)
(const websocket-binary i32 2)

(struct websocket-options [protocols (ptr u8)] [protocols-length u32] [headers (ptr u8)] [headers-length u32])

(define (websocket-options-init! [o (ptr websocket-options)])
  (set! (-> o protocols) 0)
  (set! (-> o protocols-length) 0)
  (set! (-> o headers) 0)
  (set! (-> o headers-length) 0))

(define (websocket-connect [url (ptr u8)] [o (ptr websocket-options)] [tag (ptr void)] [err (ptr (ptr u8))]) -> u32
  (let ([defaults websocket-options] [p o])
    (when (== p 0)
      (websocket-options-init! (& defaults))
      (set! p (& defaults)))
    (cast u32 (connect (cast i32 url) (cast i32 (strlen url)) (cast i32 (-> p protocols))
                       (cast i32 (-> p protocols-length)) (cast i32 (-> p headers)) (cast i32 (-> p headers-length))
                       (cast i32 tag) (cast i32 err)))))

(define (websocket-send [id u32] [p (ptr u8)] [n u32] [kind i32]) -> i32
  (send (cast i32 id) (cast i32 p) (cast i32 n) kind))

(define (websocket-send-text [id u32] [s (ptr u8)]) -> i32 (websocket-send id s (strlen s) websocket-text))

(define (websocket-close [id u32] [code u32]) (close (cast i32 id) (cast i32 code)))
