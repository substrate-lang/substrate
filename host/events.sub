;; Events from the host: the current event's bytes, and where each event goes; and where a trap goes: on-trap
;; calls trap-dispatch, which runs the handler given to trap-handler! and gives 1, or 0 when there is none.
;; Sources: dom 1, gpu 2, worker 3, audio 4, timer 5, fetch 6, websocket 7, stream 8, net 9, process 10, storage 11,
;; location 12, clipboard 13, files 14.

(provide events-take events-take! events-take-text handler event-head event-handler! events-dispatch
         trap-handler! trap-dispatch
         error-missing error-unreachable error-refused error-timeout error-invalid error-aborted)

(import take "events" "take" (i32 i32 -> i32))

(const error-missing i32 1)
(const error-unreachable i32 2)
(const error-refused i32 3)
(const error-timeout i32 4)
(const error-invalid i32 5)
(const error-aborted i32 6)

(typedef handler (fn (u32 u32 u32 (ptr void) i32)))

(struct event-head [handle handler])

(define defaults (array handler 16))

(define (event-handler! [source u32] [f handler])
  (when (>= source 16)
    (let ([m "events: a source beyond 15"]) (host-trap m (strlen m))))
  (set! (@ defaults source) f))

(define (events-dispatch [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (if (!= tag 0)
      ((-> (cast (ptr event-head) tag) handle) source kind id tag value)
      (let ([f (if (< source 16) (@ defaults source) 0)])
        (when (!= f 0) (f source kind id tag value)))))

(typedef recovery (fn ()))

(define recover recovery 0)

(define (trap-handler! [f recovery]) (set! recover f))

(define (trap-dispatch) -> i32
  (if (== recover 0) 0 (begin (recover) 1)))

(define (events-take [p (ptr u8)] [cap u32]) -> u32 (cast u32 (take (cast i32 p) (cast i32 cap))))

(define (events-take-text) -> (ptr u8)
  (let* ([n (events-take 0 0)] [p (cast (ptr u8) (malloc (+ n 1)))])
    (events-take p n)
    (set! (@ p n) 0)
    p))

(define (events-take! [b (ptr buffer)]) -> u32
  (let ([n (events-take 0 0)] [p (events-take-text)])
    (buffer-add! b p n)
    (free p)
    n))
