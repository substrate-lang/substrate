;; Events from the host. events-take gives the current event's bytes as host calls give them, and events-take-text its
;; text; event-handler! sets the handler for a source's untagged events, and a tagged event goes to its tag's handler
;; (compiler/substrate.sub). A failed event's value is one of the error codes here, and its text is the reason.
;; Sources: dom 1, gpu 2, worker 3, audio 4, timer 5, fetch 6, websocket 7, stream 8, net 9, process 10, storage 11,
;; location 12, clipboard 13, files 14.

(provide events-take events-take! events-take-text event-handler!
         error-missing error-unreachable error-refused error-timeout error-invalid error-aborted error-denied
         error-in-use error-other error-not-granted)

(import take "events" "take" (i32 -> i32))

(const error-missing i32 1)
(const error-unreachable i32 2)
(const error-refused i32 3)
(const error-timeout i32 4)
(const error-invalid i32 5)
(const error-aborted i32 6)
(const error-denied i32 7)
(const error-in-use i32 8)
(const error-other i32 9)
(const error-not-granted i32 10)

(define defaults (array handler 64))

(define (by-source [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([f (if (< source 64) (@ defaults source) 0)])
    (when (!= f 0) (f source kind id tag value))))

(define (event-handler! [source u32] [f handler])
  (when (>= source 64) (host-trap "events: a source beyond 63"))
  (untagged-handler! by-source)
  (set! (@ defaults source) f))

(define (events-take) -> (slice u8)
  (let* ([n u32 0] [p (take (cast i32 (& n)))]) (slice (cast (ptr u8) p) n)))

(define (events-take-text) -> string (cast string (events-take)))

(define (events-take! [b (ptr buffer)]) -> u32
  (let ([e (events-take)])
    (when (!= (-> e items) 0)
      (buffer-add! b (-> e items) (-> e length))
      (free (-> e items)))
    (-> e length)))
