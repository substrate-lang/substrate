;; The host module "files", from a program: the user's files, picked, each a stream; and bytes saved as a file.
;; Events: file 1 (value: the stream; bytes: the name), picked 2 (value: how many), failed 3 (value: the error code).
;; pick takes whether several may be picked, and the types accepted, "" for any.
(provide files-source files-file files-picked files-failed files-pick files-save)

(import pick "files" "pick" (i32 i32 i32 i32 i32 -> i32))
(import save "files" "save" (i32 i32 i32 i32 ->))

(const files-source u32 14)
(const files-file u32 1)
(const files-picked u32 2)
(const files-failed u32 3)

(define (files-pick [multiple i32] [accept (ptr u8)] [tag (ptr void)] [err (ptr (ptr u8))]) -> u32
  (cast u32 (pick multiple (cast i32 accept) (cast i32 (strlen accept)) (cast i32 tag) (cast i32 err))))

(define (files-save [name (ptr u8)] [p (ptr u8)] [n u32])
  (save (cast i32 name) (cast i32 (strlen name)) (cast i32 p) (cast i32 n)))
