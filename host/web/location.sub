;; The host module "location", from a program: the page's URL, and the history it moves through. Events: changed 1
;; (bytes: the URL), untagged, after the user goes back or forward.
(provide location-source location-changed location-get location-push location-replace location-back)

(import get "location" "get" (i32 i32 -> i32))
(import push "location" "push" (i32 i32 -> i32))
(import replace "location" "replace" (i32 i32 -> i32))
(import back "location" "back" (->))

(const location-source u32 12)
(const location-changed u32 1)

(define (location-get) -> (ptr u8)
  (let* ([n (get 0 0)] [p (cast (ptr u8) (malloc (+ (cast u32 n) 1)))])
    (get (cast i32 p) n)
    (set! (@ p n) 0)
    p))

(define (location-push [url (ptr u8)]) -> i32 (push (cast i32 url) (cast i32 (strlen url))))

(define (location-replace [url (ptr u8)]) -> i32 (replace (cast i32 url) (cast i32 (strlen url))))

(define (location-back) (back))
