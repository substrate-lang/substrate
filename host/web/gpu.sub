;; The host module "gpu", from a program. Events: error 1 (value: the error code), loaded 2, pixels 3, bytes 4.
(provide gpu-source gpu-error gpu-loaded gpu-pixels gpu-bytes gpu-apply gpu-loading)

(const gpu-source u32 2)
(const gpu-error u32 1)
(const gpu-loaded u32 2)
(const gpu-pixels u32 3)
(const gpu-bytes u32 4)

(import gpu-apply "gpu" "apply" (i32 i32 ->))
(import gpu-loading "gpu" "loading" (-> i32))
