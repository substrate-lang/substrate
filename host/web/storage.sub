;; The host module "storage", from a program: keys and their bytes, kept by the browser. Events: got 1 (value: 1 if
;; found; bytes: the value), done 2, keys 3 (value: how many; bytes: the keys, each ended by a zero), failed 4 (value: the
;; error code).
(provide storage-source storage-got storage-done storage-keys storage-failed
         storage-get storage-set storage-set-text storage-remove storage-list)

(import get "storage" "get" (i32 i32 i32 -> i32))
(import set "storage" "set" (i32 i32 i32 i32 i32 -> i32))
(import remove "storage" "remove" (i32 i32 i32 -> i32))
(import list "storage" "list" (i32 i32 i32 -> i32))

(const storage-source u32 11)
(const storage-got u32 1)
(const storage-done u32 2)
(const storage-keys u32 3)
(const storage-failed u32 4)

(define (storage-get [key (ptr u8)] [tag (ptr void)]) -> u32
  (cast u32 (get (cast i32 key) (cast i32 (strlen key)) (cast i32 tag))))

(define (storage-set [key (ptr u8)] [p (ptr u8)] [n u32] [tag (ptr void)]) -> u32
  (cast u32 (set (cast i32 key) (cast i32 (strlen key)) (cast i32 p) (cast i32 n) (cast i32 tag))))

(define (storage-set-text [key (ptr u8)] [text (ptr u8)] [tag (ptr void)]) -> u32
  (storage-set key text (strlen text) tag))

(define (storage-remove [key (ptr u8)] [tag (ptr void)]) -> u32
  (cast u32 (remove (cast i32 key) (cast i32 (strlen key)) (cast i32 tag))))

(define (storage-list [prefix (ptr u8)] [tag (ptr void)]) -> u32
  (cast u32 (list (cast i32 prefix) (cast i32 (strlen prefix)) (cast i32 tag))))
