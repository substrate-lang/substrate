;; Watching files: the host module "watch", after Deno's watchFs. watch-start watches the paths given as entries, and
;; everything under them unless the options' recursive is 0, and returns the watch's number, or 0 with the reason at
;; err. A changed event's value is watch-create, watch-modify or watch-remove, and its bytes are the absolute paths it
;; is about, as entries; a rename comes as a remove and a create. Changes under the options' ignore paths, entries
;; too, are left out. A failed event ends the watch.
(provide watch-source watch-changed watch-failed watch-create watch-modify watch-remove watch-options
         watch-options-init! watch-start watch-stop)

(import start "watch" "start" (i32 i32 i32 i32 i32 i32 i32 -> i32))
(import stop "watch" "stop" (i32 ->))

(const watch-source u32 15)
(const watch-changed u32 1)
(const watch-failed u32 2)

(const watch-create i32 1)
(const watch-modify i32 2)
(const watch-remove i32 3)

(struct watch-options [recursive i32] [ignore (ptr u8)] [ignore-length u32])

(define (watch-options-init! [o (ptr watch-options)])
  (set! (-> o recursive) 1)
  (set! (-> o ignore) 0)
  (set! (-> o ignore-length) 0))

(define (watch-start [paths (ptr u8)] [n u32] [o (ptr watch-options)] [tag (ptr void)] [err (ptr (ptr u8))]) -> u32
  (let ([recursive 1] [ignore (ptr u8) 0] [m u32 0])
    (when (!= o 0)
      (set! recursive (-> o recursive))
      (set! ignore (-> o ignore))
      (set! m (-> o ignore-length)))
    (cast u32 (start (cast i32 paths) (cast i32 n) recursive (cast i32 ignore) (cast i32 m) (cast i32 tag)
                     (cast i32 err)))))

(define (watch-stop [w u32]) (stop (cast i32 w)))
