;; The environment's variables: the host module "env". get gives a variable's value as host-arg does, or 0 when
;; there is none.
(provide env-text)

(import get "env" "get" (i32 i32 i32 -> i32))

(define (env-text [name (ptr u8)]) -> (ptr u8) (cast (ptr u8) (get (cast i32 name) (cast i32 (strlen name)) 0)))
