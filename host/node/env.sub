;; The environment's variables: the host module "env". get: a variable's length, its bytes held for host-take, or
;; -1 when there is none.
(provide env-get env-text)

(import get "env" "get" (i32 i32 -> i32))

(define (env-get [name (ptr u8)]) -> i32 (get (cast i32 name) (cast i32 (strlen name))))

(define (env-text [name (ptr u8)]) -> (ptr u8) (if (< (env-get name) 0) 0 (host-take-text)))
