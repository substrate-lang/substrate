;; Environment variables: the host module "env". env-get gives a variable's value, or a string with no bytes when it is
;; not set or not granted, with the reason at err. env-set and env-delete change the program's environment, which the
;; programs it runs inherit, and return 0, or -1 with the reason at err. env-list gives the variables -E grants,
;; NAME=VALUE, in name order, as Deno's toObject does; without -E it fails.
(provide env-get env-set env-delete env-list)

(import get "env" "get" (i32 i32 i32 i32 -> i32))
(import put "env" "set" (i32 i32 i32 i32 i32 -> i32))
(import drop "env" "delete" (i32 i32 i32 -> i32))
(import listed "env" "list" (i32 i32 -> i32))

(define (env-get [name string] [err (ptr string)]) -> string
  (let* ([n u32 0] [p (get (cast i32 (-> name bytes)) (cast i32 (-> name length)) (cast i32 (& n)) (cast i32 err))])
    (cast string (slice (cast (ptr u8) p) n))))

(define (env-set [name string] [value string] [err (ptr string)]) -> i32
  (put (cast i32 (-> name bytes)) (cast i32 (-> name length)) (cast i32 (-> value bytes)) (cast i32 (-> value length))
       (cast i32 err)))

(define (env-delete [name string] [err (ptr string)]) -> i32
  (drop (cast i32 (-> name bytes)) (cast i32 (-> name length)) (cast i32 err)))

(define (env-list [err (ptr string)]) -> (slice string)
  (let* ([n u32 0] [p (listed (cast i32 (& n)) (cast i32 err))]) (entry-strings (cast (ptr u8) p) n)))
