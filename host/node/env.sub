;; Environment variables: the host module "env". env-text gives a variable's value, or 0 when it is not set or not
;; granted, with the reason at err. env-set and env-delete change the program's environment, which the programs it
;; runs inherit, and return 0, or -1 with the reason at err. env-list gives the variables -E grants as entries,
;; NAME=VALUE, in name order, as host-arg gives bytes, as Deno's toObject does; without -E it fails.
(provide env-text env-set env-delete env-list)

(import get "env" "get" (i32 i32 i32 i32 -> i32))
(import put "env" "set" (i32 i32 i32 i32 i32 -> i32))
(import drop "env" "delete" (i32 i32 i32 -> i32))
(import listed "env" "list" (i32 i32 -> i32))

(define (env-text [name (ptr u8)] [err (ptr (ptr u8))]) -> (ptr u8)
  (cast (ptr u8) (get (cast i32 name) (cast i32 (strlen name)) 0 (cast i32 err))))

(define (env-set [name (ptr u8)] [value (ptr u8)] [err (ptr (ptr u8))]) -> i32
  (put (cast i32 name) (cast i32 (strlen name)) (cast i32 value) (cast i32 (strlen value)) (cast i32 err)))

(define (env-delete [name (ptr u8)] [err (ptr (ptr u8))]) -> i32
  (drop (cast i32 name) (cast i32 (strlen name)) (cast i32 err)))

(define (env-list [n (ptr u32)] [err (ptr (ptr u8))]) -> (ptr u8) (cast (ptr u8) (listed (cast i32 n) (cast i32 err))))
