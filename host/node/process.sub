;; Child programs: the host module "process", their three pipes being streams.
;; Events: exit 1 (value: the exit code, or 128 plus the signal), failed 2 (value: the error code).
;; A spec is lines: program PATH, arg TEXT, dir PATH, env NAME=VALUE, and stdin, stdout or stderr followed by
;; ignore or inherit, for a pipe the program will not read or write.
(provide process-source process-exit process-failed process-spawn process-stdin process-stdout process-stderr process-kill)

(import spawn "process" "spawn" (i32 i32 i32 -> i32))
(import stdin "process" "stdin" (i32 -> i32))
(import stdout "process" "stdout" (i32 -> i32))
(import stderr "process" "stderr" (i32 -> i32))
(import kill "process" "kill" (i32 i32 ->))

(const process-source u32 10)
(const process-exit u32 1)
(const process-failed u32 2)

(define (process-spawn [spec (ptr u8)] [tag (ptr void)]) -> u32
  (cast u32 (spawn (cast i32 spec) (cast i32 (strlen spec)) (cast i32 tag))))

(define (process-stdin [id u32]) -> u32 (cast u32 (stdin (cast i32 id))))

(define (process-stdout [id u32]) -> u32 (cast u32 (stdout (cast i32 id))))

(define (process-stderr [id u32]) -> u32 (cast u32 (stderr (cast i32 id))))

(define (process-kill [id u32] [signal u32]) (kill (cast i32 id) (cast i32 signal)))
