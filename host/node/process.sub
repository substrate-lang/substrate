;; Child programs: the host module "process", their three pipes being streams. spawn takes the program, its
;; arguments and environment as entries each ended by a zero, NAME=VALUE for the environment, a directory, "" for
;; the parent's, and a mode for each pipe: process-pipe, a stream; process-ignore; process-inherit, the parent's.
;; Events: exit 1 (value: the exit code, or 128 plus the signal), failed 2 (value: the error code).
(provide process-source process-exit process-failed process-pipe process-ignore process-inherit
         process-spawn process-stdin process-stdout process-stderr process-kill)

(import spawn "process" "spawn" (i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 -> i32))
(import stdin "process" "stdin" (i32 -> i32))
(import stdout "process" "stdout" (i32 -> i32))
(import stderr "process" "stderr" (i32 -> i32))
(import kill "process" "kill" (i32 i32 ->))

(const process-source u32 10)
(const process-exit u32 1)
(const process-failed u32 2)
(const process-pipe i32 0)
(const process-ignore i32 1)
(const process-inherit i32 2)

(define (process-spawn [program (ptr u8)] [args (ptr u8)] [n u32] [dir (ptr u8)] [env (ptr u8)] [m u32]
                       [stdin i32] [stdout i32] [stderr i32] [tag (ptr void)]) -> u32
  (cast u32 (spawn (cast i32 program) (cast i32 (strlen program)) (cast i32 args) (cast i32 n) (cast i32 dir)
                   (cast i32 (strlen dir)) (cast i32 env) (cast i32 m) stdin stdout stderr (cast i32 tag))))

(define (process-stdin [id u32]) -> u32 (cast u32 (stdin (cast i32 id))))

(define (process-stdout [id u32]) -> u32 (cast u32 (stdout (cast i32 id))))

(define (process-stderr [id u32]) -> u32 (cast u32 (stderr (cast i32 id))))

(define (process-kill [id u32] [signal u32]) (kill (cast i32 id) (cast i32 signal)))
