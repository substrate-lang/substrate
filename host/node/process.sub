;; Child programs: the host module "process", their three pipes being streams. spawn takes the program, its
;; arguments as entries each ended by a zero, and options, 0 for the defaults: the directory, "" for the parent's;
;; the environment as such entries, NAME=VALUE, added to the parent's, or to none when clear is set; and a mode for
;; each pipe: process-pipe, a stream; process-ignore; process-inherit, the parent's.
;; Events: exit 1 (value: the exit code, or 128 plus the signal), failed 2 (value: the error code).
(provide process-source process-exit process-failed process-pipe process-ignore process-inherit process-options
         process-options-init! process-spawn process-stdin process-stdout process-stderr process-kill)

(import spawn "process" "spawn" (i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 -> i32))
(import stdin "process" "stdin" (i32 -> i32))
(import stdout "process" "stdout" (i32 -> i32))
(import stderr "process" "stderr" (i32 -> i32))
(import kill "process" "kill" (i32 i32 ->))

(const process-source u32 10)
(const process-exit u32 1)
(const process-failed u32 2)
(const process-pipe i32 0)
(const process-ignore i32 1)
(const process-inherit i32 2)

(struct process-options [dir (ptr u8)] [env (ptr u8)] [env-length u32] [clear i32] [stdin i32] [stdout i32]
  [stderr i32])

(define (process-options-init! [o (ptr process-options)])
  (set! (-> o dir) "")
  (set! (-> o env) "")
  (set! (-> o env-length) 0)
  (set! (-> o clear) 0)
  (set! (-> o stdin) process-pipe)
  (set! (-> o stdout) process-pipe)
  (set! (-> o stderr) process-pipe))

(define (process-spawn [program (ptr u8)] [args (ptr u8)] [n u32] [o (ptr process-options)] [tag (ptr void)]
                       [err (ptr (ptr u8))]) -> u32
  (let ([defaults process-options] [p o])
    (when (== p 0)
      (process-options-init! (& defaults))
      (set! p (& defaults)))
    (cast u32 (spawn (cast i32 program) (cast i32 (strlen program)) (cast i32 args) (cast i32 n)
                     (cast i32 (-> p dir)) (cast i32 (strlen (-> p dir))) (cast i32 (-> p env)) (cast i32 (-> p env-length))
                     (-> p clear) (-> p stdin) (-> p stdout) (-> p stderr) (cast i32 tag) (cast i32 err)))))

(define (process-stdin [id u32]) -> u32 (cast u32 (stdin (cast i32 id))))

(define (process-stdout [id u32]) -> u32 (cast u32 (stdout (cast i32 id))))

(define (process-stderr [id u32]) -> u32 (cast u32 (stderr (cast i32 id))))

(define (process-kill [id u32] [signal u32]) (kill (cast i32 id) (cast i32 signal)))
