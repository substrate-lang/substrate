;; Byte streams: the host module "stream", whose ids other modules hand out.
;; Events: read 1 (value: the bytes read, 0 at the end), drained 2, failed 3 (value: the error code),
;; finished 4 (once everything written before finish has been).
(require-unqualified events "events.sub")

(provide stream-source stream-read stream-drained stream-failed stream-finished
         stream-read! stream-write stream-write-text stream-finish stream-close stream-tag!
         stream-reader stream-read-all! stream-pipe stream-pipe-start! stream-pipe-drained!)

(import read "stream" "read" (i32 i32 i32 -> i32))
(import write "stream" "write" (i32 i32 i32 -> i32))
(import finish "stream" "finish" (i32 ->))
(import close "stream" "close" (i32 ->))
(import tag "stream" "tag" (i32 i32 ->))

(const stream-source u32 8)
(const stream-read u32 1)
(const stream-drained u32 2)
(const stream-failed u32 3)
(const stream-finished u32 4)

(define (stream-read! [id u32] [p (ptr u8)] [cap u32]) -> i32 (read (cast i32 id) (cast i32 p) (cast i32 cap)))

(define (stream-write [id u32] [p (ptr u8)] [n u32]) -> i32 (write (cast i32 id) (cast i32 p) (cast i32 n)))

(define (stream-write-text [id u32] [s (ptr u8)]) -> i32 (stream-write id s (strlen s)))

(define (stream-finish [id u32]) (finish (cast i32 id)))

(define (stream-close [id u32]) (close (cast i32 id)))

(define (stream-tag! [id u32] [t (ptr void)]) (tag (cast i32 id) (cast i32 t)))

;; A reader takes a stream's bytes into its buffer until the end or a failure, then calls finished.
(struct stream-reader [head event-head] [id u32] [bytes buffer] [failed i32] [chunk (array u8 4096)]
  [finished (fn ((ptr stream-reader)))])

(define (stream-read-all! [r (ptr stream-reader)] [id u32] [finished (fn ((ptr stream-reader)))])
  (set! (-> r head handle) reader-heard)
  (set! (-> r id) id)
  (set! (-> r bytes) (make-buffer))
  (set! (-> r failed) 0)
  (set! (-> r finished) finished)
  (stream-tag! id (cast (ptr void) r))
  (stream-read! id (-> r chunk) 4096))

(define (reader-heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([r (cast (ptr stream-reader) tag)])
    (cond [(and (== kind stream-read) (> value 0))
           (buffer-add! (& (-> r bytes)) (-> r chunk) (cast u32 value))
           (stream-read! id (-> r chunk) 4096)]
          [(== kind stream-read) ((-> r finished) r)]
          [(== kind stream-failed)
           (set! (-> r failed) value)
           ((-> r finished) r)])))

;; A pipe moves one stream's bytes to another until the end or a failure, or n bytes unless n is -1, then calls
;; finished; a source that ends before n bytes fails. Whoever owns the destination tells the pipe when that stream
;; has drained. The source is closed at the end.
(struct stream-pipe [head event-head] [from u32] [to u32] [left i64] [finish i32] [waiting i32] [failed i32]
  [chunk (array u8 65536)] [finished (fn ((ptr stream-pipe)))])

(define (stream-pipe-start! [p (ptr stream-pipe)] [from u32] [to u32] [n i64] [finish i32]
                            [finished (fn ((ptr stream-pipe)))])
  (set! (-> p head handle) pipe-heard)
  (set! (-> p from) from)
  (set! (-> p to) to)
  (set! (-> p left) n)
  (set! (-> p finish) finish)
  (set! (-> p waiting) 0)
  (set! (-> p failed) 0)
  (set! (-> p finished) finished)
  (stream-tag! from (cast (ptr void) p))
  (pipe-read! p))

(define (stream-pipe-drained! [p (ptr stream-pipe)])
  (when (-> p waiting)
    (set! (-> p waiting) 0)
    (pipe-read! p)))

(define (pipe-read! [p (ptr stream-pipe)])
  (let ([left (-> p left)])
    (if (== left 0)
        (pipe-end! p 0)
        (stream-read! (-> p from) (-> p chunk) (if (and (> left 0) (< left 65536)) (cast u32 left) 65536)))))

(define (pipe-end! [p (ptr stream-pipe)] [failed i32])
  (set! (-> p failed) failed)
  (stream-close (-> p from))
  (when (and (== failed 0) (-> p finish)) (stream-finish (-> p to)))
  ((-> p finished) p))

(define (pipe-heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([p (cast (ptr stream-pipe) tag)])
    (cond [(and (== kind stream-read) (> value 0))
           (when (> (-> p left) 0) (-= (-> p left) (cast i64 value)))
           (let ([w (stream-write (-> p to) (-> p chunk) (cast u32 value))])
             (cond [(< w 0) (pipe-end! p error-aborted)]
                   [(== w 1) (set! (-> p waiting) 1)]
                   [else (pipe-read! p)]))]
          [(== kind stream-read) (pipe-end! p (if (> (-> p left) 0) error-aborted 0))]
          [(== kind stream-failed) (pipe-end! p value)])))
