;; Files: the host module "fs", by path. read: the size, the bytes held for host-take, -1 if missing. write,
;; make-dir, remove and rename: 0, or -1. stat: the size, -1 if missing, -2 for a directory. list: the names as
;; entries each ended by a zero, with their length in n.
;; open gives a stream; its modes: read 0, write 1, append 2.
(provide fs-read fs-write fs-make-dir fs-read-file fs-write-file fs-stat fs-list fs-remove fs-rename fs-open
         fs-read-mode fs-write-mode fs-append-mode)

(import read_file "fs" "read_file" (i32 i32 -> i32))
(import write_file "fs" "write_file" (i32 i32 i32 i32 -> i32))
(import make_dir "fs" "make_dir" (i32 i32 -> i32))
(import stat "fs" "stat" (i32 i32 -> i64))
(import list "fs" "list" (i32 i32 -> i32))
(import remove "fs" "remove" (i32 i32 -> i32))
(import rename "fs" "rename" (i32 i32 i32 i32 -> i32))
(import open "fs" "open" (i32 i32 i32 i32 -> i32))

(const fs-read-mode u32 0)
(const fs-write-mode u32 1)
(const fs-append-mode u32 2)

(define (fs-read [path (ptr u8)] [n i32]) #:inline -> i32 (read_file (cast i32 path) n))

(define (fs-write [path (ptr u8)] [n i32] [p (ptr u8)] [len i32]) #:inline -> i32
  (write_file (cast i32 path) n (cast i32 p) len))

(define (fs-make-dir [path (ptr u8)] [n i32]) #:inline -> i32 (make_dir (cast i32 path) n))

(define (fs-read-file [path (ptr u8)] [n (ptr u32)]) -> (ptr u8)
  (let ([size (fs-read path (strlen path))])
    (if (< size 0)
        0
        (begin
          (when (!= n 0) (set! (@ n) size))
          (host-take-text)))))

(define (fs-write-file [path (ptr u8)] [p (ptr u8)] [n u32]) -> i32 (fs-write path (strlen path) p n))

(define (fs-stat [path (ptr u8)]) -> i64 (stat (cast i32 path) (cast i32 (strlen path))))

(define (fs-list [path (ptr u8)] [n (ptr u32)]) -> (ptr u8)
  (let ([size (list (cast i32 path) (cast i32 (strlen path)))])
    (if (< size 0)
        0
        (begin
          (when (!= n 0) (set! (@ n) (cast u32 size)))
          (host-take-text)))))

(define (fs-remove [path (ptr u8)]) -> i32 (remove (cast i32 path) (cast i32 (strlen path))))

(define (fs-rename [from (ptr u8)] [to (ptr u8)]) -> i32
  (rename (cast i32 from) (cast i32 (strlen from)) (cast i32 to) (cast i32 (strlen to))))

(define (fs-open [path (ptr u8)] [mode u32] [tag (ptr void)]) -> u32
  (cast u32 (open (cast i32 path) (cast i32 (strlen path)) (cast i32 mode) (cast i32 tag))))
