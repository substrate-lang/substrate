;; Files by path: the host module "fs". fs-read-file gives a file's bytes and fs-list a directory's names as entries,
;; both as host-arg gives bytes. The calls that change files return 0, or -1 when they fail. fs-stat returns the
;; size, -2 for a directory, or -1 when it fails. fs-open returns a stream. Each call stores a failure's reason at
;; err.
(provide fs-read fs-write fs-make-dir fs-read-file fs-write-file fs-stat fs-list fs-remove fs-rename fs-open
         fs-read-mode fs-write-mode fs-append-mode)

(import read_file "fs" "read_file" (i32 i32 i32 i32 -> i32))
(import write_file "fs" "write_file" (i32 i32 i32 i32 i32 -> i32))
(import make_dir "fs" "make_dir" (i32 i32 i32 -> i32))
(import stat "fs" "stat" (i32 i32 i32 -> i64))
(import list "fs" "list" (i32 i32 i32 i32 -> i32))
(import remove "fs" "remove" (i32 i32 i32 -> i32))
(import rename "fs" "rename" (i32 i32 i32 i32 i32 -> i32))
(import open "fs" "open" (i32 i32 i32 i32 i32 -> i32))

(const fs-read-mode u32 0)
(const fs-write-mode u32 1)
(const fs-append-mode u32 2)

(define (fs-read [path (ptr u8)] [len i32] [n (ptr u32)] [err (ptr (ptr u8))]) #:inline -> (ptr u8)
  (cast (ptr u8) (read_file (cast i32 path) len (cast i32 n) (cast i32 err))))

(define (fs-write [path (ptr u8)] [n i32] [p (ptr u8)] [len i32] [err (ptr (ptr u8))]) #:inline -> i32
  (write_file (cast i32 path) n (cast i32 p) len (cast i32 err)))

(define (fs-make-dir [path (ptr u8)] [n i32] [err (ptr (ptr u8))]) #:inline -> i32
  (make_dir (cast i32 path) n (cast i32 err)))

(define (fs-read-file [path (ptr u8)] [n (ptr u32)] [err (ptr (ptr u8))]) -> (ptr u8)
  (fs-read path (strlen path) n err))

(define (fs-write-file [path (ptr u8)] [p (ptr u8)] [n u32] [err (ptr (ptr u8))]) -> i32
  (fs-write path (strlen path) p n err))

(define (fs-stat [path (ptr u8)] [err (ptr (ptr u8))]) -> i64
  (stat (cast i32 path) (cast i32 (strlen path)) (cast i32 err)))

(define (fs-list [path (ptr u8)] [n (ptr u32)] [err (ptr (ptr u8))]) -> (ptr u8)
  (cast (ptr u8) (list (cast i32 path) (cast i32 (strlen path)) (cast i32 n) (cast i32 err))))

(define (fs-remove [path (ptr u8)] [err (ptr (ptr u8))]) -> i32
  (remove (cast i32 path) (cast i32 (strlen path)) (cast i32 err)))

(define (fs-rename [from (ptr u8)] [to (ptr u8)] [err (ptr (ptr u8))]) -> i32
  (rename (cast i32 from) (cast i32 (strlen from)) (cast i32 to) (cast i32 (strlen to)) (cast i32 err)))

(define (fs-open [path (ptr u8)] [mode u32] [tag (ptr void)] [err (ptr (ptr u8))]) -> u32
  (cast u32 (open (cast i32 path) (cast i32 (strlen path)) (cast i32 mode) (cast i32 tag) (cast i32 err))))
