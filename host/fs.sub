;; Files by path: the host module "fs", after Deno's file calls. fs-read-file gives a file's bytes and fs-list a
;; directory's names as entries, both as host-arg gives bytes; fs-read-link, fs-real-path, fs-make-temp-dir,
;; fs-make-temp-file and fs-cwd give a path as text. fs-stat fills an fs-info, and fs-lstat does too without following
;; a link at the end of the path. fs-remove removes a file, a link or an empty directory, or with recursive set a
;; directory and everything in it. The other calls return 0, or -1 when they fail. fs-open returns a stream. Each call
;; stores a failure's reason at err.
(provide fs-read fs-write fs-make-dir fs-read-file fs-write-file fs-info fs-stat fs-lstat fs-list fs-remove fs-rename
         fs-open fs-read-link fs-real-path fs-symlink fs-copy fs-chmod fs-make-temp-dir fs-make-temp-file fs-cwd
         fs-read-mode fs-write-mode fs-append-mode fs-file fs-directory fs-link fs-other)

(import read_file "fs" "read_file" (i32 i32 i32 i32 -> i32))
(import write_file "fs" "write_file" (i32 i32 i32 i32 i32 -> i32))
(import make_dir "fs" "make_dir" (i32 i32 i32 -> i32))
(import info "fs" "info" (i32 i32 i32 i32 -> i32 f64 f64 i32))
(import list "fs" "list" (i32 i32 i32 i32 -> i32))
(import remove "fs" "remove" (i32 i32 i32 -> i32))
(import remove_all "fs" "remove_all" (i32 i32 i32 -> i32))
(import rename "fs" "rename" (i32 i32 i32 i32 i32 -> i32))
(import open "fs" "open" (i32 i32 i32 i32 i32 -> i32))
(import read_link "fs" "read_link" (i32 i32 i32 -> i32))
(import real_path "fs" "real_path" (i32 i32 i32 -> i32))
(import symlink "fs" "symlink" (i32 i32 i32 i32 i32 -> i32))
(import copy_file "fs" "copy_file" (i32 i32 i32 i32 i32 -> i32))
(import chmod "fs" "chmod" (i32 i32 i32 i32 -> i32))
(import make_temp "fs" "make_temp" (i32 i32 i32 i32 i32 i32 i32 i32 -> i32))
(import cwd "fs" "cwd" (i32 -> i32))

(const fs-read-mode u32 0)
(const fs-write-mode u32 1)
(const fs-append-mode u32 2)

;; An fs-info's kind.
(const fs-file i32 1)
(const fs-directory i32 2)
(const fs-link i32 3)
(const fs-other i32 4)

;; modified is in milliseconds since 1970, and mode is the file's mode bits, its type's included.
(struct fs-info [kind i32] [size i64] [modified f64] [mode u32])

(define (fs-read [path (ptr u8)] [len i32] [n (ptr u32)] [err (ptr (ptr u8))]) #:inline -> (ptr u8)
  (cast (ptr u8) (read_file (cast i32 path) len (cast i32 n) (cast i32 err))))

(define (fs-write [path (ptr u8)] [n i32] [p (ptr u8)] [len i32] [err (ptr (ptr u8))]) #:inline -> i32
  (write_file (cast i32 path) n (cast i32 p) len (cast i32 err)))

(define (fs-make-dir [path (ptr u8)] [n i32] [err (ptr (ptr u8))]) #:inline -> i32
  (make_dir (cast i32 path) n (cast i32 err)))

(define (fs-read-file [path (ptr u8)] [n (ptr u32)] [err (ptr (ptr u8))]) -> (ptr u8)
  (fs-read path (strlen path) n err))

(define (fs-write-file [path (ptr u8)] [p (ptr u8)] [n u32] [err (ptr (ptr u8))]) -> i32
  (fs-write path (strlen path) p n err))

(define (stat-of [path (ptr u8)] [follow i32] [i (ptr fs-info)] [err (ptr (ptr u8))]) -> i32
  (let ([(kind size modified mode) (info (cast i32 path) (cast i32 (strlen path)) follow (cast i32 err))])
    (set! (-> i kind) kind)
    (set! (-> i size) (cast i64 size))
    (set! (-> i modified) modified)
    (set! (-> i mode) (cast u32 mode))
    (if (== kind 0) -1 0)))

(define (fs-stat [path (ptr u8)] [i (ptr fs-info)] [err (ptr (ptr u8))]) -> i32 (stat-of path 1 i err))

(define (fs-lstat [path (ptr u8)] [i (ptr fs-info)] [err (ptr (ptr u8))]) -> i32 (stat-of path 0 i err))

(define (fs-list [path (ptr u8)] [n (ptr u32)] [err (ptr (ptr u8))]) -> (ptr u8)
  (cast (ptr u8) (list (cast i32 path) (cast i32 (strlen path)) (cast i32 n) (cast i32 err))))

(define (fs-remove [path (ptr u8)] [recursive i32] [err (ptr (ptr u8))]) -> i32
  (if recursive
      (remove_all (cast i32 path) (cast i32 (strlen path)) (cast i32 err))
      (remove (cast i32 path) (cast i32 (strlen path)) (cast i32 err))))

(define (fs-rename [from (ptr u8)] [to (ptr u8)] [err (ptr (ptr u8))]) -> i32
  (rename (cast i32 from) (cast i32 (strlen from)) (cast i32 to) (cast i32 (strlen to)) (cast i32 err)))

(define (fs-open [path (ptr u8)] [mode u32] [tag (ptr void)] [err (ptr (ptr u8))]) -> u32
  (cast u32 (open (cast i32 path) (cast i32 (strlen path)) (cast i32 mode) (cast i32 tag) (cast i32 err))))

(define (fs-read-link [path (ptr u8)] [err (ptr (ptr u8))]) -> (ptr u8)
  (cast (ptr u8) (read_link (cast i32 path) (cast i32 (strlen path)) (cast i32 err))))

(define (fs-real-path [path (ptr u8)] [err (ptr (ptr u8))]) -> (ptr u8)
  (cast (ptr u8) (real_path (cast i32 path) (cast i32 (strlen path)) (cast i32 err))))

;; fs-symlink makes a link at path to target, which needs all of -R and -W, as Deno's symlink does.
(define (fs-symlink [target (ptr u8)] [path (ptr u8)] [err (ptr (ptr u8))]) -> i32
  (symlink (cast i32 target) (cast i32 (strlen target)) (cast i32 path) (cast i32 (strlen path)) (cast i32 err)))

(define (fs-copy [from (ptr u8)] [to (ptr u8)] [err (ptr (ptr u8))]) -> i32
  (copy_file (cast i32 from) (cast i32 (strlen from)) (cast i32 to) (cast i32 (strlen to)) (cast i32 err)))

(define (fs-chmod [path (ptr u8)] [mode u32] [err (ptr (ptr u8))]) -> i32
  (chmod (cast i32 path) (cast i32 (strlen path)) (cast i32 mode) (cast i32 err)))

;; The temporary calls make a new directory or file named prefix, random hexadecimal digits and suffix, in dir, or in
;; the system's temporary directory when dir is 0, and give its path.
(define (make-temp [dir (ptr u8)] [prefix (ptr u8)] [suffix (ptr u8)] [file i32] [err (ptr (ptr u8))]) -> (ptr u8)
  (cast (ptr u8) (make_temp (cast i32 dir) (if (== dir 0) 0 (cast i32 (strlen dir))) (cast i32 prefix)
                            (cast i32 (strlen prefix)) (cast i32 suffix) (cast i32 (strlen suffix)) file
                            (cast i32 err))))

(define (fs-make-temp-dir [dir (ptr u8)] [prefix (ptr u8)] [suffix (ptr u8)] [err (ptr (ptr u8))]) -> (ptr u8)
  (make-temp dir prefix suffix 0 err))

(define (fs-make-temp-file [dir (ptr u8)] [prefix (ptr u8)] [suffix (ptr u8)] [err (ptr (ptr u8))]) -> (ptr u8)
  (make-temp dir prefix suffix 1 err))

(define (fs-cwd [err (ptr (ptr u8))]) -> (ptr u8) (cast (ptr u8) (cwd (cast i32 err))))
