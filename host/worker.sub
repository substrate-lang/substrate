;; Workers: this program's functions, each run on a thread that shares only messages. worker-start runs the function,
;; one of the program's own rather than of code it loaded, with the bytes as its argument 0, and returns the worker's
;; number, or 0 with the reason at err. The options set a time limit in milliseconds for each stretch of work, a
;; memory limit in bytes, and whether output comes as stdout and stderr events; a limit of 0 means none. A worker has
;; its parent's modules, and calling one that a thread cannot have traps. It has its parent's grants, or the options'
;; grants when there are any: flags such as -R=DIR, which must lie within the parent's. A done event's bytes are the
;; trap, if any. An ended event's value is the exit code, or -1 after a trap, the time limit or a failure, and its
;; bytes are the reason.
(provide worker-source worker-message worker-stdout worker-stderr worker-done worker-ended
         worker-options worker-options-init! worker-start worker-send worker-send-text worker-stop)

(import start "worker" "start" (i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 -> i32))
(import send "worker" "send" (i32 i32 i32 -> i32))
(import stop "worker" "stop" (i32 ->))

(const worker-source u32 3)
(const worker-message u32 1)
(const worker-stdout u32 2)
(const worker-stderr u32 3)
(const worker-done u32 4)
(const worker-ended u32 5)

(struct worker-options [time u32] [memory u32] [output bool] [grants (slice string)])

(define (worker-options-init! [o (ptr worker-options)])
  (set! (-> o time) 0)
  (set! (-> o memory) 0)
  (set! (-> o output) #f)
  (set! (-> o grants) 0))

(define (worker-start [function (fn ())] [argument (slice u8)] [o (ptr worker-options)] [tag (ptr void)]
                      [err (ptr string)]) -> u32
  (let ([defaults worker-options] [p o] [grants (make-buffer)] [id u32 0])
    (when (== p 0)
      (worker-options-init! (& defaults))
      (set! p (& defaults)))
    (buffer-add-entries! (& grants) (-> p grants))
    (set! id (cast u32 (start (cast i32 function) (cast i32 (-> argument items)) (cast i32 (-> argument length))
                              (cast i32 (-> p time)) (cast i32 (-> p memory)) (-> p output) (cast i32 tag)
                              (cast i32 (-> grants bytes)) (cast i32 (-> grants length)) (cast i32 err))))
    (buffer-free! (& grants))
    id))

(define (worker-send [w u32] [b (slice u8)]) -> i32 (send (cast i32 w) (cast i32 (-> b items)) (cast i32 (-> b length))))

(define (worker-send-text [w u32] [s string]) -> i32 (worker-send w (cast (slice u8) s)))

(define (worker-stop [w u32]) (stop (cast i32 w)))
