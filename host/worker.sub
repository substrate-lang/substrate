;; Workers: this program, or modules given to it, run on a thread of its own, sharing nothing but messages.
;; worker-start runs one of this program's functions with bytes as its argument. For more, plan one with worker-new,
;; then grant it modules, folders, limits and modules of another program, and run it. A worker's time limit is in
;; milliseconds and its memory limit in bytes, each unlimited when 0.
;; Events: message 1, stdout 2, stderr 3, done 4 (bytes: the trap, if any), ended 5 (bytes: the reason).
(provide worker-source worker-message worker-stdout worker-stderr worker-done worker-ended
         worker-start worker-new worker-grant! worker-read! worker-write! worker-limit! worker-module! worker-run!
         worker-send worker-send-text worker-stop worker-error)

(import new "worker" "new" (i32 -> i32))
(import grant "worker" "grant" (i32 i32 i32 -> i32))
(import read "worker" "read" (i32 i32 i32 -> i32))
(import write "worker" "write" (i32 i32 i32 -> i32))
(import limit "worker" "limit" (i32 i32 i32 ->))
(import module "worker" "module" (i32 i32 i32 i32 i32 -> i32))
(import run "worker" "run" (i32 i32 i32 i32 i32 -> i32))
(import send "worker" "send" (i32 i32 i32 -> i32))
(import stop "worker" "stop" (i32 ->))

(const worker-source u32 3)
(const worker-message u32 1)
(const worker-stdout u32 2)
(const worker-stderr u32 3)
(const worker-done u32 4)
(const worker-ended u32 5)

(define (worker-new [tag (ptr void)]) -> u32 (cast u32 (new (cast i32 tag))))

(define (worker-grant! [w u32] [name (ptr u8)]) -> i32 (grant (cast i32 w) (cast i32 name) (cast i32 (strlen name))))

(define (worker-read! [w u32] [dir (ptr u8)]) -> i32 (read (cast i32 w) (cast i32 dir) (cast i32 (strlen dir))))

(define (worker-write! [w u32] [dir (ptr u8)]) -> i32 (write (cast i32 w) (cast i32 dir) (cast i32 (strlen dir))))

(define (worker-limit! [w u32] [ms u32] [bytes u32]) (limit (cast i32 w) (cast i32 ms) (cast i32 bytes)))

(define (worker-module! [w u32] [name (ptr u8)] [p (ptr u8)] [n u32]) -> i32
  (module (cast i32 w) (cast i32 name) (cast i32 (strlen name)) (cast i32 p) (cast i32 n)))

(define (worker-run! [w u32] [function (ptr u8)] [p (ptr u8)] [n u32]) -> i32
  (run (cast i32 w) (cast i32 function) (cast i32 (strlen function)) (cast i32 p) (cast i32 n)))

(define (worker-start [function (ptr u8)] [p (ptr u8)] [n u32] [tag (ptr void)]) -> u32
  (let ([w (worker-new tag)])
    (if (< (worker-run! w function p n) 0)
        (begin (worker-stop w) 0)
        w)))

(define (worker-send [w u32] [p (ptr u8)] [n u32]) -> i32 (send (cast i32 w) (cast i32 p) (cast i32 n)))

(define (worker-send-text [w u32] [s (ptr u8)]) -> i32 (worker-send w s (strlen s)))

(define (worker-stop [w u32]) (stop (cast i32 w)))

(define (worker-error) -> (ptr u8)
  (let* ([p (cast (ptr u8) (malloc 1024))] [n (host-error-message p 1023)])
    (set! (@ p n) 0)
    p))
