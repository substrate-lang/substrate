;; Workers: this program's functions run on threads of their own, sharing nothing but messages. worker-start runs
;; the named function on a thread, where the bytes are the worker's argument 0, read with host-arg; it gives the
;; worker's number, or 0 with the reason at err. Its options, 0 for the defaults: a time limit in
;; milliseconds on each stretch of work, and a memory limit in bytes, each unlimited when 0. A worker has its
;; parent's modules; one a thread cannot have, such as dom in a browser, traps when called. In a browser, its
;; files are a copy of the page's, which it cannot write.
;; Events: message 1, stdout 2, stderr 3, done 4 (bytes: the trap, if any), ended 5 (value: the exit code, or -1
;; after a trap, the time limit or a failure, with the reason as bytes).
(provide worker-source worker-message worker-stdout worker-stderr worker-done worker-ended
         worker-options worker-options-init! worker-start worker-send worker-send-text worker-stop)

(import start "worker" "start" (i32 i32 i32 i32 i32 i32 i32 i32 -> i32))
(import send "worker" "send" (i32 i32 i32 -> i32))
(import stop "worker" "stop" (i32 ->))

(const worker-source u32 3)
(const worker-message u32 1)
(const worker-stdout u32 2)
(const worker-stderr u32 3)
(const worker-done u32 4)
(const worker-ended u32 5)

(struct worker-options [time u32] [memory u32])

(define (worker-options-init! [o (ptr worker-options)])
  (set! (-> o time) 0)
  (set! (-> o memory) 0))

(define (worker-start [function (ptr u8)] [p (ptr u8)] [n u32] [o (ptr worker-options)] [tag (ptr void)]
                      [err (ptr (ptr u8))]) -> u32
  (let ([time u32 0] [memory u32 0])
    (when (!= o 0)
      (set! time (-> o time))
      (set! memory (-> o memory)))
    (cast u32 (start (cast i32 function) (cast i32 (strlen function)) (cast i32 p) (cast i32 n)
                     (cast i32 time) (cast i32 memory) (cast i32 tag) (cast i32 err)))))

(define (worker-send [w u32] [p (ptr u8)] [n u32]) -> i32 (send (cast i32 w) (cast i32 p) (cast i32 n)))

(define (worker-send-text [w u32] [s (ptr u8)]) -> i32 (worker-send w s (strlen s)))

(define (worker-stop [w u32]) (stop (cast i32 w)))
