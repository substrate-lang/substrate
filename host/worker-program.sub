;; A worker on a program `sub build` wrote: worker-program! gives a worker the modules under DIR, those DIR/program
;; lists, each in NAME.wasm; -1 when one is missing.
(provide worker-program!)
(require-unqualified worker "worker.sub")
(require-unqualified fs "fs.sub")

(define (worker-program! [w u32] [dir (ptr u8)]) -> i32
  (let* ([n u32 0] [path (make-buffer)] [list (ptr u8) 0] [at u32 0] [ok i32 0])
    (buffer-add-string! (& path) dir)
    (buffer-add-string! (& path) "/program")
    (buffer-add-byte! (& path) 0)
    (set! list (fs-read-file (-> path bytes) (& n)))
    (buffer-free! (& path))
    (when (== list 0) (return -1))
    (while (< at n)
      (let ([end at])
        (while (and (< end n) (!= (@ list end) 10)) (+= end 1))
        (when (> end at)
          (let ([name (make-buffer)] [file (make-buffer)] [size u32 0])
            (buffer-add! (& name) (+ list at) (- end at))
            (buffer-add-byte! (& name) 0)
            (buffer-add-string! (& file) dir)
            (buffer-add-byte! (& file) 47)
            (buffer-add! (& file) (+ list at) (- end at))
            (buffer-add-string! (& file) ".wasm")
            (buffer-add-byte! (& file) 0)
            (let ([bytes (fs-read-file (-> file bytes) (& size))])
              (if (== bytes 0)
                  (set! ok -1)
                  (begin
                    (worker-module! w (-> name bytes) bytes size)
                    (free bytes))))
            (buffer-free! (& name))
            (buffer-free! (& file))))
        (set! at (+ end 1))))
    (free list)
    ok))
