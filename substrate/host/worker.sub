;; Workers: this program's functions, each run on a thread that shares only messages. worker-start runs one of the
;; program's own functions with the bytes as its argument 0, and returns the worker's number, or 0 with the reason at
;; err. Options: a time limit in ms for each stretch of work and a memory limit in bytes, none at 0; output as stdout
;; and stderr events; grants (grants.sub) within the parent's, by default the parent's own. Calling a module a thread
;; cannot have traps. A done event's bytes are the trap, if any; an ended event's value is the exit code, or -1 after a
;; trap, the time limit or a failure, with the reason as its bytes.
(require-unqualified gr "grants.sub")

(provide worker-source worker-message worker-stdout worker-stderr worker-done worker-ended
         worker-options worker-options-init! worker-start worker-send worker-send-text worker-stop)

(import start "worker" "start" (i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 -> i32))
(import send "worker" "send" (i32 i32 i32 -> i32))
(import stop "worker" "stop" (i32 ->))

(const worker-source u32 3)
(const worker-message u32 1)
(const worker-stdout u32 2)
(const worker-stderr u32 3)
(const worker-done u32 4)
(const worker-ended u32 5)

(struct worker-options [time u32] [memory u32] [output bool] [grants grants])

(define (worker-options-init! [o (ptr worker-options)])
  (set! (-> o time) 0)
  (set! (-> o memory) 0)
  (set! (-> o output) #f)
  (set! (-> o grants) (make-grants))
  (grants-inherit! (& (-> o grants))))

(define (worker-start [function (fn ())] [argument (slice u8)] [o (ptr worker-options)] [tag (ptr void)]
                      [err (ptr string)]) -> u32
  (let ([defaults worker-options] [p o] [entries (make-buffer)] [id u32 0])
    (when (== p 0)
      (worker-options-init! (& defaults))
      (set! p (& defaults)))
    (grants-entries! (& entries) (& (-> p grants)))
    (set! id (cast u32 (start (cast i32 function) (cast i32 (-> argument items)) (cast i32 (-> argument length))
                              (cast i32 (-> p time)) (cast i32 (-> p memory)) (-> p output) (cast i32 tag)
                              (cast i32 (-> entries bytes)) (cast i32 (-> entries length)) (cast i32 err))))
    (buffer-free! (& entries))
    (when (== o 0) (buffer-free! (& (-> defaults grants list))))
    id))

(define (worker-send [w u32] [b (slice u8)]) -> i32 (send (cast i32 w) (cast i32 (-> b items)) (cast i32 (-> b length))))

(define (worker-send-text [w u32] [s string]) -> i32 (worker-send w (cast (slice u8) s)))

(define (worker-stop [w u32]) (stop (cast i32 w)))
