;; Workers: functions of this program, each running on its own thread and sharing only messages. worker-start runs one
;; of the program's own functions with the bytes as its argument 0, and returns the worker's number, or 0 with the
;; reason at err. Its options:
;;   time, memory  limits in ms for each stretch of work and in bytes, or 0 for none
;;   output        the worker's stdout and stderr come as events
;;   grants        the worker's grants (grants.sub), within the parent's and by default the parent's own
;;   ends          the worker ends as a program does, once nothing it started is pending, and so takes no messages
;;   args          the worker's arguments, in place of the bytes
;; A worker keeps its parent's fakes and adds those its grants ask for. On Node, TLS files its grants name replace the
;; parent's, and ends is only on Node. A worker that calls a host module its thread cannot have, such as stdin, traps.
;; A done event's bytes are the trap, if any. An ended event's value is the exit code, or -1 after a trap, the time
;; limit or a failure, and its bytes are the reason. worker-wait blocks until a worker this thread started has an event
;; and takes it, so that its tag never gets it: it returns the event's kind with its value and bytes, or 0 when ms pass
;; first, or -1 when the worker is not running; it is only on Node.
(require-unqualified gr "grants.sub")

(provide worker-source worker-message worker-stdout worker-stderr worker-done worker-ended
         worker-options worker-options-init! worker-start worker-send worker-send-text worker-stop worker-wait)

(import start "worker" "start" (i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 -> i32))
(import send "worker" "send" (i32 i32 i32 -> i32))
(import stop "worker" "stop" (i32 ->))
(import wait "worker" "wait" (i32 i32 i32 i32 -> i32))

(const worker-source u32 3)
(const worker-message u32 1)
(const worker-stdout u32 2)
(const worker-stderr u32 3)
(const worker-done u32 4)
(const worker-ended u32 5)

(struct worker-options [time u32] [memory u32] [output bool] [grants grants] [ends bool] [args (slice string)])

(define (worker-options-init! [o (ptr worker-options)])
  (set! (-> o time) 0)
  (set! (-> o memory) 0)
  (set! (-> o output) #f)
  (set! (-> o ends) #f)
  (set! (-> o args) (slice (cast (ptr string) 0) 0))
  (set! (-> o grants) (make-grants))
  (grants-inherit! (& (-> o grants))))

(define (worker-start [function (fn ())] [argument (slice u8)] [o (ptr worker-options)] [tag (ptr void)]
                      [err (ptr string)]) -> u32
  (let ([defaults worker-options] [p o] [entries (make-buffer)] [args (make-buffer)] [id u32 0])
    (when (== p 0)
      (worker-options-init! (& defaults))
      (set! p (& defaults)))
    (grants-entries! (& entries) (& (-> p grants)))
    (buffer-add-entries! (& args) (-> p args))
    (set! id (cast u32 (start (cast i32 function) (cast i32 (-> argument items)) (cast i32 (-> argument length))
                              (cast i32 (-> p time)) (cast i32 (-> p memory)) (-> p output) (cast i32 tag)
                              (cast i32 (-> entries bytes)) (cast i32 (-> entries length)) (cast i32 err) (-> p ends)
                              (cast i32 (-> args bytes)) (cast i32 (-> args length)))))
    (buffer-free! (& entries))
    (buffer-free! (& args))
    (when (== o 0) (buffer-free! (& (-> defaults grants list))))
    id))

(define (worker-send [w u32] [b (slice u8)]) -> i32 (send (cast i32 w) (cast i32 (-> b items)) (cast i32 (-> b length))))

(define (worker-send-text [w u32] [s string]) -> i32 (worker-send w (cast (slice u8) s)))

(define (worker-stop [w u32]) (stop (cast i32 w)))

(define (worker-wait [w u32] [ms u32] [value (ptr i32)] [bytes (ptr (slice u8))]) -> i32
  (wait (cast i32 w) (cast i32 ms) (cast i32 value) (cast i32 bytes)))
