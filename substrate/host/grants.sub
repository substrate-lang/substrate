;; Grants: what the host lets a program do, as pairs of a kind and an item.
;;   read write net env run    a path, a host or a name
;;   deny-read ... deny-run    the same, refused
;;   all                       one of those kinds, all of it
;;   inherit                   a kind, as the parent has it
;;   fake                      clock, timer, websocket or fetch
;;   fetch                     the directory a fake fetch answers from
;;   tls-cert tls-key          a file
;; grants-parse! reads flags as people type them, like -R=a,b, where ",," is a comma inside an item.
(provide grant grants grant-read grant-write grant-net grant-env grant-run make-grants grants-allow! grants-deny!
         grants-allow-all! grants-deny-all! grants-all! grants-inherit! grants-fake! grants-fetch! grants-tls!
         grants-parse! grants-flag? grants-entries! grants-arguments)

(struct grant [kind string] [item string])
(struct grants [list buffer])

(const grant-read u32 0)
(const grant-write u32 1)
(const grant-net u32 2)
(const grant-env u32 3)
(const grant-run u32 4)

(define (make-grants) -> grants
  (let ([g grants])
    (set! (-> g list) (make-buffer))
    g))

(define (added! [g (ptr grants)] [kind string] [item string])
  (let ([e (grant #:kind kind #:item item)])
    (buffer-add! (& (-> g list)) (slice (cast (ptr u8) (& e)) (sizeof grant)))))

(define (allowed [k u32]) -> string (let ([names (array-of string "read" "write" "net" "env" "run")]) (@ names k)))

(define (denied [k u32]) -> string
  (let ([names (array-of string "deny-read" "deny-write" "deny-net" "deny-env" "deny-run")]) (@ names k)))

(define (grants-allow! [g (ptr grants)] [k u32] [item string]) (added! g (allowed k) item))

(define (grants-deny! [g (ptr grants)] [k u32] [item string]) (added! g (denied k) item))

(define (grants-allow-all! [g (ptr grants)] [k u32]) (added! g "all" (allowed k)))

(define (grants-deny-all! [g (ptr grants)] [k u32]) (added! g "all" (denied k)))

(define (grants-all! [g (ptr grants)]) (for ([k u32 0]) (< k 5) (+= k 1) (grants-allow-all! g k)))

(define (grants-inherit! [g (ptr grants)]) (for ([k u32 0]) (< k 5) (+= k 1) (added! g "inherit" (allowed k))))

(define (grants-fake! [g (ptr grants)] [name string]) (added! g "fake" name))

(define (grants-fetch! [g (ptr grants)] [dir string]) (added! g "fetch" dir))

(define (grants-tls! [g (ptr grants)] [cert string] [key string])
  (added! g "tls-cert" cert)
  (added! g "tls-key" key))

(define (grants-entries! [b (ptr buffer)] [g (ptr grants)])
  (unless (== g 0)
    (let ([l (slice (cast (ptr grant) (-> g list bytes)) (/ (-> g list length) (sizeof grant)))])
      (for ([i u32 0]) (< i (-> l length)) (+= i 1)
        (let ([e (& (@ l i))])
          (buffer-add-string! b (-> e kind))
          (buffer-add-byte! b 0)
          (buffer-add-string! b (-> e item))
          (buffer-add-byte! b 0))))))

;; The arguments subhost.mjs takes to run the program in dir with g and args.
(define (grants-arguments [g (ptr grants)] [dir string] [args (slice string)]) -> (slice string)
  (let ([b (make-buffer)] [l (slice (cast (ptr grant) (-> g list bytes)) (/ (-> g list length) (sizeof grant)))])
    (for ([i u32 0]) (< i (-> l length)) (+= i 1)
      (let ([e (& (@ l i))])
        (pushed! (& b) "--grant")
        (pushed! (& b) (-> e kind))
        (pushed! (& b) (-> e item))))
    (pushed! (& b) "--")
    (pushed! (& b) dir)
    (for ([i u32 0]) (< i (-> args length)) (+= i 1) (pushed! (& b) (@ args i)))
    (strings-in (& b))))

;; ---- flags ----

(define (equals-at [s string]) -> u32
  (for ([i u32 0]) (< i (-> s length)) (+= i 1) (when (== (@ s i) #\=) (return i)))
  (-> s length))

(define (kind-of [name string] [k (ptr u32)]) -> bool
  (let ([shorts (array-of string "-R" "-W" "-N" "-E" "--allow-run")]
        [longs (array-of string "--allow-read" "--allow-write" "--allow-net" "--allow-env" "--allow-run")])
    (for ([i u32 0]) (< i 5) (+= i 1)
      (when (or (== name (@ shorts i)) (== name (@ longs i)))
        (set! (@ k) i)
        (return #t)))
    #f))

(define (denial-of [name string] [k (ptr u32)]) -> bool
  (let ([names (array-of string "--deny-read" "--deny-write" "--deny-net" "--deny-env" "--deny-run")])
    (for ([i u32 0]) (< i 5) (+= i 1)
      (when (== name (@ names i))
        (set! (@ k) i)
        (return #t)))
    #f))

(define (refused [err (ptr string)] [a string] [b string]) -> bool
  (let ([m (make-buffer)])
    (buffer-add-string! (& m) a)
    (buffer-add-string! (& m) b)
    (set! (@ err) (buffer-string (& m)))
    #f))

(define (pushed! [b (ptr buffer)] [s string]) (buffer-add! b (slice (cast (ptr u8) (& s)) (sizeof string))))

(define (split [flag string] [list string] [into (ptr buffer)] [err (ptr string)]) -> bool
  (let ([item (make-buffer)] [i u32 0] [n (-> list length)])
    (while (<= i n)
      (cond [(and (< (+ i 1) n) (== (@ list i) #\,) (== (@ list (+ i 1)) #\,))
             (buffer-add-byte! (& item) #\,)
             (+= i 2)]
            [(or (== i n) (== (@ list i) #\,))
             (when (== (-> item length) 0) (return (refused err flag " has an empty item")))
             (pushed! into (buffer-string (& item)))
             (set! item (make-buffer))
             (+= i 1)]
            [else
             (buffer-add-byte! (& item) (cast i32 (@ list i)))
             (+= i 1)]))
    #t))

(define (strings-in [b (ptr buffer)]) -> (slice string)
  (slice (cast (ptr string) (-> b bytes)) (/ (-> b length) (sizeof string))))

(define (listed! [g (ptr grants)] [kind string] [flag string] [list string] [err (ptr string)]) -> bool
  (let ([items (make-buffer)])
    (unless (split flag list (& items) err) (return #f))
    (let ([l (strings-in (& items))]) (for ([i u32 0]) (< i (-> l length)) (+= i 1) (added! g kind (@ l i))))
    #t))

(define (fakes! [g (ptr grants)] [flag string] [list string] [err (ptr string)]) -> bool
  (let ([items (make-buffer)])
    (unless (split flag list (& items) err) (return #f))
    (let ([l (strings-in (& items))])
      (for ([i u32 0]) (< i (-> l length)) (+= i 1)
        (let* ([item (@ l i)] [colon (colon-at item)] [name (slice item 0 colon)]
               [plain (or (== name "clock") (== name "timer") (== name "websocket") (== name "fetch"))])
          (cond [(and plain (== colon (-> item length))) (added! g "fake" name)]
                [(and (== name "fetch") (== colon (- (-> item length) 1))) (added! g "fake" name)]
                [(== name "fetch") (added! g "fetch" (slice item (+ colon 1) (-> item length)))]
                [else (return (refused err "no fake " item))]))))
    #t))

(define (colon-at [s string]) -> u32
  (for ([i u32 0]) (< i (-> s length)) (+= i 1) (when (== (@ s i) #\:) (return i)))
  (-> s length))

(define (grants-parse! [g (ptr grants)] [flags (slice string)] [err (ptr string)]) -> bool
  (for ([i u32 0]) (< i (-> flags length)) (+= i 1)
    (let* ([flag (@ flags i)] [eq (equals-at flag)] [name (slice flag 0 eq)] [listed (< eq (-> flag length))]
           [value (if listed (slice flag (+ eq 1) (-> flag length)) "")] [k u32 0])
      (cond [(or (== name "-A") (== name "--allow-all"))
             (when listed (return (refused err name " takes no list")))
             (grants-all! g)]
            [(kind-of name (& k))
             (if listed (unless (listed! g (allowed k) flag value err) (return #f)) (grants-allow-all! g k))]
            [(denial-of name (& k))
             (if listed (unless (listed! g (denied k) flag value err) (return #f)) (grants-deny-all! g k))]
            [(== name "--fake")
             (unless listed (return (refused err name " takes a list")))
             (unless (fakes! g flag value err) (return #f))]
            [(or (== name "--tls-cert") (== name "--tls-key"))
             (when (== (-> value length) 0) (return (refused err name " takes a file")))
             (added! g (if (== name "--tls-cert") "tls-cert" "tls-key") value)]
            [else (return (refused err flag " is not a grant"))])))
  #t)

(define (grants-flag? [s string]) -> bool
  (let ([name (slice s 0 (equals-at s))] [k u32 0])
    (or (== name "-A") (== name "--allow-all") (kind-of name (& k)) (denial-of name (& k)) (== name "--fake")
        (== name "--tls-cert") (== name "--tls-key"))))
