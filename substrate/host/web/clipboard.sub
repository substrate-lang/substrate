;; The clipboard's text, used with the user's leave: the host module "clipboard". A text event's bytes are the text.
(provide clipboard-source clipboard-text clipboard-written clipboard-failed clipboard-read clipboard-write)

(import read "clipboard" "read" (i32 i32 -> i32))
(import write "clipboard" "write" (i32 i32 i32 i32 -> i32))

(const clipboard-source u32 13)
(const clipboard-text u32 1)
(const clipboard-written u32 2)
(const clipboard-failed u32 3)

(define (clipboard-read [tag (ptr void)] [id (ptr u32)] [err (ptr error)]) -> bool
  (let ([why string] [n u32 0])
    (set! n (cast u32 (read (cast i32 tag) (cast i32 (& why)))))
    (unless (== id 0) (set! (@ id) n))
    (or (!= n 0) (host-failed! (& why) err))))

(define (clipboard-write [text string] [tag (ptr void)] [id (ptr u32)] [err (ptr error)]) -> bool
  (let ([why string] [n u32 0])
    (set! n (cast u32 (write (cast i32 (-> text bytes)) (cast i32 (-> text length)) (cast i32 tag) (cast i32 (& why)))))
    (unless (== id 0) (set! (@ id) n))
    (or (!= n 0) (host-failed! (& why) err))))
