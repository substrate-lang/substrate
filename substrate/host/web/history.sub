;; The session history: the host module "history", after the browser's window.history. An entry's state is bytes. An
;; empty url keeps the document's URL, as leaving the url out does in the browser. When the user goes back or forward,
;; each listener's tag gets a popstate event with the URL as its bytes. history-listen gives the listener's number, and
;; history-unlisten takes it.
(provide history-source history-popstate history-push-state history-replace-state history-state history-back
         history-forward history-go history-scroll-restoration history-set-scroll-restoration history-listen
         history-unlisten)

(import push-state "history" "push_state" (i32 i32 i32 i32 i32 -> i32))
(import replace-state "history" "replace_state" (i32 i32 i32 i32 i32 -> i32))
(import state "history" "state" (i32 -> i32))
(import back "history" "back" (->))
(import forward "history" "forward" (->))
(import go "history" "go" (i32 ->))
(import scroll-restoration "history" "scroll_restoration" (-> i32))
(import set-scroll-restoration "history" "set_scroll_restoration" (i32 i32 ->))
(import listen "history" "listen" (i32 -> i32))
(import unlisten "history" "unlisten" (i32 ->))

(const history-source u32 12)
(const history-popstate u32 1)

(define (history-push-state [s (slice u8)] [url string] [err (ptr error)]) -> bool
  (let ([why string])
    (or (== (push-state (cast i32 (-> s items)) (cast i32 (-> s length)) (cast i32 (-> url bytes))
                        (cast i32 (-> url length)) (cast i32 (& why)))
            0)
        (host-failed! (& why) err))))

(define (history-replace-state [s (slice u8)] [url string] [err (ptr error)]) -> bool
  (let ([why string])
    (or (== (replace-state (cast i32 (-> s items)) (cast i32 (-> s length)) (cast i32 (-> url bytes))
                           (cast i32 (-> url length)) (cast i32 (& why)))
            0)
        (host-failed! (& why) err))))

(define (history-state) -> (slice u8) (let* ([n u32 0] [p (state (cast i32 (& n)))]) (slice (cast (ptr u8) p) n)))

(define (history-back) (back))

(define (history-forward) (forward))

(define (history-go [delta i32]) (go delta))

(define (history-scroll-restoration) -> string (if (== (scroll-restoration) 1) "manual" "auto"))

(define (history-set-scroll-restoration [mode string])
  (set-scroll-restoration (cast i32 (-> mode bytes)) (cast i32 (-> mode length))))

(define (history-listen [tag (ptr void)]) -> u32 (cast u32 (listen (cast i32 tag))))

(define (history-unlisten [id u32]) (unlisten (cast i32 id)))
