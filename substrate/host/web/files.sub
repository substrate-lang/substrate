;; The user's files: the host module "files". Each file picked comes as a file event, whose value is its stream and
;; whose bytes are its name, and then a picked event's value is how many there were. An accept of "" takes any type.
;; files-pick stores the request's number at id, and returns #t, or #f with the failure at err.
(provide files-source files-file files-picked files-failed files-pick files-save)

(import pick "files" "pick" (i32 i32 i32 i32 i32 -> i32))
(import save "files" "save" (i32 i32 i32 i32 ->))

(const files-source u32 14)
(const files-file u32 1)
(const files-picked u32 2)
(const files-failed u32 3)

(define (files-pick [multiple bool] [accept string] [tag (ptr void)] [id (ptr u32)] [err (ptr error)]) -> bool
  (let ([why string])
    (set! (@ id) (cast u32 (pick multiple (cast i32 (-> accept bytes)) (cast i32 (-> accept length)) (cast i32 tag)
                                 (cast i32 (& why)))))
    (or (!= (@ id) 0) (host-failed! (& why) err))))

(define (files-save [name string] [b (slice u8)])
  (save (cast i32 (-> name bytes)) (cast i32 (-> name length)) (cast i32 (-> b items)) (cast i32 (-> b length))))
