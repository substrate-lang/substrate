;; The document's URL: the host module "location", after the browser's window.location.
(provide location-href location-assign location-replace location-reload)

(import href "location" "href" (i32 -> i32))
(import assign "location" "assign" (i32 i32 i32 -> i32))
(import replace "location" "replace" (i32 i32 i32 -> i32))
(import reload "location" "reload" (->))

(define (location-href) -> string
  (let* ([n u32 0] [p (href (cast i32 (& n)))]) (cast string (slice (cast (ptr u8) p) n))))

(define (location-assign [url string] [err (ptr error)]) -> bool
  (let ([why string])
    (or (== (assign (cast i32 (-> url bytes)) (cast i32 (-> url length)) (cast i32 (& why))) 0)
        (host-failed! (& why) err))))

(define (location-replace [url string] [err (ptr error)]) -> bool
  (let ([why string])
    (or (== (replace (cast i32 (-> url bytes)) (cast i32 (-> url length)) (cast i32 (& why))) 0)
        (host-failed! (& why) err))))

(define (location-reload) (reload))
