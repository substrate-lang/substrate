;; The page's URL and history: the host module "location". When the user goes back or forward, each listener's tag
;; gets a changed event with the URL as its bytes. location-listen gives the listener's number, and location-unlisten
;; takes it.
(provide location-source location-changed location-get location-push location-replace location-back location-listen
         location-unlisten)

(import get "location" "get" (i32 -> i32))
(import push "location" "push" (i32 i32 i32 -> i32))
(import replace "location" "replace" (i32 i32 i32 -> i32))
(import back "location" "back" (->))
(import listen "location" "listen" (i32 -> i32))
(import unlisten "location" "unlisten" (i32 ->))

(const location-source u32 12)
(const location-changed u32 1)

(define (location-get) -> string (let* ([n u32 0] [p (get (cast i32 (& n)))]) (cast string (slice (cast (ptr u8) p) n))))

(define (location-push [url string] [err (ptr error)]) -> bool
  (let ([why string])
    (or (== (push (cast i32 (-> url bytes)) (cast i32 (-> url length)) (cast i32 (& why))) 0)
        (host-failed! (& why) err))))

(define (location-replace [url string] [err (ptr error)]) -> bool
  (let ([why string])
    (or (== (replace (cast i32 (-> url bytes)) (cast i32 (-> url length)) (cast i32 (& why))) 0)
        (host-failed! (& why) err))))

(define (location-back) (back))

(define (location-listen [tag (ptr void)]) -> u32 (cast u32 (listen (cast i32 tag))))

(define (location-unlisten [id u32]) (unlisten (cast i32 id)))
