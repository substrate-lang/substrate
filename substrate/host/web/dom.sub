;; The document: the host module "dom". A heard event carries the id and tag its listener was given. A visibility
;; listener hears when its element comes into the viewport or leaves it. The reads of the document are in
;; std/web/dom.sub. dom-images-loading counts the images loading for a tag.
(provide dom-source dom-heard dom-image-loaded dom-image-failed dom-apply dom-images-loading)

(const dom-source u32 1)
(const dom-heard u32 1)
(const dom-image-loaded u32 2)
(const dom-image-failed u32 3)

(import dom-apply "dom" "apply" (i32 i32 ->))
(import images-loading "dom" "images_loading" (i32 -> i32))

(define (dom-images-loading [tag (ptr void)]) -> u32 (cast u32 (images-loading (cast i32 tag))))
