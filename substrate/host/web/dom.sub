;; The page: the host module "dom". A heard event carries the id and tag its listener was given. dom-event-flags gives
;; the bits dom-shift to dom-visible. dom-event-number takes one of dom-time, dom-x, dom-y, dom-movement-x,
;; dom-movement-y and dom-button, and gives that number for the current event. A visibility listener hears when its
;; element comes into the viewport or leaves it, with dom-visible set while it is in. dom-bind-element gives the
;; element with an id a node number (std/web/dom.sub).
(provide dom-source dom-heard dom-image-loaded dom-image-failed
         dom-shift dom-control dom-alt dom-meta dom-checked dom-locked dom-visible
         dom-time dom-x dom-y dom-movement-x dom-movement-y dom-button
         dom-apply dom-event-value dom-event-key dom-event-flags dom-event-number dom-prevent-default
         dom-stop-propagation dom-images-loading dom-bind-element)

(const dom-source u32 1)
(const dom-heard u32 1)
(const dom-image-loaded u32 2)
(const dom-image-failed u32 3)

(const dom-shift u32 1)
(const dom-control u32 2)
(const dom-alt u32 4)
(const dom-meta u32 8)
(const dom-checked u32 16)
(const dom-locked u32 32)
(const dom-visible u32 64)

(const dom-time i32 0)
(const dom-x i32 1)
(const dom-y i32 2)
(const dom-movement-x i32 3)
(const dom-movement-y i32 4)
(const dom-button i32 5)

(import dom-apply "dom" "apply" (i32 i32 ->))
(import dom-event-value "dom" "event_value" (i32 -> i32))
(import dom-event-key "dom" "event_key" (i32 -> i32))
(import dom-event-flags "dom" "event_flags" (-> i32))
(import dom-event-number "dom" "event_number" (i32 -> f64))
(import dom-prevent-default "dom" "prevent_default" (->))
(import dom-stop-propagation "dom" "stop_propagation" (->))
(import dom-images-loading "dom" "images_loading" (-> i32))
(import dom-bind-element "dom" "element" (i32 i32 i32 -> i32))
