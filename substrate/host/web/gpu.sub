;; WebGPU: the host module "gpu". gpu-apply runs a batch of commands, and the events the batch causes go to its tag: its
;; errors, the loads of its texture files and its reads. gpu-loading counts the texture files loading for a tag. Each
;; listener's tag hears the errors about the whole device, such as its loss; gpu-listen gives the listener's number,
;; which gpu-unlisten takes.
(provide gpu-source gpu-error gpu-loaded gpu-pixels gpu-bytes gpu-apply gpu-loading gpu-listen gpu-unlisten)

(const gpu-source u32 2)
(const gpu-error u32 1)
(const gpu-loaded u32 2)
(const gpu-pixels u32 3)
(const gpu-bytes u32 4)

(import apply "gpu" "apply" (i32 i32 i32 ->))
(import loading "gpu" "loading" (i32 -> i32))
(import listen "gpu" "listen" (i32 -> i32))
(import unlisten "gpu" "unlisten" (i32 ->))

(define (gpu-apply [commands (slice u8)] [tag (ptr void)])
  (apply (cast i32 (-> commands items)) (cast i32 (-> commands length)) (cast i32 tag)))

(define (gpu-loading [tag (ptr void)]) -> u32 (cast u32 (loading (cast i32 tag))))

(define (gpu-listen [tag (ptr void)]) -> u32 (cast u32 (listen (cast i32 tag))))

(define (gpu-unlisten [id u32]) (unlisten (cast i32 id)))
