;; Files: the host module "fs", on paths and on open files. fs-list stores a directory's names
;; at into, and fs-read-link, fs-real-path, fs-make-temp-dir, fs-make-temp-file and fs-cwd a path, as host calls give
;; them. fs-stat fills an fs-info, and fs-lstat does too without following a link at the end of the path. fs-remove
;; removes a file, a link or an empty directory, or when recursive a directory and everything in it.
(provide fs-read-file fs-write-file fs-make-dir fs-info fs-stat fs-lstat fs-list fs-remove fs-rename
         fs-read-link fs-real-path fs-symlink fs-copy fs-chmod fs-make-temp-dir fs-make-temp-file
         fs-cwd fs-kind fs-none fs-file fs-directory fs-link fs-other
         fs-open-file fs-read-at fs-write-at fs-set-size fs-sync fs-size fs-close-file fs-read-stream fs-write-stream
         fs-read-flag fs-write-flag fs-append-flag fs-truncate-flag fs-create-flag fs-create-new-flag)

(import make_dir "fs" "make_dir" (i32 i32 i32 -> i32))
(import info "fs" "info" (i32 i32 i32 i32 -> i32 f64 f64 i32))
(import list "fs" "list" (i32 i32 i32 i32 -> i32))
(import remove "fs" "remove" (i32 i32 i32 -> i32))
(import remove_all "fs" "remove_all" (i32 i32 i32 -> i32))
(import rename "fs" "rename" (i32 i32 i32 i32 i32 -> i32))
(import read_link "fs" "read_link" (i32 i32 i32 i32 -> i32))
(import real_path "fs" "real_path" (i32 i32 i32 i32 -> i32))
(import symlink "fs" "symlink" (i32 i32 i32 i32 i32 -> i32))
(import copy_file "fs" "copy_file" (i32 i32 i32 i32 i32 -> i32))
(import chmod "fs" "chmod" (i32 i32 i32 i32 -> i32))
(import make_temp "fs" "make_temp" (i32 i32 i32 i32 i32 i32 i32 i32 i32 -> i32))
(import cwd "fs" "cwd" (i32 i32 -> i32))
(import open_file "fs" "open_file" (i32 i32 i32 i32 -> i32))
(import read_at "fs" "read_at" (i32 i32 i32 f64 i32 -> i32))
(import write_at "fs" "write_at" (i32 i32 i32 f64 i32 -> i32))
(import set_file_size "fs" "set_file_size" (i32 f64 i32 -> i32))
(import sync_file "fs" "sync_file" (i32 i32 -> i32))
(import file_size "fs" "file_size" (i32 i32 -> f64))
(import close_file "fs" "close_file" (i32 i32 -> i32))
(import file_stream "fs" "file_stream" (i32 i32 f64 i32 i32 -> i32))

;; An fs-info's kind.
(enum fs-kind fs-none fs-file fs-directory fs-link fs-other)

;; modified is in milliseconds since 1970, and mode is the file's mode bits, its type's included.
(struct fs-info [kind fs-kind] [size i64] [modified f64] [mode u32])

(define (done [r i32] [why (ptr string)] [err (ptr error)]) -> bool (or (== r 0) (host-failed! why err)))

(define (fs-make-dir [path string] [err (ptr error)]) -> bool
  (let ([why string])
    (done (make_dir (cast i32 (-> path bytes)) (cast i32 (-> path length)) (cast i32 (& why))) (& why) err)))

(define (stat-of [path string] [follow bool] [i (ptr fs-info)] [err (ptr error)]) -> bool
  (let ([why string])
    (let ([(kind size modified mode)
           (info (cast i32 (-> path bytes)) (cast i32 (-> path length)) follow (cast i32 (& why)))])
      (set! (-> i kind) (cast fs-kind kind))
      (set! (-> i size) (cast i64 size))
      (set! (-> i modified) modified)
      (set! (-> i mode) (cast u32 mode))
      (or (!= kind 0) (host-failed! (& why) err)))))

(define (fs-stat [path string] [i (ptr fs-info)] [err (ptr error)]) -> bool (stat-of path #t i err))

(define (fs-lstat [path string] [i (ptr fs-info)] [err (ptr error)]) -> bool (stat-of path #f i err))

(define (fs-list [path string] [into (ptr (slice string))] [err (ptr error)]) -> bool
  (let* ([why string] [n u32 0]
         [p (list (cast i32 (-> path bytes)) (cast i32 (-> path length)) (cast i32 (& n)) (cast i32 (& why)))])
    (set! (@ into) (entry-strings (cast (ptr u8) p) n))
    (or (!= p 0) (host-failed! (& why) err))))

(define (fs-remove [path string] [recursive bool] [err (ptr error)]) -> bool
  (let ([why string])
    (done (if recursive
              (remove_all (cast i32 (-> path bytes)) (cast i32 (-> path length)) (cast i32 (& why)))
              (remove (cast i32 (-> path bytes)) (cast i32 (-> path length)) (cast i32 (& why))))
          (& why) err)))

(define (fs-rename [from string] [to string] [err (ptr error)]) -> bool
  (let ([why string])
    (done (rename (cast i32 (-> from bytes)) (cast i32 (-> from length)) (cast i32 (-> to bytes))
                  (cast i32 (-> to length)) (cast i32 (& why)))
          (& why) err)))

(define (path-given [p i32] [n u32] [into (ptr string)] [why (ptr string)] [err (ptr error)]) -> bool
  (set! (@ into) (cast string (slice (cast (ptr u8) p) n)))
  (or (!= p 0) (host-failed! why err)))

(define (fs-read-link [path string] [into (ptr string)] [err (ptr error)]) -> bool
  (let* ([why string] [n u32 0]
         [p (read_link (cast i32 (-> path bytes)) (cast i32 (-> path length)) (cast i32 (& n)) (cast i32 (& why)))])
    (path-given p n into (& why) err)))

(define (fs-real-path [path string] [into (ptr string)] [err (ptr error)]) -> bool
  (let* ([why string] [n u32 0]
         [p (real_path (cast i32 (-> path bytes)) (cast i32 (-> path length)) (cast i32 (& n)) (cast i32 (& why)))])
    (path-given p n into (& why) err)))

;; fs-symlink makes a link at path to target, which needs all of -R and -W, as Deno's symlink does.
(define (fs-symlink [target string] [path string] [err (ptr error)]) -> bool
  (let ([why string])
    (done (symlink (cast i32 (-> target bytes)) (cast i32 (-> target length)) (cast i32 (-> path bytes))
                   (cast i32 (-> path length)) (cast i32 (& why)))
          (& why) err)))

(define (fs-copy [from string] [to string] [err (ptr error)]) -> bool
  (let ([why string])
    (done (copy_file (cast i32 (-> from bytes)) (cast i32 (-> from length)) (cast i32 (-> to bytes))
                     (cast i32 (-> to length)) (cast i32 (& why)))
          (& why) err)))

(define (fs-chmod [path string] [mode u32] [err (ptr error)]) -> bool
  (let ([why string])
    (done (chmod (cast i32 (-> path bytes)) (cast i32 (-> path length)) (cast i32 mode) (cast i32 (& why)))
          (& why) err)))

;; The temporary calls make a new directory or file named prefix, random hexadecimal digits and suffix, in dir, or in
;; the system's temporary directory when dir is empty, and give its path.
(define (make-temp [dir string] [prefix string] [suffix string] [file bool] [into (ptr string)] [err (ptr error)])
  -> bool
  (let* ([why string] [n u32 0]
         [p (make_temp (cast i32 (-> dir bytes)) (cast i32 (-> dir length)) (cast i32 (-> prefix bytes))
                       (cast i32 (-> prefix length)) (cast i32 (-> suffix bytes)) (cast i32 (-> suffix length)) file
                       (cast i32 (& n)) (cast i32 (& why)))])
    (path-given p n into (& why) err)))

(define (fs-make-temp-dir [dir string] [prefix string] [suffix string] [into (ptr string)] [err (ptr error)]) -> bool
  (make-temp dir prefix suffix #f into err))

(define (fs-make-temp-file [dir string] [prefix string] [suffix string] [into (ptr string)] [err (ptr error)]) -> bool
  (make-temp dir prefix suffix #t into err))

(define (fs-cwd [into (ptr string)] [err (ptr error)]) -> bool
  (let* ([why string] [n u32 0] [p (cwd (cast i32 (& n)) (cast i32 (& why)))]) (path-given p n into (& why) err)))

;; Open files, read and written at a position. fs-open-file gives a handle opened as flags say, to read when they say
;; neither read nor write; writing, appending, creating and truncating need -W, and reading -R. fs-read-at gives the
;; number of bytes it read, fewer at the end of the file, and fs-size the file's size. fs-read-stream and
;; fs-write-stream make a handle a stream from start, which closes the handle when it closes. If they fail, they close
;; the handle. fs-read-file stores a file's bytes, from malloc, at into, and fs-write-file makes a file hold b.
(const fs-read-flag u32 1)
(const fs-write-flag u32 2)
(const fs-append-flag u32 4)
(const fs-truncate-flag u32 8)
(const fs-create-flag u32 16)
(const fs-create-new-flag u32 32)

(define (fs-open-file [path string] [flags u32] [h (ptr u32)] [err (ptr error)]) -> bool
  (let ([why string] [n u32 0])
    (set! n (cast u32 (open_file (cast i32 (-> path bytes)) (cast i32 (-> path length)) (cast i32 flags)
                                 (cast i32 (& why)))))
    (unless (== h 0) (set! (@ h) n))
    (or (!= n 0) (host-failed! (& why) err))))

(define (fs-read-at [h u32] [into (slice u8)] [at i64] [n (ptr u32)] [err (ptr error)]) -> bool
  (let* ([why string]
         [r (read_at (cast i32 h) (cast i32 (-> into items)) (cast i32 (-> into length)) (cast f64 at)
                     (cast i32 (& why)))])
    (set! (@ n) (if (< r 0) 0 (cast u32 r)))
    (or (>= r 0) (host-failed! (& why) err))))

(define (fs-write-at [h u32] [b (slice u8)] [at i64] [err (ptr error)]) -> bool
  (let ([why string])
    (done (write_at (cast i32 h) (cast i32 (-> b items)) (cast i32 (-> b length)) (cast f64 at) (cast i32 (& why)))
          (& why) err)))

(define (fs-set-size [h u32] [n i64] [err (ptr error)]) -> bool
  (let ([why string]) (done (set_file_size (cast i32 h) (cast f64 n) (cast i32 (& why))) (& why) err)))

(define (fs-sync [h u32] [err (ptr error)]) -> bool
  (let ([why string]) (done (sync_file (cast i32 h) (cast i32 (& why))) (& why) err)))

(define (fs-size [h u32] [size (ptr i64)] [err (ptr error)]) -> bool
  (let* ([why string] [s (file_size (cast i32 h) (cast i32 (& why)))])
    (set! (@ size) (if (< s 0.0) 0 (cast i64 s)))
    (or (>= s 0.0) (host-failed! (& why) err))))

(define (fs-close-file [h u32] [err (ptr error)]) -> bool
  (let ([why string]) (done (close_file (cast i32 h) (cast i32 (& why))) (& why) err)))

(define (file-stream [h u32] [write i32] [start i64] [tag (ptr void)] [id (ptr u32)] [err (ptr error)]) -> bool
  (let ([why string] [n u32 0])
    (set! n (cast u32 (file_stream (cast i32 h) write (cast f64 start) (cast i32 tag) (cast i32 (& why)))))
    (unless (== id 0) (set! (@ id) n))
    (or (!= n 0) (host-failed! (& why) err))))

(define (fs-read-stream [h u32] [start i64] [tag (ptr void)] [id (ptr u32)] [err (ptr error)]) -> bool
  (file-stream h 0 start tag id err))

(define (fs-write-stream [h u32] [start i64] [tag (ptr void)] [id (ptr u32)] [err (ptr error)]) -> bool
  (file-stream h 1 start tag id err))

(define (fs-read-file [path string] [into (ptr (slice u8))] [err (ptr error)]) -> bool
  (let ([h u32 0] [size i64 0] [room u32 0] [p (ptr u8) 0] [more (ptr u8) 0] [n u32 0] [got u32 0])
    (set! (@ into) (slice (cast (ptr u8) 0) 0))
    (unless (fs-open-file path fs-read-flag (& h) err) (return #f))
    (fs-size h (& size) 0)
    (set! room (if (> size 0) (+ (cast u32 (if (> size 2147483583) 2147483583 size)) 1) 4096))
    (set! p (try-malloc room))
    (while (!= p 0)
      (unless (fs-read-at h (slice (+ p n) (- room n)) (cast i64 n) (& got) err)
        (free p)
        (fs-close-file h 0)
        (return #f))
      (+= n got)
      (when (< n room)
        (fs-close-file h 0)
        (set! (@ into) (slice p n))
        (return #t))
      (set! more (try-realloc p (* room 2)))
      (when (== more 0) (free p))
      (set! p more)
      (set! room (* room 2)))
    (fs-close-file h 0)
    (error-fail! err error-other "File too large")))

(define (fs-write-file [path string] [b (slice u8)] [err (ptr error)]) -> bool
  (let ([h u32 0])
    (and (fs-open-file path (bit-or fs-write-flag fs-create-flag fs-truncate-flag) (& h) err)
         (if (fs-write-at h b 0 err)
             (fs-close-file h err)
             (begin (fs-close-file h 0) #f)))))
