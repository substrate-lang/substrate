;; Files: the host module "fs", on paths and on open files. fs-list stores a directory's names
;; at into, and fs-read-link, fs-real-path, fs-make-temp-dir, fs-make-temp-file and fs-cwd a path, as host calls give
;; them. fs-stat fills an fs-info, and fs-lstat does too without following a link at the end of the path. fs-remove
;; removes a file, a link or an empty directory, or when recursive a directory and everything in it. The calls return
;; 0, or -1 when they fail, and store a failure's reason at err.
(provide fs-read-file fs-write-file fs-make-dir fs-info fs-stat fs-lstat fs-list fs-remove fs-rename
         fs-read-link fs-real-path fs-symlink fs-copy fs-chmod fs-make-temp-dir fs-make-temp-file
         fs-cwd fs-kind fs-none fs-file fs-directory fs-link fs-other
         fs-open-file fs-read-at fs-write-at fs-set-size fs-sync fs-size fs-close-file fs-read-stream fs-write-stream
         fs-read-flag fs-write-flag fs-append-flag fs-truncate-flag fs-create-flag fs-create-new-flag)

(import make_dir "fs" "make_dir" (i32 i32 i32 -> i32))
(import info "fs" "info" (i32 i32 i32 i32 -> i32 f64 f64 i32))
(import list "fs" "list" (i32 i32 i32 i32 -> i32))
(import remove "fs" "remove" (i32 i32 i32 -> i32))
(import remove_all "fs" "remove_all" (i32 i32 i32 -> i32))
(import rename "fs" "rename" (i32 i32 i32 i32 i32 -> i32))
(import read_link "fs" "read_link" (i32 i32 i32 i32 -> i32))
(import real_path "fs" "real_path" (i32 i32 i32 i32 -> i32))
(import symlink "fs" "symlink" (i32 i32 i32 i32 i32 -> i32))
(import copy_file "fs" "copy_file" (i32 i32 i32 i32 i32 -> i32))
(import chmod "fs" "chmod" (i32 i32 i32 i32 -> i32))
(import make_temp "fs" "make_temp" (i32 i32 i32 i32 i32 i32 i32 i32 i32 -> i32))
(import cwd "fs" "cwd" (i32 i32 -> i32))
(import open_file "fs" "open_file" (i32 i32 i32 i32 -> i32))
(import read_at "fs" "read_at" (i32 i32 i32 f64 i32 -> i32))
(import write_at "fs" "write_at" (i32 i32 i32 f64 i32 -> i32))
(import set_file_size "fs" "set_file_size" (i32 f64 i32 -> i32))
(import sync_file "fs" "sync_file" (i32 i32 -> i32))
(import file_size "fs" "file_size" (i32 i32 -> f64))
(import close_file "fs" "close_file" (i32 i32 -> i32))
(import file_stream "fs" "file_stream" (i32 i32 f64 i32 i32 -> i32))

;; An fs-info's kind.
(enum fs-kind fs-none fs-file fs-directory fs-link fs-other)

;; modified is in milliseconds since 1970, and mode is the file's mode bits, its type's included.
(struct fs-info [kind fs-kind] [size i64] [modified f64] [mode u32])

(define (fs-make-dir [path string] [err (ptr string)]) -> i32
  (make_dir (cast i32 (-> path bytes)) (cast i32 (-> path length)) (cast i32 err)))

(define (stat-of [path string] [follow bool] [i (ptr fs-info)] [err (ptr string)]) -> i32
  (let ([(kind size modified mode) (info (cast i32 (-> path bytes)) (cast i32 (-> path length)) follow (cast i32 err))])
    (set! (-> i kind) (cast fs-kind kind))
    (set! (-> i size) (cast i64 size))
    (set! (-> i modified) modified)
    (set! (-> i mode) (cast u32 mode))
    (if (== kind 0) -1 0)))

(define (fs-stat [path string] [i (ptr fs-info)] [err (ptr string)]) -> i32 (stat-of path #t i err))

(define (fs-lstat [path string] [i (ptr fs-info)] [err (ptr string)]) -> i32 (stat-of path #f i err))

(define (fs-list [path string] [into (ptr (slice string))] [err (ptr string)]) -> i32
  (let* ([n u32 0] [p (list (cast i32 (-> path bytes)) (cast i32 (-> path length)) (cast i32 (& n)) (cast i32 err))])
    (set! (@ into) (entry-strings (cast (ptr u8) p) n))
    (if (== p 0) -1 0)))

(define (fs-remove [path string] [recursive bool] [err (ptr string)]) -> i32
  (if recursive
      (remove_all (cast i32 (-> path bytes)) (cast i32 (-> path length)) (cast i32 err))
      (remove (cast i32 (-> path bytes)) (cast i32 (-> path length)) (cast i32 err))))

(define (fs-rename [from string] [to string] [err (ptr string)]) -> i32
  (rename (cast i32 (-> from bytes)) (cast i32 (-> from length)) (cast i32 (-> to bytes)) (cast i32 (-> to length))
          (cast i32 err)))

(define (path-given [p i32] [n u32] [into (ptr string)]) -> i32
  (set! (@ into) (cast string (slice (cast (ptr u8) p) n)))
  (if (== p 0) -1 0))

(define (fs-read-link [path string] [into (ptr string)] [err (ptr string)]) -> i32
  (let* ([n u32 0] [p (read_link (cast i32 (-> path bytes)) (cast i32 (-> path length)) (cast i32 (& n)) (cast i32 err))])
    (path-given p n into)))

(define (fs-real-path [path string] [into (ptr string)] [err (ptr string)]) -> i32
  (let* ([n u32 0] [p (real_path (cast i32 (-> path bytes)) (cast i32 (-> path length)) (cast i32 (& n)) (cast i32 err))])
    (path-given p n into)))

;; fs-symlink makes a link at path to target, which needs all of -R and -W, as Deno's symlink does.
(define (fs-symlink [target string] [path string] [err (ptr string)]) -> i32
  (symlink (cast i32 (-> target bytes)) (cast i32 (-> target length)) (cast i32 (-> path bytes)) (cast i32 (-> path length))
           (cast i32 err)))

(define (fs-copy [from string] [to string] [err (ptr string)]) -> i32
  (copy_file (cast i32 (-> from bytes)) (cast i32 (-> from length)) (cast i32 (-> to bytes)) (cast i32 (-> to length))
             (cast i32 err)))

(define (fs-chmod [path string] [mode u32] [err (ptr string)]) -> i32
  (chmod (cast i32 (-> path bytes)) (cast i32 (-> path length)) (cast i32 mode) (cast i32 err)))

;; The temporary calls make a new directory or file named prefix, random hexadecimal digits and suffix, in dir, or in
;; the system's temporary directory when dir is empty, and give its path.
(define (make-temp [dir string] [prefix string] [suffix string] [file bool] [into (ptr string)] [err (ptr string)])
  -> i32
  (let* ([n u32 0]
         [p (make_temp (cast i32 (-> dir bytes)) (cast i32 (-> dir length)) (cast i32 (-> prefix bytes))
                       (cast i32 (-> prefix length)) (cast i32 (-> suffix bytes)) (cast i32 (-> suffix length)) file
                       (cast i32 (& n)) (cast i32 err))])
    (path-given p n into)))

(define (fs-make-temp-dir [dir string] [prefix string] [suffix string] [into (ptr string)] [err (ptr string)]) -> i32
  (make-temp dir prefix suffix #f into err))

(define (fs-make-temp-file [dir string] [prefix string] [suffix string] [into (ptr string)] [err (ptr string)]) -> i32
  (make-temp dir prefix suffix #t into err))

(define (fs-cwd [into (ptr string)] [err (ptr string)]) -> i32
  (let* ([n u32 0] [p (cwd (cast i32 (& n)) (cast i32 err))]) (path-given p n into)))

;; Open files, read and written at a position. fs-open-file gives a handle opened as flags say, to read when they say
;; neither read nor write, or 0 when it fails; writing, appending, creating and truncating need -W, and reading -R.
;; fs-read-at gives the number of bytes it read, fewer at the end of the file, and fs-size the file's size, or -1 when
;; it fails. fs-read-stream and fs-write-stream make a handle a stream from start, which closes the handle when it
;; closes, or give 0 when they fail, closing it. fs-read-file stores a file's bytes, from malloc, at into, and
;; fs-write-file makes a file hold b.
(const fs-read-flag u32 1)
(const fs-write-flag u32 2)
(const fs-append-flag u32 4)
(const fs-truncate-flag u32 8)
(const fs-create-flag u32 16)
(const fs-create-new-flag u32 32)

(define (fs-open-file [path string] [flags u32] [err (ptr string)]) -> u32
  (cast u32 (open_file (cast i32 (-> path bytes)) (cast i32 (-> path length)) (cast i32 flags) (cast i32 err))))

(define (fs-read-at [h u32] [into (slice u8)] [at i64] [err (ptr string)]) -> i32
  (read_at (cast i32 h) (cast i32 (-> into items)) (cast i32 (-> into length)) (cast f64 at) (cast i32 err)))

(define (fs-write-at [h u32] [b (slice u8)] [at i64] [err (ptr string)]) -> i32
  (write_at (cast i32 h) (cast i32 (-> b items)) (cast i32 (-> b length)) (cast f64 at) (cast i32 err)))

(define (fs-set-size [h u32] [n i64] [err (ptr string)]) -> i32 (set_file_size (cast i32 h) (cast f64 n) (cast i32 err)))

(define (fs-sync [h u32] [err (ptr string)]) -> i32 (sync_file (cast i32 h) (cast i32 err)))

(define (fs-size [h u32] [err (ptr string)]) -> i64 (cast i64 (file_size (cast i32 h) (cast i32 err))))

(define (fs-close-file [h u32] [err (ptr string)]) -> i32 (close_file (cast i32 h) (cast i32 err)))

(define (fs-read-stream [h u32] [start i64] [tag (ptr void)] [err (ptr string)]) -> u32
  (cast u32 (file_stream (cast i32 h) 0 (cast f64 start) (cast i32 tag) (cast i32 err))))

(define (fs-write-stream [h u32] [start i64] [tag (ptr void)] [err (ptr string)]) -> u32
  (cast u32 (file_stream (cast i32 h) 1 (cast f64 start) (cast i32 tag) (cast i32 err))))

(define (fs-read-file [path string] [into (ptr (slice u8))] [err (ptr string)]) -> i32
  (let* ([h (fs-open-file path fs-read-flag err)] [size i64 0] [room u32 0] [p (ptr u8) 0] [more (ptr u8) 0] [n u32 0]
         [got i32 0])
    (set! (@ into) (slice (cast (ptr u8) 0) 0))
    (when (== h 0) (return -1))
    (set! size (fs-size h err))
    (set! room (if (> size 0) (+ (cast u32 (if (> size 2147483583) 2147483583 size)) 1) 4096))
    (set! p (try-malloc room))
    (while (!= p 0)
      (set! got (fs-read-at h (slice (+ p n) (- room n)) (cast i64 n) err))
      (when (< got 0)
        (free p)
        (fs-close-file h 0)
        (return -1))
      (+= n (cast u32 got))
      (when (< n room)
        (fs-close-file h 0)
        (set! (@ into) (slice p n))
        (return 0))
      (set! more (try-realloc p (* room 2)))
      (when (== more 0) (free p))
      (set! p more)
      (set! room (* room 2)))
    (fs-close-file h 0)
    (when (!= err 0) (set! (@ err) (string-copy "File too large")))
    -1))

(define (fs-write-file [path string] [b (slice u8)] [err (ptr string)]) -> i32
  (let ([h (fs-open-file path (bit-or fs-write-flag fs-create-flag fs-truncate-flag) err)] [r i32 0])
    (when (== h 0) (return -1))
    (set! r (fs-write-at h b 0 err))
    (if (< r 0)
        (fs-close-file h 0)
        (set! r (fs-close-file h err)))
    r))
