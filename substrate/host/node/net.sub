;; TCP: the host module "net", whose connections are streams. net-listen binds host, or 127.0.0.1 when host is "",
;; and closes at once any connection beyond most, unless most is 0. A listening event's value is the port, and an
;; accept event's value is the new connection's stream and its text the peer's address. The two sides of a connection
;; end separately: the peer's end is a read of 0, and stream-finish ends this side. net-listen and net-connect store the
;; listener's or the connection's number at id, and return #t, or #f with the failure at err.
(provide net-source net-listening net-accept net-connected net-failed net-listen net-connect net-close)

(import listen "net" "listen" (i32 i32 i32 i32 i32 i32 i32 -> i32))
(import connect "net" "connect" (i32 i32 i32 i32 i32 i32 -> i32))
(import close "net" "close" (i32 ->))

(const net-source u32 9)
(const net-listening u32 1)
(const net-accept u32 2)
(const net-connected u32 3)
(const net-failed u32 4)

(define (net-listen [port u32] [host string] [secure bool] [most u32] [tag (ptr void)] [id (ptr u32)]
                    [err (ptr error)]) -> bool
  (let ([why string])
    (set! (@ id) (cast u32 (listen (cast i32 port) (cast i32 (-> host bytes)) (cast i32 (-> host length)) secure
                                   (cast i32 most) (cast i32 tag) (cast i32 (& why)))))
    (or (!= (@ id) 0) (host-failed! (& why) err))))

(define (net-connect [port u32] [host string] [secure bool] [tag (ptr void)] [id (ptr u32)] [err (ptr error)]) -> bool
  (let ([why string])
    (set! (@ id) (cast u32 (connect (cast i32 port) (cast i32 (-> host bytes)) (cast i32 (-> host length)) secure
                                    (cast i32 tag) (cast i32 (& why)))))
    (or (!= (@ id) 0) (host-failed! (& why) err))))

(define (net-close [id u32]) (close (cast i32 id)))
