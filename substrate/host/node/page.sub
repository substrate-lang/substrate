;; Built web programs opened as pages in the simulated browser: the host module "page". page-open takes a program's
;; directory, the file whose markup is the page, or "" for the default page, the directory whose files are the page's
;; assets, or "", and the page's URL, relative to http://localhost/index.html. page-request sends a request, its
;; fields each ended by a zero byte, and gives the answer.
(provide page-open page-request page-close)

(import open "page" "open" (i32 i32 i32 i32 i32 i32 i32 i32 i32 -> i32))
(import request "page" "request" (i32 i32 i32 i32 i32 -> i32))
(import close "page" "close" (i32 ->))

(define (page-open [dir string] [markup string] [assets string] [url string] [err (ptr string)]) -> u32
  (cast u32 (open (cast i32 (-> dir bytes)) (cast i32 (-> dir length)) (cast i32 (-> markup bytes))
                  (cast i32 (-> markup length)) (cast i32 (-> assets bytes)) (cast i32 (-> assets length))
                  (cast i32 (-> url bytes)) (cast i32 (-> url length)) (cast i32 err))))

(define (page-request [id u32] [fields string] [answer (ptr string)] [err (ptr string)]) -> i32
  (request (cast i32 id) (cast i32 (-> fields bytes)) (cast i32 (-> fields length)) (cast i32 answer) (cast i32 err)))

(define (page-close [id u32]) (close (cast i32 id)))
