;; Built web programs opened in simulated browsers: the host module "browser". browser-open takes a program's
;; directory, its HTML file, or "" for the default one, the directory whose files are its assets, or "", and its URL,
;; relative to http://localhost/index.html. browser-request sends a request, its fields each ended by a zero byte, and
;; gives the answer.
(provide browser-open browser-request browser-close)

(import open "browser" "open" (i32 i32 i32 i32 i32 i32 i32 i32 i32 -> i32))
(import request "browser" "request" (i32 i32 i32 i32 i32 -> i32))
(import close "browser" "close" (i32 ->))

(define (browser-open [dir string] [html string] [assets string] [url string] [err (ptr string)]) -> u32
  (cast u32 (open (cast i32 (-> dir bytes)) (cast i32 (-> dir length)) (cast i32 (-> html bytes))
                  (cast i32 (-> html length)) (cast i32 (-> assets bytes)) (cast i32 (-> assets length))
                  (cast i32 (-> url bytes)) (cast i32 (-> url length)) (cast i32 err))))

(define (browser-request [id u32] [fields string] [answer (ptr string)] [err (ptr string)]) -> i32
  (request (cast i32 id) (cast i32 (-> fields bytes)) (cast i32 (-> fields length)) (cast i32 answer) (cast i32 err)))

(define (browser-close [id u32]) (close (cast i32 id)))
