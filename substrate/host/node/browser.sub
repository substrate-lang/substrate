;; The host module "browser", which opens web sites in Chromium for tests. browser-open takes a site's directory, a URL
;; relative to the site's index.html, the Chromium file to use, a server function or 0, a directory to keep Chromium's
;; own files in, and more arguments for Chromium, separated by spaces. A server runs on a worker with the site's
;; directory as its argument and prints its address, and the browser opens the site through the server. browser-request
;; sends a request whose fields each end in a zero byte, and returns the answer.
(provide browser-open browser-request browser-close)

(import open "browser" "open" (i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 -> i32))
(import request "browser" "request" (i32 i32 i32 i32 i32 -> i32))
(import close "browser" "close" (i32 ->))

(define (browser-open [dir string] [url string] [chromium string] [server (fn ())] [files string] [args string]
                      [err (ptr string)]) -> u32
  (cast u32 (open (cast i32 (-> dir bytes)) (cast i32 (-> dir length)) (cast i32 (-> url bytes)) (cast i32 (-> url length))
                  (cast i32 (-> chromium bytes)) (cast i32 (-> chromium length)) (cast i32 server)
                  (cast i32 (-> files bytes)) (cast i32 (-> files length)) (cast i32 (-> args bytes))
                  (cast i32 (-> args length)) (cast i32 err))))

(define (browser-request [id u32] [fields string] [answer (ptr string)] [err (ptr string)]) -> i32
  (request (cast i32 id) (cast i32 (-> fields bytes)) (cast i32 (-> fields length)) (cast i32 answer) (cast i32 err)))

(define (browser-close [id u32]) (close (cast i32 id)))
