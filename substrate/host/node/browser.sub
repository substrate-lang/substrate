;; The host module "browser", which opens web sites in Chromium for tests. browser-open takes a site's directory, a URL
;; relative to the site's index.html, the Chromium file to use, a server program's directory or "", a directory to
;; keep Chromium's own files in, and more arguments for Chromium, separated by spaces. A server is started with the
;; site's directory and prints its address, and the site is opened through it. browser-request sends a request whose
;; fields each end in a zero byte, and gives the answer.
(provide browser-open browser-request browser-close browser-webgpu)

(import open "browser" "open" (i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 -> i32))
(import request "browser" "request" (i32 i32 i32 i32 i32 -> i32))
(import close "browser" "close" (i32 ->))
(import webgpu "browser" "webgpu" (i32 i32 i32 i32 i32 i32 i32 i32 -> i32))

(define (browser-open [dir string] [url string] [chromium string] [server string] [files string] [args string]
                      [err (ptr string)]) -> u32
  (cast u32 (open (cast i32 (-> dir bytes)) (cast i32 (-> dir length)) (cast i32 (-> url bytes)) (cast i32 (-> url length))
                  (cast i32 (-> chromium bytes)) (cast i32 (-> chromium length)) (cast i32 (-> server bytes))
                  (cast i32 (-> server length)) (cast i32 (-> files bytes)) (cast i32 (-> files length))
                  (cast i32 (-> args bytes)) (cast i32 (-> args length)) (cast i32 err))))

(define (browser-request [id u32] [fields string] [answer (ptr string)] [err (ptr string)]) -> i32
  (request (cast i32 id) (cast i32 (-> fields bytes)) (cast i32 (-> fields length)) (cast i32 answer) (cast i32 err)))

(define (browser-close [id u32]) (close (cast i32 id)))

;; browser-webgpu starts the Chromium at chromium as browser-open would, keeping its files in files, draws frames on a
;; WebGPU canvas and reads one back. It gives Chromium's version, then the WebGPU adapter it drew with, or an empty line
;; and why it could not.
(define (browser-webgpu [chromium string] [files string] [args string] [answer (ptr string)] [err (ptr string)]) -> i32
  (webgpu (cast i32 (-> chromium bytes)) (cast i32 (-> chromium length)) (cast i32 (-> files bytes)) (cast i32 (-> files length))
          (cast i32 (-> args bytes)) (cast i32 (-> args length)) (cast i32 answer) (cast i32 err)))
