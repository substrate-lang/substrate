;; Web sites opened in browsers for tests: the host module "browser". browser-open takes a site's directory, as
;; substrate site builds it, the URL to open, relative to the site's index.html, Chromium's file or "" for the simulated
;; browser, and a server program's directory or "". A server is given the site's directory and prints its address, and
;; the site is opened through it. browser-request sends a request, its fields each ended by a zero byte, and gives the
;; answer.
(provide browser-open browser-request browser-close)

(import open "browser" "open" (i32 i32 i32 i32 i32 i32 i32 i32 i32 -> i32))
(import request "browser" "request" (i32 i32 i32 i32 i32 -> i32))
(import close "browser" "close" (i32 ->))

(define (browser-open [dir string] [url string] [chromium string] [server string] [err (ptr string)]) -> u32
  (cast u32 (open (cast i32 (-> dir bytes)) (cast i32 (-> dir length)) (cast i32 (-> url bytes)) (cast i32 (-> url length))
                  (cast i32 (-> chromium bytes)) (cast i32 (-> chromium length)) (cast i32 (-> server bytes))
                  (cast i32 (-> server length)) (cast i32 err))))

(define (browser-request [id u32] [fields string] [answer (ptr string)] [err (ptr string)]) -> i32
  (request (cast i32 id) (cast i32 (-> fields bytes)) (cast i32 (-> fields length)) (cast i32 answer) (cast i32 err)))

(define (browser-close [id u32]) (close (cast i32 id)))
