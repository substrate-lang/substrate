;; Child programs: the host module "process", whose pipes are streams. process-spawn takes the arguments, and options,
;; or 0 for the defaults. The options' env strings, NAME=VALUE, are added to the parent's environment, or replace it
;; when clear is set. An exit event's value is the exit code, or 128 plus the signal. process-exec replaces this
;; program's process with another program, keeping its environment and standard streams; it returns only when that
;; fails. process-pid is the program's own process number.
(require-unqualified gr "../grants.sub")

(provide process-source process-exit process-failed process-pipe process-ignore process-inherit process-options
         process-options-init! process-spawn process-run process-exec process-exec-at-end process-restrict process-stdin process-stdout
         process-stderr process-kill process-pid)

(import spawn "process" "spawn" (i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 -> i32))
(import run "process" "run" (i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 -> i32))
(import exec "process" "exec" (i32 i32 i32 i32 i32 -> i32))
(import exec-at-end "process" "exec_at_end" (i32 i32 i32 i32 i32 -> i32))
(import restrict "process" "restrict" (i32 i32 i32 -> i32))
(import stdin "process" "stdin" (i32 -> i32))
(import stdout "process" "stdout" (i32 -> i32))
(import stderr "process" "stderr" (i32 -> i32))
(import kill "process" "kill" (i32 i32 ->))
(import pid "process" "pid" (-> i32))

(const process-source u32 10)
(const process-exit u32 1)
(const process-failed u32 2)
(const process-pipe i32 0)
(const process-ignore i32 1)
(const process-inherit i32 2)

(struct process-options [dir string] [env (slice string)] [clear bool] [stdin i32] [stdout i32] [stderr i32])

(define (process-options-init! [o (ptr process-options)])
  (set! (-> o dir) "")
  (set! (-> o env) 0)
  (set! (-> o clear) #f)
  (set! (-> o stdin) process-pipe)
  (set! (-> o stdout) process-pipe)
  (set! (-> o stderr) process-pipe))

(define (process-spawn [program string] [args (slice string)] [o (ptr process-options)] [tag (ptr void)]
                       [err (ptr string)]) -> u32
  (let ([defaults process-options] [p o] [a (make-buffer)] [e (make-buffer)] [id u32 0])
    (when (== p 0)
      (process-options-init! (& defaults))
      (set! p (& defaults)))
    (buffer-add-entries! (& a) args)
    (buffer-add-entries! (& e) (-> p env))
    (set! id (cast u32 (spawn (cast i32 (-> program bytes)) (cast i32 (-> program length)) (cast i32 (-> a bytes))
                              (cast i32 (-> a length)) (cast i32 (-> p dir bytes)) (cast i32 (-> p dir length))
                              (cast i32 (-> e bytes)) (cast i32 (-> e length)) (-> p clear) (-> p stdin) (-> p stdout)
                              (-> p stderr) (cast i32 tag) (cast i32 err))))
    (buffer-free! (& a))
    (buffer-free! (& e))
    id))

(define (process-run [program string] [args (slice string)] [o (ptr process-options)] [input (slice u8)] [timeout u32]
                     [output (ptr (slice u8))] [err (ptr string)]) -> i32
  (let ([defaults process-options] [p o] [a (make-buffer)] [e (make-buffer)] [code i32 0])
    (when (== p 0)
      (process-options-init! (& defaults))
      (set! p (& defaults)))
    (set! (@ output) (slice (cast (ptr u8) 0) 0))
    (buffer-add-entries! (& a) args)
    (buffer-add-entries! (& e) (-> p env))
    (set! code (run (cast i32 (-> program bytes)) (cast i32 (-> program length)) (cast i32 (-> a bytes)) (cast i32 (-> a length))
                    (cast i32 (-> p dir bytes)) (cast i32 (-> p dir length)) (cast i32 (-> e bytes)) (cast i32 (-> e length))
                    (-> p clear) (cast i32 (-> input items)) (cast i32 (-> input length)) (cast i32 timeout)
                    (cast i32 output) (cast i32 err)))
    (buffer-free! (& a))
    (buffer-free! (& e))
    code))

(define (process-exec [program string] [args (slice string)] [err (ptr string)]) -> i32
  (let ([a (make-buffer)] [r i32 0])
    (buffer-add-entries! (& a) args)
    (set! r (exec (cast i32 (-> program bytes)) (cast i32 (-> program length)) (cast i32 (-> a bytes)) (cast i32 (-> a length))
                  (cast i32 err)))
    (buffer-free! (& a))
    r))

(define (process-exec-at-end [program string] [args (slice string)] [err (ptr string)]) -> i32
  (let ([a (make-buffer)] [r i32 0])
    (buffer-add-entries! (& a) args)
    (set! r (exec-at-end (cast i32 (-> program bytes)) (cast i32 (-> program length)) (cast i32 (-> a bytes))
                         (cast i32 (-> a length)) (cast i32 err)))
    (buffer-free! (& a))
    r))

(define (process-restrict [g (ptr grants)] [err (ptr string)]) -> i32
  (let ([a (make-buffer)] [r i32 0])
    (grants-entries! (& a) g)
    (set! r (restrict (cast i32 (-> a bytes)) (cast i32 (-> a length)) (cast i32 err)))
    (buffer-free! (& a))
    r))

(define (process-stdin [id u32]) -> u32 (cast u32 (stdin (cast i32 id))))

(define (process-stdout [id u32]) -> u32 (cast u32 (stdout (cast i32 id))))

(define (process-stderr [id u32]) -> u32 (cast u32 (stderr (cast i32 id))))

(define (process-kill [id u32] [signal u32]) (kill (cast i32 id) (cast i32 signal)))

(define (process-pid) -> i32 (pid))
