;; Watching files: the host module "watch", after Deno's watchFs. watch-start watches the paths, and everything under
;; them unless the options' recursive is #f, stores the watch's number at id, and returns #t, or #f with the failure at
;; err. A changed event's value is watch-create, watch-modify or watch-remove, and its bytes are the absolute paths it
;; is about, as entries; a rename comes as a remove and a create. Changes under the options' ignore paths are left out.
;; A failed event ends the watch.
(provide watch-source watch-changed watch-failed watch-create watch-modify watch-remove watch-options
         watch-options-init! watch-start watch-stop)

(import start "watch" "start" (i32 i32 i32 i32 i32 i32 i32 -> i32))
(import stop "watch" "stop" (i32 ->))

(const watch-source u32 15)
(const watch-changed u32 1)
(const watch-failed u32 2)

(const watch-create i32 1)
(const watch-modify i32 2)
(const watch-remove i32 3)

(struct watch-options [recursive bool] [ignore (slice string)])

(define (watch-options-init! [o (ptr watch-options)])
  (set! (-> o recursive) #t)
  (set! (-> o ignore) 0))

(define (watch-start [paths (slice string)] [o (ptr watch-options)] [tag (ptr void)] [id (ptr u32)] [err (ptr error)])
  -> bool
  (let ([defaults watch-options] [p o] [watched (make-buffer)] [ignored (make-buffer)] [why string] [n u32 0])
    (when (== p 0)
      (watch-options-init! (& defaults))
      (set! p (& defaults)))
    (buffer-add-entries! (& watched) paths)
    (buffer-add-entries! (& ignored) (-> p ignore))
    (set! n (cast u32 (start (cast i32 (-> watched bytes)) (cast i32 (-> watched length)) (-> p recursive)
                             (cast i32 (-> ignored bytes)) (cast i32 (-> ignored length)) (cast i32 tag)
                             (cast i32 (& why)))))
    (buffer-free! (& watched))
    (buffer-free! (& ignored))
    (unless (== id 0) (set! (@ id) n))
    (or (!= n 0) (host-failed! (& why) err))))

(define (watch-stop [w u32]) (stop (cast i32 w)))
