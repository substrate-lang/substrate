;; Signals to the program: the host module "signal", after Deno's addSignalListener. signal-listen listens for the
;; signal named, such as "SIGINT" or "SIGTERM". While any listener is there, the signal no longer ends the program, and
;; a listener alone does not keep it running. A received event comes each time the signal arrives. SIGKILL, SIGSTOP,
;; SIGILL, SIGFPE and SIGSEGV cannot be listened for, and a worker has no signals.
(provide signal-source signal-received signal-listen signal-stop)

(import listen "signal" "listen" (i32 i32 i32 i32 -> i32))
(import stop "signal" "stop" (i32 ->))

(const signal-source u32 16)
(const signal-received u32 1)

(define (signal-listen [name string] [tag (ptr void)] [id (ptr u32)] [err (ptr error)]) -> bool
  (let ([why string] [n u32 0])
    (set! n (cast u32 (listen (cast i32 (-> name bytes)) (cast i32 (-> name length)) (cast i32 tag)
                              (cast i32 (& why)))))
    (unless (== id 0) (set! (@ id) n))
    (or (!= n 0) (host-failed! (& why) err))))

(define (signal-stop [id u32]) (stop (cast i32 id)))
