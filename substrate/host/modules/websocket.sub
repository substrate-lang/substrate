;; WebSocket clients: the host module "websocket". websocket-connect takes options, or 0 for the defaults: the
;; subprotocols to offer and the headers to send, each header's name followed by its value; a page cannot send headers.
;; It stores the socket's number at id, and returns #t, or #f with the failure at err.
;; An open event's bytes are the subprotocol the server chose, empty for none. A message event's value is
;; websocket-text or websocket-binary, which websocket-send also takes.
(provide websocket-source websocket-open websocket-message websocket-closed websocket-failed websocket-drained
         websocket-text websocket-binary websocket-options websocket-options-init! websocket-connect websocket-send
         websocket-send-text websocket-close)

(import connect "websocket" "connect" (i32 i32 i32 i32 i32 i32 i32 i32 -> i32))
(import send "websocket" "send" (i32 i32 i32 i32 -> i32))
(import close "websocket" "close" (i32 i32 ->))

(const websocket-source u32 7)
(const websocket-open u32 1)
(const websocket-message u32 2)
(const websocket-closed u32 3)
(const websocket-failed u32 4)
(const websocket-drained u32 5)
(const websocket-text i32 1)
(const websocket-binary i32 2)

(struct websocket-options [protocols (slice string)] [headers (slice string)])

(define (websocket-options-init! [o (ptr websocket-options)])
  (set! (-> o protocols) 0)
  (set! (-> o headers) 0))

(define (websocket-connect [url string] [o (ptr websocket-options)] [tag (ptr void)] [id (ptr u32)] [err (ptr error)])
  -> bool
  (let ([defaults websocket-options] [p o] [protocols (make-buffer)] [headers (make-buffer)] [why string])
    (when (== p 0)
      (websocket-options-init! (& defaults))
      (set! p (& defaults)))
    (buffer-add-entries! (& protocols) (-> p protocols))
    (buffer-add-entries! (& headers) (-> p headers))
    (set! (@ id) (cast u32 (connect (cast i32 (-> url bytes)) (cast i32 (-> url length)) (cast i32 (-> protocols bytes))
                                    (cast i32 (-> protocols length)) (cast i32 (-> headers bytes))
                                    (cast i32 (-> headers length)) (cast i32 tag) (cast i32 (& why)))))
    (buffer-free! (& protocols))
    (buffer-free! (& headers))
    (or (!= (@ id) 0) (host-failed! (& why) err))))

(define (websocket-send [id u32] [b (slice u8)] [kind i32]) -> i32
  (send (cast i32 id) (cast i32 (-> b items)) (cast i32 (-> b length)) kind))

(define (websocket-send-text [id u32] [s string]) -> i32 (websocket-send id (cast (slice u8) s) websocket-text))

(define (websocket-close [id u32] [code u32]) (close (cast i32 id) (cast i32 code)))
