;; The types of the shapes example, defined with struct.sub. The
;; program in ../shapes.sub constructs and matches them.
(require st "struct.sub" struct enum)
(provide point make-point point-x point-y
         shape circle square rect make-circle make-square make-rect circle?)

(struct point [x i32] [y i32])

;; circle and square have the same fields, so wasm cannot tell their types
;; apart at run time. Their brands can.
(enum shape
  (circle [r i32])
  (square [side i32])
  (rect [w i32] [h i32]))
