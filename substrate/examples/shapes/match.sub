;; Lifecycle: part of the shapes example (spec 7: to revisit with the typed
;; layer).
;;
;; match, over the compile-time values struct.sub defines:
;;
;;   (match e
;;     [(circle r) body ...]
;;     [(rect w _) body ...]
;;     [else body ...])
;;
;; e must have the type the clauses' variants belong to: their enum, or the
;; struct itself. The kernel's type checker checks this. A pattern names a
;; struct or variant and binds its fields in order; _ skips one. Without
;; else, the clauses must cover every variant. match's value is the value
;; of the clause that runs. _ is a binding this library provides, and so is
;; else, Substrate's, so a module requires them along with match; used
;; anywhere else they are errors.
;;
;; Compile-time errors: a pattern that names no struct or variant, the
;; wrong number of fields, variants of different types, a variant matched
;; twice, a missing variant, and else before the last clause.
;;
;; At run time, match reads the value's brand, compares it with each
;; clause's brand in turn, and casts to that variant to read its fields.

(require sub "../../lib/substrate.sub" else)
(provide match else _)

(begin-for-syntax
  (require k kernel)

  ;; The compile-time value of the struct or variant id names, as a list
  ;; (variant name type brand (field ...)), or #f.
  (func (variant-info [id eqref]) -> eqref
    (if (i32.eqz (k:identifier? id)) (return '#f))
    (let ([l (k:syntax->list (k:syntax-local-value id))])
      (if (ref.is_null l) (return '#f))
      (if (i32.ne (k:length l) 5) (return '#f))
      (if (ref.eq (k:syntax-e (k:car l)) 'variant) l '#f)))

  (func (info-name [info eqref]) -> eqref (k:cadr info))
  (func (info-type [info eqref]) -> eqref (k:caddr info))
  (func (info-brand [info eqref]) -> eqref (k:car (k:cdddr info)))
  (func (info-fields [info eqref]) -> eqref (k:syntax->list (k:cadr (k:cdddr info))))

  ;; The variants of type: an enum's variants, or the struct itself.
  (func (variants-of [type eqref]) -> eqref
    (let ([l (k:syntax->list (k:syntax-local-value type))])
      (if (ref.eq (k:syntax-e (k:car l)) 'enum)
          (k:syntax->list (k:caddr l))
          (k:cons (k:cadr l) '()))))

  (func (memq? [x eqref] [l eqref]) -> i32
    (if (k:null? l) (return 0))
    (if (ref.eq x (k:car l)) (return 1))
    (memq? x (k:cdr l)))

  ;; else and _ are compared by binding, not by name: a module requires
  ;; them with match.
  (func (else-clause? [clause eqref]) -> i32
    (let ([l (k:syntax->list clause)])
      (if (ref.is_null l) (return 0))
      (if (k:null? l) (return 0))
      (if (i32.eqz (k:identifier? (k:car l))) (return 0))
      (k:free-identifier=? (k:car l) #'else)))

  (func (wildcard? [id eqref]) -> i32 (k:free-identifier=? id #'_))

  ;; The pattern of a non-else clause, as a list (variant field ...),
  ;; checked, and the variant's compile-time value.
  (func (clause-pattern [clause eqref]) -> eqref
    (let ([l (k:syntax->list clause)])
      (if (i32.or (ref.is_null l) (k:null? l))
          (k:raise-syntax-error 'match '"expected a clause [(variant field ...) body ...]" clause))
      (if (i32.and (k:identifier? (k:car l)) (ref.eq (k:syntax-e (k:car l)) 'else))
          (k:raise-syntax-error 'match '"this else is not match's: require else from the match library" (k:car l)))
      (let ([p (k:syntax->list (k:car l))])
        (if (i32.or (ref.is_null p) (k:null? p))
            (k:raise-syntax-error 'match '"expected a pattern (variant field ...)" (k:car l)))
        p)))

  ;; Check each field pattern: a name or _.
  (func (check-field-patterns [ps eqref])
    (if (i32.eqz (k:null? ps))
        (begin
          (if (i32.eqz (k:identifier? (k:car ps)))
              (k:raise-syntax-error 'match '"a field pattern is a name or _" (k:car ps)))
          (check-field-patterns (k:cdr ps)))))

  ;; Check the clauses. type is the type of the first clause's variant.
  ;; Returns the compile-time values of the variants matched.
  (func (check-clauses [clauses eqref] [type eqref] [seen eqref]) -> eqref
    (if (k:null? clauses) (return seen))
    (if (else-clause? (k:car clauses))
        (begin
          (if (i32.eqz (k:null? (k:cdr clauses)))
              (k:raise-syntax-error 'match '"else must be the last clause" (k:car clauses)))
          (return seen)))
    (let* ([p (clause-pattern (k:car clauses))]
           [head (k:car p)]
           [info (variant-info head)])
      (if (ref.is_null info)
          (k:raise-syntax-error '#f '"does not name a struct or enum variant" head))
      (let ([v (k:syntax-local-value head)])
        (if (i32.eqz (ref.eq (k:syntax-local-value (info-type info)) (k:syntax-local-value type)))
            (k:raise-syntax-error '#f '"is not a variant of the same type as the first clause" head))
        (if (memq? v seen)
            (k:raise-syntax-error '#f '"is matched by an earlier clause" head))
        (if (i32.ne (k:length (k:cdr p)) (k:length (info-fields info)))
            (k:raise-syntax-error '#f '"wrong number of fields for this variant" (k:car (k:syntax->list (k:car clauses)))))
        (check-field-patterns (k:cdr p))
        (check-clauses (k:cdr clauses) type (k:cons v seen)))))

  ;; The variants in ids whose compile-time values are not in seen.
  (func (unmatched [ids eqref] [seen eqref]) -> eqref
    (if (k:null? ids) (return '()))
    (if (memq? (k:syntax-local-value (k:car ids)) seen)
        (unmatched (k:cdr ids) seen)
        (k:cons (k:car ids) (unmatched (k:cdr ids) seen))))

  ;; msg followed by the names of ids.
  (func (with-names [msg eqref] [ids eqref]) -> eqref
    (if (k:null? ids) (return msg))
    (with-names (k:string-append msg (k:string-append '" " (k:symbol->string (k:syntax-e (k:car ids)))))
                (k:cdr ids)))

  ;; [x (struct.get name field c)] for each field pattern x that is not _.
  (func (field-bindings [name eqref] [fields eqref] [ps eqref]) -> eqref
    (if (k:null? ps) (return '()))
    (let ([rest (field-bindings name (k:cdr fields) (k:cdr ps))])
      (if (wildcard? (k:car ps))
          rest
          (k:cons #`[#,(k:car ps) (struct.get #,name #,(k:car fields) c)] rest))))

  ;; The dispatch on brand b of subject v, one clause at a time.
  (func (dispatch [clauses eqref]) -> eqref
    (if (k:null? clauses) (return #'(unreachable)))
    (let ([c (k:syntax->list (k:car clauses))])
      (if (else-clause? (k:car clauses))
          (return #`(begin #,@(k:cdr c))))
      (let* ([p (k:syntax->list (k:car c))]
             [info (variant-info (k:car p))]
             [name (info-name info)]
             [bindings (field-bindings name (info-fields info) (k:cdr p))]
             [body (if (k:null? bindings)
                       #`(begin #,@(k:cdr c))
                       #`(let ([c (ref.cast (ref #,name) v)])
                           (let (#,@bindings) #,@(k:cdr c))))])
        #`(if (ref.eq b #,(info-brand info)) #,body #,(dispatch (k:cdr clauses))))))

  ;; (match e clause ...)
  (func (match [stx eqref]) -> eqref
    (let ([parts (k:syntax->list stx)])
      (if (i32.lt_u (k:length parts) 3)
          (k:raise-syntax-error '#f '"expected (match expr clause ...)" stx))
      (let ([clauses (k:cddr parts)])
        (if (else-clause? (k:car clauses))
            (k:raise-syntax-error 'match '"match needs a struct or variant clause before else" (k:car parts)))
        (let* ([head (k:car (clause-pattern (k:car clauses)))]
               [info (variant-info head)])
          (if (ref.is_null info)
              (k:raise-syntax-error '#f '"does not name a struct or enum variant" head))
          (let* ([type (info-type info)]
                 [seen (check-clauses clauses type '())])
            (if (i32.eqz (else-clause? (k:car (k:reverse clauses))))
                (let ([missing (unmatched (variants-of type) seen)])
                  (if (i32.eqz (k:null? missing))
                      (k:raise-syntax-error 'match (with-names '"missing variants:" missing) (k:car parts)))))
            #`(let ([v (ref #,type) #,(k:cadr parts)])
                (let ([b (struct.get #,type brand v)])
                  #,(dispatch clauses)))))))))

(define-syntax match match)

;; _ means something only in a match pattern.
(begin-for-syntax
  (func (pattern-keyword [stx eqref]) -> eqref
    (k:raise-syntax-error '#f '"not allowed as an expression" stx)
    (unreachable)))
(define-syntax _ pattern-keyword)
