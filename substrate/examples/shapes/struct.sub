;; Lifecycle: part of the shapes example (spec 7: to revisit with the typed
;; layer).
;;
;; Structs and enums, written with the kernel alone:
;;
;;   (struct point [x i32] [y i32])
;;   (enum shape (circle [r i32]) (rect [w i32] [h i32]))
;;
;; (struct point [x i32] [y i32]) defines
;;   point               a type: a point is a (ref point)
;;   (make-point x y)    the constructor, -> (ref point)
;;   (point-x p)         an accessor per field, taking a (ref point)
;;   (point? v)          1 if the eqref v is a point, else 0
;;   point               a compile-time value, for match (match.sub)
;;
;; (enum shape (circle [r i32]) ...) defines the type shape and a
;; compile-time value for it, and for each variant what struct defines. Each
;; variant's type is a subtype of shape, so a (ref circle) is a
;; (ref shape). Fields are immutable.
;;
;; Brands. Wasm tells types apart at run time by structure (spec 5.1), so
;; ref.test cannot tell (celsius [t i32]) from (fahrenheit [t i32]). So each
;; struct and variant has a brand: an object made when the defining module
;; is instantiated, held in an immutable global that only the generated code
;; can name. Every value holds its brand in its first field, and the
;; predicates, match and the accessors compare brands by identity. A brand
;; costs one field per value. It also holds its struct's name and field
;; names, for the accessors' errors.
;;
;; Accessors. The checker identifies types by structure too, so a
;; (ref celsius) parameter accepts a fahrenheit: each accessor checks the
;; brand, and stops with an error naming it, such as "celsius-t: expected a
;; celsius, got a fahrenheit". [revisit] With the typed layer (a rung after
;; bootstrap), revisit this library and match, and examples/shapes.sub with
;; them, so that such uses are compile-time errors.
;;
;; The compile-time value is a syntax object:
;;   (variant <name> <type> <brand> (<field> ...))
;;       for a struct or a variant. <name> is its type. <type> is what a
;;       match on it takes: the struct itself, or the variant's enum.
;;       <brand> is the global holding its brand.
;;   (enum <name> (<variant> ...))
;;       for an enum.

(provide struct enum)

;; A brand: an object compared by identity, with its struct's name and
;; field names as UTF-8 bytes.
(type name-bytes (array i8))
(type names (array (ref name-bytes)))
(type brand (struct (field name (ref name-bytes)) (field fields (ref names))))

;; Every struct and enum type is a subtype of branded.
(type branded (sub (struct (field brand (ref brand)))))

;; ---- accessor errors ----

(memory 1)
(import host-trap "host" "trap" (i32 i32 ->))
(data msg-expected 0 ": expected a ")
(data msg-got 16 ", got a ")

;; Copy the bytes of a to memory at address at; returns the address after.
(func (put-bytes [at i32] [a (ref name-bytes)]) -> i32
  (let ([i 0])
    (block done
      (loop next
        (br-if done (i32.ge_u i (array.len a)))
        (i32.store8 (i32.add at i) (array.get_u name-bytes a i))
        (set! i (i32.add i 1))
        (br next)))
    (i32.add at (array.len a))))

(func (put-data [at i32] [addr i32] [len i32]) -> i32
  (memory.copy at addr len)
  (i32.add at len))

;; The accessor for field index field of the struct with brand b was given
;; v, which has another brand: stop, naming the accessor and both structs.
;; The message is built from address 1024.
(func (wrong-struct [b (ref brand)] [field i32] [v (ref branded)])
  (let ([at (put-bytes 1024 (struct.get brand name b))])
    (i32.store8 at 45)
    (set! at (put-bytes (i32.add at 1) (array.get names (struct.get brand fields b) field)))
    (set! at (put-data at (data-address msg-expected) (data-size msg-expected)))
    (set! at (put-bytes at (struct.get brand name b)))
    (set! at (put-data at (data-address msg-got) (data-size msg-got)))
    (set! at (put-bytes at (struct.get brand name (struct.get branded brand v))))
    (host-trap 1024 (i32.sub at 1024))))

(begin-for-syntax
  (require k kernel)

  ;; name followed by suffix, with the scopes of name.
  (func (suffixed [name eqref] [suffix eqref]) -> eqref
    (k:datum->syntax name (k:symbol-append (k:syntax-e name) suffix) name))

  ;; prefix followed by name, with the scopes of name.
  (func (prefixed [prefix eqref] [name eqref]) -> eqref
    (k:datum->syntax name (k:symbol-append prefix (k:syntax-e name)) name))

  ;; An identifier with this library's scopes, so only the code this macro
  ;; use generates can refer to it (spec 6.2).
  (func (hidden [prefix eqref] [name eqref]) -> eqref
    (k:datum->syntax #'here (k:symbol-append prefix (k:syntax-e name)) name))

  ;; Is x a list of n or more elements whose first is an identifier?
  (func (headed-list? [x eqref] [n i32]) -> i32
    (let ([l (k:syntax->list x)])
      (if (ref.is_null l) (return 0))
      (if (i32.lt_u (k:length l) n) (return 0))
      (k:identifier? (k:car l))))

  ;; Check that each field is [name type].
  (func (check-fields [fields eqref] [who eqref])
    (if (i32.eqz (k:null? fields))
        (begin
          (if (i32.eqz (i32.and (headed-list? (k:car fields) 2)
                                (i32.eq (k:length (k:syntax->list (k:car fields))) 2)))
              (k:raise-syntax-error who '"expected a field [name type]" (k:car fields)))
          (check-fields (k:cdr fields) who))))

  ;; (field name type) for each field.
  (func (field-decls [fields eqref]) -> eqref
    (if (k:null? fields)
        '()
        (let ([f (k:syntax->list (k:car fields))])
          (k:cons #`(field #,(k:car f) #,(k:cadr f)) (field-decls (k:cdr fields))))))

  ;; The first element of each list.
  (func (heads [lists eqref]) -> eqref
    (if (k:null? lists)
        '()
        (k:cons (k:car (k:syntax->list (k:car lists))) (heads (k:cdr lists)))))

  (func (number [n i32]) -> eqref (k:datum->syntax #'here (k:fixnum n) '#f))

  ;; An identifier's name as UTF-8 bytes: (array.new_fixed name-bytes b ...).
  (func (name-array [id eqref]) -> eqref
    (let* ([str (k:symbol->string (k:syntax-e id))] [i (k:string-length str)] [bytes '()])
      (block done
        (loop next
          (br-if done (i32.eqz i))
          (set! i (i32.sub i 1))
          (set! bytes (k:cons (number (k:string-byte str i)) bytes))
          (br next)))
      #`(array.new_fixed name-bytes #,@bytes)))

  (func (name-arrays [ids eqref]) -> eqref
    (if (k:null? ids) '() (k:cons (name-array (k:car ids)) (name-arrays (k:cdr ids)))))

  ;; An accessor function for each field of type name, from index i, which
  ;; checks the value's brand.
  (func (accessors [name eqref] [brand eqref] [fields eqref] [i i32]) -> eqref
    (if (k:null? fields)
        '()
        (let* ([f (k:syntax->list (k:car fields))]
               [field (k:car f)])
          (k:cons #`(func (#,(suffixed (suffixed name '-) (k:syntax-e field)) [v (ref #,name)]) -> #,(k:cadr f)
                      (if (i32.eqz (ref.eq (struct.get #,name brand v) #,brand))
                          (wrong-struct #,brand #,(number i) v))
                      (struct.get #,name #,field v))
                  (accessors name brand (k:cdr fields) (i32.add i 1))))))

  ;; The definitions for one struct or variant, as a list: its brand, type,
  ;; constructor, accessors, predicate and compile-time value. super is
  ;; its supertype and type what a match on it takes; who, struct or enum,
  ;; names the form in errors.
  (func (variant-forms [name eqref] [super eqref] [type eqref] [brand eqref] [fields eqref] [who eqref]) -> eqref
    (check-fields fields who)
    (k:syntax->list
     #`((global #,brand (ref brand)
                (struct.new brand #,(name-array name) (array.new_fixed names #,@(name-arrays (heads fields)))))
        (type #,name (sub final #,super (struct (field brand (ref brand)) #,@(field-decls fields))))
        (func (#,(prefixed 'make- name) #,@fields) -> (ref #,name)
          (struct.new #,name #,brand #,@(heads fields)))
        #,@(accessors name brand fields 0)
        (func (#,(suffixed name '?) [v eqref]) -> i32
          (if (ref.test (ref #,name) v)
              (ref.eq (struct.get #,name brand (ref.cast (ref #,name) v)) #,brand)
              0))
        (define-syntax #,name (quote-syntax (variant #,name #,type #,brand (#,@(heads fields))))))))

  ;; (struct name [field type] ...)
  (func (struct [stx eqref]) -> eqref
    (if (i32.eqz (headed-list? (k:cdr (k:syntax->list stx)) 1))
        (k:raise-syntax-error '#f '"expected (struct name [field type] ...)" stx))
    (let ([name (k:cadr (k:syntax->list stx))])
      #`(begin #,@(variant-forms name #'branded name (hidden 'brand- name) (k:cddr (k:syntax->list stx)) 'struct))))

  ;; The forms for each variant of enum.
  (func (variants-forms [enum eqref] [variants eqref]) -> eqref
    (if (k:null? variants)
        '()
        (begin
          (if (i32.eqz (headed-list? (k:car variants) 1))
              (k:raise-syntax-error 'enum '"expected a variant (name [field type] ...)" (k:car variants)))
          (let ([v (k:syntax->list (k:car variants))])
            (k:append (variant-forms (k:car v) enum enum (hidden 'brand- (k:car v)) (k:cdr v) 'enum)
                      (variants-forms enum (k:cdr variants)))))))

  ;; (enum name (variant [field type] ...) ...)
  (func (enum [stx eqref]) -> eqref
    (let ([parts (k:syntax->list stx)])
      (if (i32.or (i32.lt_u (k:length parts) 3) (i32.eqz (headed-list? (k:cdr parts) 1)))
          (k:raise-syntax-error '#f '"expected (enum name (variant [field type] ...) ...)" stx))
      (let ([name (k:cadr parts)] [variants (k:cddr parts)])
        #`(begin
            (type #,name (sub branded (struct (field brand (ref brand)))))
            (define-syntax #,name (quote-syntax (enum #,name (#,@(heads variants)))))
            #,@(variants-forms name variants))))))

(define-syntax struct struct)
(define-syntax enum enum)
