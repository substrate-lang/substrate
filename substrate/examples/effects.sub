;; One effect, emit, passed as a hidden argument (examples/effects/emit.sub).
;; count-up emits 1..n. What an emit does is up to the handler around it:
;; add-up keeps a sum, tally counts, and tenfold also answers each emit
;; with ten times its value. The inner handle in main shadows the outer
;; one only for its own body. beeps, from another library, emits from its
;; own macro template, and the emits still reach the handler around them.
(require print "../lib/print.sub" write-int newline)
(require-unqualified fx "effects/emit.sub")
(require bp "effects/beeps.sub" beeps)

(define (count-up [i i32] [n i32])
  (if (i32.le_s i n)
      (begin (emit i) (count-up (i32.add i 1) n))))

;; The sum of what the handler answers for 1..n.
(define (answers [i i32] [n i32]) -> i32
  (if (i32.gt_s i n) 0 (i32.add (emit i) (answers (i32.add i 1) n))))

(func (add-up [ev (ref evidence)] [x i32]) -> i32 (type handler)
  (struct.set evidence state ev (i32.add (struct.get evidence state ev) x))
  x)

(func (tally [ev (ref evidence)] [x i32]) -> i32 (type handler)
  (struct.set evidence state ev (i32.add (struct.get evidence state ev) 1))
  x)

(func (tenfold [ev (ref evidence)] [x i32]) -> i32 (type handler)
  (i32.mul x 10))

(func (main)
  (write-int (handle add-up 0 (count-up 1 10))) (newline)
  (write-int (handle tally 0 (count-up 1 10))) (newline)
  (handle tenfold 0 (write-int (answers 1 10)) (newline))
  (write-int (handle add-up 0
               (count-up 1 3)
               (write-int (handle tally 0 (count-up 1 5))) (newline)
               (count-up 1 2)))
  (newline)
  (write-int (handle add-up 0 (beeps))) (newline))
