;; Effect handlers on Substrate (examples/effects/handlers.sub).
;; count-up performs emit for i..n; what each emit does is up to the
;; handler around it.
(require-unqualified fx "effects/handlers.sub")
(require e "effects/emit.sub" Emit emit)
(require b "effects/beeps.sub" beeps)

(effect Ask (ask))

(define (count-up i n)
  (when (<= i n)
    (emit i)
    (count-up (+ i 1) n)))

;; The sum of the handler's answers to emit for i..n.
(define (answers i n)
  (if (> i n) 0 (+ (emit i) (answers (+ i 1) n))))

(define (run)
  ;; A clause is a closure: this one adds to total.
  (let ([total 0])
    (with-handler (Emit [(emit x) (set! total (+ total x))])
      (count-up 1 10))
    (display total) (newline))
  ;; A clause's value is the operation's result.
  (display (with-handler (Emit [(emit x) (* x 10)])
             (answers 1 10)))
  (newline)
  ;; An inner handler handles only the operations of its own body.
  (let ([count 0])
    (with-handler (Emit [(emit x) (set! count (+ count 1))])
      (count-up 1 3)
      (with-handler (Emit [(emit x) #f])
        (count-up 1 100))
      (count-up 1 2))
    (display count) (newline))
  ;; A clause's own operations go to the handlers outside it.
  (display (with-handler (Ask [(ask) 7])
             (with-handler (Emit [(emit x) (* x (ask))])
               (answers 1 3))))
  (newline)
  ;; A lambda keeps the handlers of the code it is written in.
  (let ([total 0])
    (let ([f (with-handler (Emit [(emit x) (set! total (+ total x))])
               (lambda (x) (emit x)))])
      (with-handler (Emit [(emit x) #f])
        (f 5) (f 6)))
    (display total) (newline))
  ;; beeps calls beep, which performs emit, from its own macro template.
  (let ([total 0])
    (with-handler (Emit [(emit x) (set! total (+ total x))])
      (beeps))
    (display total) (newline)))

(func (main) (run))
