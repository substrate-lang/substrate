;; Lifecycle: example. A typed language on the kernel. Its #%linklet (spec
;; 6.5) checks its types and gives its closures types, in Substrate at
;; compile time. A module takes these forms with require-unqualified:
;;
;;   (define (f [x : A] ...) : R body ...)  a function of type (-> A ... R)
;;   (define #:forall (T ...) (f [x : A] ...) : R body ...)
;;                                           a generic, whose types may
;;                                           name its type parameters T ...
;;   (lambda ([x : A] ...) body ...)         a function value
;;   (f arg ...), (e arg ...)                applications: of a function
;;                                           define made, a direct call,
;;                                           or of a function value
;;   (inst f T ...)                          generic f at types T ...
;;   let, let*, if, begin, integers, #t, #f  as in the kernel
;;   + - * < = print                         functions on Int
;;
;; Types are Int, a 64-bit integer, Bool, and (-> A ... R), the functions
;; from A ... to R, written with their words, which are compared by name.
;; Every variable has a type: a parameter the one written, a variable let
;; binds its value's. A function define made is a value too. A call of a
;; generic takes its type parameters from its arguments' types; inst gives
;; them, and makes a generic's instance a value.
;;
;; How it works. The forms only bind. define and lambda keep each
;; parameter's type in a syntax property of its name, and define binds f to
;; a transformer that turns each use of f into the function, with f's type
;; in the same property: that is how a module that imports f knows its
;; type. The kernel types they must write, of parameters and results, come
;; from the types. #%linklet then checks each function define made, and
;; lowers its body: a lambda becomes a struct, of a closure type, holding
;; the values the lambda captures, and a module-level function, its code;
;; an application of a function value, a call-ref of the code in its
;; struct. A function type has one closure type, which each module that
;; uses it declares; wasm makes the declarations one type (spec 5.1).
;;
;; A generic is monomorphized. define binds its name to a transformer that
;; keeps its definition, and a use of it is a hole holding the generic
;; (spec 6.4). #%linklet, meeting a call of it or an inst, fills the hole
;; with its instance at those types, made once in each module that uses
;; it: it expands the generic's body as a lambda, with the type parameters
;; bound to the types, and lowers that as a function define made, lifting
;; what it defines, which binds it at once (6.5). So an instance is checked
;; at its types, and a generic nothing uses is not checked.

(require print "../../lib/print.sub" write-i64 newline)
(begin-for-syntax
  (require-unqualified substrate "../../lib/substrate.sub")
  (require k kernel))

(provide [define typed-define] [lambda typed-lambda] [inst typed-inst] [#%linklet typed-linklet] + - * < = print)

(begin-for-syntax
  ;; ---- types ----
  ;;
  ;; A type is the datum Int, Bool or (-> A ... R); in a generic's
  ;; signature, a type parameter too, the symbol that names it.

  ;; The syntax property holding the type of a parameter, or of a use of a
  ;; function define made.
  (define type-key 'typed-type)
  (define (with-type x t) (syntax-property x type-key t))
  (define (type-of-syntax x) (syntax-property x type-key))

  (define (function-type? t) (pair? t))
  (define (parameter-types t) (take (cdr t) (- (length t) 2)))
  (define (result-type t) (last t))

  ;; An error in an instance of a generic (below) names the instance.
  (define (type-error where form . args)
    (raise-syntax-error 'typed (string-append (apply format form args) (if instantiating (format ", in ~a" instantiating) ""))
                        where))

  ;; While a generic's signature is parsed, the names of its type
  ;; parameters; while one of its instances is expanded, each name's type,
  ;; as (name . type).
  (define type-parameters '())
  (define type-arguments '())

  (define (with-types parameters arguments thunk)
    (let ([p type-parameters] [a type-arguments])
      (dynamic-wind (lambda () (set! type-parameters parameters) (set! type-arguments arguments))
                    thunk
                    (lambda () (set! type-parameters p) (set! type-arguments a)))))

  ;; Type syntax s as a type.
  (define (parse-type s)
    (syntax-match s
      ['Int 'Int]
      ['Bool 'Bool]
      [('-> a ... r) `(-> ,@(map parse-type a) ,(parse-type r))]
      [(? identifier? v)
       (let ([bound (assq (syntax-e v) type-arguments)])
         (cond [bound (cdr bound)]
               [(memq (syntax-e v) type-parameters) (syntax-e v)]
               [else (type-error v "expected a type: Int, Bool, (-> type ... type) or a type parameter")]))]
      [_ (type-error s "expected a type: Int, Bool, (-> type ... type) or a type parameter")]))

  ;; Type t with each type parameter that s, an alist, binds replaced.
  (define (substitute t s)
    (cond [(pair? t) (cons '-> (map (lambda (x) (substitute x s)) (cdr t)))]
          [(assq t s) (cdr (assq t s))]
          [else t]))

  ;; s, an alist, extended so that pattern p, a type with type parameters,
  ;; is type t; #f if it cannot be.
  (define (unify p t s)
    (cond [(not s) #f]
          [(pair? p) (and (pair? t) (= (length p) (length t)) (unify-all (cdr p) (cdr t) s))]
          [(memq p '(Int Bool)) (and (eq? p t) s)]
          [(assq p s) (and (equal? (cdr (assq p s)) t) s)]
          [else (cons (cons p t) s)]))

  (define (unify-all ps ts s) (if (null? ps) s (unify-all (cdr ps) (cdr ts) (unify (car ps) (car ts) s))))

  ;; ---- kernel types ----
  ;;
  ;; Int is an i64 and Bool an i32. A function type is (ref C), C its
  ;; closure type: a struct whose field code is the function's code, of
  ;; type F, which takes the struct and the arguments. A lambda's struct
  ;; is of a subtype of C, with a field for each value it captures.

  (define (kernel-type t)
    (cond [(eq? t 'Int) #'i64]
          [(eq? t 'Bool) #'i32]
          [else #`(ref #,(car (closure-types t)))]))

  ;; The closure types declared in the module being compiled, as function
  ;; type -> (C . F), the names as the module sees them (spec 2.3).
  (define declared (make-hash))

  (define counter 0)
  (define (fresh base)
    (set! counter (+ counter 1))
    (datum->syntax #'here (string->symbol (format "~a~a" base counter))))

  ;; The closure and code types of function type t, as (C . F), as the
  ;; running macro or #%linklet sees them. The first use in a module
  ;; declares them, lifting the declaration, which binds their names at
  ;; once (spec 2.3, 6.5).
  (define (closure-types t)
    (let ([known (hash-ref declared t #f)])
      (if known
          (cons (k:syntax-local-introduce (car known)) (k:syntax-local-introduce (cdr known)))
          (let* ([params (map kernel-type (parameter-types t))]
                 [result (kernel-type (result-type t))]
                 [c (fresh 'closure)]
                 [f (fresh 'code)])
            (syntax-local-lift-definition #`(rec (type #,c (sub (struct (field code (ref #,f)))))
                                                 (type #,f (func ((ref #,c) #,@params -> #,result)))))
            (hash-set! declared t (cons (k:syntax-local-introduce c) (k:syntax-local-introduce f)))
            (cons c f)))))

  ;; ---- forms ----

  (define (named-after id suffix)
    (datum->syntax #'here (string->symbol (format "~a~a" (syntax-e id) suffix)) id))

  ;; (define (f [x : A] ...) : R body ...): the function, under a name of
  ;; this macro's that has its type; its value, a struct of its closure
  ;; type whose code calls it; and f, bound to the transformer.
  ;;
  ;; (define #:forall (T ...) (f [x : A] ...) : R body ...): a generic, whose
  ;; types may name T ...; f is bound to generic-transformer, which keeps
  ;; the definition to make its instances (below).
  (define (typed-define stx)
    (syntax-match stx
      [(_ #:forall ((? identifier? tv) ...) ((? identifier? name) ((? identifier? x) ': a) ...) ': r body ...)
       (for-each (lambda (v) (when (memq (syntax-e v) '(Int Bool)) (type-error v "~a is a type" (syntax-e v)))) tv)
       (with-types (map syntax-e tv) '() (lambda () (map parse-type a) (parse-type r)))
       #`(define-syntax #,name
           (generic-transformer
            (quote-syntax (#,name (#,@tv) (#,@(map (lambda (x a) #`[#,x #,a]) x a)) #,r (#,@body)))))]
      [(_ ((? identifier? name) ((? identifier? x) ': a) ...) ': r body ...)
       (let* ([t `(-> ,@(map parse-type a) ,(parse-type r))]
              [types (closure-types t)]
              [func (with-type (datum->syntax #'here (syntax-e name) name) t)]
              [value (named-after name ".value")]
              [code (named-after name ".code")]
              [params (map (lambda (x a) #`[#,(with-type x a) #,(kernel-type a)]) x (parameter-types t))]
              [result (kernel-type (result-type t))])
         #`(begin
             (func (#,func #,@params) #:value #,value -> #,result #,@body)
             (func (#,code [self (ref #,(car types))] #,@params) -> #,result (type #,(cdr types))
               (#,func #,@x))
             (global #,value (ref #,(car types)) (struct.new #,(car types) (ref.func #,code)))
             (define-syntax #,name (function-transformer (quote-syntax #,func) '#,(datum->syntax #'here t)))))]))

  ;; The transformer define binds f to: a use of f is func, the function,
  ;; with f's type t in its property; so is the head of an application.
  (define (function-transformer func t)
    (lambda (stx)
      (let ([f (with-type func t)])
        (syntax-match stx
          [(_ arg ...) #`(#%app #,f #,@arg)]
          [_ f]))))

  ;; The transformer a generic's name is bound to: a use of it is a hole,
  ;; (#%hole typed-generic g), which #%linklet fills with an instance of
  ;; the generic g, the syntax (f (T ...) ([x A] ...) R (body ...)) (spec
  ;; 6.4); so is the head of an application.
  (define (generic-transformer g)
    (lambda (stx)
      (let ([hole #`(#%hole typed-generic #,g)])
        (syntax-match stx
          [(_ arg ...) #`(#%app #,hole #,@arg)]
          [_ hole]))))

  ;; (inst f T ...): generic f's instance at types T ..., the hole of a use
  ;; of f with the types after the generic.
  (define (typed-inst stx)
    (syntax-match stx
      [(_ f t ...)
       (syntax-match (local-expand f)
         [('#%hole 'typed-generic g) #`(#%hole typed-generic #,g #,(datum->syntax #'here (map parse-type t)))]
         [_ (type-error f "~s is not a generic function" (syntax->datum f))])]))

  ;; (lambda ([x : A] ...) body ...): the kernel's lambda, whose parameters
  ;; have their types.
  (define (typed-lambda stx)
    (syntax-match stx
      [(_ (((? identifier? x) ': a) ...) body ...)
       (let ([types (map parse-type a)])
         #`(lambda (#,@(map (lambda (x t) #`[#,(with-type x t) #,(kernel-type t)]) x types)) #,@body))]))

  ;; ---- #%linklet ----
  ;;
  ;; Checking and lowering are one walk: lower gives an expression's type
  ;; and its code. env holds the variables in scope, each as (key binder .
  ;; type), key being its local binding (spec 2.3).

  ;; A module's forms, with each function define made checked and its body
  ;; lowered. The definitions lowering needs, it lifts.
  (define (typed-linklet stx)
    (syntax-match stx
      [(_ 'module form ...)
       (set! instances (make-hasheq))
       (map (lambda (f) (if (typed-function? f) (lower-function f) f)) form)]
      [(_ _ form ...) form]))

  ;; Is f a function define made, a func whose name has a type?
  (define (typed-function? f)
    (syntax-match f
      [('func (name . _) . _) (and (type-of-syntax name) #t)]
      [_ #f]))

  (define (lower-function f)
    (syntax-match f
      [(word (name (x kt) ...) #:value value '-> r body ...)
       (let* ([t (type-of-syntax name)]
              [b (lower-body f body (map variable x))])
         (unless (equal? (car b) (result-type t))
           (type-error (last body) "~a returns ~s, but its body is ~s" (syntax-e name) (result-type t) (car b)))
         (rebuild f #`(#,word (#,name #,@(map (lambda (x kt) #`[#,x #,kt]) x kt)) #:value #,value -> #,r #,@(cdr b))))]))

  ;; Parameter or let variable x, of the type in its property, for env.
  (define (variable x) (cons (k:local-binding x) (cons x (type-of-syntax x))))

  ;; code, a form in place of e, at e's location.
  (define (rebuild e code) (syntax-rewrap e (syntax-e code)))

  ;; A body, lowered: (type . forms), its type the last form's.
  (define (lower-body where forms env)
    (when (null? forms) (type-error where "expected a body"))
    (let ([rs (map (lambda (e) (lower e env)) forms)])
      (cons (car (last rs)) (map cdr rs))))

  ;; Expression e, checked and lowered: (type . code).
  (define (lower e env)
    (syntax-match e
      [('#%hole 'typed-generic g . given) (instance-value e g given)]
      [(? identifier? x) (cons (variable-type x env) x)]
      [('#%datum n) (literal e n)]
      [('let (binding ...) body ...) (lower-let e binding body env)]
      [('if test then otherwise)
       (let ([c (expect test 'Bool env)] [a (lower then env)] [b (lower otherwise env)])
         (unless (equal? (car a) (car b)) (type-error otherwise "expected ~s, got ~s" (car a) (car b)))
         (cons (car a) (rebuild e #`(if #,c #,(cdr a) #,(cdr b)))))]
      [('begin body ...)
       (let ([b (lower-body e body env)]) (cons (car b) (rebuild e #`(begin #,@(cdr b)))))]
      [('#%app ('#%hole 'typed-generic g . given) arg ...) (generic-call e g given arg env)]
      [('#%app f arg ...)
       (if (and (identifier? f) (eq? (identifier-binding-kind f) 'function))
           (direct-call e f arg env)
           (value-call e f arg env))]
      [('lambda ((x _) ...) body ...) (lower-lambda e x body env)]
      [_ (type-error e "this is not typed code")]))

  (define (expect e t env)
    (let ([r (lower e env)])
      (unless (equal? (car r) t) (type-error e "expected ~s, got ~s" t (car r)))
      (cdr r)))

  (define (variable-type x env)
    (let ([b (assv (k:local-binding x) env)])
      (if b (cddr b) (or (type-of-syntax x) (type-error x "~a has no type" (syntax-e x))))))

  (define (literal e n)
    (let ([d (syntax-e n)])
      (cond [(integer? d) (cons 'Int (rebuild e #`(i64.const #,n)))]
            [(boolean? d) (cons 'Bool e)]
            [else (type-error e "~s is not a literal of a type" d)])))

  (define (lower-let e bindings body env)
    (let* ([bs (map (lambda (b)
                      (syntax-match b
                        [(x init) (let ([r (lower init env)]) (list x (car r) (cdr r)))]
                        [_ (type-error b "this is not typed code")]))
                    bindings)]
           [inner (append (map (lambda (b) (cons (k:local-binding (car b)) (cons (car b) (cadr b)))) bs) env)]
           [r (lower-body e body inner)])
      (cons (car r)
            (rebuild e #`(let (#,@(map (lambda (b) #`[#,(car b) #,(kernel-type (cadr b)) #,(caddr b)]) bs))
                           #,@(cdr r))))))

  ;; The arguments args of e, a call of a function of type t, checked and
  ;; lowered.
  (define (arguments e t args env)
    (let ([ps (parameter-types t)])
      (unless (= (length ps) (length args))
        (type-error e "expected ~a argument~a, got ~a" (length ps) (if (= (length ps) 1) "" "s") (length args)))
      (map (lambda (a p) (expect a p env)) args ps)))

  ;; A call of f, a function define made: direct.
  (define (direct-call e f args env)
    (let ([t (or (type-of-syntax f) (type-error f "~a is not a typed function" (syntax-e f)))])
      (cons (result-type t) (rebuild e #`(#%app #,f #,@(arguments e t args env))))))

  ;; An application of a function value: a call-ref of the code in its
  ;; struct, given the struct.
  (define (value-call e f args env)
    (let ([r (lower f env)])
      (unless (function-type? (car r)) (type-error f "expected a function, got ~s" (car r)))
      (let ([types (closure-types (car r))] [lowered (arguments e (car r) args env)])
        (cons (result-type (car r))
              (rebuild e #`(let ([c #,(kernel-type (car r)) #,(cdr r)])
                             (call-ref #,(cdr types) (struct.get #,(car types) code c) c #,@lowered)))))))

  ;; A lambda: a struct of its closure type, or of a subtype of it with a
  ;; field for each variable the lambda captures, holding its code, a
  ;; module-level function, and their values. The code binds the captured
  ;; variables to the fields, with their binders, so the lambda's body
  ;; refers to them.
  (define (lower-lambda e xs body env)
    (let* ([vs (map variable xs)]
           [b (lower-body e body (append vs env))]
           [t `(-> ,@(map cddr vs) ,(car b))]
           [types (closure-types t)]
           [captured (captured-variables e env)]
           [code (fresh 'lambda)]
           [head #`(#,code [self (ref #,(car types))] #,@(map (lambda (v) #`[#,(cadr v) #,(kernel-type (cddr v))]) vs))]
           [result (kernel-type (car b))])
      (if (null? captured)
          (begin
            (syntax-local-lift-definition #`(func #,head -> #,result (type #,(cdr types)) #,@(cdr b)))
            (cons t (rebuild e #`(struct.new #,(car types) (ref.func #,code)))))
          (let ([closure (fresh 'closure)]
                [fields (map (lambda (v) (fresh 'v)) captured)])
            (syntax-local-lift-definition #`(type #,closure (sub final #,(car types)
                                         (struct (field code (ref #,(cdr types)))
                                                 #,@(map (lambda (v f) #`(field #,f #,(kernel-type (cddr v)))) captured fields)))))
            (syntax-local-lift-definition #`(func #,head -> #,result (type #,(cdr types))
                      (let ([env (ref.cast (ref #,closure) self)])
                        (let (#,@(map (lambda (v f) #`[#,(cadr v) #,(kernel-type (cddr v)) (struct.get #,closure #,f env)])
                                      captured fields))
                          #,@(cdr b)))))
            (cons t (rebuild e #`(struct.new #,closure (ref.func #,code) #,@(map cadr captured))))))))

  ;; The variables of env that e refers to, each once, in order.
  (define (captured-variables e env)
    (let ([seen (make-hasheqv)] [out '()])
      (let walk ([x e])
        (cond [(identifier? x)
               (let* ([key (k:local-binding x)] [v (and key (assv key env))])
                 (when (and v (not (hash-ref seen key #f)))
                   (hash-set! seen key #t)
                   (set! out (cons v out))))]
              [(syntax? x) (walk (syntax-e x))]
              [(pair? x) (walk (car x)) (walk (cdr x))]
              [else #f]))
      (reverse out)))

  ;; ---- generics ----
  ;;
  ;; A generic is monomorphized: each module that uses it at some types
  ;; gets an instance of it, a function of its own, made from the generic's
  ;; definition when #%linklet first meets the hole a use of it left. Its
  ;; body is checked there, at those types, as C++ checks a template's.

  ;; While #%linklet runs, the instances it made, by the generic's name:
  ;; name -> list of (id types . f), id the name as the generic wrote it,
  ;; compared by binding. While one is made, its name, as errors give it,
  ;; and the generics whose instances are being made, one inside another,
  ;; innermost first.
  (define instances #f)
  (define instantiating #f)
  (define making '())

  (define (generic-id g) (car (syntax-e g)))
  (define (generic-name g) (syntax-e (generic-id g)))

  ;; Generic g's type parameters, its parameters' types and its result
  ;; type, the type parameters in them: (T ... ) (A ...) R.
  (define (signature g)
    (syntax-match g
      [(_ (tv ...) ((_ a) ...) r _)
       (let ([tvs (map syntax-e tv)])
         (with-types tvs '() (lambda () (list tvs (map parse-type a) (parse-type r)))))]))

  ;; A call e of generic g, whose hole holds the types inst gave, if it
  ;; gave them: of its instance at the types that make its parameters'
  ;; types the arguments'. Errors show the call as it was written.
  (define (generic-call e g given args env)
    (let* ([sig (signature g)]
           [shown (syntax-rewrap e (cons (generic-id g) args))]
           [rs (map (lambda (a) (lower a env)) args)]
           [n (length (cadr sig))])
      (unless (= n (length args))
        (type-error shown "expected ~a argument~a, got ~a" n (if (= n 1) "" "s") (length args)))
      (let ([s (unify-all (cadr sig) (map car rs) (if (pair? given) (bindings shown g sig given) '()))])
        (unless s (type-error shown "~a takes ~s, not ~s" (generic-name g) (cadr sig) (map car rs)))
        (for-each (lambda (v)
                    (unless (assq v s)
                      (type-error shown "~a's type ~a is not known from its arguments: give it with inst" (generic-name g) v)))
                  (car sig))
        (cons (substitute (caddr sig) s)
              (rebuild e #`(#%app #,(instance g (map (lambda (v) (cdr (assq v s))) (car sig)) shown) #,@(map cdr rs)))))))

  ;; Generic g as a value, e: its instance, a function define made, at the
  ;; types inst gave.
  (define (instance-value e g given)
    (let ([sig (signature g)] [shown (syntax-rewrap e (generic-name g))])
      (unless (pair? given) (type-error shown "~a is generic: give its types with inst" (generic-name g)))
      (let ([s (bindings shown g sig given)])
        (cons `(-> ,@(map (lambda (p) (substitute p s)) (cadr sig)) ,(substitute (caddr sig) s))
              (instance g (map cdr s) shown)))))

  ;; The types inst gave generic g, the syntax (T ...), as its type
  ;; parameters'.
  (define (bindings where g sig given)
    (let ([ts (syntax->datum (car given))] [n (length (car sig))])
      (unless (= (length ts) n)
        (type-error where "~a takes ~a type~a, got ~a" (generic-name g) n (if (= n 1) "" "s") (length ts)))
      (map cons (car sig) ts)))

  ;; Generic g's instance at types ts: its function's name. The first time
  ;; this module asks for it, g's body is expanded as a lambda, its type
  ;; parameters bound to ts, and lowered as a function define made: the
  ;; name is known first, so the body can call it.
  (define (instance g ts where)
    (let ([known (findf (lambda (i) (and (equal? (cadr i) ts) (free-identifier=? (car i) (generic-id g))))
                        (hash-ref instances (generic-name g) '()))])
      (if known
          (cddr known)
          (syntax-match g
            [(name (tv ...) ((x a) ...) r (body ...))
             (let* ([listed (format "~s" ts)]
                    [label (format "~a<~a>" (syntax-e name) (substring/utf-8 listed 1 (- (string-utf-8-length listed) 1)))]
                    [f (fresh label)]
                    [outer instantiating])
               ;; Polymorphic recursion, an instance that needs one at larger
               ;; types, would make instances without end.
               (when (= (length making) 100)
                 (raise-syntax-error 'typed (format "~a needs instances at ever larger types: it cannot be monomorphized"
                                                    (recurring making))
                                     where))
               (hash-set! instances (syntax-e name) (cons (cons name (cons ts f)) (hash-ref instances (syntax-e name) '())))
               (dynamic-wind
                (lambda () (set! instantiating label) (set! making (cons (syntax-e name) making)))
                (lambda ()
                  (with-types '() (map cons (map syntax-e tv) ts)
                    (lambda ()
                      (add-function! f (local-expand #`(typed-lambda (#,@(map (lambda (x a) #`[#,x : #,a]) x a)) #,@body))
                                     (parse-type r)))))
                (lambda () (set! instantiating outer) (set! making (cdr making))))
               f)]))))

  ;; The name that most often recurs in names.
  (define (recurring names)
    (let ([count (lambda (n) (length (filter (lambda (m) (eq? m n)) names)))])
      (foldl (lambda (n best) (if (> (count n) (count best)) n best)) (car names) names)))

  ;; lam, a fully expanded lambda whose result type is result, as function
  ;; f with a value, as define makes them: the function, its code, and its
  ;; value, lifted.
  (define (add-function! f lam result)
    (syntax-match lam
      [(_ ((x k) ...) body ...)
       (let* ([b (lower-body lam body (map variable x))]
              [types (closure-types `(-> ,@(map type-of-syntax x) ,result))]
              [value (fresh 'value)]
              [code (fresh 'code)]
              [ys (map (lambda (x) (fresh 'y)) x)]
              [rk (kernel-type result)])
         (unless (equal? (car b) result)
           (type-error (last body) "~a returns ~s, but its body is ~s" (syntax-e f) result (car b)))
         (syntax-local-lift-definition
          #`(func (#,f #,@(map (lambda (x k) #`[#,x #,k]) x k)) #:value #,value -> #,rk #,@(cdr b)))
         (syntax-local-lift-definition
          #`(func (#,code [self (ref #,(car types))] #,@(map (lambda (y k) #`[#,y #,k]) ys k)) -> #,rk (type #,(cdr types))
              (#%app #,f #,@ys)))
         (syntax-local-lift-definition
          #`(global #,value (ref #,(car types)) (struct.new #,(car types) (ref.func #,code)))))])))

(define-syntax typed-define typed-define)
(define-syntax typed-lambda typed-lambda)
(define-syntax typed-inst typed-inst)
(define-syntax typed-linklet typed-linklet)

;; ---- functions on Int ----

(typed-define (+ [a : Int] [b : Int]) : Int (i64.add a b))
(typed-define (- [a : Int] [b : Int]) : Int (i64.sub a b))
(typed-define (* [a : Int] [b : Int]) : Int (i64.mul a b))
(typed-define (< [a : Int] [b : Int]) : Bool (i64.lt_s a b))
(typed-define (= [a : Int] [b : Int]) : Bool (i64.eq a b))
;; Write n on a line, and return it.
(typed-define (print [n : Int]) : Int (write-i64 n) (newline) n)
