;; Lifecycle: example. A typed language on the kernel, which checks its
;; types and gives its closures types, in Substrate at compile time. A
;; module takes these forms with require-unqualified:
;;
;;   (define (f [x : A] ...) : R body ...)  a function of type (-> A ... R)
;;   (define #:forall (tv ...) (f [x : A] ...) : R body ...)
;;                                           a generic, whose types may
;;                                           name its type parameters, each
;;                                           tv T, or (T trait ...) if T
;;                                           needs impls of the traits
;;   (lambda ([x : A] ...) body ...)         a function value
;;   (f arg ...), (e arg ...)                applications: of a function
;;                                           define made, a direct call,
;;                                           or of a function value
;;   (data (D T ...) [V A ...] ...)          a data type, with type
;;                                           parameters T ..., or (data D
;;                                           ...) with none; its values
;;                                           are made by its constructors
;;                                           V ..., each from values of
;;                                           types A ...
;;   (V arg ...), V                          a constructor, applied or alone
;;   (match e [(V x ...) body ...] ...)      the body of the clause for
;;                                           e's variant, its fields bound
;;                                           to x ...; a clause [V body
;;                                           ...] is for a variant with no
;;                                           fields, and [_ body ...] for any
;;   (trait (D T) [m : (-> A ... R)] ...)   a trait, whose methods m ...,
;;                                           of types that name T, impls
;;                                           give for a type; a clause
;;                                           (type N) is an associated
;;                                           type, which N means in them
;;   (impl (D A) [m (x ...) body ...] ...)  an impl of trait D for type A,
;;   (impl #:forall (tv ...) (D A) ...)      whose methods have their
;;                                           types at A, and a clause
;;                                           (type N B) gives N; A may name
;;                                           type parameters, as a
;;                                           generic's
;;   (m arg ...)                             a method, of the impl for the
;;                                           type its arguments give
;;   (inst f T ...)                          generic, constructor or method
;;                                           f at types T ...
;;   let, let*, if, begin, integers, #t, #f  as in the kernel
;;   + - * < = print                         functions on Int
;;
;; Types are Int, a 64-bit integer, Bool, and (-> A ... R), the functions
;; from A ... to R, written with their words, which are compared by name;
;; (D A ...), or D, data type D at types A ..., which may name D itself,
;; but only as a whole field's type, at its type parameters; and (N A),
;; associated type N of a trait for type A, which is the type A's impl
;; gives N, or, for a type parameter whose bounds give the trait, a type
;; of its own.
;; Every variable has a type: a parameter the one written, a variable let
;; binds its value's. A function define made is a value too. A call of a
;; generic takes its type parameters from its arguments' types; inst gives
;; them, and makes a generic's instance a value. A constructor takes its
;; data type's types from its arguments' types, or if they do not give
;; them, from the type its place expects, such as its function's result,
;; or a parameter's or field's type; inst gives them too. A match's
;; clauses cover the variants of its data type, and each can match. A
;; method takes its trait's type from its arguments' types, or if they do
;; not give it, from the type its place expects; inst gives it too. A
;; trait's impl is written in the file that defines the trait or its
;; type's data type, and a type has at most one impl of a trait. A generic
;; is checked where it is defined, its type parameters types of their own,
;; with the impls its bounds name; so its body can use a method on T only
;; if T's bounds give it, and a use of the generic needs the impls its
;; bounds name at the use's types.
;;
;; How it works. The forms only bind. define and lambda keep each
;; parameter's type in a syntax property of its name, and define binds f to
;; a transformer that turns each use of f into the function, with f's type
;; in the same property: that is how a module that imports f knows its
;; type. The kernel types they must write, of parameters and results, come
;; from the types. A function's body is one macro use, typed-body, which
;; the module's second pass expands, once every definition, macro and fact
;; of the module is declared (spec 5.2): it expands the body, checks it,
;; and lowers it: a lambda becomes the kernel's, of its type's kernel
;; types, so its value is a closure of that signature's closure type (spec
;; 5.3), and an application of a function value the kernel's.
;;
;; A generic is monomorphized. define binds its name to a transformer that
;; keeps its definition, and a use of it is a mark, quoted data holding the
;; generic, which the checker reads where the kernel would quote it.
;; Meeting a call of it or an inst, the checker replaces the mark with its
;; instance at those types, made once in each module that uses it: it
;; expands the generic's body as a lambda, with the type parameters bound
;; to the types, and lowers that as a function define made, lifting what
;; it defines, which binds it at once (6.4). Each generic the module
;; defines is checked once, in the second pass, as a function is, with its
;; type parameters abstract and its bounds given; checking is a walk of
;; its own, and lowering, which only instances need, another.
;;
;; A data type's value is a struct, of its variant's type, one of the
;; subtypes of a base, which each module that uses the data type at some
;; types declares. data binds D and each constructor to transformers
;; whose uses are marks holding the definition, as a generic's is: a type
;; names D, and takes the definition from its mark, which is not a value.
;; The checker replaces a constructor's with the struct, of the type at
;; the types it finds; and a match, whose mark holds the clauses'
;; variants, with a test of the subject's struct type for each.
;; A data type holds its definition, so a module that meets it only in a
;; signature, as in another module's generic's, can declare it; its
;; definition names the file that defines it.
;;
;; A trait binds its name and methods as data does, and an impl is a fact
;; about its trait (spec 6.5), holding its syntax, which the second pass
;; checks. The checker replaces a method's mark with a call of the
;; method's instance for the impl whose type is the type the call has: it
;; finds that impl among the facts about the trait, checks the impls its
;; bounds need, and makes the instance from the impl's function as it
;; makes a generic's. So a method is a direct call. Every module that can
;; name a trait and a type sees the facts of the files that define them,
;; which is why an impl is written in one of those: all modules find the
;; same impl. A projection, (N A), is found the same way, and types are
;; compared once their projections are reduced to the types their impls
;; give (normalize). A type is a datum, so a projection holds its trait's
;; name, which leads back to the trait in any module that can meet the
;; type (spec 6.6).

(require print "../../lib/print.sub" write-i64 newline)
(begin-for-syntax
  (require-unqualified substrate "../../lib/substrate.sub")
  (require k kernel))

(provide [define typed-define] [lambda typed-lambda] [inst typed-inst] [data typed-data] [match typed-match]
         [trait typed-trait] [impl typed-impl] + - * < = print)

(begin-for-syntax
  ;; ---- types ----
  ;;
  ;; A type is the datum Int, Bool, (-> A ... R), or (data D A ...), the
  ;; data type that definition D (below) makes at types A ...; in a
  ;; generic's signature, a type parameter too, the symbol that names it;
  ;; while a generic's body is checked, (param T), its type parameter T,
  ;; which is a type of its own; and (assoc D N A), associated type N of
  ;; the trait D names (spec 6.6) for type A, a projection, which normalize
  ;; reduces to the type the impl for A gives N. A data definition is (name (T ...) ((V
  ;; A ...) ...) file): its type parameters; its variants, each a
  ;; constructor's name and its fields' types, which may name T ... and,
  ;; as (self A ...), the data type being defined; and the file that
  ;; defines it, so that two data types are two, whatever their shapes.
  ;; So a type holds what it needs, and a module can lay out a data type
  ;; it only met in another module's signature.

  ;; The syntax property holding the type of a parameter, or of a use of a
  ;; function define made.
  (define type-key 'typed-type)
  (define (with-type x t) (syntax-property x type-key t))
  (define (type-of-syntax x) (syntax-property x type-key))

  (define (function-type? t) (and (pair? t) (eq? (car t) '->)))
  (define (parameter-types t) (take (cdr t) (- (length t) 2)))
  (define (result-type t) (last t))

  (define (data-type? t) (and (pair? t) (eq? (car t) 'data)))
  (define (data-definition t) (cadr t))
  (define (data-arguments t) (cddr t))
  (define (variants d) (caddr d))

  (define (param? t) (and (pair? t) (eq? (car t) 'param)))

  (define (assoc? t) (and (pair? t) (eq? (car t) 'assoc)))
  (define (assoc-trait t) (cadr t))
  (define (assoc-name t) (caddr t))
  (define (assoc-type t) (cadddr t))

  ;; In a trait's own methods' types, (self-assoc N) is its associated type
  ;; N for its type parameter (method-type).
  (define (self-assoc? t) (and (pair? t) (eq? (car t) 'self-assoc)))

  ;; Type t as it is written, for messages: (List Int), not its datum.
  (define (shown t)
    (cond [(function-type? t) (cons '-> (map shown (cdr t)))]
          [(data-type? t)
           (let ([name (car (data-definition t))])
             (if (null? (data-arguments t)) name (cons name (map shown (data-arguments t)))))]
          [(param? t) (cadr t)]
          [(assoc? t) (list (assoc-name t) (shown (assoc-type t)))]
          [(self-assoc? t) (cadr t)]
          [else t]))

  (define (type-error where form . args)
    (raise-syntax-error 'typed (apply format form args) where))

  ;; While a generic's signature is parsed, the names of its type
  ;; parameters; while one of its instances is expanded, each name's type,
  ;; as (name . type).
  (define type-parameters '())
  (define type-arguments '())

  (define (with-types parameters arguments thunk)
    (let ([p type-parameters] [a type-arguments])
      (dynamic-wind (lambda () (set! type-parameters parameters) (set! type-arguments arguments))
                    thunk
                    (lambda () (set! type-parameters p) (set! type-arguments a)))))

  ;; While a data definition is parsed, its name and its type parameters,
  ;; for the types of its fields that name it; while a trait's methods'
  ;; types are, its associated types' names.
  (define defining #f)
  (define parsing-assocs '())

  ;; Type syntax s as a type.
  (define (parse-type s)
    (syntax-match s
      [('quote t) (syntax->datum t)]           ; a type as its datum, which the forms write
      ['Int 'Int]
      ['Bool 'Bool]
      [('-> a ... r) `(-> ,@(map parse-type a) ,(parse-type r))]
      [((? identifier? d) a ...) (type-application d (map parse-type a) s)]
      [(? identifier? v)
       (let ([bound (assq (syntax-e v) type-arguments)])
         (cond [bound (cdr bound)]
               [(memq (syntax-e v) type-parameters) (syntax-e v)]
               [(memq (syntax-e v) parsing-assocs) (list 'self-assoc (syntax-e v))]
               [else (type-application v '() s)]))]
      [_ (not-a-type s)]))

  (define (not-a-type s)
    (type-error s "expected a type: Int, Bool, (-> type ... type), a data type or a type parameter"))

  ;; d applied to types ts, where being the whole: a data type, (data D t
  ;; ...) with D the definition in the mark a use of d is, or (self t ...)
  ;; in d's own definition; or, if d is associated type N of trait def, the
  ;; projection (assoc def N t).
  (define (type-application d ts where)
    (let ([mark (and (not (and defining (eq? (syntax-e d) (car defining))))
                     (eq? (identifier-binding-kind d) 'macro)
                     (local-expand d))])
      (syntax-match mark
        [('quote ('typed-assoc tr def n))
         (unless (= (length ts) 1) (type-error where "~a takes 1 type, not ~a" (syntax-e d) (length ts)))
         (list 'assoc (k:identifier-name tr) (syntax->datum n) (car ts))]
        [_ (let ([definition
                  (cond [(and defining (eq? (syntax-e d) (car defining))) defining]
                        [mark (syntax-match mark
                                [('quote ('typed-data definition)) (syntax->datum definition)]
                                [_ (type-error d "~a is not a type" (syntax-e d))])]
                        [(or (memq (syntax-e d) '(Int Bool)) (memq (syntax-e d) type-parameters) (assq (syntax-e d) type-arguments))
                         (type-error where "~a takes no types" (syntax-e d))]
                        [else (type-error d "~a is not a type" (syntax-e d))])])
             (unless (= (length ts) (length (cadr definition)))
               (type-error where "~a takes ~a type~a, not ~a" (car definition) (length (cadr definition))
                           (if (= (length (cadr definition)) 1) "" "s") (length ts)))
             (if (eq? definition defining) (cons 'self ts) (cons 'data (cons definition ts))))])))

  ;; Type t with each type parameter that s, an alist, binds replaced, and
  ;; within data definition d, each (self A ...) the data type it names.
  (define (substitute t s . d)
    (let ([sub (lambda (x) (apply substitute x s d))])
      (cond [(function-type? t) (cons '-> (map sub (cdr t)))]
            [(data-type? t) (cons 'data (cons (data-definition t) (map sub (data-arguments t))))]
            [(and (pair? t) (eq? (car t) 'self)) (cons 'data (cons (car d) (map sub (cdr t))))]
            [(assoc? t) (list 'assoc (assoc-trait t) (assoc-name t) (sub (assoc-type t)))]
            [(assq t s) (cdr (assq t s))]
            [else t])))

  ;; s, an alist, extended so that pattern p, a type with type parameters,
  ;; is type t; #f if it cannot be. A projection in p says nothing of its
  ;; type, so it is passed over, and checked once s is known (check-inferring).
  (define (unify p t s)
    (cond [(not s) #f]
          [(assoc? p) s]
          [(function-type? p) (and (function-type? t) (= (length p) (length t)) (unify-all (cdr p) (cdr t) s))]
          [(data-type? p) (and (data-type? t) (equal? (data-definition p) (data-definition t))
                               (unify-all (data-arguments p) (data-arguments t) s))]
          [(or (memq p '(Int Bool)) (param? p)) (and (equal? p t) s)]
          [(assq p s) (and (equal? (cdr (assq p s)) t) s)]
          [(symbol? p) (cons (cons p t) s)]
          [else #f]))

  ;; Does type t name no type parameter of a signature?
  (define (concrete? t)
    (cond [(function-type? t) (andmap concrete? (cdr t))]
          [(data-type? t) (andmap concrete? (data-arguments t))]
          [(assoc? t) (concrete? (assoc-type t))]
          [else (or (memq t '(Int Bool)) (param? t))]))

  ;; Does type t name a projection?
  (define (names-assoc? t)
    (cond [(function-type? t) (ormap names-assoc? (cdr t))]
          [(data-type? t) (ormap names-assoc? (data-arguments t))]
          [else (assoc? t)]))

  ;; Does type t name v, a type parameter of a signature, or (param T)?
  (define (names? t v)
    (cond [(function-type? t) (ormap (lambda (x) (names? x v)) (cdr t))]
          [(data-type? t) (ormap (lambda (x) (names? x v)) (data-arguments t))]
          [(assoc? t) (names? (assoc-type t) v)]
          [else (equal? t v)]))

  (define (unify-all ps ts s) (if (null? ps) s (unify-all (cdr ps) (cdr ts) (unify (car ps) (car ts) s))))

  ;; ---- kernel types ----
  ;;
  ;; Int is an i64 and Bool an i32. A function type is the kernel's closure
  ;; type of its signature at those types (spec 5.3). A data type is (ref
  ;; B), B its base: a struct with no fields, whose subtypes are its
  ;; variants' structs.

  (define (kernel-type t)
    (cond [(eq? t 'Int) #'i64]
          [(eq? t 'Bool) #'i32]
          [(data-type? t) #`(ref #,(car (data-types t)))]
          [else #`(ref (closure (#,@(map kernel-type (parameter-types t)) -> #,(kernel-type (result-type t)))))]))

  ;; The data types declared in the module being compiled, the names as
  ;; the module sees them (spec 2.3): data type -> (B V ...).
  (define declared (make-hash))

  (define counter 0)
  (define (fresh base)
    (set! counter (+ counter 1))
    (datum->syntax #'here (string->symbol (format "~a~a" base counter))))

  ;; The types of data type t, as (B V ...), as the running macro sees
  ;; them: B its base, and V ... its variants' structs, final
  ;; subtypes of B with a field for each of the variant's, f0 ..., all in
  ;; one recursion group, so that two variants with the same fields are two
  ;; types (spec 5.2). The first use in a module declares them, lifting the
  ;; declaration; they are known first, so a field can be of type t. No
  ;; other type of a field names t (field-type): its types would be of
  ;; another group, which would name this one.
  (define (data-types t)
    (let ([known (hash-ref declared t #f)])
      (if known
          (map (lambda (x) (k:syntax-local-introduce x)) known)
          (let* ([label (type-label t)]
                 [b (fresh label)]
                 [vs (map (lambda (v) (fresh (format "~a.~a" label (car v)))) (variants (data-definition t)))])
            (hash-set! declared t (map (lambda (x) (k:syntax-local-introduce x)) (cons b vs)))
            (syntax-local-lift-definition
             #`(rec (type #,b (sub (struct)))
                    #,@(map (lambda (v i)
                              #`(type #,v (sub final #,b (struct #,@(map (lambda (ft k) #`(field #,(field-name k) #,(kernel-type ft)))
                                                                        (field-types t i) (range (length (field-types t i))))))))
                            vs (range (length vs)))))
            (cons b vs)))))

  (define (field-name k) (datum->syntax #'here (string->symbol (format "f~a" k))))

  ;; The types of the fields of data type t's variant i: its definition's,
  ;; at t's types.
  (define (field-types t i)
    (let ([d (data-definition t)])
      (map (lambda (ft) (substitute ft (map cons (cadr d) (data-arguments t)) d)) (cdr (list-ref (variants d) i)))))

  ;; A name for a type's declarations: List<Int>, Shape.
  (define (type-label t)
    (let ([s (shown t)])
      (if (pair? s) (format "~a<~a>" (car s) (types-text (cdr s))) (format "~a" s))))

  ;; Types ts written, with spaces between them: Int (List Int).
  (define (types-text ts) (joined (map (lambda (t) (format "~s" (shown t))) ts) " "))

  ;; The elements of list xs written, sep between them.
  (define (joined xs sep)
    (if (null? xs) "" (foldl (lambda (x acc) (string-append acc sep (format "~a" x))) (format "~a" (car xs)) (cdr xs))))

  ;; ---- forms ----

  (define (named-after id suffix)
    (datum->syntax #'here (string->symbol (format "~a~a" (syntax-e id) suffix)) id))

  (define (type-parameters! tv)
    (for-each (lambda (v) (when (memq (syntax-e v) '(Int Bool)) (type-error v "~a is a type" (syntax-e v)))) tv))

  ;; The type parameters #:forall gives, each T or (T trait ...): their
  ;; names, and their bounds, each (T trait).
  (define (type-variables tv)
    (let ([parts (map (lambda (v)
                        (syntax-match v
                          [(? identifier? t) (list t)]
                          [((? identifier? t) (? identifier? tr) ...) (for-each trait-of tr) (cons t tr)]
                          [_ (type-error v "expected a type parameter: T, or (T trait ...)")]))
                      tv)])
      (type-parameters! (map car parts))
      (cons (map car parts)
            (apply append (map (lambda (p) (map (lambda (tr) #`(#,(car p) #,tr)) (cdr p))) parts)))))

  ;; form, as a module-level form of the module's second pass, which
  ;; expands it once every definition, macro and fact of the module is
  ;; declared (spec 5.2): a let's contents wait for it.
  (define (second-pass form) #`(let () #,form))

  ;; (define (f [x : A] ...) : R body ...): the function, whose body
  ;; typed-body checks and lowers in the second pass, its value and f,
  ;; bound to the transformer (define-function).
  ;;
  ;; (define #:forall (tv ...) (f [x : A] ...) : R body ...): a generic,
  ;; each tv a type parameter T or (T trait ...), whose types may name them
  ;; and which needs impls of the traits given for them. f is bound to
  ;; generic-transformer, which keeps the definition to make its instances
  ;; (below), and the second pass checks its body (generic-check).
  (define (typed-define stx)
    (syntax-match stx
      [(_ #:forall (tv ...) ((? identifier? name) ((? identifier? x) ': a) ...) ': r body ...)
       (when (null? body) (type-error stx "expected a body"))
       (let* ([ps (type-variables tv)]
              [g #`(#,name (#,@(car ps)) (#,@(cdr ps)) (#,@(map (lambda (x a) #`[#,x #,a]) x a)) #,r (#,@body))])
         (with-types (map syntax-e (car ps)) '() (lambda () (map parse-type a) (parse-type r)))
         #`(begin
             (define-syntax #,name (generic-transformer (quote-syntax #,g)))
             #,(second-pass #`(generic-check #,g))))]
      [(_ ((? identifier? name) ((? identifier? x) ': a) ...) ': r body ...)
       (when (null? body) (type-error stx "expected a body"))
       (define-function stx name x a r
         (lambda (xs t) #`((typed-body #,name (#,@xs) #,(datum->syntax #'here (result-type t)) #,@body))))]))

  ;; (kernel-define (f [x : A] ...) : R body ...): as define, but the body
  ;; is kernel code, which nothing checks; for the functions on Int below.
  (define (kernel-define stx)
    (syntax-match stx
      [(_ ((? identifier? name) ((? identifier? x) ': a) ...) ': r body ...)
       (define-function stx name x a r (lambda (xs t) body))]))

  ;; The forms of the function name define makes, of parameters x ... of
  ;; types a ... and result type r, whose body is (body-of xs t), xs the
  ;; parameters with their types in their properties and t the function's
  ;; type: the function, under a name of this macro's that has its type;
  ;; its value, a struct of its closure type whose code calls it; and
  ;; name, bound to the transformer.
  (define (define-function stx name x a r body-of)
    (let* ([t (normalize `(-> ,@(map parse-type a) ,(parse-type r)) stx)]
           [func (with-type (datum->syntax #'here (syntax-e name) name) t)]
           [value (named-after name ".value")]
           [xs (map with-type x (parameter-types t))]
           [params (map (lambda (x a) #`[#,x #,(kernel-type a)]) xs (parameter-types t))]
           [result (kernel-type (result-type t))])
      #`(begin
          #,(located stx #`(func (#,func #,@params) #:value #,value -> #,result #,@(body-of xs t)))
          (global #,value #,(kernel-type t) (lambda (#,@params) -> #,result (#,func #,@x)))
          (define-syntax #,name (function-transformer (quote-syntax #,func) '#,(datum->syntax #'here t))))))

  ;; The transformer define binds f to: a use of f is func, the function,
  ;; with f's type t in its property; so is the head of an application.
  (define (function-transformer func t)
    (transformer (stx)
      (let ([f (with-type func t)])
        (syntax-match stx
          [(_ arg ...) #`(#%app #,f #,@arg)]
          [_ f]))))

  ;; The transformer a generic's name is bound to: a use of it is the mark
  ;; '(typed-generic g), which the checker replaces with an instance of the
  ;; generic g, the syntax (f (T ...) ((T trait) ...) ([x A] ...) R (body
  ;; ...)).
  (define (generic-transformer g) (mark-transformer #`'(typed-generic #,g)))

  ;; A transformer whose use is mark, and so is the head of an
  ;; application: quoted data, which the checker reads where the kernel
  ;; would quote it, so a mark can hold syntax and data alike.
  (define (mark-transformer mark)
    (transformer (stx)
      (syntax-match stx
        [(_ arg ...) #`(#%app #,mark #,@arg)]
        [_ mark])))

  ;; (inst f T ...): generic f's instance at types T ..., constructor f's
  ;; data type's, or method f's trait's: the mark of a use of f, with the
  ;; types after what it holds.
  (define (typed-inst stx)
    (syntax-match stx
      [(_ f t ...)
       (let ([ts (datum->syntax #'here (map parse-type t))])
         (syntax-match (local-expand f)
           [('quote ('typed-generic g)) #`'(typed-generic #,g #,ts)]
           [('quote ('typed-constructor d i)) #`'(typed-constructor #,d #,i #,ts)]
           [('quote ('typed-method tr d i)) #`'(typed-method #,tr #,d #,i #,ts)]
           [_ (type-error f "~s is not a generic function, a constructor or a method" (syntax->datum f))]))]))

  ;; (data (D T ...) [V A ...] ...), or (data D [V A ...] ...) with no type
  ;; parameters: a data type, whose values its constructors V ... make, each
  ;; from values of the types A ..., which may name T ... and D. D is bound
  ;; to data-transformer, and each V to constructor-transformer.
  (define (typed-data stx)
    (syntax-match stx
      [(_ head variant ...)
       (let* ([parts (syntax-match head
                       [((? identifier? d) (? identifier? tv) ...) (cons d tv)]
                       [(? identifier? d) (list d)]
                       [_ (type-error head "expected (name type-parameter ...) or name")])]
              [name (car parts)]
              [tvs (begin (type-parameters! (cdr parts)) (map syntax-e (cdr parts)))]
              [vs (map (lambda (v)
                         (syntax-match v
                           [((? identifier? c) a ...) (cons c a)]
                           [(? identifier? c) (list c)]
                           [_ (type-error v "expected [constructor type ...]")]))
                       variant)]
              [definition
               (let ([outer defining])
                 (dynamic-wind
                  (lambda () (set! defining (list (syntax-e name) tvs)))
                  (lambda ()
                    (with-types tvs '()
                      (lambda ()
                        (list (syntax-e name) tvs
                              (map (lambda (v) (cons (syntax-e (car v)) (map (lambda (a) (field-type a name tvs)) (cdr v)))) vs)
                              (k:syntax-source stx)))))
                  (lambda () (set! defining outer))))]
              [d (datum->syntax #'here definition)])
         #`(begin
             (define-syntax #,name (data-transformer '#,d))
             #,@(map (lambda (v i) #`(define-syntax #,(car v) (constructor-transformer '#,d #,(datum->syntax #'here i)))) vs (range (length vs)))))]))

  ;; Field type a of data type name, whose type parameters are tvs, as a
  ;; type. It names the data type only as the whole type, at tvs: so the
  ;; data type's structs are one recursion group, of finitely many types
  ;; (data-types).
  (define (field-type a name tvs)
    (let ([t (parse-type a)])
      (when (names-assoc? t) (type-error a "a field's type cannot name an associated type"))
      (let check ([u t] [whole? #t])
        (cond [(and (pair? u) (eq? (car u) 'self))
               (unless (and whole? (equal? (cdr u) tvs))
                 (type-error a "~a's fields can name it only as their type, ~s"
                             (syntax-e name) (if (null? tvs) (syntax-e name) (cons (syntax-e name) tvs))))]
              [(function-type? u) (for-each (lambda (x) (check x #f)) (cdr u))]
              [(data-type? u) (for-each (lambda (x) (check x #f)) (data-arguments u))]))
      t))

  ;; The transformer a data type's name, of definition d, is bound to: a use
  ;; of it is the mark '(typed-data d), which a type holds, and which is
  ;; not a value.
  (define (data-transformer d) (mark-transformer #`'(typed-data #,(datum->syntax #'here d))))

  ;; The transformer a constructor, variant i of data definition d, is
  ;; bound to: a use of it is the mark '(typed-constructor d i), which the
  ;; checker replaces with the struct it makes.
  (define (constructor-transformer d i)
    (mark-transformer #`'(typed-constructor #,(datum->syntax #'here d) #,(datum->syntax #'here i))))

  ;; (match e [pattern body ...] ...): the body of the first clause whose
  ;; pattern e's value matches. A pattern is (V x ...), a constructor and a
  ;; variable for each of its fields, V alone for one with none, or _; a
  ;; variable _ is none. The constructors are of one data type, whose
  ;; variants the clauses cover, and each clause can match. Its code is
  ;; (#%app '(typed-match d (i ...)) e (lambda ([x eqref] ...) body ...)
  ;; ...), i each clause's variant, or #f for _: the checker makes it tests
  ;; of e's variant, and a lambda only binds the clause's variables, whose
  ;; types it knows then, so their kernel types are eqref, which nothing
  ;; compiles.
  (define (typed-match stx)
    (syntax-match stx
      [(_ subject clause ...)
       (when (null? clause) (type-error stx "expected a clause [pattern body ...]"))
       (let* ([cs (map match-clause clause)]
              [ds (filter (lambda (d) d) (map cadddr cs))]
              [d (and (pair? ds) (car ds))])
         (for-each (lambda (c)
                     (unless (or (not (cadddr c)) (equal? (cadddr c) d))
                       (type-error (list-ref c 4) "~a is a constructor of ~a, not of ~a"
                                   (syntax-e (list-ref c 4)) (car (cadddr c)) (car d))))
                   cs)
         (covered! stx d cs)
         #`(#%app '(typed-match #,(datum->syntax #'here d) #,(datum->syntax #'here (map car cs)))
                  #,subject
                  #,@(map (lambda (c) #`(lambda (#,@(map (lambda (x) #`[#,x eqref]) (cadr c))) #,@(caddr c))) cs)))]))

  ;; A clause [pattern body ...] of match, as (i xs body d p): its variant
  ;; i of data definition d, or #f and #f for _; its variables; its body;
  ;; and its constructor, or _.
  (define (match-clause c)
    (syntax-match c
      [(p body0 body ...)
       (syntax-match p
         ['_ (list #f '() (cons body0 body) #f p)]
         [((? identifier? v) x ...) (constructor-clause v x (cons body0 body) p)]
         [(? identifier? v) (constructor-clause v '() (cons body0 body) p)]
         [_ (type-error p "expected a pattern: (constructor variable ...), constructor or _")])]
      [_ (type-error c "expected a clause [pattern body ...]")]))

  (define (constructor-clause v xs body p)
    (syntax-match (local-expand v)
      [('quote ('typed-constructor d i))
       (let* ([d (syntax->datum d)] [i (syntax->datum i)] [n (length (cdr (list-ref (variants d) i)))])
         (unless (= n (length xs))
           (type-error p "~a has ~a field~a, not ~a" (syntax-e v) n (if (= n 1) "" "s") (length xs)))
         (for-each (lambda (x) (unless (identifier? x) (type-error x "expected a variable"))) xs)
         (list i (map (lambda (x) (if (eq? (syntax-e x) '_) (fresh 'ignored) x)) xs) body d v))]
      [_ (type-error v "~a is not a constructor" (syntax-e v))]))

  ;; Check that clauses cs of match stx cover data definition d's variants,
  ;; and that each can match: a clause for variant i one of those left, and
  ;; _ while any is. With no d, every clause is _, and one is left for it.
  (define (covered! stx d cs)
    (let loop ([cs cs] [left (if d (range (length (variants d))) '(#f))])
      (if (null? cs)
          (unless (null? left)
            (type-error stx "this match does not cover ~a" (joined (map (lambda (i) (car (list-ref (variants d) i))) left) ", ")))
          (let ([i (car (car cs))])
            (unless (if i (memv i left) (pair? left))
              (type-error (list-ref (car cs) 4) "this clause can never match"))
            (loop (cdr cs) (if i (filter (lambda (j) (not (eqv? j i))) left) '()))))))

  ;; (lambda ([x : A] ...) body ...): the kernel's lambda, whose parameters
  ;; have their types. Their kernel types are eqref, which nothing
  ;; compiles: lowering a lambda makes its own, and a type parameter's has
  ;; none.
  (define (typed-lambda stx)
    (syntax-match stx
      [(_ (((? identifier? x) ': a) ...) body ...)
       (let ([types (map parse-type a)])
         #`(lambda (#,@(map (lambda (x t) #`[#,(with-type x t) eqref]) x types)) #,@body))]))

  ;; ---- traits ----
  ;;
  ;; A trait is (name T ((m type) ...) file (N ...)): its type parameter;
  ;; its methods, each a name and a function type that names T, and may
  ;; name its associated types N ... as (self-assoc N); the file that
  ;; defines it; and its associated types' names. An impl of it for a type
  ;; is a fact about it (spec 6.5), with the syntax (impl (T ...) ((T
  ;; trait) ...) type ((m (x ...) body ...) ...) ((N type) ...)): its type
  ;; parameters, the traits they need, its type, which names them, a
  ;; function for each method, and a type for each associated type. A use
  ;; of a method, or a projection, finds the impl for its type among the
  ;; facts about its trait. An impl is written in the file that defines
  ;; its trait or its type's data type, so every module that can name both
  ;; sees it, and each type has one impl of a trait: all modules agree on
  ;; which.

  (define (trait-name def) (car def))
  (define (trait-parameter def) (cadr def))
  (define (trait-methods def) (caddr def))
  (define (trait-file def) (cadddr def))
  (define (trait-types def) (list-ref def 4))

  ;; The type of method i of trait def, which trait names, its associated
  ;; types N as (N T), T its type parameter.
  (define (method-type def i trait)
    (let loop ([t (cadr (list-ref (trait-methods def) i))])
      (cond [(self-assoc? t) (list 'assoc trait (cadr t) (trait-parameter def))]
            [(function-type? t) (cons '-> (map loop (cdr t)))]
            [(data-type? t) (cons 'data (cons (data-definition t) (map loop (data-arguments t))))]
            [else t])))

  ;; The trait identifier id names.
  (define (trait-of id)
    (syntax-match (if (eq? (identifier-binding-kind id) 'macro) (local-expand id) id)
      [('quote ('typed-trait def)) (syntax->datum def)]
      [_ (type-error id "~a is not a trait" (syntax-e id))]))

  ;; The trait name names, as (identifier . definition): a projection holds
  ;; its trait's name, which leads back to it (spec 6.6).
  (define traits-by-name (make-hasheq))
  (define (trait-named name)
    (or (hash-ref traits-by-name name #f)
        (let* ([id (k:name-identifier name)] [t (cons id (trait-of id))])
          (hash-set! traits-by-name name t)
          t)))

  ;; (trait (D T) clause ...), each clause (type N), an associated type, or
  ;; [m : type], a method: a trait, whose impls give, for a type, a type
  ;; for each N and a function m of the type given at that type, where N
  ;; means (N T). D is bound to trait-transformer, each N to
  ;; assoc-transformer and each m to method-transformer.
  (define (typed-trait stx)
    (syntax-match stx
      [(_ ((? identifier? name) (? identifier? tv)) clause ...)
       (type-parameters! (list tv))
       (let* ([ns (apply append (map (lambda (c) (syntax-match c [('type (? identifier? n)) (list n)] [_ '()])) clause))]
              [ms (apply append (map (lambda (c)
                                       (syntax-match c
                                         [('type (? identifier? _)) '()]
                                         [((? identifier? m) ': t) (list (cons m t))]
                                         [_ (type-error c "expected (type name) or [method : type]")]))
                                     clause))]
              [types (with-types (list (syntax-e tv)) '()
                       (lambda ()
                         (let ([saved parsing-assocs])
                           (dynamic-wind (lambda () (set! parsing-assocs (map syntax-e ns)))
                                         (lambda () (map (lambda (m) (parse-type (cdr m))) ms))
                                         (lambda () (set! parsing-assocs saved))))))]
              [def (list (syntax-e name) (syntax-e tv) (map (lambda (m t) (list (syntax-e (car m)) t)) ms types)
                         (k:syntax-source stx) (map syntax-e ns))]
              [d (datum->syntax #'here def)])
         (for-each (lambda (m t)
                     (unless (and (function-type? t) (names? t (syntax-e tv)))
                       (type-error (cdr m) "~a's type must be a function type that names ~a" (syntax-e (car m)) (syntax-e tv)))
                     (when (names-assoc? t)
                       (type-error (cdr m) "~a's type can name only ~a's associated types" (syntax-e (car m)) (syntax-e name))))
                   ms types)
         #`(begin
             (define-syntax #,name (trait-transformer '#,d))
             #,@(map (lambda (n) #`(define-syntax #,n (assoc-transformer (quote-syntax #,name) '#,d '#,n))) ns)
             #,@(map (lambda (m i) #`(define-syntax #,(car m) (method-transformer (quote-syntax #,name) '#,d #,(datum->syntax #'here i))))
                     ms (range (length ms)))))]
      [_ (type-error stx "expected (trait (name T) clause ...)")]))

  ;; The transformer associated type n of trait def, which trait names, is
  ;; bound to: a use of it is the mark '(typed-assoc trait def n), which a
  ;; type takes the projection from, and which is not a value.
  (define (assoc-transformer trait def n)
    (mark-transformer #`'(typed-assoc #,trait #,(datum->syntax #'here def) #,(datum->syntax #'here n))))

  ;; The transformer a trait's name, of definition def, is bound to: a use
  ;; of it is the mark '(typed-trait def), which bounds and impls take the
  ;; trait from, and which is not a value.
  (define (trait-transformer def) (mark-transformer #`'(typed-trait #,(datum->syntax #'here def))))

  ;; The transformer method i of trait def, which trait names, is bound
  ;; to: a use of it is the mark '(typed-method trait def i), which the
  ;; checker replaces with the method of the impl for the type it finds.
  (define (method-transformer trait def i)
    (mark-transformer #`'(typed-method #,trait #,(datum->syntax #'here def) #,(datum->syntax #'here i))))

  ;; (impl (Tr type) clause ...), or (impl #:forall (tv ...) (Tr type)
  ;; clause ...), each tv T or (T trait ...), and each clause (type N A) or
  ;; [m (x ...) body ...]: an impl of trait Tr for type, which names its
  ;; type parameters, which need impls of the traits given; for each of
  ;; Tr's associated types N, a type A, and for each of its methods, a
  ;; function of the method's type at type. It is a fact about Tr, which
  ;; the second pass checks (impl-check).
  (define (typed-impl stx)
    (syntax-match stx
      [(_ #:forall (tv ...) (tr type) clause ...) (impl-fact stx tv tr type clause)]
      [(_ ((? identifier? tr) type) clause ...) (impl-fact stx '() tr type clause)]
      [_ (type-error stx "expected (impl (trait type) clause ...)")]))

  (define (impl-fact stx tv tr type clauses)
    (let* ([def (trait-of tr)]
           [ps (type-variables tv)]
           [t (with-types (map syntax-e (car ps)) '() (lambda () (parse-type type)))]
           [written (constraint def t)]
           [head (and (data-type? t) (cadddr (data-definition t)))]
           [types (filter (lambda (c) (syntax-match c [('type (? identifier? _) _) #t] [_ #f])) clauses)]
           [methods (filter (lambda (c) (not (memq c types))) clauses)])
      (when (names-assoc? t) (type-error type "an impl's type cannot name an associated type"))
      (for-each (lambda (v) (unless (names? t (syntax-e v)) (type-error v "~a is not in the impl's type" (syntax-e v)))) (car ps))
      (unless (or (equal? (k:syntax-source stx) (trait-file def)) (and head (equal? (k:syntax-source stx) head)))
        (type-error stx "the impl ~a must be in the file that defines ~a~a" written (trait-name def)
                    (if head (format " or ~a" (car (data-definition t))) "")))
      (let loop ([ms methods] [seen '()])
        (unless (null? ms)
          (syntax-match (car ms)
            [((? identifier? n) ((? identifier? x) ...) body0 body ...)
             (let ([m (assq (syntax-e n) (trait-methods def))])
               (unless m (type-error n "~a is not a method of ~a" (syntax-e n) (trait-name def)))
               (when (memq (syntax-e n) seen) (type-error n "~a is given twice" (syntax-e n)))
               (unless (= (length x) (length (parameter-types (cadr m))))
                 (type-error (car ms) "~a takes ~a argument~a" (syntax-e n) (length (parameter-types (cadr m)))
                             (if (= (length (parameter-types (cadr m))) 1) "" "s")))
               (loop (cdr ms) (cons (syntax-e n) seen)))]
            [_ (type-error (car ms) "expected [method (x ...) body ...]")])))
      (for-each (lambda (m)
                  (unless (ormap (lambda (g) (eq? (syntax-e (car (syntax-e g))) (car m))) methods)
                    (type-error stx "the impl ~a has no ~a" written (car m))))
                (trait-methods def))
      (let loop ([cs types] [seen '()])
        (unless (null? cs)
          (syntax-match (car cs)
            [(_ n a)
             (unless (memq (syntax-e n) (trait-types def))
               (type-error n "~a is not an associated type of ~a" (syntax-e n) (trait-name def)))
             (when (memq (syntax-e n) seen) (type-error n "~a is given twice" (syntax-e n)))
             (with-types (map syntax-e (car ps)) '() (lambda () (parse-type a)))
             (loop (cdr cs) (cons (syntax-e n) seen))])))
      (for-each (lambda (n)
                  (unless (ormap (lambda (c) (eq? (syntax-e (cadr (syntax-e c))) n)) types)
                    (type-error stx "the impl ~a has no type ~a" written n)))
                (trait-types def))
      (let ([impl (datum->syntax #'here (list 'impl (car ps) (cdr ps) type methods (map (lambda (c) (cdr (syntax-e c))) types)) stx)])
        #`(begin (#%fact #,tr #'#,impl) #,(second-pass #`(impl-check #,impl #,tr))))))

  ;; Trait def at type t, written: (Eq (List Int)).
  (define (constraint def t) (format "~s" (list (trait-name def) (shown t))))

  ;; ---- bodies ----
  ;;
  ;; Two walks over each body. check gives each expression's type and
  ;; elaborates it: it makes every decision the expression's code depends
  ;; on, and reports every error. lower makes the code of what check
  ;; elaborated, lifting the definitions the code needs; it decides
  ;; nothing, so it cannot fail. An elaborated expression is (type kind e
  ;; part ...), e the expression. env holds the variables in scope, each as
  ;; (key binder . type), key being its local binding (spec 2.3).

  ;; The tables of the second pass, made when it starts: the impls of each
  ;; trait, and the instances made, are then kept, since every impl of the
  ;; module is a fact by then; a macro of the first pass keeps neither.
  (define (second-pass!)
    (unless instances
      (set! instances (make-hasheq))
      (set! method-instances (make-hasheq))
      (set! impl-table (make-hash))
      (set! resolved (make-hash))))

  ;; (typed-body f (x ...) R body ...), the body of function f define
  ;; made, whose parameters x ... have their types in their properties and
  ;; whose result type is R: the body, expanded, checked and lowered. It is
  ;; the function's body, so the second pass expands it (spec 5.2).
  (define (typed-body stx)
    (syntax-match stx
      [(_ name (x ...) r body ...)
       (second-pass!)
       (let ([b (check-function stx name (map local-expand body)
                                (map (lambda (x) (variable (local-expand x))) x) (syntax->datum r))])
         #`(begin #,@(map lower b)))]))

  ;; (generic-check g): check generic g, which this module defines, in the
  ;; second pass; nothing is left.
  (define (generic-check stx)
    (syntax-match stx [(_ g) (second-pass!) (check-generic! g) #'(begin)]))

  ;; (impl-check impl trait): check impl, which this module defines, of
  ;; the trait trait names, in the second pass; nothing is left.
  (define (impl-check stx)
    (syntax-match stx [(_ impl tr) (second-pass!) (check-impl! impl tr) #'(begin)]))

  ;; The body of function name, the form where, whose parameters are the
  ;; variables env and whose result type is result, checked.
  (define (check-function where name body env result)
    (let* ([result (normalize result where)] [b (check-body where body env result)])
      (unless (equal? (body-type b) result)
        (type-error (last body) "~a returns ~s, but its body is ~s" (syntax-e name) (shown result) (shown (body-type b))))
      b))

  ;; Parameter or let variable x, of the type in its property, for env.
  (define (variable x) (cons (k:local-binding x) (cons x (normalize (type-of-syntax x) x))))

  ;; code, a form in place of e, at e's location.
  (define (rebuild e code) (syntax-rewrap e (syntax-e code)))

  ;; A definition made from where, at its location rather than this file's.
  (define (located where form) (datum->syntax form (syntax-e form) where))

  ;; An elaborated expression, and its parts.
  (define (node t kind e . parts) (cons t (cons kind (cons e parts))))
  (define (node-e n) (caddr n))
  (define (node-parts n) (cdddr n))

  ;; A body, checked: its forms elaborated, its type the last one's. hint,
  ;; the type its place expects, if it is known, is the last form's (check).
  (define (check-body where forms env . hint)
    (when (null? forms) (type-error where "expected a body"))
    (append (map (lambda (e) (check e env)) (take forms (- (length forms) 1)))
            (list (apply check (last forms) env hint))))

  (define (body-type b) (car (last b)))

  ;; Expression e, checked: its elaboration. A mark, quoted data, is what
  ;; a transformer of this module's expanded a use of a name to
  ;; (mark-transformer). hint, the type e's place
  ;; expects, if it is known, is passed on to the places whose value is
  ;; e's, so that a constructor there that cannot find its data type's
  ;; types in its arguments takes them from it; it is a hint, which the
  ;; place still checks.
  (define (check e env . hint)
    (let ([t (and (pair? hint) (car hint))])
      (syntax-match e
        [('quote ('typed-generic g . given)) (check-generic-value e g given)]
        [('quote ('typed-constructor d i . given)) (check-constructor e d i given '() env t)]
        [('quote ('typed-data d)) (type-error e "~a is a data type, not a value" (car (syntax->datum d)))]
        [('quote ('typed-trait d)) (type-error e "~a is a trait, not a value" (car (syntax->datum d)))]
        [('quote ('typed-assoc _ _ n)) (type-error e "~a is a type, not a value" (syntax->datum n))]
        [('quote ('typed-method tr d i . given)) (check-method-value e tr d i given)]
        [(? identifier? x) (node (variable-type x env) 'code e x)]
        [('#%datum n) (check-literal e n)]
        [('let (binding ...) body ...) (check-let e binding body env t)]
        [('if test then otherwise)
         (let* ([c (expect test 'Bool env)] [a (check then env t)] [b (check otherwise env (or t (car a)))])
           (unless (equal? (car a) (car b)) (type-error otherwise "expected ~s, got ~s" (shown (car a)) (shown (car b))))
           (node (car a) 'if e c a b))]
        [('begin body ...)
         (let ([b (check-body e body env t)]) (node (body-type b) 'begin e b))]
        [('#%app ('quote ('typed-generic g . given)) arg ...) (check-generic-call e g given arg env)]
        [('#%app ('quote ('typed-constructor d i . given)) arg ...) (check-constructor e d i given arg env t)]
        [('#%app ('quote ('typed-match d is)) subject clause ...) (check-match e d is subject clause env t)]
        [('#%app ('quote ('typed-method tr d i . given)) arg ...) (check-method-call e tr d i given arg env t)]
        [('#%app f arg ...)
         (if (and (identifier? f) (eq? (identifier-binding-kind f) 'function))
             (check-direct-call e f arg env)
             (check-value-call e f arg env))]
        [('lambda ((x _) ...) body ...) (check-lambda e x body env)]
        [((? identifier? h) . _) (type-error e "~a is not a form of the typed language" (syntax-e h))]
        [_ (type-error e "this is not typed code")])))

  ;; The code of n, an elaborated expression.
  (define (lower n)
    (let ([e (node-e n)] [p (node-parts n)])
      (case (cadr n)
        [(code) (car p)]
        [(if) (let* ([c (lower (car p))] [a (lower (cadr p))] [b (lower (caddr p))]) (rebuild e #`(if #,c #,a #,b)))]
        [(begin) (rebuild e #`(begin #,@(map lower (car p))))]
        [(let) (lower-let e (car p) (cadr p))]
        [(direct) (rebuild e #`(#%app #,(car p) #,@(map lower (cadr p))))]
        [(value-call) (lower-value-call e (car p) (cadr p))]
        [(lambda) (lower-lambda e (car p) (cadr p))]
        [(construct) (lower-constructor e (car n) (car p) (cadr p) (caddr p))]
        [(match) (lower-match e (car p) (cadr p) (caddr p))]
        [(generic-call) (let ([codes (map lower (caddr p))]) (rebuild e #`(#%app #,(instance (car p) (cadr p) (cadddr p)) #,@codes)))]
        [(generic-value) (instance (car p) (cadr p) (caddr p))]
        [(method-call) (let ([codes (map lower (caddr p))]) (rebuild e #`(#%app #,(method-instance (car p) (cadr p) (cadddr p)) #,@codes)))]
        [(method-value) (method-instance (car p) (cadr p) (caddr p))])))

  (define (expect e t env)
    (let ([r (check e env t)])
      (unless (equal? (car r) t) (type-error e "expected ~s, got ~s" (shown t) (shown (car r))))
      r))

  (define (variable-type x env)
    (let ([b (assv (k:local-binding x) env)])
      (if b (cddr b) (normalize (or (type-of-syntax x) (type-error x "~a has no type" (syntax-e x))) x))))

  (define (check-literal e n)
    (let ([d (syntax-e n)])
      (cond [(integer? d) (node 'Int 'code e (rebuild e #`(i64.const #,n)))]
            [(boolean? d) (node 'Bool 'code e e)]
            [else (type-error e "~s is not a literal of a type" d)])))

  ;; A let: its bindings, each (x init), init elaborated, and its body.
  (define (check-let e bindings body env t)
    (let* ([bs (map (lambda (b)
                      (syntax-match b
                        [(x init) (list x (check init env))]
                        [_ (type-error b "this is not typed code")]))
                    bindings)]
           [inner (append (map (lambda (b) (cons (k:local-binding (car b)) (cons (car b) (car (cadr b))))) bs) env)]
           [b (check-body e body inner t)])
      (node (body-type b) 'let e bs b)))

  (define (lower-let e bs body)
    (let* ([inits (map (lambda (b) (lower (cadr b))) bs)] [codes (map lower body)])
      (rebuild e #`(let (#,@(map (lambda (b init) #`[#,(car b) #,(kernel-type (car (cadr b))) #,init]) bs inits))
                     #,@codes))))

  ;; The arguments args of e, a call of a function of type t, checked.
  (define (check-arguments e t args env)
    (let ([ps (parameter-types t)])
      (unless (= (length ps) (length args))
        (type-error e "expected ~a argument~a, got ~a" (length ps) (if (= (length ps) 1) "" "s") (length args)))
      (map (lambda (a p) (expect a p env)) args ps)))

  ;; args, checked as the arguments for parameters of types ps, which may
  ;; name type parameters: (nodes order . s), s extending s0 with the types
  ;; that make ps the arguments', and order the order they were checked
  ;; in. A constructor alone is checked last, since only its parameter's
  ;; type can give it its types, and each argument has its parameter's
  ;; type as a hint once that is known. (mismatch a expected actual)
  ;; reports an argument of the wrong type.
  (define (check-inferring ps args env s0 mismatch)
    (let* ([n (length ps)] [nodes (make-vector n #f)]
           [alone? (lambda (k) (syntax-match (list-ref args k) [('quote ('typed-constructor _ _)) #t] [_ #f]))]
           [order (append (filter (lambda (k) (not (alone? k))) (range n)) (filter alone? (range n)))]
           [s (foldl (lambda (k s)
                       (let* ([p (list-ref ps k)] [a (list-ref args k)] [expected (substitute p s)]
                              [r (if (concrete? expected) (check a env (normalize expected a)) (check a env))]
                              [s2 (unify p (car r) s)])
                         (unless s2 (mismatch a expected (car r)))
                         (vector-set! nodes k r)
                         s2))
                     s0 order)])
      (for-each (lambda (p a r)
                  (let ([expected (substitute p s)])
                    (when (and (names-assoc? p) (concrete? expected) (not (equal? (normalize expected a) (car r))))
                      (mismatch a (normalize expected a) (car r)))))
                ps args (vector->list nodes))
      (cons (vector->list nodes) (cons order s))))

  ;; A call of f, a function define made: direct.
  (define (check-direct-call e f args env)
    (let ([t (normalize (or (type-of-syntax f) (type-error f "~a is not a typed function" (syntax-e f))) e)])
      (node (result-type t) 'direct e f (check-arguments e t args env))))

  ;; An application of a function value, r elaborated: the kernel's, of a
  ;; closure of its function type's signature (spec 5.3).
  (define (check-value-call e f args env)
    (let ([r (check f env)])
      (unless (function-type? (car r)) (type-error f "expected a function, got ~s" (shown (car r))))
      (node (result-type (car r)) 'value-call e r (check-arguments e (car r) args env))))

  (define (lower-value-call e r args)
    (let ([f (lower r)] [lowered (map lower args)])
      (rebuild e #`(#%app #,f #,@lowered))))

  ;; A lambda: its parameters, as variables, and its body.
  (define (check-lambda e xs body env)
    (let* ([vs (map variable xs)] [b (check-body e body (append vs env))])
      (node `(-> ,@(map cddr vs) ,(body-type b)) 'lambda e vs b)))

  ;; A lambda: the kernel's, of its parameters' and result's kernel types,
  ;; a closure the kernel makes (spec 5.3).
  (define (lower-lambda e vs b)
    (rebuild e #`(lambda (#,@(map (lambda (v) #`[#,(cadr v) #,(kernel-type (cddr v))]) vs))
                   -> #,(kernel-type (body-type b)) #,@(map lower b))))

  ;; ---- data ----

  ;; Constructor e, variant i of data definition d, applied to args, or
  ;; alone: its variant, its arguments elaborated, and the order they were
  ;; checked in. Its data type's types are those that make its fields'
  ;; types the arguments' (check-inferring), given what inst gave and, if
  ;; it does not give them, what hint, the type expected, is.
  (define (check-constructor e d i given args env hint)
    (let* ([d (syntax->datum d)] [i (syntax->datum i)] [variant (list-ref (variants d) i)]
           [alone? (syntax-match e [('#%app . _) #f] [_ #t])]
           [written (syntax-rewrap e (if alone? (car variant) (cons (car variant) args)))]
           [fields (map (lambda (ft) (substitute ft '() d)) (cdr variant))]
           [n (length fields)])
      (when (and alone? (> n 0))
        (type-error written "~a is a constructor, not a function value: apply it to its ~a argument~a"
                    (car variant) n (if (= n 1) "" "s")))
      (unless (= n (length args))
        (type-error written "~a takes ~a argument~a, not ~a" (car variant) n (if (= n 1) "" "s") (length args)))
      (let* ([c (check-inferring fields args env
                                 (cond [(pair? given) (bindings written (car variant) (cadr d) given)]
                                       [(and hint (data-type? hint) (equal? (data-definition hint) d)) (map cons (cadr d) (data-arguments hint))]
                                       [else '()])
                                 (lambda (a expected actual)
                                   (type-error a "~a's field is ~s, not ~s" (car variant) (shown expected) (shown actual))))]
             [s (cddr c)])
        (for-each (lambda (v)
                    (unless (assq v s)
                      (type-error written "~a's type ~a is not known from its arguments or its place: give it with inst"
                                  (car variant) v)))
                  (cadr d))
        (node (cons 'data (cons d (map (lambda (v) (cdr (assq v s))) (cadr d)))) 'construct e i (car c) (cadr c)))))

  ;; A constructor of data type t: a struct of its variant's type, its
  ;; arguments lowered in the order they were checked in.
  (define (lower-constructor e t i args order)
    (let ([codes (make-vector (length args) #f)])
      (for-each (lambda (k) (vector-set! codes k (lower (list-ref args k)))) order)
      (rebuild e #`(struct.new #,(list-ref (cdr (data-types t)) i) #,@(vector->list codes)))))

  ;; A match, e: subject, and a lambda for each clause, of variant i of data
  ;; definition d in is, or #f for _, binding its variables to the fields:
  ;; the subject elaborated, d, and each clause as (i xs field-types body),
  ;; its body elaborated. The clauses' bodies are of one type, which hint,
  ;; the type expected, may be.
  (define (check-match e d is subject lambdas env hint)
    (let* ([d (syntax->datum d)] [is (syntax->datum is)] [r (check subject env)] [t (car r)])
      (when d
        (unless (and (data-type? t) (equal? (data-definition t) d))
          (type-error subject "expected a value of the data type ~a, got ~s" (car d) (shown t))))
      (let* ([clauses (map (lambda (i lam)
                             (syntax-match lam
                               [(_ ((x _) ...) body ...)
                                (let* ([fts (if i (field-types t i) '())]
                                       [vs (map (lambda (x ft) (cons (k:local-binding x) (cons x ft))) x fts)])
                                  (list i x fts (check-body lam body (append vs env) hint) (last body)))]))
                           is lambdas)]
             [type (body-type (cadddr (car clauses)))])
        (for-each (lambda (c)
                    (unless (equal? (body-type (cadddr c)) type)
                      (type-error (list-ref c 4) "expected ~s, got ~s" (shown type) (shown (body-type (cadddr c))))))
                  clauses)
        (node type 'match e r d (map (lambda (c) (take c 4)) clauses)))))

  ;; A match's code binds the subject, then tests its variant for each
  ;; clause in turn, binding the clause's variables, with their binders, to
  ;; the fields of the variant's struct; the clauses cover the variants, so
  ;; after the last test nothing is left.
  (define (lower-match e r d clauses)
    (let* ([subject (lower r)]
           [s (fresh 'subject)]
           [clauses (map (lambda (c) (list (car c) (cadr c) (caddr c) (map lower (cadddr c)))) clauses)]
           [t (car r)])
      (rebuild e #`(let ([#,s #,(kernel-type t) #,subject]) #,(clause-code s (and d (data-types t)) clauses)))))

  ;; The code of clauses, each (i xs field-types codes), of a match of s,
  ;; whose data type's types are types.
  (define (clause-code s types clauses)
    (if (null? clauses)
        #'(unreachable)
        (let* ([c (car clauses)] [i (car c)] [body (cadddr c)])
          (if (not i)
              #`(begin #,@body)
              (let ([v (list-ref (cdr types) i)])
                #`(if (ref.test (ref #,v) #,s)
                      (let (#,@(map (lambda (x ft k) #`[#,x #,(kernel-type ft) (struct.get #,v #,(field-name k) (ref.cast (ref #,v) #,s))])
                                    (cadr c) (caddr c) (range (length (cadr c)))))
                        #,@body)
                      #,(clause-code s types (cdr clauses))))))))

  ;; ---- generics ----
  ;;
  ;; A generic is monomorphized: each module that uses it at some types
  ;; gets an instance of it, a function of its own, made from the generic's
  ;; definition when the checker first meets the mark a use of it left. Its
  ;; body is checked once, where it is defined, with its type parameters
  ;; abstract and the impls its bounds name given, and a use of it has
  ;; the impls its bounds need at the use's types; so an instance is
  ;; well typed, as Rust's are.

  ;; In the second pass, the instances made, by the generic's name:
  ;; name -> list of (id types . f), id the name as the generic wrote it,
  ;; compared by binding. While they are made, the generics and methods
  ;; whose instances are being made, one inside another, innermost first.
  (define instances #f)
  (define making '())

  (define (generic-id g) (car (syntax-e g)))
  (define (generic-name g) (syntax-e (generic-id g)))

  ;; Generic g's type parameters, its parameters' types, its result type,
  ;; the type parameters in them, and its bounds: (T ...) (A ...) R ((T .
  ;; trait) ...), trait the identifier that names it.
  (define (signature g)
    (syntax-match g
      [(_ (tv ...) ((btv btr) ...) ((_ a) ...) r _)
       (let ([tvs (map syntax-e tv)])
         (with-types tvs '()
           (lambda () (list tvs (map parse-type a) (parse-type r) (map (lambda (v r) (cons (syntax-e v) r)) btv btr)))))]))

  ;; The error of a call, written, of name, whose parameters' types are ps,
  ;; given args of other types: all their types, as each alone gives it.
  (define (takes-error written name ps args env)
    (type-error written "~a takes ~s, not ~s" name (map shown ps) (map (lambda (a) (shown (car (check a env)))) args)))

  ;; Check that s, types for generic g's type parameters, have the impls
  ;; its bounds need.
  (define (bounds! g sig s where)
    (for-each (lambda (b)
                (resolve (cdr b) (trait-of (cdr b)) (cdr (assq (car b) s)) where (format ", which ~a needs" (generic-name g))))
              (cadddr sig)))

  ;; A call e of generic g, whose mark holds the types inst gave, if it
  ;; gave them: of its instance at the types that make its parameters'
  ;; types the arguments'; elaborated as g, those types, the arguments and
  ;; the call as it was written, which errors show.
  (define (check-generic-call e g given args env)
    (let* ([sig (signature g)]
           [written (syntax-rewrap e (cons (generic-id g) args))]
           [n (length (cadr sig))])
      (unless (= n (length args))
        (type-error written "expected ~a argument~a, got ~a" n (if (= n 1) "" "s") (length args)))
      (let* ([c (check-inferring (cadr sig) args env (if (pair? given) (bindings written (generic-name g) (car sig) given) '())
                                 (lambda (a expected actual) (takes-error written (generic-name g) (cadr sig) args env)))]
             [rs (car c)] [s (cddr c)])
        (for-each (lambda (v)
                    (unless (assq v s)
                      (type-error written "~a's type ~a is not known from its arguments: give it with inst" (generic-name g) v)))
                  (car sig))
        (bounds! g sig s written)
        (node (normalize (substitute (caddr sig) s) written) 'generic-call e g (map (lambda (v) (cdr (assq v s))) (car sig)) rs written))))

  ;; Generic g as a value, e: its instance, a function define made, at the
  ;; types inst gave.
  (define (check-generic-value e g given)
    (let ([sig (signature g)] [written (syntax-rewrap e (generic-name g))])
      (unless (pair? given) (type-error written "~a is generic: give its types with inst" (generic-name g)))
      (let ([s (bindings written (generic-name g) (car sig) given)])
        (bounds! g sig s written)
        (node (normalize `(-> ,@(map (lambda (p) (substitute p s)) (cadr sig)) ,(substitute (caddr sig) s)) written)
              'generic-value e g (map cdr s) written))))

  ;; The types inst gave name, the syntax (T ...), as the type parameters
  ;; params'.
  (define (bindings where name params given)
    (let ([ts (syntax->datum (car given))] [n (length params)])
      (unless (= (length ts) n)
        (type-error where "~a takes ~a type~a, got ~a" name n (if (= n 1) "" "s") (length ts)))
      (map cons params ts)))

  ;; Generic g's instance at types ts: its function's name. The first time
  ;; this module asks for it, g's body is expanded as a lambda, its type
  ;; parameters bound to ts, and lowered as a function define made: the
  ;; name is known first, so the body can call it.
  (define (instance g ts where)
    (let ([known (findf (lambda (i) (and (equal? (cadr i) ts) (free-identifier=? (car i) (generic-id g))))
                        (hash-ref instances (generic-name g) '()))])
      (if known
          (cddr known)
          (syntax-match g
            [(name (tv ...) _ ((x a) ...) r (body ...))
             (let ([f (fresh (format "~a<~a>" (syntax-e name) (types-text ts)))])
               (hash-set! instances (syntax-e name) (cons (cons name (cons ts f)) (hash-ref instances (syntax-e name) '())))
               (made (syntax-e name) where
                     (lambda ()
                       (with-types '() (map cons (map syntax-e tv) ts)
                         (lambda ()
                           (add-function! f (local-expand #`(typed-lambda (#,@(map (lambda (x a) #`[#,x : #,a]) x a)) #,@body))
                                          (parse-type r) name)))))
               f)]))))

  ;; (thunk), which makes an instance of generic or method name, for where.
  ;; Polymorphic recursion, an instance that needs one at larger types,
  ;; would make instances without end.
  (define (made name where thunk)
    (when (= (length making) 100)
      (raise-syntax-error 'typed (format "~a needs instances at ever larger types: it cannot be monomorphized"
                                         (recurring making))
                          where))
    (dynamic-wind (lambda () (set! making (cons name making))) thunk (lambda () (set! making (cdr making)))))

  ;; Check generic g, which this module defines: its body with its type
  ;; parameters abstract, (param T), and the impls its bounds name given.
  (define (check-generic! g)
    (syntax-match g
      [(name (tv ...) ((btv btr) ...) ((x a) ...) r (body ...))
       (let ([s (map (lambda (v) (cons (syntax-e v) (list 'param (syntax-e v)))) tv)])
         (with-givens (map (lambda (v r) (cons (trait-of r) (cdr (assq (syntax-e v) s)))) btv btr)
           (lambda ()
             (with-types '() s
               (lambda ()
                 (let ([lam (local-expand #`(typed-lambda (#,@(map (lambda (x a) #`[#,x : #,a]) x a)) #,@body))])
                   (syntax-match lam
                     [(_ ((x _) ...) body ...) (check-function lam name body (map variable x) (normalize (parse-type r) r))])))))))]))

  ;; The name that most often recurs in names.
  (define (recurring names)
    (let ([count (lambda (n) (length (filter (lambda (m) (eq? m n)) names)))])
      (foldl (lambda (n best) (if (> (count n) (count best)) n best)) (car names) names)))

  ;; lam, a fully expanded lambda whose result type is result, as function
  ;; f with a value, as define makes them: the function, its code, and its
  ;; value, lifted together, since the function's value is read as its body
  ;; is expanded; the function is located at where.
  (define (add-function! f lam result where)
    (syntax-match lam
      [(_ ((x _) ...) body ...)
       (let* ([b (map lower (check-function lam f body (map variable x) result))]
              [k (map (lambda (v) (kernel-type (cddr v))) (map variable x))]
              [t (normalize `(-> ,@(map type-of-syntax x) ,result) lam)]
              [value (fresh 'value)]
              [ys (map (lambda (x) (fresh 'y)) x)]
              [rk (kernel-type (normalize result lam))])
         (syntax-local-lift-definition
          #`(begin
              #,(located where #`(func (#,f #,@(map (lambda (x k) #`[#,x #,k]) x k)) #:value #,value -> #,rk #,@b))
              (global #,value #,(kernel-type t) (lambda (#,@(map (lambda (y k) #`[#,y #,k]) ys k)) -> #,rk (#%app #,f #,@ys))))))]))

  ;; ---- impls ----

  ;; While a body is checked, the impls it may assume, each (trait .
  ;; type): its generic's bounds.
  (define givens '())

  (define (with-givens gs thunk)
    (let ([saved givens]) (dynamic-wind (lambda () (set! givens gs)) thunk (lambda () (set! givens saved)))))

  ;; In the second pass, each trait's impls, parsed (parse-impl), and the
  ;; impl each trait has for each type; a macro of the first pass, running
  ;; while facts are still to come, keeps neither.
  (define impl-table #f)
  (define resolved #f)

  ;; An impl, parsed: its syntax, its type parameters (T ...), their
  ;; bounds ((T . trait) ...), its type, its methods' functions, and its
  ;; associated types ((N . type) ...). A struct, so that a table can be
  ;; keyed by it.
  (struct impl (syntax tvs bounds type methods assocs))

  (define (parse-impl stx)
    (syntax-match stx
      [(_ (tv ...) ((btv btr) ...) type (method ...) ((an at) ...))
       (let ([tvs (map syntax-e tv)])
         (with-types tvs '()
           (lambda ()
             (impl stx tvs (map (lambda (v r) (cons (syntax-e v) r)) btv btr) (parse-type type) method
                   (map (lambda (n a) (cons (syntax-e n) (parse-type a))) an at)))))]))

  ;; Impl p's function for method name, (name (x ...) body ...).
  (define (impl-method p name) (findf (lambda (m) (eq? (syntax-e (car (syntax-e m))) name)) (impl-methods p)))

  ;; The impls of trait def, which id names, in the order the facts about
  ;; it come (spec 6.5).
  (define (impls-of id def)
    (or (and impl-table (hash-ref impl-table def #f))
        (let ([is (map (lambda (f) (parse-impl (caddr f))) (k:syntax-local-facts id))])
          (when impl-table (hash-set! impl-table def is))
          is)))

  ;; How trait def, which id names, is had for type t: given, if the body
  ;; being checked assumes it; or (p def ts name), impl p, whose type is t
  ;; at types ts for its type parameters, and the trait's name, once the
  ;; impls its bounds need are had too. For errors, where is what needs it,
  ;; and why says why.
  (define (resolve id def t where why)
    (if (member (cons def t) givens)
        'given
        (or (and resolved (hash-ref resolved (cons def t) #f))
            (resolve-impl id def t where why))))

  (define (resolve-impl id def t where why)
    (let ([ms (apply append (map (lambda (p) (let ([s (unify (impl-type p) t '())]) (if s (list (cons p s)) '())))
                                 (impls-of id def)))])
      (cond
        [(and (null? ms) (param? t))
         (type-error where "~a is not given~a: give ~a the bound (~a ~a)" (constraint def t) why (cadr t) (cadr t) (trait-name def))]
        [(null? ms) (type-error where "no impl gives ~a~a" (constraint def t) why)]
        [(pair? (cdr ms))
         (type-error where "~a has more than one impl, at ~a and at ~a" (constraint def t)
                     (written-at (impl-syntax (car (car ms)))) (written-at (impl-syntax (car (cadr ms)))))]
        [else
         (let* ([p (car (car ms))] [s (cdr (car ms))])
           (for-each (lambda (b)
                       (resolve (cdr b) (trait-of (cdr b)) (cdr (assq (car b) s)) where
                                (format ", which ~a needs" (constraint def t))))
                     (impl-bounds p))
           (let ([r (list p def (map (lambda (v) (cdr (assq v s))) (impl-tvs p)) (k:identifier-name id))])
             (unless (or (not resolved) (names-param? t)) (hash-set! resolved (cons def t) r))
             r))])))

  (define (names-param? t)
    (cond [(function-type? t) (ormap names-param? (cdr t))]
          [(data-type? t) (ormap names-param? (data-arguments t))]
          [(assoc? t) (names-param? (assoc-type t))]
          [else (param? t)]))

  ;; Type t with each projection (assoc def N u) replaced by the type that
  ;; the impl of def for u gives N, as far as that goes: a projection on a
  ;; type the body being checked assumes def for stays, a type of its own.
  ;; where is what needs it, for errors. Types are compared normalized.
  (define (normalize t where)
    (cond [(function-type? t) (cons '-> (map (lambda (x) (normalize x where)) (cdr t)))]
          [(data-type? t) (cons 'data (cons (data-definition t) (map (lambda (x) (normalize x where)) (data-arguments t))))]
          [(assoc? t)
           (let* ([trait (trait-named (assoc-trait t))] [u (normalize (assoc-type t) where)]
                  [r (resolve (car trait) (cdr trait) u where
                              (format ", which ~s needs" (shown (list 'assoc (assoc-trait t) (assoc-name t) u))))])
             (if (eq? r 'given)
                 (list 'assoc (assoc-trait t) (assoc-name t) u)
                 (normalize (substitute (cdr (assq (assoc-name t) (impl-assocs (car r)))) (map cons (impl-tvs (car r)) (caddr r)))
                            where)))]
          [else t]))

  ;; Where syntax s is, as errors write it: file:line:col.
  (define (written-at s) (format "~a:~a:~a" (k:syntax-source s) (k:syntax-line s) (+ 1 (k:syntax-column s))))

  ;; A call e of method i of trait d, which id names: of the method of the
  ;; impl for the type that makes the method's parameters' types the
  ;; arguments', or, if they do not give it, its result the type hint
  ;; expects, or the type inst gave.
  (define (check-method-call e id d i given args env hint)
    (let* ([def (syntax->datum d)] [i (syntax->datum i)] [m (list-ref (trait-methods def) i)] [tv (trait-parameter def)]
           [mt (method-type def i (k:identifier-name id))]
           [written (syntax-rewrap e (cons (car m) args))]
           [ps (parameter-types mt)])
      (unless (= (length ps) (length args))
        (type-error written "expected ~a argument~a, got ~a" (length ps) (if (= (length ps) 1) "" "s") (length args)))
      (let* ([c (check-inferring ps args env (if (pair? given) (bindings written (car m) (list tv) given) '())
                                 (lambda (a expected actual) (takes-error written (car m) ps args env)))]
             [rs (car c)]
             [s (if (and (not (assq tv (cddr c))) hint) (or (unify (result-type mt) hint (cddr c)) (cddr c)) (cddr c))])
        (unless (assq tv s)
          (type-error written "~a's type ~a is not known from its arguments or its place: give it with inst" (car m) tv))
        (let ([r (resolve id def (cdr (assq tv s)) written "")])
          (node (normalize (substitute (result-type mt) s) written) 'method-call e r i rs written)))))

  ;; Method i of trait d as a value, e: the method of the impl for the type
  ;; inst gave.
  (define (check-method-value e id d i given)
    (let* ([def (syntax->datum d)] [i (syntax->datum i)] [m (list-ref (trait-methods def) i)]
           [written (syntax-rewrap e (car m))])
      (unless (pair? given) (type-error written "~a is a method: apply it, or give its type with inst" (car m)))
      (let* ([s (bindings written (car m) (list (trait-parameter def)) given)] [r (resolve id def (cdr (car s)) written "")])
        (node (normalize (substitute (method-type def i (k:identifier-name id)) s) written) 'method-value e r i written))))

  ;; In the second pass, the methods' instances made, by impl: impl ->
  ;; list of ((i . ts) . f), method i at types ts, and its function.
  (define method-instances #f)

  ;; Method i of r, an impl as resolve gives it, at its types: its
  ;; function's name. The first time this module asks for it, the impl's
  ;; function for the method is expanded as a lambda of the method's type
  ;; at the impl's, its type parameters bound, and lowered as a function
  ;; define made, as a generic's instance is.
  (define (method-instance r i where)
    (let* ([p (car r)] [def (cadr r)] [ts (caddr r)]
           [known (assoc (cons i ts) (hash-ref method-instances p '()))])
      (if known
          (cdr known)
          (let* ([m (list-ref (trait-methods def) i)]
                 [t (substitute (impl-type p) (map cons (impl-tvs p) ts))]
                 [f (fresh (format "~a.~a<~a>" (trait-name def) (car m) (types-text (list t))))])
            (hash-set! method-instances p (cons (cons (cons i ts) f) (hash-ref method-instances p '())))
            (made (car m) where
                  (lambda ()
                    (with-types '() (map cons (impl-tvs p) ts)
                      (lambda ()
                        (let* ([method (impl-method p (car m))]
                               [mt (normalize (substitute (method-type def i (cadddr r)) (list (cons (trait-parameter def) t))) method)])
                          (add-function! f (method-lambda method mt) (result-type mt) method))))))
            f))))

  ;; An impl's function for a method, (m (x ...) body ...), expanded as a
  ;; lambda of the method's type mt.
  (define (method-lambda method mt)
    (syntax-match method
      [(_ (x ...) body ...)
       (local-expand #`(typed-lambda (#,@(map (lambda (x t) #`[#,x : '#,(datum->syntax #'here t)]) x (parameter-types mt))) #,@body))]))

  ;; Check impl stx of the trait tr names, which this module defines: each
  ;; method's function at the method's type, the impl's type parameters
  ;; abstract and the impls its bounds name given.
  (define (check-impl! stx tr)
    (let* ([def (trait-of tr)] [p (parse-impl stx)]
           [s (map (lambda (v) (cons v (list 'param v))) (impl-tvs p))]
           [t (substitute (impl-type p) s)])
      (with-givens (map (lambda (b) (cons (trait-of (cdr b)) (cdr (assq (car b) s)))) (impl-bounds p))
        (lambda ()
          (with-types '() s
            (lambda ()
              (for-each (lambda (m i)
                          (let* ([method (impl-method p (car m))]
                                 [mt (normalize (substitute (method-type def i (k:identifier-name tr)) (list (cons (trait-parameter def) t))) method)]
                                 [lam (method-lambda method mt)])
                            (syntax-match lam
                              [(_ ((x _) ...) body ...)
                               (check-function lam (car (syntax-e method)) body (map variable x) (result-type mt))])))
                        (trait-methods def) (range (length (trait-methods def)))))))))))

(define-syntax typed-define typed-define)
(define-syntax kernel-define kernel-define)
(define-syntax typed-lambda typed-lambda)
(define-syntax typed-inst typed-inst)
(define-syntax typed-data typed-data)
(define-syntax typed-match typed-match)
(define-syntax typed-trait typed-trait)
(define-syntax typed-impl typed-impl)
(define-syntax typed-body typed-body)
(define-syntax generic-check generic-check)
(define-syntax impl-check impl-check)

;; ---- functions on Int ----
;;
;; Kernel code, which nothing checks; every other define's body is typed
;; code.

(kernel-define (+ [a : Int] [b : Int]) : Int (i64.add a b))
(kernel-define (- [a : Int] [b : Int]) : Int (i64.sub a b))
(kernel-define (* [a : Int] [b : Int]) : Int (i64.mul a b))
(kernel-define (< [a : Int] [b : Int]) : Bool (i64.lt_s a b))
(kernel-define (= [a : Int] [b : Int]) : Bool (i64.eq a b))
;; Write n on a line, and return it.
(kernel-define (print [n : Int]) : Int (write-i64 n) (newline) n)
