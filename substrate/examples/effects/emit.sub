;; Lifecycle: example. A spike for the effects rung (seed plan): one
;; tail-resumptive effect, emit, passed as a hidden argument, the way
;; Effekt passes capabilities and Koka passes evidence. Not a library to
;; build on.
;;
;;   (define (f [p t] ...) [-> r] body ...)  a function that may emit
;;   (emit x)                                send x, an i32, to the handler;
;;                                           its answer is emit's value
;;   (handle h init body ...)                run body with handler h and
;;                                           state init; its value is the
;;                                           final state
;;
;; A handler is a function of type handler: (func (h [ev (ref evidence)]
;; [x i32]) -> i32 (type handler) ...), which can read and set the state,
;; (struct.get evidence state ev). Modules use this with
;; require-unqualified: define, emit, handle and #%app are the forms
;; their code is written in.
;;
;; How the evidence reaches every call. define gives the function a first
;; parameter, ev, and wraps its body in (with-evidence ev body ...). This
;; library's #%app turns a call of such a function into a call that passes
;; hole, a global of this library, in place of the evidence; emit uses
;; hole too. with-evidence local-expands the body (spec 2.3) and replaces
;; each hole, compared by binding, with its ev. That keeps the evidence
;; hygienic, and also reaches calls written in other libraries' macro
;; templates. Racket would use a syntax parameter; those need local macro
;; bindings, which the kernel does not have. A hole left over, from a call
;; outside define or handle, fails to type-check: it is a (ref null
;; evidence), and a function wants a (ref evidence).

(provide define emit handle [#%app app] evidence handler)

(rec
  (type evidence (struct (field op (ref handler)) (field state (mut i32))))
  (type handler (func ((ref evidence) i32 -> i32))))

(global hole (ref null evidence) (ref.null evidence))

(begin-for-syntax
  (require s syntax)

  (func (named? [x eqref] [name eqref]) -> i32
    (if (s:identifier? x) (ref.eq (s:syntax-e x) name) 0))

  ;; (define (name [p t] ...) [-> r] body ...): the function, under a name
  ;; of its own, and name as static information pointing at it.
  (func (define [stx eqref]) -> eqref
    (let* ([parts (s:syntax->list stx)]
           [head (s:syntax->list (s:cadr parts))]
           [rest (s:cddr parts)]
           [arrow (if (i32.and (i32.eqz (s:null? rest)) (named? (s:car rest) '->))
                      (s:cons (s:car rest) (s:cons (s:cadr rest) '()))
                      '())]
           [body (if (s:null? arrow) rest (s:cddr rest))])
      #`(begin
          (func (impl [ev (ref evidence)] #,@(s:cdr head)) #,@arrow
            (with-evidence ev #,@body))
          (define-static #,(s:car head) (quote-syntax (effectful impl))))))

  ;; hole, located at stx, so a hole left over is reported at the code
  ;; that left it.
  (func (hole-at [stx eqref]) -> eqref (s:datum->syntax #'hole 'hole stx))

  ;; (#%app f arg ...): a function defined with define gets the evidence,
  ;; as hole for now; anything else is called as it is.
  (func (app [stx eqref]) -> eqref
    (let* ([parts (s:cdr (s:syntax->list stx))]
           [f (s:car parts)]
           [args (s:cdr parts)])
      (if (i32.and (s:identifier? f) (ref.eq (s:binding-kind f) 'static))
          (let ([info (s:syntax->list (s:syntax-local-value f))])
            (if (i32.and (i32.eqz (ref.is_null info)) (named? (s:car info) 'effectful))
                (return #`(#,(s:cadr info) #,(hole-at stx) #,@args)))))
      #`(#,f #,@args)))

  ;; (emit x): call the handler with the evidence and x.
  (func (emit [stx eqref]) -> eqref
    (let ([h (hole-at stx)])
      #`(call-ref handler (struct.get evidence op #,h) #,h #,(s:cadr (s:syntax->list stx)))))

  ;; (handle h init body ...)
  (func (handle [stx eqref]) -> eqref
    (let ([parts (s:syntax->list stx)])
      #`(let ([ev (ref evidence) (struct.new evidence (ref.func #,(s:cadr parts)) #,(s:caddr parts))])
          (with-evidence ev #,@(s:cdddr parts))
          (struct.get evidence state ev))))

  ;; (with-evidence ev body ...): body, expanded, with each hole replaced
  ;; by ev.
  (func (with-evidence [stx eqref]) -> eqref
    (let ([parts (s:syntax->list stx)])
      (fill (s:local-expand #`(begin #,@(s:cddr parts))) (s:cadr parts))))

  (func (fill [x eqref] [ev eqref]) -> eqref
    (if (s:identifier? x)
        (return (if (s:free-identifier=? x #'hole) ev x)))
    (let ([l (s:syntax->list x)])
      (if (ref.is_null l) (return x))
      (if (s:null? l) (return x))
      (if (i32.or (named? (s:car l) 'quote) (named? (s:car l) 'quote-syntax)) (return x))
      (s:syntax-rewrap x (fill-list l ev))))

  (func (fill-list [l eqref] [ev eqref]) -> eqref
    (if (s:null? l) '() (s:cons (fill (s:car l) ev) (fill-list (s:cdr l) ev)))))

(define-syntax define define)
(define-syntax app app)
(define-syntax emit emit)
(define-syntax handle handle)
(define-syntax with-evidence with-evidence)
