;; Lifecycle: example. A library written with the effect language: beep
;; emits 7, and (beeps) is a macro whose template calls beep twice. Those
;; calls are written here, with this library's scopes, not the user's, and
;; still get the evidence of the handle they are expanded in.
(require-unqualified fx "emit.sub")
(provide beeps)

(define (beep) (emit 7))

(begin-for-syntax
  (require s syntax)
  (func (beeps [stx eqref]) -> eqref #'(begin (beep) (beep))))
(define-syntax beeps beeps)
