;; Lifecycle: example. A C-like language on the kernel: C's types, memory
;; and control, written as s-expressions, compiled to wasm that uses linear
;; memory and no GC; its macros are in Substrate at compile time. A module
;; takes these forms from c.sub, with its allocator (runtime.sub), with
;; require-unqualified, and shares its memory and table, (memory from c)
;; and (table from c):
;;
;;   (define (f [x T] ...) -> R body ...)   a function, of result type R,
;;   (define (f [x T] ...) body ...)        or of none
;;   (define x T), (define x T init)        a global variable, in memory:
;;                                          zero, or init's value
;;   (struct S [field T] ...)               a struct type, laid out as C
;;                                          lays it out
;;   (union U [field T] ...)                a union type, whose fields
;;                                          share its bytes
;;   (typedef N T)                          N names type T
;;   (let ([x T init] ...) body ...)        local variables, each of type T
;;   (let ([x init] ...) body ...), let*    or of init's; [x T] is 0 if
;;                                          it is a number or pointer,
;;                                          and not set, as in C, if an
;;                                          array or struct
;;   (set! place e)                         e stored in place, which is
;;                                          its value
;;   (+= place e), -= *= /= %= <<= >>=      place updated
;;   bit-and= bit-or= bit-xor=
;;   (if c a [b]), (when c body ...), (unless c body ...), (begin body ...)
;;   (while c body ...)                     a loop; for's variables are in
;;   (for ([x T init] ...) c step body ...) scope for c, step and body,
;;                                          and step runs after each body
;;   (break), (continue), (return [e])
;;   (f arg ...)                            a call of a function define
;;                                          made, of a kernel function of
;;                                          numeric types, or of a function
;;                                          pointer: a C function's name is
;;                                          one, as is (& f) of any function
;;   + - * / %                              arithmetic; + and - also on a
;;                                          pointer and an integer, scaled
;;                                          by the size of what it points
;;                                          to, and - on two pointers
;;   == != < <= > >=, and or not            comparisons and logic, 1 or 0
;;   bit-and bit-or bit-xor bit-not << >>
;;   (@ p), (@ p i)                         the places *p and p[i]
;;   (-> p field ...)                       the place p->field, p a pointer
;;                                          to a struct or a struct's place
;;   (& place)                              its address
;;   (cast T e), (sizeof T), (offsetof S field)
;;   (memory.size) (memory.grow n) (memory.copy d s n) (memory.fill d v n)
;;   integers, decimals, #\c, #t and #f (1 and 0), and "text", a (ptr u8)
;;   to its bytes, followed by a 0
;;
;; The types are i8 u8 i16 u16 i32 u32 i64 u64, f32 f64, void (a result
;; only), (ptr T), (array T n), n a count, (fn (T ...) -> R) and (fn (T
;; ...)), pointers to functions, and the names struct, union and typedef
;; give. A variable may be an array or a struct, and a function takes and
;; returns structs by value. An array's value is
;; the address of its first element, as in C, and a struct's is its
;; address too, which set!, let, a call and a return copy the struct
;; from; so (-> (f) x) is a field of the struct f returns. C's
;; conversions are implicit between numbers, and between a (ptr void) and
;; another pointer; cast does the others, between numbers and pointers
;; too. A narrower integer is an i32 once read, as C promotes it; an
;; integer literal takes the type its place needs, and a decimal the type
;; of the float it meets, or f64; an operation on numbers of two types is
;; at the larger, unsigned if either is, as C's.
;;
;; How it works. A function is the kernel's, under its own name, with a
;; fact that gives its C types (spec 6.5), which a call from any module
;; reads. Its body is one macro use, c-body, which the module's second
;; pass expands (spec 5.2): it expands the body to fully expanded code
;; (spec 6.4), checks it and lowers it to kernel code, in one walk. C's
;; operators and places are marks, quoted data that the walk reads, as the
;; typed example's generics are (examples/typed/typed.sub); let is the
;; kernel's, with each variable's declared type in a syntax property of
;; its name. A struct's name is bound to its fields' syntax, which is laid
;; out when a type needs it, so a field may point to a struct defined
;; later; a struct's type holds the struct's name (spec 6.6), which leads
;; back to it in any module. Memory is print.sub's, shared by every module
;; (memory from print): sbrk gives out the bytes past 1024, which are
;; zero, and a global is a kernel global holding the address of its bytes,
;; which sbrk gives when the module starts, as it gives a string literal
;; its bytes. A variable the kernel cannot hold, an array or struct or one
;; whose address is taken, is in its function's frame, which the function
;; takes from the stack as it starts, below the stack's top, sp, and gives
;; back as it returns; so is a struct a call returns. Structs pass as C
;; passes them: an argument is the address of a copy the caller makes in
;; its frame, unless a call just returned it, and a function that returns
;; one takes, first, the address to put it at, bytes no one reads until
;; it returns, and returns that address; one that returns the same
;; variable at each return builds that variable there. A function pointer is the
;; function's index in the table, which every module shares, and which
;; holds no function at 0, a null pointer; a call of one is the kernel's
;; call-indirect. No code quotes data, so a program is freestanding (spec
;; 3.4).

(require print "../../lib/print.sub")
(begin-for-syntax
  (require-unqualified substrate "../../lib/substrate.sub")
  (require k kernel))

(provide [define c-define] [struct c-struct] [union c-union] typedef [let c-let] [let* c-let*] [set! c-set!]
         [#%datum c-datum] when unless while for break continue and or not cast sizeof offsetof @ & ->
         + - * / % == != < <= > >= bit-and bit-or bit-xor bit-not << >>
         += -= *= /= %= <<= >>= bit-and= bit-or= bit-xor= sbrk)

(memory from print)

;; The functions whose pointers are taken, after an empty 0.
(table 1)

;; The heap's end, a multiple of 8: memory past it has not been given out,
;; so it is zero. Bytes 0..1023 are print's.
(global brk (mut i32) 1024)

;; n more bytes past the heap's end, which moves past them, rounded up to a
;; multiple of 8: their address, or 0 if memory cannot grow.
(func (sbrk [n i32]) -> i32
  (let ([p brk] [end (i32.and (i32.add (i32.add brk n) 7) -8)] [size (i32.shl (memory.size) 16)])
    (if (i32.gt_u end size)
        (if (i32.lt_s (memory.grow (i32.shr_u (i32.add (i32.sub end size) 65535) 16)) 0)
            (return 0)))
    (set! brk end)
    p))

;; The stack, 1 MiB from sbrk, whose frames are taken from sp, its top,
;; down.
(global stack-base (mut i32) (sbrk 1048576))
(global sp (mut i32) (i32.add stack-base 1048576))

(begin-for-syntax
  (define (c-error where form . args) (raise-syntax-error 'c (apply format form args) (written where)))

  ;; Fully expanded e as it was written, near enough, for messages.
  (define (written e)
    (syntax-match e
      [('#%datum d) d]
      [('quote ('c-string s)) s]
      [('quote ('c-sizeof t)) (syntax-rewrap e (list 'sizeof t))]
      [('quote ('c-offsetof t f)) (syntax-rewrap e (list 'offsetof t f))]
      [('quote ('c-function f)) (syntax-rewrap e (list '& f))]
      [('#%app ('quote ((? identifier? m) . data)) arg ...)
       (let ([ws (map written arg)] [data (syntax->list data)])
         (syntax-rewrap e (case (syntax-e m)
                            [(c-op) (cons (car data) ws)] [(c-cast) (cons 'cast (cons (car data) ws))]
                            [(c-update) (cons (string->symbol (format "~a=" (syntax-e (car data)))) ws)]
                            [(c-arrow) (list '-> (car ws) (car data))] [(c-deref) (cons '@ ws)] [(c-addr) (cons '& ws)]
                            [(c-set!) (cons 'set! ws)] [(c-while) (cons 'while ws)] [(c-break) '(break)] [(c-continue) '(continue)]
                            [else (cons (syntax-e m) ws)])))]
      [('#%app f arg ...) (syntax-rewrap e (cons f (map written arg)))]
      [(x ...) (syntax-rewrap e (map written x))]
      [_ e]))

  (define (syn d) (datum->syntax #'here d))

  ;; form, located at where.
  (define (at where form) (datum->syntax form (syntax-e form) where))

  (define counter 0)
  (define (fresh base)
    (set! counter (+ counter 1))
    (syn (string->symbol (format "~a~a" base counter))))

  ;; ---- types ----
  ;;
  ;; A type is a datum: i8 u8 i16 u16 i32 u32 i64 u64 f32 f64 void,
  ;; (ptr T), (array T n), (fn (T ...) R) or (struct name S), name the name of the
  ;; struct's or union's definition (spec 6.6) and S its own. An
  ;; expression's type is a number's, i32 u32 i64 u64 f32 f64, a pointer's
  ;; or void; lit, an integer constant, or flit, a decimal, until its place
  ;; gives it a type; or none, for an expression that does not finish,
  ;; such as a return.

  (define (integer-type? t) (memq t '(i8 u8 i16 u16 i32 u32 i64 u64 lit)))
  (define (float-type? t) (memq t '(f32 f64 flit)))
  (define (arithmetic? t) (or (integer-type? t) (float-type? t)))
  (define (pointer? t) (and (pair? t) (eq? (car t) 'ptr)))
  (define (fn-type? t) (and (pair? t) (eq? (car t) 'fn)))
  (define (address-type? t) (or (pointer? t) (fn-type? t)))
  (define (array-type? t) (and (pair? t) (eq? (car t) 'array)))
  (define (struct-type? t) (and (pair? t) (eq? (car t) 'struct)))
  (define (aggregate? t) (or (array-type? t) (struct-type? t)))

  ;; The type of a value read from a place of type t: C's promotion.
  (define (promoted t) (if (memq t '(i8 u8 i16 u16)) 'i32 t))

  ;; A constant's type once nothing else gives it one.
  (define (settled-type t) (case t [(lit) 'i32] [(flit) 'f64] [else t]))

  (define (kernel-type t)
    (cond [(memq t '(i64 u64)) 'i64] [(memq t '(f32 f64)) t] [(eq? t 'flit) 'f64] [else 'i32]))

  ;; Type t as it is written, for messages.
  (define (shown t)
    (cond [(pointer? t) (list 'ptr (shown (cadr t)))]
          [(fn-type? t) `(fn ,(map shown (cadr t)) ,@(if (eq? (caddr t) 'void) '() (list '-> (shown (caddr t)))))]
          [(array-type? t) (list 'array (shown (cadr t)) (caddr t))]
          [(struct-type? t) (caddr t)]
          [(eq? t 'none) 'void]
          [else (settled-type t)]))

  (define scalar-names '(i8 u8 i16 u16 i32 u32 i64 u64 f32 f64))

  ;; Type syntax s as a type.
  (define (parse-type s)
    (syntax-match s
      [(? identifier? x) (if (memq (syntax-e x) (cons 'void scalar-names)) (syntax-e x) (named-type x))]
      [('ptr t) (list 'ptr (parse-type t))]
      [('array t n)
       (unless (and (integer? (syntax-e n)) (>= (syntax-e n) 0)) (c-error n "an array's length is a count"))
       (list 'array (complete! (parse-type t) t) (syntax-e n))]
      [('fn (t ...) '-> r) (list 'fn (map (lambda (t) (value-type! (parse-type t) t)) t) (result-type! r))]
      [('fn (t ...)) (list 'fn (map (lambda (t) (value-type! (parse-type t) t)) t) 'void)]
      [_ (c-error s "expected a type")]))

  ;; What x is bound to if it names a type: (c-struct S fields kind) for a
  ;; struct or union, (c-typedef type) for a typedef; or #f.
  (define (type-binding x)
    (let ([v (and (eq? (identifier-binding-kind x) 'compile-time-value) (syntax-local-value x))])
      (and (pair? v) (memq (car v) '(c-struct c-typedef)) v)))

  (define (named-type x)
    (let ([v (or (type-binding x) (c-error x "~a is not a type" (syntax-e x)))])
      (if (eq? (car v) 'c-struct) (list 'struct (k:identifier-name x) (cadr v)) (cadr v))))

  ;; Whether s is written as a type rather than a value, which a let's
  ;; [x T] tells from [x value].
  (define (type-syntax? s)
    (syntax-match s
      [(? identifier? x) (or (and (memq (syntax-e x) scalar-names) #t) (and (type-binding x) #t))]
      [((? identifier? h) . _) (and (memq (syntax-e h) '(ptr array fn)) #t)]
      [_ #f]))

  ;; t, a type of a variable, which must be a number's or a pointer's.
  (define (scalar! t where)
    (unless (or (arithmetic? t) (address-type? t))
      (c-error where "expected a number or pointer type, not ~s" (shown t)))
    t)

  ;; t, a type of a parameter or result: a number's, a pointer's or a
  ;; struct's.
  (define (value-type! t where) (if (struct-type? t) t (scalar! t where)))

  (define (result-type! r) (let ([t (parse-type r)]) (if (eq? t 'void) t (value-type! t r))))

  ;; t, which must have a size: it is not void, and holds no struct that
  ;; holds it.
  (define (complete! t where)
    (cond [(eq? t 'void) (c-error where "void has no size")]
          [(array-type? t) (complete! (cadr t) where)]
          [(and (struct-type? t) (eq? (hash-ref layouts (cadr t) #f) 'laying-out))
           (c-error where "~a holds itself" (caddr t))])
    t)

  (define (size-of t)
    (cond [(memq t '(i8 u8)) 1] [(memq t '(i16 u16)) 2] [(memq t '(i64 u64 f64)) 8]
          [(array-type? t) (* (caddr t) (size-of (cadr t)))]
          [(struct-type? t) (car (layout t))]
          [else 4]))

  (define (alignment t)
    (cond [(array-type? t) (alignment (cadr t))] [(struct-type? t) (cadr (layout t))] [else (size-of t)]))

  (define (round-up n a) (* (quotient (+ n a -1) a) a))

  ;; The layout of struct or union type t, (size alignment ((field type
  ;; offset) ...)), as C's: each field of a struct at the next multiple of
  ;; its alignment, each of a union at 0, and the size a multiple of the
  ;; largest alignment. Laid out once per compilation.
  (define layouts (make-hasheq))
  (define (layout t)
    (or (hash-ref layouts (cadr t) #f)
        (let* ([v (syntax-local-value (k:name-identifier (cadr t)))] [union? (eq? (cadddr v) 'union)])
          (hash-set! layouts (cadr t) 'laying-out)
          (let loop ([fs (syntax->list (caddr v))] [end 0] [align 1] [out '()])
            (if (null? fs)
                (let ([l (list (round-up end align) align (reverse out))])
                  (hash-set! layouts (cadr t) l)
                  l)
                (syntax-match (car fs)
                  [(f ft)
                   (let* ([ty (complete! (parse-type ft) ft)] [a (alignment ty)] [o (if union? 0 (round-up end a))])
                     (loop (cdr fs) (max end (+ o (size-of ty))) (max align a) (cons (list (syntax-e f) ty o) out)))]))))))

  ;; ---- definitions ----

  ;; form, as a module-level form of the second pass, which expands it
  ;; once every definition of the module is declared (spec 5.2).
  (define (second-pass form) #`(let () #,form))

  ;; (define (f [x T] ...) -> R body ...), (define x T [init]).
  (define (c-define s)
    (syntax-match s
      [(_ ((? identifier? f) ((? identifier? x) t) ...) '-> r body ...) (function s f x t r body)]
      [(_ ((? identifier? f) ((? identifier? x) t) ...) body ...) (function s f x t #'void body)]
      [(_ (? identifier? x) t) (global s x t '())]
      [(_ (? identifier? x) t init) (global s x t (list init))]
      [_ (c-error s "expected (define (f [x type] ...) -> type body ...) or (define x type [value])")]))

  ;; Function f: the kernel's, of the kernel types of its C types, whose
  ;; body c-body checks and lowers in the second pass; its value (spec
  ;; 5.2), a global holding its index in the table, its pointer; and a
  ;; fact that gives its C types, (c-function (T ...) R). If R is a
  ;; struct, its first parameter is the address its result goes to.
  (define (function s f xs ts r body)
    (let* ([ps (map (lambda (t) (value-type! (parse-type t) t)) ts)]
           [rt (result-type! r)]
           [to (and (struct-type? rt) (fresh 'to))]
           [value (syn (string->symbol (format "~a.pointer" (syntax-e f))))])
      #`(begin
          #,(at s #`(func (#,f #,@(if to (list #`[#,to i32]) '()) #,@(map (lambda (x p) #`[#,x #,(syn (kernel-type p))]) xs ps))
                      #:value #,value
                      #,@(if (eq? rt 'void) '() (list #'-> (syn (kernel-type rt))))
                      (c-body (#,@xs) #,(or to #'#f) '#,(syn (cons rt ps)) #,@body)))
          (global #,value (mut i32) (func-index #,f))
          (#%fact #,f '#,(syn (list 'c-function ps rt))))))

  ;; Global x: a kernel global holding the address of its bytes, which
  ;; c-static gives it when the module starts, and a fact that gives its
  ;; type, (c-global T).
  (define (global s x t init)
    (let ([ty (complete! (parse-type t) t)])
      #`(begin
          #,(at s #`(global #,x (mut i32) (c-static '#,(syn ty) #,@init)))
          (#%fact #,x '#,(syn (list 'c-global ty))))))

  ;; (c-static 'T [init]): the address of a global's bytes, new from sbrk,
  ;; so zero, with init's value put in them, in a frame if that needs one.
  (define (c-static s)
    (syntax-match s
      [(_ ('quote t)) #`(sbrk #,(syn (size-of (syntax->datum t))))]
      [(_ ('quote t) init)
       (let* ([t (syntax->datum t)] [p (fresh 'p)] [e (begin (start-function! 'void #f) (local-expand init))])
         #`(let ([#,p (sbrk #,(syn (size-of t)))])
             #,(with-frame
                 (lambda ()
                   (framed '() (cons 'void (if (aggregate? t) (as-void (copy-into p e t '())) (store t p 0 (expect e t '() #t)))))))
             #,p))]))

  ;; (struct S [field T] ...) and (union U [field T] ...): the name bound
  ;; to (c-struct S fields kind), laid out in the second pass, which
  ;; reports its errors (c-struct-check), or before, when a type needs it.
  (define (c-struct s) (aggregate-type s 'struct))
  (define (c-union s) (aggregate-type s 'union))

  (define (aggregate-type s kind)
    (syntax-match s
      [(_ (? identifier? name) field ...)
       (let loop ([fs field] [seen '()])
         (unless (null? fs)
           (syntax-match (car fs)
             [((? identifier? f) _)
              (when (memq (syntax-e f) seen) (c-error f "~a is a field twice" (syntax-e f)))
              (loop (cdr fs) (cons (syntax-e f) seen))]
             [_ (c-error (car fs) "expected [field type]")])))
       #`(begin (define-syntax #,name (list 'c-struct '#,name (quote-syntax (#,@field)) '#,(syn kind)))
                #,(second-pass #`(c-struct-check #,name)))]))

  (define (c-struct-check s) (syntax-match s [(_ name) (layout (named-type name)) #'(begin)]))

  (define (c-typedef s)
    (syntax-match s
      [(_ (? identifier? n) t) #`(define-syntax #,n (list 'c-typedef '#,(syn (parse-type t))))]))

  ;; ---- forms ----

  ;; A transformer whose use, alone or at the head of an application, is
  ;; mark, quoted data that the walk reads.
  (define (mark-transformer mark)
    (transformer (s)
      (syntax-match s
        [(_ arg ...) (at s #`(#%app '#,(syn mark) #,@arg))]
        [_ (at s #`'#,(syn mark))])))

  ;; (let ([x T init] | [x T] | [x init] ...) body ...): the kernel's, each
  ;; x with its type T, if it is given, in a property; [x T]'s value is
  ;; the mark '(c-zero).
  (define (c-let s)
    (syntax-match s
      [(_ (b ...) body ...)
       (at s #`(let (#,@(map (lambda (b)
                               (syntax-match b
                                 [((? identifier? x) t init) #`[#,(syntax-property x 'c-type (parse-type t)) #,init]]
                                 [((? identifier? x) (? type-syntax? t)) #`[#,(syntax-property x 'c-type (parse-type t)) '(c-zero)]]
                                 [((? identifier? x) init) #`[#,x #,init]]
                                 [_ (c-error b "expected [x type value], [x type] or [x value]")]))
                             b))
                 #,@body))]))

  (define (c-let* s)
    (syntax-match s
      [(_ () body ...) (at s #`(c-let () #,@body))]
      [(_ (b rest ...) body ...) (at s #`(c-let (#,b) (c-let* (#,@rest) #,@body)))]))

  (define (c-datum s)
    (syntax-match s [(_ d) (if (string? (syntax-e d)) (at s #`'(c-string #,d)) #`(#%datum #,d))]))

  (define (c-when s) (syntax-match s [(_ c body ...) (at s #`(if #,c (begin #,@body)))]))
  (define (c-unless s) (syntax-match s [(_ c body ...) (at s #`(if #,c (begin) (begin #,@body)))]))

  (define (c-while s)
    (syntax-match s [(_ c body ...) (at s #`(#%app '(c-while) #,c (begin #,@body)))]))

  (define (c-for s)
    (syntax-match s
      [(_ (b ...) c step body ...) (at s #`(c-let (#,@b) (#%app '(c-while) #,c (begin #,@body) #,step)))]))

  (define (c-cast s) (syntax-match s [(_ t e) (at s #`(#%app '(c-cast #,t) #,e))]))

  ;; (& place), or (& f), f a function: a kernel function's name is not an
  ;; expression, so the mark holds it.
  (define (c-addr s)
    (syntax-match s
      [(_ (? function-name? f)) (at s #`'(c-function #,f))]
      [(_ x) (at s #`(#%app '(c-addr) #,x))]))
  (define (c-sizeof s) (syntax-match s [(_ t) (at s #`'(c-sizeof #,t))]))
  (define (c-offsetof s) (syntax-match s [(_ t (? identifier? f)) (at s #`'(c-offsetof #,t #,f))]))

  (define (c-arrow s)
    (syntax-match s
      [(_ e (? identifier? f) (? identifier? g) ...)
       (foldl (lambda (f e) (at s #`(#%app '(c-arrow #,f) #,e))) e (cons f g))]))

  ;; ---- bodies ----
  ;;
  ;; One walk over fully expanded code (spec 6.4) checks each expression
  ;; and gives its type and its kernel code, as (type . code); a
  ;; constant's code, while its type is lit or flit, is its value. env
  ;; holds the local variables, each as (key T . where), key its local
  ;; binding (spec 2.3): where is (), for a kernel local; (offset), in the
  ;; frame at offset; (at), a struct parameter, the address of the
  ;; caller's copy; or (result), the struct the function returns, which is
  ;; where to says.

  ;; The function being checked: its result type; its loops, innermost
  ;; first, each the labels (break . continue); its frame, (fp . saved),
  ;; the locals that hold the frame's address and sp before it, or #f if
  ;; it has none, and the frame's bytes so far; the variables whose
  ;; addresses it takes, by local binding; the parameter that holds where
  ;; its struct result goes; and the variable it returns, if it builds it
  ;; there. scan finds its returns' values and its lets' variables.
  (define result 'void)
  (define loops '())
  (define frame #f)
  (define frame-size 0)
  (define addressed '())
  (define to #f)
  (define returned #f)
  (define returns '())
  (define binders '())

  (define (start-function! r result-to)
    (set! result r) (set! loops '()) (set! frame #f) (set! frame-size 0) (set! addressed '()) (set! to result-to)
    (set! returned #f) (set! returns '()) (set! binders '()))

  ;; What frame-slot! raises in a function with no frame, which with-frame
  ;; takes to check it again with one.
  (define needs-frame (list 'needs-frame))

  ;; The offset in the frame of new bytes for a value of type t.
  (define (frame-slot! t)
    (unless frame (raise needs-frame))
    (let ([o (round-up frame-size (alignment t))])
      (set! frame-size (+ o (size-of t)))
      o))

  (define (frame-place t offset) (list t 'memory (car frame) offset))

  ;; (walk), which checks and lowers a body, with no frame, or if it
  ;; finds it needs one, again with one.
  (define (with-frame walk)
    (set! frame #f)
    (set! frame-size 0)
    (or (with-handlers ([(lambda (x) (eq? x needs-frame)) (lambda (x) #f)]) (walk))
        (begin (set! frame (cons (fresh 'fp) (fresh 'saved))) (set! frame-size 0) (walk))))

  ;; What the check must know of fully expanded e before it starts:
  ;; addressed gets the variables whose addresses e takes, returns its
  ;; returns' values, and binders its lets' variables.
  (define (scan e)
    (syntax-match e
      [('quote . _) #f]
      [('#%app ('quote ('c-addr)) (? identifier? x))
       (let ([b (k:local-binding x)]) (when b (set! addressed (cons b addressed))))]
      [('let ((x init) ...) body ...)
       (set! binders (append (map (lambda (x) (k:local-binding x)) x) binders))
       (for-each scan init)
       (for-each scan body)]
      [('return v) (set! returns (cons v returns)) (scan v)]
      [(x ...) (for-each scan x)]
      [_ #f]))

  ;; The variable, by local binding, that a function whose body is forms
  ;; returns at each return and as its value, if a let in it binds it; or
  ;; #f.
  (define (returned-variable forms)
    (let ([v (value-variable (last forms))])
      (and v (memv v binders) (andmap (lambda (e) (eqv? (value-variable e) v)) returns) v)))

  (define (value-variable e)
    (syntax-match e
      [(? identifier? x) (k:local-binding x)]
      [('return v) (value-variable v)]
      [('let _ body ... v) (value-variable v)]
      [('begin body ... v) (value-variable v)]
      [_ #f]))

  ;; (c-body (x ...) to '(R T ...) body ...): the body of a function whose
  ;; parameters x ... are of types T ... and whose result type is R, to
  ;; the parameter for a struct result's address, or #f.
  (define (c-body s)
    (syntax-match s
      [(_ (x ...) result-to ('quote types) body ...)
       (let* ([types (syntax->datum types)] [xs (map local-expand x)] [forms (map local-expand body)])
         (start-function! (car types) (and (identifier? result-to) result-to))
         (for-each scan forms)
         (when (and to (pair? forms)) (set! returned (returned-variable forms)))
         (with-frame
           (lambda ()
             ;; A parameter whose address is taken is copied into the
             ;; frame.
             (let ([params (map (lambda (x t)
                                  (let ([key (k:local-binding x)])
                                    (cond [(struct-type? t) (list (list key t 'at))]
                                          [(memv key addressed)
                                           (let ([o (frame-slot! t)]) (list (list key t o) (store t (car frame) o x)))]
                                          [else (list (list key t))])))
                                xs (cdr types))])
               (framed (apply append (map cdr params)) (function-body s forms (map car params) (car types)))))))]))

  ;; A function's body: its value converted to the result type, or for a
  ;; struct, put where to says.
  (define (function-body s forms env r)
    (cond [(eq? r 'void) (cons 'void (as-void (check-sequence s forms env 'void)))]
          [(struct-type? r)
           (when (null? forms) (c-error s "expected a body"))
           (let ([codes (map (lambda (f) (as-void (check f env 'void))) (take forms (- (length forms) 1)))]
                 [v (result-value (last forms) env)])
             (cons (car v) (at s #`(begin #,@codes #,(cdr v)))))]
          [else (let ([b (check-sequence s forms env r)])
                  (cons (if (eq? (car b) 'none) 'none r) (convert b r (if (null? forms) s (last forms)))))]))

  ;; Struct e, as the function's result, where to says: (type . code), its
  ;; code giving that address. If e is the variable the function returns,
  ;; it is there already.
  (define (result-value e env)
    (if returned
        (let ([r (check e env result)]) (if (eq? (car r) 'none) r (cons 'i32 (convert r result e))))
        (copy-into to e result env)))

  ;; A body, b, in its frame if it has one: the frame taken from the stack,
  ;; with the parameters it holds stored in it by the code entry, and given
  ;; back as the body ends, as at each return.
  (define (framed entry b)
    (if frame
        (let ([fp (car frame)] [saved (cdr frame)])
          #`(let ([#,saved sp])
              (let ([#,fp (i32.sub #,saved #,(const 'i32 (round-up frame-size 8)))])
                (if (i32.lt_u #,fp stack-base) (unreachable))
                (set! sp #,fp)
                #,@entry
                #,(leave b))))
        (cdr b)))

  ;; r's code, which gives the frame back, if there is one, after its value.
  (define (leave r)
    (cond [(or (not frame) (eq? (car r) 'none)) (cdr r)]
          [(eq? (car r) 'void) #`(begin #,(cdr r) (set! sp #,(cdr frame)))]
          [else (let ([v (fresh 'v)]) #`(let ([#,v #,(cdr r)]) (set! sp #,(cdr frame)) #,v))]))

  ;; e's (type . code), the code located at e. hint, if it is given, is
  ;; the type e's place expects, which a constant that a let, if or begin
  ;; ends with takes, or void if its value is not used.
  (define (check e env . hint)
    (let ([r (check-expression e env (and (pair? hint) (car hint)))])
      (if (and (syntax? (cdr r)) (pair? (syntax-e (cdr r)))) (cons (car r) (syntax-rewrap e (syntax-e (cdr r)))) r)))

  ;; e's value, as one of type t.
  (define (expect e t env . stored) (apply convert (check e env t) t e stored))

  (define (check-expression e env hint)
    (syntax-match e
      [(? function-name? f) (function-pointer f)]
      [(? identifier? x) (read-place (variable-place x env) e)]
      [('#%datum d) (literal e (syntax-e d))]
      [('quote ('c-string s)) (string-literal (syntax-e s))]
      [('quote ('c-sizeof t)) (cons 'lit (size-of (complete! (parse-type t) t)))]
      [('quote ('c-offsetof t f))
       (let ([ty (parse-type t)])
         (unless (struct-type? ty) (c-error t "~s is not a struct" (shown ty)))
         (cons 'lit (caddr (field-of ty f))))]
      [('#%app ('quote ('c-op o)) arg ...) (check-op e (syntax-e o) arg env)]
      [('#%app ('quote ('c-cast t)) x) (check-cast t x env)]
      [('#%app ('quote ('c-set!)) place v) (check-set place v env hint)]
      [('#%app ('quote ('c-update o)) place v) (check-update e (syntax-e o) place v env hint)]
      [('quote ('c-function f)) (function-pointer f)]
      [('#%app ('quote ('c-addr)) place) (let ([p (check-place place env)]) (cons (list 'ptr (car p)) (address p place)))]
      [('#%app ('quote ('c-while)) c body step ...) (check-while c body step env)]
      [('#%app ('quote ('c-break))) (jump e car)]
      [('#%app ('quote ('c-continue))) (jump e cdr)]
      [('#%app ('quote ('c-deref)) . _) (read-place (check-place e env) e)]
      [('#%app ('quote ('c-arrow _)) . _) (read-place (check-place e env) e)]
      [('#%app ('quote _) . _) (c-error e "bad syntax")]
      [('#%app f arg ...)
       (let* ([c (callee f env)] [r (cadr (car c))])
         (if (struct-type? r)
             ;; Its struct goes in the frame.
             (cons r (call e f c arg env (address (frame-place r (frame-slot! r)) e)))
             (cons (promoted r) (call e f c arg env #f))))]
      [('let (b ...) body ...) (check-let e b body env hint)]
      [('if c a) (cons 'void #`(if #,(truth (check c env) c) #,(as-void (check a env 'void))))]
      [('if c a b)
       (let* ([t (truth (check c env) c)] [ra (check a env hint)] [rb (check b env hint)]
              [ty (promoted (settled-for (join (car ra) (car rb)) hint))])
         (cons ty #`(if #,t #,(as ra ty a) #,(as rb ty b))))]
      [('begin body ...) (check-sequence e body env hint)]
      [('return) (unless (eq? result 'void) (c-error e "expected a value to return")) (cons 'none (if frame #`(begin (set! sp #,(cdr frame)) (return)) e))]
      [('return v)
       (when (eq? result 'void) (c-error e "this function returns no value"))
       (cons 'none #`(return #,(leave (if (struct-type? result) (result-value v env) (cons result (expect v result env))))))]
      [('memory.size) (cons 'i32 e)]
      [('memory.grow n) (cons 'i32 #`(memory.grow #,(expect n 'i32 env)))]
      [('memory.copy d s n) (cons 'void #`(memory.copy #,(address-value d env) #,(address-value s env) #,(expect n 'i32 env)))]
      [('memory.fill d v n) (cons 'void #`(memory.fill #,(address-value d env) #,(expect v 'i32 env) #,(expect n 'i32 env)))]
      [_ (c-error e "this is not C code")]))

  ;; forms, a body: its value is the last's, and the others' are dropped.
  (define (check-sequence where forms env hint)
    (cond [(null? forms) (cons 'void #'(nop))]
          [(null? (cdr forms)) (check (car forms) env hint)]
          [else (let* ([codes (map (lambda (f) (as-void (check f env 'void))) (take forms (- (length forms) 1)))]
                       [r (settle (check (last forms) env hint) hint (last forms))])
                  (cons (car r) (at where #`(begin #,@codes #,(cdr r)))))]))

  (define (literal e d)
    (cond [(integer? d) (cons 'lit d)]
          [(number? d) (cons 'flit d)]
          [(char? d) (cons 'lit (char->integer d))]
          [(boolean? d) (cons 'lit (if d 1 0))]
          [else (c-error e "~s is not a C literal" d)]))

  ;; A let: each variable's type is the one its property gives, or its
  ;; value's. A variable in the frame is given its value first, and the
  ;; others by the kernel's let.
  (define (check-let e bindings body env hint)
    (let* ([vs (map (lambda (b) (syntax-match b [(x init) (let-variable x init env)])) bindings)]
           [r (settle (check-sequence e body (append (map car vs) env) hint) hint e)]
           [code #`(let (#,@(filter (lambda (x) x) (map caddr vs))) #,(cdr r))])
      (cons (car r) (let ([stores (filter (lambda (x) x) (map cadr vs))]) (if (null? stores) code #`(begin #,@stores #,code))))))

  ;; Let variable x, whose value is init's: (entry store binding), its env
  ;; entry, and either the code that puts its value in memory, if any, or
  ;; its kernel binding. An array or struct declared [x T] is not set, as
  ;; in C; a number or pointer is 0.
  (define (let-variable x init env)
    (let* ([declared (syntax-property x 'c-type)] [key (k:local-binding x)]
           [zero? (syntax-match init [('quote ('c-zero)) #t] [_ #f])]
           ;; A call that returns a struct is given the variable's bytes to
           ;; put it in, so it is not checked here.
           [call (and (not declared) (syntax-match init [('#%app (? struct-call? f) . _) (cadr (function-type f))] [_ #f]))]
           [r (and (not zero?) (not (aggregate? declared)) (not call) (check init env declared))]
           [t (cond [declared (complete! declared x)] [call call] [(struct-type? (car r)) (car r)] [else (scalar! (settled-type (car r)) x)])]
           [value (lambda (stored) (cond [zero? (constant 0 t x)] [stored (convert r t init #t)] [else (convert r t init)]))]
           ;; The code that puts an array's or struct's value at dst.
           [put (lambda (dst) (if r (copy-bytes dst (cdr r) (size-of t)) (as-void (copy-into dst init t env))))])
      (cond [(eqv? key returned)
             (unless (equal? t result) (c-error x "~a is returned, so it is a ~s, not a ~s" (syntax-e x) (shown result) (shown t)))
             (list (list key t 'result) (and (not zero?) (put to)) #f)]
            [(or (aggregate? t) (memv key addressed))
             (let* ([o (frame-slot! t)] [p (frame-place t o)])
               (list (list key t o)
                     (cond [(not (aggregate? t)) (store t (car frame) o (value #t))]
                           [zero? #f]
                           [else (put (address p x))])
                     #f))]
            [else (list (list key t) #f #`[#,x #,(syn (kernel-type t)) #,(value #f)])])))

  ;; ---- calls ----

  ;; What the head f of a call calls: (sig . code), sig the function's
  ;; types, ((T ...) R), and code #f if f names a function, a C function,
  ;; whose fact gives its types, or a kernel function of numbers, or else
  ;; the code of the function pointer f's value.
  (define (callee f env)
    (if (function-name? f)
        (cons (function-type f) #f)
        (let ([r (check f env)])
          (unless (fn-type? (car r)) (c-error f "expected a function, got ~s" (shown (car r))))
          (cons (cdr (car r)) (cdr r)))))

  ;; The code of a call of callee c, which head f gives; to, if its result
  ;; is a struct, the address it goes to, which the call returns. A struct
  ;; argument is the address of a copy the caller makes in its frame, as
  ;; C's is, and of the struct itself if a call returned it.
  (define (call e f c args env to)
    (let* ([ps (car (car c))]
           [as (append (if to (list to) '())
                       (map (lambda (a p)
                              (if (struct-type? p)
                                  (cdr (copy-into (address (frame-place p (frame-slot! p)) a) a p env))
                                  (expect a p env)))
                            args ps))])
      (unless (= (length ps) (length args))
        (c-error e "~a takes ~a argument~a, got ~a" (syntax->datum (written f)) (length ps) (if (= (length ps) 1) "" "s") (length args)))
      (if (cdr c)
          #`(call-indirect #,(syn (signature (car c))) #,(cdr c) #,@as)
          #`(#%app #,f #,@as))))

  ;; The kernel signature of a function of types sig, ((T ...) R).
  (define (signature sig)
    (let ([r (cadr sig)])
      (append (map kernel-type (if (struct-type? r) (cons 'i32 (car sig)) (car sig))) '(->)
              (if (eq? r 'void) '() (list (kernel-type r))))))

  (define (function-name? f) (and (identifier? f) (eq? (identifier-binding-kind f) 'function)))

  ;; Function f's pointer: its index in the table, which a C function's
  ;; value holds.
  (define (function-pointer f)
    (cons (cons 'fn (function-type f)) (if (fact f 'c-function) f #`(func-index #,f))))

  (define (function-type f)
    (unless (eq? (identifier-binding-kind f) 'function) (c-error f "~a is not a function" (syntax-e f)))
    (or (fact f 'c-function)
        (let* ([sig (k:identifier-function-signature f)] [rs (cdr (memq '-> sig))])
          (for-each (lambda (t) (unless (memq t '(i32 i64 f32 f64 ->)) (c-error f "~a takes or returns ~s, which C has not" (syntax-e f) t)))
                    sig)
          (when (and (pair? rs) (pair? (cdr rs))) (c-error f "~a returns more than one value" (syntax-e f)))
          (list (take sig (- (length sig) (length rs) 1)) (if (null? rs) 'void (car rs))))))

  (define (struct-call? f)
    (and (identifier? f) (eq? (identifier-binding-kind f) 'function)
         (let ([sig (fact f 'c-function)]) (and sig (struct-type? (cadr sig))))))


  ;; What the fact of kind kind about id's definition gives, or #f.
  (define (fact id kind)
    (let ([f (findf (lambda (v) (and (pair? v) (eq? (car v) kind))) (map caddr (k:syntax-local-facts id)))])
      (and f (cdr f))))

  ;; Struct e, of type t, put at the address dst gives: (type . code),
  ;; its code giving that address, as an i32, unless e does not finish. A
  ;; call that returns the struct is given dst, and otherwise the struct
  ;; is copied from the address that is its value. dst is fresh, bytes no
  ;; one reads until this is done: a new variable's, or a copy's, or the
  ;; function's own result's.
  (define (copy-into dst e t env)
    (syntax-match e
      [('#%app (? struct-call? f) arg ...)
       (unless (equal? (cadr (function-type f)) t) (c-error e "expected ~s, got ~s" (shown t) (shown (cadr (function-type f)))))
       (cons 'i32 (call e f (callee f env) arg env dst))]
      [_ (let ([r (check e env t)] [d (fresh 'to)])
           (if (eq? (car r) 'none)
               r
               (cons 'i32 #`(let ([#,d #,dst]) #,(copy-bytes d (convert r t e) (size-of t)) #,d))))]))

  ;; Code that copies n bytes from the address src gives to dst's: loads
  ;; and stores, which the engine compiles in line, if n is small, and
  ;; otherwise memory.copy, a call into the engine.
  (define (copy-bytes dst src n)
    (if (or (= n 0) (> n 64))
        #`(memory.copy #,dst #,src #,(const 'i32 n))
        (let ([d (fresh 'd)] [s (fresh 's)])
          #`(let ([#,d #,dst] [#,s #,src])
              #,@(map (lambda (p) (store (car p) d (cdr p) (load (car p) s (cdr p)))) (pieces n))))))

  ;; n bytes in pieces, each (type . offset): 8 bytes at a time, then 4, 2
  ;; and 1.
  (define (pieces n)
    (let loop ([o 0])
      (let ([left (- n o)])
        (cond [(>= left 8) (cons (cons 'u64 o) (loop (+ o 8)))]
              [(>= left 4) (cons (cons 'u32 o) (loop (+ o 4)))]
              [(>= left 2) (cons (cons 'u16 o) (loop (+ o 2)))]
              [(>= left 1) (cons (cons 'u8 o) (loop (+ o 1)))]
              [else '()]))))

  ;; ---- places ----
  ;;
  ;; A place is (T local x), local variable x, or (T memory a o), the
  ;; bytes at the address a's code gives plus o, a count; T is its type.

  (define (check-place e env)
    (syntax-match e
      [(? identifier? x) (variable-place x env)]
      [('#%app ('quote ('c-deref)) p) (let ([r (check p env)]) (list (pointee r p) 'memory (cdr r) 0))]
      [('#%app ('quote ('c-deref)) p i) (index-place p i env)]
      [('#%app ('quote ('c-arrow f)) s) (field-place s f env)]
      [_ (c-error e "expected a place: a variable, (@ p), (@ p i) or (-> p field)")]))

  (define (place-form? e)
    (syntax-match e
      [(? identifier? _) #t]
      [('#%app ('quote ((? identifier? m) . _)) . _) (and (memq (syntax-e m) '(c-deref c-arrow)) #t)]
      [_ #f]))

  (define (variable-place x env)
    (let ([b (assv (k:local-binding x) env)])
      (cond [(and b (null? (cddr b))) (list (cadr b) 'local x)]
            [(and b (eq? (caddr b) 'at)) (list (cadr b) 'memory x 0)]
            [(and b (eq? (caddr b) 'result)) (list (cadr b) 'memory to 0)]
            [b (frame-place (cadr b) (caddr b))]
            [(and (eq? (identifier-binding-kind x) 'variable) (fact x 'c-global)) (list (car (fact x 'c-global)) 'memory x 0)]
            [(eq? (identifier-binding-kind x) 'function) (c-error x "~a is a function, not a value" (syntax-e x))]
            [else (c-error x "~a is not a C variable" (syntax-e x))])))

  (define (pointee r where)
    (unless (pointer? (car r)) (c-error where "expected a pointer, got ~s" (shown (car r))))
    (when (eq? (cadr (car r)) 'void) (c-error where "a (ptr void) points to no type: cast it"))
    (cadr (car r)))

  ;; p[i]: at i times the size past p, as an offset if i is a constant.
  (define (index-place p i env)
    (let* ([r (check p env)] [t (pointee r p)] [n (check i env)] [size (size-of (complete! t p))])
      (unless (integer-type? (car n)) (c-error i "an index is an integer, not ~s" (shown (car n))))
      (if (and (eq? (car n) 'lit) (>= (cdr n) 0))
          (list t 'memory (cdr r) (* (cdr n) size))
          (list t 'memory #`(i32.add #,(cdr r) #,(scaled n size i)) 0))))

  ;; s->f: s a pointer to a struct, or a struct, whose value is its
  ;; address; the offset of a field of a place's struct is the place's
  ;; plus its own.
  (define (field-place s f env)
    (let* ([p (and (place-form? s) (check-place s env))]
           [base (if (and p (struct-type? (car p)))
                     p
                     (let ([r (if p (read-place p s) (check s env))])
                       (cond [(struct-type? (car r)) (list (car r) 'memory (cdr r) 0)]
                             [(and (pointer? (car r)) (struct-type? (cadr (car r)))) (list (cadr (car r)) 'memory (cdr r) 0)]
                             [else (c-error s "-> takes a pointer to a struct, or a struct, not ~s" (shown (car r)))])))]
           [field (field-of (car base) f)])
      (list (cadr field) 'memory (caddr base) (+ (cadddr base) (caddr field)))))

  ;; Field f of struct type t: (f type offset).
  (define (field-of t f)
    (or (assq (syntax-e f) (caddr (layout t))) (c-error f "~a has no field ~a" (shown t) (syntax-e f))))

  ;; A place's value: an array's is the address of its first element, as
  ;; in C, and a struct's its address.
  (define (read-place p e)
    (let ([t (car p)])
      (cond [(array-type? t) (cons (list 'ptr (cadr t)) (address p e))]
            [(struct-type? t) (cons t (address p e))]
            [(eq? (cadr p) 'local) (cons (promoted t) (caddr p))]
            [else (cons (promoted t) (load t (caddr p) (cadddr p)))])))

  (define (address p where)
    (when (eq? (cadr p) 'local)
      (c-error where "~a is a local variable, not in memory: it has no address" (syntax-e (caddr p))))
    (if (= (cadddr p) 0) (caddr p) #`(i32.add #,(caddr p) #,(const 'i32 (cadddr p)))))

  (define (check-set place v env hint)
    (let* ([p (check-place place env)] [t (car p)])
      ;; A place may be read while a call runs, so a call's struct goes
      ;; first where the call puts it, and is copied.
      (cond [(struct-type? t) (cons 'void (copy-bytes (address p place) (expect v t env) (size-of t)))]
            [(array-type? t) (c-error place "an array cannot be assigned: copy it with memcpy")]
            [else (assign p (check v env t) v hint)])))

  ;; (op= place v): place's value, op v, stored in it; the address of a
  ;; place in memory is found once.
  (define (check-update e o place v env hint)
    (let* ([p (check-place place env)] [a (fresh 'a)]
           [q (if (eq? (cadr p) 'local) p (list (car p) 'memory a (cadddr p)))]
           [r (assign q (binary e o (read-place q place) (check v env)) e hint)])
      (cons (car r) (if (eq? (cadr p) 'local) (cdr r) #`(let ([#,a #,(caddr p)]) #,(cdr r))))))

  ;; r stored in place p: its value is the place's new one, unless hint
  ;; says it is not used.
  (define (assign p r where hint)
    (let ([t (car p)] [x (caddr p)])
      (cond [(eq? (cadr p) 'local)
             (let ([c (convert r t where)])
               (if (eq? hint 'void) (cons 'void #`(set! #,x #,c)) (cons (promoted t) #`(begin (set! #,x #,c) #,x))))]
            [(eq? hint 'void) (cons 'void (store t x (cadddr p) (convert r t where #t)))]
            [else (let ([v (fresh 'v)])
                    (cons (promoted t) #`(let ([#,v #,(convert r t where)]) #,(store t x (cadddr p) v) #,v)))])))

  (define (memory-op name a o . v)
    (let ([op (syn name)])
      (if (= o 0) #`(#,op #,a #,@v) #`(#,op #,a #,@v #,(syn o)))))

  (define (load t a o)
    (memory-op (case t
                 [(i8) 'i32.load8_s] [(u8) 'i32.load8_u] [(i16) 'i32.load16_s] [(u16) 'i32.load16_u]
                 [(i64 u64) 'i64.load] [(f32) 'f32.load] [(f64) 'f64.load] [else 'i32.load])
               a o))

  (define (store t a o v)
    (memory-op (case t
                 [(i8 u8) 'i32.store8] [(i16 u16) 'i32.store16] [(i64 u64) 'i64.store]
                 [(f32) 'f32.store] [(f64) 'f64.store] [else 'i32.store])
               a o v))

  ;; An address for a memory instruction: a pointer, or an integer.
  (define (address-value e env)
    (let ([r (check e env)]) (if (pointer? (car r)) (cdr r) (convert r 'i32 e))))

  ;; ---- values ----

  (define (const t n) #`(#,(syn (string->symbol (format "~a.const" t))) #,(syn n)))
  (define (op-name t name) (syn (string->symbol (format "~a.~a" (kernel-type t) name))))

  ;; r, a constant made a value of the type hint gives, or its own.
  (define (settle r hint where)
    (let ([t (settled-for (car r) hint)])
      (if (eq? t (car r)) r (cons (promoted t) (convert r t where)))))

  (define (settled-for t hint)
    (if (and hint (not (eq? hint 'void)) (memq t '(lit flit))) hint (settled-type t)))

  (define (as-void r)
    (cond [(memq (car r) '(void none)) (cdr r)]
          [(memq (car r) '(lit flit)) #'(nop)]
          [else #`(drop #,(cdr r))]))

  ;; The code of r as a value of type ty, or with none if ty is void.
  (define (as r ty where) (if (eq? ty 'void) (as-void r) (convert r ty where)))

  ;; The type of an if whose branches are of types a and b.
  (define (join a b)
    (cond [(eq? a 'none) b]
          [(eq? b 'none) a]
          [(or (eq? a 'void) (eq? b 'void)) 'void]
          [(equal? a b) a]
          [(and (arithmetic? a) (arithmetic? b)) (common a b)]
          [(and (address-type? a) (eq? b 'lit)) a]
          [(and (address-type? b) (eq? a 'lit)) b]
          [(and (pointer? a) (pointer? b) (or (eq? (cadr a) 'void) (eq? (cadr b) 'void))) '(ptr void)]
          [else 'void]))

  ;; The type two numbers of types a and b meet at: the larger, unsigned
  ;; if either is; a constant takes the other's type.
  (define (common a b)
    (cond [(eq? a 'lit) (if (eq? b 'flit) 'f64 (settled-type b))]
          [(eq? b 'lit) (common b a)]
          [(eq? a 'flit) (if (eq? b 'f32) 'f32 'f64)]
          [(eq? b 'flit) (common b a)]
          [else (let ([ranks '(i32 u32 i64 u64 f32 f64)]) (if (< (length (memq a ranks)) (length (memq b ranks))) a b))]))

  ;; An i32 that is not 0 if r's value is not 0 or null, for a condition.
  (define (truth r where)
    (let* ([r (settle r #f where)] [t (car r)])
      (cond [(or (memq t '(i32 u32)) (address-type? t)) (cdr r)]
            [(arithmetic? t) #`(#,(op-name t 'ne) #,(cdr r) #,(const (kernel-type t) 0))]
            [else (c-error where "expected a number or a pointer, got ~s" (shown t))])))

  ;; truth's, as 1 or 0.
  (define (boolean r where)
    (let ([r (settle r #f where)])
      (if (or (memq (car r) '(i32 u32)) (address-type? (car r))) #`(i32.ne #,(cdr r) (i32.const 0)) (truth r where))))

  ;; The code of r as a value of type t: C's implicit conversions. A
  ;; narrower integer is normalized, sign or zero extended, unless the
  ;; value is stored in memory, which cuts it anyway.
  (define (convert r t where . stored)
    (let ([from (car r)] [c (cdr r)] [normalize? (null? stored)])
      (cond [(eq? from 'none) c]
            [(eq? from 'void) (c-error where "this has no value, but ~s is expected" (shown t))]
            [(eq? from 'lit) (constant c t where)]
            [(eq? from 'flit) (if (float-type? t) (const t c) (numeric (const 'f64 c) 'f64 t normalize?))]
            [(or (struct-type? t) (struct-type? from))
             (unless (equal? from t) (c-error where "expected ~s, got ~s" (shown t) (shown from)))
             c]
            [(address-type? t)
             (unless (or (equal? from t) (and (pointer? from) (pointer? t) (or (eq? (cadr from) 'void) (eq? (cadr t) 'void))))
               (c-error where "expected ~s, got ~s" (shown t) (shown from)))
             c]
            [(or (address-type? from) (not (arithmetic? t))) (c-error where "expected ~s, got ~s" (shown t) (shown from))]
            [else (numeric c from t normalize?)])))

  (define (constant n t where)
    (cond [(address-type? t) (if (= n 0) (const 'i32 0) (c-error where "~a is not a pointer: cast it" n))]
          [(float-type? t) (const t n)]
          [(integer-type? t)
           (const (kernel-type t)
                  (case t
                    [(u8) (bitwise-and n 255)] [(u16) (bitwise-and n 65535)]
                    [(i8) (- (bitwise-and (+ n 128) 255) 128)] [(i16) (- (bitwise-and (+ n 32768) 65535) 32768)]
                    [else n]))]
          [else (c-error where "expected ~s, got ~a" (shown t) n)]))

  ;; Code c, a number of type from, as one of type t.
  (define (numeric c from t normalize?)
    (let* ([to (promoted t)] [kf (kernel-type from)] [kt (kernel-type to)] [signed (memq from '(i32 i64))]
           [v (cond [(eq? kf kt) c]
                    [(and (eq? kf 'i32) (eq? kt 'i64)) #`(#,(if signed #'i64.extend_i32_s #'i64.extend_i32_u) #,c)]
                    [(and (eq? kf 'i64) (eq? kt 'i32)) #`(i32.wrap_i64 #,c)]
                    [(float-type? from)
                     (if (float-type? to)
                         #`(#,(if (eq? kt 'f64) #'f64.promote_f32 #'f32.demote_f64) #,c)
                         #`(#,(op-name to (format "trunc_~a_~a" kf (if (memq to '(i32 i64)) 's 'u))) #,c))]
                    [else #`(#,(op-name to (format "convert_~a_~a" kf (if signed 's 'u))) #,c)])])
      (if normalize?
          (case t
            [(i8) #`(i32.extend8_s #,v)] [(i16) #`(i32.extend16_s #,v)]
            [(u8) #`(i32.and #,v (i32.const 255))] [(u16) #`(i32.and #,v (i32.const 65535))]
            [else v])
          v)))

  (define (check-cast t x env)
    (let* ([to (parse-type t)] [r (check x env)] [from (car r)])
      (cond [(eq? to 'void) (cons 'void (as-void r))]
            [(address-type? to)
             (cond [(eq? from 'lit) (cons to (const 'i32 (cdr r)))]
                   [(or (address-type? from) (memq from '(i32 u32))) (cons to (cdr r))]
                   [(memq from '(i64 u64)) (cons to #`(i32.wrap_i64 #,(cdr r)))]
                   [else (c-error x "cannot cast ~s to ~s" (shown from) (shown to))])]
            [(and (address-type? from) (integer-type? to)) (cons (promoted to) (numeric (cdr r) 'u32 to #t))]
            [else (cons (promoted (scalar! to t)) (convert r to x))])))

  ;; ---- operators ----

  (define (check-op e o args env)
    (let ([rs (map (lambda (a) (check a env)) args)] [n (length args)])
      (case o
        [(+ * bit-and bit-or bit-xor)
         (arity! e o (>= n 2) "two or more arguments")
         (foldl (lambda (b a) (binary e o a b)) (car rs) (cdr rs))]
        [(-)
         (arity! e o (>= n 1) "one or more arguments")
         (if (= n 1) (negate e (car rs)) (foldl (lambda (b a) (binary e o a b)) (car rs) (cdr rs)))]
        [(and or) (logical o rs args)]
        [(not) (arity! e o (= n 1) "one argument") (cons 'i32 #`(i32.eqz #,(truth (car rs) (car args))))]
        [(bit-not)
         (arity! e o (= n 1) "one argument")
         (let ([t (settled-type (car (car rs)))])
           (unless (integer-type? t) (c-error e "bit-not takes an integer, not ~s" (shown t)))
           (cons t #`(#,(op-name t 'xor) #,(convert (car rs) t e) #,(const (kernel-type t) -1))))]
        [else (arity! e o (= n 2) "two arguments") (binary e o (car rs) (cadr rs))])))

  (define (arity! e o ok what) (unless ok (c-error e "~a takes ~a" o what)))

  (define (binary e o a b)
    (let ([ta (car a)] [tb (car b)])
      (cond [(and (memq o '(+ -)) (pointer? ta) (integer-type? tb)) (offset e o a b)]
            [(and (eq? o '+) (integer-type? ta) (pointer? tb)) (offset e o b a)]
            [(and (eq? o '-) (pointer? ta) (pointer? tb))
             (unless (equal? ta tb) (c-error e "- takes pointers of one type, not ~s and ~s" (shown ta) (shown tb)))
             (let ([size (size-of (complete! (cadr ta) e))] [d #`(i32.sub #,(cdr a) #,(cdr b))])
               (cons 'i32 (if (= size 1) d #`(i32.div_s #,d #,(const 'i32 size)))))]
            [(memq o '(== != < <= > >=))
             (let ([t (cond [(address-type? ta) ta]
                            [(address-type? tb) tb]
                            [(and (arithmetic? ta) (arithmetic? tb)) (common ta tb)]
                            [else (c-error e "~a compares numbers or pointers, not ~s and ~s" o (shown ta) (shown tb))])])
               (cons 'i32 #`(#,(instruction o t) #,(convert a t e) #,(convert b t e))))]
            [(and (arithmetic? ta) (arithmetic? tb))
             (let ([t (if (memq o '(<< >>)) (settled-type ta) (common ta tb))])
               (when (and (memq o '(% bit-and bit-or bit-xor << >>)) (not (and (integer-type? t) (integer-type? tb))))
                 (c-error e "~a takes integers, not ~s and ~s" o (shown ta) (shown tb)))
               (cons t #`(#,(instruction o t) #,(convert a t e) #,(convert b t e))))]
            [else (c-error e "~a takes numbers, not ~s and ~s" o (shown ta) (shown tb))])))

  ;; The instruction for o on values of type t.
  (define (instruction o t)
    (let ([u (or (memq t '(u32 u64)) (address-type? t))] [f (float-type? t)])
      (op-name t (case o
                   [(+) 'add] [(-) 'sub] [(*) 'mul] [(/) (if f 'div (if u 'div_u 'div_s))] [(%) (if u 'rem_u 'rem_s)]
                   [(bit-and) 'and] [(bit-or) 'or] [(bit-xor) 'xor] [(<<) 'shl] [(>>) (if u 'shr_u 'shr_s)]
                   [(==) 'eq] [(!=) 'ne]
                   [(<) (if f 'lt (if u 'lt_u 'lt_s))] [(<=) (if f 'le (if u 'le_u 'le_s))]
                   [(>) (if f 'gt (if u 'gt_u 'gt_s))] [(>=) (if f 'ge (if u 'ge_u 'ge_s))]))))

  ;; Pointer p plus or minus integer n, scaled by the size p points to.
  (define (offset e o p n)
    (cons (car p) #`(#,(instruction o 'i32) #,(cdr p) #,(scaled n (size-of (complete! (cadr (car p)) e)) e))))

  ;; The code of integer n times size, an i32.
  (define (scaled n size where)
    (if (eq? (car n) 'lit)
        (const 'i32 (* (cdr n) size))
        (let ([i (convert n 'i32 where)]) (if (= size 1) i #`(i32.mul #,i #,(const 'i32 size))))))

  (define (negate e r)
    (let ([t (car r)])
      (cond [(memq t '(lit flit)) (cons t (- (cdr r)))]
            [(float-type? t) (cons t #`(#,(op-name t 'neg) #,(cdr r)))]
            [(integer-type? t) (cons t #`(#,(op-name t 'sub) #,(const (kernel-type t) 0) #,(cdr r)))]
            [else (c-error e "- takes a number, not ~s" (shown t))])))

  ;; and, or: each value tested in turn, 1 or 0.
  (define (logical o rs args)
    (cond [(null? rs) (cons 'lit (if (eq? o 'and) 1 0))]
          [(null? (cdr rs)) (cons 'i32 (boolean (car rs) (car args)))]
          [else (let ([t (truth (car rs) (car args))] [rest (cdr (logical o (cdr rs) (cdr args)))])
                  (cons 'i32 (if (eq? o 'and) #`(if #,t #,rest (i32.const 0)) #`(if #,t (i32.const 1) #,rest))))]))

  ;; ---- control ----

  (define (check-while c body step env)
    (let* ([brk (fresh 'break)] [cont (fresh 'continue)] [top (fresh 'loop)]
           [t (truth (check c env) c)]
           [b (let ([l0 loops])
                (dynamic-wind (lambda () (set! loops (cons (cons brk cont) loops)))
                              (lambda () (as-void (check body env 'void)))
                              (lambda () (set! loops l0))))]
           [s (map (lambda (x) (as-void (check x env 'void))) step)])
      (cons 'void #`(block #,brk (loop #,top (br-if #,brk (i32.eqz #,t)) (block #,cont #,b) #,@s (br #,top))))))

  ;; break or continue: a branch to the label which of the innermost loop's.
  (define (jump e which)
    (when (null? loops) (c-error e "not in a loop"))
    (cons 'none #`(br #,(which (car loops)))))

  ;; ---- string literals ----
  ;;
  ;; A string literal is a global, lifted, whose bytes, followed by a 0,
  ;; the module stores when it starts, eight at a time; one per string per
  ;; module, the name kept as the module sees it (spec 2.3).

  (define strings (make-hash))

  (define (string-literal s)
    (let ([known (hash-ref strings s #f)])
      (cons '(ptr u8)
            (if known
                (k:syntax-local-introduce known)
                (let* ([bs (bytes-append (string->bytes/utf-8 s) (bytes 0))] [n (bytes-length bs)] [g (fresh 'string)] [p (fresh 'p)])
                  (syntax-local-lift-definition
                   #`(global #,g (mut i32)
                             (let ([#,p (sbrk #,(syn n))])
                               #,@(let loop ([i 0])
                                    (cond [(<= (+ i 8) n) (cons (store 'u64 p i (const 'i64 (word bs i))) (loop (+ i 8)))]
                                          [(< i n) (cons (store 'u8 p i (const 'i32 (bytes-ref bs i))) (loop (+ i 1)))]
                                          [else '()]))
                               #,p)))
                  (hash-set! strings s (k:syntax-local-introduce g))
                  g)))))

  ;; The 8 bytes of bs from i, little-endian.
  (define (word bs i)
    (let loop ([j 7] [w 0]) (if (< j 0) w (loop (- j 1) (+ (* w 256) (bytes-ref bs (+ i j))))))))

