;; Lifecycle: example. The C example's allocator, arenas and memory
;; functions, written in its C (lang.sub). The allocator is K&R's (The C Programming
;; Language, section 8.7): the free blocks are a circular list in address
;; order, from which malloc takes the first that is large enough, and to
;; which free gives a block back, joining it to the free blocks on either
;; side that it touches. When no block is large enough, malloc takes more
;; memory from sbrk, at least 8 KiB. Each block starts with a header, and
;; its size counts headers.
;;
;; An arena gives out memory by moving a pointer past it, in chunks of 64
;; KiB or more from malloc, which arena-free frees all at once. (new a T)
;; is a new T in arena a.

(require-unqualified c "lang.sub")
(require print "../../lib/print.sub" write-bytes)

(provide malloc calloc realloc free memcpy memset strlen print-string arena make-arena arena-alloc arena-free new)

(memory from c)
(table from c)

(struct header [next (ptr header)] [size u32])

;; The list's own block, of size 0, and the block where the last search
;; ended, 0 until malloc first runs.
(define base header)
(define freep (ptr header) 0)

(define (malloc [n u32]) -> (ptr void)
  (let ([units (+ (/ (+ n (sizeof header) -1) (sizeof header)) 1)] [prev freep])
    (when (== prev 0)
      (set! (-> base next) (& base))
      (set! freep (& base))
      (set! prev freep))
    (let ([p (-> prev next)])
      (while 1
        (when (>= (-> p size) units)
          (if (== (-> p size) units)
              (set! (-> prev next) (-> p next))
              (begin
                (-= (-> p size) units)
                (+= p (-> p size))
                (set! (-> p size) units)))
          (set! freep prev)
          (return (+ p 1)))
        (when (== p freep)
          (set! p (more-memory units))
          (when (== p 0) (return 0)))
        (set! prev p)
        (set! p (-> p next))))
    0))

;; At least units more headers' worth of free memory, from sbrk: the free
;; block before them, or 0 if memory cannot grow.
(define (more-memory [units u32]) -> (ptr header)
  (let* ([n (if (< units 1024) 1024 units)] [p (cast (ptr header) (sbrk (* n (sizeof header))))])
    (if (== p 0)
        0
        (begin (set! (-> p size) n) (free (+ p 1)) freep))))

(define (free [block (ptr void)])
  (when (!= block 0)
    (let ([b (- (cast (ptr header) block) 1)] [p freep])
      ;; p, the free block after which b goes: b is between p and the next,
      ;; or past the list's ends.
      (while (not (and (> b p) (< b (-> p next))))
        (when (and (>= p (-> p next)) (or (> b p) (< b (-> p next))))
          (break))
        (set! p (-> p next)))
      (if (== (+ b (-> b size)) (-> p next))
          (begin
            (+= (-> b size) (-> p next size))
            (set! (-> b next) (-> p next next)))
          (set! (-> b next) (-> p next)))
      (if (== (+ p (-> p size)) b)
          (begin
            (+= (-> p size) (-> b size))
            (set! (-> p next) (-> b next)))
          (set! (-> p next) b))
      (set! freep p))))

(define (calloc [count u32] [size u32]) -> (ptr void)
  (let ([p (malloc (* count size))])
    (when (!= p 0) (memset p 0 (* count size)))
    p))

;; A block of n bytes holding the first n of block's, which is freed.
(define (realloc [block (ptr void)] [n u32]) -> (ptr void)
  (if (== block 0)
      (malloc n)
      (let ([old (* (- (-> (- (cast (ptr header) block) 1) size) 1) (sizeof header))] [p (malloc n)])
        (when (!= p 0)
          (memcpy p block (if (< n old) n old))
          (free block))
        p)))

(define (memcpy [to (ptr void)] [from (ptr void)] [n u32]) -> (ptr void)
  (memory.copy to from n)
  to)

(define (memset [to (ptr void)] [byte i32] [n u32]) -> (ptr void)
  (memory.fill to byte n)
  to)

(define (strlen [s (ptr u8)]) -> u32
  (let ([p s])
    (while (!= (@ p) 0) (+= p 1))
    (- p s)))

(define (print-string [s (ptr u8)])
  (print:write-bytes (cast i32 s) (strlen s)))

;; ---- arenas ----

;; A chunk's header, before its bytes: the chunk before it.
(struct chunk [previous (ptr chunk)] [size u32])

;; An arena: its last chunk, and the part of it not yet given out.
(struct arena [last (ptr chunk)] [next (ptr u8)] [end (ptr u8)])

(define (make-arena) -> arena
  (let ([a arena])
    (set! (-> a last) 0)
    (set! (-> a next) 0)
    (set! (-> a end) 0)
    a))

;; n bytes, rounded up to a multiple of 8.
(define (arena-alloc [a (ptr arena)] [n u32]) -> (ptr void)
  (let ([size (bit-and (+ n 7) -8)])
    (when (> size (- (-> a end) (-> a next)))
      (arena-grow a size))
    (let ([p (-> a next)])
      (+= (-> a next) size)
      p)))

(define (arena-grow [a (ptr arena)] [n u32])
  (let* ([size (if (> n 65536) n 65536)]
         [c (cast (ptr chunk) (malloc (+ size (sizeof chunk))))])
    (set! (-> c previous) (-> a last))
    (set! (-> c size) size)
    (set! (-> a last) c)
    (set! (-> a next) (cast (ptr u8) (+ c 1)))
    (set! (-> a end) (+ (-> a next) size))))

(define (arena-free [a (ptr arena)])
  (let ([c (-> a last)])
    (while (!= c 0)
      (let ([previous (-> c previous)])
        (free c)
        (set! c previous))))
  (set! (-> a last) 0)
  (set! (-> a next) 0)
  (set! (-> a end) 0))

(begin-for-syntax
  (require-unqualified substrate "../../lib/substrate.sub")
  ;; (new a T): (cast (ptr T) (arena-alloc a (sizeof T))).
  (define (new-form s)
    (syntax-match s [(_ a t) #`(cast (ptr #,t) (arena-alloc #,a (sizeof #,t)))])))

(define-syntax new new-form)
