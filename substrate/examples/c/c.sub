;; Lifecycle: example. The C example: its language (lang.sub), its
;; allocator and memory functions (runtime.sub) and its math (math.sub),
;; for a module to take with require-unqualified, and their memory and
;; table, which a module shares with (memory from c) and (table from c).
(require-unqualified lang "lang.sub")
(require-unqualified runtime "runtime.sub")
(require-unqualified math "math.sub")

(provide (all-from-out lang) (all-from-out runtime) (all-from-out math))

(memory from lang)
(table from lang)
