;; Lifecycle: example. The C example: its language (lang.sub) and its
;; allocator and memory functions (runtime.sub), for a module to take with
;; require-unqualified, and their memory and table, which a module shares
;; with (memory from c) and (table from c).
(require-unqualified lang "lang.sub")
(require-unqualified runtime "runtime.sub")

(provide (all-from-out lang) (all-from-out runtime))

(memory from lang)
(table from lang)
