;; Lifecycle: benchmark. Recursive fib: calls and integer arithmetic.
(require-unqualified c "../c.sub")
(require print "../../../lib/print.sub" write-i64 newline)
(memory from c)
(table from c)

(define (fib [n i32]) -> i32 (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))

(define (main) (write-i64 (fib 38)) (newline))
