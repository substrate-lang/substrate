;; Lifecycle: benchmark. The Mandelbrot set on a 600 by 600 grid, at most
;; 100 iterations a point, with complex numbers as structs passed and
;; returned by value: each call copies its structs through frames.
(require-unqualified c "../c.sub")
(require print "../../../lib/print.sub" write-i64 newline)
(memory from c)
(table from c)

(struct complex [re f64] [im f64])

(define (make [re f64] [im f64]) -> complex
  (let ([z complex]) (set! (-> z re) re) (set! (-> z im) im) z))

(define (add [a complex] [b complex]) -> complex
  (make (+ (-> a re) (-> b re)) (+ (-> a im) (-> b im))))

(define (mul [a complex] [b complex]) -> complex
  (make (- (* (-> a re) (-> b re)) (* (-> a im) (-> b im))) (+ (* (-> a re) (-> b im)) (* (-> a im) (-> b re)))))

(define (magnitude2 [a complex]) -> f64 (+ (* (-> a re) (-> a re)) (* (-> a im) (-> a im))))

;; How many points stay within 2 of 0 for limit iterations of z^2 + c.
(define (mandelbrot [size i32] [limit i32]) -> i32
  (let ([inside 0])
    (for ([y 0]) (< y size) (+= y 1)
      (for ([x 0]) (< x size) (+= x 1)
        (let ([c complex (make (- (/ (* 3.0 x) size) 2.0) (- (/ (* 3.0 y) size) 1.5))]
              [z complex (make 0.0 0.0)]
              [k 0])
          (while (and (< k limit) (<= (magnitude2 z) 4.0))
            (set! z (add (mul z z) c))
            (+= k 1))
          (when (== k limit) (+= inside 1)))))
    inside))

(define (main) (write-i64 (mandelbrot 600 100)) (newline))
