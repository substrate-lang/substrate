;; A typed language on the kernel (examples/typed/typed.sub): its
;; #%linklet checks the types, and lowers its lambdas to structs of closure
;; types, one per function type. Functions from another module
;; (typed/numbers.sub) come with their types. A generic is monomorphized:
;; each use at new types makes an instance, a function of this module's.
;; A data type's values are made by its constructors and taken apart by
;; match; its type may have type parameters too. A trait's methods, and
;; its associated types, are given for a type by an impl, written with the
;; trait or with the type, and a generic whose type parameter needs one
;; says so.
(require-unqualified typed "typed/typed.sub")
(require num "typed/numbers.sub" square compose twice iterate Both swap)
(require e "typed/eq.sub" Eq eq ne)

(define (make-adder [n : Int]) : (-> Int Int)
  (lambda ([x : Int]) (+ x n)))

;; Lambdas in lambdas: the inner one captures x, a parameter of the outer,
;; and k, which both capture.
(define (nested [n : Int]) : Int
  (let ([k 10])
    ((lambda ([x : Int]) ((lambda ([y : Int]) (+ (+ x y) k)) n)) 1)))

;; Generics.
(define #:forall (T) (id [x : T]) : T x)
(define #:forall (A B) (first [a : A] [b : B]) : A a)
;; A lambda that captures a value of the type parameter's type.
(define #:forall (T) (always [x : T]) : (-> Int T) (lambda ([n : Int]) x))

;; Data types.
(data Shape [Circle Int] [Rect Int Int])
(data (Option T) [None] [Some T])
(data (List T) [Nil] [Cons T (List T)])

(define (area [s : Shape]) : Int
  (match s [(Circle r) (* 3 (* r r))] [(Rect w h) (* w h)]))

(define (sum [l : (List Int)]) : Int
  (match l [Nil 0] [(Cons x rest) (+ x (sum rest))]))

(define #:forall (T) (length-of [l : (List T)]) : Int
  (match l [Nil 0] [(Cons _ rest) (+ 1 (length-of rest))]))

;; Nil alone is a (List B): its place, the result, says so.
(define #:forall (A B) (map-list [f : (-> A B)] [l : (List A)]) : (List B)
  (match l [Nil Nil] [(Cons x rest) (Cons (f x) (map-list f rest))]))

(define #:forall (T) (head [l : (List T)]) : (Option T)
  (match l [(Cons x _) (Some x)] [_ None]))

;; Traits. List's impl of Eq, from typed/eq.sub, is here with List; it
;; needs T's.
(impl #:forall ((T Eq)) (Eq (List T))
  [eq (a b) (match a
              [Nil (match b [Nil #t] [_ #f])]
              [(Cons x xs) (match b [(Cons y ys) (if (eq x y) (eq xs ys) #f)] [_ #f])])])

(define #:forall ((T Eq)) (member [x : T] [l : (List T)]) : Bool
  (match l [Nil #f] [(Cons y rest) (if (eq x y) #t (member x rest))]))

;; A method whose type is found from the type its place expects.
(trait (Zero T) [zero : (-> T)])
(impl (Zero Int) [zero () 0])
(impl #:forall (T) (Zero (List T)) [zero () Nil])

;; An associated type: each impl of Container says what its type's
;; elements are, and (Elem C) is that type for C.
(trait (Container C)
  (type Elem)
  [front : (-> C (Option Elem))])
(impl #:forall (T) (Container (List T)) (type Elem T) [front (l) (head l)])
(impl (Container Shape) (type Elem Int) [front (s) (Some (area s))])

(define #:forall ((C Container)) (front-or [c : C] [d : (Elem C)]) : (Elem C)
  (match (front c) [(Some x) x] [None d]))

(define (run) : Int
  (let ([add3 (make-adder 3)]
        [double (lambda ([x : Int]) (* x 2))]
        [l (Cons 1 (Cons 2 (Cons 3 Nil)))])
    (print (add3 4))
    (print ((compose add3 double) 5))
    (print (twice square 3))
    (print (nested 5))
    (print (id 7))                        ; id<Int>
    (print (if (id #t) 1 0))              ; id<Bool>
    (print ((id add3) 1))                 ; id<(-> Int Int)>
    (print (first 8 #f))                  ; first<Int Bool>
    (print ((always 9) 0))                ; always<Int>
    (print (((always (always 2)) 0) 0))   ; always<(-> Int Int)>, whose type holds always<Int>'s
    (print (iterate 3 double 1))          ; iterate<Int>, from typed/numbers.sub
    (print (iterate 2 (inst id Int) 5))   ; id<Int> as a value, given its type
    (print (area (Rect 2 5)))
    (print (sum (map-list double l)))     ; map-list<Int Int>
    (print (length-of (map-list (lambda ([x : Int]) (< x 2)) l)))   ; map-list<Int Bool>, length-of<Bool>
    (print (match (head l) [(Some x) x] [None 0]))
    (print (match (head (inst Nil Int)) [(Some x) x] [None 0]))    ; Nil's type, given
    (print (match (swap (Both 4 #t)) [(Both b n) (if b n 0)]))     ; swap<Int Bool>, from typed/numbers.sub
    (print (if (member 3 l) 1 0))                                   ; member<Int>, with Int's eq
    (print (if (member (Cons 2 Nil) (Cons l (Cons (Cons 2 Nil) Nil))) 1 0))   ; with (List Int)'s, which uses Int's
    (print (if (eq (swap (Both 1 #t)) (Both #t 1)) 1 0))            ; (Pair Bool Int)'s, from typed/numbers.sub
    (print (if (ne l (map-list double l)) 1 0))                     ; ne, from typed/eq.sub
    (print (+ (zero) (length-of ((inst zero (List Int))))))         ; Int's zero, then (List Int)'s, as a value
    (print (front-or l 0))                                          ; (Elem (List Int)) is Int
    (print (front-or (Rect 2 5) 0))                                 ; and so is (Elem Shape)
    (print (if (front-or (map-list (lambda ([x : Int]) (< x 2)) l) #f) 1 0))   ; (Elem (List Bool)) is Bool
    (print (if (= (* 2 3) 6) (add3 0) 0))))

(func (main) (drop (run)))
