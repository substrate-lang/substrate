;; A C-like language on the kernel (examples/c/lang.sub), whose programs
;; keep their data in linear memory, which malloc and free give out
;; (examples/c/runtime.sub), and use no GC: this program is freestanding
;; (spec 3.4). A list, an array that grows and is sorted in place, a
;; static table, strings, and C's arithmetic on its types.
(require-unqualified c "c/c.sub")
(require print "../lib/print.sub" write-int write-i64 write-u64 write-byte newline)
(memory from print)
(freestanding)

(struct node [value i32] [next (ptr node)])

;; The list n, n-1, ..., 1.
(define (countdown [n i32]) -> (ptr node)
  (let ([list (ptr node) 0])
    (for ([i i32 1]) (<= i n) (set! i (+ i 1))
      (let ([cell (cast (ptr node) (malloc (sizeof node)))])
        (set! (-> cell value) i)
        (set! (-> cell next) list)
        (set! list cell)))
    list))

(define (sum [list (ptr node)]) -> i32
  (let ([s 0])
    (while (!= list 0)
      (set! s (+ s (-> list value)))
      (set! list (-> list next)))
    s))

(define (free-list [list (ptr node)])
  (while (!= list 0)
    (let ([next (-> list next)])
      (free list)
      (set! list next))))

;; An array that grows: its items, how many there are, and how many fit.
(struct vec [items (ptr i32)] [count u32] [capacity u32])

(define (push [v (ptr vec)] [x i32])
  (when (== (-> v count) (-> v capacity))
    (set! (-> v capacity) (if (== (-> v capacity) 0) 4 (* 2 (-> v capacity))))
    (set! (-> v items) (realloc (-> v items) (* (-> v capacity) (sizeof i32)))))
  (set! (@ (-> v items) (-> v count)) x)
  (set! (-> v count) (+ (-> v count) 1)))

(define (sort [a (ptr i32)] [n u32])
  (for ([i u32 1]) (< i n) (set! i (+ i 1))
    (let ([x (@ a i)] [j i])
      (while (and (> j 0) (> (@ a (- j 1)) x))
        (set! (@ a j) (@ a (- j 1)))
        (set! j (- j 1)))
      (set! (@ a j) x))))

(define (print-vec [v (ptr vec)])
  (for ([i u32 0]) (< i (-> v count)) (set! i (+ i 1))
    (when (> i 0) (write-byte 32))
    (write-int (@ (-> v items) i)))
  (newline))

;; The first 90 Fibonacci numbers, in static memory.
(define fib (array u64 90))

(define (fill-fib)
  (set! (@ fib 1) 1)
  (for ([i 2]) (< i 90) (set! i (+ i 1))
    (set! (@ fib i) (+ (@ fib (- i 1)) (@ fib (- i 2))))))

;; The first prime that is at least n: continue skips a candidate once a
;; divisor is found, and break ends the search.
(define (next-prime [n u32]) -> u32
  (let ([found u32 0])
    (for ([k n]) 1 (set! k (+ k 1))
      (let ([d u32 2] [composite 0])
        (while (<= (* d d) k)
          (when (== (% k d) 0) (set! composite 1) (break))
          (set! d (+ d 1)))
        (when composite (continue))
        (set! found k)
        (break)))
    found))

(define greeting (ptr u8) "hello, ")

(define (main)
  (print-string greeting)
  (print-string "world\n")
  (let ([list (countdown 100)])
    (write-int (sum list)) (newline)
    (free-list list))
  (let ([v (cast (ptr vec) (calloc 1 (sizeof vec)))])
    (for ([i 0]) (< i 10) (set! i (+ i 1))
      (push v (% (* i 7919) 23)))
    (print-vec v)
    (sort (-> v items) (-> v count))
    (print-vec v)
    (write-int (cast i32 (-> v capacity))) (newline))
  (fill-fib)
  (write-u64 (@ fib 89)) (newline)
  (write-int (next-prime 1000000)) (newline)
  ;; C's arithmetic: signed and unsigned division and shifts, an 8-bit
  ;; variable that wraps, 64 bits, and a double.
  (let ([a i32 -7] [b u32 7] [c u8 250])
    (write-int (/ a 2)) (write-byte 32)
    (write-int (% a 2)) (write-byte 32)
    (write-u64 (cast u64 (/ (cast u32 a) 2))) (write-byte 32)
    (set! c (+ c 10))
    (write-int c) (write-byte 32)
    (write-int (>> a 1)) (write-byte 32)
    (write-int (cast i32 (>> (cast u32 a) 28))) (write-byte 32)
    (write-i64 (* (cast i64 100000) 100000)) (write-byte 32)
    (write-int (cast i32 (* 2.5 b))) (newline)))
