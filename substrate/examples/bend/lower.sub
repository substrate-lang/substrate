;; Lifecycle: example. The Bend example's lowering (bend.sub): a module's
;; checked definitions, as core.sub's validate! gives them, to kernel code,
;; so that the module runs. It follows Bend's compiler (bend2/comp.ts, its
;; JavaScript lane: js_expr, js_func) and makes kernel code as data, which
;; bend.sub turns into syntax: a symbol in it means what it means in
;; bend.sub, whose runtime.sub is rt; syntax in it, a definition's code,
;; is kept as it is.
;;
;; Every value is an eqref. A datatype's value is a struct: a family is a
;; recursion group of a base and a final subtype per constructor, whose
;; fields, f0 ..., are the constructor's live ones, so a match tests which
;; constructor a value has with ref.test (spec 5.1). A function value is a
;; closure: a struct whose first field is its code, a function of the
;; closure and one argument, and whose others are what it captured. What
;; is erased, a binder, argument or field of quantity -, a type, a proof's
;; rewrite, is left out. A definition is a function of its live
;; parameters; an application of it to that many live arguments is a
;; direct call, and any other, as of a variable, applies closures, one
;; argument at a time: a definition given fewer is made a closure first,
;; by eta-expansion.
;;
;; A checked term is annotated with each node's type, which says what is
;; erased. Its binders are opened with probes, variables of ids of their
;; own, which the function being made maps to its locals.

(require-unqualified substrate "../../lib/substrate.sub")
(require-unqualified core "core.sub")

(provide lower-module)

;; ---- the module ----

(define book #f)
(define code-of #f)
(define forms '())
(define types '())
(define used (make-hasheq))
(define families (make-hasheq))
(define closure-types #f)
(define printers (make-hash))
(define memo (make-hash))
(define probes 0)
(define where #f)

;; The code of a module's definitions defs, each (k n T e id at), and of
;; its prints, each (e T at), checked against book, as (forms funcs
;; prints): the forms the code needs, first; each definition's function,
;; named id, in order; and each print's code, which writes the value of e,
;; of type T. at is where each is, for errors. code-of gives a
;; definition's function, an identifier, by name.
(define (lower-module b defs prints code)
  (set! book b)
  (set! code-of code)
  (let* ([funcs (map (lambda (d) (set! where (list-ref d 5)) (def-func (car d) (list-ref d 4) (caddr d) (cadddr d))) defs)]
         [writes (map (lambda (p) (set! where (caddr p)) (print-code (car p) (cadr p))) prints)])
    (list (append (reverse types) (reverse forms)) funcs writes)))

(define (lift! form) (set! forms (cons form forms)))

;; A module-level name that no other this module made has, from base.
(define (fresh-global base)
  (let loop ([n 0])
    (let ([s (string->symbol (if (= n 0) (format "~a" base) (format "~a.~a" base n)))])
      (if (hash-ref used s #f) (loop (+ n 1)) (begin (hash-set! used s #t) s)))))

(define (field j) (string->symbol (format "f~a" j)))
(define (capture j) (string->symbol (format "c~a" j)))

(define nothing '(ref.null eq))

(define (memoized key f) (or (hash-ref memo key #f) (let ([v (f)]) (hash-set! memo key v) v)))

;; ---- types ----

;; The types of family k, (base variant ...), declared the first time.
(define (family-types k)
  (or (hash-ref families k #f)
      (let* ([cs (AdtD-c (book-tld book k))]
             [b (fresh-global (short k))]
             [vs (map (lambda (c) (fresh-global (format "~a.~a" (short k) (short (CtrD-k c))))) cs)])
        (hash-set! families k (cons b vs))
        (set! types (cons `(rec (type ,b (sub (struct)))
                                ,@(map (lambda (v c)
                                         `(type ,v (sub final ,b (struct ,@(map (lambda (j) `(field ,(field j) eqref))
                                                                                (range (length (live-fields (CtrD-k c)))))))))
                                       vs cs))
                          types))
        (cons b vs))))

;; The variant of constructor k.
(define (variant k)
  (let* ([fam (book-fam book k)] [cs (AdtD-c (book-tld book fam))])
    (list-ref (cdr (family-types fam)) (let loop ([cs cs] [i 0]) (if (eq? (CtrD-k (car cs)) k) i (loop (cdr cs) (+ i 1)))))))

;; The closure type and its code's type, (closure . code); and the
;; closure type of n captures.
(define (closure-type)
  (or closure-types
      (let ([c (fresh-global "closure")] [f (fresh-global "code")])
        (set! types (cons `(rec (type ,c (sub (struct (field code (ref ,f)))))
                                (type ,f (func ((ref ,c) eqref -> eqref))))
                          types))
        (set! closure-types (cons c f))
        closure-types)))

(define (closure-type-of n)
  (let ([base (closure-type)])
    (memoized (list 'closure n)
              (lambda ()
                (let ([t (fresh-global (format "closure~a" n))])
                  (set! types (cons `(type ,t (sub final ,(car base) (struct (field code (ref ,(cdr base)))
                                                                             ,@(map (lambda (j) `(field ,(capture j) eqref)) (range n)))))
                                    types))
                  t)))))

;; ---- what is live ----

(define (live? q) (not (eq? q 'none)))

;; The domains of type T, each (q k A).
(define (domains T) (car (tele-unbind book T)))

;; Constructor k's fields, each (q k A): the last of its type's domains;
;; and which are live, and the live ones.
(define (fields k)
  (memoized (list 'fields k)
            (lambda ()
              (let* ([c (book-ctr book k)] [doms (domains (CtrD-T c))])
                (list-tail doms (- (length doms) (CtrD-n c)))))))

(define (fields-live k) (map (lambda (d) (live? (car d))) (fields k)))
(define (live-fields k) (filter (lambda (d) (live? (car d))) (fields k)))

;; Which of definition k's parameters are live.
(define (params-live k)
  (memoized (list 'params k)
            (lambda ()
              (let* ([d (book-tld book k)] [doms (domains (DefD-T d))])
                (map (lambda (i) (or (>= i (length doms)) (live? (car (list-ref doms i))))) (range (DefD-n d)))))))

(define (count-live flags) (length (filter (lambda (x) x) flags)))

;; The xs whose flags are true; those past the flags are kept.
(define (keep-live xs flags)
  (cond [(null? xs) '()]
        [(null? flags) xs]
        [(car flags) (cons (car xs) (keep-live (cdr xs) (cdr flags)))]
        [else (keep-live (cdr xs) (cdr flags))]))

;; ---- functions being made ----
;;
;; A function has its locals, each probe's local, a symbol, or erased;
;; the function it is in, if it is a closure's code, whose locals it
;; captures as it uses them, each (local . outer); and the names it has
;; used.

(struct fn (parent locals [captures #:mutable] names))

(define (new-fn parent) (fn parent (make-hasheqv) '() (make-hasheq)))

(define (probe k) (set! probes (+ probes 1)) (Var k probes #f #f))

(define (local! f k)
  (let loop ([n 0])
    (let ([s (string->symbol (format "~a.~a" k n))])
      (if (hash-ref (fn-names f) s #f) (loop (+ n 1)) (begin (hash-set! (fn-names f) s #t) s)))))

(define (bind! f p v) (hash-set! (fn-locals f) (Var-i p) v))

;; A probe bound to a new local of f, as (probe . local).
(define (bound! f k) (let ([p (probe k)] [s (local! f k)]) (bind! f p s) (cons p s)))

(define (erased! f k) (let ([p (probe k)]) (bind! f p 'erased) p))

(define (lookup f p)
  (or (hash-ref (fn-locals f) (Var-i p) #f)
      (let ([outer (if (fn-parent f) (lookup (fn-parent f) p) (lower-error "a variable out of scope"))])
        (if (eq? outer 'erased)
            'erased
            (let ([c (local! f (Var-k p))])
              (set-fn-captures! f (cons (cons c outer) (fn-captures f)))
              (bind! f p c)
              c)))))

(define (lower-error message . at) (raise-syntax-error 'bend message (if (and (pair? at) (car at)) (car at) where)))

;; ---- terms ----

;; t under its annotations and rewrites, and its type, from the innermost
;; annotation, or ty: (x . type).
(define (peel t ty)
  (let loop ([x (term-force t)] [ty ty])
    (match x
      [(Ann y T _) (loop (term-force y) T)]
      [(Rwt _ _ y _) (loop (term-force y) ty)]
      [_ (cons x ty)])))

(define (ty-all ty)
  (let ([t (and ty (term-wnf book ty))])
    (if (and t (All? t)) t (lower-error "a function type for a binder"))))

;; Is x a function value: a match, or a lambda whose binder is live?
(define (function? x ty)
  (match x
    [(Mat _ _ _ _) #t]
    [(Efq _) #t]
    [(Lam _ _ _ _) (live? (All-q (ty-all ty)))]
    [_ #f]))

;; t as an expression, in function f, of type ty or its annotation's.
(define (expr f t ty)
  (let* ([p (peel t ty)] [x (car p)] [ty (cdr p)])
    (match x
      [(Var _ _ _ _) (let ([v (lookup f x)]) (if (eq? v 'erased) nothing v))]
      [(Ref _ _) (spine-expr f x)]
      [(App _ _ _) (spine-expr f x)]
      [(Ctr k xs _) `(struct.new ,(variant k) ,@(map (lambda (x) (expr f x #f)) (keep-live xs (fields-live k))))]
      [(Let _ _ _ _ _ _) (let-code f x (lambda (b) (expr f b ty)))]
      [(Hol k s) (lower-error (format "(? ~a) is a hole, which cannot run: fill it" k) (and s (datum->syntax #f (list '? k) s)))]
      [_ (cond [(function? x ty) (closure f x ty)]
               [(Lam? x) (let ([all (ty-all ty)] [p (erased! f (Lam-k x))]) (expr f ((Lam-f x) p) ((All-B all) p)))]
               [else nothing])])))

;; An application, as (head annotated-head apps), apps its App nodes,
;; innermost first.
(define (spine t)
  (let loop ([c (term-force t)] [h t] [apps '()])
    (match c
      [(App g _ _) (loop (term-force g) g (cons c apps))]
      [(Ann y _ _) (loop (term-force y) h apps)]
      [_ (list c h apps)])))

(define (spine-expr f t)
  (let* ([s (spine t)] [head (car s)] [apps (caddr s)]
         [tld (and (Ref? head) (book-tld book (Ref-k head)))]
         [def (and (DefD? tld) (DefD-v tld) tld)]
         [T (if def (DefD-T def) (let ([h (term-force (cadr s))]) (and (Ann? h) (Ann-T h))))]
         [qs (if T (map car (domains T)) '())]
         [live (keep-live apps (map (lambda (i) (or (>= i (length qs)) (live? (list-ref qs i)))) (range (length apps))))])
    (cond
      [def
       (let ([need (count-live (params-live (Ref-k head)))])
         (cond [(= (length live) need) `(#%app ,(code-of (Ref-k head)) ,@(map (lambda (a) (expr f (App-x a) #f)) live))]
               [(> (length live) need) (apply-last f live)]
               [else (expr f (eta t (tele-fill book (DefD-T def) (map App-x apps) '() #f) (- (DefD-n def) (length apps))) #f)]))]
      [(Ref? head) nothing]
      [(null? live) (expr f (cadr s) #f)]
      [else (apply-last f live)])))

;; The last live application of a spine, which applies a closure.
(define (apply-last f live)
  (let ([a (last live)] [c (local! f 'f)] [types (closure-type)])
    `(let ([,c (ref.cast (ref ,(car types)) ,(expr f (App-f a) #f))])
       (call-ref ,(cdr types) (struct.get ,(car types) code ,c) ,c ,(expr f (App-x a) #f)))))

;; t, of type T, applied to n arguments more, as lambdas of them.
(define (eta t T n)
  (if (= n 0)
      t
      (let ([all (ty-all T)])
        (Ann (Lam 'x 0 (lambda (y) (eta (App t y #f) ((All-B all) y) (- n 1))) #f) T #f))))

;; A let: its live values bound, then its body, as (code body).
(define (let-code f x code)
  (let* ([vals (map (lambda (v q) (and (live? q) (expr f v #f))) (Let-v x) (Let-q x))]
         [ps (map (lambda (k q) (if (live? q) (bound! f k) (cons (erased! f k) #f))) (Let-k x) (Let-q x))])
    `(let ,(filter (lambda (b) b) (map (lambda (p v) (and (cdr p) (list (cdr p) v))) ps vals))
       ,(code ((Let-f x) (map car ps))))))

;; A closure of x, a function value of type ty: its code lifted, a
;; function of the closure and x's argument.
(define (closure f x ty)
  (let* ([g (new-fn f)]
         [types (closure-type)]
         [self (local! g 'self)]
         [arg (local! g (if (Lam? x) (Lam-k x) 'x))]
         [b (body g x ty (list arg))]
         [caps (reverse (fn-captures g))]
         [name (fresh-global (format "~a.fn" (short current-def)))])
    (if (null? caps)
        (let ([value (fresh-global (format "~a.value" name))])
          (lift! `(func (,name [,self (ref ,(car types))] [,arg eqref]) -> eqref (type ,(cdr types)) ,b))
          (lift! `(global ,value (ref ,(car types)) (struct.new ,(car types) (ref.func ,name))))
          value)
        (let* ([t (closure-type-of (length caps))] [env (local! g 'env)])
          (lift! `(func (,name [,self (ref ,(car types))] [,arg eqref]) -> eqref (type ,(cdr types))
                    (let ([,env (ref.cast (ref ,t) ,self)])
                      (let ,(map (lambda (c j) `[,(car c) (struct.get ,t ,(capture j) ,env)]) caps (range (length caps)))
                        ,b))))
          `(struct.new ,t (ref.func ,name) ,@(map cdr caps))))))

;; The definition whose code is being made, whose name its closures'
;; functions take.
(define current-def #f)

;; t, of type ty, as the body of a function whose live arguments not yet
;; taken are args, locals: a lambda takes one, if its binder is live, and
;; a match takes its scrutinee and gives its case the constructor's live
;; fields (bend.ts's js_func).
(define (body f t ty args)
  (let* ([p (peel t ty)] [x (car p)] [ty (cdr p)])
    (cond
      [(and (null? args) (function? x ty)) (expr f x ty)]
      [(Lam? x)
       (let* ([all (ty-all ty)] [p (probe (Lam-k x))])
         (if (live? (All-q all))
             (begin (bind! f p (car args)) (body f ((Lam-f x) p) ((All-B all) p) (cdr args)))
             (begin (bind! f p 'erased) (body f ((Lam-f x) p) ((All-B all) p) args))))]
      [(Efq? x) '(unreachable)]
      [(Mat? x) (match-code f x ty args)]
      [(Let? x) (let-code f x (lambda (b) (body f b ty args)))]
      [(pair? args) (body f (eta x ty 1) ty args)]
      [else (expr f x ty)])))

;; A lambda-match's cases, (((k . h) ...) . rest), rest what the last
;; one's m is.
(define (cases t)
  (let loop ([cur t] [arms '()])
    (let ([m (term-strip cur)])
      (if (Mat? m)
          (loop (Mat-m m) (cons (cons (Mat-k m) (Mat-h m)) arms))
          (cons (reverse arms) cur)))))

(define (match-code f x ty args)
  (let* ([all (ty-all ty)]
         [adt (term-wnf book (All-A all))]
         [total (length (AdtD-c (book-adt book adt '())))]
         [cs (cases x)]
         [s (car args)]
         [bodies (map (lambda (arm) (case-code f (car arm) (cdr arm) s (cdr args))) (car cs))]
         [rest (and (< (length (car cs)) total) (body f (cdr cs) #f args))])
    (let loop ([arms (car cs)] [bodies bodies])
      (cond [(null? arms) (or rest '(unreachable))]
            [(and (null? (cdr arms)) (not rest)) (car bodies)]
            [else `(if (ref.test (ref ,(variant (car (car arms)))) ,s) ,(car bodies) ,(loop (cdr arms) (cdr bodies)))]))))

;; Case h of constructor k, for scrutinee s: its live fields bound.
(define (case-code f k h s rest)
  (let ([fs (live-fields k)])
    (if (null? fs)
        (body f h #f rest)
        (let ([c (local! f 'c)] [v (variant k)] [xs (map (lambda (d) (local! f (cadr d))) fs)])
          `(let ([,c (ref.cast (ref ,v) ,s)])
             (let ,(map (lambda (x j) `[,x (struct.get ,v ,(field j) ,c)]) xs (range (length xs)))
               ,(body f h #f (append xs rest))))))))

;; ---- definitions ----

;; Definition k's function, named id, of type T and checked value e: a
;; function of its live parameters.
(define (def-func k id T e)
  (set! current-def k)
  (let* ([f (new-fn #f)]
         [doms (domains T)]
         [params (map (lambda (i) (local! f (if (< i (length doms)) (cadr (list-ref doms i)) 'x)))
                      (keep-live (range (length (params-live k))) (params-live k)))])
    `(func (,id ,@(map (lambda (p) `[,p eqref]) params)) -> eqref
       ,(body f (term-higher e '()) T params))))

;; ---- print ----
;;
;; A print writes a value, and a newline, as the example writes terms: a
;; constructor's name and its fields, a Nat as (nat n), a proof as refl.
;; What writes a value of a type is a function made for the type, as
;; Bend's show_main makes a descriptor for its main's. A function, a type, or
;; a datatype with an erased field, or one whose type depends on another,
;; cannot be written.

;; The code of a print of checked term e, of type T.
(define (print-code e T)
  (set! current-def 'print)
  (set! printed (term-show (term-lower (term-wnf book T) 0)))
  `(begin (#%app ,(printer T) ,(expr (new-fn #f) (term-higher e '()) T)) (#%app rt:newline)))

;; The type of the value being printed, shown, for errors.
(define printed #f)

;; The function that writes values of type T.
(define (printer T)
  (let* ([t (term-wnf book T)] [key (term->datum (term-lower t 0) #f)])
    (or (hash-ref printers key #f)
        (let ([name (fresh-global "show")])
          (hash-set! printers key name)
          (lift! (printer-func name t (term-show (term-lower t 0))))
          name))))

(define (write-code s) `(#%app rt:write-string ',s))

(define (printer-func name t shown)
  (let ([refuse (lambda ()
                  (lower-error (format "a value of type ~a cannot be written: ~a is a function, a type, or a datatype with an erased or dependent field"
                                       printed (if (equal? shown printed) "it" shown))))])
    (match t
      [(Eql _ _ _ _) `(func (,name [v eqref]) ,(write-code "refl"))]
      [(ADT k xs _ _)
       (let ([adt (book-tld book k)])
         (unless (AdtD? adt) (refuse))
         (if (nat? adt)
             (let ([succ (variant (CtrD-k (cadr (AdtD-c adt))))])
               `(func (,name [v eqref])
                  (let ([n i64 (i64.const 0)] [x eqref v])
                    (block done
                      (loop next
                        (br-if done (i32.eqz (ref.test (ref ,succ) x)))
                        (set! n (i64.add n (i64.const 1)))
                        (set! x (struct.get ,succ f0 (ref.cast (ref ,succ) x)))
                        (br next)))
                    (#%app rt:write-nat n))))
             (let ([arms (map (lambda (c)
                                (let* ([fields (let ([doms (domains (tele-fill book (CtrD-T c) xs '() #f))])
                                                 (list-tail doms (- (length doms) (CtrD-n c))))]
                                       [v (variant (CtrD-k c))])
                                  (for-each (lambda (d) (unless (live? (car d)) (refuse))) fields)
                                  (cons v (if (null? fields)
                                              (write-code (short (CtrD-k c)))
                                              `(let ([c (ref.cast (ref ,v) v)])
                                                 ,(write-code (format "(~a" (short (CtrD-k c))))
                                                 ,@(apply append
                                                          (map (lambda (d j) `((#%app rt:write-byte (i32.const 32))
                                                                               (#%app ,(printer (caddr d)) (struct.get ,v ,(field j) c))))
                                                               fields (range (length fields))))
                                                 (#%app rt:write-byte (i32.const 41)))))))
                              (AdtD-c adt))])
               `(func (,name [v eqref])
                  ,(let loop ([arms arms])
                     (cond [(null? arms) '(unreachable)]
                           [(null? (cdr arms)) (cdr (car arms))]
                           [else `(if (ref.test (ref ,(car (car arms))) v) ,(cdr (car arms)) ,(loop (cdr arms)))]))))))]
      [_ (refuse)])))

;; Is datatype adt Nat, Zero and Succ?
(define (nat? adt)
  (let ([cs (AdtD-c adt)])
    (and (= (length cs) 2)
         (equal? (short (CtrD-k (car cs))) "Zero") (= (CtrD-n (car cs)) 0)
         (equal? (short (CtrD-k (cadr cs))) "Succ") (= (CtrD-n (cadr cs)) 1))))
