;; Lifecycle: example. The kernel of the Bend example (bend.sub): a port
;; of Bend2's (bend2/bend.ts, from Term to Valid), in Substrate, run at
;; compile time. Its terms; flattening matches into lambda-matches; weak
;; head and strong normal forms; comparison; bidirectional checking with
;; quantities and descent; and validating a module's definitions in order.
;; bend.sub gives it terms as data and definitions as events, and it
;; raises a syntax error at the first term that does not check.
;;
;; A term is a struct, as Bend's are objects. A binder's body is, in a
;; term's first-order form, a term whose variables are Var with the
;; binder's id; in its higher-order form, which the kernel works on, a
;; function from the bound value to the body (term-higher, term-lower). A
;; name, of a definition, a datatype or a constructor, is its name as the
;; Substrate kernel gives it (spec 6.7), a symbol. Every node has s, the
;; syntax it came from, or #f, where errors are located. Quantities are
;; the symbols none (-), lone and many (+).

(require-unqualified substrate "../../lib/substrate.sub")

(provide datum->term datum->body term->datum datum->tld term-higher term-lower body-flatten
         term-show validate! flatten-definition strip-datum short)

;; ---- terms ----

(struct Var (k [i #:mutable] [v #:mutable] s))   ; x: i its binder's id, or -1 a share cell, -2 a filled one; v its value
(struct Ref (k s))                               ; a definition, by name
(struct Sub (i v f s))                           ; x <- v; f: v, a term or a pattern, for the variable i in f
(struct Let (k i q v f s))                       ; x y = v w; f: names, ids, quantities, values, body
(struct Typ (g s))                               ; Kind(g)
(struct Qnt (s))                                 ; Quant
(struct Qua (q s))                               ; &0 &1 &2
(struct Min (a b s))                             ; a <&> b
(struct All (q k i A B s))                       ; @q x:A -> B
(struct Lam (k i f s))                           ; x => f
(struct App (f x s))                             ; f(x)
(struct ADT (k x r s))                           ; D<x ...>, less its constructors r
(struct Ctr (k x s))                             ; K{x ...}
(struct Mat (k h m s))                           ; \{K: h; m}
(struct Efq (s))                                 ; \{}
(struct Eql (a b T s))                           ; {a == b : T}
(struct Rfl (s))                                 ; {==}
(struct Rwt (e p f s))                           ; %e : p; f
(struct Hol (k s))                               ; ?k
(struct Ann (x T s))                             ; {x : T}

;; Patterns, and bodies, of a definition before its matches are
;; flattened: a match of the terms es by rows, each (patterns . body), or
;; a term, its reply.
(struct PVar (k i s))
(struct PCtr (k x s))
(struct Match (e r s))

(define (term-s t)
  (match t
    [(Var _ _ _ s) s] [(Ref _ s) s] [(Sub _ _ _ s) s] [(Let _ _ _ _ _ s) s] [(Typ _ s) s] [(Qnt s) s]
    [(Qua _ s) s] [(Min _ _ s) s] [(All _ _ _ _ _ s) s] [(Lam _ _ _ s) s] [(App _ _ s) s] [(ADT _ _ _ s) s]
    [(Ctr _ _ s) s] [(Mat _ _ _ s) s] [(Efq s) s] [(Eql _ _ _ s) s] [(Rfl s) s] [(Rwt _ _ _ s) s]
    [(Hol _ s) s] [(Ann _ _ s) s] [_ #f]))

;; ---- terms as data ----
;;
;; bend.sub reads a definition's code back into a first-order term as
;; data, a list per node, its last element its syntax or #f: (var k i s),
;; (ref k s), (let (k ...) (i ...) (q ...) (v ...) f s), (typ g s), (qnt
;; s), (qua q s), (min a b s), (all q k i A B s), (lam k i f s), (app f x
;; s), (adt k (x ...) (r ...) s), (ctr k (x ...) s), (mat k h m s), (efq
;; s), (eql a b T s), (rfl s), (rwt e p f s), (hol k s), (ann x T s); a
;; body is a term, or (match (e ...) (((p ...) body) ...) s), a pattern
;; (pvar k i s) or (pctr k (p ...) s). A module's facts hold its
;; definitions as data, without syntax (term->datum).

(define (datum->term d)
  (let ([t (lambda (x) (datum->term x))] [ts (lambda (xs) (map datum->term xs))])
    (match d
      [('var k i s) (Var k i #f s)]
      [('ref k s) (Ref k s)]
      [('sub i v f s) (Sub i (if (memq (car v) '(pvar pctr)) (datum->pattern v) (t v)) (t f) s)]
      [('let k i q v f s) (Let k i q (ts v) (t f) s)]
      [('typ g s) (Typ (t g) s)]
      [('qnt s) (Qnt s)]
      [('qua q s) (Qua q s)]
      [('min a b s) (Min (t a) (t b) s)]
      [('all q k i A B s) (All q k i (t A) (t B) s)]
      [('lam k i f s) (Lam k i (t f) s)]
      [('app f x s) (App (t f) (t x) s)]
      [('adt k x r s) (ADT k (ts x) r s)]
      [('ctr k x s) (Ctr k (ts x) s)]
      [('mat k h m s) (Mat k (t h) (t m) s)]
      [('efq s) (Efq s)]
      [('eql a b T s) (Eql (t a) (t b) (t T) s)]
      [('rfl s) (Rfl s)]
      [('rwt e p f s) (Rwt (t e) (t p) (t f) s)]
      [('hol k s) (Hol k s)]
      [('ann x T s) (Ann (t x) (t T) s)])))

(define (datum->pattern d)
  (match d
    [('pvar k i s) (PVar k i s)]
    [('pctr k x s) (PCtr k (map datum->pattern x) s)]))

(define (datum->body d)
  (match d
    [('match e r s) (Match (map datum->term e)
                           (map (lambda (row) (cons (map datum->pattern (car row)) (datum->body (cadr row)))) r)
                           s)]
    [_ (datum->term d)]))

;; First-order term t as data, with its syntax if keep is true.
(define (term->datum t keep)
  (let ([d (lambda (x) (term->datum x keep))] [ds (lambda (xs) (map (lambda (x) (term->datum x keep)) xs))]
        [w (lambda (s) (and keep s))])
    (match t
      [(Var k i _ s) (list 'var k i (w s))]
      [(Ref k s) (list 'ref k (w s))]
      [(Let k i q v f s) (list 'let k i q (ds v) (d f) (w s))]
      [(Typ g s) (list 'typ (d g) (w s))]
      [(Qnt s) (list 'qnt (w s))]
      [(Qua q s) (list 'qua q (w s))]
      [(Min a b s) (list 'min (d a) (d b) (w s))]
      [(All q k i A B s) (list 'all q k i (d A) (d B) (w s))]
      [(Lam k i f s) (list 'lam k i (d f) (w s))]
      [(App f x s) (list 'app (d f) (d x) (w s))]
      [(ADT k x r s) (list 'adt k (ds x) r (w s))]
      [(Ctr k x s) (list 'ctr k (ds x) (w s))]
      [(Mat k h m s) (list 'mat k (d h) (d m) (w s))]
      [(Efq s) (list 'efq (w s))]
      [(Eql a b T s) (list 'eql (d a) (d b) (d T) (w s))]
      [(Rfl s) (list 'rfl (w s))]
      [(Rwt e p f s) (list 'rwt (d e) (d p) (d f) (w s))]
      [(Hol k s) (list 'hol k (w s))]
      [(Ann x T s) (list 'ann (d x) (d T) (w s))])))

;; Term d, as data, without its syntax, as a module's facts hold it.
(define (strip-datum d) (term->datum (datum->term d) #f))

;; A definition's value, from its body, as data, and its parameters, each
;; (pvar k i s): the body flattened, its patterns put for its variables,
;; and its binders numbered by depth; with its syntax if keep is true.
(define (flatten-definition body vars fresh keep)
  (let* ([next fresh]
         [fr (lambda () (set! next (+ next 1)) next)]
         [flat (body-flatten (datum->body body) (map datum->pattern vars) fr)])
    (term->datum (term-lower (term-higher flat '()) 0) keep)))

;; ---- the two forms of a term ----

;; First-order term t in its higher-order form: env maps each id bound
;; around t to its value, or to a function of a syntax giving it. A
;; variable no binder around binds is a reference, as in Bend.
(define (term-higher t env)
  (let ([h (lambda (x) (term-higher x env))])
    (match t
      [(Var k i v s)
       (if (< i 0)
           t
           (let ([b (assv i env)])
             (cond [(not b) (Ref k s)]
                   [(procedure? (cdr b)) ((cdr b) s)]
                   [else (cdr b)])))]
      [(Sub i x f _)
       (let ([v (if (or (PVar? x) (PCtr? x))
                    (lambda (s) (term-higher (pattern-term x s) env))
                    (term-higher x env))])
         (term-higher f (cons (cons i v) env)))]
      [(Let k i q v f s)
       (Let k i q (map h v) (lambda (xs) (term-higher f (append (map cons i xs) env))) s)]
      [(All q k i A B s) (All q k i (h A) (lambda (x) (term-higher B (cons (cons i x) env))) s)]
      [(Lam k i f s) (Lam k i (lambda (x) (term-higher f (cons (cons i x) env))) s)]
      [(Typ g s) (Typ (h g) s)]
      [(Min a b s) (Min (h a) (h b) s)]
      [(App f x s) (App (h f) (h x) s)]
      [(ADT k x r s) (ADT k (map h x) r s)]
      [(Ctr k x s) (Ctr k (map h x) s)]
      [(Mat k hh m s) (Mat k (h hh) (h m) s)]
      [(Eql a b T s) (Eql (h a) (h b) (h T) s)]
      [(Rwt e p f s) (Rwt (h e) (h p) (h f) s)]
      [(Ann x T s) (Ann (h x) (h T) s)]
      [_ t])))

;; Higher-order term t in its first-order form, its binders numbered by
;; depth from d.
(define (term-lower t d)
  (let ([l (lambda (x) (term-lower x d))])
    (match (term-force t)
      [(Var k i _ s) (Var k i #f s)]
      [(Let k i q v f s)
       (let ([xs (map (lambda (k j) (Var k (+ d j) #f #f)) k (range (length k)))])
         (Let k (range d (+ d (length k))) q (map l v) (term-lower (f xs) (+ d (length k))) s))]
      [(All q k i A B s) (All q k d (l A) (term-lower (B (Var k d #f #f)) (+ d 1)) s)]
      [(Lam k i f s) (Lam k d (term-lower (f (Var k d #f #f)) (+ d 1)) s)]
      [(Typ g s) (Typ (l g) s)]
      [(Min a b s) (Min (l a) (l b) s)]
      [(App f x s) (App (l f) (l x) s)]
      [(ADT k x r s) (ADT k (map l x) r s)]
      [(Ctr k x s) (Ctr k (map l x) s)]
      [(Mat k h m s) (Mat k (l h) (l m) s)]
      [(Eql a b T s) (Eql (l a) (l b) (l T) s)]
      [(Rwt e p f s) (Rwt (l e) (l p) (l f) s)]
      [(Ann x T s) (Ann (l x) (l T) s)]
      [x x])))

;; f applied to x: a beta step, if f is a lambda.
(define (term-apply f x s)
  (let ([g (term-strip f)])
    (if (Lam? g) ((Lam-f g) x) (App g x s))))

;; t's head and its arguments, in order.
(define (term-unapply t)
  (let loop ([t t] [xs '()])
    (if (App? t) (loop (App-f t) (cons (App-x t) xs)) (cons t xs))))

;; t in a share cell, which the machine fills with its weak head normal
;; form the first time it is forced, so shared work runs once.
(define (term-cell t k)
  (if (and (Var? t) (< (Var-i t) 0)) t (Var k -1 t (term-s t))))

(define (term-force t) (if (and (Var? t) (Var-v t)) (term-force (Var-v t)) t))

(define (term-strip t)
  (let ([t (term-force t)]) (if (Ann? t) (term-strip (Ann-x t)) t)))

;; ---- flattening matches ----
;;
;; A definition's body, its parameters pending, as Bend's parser flattens
;; it (bend.ts, Flatten): a match compiles into lambda-matches at the
;; binders it scrutinizes, a parameter or a field bound before, closing
;; the binders before it as lambdas first; the first row wins, and the
;; cases no row covers become \{}. A pattern is put for a variable by a
;; Sub, which term-higher resolves. fr gives fresh ids.

(define (body-flatten b vars fr)
  (cond [(Match? b) (match-flatten b vars fr)]
        [(null? vars) b]
        [else (let ([v (car vars)]) (Lam (PVar-k v) (PVar-i v) (body-flatten b (cdr vars) fr) (PVar-s v)))]))

(define (pattern-term q s)
  (match q
    [(PVar k i qs) (Var k i #f (or s qs))]
    [(PCtr k x qs) (Ctr k (map (lambda (p) (pattern-term p s)) x) (or s qs))]))

(define (pattern-s q) (if (PVar? q) (PVar-s q) (PCtr-s q)))

;; Body b with pattern v put for the variable i.
(define (body-sub b i v)
  (if (Match? b)
      (Match (map (lambda (e)
                    (cond [(not (Var? e)) (Sub i v e #f)]
                          [(= (Var-i e) i) (pattern-term v (Var-s e))]
                          [else e]))
                  (Match-e b))
             (map (lambda (row) (cons (car row) (body-sub (cdr row) i v))) (Match-r b))
             (Match-s b))
      (Sub i v b #f)))

(define (match-flatten m vars fr)
  (let ([es (Match-e m)] [rs (Match-r m)] [s (Match-s m)])
    (cond
      [(and (null? es) (pair? rs)) (body-flatten (cdr (car rs)) vars fr)]
      [(null? es) (flatten-error s "a case (this match has no row to return)")]
      [(null? vars)
       (let ([e (let loop ([e (car es)]) (if (Sub? e) (loop (Sub-f e)) e))])
         (cond [(Var? e)
                (flatten-error (Var-s e) "match scrutinees in binder order (this variable is unbound, consumed, or out of order: reorder the match)")]
               [(Ctr? e)
                (flatten-error s "an undestructed scrutinee (this value is already a constructor: bind its fields directly)")]
               [else (flatten-error (or (term-s e) s) "a parameter or field scrutinee (a match cannot scrutinize a computed value: give it its own def)")]))]
      [else
       (let* ([x (car vars)]
              [scu (car es)]
              [c (findf PCtr? (map (lambda (row) (car (car row))) rs))]
              [v (and (Var? scu) (findf (lambda (w) (= (PVar-i w) (Var-i scu))) vars))])
         (cond
           [(and v (not c) (pair? rs))
            (match-flatten (Match (cdr es)
                                  (map (lambda (row)
                                         (let ([p0 (car (car row))])
                                           (unless (PVar? p0)
                                             (flatten-error (pattern-s p0) "a variable pattern (this column has no constructor row)"))
                                           (cons (cdr (car row)) (body-sub (cdr row) (PVar-i p0) v))))
                                       rs)
                                  s)
                           vars fr)]
           [(eq? v x)
            (if (not c)
                (Efq s)
                (let* ([xs (map (lambda (q)
                                  (if (PVar? q)
                                      q
                                      (let ([i (fr)]) (PVar (string->symbol (format "_~a" i)) i (pattern-s q)))))
                                (PCtr-x c))]
                       [kx (PCtr (PCtr-k c) xs (PVar-s x))]
                       [ps (apply append
                                  (map (lambda (row)
                                         (let ([p0 (car (car row))] [rest (cdr (car row))])
                                           (cond
                                             [(PVar? p0)
                                              (list (cons (append xs rest) (body-sub (body-sub (cdr row) (PVar-i p0) x) (PVar-i x) kx)))]
                                             [(not (eq? (PCtr-k p0) (PCtr-k c))) '()]
                                             [(not (= (length (PCtr-x p0)) (length xs)))
                                              (flatten-error (PCtr-s p0) (format "a ~a pattern with ~a field~a" (short (PCtr-k c)) (length xs) (if (= (length xs) 1) "" "s")))]
                                             [else (list (cons (append (PCtr-x p0) rest) (body-sub (cdr row) (PVar-i x) kx)))])))
                                       rs))]
                       [pt (match-flatten (Match (append (map (lambda (q) (pattern-term q #f)) xs) (cdr es)) ps s)
                                          (append xs (cdr vars)) fr)]
                       [ds (filter (lambda (row)
                                     (let ([p0 (car (car row))]) (or (PVar? p0) (not (eq? (PCtr-k p0) (PCtr-k c))))))
                                   rs)]
                       [dt (match-flatten (Match es ds s) vars fr)])
                  (Mat (PCtr-k c) pt dt (PCtr-s c))))]
           [else (Lam (PVar-k x) (PVar-i x) (match-flatten m (cdr vars) fr) (PVar-s x))]))])))

(define (flatten-error s message) (raise-syntax-error 'bend (string-append "expected " message) (or s current-where)))

;; ---- quantities and usage ----
;;
;; Quantities add sequentially, two live uses saturating to many, and join
;; across branches by their maximum. A usage maps a variable's id to how
;; it was used; a context, each id bound around a term to (q k T).

(define (quant-add a b) (cond [(eq? a 'none) b] [(eq? b 'none) a] [else 'many]))
(define (quant-join a b) (cond [(or (eq? a 'many) (eq? b 'many)) 'many] [(eq? a 'none) b] [else a]))
(define (quant-dem q qt) (if (eq? q 'none) 'none qt))
(define (quant-show q) (case q [(none) "-"] [(lone) ""] [else "+"]))

(define (quant-used ctx k q u s)
  (unless (eq? (quant-join u q) q)
    (bend-error ctx (format "~a~a" (quant-show q) k)
                (if (eq? u 'many) (format "~a (consumed more than once)" k) (format "~a~a" (quant-show u) k))
                s)))

(define (uses-get u k) (let ([b (assv k u)]) (if b (cdr b) 'none)))
(define (uses-union a b f)
  (append (map (lambda (p) (let ([y (assv (car p) b)]) (if y (cons (car p) (f (cdr p) (cdr y))) p))) a)
          (filter (lambda (p) (not (assv (car p) a))) b)))
(define (uses-add a b) (uses-union a b quant-add))
(define (uses-del u k) (filter (lambda (p) (not (= (car p) k))) u))

(define (ctx-bind ctx i q k T) (cons (list i q k T) (filter (lambda (e) (not (= (car e) i))) ctx)))
(define (ctx-get ctx i) (let ([e (assv i ctx)]) (and e (cdr e))))

;; Is a live variable of ctx of a datatype with no constructors? Then the
;; code in ctx is unreachable.
(define (ctx-dead? book ctx)
  (ormap (lambda (e)
           (and (not (eq? (cadr e) 'none))
                (let ([t (term-wnf book (cadddr e))])
                  (and (ADT? t) (null? (AdtD-c (book-adt book t ctx)))))))
         ctx))

;; ---- the book ----
;;
;; What the kernel knows of definitions, by name: a datatype, its
;; parameters n, the first that is not a Quant g, its type T, and its
;; constructors; a constructor, its fields n and its type T, over its
;; family's parameters and its fields; a definition, its parameters n, its
;; type T, and its value v, or #f while it is declared and stuck.

(struct AdtD (n g T c))
(struct CtrD (k n T))
(struct DefD (n T [v #:mutable]))
(struct Book (tld ctr))

(define (book-tld book k) ((Book-tld book) k))
(define (book-ctr book k) ((Book-ctr book) k))

;; The family of constructor k.
(define (book-fam book k)
  (let loop ([t (term-strip (CtrD-T (book-ctr book k)))] [d 0])
    (if (All? t)
        (loop (term-strip ((All-B t) (Var (All-k t) d #f #f))) (+ d 1))
        (if (ADT? t) (ADT-k t) k))))

;; The datatype t, an ADT node, is of, less the constructors it removes.
(define (book-adt book t ctx)
  (let ([tld (book-tld book (ADT-k t))])
    (unless (AdtD? tld) (bend-error ctx (format "a declared datatype (unknown: ~a)" (short (ADT-k t))) #f (ADT-s t)))
    (if (null? (ADT-r t))
        tld
        (AdtD (AdtD-n tld) (AdtD-g tld) (AdtD-T tld) (filter (lambda (c) (not (memq (CtrD-k c) (ADT-r t)))) (AdtD-c tld))))))

(define (ctrs-find cs k) (findf (lambda (c) (eq? (CtrD-k c) k)) cs))

;; A definition's information as data (bend.sub's facts) as the book has
;; it: (adt n g T ((k n T) ...)), (ctr n T) or (def n T v).
(define (datum->tld d)
  (let ([h (lambda (x) (term-higher (datum->term x) '()))])
    (match d
      [('adt n g T cs) (AdtD n g (h T) (map (lambda (c) (CtrD (car c) (cadr c) (h (caddr c)))) cs))]
      [('ctr k n T) (CtrD k n (h T))]
      [('def n T v) (DefD n (h T) (and v (h v)))])))

;; ---- errors ----
;;
;; A term that does not check raises a syntax error, as Bend's Err: what
;; was expected and what was observed, a term or a string, the context,
;; and where. The definition being validated is where an error without
;; syntax of its own is, and its book what the terms shown are normalized
;; with, as Bend's are.

(define current-where #f)
(define current-book #f)

(define (shown t d names)
  (term-show (term-lower (if current-book (term-snf current-book t) t) d) names))

(define (bend-error ctx expected observed s)
  (let* ([ctx (sort ctx (lambda (a b) (< (car a) (car b))))]
         [names (map caddr ctx)]
         [show (lambda (e) (if (string? e) e (shown e (length ctx) names)))]
         [context (apply string-append
                         (map (lambda (e) (format "~n  ~a : ~a" (caddr e) (shown (cadddr e) (car e) names))) ctx))])
    (raise-syntax-error 'bend
                        (string-append (if observed
                                           (format "expected ~a~n  observed ~a" (show expected) (show observed))
                                           (format "expected ~a" (show expected)))
                                       (if (null? ctx) "" (string-append (format "~n context:") context)))
                        (or s current-where))))

;; The name k as the user wrote it: its symbol, without its file.
(define (short k)
  (let* ([s (symbol->string k)] [n (string-utf-8-length s)])
    (let loop ([i 0])
      (cond [(= i n) s]
            [(= (string-utf-8-byte s i) 58) (substring/utf-8 s (+ i 1) n)]
            [else (loop (+ i 1))]))))

;; First-order term t written as the example writes it, names the names
;; of the variables bound around it, by depth.
(define (term-show t names)
  (let show ([t t] [names names])
    (let ([sh (lambda (x) (show x names))])
      (match t
        [(Var k i _ _) (format "~a" (if (and (>= i 0) (< i (length names))) (list-ref names i) k))]
        [(Ref k _) (short k)]
        [(Typ g _) (let ([g (term-strip g)])
                     (cond [(and (Qua? g) (eq? (Qua-q g) 'lone)) "Type"]
                           [(and (Qua? g) (eq? (Qua-q g) 'many)) "Data"]
                           [else (format "(Kind ~a)" (sh g))]))]
        [(Qnt _) "Quant"]
        [(Qua q _) (case q [(none) "&0"] [(lone) "&1"] [else "&2"])]
        [(Min a b _) (format "(meet ~a ~a)" (sh a) (sh b))]
        [(All q k i A B _)
         (format "(-> [~a~a : ~a] ~a)" (quant-show q) k (sh A) (show B (append names (list k))))]
        [(Lam k i f _) (format "(fn (~a) ~a)" k (show f (append names (list k))))]
        [(App _ _ _) (let ([hx (term-unapply t)]) (format "(~a)" (joined (map sh (cons (car hx) (cdr hx))))))]
        [(ADT k x r _)
         (let ([d (if (null? x) (short k) (format "(~a ~a)" (short k) (joined (map sh x))))])
           (if (null? r) d (format "(~a #:without ~a)" d (joined (map short r)))))]
        [(Ctr k x _) (or (nat-literal t) (if (null? x) (short k) (format "(~a ~a)" (short k) (joined (map sh x)))))]
        [(Mat k h m _) (format "(split ~a ~a ~a)" (short k) (sh h) (sh m))]
        [(Efq _) "(absurd)"]
        [(Eql a b T _) (format "(== ~a ~a ~a)" (sh a) (sh b) (sh T))]
        [(Rfl _) "refl"]
        [(Rwt e p f _) (format "(rewrite ~a ~a ~a)" (sh e) (sh p) (sh f))]
        [(Hol k _) (format "(? ~a)" k)]
        [(Ann x T _) (format "(the ~a ~a)" (sh T) (sh x))]
        [(Let k i q v f _)
         (format "(let (~a) ~a)" (joined (map (lambda (k v) (format "[~a ~a]" k (sh v))) k v)) (show f (append names k)))]
        [(Sub _ _ f _) (sh f)]
        [_ "?"]))))

;; A chain of Succ ending in Zero, written (nat n); Zero alone is Zero.
(define (nat-literal t)
  (let loop ([t t] [n 0])
    (cond [(and (Ctr? t) (equal? (short (Ctr-k t)) "Zero") (null? (Ctr-x t))) (if (= n 0) "Zero" (format "(nat ~a)" n))]
          [(and (Ctr? t) (equal? (short (Ctr-k t)) "Succ") (= (length (Ctr-x t)) 1)) (loop (term-strip (car (Ctr-x t))) (+ n 1))]
          [else #f])))

(define (joined xs) (if (null? xs) "" (foldl (lambda (x acc) (string-append acc " " x)) (car xs) (cdr xs))))

;; ---- weak head normal form ----
;;
;; A stack machine (bend.ts, WNF): sound, weak, idempotent, partial exactly
;; on terms with no weak head normal form. A saturated definition unfolds;
;; a stuck one gives back its reference applied, which lhs, its left-hand
;; side so far, rebuilds. A term entering a spine becomes a share cell,
;; which the machine fills with its weak head normal form, so shared work
;; runs once. A rewrite steps to its body when its evidence reaches refl.

(struct FApp (x s))              ; _(x)
(struct FMat (t e lhs s))        ; \{K: h; m}(_), lhs the left-hand side before it
(struct FVar (l a))              ; a share cell being filled, a its annotation
(struct FMna (b s))              ; _ <&> b
(struct FMnb (a s))              ; a <&> _
(struct WLhs (t n))              ; a left-hand side: t gives it, n parameters remain

(define (term-wnf book term)
  (let ([frs '()] [lhs #f])
    (letrec
        ([push! (lambda (f) (set! frs (cons f frs)))]
         [pop! (lambda () (let ([f (car frs)]) (set! frs (cdr frs)) f))]
         [app-on-top? (lambda () (and (pair? frs) (FApp? (car frs))))]
         ;; The applications on top of the stack, up to n.
         [apps (lambda (n) (let loop ([fs frs] [run 0]) (if (and (< run n) (pair? fs) (FApp? (car fs))) (loop (cdr fs) (+ run 1)) run)))]
         [done (lambda (tm) (set! lhs #f) (back tm))]
         [main
          (lambda (tm)
            (match tm
              [(Var k i v s)
               (if (not v)
                   (done tm)
                   (begin (when (= i -1) (push! (FVar tm (and (Ann? v) v))))
                          (set! lhs #f)
                          (main v)))]
              [(Ann x _ _) (main x)]
              [(Min a b s) (push! (FMna b s)) (main a)]
              [(Let k _ _ v f _) (main (f (map (lambda (v k) (term-cell v k)) v k)))]
              [(App f x s) (push! (FApp (term-cell x '_) s)) (set! lhs #f) (main f)]
              [(Lam _ _ f _)
               (if (not (app-on-top?))
                   (done tm)
                   (let ([fr (pop!)])
                     (cond [(and lhs (= (WLhs-n lhs) 0)) (set! lhs #f)]
                           [lhs (let ([pt (WLhs-t lhs)] [pn (WLhs-n lhs)])
                                  (set! lhs (WLhs (lambda () (term-apply (pt) (FApp-x fr) (FApp-s fr))) (- pn 1))))])
                     (main (f (FApp-x fr)))))]
              [(Mat _ _ _ _)
               (if (not (app-on-top?))
                   (done tm)
                   (let ([fr (pop!)])
                     (push! (FMat tm (FApp-x fr) lhs (FApp-s fr)))
                     (set! lhs #f)
                     (main (FApp-x fr))))]
              [(Efq _)
               (if (and lhs (> (WLhs-n lhs) 0) (app-on-top?))
                   (done ((WLhs-t lhs)))
                   (done tm))]
              [(Rwt e _ f _)
               (if (Rfl? (term-wnf book e)) (main f) (done tm))]
              [(Ref k s)
               (let ([tld (book-tld book k)])
                 (cond [(not tld) (done tm)]
                       [(AdtD? tld) (done (if (= (AdtD-n tld) 0) (ADT k '() '() s) tm))]
                       [(or (< (apps (DefD-n tld)) (DefD-n tld)) (not (DefD-v tld))) (done tm)]
                       [else (set! lhs (WLhs (lambda () tm) (DefD-n tld))) (main (DefD-v tld))]))]
              [_ (done tm)]))]
         [back
          (lambda (tm)
            (if (null? frs)
                tm
                (let ([fr (pop!)])
                  (match fr
                    [(FVar l a)
                     (let ([tm (match tm
                                 [(Ctr k x s) (Ctr k (map (lambda (x) (term-cell x '_)) x) s)]
                                 [(ADT k x r s) (ADT k (map (lambda (x) (term-cell x '_)) x) r s)]
                                 [(All q k i A B s) (All q k i (term-cell A '_) B s)]
                                 [(Mat k h m s) (Mat k (term-cell h '_) (term-cell m '_) s)]
                                 [(Eql a b T s) (Eql (term-cell a '_) (term-cell b '_) (term-cell T '_) s)]
                                 [(Min a b s) (Min (term-cell a '_) (term-cell b '_) s)]
                                 [(Typ g s) (Typ (term-cell g '_) s)]
                                 [_ tm])])
                       (set-Var-v! l (if a (Ann tm (term-cell (Ann-T a) '_) (Ann-s a)) tm))
                       (set-Var-i! l -2)
                       (main tm))]
                    [(FApp x s) (back (term-apply tm x s))]
                    [(FMna b s)
                     (cond [(and (Qua? tm) (eq? (Qua-q tm) 'many)) (main b)]
                           [(and (Qua? tm) (eq? (Qua-q tm) 'none)) (back tm)]
                           [else (push! (FMnb tm s)) (main b)])]
                    [(FMnb a s)
                     (back (cond [(and (Qua? tm) (eq? (Qua-q tm) 'many)) a]
                                 [(or (not (Qua? tm)) (and (eq? (Qua-q tm) 'lone) (not (Qua? a)))) (Min a tm s)]
                                 [else tm]))]
                    [(FMat t e fl s)
                     (let ([lhs-term (lambda () (if fl ((WLhs-t fl)) t))])
                       (if (Ctr? tm)
                           (let walk ([t t])
                             (match t
                               [(Ann x _ _) (walk x)]
                               [(Mat k h m _)
                                (if (eq? k (Ctr-k tm))
                                    (let ([n (length (Ctr-x tm))])
                                      (set! lhs (and fl (WLhs (lambda () (lhs-ext ((WLhs-t fl)) k n '())) (+ (- (WLhs-n fl) 1) n))))
                                      (for-each (lambda (x) (push! (FApp (term-cell x '_) #f))) (reverse (Ctr-x tm)))
                                      (main h))
                                    (walk m))]
                               [(Efq _) (back (term-apply (lhs-term) e s))]
                               [_ (set! lhs fl) (push! (FApp tm #f)) (main t)]))
                           (back (term-apply (lhs-term) e s))))]))))])
      (main term))))

;; ---- strong normal form ----

(define (term-snf book term)
  (let ([n (lambda (x) (term-snf book x))])
    (match (term-wnf book term)
      [(Var k i _ s) (Var k i #f s)]
      [(Typ g s) (Typ (n g) s)]
      [(Min a b s) (Min (n a) (n b) s)]
      [(All q k i A B s) (All q k i (n A) (lambda (x) (n (B x))) s)]
      [(Lam k i f s) (Lam k i (lambda (x) (n (f x))) s)]
      [(App f x s) (App (if (Ref? f) f (n f)) (n x) s)]
      [(ADT k x r s) (ADT k (map n x) r s)]
      [(Ctr k x s) (Ctr k (map n x) s)]
      [(Mat k h m s) (Mat k (n h) (n m) s)]
      [(Eql a b T s) (Eql (n a) (n b) (n T) s)]
      [(Rwt e p f s) (Rwt (n e) (n p) (n f) s)]
      [t t])))

;; ---- comparison ----
;;
;; (term-compare mode book a b dep): a fits b (bend.ts, Compare). le is
;; conversion, directional only at kinds and at datatypes less their
;; constructors, and a function type's domains swapped; eq, what flows
;; both ways, is exact, and stays eq all the way down.

(define (term-compare mode book lhs rhs dep)
  (or (eq? lhs rhs)
      (let ([a (term-wnf book lhs)] [b (term-wnf book rhs)])
        (or (eq? a b)
            (cond
              [(or (Lam? a) (Lam? b))
               (let ([x (Var (if (Lam? a) (Lam-k a) (Lam-k b)) dep #f #f)])
                 (term-compare mode book (term-apply a x #f) (term-apply b x #f) (+ dep 1)))]
              [else
               (let ([eq (lambda (x y) (term-compare 'eq book x y dep))])
                 (match a
                   [(Var _ i _ _) (and (Var? b) (= i (Var-i b)))]
                   [(Ref k _) (and (Ref? b) (eq? k (Ref-k b)))]
                   [(Typ g _)
                    (and (Typ? b)
                         (if (eq? mode 'eq)
                             (eq g (Typ-g b))
                             (let ([g (term-wnf book g)] [h (term-wnf book (Typ-g b))])
                               (cond [(or (and (Qua? g) (eq? (Qua-q g) 'many)) (and (Qua? h) (not (eq? (Qua-q h) 'many)))) #t]
                                     [(Min? g) (and (term-compare 'le book (Typ (Min-a g) #f) b dep)
                                                    (term-compare 'le book (Typ (Min-b g) #f) b dep))]
                                     [(Min? h) (or (term-compare 'le book a (Typ (Min-a h) #f) dep)
                                                   (term-compare 'le book a (Typ (Min-b h) #f) dep))]
                                     [else (term-compare 'le book g h dep)]))))]
                   [(Qnt _) (Qnt? b)]
                   [(Qua q _) (and (Qua? b) (eq? q (Qua-q b)))]
                   [(Min x y _) (and (Min? b) (eq x (Min-a b)) (eq y (Min-b b)))]
                   [(All q k _ A B _)
                    (let ([x (Var k dep #f #f)])
                      (and (All? b) (eq? q (All-q b))
                           (term-compare mode book (All-A b) A dep)
                           (term-compare mode book (B x) ((All-B b) x) (+ dep 1))))]
                   [(App f x _) (and (App? b) (eq f (App-f b)) (eq x (App-x b)))]
                   [(ADT k x r _)
                    (and (ADT? b) (eq? k (ADT-k b)) (= (length x) (length (ADT-x b)))
                         (or (not (eq? mode 'eq)) (= (length r) (length (ADT-r b))))
                         (andmap (lambda (c) (memq c r)) (ADT-r b))
                         (andmap eq x (ADT-x b)))]
                   [(Ctr k x _) (and (Ctr? b) (eq? k (Ctr-k b)) (= (length x) (length (Ctr-x b))) (andmap eq x (Ctr-x b)))]
                   [(Mat k h m _) (and (Mat? b) (eq? k (Mat-k b)) (eq h (Mat-h b)) (eq m (Mat-m b)))]
                   [(Efq _) (Efq? b)]
                   [(Eql x y T _) (and (Eql? b) (eq x (Eql-a b)) (eq y (Eql-b b)) (eq T (Eql-T b)))]
                   [(Rfl _) (Rfl? b)]
                   [(Hol k _) (and (Hol? b) (eq? k (Hol-k b)))]
                   [(Rwt e p f _) (and (Rwt? b) (eq e (Rwt-e b)) (eq p (Rwt-p b)) (eq f (Rwt-f b)))]
                   [_ #f]))])))))

;; ---- descent ----

;; How argument arg of a self-call compares with column col of the
;; definition's left-hand side: eq if unchanged, lt if a strict subterm,
;; gt otherwise. An erased column is eq.
(define (term-descend q arg col)
  (if (eq? q 'none)
      'eq
      (let ([a (term-strip arg)] [p (term-strip col)])
        (match p
          [(Var _ i _ _) (if (and (Var? a) (= (Var-i a) i)) 'eq 'gt)]
          [(Ctr k x _)
           (or (and (Ctr? a) (eq? (Ctr-k a) k) (= (length (Ctr-x a)) (length x))
                    (let loop ([as (Ctr-x a)] [ps x] [ord 'eq])
                      (cond [(or (null? as) (eq? ord 'gt)) (if (eq? ord 'gt) #f ord)]
                            [else (let ([f (term-descend 'lone (car as) (car ps))])
                                    (loop (cdr as) (cdr ps) (if (eq? f 'eq) ord f)))])))
               (if (ormap (lambda (q) (not (eq? (term-descend 'lone a q) 'gt))) x) 'lt 'gt))]
          [_ 'gt]))))

;; The left-hand side lhs extended by constructor k's n fields: a function
;; of the fields giving lhs applied to k{fields}.
(define (lhs-ext lhs k n xs)
  (if (= n 0)
      (term-apply lhs (Ctr k (reverse xs) #f) #f)
      (Lam '_ 0 (lambda (x) (lhs-ext lhs k (- n 1) (cons x xs))) #f)))

;; ---- telescopes ----

(define (tele-head book tel ctx s)
  (let ([t (term-wnf book tel)])
    (unless (All? t) (bend-error ctx "unreachable (a telescope binds its parameters and fields)" #f s))
    t))

(define (tele-fill book tel xs ctx s)
  (foldl (lambda (x tel) ((All-B (tele-head book tel ctx s)) x)) tel xs))

;; Arguments xs checked along telescope tel: (xs us tel), tel what is left.
(define (tele-check book lhs tel xs qt ctx d s)
  (let loop ([xs xs] [tel tel] [out '()] [us '()])
    (if (null? xs)
        (list (reverse out) us tel)
        (let* ([t (tele-head book tel ctx s)]
               [c (term-check book lhs (car xs) (quant-dem (All-q t) qt) (All-A t) ctx d)])
          (loop (cdr xs) ((All-B t) (car xs)) (cons (Chk-tm c) out) (uses-add us (Chk-us c)))))))

;; Telescope T's domains, each (q k A), and what it ends in.
(define (tele-unbind book T)
  (let loop ([tel T] [doms '()])
    (let ([t (term-wnf book tel)])
      (if (All? t)
          (loop ((All-B t) (Var (All-k t) (length doms) #f #f)) (cons (list (All-q t) (All-k t) (All-A t)) doms))
          (cons (reverse doms) t)))))

;; ---- checking ----
;;
;; One bidirectional pass (bend.ts, Check). qt is the demand: none checks
;; dead, lone live. us, the usage measured, is checked against each
;; binder's quantity where it closes. A checked term comes back
;; first-order, each node annotated with its type. lhs is the definition's
;; own equation, rebuilt as the walk goes, so that a live self-call can be
;; checked to descend.

(struct Lhs (t n def qs u))
(struct Inf (tm ty us))
(struct Chk (tm us))

(define (inferred tm ty us) (Inf (Ann tm (Var '_ -1 ty #f) #f) ty us))
(define (checked tm ty us) (Chk (Ann tm (Var '_ -1 ty #f) #f) us))
(define (lhs-kind lhs q) (if (and (Lhs-u lhs) (eq? q 'many)) 'lone q))
(define (type-of q) (Typ (Qua q #f) #f))
(define (typeless-show tm ctx) (format "non-inferrable term '~a'" (shown tm (length ctx) (map caddr (sort ctx (lambda (a b) (< (car a) (car b))))))))

(define (term-infer book lhs tm qt ctx d sp)
  (match tm
    [(Var k i v s)
     (if (and (< i 0) v)
         (term-infer book lhs (term-force tm) qt ctx d sp)
         (let ([ann (ctx-get ctx i)])
           (unless ann (bend-error ctx "a bound variable" tm s))
           (inferred (Var k i #f s) (caddr ann) (list (cons i qt)))))]
    [(Ref k s)
     (let* ([tld (book-tld book k)] [live (not (eq? qt 'none))] [self (eq? k (Lhs-def lhs))])
       (unless tld (bend-error ctx "a defined name" tm s))
       (when (and live self (not (Lhs-u lhs)))
         (let loop ([cols (cdr (term-unapply (Lhs-t lhs)))] [sp sp] [qs (Lhs-qs lhs)] [ord 'eq])
           (if (and (eq? ord 'eq) (pair? cols) (pair? sp))
               (loop (cdr cols) (cdr sp) (if (pair? qs) (cdr qs) '())
                     (term-descend (if (pair? qs) (car qs) 'lone) (car sp) (car cols)))
               (unless (eq? ord 'lt)
                 (bend-error ctx "a decreasing self-call (arguments are read left to right: each passed unchanged until one shrinks)" tm s)))))
       (when (and live (not self) (DefD? tld) (not (DefD-v tld)))
         (bend-error ctx "a filled definition (an unfilled law is a dead claim: live code cannot use it)" tm s))
       (when (and (not (and live self)) (AdtD? tld) (> (AdtD-n tld) 0))
         (bend-error ctx (format "a family instance (write (~a ...))" (short k)) tm s))
       (inferred (Ref k s) (if (AdtD? tld) (AdtD-T tld) (DefD-T tld)) '()))]
    [(Typ g s)
     (let ([c (term-check book lhs g 'none (Qnt s) ctx d)])
       (inferred (Typ (Chk-tm c) s) (type-of 'lone) '()))]
    [(Qnt s) (inferred tm (type-of 'lone) '())]
    [(Qua q s) (inferred tm (Qnt s) '())]
    [(Min a b s)
     (let ([ca (term-check book lhs a qt (Qnt s) ctx d)] [cb (term-check book lhs b qt (Qnt s) ctx d)])
       (inferred (Min (Chk-tm ca) (Chk-tm cb) s) (Qnt s) (uses-add (Chk-us ca) (Chk-us cb))))]
    [(All q k i A B s)
     (let* ([bctx (ctx-bind ctx d q k A)]
            [ca (term-check book lhs A 'none (type-of (lhs-kind lhs q)) ctx d)]
            [cb (term-check book lhs (B (Var k d #f #f)) 'none (type-of 'lone) bctx (+ d 1))])
       (inferred (All q k d (Chk-tm ca) (Chk-tm cb) s) (type-of 'lone) '()))]
    [(App f x s)
     (if (Lam? f)
         (term-infer book lhs ((Lam-f f) x) qt ctx d sp)
         (let* ([fi (term-infer book lhs f qt ctx d (cons x sp))]
                [fw (term-wnf book (Inf-ty fi))])
           (unless (All? fw) (bend-error ctx "a function type" (Inf-ty fi) s))
           (let ([xc (term-check book lhs x (quant-dem (All-q fw) qt) (All-A fw) ctx d)])
             (inferred (App (Inf-tm fi) (Chk-tm xc) s) ((All-B fw) x) (uses-add (Inf-us fi) (Chk-us xc))))))]
    [(ADT k x r s)
     (let ([adt (book-adt book tm ctx)])
       (unless (= (length x) (AdtD-n adt))
         (bend-error ctx (format "~a with ~a parameter~a" (short k) (AdtD-n adt) (if (= (AdtD-n adt) 1) "" "s")) tm s))
       (let ([c (tele-check book lhs (AdtD-T adt) x qt ctx d s)])
         (inferred (ADT k (car c) r s) (caddr c) (cadr c))))]
    [(Eql a b T s)
     (let ([ct (term-check book lhs T 'none (type-of 'lone) ctx d)]
           [ca (term-check book lhs a 'none T ctx d)]
           [cb (term-check book lhs b 'none T ctx d)])
       (inferred (Eql (Chk-tm ca) (Chk-tm cb) (Chk-tm ct) s) (type-of 'many) '()))]
    [(Ann x T s)
     (term-check book lhs T 'none (type-of 'lone) ctx d)
     (let ([c (term-check book lhs x qt T ctx d)]) (Inf (Chk-tm c) T (Chk-us c)))]
    [_
     (when (and (Ctr? tm) (not (book-ctr book (Ctr-k tm))))
       (bend-error ctx "a declared constructor" tm (Ctr-s tm)))
     (bend-error ctx "an annotated term (cannot infer)" tm (term-s tm))]))

(define (term-check book lhs tm qt ty ctx d)
  (match tm
    [(Var _ i v _)
     (if (and (< i 0) v)
         (term-check book lhs (term-force tm) qt ty ctx d)
         (check-any book lhs tm qt ty ctx d))]
    [(Lam k i f s)
     (let ([t (term-wnf book ty)])
       (unless (All? t) (bend-error ctx ty (typeless-show tm ctx) s))
       (let* ([x (Var k d #f #f)]
              [flhs (if (> (Lhs-n lhs) 0)
                        (Lhs (term-apply (Lhs-t lhs) x #f) (- (Lhs-n lhs) 1) (Lhs-def lhs) (Lhs-qs lhs) (Lhs-u lhs))
                        lhs)]
              [c (term-check book flhs (f x) qt ((All-B t) x) (ctx-bind ctx d (All-q t) k (All-A t)) (+ d 1))])
         (quant-used ctx k (All-q t) (uses-get (Chk-us c) d) s)
         (checked (Lam k d (Chk-tm c) s) ty (uses-del (Chk-us c) d))))]
    [(Let ks i qs vs f s)
     (let loop ([j 0] [ks* ks] [qs* qs] [vs* vs] [vx '()] [us '()] [fctx ctx])
       (if (pair? ks*)
           (let* ([vi (term-infer book lhs (car vs*) (quant-dem (car qs*) qt) ctx d '())])
             (term-check book lhs (Inf-ty vi) 'none (type-of (lhs-kind lhs (car qs*))) ctx d)
             (loop (+ j 1) (cdr ks*) (cdr qs*) (cdr vs*) (cons (Inf-tm vi) vx) (uses-add us (Inf-us vi))
                   (ctx-bind fctx (+ d j) (car qs*) (car ks*) (Inf-ty vi))))
           (let* ([n (length ks)]
                  [xs (map (lambda (k j v) (Var k (+ d j) v #f)) ks (range n) vs)]
                  [c (term-check book lhs (f xs) qt ty fctx (+ d n))]
                  [fu (foldl (lambda (k q j fu)
                               (quant-used ctx k q (uses-get fu (+ d j)) s)
                               (uses-del fu (+ d j)))
                             (Chk-us c) ks qs (range n))])
             (checked (Let ks (range d (+ d n)) qs (reverse vx) (Chk-tm c) s) ty (uses-add us fu)))))]
    [(Ctr k x s)
     (let ([t (term-wnf book ty)])
       (unless (ADT? t)
         (bend-error ctx ty (if (book-ctr book k) (Ref (book-fam book k) s) (typeless-show tm ctx)) s))
       (let* ([adt (book-adt book t ctx)] [ctr (ctrs-find (AdtD-c adt) k)])
         (unless ctr
           (if (book-ctr book k)
               (bend-error ctx ty (Ref (book-fam book k) s) s)
               (bend-error ctx (format "a declared constructor (~a declares ~a)" (short (ADT-k t)) (joined (map (lambda (c) (short (CtrD-k c))) (AdtD-c adt))))
                           tm s)))
         (unless (= (length x) (CtrD-n ctr))
           (bend-error ctx (format "~a with ~a field~a" (short k) (CtrD-n ctr) (if (= (CtrD-n ctr) 1) "" "s")) tm s))
         (let ([c (tele-check book lhs (tele-fill book (CtrD-T ctr) (ADT-x t) ctx s) x qt ctx d s)])
           (checked (Ctr k (car c) s) ty (cadr c)))))]
    [(Mat _ _ _ s) (check-match book lhs tm qt ty ctx d)]
    [(Efq s) (check-match book lhs tm qt ty ctx d)]
    [(Rfl s)
     (let ([t (term-wnf book ty)])
       (unless (Eql? t) (bend-error ctx ty (typeless-show tm ctx) s))
       (unless (term-compare 'eq book (Eql-a t) (Eql-b t) d) (bend-error ctx (Eql-a t) (Eql-b t) s))
       (checked tm ty '()))]
    [(Hol k s)
     (unless (eq? k 'TODO) (bend-error ctx ty tm s))
     (checked tm ty '())]
    [(Rwt e p f s)
     (let* ([ei (term-infer book lhs e qt ctx d '())] [ew (term-wnf book (Inf-ty ei))])
       (unless (Eql? ew) (bend-error ctx "an equation (== a b T)" (Inf-ty ei) (or (term-s e) s)))
       (let ([ptype (All 'lone '_ 0 (Eql-T ew)
                         (lambda (x) (All 'lone 'e 0 (Eql (Eql-a ew) x (Eql-T ew) #f) (lambda (_) (type-of 'lone)) s))
                         s)])
         (let ([pc (term-check book lhs p 'none ptype ctx d)]
               [bgoal (term-apply (term-apply p (Eql-b ew) #f) e #f)])
           (unless (term-compare 'le book bgoal ty d) (bend-error ctx ty bgoal s))
           (let ([fc (term-check book lhs f qt (term-apply (term-apply p (Eql-a ew) #f) (Rfl s) #f) ctx d)])
             (checked (Rwt (Inf-tm ei) (Chk-tm pc) (Chk-tm fc) s) ty (uses-add (Inf-us ei) (Chk-us fc)))))))]
    [_ (check-any book lhs tm qt ty ctx d)]))

(define (check-any book lhs tm qt ty ctx d)
  (let ([xi (term-infer book lhs tm qt ctx d '())])
    (unless (term-compare 'le book (Inf-ty xi) ty d) (bend-error ctx ty (Inf-ty xi) (term-s tm)))
    (Chk (Inf-tm xi) (Inf-us xi))))

;; A lambda-match or \{}, against @q s:D<p ...> -> P: each constructor's
;; case, given its fields, and the rest, given the datatype less it.
(define (check-match book lhs tm qt ty ctx d)
  (let ([t (term-wnf book ty)] [s (term-s tm)])
    (unless (All? t) (bend-error ctx ty (typeless-show tm ctx) s))
    (when (and (not (eq? qt 'none)) (eq? (All-q t) 'none))
      (bend-error ctx "a live scrutinee (a - scrutinee matches only in a dead region)" #f s))
    (let ([a (term-wnf book (All-A t))])
      (unless (ADT? a) (bend-error ctx "a datatype" (All-A t) s))
      (let ([rem (AdtD-c (book-adt book a ctx))])
        (if (Efq? tm)
            (begin
              (unless (or (null? rem) (ctx-dead? book ctx))
                (bend-error ctx (format "cases for ~a" (joined (map (lambda (c) (short (CtrD-k c))) rem))) tm s))
              (checked tm ty '()))
            (let* ([k (Mat-k tm)] [ctr (ctrs-find rem k)])
              (unless ctr (bend-error ctx (format "a constructor of ~a (missing, or already matched)" (short (ADT-k a))) tm s))
              (let* ([goal (let mat-goal ([cur (tele-fill book (CtrD-T ctr) (ADT-x a) ctx s)] [n (CtrD-n ctr)] [xs '()])
                             (if (= n 0)
                                 ((All-B t) (Ctr k (reverse xs) s))
                                 (let* ([c (tele-head book cur ctx s)]
                                        [dem (case (All-q c) [(none) 'none] [(lone) (All-q t)] [else (quant-add (All-q t) (All-q t))])])
                                   (All dem (All-k c) (All-i c) (All-A c) (lambda (x) (mat-goal ((All-B c) x) (- n 1) (cons x xs))) s))))]
                     [hlhs (if (> (Lhs-n lhs) 0)
                               (Lhs (lhs-ext (Lhs-t lhs) k (CtrD-n ctr) '()) (+ (- (Lhs-n lhs) 1) (CtrD-n ctr)) (Lhs-def lhs) (Lhs-qs lhs) (Lhs-u lhs))
                               lhs)]
                     [hc (term-check book hlhs (Mat-h tm) qt goal ctx d)]
                     [mgoal (All (All-q t) (All-k t) (All-i t) (ADT (ADT-k a) (ADT-x a) (append (ADT-r a) (list k)) s) (All-B t) s)]
                     [mc (term-check book lhs (Mat-m tm) qt mgoal ctx d)])
                (checked (Mat k (Chk-tm hc) (Chk-tm mc) s) ty (uses-union (Chk-us hc) (Chk-us mc) quant-join)))))))))

;; ---- validating a module's definitions ----
;;
;; bend.sub gives a module's definitions as events, in order (bend.ts,
;; book_valid), each with its syntax: (adt k n g T ((c n T) ...) where),
;; (def k n T v where), v #f for a law, which declares k, and (fill k v
;; where), which defines a law. Each checks against what came before it,
;; so a reference forward is undefined. A definition is declared, stuck,
;; until its body checks. lookup gives another module's definition, as
;; datum->tld reads it, or #f. The checked definitions come back, as
;; (k . tld).

(define (validate! lookup events)
  (let* ([own (apply append (map (lambda (ev)
                                   (case (car ev)
                                     [(adt) (cons (cadr ev) (map car (list-ref ev 5)))]
                                     [(def) (list (cadr ev))]
                                     [else '()]))
                                 events))]
         [tlds (make-hasheq)]
         [ctrs (make-hasheq)]
         [other (make-hasheq)]
         [imported (lambda (k)
                     (and (not (memq k own))
                          (or (hash-ref other k #f)
                              (let ([d (lookup k)]) (and d (let ([t (datum->tld d)]) (hash-set! other k t) t))))))]
         [book (Book (lambda (k) (or (hash-ref tlds k #f) (let ([t (imported k)]) (and (or (AdtD? t) (DefD? t)) t))))
                     (lambda (k) (or (hash-ref ctrs k #f) (let ([t (imported k)]) (and (CtrD? t) t)))))]
         [h (lambda (d) (term-higher (datum->term d) '()))])
    (set! current-book book)
    (for-each
     (lambda (ev)
       (set! current-where (last ev))
       (match ev
         [('adt k n g T cs where) (validate-adt! book tlds ctrs k n g (h T) (map (lambda (c) (CtrD (car c) (cadr c) (h (caddr c)))) cs))]
         [('def k n T v where) (validate-def! book tlds k n (h T) (and v (h v)))]
         [('fill k v where)
          (let ([law (book-tld book k)])
            (unless (and (DefD? law) (not (DefD-v law)))
              (bend-error '() (format "a law to fill (~a is not one, or is filled already)" (short k)) #f where))
            (validate-def! book tlds k (DefD-n law) (DefD-T law) (h v)))]))
     events)
    (set! current-where #f)
    (set! current-book #f)
    (hash->list tlds)))

(define (validate-adt! book tlds ctrs k n g T cs)
  (let ([adt (AdtD n g T cs)])
    (hash-set! tlds k adt)
    (for-each (lambda (c) (hash-set! ctrs (CtrD-k c) c)) cs)
    (term-check book (Lhs (Ref k #f) 0 k '() #f) T 'none (type-of 'lone) '() 0)
    (let* ([u (tele-unbind book T)] [kind (cdr u)])
      (unless (Typ? kind) (bend-error '() (format "a kind (type ~a is (Kind g))" (short k)) kind (term-s kind)))
      (for-each
       (lambda (c)
         (let loop ([tel (CtrD-T c)] [ctx '()] [d 0])
           (if (< d (+ n (CtrD-n c)))
               (let* ([t (tele-head book tel ctx #f)]
                      [goal (if (and (>= d n) (eq? (All-q t) 'lone)) kind (type-of (All-q t)))])
                 (term-check book (Lhs (Ref (CtrD-k c) #f) 0 (CtrD-k c) '() #f) (All-A t) 'none goal ctx d)
                 (loop ((All-B t) (Var (All-k t) d #f #f)) (ctx-bind ctx d (All-q t) (All-k t) (All-A t)) (+ d 1)))
               (let ([tip (term-wnf book tel)]
                     [expected (format "a telescope tipped at ~a applied to its own parameters" (short k))])
                 (unless (and (ADT? tip) (eq? (ADT-k tip) k) (= (length (ADT-x tip)) n) (null? (ADT-r tip))
                              (andmap (lambda (x d) (let ([x (term-wnf book x)]) (and (Var? x) (= (Var-i x) d))))
                                      (ADT-x tip) (range n)))
                   (bend-error ctx expected tip #f))))))
       cs))))

(define (validate-def! book tlds k n T v)
  (hash-set! tlds k (DefD n T #f))
  (term-check book (Lhs (Ref k #f) 0 k '() #f) T 'none (type-of 'lone) '() 0)
  (when v
    (let ([qs (let ([doms (car (tele-unbind book T))])
                (append (map car (take doms (min n (length doms)))) (map (lambda (_) 'lone) (range (max 0 (- n (length doms)))))))])
      (term-check book (Lhs (Ref k #f) n k qs #f) v 'lone T '() 0)
      (hash-set! tlds k (DefD n T v)))))

