;; Lifecycle: example. What a program of the Bend example (bend.sub) runs
;; with, besides its own code: what a print, whose code lower.sub makes,
;; writes with. Kernel code.
(require print "../../lib/print.sub")
(require k kernel)

(provide write-string write-byte write-nat newline)

(func (write-byte [b i32]) (print:write-byte b))

(func (newline) (print:newline))

;; String s's bytes.
(func (write-string [s eqref])
  (let ([n (k:string-length s)] [i 0])
    (block done
      (loop next
        (br-if done (i32.ge_u i n))
        (print:write-byte (k:string-byte s i))
        (set! i (i32.add i 1))
        (br next)))))

;; The Nat n, as the example writes it: Zero, or (nat n).
(func (write-nat [n i64])
  (if (i64.eqz n)
      (write-string '"Zero")
      (begin (write-string '"(nat ") (print:write-u64 n) (print:write-byte 41))))
