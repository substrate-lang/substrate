;; Lifecycle: example. Bend on the kernel: a port of Bend2's dependently
;; typed, affine language (bend2/bend.ts), in s-expressions, whose kernel,
;; core.sub, checks each module's definitions while it compiles, and which
;; lower.sub makes kernel code. A module takes these forms with
;; require-unqualified:
;;
;;   (type (D p ...) K [C field ...] ...)    a datatype, of kind K, whose
;;   (type D K [C field ...] ...)            parameters p are [q x : A],
;;                                           or x, an erased Quant, and a
;;                                           constructor's fields [q x : A]
;;   (def (f [q x : A] ...) R body)          a definition of type
;;                                           (-> [q x : A] ... R)
;;   (law (f [q x : A] ...) R)               a law: f declared, of that
;;                                           type, and stuck until
;;   (def (f x ...) body)                    fills it, here or in a module
;;                                           that requires this one
;;   (def (f [~ t : A] ... [q x : A] ...) R body)
;;                                           a template (below)
;;
;; A binder's quantity q is -, erased, + for many uses, or nothing for one.
;; A body is a term or (match x ... [(pattern ...) body] ...), whose
;; scrutinees are parameters or fields, as in Bend, and a pattern is a
;; variable, _, which binds nothing, a constructor C or (C pattern ...).
;; Terms:
;;
;;   x, f, D, C              a variable, or a definition, datatype or
;;                           constructor by name (spec 6.7)
;;   (f a ...), (D a ...), (C a ...)
;;                           an application, a datatype's instance, whose
;;                           leading parameters that are quantities can be
;;                           left out, as in Bend, and a value
;;   (fn (x ...) t)          a function
;;   (-> [q x : A] ... B), (-> A ... B)
;;                           a function type
;;   (let ([q x v] ...) t)   values bound in parallel
;;   Type Data Quant (Kind q) &0 &1 &2 (meet a b)
;;                           kinds and quantities
;;   (split C h m), (absurd) a lambda-match: C's case h, the others m
;;   (== a b T), refl, (rewrite e P f)
;;                           equality, its proof, and its eliminator J,
;;                           whose motive P has _ where it rewrites, as
;;                           Bend's does
;;   (the T x), (? name)     an annotation, and a hole
;;   (nat n)                 the Nat n, of the Succ and Zero in scope
;;
;; and, in kernel code, (print e), which writes the value of term e and a
;; newline, as terms are written here.
;;
;; Bend keeps constructors apart from other names, and writes them with
;; braces; here a constructor is a name like any other, so one cannot be
;; named as its datatype is.
;;
;; How it works. type, def and law bind each name they define to a
;; transformer, whose use in a term is a hole naming it (spec 6.4, 6.7);
;; then, the names bound, they expand the definition's types and body, in
;; which binders are kernel lambdas, so the expander keeps them hygienic,
;; and every other node is a hole; read the expansion back as data
;; (read-term); check it at once, as Bend's book_valid does, against the
;; definitions before it and those of the modules it requires (core.sub);
;; and record it as a fact about the name (spec 6.6), which is how another
;; module finds it, by name. A match is flattened into lambda-matches at
;; the binders it scrutinizes, as Bend's parser does. An error shows the
;; term it is about as it is written here, at the place it was written.
;;
;; A definition with a value is a function of its live parameters, which
;; def lifts, and whose body the kernel expands once it has read every
;; definition of the module, when every law is filled: bend-code makes it
;; from the value as it checked it (lower.sub). A fact about the
;; definition holds the function's name, which is how code in any module
;; calls it, kernel code too, with its live arguments. In kernel code,
;; (print e) writes the value of a term e.

(require rt "runtime.sub")
(begin-for-syntax
  (require-unqualified substrate "../../lib/substrate.sub")
  (require k kernel)
  (require-unqualified core "core.sub")
  (require-unqualified lower "lower.sub"))

(provide [type bend-type] [def bend-def] [law bend-law] [match bend-match] [fn bend-fn] [-> bend-arrow]
         [let bend-let] [split bend-split] [absurd bend-absurd] [== bend-eql] [refl bend-refl]
         [rewrite bend-rewrite] [the bend-the] [? bend-hole] [nat bend-nat] [Kind bend-kind] [meet bend-meet]
         [Type bend-Type] [Data bend-Data] [Quant bend-Quant] [&0 bend-q0] [&1 bend-q1] [&2 bend-q2]
         [print bend-print] [#%datum bend-datum])

(begin-for-syntax
  (define (bend-error where form . args) (raise-syntax-error 'bend (apply format form args) where))
  (define (datum d) (datum->syntax #'here d))

  ;; ---- terms, as the expander sees them ----
  ;;
  ;; A term expands to kernel code whose binders are lambdas, with holes
  ;; for types, and whose every other node is (#%hole bend kind data ...),
  ;; alone or applied to the node's parts, which the expander expands (spec
  ;; 6.4). That is while Bend reads a term, which read-expand expands;
  ;; outside one, in kernel code, a Bend name is a call of its function
  ;; (bend-name).

  (define reading? #f)

  (define (read-expand stx)
    (set! reading? #t)
    (let ([x (local-expand stx)])
      (set! reading? #f)
      x))

  (define (node kind . data) #`(#%hole bend #,@(map datum (cons kind data))))

  (define (binder x) #`[#,x (#%hole)])

  (define (bend-datum stx)
    (bend-error stx "a number is a U32, which this example does not have yet: write a Nat as (nat n)"))

  (define (bend-fn stx)
    (syntax-match stx
      [(_ ((? identifier? x) ...) t)
       (when (null? x) (bend-error stx "expected (fn (x ...) t), with a variable"))
       (foldr (lambda (x t) #`(lambda (#,(binder x)) #,t)) t x)]
      [_ (bend-error stx "expected (fn (x ...) t)")]))

  ;; A binder written [q x : A], q - or +, or [x : A]: (q x A). A def's
  ;; parameter may also be [~ x : A], a template's (q template).
  (define (bind-spec b)
    (syntax-match b
      [((? identifier? x) ': A) (list 'lone x A)]
      [('- (? identifier? x) ': A) (list 'none x A)]
      [('+ (? identifier? x) ': A) (list 'many x A)]
      [('~ (? identifier? x) ': A) (list 'template x A)]
      [_ #f]))

  ;; A parameter of a datatype: a binder, or x alone, an erased Quant.
  (define (param-spec p)
    (or (bind-spec p)
        (syntax-match p
          [(? identifier? x) (list 'none x #'bend-Quant)]
          [_ (bend-error p "expected a parameter: [q x : A], or x, a quantity")])))

  (define (quant-type? A) (and (identifier? A) (free-identifier=? A #'bend-Quant)))

  ;; How many of a datatype's parameters, from the first, are quantities.
  (define (leading-quantities ps)
    (let loop ([ps ps] [i 0]) (if (and (pair? ps) (quant-type? (caddr (car ps)))) (loop (cdr ps) (+ i 1)) i)))

  ;; (-> b ... B): each b a binder, or a type bound to nothing.
  (define (bend-arrow stx)
    (syntax-match stx
      [(_ b ... B)
       (when (null? b) (bend-error stx "expected (-> A ... B), with a domain"))
       (arrow (map (lambda (b) (or (bind-spec b) (list 'lone (datum '_) b))) b) B)]))

  (define (arrow specs B)
    (foldr (lambda (spec B)
             (when (eq? (car spec) 'template)
               (bend-error (cadr spec) "expected ~~ only on a def's first parameters, which make it a template"))
             #`(#%app #,(node 'all (car spec)) #,(caddr spec) (lambda (#,(binder (cadr spec))) #,B)))
           B specs))

  (define (bend-let stx)
    (syntax-match stx
      [(_ (b ...) t)
       (let ([bs (map (lambda (b)
                        (syntax-match b
                          [((? identifier? x) v) (list 'lone x v)]
                          [('- (? identifier? x) v) (list 'none x v)]
                          [('+ (? identifier? x) v) (list 'many x v)]
                          [_ (bend-error b "expected a binding: [q x v]")]))
                      b)])
         (when (null? bs) (bend-error stx "expected (let ([q x v] ...) t), with a binding"))
         #`(#%app #,(node 'let (map car bs)) #,@(map caddr bs) (lambda (#,@(map (lambda (b) (binder (cadr b))) bs)) #,t)))]))

  (define (bend-split stx)
    (syntax-match stx
      [(_ (? identifier? c) h m) #`(#%app #,(node 'mat) #,c #,h #,m)]
      [_ (bend-error stx "expected (split C h m)")]))

  (define (bend-absurd stx) (node 'efq))
  (define (bend-eql stx) (syntax-match stx [(_ a b T) #`(#%app #,(node 'eql) #,a #,b #,T)]))
  (define (bend-refl stx) (node 'rfl))
  ;; (rewrite e P f): P the motive, with _ where the rewrite applies, as
  ;; Bend writes it: _ is bound in P, as is e's proof, unnamed.
  (define (bend-rewrite stx)
    (syntax-match stx
      [(_ e P f)
       #`(#%app #,(node 'rwt) #,e (lambda (#,(binder (datum->syntax stx '_ stx))) (lambda (#,(binder (datum 'e))) #,P)) #,f)]
      [_ (bend-error stx "expected (rewrite e P f)")]))
  (define (bend-the stx) (syntax-match stx [(_ T x) #`(#%app #,(node 'ann) #,x #,T)]))
  (define (bend-hole stx) (syntax-match stx [(_ (? identifier? h)) (node 'hol (syntax-e h))]))
  (define (bend-kind stx) (syntax-match stx [(_ g) #`(#%app #,(node 'typ) #,g)]))
  (define (bend-meet stx) (syntax-match stx [(_ a b) #`(#%app #,(node 'min) #,a #,b)]))
  (define (bend-Type stx) #`(#%app #,(node 'typ) #,(node 'qua 'lone)))
  (define (bend-Data stx) #`(#%app #,(node 'typ) #,(node 'qua 'many)))
  (define (bend-Quant stx) (node 'qnt))
  (define (bend-q0 stx) (node 'qua 'none))
  (define (bend-q1 stx) (node 'qua 'lone))
  (define (bend-q2 stx) (node 'qua 'many))

  ;; (nat n): Succ applied n times to Zero, as the module names them.
  (define (bend-nat stx)
    (syntax-match stx
      [(_ n)
       (let ([n (syntax-e n)])
         (unless (and (fixnum? n) (>= n 0)) (bend-error stx "expected (nat n), n a natural number"))
         (let loop ([i n] [t (datum->syntax stx 'Zero stx)])
           (if (= i 0) t (loop (- i 1) #`(#,(datum->syntax stx 'Succ stx) #,t)))))]))

  ;; (match x ... [(p ...) body] ...), a single scrutinee's patterns not in
  ;; parentheses: each row binds its patterns' variables in a lambda, and
  ;; the hole holds the rows' patterns, which read-body reads. A
  ;; scrutinee is a variable, as the flattener needs (core.sub).
  (define (bend-match stx)
    (syntax-match stx
      [(_ (? identifier? x) ... row ...)
       (when (null? x)
         (bend-error (if (pair? row) (car row) stx)
                     "expected a parameter or field scrutinee (a match cannot scrutinize a computed value: give it its own def)"))
       (let ([rows (map (lambda (r)
                          (syntax-match r
                            [(ps body)
                             (let ([ps (if (= (length x) 1) (list ps) (or (syntax->list ps) (bend-error ps "expected (pattern ...)")))])
                               (unless (= (length ps) (length x))
                                 (bend-error r "expected ~a pattern~a" (length x) (if (= (length x) 1) "" "s")))
                               (list ps (apply append (map pattern-vars ps)) body))]
                            [_ (bend-error r "expected a row [pattern body]")]))
                        row)])
         #`(#%app (#%hole bend match #,(datum (length x)) #,stx #,@(map (lambda (r) #`(#,@(car r))) rows)) #,@x
                  #,@(map (lambda (r) #`(lambda (#,@(map binder (cadr r))) #,(caddr r))) rows)))]))

  ;; A pattern's variables, in order: a variable, not a constructor's name,
  ;; is one, and (C p ...) has its patterns', one per field of C. _ binds
  ;; nothing.
  (define (pattern-vars p)
    (syntax-match p
      [(? identifier? x)
       (cond [(eq? (syntax-e x) '_) '()]
             [(constructor x) (fields-matched p x '()) '()]
             [else (list x)])]
      [((? identifier? c) q ...)
       (unless (constructor c) (bend-error c "~a is not a constructor" (syntax-e c)))
       (fields-matched p c q)
       (apply append (map pattern-vars q))]
      [_ (bend-error p "expected a pattern: a variable, _, C or (C pattern ...)")]))

  (define (fields-matched p c q)
    (let ([n (cdr (constructor c))])
      (unless (= (length q) n)
        (bend-error p "expected a ~a pattern with ~a field~a" (syntax-e c) n (if (= n 1) "" "s")))))

  ;; The constructor x names, as (name . fields), or #f.
  (define (constructor x)
    (let* ([name (k:identifier-name x)] [info (and name (name-kind name))])
      (and info (eq? (car info) 'ctr) (cons name (cadr info)))))

  (define (constructor-name x) (let ([c (constructor x)]) (and c (car c))))

  ;; ---- names ----

  ;; The transformer every name a module defines is bound to, by
  ;; (define-syntax f bend-name): one function, so the unit runs no code of
  ;; its own (spec 3.1). A use of a name in a term is (#%hole bend kind
  ;; name data ...), as its kind says: ref; ctr, and a constructor's
  ;; fields; tmpl, and a template's template parameters; or adt, and a
  ;; datatype's parameters n and the leading ones that are quantities g,
  ;; which can be left out, as in Bend: they are &1. So is an application's
  ;; head. In kernel code, a definition applied is a call of its function,
  ;; made once every law is filled (bend-call).
  (define (bend-name stx)
    (let* ([id (if (identifier? stx) stx (car (syntax-e stx)))]
           [name (k:identifier-name id)]
           [info (name-kind name)])
      (if reading?
          (let ([hole (datum->syntax #'here (syntax-e (apply node (car info) name (cdr info))) id)])
            (syntax-match stx
              [(_ a ...)
               (let ([a (if (and (eq? (car info) 'adt) (= (+ (length a) (caddr info)) (cadr info)))
                            (append (map (lambda (_) (node 'qua 'lone)) (range (caddr info))) a)
                            a)])
                 #`(#%app #,hole #,@a))]
              [_ hole]))
          (if (and (pair? (syntax-e stx)) (eq? (car info) 'ref))
              #`(let () (bend-call #,@(syntax-e stx)))
              (bend-error stx "expected, in kernel code, a definition called with its live arguments, (f x ...), or (print e)")))))

  ;; Each name's kind, (kind data ...), as its hole holds it: this module's
  ;; names', recorded as it defines them, before any use; another module's,
  ;; from the facts about them, read once; #f for a name not Bend's.
  (define kinds (make-hasheq))

  (define (kind! name . info) (hash-set! kinds name info))

  (define (name-kind name)
    (let ([info (hash-ref kinds name 'unknown)])
      (if (eq? info 'unknown)
          (let* ([d (findf (lambda (d) (memq (car d) '(adt ctr def template))) (fact-data name))]
                 [info (and d (case (car d)
                                [(adt) (list 'adt (cadr d) (caddr d))]
                                [(ctr) (list 'ctr (caddr d))]
                                [(template) (list 'tmpl (cadr d))]
                                [else (list 'ref)]))])
            (hash-set! kinds name info)
            info)
          info)))

  ;; ---- reading terms back ----
  ;;
  ;; A term's expansion as data (core.sub): env maps each local variable's
  ;; binding (spec 2.3) to its name and id, a number fresh for each binder,
  ;; which next counts. A node's syntax is where it came from, its location
  ;; alone: an error about the node is located there, and shows the node as
  ;; core.sub writes terms. The expansion itself is not kept.
  (define next 0)
  (define (fresh!) (set! next (+ next 1)) next)
  (define (bind x i env) (cons (cons (k:local-binding x) (cons (syntax-e x) i)) env))

  ;; Syntax e's location, as a syntax object of its own: a variable's name,
  ;; or _.
  (define (location e) (datum->syntax #f (if (identifier? e) (syntax-e e) '_) e))

  ;; f applied to the terms as, one at a time, as the application at s.
  (define (apps s f as) (foldl (lambda (a f) (list 'app f a s)) f as))

  (define (read-term e env)
    (let ([r (lambda (x) (read-term x env))] [s (location e)])
      (syntax-match e
        [(? identifier? x)
         (let ([v (and (k:local-binding x) (assv (k:local-binding x) env))])
           (unless v (bend-error x "~a is not a variable or a definition of Bend" (syntax-e x)))
           (list 'var (cadr v) (cddr v) s))]
        [('#%hole 'bend kind . data) (read-node e e s (syntax-e kind) (map syntax->datum data) '() env)]
        [('#%app (? hole? h) arg ...) (read-node e h s (syntax-e (caddr (syntax-e h))) (map syntax->datum (cdddr (syntax-e h))) arg env)]
        [('#%app f arg ...) (apps s (r f) (map r arg))]
        [('lambda ((x _)) body)
         (let ([i (fresh!)]) (list 'lam (syntax-e x) i (read-term body (bind x i env)) s))]
        [_ (bend-error e "this is not a Bend term")])))

  (define (hole? h) (syntax-match h [('#%hole 'bend . _) #t] [_ #f]))

  ;; Node kind of Bend, its hole's data, applied to args, as the
  ;; expression e, at s, whose hole is h.
  (define (read-node e h s kind data args env)
    (let ([r (lambda (x) (read-term x env))])
      (case kind
        [(ref tmpl) (when (eq? kind 'tmpl) (set! template-read #t))
                    (apps s (list 'ref (car data) (if (eq? h e) s (location h))) (map r args))]
        [(adt) (if (and (null? args) (> (cadr data) 0))
                   (list 'ref (car data) s)
                   (list 'adt (car data) (map r args) '() s))]
        [(ctr) (list 'ctr (car data) (map r args) s)]
        [(qua) (list 'qua (car data) s)]
        [(qnt) (list 'qnt s)]
        [(efq) (list 'efq s)]
        [(rfl) (list 'rfl s)]
        [(hol) (list 'hol (car data) s)]
        [(typ min eql rwt) (append (cons kind (map r args)) (list s))]
        [(ann) (list 'ann (r (car args)) (r (cadr args)) s)]
        [(mat)
         (syntax-match (car args)
           [('#%hole 'bend 'ctr name _) (list 'mat (syntax-e name) (r (cadr args)) (r (caddr args)) s)]
           [_ (bend-error (car args) "expected a constructor")])]
        [(all)
         (syntax-match (cadr args)
           [('lambda ((x _)) B)
            (let ([i (fresh!)])
              (list 'all (car data) (syntax-e x) i (r (car args)) (read-term B (bind x i env)) s))])]
        [(let)
         (syntax-match (last args)
           [('lambda ((x _) ...) f)
            (let ([is (map (lambda (x) (fresh!)) x)])
              (list 'let (map syntax-e x) is (car data) (map r (take args (length x)))
                    (read-term f (foldl bind env x is)) s))])]
        [(match) (bend-error (list-ref (syntax->list h) 4) "expected a match only as a body, a definition's or a case's: a term splits with split")]
        [else (bend-error e "this is not a Bend term")])))

  ;; A body read back: a term, or (match (e ...) (((p ...) body) ...) s), s
  ;; the match as it is written.
  (define (read-body e env)
    (syntax-match e
      [('#%app ('#%hole 'bend 'match n form row ...) arg ...)
       (let ([n (syntax-e n)])
         (list 'match (map (lambda (x) (read-term x env)) (take arg n))
               (map (lambda (ps lam)
                      (syntax-match lam
                        [('lambda ((x _) ...) body)
                         (let ([is (map (lambda (x) (fresh!)) x)])
                           (list (patterns (syntax->list ps) (map list (map syntax-e x) is (map location x)))
                                 (read-body body (foldl bind env x is))))]))
                    row (list-tail arg n))
               form))]
      [_ (read-term e env)]))

  ;; A row's patterns ps as data, its variables vars, each (k i x), taken
  ;; in order; a _ is a variable of its own, which nothing refers to.
  (define (patterns ps vars)
    (letrec ([build (lambda (p)
                      (syntax-match p
                        [(? identifier? x)
                         (let ([c (constructor-name x)])
                           (cond [c (list 'pctr c '() p)]
                                 [(eq? (syntax-e x) '_) (list 'pvar '_ (fresh!) x)]
                                 [else (let ([v (car vars)]) (set! vars (cdr vars)) (cons 'pvar v))]))]
                        [(c q ...) (list 'pctr (constructor-name c) (map build q) p)]))])
      (map build ps)))

  ;; ---- definitions ----
  ;;
  ;; The definitions this module makes are checked as they are read, in
  ;; order, as core.sub's events, against the module's book (below). Each
  ;; with a value is kept, checked, as (n T e where), by name, until
  ;; bend-code makes its function's body.
  (define checked (make-hasheq))

  ;; Table t's value for key k, which it no longer holds; and a new key.
  (define (take! t k) (let ([v (hash-ref t k)]) (hash-remove! t k) v))
  (define tickets 0)
  (define (ticket!) (set! tickets (+ tickets 1)) tickets)

  (define (check! event)
    (let ([c (validate! book event)])
      (when c (hash-set! checked (car c) (list (cadr c) (caddr c) (cadddr c) (last event))))))

  ;; The function of a definition, key, named id, of type T with n
  ;; parameters: a function of the live ones, whose body is made when the
  ;; kernel expands it (bend-code).
  (define (function-form key id T n)
    (let ([ps (map (lambda (p) (datum->syntax #'here p)) (def-params T n))])
      #`(func (#,id #,@(map (lambda (p) #`[#,p eqref]) ps)) -> eqref (bend-code #,key #,@ps))))

  ;; The function of definition f, named name, checked: lifted, and its
  ;; name.
  (define (function! f name)
    (let ([id (datum->syntax #'here (syntax-e f))] [c (hash-ref checked name)])
      (syntax-local-lift-definition (function-form f id (cadr c) (car c)))
      (let ([code (k:identifier-name (k:syntax-local-introduce id))])
        (hash-set! own-codes name code)
        code)))

  ;; Type syntax T, expanded and read back.
  (define (read-type T) (set! next 0) (set! template-read #f) (read-term (read-expand T) '()))

  ;; Whether the term read last applies a template.
  (define template-read #f)

  ;; A definition's value from its parameters xs and its body: the body,
  ;; the parameters bound, expanded, read back and flattened.
  (define (read-value xs body)
    (set! next 0)
    (set! template-read #f)
    (syntax-match (read-expand #`(lambda (#,@(map binder xs)) #,body))
      [('lambda ((x _) ...) b)
       (let* ([is (map (lambda (x) (fresh!)) x)]
              [body (read-body b (foldl bind '() x is))])
         (flatten-definition body (map (lambda (x i) (list 'pvar (syntax-e x) i (location x))) x is) next #t))]))

  ;; A fact about id: d, data (spec 6.6), its terms without their syntax.
  ;; A template's is syntax: another module checks the template's
  ;; instances, so the template's terms are (#:term data syntaxes), their
  ;; data and where each of their nodes came from, apart (core.sub), so
  ;; that errors in an instance are located in the template as a local
  ;; template's are.
  (define (fact id d) #`(#%fact #,id '#,(datum d)))
  (define (syntax-fact id d) #`(#%fact #,id #'#,(datum d)))

  (define (fact-term d)
    (list '#:term (strip-datum d) (map (lambda (s) (and s (datum->syntax #f '_ s))) (term-syntaxes d))))

  ;; A fact as data, its terms whole.
  (define (fact->datum x)
    (let ([l (and (syntax? x) (syntax->list x))])
      (cond [(not (syntax? x)) x]
            [(and l (pair? l) (eq? (syntax-e (car l)) '#:term))
             (with-syntaxes (syntax->datum (cadr l))
                            (map (lambda (s) (and (syntax-e s) s)) (syntax->list (caddr l))))]
            [l (map fact->datum l)]
            [else (syntax-e x)])))

  ;; (type (D p ...) K [C field ...] ...), or (type D K ...): D and each C
  ;; bound, then (type-info ...), which reads their types.
  (define (type-parts stx)
    (syntax-match stx
      [(_ head K ctr ...)
       (list (syntax-match head
               [((? identifier? d) p ...) (cons d (map param-spec p))]
               [(? identifier? d) (list d)]
               [_ (bend-error head "expected (D parameter ...) or D")])
             K
             (map (lambda (c)
                    (syntax-match c
                      [((? identifier? n) f ...)
                       (cons n (map (lambda (f) (or (bind-spec f) (bend-error f "expected a field: [q x : A]"))) f))]
                      [(? identifier? n) (list n)]
                      [_ (bend-error c "expected a constructor: [C field ...]")]))
                  ctr))]
      [_ (bend-error stx "expected (type (D parameter ...) K [C field ...] ...)")]))

  (define (bend-type stx)
    (let* ([parts (type-parts stx)] [h (car parts)] [ps (cdr h)])
      #`(begin
          (define-syntax #,(car h) bend-name)
          #,@(map (lambda (c) #`(define-syntax #,(car c) bend-name)) (caddr parts))
          (type-info #,stx))))

  (define (type-info stx)
    (syntax-match stx
      [(_ form)
       (let* ([parts (type-parts form)] [d (car (car parts))] [ps (cdr (car parts))]
              [n (length ps)]
              [g (leading-quantities ps)]
              [kinds (begin (kind! (k:identifier-name d) 'adt n g)
                            (for-each (lambda (c) (kind! (k:identifier-name (car c)) 'ctr (length (cdr c)))) (caddr parts)))]
              [T (resolve (read-type (arrow ps (cadr parts))) form)]
              [tip (if (null? ps) d #`(#%app #,d #,@(map cadr ps)))]
              [cs (map (lambda (c) (list (k:identifier-name (car c)) (length (cdr c)) (resolve (read-type (arrow (append ps (cdr c)) tip)) form)))
                       (caddr parts))])
         (check! (list 'adt (k:identifier-name d) n g T cs form))
         #`(begin
             #,(fact d (list 'adt n g (strip-datum T) (map (lambda (c) (list (car c) (cadr c) (strip-datum (caddr c)))) cs)))
             #,@(map (lambda (c part) (fact (car part) (list 'ctr (car c) (cadr c) (strip-datum (caddr c)))))
                     cs (caddr parts))))]))

  ;; (def (f [q x : A] ...) R body): f bound, then its type and body read
  ;; and checked, and its function lifted. (def (f x ...) body): f's law
  ;; filled, and its function lifted. The function's name, which the facts
  ;; about f hold, is how code calls it (spec 6.7).
  (define (bend-def stx)
    (syntax-match stx
      [(_ ((? identifier? f) (? identifier? x) ...) body) (fill-info stx)]
      [(_ ((? identifier? f) b ...) R body)
       (if (> (leading-templates (def-specs b)) 0)
           #`(begin (define-syntax #,f bend-name) (template-info #,stx))
           #`(begin (define-syntax #,f bend-name) (def-info #,stx)))]
      [_ (bend-error stx "expected (def (f [q x : A] ...) R body), or (def (f x ...) body) to fill a law")]))

  (define (def-specs b) (map (lambda (b) (or (bind-spec b) (bend-error b "expected a parameter: [q x : A]"))) b))

  ;; How many of a def's parameters, from the first, are a template's; and
  ;; its parameters with each ~ erased, as a ~ after the first is, as in
  ;; Bend.
  (define (leading-templates specs)
    (let loop ([ps specs] [m 0]) (if (and (pair? ps) (eq? (car (car ps)) 'template)) (loop (cdr ps) (+ m 1)) m)))

  (define (erase-templates specs)
    (map (lambda (s) (if (eq? (car s) 'template) (cons 'none (cdr s)) s)) specs))

  ;; The names of the functions of this module's definitions, by the
  ;; definitions' names.
  (define own-codes (make-hasheq))

  ;; (def-info form), (law-info form): the forms' second steps, once f is
  ;; bound; and a fill.
  (define (def-info stx)
    (let ([form (cadr (syntax->list stx))])
      (syntax-match form
        [(_ (f b ...) R body)
         (kind! (k:identifier-name f) 'ref)
         (let* ([specs (erase-templates (def-specs b))]
                [T (resolve (read-type (arrow specs R)) form)]
                [v (resolve (read-value (map cadr specs) body) form)]
                [name (k:identifier-name f)])
           (check! (list 'def name (length specs) T v form))
           (fact f (list 'def (length specs) (strip-datum T) (strip-datum v) (function! f name))))])))

  (define (bend-law stx)
    (syntax-match stx
      [(_ ((? identifier? f) b ...) R)
       #`(begin (define-syntax #,f bend-name) (law-info #,stx))]
      [_ (bend-error stx "expected (law (f [q x : A] ...) R)")]))

  (define (law-info stx)
    (let ([form (cadr (syntax->list stx))])
      (syntax-match form
        [(_ (f b ...) R)
         (kind! (k:identifier-name f) 'ref)
         (let* ([specs (def-specs b)] [T (resolve (read-type (arrow specs R)) form)])
           (check! (list 'def (k:identifier-name f) (length specs) T #f form))
           (fact f (list 'def (length specs) (strip-datum T) #f #f)))])))

  (define (fill-info form)
    (syntax-match form
      [(_ (f x ...) body)
       (unless (let ([info (let ([name (k:identifier-name f)]) (and name (name-kind name)))]) (and info (eq? (car info) 'ref)))
         (bend-error f "~a is not a law to fill" (syntax-e f)))
       (let ([v (resolve (read-value x body) form)] [name (k:identifier-name f)])
         (check! (list 'fill name v form))
         (fact f (list 'fill (strip-datum v) (function! f name))))]))

  ;; ---- templates ----
  ;;
  ;; A def whose first parameters are [~ x : A] is a template, as in Bend:
  ;; not a definition, which is checked and compiled, but its instances
  ;; are, each a definition of the rest of its parameters. An application
  ;; of a template gives it its template arguments first, closed terms;
  ;; its instance at them is the template's type and value with them put
  ;; for its template parameters, and it is shared by every application at
  ;; the same arguments: an instance's own recursion reaches it. A lambda
  ;; argument applied in the template is put in place, as Bend puts it, so
  ;; the instance calls no closure. A template is read, and kept, as data, with
  ;; the applications of templates in it left for its instances. An
  ;; instance is a definition of its own, its function, whose name is its
  ;; name: a fact about it holds it, as for a def, and a fact about the
  ;; template names it, so a module that requires this one uses it too.

  ;; This module's templates, and those found in facts, by name: (m n T v
  ;; where), m template parameters of n; or #f for other names.
  (define templates (make-hasheq))

  (define (template-info stx)
    (let ([form (cadr (syntax->list stx))])
      (syntax-match form
        [(_ (f b ...) R body)
         (kind! (k:identifier-name f) 'tmpl (leading-templates (def-specs b)))
         (let* ([specs (def-specs b)] [m (leading-templates specs)] [specs (erase-templates specs)]
                [T (read-type (arrow specs R))]
                [v (read-value (map cadr specs) body)])
           (hash-set! templates (k:identifier-name f) (list m (length specs) T v form))
           (syntax-fact f (list 'template m (length specs) (fact-term T) (fact-term v))))])))

  (define (template-of k)
    (let ([info (name-kind k)])
      (and info (eq? (car info) 'tmpl)
           (or (hash-ref templates k #f)
               (let ([t (append (cdr (findf (lambda (d) (eq? (car d) 'template)) (fact-data k))) (list #f))])
                 (hash-set! templates k t)
                 t)))))

  (define (fact-data k) (map (lambda (f) (fact->datum (caddr f))) (k:syntax-local-facts (k:name-identifier k))))

  ;; Term d, as data, each application of a template made one of its
  ;; instance; at locates errors. A term just read that applies none is as
  ;; it is.
  (define (resolve d at) (if template-read (resolve-calls d at) d))

  (define (resolve-calls d at)
    (rewrite-calls d (lambda (k xs s)
                       (let ([t (template-of k)])
                         (and t (template-call k t xs (or s at) at))))))

  (define (template-call k t xs s at)
    (let ([m (car t)]
          [call (datum->syntax #f (string->symbol (datum-show (apps s (list 'ref k s) xs))) s)])
      (when (< (length xs) m)
        (bend-error call "expected ~a applied to its ~a template argument~a first" (short k) m (if (= m 1) "" "s")))
      (let ([args (take xs m)])
        (for-each (lambda (x)
                    (unless (closed? x)
                      (bend-error call "expected closed template arguments to ~a: this one uses a local variable, which only a run-time argument can" (short k))))
                  args)
        (cons (instance k t args at) m))))

  ;; The instances made, by (template . key), as names, and how many each
  ;; template has here.
  (define instances (make-hash))
  (define counts (make-hasheq))

  (define (instance k t args at)
    (let ([key (cons k (map term-key args))])
      (or (hash-ref instances key #f)
          (and (not (list-ref t 4)) (hash-ref (required-instances k) key #f))
          (make-instance k t args key at))))

  ;; The instances of template k that modules this one requires made, as
  ;; facts about it say, read once: made here, one is in instances.
  (define required (make-hasheq))
  (define (required-instances k)
    (or (hash-ref required k #f)
        (let ([is (make-hash)])
          (for-each (lambda (d) (when (eq? (car d) 'instance) (hash-set! is (cadr d) (caddr d)))) (fact-data k))
          (hash-set! required k is)
          is)))

  ;; A new instance, k~n: its function lifted, whose name is the
  ;; instance's, then (instance-info id i), which checks it, after the
  ;; instances it applies, before its function's body is made, which it may
  ;; be at once. As in Bend, arguments written in more than 2048 characters
  ;; make none: a template whose recursion grows its arguments stops there.
  (define (make-instance k t args key at)
    (when (> (apply + (map (lambda (a) (+ 1 (string-utf-8-length (datum-show a)))) args)) 2048)
      (bend-error at "expected the template arguments of ~a to stop growing: each call makes an instance" (short k)))
    (let* ([n (hash-ref counts k 0)]
           [id (datum->syntax #'here (string->symbol (format "~a~~~a" (short k) n)))]
           [where (or (list-ref t 4) at)]
           [m (- (cadr t) (car t))]
           [T (term-instantiate (caddr t) args)]
           [v (term-instantiate (cadddr t) args)]
           [i (ticket!)])
      (hash-set! counts k (+ n 1))
      (unless (and T v) (bend-error where "expected ~a's template parameters to be its first, and not matched" (short k)))
      (hash-set! making i (list k key m T v where))
      (syntax-local-lift-definition
       #`(begin #,(function-form id id (term-higher (datum->term T) '()) m) (instance-info #,id #,(datum i))))
      (hash-ref instances key)))

  ;; The instances being made, each (k key m T v where), by ticket.
  (define making (make-hasheqv))

  (define (instance-info stx)
    (let* ([id (cadr (syntax->list stx))]
           [name (k:identifier-name id)]
           [p (take! making (syntax-e (caddr (syntax->list stx))))]
           [k (car p)] [key (cadr p)] [m (caddr p)] [where (list-ref p 5)])
      (hash-set! instances key name)
      (hash-set! own-codes name name)
      (kind! name 'ref)
      (let ([T (resolve-calls (cadddr p) where)] [v (resolve-calls (list-ref p 4) where)])
        (check! (list 'def name m T v where))
        #`(begin #,(fact id (list 'def m (strip-datum T) (strip-datum v) name))
                 #,(fact (k:syntax-local-introduce (k:name-identifier k)) (list 'instance key name))))))

  ;; ---- print ----

  ;; (print e), in kernel code: e's value written, and a newline. e is a
  ;; term, read here, whose type says how to write its value (lower.sub):
  ;; (bend-show i), print i of the module, checks it and makes its
  ;; code once every law is filled. Each print is (e where), e as data.
  (define prints (make-hasheqv))

  (define (bend-print stx)
    (syntax-match stx
      [(_ e)
       (set! next 0)
       (set! template-read #f)
       (let ([t (resolve (read-term (read-expand e) '()) stx)] [i (ticket!)])
         (hash-set! prints i (list t stx))
         #`(let () (bend-show #,(datum i))))]
      [_ (bend-error stx "expected (print e)")]))

  (define (bend-show stx)
    (let* ([p (take! prints (syntax-e (cadr (syntax->list stx))))]
           [c (infer-closed book (car p) (cadr p))])
      (generated (print-code (car c) (cdr c) (cadr p)))))

  ;; ---- code ----
  ;;
  ;; A module-level form's macro runs in the kernel's first pass, before
  ;; the forms after it are read; an expression's, a function's body among
  ;; them, in the second, once every definition of the module is checked
  ;; and every law filled (spec 5.2). So a function's body is (bend-code f
  ;; p ...), and a print and a call in kernel code wait in (let () ...).

  ;; (bend-code f p ...): the body of the function of definition f, whose
  ;; live parameters are p ...: its value, checked, as code.
  (define (bend-code stx)
    (let* ([parts (syntax->list stx)] [name (k:identifier-name (cadr parts))] [c (take! checked name)])
      (generated (def-body name (cadr c) (caddr c) (map (lambda (p) (k:syntax-local-introduce p)) (cddr parts)) (cadddr c)))))

  ;; (bend-call f a ...), in kernel code: a call of definition f's
  ;; function, which takes its live arguments.
  (define (bend-call stx)
    (syntax-match stx
      [(_ f a ...) #`(#%app #,(k:syntax-local-introduce (code-of (k:identifier-name f))) #,@a)]))

  ;; Code lower.sub made as data, as syntax, and the forms it needs, lifted
  ;; first. Every piece names what they define alike: with bend.sub's
  ;; scopes and one of this module's own, scope's.
  (define scope #f)

  (define (generated d)
    (unless scope (set! scope (k:syntax-local-introduce (datum->syntax #'here 'bend))))
    (let ([forms (lowered-forms!)])
      (unless (null? forms)
        (syntax-local-lift-definition (k:syntax-local-introduce (datum->syntax scope (cons 'begin forms))))))
    (k:syntax-local-introduce (datum->syntax scope d)))

  ;; The function of definition name, an identifier.
  (define (code-of name)
    (let ([c (or (hash-ref own-codes name #f) (hash-ref codes name #f) (begin (lookup name) (hash-ref codes name #f)))])
      (unless c (raise-syntax-error 'bend (format "~a has no code: it is a law no module has filled, or a datatype" (short name)) #f))
      (k:name-identifier c)))

  ;; The names of the functions of other modules' definitions, as lookup
  ;; found them.
  (define codes (make-hasheq))

  ;; What the modules this one requires say of name, from the facts about
  ;; it: its definition's information, a law's filled by a fill if one is.
  ;; This module has none yet about a name the book looks up.
  (define (lookup name)
    (let* ([data (fact-data name)]
           [info (findf (lambda (d) (memq (car d) '(adt ctr def))) data)]
           [fill (findf (lambda (d) (eq? (car d) 'fill)) data)])
      (cond [(not info) #f]
            [(eq? (car info) 'def)
             (let ([v (or (cadddr info) (and fill (cadr fill)))] [code (or (list-ref info 4) (and fill (caddr fill)))])
               (when code (hash-set! codes name code))
               (list 'def (cadr info) (caddr info) v))]
            [else info])))

  ;; The module's book, which its definitions are checked against and its
  ;; code is made with.
  (define book (new-book lookup))
  (lower-start! book code-of))

(define-syntax bend-type bend-type)
(define-syntax type-info type-info)
(define-syntax bend-def bend-def)
(define-syntax def-info def-info)
(define-syntax template-info template-info)
(define-syntax instance-info instance-info)
(define-syntax bend-law bend-law)
(define-syntax law-info law-info)
(define-syntax bend-match bend-match)
(define-syntax bend-fn bend-fn)
(define-syntax bend-arrow bend-arrow)
(define-syntax bend-let bend-let)
(define-syntax bend-split bend-split)
(define-syntax bend-absurd bend-absurd)
(define-syntax bend-eql bend-eql)
(define-syntax bend-refl bend-refl)
(define-syntax bend-rewrite bend-rewrite)
(define-syntax bend-the bend-the)
(define-syntax bend-hole bend-hole)
(define-syntax bend-nat bend-nat)
(define-syntax bend-kind bend-kind)
(define-syntax bend-meet bend-meet)
(define-syntax bend-Type bend-Type)
(define-syntax bend-Data bend-Data)
(define-syntax bend-Quant bend-Quant)
(define-syntax bend-q0 bend-q0)
(define-syntax bend-q1 bend-q1)
