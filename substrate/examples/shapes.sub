;; Structs and enums defined in one module (shapes/shape.sub) and matched in
;; another, with lib/struct.sub and lib/match.sub. Both are ordinary
;; libraries: macros that share static information.
(require print "../lib/print.sub" write-int newline)
(require m "../lib/match.sub" match)
(require sh "shapes/shape.sub" point make-point shape make-circle make-square make-rect circle square rect)

(func (area [s (ref shape)]) -> i32
  (match s
    [(circle r) (i32.mul 3 (i32.mul r r))]
    [(square side) (i32.mul side side)]
    [(rect w h) (i32.mul w h)]))

(func (corners [s (ref shape)]) -> i32
  (match s
    [(rect _ _) 4]
    [(square _) 4]
    [else 0]))

(func (manhattan [p (ref point)]) -> i32
  (match p [(point x y) (i32.add x y)]))

(func (main)
  (write-int (area (make-circle 2))) (newline)
  (write-int (area (make-square 2))) (newline)
  (write-int (area (make-rect 2 5))) (newline)
  (write-int (corners (make-circle 1))) (newline)
  (write-int (corners (make-square 1))) (newline)
  (write-int (manhattan (make-point 3 4))) (newline)
  (write-int (sh:circle? (make-square 2))) (newline))
