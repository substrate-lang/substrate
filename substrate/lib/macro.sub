;; define-macro, written with the kernel alone:
;;
;;   (define-macro (name stx) body ...)
;;
;; defines a phase-1 function `name` from syntax to syntax and makes `name`
;; at this phase a macro that calls it. The two `name`s live at different
;; phases, so they do not collide. define-macro is itself defined this way:
;; a phase-1 function, then define-syntax. Temporary: an included file
;; until modules exist.

(begin-for-syntax
  (func (define-macro [stx i32]) -> i32
    (let* ([parts (syntax->list stx)]
           [head (syntax->list (cadr parts))])
      #`(begin
          (begin-for-syntax
            (func (#,(car head) [#,(cadr head) i32]) -> i32 #,@(cddr parts)))
          (define-syntax #,(car head) #,(car head))))))

(define-syntax define-macro define-macro)
