;; Lifecycle: permanent library: Substrate, the language most code is
;; written in, defined on the Substrate kernel. The compiler is written in
;; it.
;;
;; Values are the kernel module's data (spec 2.2) plus closures, vectors,
;; byte strings, structs, hash tables and boxes. Every value is an eqref,
;; and #f is the only false value. A module written in Substrate takes its
;; forms with require-unqualified:
;;
;;   (define (f x ...) body ...)   a known function (below)
;;   (define (f x ... . rest) body ...)
;;                                  a function whose rest is a list of the
;;                                  arguments after the x ..., bound to a
;;                                  closure
;;   (define f (lambda (x ...) ...)) a known function too
;;   (define f (case-lambda ...))   a known function running its first
;;                                  clause with fixed parameters, if it has
;;                                  one, whose value is the case-lambda
;;   (define f (lambda ...)), (define f (case-lambda ...))
;;                                  otherwise, a function bound to a closure
;;   (define (f x ...) #:inline body ...), (define f #:inline e)
;;                                  a known function that is inline (spec
;;                                  5.2): its body is compiled into each
;;                                  direct call of it
;;   (define x e)                   a variable
;;   (lambda params body ...)       a closure, with params (x ...),
;;                                  (x ... . rest) or rest
;;   (case-lambda [params body ...] ...)
;;                                  a closure that runs the first clause
;;                                  taking the arguments it is given
;;   (set! x e)                     assign x; the value is #f
;;   (f arg ...)                    a call: of a closure, or of a kernel
;;                                  function, such as a known function,
;;                                  which is called directly if it takes
;;                                  that many arguments
;;   if, cond (with else), case (with else), when, unless, and, or, let
;;   (also named let), letrec, do; quasiquote and let* are the kernel's;
;;   literals are values, so 42 is a fixnum
;;   (struct name (field ...) option ...)
;;                                  a struct: the constructor name,
;;                                  the predicate name?, an accessor
;;                                  name-field per field, and a mutator
;;                                  set-name-field! per mutable field; a
;;                                  field is id or [id #:mutable], and
;;                                  the option #:mutable makes them all
;;                                  mutable
;;   (define-syntax (name stx) body ...), (define-syntax name expr)
;;                                  a macro, if the value is a procedure,
;;                                  which becomes its transformer; the
;;                                  module must also take Substrate at
;;                                  phase 1
;;   #%linklet                      the hook that lowers every lambda
;;                                  (spec 6.5)
;;   (with-handlers ([pred handler] ...) body ...)
;;                                  body's value; if body raises a value
;;                                  that a pred is true of, the value of
;;                                  the first such pred's handler, called
;;                                  with it once body has been left
;;   (syntax-match subject [pattern body ...] ...)
;;                                  the body of the first clause whose
;;                                  pattern subject matches, with the
;;                                  pattern's variables bound (syntax
;;                                  patterns, below)
;;
;; and the functions the provides below list, grouped as they are defined
;; there. A function given an argument of the wrong type, or the wrong
;; number of arguments, raises an exception that names it (exn?,
;; exn-message), as error does. Raising a value, with raise or as an
;; error, throws it to a handler with-handlers installed that takes it; if
;; there is none, the program stops there, with the value's message and a
;; backtrace. So does compile-time code, whose handlers are those of its
;; own phase; syntax errors, which raise-syntax-error and the expander
;; throw, always reach the compiler's, or a macro's around local-expand
;; that takes them (syntax-error?). Characters are
;; classified and cased as ASCII. Strings are UTF-8, indexed by byte; the
;; functions that take byte indexes say UTF-8 in their names.
;;
;; Integers are exact up to 64 bits; arithmetic beyond that is an error.
;; A program's entry point is its function main: (define (main) ...), or a
;; kernel (func (main) ...).
;;
;; Substrate is two modules. Its core (substrate-core.sub) is kernel code:
;; values and calls, closures and their conversion, the forms define,
;; lambda, case-lambda, set!, if, let, letrec, struct and define-syntax, and
;; the functions that work on the wasm representation of values. This
;; module is written in Substrate on the core: its other forms, and the
;; functions over lists that are loops. Its macros run in Substrate too, so
;; they are written with the core's forms: a module cannot require itself
;; for its compile-time code.

(require-unqualified core "substrate-core.sub")
(begin-for-syntax (require-unqualified core "substrate-core.sub"))

(provide (except-out (all-from-out core) call-with-handlers) else when unless and or cond case do with-handlers
         syntax-match _ ... ?
         list-tail list-ref last-pair take [drop list-drop] last findf range sort
         memq memv member assq assv assoc map for-each andmap ormap filter foldl foldr)

;; ---- forms -----------------------------------------------------------------------------

;; else is a keyword of clauses, such as cond's and case's last, which the
;; forms compare by binding; as an expression it is an error.
(define-syntax (else stx) (raise-syntax-error #f "not allowed as an expression" stx))

;; Helpers of the macros below, at phase 1.
(begin-for-syntax
  (define (else? x) (if (identifier? x) (free-identifier=? x #'else) #f))

  ;; The cond clauses of case's clauses cs, testing k: case binds it.
  (define (case-clauses cs)
    (if (null? cs)
        '()
        (let ([c (syntax->list (car cs))])
          (if (not c) (raise-syntax-error 'case "expected a clause: [(datum ...) body ...]" (car cs)))
          (cons (if (else? (car c))
                    #`[else #,@(cdr c)]
                    #`[(#,(if (eq-datums? (syntax->datum (car c))) #'memq #'member) k '#,(car c)) #,@(cdr c)])
                (case-clauses (cdr cs))))))

  ;; Whether ds is a list of datums that equal? compares as references:
  ;; symbols and keywords, which are interned, fixnums, booleans and ().
  (define (eq-datums? ds)
    (if (null? ds)
        #t
        (if (pair? ds)
            (let ([d (car ds)])
              (if (if (symbol? d) #t (if (keyword? d) #t (if (fixnum? d) #t (if (boolean? d) #t (null? d)))))
                  (eq-datums? (cdr ds))
                  #f))
            #f)))

  ;; Part i of each of with-handlers' clauses cs, [pred handler].
  (define (clause-parts cs i)
    (if (null? cs)
        '()
        (let ([c (syntax->list (car cs))])
          (if (if c (= (length c) 2) #f)
              (cons (if (= i 0) (car c) (car (cdr c))) (clause-parts (cdr cs) i))
              (raise-syntax-error 'with-handlers "expected a clause: [pred handler]" (car cs))))))

  (define (do-inits specs)
    (if (null? specs)
        '()
        (let ([spec (syntax->list (car specs))])
          (cons #`[#,(car spec) #,(car (cdr spec))] (do-inits (cdr specs))))))

  (define (do-steps specs)
    (if (null? specs)
        '()
        (let ([spec (syntax->list (car specs))])
          (cons (if (null? (cdr (cdr spec))) (car spec) (car (cdr (cdr spec)))) (do-steps (cdr specs)))))))

(define-syntax (when stx)
  (let ([parts (syntax->list stx)])
    #`(if #,(car (cdr parts)) (begin #,@(cdr (cdr parts))))))

(define-syntax (unless stx)
  (let ([parts (syntax->list stx)])
    #`(if #,(car (cdr parts)) '#f (begin #,@(cdr (cdr parts))))))

(define-syntax (and stx)
  (let ([args (cdr (syntax->list stx))])
    (if (null? args)
        #''#t
        (if (null? (cdr args))
            (car args)
            #`(if #,(car args) (and #,@(cdr args)) '#f)))))

(define-syntax (or stx)
  (let ([args (cdr (syntax->list stx))])
    (if (null? args)
        #''#f
        (if (null? (cdr args))
            (car args)
            #`(let ([t #,(car args)]) (if t t (or #,@(cdr args))))))))

;; (cond [test body ...] ... [else body ...])
(define-syntax (cond stx)
  (let ([clauses (cdr (syntax->list stx))])
    (if (null? clauses)
        #''#f
        (let ([c (syntax->list (car clauses))])
          (if (else? (car c))
              #`(begin #,@(cdr c))
              #`(if #,(car c) (begin #,@(cdr c)) (cond #,@(cdr clauses))))))))

;; (case key [(datum ...) body ...] ... [else body ...]): the first clause
;; with a datum equal? to key. A clause whose datums equal? compares as
;; references is tested with memq.
(define-syntax (case stx)
  (let ([parts (syntax->list stx)])
    #`(let ([k #,(car (cdr parts))]) (cond #,@(case-clauses (cdr (cdr parts)))))))

;; (do ([x init step] ...) (test result ...) body ...): a loop. A variable
;; without a step keeps its value.
(define-syntax (do stx)
  (let* ([parts (syntax->list stx)]
         [specs (syntax->list (car (cdr parts)))]
         [end (syntax->list (car (cdr (cdr parts))))])
    #`(let loop (#,@(do-inits specs))
        (if #,(car end)
            (begin '#f #,@(cdr end))
            (begin #,@(cdr (cdr (cdr parts))) (loop #,@(do-steps specs)))))))

;; (with-handlers ([pred handler] ...) body ...)
(define-syntax (with-handlers stx)
  (let* ([parts (syntax->list stx)] [clauses (syntax->list (car (cdr parts)))])
    #`(call-with-handlers (list #,@(clause-parts clauses 0)) (list #,@(clause-parts clauses 1))
                          (lambda () #,@(cdr (cdr parts))))))

;; ---- lists -----------------------------------------------------------------------------
;;
;; Each function checks its arguments and names itself in its errors, as
;; the core's do. A loop is a function calling itself in tail position.

;; l, which must be a list, for function who.
(define (list-of l who) (if (list? l) l (error who "expected a list, got ~s" l)))

;; k, which must be a count: an integer from 0 up.
(define (count-of k who)
  (cond [(and (fixnum? k) (>= k 0)) k]
        [(integer? k) (error who "index ~s is out of range" k)]
        [else (error who "expected an integer, got ~s" k)]))

;; l after its first n elements, for function who, given index k.
(define (tail-of l n k who)
  (cond [(= n 0) l]
        [(pair? l) (tail-of (cdr l) (- n 1) k who)]
        [else (error who "index ~s is out of range" k)]))

(define (list-tail l k) (tail-of l (count-of k 'list-tail) k 'list-tail))
;; Provided as drop: in kernel code, drop is the wasm instruction.
(define (list-drop l k) (tail-of l (count-of k 'drop) k 'drop))

(define (list-ref l k)
  (let ([t (tail-of l (count-of k 'list-ref) k 'list-ref)])
    (if (pair? t) (car t) (error 'list-ref "index ~s is out of range" k))))

;; The first k elements of l.
(define (take l k) (take-of l (count-of k 'take) k '()))

(define (take-of l n k acc)
  (cond [(= n 0) (reverse acc)]
        [(pair? l) (take-of (cdr l) (- n 1) k (cons (car l) acc))]
        [else (error 'take "index ~s is out of range" k)]))

(define (last-pair l) (if (pair? l) (last-pair-of l) (error 'last-pair "expected a pair, got ~s" l)))
(define (last-pair-of p) (if (pair? (cdr p)) (last-pair-of (cdr p)) p))
(define (last l) (if (pair? l) (car (last-pair-of l)) (error 'last "expected a pair, got ~s" l)))

;; The first element of l that f is true of, or #f.
(define (findf f l) (find-in f (list-of l 'findf)))
(define (find-in f l)
  (cond [(null? l) #f]
        [(f (car l)) (car l)]
        [else (find-in f (cdr l))]))

;; (range end) or (range start end): the integers from start, or 0, up to
;; but not including end.
(define range
  (case-lambda
    [(end) (range-down (- (count-of end 'range) 1) 0 '())]
    [(start end) (let ([s (count-of start 'range)]) (range-down (- (count-of end 'range) 1) s '()))]))
(define (range-down i start acc) (if (< i start) acc (range-down (- i 1) start (cons i acc))))

;; l sorted by less?, keeping the order of elements neither is less than
;; the other: a stable merge sort.
(define (sort l less?) (merge-sort (list-of l 'sort) (length l) less?))

(define (merge-sort l n less?)
  (if (<= n 1)
      l
      (let ([h (quotient n 2)])
        (merge (merge-sort (take-of l h h '()) h less?) (merge-sort (tail-of l h h 'sort) (- n h) less?) less? '()))))

;; Sorted lists a and b as one sorted list; of equal elements, a's first.
(define (merge a b less? acc)
  (cond [(null? a) (reverse-onto acc b)]
        [(null? b) (reverse-onto acc a)]
        [(less? (car b) (car a)) (merge a (cdr b) less? (cons (car b) acc))]
        [else (merge (cdr a) b less? (cons (car a) acc))]))

;; acc reversed, followed by l.
(define (reverse-onto acc l) (if (null? acc) l (reverse-onto (cdr acc) (cons (car acc) l))))

;; The first tail of l whose car is x, by eq?, eqv? or equal?.
(define (memq x l) (cond [(not (pair? l)) #f] [(eq? x (car l)) l] [else (memq x (cdr l))]))
(define (memv x l) (cond [(not (pair? l)) #f] [(eqv? x (car l)) l] [else (memv x (cdr l))]))
(define (member x l) (cond [(not (pair? l)) #f] [(equal? x (car l)) l] [else (member x (cdr l))]))

;; The first pair of alist l whose car is x, by eq?, eqv? or equal?.
(define (assq x l) (cond [(not (pair? l)) #f] [(eq? x (key-of (car l) 'assq)) (car l)] [else (assq x (cdr l))]))
(define (assv x l) (cond [(not (pair? l)) #f] [(eqv? x (key-of (car l) 'assv)) (car l)] [else (assv x (cdr l))]))
(define (assoc x l) (cond [(not (pair? l)) #f] [(equal? x (key-of (car l) 'assoc)) (car l)] [else (assoc x (cdr l))]))
(define (key-of p who) (if (pair? p) (car p) (error who "expected a pair, got ~s" p)))

;; f applied to the elements of lists in order: their results as a list
;; (map), nothing (for-each), whether all are true (andmap) or the first
;; true one (ormap). The lists must have one length.
(define map
  (case-lambda
    [(f l) (map-in f (list-of l 'map) '())]
    [(f l . ls) (map-n f (lists-of (cons l ls) 'map) '())]))
(define (map-in f l acc) (if (pair? l) (map-in f (cdr l) (cons (f (car l)) acc)) (reverse acc)))
(define (map-n f ls acc) (if (pair? (car ls)) (map-n f (cdrs ls) (cons (apply f (cars ls)) acc)) (reverse acc)))

(define for-each
  (case-lambda
    [(f l) (for-each-in f (list-of l 'for-each))]
    [(f l . ls) (for-each-n f (lists-of (cons l ls) 'for-each))]))
(define (for-each-in f l) (if (pair? l) (begin (f (car l)) (for-each-in f (cdr l))) #f))
(define (for-each-n f ls) (if (pair? (car ls)) (begin (apply f (cars ls)) (for-each-n f (cdrs ls))) #f))

(define andmap
  (case-lambda
    [(f l) (andmap-in f (list-of l 'andmap) #t)]
    [(f l . ls) (andmap-n f (lists-of (cons l ls) 'andmap) #t)]))
(define (andmap-in f l r) (if (pair? l) (let ([v (f (car l))]) (if v (andmap-in f (cdr l) v) #f)) r))
(define (andmap-n f ls r) (if (pair? (car ls)) (let ([v (apply f (cars ls))]) (if v (andmap-n f (cdrs ls) v) #f)) r))

(define ormap
  (case-lambda
    [(f l) (ormap-in f (list-of l 'ormap))]
    [(f l . ls) (ormap-n f (lists-of (cons l ls) 'ormap))]))
(define (ormap-in f l) (if (pair? l) (or (f (car l)) (ormap-in f (cdr l))) #f))
(define (ormap-n f ls) (if (pair? (car ls)) (or (apply f (cars ls)) (ormap-n f (cdrs ls))) #f))

;; ls, lists of one length, for function who.
(define (lists-of ls who) (same-lengths (cdr ls) (length (list-of (car ls) who)) who) ls)
(define (same-lengths ls n who)
  (cond [(null? ls) #t]
        [(= (length (list-of (car ls) who)) n) (same-lengths (cdr ls) n who)]
        [else (error who "all lists must have the same size")]))
(define (cars ls) (if (null? ls) '() (cons (car (car ls)) (cars (cdr ls)))))
(define (cdrs ls) (if (null? ls) '() (cons (cdr (car ls)) (cdrs (cdr ls)))))

;; The elements of l that keep? is true of.
(define (filter keep? l) (filter-in keep? (list-of l 'filter) '()))
(define (filter-in keep? l acc)
  (cond [(null? l) (reverse acc)]
        [(keep? (car l)) (filter-in keep? (cdr l) (cons (car l) acc))]
        [else (filter-in keep? (cdr l) acc)]))

;; f called with an element of each list, then the value so far, from the
;; left (foldl) or the right (foldr).
(define foldl
  (case-lambda
    [(f init l) (foldl-in f init (list-of l 'foldl))]
    [(f init l . ls) (foldl-n f init (lists-of (cons l ls) 'foldl))]))
(define foldr
  (case-lambda
    [(f init l) (foldl-in f init (reverse (list-of l 'foldr)))]
    [(f init l . ls) (foldl-n f init (map reverse (lists-of (cons l ls) 'foldr)))]))
(define (foldl-in f acc l) (if (pair? l) (foldl-in f (f (car l) acc) (cdr l)) acc))
(define (foldl-n f acc ls)
  (if (pair? (car ls)) (foldl-n f (apply f (append (cars ls) (list acc))) (cdrs ls)) acc))

;; ---- syntax patterns -------------------------------------------------------------------
;;
;; (syntax-match subject [pattern body ...] ...) takes syntax apart, as
;; quasisyntax builds it. The clauses are tried in order: the first whose
;; pattern subject matches binds the pattern's variables, and its body
;; gives the value. A pattern is:
;;
;;   x                  an identifier: anything, bound to x
;;   _                  anything
;;   #:kw "s" 5 #\c #t  syntax whose datum is equal to it
;;   'd                 syntax whose datum is equal to d: for a symbol, an
;;                      identifier of that name
;;   #'id               an identifier free-identifier=? to id, which asks
;;                      the expander, so only a macro can use it
;;   (p ...), (p ... . tail)
;;                      a syntax list or a list, element by element
;;   p ...              in a list, as many elements that match p as there
;;                      can be while the rest of the list matches
;;   (? pred p ...)     x, if (pred x) is true and every p matches x
;;
;; A variable is bound to syntax, or under an ellipsis to the list of what
;; each element bound, which #,@ splices. _, ... and ? are compared by
;; binding. If no clause matches, it is a syntax error blamed on subject:
;; "expected" and the patterns, each written as it is, but for a check
;; (? pred p ...), written as its last p, and a _ at a pattern's head,
;; written as subject's head.

(define-syntax (_ stx) (raise-syntax-error #f "allowed only in a pattern" stx))
(define-syntax (... stx) (raise-syntax-error #f "allowed only in a pattern" stx))
(define-syntax (? stx) (raise-syntax-error #f "allowed only in a pattern" stx))

(begin-for-syntax
  ;; A pattern is parsed into a description, a datum that match-syntax
  ;; walks: (var i name), the pattern's variable i; (any); (datum d);
  ;; (bound i name), an identifier free-identifier=? to value i; (check i
  ;; p ...), value i being the predicate; or (list (element ...) tail),
  ;; where an element is a description or (repeat p (i ...)), p repeated,
  ;; binding variables i ..., and tail is a description or (null). The
  ;; values are the syntax-match's predicates and #'id identifiers, which
  ;; it evaluates first. A name is as written, for errors.

  (define (pattern-keyword? x k) (if (identifier? x) (free-identifier=? x k) #f))

  ;; Is l a list of two elements?
  (define (two? l) (if (pair? l) (if (pair? (cdr l)) (null? (cdr (cdr l))) #f) #f))

  ;; The numbers from i below n.
  (define (numbers-from i n) (if (< i n) (cons i (numbers-from (+ i 1) n)) '()))

  ;; Is an identifier in ids named as id is?
  (define (named-in? id ids)
    (if (null? ids) #f (if (eq? (syntax-e (car ids)) (syntax-e id)) #t (named-in? id (cdr ids)))))

  ;; Patterns ps parsed, as (descriptions variables values): for each
  ;; pattern its description and its variables, in order, and the values
  ;; the descriptions refer to, in order.
  (define (parse-patterns ps)
    (let ([values '()] [vars '()])
      (letrec
          ([value! (lambda (e) (set! values (cons e values)) (- (length values) 1))]
           [var! (lambda (id)
                   (if (named-in? id vars)
                       (raise-syntax-error 'syntax-match "this pattern variable appears twice in its pattern" id)
                       (begin (set! vars (cons id vars)) (- (length vars) 1))))]
           [parse (lambda (p)
                    (let ([e (syntax-e p)])
                      (if (symbol? e)
                          (if (pattern-keyword? p #'_)
                              '(any)
                              (if (if (pattern-keyword? p #'...) #t (pattern-keyword? p #'?))
                                  (raise-syntax-error 'syntax-match "not allowed here in a pattern" p)
                                  (list 'var (var! p) e)))
                          (if (pair? e) (parse-form p e) (if (null? e) '(list () (null)) (list 'datum e))))))]
           [parse-form (lambda (p e)
                         (if (if (two? e) (pattern-keyword? (car e) #'quote) #f)
                             (list 'datum (syntax->datum (cadr e)))
                             (if (if (two? e) (pattern-keyword? (car e) #'quote-syntax) #f)
                                 (if (identifier? (cadr e))
                                     (list 'bound (value! p) (syntax-e (cadr e)))
                                     (raise-syntax-error 'syntax-match "expected #'identifier" p))
                                 (if (pattern-keyword? (car e) #'?)
                                     (if (if (pair? (cdr e)) (list? (cdr e)) #f)
                                         (cons 'check (cons (value! (cadr e)) (parse-all (cddr e))))
                                         (raise-syntax-error 'syntax-match "expected (? predicate pattern ...)" p))
                                     (let ([r (elements e)]) (list 'list (car r) (cdr r)))))))]
           [parse-all (lambda (ps) (if (null? ps) '() (let ([d (parse (car ps))]) (cons d (parse-all (cdr ps))))))]
           ;; The elements and the tail of pair chain l, as (elements . tail).
           [elements (lambda (l)
                       (if (pair? l)
                           (if (pattern-keyword? (car l) #'...)
                               (raise-syntax-error 'syntax-match "... follows the pattern it repeats" (car l))
                               (if (if (pair? (cdr l)) (pattern-keyword? (cadr l) #'...) #f)
                                   (let* ([before (length vars)]
                                          [d (parse (car l))]
                                          [repeat (list 'repeat d (numbers-from before (length vars)))]
                                          [r (elements (cddr l))])
                                     (cons (cons repeat (car r)) (cdr r)))
                                   (let* ([d (parse (car l))] [r (elements (cdr l))])
                                     (cons (cons d (car r)) (cdr r)))))
                           (cons '() (if (null? l) '(null) (parse l)))))])
        (let loop ([ps ps] [descs '()] [varss '()])
          (if (null? ps)
              (list (reverse descs) (reverse varss) (reverse values))
              (begin
                (set! vars '())
                (let ([d (parse (car ps))])
                  (loop (cdr ps) (cons d descs) (cons (reverse vars) varss)))))))))

  ;; A syntax-match's clauses, each [pattern body ...], as lists.
  (define (match-clauses cs)
    (if (null? cs)
        '()
        (let ([c (syntax->list (car cs))])
          (if (if c (>= (length c) 2) #f)
              (cons c (match-clauses (cdr cs)))
              (raise-syntax-error 'syntax-match "expected a clause [pattern body ...]" (car cs))))))

  (define (clause-patterns cs) (if (null? cs) '() (cons (car (car cs)) (clause-patterns (cdr cs)))))

  (define (literal d) (datum->syntax #'here d))

  ;; [x (vector-ref m i)] for each variable x, the i-th.
  (define (variable-bindings vars i)
    (if (null? vars)
        '()
        (cons #`[#,(car vars) (vector-ref m #,(literal i))] (variable-bindings (cdr vars) (+ i 1)))))

  ;; Code that tries clauses cs, whose patterns have descriptions ds and
  ;; variables varss, in turn; all: every description, for the error if
  ;; none matches.
  (define (match-code cs ds varss all)
    (if (null? cs)
        #`(no-match '#,(literal all) s)
        #`(let ([m (match-syntax '#,(literal (car ds)) #,(literal (length (car varss))) values s)])
            (if m
                (let (#,@(variable-bindings (car varss) 0)) #,@(cdr (car cs)))
                #,(match-code (cdr cs) (cdr ds) (cdr varss) all))))))

;; (syntax-match subject [pattern body ...] ...)
(define-syntax (syntax-match stx)
  (let* ([parts (syntax->list stx)]
         [clauses (if (if parts (>= (length parts) 3) #f)
                      (match-clauses (cddr parts))
                      (raise-syntax-error #f "expected (syntax-match subject [pattern body ...] ...)" stx))]
         [parsed (parse-patterns (clause-patterns clauses))]
         [values (caddr parsed)])
    #`(let ([s #,(cadr parts)] [values #,(if (null? values) #''#f #`(vector #,@values))])
        #,(match-code clauses (car parsed) (cadr parsed) (car parsed)))))

;; The bindings of the n variables of description d, as a vector, if x
;; matches d; otherwise #f. values: the syntax-match's values.
(define (match-syntax d n values x)
  (let ([vs (make-vector n #f)])
    (and (matches? d x values vs) vs)))

;; Does x match description d? The variables d binds are written in vs.
(define (matches? d x values vs)
  (case (car d)
    [(list) (elements-match? (cadr d) (caddr d) (list-part x) values vs)]
    [(var) (vector-set! vs (cadr d) x) #t]
    [(datum) (equal? (syntax->datum x) (cadr d))]
    [(check) (and ((vector-ref values (cadr d)) x) (andmap (lambda (p) (matches? p x values vs)) (cddr d)))]
    [(any) #t]
    [(bound) (and (identifier? x) (free-identifier=? x (vector-ref values (cadr d))))]))

;; x's elements if it is a syntax list; otherwise x.
(define (list-part x) (if (syntax? x) (syntax-e x) x))

;; Do the elements of list l match descriptions es, and what follows them
;; tail?
(define (elements-match? es tail l values vs)
  (cond [(null? es) (if (eq? (car tail) 'null) (null? (list-part l)) (matches? tail l values vs))]
        [(eq? (car (car es)) 'repeat) (repeat-matches? (car es) (cdr es) tail l values vs)]
        [else (let ([l (list-part l)])
                (and (pair? l) (matches? (car es) (car l) values vs)
                     (elements-match? (cdr es) tail (cdr l) values vs)))]))

;; e is (repeat p (i ...)): do elements from the start of l match p, as
;; many as can while es and tail match the rest? Variables i ... are bound
;; to lists.
(define (repeat-matches? e es tail l values vs)
  (let ([p (cadr e)] [vars (caddr e)])
    ;; rows: for each element that matches p, the latest first, the values
    ;; of vars then and the rest of l after it.
    (let collect ([rest l] [rows '()])
      (let ([m (list-part rest)])
        (if (and (pair? m) (matches? p (car m) values vs))
            (collect (cdr m) (cons (cons (map (lambda (i) (vector-ref vs i)) vars) (cdr m)) rows))
            (let try ([rows rows])
              (set-repeated! vars (reverse (map car rows)) vs)
              (or (elements-match? es tail (if (null? rows) l (cdr (car rows))) values vs)
                  (and (pair? rows) (try (cdr rows))))))))))

;; Bind each of vars to the list of its values in rows, each row the values
;; of vars, in order.
(define (set-repeated! vars rows vs)
  (unless (null? vars)
    (vector-set! vs (car vars) (map car rows))
    (set-repeated! (cdr vars) (map cdr rows) vs)))

;; No clause matched x, and ds are the descriptions of the clauses'
;; patterns: the error.
(define (no-match ds x)
  (raise-syntax-error #f (string-append "expected " (alternatives (map (lambda (d) (pattern-text d x)) ds))) x))

;; "a", "a or b", "a, b or c".
(define (alternatives ts)
  (cond [(null? (cdr ts)) (car ts)]
        [(null? (cddr ts)) (string-append (car ts) " or " (cadr ts))]
        [else (string-append (car ts) ", " (alternatives (cdr ts)))]))

;; Description d written as its pattern is, in an error about x: a _ at its
;; head as x's head.
(define (pattern-text d x)
  (let ([l (list-part x)])
    (if (and (eq? (car d) 'list) (pair? (cadr d)) (equal? (car (cadr d)) '(any)) (pair? l) (identifier? (car l)))
        (description-text (list 'list (cons (list 'datum (syntax-e (car l))) (cdr (cadr d))) (caddr d)))
        (description-text d))))

(define (description-text d)
  (case (car d)
    [(var bound) (symbol->string (caddr d))]
    [(datum) (format "~s" (cadr d))]
    [(any) "_"]
    [(check) (if (null? (cddr d)) "_" (description-text (last (cddr d))))]
    [(repeat) (string-append (description-text (cadr d)) " ...")]
    [(list) (string-append "(" (spaced (map description-text (cadr d)))
                           (if (eq? (car (caddr d)) 'null) "" (string-append " . " (description-text (caddr d))))
                           ")")]))

;; Strings ts, with a space between each two.
(define (spaced ts) (if (null? ts) "" (foldl (lambda (t acc) (string-append acc " " t)) (car ts) (cdr ts))))
