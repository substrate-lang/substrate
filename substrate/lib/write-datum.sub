;; write-datum: print syntax-library data (spec section 2) in Lisp
;; notation, using only the contract functions. Shares print.sub's memory
;; and uses bytes 256..511 of it.
;;
;; This module requires the syntax library, so a program that uses it at
;; run time links the library (spec 3.3).

(require s syntax)
(require print "print.sub")
(memory from print)
(provide write-datum)

(data wd-false 256 "#f")
(data wd-true 260 "#t")
(data wd-nil 264 "()")
(data wd-char 268 "#\\")
(data wd-space 272 "space")
(data wd-newline 280 "newline")
(data wd-dot 288 " . ")
(data wd-syntax 292 "#<syntax ")
(data wd-other 304 "#<other>")

;; A code point as UTF-8, formatted in bytes 320..323.
(func (write-utf8 [cp i32])
  (if (i32.lt_u cp 128) (return (print:write-byte cp)))
  (if (i32.lt_u cp 2048)
      (begin
        (i32.store8 320 (i32.or 192 (i32.shr_u cp 6)))
        (i32.store8 321 (i32.or 128 (i32.and cp 63)))
        (return (print:write-bytes 320 2))))
  (if (i32.lt_u cp 65536)
      (begin
        (i32.store8 320 (i32.or 224 (i32.shr_u cp 12)))
        (i32.store8 321 (i32.or 128 (i32.and (i32.shr_u cp 6) 63)))
        (i32.store8 322 (i32.or 128 (i32.and cp 63)))
        (return (print:write-bytes 320 3))))
  (i32.store8 320 (i32.or 240 (i32.shr_u cp 18)))
  (i32.store8 321 (i32.or 128 (i32.and (i32.shr_u cp 12) 63)))
  (i32.store8 322 (i32.or 128 (i32.and (i32.shr_u cp 6) 63)))
  (i32.store8 323 (i32.or 128 (i32.and cp 63)))
  (print:write-bytes 320 4))

;; The bytes of a string, copied out with string-byte into 384..511, 126 at
;; a time. escape: 1 to escape " \ and newline, as write does.
(func (write-string-bytes [str eqref] [escape i32])
  (let ([n (s:string-length str)] [i 0] [k 0])
    (block done
      (loop next
        (br-if done (i32.ge_u i n))
        (let ([b (s:string-byte str i)])
          (if (i32.and escape (i32.or (i32.or (i32.eq b 34) (i32.eq b 92)) (i32.eq b 10)))
              (begin (i32.store8 (i32.add 384 k) 92) (set! k (i32.add k 1))))
          (i32.store8 (i32.add 384 k) (select 110 b (i32.and escape (i32.eq b 10))))
          (set! k (i32.add k 1)))
        (if (i32.ge_u k 126)
            (begin (print:write-bytes 384 k) (set! k 0)))
        (set! i (i32.add i 1))
        (br next)))
    (print:write-bytes 384 k)))

(func (write-datum [v eqref])
  (if (ref.is_null v) (return (print:write-bytes (data-address wd-false) (data-size wd-false))))
  (if (s:fixnum? v) (return (print:write-int (s:fixnum-value v))))
  (if (ref.eq v '#t) (return (print:write-bytes (data-address wd-true) (data-size wd-true))))
  (if (s:null? v) (return (print:write-bytes (data-address wd-nil) (data-size wd-nil))))
  (if (s:char? v)
      (let ([cp (s:char->integer v)])
        (print:write-bytes (data-address wd-char) (data-size wd-char))
        (if (i32.eq cp 32) (return (print:write-bytes (data-address wd-space) (data-size wd-space))))
        (if (i32.eq cp 10) (return (print:write-bytes (data-address wd-newline) (data-size wd-newline))))
        (return (write-utf8 cp))))
  (if (s:symbol? v) (return (write-string-bytes (s:symbol->string v) 0)))
  (if (s:string? v)
      (begin
        (print:write-byte 34)
        (write-string-bytes v 1)
        (return (print:write-byte 34))))
  (if (s:pair? v)
      (begin
        (print:write-byte 40)
        (write-datum (s:car v))
        (set! v (s:cdr v))
        (block done
          (loop next
            (br-if done (i32.eqz (s:pair? v)))
            (print:write-byte 32)
            (write-datum (s:car v))
            (set! v (s:cdr v))
            (br next)))
        (if (i32.eqz (s:null? v))
            (begin (print:write-bytes (data-address wd-dot) (data-size wd-dot)) (write-datum v)))
        (return (print:write-byte 41))))
  (if (s:syntax? v)
      (begin
        (print:write-bytes (data-address wd-syntax) (data-size wd-syntax))
        (write-datum (s:syntax->datum v))
        (return (print:write-byte 62))))
  (print:write-bytes (data-address wd-other) (data-size wd-other)))
