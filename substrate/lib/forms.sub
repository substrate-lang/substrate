;; Forms for C-like Lisp code on kernel data: for/each, for/list, fmt, define-macro.
(require-unqualified base "../compiler/base/base.sub")
(require-unqualified kd "../compiler/kernel.sub")
(provide for/each for/list fmt define-macro)

(begin-for-syntax
  (require-unqualified base "../compiler/base/base.sub")
  (require-unqualified kd "../compiler/kernel.sub")

  (define (for-clauses [stx datum] [cs datum]) -> datum
    (let ([xs nil] [ls nil] [guard datum 0])
      (while (pair? cs)
        (let ([c (car cs)])
          (cond [(and (syntax? c) (== (syntax-e c) '#:when) (pair? (cdr cs)) (null? (cddr cs)))
                 (set! guard (cadr cs))
                 (set! cs nil)]
                [else
                 (let ([b (syntax->list c)])
                   (unless (and (!= b 0) (pair? b) (pair? (cdr b)) (null? (cddr b)) (identifier? (car b)))
                     (raise-syntax-error 0 '"expected ([x list] ... [#:when test])" stx))
                   (set! xs (cons (car b) xs))
                   (set! ls (cons (cadr b) ls))
                   (set! cs (cdr cs)))])))
      (when (null? xs) (raise-syntax-error 0 '"expected ([x list] ... [#:when test])" stx))
      `(,(reverse xs) ,(reverse ls) ,guard)))

  (define temps i32 0)
  (define (temp) -> datum
    (set! temps (+ temps 1))
    (datum->syntax #'here (string->symbol (format-message "l~a" (cons (fixnum temps) nil))) 0))

  (define (temps-for [l datum]) -> datum (if (null? l) nil (cons (temp) (temps-for (cdr l)))))
  (define (pairs [xs datum] [es datum]) -> datum
    (if (null? xs) nil (cons #`[#,(car xs) #,(car es)] (pairs (cdr xs) (cdr es)))))
  (define (element-bindings [xs datum] [ts datum]) -> datum
    (if (null? xs) nil (cons #`[#,(car xs) (car #,(car ts))] (element-bindings (cdr xs) (cdr ts)))))
  (define (steps [ts datum]) -> datum
    (if (null? ts) nil (cons #`(set! #,(car ts) (cdr #,(car ts))) (steps (cdr ts)))))
  (define (all-pairs [ts datum]) -> datum
    (if (null? (cdr ts)) #`(pair? #,(car ts)) #`(and (pair? #,(car ts)) #,(all-pairs (cdr ts)))))

  ;; The lists step before the body, so that continue takes the next elements.
  (define (for-loop [stx datum] [cs datum] [each datum]) -> datum
    (let* ([c (for-clauses stx cs)] [ts (temps-for (car c))] [guard (caddr c)])
      #`(let (#,@(pairs ts (cadr c)))
          (while #,(all-pairs ts)
            (let (#,@(element-bindings (car c) ts))
              #,@(steps ts)
              #,(if (!= guard 0) #`(when #,guard #,each) each))))))

  (define (for/each-form [stx datum]) -> datum
    (let ([parts (syntax->list stx)])
      (unless (and (!= parts 0) (>= (length parts) 3) (!= (syntax->list (cadr parts)) 0))
        (raise-syntax-error 0 '"expected (for/each (clause ...) body ...)" stx))
      (for-loop stx (syntax->list (cadr parts)) #`(begin #,@(cddr parts)))))

  (define (for/list-form [stx datum]) -> datum
    (let ([parts (syntax->list stx)])
      (unless (and (!= parts 0) (>= (length parts) 3) (!= (syntax->list (cadr parts)) 0))
        (raise-syntax-error 0 '"expected (for/list (clause ...) body ...)" stx))
      #`(let ([acc nil])
          #,(for-loop stx (syntax->list (cadr parts)) #`(set! acc (cons (begin #,@(cddr parts)) acc)))
          (reverse acc))))

  (define (fmt-form [stx datum]) -> datum
    (let ([parts (syntax->list stx)])
      (unless (and (!= parts 0) (pair? (cdr parts))) (raise-syntax-error 0 '"expected (fmt template arg ...)" stx))
      #`(format-message #,(cadr parts) #,(list-of (cddr parts)))))

  (define (list-of [args datum]) -> datum
    (if (pair? args) #`(cons #,(car args) #,(list-of (cdr args))) #'nil))

  ;; Not define-syntax, which stays the kernel's: templates write thousands of
  ;; define-syntax forms, and each would go through a macro first.
  (define (define-macro-form [stx datum]) -> datum
    (let* ([parts (syntax->list stx)]
           [head (if (and (!= parts 0) (pair? (cdr parts)) (pair? (cddr parts))) (cadr parts) 0)]
           [h (if (or (== head 0) (identifier? head)) 0 (syntax->list head))])
      (unless (and (!= h 0) (pair? h) (pair? (cdr h)) (null? (cddr h)) (identifier? (car h)) (identifier? (cadr h)))
        (raise-syntax-error 0 '"expected (define-macro (name stx) body ...)" stx))
      (let ([name (car h)] [s (cadr h)])
        #`(begin
            (begin-for-syntax (define (#,name [#,s datum]) -> datum #,@(cddr parts)))
            (define-syntax #,name #,name))))))

(define-syntax for/each for/each-form)
(define-syntax for/list for/list-form)
(define-syntax fmt fmt-form)
(define-syntax define-macro define-macro-form)
