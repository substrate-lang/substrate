;; Drawing on a <canvas> element: rectangles, paths, circles and text.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified ui "ui.sub")

(provide fill-style stroke-style line-width global-alpha
         fill-rect stroke-rect clear-rect
         begin-path move-to line-to arc close-path fill-path stroke-path
         fill-circle draw-line
         set-font text-align text-baseline fill-text
         load-image draw-sprite
         translate rotate scale save-state restore-state)

(memory from base)
(table from base)

(define (command! [op u32]) -> i32
  (if (ui-canvas-drawing?)
      (begin
        (buffer-add! (ui-patches) (cast (ptr u8) (array-of u32 op)) 4)
        1)
      0))

(define (numbers! [v (ptr f32)] [n u32]) (buffer-add! (ui-patches) (cast (ptr u8) v) (* 4 n)))

;; Copied: the command runs when the buffer is applied, when the string may have changed.
(define (text! [s (ptr u8)])
  (let* ([n (strlen s)] [copy (cast (ptr u8) (ui-frame-alloc (+ n 1)))])
    (memcpy copy s (+ n 1))
    (buffer-add! (ui-patches) (cast (ptr u8) (array-of u32 (cast u32 copy) n)) 8)))

(define (plain! [op u32]) (command! op))
(define (one! [op u32] [a f64]) (when (command! op) (numbers! (array-of f32 (cast f32 a)) 1)))
(define (two! [op u32] [a f64] [b f64]) (when (command! op) (numbers! (array-of f32 (cast f32 a) (cast f32 b)) 2)))
(define (four! [op u32] [a f64] [b f64] [c f64] [d f64])
  (when (command! op) (numbers! (array-of f32 (cast f32 a) (cast f32 b) (cast f32 c) (cast f32 d)) 4)))
(define (named! [op u32] [s (ptr u8)]) (when (command! op) (text! s)))

(define (fill-style [color (ptr u8)]) (named! 2 color))
(define (stroke-style [color (ptr u8)]) (named! 3 color))
(define (line-width [w f64]) (one! 4 w))
(define (global-alpha [a f64]) (one! 23 a))

(define (fill-rect [x f64] [y f64] [w f64] [h f64]) (four! 5 x y w h))
(define (stroke-rect [x f64] [y f64] [w f64] [h f64]) (four! 6 x y w h))
(define (clear-rect [x f64] [y f64] [w f64] [h f64]) (four! 1 x y w h))

(define (begin-path) (plain! 7))
(define (move-to [x f64] [y f64]) (two! 8 x y))
(define (line-to [x f64] [y f64]) (two! 9 x y))
(define (arc [x f64] [y f64] [radius f64] [start f64] [end f64])
  (when (command! 10)
    (numbers! (array-of f32 (cast f32 x) (cast f32 y) (cast f32 radius) (cast f32 start) (cast f32 end)) 5)))
(define (close-path) (plain! 11))
(define (fill-path) (plain! 12))
(define (stroke-path) (plain! 13))

(define (fill-circle [x f64] [y f64] [radius f64])
  (begin-path)
  (arc x y radius 0.0 6.283185307179586)
  (fill-path))

(define (draw-line [x1 f64] [y1 f64] [x2 f64] [y2 f64])
  (begin-path)
  (move-to x1 y1)
  (line-to x2 y2)
  (stroke-path))

(define (set-font [font (ptr u8)]) (named! 14 font))
(define (text-align [align (ptr u8)]) (named! 16 align))
(define (text-baseline [baseline (ptr u8)]) (named! 17 baseline))
(define (fill-text [text (ptr u8)] [x f64] [y f64])
  (when (command! 15)
    (text! text)
    (numbers! (array-of f32 (cast f32 x) (cast f32 y)) 2)))

(define next-image u32 1)

;; A patch of its own, so not written while a draw patch is open.
(define (load-image [path (ptr u8)]) -> u32
  (if (ui-canvas-drawing?)
      0
      (let* ([n (strlen path)] [copy (cast (ptr u8) (ui-frame-alloc (+ n 1)))] [id next-image])
        (memcpy copy path (+ n 1))
        (+= next-image 1)
        (ui-image id copy)
        id)))

(define (draw-sprite [image u32] [cell-width f64] [cell-height f64] [frame u32] [x f64] [y f64] [flip i32])
  (when (command! 24)
    (buffer-add! (ui-patches) (cast (ptr u8) (array-of u32 image frame (if flip 1 0))) 12)
    (numbers! (array-of f32 (cast f32 cell-width) (cast f32 cell-height) (cast f32 x) (cast f32 y)) 4)))

(define (translate [x f64] [y f64]) (two! 20 x y))
(define (rotate [angle f64]) (one! 21 angle))
(define (scale [x f64] [y f64]) (two! 22 x y))
(define (save-state) (plain! 18))
(define (restore-state) (plain! 19))
