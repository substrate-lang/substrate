;; Lifecycle: experimental.
;;
;; Materials painted by the GPU: the textures a scene's surfaces are
;; drawn with, grass, dirt, rock, sand, snow, bark, leaves, blades of
;; grass, planks, roof tiles, plaster, needles and a face, painted
;; when the scene starts by a shader, from noise, into one texture of
;; many layers, each layer a material with its mip levels. A program
;; does not ship images for them, and a material is the same on every
;; machine.
;;
;; A material is a greyscale: its brightness varies about 1 in the
;; strokes and grains the material has, and a surface's own colour (a
;; vertex colour, a placement's tint) multiplies it, so one material
;; serves every colour of grass or wood. Three are cards: the leaves
;; and the blades are shapes with an alpha, to be drawn on a quad,
;; which is see-through outside the shape, and the face is a drawn
;; face, in colour, eyes, brows and a mouth over a see-through card to
;; be set on a head. The others tile: a surface shows them repeated
;; every material-scale units, in world coordinates, so that a mesh
;; need not have texture coordinates for them.
;;
;;   (materials-init! m)     makes the texture, 256 by 256 texels, with
;;                           a layer per material and 9 mip levels, and
;;                           a sampler that repeats and blends between
;;                           levels; and writes the passes that paint
;;                           every layer at every level. Once, where GPU
;;                           commands are being written (meshes-init!
;;                           calls it).
;;   (materials-texture m) (materials-sampler m)
;;                           the texture and the sampler
;;   material-none material-grass material-dirt material-rock
;;   material-sand material-snow material-bark material-leaves
;;   material-blades material-planks material-tiles material-plaster
;;   material-needles material-face
;;                           the layers, 0 to 13; material-none is
;;                           white, which is no material
;;   material-count          how many
;;   (material-scale m) -> f64
;;                           how many units of the world a tiled
;;                           material spans before it repeats
;;
;; ---- How it works ----
;;
;; The paint shader (Shade) draws one triangle over the target, and its
;; fragment makes the texel of the layer at the texel's place, 0 to 1
;; each way, from noise that repeats at the edges (the noise library's
;; tiled noise), so that the material tiles. One pass paints one mip
;; level of one layer: the pass's target is that level of that layer,
;; and a uniform tells the fragment which layer, which level and the
;; level's size; the uniforms for every pass lie in one buffer, bound at
;; a different offset each time (a uniform-array). Each level is painted
;; on its own, with the detail that is finer than its texels faded out:
;; a term whose features span fewer than about two texels at that level
;; is left out, and an fbm has only the octaves that fit. That is what
;; mip levels are for: a surface far away reads a level whose detail
;; it can show, and does not sparkle.
(require-unqualified base "../../../compiler/base/base.sub")
(require-unqualified gpu "../gpu.sub")
(require-unqualified shader "shader.sub")
(require-unqualified screen "../../shade/screen.sub")
(require-unqualified noise "../../shade/noise.sub")

(provide materials materials-init! materials-texture materials-sampler material-scale
         material-none material-grass material-dirt material-rock material-sand material-snow material-bark
         material-leaves material-blades material-planks material-tiles material-plaster material-needles material-face material-count)

(memory from base)
(table from base)

(define material-none u32 0)
(define material-grass u32 1)
(define material-dirt u32 2)
(define material-rock u32 3)
(define material-sand u32 4)
(define material-snow u32 5)
(define material-bark u32 6)
(define material-leaves u32 7)
(define material-blades u32 8)
(define material-planks u32 9)
(define material-tiles u32 10)
(define material-plaster u32 11)
(define material-needles u32 12)
(define material-face u32 13)
(define material-count u32 14)

(define material-size u32 256)
(define material-levels u32 9)

(struct materials [texture u32] [sampler u32] [shader paint-shader] [brushes u32] [group u32] [pipeline u32])

(define (material-scale [m u32]) -> f64
  (cond [(== m material-grass) 3.0] [(== m material-dirt) 3.0] [(== m material-rock) 7.0] [(== m material-sand) 2.5]
        [(== m material-snow) 4.0] [(== m material-bark) 1.2] [(== m material-planks) 3.0] [(== m material-tiles) 2.4]
        [(== m material-plaster) 3.0] [(== m material-needles) 1.8] [else 1.0]))

(shader paint
  [uniform-array brush 0 0 (fragment) [layer i32] [level i32] [size f32]]
  [builtins vertex-index]
  [use screen]
  [use noise]
  [vertex (vertex [in vertex]) -> varyings
    (varyings [position (screen-corner in.vertex-index)])]
  ;; How much of a term with features `cells` across the texture to
  ;; keep at this level: all of it when a cell spans three texels or
  ;; more, none when it spans less than one.
  [define (keep [cells f32]) -> f32 (smoothstep 1.0 3.0 (/ brush.size cells))]
  ;; How many octaves of an fbm whose first has `cells` cells fit at
  ;; this level, up to n.
  [define (octaves-for [cells f32] [n i32]) -> i32
    (max 1 (min n (i32 (floor (log2 (/ brush.size cells))))))]
  ;; Noise over the texture, repeating at its edges, with `cells` cells
  ;; across and up, in up to `octaves` octaves.
  [define (grain [uv vec2] [cells vec2] [octaves i32]) -> f32
    (tiled-fbm (* uv cells) cells (octaves-for (max cells.x cells.y) octaves))]
  [define (grey [v f32]) -> vec4 (vec4 (vec3 v) 1.0)]
  ;; A disc's share of a pixel: 1 inside, falling to 0 over an edge of a
  ;; texel and a half, so that a drawn line is smooth.
  [define (disc [uv vec2] [centre vec2] [rx f32] [ry f32]) -> f32
    (let ([d (length (/ (- uv centre) (vec2 rx ry)))])
      (- 1.0 (smoothstep (- 1.0 (/ 1.5 (* brush.size rx))) 1.0 d)))]
  ;; Grass: clumps, and blades, tall thin features.
  [define (grass [uv vec2]) -> vec4
    (let ([clump (grain uv (vec2 4.0 4.0) 3)]
          [blades (grain uv (vec2 24.0 5.0) 3)])
      (grey (* (+ 0.7 (* 0.45 blades)) (+ 0.85 (* 0.3 clump)))))]
  ;; Dirt: mottled, with pebbles.
  [define (dirt [uv vec2]) -> vec4
    (let ([mottle (grain uv (vec2 5.0 5.0) 4)]
          [pebbles (* (keep 24.0) (smoothstep 0.62 0.72 (tiled-noise (* uv 24.0) (vec2 24.0 24.0))))])
      (grey (+ 0.78 (* 0.4 mottle) (* 0.15 pebbles))))]
  ;; Rock: strata that waver, cracks, mottling.
  [define (rock [uv vec2]) -> vec4
    (let* ([warp (grain uv (vec2 3.0 3.0) 3)]
           [strata (sin (+ (* uv.y 6.2831853 5.0) (* 3.0 warp)))]
           [cracks (* (keep 14.0) (smoothstep 0.06 0.0 (abs (- (tiled-noise (* uv 7.0) (vec2 7.0 7.0)) 0.5))))]
           [mottle (grain uv (vec2 9.0 9.0) 3)])
      (grey (- (+ 0.82 (* 0.12 strata) (* 0.3 mottle)) (* 0.3 cracks))))]
  ;; Sand: fine grain, and ripples.
  [define (sand [uv vec2]) -> vec4
    (let ([grainy (tiled-noise (* uv 48.0) (vec2 48.0 48.0))]
          [ripple (sin (+ (* uv.x 6.2831853 7.0) (* 2.5 (grain uv (vec2 3.0 3.0) 2))))])
      (grey (+ 0.93 (* 0.1 (keep 48.0) (- grainy 0.5)) (* 0.05 ripple))))]
  [define (snow [uv vec2]) -> vec4
    (grey (+ 0.96 (* 0.08 (- (grain uv (vec2 6.0 6.0) 3) 0.5))))]
  ;; Bark: fine streaks up the trunk, with fissures between them.
  [define (bark [uv vec2]) -> vec4
    (let* ([streaks (grain uv (vec2 20.0 2.0) 4)]
           [fine (grain uv (vec2 48.0 6.0) 2)]
           [fissure (* (keep 20.0) (smoothstep 0.45 0.32 streaks))])
      (grey (- (+ 0.78 (* 0.3 streaks) (* 0.15 (keep 48.0) (- fine 0.5))) (* 0.4 fissure))))]
  ;; Leaves: a card, a cluster of fourteen leaves about its middle, each
  ;; an ellipse pointing outwards with a dark midrib and a lighter
  ;; edge, a little different in brightness from the next, lighter
  ;; towards the top of the card.
  [define (leaves [uv vec2]) -> vec4
    (let ([c (- uv (vec2 0.5 0.5))] [alpha 0.0] [shade 0.8])
      (for ([i 0]) (< i 14) (+= i 1)
        (let* ([fi (f32 i)]
               [a (+ (* fi 0.449) (* 0.3 (- (hash (vec2 fi 5.0)) 0.5)))]
               [reach (if (< i 8) 0.26 0.12)]
               [along (vec2 (cos a) (sin a))]
               [across (vec2 (- 0.0 along.y) along.x)]
               [centre (* along reach)]
               [p (- c centre)]
               [u (/ (dot p along) (if (< i 8) 0.19 0.14))]
               [v (/ (dot p across) 0.075)]
               [r (+ (* u u) (* v v))])
          (when (< r 1.0)
            (let ([leaf (* (+ 0.82 (* 0.3 (hash (vec2 fi 9.0)))) (- 1.0 (* 0.25 (smoothstep 0.1 0.0 (abs v)))) (+ 1.0 (* 0.12 (smoothstep 0.6 1.0 r))))])
              (set! shade (if (> alpha 0.5) (max shade leaf) leaf))
              (set! alpha 1.0)))))
      (vec4 (vec3 (* shade (+ 1.0 (* 0.25 (- 0.5 uv.y))))) alpha))]
  ;; Blades: a card, nine thin blades of grass of different heights,
  ;; each narrowing to its tip and bending over, darker at the foot and
  ;; a little different in brightness from its neighbours.
  [define (blades [uv vec2]) -> vec4
    (let ([up (- 1.0 uv.y)] [alpha 0.0] [shade 0.7])
      (for ([i 0]) (< i 9) (+= i 1)
        (let* ([fi (f32 i)]
               [h (+ 0.45 (* 0.55 (hash (vec2 fi 3.0))))]
               [bend (* (- (hash (vec2 fi 7.0)) 0.5) 0.4)]
               [x (+ 0.06 (* 0.11 fi) (* bend up up))]
               [t (/ up h)]
               [width (* 0.028 (- 1.0 (* t t)))]
               [d (abs (- uv.x x))])
          (when (and (< d width) (< t 1.0))
            (set! alpha (max alpha (smoothstep width (* width 0.6) d)))
            (set! shade (max shade (* (+ 0.45 (* 0.55 t)) (+ 0.85 (* 0.3 (hash (vec2 fi 11.0))))))))))
      (vec4 (vec3 shade) alpha))]
  ;; Planks: boards across, with seams between and grain along them.
  [define (planks [uv vec2]) -> vec4
    (let* ([fy (fract (* uv.y 4.0))]
           [seam (* (keep 32.0) (+ (smoothstep 0.06 0.0 fy) (smoothstep 0.94 1.0 fy)))]
           [grained (grain uv (vec2 3.0 24.0) 3)])
      (grey (- (+ 0.75 (* 0.4 grained)) (* 0.35 seam))))]
  ;; Tiles: rows of roof tiles, each row half a tile across from the
  ;; last, shadowed under the row above, with seams between the tiles.
  [define (tiles [uv vec2]) -> vec4
    (let* ([row (floor (* uv.y 6.0))]
           [fy (fract (* uv.y 6.0))]
           [fx (fract (+ (* uv.x 8.0) (* 0.5 (- row (* 2.0 (floor (* row 0.5)))))))]
           [curve (* 0.1 (sin (* fx 3.14159)))]
           [under (* (keep 24.0) (smoothstep (+ 0.16 curve) (+ 0.02 curve) fy))]
           [side (* (keep 32.0) (smoothstep 0.03 0.0 (min fx (- 1.0 fx))))]
           [mottle (grain uv (vec2 8.0 8.0) 3)])
      (grey (- (+ 0.8 (* 0.25 mottle)) (* 0.4 under) (* 0.25 side))))]
  [define (plaster [uv vec2]) -> vec4
    (grey (+ 0.94 (* 0.1 (- (grain uv (vec2 10.0 10.0) 3) 0.5))))]
  ;; Needles: streaks slanting across, as a bough's needles lie. The
  ;; slant moves the pattern six cells across over the texture's
  ;; height, a whole number, so that it still tiles.
  [define (needles [uv vec2]) -> vec4
    (let ([n (tiled-fbm (vec2 (+ (* uv.x 12.0) (* uv.y 6.0)) (* uv.y 3.0)) (vec2 12.0 3.0) (octaves-for 12.0 4))])
      (grey (+ 0.65 (* 0.5 n))))]
  ;; The face: two eyes, white with a blue iris, a dark pupil and a
  ;; glint, each under a brow, and a small smiling mouth; see-through
  ;; between them. Drawn in colour, the one layer that is: it is drawn
  ;; on a white card, which the tint leaves alone.
  [define (face [uv vec2]) -> vec4
    (let ([color (vec3 0.0)] [alpha 0.0])
      (for ([side -1]) (<= side 1) (+= side 2)
        (let* ([centre (vec2 (+ 0.5 (* (f32 side) 0.2)) 0.45)]
               [white (disc uv centre 0.13 0.11)]
               [iris (disc uv (+ centre (vec2 0.0 0.02)) 0.075 0.085)]
               [pupil (disc uv (+ centre (vec2 0.0 0.025)) 0.038 0.045)]
               [glint (disc uv (+ centre (vec2 (* (f32 side) -0.03) -0.035)) 0.022 0.022)]
               [lid (smoothstep 0.0 0.015 (- (- centre.y 0.07) uv.y))]
               [brow (* (disc uv (+ centre (vec2 (* (f32 side) 0.01) -0.14)) 0.12 0.022) (step 0.0 (- (+ centre.y -0.14) uv.y -0.01)))])
          (set! color (mix color (vec3 0.96) (* white (- 1.0 lid))))
          (set! alpha (max alpha (* white (- 1.0 lid))))
          (set! color (mix color (vec3 0.25 0.4 0.62) (* iris (- 1.0 lid))))
          (set! color (mix color (vec3 0.1 0.1 0.14) (* pupil (- 1.0 lid))))
          (set! color (mix color (vec3 1.0) (* glint (- 1.0 lid))))
          (set! color (mix color (vec3 0.29 0.2 0.15) brow))
          (set! alpha (max alpha brow))))
      ;; The mouth: the lower half of a thin ring.
      (let* ([m (vec2 0.5 0.7)]
             [ring (- (disc uv m 0.085 0.07) (disc uv m 0.07 0.05))]
             [lower (smoothstep (- m.y 0.01) (+ m.y 0.01) uv.y)]
             [mouth (* (clamp ring 0.0 1.0) lower)])
        (set! color (mix color (vec3 0.55 0.25 0.25) mouth))
        (set! alpha (max alpha mouth)))
      (vec4 color alpha))]
  [fragment (fragment [in varyings]) -> vec4
    (let ([uv (/ in.position.xy brush.size)] [l brush.layer])
      (if (== l 1) (grass uv)
          (if (== l 2) (dirt uv)
              (if (== l 3) (rock uv)
                  (if (== l 4) (sand uv)
                      (if (== l 5) (snow uv)
                          (if (== l 6) (bark uv)
                              (if (== l 7) (leaves uv)
                                  (if (== l 8) (blades uv)
                                      (if (== l 9) (planks uv)
                                          (if (== l 10) (tiles uv)
                                              (if (== l 11) (plaster uv)
                                                  (if (== l 12) (needles uv)
                                                      (if (== l 13) (face uv)
                                                          (vec4 1.0 1.0 1.0 1.0)))))))))))))))])

(define (materials-init! [m (ptr materials)])
  (memset m 0 (sizeof materials))
  (paint-init! (& (-> m shader)))
  (set! (-> m texture) (gpu-texture! material-size material-size material-count material-levels gpu-rgba8 (+ gpu-sampled gpu-target)))
  (set! (-> m sampler) (gpu-sampler! gpu-linear gpu-repeat gpu-compare-none))
  ;; The brush for each pass: a layer and a level, one after another in
  ;; a buffer, at the stride a dynamic offset needs.
  (let* ([passes (* material-count material-levels)]
         [bytes (cast (ptr u8) (malloc (* passes paint-brush-stride)))])
    (memset bytes 0 (* passes paint-brush-stride))
    (for ([layer u32 0]) (< layer material-count) (+= layer 1)
      (for ([level u32 0]) (< level material-levels) (+= level 1)
        (let ([b (cast (ptr paint-brush) (+ bytes (* (+ (* layer material-levels) level) paint-brush-stride)))])
          (set! (-> b layer) (cast i32 layer))
          (set! (-> b level) (cast i32 level))
          (set! (-> b size) (cast f32 (>> material-size level))))))
    (set! (-> m brushes) (gpu-buffer! (* passes paint-brush-stride) gpu-uniform))
    (gpu-write-copy! (-> m brushes) 0 bytes (* passes paint-brush-stride))
    (free bytes))
  (set! (-> m group) (paint-bind-group-0! (& (-> m shader)) (-> m brushes)))
  (let ([settings render-settings])
    (render-settings-init! (& settings))
    (set! (@ (-> settings targets) 0) gpu-rgba8)
    (set! (-> m pipeline) (paint-render-pipeline! (& (-> m shader)) "vertex" "fragment" (& settings))))
  ;; The passes: every level of every layer.
  (for ([layer u32 0]) (< layer material-count) (+= layer 1)
    (for ([level u32 0]) (< level material-levels) (+= level 1)
      (gpu-render-pass! 1 0 0 0 0 0.0)
      (gpu-pass-target! gpu-on-texture (-> m texture) level layer gpu-clear 1.0 1.0 1.0 1.0)
      (gpu-pipeline! (-> m pipeline))
      (gpu-bind-group-set! 0 (-> m group) 1)
      (gpu-offset! (* (+ (* layer material-levels) level) paint-brush-stride))
      (gpu-draw! 3 1 0 0)
      (gpu-end-pass!))))

(define (materials-texture [m (ptr materials)]) -> u32 (-> m texture))
(define (materials-sampler [m (ptr materials)]) -> u32 (-> m sampler))
