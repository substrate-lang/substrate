;; Lifecycle: experimental.
;;
;; The mathematics a 3D game needs and the language does not have:
;; trigonometry, 4 by 4 matrices for the GPU, and 3 by 4 matrices for
;; placing things in the world.
;;
;; Trigonometry. Wasm has no instruction for these, so they are computed
;; here, in the program; the results are the same on every host.
;;
;;   pi
;;   (radians degrees)      the angle in radians
;;   (sin x) (cos x)        for x in radians; the error is below 1e-10
;;   (tan x)
;;   (atan2 y x)            the angle of the point (x, y), -pi to pi; the
;;                          error is below 2e-5
;;   (asin x) (acos x)
;;   (angle-between a b)    the turn from the angle a to the angle b, -pi
;;                          to pi: positive counter-clockwise
;;   (clamp x low high)     x, kept between low and high
;;
;; Matrices. A matrix is 16 floats (an (array f32 16)), column by column,
;; which is how WGSL reads a mat4x4f from a uniform buffer. The functions
;; write their result into a matrix given first, so no matrix is ever
;; returned; `out` must not be one of the other arguments.
;;
;;   (mat4-identity! out)
;;   (mat4-perspective! out fov aspect near far)
;;       The projection of a camera with the vertical field of view
;;       `fov` (radians) on a screen `aspect` times as wide as it is
;;       high, showing what is between the distances `near` and `far`.
;;       Depth goes to 0..1, as WebGPU's clip space has it.
;;   (mat4-orthographic! out left right bottom top near far)
;;       The projection of a camera without perspective, showing the box
;;       between those distances: the sun's view for a shadow map.
;;   (mat4-view! out x y z yaw pitch)
;;       The view of a camera at (x, y, z) turned `yaw` radians about
;;       the vertical axis and `pitch` radians up (positive) or down. A
;;       yaw of 0 looks along +z, and turning left (a positive yaw)
;;       brings +x into view; y is up.
;;   (mat4-look! out x y z tx ty tz)
;;       The view of a camera at (x, y, z) looking at (tx, ty, tz), with
;;       y up (or z, when it looks straight up or down).
;;   (mat4-multiply! out a b)
;;       out = a * b: the transformation b, then a. The matrix a camera
;;       hands to a shader is (mat4-multiply! m projection view).
;;   (mat4-transform! out m x y z)
;;       The point (x, y, z) transformed by m, as four numbers (x, y,
;;       z, w) written into the array `out` of 4 f64.
;;
;; Placements. A 3 by 4 matrix is 12 floats, row by row (the top three
;; rows of a 4 by 4 whose last row is 0 0 0 1): a turn and a scale in
;; its left three columns, and a move in its last. It is what a mesh's
;; placement holds (meshes.sub), and what a figure's parts compose
;; (models.sub). Angles are the camera's: yaw about the vertical axis
;; (0 faces +z, positive turns left towards +x), pitch about the thing's
;; own x axis (positive raises its front), and roll about its own z axis
;; (positive drops its right side).
;;
;;   (mat34-identity! out)
;;   (mat34-pose! out x y z yaw pitch roll scale)
;;       The matrix that moves a thing to (x, y, z), turned by those
;;       angles and scaled by `scale`: scale first, then roll, pitch,
;;       yaw, then the move.
;;   (mat34-multiply! out a b)
;;       out = a * b: the transformation b, then a; out must not be a
;;       or b.
;;   (mat34-point! out m x y z)
;;       The point (x, y, z) transformed by m, as three f64 in `out`.
;;   (mat34-direction! out m x y z)
;;       The direction (x, y, z) transformed by m, without the move.
;;   (mat34-yaw m) (mat34-pitch m)
;;       The yaw and the pitch of the matrix's forward direction, its
;;       third column.
(require-unqualified base "../../../compiler/base/base.sub")

(provide pi radians sin cos tan atan2 asin acos angle-between clamp
         mat4-identity! mat4-perspective! mat4-orthographic! mat4-view! mat4-look! mat4-multiply! mat4-transform!
         mat34-identity! mat34-pose! mat34-multiply! mat34-point! mat34-direction! mat34-yaw mat34-pitch)

(memory from base)
(table from base)

(define pi f64 3.141592653589793)

(define (radians [degrees f64]) -> f64 (* degrees (/ pi 180.0)))

(define (clamp [x f64] [low f64] [high f64]) -> f64 (if (< x low) low (if (> x high) high x)))

;; The angle is brought into [-pi/2, pi/2], where the Taylor series of
;; the sine, taken as far as x^15, is accurate to about 1e-11.
(define (sin [x f64]) -> f64
  (let ([r (- x (* (nearbyint (/ x (* 2.0 pi))) (* 2.0 pi)))])
    (cond [(> r (/ pi 2.0)) (set! r (- pi r))]
          [(< r (- 0.0 (/ pi 2.0))) (set! r (- (- 0.0 pi) r))])
    (let ([square (* r r)] [term r] [sum r])
      (for ([k f64 2.0]) (<= k 14.0) (+= k 2.0)
        (set! term (* term (/ (- 0.0 square) (* k (+ k 1.0)))))
        (+= sum term))
      sum)))

(define (cos [x f64]) -> f64 (sin (+ x (/ pi 2.0))))

(define (tan [x f64]) -> f64 (/ (sin x) (cos x)))

;; The arc tangent of t in [-1, 1], by a polynomial whose error is below
;; 2e-5 (the usual fit of the odd powers up to the eleventh).
(define (atan-unit [t f64]) -> f64
  (let ([s (* t t)])
    (* t (+ 0.99997726 (* s (+ -0.33262347 (* s (+ 0.19354346 (* s (+ -0.11643287 (* s (+ 0.05265332 (* s -0.01172120)))))))))))))

(define (atan2 [y f64] [x f64]) -> f64
  (cond [(and (== x 0.0) (== y 0.0)) 0.0]
        [(> (fabs x) (fabs y))
         (let ([a (atan-unit (/ y x))])
           (if (>= x 0.0) a (if (>= y 0.0) (+ a pi) (- a pi))))]
        [else
         (let ([a (atan-unit (/ x y))])
           (if (>= y 0.0) (- (/ pi 2.0) a) (- (- 0.0 (/ pi 2.0)) a)))]))

(define (asin [x f64]) -> f64
  (let ([c (clamp x -1.0 1.0)])
    (atan2 c (sqrt (- 1.0 (* c c))))))

(define (acos [x f64]) -> f64 (- (/ pi 2.0) (asin x)))

(define (angle-between [a f64] [b f64]) -> f64
  (let ([d (- b a)])
    (- d (* (* 2.0 pi) (nearbyint (/ d (* 2.0 pi)))))))

;; ---- Matrices ----

;; Element (row, column) of a matrix stored column by column.
(define (at [m (ptr f32)] [row u32] [column u32]) -> f64 (cast f64 (@ m (+ (* column 4) row))))
(define (put! [m (ptr f32)] [row u32] [column u32] [value f64]) (set! (@ m (+ (* column 4) row)) (cast f32 value)))

(define (mat4-identity! [out (ptr f32)])
  (for ([i u32 0]) (< i 16) (+= i 1)
    (set! (@ out i) (if (== (% i 5) 0) 1.0 0.0))))

(define (mat4-perspective! [out (ptr f32)] [fov f64] [aspect f64] [near f64] [far f64])
  (let ([f (/ 1.0 (tan (/ fov 2.0)))])
    (for ([i u32 0]) (< i 16) (+= i 1) (set! (@ out i) 0.0))
    (put! out 0 0 (/ f aspect))
    (put! out 1 1 f)
    (put! out 2 2 (/ far (- near far)))
    (put! out 2 3 (/ (* near far) (- near far)))
    (put! out 3 2 -1.0)))

(define (mat4-orthographic! [out (ptr f32)] [left f64] [right f64] [bottom f64] [top f64] [near f64] [far f64])
  (for ([i u32 0]) (< i 16) (+= i 1) (set! (@ out i) 0.0))
  (put! out 0 0 (/ 2.0 (- right left)))
  (put! out 0 3 (- 0.0 (/ (+ right left) (- right left))))
  (put! out 1 1 (/ 2.0 (- top bottom)))
  (put! out 1 3 (- 0.0 (/ (+ top bottom) (- top bottom))))
  (put! out 2 2 (- 0.0 (/ 1.0 (- far near))))
  (put! out 2 3 (- 0.0 (/ near (- far near))))
  (put! out 3 3 1.0))

;; The view from the camera's axes: right, up and forward, and its
;; position. The world is turned by the transposed axes and moved by
;; the position taken away; the camera looks along -z in its own
;; space, as the projections expect.
(define (view-from-axes! [out (ptr f32)] [x f64] [y f64] [z f64]
                         [rx f64] [ry f64] [rz f64] [ux f64] [uy f64] [uz f64] [fx f64] [fy f64] [fz f64])
  (put! out 0 0 rx) (put! out 0 1 ry) (put! out 0 2 rz) (put! out 0 3 (- 0.0 (+ (* rx x) (* ry y) (* rz z))))
  (put! out 1 0 ux) (put! out 1 1 uy) (put! out 1 2 uz) (put! out 1 3 (- 0.0 (+ (* ux x) (* uy y) (* uz z))))
  (put! out 2 0 (- 0.0 fx)) (put! out 2 1 (- 0.0 fy)) (put! out 2 2 (- 0.0 fz)) (put! out 2 3 (+ (* fx x) (* fy y) (* fz z)))
  (put! out 3 0 0.0) (put! out 3 1 0.0) (put! out 3 2 0.0) (put! out 3 3 1.0))

(define (mat4-look! [out (ptr f32)] [x f64] [y f64] [z f64] [tx f64] [ty f64] [tz f64])
  (let* ([fx (- tx x)] [fy (- ty y)] [fz (- tz z)]
         [length (sqrt (+ (* fx fx) (* fy fy) (* fz fz)))])
    (when (== length 0.0) (set! length 1.0))
    (set! fx (/ fx length))
    (set! fy (/ fy length))
    (set! fz (/ fz length))
    ;; right = forward x up, with up = (0, 1, 0), or (0, 0, 1) when forward
    ;; is vertical.
    (let* ([vertical (< (+ (* fx fx) (* fz fz)) 1e-8)]
           [upx 0.0] [upy (if vertical 0.0 1.0)] [upz (if vertical 1.0 0.0)]
           [rx (- (* fy upz) (* fz upy))] [ry (- (* fz upx) (* fx upz))] [rz (- (* fx upy) (* fy upx))]
           [rl (sqrt (+ (* rx rx) (* ry ry) (* rz rz)))])
      (set! rx (/ rx rl))
      (set! ry (/ ry rl))
      (set! rz (/ rz rl))
      ;; up = right x forward
      (view-from-axes! out x y z rx ry rz
                       (- (* ry fz) (* rz fy)) (- (* rz fx) (* rx fz)) (- (* rx fy) (* ry fx))
                       fx fy fz))))

;; The camera's axes: forward from the yaw and the pitch; right from
;; the yaw alone, since the camera does not roll, which also keeps it
;; defined when the camera looks straight up or down; and up across the
;; two.
(define (mat4-view! [out (ptr f32)] [x f64] [y f64] [z f64] [yaw f64] [pitch f64])
  (let* ([fx (* (sin yaw) (cos pitch))] [fy (sin pitch)] [fz (* (cos yaw) (cos pitch))]
         [rx (- 0.0 (cos yaw))] [rz (sin yaw)])
    ;; up = right x forward
    (view-from-axes! out x y z rx 0.0 rz (- 0.0 (* rz fy)) (- (* rz fx) (* rx fz)) (* rx fy) fx fy fz)))

(define (mat4-multiply! [out (ptr f32)] [a (ptr f32)] [b (ptr f32)])
  (for ([row u32 0]) (< row 4) (+= row 1)
    (for ([column u32 0]) (< column 4) (+= column 1)
      (let ([sum f64 0.0])
        (for ([k u32 0]) (< k 4) (+= k 1)
          (+= sum (* (at a row k) (at b k column))))
        (put! out row column sum)))))

(define (mat4-transform! [out (ptr f64)] [m (ptr f32)] [x f64] [y f64] [z f64])
  (for ([row u32 0]) (< row 4) (+= row 1)
    (set! (@ out row) (+ (* (at m row 0) x) (* (at m row 1) y) (* (at m row 2) z) (at m row 3)))))

;; ---- Placements ----

(define (mat34-identity! [out (ptr f32)])
  (for ([i u32 0]) (< i 12) (+= i 1)
    (set! (@ out i) (if (== (% i 5) 0) 1.0 0.0))))

;; Row by row: element (row, column) is at row * 4 + column.
(define (mat34-pose! [out (ptr f32)] [x f64] [y f64] [z f64] [yaw f64] [pitch f64] [roll f64] [scale f64])
  (let* ([cy (cos yaw)] [sy (sin yaw)] [cp (cos pitch)] [sp (sin pitch)] [cr (cos roll)] [sr (sin roll)]
         ;; Ry(yaw) * Rx(pitch) * Rz(roll), with the camera's angles:
         ;; forward (0, 0, 1) goes to (sin yaw cos pitch, sin pitch,
         ;; cos yaw cos pitch), as mat4-view! has it.
         [r00 (- (* cy cr) (* sy sp sr))] [r01 (- 0.0 (+ (* cy sr) (* sy sp cr)))] [r02 (* sy cp)]
         [r10 (* cp sr)] [r11 (* cp cr)] [r12 sp]
         [r20 (- 0.0 (+ (* sy cr) (* cy sp sr)))] [r21 (- (* sy sr) (* cy sp cr))] [r22 (* cy cp)])
    (set! (@ out 0) (cast f32 (* r00 scale))) (set! (@ out 1) (cast f32 (* r01 scale))) (set! (@ out 2) (cast f32 (* r02 scale))) (set! (@ out 3) (cast f32 x))
    (set! (@ out 4) (cast f32 (* r10 scale))) (set! (@ out 5) (cast f32 (* r11 scale))) (set! (@ out 6) (cast f32 (* r12 scale))) (set! (@ out 7) (cast f32 y))
    (set! (@ out 8) (cast f32 (* r20 scale))) (set! (@ out 9) (cast f32 (* r21 scale))) (set! (@ out 10) (cast f32 (* r22 scale))) (set! (@ out 11) (cast f32 z))))

(define (mat34-multiply! [out (ptr f32)] [a (ptr f32)] [b (ptr f32)])
  (for ([row u32 0]) (< row 3) (+= row 1)
    (for ([column u32 0]) (< column 4) (+= column 1)
      (let ([sum f64 0.0])
        (for ([k u32 0]) (< k 3) (+= k 1)
          (+= sum (* (cast f64 (@ a (+ (* row 4) k))) (cast f64 (@ b (+ (* k 4) column))))))
        (when (== column 3) (+= sum (cast f64 (@ a (+ (* row 4) 3)))))
        (set! (@ out (+ (* row 4) column)) (cast f32 sum))))))

(define (mat34-point! [out (ptr f64)] [m (ptr f32)] [x f64] [y f64] [z f64])
  (for ([row u32 0]) (< row 3) (+= row 1)
    (set! (@ out row) (+ (* (cast f64 (@ m (* row 4))) x) (* (cast f64 (@ m (+ (* row 4) 1))) y)
                         (* (cast f64 (@ m (+ (* row 4) 2))) z) (cast f64 (@ m (+ (* row 4) 3)))))))

(define (mat34-direction! [out (ptr f64)] [m (ptr f32)] [x f64] [y f64] [z f64])
  (for ([row u32 0]) (< row 3) (+= row 1)
    (set! (@ out row) (+ (* (cast f64 (@ m (* row 4))) x) (* (cast f64 (@ m (+ (* row 4) 1))) y)
                         (* (cast f64 (@ m (+ (* row 4) 2))) z)))))

;; The forward direction is the third column: (m02, m12, m22).
(define (mat34-yaw [m (ptr f32)]) -> f64 (atan2 (cast f64 (@ m 2)) (cast f64 (@ m 10))))

(define (mat34-pitch [m (ptr f32)]) -> f64
  (let ([fx (cast f64 (@ m 2))] [fy (cast f64 (@ m 6))] [fz (cast f64 (@ m 10))])
    (atan2 fy (sqrt (+ (* fx fx) (* fz fz))))))
