;; Meshes drawn by the GPU: placed many times, with painted materials, lit by a sun, and water.
(require-unqualified base "../../../compiler/base/base.sub")
(require-unqualified gpu "../gpu.sub")
(require-unqualified shader "shader.sub")
(require-unqualified color "../../shade/color.sub")
(require-unqualified noise "../../shade/noise.sub")
(require-unqualified math "math.sub")
(require-unqualified camera "camera.sub")
(require-unqualified light "light.sub")
(require-unqualified materials "materials.sub")

(provide lit-code meshes mesh-lit mesh-water mesh-cards material-land material-stone material-skin mesh-color meshes-init! meshes-add! meshes-set!
         placement placement-at! meshes-place! meshes-submit! meshes-casts! meshes-heights!
         meshes-frame! meshes-shadow-maps meshes-shadow-pass! meshes-pass!)

(memory from base)
(table from base)

(define shadow-size u32 2048)
(define near-radius f64 28.0)
(define far-radius f64 120.0)

(define mesh-lit u32 0)
(define mesh-water u32 1)
(define mesh-cards u32 2)

(define material-land u32 20)
(define material-stone u32 21)
(define material-skin u32 22)

;; A placement's tint has alpha 0 for a small thing, such as grass: drawn without outlines,
;; and gone beyond about 40 units.
(struct placement [m (array f32 12)] [tint u32])

(define (placement-at! [p (ptr placement)] [x f64] [y f64] [z f64] [yaw f64] [scale f64] [tint u32])
  (mat34-pose! (-> p m) x y z yaw 0.0 0.0 scale)
  (set! (-> p tint) tint))

;; A colour in a vertex or a placement is the bytes r, g, b, a, which is not how a
;; #xRRGGBBAA number lies in memory; the sway takes the alpha.
(define (mesh-color [c u32] [sway f64]) -> u32
  (bit-or (>> c 24) (bit-and (>> c 8) #xff00) (bit-and (<< c 8) #xff0000) (<< (cast u32 (* (clamp-unit sway) 255.0)) 24)))

(define (clamp-unit [x f64]) -> f64 (if (< x 0.0) 0.0 (if (> x 1.0) 1.0 x)))

(struct mesh
  [kind u32] [casts u32]
  [vertices u32] [vertex-room u32]
  [indices u32] [index-room u32]
  [places u32] [place-room u32]
  [index-count u32] [place-count u32]
  [submitted buffer] [submit-frame u32]
  [submits u32] [submit-room u32] [submit-count u32])

(struct meshes
  [items (ptr mesh)] [count u32] [capacity u32]
  [frame u32]
  [shader lit-shader]
  [paints materials]
  [atlas-sampler u32] [atlas u32] [shadow-sampler u32] [shadow-maps u32] [heights u32] [blank-heights u32]
  [frame-uniforms u32] [cascade-uniforms u32] [frame-group u32] [surface-group u32] [shadow-group u32]
  [shadow-pipeline u32] [shadow-cards-pipeline u32] [lit-pipeline u32] [cards-pipeline u32] [water-pipeline u32]
  [heights-width f64] [heights-height f64])

;; The atlas is visible to the vertex stage too, which asks it for its size.
;; Colours given (the atlas, the materials, the vertices) are sRGB; the shader lights in
;; linear values and writes linear ones with more range than a screen, which post.sub maps back.
(shader lit
  [uniform frame 0 0 (vertex fragment)
    [view-projection mat4] [near-cascade mat4] [far-cascade mat4]
    [camera vec3] [time f32]
    [sun vec3] [near-texel f32]
    [sun-color vec4] [ambient vec4] [sky vec4]
    [fog vec2] [heights-size vec2]
    [mist vec2] [far-texel f32] [unused f32]]
  [uniform-array cascade 0 1 (vertex) [view-projection mat4]]
  [sampler atlas-sampler 1 0 (fragment)]
  [texture atlas 1 1 (vertex fragment)]
  [sampler materials-sampler 1 2 (fragment)]
  [texture-array materials 1 3 (fragment)]
  [comparison-sampler shadow-sampler 2 0 (fragment)]
  [depth-texture-array shadow-maps 2 1 (fragment)]
  [texture heights 2 2 (fragment)]
  [vertex-input vertex per-vertex [position vec3] [normal vec3] [texel vec2] [shade f32] [material f32] [color unorm8x4]]
  [vertex-input instance per-instance [row0 vec4] [row1 vec4] [row2 vec4] [tint unorm8x4]]
  [varyings [world vec3] [normal vec3] [uv vec2] [shade f32] [material f32] [color vec4]
            [near-shadow vec3] [far-shadow vec3] [outline f32]]
  [outputs [color vec4] [normal vec4]]
  [use color]
  [use noise]
  ;; The same numbers as materials.sub's material-scale.
  [define (span [m i32]) -> f32
    (if (== m 1) 3.0 (if (== m 2) 3.0 (if (== m 3) 7.0 (if (== m 4) 2.5 (if (== m 5) 4.0 (if (== m 6) 1.2
        (if (== m 9) 3.0 (if (== m 10) 2.4 (if (== m 11) 3.0 (if (== m 12) 1.8 (if (== m 21) 1.8 1.0)))))))))))]
  [define (layer [m i32]) -> i32 (if (== m 21) 3 (if (== m 22) 0 m))]
  [define (on-card [m i32]) -> bool (or (== m 7) (== m 8) (== m 13))]
  [define (placed [in vertex] [push f32]) -> vec3
    (let* ([origin (vec3 in.row0.w in.row1.w in.row2.w)]
           [away (distance frame.camera origin)]
           [shrink (if (< in.tint.a 0.5) (- 1.0 (smoothstep 32.0 44.0 away)) 1.0)]
           [p in.position]
           [turned-p (vec3 (dot in.row0.xyz p) (dot in.row1.xyz p) (dot in.row2.xyz p))]
           [world (+ origin (* turned-p shrink))]
           [wind (* (vec3 (sin (+ (* frame.time 1.7) (* world.x 0.35) (* world.z 0.2))) 0.0
                          (cos (+ (* frame.time 1.3) (* world.z 0.3))))
                    (* in.color.a in.color.a 0.35))])
      (+ world wind (* (turned in) push)))]
  [define (turned [in vertex]) -> vec3
    (let ([n in.normal])
      (normalize (vec3 (dot in.row0.xyz n) (dot in.row1.xyz n) (dot in.row2.xyz n))))]
  [define (tinted [c vec3] [tint vec3]) -> vec3
    (let ([grey (step (+ (abs (- c.r c.g)) (abs (- c.g c.b))) 0.035)])
      (mix c (* c tint) grey))]
  [define (in-map [s vec4]) -> vec3 (vec3 (+ (* s.x 0.5) 0.5) (- 0.5 (* s.y 0.5)) s.z)]
  [vertex (vertex [in vertex]) -> varyings
    (let* ([world (placed in 0.0)]
           ;; Pushed along the normal by a texel and a half, so that a surface does not shadow itself.
           [near (* frame.near-cascade (vec4 (placed in (* frame.near-texel 1.5)) 1.0))]
           [far (* frame.far-cascade (vec4 (placed in (* frame.far-texel 1.5)) 1.0))])
      (varyings [position (* frame.view-projection (vec4 world 1.0))]
                [world world]
                [normal (turned in)]
                [uv (if (< in.material 0.5) (/ in.texel (vec2 (texture-dimensions atlas))) in.texel)]
                [shade in.shade]
                [material in.material]
                [color (vec4 (tinted in.color.rgb in.tint.rgb) 1.0)]
                [near-shadow (in-map near)]
                [far-shadow (in-map far)]
                [outline in.tint.a]))]
  [vertex (shadow [in vertex]) -> varyings
    (varyings [position (* cascade.view-projection (vec4 (placed in 0.0) 1.0))])]
  [vertex (shadow-card [in vertex]) -> varyings
    (varyings [position (* cascade.view-projection (vec4 (placed in 0.0) 1.0))]
              [uv in.texel]
              [material in.material])]
  [fragment (shadow-fragment [in varyings])
    (when (< (-> (texture-sample materials materials-sampler in.uv (i32 (round in.material))) a) 0.5) (discard))]
  [define (sunlit-in [p vec3] [layer i32] [bias f32]) -> f32
    (let ([sum 0.0])
      (for ([i -1]) (<= i 1) (+= i 1)
        (for ([j -1]) (<= j 1) (+= j 1)
          (+= sum (texture-sample-compare-level shadow-maps shadow-sampler
                                                (+ p.xy (* (vec2 (f32 i) (f32 j)) (/ 1.0 2048.0))) layer (- p.z bias)))))
      (/ sum 9.0))]
  [define (sunlit [in varyings] [facing-sun f32]) -> f32
    (let* ([n in.near-shadow] [f in.far-shadow]
           [slope (+ 1.0 (* 3.0 (- 1.0 (clamp facing-sun 0.0 1.0))))]
           [near-edge (max (abs (- n.x 0.5)) (abs (- n.y 0.5)))]
           [use-near (* (- 1.0 (smoothstep 0.42 0.49 near-edge)) (step n.z 1.0))]
           [far-edge (max (abs (- f.x 0.5)) (abs (- f.y 0.5)))]
           [use-far (* (- 1.0 (smoothstep 0.45 0.5 far-edge)) (step f.z 1.0))]
           [near-lit (if (> use-near 0.0) (sunlit-in n 0 (* 0.0010 slope)) 1.0)]
           [far-lit (if (> use-far 0.0) (sunlit-in f 1 (* 0.0006 slope)) 1.0)])
      (mix (mix 1.0 far-lit use-far) near-lit use-near))]
  [define (fog-at [world vec3]) -> f32
    (let* ([away (distance frame.camera world)]
           [fog (clamp (/ (- away frame.fog.x) (- frame.fog.y frame.fog.x)) 0.0 1.0)]
           [mist (* frame.mist.y (- 1.0 (smoothstep frame.mist.x (+ frame.mist.x 15.0) world.y)) (smoothstep 10.0 90.0 away))])
      (- 1.0 (* (- 1.0 fog) (- 1.0 mist))))]
  [define (haze [world vec3]) -> vec3
    (let ([towards (max (dot (normalize (- world frame.camera)) (normalize frame.sun)) 0.0)]
          [bright (clamp (* 1.5 (dot frame.sun-color.rgb (vec3 0.33 0.34 0.33))) 0.0 1.0)])
      (+ (mix frame.sky.rgb (vec3 1.0) (* 0.3 bright)) (* frame.sun-color.rgb (pow towards 8.0) 0.3)))]
  [define (cloud-shade [world vec3]) -> f32
    (- 1.0 (* 0.55 (smoothstep 0.5 0.66 (gradient-fbm (* (+ world.xz (vec2 (* frame.time 1.5) (* frame.time 0.4))) 0.012) 4))))]
  ;; Textures are read with derivatives found before any branch on the material: WGSL allows
  ;; plain sampling only where every neighbouring fragment samples too.
  [struct slopes [wx vec3] [wy vec3] [ux vec2] [uy vec2]]
  [define (tiled [m i32] [world vec3] [n vec3] [d slopes]) -> vec4
    (let* ([s (span m)] [l (layer m)]
           [w (abs n)]
           [weights (/ w (+ w.x w.y w.z))]
           [top (texture-sample-grad materials materials-sampler (/ world.xz s) l (/ d.wx.xz s) (/ d.wy.xz s))]
           [side-x (texture-sample-grad materials materials-sampler (/ world.zy s) l (/ d.wx.zy s) (/ d.wy.zy s))]
           [side-z (texture-sample-grad materials materials-sampler (/ world.xy s) l (/ d.wx.xy s) (/ d.wy.xy s))])
      (+ (* top weights.y) (* side-x weights.x) (* side-z weights.z)))]
  [define (flat [m i32] [world vec3] [d slopes]) -> vec4
    (let ([s (span m)])
      (texture-sample-grad materials materials-sampler (/ world.xz s) m (/ d.wx.xz s) (/ d.wy.xz s)))]
  [define (land [in varyings] [n vec3] [d slopes]) -> vec4
    (let* ([c in.color.rgb]
           [dirtness (smoothstep 0.02 0.12 (- c.r c.g))]
           [snowiness (smoothstep 0.8 0.92 (min c.r (min c.g c.b)))]
           [rockiness (smoothstep 0.78 0.55 n.y)]
           [ground (mix (mix (flat 1 in.world d) (flat 2 in.world d) dirtness) (flat 5 in.world d) snowiness)])
      (mix ground (tiled 3 in.world n d) rockiness))]
  [define (surface [in varyings] [n vec3] [m i32]) -> vec4
    (let ([d (slopes [wx (dpdx in.world)] [wy (dpdy in.world)] [ux (dpdx in.uv)] [uy (dpdy in.uv)])])
      (if (or (== m 0) (== m 22))
          (texture-sample-grad atlas atlas-sampler in.uv d.ux d.uy)
          (if (== m 20)
              (land in n d)
              (if (on-card m)
                  (texture-sample-grad materials materials-sampler in.uv m d.ux d.uy)
                  (tiled m in.world n d)))))]
  [fragment (fragment [in varyings]) -> outputs
    (let* ([n (normalize in.normal)]
           [m (i32 (round in.material))]
           [texel (surface in n m)]
           [far (smoothstep 30.0 110.0 (distance frame.camera in.world))]
           [detail (mix texel.rgb (vec3 1.0) (* far (step 0.5 in.material)))])
      (when (< texel.a 0.5) (discard))
      (let* ([albedo (linear (* detail in.color.rgb))]
             [towards-sun (normalize frame.sun)]
             [facing-sun (dot n towards-sun)]
             [facing (* (smoothstep -0.1 0.15 facing-sun) (sunlit in facing-sun) (cloud-shade in.world))]
             [soft (if (or (== m 13) (== m 22)) 1.0 0.0)]
             [light (mix (+ 0.08 (* 0.92 (smoothstep 0.35 0.62 facing))) (+ 0.5 (* 0.5 (smoothstep 0.2 0.7 facing))) soft)]
             [v (normalize (- frame.camera in.world))]
             [rim (* (pow (- 1.0 (max (dot n v) 0.0)) 6.0) facing 0.25)]
             [hemisphere (+ (* n.y 0.5) 0.5)]
             [ambient (* (mix (* frame.ambient.rgb 0.85) (mix frame.ambient.rgb frame.sky.rgb 0.2) hemisphere) (mix 0.6 1.0 in.shade))]
             [color (+ (* albedo (+ ambient (* frame.sun-color.rgb light 0.85 (mix 0.7 1.0 in.shade))))
                       (* frame.sun-color.rgb rim 0.5))])
        ;; The normal target's alpha says whether the pixel gets outlines.
        (outputs [color (vec4 (mix color (haze in.world) (fog-at in.world)) 1.0)]
                 [normal (vec4 (+ (* n 0.5) 0.5) in.outline)])))]
  [define (land-at [world vec3]) -> f32
    (let* ([size (vec2 (texture-dimensions heights))]
           [at (clamp (vec2i (* (/ world.xz frame.heights-size) size)) (vec2i 0 0) (- (vec2i size) (vec2i 1 1)))])
      (-> (texture-load heights at 0) x))]
  [fragment (water [in varyings]) -> outputs
    (let* ([depth (max (- in.world.y (land-at in.world)) 0.0)]
           [drift (vec2 (* frame.time 0.6) (* frame.time 0.35))]
           [ripple (- (+ (noise (+ (* in.world.xz 0.9) drift)) (noise (- (* in.world.xz 1.7) drift)) (* 0.5 (noise (+ (* in.world.xz 3.6) (* drift 1.5))))) 1.25)]
           [n (normalize (vec3 (* ripple 0.22) 1.0 (* (- (noise (+ (* in.world.xz 1.3) (vec2 drift.y (- 0.0 drift.x)))) 0.5) 0.3)))]
           [v (normalize (- frame.camera in.world))]
           [towards-sun (normalize frame.sun)]
           [shallow (linear (vec3 0.35 0.75 0.7))]
           [deep (linear (vec3 0.05 0.2 0.45))]
           [water (mix shallow deep (smoothstep 0.2 3.0 depth))]
           [facing (dot n towards-sun)]
           [light (+ 0.4 (* 0.6 (smoothstep 0.3 0.5 facing)))]
           [mirrored (max (dot (reflect (- towards-sun) n) v) 0.0)]
           [glint (+ (* (pow mirrored 64.0) 0.8) (* (pow mirrored 10.0) 0.12))]
           [fresnel (pow (- 1.0 (max (dot n v) 0.0)) 3.0)]
           [foam (max (* 0.7 (- 1.0 (smoothstep 0.0 0.1 depth)))
                      (* (- 1.0 (smoothstep 0.05 0.4 depth)) (smoothstep 0.45 0.6 (noise (+ (* in.world.xz 2.5) (vec2 (* frame.time 0.5) (* frame.time -0.3)))))))]
           [color (+ (* water (+ frame.ambient.rgb (* frame.sun-color.rgb light)))
                     (* frame.sun-color.rgb glint))])
      (set! color (mix color (* (haze in.world) 0.9) (* fresnel 0.5)))
      (set! color (mix color (vec3 0.9) foam))
      (outputs [color (vec4 (mix color (haze in.world) (fog-at in.world)) (mix 0.75 0.95 (smoothstep 0.0 1.5 depth)))]
               [normal (vec4 0.5 1.0 0.5 1.0)]))])

(define vertex-bytes u32 44)

(define (meshes-init! [r (ptr meshes)] [atlas (ptr u8)])
  (memset r 0 (sizeof meshes))
  (lit-init! (& (-> r shader)))
  (materials-init! (& (-> r paints)))
  (set! (-> r atlas-sampler) (gpu-sampler! gpu-nearest gpu-clamp gpu-compare-none))
  (set! (-> r atlas) (gpu-texture-file! atlas))
  (set! (-> r shadow-sampler) (gpu-sampler! gpu-linear gpu-clamp gpu-less))
  (set! (-> r shadow-maps) (gpu-texture! shadow-size shadow-size 2 1 gpu-depth32f (+ gpu-sampled gpu-target)))
  (set! (-> r blank-heights) (gpu-texture! 1 1 1 1 gpu-rgba16f gpu-sampled))
  (set! (-> r heights) (-> r blank-heights))
  (set! (-> r heights-width) 1.0)
  (set! (-> r heights-height) 1.0)
  (set! (-> r frame-uniforms) (gpu-buffer! (sizeof lit-frame) gpu-uniform))
  (set! (-> r cascade-uniforms) (gpu-buffer! (* 2 lit-cascade-stride) gpu-uniform))
  (set! (-> r frame-group) (lit-bind-group-0! (& (-> r shader)) (-> r frame-uniforms) (-> r cascade-uniforms)))
  (set! (-> r surface-group)
        (lit-bind-group-1! (& (-> r shader)) (-> r atlas-sampler) (-> r atlas)
                           (materials-sampler (& (-> r paints))) (materials-texture (& (-> r paints)))))
  (shadows! r)
  (let ([settings render-settings])
    (render-settings-init! (& settings))
    (set! (-> settings cull) gpu-cull-back)
    (set! (-> settings depth-compare) gpu-less)
    (set! (-> settings depth-write) 1)
    ;; The shadow pipelines use the frame alone, or the frame and the surfaces: never the
    ;; shadow maps they draw into.
    (set! (-> settings depth-format) gpu-depth32f)
    (set! (-> settings target-count) 0)
    (set! (-> settings groups) 1)
    (set! (-> r shadow-pipeline) (lit-render-pipeline! (& (-> r shader)) "shadow" "" (& settings)))
    (set! (-> settings groups) 2)
    (set! (-> settings cull) gpu-cull-none)
    (set! (-> r shadow-cards-pipeline) (lit-render-pipeline! (& (-> r shader)) "shadow_card" "shadow_fragment" (& settings)))
    ;; The water's pipeline blends over the others and leaves the depth as it is.
    (set! (-> settings cull) gpu-cull-back)
    (set! (-> settings depth-format) gpu-depth24)
    (set! (-> settings target-count) 2)
    (set! (@ (-> settings targets) 0) gpu-rgba16f)
    (set! (@ (-> settings targets) 1) gpu-rgba8)
    (set! (-> settings groups) 0)
    (set! (-> r lit-pipeline) (lit-render-pipeline! (& (-> r shader)) "vertex" "fragment" (& settings)))
    (set! (-> settings cull) gpu-cull-none)
    (set! (-> r cards-pipeline) (lit-render-pipeline! (& (-> r shader)) "vertex" "fragment" (& settings)))
    (set! (-> settings blend) gpu-blend-alpha)
    (set! (-> settings depth-write) 0)
    (set! (-> r water-pipeline) (lit-render-pipeline! (& (-> r shader)) "vertex" "water" (& settings)))))

(define (shadows! [r (ptr meshes)])
  (when (!= (-> r shadow-group) 0) (gpu-destroy! gpu-kind-bind-group (-> r shadow-group)))
  (set! (-> r shadow-group)
        (lit-bind-group-2! (& (-> r shader)) (-> r shadow-sampler) (-> r shadow-maps) (-> r heights))))

(define (meshes-heights! [r (ptr meshes)] [texture u32] [width f64] [height f64])
  (set! (-> r heights) texture)
  (set! (-> r heights-width) width)
  (set! (-> r heights-height) height)
  (shadows! r))

(define (meshes-add! [r (ptr meshes)] [kind u32]) -> u32
  (when (== (-> r count) (-> r capacity))
    (set! (-> r capacity) (if (== (-> r capacity) 0) 16 (* 2 (-> r capacity))))
    (set! (-> r items) (cast (ptr mesh) (realloc (-> r items) (* (-> r capacity) (sizeof mesh))))))
  (let ([m (+ (-> r items) (-> r count))])
    (memset m 0 (sizeof mesh))
    (set! (-> m kind) kind)
    (set! (-> m casts) 1)
    (+= (-> r count) 1)
    (- (-> r count) 1)))

(define (meshes-casts! [r (ptr meshes)] [mesh u32] [casts u32])
  (set! (-> (+ (-> r items) mesh) casts) casts))

(define (room! [id (ptr u32)] [room (ptr u32)] [n u32] [usage u32])
  (when (< (@ room) n)
    (when (!= (@ id) 0) (gpu-destroy! gpu-kind-buffer (@ id)))
    (set! (@ room) (if (== (@ room) 0) 4096 (@ room)))
    (while (< (@ room) n) (*= (@ room) 2))
    (set! (@ id) (gpu-buffer! (@ room) usage))))

;; The bytes are read when the frame is handed over (gpu.sub), so they must stay until then.
(define (meshes-set! [r (ptr meshes)] [mesh u32] [vertices (ptr buffer)] [indices (ptr buffer)])
  (let ([m (+ (-> r items) mesh)])
    (set! (-> m index-count) (/ (-> indices length) 4))
    (when (> (-> m index-count) 0)
      (room! (& (-> m vertices)) (& (-> m vertex-room)) (-> vertices length) gpu-vertex)
      (room! (& (-> m indices)) (& (-> m index-room)) (-> indices length) gpu-index)
      (gpu-write-buffer! (-> m vertices) 0 (-> vertices bytes) (-> vertices length))
      (gpu-write-buffer! (-> m indices) 0 (-> indices bytes) (-> indices length)))))

;; The placements are read when the frame is handed over, so they must stay until then.
(define (meshes-place! [r (ptr meshes)] [mesh u32] [places (ptr placement)] [count u32])
  (let ([m (+ (-> r items) mesh)])
    (set! (-> m place-count) count)
    (when (> count 0)
      (room! (& (-> m places)) (& (-> m place-room)) (* count (sizeof placement)) gpu-vertex)
      (gpu-write-buffer! (-> m places) 0 places (* count (sizeof placement))))))

;; A submission is for the frame after the one drawn last, so during the game's draw, before
;; scene-draw!: the first of them clears what was submitted for the frame before.
(define (meshes-submit! [r (ptr meshes)] [mesh u32] [p (ptr placement)])
  (let ([m (+ (-> r items) mesh)] [next (+ (-> r frame) 1)])
    (when (!= (-> m submit-frame) next)
      (set! (-> m submit-frame) next)
      (set! (-> m submitted length) 0))
    (buffer-add! (& (-> m submitted)) (cast (ptr u8) p) (sizeof placement))))

(define (submissions! [r (ptr meshes)])
  (let ([next (+ (-> r frame) 1)])
    (for ([i u32 0]) (< i (-> r count)) (+= i 1)
      (let ([m (+ (-> r items) i)])
        (if (== (-> m submit-frame) next)
            (let ([n (-> m submitted length)])
              (set! (-> m submit-count) (/ n (sizeof placement)))
              (room! (& (-> m submits)) (& (-> m submit-room)) n gpu-vertex)
              (gpu-write-buffer! (-> m submits) 0 (-> m submitted bytes) n))
            (set! (-> m submit-count) 0))))
    (set! (-> r frame) next)))

(define (draw-all! [r (ptr meshes)] [kind u32] [shadows i32])
  (for ([i u32 0]) (< i (-> r count)) (+= i 1)
    (let ([m (+ (-> r items) i)])
      (when (and (== (-> m kind) kind) (> (-> m index-count) 0)
                 (or (not shadows) (!= (-> m casts) 0)))
        (when (> (-> m place-count) 0)
          (gpu-vertex-buffer! 0 (-> m vertices) 0)
          (gpu-vertex-buffer! 1 (-> m places) 0)
          (gpu-index-buffer! (-> m indices) gpu-u32-indexes 0)
          (gpu-draw-indexed! (-> m index-count) (-> m place-count) 0 0 0))
        (when (> (-> m submit-count) 0)
          (gpu-vertex-buffer! 0 (-> m vertices) 0)
          (gpu-vertex-buffer! 1 (-> m submits) 0)
          (gpu-index-buffer! (-> m indices) gpu-u32-indexes 0)
          (gpu-draw-indexed! (-> m index-count) (-> m submit-count) 0 0 0))))))

(define (cascade! [matrix (ptr f32)] [l (ptr light)] [sx f64] [sy f64] [sz f64] [radius f64])
  (let ([view (array f32 16)] [projection (array f32 16)] [texel (/ (* 2.0 radius) (cast f64 shadow-size))])
    (mat4-look! view
                (+ (-> l shadow-x) (* sx radius 2.0)) (+ (-> l shadow-y) (* sy radius 2.0)) (+ (-> l shadow-z) (* sz radius 2.0))
                (-> l shadow-x) (-> l shadow-y) (-> l shadow-z))
    ;; Moved only by whole texels of the map, so that the shadows' edges do not crawl.
    (set! (@ view 12) (cast f32 (* (nearbyint (/ (cast f64 (@ view 12)) texel)) texel)))
    (set! (@ view 13) (cast f32 (* (nearbyint (/ (cast f64 (@ view 13)) texel)) texel)))
    (mat4-orthographic! projection (- 0.0 radius) radius (- 0.0 radius) radius (* radius 0.5) (* radius 3.5))
    (mat4-multiply! matrix projection view)))

(define (meshes-frame! [r (ptr meshes)] [c (ptr camera)] [l (ptr light)])
  (submissions! r)
  (let ([frame lit-frame] [view (array f32 16)] [cascades (array u8 512)]
        [length (sqrt (+ (* (-> l sun-x) (-> l sun-x)) (* (-> l sun-y) (-> l sun-y)) (* (-> l sun-z) (-> l sun-z))))])
    (memset (& frame) 0 (sizeof lit-frame))
    (memset cascades 0 512)
    (mat4-view! view (-> c x) (-> c y) (-> c z) (-> c yaw) (-> c pitch))
    (mat4-multiply! (-> frame view-projection) (-> c projection) view)
    (let ([sx (/ (-> l sun-x) length)] [sy (/ (-> l sun-y) length)] [sz (/ (-> l sun-z) length)])
      (cascade! (-> frame near-cascade) l sx sy sz near-radius)
      (cascade! (-> frame far-cascade) l sx sy sz far-radius)
      (vec3! (-> frame sun) sx sy sz))
    (memcpy (-> (cast (ptr lit-cascade) cascades) view-projection) (-> frame near-cascade) 64)
    (memcpy (-> (cast (ptr lit-cascade) (+ cascades lit-cascade-stride)) view-projection) (-> frame far-cascade) 64)
    (vec3! (-> frame camera) (-> c x) (-> c y) (-> c z))
    (set! (-> frame near-texel) (cast f32 (/ (* 2.0 near-radius) (cast f64 shadow-size))))
    (set! (-> frame far-texel) (cast f32 (/ (* 2.0 far-radius) (cast f64 shadow-size))))
    (set! (-> frame time) (cast f32 (-> l time)))
    (linear-color! (-> frame sun-color) (-> l sun))
    (linear-color! (-> frame ambient) (-> l ambient))
    (linear-color! (-> frame sky) (-> l sky))
    (vec2! (-> frame fog) (-> l fog-near) (-> l fog-far))
    (vec2! (-> frame heights-size) (-> r heights-width) (-> r heights-height))
    (vec2! (-> frame mist) (-> l mist-height) (-> l mist))
    (gpu-write-copy! (-> r frame-uniforms) 0 (& frame) (sizeof lit-frame))
    (gpu-write-copy! (-> r cascade-uniforms) 0 cascades (* 2 lit-cascade-stride))))

(define (meshes-shadow-maps [r (ptr meshes)]) -> u32 (-> r shadow-maps))

(define (meshes-shadow-pass! [r (ptr meshes)] [cascade u32])
  (gpu-pipeline! (-> r shadow-pipeline))
  (gpu-bind-group-set! 0 (-> r frame-group) 1)
  (gpu-offset! (* cascade lit-cascade-stride))
  (draw-all! r mesh-lit 1)
  (gpu-pipeline! (-> r shadow-cards-pipeline))
  (gpu-bind-group-set! 0 (-> r frame-group) 1)
  (gpu-offset! (* cascade lit-cascade-stride))
  (gpu-bind-group-set! 1 (-> r surface-group) 0)
  (draw-all! r mesh-cards 1))

(define (meshes-pass! [r (ptr meshes)])
  (gpu-pipeline! (-> r lit-pipeline))
  (gpu-bind-group-set! 0 (-> r frame-group) 1)
  (gpu-offset! 0)
  (gpu-bind-group-set! 1 (-> r surface-group) 0)
  (gpu-bind-group-set! 2 (-> r shadow-group) 0)
  (draw-all! r mesh-lit 0)
  (gpu-pipeline! (-> r cards-pipeline))
  (draw-all! r mesh-cards 0)
  (gpu-pipeline! (-> r water-pipeline))
  (draw-all! r mesh-water 0))
