;; Lifecycle: experimental.
;;
;; Meshes drawn by the GPU: the meshes of a 3D scene, each placed in the
;; world as many times as wanted, drawn with painted materials, lit by
;; a sun with shadows and a toon look, and water. scene.sub draws a
;; frame with them; this file keeps the meshes and draws them in the
;; frame's passes.
;;
;; A mesh is a list of textured triangles that the program builds (the
;; game library's voxels.sub and terrain.sub build them): vertices of
;; eleven numbers each, ten floats and a colour: position (x, y, z),
;; normal (x, y, z), texel (u, v), a shade from 0 to 1 (how open the
;; surface is: the ambient light is dimmed where it is closed in), a
;; material, and a colour whose alpha is how much the vertex sways in
;; the wind (0 for not at all); and indexes, three u32 per triangle.
;; The material says what the surface is drawn with (materials.sub):
;; material-none (0) is the atlas, an image the program gives, which
;; the texel is a point of; the others are painted by the GPU, a
;; greyscale the colour multiplies: the tiled ones (grass, rock, bark,
;; planks...) are read at the vertex's place in the world and need no
;; texel, the cards (leaves, blades) are read at the texel, 0 to 1
;; across the card, and are see-through where their alpha is below a
;; half; and material-land is grass that becomes rock where it is
;; steep, dirt where its colour is brown and snow where it is white. A
;; colour in a vertex or a placement is four bytes in the order r, g,
;; b, a, which is not how a #xRRGGBBAA number lies in memory:
;; (mesh-color c sway) turns one into the bytes, with the sway as its
;; alpha. A mesh is drawn wherever it is placed: a list of placements,
;; each a position, a turn about the vertical axis, a scale and a tint;
;; a chunk of a world is placed once, a tree a thousand times. The tint
;; multiplies the grey parts of the mesh (white being the usual), and
;; leaves the coloured parts alone: a tree's crown takes the tint, its
;; bark keeps its brown.
;;
;; Lit by the sun (light.sub): a surface facing the sun is lit, one
;; facing away is in shade, with a sharp edge between, as in a drawn
;; picture rather than a photograph; the shade is lit by the ambient
;; light, more from the sky above than from below; a rim of light
;; outlines shapes against the light; shadows fall from the sun, from
;; two shadow maps drawn each frame, a fine one close to the camera
;; and a coarse one far, and from the clouds; near things hide far
;; ones; back faces are culled, except on cards, which are seen from
;; both sides; and fog fades everything to the horizon's haze by
;; distance, which glows towards the sun, with mist on the low ground
;; if the light has it. A mesh can be water instead: drawn after the
;; others, see-through, with waves of light from the sun, deep where
;; the land below it (a height map the program gives) is far down and
;; pale where it is close, with foam at the edge.
;;
;;   (meshes-init! r atlas)
;;       Makes the GPU resources: the atlas from the image file at
;;       `atlas` (loaded by the host), the materials, the shadow maps,
;;       the shader. Call it once.
;;   (meshes-add! r kind) -> mesh
;;       A new, empty mesh, of a kind: mesh-lit, mesh-cards (drawn from
;;       both sides, see-through where its material's alpha is low) or
;;       mesh-water. Returns its number, from 0.
;;   (meshes-set! r mesh vertices indices)
;;       Gives the mesh its triangles, from two buffers (base.sub's
;;       buffer) of vertices and indexes. The bytes are read when the
;;       frame is handed over (gpu.sub), so the buffers must keep them
;;       until then.
;;   (struct placement [x] [y] [z] [yaw] [scale] [tint])
;;       Where a copy of a mesh goes: f32s, and the tint a colour as
;;       mesh-color gives it (#xffffffff for none), whose alpha says
;;       whether the copy is a small thing (0) or not (1): a small
;;       thing, such as a tuft of grass, gets no outlines, and shrinks
;;       to nothing beyond 40 units, so that a meadow is drawn where it
;;       can be seen and is the ground's colour beyond.
;;   (meshes-casts! r mesh casts)
;;       Whether the mesh casts shadows (1, as made) or not (0): grass
;;       does not, which spares the shadow maps its stubble.
;;   (mesh-color c sway) -> u32
;;       The colour #xRRGGBBAA as a vertex or a placement holds it,
;;       with the sway (0 to 1) in place of its alpha.
;;   (meshes-place! r mesh placements count)
;;       Where the mesh is drawn: `count` placements at the pointer,
;;       which must stay until the frame is handed over. A mesh with no
;;       placements is not drawn.
;;   (meshes-heights! r texture width height)
;;       The height map the water reads the land from: an rgba16float
;;       texture whose first channel is the land's height, with the
;;       world's size in units it covers, from the origin.
;;   material-land material-stone
;;       The land's material, and rock at a fine scale for boulders and
;;       stones (the others are materials.sub's).
;;
;; What scene.sub calls, in order, each frame:
;;
;;   (meshes-frame! r camera light)   fills the frame's uniforms: the
;;                                    camera's matrix, the sun's two,
;;                                    the colours, the time
;;   (meshes-shadow-maps r) -> texture
;;                                    the shadow maps, a depth texture
;;                                    of two layers, for the shadow
;;                                    passes' depth: layer 0 near, 1 far
;;   (meshes-shadow-pass! r cascade)  inside the pass on that layer:
;;                                    draws the meshes that cast
;;                                    shadows into it from the sun
;;   (meshes-pass! r)                 inside the scene pass, whose colour
;;                                    targets are post.sub's: draws the
;;                                    lit meshes, the cards, then the
;;                                    water
;;
;; ---- How it works ----
;;
;; The shader is described once with shader.sub, which lays out its
;; uniform struct and makes the pipelines and bind groups, and written
;; in Shade (lib/shade/core.sub). Five pipelines share it: the two
;; shadow pipelines, for meshes and for cards (whose fragment discards
;; the see-through texels), which write depth into a shadow map as
;; seen from the sun; the lit pipeline and the cards pipeline, which
;; write the frame's colour and its normals (post.sub finds the
;; outlines in them); and the water pipeline, blended over them with
;; the depth kept. A frame is one uniform buffer with the camera's
;; matrix, the sun's, the sun, the colours and the time; the shadow
;; passes read their matrix from a second buffer at an offset each
;; (a uniform-array). Each mesh has a vertex buffer, an index buffer
;; and a buffer of placements on the GPU, replaced by bigger ones when
;; it outgrows them, and is drawn once for all its placements, each
;; vertex read with its placement (instancing). The atlas and the
;; materials are a group; the shadow maps and the height map another,
;; which the shadow passes do not bind: a pass may not read the
;; texture it draws into.
;;
;; Colours: the atlas, the materials and the colours given are in the
;; screen's sRGB; the shader decodes them, lights in linear values, and
;; writes linear values with more range than the screen has, which
;; post.sub maps back. A tiled material is read at the world position,
;; projected along the axis the surface faces most, blended between
;; the three axes where it faces between them (triplanar mapping), so
;; that a cliff and a trunk are covered as well as a floor. Shadows:
;; the two shadow maps are orthographic views from the sun of a box
;; about the camera, 2048 texels across, the near one 56 units across
;; and the far one 240, each moved only by whole texels as the camera
;; moves, so that its edges do not crawl; a fragment's place in each is
;; found in the vertex stage, with the surface pushed a little along
;; its normal first, by a texel and a half, so that a surface does not
;; shadow itself where the map is coarse, and compared with the map at
;; nine texels around it (a comparison sampler does the compare and
;; blends the four texels around a point), which softens the edge,
;; with a bias that grows as the surface turns from the sun. The near
;; map is used where it covers a point, fading into the far one at its
;; edge, and beyond the far map everything is lit. The toon edge: the
;; lit share of a surface is a smooth step of the angle to the sun,
;; then pushed to a dark band and a lit band with a narrow blend
;; between them. Wind: a vertex whose colour's alpha is above 0 is
;; moved sideways by a wave over the world and the time, by that much.
;; Clouds shadow the land: the same noise the sky draws them with, over
;; the world and drifting with time, dims the sun where it is dense.
(require-unqualified base "../../../compiler/base/base.sub")
(require-unqualified gpu "../gpu.sub")
(require-unqualified shader "shader.sub")
(require-unqualified color "../../shade/color.sub")
(require-unqualified noise "../../shade/noise.sub")
(require-unqualified math "math.sub")
(require-unqualified camera "camera.sub")
(require-unqualified light "light.sub")
(require-unqualified materials "materials.sub")

(provide lit-code meshes mesh-lit mesh-water mesh-cards material-land material-stone mesh-color meshes-init! meshes-add! meshes-set! placement
         meshes-place! meshes-casts! meshes-heights!
         meshes-frame! meshes-shadow-maps meshes-shadow-pass! meshes-pass!)

(memory from base)
(table from base)

(define shadow-size u32 2048)
(define near-radius f64 28.0)
(define far-radius f64 120.0)

(define mesh-lit u32 0)
(define mesh-water u32 1)
(define mesh-cards u32 2)

(define material-land u32 13)
;; Rock at a fine scale, for boulders and stones.
(define material-stone u32 14)

(struct placement [x f32] [y f32] [z f32] [yaw f32] [scale f32] [tint u32])

(define (mesh-color [c u32] [sway f64]) -> u32
  (bit-or (>> c 24) (bit-and (>> c 8) #xff00) (bit-and (<< c 8) #xff0000) (<< (cast u32 (* (clamp-unit sway) 255.0)) 24)))

(define (clamp-unit [x f64]) -> f64 (if (< x 0.0) 0.0 (if (> x 1.0) 1.0 x)))

(struct mesh
  [kind u32] [casts u32]
  [vertices u32] [vertex-room u32]   ; the GPU buffer and its size in bytes
  [indices u32] [index-room u32]
  [places u32] [place-room u32]
  [index-count u32] [place-count u32])

(struct meshes
  [items (ptr mesh)] [count u32] [capacity u32]
  [shader lit-shader]
  [paints materials]
  [atlas-sampler u32] [atlas u32] [shadow-sampler u32] [shadow-maps u32] [heights u32] [blank-heights u32]
  [frame-uniforms u32] [cascade-uniforms u32] [frame-group u32] [surface-group u32] [shadow-group u32]
  [shadow-pipeline u32] [shadow-cards-pipeline u32] [lit-pipeline u32] [cards-pipeline u32] [water-pipeline u32]
  [heights-width f64] [heights-height f64])

;; The atlas is visible to the vertex stage too, which asks it for its
;; size.
(shader lit
  [uniform frame 0 0 (vertex fragment)
    [view-projection mat4] [near-cascade mat4] [far-cascade mat4]
    [camera vec3] [time f32]
    [sun vec3] [near-texel f32]
    [sun-color vec4] [ambient vec4] [sky vec4]
    [fog vec2] [heights-size vec2]
    [mist vec2] [far-texel f32] [unused f32]]
  [uniform-array cascade 0 1 (vertex) [view-projection mat4]]
  [sampler atlas-sampler 1 0 (fragment)]
  [texture atlas 1 1 (vertex fragment)]
  [sampler materials-sampler 1 2 (fragment)]
  [texture-array materials 1 3 (fragment)]
  [comparison-sampler shadow-sampler 2 0 (fragment)]
  [depth-texture-array shadow-maps 2 1 (fragment)]
  [texture heights 2 2 (fragment)]
  [vertex-input vertex per-vertex [position vec3] [normal vec3] [texel vec2] [shade f32] [material f32] [color unorm8x4]]
  [vertex-input instance per-instance [place vec3] [yaw f32] [scale f32] [tint unorm8x4]]
  [varyings [world vec3] [normal vec3] [uv vec2] [shade f32] [material f32] [color vec4]
            [near-shadow vec3] [far-shadow vec3] [outline f32]]
  [outputs [color vec4] [normal vec4]]
  [use color]
  [use noise]
  ;; How many units of the world each material spans before it repeats
  ;; (materials.sub's material-scale, the same numbers).
  [define (span [m i32]) -> f32
    (if (== m 1) 3.0 (if (== m 2) 3.0 (if (== m 3) 7.0 (if (== m 4) 2.5 (if (== m 5) 4.0 (if (== m 6) 1.2
        (if (== m 9) 3.0 (if (== m 10) 2.4 (if (== m 11) 3.0 (if (== m 12) 1.8 (if (== m 14) 1.8 1.0)))))))))))]
  ;; The layer a material is painted on: material-stone is rock.
  [define (layer [m i32]) -> i32 (if (== m 14) 3 m)]
  ;; A vertex in the world: scaled, turned about the vertical axis, moved
  ;; to its placement, and swayed by the wind by its colour's alpha; then
  ;; pushed out along its normal by `push`. A small thing (its tint's
  ;; alpha is 0) shrinks to nothing between 32 and 44 units away.
  [define (placed [in vertex] [push f32]) -> vec3
    (let* ([c (cos in.yaw)] [s (sin in.yaw)]
           [away (distance frame.camera in.place)]
           [scale (if (< in.tint.a 0.5) (* in.scale (- 1.0 (smoothstep 32.0 44.0 away))) in.scale)]
           [p (* in.position scale)]
           [world (+ in.place (vec3 (- (* c p.x) (* s p.z)) p.y (+ (* s p.x) (* c p.z))))]
           [wind (* (vec3 (sin (+ (* frame.time 1.7) (* world.x 0.35) (* world.z 0.2))) 0.0
                          (cos (+ (* frame.time 1.3) (* world.z 0.3))))
                    (* in.color.a in.color.a 0.35))])
      (+ world wind (* (turned in) push)))]
  ;; The normal, turned as the vertex is.
  [define (turned [in vertex]) -> vec3
    (let ([c (cos in.yaw)] [s (sin in.yaw)] [n in.normal])
      (vec3 (- (* c n.x) (* s n.z)) n.y (+ (* s n.x) (* c n.z))))]
  ;; A placement's tint on a vertex's colour: the grey parts take it,
  ;; the coloured parts keep their colour.
  [define (tinted [c vec3] [tint vec3]) -> vec3
    (let ([grey (step (+ (abs (- c.r c.g)) (abs (- c.g c.b))) 0.035)])
      (mix c (* c tint) grey))]
  ;; Where a point lies in a shadow map, from its place in the sun's
  ;; view: x and y across the map, z the depth.
  [define (in-map [s vec4]) -> vec3 (vec3 (+ (* s.x 0.5) 0.5) (- 0.5 (* s.y 0.5)) s.z)]
  [vertex (vertex [in vertex]) -> varyings
    (let* ([world (placed in 0.0)]
           ;; The place in each shadow map: pushed along the normal by a
           ;; texel and a half first.
           [near (* frame.near-cascade (vec4 (placed in (* frame.near-texel 1.5)) 1.0))]
           [far (* frame.far-cascade (vec4 (placed in (* frame.far-texel 1.5)) 1.0))])
      (varyings [position (* frame.view-projection (vec4 world 1.0))]
                [world world]
                [normal (turned in)]
                [uv (if (< in.material 0.5) (/ in.texel (vec2 (texture-dimensions atlas))) in.texel)]
                [shade in.shade]
                [material in.material]
                [color (vec4 (tinted in.color.rgb in.tint.rgb) 1.0)]
                [near-shadow (in-map near)]
                [far-shadow (in-map far)]
                [outline in.tint.a]))]
  [vertex (shadow [in vertex]) -> varyings
    (varyings [position (* cascade.view-projection (vec4 (placed in 0.0) 1.0))])]
  ;; Cards in the shadow pass carry their texel, so that the fragment can
  ;; leave out the see-through part.
  [vertex (shadow-card [in vertex]) -> varyings
    (varyings [position (* cascade.view-projection (vec4 (placed in 0.0) 1.0))]
              [uv in.texel]
              [material in.material])]
  [fragment (shadow-fragment [in varyings])
    (when (< (-> (texture-sample materials materials-sampler in.uv (i32 (round in.material))) a) 0.5) (discard))]
  ;; How much of the sun reaches a point, from one shadow map: 0 to 1.
  [define (sunlit-in [p vec3] [layer i32] [bias f32]) -> f32
    (let ([sum 0.0])
      (for ([i -1]) (<= i 1) (+= i 1)
        (for ([j -1]) (<= j 1) (+= j 1)
          (+= sum (texture-sample-compare-level shadow-maps shadow-sampler
                                                (+ p.xy (* (vec2 (f32 i) (f32 j)) (/ 1.0 2048.0))) layer (- p.z bias)))))
      (/ sum 9.0))]
  ;; How much of the sun reaches a point: the near map where it covers
  ;; the point well inside its edge, the far map beyond, blended at the
  ;; edge; outside the far map everything is lit. The bias grows as the
  ;; surface turns from the sun, where a map's texels are stretched over
  ;; it.
  [define (sunlit [in varyings] [facing-sun f32]) -> f32
    (let* ([n in.near-shadow] [f in.far-shadow]
           [slope (+ 1.0 (* 3.0 (- 1.0 (clamp facing-sun 0.0 1.0))))]
           [near-edge (max (abs (- n.x 0.5)) (abs (- n.y 0.5)))]
           [use-near (* (- 1.0 (smoothstep 0.42 0.49 near-edge)) (step n.z 1.0))]
           [far-edge (max (abs (- f.x 0.5)) (abs (- f.y 0.5)))]
           [use-far (* (- 1.0 (smoothstep 0.45 0.5 far-edge)) (step f.z 1.0))]
           [near-lit (if (> use-near 0.0) (sunlit-in n 0 (* 0.0010 slope)) 1.0)]
           [far-lit (if (> use-far 0.0) (sunlit-in f 1 (* 0.0006 slope)) 1.0)])
      (mix (mix 1.0 far-lit use-far) near-lit use-near))]
  ;; The fog between a point and the camera, 0 to 1: by distance, and
  ;; the mist on the low ground; and what it fades to: the haze at the
  ;; sky's horizon (sky.sub), which glows towards the sun.
  [define (fog-at [world vec3]) -> f32
    (let* ([away (distance frame.camera world)]
           [fog (clamp (/ (- away frame.fog.x) (- frame.fog.y frame.fog.x)) 0.0 1.0)]
           [mist (* frame.mist.y (- 1.0 (smoothstep frame.mist.x (+ frame.mist.x 15.0) world.y)) (smoothstep 10.0 90.0 away))])
      (- 1.0 (* (- 1.0 fog) (- 1.0 mist))))]
  [define (haze [world vec3]) -> vec3
    (let ([towards (max (dot (normalize (- world frame.camera)) (normalize frame.sun)) 0.0)])
      (+ (mix frame.sky.rgb (vec3 1.0) 0.3) (* frame.sun-color.rgb (pow towards 8.0) 0.3)))]
  ;; How much the clouds dim the sun at a point of the land: the sky's
  ;; cloud noise over the world, drifting as the sky's does.
  [define (cloud-shade [world vec3]) -> f32
    (- 1.0 (* 0.55 (smoothstep 0.5 0.66 (gradient-fbm (* (+ world.xz (vec2 (* frame.time 1.5) (* frame.time 0.4))) 0.012) 4))))]
  ;; The textures are read with their coordinates' derivatives given,
  ;; found before any branch on the material (WGSL allows plain
  ;; sampling only where every neighbouring fragment samples too): the
  ;; derivatives of the world position, for the tiled materials, and of
  ;; the texel, for the atlas and the cards.
  [struct slopes [wx vec3] [wy vec3] [ux vec2] [uy vec2]]
  ;; A tiled material at a point: projected along the axis the surface
  ;; faces most, blended between the axes.
  [define (tiled [m i32] [world vec3] [n vec3] [d slopes]) -> vec4
    (let* ([s (span m)] [l (layer m)]
           [w (abs n)]
           [weights (/ w (+ w.x w.y w.z))]
           [top (texture-sample-grad materials materials-sampler (/ world.xz s) l (/ d.wx.xz s) (/ d.wy.xz s))]
           [side-x (texture-sample-grad materials materials-sampler (/ world.zy s) l (/ d.wx.zy s) (/ d.wy.zy s))]
           [side-z (texture-sample-grad materials materials-sampler (/ world.xy s) l (/ d.wx.xy s) (/ d.wy.xy s))])
      (+ (* top weights.y) (* side-x weights.x) (* side-z weights.z)))]
  ;; A tiled material on the ground, seen from above.
  [define (flat [m i32] [world vec3] [d slopes]) -> vec4
    (let ([s (span m)])
      (texture-sample-grad materials materials-sampler (/ world.xz s) m (/ d.wx.xz s) (/ d.wy.xz s)))]
  ;; The land: grass, rock where it is steep, dirt where the paint is
  ;; brown, snow where it is white.
  [define (land [in varyings] [n vec3] [d slopes]) -> vec4
    (let* ([c in.color.rgb]
           [dirtness (smoothstep 0.02 0.12 (- c.r c.g))]
           [snowiness (smoothstep 0.8 0.92 (min c.r (min c.g c.b)))]
           [rockiness (smoothstep 0.78 0.55 n.y)]
           [ground (mix (mix (flat 1 in.world d) (flat 2 in.world d) dirtness) (flat 5 in.world d) snowiness)])
      (mix ground (tiled 3 in.world n d) rockiness))]
  ;; The texel of a surface: from the atlas, a tiled material, a card or
  ;; the land.
  [define (surface [in varyings] [n vec3]) -> vec4
    (let ([m (i32 (round in.material))]
          [d (slopes [wx (dpdx in.world)] [wy (dpdy in.world)] [ux (dpdx in.uv)] [uy (dpdy in.uv)])])
      (if (== m 0)
          (texture-sample-grad atlas atlas-sampler in.uv d.ux d.uy)
          (if (== m 13)
              (land in n d)
              (if (or (== m 7) (== m 8))
                  (texture-sample-grad materials materials-sampler in.uv m d.ux d.uy)
                  (tiled m in.world n d)))))]
  [fragment (fragment [in varyings]) -> outputs
    (let* ([n (normalize in.normal)]
           [texel (surface in n)]
           ;; A material's strokes fade with distance, so that a far
           ;; hillside is its plain colour, as a drawn one is.
           [far (smoothstep 30.0 110.0 (distance frame.camera in.world))]
           [detail (mix texel.rgb (vec3 1.0) (* far (step 0.5 in.material)))])
      (when (< texel.a 0.5) (discard))
      (let* ([albedo (linear (* detail in.color.rgb))]
             [towards-sun (normalize frame.sun)]
             [facing-sun (dot n towards-sun)]
             ;; Lit or in shade, with a narrow blend between the two bands;
             ;; the clouds take some of the sun.
             [facing (* (smoothstep -0.1 0.15 facing-sun) (sunlit in facing-sun) (cloud-shade in.world))]
             [light (+ 0.08 (* 0.92 (smoothstep 0.35 0.62 facing)))]
             ;; A rim of light where a lit surface turns away from the camera.
             [v (normalize (- frame.camera in.world))]
             [rim (* (pow (- 1.0 (max (dot n v) 0.0)) 6.0) facing 0.25)]
             ;; The ambient light: the sky's from above, dimmer from below,
             ;; and dimmed where the surface is closed in.
             [hemisphere (+ (* n.y 0.5) 0.5)]
             [ambient (* (mix (* frame.ambient.rgb 0.85) (mix frame.ambient.rgb frame.sky.rgb 0.2) hemisphere) (mix 0.6 1.0 in.shade))]
             [color (+ (* albedo (+ ambient (* frame.sun-color.rgb light 0.85 (mix 0.7 1.0 in.shade))))
                       (* frame.sun-color.rgb rim 0.5))])
        ;; The normal target's alpha says whether the pixel gets outlines.
        (outputs [color (vec4 (mix color (haze in.world) (fog-at in.world)) 1.0)]
                 [normal (vec4 (+ (* n 0.5) 0.5) in.outline)])))]
  ;; The land's height under a point, from the height map.
  [define (land-at [world vec3]) -> f32
    (let* ([size (vec2 (texture-dimensions heights))]
           [at (clamp (vec2i (* (/ world.xz frame.heights-size) size)) (vec2i 0 0) (- (vec2i size) (vec2i 1 1)))])
      (-> (texture-load heights at 0) x))]
  ;; Water: the land's depth below it decides its colour, waves of light
  ;; come from the sun off ripples that move with time, the sky is
  ;; mirrored where it is seen at a low angle, and there is foam where
  ;; the land is just below.
  [fragment (water [in varyings]) -> outputs
    (let* ([depth (max (- in.world.y (land-at in.world)) 0.0)]
           ;; Ripples: waves of noise drifting across each other.
           [drift (vec2 (* frame.time 0.6) (* frame.time 0.35))]
           [ripple (- (+ (noise (+ (* in.world.xz 0.9) drift)) (noise (- (* in.world.xz 1.7) drift)) (* 0.5 (noise (+ (* in.world.xz 3.6) (* drift 1.5))))) 1.25)]
           [n (normalize (vec3 (* ripple 0.22) 1.0 (* (- (noise (+ (* in.world.xz 1.3) (vec2 drift.y (- 0.0 drift.x)))) 0.5) 0.3)))]
           [v (normalize (- frame.camera in.world))]
           [towards-sun (normalize frame.sun)]
           [shallow (linear (vec3 0.35 0.75 0.7))]
           [deep (linear (vec3 0.05 0.2 0.45))]
           [water (mix shallow deep (smoothstep 0.2 3.0 depth))]
           [facing (dot n towards-sun)]
           [light (+ 0.4 (* 0.6 (smoothstep 0.3 0.5 facing)))]
           ;; The sun off the ripples: a sharp glint, and a broad sheen.
           [mirrored (max (dot (reflect (- towards-sun) n) v) 0.0)]
           [glint (+ (* (pow mirrored 64.0) 0.8) (* (pow mirrored 10.0) 0.12))]
           [fresnel (pow (- 1.0 (max (dot n v) 0.0)) 3.0)]
           ;; Foam: a line along the water's edge, and patches that drift
           ;; where the land is just below.
           [foam (max (* 0.7 (- 1.0 (smoothstep 0.0 0.1 depth)))
                      (* (- 1.0 (smoothstep 0.05 0.4 depth)) (smoothstep 0.45 0.6 (noise (+ (* in.world.xz 2.5) (vec2 (* frame.time 0.5) (* frame.time -0.3)))))))]
           [color (+ (* water (+ frame.ambient.rgb (* frame.sun-color.rgb light)))
                     (* frame.sun-color.rgb glint))])
      (set! color (mix color (* (haze in.world) 0.9) (* fresnel 0.5)))
      (set! color (mix color (vec3 0.9) foam))
      (outputs [color (vec4 (mix color (haze in.world) (fog-at in.world)) (mix 0.75 0.95 (smoothstep 0.0 1.5 depth)))]
               [normal (vec4 0.5 1.0 0.5 1.0)]))])

(define vertex-bytes u32 44)

(define (meshes-init! [r (ptr meshes)] [atlas (ptr u8)])
  (memset r 0 (sizeof meshes))
  (lit-init! (& (-> r shader)))
  (materials-init! (& (-> r paints)))
  (set! (-> r atlas-sampler) (gpu-sampler! gpu-nearest gpu-clamp gpu-compare-none))
  (set! (-> r atlas) (gpu-texture-file! atlas))
  (set! (-> r shadow-sampler) (gpu-sampler! gpu-linear gpu-clamp gpu-less))
  (set! (-> r shadow-maps) (gpu-texture! shadow-size shadow-size 2 1 gpu-depth32f (+ gpu-sampled gpu-target)))
  ;; Until the program gives a height map, the land is at height 0.
  (set! (-> r blank-heights) (gpu-texture! 1 1 1 1 gpu-rgba16f gpu-sampled))
  (set! (-> r heights) (-> r blank-heights))
  (set! (-> r heights-width) 1.0)
  (set! (-> r heights-height) 1.0)
  (set! (-> r frame-uniforms) (gpu-buffer! (sizeof lit-frame) gpu-uniform))
  (set! (-> r cascade-uniforms) (gpu-buffer! (* 2 lit-cascade-stride) gpu-uniform))
  (set! (-> r frame-group) (lit-bind-group-0! (& (-> r shader)) (-> r frame-uniforms) (-> r cascade-uniforms)))
  (set! (-> r surface-group)
        (lit-bind-group-1! (& (-> r shader)) (-> r atlas-sampler) (-> r atlas)
                           (materials-sampler (& (-> r paints))) (materials-texture (& (-> r paints)))))
  (shadows! r)
  (let ([settings render-settings])
    (render-settings-init! (& settings))
    (set! (-> settings cull) gpu-cull-back)
    (set! (-> settings depth-compare) gpu-less)
    (set! (-> settings depth-write) 1)
    ;; The shadow pipelines use the frame alone, or the frame and the
    ;; surfaces: never the shadow maps they draw into.
    (set! (-> settings depth-format) gpu-depth32f)
    (set! (-> settings target-count) 0)
    (set! (-> settings groups) 1)
    (set! (-> r shadow-pipeline) (lit-render-pipeline! (& (-> r shader)) "shadow" "" (& settings)))
    (set! (-> settings groups) 2)
    (set! (-> settings cull) gpu-cull-none)
    (set! (-> r shadow-cards-pipeline) (lit-render-pipeline! (& (-> r shader)) "shadow_card" "shadow_fragment" (& settings)))
    ;; The lit pipeline writes post.sub's two targets; the cards' is the
    ;; same seen from both sides; the water's blends over them and
    ;; leaves the depth as it is.
    (set! (-> settings cull) gpu-cull-back)
    (set! (-> settings depth-format) gpu-depth24)
    (set! (-> settings target-count) 2)
    (set! (@ (-> settings targets) 0) gpu-rgba16f)
    (set! (@ (-> settings targets) 1) gpu-rgba8)
    (set! (-> settings groups) 0)
    (set! (-> r lit-pipeline) (lit-render-pipeline! (& (-> r shader)) "vertex" "fragment" (& settings)))
    (set! (-> settings cull) gpu-cull-none)
    (set! (-> r cards-pipeline) (lit-render-pipeline! (& (-> r shader)) "vertex" "fragment" (& settings)))
    (set! (-> settings blend) gpu-blend-alpha)
    (set! (-> settings depth-write) 0)
    (set! (-> r water-pipeline) (lit-render-pipeline! (& (-> r shader)) "vertex" "water" (& settings)))))

;; The bind group of the shadow maps and the height map, made again when
;; the height map changes.
(define (shadows! [r (ptr meshes)])
  (when (!= (-> r shadow-group) 0) (gpu-destroy! gpu-kind-bind-group (-> r shadow-group)))
  (set! (-> r shadow-group)
        (lit-bind-group-2! (& (-> r shader)) (-> r shadow-sampler) (-> r shadow-maps) (-> r heights))))

(define (meshes-heights! [r (ptr meshes)] [texture u32] [width f64] [height f64])
  (set! (-> r heights) texture)
  (set! (-> r heights-width) width)
  (set! (-> r heights-height) height)
  (shadows! r))

(define (meshes-add! [r (ptr meshes)] [kind u32]) -> u32
  (when (== (-> r count) (-> r capacity))
    (set! (-> r capacity) (if (== (-> r capacity) 0) 16 (* 2 (-> r capacity))))
    (set! (-> r items) (cast (ptr mesh) (realloc (-> r items) (* (-> r capacity) (sizeof mesh))))))
  (let ([m (+ (-> r items) (-> r count))])
    (memset m 0 (sizeof mesh))
    (set! (-> m kind) kind)
    (set! (-> m casts) 1)
    (+= (-> r count) 1)
    (- (-> r count) 1)))

(define (meshes-casts! [r (ptr meshes)] [mesh u32] [casts u32])
  (set! (-> (+ (-> r items) mesh) casts) casts))

;; A GPU buffer with room for n bytes: the one there is, or a bigger one
;; in its place.
(define (room! [id (ptr u32)] [room (ptr u32)] [n u32] [usage u32])
  (when (< (@ room) n)
    (when (!= (@ id) 0) (gpu-destroy! gpu-kind-buffer (@ id)))
    (set! (@ room) (if (== (@ room) 0) 4096 (@ room)))
    (while (< (@ room) n) (*= (@ room) 2))
    (set! (@ id) (gpu-buffer! (@ room) usage))))

(define (meshes-set! [r (ptr meshes)] [mesh u32] [vertices (ptr buffer)] [indices (ptr buffer)])
  (let ([m (+ (-> r items) mesh)])
    (set! (-> m index-count) (/ (-> indices length) 4))
    (when (> (-> m index-count) 0)
      (room! (& (-> m vertices)) (& (-> m vertex-room)) (-> vertices length) gpu-vertex)
      (room! (& (-> m indices)) (& (-> m index-room)) (-> indices length) gpu-index)
      (gpu-write-buffer! (-> m vertices) 0 (-> vertices bytes) (-> vertices length))
      (gpu-write-buffer! (-> m indices) 0 (-> indices bytes) (-> indices length)))))

(define (meshes-place! [r (ptr meshes)] [mesh u32] [places (ptr placement)] [count u32])
  (let ([m (+ (-> r items) mesh)])
    (set! (-> m place-count) count)
    (when (> count 0)
      (room! (& (-> m places)) (& (-> m place-room)) (* count (sizeof placement)) gpu-vertex)
      (gpu-write-buffer! (-> m places) 0 places (* count (sizeof placement))))))

;; Draws every mesh of a kind with the pipeline that is set; for a
;; shadow map, only those that cast shadows.
(define (draw-all! [r (ptr meshes)] [kind u32] [shadows i32])
  (for ([i u32 0]) (< i (-> r count)) (+= i 1)
    (let ([m (+ (-> r items) i)])
      (when (and (== (-> m kind) kind) (> (-> m index-count) 0) (> (-> m place-count) 0)
                 (or (not shadows) (!= (-> m casts) 0)))
        (gpu-vertex-buffer! 0 (-> m vertices) 0)
        (gpu-vertex-buffer! 1 (-> m places) 0)
        (gpu-index-buffer! (-> m indices) gpu-u32-indexes 0)
        (gpu-draw-indexed! (-> m index-count) (-> m place-count) 0 0 0)))))

;; The sun's view of a box of `radius` about the shadow centre, into
;; `matrix`: looking at the centre from the sun's side with the box in
;; view, moved only by whole texels of the map, so that the shadows'
;; edges do not crawl as the centre moves.
(define (cascade! [matrix (ptr f32)] [l (ptr light)] [sx f64] [sy f64] [sz f64] [radius f64])
  (let ([view (array f32 16)] [projection (array f32 16)] [texel (/ (* 2.0 radius) (cast f64 shadow-size))])
    (mat4-look! view
                (+ (-> l shadow-x) (* sx radius 2.0)) (+ (-> l shadow-y) (* sy radius 2.0)) (+ (-> l shadow-z) (* sz radius 2.0))
                (-> l shadow-x) (-> l shadow-y) (-> l shadow-z))
    ;; The view's translation, across and up the map, rounded to texels.
    (set! (@ view 12) (cast f32 (* (nearbyint (/ (cast f64 (@ view 12)) texel)) texel)))
    (set! (@ view 13) (cast f32 (* (nearbyint (/ (cast f64 (@ view 13)) texel)) texel)))
    (mat4-orthographic! projection (- 0.0 radius) radius (- 0.0 radius) radius (* radius 0.5) (* radius 3.5))
    (mat4-multiply! matrix projection view)))

(define (meshes-frame! [r (ptr meshes)] [c (ptr camera)] [l (ptr light)])
  (let ([frame lit-frame] [view (array f32 16)] [cascades (array u8 512)]
        [length (sqrt (+ (* (-> l sun-x) (-> l sun-x)) (* (-> l sun-y) (-> l sun-y)) (* (-> l sun-z) (-> l sun-z))))])
    (memset (& frame) 0 (sizeof lit-frame))
    (memset cascades 0 512)
    ;; The camera's matrix.
    (mat4-view! view (-> c x) (-> c y) (-> c z) (-> c yaw) (-> c pitch))
    (mat4-multiply! (-> frame view-projection) (-> c projection) view)
    ;; The sun's two.
    (let ([sx (/ (-> l sun-x) length)] [sy (/ (-> l sun-y) length)] [sz (/ (-> l sun-z) length)])
      (cascade! (-> frame near-cascade) l sx sy sz near-radius)
      (cascade! (-> frame far-cascade) l sx sy sz far-radius)
      (vec3! (-> frame sun) sx sy sz))
    (memcpy (-> (cast (ptr lit-cascade) cascades) view-projection) (-> frame near-cascade) 64)
    (memcpy (-> (cast (ptr lit-cascade) (+ cascades lit-cascade-stride)) view-projection) (-> frame far-cascade) 64)
    (vec3! (-> frame camera) (-> c x) (-> c y) (-> c z))
    (set! (-> frame near-texel) (cast f32 (/ (* 2.0 near-radius) (cast f64 shadow-size))))
    (set! (-> frame far-texel) (cast f32 (/ (* 2.0 far-radius) (cast f64 shadow-size))))
    (set! (-> frame time) (cast f32 (-> l time)))
    (linear-color! (-> frame sun-color) (-> l sun))
    (linear-color! (-> frame ambient) (-> l ambient))
    (linear-color! (-> frame sky) (-> l sky))
    (vec2! (-> frame fog) (-> l fog-near) (-> l fog-far))
    (vec2! (-> frame heights-size) (-> r heights-width) (-> r heights-height))
    (vec2! (-> frame mist) (-> l mist-height) (-> l mist))
    (gpu-write-copy! (-> r frame-uniforms) 0 (& frame) (sizeof lit-frame))
    (gpu-write-copy! (-> r cascade-uniforms) 0 cascades (* 2 lit-cascade-stride))))

(define (meshes-shadow-maps [r (ptr meshes)]) -> u32 (-> r shadow-maps))

(define (meshes-shadow-pass! [r (ptr meshes)] [cascade u32])
  (gpu-pipeline! (-> r shadow-pipeline))
  (gpu-bind-group-set! 0 (-> r frame-group) 1)
  (gpu-offset! (* cascade lit-cascade-stride))
  (draw-all! r mesh-lit 1)
  (gpu-pipeline! (-> r shadow-cards-pipeline))
  (gpu-bind-group-set! 0 (-> r frame-group) 1)
  (gpu-offset! (* cascade lit-cascade-stride))
  (gpu-bind-group-set! 1 (-> r surface-group) 0)
  (draw-all! r mesh-cards 1))

(define (meshes-pass! [r (ptr meshes)])
  (gpu-pipeline! (-> r lit-pipeline))
  (gpu-bind-group-set! 0 (-> r frame-group) 1)
  (gpu-offset! 0)
  (gpu-bind-group-set! 1 (-> r surface-group) 0)
  (gpu-bind-group-set! 2 (-> r shadow-group) 0)
  (draw-all! r mesh-lit 0)
  (gpu-pipeline! (-> r cards-pipeline))
  (draw-all! r mesh-cards 0)
  (gpu-pipeline! (-> r water-pipeline))
  (draw-all! r mesh-water 0))
