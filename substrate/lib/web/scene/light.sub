;; Lifecycle: experimental.
;;
;; The light of a 3D scene: the sun, the ambient light, the sky's
;; colour, the fog, and where shadows fall. The renderers (meshes.sub,
;; sky.sub, post.sub) read it; a game fills it in.
;;
;;   (struct light [sun-x] [sun-y] [sun-z] [sun] [ambient] [sky]
;;                 [fog-near] [fog-far] [time]
;;                 [shadow-x] [shadow-y] [shadow-z] [shadow-radius])
;;       The direction the sunlight comes from (any length); the sun's
;;       colour and the ambient light's (#xRRGGBBAA; the alpha is not
;;       used); the sky's colour, whose haze the fog fades to between
;;       fog-near and fog-far; the time in seconds, which the clouds
;;       drift with; and the part of the world that gets shadows: a
;;       box shadow-radius from its centre each way. The shadow map is
;;       2048 texels across, so a radius of 48 gives it about 20 texels
;;       per unit.
;;   (light-init! l)
;;       Fills in an afternoon: the sun fairly high, warm white,
;;       grey-blue ambient light, a blue sky, a light haze that starts
;;       at 40 and is complete at 160, shadows within 48 of the origin.
(require-unqualified base "../../../compiler/base/base.sub")

(provide light light-init!)

(memory from base)
(table from base)

(struct light
  [sun-x f64] [sun-y f64] [sun-z f64]
  [sun u32] [ambient u32] [sky u32]
  [fog-near f64] [fog-far f64]
  [time f64]
  [shadow-x f64] [shadow-y f64] [shadow-z f64] [shadow-radius f64])

(define (light-init! [l (ptr light)])
  (memset l 0 (sizeof light))
  (set! (-> l sun-x) 0.5)
  (set! (-> l sun-y) 0.65)
  (set! (-> l sun-z) 0.3)
  (set! (-> l sun) #xfff4e0ff)
  (set! (-> l ambient) #x7f8ba6ff)
  (set! (-> l sky) #x8fd3ffff)
  (set! (-> l fog-near) 40.0)
  (set! (-> l fog-far) 160.0)
  (set! (-> l shadow-radius) 48.0))
