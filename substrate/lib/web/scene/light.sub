;; The light of a 3D scene: the sun, the ambient light, the sky, the fog and the shadows.
(require-unqualified substrate "../../../compiler/substrate/substrate.sub")

(provide light light-init!)

(struct light
  [sun-x f64] [sun-y f64] [sun-z f64]
  [sun u32] [ambient u32] [sky u32]
  [fog-near f64] [fog-far f64]
  [mist-height f64] [mist f64]
  [time f64]
  [shadow-x f64] [shadow-y f64] [shadow-z f64] [shadow-radius f64])

(define (light-init! [l (ptr light)])
  (memset l 0 (sizeof light))
  (set! (-> l sun-x) 0.55)
  (set! (-> l sun-y) 0.5)
  (set! (-> l sun-z) 0.35)
  (set! (-> l sun) #xffecc8ff)
  (set! (-> l ambient) #x6e7fa8ff)
  (set! (-> l sky) #x86ccffff)
  (set! (-> l fog-near) 70.0)
  (set! (-> l fog-far) 320.0)
  (set! (-> l shadow-radius) 48.0))
