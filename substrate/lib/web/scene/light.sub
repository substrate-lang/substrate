;; Lifecycle: experimental.
;;
;; The light of a 3D scene: the sun, the ambient light, the sky's
;; colour, the fog, and where shadows fall. The renderers (meshes.sub,
;; sky.sub, post.sub) read it; a game fills it in.
;;
;;   (struct light [sun-x] [sun-y] [sun-z] [sun] [ambient] [sky]
;;                 [fog-near] [fog-far] [mist-height] [mist] [time]
;;                 [shadow-x] [shadow-y] [shadow-z] [shadow-radius])
;;       The direction the sunlight comes from (any length); the sun's
;;       colour and the ambient light's (#xRRGGBBAA; the alpha is not
;;       used); the sky's colour, whose haze the fog fades to between
;;       fog-near and fog-far; mist, a haze lying on the ground below
;;       mist-height, thinning out over the 15 units above it, as
;;       strong as `mist` (0 to 1; 0 for none) at a distance; the time
;;       in seconds, which the clouds drift with; and the part of the
;;       world that gets shadows: a box shadow-radius from its centre
;;       each way. The shadow map is 2048 texels across, so a radius of
;;       48 gives it about 20 texels per unit.
;;   (light-init! l)
;;       Fills in a late afternoon: the sun at 35 degrees, warm, blue-grey
;;       ambient light, a blue sky, a light haze that starts at 70 and is
;;       complete at 320, no mist, shadows within 48 of the origin.
(require-unqualified base "../../../compiler/base/base.sub")

(provide light light-init!)

(memory from base)
(table from base)

(struct light
  [sun-x f64] [sun-y f64] [sun-z f64]
  [sun u32] [ambient u32] [sky u32]
  [fog-near f64] [fog-far f64]
  [mist-height f64] [mist f64]
  [time f64]
  [shadow-x f64] [shadow-y f64] [shadow-z f64] [shadow-radius f64])

(define (light-init! [l (ptr light)])
  (memset l 0 (sizeof light))
  (set! (-> l sun-x) 0.55)
  (set! (-> l sun-y) 0.5)
  (set! (-> l sun-z) 0.35)
  (set! (-> l sun) #xffecc8ff)
  (set! (-> l ambient) #x6e7fa8ff)
  (set! (-> l sky) #x86ccffff)
  (set! (-> l fog-near) 70.0)
  (set! (-> l fog-far) 320.0)
  (set! (-> l shadow-radius) 48.0))
