;; Lifecycle: experimental.
;;
;; Particles: smoke, fireflies, splashes; small things in great numbers
;; that are born, drift and die, moved by the GPU and drawn as soft
;; discs that face the camera. A program places emitters, each a kind
;; of particle at a point with a strength, and the particles see to
;; themselves: a compute shader steps every particle every frame, and
;; respawns the dead ones at their emitter while it is on.
;;
;;   (particles-init! p)
;;       Makes the buffer of particles (16 emitters of 64 each), the
;;       shaders and the pipelines. Once.
;;   (particles-emit! p emitter x y z kind strength)
;;       Emitter 0 to 15 is at (x, y, z), making particles of the kind
;;       (particles-smoke, particles-fireflies, particles-splash) at
;;       \`strength\` times the kind's rate; 0 turns it off, and what it
;;       made fades away. Call it whenever the emitter moves or changes.
;;
;; What scene.sub calls each frame:
;;
;;   (particles-step! p camera light)  fills the uniforms, and writes
;;                                     the compute pass that moves the
;;                                     particles: before the render
;;                                     passes
;;   (particles-pass! p)               inside the scene pass, after the
;;                                     meshes and the water: draws them,
;;                                     blended, with the depth kept
;;
;; The kinds:
;;
;;   particles-smoke      grey puffs that rise, drift with the wind,
;;                        grow and thin out over four seconds: a chimney
;;   particles-fireflies  yellow-green motes that wander slowly about
;;                        the emitter and blink; a meadow at night
;;   particles-splash     drops of water thrown up and falling back,
;;                        gone in half a second: something wading
;;
;; ---- How it works ----
;;
;; A particle is a position, a velocity, an age, a life, a seed and a
;; kind, in a storage buffer, 48 bytes each; emitter e owns particles
;; 64e to 64e + 63. The step shader (Shade, a compute entry point of
;; workgroups of 64) reads its particle's emitter from a uniform array
;; of sixteen: a dead particle (its age past its life) is born again
;; with a chance each frame set by the kind's rate and the emitter's
;; strength, at the emitter with a random velocity from its seed, and
;; a live one is moved by its kind's rules for a frame; the random
;; numbers are hashes of the particle's number and the time, so the
;; GPU needs nothing from the program but the emitters. The draw
;; shader reads the same buffer in the vertex stage (read-only, so a
;; second shader with its own binding) and makes a quad per particle
;; from the camera's right and up axes, sized and coloured by the kind
;; and the age, a dead particle's quad being no size; the fragment is a
;; disc soft at its edge.
(require-unqualified base "../../../compiler/base/base.sub")
(require-unqualified gpu "../gpu.sub")
(require-unqualified shader "shader.sub")
(require-unqualified noise "../../shade/noise.sub")
(require-unqualified math "math.sub")
(require-unqualified camera "camera.sub")
(require-unqualified light "light.sub")

(provide particles particles-init! particles-emit! particles-step! particles-pass!
         particles-smoke particles-fireflies particles-splash)

(memory from base)
(table from base)

(define particles-smoke u32 0)
(define particles-fireflies u32 1)
(define particles-splash u32 2)

(define emitter-count u32 16)
(define slots u32 64)

(struct particles
  [stepper puffs-shader] [drawer motes-shader]
  [buffer u32] [step-uniforms u32] [draw-uniforms u32] [step-group u32] [draw-group u32]
  [step-pipeline u32] [draw-pipeline u32]
  [world puffs-world]   ; the emitters, kept between frames
  [frame u32])

;; The step: a compute entry point.
(shader puffs
  [uniform world 0 0 (compute)
    [time f32] [dt f32] [frame f32] [unused f32]
    [wind vec2] [unused2 vec2]
    [emitters (array vec4 16)]   ; x y z, and the kind
    [strengths (array vec4 16)]] ; the strength, and nothing yet
  [storage particles 0 1 (compute) read-write
    [position vec3] [age f32] [velocity vec3] [life f32] [seed f32] [kind f32] [size f32] [unused f32]]
  [use noise]
  ;; A random number from 0 to 1 for particle i, different each frame
  ;; and for each k.
  [define (random [i u32] [k f32]) -> f32
    (hash (vec2 (+ (f32 i) (* 0.37 k)) (+ world.frame (* 7.0 k))))]
  ;; A particle's birth at its emitter: where, how fast, how long,
  ;; how big, by the kind.
  [define (born! [i u32] [e i32])
    (let* ([at (@ world.emitters e)]
           [kind (i32 at.w)]
           [a (* 6.2831853 (random i 1.0))]
           [r (random i 2.0)])
      (set! (-> (@ particles i) kind) (f32 kind))
      (set! (-> (@ particles i) age) 0.0)
      (set! (-> (@ particles i) seed) (random i 3.0))
      (cond [(== kind 0)
             (set! (-> (@ particles i) position) (+ at.xyz (vec3 (* 0.15 r (cos a)) 0.0 (* 0.15 r (sin a)))))
             (set! (-> (@ particles i) velocity) (vec3 (* 0.25 (cos a)) (+ 1.0 (* 0.5 r)) (* 0.25 (sin a))))
             (set! (-> (@ particles i) life) (+ 4.0 (* 2.5 (random i 4.0))))
             (set! (-> (@ particles i) size) 0.4)]
            [(== kind 1)
             (set! (-> (@ particles i) position) (+ at.xyz (vec3 (* 10.0 (- r 0.5) (cos a)) (* 1.5 (random i 5.0)) (* 10.0 (- r 0.5) (sin a)))))
             (set! (-> (@ particles i) velocity) (vec3 (* 0.3 (cos a)) 0.0 (* 0.3 (sin a))))
             (set! (-> (@ particles i) life) (+ 6.0 (* 6.0 (random i 4.0))))
             (set! (-> (@ particles i) size) 0.12)]
            [else
             (set! (-> (@ particles i) position) (+ at.xyz (vec3 (* 0.3 (cos a)) 0.05 (* 0.3 (sin a)))))
             (set! (-> (@ particles i) velocity) (vec3 (* (+ 0.6 r) (cos a)) (+ 1.6 (* 1.4 r)) (* (+ 0.6 r) (sin a))))
             (set! (-> (@ particles i) life) 0.7)
             (set! (-> (@ particles i) size) 0.035)]))]
  ;; A frame of a particle's life, by its kind.
  [define (move! [i u32])
    (let* ([kind (i32 (-> (@ particles i) kind))] [dt world.dt] [t world.time]
           [seed (-> (@ particles i) seed)]
           [velocity (-> (@ particles i) velocity)])
      (+= (-> (@ particles i) age) dt)
      (cond [(== kind 0)
             ;; Smoke: slows as it rises, drifts with the wind, wobbles.
             (set! velocity (+ (* velocity (- 1.0 (* 0.25 dt)))
                               (* dt (vec3 (+ world.wind.x (* 0.8 (- (noise (vec2 (* t 0.5) (* seed 10.0))) 0.5)))
                                           0.4
                                           (+ world.wind.y (* 0.8 (- (noise (vec2 (* seed 10.0) (* t 0.5))) 0.5)))))))]
            [(== kind 1)
             ;; Fireflies: wander, pulled back towards the emitter.
             (let* ([e (i32 (/ i 64))] [home (@ world.emitters e)]
                    [away (- (-> (@ particles i) position) home.xyz)]
                    [turn (* 2.0 (- (noise (vec2 (* t 0.7) (* seed 20.0))) 0.5))])
               (set! velocity (+ (* velocity 0.98)
                                 (* dt (vec3 (* 0.8 turn) (* 0.5 (- (noise (vec2 (* seed 20.0) (* t 0.9))) 0.5)) (* -0.8 turn)))
                                 (* dt -0.08 away))))]
            [else
             ;; Drops: fall.
             (set! velocity (+ velocity (vec3 0.0 (* -9.0 dt) 0.0)))])
      (set! (-> (@ particles i) velocity) velocity)
      (set! (-> (@ particles i) position) (+ (-> (@ particles i) position) (* velocity dt))))]
  [compute 64 (step [id global-invocation-id])
    (let* ([i id.x] [e (i32 (/ i 64))])
      (when (< i 1024)
        (let* ([strength (-> (@ world.strengths e) x)]
               [kind (i32 (-> (@ world.emitters e) w))]
               [rate (if (== kind 0) 0.2 (if (== kind 1) 0.25 1.2))])
          (if (>= (-> (@ particles i) age) (-> (@ particles i) life))
              (when (and (> strength 0.0) (< (random i 0.0) (* rate strength world.dt 10.0)))
                (born! i e))
              (move! i)))))])

;; The drawing: a quad per particle from the camera's axes.
(shader motes
  [uniform view 0 0 (vertex fragment)
    [view-projection mat4]
    [right vec3] [time f32]
    [up vec3] [unused f32]
    [sun-color vec4]]
  [storage particles 0 1 (vertex) read
    [position vec3] [age f32] [velocity vec3] [life f32] [seed f32] [kind f32] [size f32] [unused f32]]
  [builtins vertex-index instance-index]
  [varyings [uv vec2] [color vec4]]
  [outputs [color vec4] [normal vec4]]
  [vertex (vertex [in vertex]) -> varyings
    (let* ([p (@ particles in.instance-index)]
           [corner (if (== in.vertex-index 0) (vec2 0.0 0.0)
                       (if (== in.vertex-index 1) (vec2 1.0 0.0)
                           (if (== in.vertex-index 2) (vec2 1.0 1.0)
                               (if (== in.vertex-index 3) (vec2 0.0 0.0)
                                   (if (== in.vertex-index 4) (vec2 1.0 1.0) (vec2 0.0 1.0))))))]
           [alive (if (< (-> p age) (-> p life)) 1.0 0.0)]
           [kind (i32 (-> p kind))]
           [t (/ (-> p age) (max (-> p life) 0.001))]
           ;; The size and the colour by kind and age.
           [size (* alive (if (== kind 0) (* (-> p size) (+ 0.5 (* 3.0 t)))
                              (if (== kind 1) (-> p size) (-> p size))))]
           [alpha (if (== kind 0) (* 0.75 (smoothstep 0.0 0.1 t) (- 1.0 (smoothstep 0.35 1.0 t)))
                      (if (== kind 1) (* (smoothstep 0.0 0.1 t) (- 1.0 (smoothstep 0.9 1.0 t))
                                         (smoothstep 0.2 0.9 (sin (+ (* view.time 4.0) (* (-> p seed) 20.0)))))
                          (- 0.9 (* 0.6 t))))]
           [color (if (== kind 0) (vec3 0.42 0.42 0.46)
                      (if (== kind 1) (vec3 3.0 3.4 0.9) (vec3 0.85 0.95 1.0)))]
           [world (+ (-> p position) (* view.right (- (* 2.0 corner.x) 1.0) size) (* view.up (- (* 2.0 corner.y) 1.0) size))])
      (varyings [position (* view.view-projection (vec4 world 1.0))]
                [uv corner]
                [color (vec4 color alpha)]))]
  [fragment (fragment [in varyings]) -> outputs
    (let* ([d (* 2.0 (length (- in.uv (vec2 0.5 0.5))))]
           ;; A disc soft at its edge; a firefly is a bright point in a
           ;; wider glow.
           [soft (- 1.0 (smoothstep 0.55 1.0 d))]
           [glow (if (> in.color.g 2.0) (+ (* 0.25 (- 1.0 (smoothstep 0.0 1.0 d))) (- 1.0 (smoothstep 0.0 0.35 d))) soft)])
      (outputs [color (vec4 in.color.rgb (* in.color.a glow))]
               [normal (vec4 0.5 1.0 0.5 0.0)]))])

(define (particles-init! [p (ptr particles)])
  (memset p 0 (sizeof particles))
  (puffs-init! (& (-> p stepper)))
  (motes-init! (& (-> p drawer)))
  (set! (-> p buffer) (gpu-buffer! (* emitter-count slots puffs-particles-stride) gpu-storage))
  (set! (-> p step-uniforms) (gpu-buffer! (sizeof puffs-world) gpu-uniform))
  (set! (-> p draw-uniforms) (gpu-buffer! (sizeof motes-view) gpu-uniform))
  (set! (-> p step-group) (puffs-bind-group-0! (& (-> p stepper)) (-> p step-uniforms) (-> p buffer)))
  (set! (-> p draw-group) (motes-bind-group-0! (& (-> p drawer)) (-> p draw-uniforms) (-> p buffer)))
  (set! (-> p step-pipeline) (puffs-compute-pipeline! (& (-> p stepper)) "step"))
  (let ([settings render-settings])
    (render-settings-init! (& settings))
    (set! (-> settings target-count) 2)
    (set! (@ (-> settings targets) 0) gpu-rgba16f)
    (set! (@ (-> settings targets) 1) gpu-rgba8)
    (set! (-> settings depth-format) gpu-depth24)
    (set! (-> settings depth-compare) gpu-less)
    (set! (-> settings depth-write) 0)
    (set! (-> settings blend) gpu-blend-alpha)
    (set! (-> settings cull) gpu-cull-none)
    (set! (-> p draw-pipeline) (motes-render-pipeline! (& (-> p drawer)) "vertex" "fragment" (& settings))))
  (memset (& (-> p world)) 0 (sizeof puffs-world))
  (set! (-> p world dt) (cast f32 (/ 1.0 60.0))))

(define (particles-emit! [p (ptr particles)] [emitter u32] [x f64] [y f64] [z f64] [kind u32] [strength f64])
  (when (< emitter emitter-count)
    (let ([e (-> p world emitters)] [s (-> p world strengths)])
      (set! (@ e (* emitter 4)) (cast f32 x))
      (set! (@ e (+ (* emitter 4) 1)) (cast f32 y))
      (set! (@ e (+ (* emitter 4) 2)) (cast f32 z))
      (set! (@ e (+ (* emitter 4) 3)) (cast f32 kind))
      (set! (@ s (* emitter 4)) (cast f32 strength)))))

(define (particles-step! [p (ptr particles)] [c (ptr camera)] [l (ptr light)])
  (+= (-> p frame) 1)
  (set! (-> p world time) (cast f32 (-> l time)))
  (set! (-> p world frame) (cast f32 (% (-> p frame) 100000)))
  (vec2! (-> p world wind) 0.25 0.1)
  (gpu-write-copy! (-> p step-uniforms) 0 (& (-> p world)) (sizeof puffs-world))
  (let ([v motes-view] [right (array f32 3)] [up (array f32 3)] [forward (array f32 3)] [view (array f32 16)])
    (memset (& v) 0 (sizeof motes-view))
    (mat4-view! view (-> c x) (-> c y) (-> c z) (-> c yaw) (-> c pitch))
    (mat4-multiply! (-> v view-projection) (-> c projection) view)
    (camera-axes! c right up forward)
    (vec3! (-> v right) (cast f64 (@ right 0)) (cast f64 (@ right 1)) (cast f64 (@ right 2)))
    (vec3! (-> v up) (cast f64 (@ up 0)) (cast f64 (@ up 1)) (cast f64 (@ up 2)))
    (set! (-> v time) (cast f32 (-> l time)))
    (linear-color! (-> v sun-color) (-> l sun))
    (gpu-write-copy! (-> p draw-uniforms) 0 (& v) (sizeof motes-view)))
  (gpu-compute-pass!)
  (gpu-pipeline! (-> p step-pipeline))
  (gpu-bind-group-set! 0 (-> p step-group) 0)
  (gpu-dispatch! (/ (* emitter-count slots) 64) 1 1)
  (gpu-end-pass!))

(define (particles-pass! [p (ptr particles)])
  (gpu-pipeline! (-> p draw-pipeline))
  (gpu-bind-group-set! 0 (-> p draw-group) 0)
  (gpu-draw! 6 (* emitter-count slots) 0 0))
