;; Lifecycle: experimental.
;;
;; The camera of a 3D scene: where it is, how it is turned, and what it
;; sees. The renderers (meshes.sub, sky.sub, post.sub) read it; a game
;; fills it in.
;;
;;   (struct camera [x] [y] [z] [yaw] [pitch] [near] [far] [projection])
;;       The position; the yaw and the pitch, in radians, as math.sub's
;;       mat4-view! counts them (a yaw of 0 looks along +z, a positive
;;       yaw turns left, a positive pitch looks up); the distances
;;       between which things are seen; and the projection matrix.
;;   (camera-perspective! c fov aspect near far)
;;       Sets the projection: a vertical field of view in radians, on a
;;       screen `aspect` times as wide as high.
;;   (camera-axes! c right up forward)
;;       Writes the camera's three axes, each three f32, where the
;;       shaders want them.
;;   (camera-half-width c) (camera-half-height c)
;;       How far the view reaches to the side, and up, at a distance of
;;       1: the tangents of the half angles.
(require-unqualified base "../../../compiler/base/base.sub")
(require-unqualified math "math.sub")

(provide camera camera-perspective! camera-axes! camera-half-width camera-half-height)

(memory from base)
(table from base)

(struct camera [x f64] [y f64] [z f64] [yaw f64] [pitch f64] [near f64] [far f64] [projection (array f32 16)])

(define (camera-perspective! [c (ptr camera)] [fov f64] [aspect f64] [near f64] [far f64])
  (set! (-> c near) near)
  (set! (-> c far) far)
  (mat4-perspective! (-> c projection) fov aspect near far))

;; The axes, as mat4-view! has them: forward from the yaw and the pitch,
;; right from the yaw alone, up across the two.
(define (camera-axes! [c (ptr camera)] [right (ptr f32)] [up (ptr f32)] [forward (ptr f32)])
  (let* ([fx (* (sin (-> c yaw)) (cos (-> c pitch)))] [fy (sin (-> c pitch))] [fz (* (cos (-> c yaw)) (cos (-> c pitch)))]
         [rx (- 0.0 (cos (-> c yaw)))] [rz (sin (-> c yaw))])
    (set! (@ right 0) (cast f32 rx))
    (set! (@ right 1) 0.0)
    (set! (@ right 2) (cast f32 rz))
    (set! (@ up 0) (cast f32 (- 0.0 (* rz fy))))
    (set! (@ up 1) (cast f32 (- (* rz fx) (* rx fz))))
    (set! (@ up 2) (cast f32 (* rx fy)))
    (set! (@ forward 0) (cast f32 fx))
    (set! (@ forward 1) (cast f32 fy))
    (set! (@ forward 2) (cast f32 fz))))

;; From the projection: its (1, 1) element is 1 over the tangent of the
;; half angle, and its (0, 0) element that over the aspect.
(define (camera-half-width [c (ptr camera)]) -> f64 (/ 1.0 (cast f64 (@ (-> c projection) 0))))
(define (camera-half-height [c (ptr camera)]) -> f64 (/ 1.0 (cast f64 (@ (-> c projection) 5))))
