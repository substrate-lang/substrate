;; Models and figures: things made of parts that move on joints.
(require-unqualified vector "../game/vector.sub")
(require-unqualified math "math.sub")
(require-unqualified meshes "meshes.sub")

(provide model model-add! model-count define-model part figure joint figure-init! figure-free! figure-joint figure-pose! figure-turn!
         figure-rest! figure-submit! figure-part-position figure-part-matrix swing! walk! bob look-at! ease-joint!)

(struct part [mesh u32] [parent i32] [jx f64] [jy f64] [jz f64] [yaw f64] [pitch f64] [roll f64])

(struct model [parts (vector part)])

;; A part's mesh is built with its joint at its origin, and a parent comes before its children.
(define (model-add! [m (ptr model)] [mesh u32] [parent i32] [jx f64] [jy f64] [jz f64] [yaw f64] [pitch f64] [roll f64]) -> u32
  (let ([p (vector-add! (& (-> m parts)))])
    (set! (-> p mesh) mesh)
    (set! (-> p parent) parent)
    (set! (-> p jx) jx)
    (set! (-> p jy) jy)
    (set! (-> p jz) jz)
    (set! (-> p yaw) yaw)
    (set! (-> p pitch) pitch)
    (set! (-> p roll) roll)
    (- (vector-count (& (-> m parts))) 1)))

(define (model-count [m (ptr model)]) -> u32 (vector-count (& (-> m parts))))

(struct joint [yaw f64] [pitch f64] [roll f64])

(struct figure
  [model (ptr model)]
  [x f64] [y f64] [z f64] [yaw f64] [pitch f64] [roll f64] [scale f64]
  [joints (vector joint)]
  [placed (vector placement)])

(define (figure-init! [f (ptr figure)] [m (ptr model)])
  (memset f 0 (sizeof figure))
  (set! (-> f model) m)
  (set! (-> f scale) 1.0)
  (for ([i u32 0]) (< i (model-count m)) (+= i 1)
    (vector-add! (& (-> f joints)))
    (vector-add! (& (-> f placed)))))

(define (figure-free! [f (ptr figure)])
  (vector-free! (& (-> f joints)))
  (vector-free! (& (-> f placed))))

(define (figure-joint [f (ptr figure)] [part u32]) -> (ptr joint) (vector-at (& (-> f joints)) part))

(define (figure-pose! [f (ptr figure)] [part u32] [yaw f64] [pitch f64] [roll f64])
  (let ([j (figure-joint f part)])
    (set! (-> j yaw) yaw)
    (set! (-> j pitch) pitch)
    (set! (-> j roll) roll)))

(define (figure-turn! [f (ptr figure)] [part u32] [yaw f64] [pitch f64] [roll f64])
  (let ([j (figure-joint f part)])
    (+= (-> j yaw) yaw)
    (+= (-> j pitch) pitch)
    (+= (-> j roll) roll)))

(define (figure-rest! [f (ptr figure)])
  (vector-each ([j (& (-> f joints))])
    (set! (-> j yaw) 0.0)
    (set! (-> j pitch) 0.0)
    (set! (-> j roll) 0.0)))

(define (figure-part-matrix [f (ptr figure)] [part u32]) -> (ptr f32)
  (-> (vector-at (& (-> f placed)) part) m))

(define (figure-part-position [f (ptr figure)] [part u32] [out (ptr f64)])
  (let ([m (figure-part-matrix f part)])
    (set! (@ out 0) (cast f64 (@ m 3)))
    (set! (@ out 1) (cast f64 (@ m 7)))
    (set! (@ out 2) (cast f64 (@ m 11)))))

(define (figure-submit! [f (ptr figure)] [r (ptr meshes)] [tint u32])
  (let ([root (array f32 12)] [local (array f32 12)] [rest (array f32 12)] [turn (array f32 12)]
        [parts (& (-> (-> f model) parts))])
    (mat34-pose! root (-> f x) (-> f y) (-> f z) (-> f yaw) (-> f pitch) (-> f roll) (-> f scale))
    (vector-each ([p i parts])
      (let* ([j (vector-at-unchecked (& (-> f joints)) i)]
             [placed (vector-at-unchecked (& (-> f placed)) i)]
             [parent (ptr f32) (if (< (-> p parent) 0)
                                   (cast (ptr f32) root)
                                   (cast (ptr f32) (-> (vector-at-unchecked (& (-> f placed)) (cast u32 (-> p parent))) m)))])
        (mat34-pose! rest (-> p jx) (-> p jy) (-> p jz) (-> p yaw) (-> p pitch) (-> p roll) 1.0)
        (mat34-pose! turn 0.0 0.0 0.0 (-> j yaw) (-> j pitch) (-> j roll) 1.0)
        (mat34-multiply! local rest turn)
        (mat34-multiply! (-> placed m) parent local)
        (set! (-> placed tint) tint)
        (meshes-submit! r (-> p mesh) placed)))))

(define (swing! [f (ptr figure)] [part u32] [phase f64] [amount f64])
  (set! (-> (figure-joint f part) pitch) (* amount (sin phase))))

(define (walk! [f (ptr figure)] [hip u32] [knee u32] [phase f64] [swing f64] [bend f64])
  (set! (-> (figure-joint f hip) pitch) (* swing (sin phase)))
  (let ([lift (cos phase)])
    (set! (-> (figure-joint f knee) pitch) (* (- 0.0 bend) (if (> lift 0.0) lift 0.0)))))

(define (bob [phase f64] [amount f64]) -> f64
  (let ([c (cos phase)]) (* amount c c)))

(begin-for-syntax
  (require-unqualified kd "../../../compiler/kernel.sub")

  (define (derived [name datum] [rest datum]) -> datum
    (datum->syntax name (symbol-append (syntax-e name) (string->symbol rest)) name))

  (define (define-model-form [stx datum]) -> datum
    (syntax-match stx
      [(_ (? identifier? name) (parameter ...) clause ...)
       (let ([names nil] [definitions nil] [adds nil] [index 0])
         (let ([cl clause])
           (while (pair? cl)
             (let ([l (syntax->list (car cl))])
               (unless (and (!= l 0) (== (length l) 5) (identifier? (car l)) (identifier? (caddr l)))
                 (raise-syntax-error 'define-model '"expected [part mesh parent (x y z) (yaw pitch roll)]" (car cl)))
               (let* ([part (syntax-e (car l))]
                      [mesh (cadr l)]
                      [parent-name (syntax-e (caddr l))]
                      [joint (syntax->list (cadddr l))]
                      [rest (syntax->list (car (cdr (cdddr l))))]
                      [parent -1] [k 0] [n names])
                 (unless (and (!= joint 0) (== (length joint) 3)) (raise-syntax-error 'define-model '"expected the joint as (x y z)" (cadddr l)))
                 (unless (and (!= rest 0) (== (length rest) 3)) (raise-syntax-error 'define-model '"expected the rest as (yaw pitch roll)" (car (cdr (cdddr l)))))
                 (unless (== parent-name '-)
                   (set! k 0)
                   (set! n (reverse names))
                   (while (pair? n)
                     (when (== (car n) parent-name) (set! parent k))
                     (set! k (+ k 1))
                     (set! n (cdr n)))
                   (when (< parent 0) (raise-syntax-error 'define-model '"the parent is not an earlier part of the model" (caddr l))))
                 (set! definitions (cons #`(define #,(datum->syntax name (symbol-append (symbol-append (syntax-e name) '-) part) name) u32 #,(datum->syntax name (make-integer index) 0)) definitions))
                 (set! adds (cons #`(model-add! m #,mesh #,(datum->syntax name (make-integer parent) 0)
                                                #,(car joint) #,(cadr joint) #,(caddr joint) #,(car rest) #,(cadr rest) #,(caddr rest))
                                  adds))
                 (set! names (cons part names))
                 (set! index (+ index 1))))
             (set! cl (cdr cl))))
         #`(begin
             #,@(reverse definitions)
             (define #,(derived name '"-part-count") u32 #,(datum->syntax name (make-integer index) 0))
             (define (#,(derived name '"-model!") [m (ptr model)] #,@parameter)
               (memset m 0 (sizeof model))
               #,@(reverse adds))))]
      [_ (raise-syntax-error 'define-model '"expected (define-model name (parameter ...) [part mesh parent (x y z) (yaw pitch roll)] ...)" stx)])))

(define-syntax define-model define-model-form)

;; It uses the matrices of the last submit, so it is a frame behind, which no one sees.
(define (look-at! [f (ptr figure)] [part u32] [x f64] [y f64] [z f64] [limit f64])
  (let* ([part-info (vector-at (& (-> (-> f model) parts)) part)]
         [parent (ptr f32) (if (< (-> part-info parent) 0) 0 (figure-part-matrix f (cast u32 (-> part-info parent))))]
         [here (array f64 3)])
    (figure-part-position f part here)
    (let* ([dx (- x (@ here 0))] [dy (- y (@ here 1))] [dz (- z (@ here 2))]
           [rest-yaw (if (== parent 0) (+ (-> f yaw) (-> part-info yaw)) (+ (mat34-yaw parent) (-> part-info yaw)))]
           [rest-pitch (if (== parent 0) (+ (-> f pitch) (-> part-info pitch)) (+ (mat34-pitch parent) (-> part-info pitch)))]
           [want-yaw (angle-between rest-yaw (atan2 dx dz))]
           [want-pitch (angle-between rest-pitch (atan2 dy (sqrt (+ (* dx dx) (* dz dz)))))]
           [j (figure-joint f part)])
      (set! (-> j yaw) (clamp want-yaw (- 0.0 limit) limit))
      (set! (-> j pitch) (clamp want-pitch (- 0.0 limit) limit)))))

(define (ease-joint! [f (ptr figure)] [part u32] [yaw f64] [pitch f64] [roll f64] [rate f64])
  (let ([j (figure-joint f part)])
    (+= (-> j yaw) (* rate (- yaw (-> j yaw))))
    (+= (-> j pitch) (* rate (- pitch (-> j pitch))))
    (+= (-> j roll) (* rate (- roll (-> j roll))))))
