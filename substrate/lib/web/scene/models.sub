;; Lifecycle: experimental.
;;
;; Models and figures: things made of parts that move on joints. A
;; model says what a kind of thing is made of: its parts, each a mesh
;; of the scene (meshes.sub) hanging from a parent part at a joint. A
;; figure is one such thing in the world: its model, where it stands,
;; and how much each joint is turned, which is its pose. A creature is
;; a model, and every creature of the kind is a figure of it; a lantern
;; on a post is a model of two parts; a boulder is a model of one. A
;; figure is drawn by submitting its parts' placements, composed from
;; the joints, parent down to child (meshes-submit!).
;;
;;   (struct model [parts (vector part)])
;;       A model whose bytes are all zero is an empty model.
;;   (model-add! m mesh parent jx jy jz yaw pitch roll) -> part
;;       A part: its mesh, the part it hangs from (-1 for the figure
;;       itself; parents come before their children), its joint, where
;;       it hangs in the parent's own frame, and its rest, how it is
;;       turned there when the joint is not. Returns the part's number,
;;       from 0. A mesh is built with its joint at its origin: a leg's
;;       mesh hangs down from (0, 0, 0), and the part's joint says where
;;       on the body that is.
;;   (model-count m)
;;
;;   (struct figure [model] [x] [y] [z] [yaw] [pitch] [roll] [scale]
;;                  [joints (vector joint)] [placed (vector placement)])
;;       The figure's root pose, and a joint per part, (struct joint
;;       [yaw] [pitch] [roll]): how far the part is turned from its rest
;;       about its joint. The placements composed last time are kept,
;;       for whoever wants to know where a part ended up.
;;   (figure-init! f model)
;;       A figure of the model, at the origin, its joints at rest.
;;   (figure-free! f)
;;   (figure-joint f part) -> (ptr joint)
;;   (figure-pose! f part yaw pitch roll)   sets a joint
;;   (figure-turn! f part yaw pitch roll)   adds to one
;;   (figure-rest! f)                       every joint back to 0
;;   (figure-submit! f meshes tint)
;;       Composes the parts' placements and submits them for the next
;;       frame, all with the tint.
;;   (figure-part-position f part out)
;;       Where the part's joint was when it was last submitted, three
;;       f64 into `out`.
;;   (figure-part-matrix f part) -> (ptr f32)
;;       The part's placement matrix from the last submit.
;;
;; Animation. A pose is made every frame from the figure's state; these
;; help:
;;
;;   (swing! f part phase amount)
;;       The joint's pitch is amount * sin(phase): a leg's stride, a
;;       wing's beat; call it for each leg with the phases a gait has
;;       (opposite legs half a turn apart).
;;   (look-at! f part x y z limit)
;;       Turns the part's joint so that its forward direction, +z in
;;       its rest, points at (x, y, z), within `limit` radians of its
;;       rest each way: a head that watches something. Uses the
;;       matrices of the last submit, so it is a frame behind, which no
;;       one sees.
;;   (ease-joint! f part yaw pitch roll rate)
;;       Moves the joint a share `rate` (0 to 1) of the way to those
;;       angles: a pose settling into another.
;;
;; ---- How it works ----
;;
;; A part's placement is its parent's placement times its own: a move
;; to the joint, the rest turn, then the joint's turn, as 3 by 4
;; matrices (math.sub); the figure's root is a pose with a scale. Since
;; parents come before children in the model, one pass over the parts
;; composes them all.
(require-unqualified base "../../../compiler/base/base.sub")
(require-unqualified vector "../game/vector.sub")
(require-unqualified math "math.sub")
(require-unqualified meshes "meshes.sub")

(provide model model-add! model-count part figure joint figure-init! figure-free! figure-joint figure-pose! figure-turn!
         figure-rest! figure-submit! figure-part-position figure-part-matrix swing! look-at! ease-joint!)

(memory from base)
(table from base)

(struct part [mesh u32] [parent i32] [jx f64] [jy f64] [jz f64] [yaw f64] [pitch f64] [roll f64])

(struct model [parts (vector part)])

(define (model-add! [m (ptr model)] [mesh u32] [parent i32] [jx f64] [jy f64] [jz f64] [yaw f64] [pitch f64] [roll f64]) -> u32
  (let ([p (vector-add! (& (-> m parts)))])
    (set! (-> p mesh) mesh)
    (set! (-> p parent) parent)
    (set! (-> p jx) jx)
    (set! (-> p jy) jy)
    (set! (-> p jz) jz)
    (set! (-> p yaw) yaw)
    (set! (-> p pitch) pitch)
    (set! (-> p roll) roll)
    (- (vector-count (& (-> m parts))) 1)))

(define (model-count [m (ptr model)]) -> u32 (vector-count (& (-> m parts))))

(struct joint [yaw f64] [pitch f64] [roll f64])

(struct figure
  [model (ptr model)]
  [x f64] [y f64] [z f64] [yaw f64] [pitch f64] [roll f64] [scale f64]
  [joints (vector joint)]
  [placed (vector placement)])

(define (figure-init! [f (ptr figure)] [m (ptr model)])
  (memset f 0 (sizeof figure))
  (set! (-> f model) m)
  (set! (-> f scale) 1.0)
  (for ([i u32 0]) (< i (model-count m)) (+= i 1)
    (vector-add! (& (-> f joints)))
    (vector-add! (& (-> f placed)))))

(define (figure-free! [f (ptr figure)])
  (vector-free! (& (-> f joints)))
  (vector-free! (& (-> f placed))))

(define (figure-joint [f (ptr figure)] [part u32]) -> (ptr joint) (vector-at (& (-> f joints)) part))

(define (figure-pose! [f (ptr figure)] [part u32] [yaw f64] [pitch f64] [roll f64])
  (let ([j (figure-joint f part)])
    (set! (-> j yaw) yaw)
    (set! (-> j pitch) pitch)
    (set! (-> j roll) roll)))

(define (figure-turn! [f (ptr figure)] [part u32] [yaw f64] [pitch f64] [roll f64])
  (let ([j (figure-joint f part)])
    (+= (-> j yaw) yaw)
    (+= (-> j pitch) pitch)
    (+= (-> j roll) roll)))

(define (figure-rest! [f (ptr figure)])
  (vector-each ([j (& (-> f joints))])
    (set! (-> j yaw) 0.0)
    (set! (-> j pitch) 0.0)
    (set! (-> j roll) 0.0)))

(define (figure-part-matrix [f (ptr figure)] [part u32]) -> (ptr f32)
  (-> (vector-at (& (-> f placed)) part) m))

(define (figure-part-position [f (ptr figure)] [part u32] [out (ptr f64)])
  (let ([m (figure-part-matrix f part)])
    (set! (@ out 0) (cast f64 (@ m 3)))
    (set! (@ out 1) (cast f64 (@ m 7)))
    (set! (@ out 2) (cast f64 (@ m 11)))))

(define (figure-submit! [f (ptr figure)] [r (ptr meshes)] [tint u32])
  (let ([root (array f32 12)] [local (array f32 12)] [rest (array f32 12)] [turn (array f32 12)]
        [parts (& (-> (-> f model) parts))])
    (mat34-pose! root (-> f x) (-> f y) (-> f z) (-> f yaw) (-> f pitch) (-> f roll) (-> f scale))
    (vector-each ([p i parts])
      (let* ([j (vector-at-unchecked (& (-> f joints)) i)]
             [placed (vector-at-unchecked (& (-> f placed)) i)]
             [parent (ptr f32) (if (< (-> p parent) 0)
                                   (cast (ptr f32) root)
                                   (cast (ptr f32) (-> (vector-at-unchecked (& (-> f placed)) (cast u32 (-> p parent))) m)))])
        ;; local = move to the joint, then the rest turn, then the
        ;; joint's turn.
        (mat34-pose! rest (-> p jx) (-> p jy) (-> p jz) (-> p yaw) (-> p pitch) (-> p roll) 1.0)
        (mat34-pose! turn 0.0 0.0 0.0 (-> j yaw) (-> j pitch) (-> j roll) 1.0)
        (mat34-multiply! local rest turn)
        (mat34-multiply! (-> placed m) parent local)
        (set! (-> placed tint) tint)
        (meshes-submit! r (-> p mesh) placed)))))

(define (swing! [f (ptr figure)] [part u32] [phase f64] [amount f64])
  (set! (-> (figure-joint f part) pitch) (* amount (sin phase))))

(define (look-at! [f (ptr figure)] [part u32] [x f64] [y f64] [z f64] [limit f64])
  (let* ([part-info (vector-at (& (-> (-> f model) parts)) part)]
         ;; The frame the joint turns in: the parent's placement with the
         ;; rest turn, which is where the part would be at rest.
         [parent (ptr f32) (if (< (-> part-info parent) 0) 0 (figure-part-matrix f (cast u32 (-> part-info parent))))]
         [here (array f64 3)])
    (figure-part-position f part here)
    ;; The direction to the target, in the world; then its yaw and pitch
    ;; relative to the rest frame's forward.
    (let* ([dx (- x (@ here 0))] [dy (- y (@ here 1))] [dz (- z (@ here 2))]
           [rest-yaw (if (== parent 0) (+ (-> f yaw) (-> part-info yaw)) (+ (mat34-yaw parent) (-> part-info yaw)))]
           [rest-pitch (if (== parent 0) (+ (-> f pitch) (-> part-info pitch)) (+ (mat34-pitch parent) (-> part-info pitch)))]
           [want-yaw (angle-between rest-yaw (atan2 dx dz))]
           [want-pitch (angle-between rest-pitch (atan2 dy (sqrt (+ (* dx dx) (* dz dz)))))]
           [j (figure-joint f part)])
      (set! (-> j yaw) (clamp want-yaw (- 0.0 limit) limit))
      (set! (-> j pitch) (clamp want-pitch (- 0.0 limit) limit)))))

(define (ease-joint! [f (ptr figure)] [part u32] [yaw f64] [pitch f64] [roll f64] [rate f64])
  (let ([j (figure-joint f part)])
    (+= (-> j yaw) (* rate (- yaw (-> j yaw))))
    (+= (-> j pitch) (* rate (- pitch (-> j pitch))))
    (+= (-> j roll) (* rate (- roll (-> j roll))))))
