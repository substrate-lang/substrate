;; A 3D scene drawn by the GPU: meshes lit by a sun, under a sky, made into a picture.
(require-unqualified base "../../../compiler/base/base.sub")
(require-unqualified gpu "../gpu.sub")
(require-unqualified camera "camera.sub")
(require-unqualified light "light.sub")
(require-unqualified meshes "meshes.sub")
(require-unqualified sky "sky.sub")
(require-unqualified post "post.sub")
(require-unqualified particles "particles.sub")

(provide scene scene-init! scene-meshes scene-emit! scene-draw!)

(memory from base)
(table from base)

(struct scene [meshes meshes] [dome sky] [picture post] [motes particles] [outline f64] [exposure f64])

(define (scene-init! [s (ptr scene)] [atlas (ptr u8)] [width u32] [height u32] [scale u32])
  (meshes-init! (& (-> s meshes)) atlas)
  (sky-init! (& (-> s dome)))
  (post-init! (& (-> s picture)) width height scale)
  (particles-init! (& (-> s motes)))
  (set! (-> s outline) 0.85)
  (set! (-> s exposure) 1.0))

(define (scene-meshes [s (ptr scene)]) -> (ptr meshes) (& (-> s meshes)))

(define (scene-emit! [s (ptr scene)] [emitter u32] [x f64] [y f64] [z f64] [kind u32] [strength f64])
  (particles-emit! (& (-> s motes)) emitter x y z kind strength))

(define (scene-draw! [s (ptr scene)] [kind u32] [target u32] [format u32] [c (ptr camera)] [l (ptr light)])
  (let ([m (& (-> s meshes))] [p (& (-> s picture))])
    (meshes-frame! m c l)
    (particles-step! (& (-> s motes)) c l)
    (for ([cascade u32 0]) (< cascade 2) (+= cascade 1)
      (gpu-render-pass! 0 (meshes-shadow-maps m) 0 cascade gpu-clear 1.0)
      (meshes-shadow-pass! m cascade)
      (gpu-end-pass!))
    (gpu-render-pass! 2 (post-depth p) 0 0 gpu-clear 1.0)
    (gpu-pass-target! gpu-on-texture (post-color p) 0 0 gpu-clear 0.0 0.0 0.0 1.0)
    (gpu-pass-target! gpu-on-texture (post-normals p) 0 0 gpu-clear 0.5 0.5 0.5 0.0)
    (sky-pass! (& (-> s dome)) c l (post-width p) (post-height p))
    (meshes-pass! m)
    (particles-pass! (& (-> s motes)))
    (gpu-end-pass!)
    (post-draw! p kind target format c (-> s outline) (-> s exposure))))
