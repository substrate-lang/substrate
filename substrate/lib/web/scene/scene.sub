;; Lifecycle: experimental.
;;
;; A 3D scene drawn by the GPU: meshes lit by a sun, under a sky, made
;; into a picture with outlines. This is the file a game uses; the
;; others here are its parts.
;;
;;   (struct scene [meshes] [dome] [picture] [outline] [exposure])
;;       The meshes (meshes.sub), the sky (sky.sub), the picture pass
;;       and its textures (post.sub), and two settings of the picture:
;;       how dark the outlines are, 0 to 1 (0.85), and the exposure
;;       (1).
;;   (scene-init! s atlas width height scale)
;;       Makes the GPU resources: the meshes' atlas from the image file
;;       at `atlas`, and the picture's textures, `scale` times
;;       `width` by `height` pixels, the size of the screen: a scale
;;       of 2 draws the scene at twice the screen's size each way and
;;       the picture pass averages it down, which smooths the edges
;;       (post.sub), at four times the GPU's work on pixels; 1 draws it
;;       at the screen's size. Call it once.
;;   (scene-meshes s) -> (ptr meshes)
;;       The meshes, to add to, fill and place (meshes-add!,
;;       meshes-set!, meshes-place!).
;;   (scene-draw! s kind target format camera light)
;;       Writes the commands of a frame: the shadow maps, from the sun;
;;       the scene, into the picture's textures: the sky, then the
;;       meshes; and the picture, on the target (as sprites-draw! takes
;;       it: gpu-on-surface or gpu-on-texture, its number and its
;;       format). The camera is camera.sub's and the light light.sub's.
;;
;; A game then draws its sprites and text over the picture (the game
;; library's draw.sub).
(require-unqualified base "../../../compiler/base/base.sub")
(require-unqualified gpu "../gpu.sub")
(require-unqualified camera "camera.sub")
(require-unqualified light "light.sub")
(require-unqualified meshes "meshes.sub")
(require-unqualified sky "sky.sub")
(require-unqualified post "post.sub")

(provide scene scene-init! scene-meshes scene-draw!)

(memory from base)
(table from base)

(struct scene [meshes meshes] [dome sky] [picture post] [outline f64] [exposure f64])

(define (scene-init! [s (ptr scene)] [atlas (ptr u8)] [width u32] [height u32] [scale u32])
  (meshes-init! (& (-> s meshes)) atlas)
  (sky-init! (& (-> s dome)))
  (post-init! (& (-> s picture)) width height scale)
  (set! (-> s outline) 0.85)
  (set! (-> s exposure) 1.0))

(define (scene-meshes [s (ptr scene)]) -> (ptr meshes) (& (-> s meshes)))

(define (scene-draw! [s (ptr scene)] [kind u32] [target u32] [format u32] [c (ptr camera)] [l (ptr light)])
  (let ([m (& (-> s meshes))] [p (& (-> s picture))])
    (meshes-frame! m c l)
    ;; The shadow maps, from the sun: the near one, then the far one.
    (for ([cascade u32 0]) (< cascade 2) (+= cascade 1)
      (gpu-render-pass! 0 (meshes-shadow-maps m) 0 cascade gpu-clear 1.0)
      (meshes-shadow-pass! m cascade)
      (gpu-end-pass!))
    ;; The scene: the sky under everything, then the meshes.
    (gpu-render-pass! 2 (post-depth p) 0 0 gpu-clear 1.0)
    (gpu-pass-target! gpu-on-texture (post-color p) 0 0 gpu-clear 0.0 0.0 0.0 1.0)
    (gpu-pass-target! gpu-on-texture (post-normals p) 0 0 gpu-clear 0.5 0.5 0.5 0.0)
    (sky-pass! (& (-> s dome)) c l (post-width p) (post-height p))
    (meshes-pass! m)
    (gpu-end-pass!)
    ;; The picture.
    (post-draw! p kind target format c (-> s outline) (-> s exposure))))
