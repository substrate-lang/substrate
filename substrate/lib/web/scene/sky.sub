;; Lifecycle: experimental.
;;
;; The sky: what a scene shows where there is nothing. Drawn by one
;; pass over the screen with no geometry, from the direction each pixel
;; looks in: the sky's colour from the horizon up to the zenith, haze
;; below the horizon, the sun as a disc with a glow around it, where
;; the scene's light comes from, and clouds that drift with time.
;;
;;   (sky-init! s)                       makes the shader; once
;;   (sky-pass! s camera light width height)
;;                                       writes the commands that draw
;;                                       the sky, inside the scene's
;;                                       render pass (scene.sub opens
;;                                       it and calls this first), on
;;                                       targets `width` by `height`
;;
;; The light (light.sub) gives the sun's direction and colour, the sky's
;; colour and the time; the sky lightens towards the horizon by itself.
;; The pass writes the scene's two targets, colour and normals
;; (post.sub), and leaves the depth alone, so the scene draws over it.
;;
;; ---- How it works ----
;;
;; The uniform holds the camera's axes and the size of its view, so a
;; pixel's direction is forward, plus right and up scaled by where the
;; pixel is on the screen. The clouds are value noise (lib/shade/noise.sub),
;; four octaves, on a plane high above the camera, so that they
;; foreshorten towards the horizon; where the noise is above a threshold
;; there is cloud, lit white on the sunward side and grey underneath.
;; The shader is written in Shade (lib/shade/core.sub).
(require-unqualified base "../../../compiler/base/base.sub")
(require-unqualified gpu "../gpu.sub")
(require-unqualified shader "shader.sub")
(require-unqualified screen "../../shade/screen.sub")
(require-unqualified noise "../../shade/noise.sub")
(require-unqualified math "math.sub")
(require-unqualified camera "camera.sub")
(require-unqualified light "light.sub")

(provide sky sky-init! sky-pass!)

(memory from base)
(table from base)

(struct sky [shader dome-shader] [uniforms u32] [group u32] [pipeline u32])

(shader dome
  [uniform view 0 0 (fragment)
    [right vec3] [time f32] [up vec3] [unused f32] [forward vec3] [unused2 f32]
    [scale vec2] [size vec2]
    [sun vec3] [unused3 f32] [sun-color vec4] [sky vec4]]
  [builtins vertex-index]
  [outputs [color vec4] [normal vec4]]
  [use screen]
  [use noise]
  [vertex (vertex [in vertex]) -> varyings
    (varyings [position (screen-corner in.vertex-index)])]
  [fragment (fragment [in varyings]) -> outputs
    (let* ([point (screen-point in.position view.size)]
           [dir (normalize (+ view.forward (* view.right point.x view.scale.x) (* view.up point.y view.scale.y)))]
           [sun (normalize view.sun)]
           [elevation dir.y]
           ;; The sky: haze at the horizon, the sky's colour above it,
           ;; deeper and bluer towards the zenith; dimmer haze below the
           ;; horizon.
           [haze (mix view.sky.rgb (vec3 1.0) 0.5)]
           [zenith (* view.sky.rgb (vec3 0.7 0.82 1.0))]
           [color (mix haze view.sky.rgb (smoothstep 0.0 0.2 elevation))]
           ;; The sun: a disc, a glow close around it, and a wide one.
           [towards (max (dot dir sun) 0.0)])
      (set! color (mix color zenith (smoothstep 0.2 0.8 elevation)))
      (set! color (mix color (* haze 0.7) (smoothstep 0.0 -0.3 elevation)))
      (+= color (* view.sun-color.rgb (+ (* (smoothstep 0.9988 0.9994 towards) 4.0) (* (pow towards 48.0) 0.4) (* (pow towards 6.0) 0.12))))
      ;; Clouds, on a plane 80 above, drifting.
      (when (> elevation 0.02)
        (let* ([p (+ (* (/ dir.xz elevation) 80.0) (vec2 (* view.time 1.5) (* view.time 0.4)))]
               [density (smoothstep 0.5 0.68 (fbm (* p 0.012) 4))]
               [lit (* (mix 0.72 1.0 (smoothstep 0.0 0.8 sun.y)) (mix 0.85 1.05 towards))]
               [cloud (* (vec3 lit) (mix (vec3 1.0) view.sun-color.rgb 0.3))])
          (set! color (mix color cloud (* density (smoothstep 0.02 0.12 elevation))))))
      (outputs [color (vec4 color 1.0)] [normal (vec4 0.5 0.5 0.5 0.0)]))])

(define (sky-init! [s (ptr sky)])
  (memset s 0 (sizeof sky))
  (dome-init! (& (-> s shader)))
  (set! (-> s uniforms) (gpu-buffer! (sizeof dome-view) gpu-uniform))
  (set! (-> s group) (dome-bind-group-0! (& (-> s shader)) (-> s uniforms)))
  ;; The sky is drawn first, under everything: it writes the colour and
  ;; the normals and leaves the depth alone.
  (let ([settings render-settings])
    (render-settings-init! (& settings))
    (set! (-> settings target-count) 2)
    (set! (@ (-> settings targets) 0) gpu-rgba16f)
    (set! (@ (-> settings targets) 1) gpu-rgba8)
    (set! (-> settings depth-format) gpu-depth24)
    (set! (-> settings depth-compare) gpu-always)
    (set! (-> settings depth-write) 0)
    (set! (-> s pipeline) (dome-render-pipeline! (& (-> s shader)) "vertex" "fragment" (& settings)))))

(define (sky-pass! [s (ptr sky)] [c (ptr camera)] [l (ptr light)] [width u32] [height u32])
  (let ([v dome-view])
    (memset (& v) 0 (sizeof dome-view))
    (camera-axes! c (-> v right) (-> v up) (-> v forward))
    (vec2! (-> v scale) (camera-half-width c) (camera-half-height c))
    (vec2! (-> v size) (cast f64 width) (cast f64 height))
    (set! (-> v time) (cast f32 (-> l time)))
    (vec3! (-> v sun) (-> l sun-x) (-> l sun-y) (-> l sun-z))
    (linear-color! (-> v sun-color) (-> l sun))
    (linear-color! (-> v sky) (-> l sky))
    (gpu-write-copy! (-> s uniforms) 0 (& v) (sizeof dome-view))
    (gpu-pipeline! (-> s pipeline))
    (gpu-bind-group-set! 0 (-> s group) 0)
    (gpu-draw! 3 1 0 0)))
