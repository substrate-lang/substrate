;; The sky: what a scene shows where there is nothing, drawn in one pass over the screen.
(require-unqualified gpu "../gpu.sub")
(require-unqualified shader "shader.sub")
(require-unqualified screen "../../shade/screen.sub")
(require-unqualified noise "../../shade/noise.sub")
(require-unqualified math "math.sub")
(require-unqualified camera "camera.sub")
(require-unqualified light "light.sub")

(provide sky sky-init! sky-pass!)

(struct sky [shader dome-shader] [uniforms u32] [group u32] [pipeline u32])

(shader dome
  [uniform view 0 0 (fragment)
    [right vec3] [time f32] [up vec3] [unused f32] [forward vec3] [unused2 f32]
    [scale vec2] [size vec2]
    [sun vec3] [unused3 f32] [sun-color vec4] [sky vec4]]
  [builtins vertex-index]
  [outputs [color vec4] [normal vec4]]
  [use screen]
  [use noise]
  [vertex (vertex [in vertex]) -> varyings
    (varyings [position (screen-corner in.vertex-index)])]
  [define (ridge [dir vec3] [seed f32] [height f32]) -> f32
    (let ([around (vec2 (+ (* dir.x 2.5) seed) (* dir.z 2.5))])
      (* height (- (fbm around 3) 0.15)))]
  [fragment (fragment [in varyings]) -> outputs
    (let* ([point (screen-point in.position view.size)]
           [dir (normalize (+ view.forward (* view.right point.x view.scale.x) (* view.up point.y view.scale.y)))]
           [sun (normalize view.sun)]
           [elevation dir.y]
           [towards (max (dot dir sun) 0.0)]
           [bright (clamp (* 1.5 (dot view.sun-color.rgb (vec3 0.33 0.34 0.33))) 0.0 1.0)]
           [haze (+ (mix view.sky.rgb (vec3 1.0) (* 0.3 bright)) (* view.sun-color.rgb (pow towards 8.0) 0.3))]
           [zenith (* view.sky.rgb (vec3 0.65 0.8 1.0))]
           [color (mix haze view.sky.rgb (smoothstep 0.0 0.25 elevation))]
           [far-ridge (ridge dir 0.0 0.09)]
           [near-ridge (ridge dir 7.0 0.05)])
      (set! color (mix color zenith (smoothstep 0.25 0.9 elevation)))
      (set! color (mix color (* haze 0.7) (smoothstep 0.0 -0.3 elevation)))
      (set! color (mix color (mix (* haze 0.8) (* view.sky.rgb 0.55) 0.35) (smoothstep 0.004 -0.004 (- elevation far-ridge))))
      (set! color (mix color (mix (* haze 0.7) (* view.sky.rgb 0.45) 0.5) (smoothstep 0.004 -0.004 (- elevation near-ridge))))
      (+= color (* (vec3 (* 0.6 (- 1.0 bright))) (smoothstep 0.9975 0.999 (hash (floor (* dir.xz (/ 400.0 (max elevation 0.1)))))) (smoothstep 0.05 0.3 elevation)))
      (+= color (* (mix view.sun-color.rgb (vec3 1.0) 0.6) (smoothstep 0.9988 0.9994 towards) 6.0))
      (+= color (* view.sun-color.rgb (+ (* (pow towards 48.0) 0.4) (* (pow towards 6.0) 0.12))))
      (when (> elevation 0.02)
        (let* ([p (+ (* (/ dir.xz elevation) 80.0) (vec2 (* view.time 1.5) (* view.time 0.4)))]
               [q (* (vec2 (* p.x 0.75) p.y) 0.012)]
               [warped (+ q (* 0.3 (vec2 (gradient-fbm (+ q (vec2 3.1 1.7)) 2) (gradient-fbm (+ q (vec2 -2.3 4.9)) 2))))]
               [thickness (gradient-fbm warped 5)]
               [sunward (gradient-fbm (+ warped (* (normalize (vec2 sun.x sun.z)) 0.07)) 5)]
               [density (smoothstep 0.48 0.6 thickness)]
               [shade (mix 1.0 0.72 (smoothstep 0.58 0.75 thickness))]
               [lit-edge (* 0.18 (smoothstep 0.0 0.06 (- thickness sunward)))]
               [lit (* (+ shade lit-edge) (mix 0.8 1.0 (smoothstep 0.0 0.8 sun.y)) (mix 0.9 1.1 (pow towards 2.0)))]
               [cloud (* (vec3 lit) (mix (* view.sky.rgb 1.6) (mix (vec3 1.0) view.sun-color.rgb 0.3) bright))])
          (set! color (mix color cloud (* density (smoothstep 0.02 0.15 elevation))))))
      (outputs [color (vec4 color 1.0)] [normal (vec4 0.5 0.5 0.5 0.0)]))])

(define (sky-init! [s (ptr sky)])
  (memset s 0 (sizeof sky))
  (dome-init! (& (-> s shader)))
  (set! (-> s uniforms) (gpu-buffer! (sizeof dome-view) gpu-uniform))
  (set! (-> s group) (dome-bind-group-0! (& (-> s shader)) (-> s uniforms)))
  (let ([settings render-settings])
    (render-settings-init! (& settings))
    (set! (-> settings target-count) 2)
    (set! (@ (-> settings targets) 0) gpu-rgba16f)
    (set! (@ (-> settings targets) 1) gpu-rgba8)
    (set! (-> settings depth-format) gpu-depth24)
    (set! (-> settings depth-compare) gpu-always)
    (set! (-> settings depth-write) 0)
    (set! (-> s pipeline) (dome-render-pipeline! (& (-> s shader)) "vertex" "fragment" (& settings)))))

(define (sky-pass! [s (ptr sky)] [c (ptr camera)] [l (ptr light)] [width u32] [height u32])
  (let ([v dome-view])
    (memset (& v) 0 (sizeof dome-view))
    (camera-axes! c (-> v right) (-> v up) (-> v forward))
    (vec2! (-> v scale) (camera-half-width c) (camera-half-height c))
    (vec2! (-> v size) (cast f64 width) (cast f64 height))
    (set! (-> v time) (cast f32 (-> l time)))
    (vec3! (-> v sun) (-> l sun-x) (-> l sun-y) (-> l sun-z))
    (linear-color! (-> v sun-color) (-> l sun))
    (linear-color! (-> v sky) (-> l sky))
    (gpu-write-copy! (-> s uniforms) 0 (& v) (sizeof dome-view))
    (gpu-pipeline! (-> s pipeline))
    (gpu-bind-group-set! 0 (-> s group) 0)
    (gpu-draw! 3 1 0 0)))
