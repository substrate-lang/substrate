;; Lifecycle: experimental.
;;
;; Snake, as a web page: a small but complete game.
;;
;; The game itself is in rules.sub, which knows nothing about pages. This
;; file is the page around it, and it does three things:
;;   - it passes the browser's frames and key presses on to the game;
;;   - it draws the board on a <canvas> (lib/web/canvas.sub);
;;   - it shows the score and a line of help as ordinary page elements.
;;
;; It is a view (lib/web/ui.sub) in the usual model / message / update
;; structure (lib/web/web.sub). Two attributes on the canvas do the work
;; that is special to a game: [on-window frame ...] sends a message for
;; every frame the browser draws, and [on-window keydown ...] sends one
;; for every key pressed anywhere on the page.
;;
;; To play, in the dev shell:
;;
;;   lib/web/site.sh lib/web/examples/snake/snake.sub build/web/snake lib/web/examples/snake/page.html
;;   host/web/serve.mjs build/web/snake
;;
;; Keys: the arrows or W, A, S, D turn the snake; Space pauses; Enter
;; starts a new game.
(require-unqualified base "../../../../compiler/base/base.sub")
(require-unqualified ui "../../ui.sub")
(require-unqualified web "../../web.sub")
(require-unqualified canvas "../../canvas.sub")
(require-unqualified rules "rules.sub")

(memory from base)
(table from base)

;; ---- The model and the messages ----

(struct model
  ;; The game (rules.sub).
  [game snake]
  ;; The highest score since the page was loaded.
  [best u32]
  ;; A counter that is increased whenever the board should be drawn again.
  ;; The canvas's [draw ...] attribute watches it.
  [redraw u32]
  ;; 0 until the first frame. See `tick!`.
  [seeded i32])

(variant message
  ;; The browser is about to draw a frame. `time` is in milliseconds.
  [tick [time f64]]
  ;; A key was pressed, anywhere on the page. `key` is its name, such as
  ;; "ArrowUp" or "w".
  [key-pressed [key (ptr u8)]]
  ;; The "New game" button.
  [new-game])
(messages message)

;; ---- Updating ----

;; Starts a new game. `seed` decides where the food appears.
(define (restart! [m (ptr model)] [seed u32])
  (snake-reset! (& (-> m game)) seed)
  (+= (-> m redraw) 1))

;; A seed for the next game: the redraw counter, which depends on how the
;; player has played so far, mixed with the score.
(define (next-seed [m (ptr model)]) -> u32 (+ (* (-> m redraw) 2654435761) (-> m game score)))

;; A frame: let the game move the snake if a step is due.
(define (tick! [m (ptr model)] [time f64])
  ;; There is no source of randomness when the page loads, so `init`
  ;; starts with a fixed seed. The first frame replaces that game with one
  ;; seeded from the frame's time, which differs on every visit. This
  ;; happens before the player can see or do anything.
  (unless (-> m seeded)
    (set! (-> m seeded) 1)
    (restart! m (cast u32 (* time 1000.0))))
  (when (snake-advance! (& (-> m game)) time)
    (when (> (-> m game score) (-> m best)) (set! (-> m best) (-> m game score)))
    (+= (-> m redraw) 1)))

;; Returns 1 if the C strings a and b are equal.
(define (same? [a (ptr u8)] [b (ptr u8)]) -> i32
  (let ([i u32 0])
    (while (and (== (@ a i) (@ b i)) (!= (@ a i) 0)) (+= i 1))
    (== (@ a i) (@ b i))))

;; What direction-of returns for a key that is not a direction key.
(define no-direction u32 4)

;; Returns the direction that a key stands for, or no-direction. `key` is
;; the key's name as the browser gives it. The arrows and W, A, S, D both
;; work, and so do the capital letters, in case Caps Lock is on.
(define (direction-of [key (ptr u8)]) -> u32
  (cond [(or (same? key "ArrowUp") (same? key "w") (same? key "W")) snake-up]
        [(or (same? key "ArrowRight") (same? key "d") (same? key "D")) snake-right]
        [(or (same? key "ArrowDown") (same? key "s") (same? key "S")) snake-down]
        [(or (same? key "ArrowLeft") (same? key "a") (same? key "A")) snake-left]
        [else no-direction]))

;; A key was pressed. prevent-default! stops the browser from also using
;; the key itself: the arrows and Space would scroll the page.
(define (key! [m (ptr model)] [key (ptr u8)])
  (let ([direction (direction-of key)])
    (cond [(!= direction no-direction)
           (prevent-default!)
           (snake-turn! (& (-> m game)) direction)]
          [(same? key " ")
           (prevent-default!)
           (snake-toggle-pause! (& (-> m game)))]
          [(same? key "Enter")
           (prevent-default!)
           (restart! m (next-seed m))])
    (+= (-> m redraw) 1)))

(define (update [m (ptr model)] [e (ptr message)])
  (match e
    [(tick time) (tick! m time)]
    [(key-pressed key) (key! m key)]
    [new-game (restart! m (next-seed m))]))

;; Called once when the page loads.
(define (init [m (ptr model)]) (restart! m 1))

;; ---- Drawing ----

;; The board is 20 by 20 cells of 20 pixels: a canvas of 400 by 400.

;; Draws the whole board: the background, the food, the snake, and a veil
;; over everything when the game is paused or over. Drawing everything
;; again on each change is simple, and at most 400 small rectangles is
;; little work.
(define (draw-game [m (ptr model)])
  (let* ([g (& (-> m game))] [state (-> g state)])
    (fill-style "#10141a")
    (fill-rect 0 0 400 400)

    (fill-style "#e5534b")
    (fill-circle (+ (* (-> g food x) 20) 10) (+ (* (-> g food y) 20) 10) 7)

    ;; The body first, then the head in a lighter colour. Each cell is
    ;; drawn one pixel smaller than its square on every side, which leaves
    ;; thin gaps between cells.
    (fill-style "#57ab5a")
    (for ([i u32 1]) (< i (-> g length)) (+= i 1)
      (let ([c (snake-segment g i)])
        (fill-rect (+ (* (-> c x) 20) 1) (+ (* (-> c y) 20) 1) 18 18)))
    (let ([head (snake-segment g 0)])
      (fill-style "#b4f1a7")
      (fill-rect (+ (* (-> head x) 20) 1) (+ (* (-> head y) 20) 1) 18 18))

    (when (or (== state snake-paused) (== state snake-over) (== state snake-won))
      (global-alpha 0.55)
      (fill-style "#10141a")
      (fill-rect 0 0 400 400)
      (global-alpha 1))))

;; The line of help under the board.
(define (status [m (ptr model)]) -> (ptr u8)
  (let ([state (-> m game state)])
    (cond [(== state snake-waiting) "Press an arrow key to start."]
          [(== state snake-paused) "Paused. Press Space to continue."]
          [(== state snake-over) "Game over. Press Enter to play again."]
          [(== state snake-won) "You filled the board! Press Enter to play again."]
          [else "Arrow keys or W A S D to turn. Space to pause."])))

;; The page. The canvas carries the two window listeners, so they exist
;; exactly as long as the board does. The board is drawn again whenever
;; `redraw` changes.
(view (page [m (ptr model)])
  (div ([class "snake"])
    (header
      (h1 "snake")
      (p "Score " (span ([id "score"]) (int (-> m game score)))
         "  Best " (span ([id "best"]) (int (-> m best)))))
    (canvas ([id "board"] [width 400] [height 400]
             [on-window frame (tick (event time))]
             [on-window keydown (key-pressed (event key))]
             [draw (-> m redraw) (draw-game m)]))
    (p ([id "status"]) (text (status m)))
    (button ([id "new-game"] [on click new-game]) "New game")))

(app model message init update page)
