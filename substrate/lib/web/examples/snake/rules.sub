;; Lifecycle: experimental.
;;
;; The game snake, without its page. This file has the rules, the timing
;; and the placing of food, and no drawing or input handling; snake.sub is
;; the web page built around it.
;;
;; The game: a snake moves across a grid, one cell per step. The player
;; turns it. Eating the food makes the snake one cell longer and scores a
;; point; new food then appears on a free cell. The game ends when the
;; snake runs into a wall or into itself. The snake speeds up as the score
;; grows.
;;
;; Keeping the game apart from the page means it can be tested without a
;; browser: tests/ui/snake.sub calls the same functions that the page
;; calls, with made-up times, and prints the board as text.
;;
;;   (snake-reset! s seed)     Starts a new game. `seed` decides where the
;;                             food appears: the same seed always gives
;;                             the same game.
;;   (snake-turn! s d)         The player asks to go in direction d:
;;                             snake-up, snake-right, snake-down or
;;                             snake-left. The first turn starts the game.
;;   (snake-toggle-pause! s)   Pauses the game, or continues it.
;;   (snake-advance! s time)   Call this on every frame, with the current
;;                             time in milliseconds. It moves the snake by
;;                             as many steps as are due. Returns 1 if it
;;                             took a step, which means the board should
;;                             be drawn again.
;;   (snake-step! s)           Moves the snake one cell, now.
;;                             snake-advance! calls it; a test can call it
;;                             directly.
;;   (snake-segment s i)       The i-th cell of the snake, for drawing.
;;                             0 is the head.
;;   (snake-occupied? s x y)   1 if the snake covers the cell (x, y).
;;
;; The fields `state`, `score`, `length` and `food` of a snake are meant
;; to be read directly.
(require-unqualified base "../../../../compiler/base/base.sub")

(provide snake cell snake-columns snake-rows
         snake-waiting snake-playing snake-paused snake-over snake-won
         snake-up snake-right snake-down snake-left
         snake-reset! snake-turn! snake-toggle-pause! snake-advance! snake-step!
         snake-segment snake-occupied?)

(memory from base)
(table from base)

;; The board is 20 cells wide and 20 cells high. A snake can therefore be
;; at most 400 cells long, which is the size of the `body` array below.
(define snake-columns i32 20)
(define snake-rows i32 20)

;; A position on the board. (0, 0) is the top left cell.
(struct cell [x i32] [y i32])

;; The values of a snake's `state`.
(define snake-waiting u32 0)   ; a new game, waiting for the first key
(define snake-playing u32 1)
(define snake-paused u32 2)
(define snake-over u32 3)      ; the snake hit a wall or itself
(define snake-won u32 4)       ; the snake fills the whole board

;; Directions, in clockwise order, so that the opposite of d is d + 2.
(define snake-up u32 0)
(define snake-right u32 1)
(define snake-down u32 2)
(define snake-left u32 3)

(struct snake
  ;; The snake's cells, kept in a ring buffer. body[head] is the head. The
  ;; cell behind it is body[head - 1], and so on, `length` cells in all,
  ;; wrapping around from index 0 to index 399. Moving the snake writes
  ;; one new head cell; nothing else is copied.
  [body (array cell 400)] [head u32] [length u32]
  ;; The direction the snake is moving in.
  [direction u32]
  ;; Turns that the player has asked for and that have not happened yet:
  ;; at most two. A quick player presses two keys within one step, for
  ;; example up then left to make a U-turn. Each step takes one turn from
  ;; this queue, so both key presses count.
  [turns (array u32 2)] [turn-count u32]
  [food cell]
  [score u32]
  [state u32]
  ;; The random number generator's state (see next-random!).
  [random u32]
  ;; Timing (see snake-advance!). `timed` is 1 once `last-time` holds the
  ;; time of the previous frame. `pending` is the time, in milliseconds,
  ;; that has passed but has not been used up by a step yet.
  [timed i32] [last-time f64] [pending f64])

;; ---- Small helpers ----

;; How far one step in a direction moves, in x and in y.
(define (dx [direction u32]) -> i32
  (case direction
    [(1) 1]
    [(3) -1]
    [else 0]))

(define (dy [direction u32]) -> i32
  (case direction
    [(0) -1]
    [(2) 1]
    [else 0]))

(define (opposite [direction u32]) -> u32 (% (+ direction 2) 4))

(define (snake-segment [s (ptr snake)] [i u32]) -> (ptr cell)
  (+ (-> s body) (% (- (+ (-> s head) 400) i) 400)))

;; Returns 1 if one of the first n cells of the snake, counting from the
;; head, is at (x, y).
(define (covers? [s (ptr snake)] [x i32] [y i32] [n u32]) -> i32
  (for ([i u32 0]) (< i n) (+= i 1)
    (let ([c (snake-segment s i)])
      (when (and (== (-> c x) x) (== (-> c y) y)) (return 1))))
  0)

(define (snake-occupied? [s (ptr snake)] [x i32] [y i32]) -> i32 (covers? s x y (-> s length)))

;; Returns the next number of a pseudo-random sequence. The numbers look
;; random, but the same seed always gives the same sequence, which is what
;; lets a test replay a game exactly. The method is called xorshift: three
;; shifts and exclusive-ors of the previous number. It never produces 0,
;; provided it does not start from 0.
(define (next-random! [s (ptr snake)]) -> u32
  (let ([x (-> s random)])
    (set! x (bit-xor x (<< x 13)))
    (set! x (bit-xor x (>> x 17)))
    (set! x (bit-xor x (<< x 5)))
    (set! (-> s random) x)
    x))

;; Puts the food on a free cell chosen at random: it picks a number k
;; below the number of free cells, then walks over the board and takes
;; the k-th free cell.
(define (place-food! [s (ptr snake)])
  (let ([k (% (next-random! s) (- 400 (-> s length)))])
    (for ([y i32 0]) (< y snake-rows) (+= y 1)
      (for ([x i32 0]) (< x snake-columns) (+= x 1)
        (unless (snake-occupied? s x y)
          (when (== k 0)
            (set! (-> s food x) x)
            (set! (-> s food y) y)
            (return))
          (-= k 1))))))

;; Reverses the order of the snake's cells, so that its tail becomes its
;; head.
(define (reverse! [s (ptr snake)])
  (let ([n (-> s length)])
    (for ([i u32 0]) (< i (/ n 2)) (+= i 1)
      (let ([a (snake-segment s i)] [b (snake-segment s (- n 1 i))] [t cell])
        (set! t (@ a))
        (set! (@ a) (@ b))
        (set! (@ b) t)))))

;; ---- The rules ----

;; Starts a new game: a snake three cells long in the middle of the
;; board, pointing right, and one piece of food. The game waits for the
;; first turn.
(define (snake-reset! [s (ptr snake)] [seed u32])
  (for ([i u32 0]) (< i 3) (+= i 1)
    (set! (-> (+ (-> s body) i) x) (+ 8 (cast i32 i)))
    (set! (-> (+ (-> s body) i) y) 10))
  (set! (-> s head) 2)
  (set! (-> s length) 3)
  (set! (-> s direction) snake-right)
  (set! (-> s turn-count) 0)
  (set! (-> s score) 0)
  (set! (-> s state) snake-waiting)
  (set! (-> s timed) 0)
  ;; The generator must not start from 0.
  (set! (-> s random) (if (== seed 0) 2654435769 seed))
  (place-food! s))

(define (snake-turn! [s (ptr snake)] [direction u32])
  (cond
    ;; The first turn starts the game, in whatever direction was pressed.
    ;; The new snake points right. If the player presses left, the snake
    ;; is reversed first, so that it does not run into itself at once.
    [(== (-> s state) snake-waiting)
     (when (== direction (opposite (-> s direction))) (reverse! s))
     (set! (-> s direction) direction)
     (set! (-> s state) snake-playing)]
    ;; During the game, a turn is added to the queue, unless the queue is
    ;; full or the turn makes no sense: the snake cannot keep going the
    ;; way it already goes, and cannot reverse into itself. "The way it
    ;; goes" is the last turn in the queue, if there is one.
    [(== (-> s state) snake-playing)
     (let ([heading (if (> (-> s turn-count) 0) (@ (-> s turns) (- (-> s turn-count) 1)) (-> s direction))])
       (when (and (< (-> s turn-count) 2) (!= direction heading) (!= direction (opposite heading)))
         (set! (@ (-> s turns) (-> s turn-count)) direction)
         (+= (-> s turn-count) 1)))]))

(define (snake-toggle-pause! [s (ptr snake)])
  (cond [(== (-> s state) snake-playing) (set! (-> s state) snake-paused)]
        [(== (-> s state) snake-paused) (set! (-> s state) snake-playing)]))

(define (snake-step! [s (ptr snake)])
  (when (== (-> s state) snake-playing)
    ;; Take one turn from the queue, if there is one.
    (when (> (-> s turn-count) 0)
      (set! (-> s direction) (@ (-> s turns) 0))
      (set! (@ (-> s turns) 0) (@ (-> s turns) 1))
      (-= (-> s turn-count) 1))
    (let* ([head (snake-segment s 0)]
           [x (+ (-> head x) (dx (-> s direction)))]
           [y (+ (-> head y) (dy (-> s direction)))]
           [eats (and (== x (-> s food x)) (== y (-> s food y)))])
      (cond
        ;; A wall.
        [(or (< x 0) (>= x snake-columns) (< y 0) (>= y snake-rows)) (set! (-> s state) snake-over)]
        ;; The snake's own body. If the snake is not growing, its last
        ;; cell moves away during this step, so the head may move into
        ;; it: that cell is left out of the check.
        [(covers? s x y (if eats (-> s length) (- (-> s length) 1))) (set! (-> s state) snake-over)]
        [else
         ;; Move: write the new head after the old one in the ring buffer.
         ;; If the snake is not growing, `length` stays the same, which
         ;; drops the last cell.
         (set! (-> s head) (% (+ (-> s head) 1) 400))
         (let ([new (snake-segment s 0)])
           (set! (-> new x) x)
           (set! (-> new y) y))
         (when eats
           (+= (-> s length) 1)
           (+= (-> s score) 1)
           (if (== (-> s length) 400)
               (set! (-> s state) snake-won)
               (place-food! s)))]))))

;; ---- Timing ----
;;
;; A browser calls the game once for every frame it displays, and frames
;; do not arrive at a fixed rate: 60 a second on most screens, 120 or 144
;; on others, fewer when the machine is busy. If the snake moved once per
;; frame, its speed would depend on the screen.
;;
;; So the snake moves in steps of a fixed length of time instead. On every
;; frame, snake-advance! adds the time since the previous frame to
;; `pending`, and takes one step for each full step length in it. Most
;; frames take no step; a late frame can take several.

;; How long one step takes, in milliseconds. The snake gets faster as the
;; score grows: from 130 ms a step down to 60 ms.
(define (step-length [score u32]) -> f64
  (let ([ms (- 130 (* 3 (cast i32 score)))])
    (if (< ms 60) 60.0 (cast f64 ms))))

;; The most steps taken on one frame. If more time than that has built up
;; (the browser tab was in the background, or the machine stalled), the
;; rest is dropped: the game falls behind real time instead of rushing
;; ahead to catch up.
(define max-steps u32 5)

(define (snake-advance! [s (ptr snake)] [now f64]) -> i32
  (cond
    ;; While the snake is not moving (the game is waiting, paused or
    ;; over), forget the time of the last frame. Otherwise the whole wait
    ;; would count as elapsed time when the game continues.
    [(!= (-> s state) snake-playing)
     (set! (-> s timed) 0)
     0]
    ;; The first frame after a start or a pause only records the time.
    [(not (-> s timed))
     (set! (-> s timed) 1)
     (set! (-> s last-time) now)
     (set! (-> s pending) 0.0)
     0]
    [else
     (let ([steps u32 0])
       (+= (-> s pending) (- now (-> s last-time)))
       (set! (-> s last-time) now)
       ;; The step length is read again for each step, because eating food
       ;; shortens it.
       (while (and (== (-> s state) snake-playing) (< steps max-steps)
                   (>= (-> s pending) (step-length (-> s score))))
         (-= (-> s pending) (step-length (-> s score)))
         (snake-step! s)
         (+= steps 1))
       (when (>= (-> s pending) (step-length (-> s score))) (set! (-> s pending) 0.0))
       (> steps 0))]))
