;; Lifecycle: experimental.
;;
;; The valley, a landscape to walk through, as a web page.
;;
;; The game is in world.sub. This file hands its three functions to the
;; game loop (lib/web/game/game.sub), which calls world-step! 60 times a
;; second and world-draw on every frame, on a screen of 640 by 360
;; pixels drawn by the GPU, which a 3D scene needs. [pointer lock] makes
;; a click on the screen lock the pointer to it, so that the mouse looks
;; around; Escape frees it.
;;
;; The directory `assets` holds the atlas, one white tile, which
;; lib/web/site.sh puts in the site, as it does for any program. To
;; walk, in the dev shell:
;;
;;   lib/web/site.sh lib/web/examples/valley/valley.sub \
;;     build/lib/web/valley lib/web/examples/valley/page.html
;;   host/web/serve.mjs build/lib/web/valley
(require-unqualified base "../../../../compiler/base/base.sub")
(require-unqualified game "../../game/game.sub")
(require-unqualified world "world.sub")

(memory from base)
(table from base)

(game world [size 640 360] [renderer gpu] [pointer lock] world-init! world-step! world-draw)
