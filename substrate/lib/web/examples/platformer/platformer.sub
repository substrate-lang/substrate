;; Lifecycle: experimental.
;;
;; A small platformer, as a web page.
;;
;; The game is in world.sub. This file only hands its three functions to
;; the game loop (lib/web/game/game.sub), which calls world-step! 60
;; times a second and world-draw on every frame, on a screen of 320 by 180
;; pixels, drawn by the GPU. The game would look the same on the 2D
;; canvas; it uses [renderer gpu] to show the GPU renderer in use.
;;
;; The directory `assets` holds the game's levels, which are text files,
;; and its sheet of sprites. lib/web/site.sh puts them in the site, as it
;; does for any program.
;;
;; To play, in the dev shell:
;;
;;   lib/web/site.sh lib/web/examples/platformer/platformer.sub \
;;     build/web/platformer lib/web/examples/platformer/page.html
;;   host/web/serve.mjs build/web/platformer
(require-unqualified base "../../../../compiler/base/base.sub")
(require-unqualified game "../../game/game.sub")
(require-unqualified world "world.sub")

(memory from base)
(table from base)

(game world [size 320 180] [renderer gpu] world-init! world-step! world-draw)
