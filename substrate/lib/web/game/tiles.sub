;; Tile maps for 2D games: levels of square tiles, bodies that move through them, a camera.
(require-unqualified substrate "../../../compiler/substrate/substrate.sub")
(require-unqualified vector "vector.sub")
(require-unqualified draw "draw.sub")

(provide tilemap tilemap-init! tilemap-free! tile-set! tile-at tile-solid! solid-at?
         body move-body! bodies-overlap?
         camera camera-follow! draw-tilemap
         text-grid text-grid-read! grid-char text-grid-free!)

(struct tilemap
  [columns i32] [rows i32]
  [size i32]
  [tiles (ptr u8)]
  [solid (array u8 256)])

(define (tilemap-init! [m (ptr tilemap)] [columns i32] [rows i32] [size i32])
  (set! (-> m columns) columns)
  (set! (-> m rows) rows)
  (set! (-> m size) size)
  (set! (-> m tiles) (cast (ptr u8) (calloc (cast u32 (* columns rows)) 1)))
  (memset (-> m solid) 0 256))

(define (tilemap-free! [m (ptr tilemap)])
  (free (-> m tiles))
  (set! (-> m tiles) 0)
  (set! (-> m columns) 0)
  (set! (-> m rows) 0))

(define (inside? [m (ptr tilemap)] [column i32] [row i32]) -> i32
  (and (>= column 0) (< column (-> m columns)) (>= row 0) (< row (-> m rows))))

(define (tile-set! [m (ptr tilemap)] [column i32] [row i32] [tile u32])
  (when (inside? m column row)
    (set! (@ (-> m tiles) (+ (* row (-> m columns)) column)) (cast u8 tile))))

(define (tile-at [m (ptr tilemap)] [column i32] [row i32]) -> u32
  (if (inside? m column row)
      (cast u32 (@ (-> m tiles) (+ (* row (-> m columns)) column)))
      0))

(define (tile-solid! [m (ptr tilemap)] [tile u32])
  (when (< tile 256) (set! (@ (-> m solid) tile) 1)))

;; Solid beyond the left and right edges, so nothing walks out of the level; open above
;; and below, so things can jump above the top and fall out of the bottom.
(define (solid-at? [m (ptr tilemap)] [column i32] [row i32]) -> i32
  (cond [(or (< column 0) (>= column (-> m columns))) 1]
        [(or (< row 0) (>= row (-> m rows))) 0]
        [else (!= (@ (-> m solid) (tile-at m column row)) 0)]))

(struct body
  [x f64] [y f64] [width f64] [height f64]
  [vx f64] [vy f64]
  [on-ground i32] [hit-wall i32] [hit-ceiling i32])

(define (cell-of [m (ptr tilemap)] [p f64]) -> i32 (cast i32 (floor (/ p (cast f64 (-> m size))))))

;; Edges are moved in by this much, so that touching a tile is not being inside it.
(define (edge) -> f64 0.001)

(define (solid-column? [m (ptr tilemap)] [b (ptr body)] [x f64]) -> i32
  (let ([column (cell-of m x)] [last (cell-of m (- (+ (-> b y) (-> b height)) (edge)))])
    (for ([row i32 (cell-of m (-> b y))]) (<= row last) (+= row 1)
      (when (solid-at? m column row) (return 1)))
    0))

(define (solid-row? [m (ptr tilemap)] [b (ptr body)] [y f64]) -> i32
  (let ([row (cell-of m y)] [last (cell-of m (- (+ (-> b x) (-> b width)) (edge)))])
    (for ([column i32 (cell-of m (-> b x))]) (<= column last) (+= column 1)
      (when (solid-at? m column row) (return 1)))
    0))

;; In pieces shorter than a tile: only the leading edge is checked, so a longer move
;; could jump straight over a wall.
(define (move-x! [b (ptr body)] [m (ptr tilemap)] [distance f64])
  (let ([size (cast f64 (-> m size))] [left distance])
    (while (!= left 0.0)
      (let* ([most (- size 1.0)]
             [piece (if (> left most) most (if (< left (- 0.0 most)) (- 0.0 most) left))])
        (-= left piece)
        (+= (-> b x) piece)
        (if (> piece 0.0)
            (let ([right (- (+ (-> b x) (-> b width)) (edge))])
              (when (solid-column? m b right)
                (set! (-> b x) (- (* (cast f64 (cell-of m right)) size) (-> b width)))
                (set! (-> b vx) 0.0)
                (set! (-> b hit-wall) 1)
                (return)))
            (when (solid-column? m b (-> b x))
              (set! (-> b x) (* (cast f64 (+ (cell-of m (-> b x)) 1)) size))
              (set! (-> b vx) 0.0)
              (set! (-> b hit-wall) 1)
              (return)))))))

(define (move-y! [b (ptr body)] [m (ptr tilemap)] [distance f64])
  (let ([size (cast f64 (-> m size))] [left distance])
    (while (!= left 0.0)
      (let* ([most (- size 1.0)]
             [piece (if (> left most) most (if (< left (- 0.0 most)) (- 0.0 most) left))])
        (-= left piece)
        (+= (-> b y) piece)
        (if (> piece 0.0)
            (let ([bottom (- (+ (-> b y) (-> b height)) (edge))])
              (when (solid-row? m b bottom)
                (set! (-> b y) (- (* (cast f64 (cell-of m bottom)) size) (-> b height)))
                (set! (-> b vy) 0.0)
                (set! (-> b on-ground) 1)
                (return)))
            (when (solid-row? m b (-> b y))
              (set! (-> b y) (* (cast f64 (+ (cell-of m (-> b y)) 1)) size))
              (set! (-> b vy) 0.0)
              (set! (-> b hit-ceiling) 1)
              (return)))))))

;; One axis at a time, so that a body that runs into a wall while falling slides down it.
(define (move-body! [m (ptr tilemap)] [b (ptr body)])
  (set! (-> b on-ground) 0)
  (set! (-> b hit-wall) 0)
  (set! (-> b hit-ceiling) 0)
  (move-x! b m (-> b vx))
  (move-y! b m (-> b vy)))

(define (bodies-overlap? [a (ptr body)] [b (ptr body)]) -> i32
  (and (< (-> a x) (+ (-> b x) (-> b width)))
       (< (-> b x) (+ (-> a x) (-> a width)))
       (< (-> a y) (+ (-> b y) (-> b height)))
       (< (-> b y) (+ (-> a y) (-> a height)))))

(struct camera [x f64] [y f64])

(define (clamp [v f64] [low f64] [high f64]) -> f64
  (if (or (< v low) (< high low)) low (if (> v high) high v)))

(define (camera-follow! [c (ptr camera)] [x f64] [y f64] [screen-width f64] [screen-height f64] [m (ptr tilemap)])
  (let ([size (cast f64 (-> m size))])
    (set! (-> c x) (clamp (- x (/ screen-width 2.0)) 0.0 (- (* (cast f64 (-> m columns)) size) screen-width)))
    (set! (-> c y) (clamp (- y (/ screen-height 2.0)) 0.0 (- (* (cast f64 (-> m rows)) size) screen-height)))))

;; Positions are floored: a sprite drawn between two pixels is blurred.
(define (draw-tilemap [m (ptr tilemap)] [sheet u32] [c (ptr camera)] [screen-width f64] [screen-height f64])
  (let* ([size (cast f64 (-> m size))]
         [cx (floor (-> c x))] [cy (floor (-> c y))]
         [last-column (cell-of m (+ cx screen-width))] [last-row (cell-of m (+ cy screen-height))])
    (for ([row i32 (cell-of m cy)]) (<= row last-row) (+= row 1)
      (for ([column i32 (cell-of m cx)]) (<= column last-column) (+= column 1)
        (let ([tile (tile-at m column row)])
          (when (!= tile 0)
            (draw-sprite sheet (- tile 1) (- (* (cast f64 column) size) cx) (- (* (cast f64 row) size) cy) 0)))))))

(struct text-line [start (ptr u8)] [length u32])

;; A grid points into its text, which must outlive it.
(struct text-grid [columns i32] [rows i32] [lines (vector text-line)])

(define (text-grid-read! [g (ptr text-grid)] [text (ptr u8)])
  (vector-clear! (& (-> g lines)))
  (set! (-> g columns) 0)
  (let ([p text])
    (while (!= (@ p) 0)
      (let ([start p])
        (while (and (!= (@ p) 0) (!= (@ p) 10)) (+= p 1))
        (let ([line (vector-add! (& (-> g lines)))] [length (cast u32 (- p start))])
          ;; A line from a Windows file ends with a carriage return, which is not part of it.
          (when (and (> length 0) (== (@ start (- length 1)) 13)) (-= length 1))
          (set! (-> line start) start)
          (set! (-> line length) length)))
      (when (== (@ p) 10) (+= p 1))))
  (while (and (> (vector-count (& (-> g lines))) 0)
              (== (-> (vector-at (& (-> g lines)) (- (vector-count (& (-> g lines))) 1)) length) 0))
    (vector-remove-last! (& (-> g lines))))
  (vector-each ([line (& (-> g lines))])
    (when (> (cast i32 (-> line length)) (-> g columns)) (set! (-> g columns) (cast i32 (-> line length)))))
  (set! (-> g rows) (cast i32 (vector-count (& (-> g lines))))))

(define (grid-char [g (ptr text-grid)] [column i32] [row i32]) -> u32
  (if (or (< row 0) (>= row (-> g rows)) (< column 0))
      0
      (let ([line (vector-at (& (-> g lines)) (cast u32 row))])
        (if (< (cast u32 column) (-> line length)) (cast u32 (@ (-> line start) column)) 0))))

(define (text-grid-free! [g (ptr text-grid)])
  (vector-free! (& (-> g lines)))
  (set! (-> g columns) 0)
  (set! (-> g rows) 0))
