;; Lifecycle: experimental.
;;
;; Stopping the program when it finds a mistake in itself.
;;
;; This file is part of the game library. It is not a standard library of
;; the language.
;;
;;   (trap "the level has no player")
;;   (trap-format "there is no item ~d: the vector holds ~d" i count)
;;
;; Both stop what the program is doing and report the message, together
;; with the functions that were running and where each one is in the
;; source. trap-format builds the message from a pattern, as the forms of
;; format.sub do.
;;
;; They are for situations from which carrying on would only do damage.
;; Most are mistakes in the program itself, such as an index that is out
;; of range. A program that can do something sensible about a problem
;; (ask again, use a default, show its own message) should do that
;; instead.
;;
;; What "stopping" means depends on where the program runs (spec 4):
;;
;;   - On the command line the program ends, with the message and the
;;     list of functions on standard error.
;;   - In a web page, only the call that was running ends: the handling
;;     of one event, or one frame of a game. The page stays open and the
;;     program is called again for the next event. A program can define
;;     `on-trap` to hear about it (the `trapped` function of a page,
;;     ../web.sub; a game shows the message on the screen, game.sub).
;;     Otherwise the message goes to the browser's console.
;;
;; Neither form returns to its caller.
(require-unqualified base "../../../compiler/base/base.sub")
(require-unqualified format "format.sub")

(provide trap trap-format)

(memory from base)
(table from base)

;; The host's function: stop, with the UTF-8 message of `length` bytes at
;; `message`.
(import host-trap "host" "trap" (i32 i32 ->))

(define (trap [message (ptr u8)]) (host-trap (cast i32 message) (cast i32 (strlen message))))

(begin-for-syntax
  (require-unqualified base "../../../compiler/base/base.sub")
  (require-unqualified kd "../../../compiler/kernel.sub")
  (require sm "../../../compiler/base/syntax-match.sub" syntax-match _ ... ?)

  ;; (trap-format pattern argument ...) is (trap (format-string pattern
  ;; argument ...)). The string is never freed, which does not matter:
  ;; the program stops.
  (define (trap-format-form [s datum]) -> datum
    (syntax-match s
      [(_ pattern argument ...) #`(trap (format-string #,pattern #,@argument))]
      [_ (raise-syntax-error 'trap-format '"expected (trap-format pattern argument ...)" s)])))

(define-syntax trap-format trap-format-form)
