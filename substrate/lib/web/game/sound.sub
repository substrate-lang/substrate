;; Sound for games: sound files, and short synthesized tones.
(require-unqualified substrate "../../../compiler/substrate/substrate.sub")
(require-unqualified vector "vector.sub")

(provide play-tone square-wave sawtooth-wave triangle-wave sine-wave
         tone tones-waiting tone-at tones-clear!
         load-sound play-sound play-music stop-music
         sound-play sounds-waiting sound-at sounds-clear!
         sound-file sound-files-waiting sound-file-at sound-files-clear!
         music-same music-start music-stop music-change music-sound music-volume music-change-clear!)

;; As host/web/audio.mjs numbers them.
(const square-wave u32 0)
(const sawtooth-wave u32 1)
(const triangle-wave u32 2)
(const sine-wave u32 3)

(struct tone [wave u32] [from f64] [to f64] [ms f64] [volume f64])

(define tones (array tone 16))
(define tone-count u32 0)

(define (play-tone [wave u32] [from f64] [to f64] [ms f64] [volume f64])
  (when (< tone-count 16)
    (let ([t (+ tones tone-count)])
      (set! (-> t wave) wave)
      (set! (-> t from) from)
      (set! (-> t to) to)
      (set! (-> t ms) ms)
      (set! (-> t volume) volume))
    (+= tone-count 1)))

(define (tones-waiting) -> u32 tone-count)
(define (tone-at [i u32]) -> (ptr tone) (+ tones i))
(define (tones-clear!) (set! tone-count 0))

(struct sound-file [id u32] [path (ptr u8)])

(define files (vector sound-file))

(define next-sound u32 1)

;; Copied: the list is read at the end of the frame, when the string may have changed.
(define (load-sound [path (ptr u8)]) -> u32
  (let* ([id next-sound] [n (strlen path)] [copy (cast (ptr u8) (malloc (+ n 1)))] [f (vector-add! (& files))])
    (+= next-sound 1)
    (memcpy copy path (+ n 1))
    (set! (-> f id) id)
    (set! (-> f path) copy)
    id))

(define (sound-files-waiting) -> u32 (vector-count (& files)))
(define (sound-file-at [i u32]) -> (ptr sound-file) (vector-at (& files) i))
(define (sound-files-clear!)
  (vector-each ([f (& files)]) (free (-> f path)))
  (vector-clear! (& files)))

(struct sound-play [sound u32] [volume f64])

(define plays (array sound-play 16))
(define play-count u32 0)

(define (play-sound [sound u32] [volume f64])
  (when (< play-count 16)
    (let ([p (+ plays play-count)])
      (set! (-> p sound) sound)
      (set! (-> p volume) volume))
    (+= play-count 1)))

(define (sounds-waiting) -> u32 play-count)
(define (sound-at [i u32]) -> (ptr sound-play) (+ plays i))
(define (sounds-clear!) (set! play-count 0))

(const music-same u32 0)
(const music-start u32 1)
(const music-stop u32 2)

(define change u32 0)
(define wanted u32 0)
(define level f64 0.0)

(define (play-music [sound u32] [volume f64])
  (set! change music-start)
  (set! wanted sound)
  (set! level volume))

(define (stop-music) (set! change music-stop))

(define (music-change) -> u32 change)
(define (music-sound) -> u32 wanted)
(define (music-volume) -> f64 level)
(define (music-change-clear!) (set! change music-same))
