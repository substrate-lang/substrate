;; Lifecycle: experimental.
;;
;; Meshes drawn by the GPU: a renderer for a 3D scene built on ../gpu.sub,
;; as sprites.sub is for 2D, with a sun, shadows, a sky and a toon look.
;;
;; A mesh is a list of textured triangles that the program builds
;; (voxels.sub builds them for a world of blocks): vertices of ten
;; numbers each, nine floats and a colour: position (x, y, z), normal
;; (x, y, z), texel (u, v) in an atlas, a shade from 0 to 1 (how open
;; the surface is: the ambient light is dimmed where it is closed in),
;; and a colour that the texel is multiplied by (four bytes, r, g, b,
;; a, as #xffffffff for the texel as it is; a plain-coloured mesh uses
;; a white texel and the colour); and indexes, three u32 per triangle.
;; Every mesh shares the one atlas, and each has an origin, where its
;; (0, 0, 0) is in the world.
;;
;; A frame draws all the meshes from a camera (camera.sub), lit by a
;; sun, under a sky (sky.sub). A surface facing the sun is lit, one
;; facing away is in shade, with a sharp edge between, as in a drawn
;; picture rather than a photograph; a rim of light outlines shapes
;; against the light; shadows fall from the sun, from a shadow map
;; drawn each frame; near things hide far ones; back faces are culled;
;; and fog fades everything to the sky's colour by distance. The frame
;; is drawn into post.sub's textures, and post.sub draws the picture
;; on the screen, with the outlines.
;;
;;   (struct light [sun-x] [sun-y] [sun-z] [sun] [ambient] [sky]
;;                 [fog-near] [fog-far] [time]
;;                 [shadow-x] [shadow-y] [shadow-z] [shadow-radius])
;;       The direction the sunlight comes from (any length), the sun's
;;       colour and the ambient light's (#xRRGGBBAA; the alpha is not
;;       used), the sky's colour (fog fades to the haze at its horizon
;;       between fog-near and fog-far), the time in seconds (the clouds drift
;;       with it), and the part of the world that gets shadows: a box
;;       shadow-radius from its centre each way. The map is 2048 texels
;;       across, so a radius of 48 gives it about 20 texels per unit.
;;   (light-init! l)
;;       Fills in an afternoon: the sun fairly high, warm white,
;;       grey-blue ambient light, a blue sky, fog from 24 to 56,
;;       shadows within 48 of the origin.
;;
;;   (meshes-init! r atlas)
;;       Makes the GPU resources: the atlas from the image file at
;;       `atlas` (loaded by the host), the shadow map, the sky. Call it
;;       once.
;;   (meshes-add! r) -> mesh
;;       A new, empty mesh. Returns its number, from 0.
;;   (meshes-set! r mesh vertices indices x y z)
;;       Gives the mesh its triangles, from two buffers (base.sub's
;;       buffer) of vertices and indexes, and its origin. The bytes are
;;       read when the frame is handed over (gpu.sub), so the buffers
;;       must keep them until then.
;;   (meshes-draw! r p camera light)
;;       Writes the commands that draw the frame into the textures of
;;       the post p (post.sub): first the shadow map, from the sun,
;;       then the sky, then the meshes.
;;
;; A game then calls post-draw! to put the picture on its screen, and
;; draws its sprites and text over it (draw.sub).
;;
;; ---- How it works ----
;;
;; The shader is described once with ../shader.sub, which lays out its
;; uniform struct and makes the pipelines and bind groups. Two
;; pipelines share it: the shadow pass, which has no fragment stage and
;; writes depth into the shadow map as seen from the sun; and the lit
;; pass, which writes the frame's colour and its normals (post.sub
;; finds the outlines in them). A frame is one uniform buffer with the
;; camera's matrix, the sun's, the sun and the colours; each mesh's
;; origin is in a second uniform buffer, 256 bytes apart as WebGPU
;; requires, chosen per draw with a dynamic offset, so the meshes
;; share one bind group. The atlas and the shadow map are a group of
;; their own, which the shadow pass does not bind: a pass may not read
;; the texture it draws into. Each mesh has a vertex buffer and an
;; index buffer on the GPU, replaced by bigger ones when the mesh
;; outgrows them.
;;
;; Colours: the atlas and the colours given are in the screen's sRGB;
;; the shader decodes them, lights in linear values, and writes linear
;; values with more range than the screen has, which post.sub maps
;; back. Shadows: the fragment's place in the sun's view is found in
;; the vertex stage, with the surface pushed a little along its normal
;; first so that a surface does not shadow itself, and compared with
;; the map at nine texels around it (a comparison sampler does the
;; compare and blends the four texels around a point), which softens
;; the edge. The toon edge: the lit share of a surface is a smooth step
;; of the angle to the sun, then pushed to a dark band and a lit band
;; with a narrow blend between them.
(require-unqualified base "../../../compiler/base/base.sub")
(require-unqualified gpu "../gpu.sub")
(require-unqualified shader "../shader.sub")
(require-unqualified math "math.sub")
(require-unqualified camera "camera.sub")
(require-unqualified sky "sky.sub")
(require-unqualified post "post.sub")

(provide light light-init! meshes meshes-init! meshes-add! meshes-set! meshes-draw!)

(memory from base)
(table from base)

;; ---- The light ----

(struct light
  [sun-x f64] [sun-y f64] [sun-z f64]
  [sun u32] [ambient u32] [sky u32]
  [fog-near f64] [fog-far f64]
  [time f64]
  [shadow-x f64] [shadow-y f64] [shadow-z f64] [shadow-radius f64])

(define (light-init! [l (ptr light)])
  (memset l 0 (sizeof light))
  (set! (-> l sun-x) 0.5)
  (set! (-> l sun-y) 0.65)
  (set! (-> l sun-z) 0.3)
  (set! (-> l sun) #xfff4e0ff)
  (set! (-> l ambient) #x7f8ba6ff)
  (set! (-> l sky) #x8fd3ffff)
  (set! (-> l fog-near) 24.0)
  (set! (-> l fog-far) 56.0)
  (set! (-> l shadow-radius) 48.0))

;; ---- The renderer ----

(define shadow-size u32 2048)

(struct mesh
  [vertices u32] [vertex-room u32]   ; the GPU buffer and its size in bytes
  [indices u32] [index-room u32]
  [index-count u32]
  [x f64] [y f64] [z f64])

(struct meshes
  [items (ptr mesh)] [count u32] [capacity u32]
  [shader scene-shader]
  [atlas-sampler u32] [atlas u32] [shadow-sampler u32] [shadow-map u32]
  [frame-uniforms u32] [frame-group u32] [material-group u32]
  ;; The origins, one 256-byte slot per mesh.
  [origins u32] [origin-slots u32] [origin-group u32]
  [dome sky]
  [shadow-pipeline u32] [lit-pipeline u32])

;; The atlas is visible to the vertex stage too, which asks it for its
;; size.
(shader scene
  [uniform frame 0 0 (vertex fragment)
    [view-projection mat4] [sun-view-projection mat4]
    [camera vec3] [shadow-texel f32]
    [sun vec3] [unused f32]
    [sun-color vec4] [ambient vec4] [sky vec4] [fog vec2]]
  [uniform-array origin 1 0 (vertex) [at vec3]]
  [sampler atlas-sampler 2 0 (fragment)]
  [texture atlas 2 1 (vertex fragment)]
  [comparison-sampler shadow-sampler 2 2 (fragment)]
  [depth-texture shadow-map 2 3 (fragment)]
  [vertex-input vertex per-vertex [position vec3] [normal vec3] [texel vec2] [shade f32] [color unorm8x4]]
  [varyings [world vec3] [normal vec3] [uv vec2] [shade f32] [color vec4] [shadow vec3]]
  [code "
// A vertex in the world, pushed out along its normal by `push`.
fn place(in: Vertex, push: f32) -> vec3f { return in.position + origin.at + in.normal * push; }

@vertex fn vertex(in: Vertex) -> Varyings {
  let world = place(in, 0.0);
  var out: Varyings;
  out.position = frame.view_projection * vec4f(world, 1.0);
  out.world = world;
  out.normal = in.normal;
  out.uv = in.texel / vec2f(textureDimensions(atlas));
  out.shade = in.shade;
  out.color = in.color;
  // The place in the shadow map: pushed along the normal first, so that
  // a surface does not shadow itself where the map is coarse.
  let s = frame.sun_view_projection * vec4f(place(in, 0.06), 1.0);
  out.shadow = vec3f(s.x * 0.5 + 0.5, 0.5 - s.y * 0.5, s.z);
  return out;
}

@vertex fn shadow(in: Vertex) -> Varyings {
  var out: Varyings;
  out.position = frame.sun_view_projection * vec4f(place(in, 0.0), 1.0);
  return out;
}

// How much of the sun reaches a point, from the shadow map: 0 to 1.
// Outside the map everything is lit.
fn sunlit(p: vec3f) -> f32 {
  if (p.x < 0.0 || p.x > 1.0 || p.y < 0.0 || p.y > 1.0 || p.z > 1.0) { return 1.0; }
  var sum = 0.0;
  for (var i = -1; i <= 1; i++) {
    for (var j = -1; j <= 1; j++) {
      sum += textureSampleCompareLevel(shadow_map, shadow_sampler, p.xy + vec2f(f32(i), f32(j)) * frame.shadow_texel, p.z - 0.0015);
    }
  }
  return sum / 9.0;
}

// The screen's sRGB to linear.
fn linear(c: vec3f) -> vec3f { return pow(c, vec3f(2.2)); }

struct Picture { @location(0) color: vec4f, @location(1) normal: vec4f }

@fragment fn fragment(in: Varyings) -> Picture {
  let albedo = linear(textureSample(atlas, atlas_sampler, in.uv).rgb * in.color.rgb);
  let n = normalize(in.normal);
  let towards_sun = normalize(frame.sun);
  // Lit or in shade, with a narrow blend between the two bands.
  let facing = smoothstep(-0.1, 0.15, dot(n, towards_sun)) * sunlit(in.shadow);
  let light = 0.15 + 0.85 * smoothstep(0.4, 0.6, facing);
  // A rim of light where a lit surface turns away from the camera.
  let v = normalize(frame.camera - in.world);
  let rim = pow(1.0 - max(dot(n, v), 0.0), 6.0) * facing * 0.25;
  let ambient = frame.ambient.rgb * mix(0.5, 1.0, in.shade);
  let color = albedo * (ambient + frame.sun_color.rgb * light * mix(0.7, 1.0, in.shade)) + frame.sun_color.rgb * rim * 0.5;
  // Fog, towards the haze at the sky's horizon (sky.sub).
  let fog = clamp((distance(frame.camera, in.world) - frame.fog.x) / (frame.fog.y - frame.fog.x), 0.0, 1.0);
  let haze = mix(frame.sky.rgb, vec3f(1.0, 1.0, 1.0), 0.5);
  var out: Picture;
  out.color = vec4f(mix(color, haze, fog), 1.0);
  out.normal = vec4f(n * 0.5 + 0.5, 1.0);
  return out;
}
"])

(define vertex-bytes u32 40)

(define (meshes-init! [r (ptr meshes)] [atlas (ptr u8)])
  (memset r 0 (sizeof meshes))
  (scene-init! (& (-> r shader)))
  (set! (-> r atlas-sampler) (gpu-sampler! gpu-nearest gpu-clamp gpu-compare-none))
  (set! (-> r atlas) (gpu-texture-file! atlas))
  (set! (-> r shadow-sampler) (gpu-sampler! gpu-linear gpu-clamp gpu-less))
  (set! (-> r shadow-map) (gpu-texture! shadow-size shadow-size 1 1 gpu-depth32f (+ gpu-sampled gpu-target)))
  (set! (-> r frame-uniforms) (gpu-buffer! (sizeof scene-frame) gpu-uniform))
  (set! (-> r frame-group) (scene-bind-group-0! (& (-> r shader)) (-> r frame-uniforms)))
  (set! (-> r material-group) (scene-bind-group-2! (& (-> r shader)) (-> r atlas-sampler) (-> r atlas) (-> r shadow-sampler) (-> r shadow-map)))
  (origins! r 16)
  (sky-init! (& (-> r dome)))
  (let ([settings render-settings])
    (render-settings-init! (& settings))
    (set! (-> settings cull) gpu-cull-back)
    (set! (-> settings depth-compare) gpu-less)
    (set! (-> settings depth-write) 1)
    ;; The shadow pipeline uses the frame and the origins only.
    (set! (-> settings depth-format) gpu-depth32f)
    (set! (-> settings target-count) 0)
    (set! (-> settings groups) 2)
    (set! (-> r shadow-pipeline) (scene-render-pipeline! (& (-> r shader)) "shadow" "" (& settings)))
    ;; The lit pipeline writes post.sub's two targets.
    (set! (-> settings depth-format) gpu-depth24)
    (set! (-> settings target-count) 2)
    (set! (@ (-> settings targets) 0) gpu-rgba16f)
    (set! (@ (-> settings targets) 1) gpu-rgba8)
    (set! (-> settings groups) 0)
    (set! (-> r lit-pipeline) (scene-render-pipeline! (& (-> r shader)) "vertex" "fragment" (& settings)))))

;; The buffer of origins, with room for `slots` meshes, and its bind
;; group, which sees one slot at a time. A bigger buffer in place of a
;; full one gets the origins of the meshes there are.
(define (origins! [r (ptr meshes)] [slots u32])
  (when (!= (-> r origins) 0)
    (gpu-destroy! gpu-kind-bind-group (-> r origin-group))
    (gpu-destroy! gpu-kind-buffer (-> r origins)))
  (set! (-> r origin-slots) slots)
  (set! (-> r origins) (gpu-buffer! (* slots scene-origin-stride) gpu-uniform))
  (set! (-> r origin-group) (scene-bind-group-1! (& (-> r shader)) (-> r origins)))
  (for ([i u32 0]) (< i (-> r count)) (+= i 1)
    (let ([m (+ (-> r items) i)])
      (origin! r i (-> m x) (-> m y) (-> m z)))))

(define (origin! [r (ptr meshes)] [mesh u32] [x f64] [y f64] [z f64])
  (let ([o scene-origin])
    (vec3! (-> o at) x y z)
    (gpu-write-copy! (-> r origins) (* mesh scene-origin-stride) (& o) (sizeof scene-origin))))

(define (meshes-add! [r (ptr meshes)]) -> u32
  (when (== (-> r count) (-> r capacity))
    (set! (-> r capacity) (if (== (-> r capacity) 0) 16 (* 2 (-> r capacity))))
    (set! (-> r items) (cast (ptr mesh) (realloc (-> r items) (* (-> r capacity) (sizeof mesh))))))
  (when (== (-> r count) (-> r origin-slots)) (origins! r (* 2 (-> r origin-slots))))
  (let ([m (+ (-> r items) (-> r count))])
    (memset m 0 (sizeof mesh))
    (+= (-> r count) 1)
    (- (-> r count) 1)))

;; A GPU buffer with room for n bytes: the one there is, or a bigger one
;; in its place.
(define (room! [id (ptr u32)] [room (ptr u32)] [n u32] [usage u32])
  (when (< (@ room) n)
    (when (!= (@ id) 0) (gpu-destroy! gpu-kind-buffer (@ id)))
    (set! (@ room) (if (== (@ room) 0) 4096 (@ room)))
    (while (< (@ room) n) (*= (@ room) 2))
    (set! (@ id) (gpu-buffer! (@ room) usage))))

(define (meshes-set! [r (ptr meshes)] [mesh u32] [vertices (ptr buffer)] [indices (ptr buffer)] [x f64] [y f64] [z f64])
  (let ([m (+ (-> r items) mesh)])
    (set! (-> m x) x)
    (set! (-> m y) y)
    (set! (-> m z) z)
    (set! (-> m index-count) (/ (-> indices length) 4))
    (when (> (-> m index-count) 0)
      (room! (& (-> m vertices)) (& (-> m vertex-room)) (-> vertices length) gpu-vertex)
      (room! (& (-> m indices)) (& (-> m index-room)) (-> indices length) gpu-index)
      (gpu-write-buffer! (-> m vertices) 0 (-> vertices bytes) (-> vertices length))
      (gpu-write-buffer! (-> m indices) 0 (-> indices bytes) (-> indices length)))
    (origin! r mesh x y z)))

;; Draws every mesh with the pipeline that is set.
(define (draw-all! [r (ptr meshes)])
  (for ([i u32 0]) (< i (-> r count)) (+= i 1)
    (let ([m (+ (-> r items) i)])
      (when (> (-> m index-count) 0)
        (gpu-bind-group-set! 1 (-> r origin-group) 1)
        (gpu-offset! (* i scene-origin-stride))
        (gpu-vertex-buffer! 0 (-> m vertices) 0)
        (gpu-index-buffer! (-> m indices) gpu-u32-indexes 0)
        (gpu-draw-indexed! (-> m index-count) 1 0 0 0)))))

(define (meshes-draw! [r (ptr meshes)] [p (ptr post)] [c (ptr camera)] [l (ptr light)])
  (let ([frame scene-frame] [view (array f32 16)] [sun-view (array f32 16)] [sun-projection (array f32 16)]
        [radius (-> l shadow-radius)]
        [length (sqrt (+ (* (-> l sun-x) (-> l sun-x)) (* (-> l sun-y) (-> l sun-y)) (* (-> l sun-z) (-> l sun-z))))])
    (memset (& frame) 0 (sizeof scene-frame))
    ;; The camera's matrix.
    (mat4-view! view (-> c x) (-> c y) (-> c z) (-> c yaw) (-> c pitch))
    (mat4-multiply! (-> frame view-projection) (-> c projection) view)
    ;; The sun's: looking at the shadow box's centre from the sun's side,
    ;; with the box in view.
    (let ([sx (/ (-> l sun-x) length)] [sy (/ (-> l sun-y) length)] [sz (/ (-> l sun-z) length)])
      (mat4-look! sun-view
                  (+ (-> l shadow-x) (* sx radius 2.0)) (+ (-> l shadow-y) (* sy radius 2.0)) (+ (-> l shadow-z) (* sz radius 2.0))
                  (-> l shadow-x) (-> l shadow-y) (-> l shadow-z))
      (mat4-orthographic! sun-projection (- 0.0 radius) radius (- 0.0 radius) radius (* radius 0.5) (* radius 3.5))
      (mat4-multiply! (-> frame sun-view-projection) sun-projection sun-view)
      (vec3! (-> frame sun) sx sy sz))
    (vec3! (-> frame camera) (-> c x) (-> c y) (-> c z))
    (set! (-> frame shadow-texel) (/ 1.0 (cast f32 shadow-size)))
    (linear-color! (-> frame sun-color) (-> l sun))
    (linear-color! (-> frame ambient) (-> l ambient))
    (linear-color! (-> frame sky) (-> l sky))
    (vec2! (-> frame fog) (-> l fog-near) (-> l fog-far))
    (gpu-write-copy! (-> r frame-uniforms) 0 (& frame) (sizeof scene-frame))
    ;; The shadow map, from the sun.
    (gpu-render-pass! 0 (-> r shadow-map) 0 0 gpu-clear 1.0)
    (gpu-pipeline! (-> r shadow-pipeline))
    (gpu-bind-group-set! 0 (-> r frame-group) 0)
    (draw-all! r)
    (gpu-end-pass!)
    ;; The scene: the sky under everything, then the meshes.
    (gpu-render-pass! 2 (post-depth p) 0 0 gpu-clear 1.0)
    (gpu-pass-target! gpu-on-texture (post-color p) 0 0 gpu-clear 0.0 0.0 0.0 1.0)
    (gpu-pass-target! gpu-on-texture (post-normals p) 0 0 gpu-clear 0.5 0.5 0.5 0.0)
    (sky-pass! (& (-> r dome)) c (-> l sun-x) (-> l sun-y) (-> l sun-z) (-> l sun) (-> l sky) (post-width p) (post-height p) (-> l time))
    (gpu-pipeline! (-> r lit-pipeline))
    (gpu-bind-group-set! 0 (-> r frame-group) 0)
    (gpu-bind-group-set! 2 (-> r material-group) 0)
    (draw-all! r)
    (gpu-end-pass!)))
