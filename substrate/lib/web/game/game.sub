;; Lifecycle: experimental.
;;
;; The game loop: what turns three functions into a game in a web page.
;;
;; A game is a "world" (a struct with everything in it) and three
;; functions:
;;
;;   (define (init [w (ptr world)]) ...)
;;       Sets the world up. Called once, before the first step. The world
;;       starts out as all zero bytes. This is the place to load sprite
;;       sheets (load-sheet in draw.sub) and sounds (load-sound in
;;       sound.sub).
;;
;;   (define (step [w (ptr world)] [in (ptr input)]) ...)
;;       Advances the world by one step: move things, check collisions,
;;       react to keys. Called 60 times a second, however fast or slow the
;;       screen is. `in` says which keys are held and which were just
;;       pressed (input.sub).
;;
;;   (define (draw [w (ptr world)]) ...)
;;       Draws the world, with the functions of draw.sub. Called once for
;;       every frame the browser displays.
;;
;; and one line that ties them together:
;;
;;   (game world [size 320 180] init step draw)
;;
;; `size` is the width and height of the game's screen in pixels. The
;; screen is a canvas with exactly that many pixels, which the browser
;; stretches to fill the window, keeping its shape and without blurring.
;; A small size such as 320 by 180 gives the blocky look of an old video
;; game, and means a sprite drawn at (10, 20) is always at (10, 20),
;; whatever the size of the window.
;;
;; The screen is drawn by the browser's 2D canvas unless the game asks
;; for the GPU:
;;
;;   (game world [size 320 180] [renderer gpu] init step draw)
;;
;; The game is written the same either way. With the GPU, the sprites
;; are drawn by WebGPU (../scene/sprites.sub, on ../gpu.sub), which draws tens of
;; thousands of them in the time the canvas takes for a few hundred, and
;; the text is drawn on a see-through canvas over the screen. A browser
;; without WebGPU stops such a game with a message saying so.
;;
;; A game that looks around with the mouse asks for the pointer:
;;
;;   (game world [size 640 360] [renderer gpu] [pointer lock] init step draw)
;;
;; Clicking the screen then locks the pointer to it: the cursor goes,
;; and the mouse's movement reaches the game's step function through
;; the input (mouse-dx and mouse-dy in input.sub), as the mouse buttons
;; do. Escape frees the pointer; the click that locks it again is not
;; passed to the game. Without the option the buttons still reach the
;; game, but the movement does not.
;;
;; What the loop takes care of:
;;   - calling `step` at a steady 60 times a second. Screens refresh at
;;     different rates, so on each frame it works out how many steps are
;;     due: often one, sometimes none or two. After a long pause (the tab
;;     was in the background) it does not try to catch up;
;;   - keeping the input up to date from the browser's key events, and
;;     stopping the arrow keys and Space from scrolling the page;
;;   - waiting until the images and sounds have loaded before the first
;;     step;
;;   - playing the sounds and the music that the game asked for
;;     (sound.sub);
;;   - redrawing on every frame;
;;   - stopping the game if it traps. A trap is what happens when the
;;     program cannot go on: it found a mistake in itself, such as an
;;     index that is out of range (trap.sub), or it did something
;;     impossible, such as dividing by zero. The loop then takes no more
;;     steps, and shows the message, with the list of functions that were
;;     running, on top of the screen. (Without this the game would simply
;;     freeze, and the message would only be in the browser's console.)
;;
;; `step` and `draw` only use input.sub, sound.sub, timers.sub, tiles.sub
;; and draw.sub, none of which needs a browser. So a game's world can be
;; put in a file of its own and played by a test, with made-up key
;; presses (see tests/ui/platformer.sub).
;;
;; A game's page must give the program three host modules, "dom",
;; "audio" and "gpu" (see lib/web/examples/platformer/page.html). The
;; "gpu" module is only used by a game that asks for the GPU, but the
;; loop is linked to it either way, so it must be there.
;;
;; How it is built: `game` is a macro. It expands into an ordinary page
;; program (../web.sub): a model that holds the world and the loop's own
;; state, messages for frames and keys, an update function, and a view
;; with one canvas, or, for the GPU, two: the screen, and the overlay
;; for text.
(require-unqualified base "../../../compiler/base/base.sub")
(require-unqualified ui "../ui.sub")
(require-unqualified web "../web.sub")
(require-unqualified gpu "../gpu.sub")
(require-unqualified input "input.sub")
(require-unqualified sound "sound.sub")
(require-unqualified draw "draw.sub")
(require-unqualified trap "trap.sub")

(provide game)

(memory from base)
(table from base)

;; From the page: whether the browser should be kept from doing what it
;; usually does with an event (scrolling on an arrow key, opening a menu
;; on a right click).
;; From the browser: sound (host/web/audio.mjs documents each function),
;; how many images are still loading (host/web/dom.mjs), and the GPU
;; (host/web/gpu.mjs): the commands written during a frame are handed
;; over at its end, and the host's events for the program (the data of
;; one is read with take) say what went wrong.
(import audio-tone "audio" "tone" (i32 f64 f64 f64 f64 ->))
(import audio-load "audio" "load" (i32 i32 i32 ->))
(import audio-loading "audio" "loading" (-> i32))
(import audio-play "audio" "play" (i32 f64 f64 i32 -> i32))
(import audio-stop "audio" "stop" (i32 ->))
(import dom-images-loading "dom" "images_loading" (-> i32))
(import gpu-apply "gpu" "apply" (i32 i32 ->))
(import gpu-take "gpu" "take" (i32 i32 -> i32))
(import gpu-loading "gpu" "loading" (-> i32))
;; From every host: the report of the last trap (spec 4).
(import host-error-message "host" "error_message" (i32 i32 -> i32))

;; ---- The loop's own state ----

(struct game-loop
  ;; The keys, as the game's step function sees them.
  [input input]
  ;; The length of one step, in milliseconds.
  [step-ms f64]
  ;; 1 once `last-time` holds the time of the previous frame.
  [timed i32]
  [last-time f64]
  ;; Time that has passed but has not been used up by a step yet.
  [pending f64]
  ;; A counter of frames. The canvas is redrawn whenever it changes, which
  ;; is on every frame.
  [frame u32]
  ;; 1 once the game's init function has been called.
  [started i32]
  ;; The number the browser gave the music that is playing, or 0.
  [music i32]
  ;; With the GPU renderer: the node number of the screen's canvas, which
  ;; the view stores here when the canvas is created ([node ...] in
  ;; ../ui.sub), and the GPU surface made for it, both 0 until then.
  [surface-node u32]
  [surface u32]
  ;; With [pointer lock]: 1, and the number the view watches to ask for
  ;; the lock ([pointer-lock ...] in ../ui.sub): a click that finds the
  ;; pointer free changes it.
  [wants-pointer i32]
  [lock-requests u32]
  ;; 1 once the game has stopped because of a trap, and the report of the
  ;; trap: its message, then the functions that were running.
  [stopped i32]
  [problem (array u8 2048)])

;; The most steps taken on one frame. If more time than that has built up,
;; the rest is dropped: the game falls behind real time instead of rushing
;; ahead to catch up.
(define max-steps u32 5)

(define (game-loop-start! [l (ptr game-loop)] [steps-per-second f64])
  (set! (-> l step-ms) (/ 1000.0 steps-per-second))
  (set! (-> l timed) 0)
  (set! (-> l pending) 0.0))

;; Called on every frame with the frame's time, in milliseconds. Returns
;; how many steps of the game to run now.
(define (game-loop-steps! [l (ptr game-loop)] [now f64]) -> u32
  (cond
    ;; Nothing happens until the images, sounds and sprite sheets have
    ;; arrived. The clock starts afterwards.
    [(> (+ (dom-images-loading) (audio-loading) (gpu-loading)) 0)
     (set! (-> l timed) 0)
     0]
    ;; The first frame only records the time.
    [(not (-> l timed))
     (set! (-> l timed) 1)
     (set! (-> l last-time) now)
     (set! (-> l pending) 0.0)
     0]
    [else
     (let ([steps u32 0])
       (+= (-> l pending) (- now (-> l last-time)))
       (set! (-> l last-time) now)
       (while (and (>= (-> l pending) (-> l step-ms)) (< steps max-steps))
         (-= (-> l pending) (-> l step-ms))
         (+= steps 1))
       (when (>= (-> l pending) (-> l step-ms)) (set! (-> l pending) 0.0))
       steps)]))

;; Returns 1 the first time it is called and 0 afterwards. The game's
;; init function runs when it returns 1: on the first frame, not when the
;; page loads, so that a trap in it is shown like any other. `started` is
;; set before init runs, so that an init that traps is not run again.
(define (game-loop-first-frame? [l (ptr game-loop)]) -> i32
  (if (-> l started)
      0
      (begin
        (set! (-> l started) 1)
        1)))

;; Returns 1 while the game is running: it has been set up and has not
;; stopped. Only then is the world drawn.
(define (game-loop-running? [l (ptr game-loop)]) -> i32 (and (-> l started) (not (-> l stopped))))

(define (game-loop-stopped? [l (ptr game-loop)]) -> i32 (-> l stopped))

;; Called after a trap: stops the game and its music, and keeps the
;; host's report of the trap, to be shown on the page. The first report
;; is the one kept: a later trap, such as the GPU's "invalid due to a
;; previous error" after the error itself, says less.
(define (game-loop-trapped! [l (ptr game-loop)])
  (unless (-> l stopped)
    (let ([n (host-error-message (cast i32 (-> l problem)) 2047)])
      (set! (@ (-> l problem) (if (< n 2047) n 2047)) 0)))
  (when (!= (-> l music) 0)
    (audio-stop (-> l music))
    (set! (-> l music) 0))
  (set! (-> l stopped) 1))

(define (game-loop-problem [l (ptr game-loop)]) -> (ptr u8) (-> l problem))

;; Called after each step: presses and releases are reported for one step
;; only.
(define (game-loop-step-done! [l (ptr game-loop)]) (input-end-step! (& (-> l input))))

;; With the GPU renderer: whether the world is drawn on this frame, which
;; is once the game is running and the screen's canvas is on the page
;; (the view reports it after the first frame). Makes the GPU surface
;; for the canvas the first time. The frame is then drawn between
;; draw-begin! and draw-end! (draw.sub).
(define (game-loop-drawing? [l (ptr game-loop)]) -> i32
  (if (and (game-loop-running? l) (!= (-> l surface-node) 0))
      (begin
        (when (== (-> l surface) 0) (set! (-> l surface) (gpu-surface! (-> l surface-node))))
        1)
      0))

(define (game-loop-surface [l (ptr game-loop)]) -> u32 (-> l surface))

;; An event from the GPU: something went wrong, which stops the game with
;; the message, as a trap would. The other events (a sheet has loaded,
;; data read back) are of no interest to the loop.
(define (game-loop-gpu-event! [kind u32] [id u32])
  (when (== kind gpu-error)
    (let* ([n (gpu-take 0 0)] [message (cast (ptr u8) (malloc (+ n 1)))])
      (gpu-take (cast i32 message) n)
      (set! (@ message n) 0)
      (trap-format "gpu: ~s" message))))

;; Called at the end of every frame: hands the browser what the game
;; asked for during the frame (sound files to load, tones and sounds to
;; play, a change of music, the GPU's commands), and makes the canvas
;; redraw.
(define (game-loop-frame-done! [l (ptr game-loop)])
  (let ([commands (gpu-commands)])
    (when (> (-> commands length) 0)
      (gpu-apply (cast i32 (-> commands bytes)) (cast i32 (-> commands length))))
    (gpu-commands-done!))
  (for ([i u32 0]) (< i (sound-files-waiting)) (+= i 1)
    (let ([f (sound-file-at i)])
      (audio-load (cast i32 (-> f id)) (cast i32 (-> f path)) (cast i32 (strlen (-> f path))))))
  (sound-files-clear!)
  (for ([i u32 0]) (< i (tones-waiting)) (+= i 1)
    (let ([t (tone-at i)])
      (audio-tone (cast i32 (-> t wave)) (-> t from) (-> t to) (-> t ms) (-> t volume))))
  (tones-clear!)
  (for ([i u32 0]) (< i (sounds-waiting)) (+= i 1)
    (let ([s (sound-at i)])
      (audio-play (cast i32 (-> s sound)) (-> s volume) 1.0 0)))
  (sounds-clear!)
  ;; Music: a sound that loops. Starting a piece stops the one before.
  (when (!= (music-change) music-same)
    (when (!= (-> l music) 0)
      (audio-stop (-> l music))
      (set! (-> l music) 0))
    (when (== (music-change) music-start)
      (set! (-> l music) (audio-play (cast i32 (music-sound)) (music-volume) 1.0 1)))
    (music-change-clear!))
  (+= (-> l frame) 1))

;; A key went down (down = 1) or came up (down = 0). `name` is the key's
;; name as the browser gives it. Returns 1 if the browser should be
;; stopped from using the key itself: the arrow keys and Space would
;; scroll the page.
(define (game-loop-key! [l (ptr game-loop)] [name (ptr u8)] [down i32]) -> i32
  (let ([code (key-code name)])
    (if down
        (input-key-down! (& (-> l input)) code)
        (input-key-up! (& (-> l input)) code))
    (or (== code key-left) (== code key-right) (== code key-up) (== code key-down) (== code key-space))))

;; The window lost the keyboard focus: the key-up events of keys that are
;; still held will never arrive, so forget them.
(define (game-loop-blur! [l (ptr game-loop)]) (input-clear! (& (-> l input))))

;; A mouse button went down on the screen. With [pointer lock], a click
;; while the pointer is free asks for the lock instead of reaching the
;; game.
(define (game-loop-mouse-down! [l (ptr game-loop)] [button i32])
  (if (and (-> l wants-pointer) (not (mouse-locked? (& (-> l input)))))
      (+= (-> l lock-requests) 1)
      (input-mouse-down! (& (-> l input)) (cast u32 button))))

(define (game-loop-mouse-up! [l (ptr game-loop)] [button i32]) (input-mouse-up! (& (-> l input)) (cast u32 button)))

;; The mouse moved. Its movement is for the game only while the pointer
;; is locked: a free mouse is just crossing the page.
(define (game-loop-mouse-moved! [l (ptr game-loop)] [dx i32] [dy i32])
  (when (mouse-locked? (& (-> l input)))
    (input-mouse-move! (& (-> l input)) (cast f64 dx) (cast f64 dy))))

;; The pointer became locked or free. A button held when the lock ends
;; may never report coming up, so the buttons are forgotten then.
(define (game-loop-pointer! [l (ptr game-loop)] [locked i32])
  (input-mouse-lock! (& (-> l input)) locked)
  (unless locked
    (input-mouse-up! (& (-> l input)) mouse-left)
    (input-mouse-up! (& (-> l input)) mouse-middle)
    (input-mouse-up! (& (-> l input)) mouse-right)))

;; ---- The `game` form ----

(begin-for-syntax
  (require-unqualified base "../../../compiler/base/base.sub")
  (require-unqualified kd "../../../compiler/kernel.sub")
  (require sm "../../../compiler/base/syntax-match.sub" syntax-match _ ... ?)

  ;; Expands (game World [size width height] option ... init step draw),
  ;; where the options are [renderer r] and [pointer lock], into a page
  ;; program:
  ;;   game-state     the model: the world, and the loop's state
  ;;   game-message   one message for a frame, two for keys, one for the
  ;;                  window losing the focus, four for the mouse, one
  ;;                  for the menu a right click would open
  ;;   game-update    on the first frame, calls the game's init function;
  ;;                  runs the steps that are due on a frame; with the
  ;;                  GPU, then draws the world; passes key events to the
  ;;                  loop
  ;;   game-trapped   called after a trap: stops the game
  ;;   on-gpu         the GPU's events: an error stops the game
  ;;   game-screen    the view. Its listeners are on the window, so keys
  ;;                  work without anything being clicked first. With the
  ;;                  canvas renderer it is one canvas, drawn by the game's
  ;;                  draw function whenever the frame counter changes;
  ;;                  with the GPU it is the screen's canvas, which the
  ;;                  GPU draws on, under a see-through canvas for the
  ;;                  text, in a box. The style makes the browser stretch
  ;;                  the canvas to fill the window, keeping its shape and
  ;;                  its hard pixel edges. When the game has stopped, a
  ;;                  panel with the report of the trap is shown on top.
  (define (game-form [s datum]) -> datum
    (syntax-match s
      [(_ world ((? identifier? word) width height) rest ...)
       (unless (and (== (syntax-e word) 'size) (integer? (syntax-e width)) (integer? (syntax-e height)))
         (raise-syntax-error 'game '"expected (game World [size width height] init step draw), with the width and height written as numbers" s))
       ;; The options come first, each a list of two words; what is left
       ;; must be the three functions.
       (let ([renderer #'canvas] [pointer 0] [functions rest])
         (while (and (pair? functions) (option? (car functions)))
           (let* ([l (syntax->list (car functions))] [name (syntax-e (car l))] [value (syntax-e (cadr l))])
             (cond [(== name 'renderer)
                    (unless (or (== value 'canvas) (== value 'gpu))
                      (raise-syntax-error 'game '"the renderer must be canvas or gpu" (cadr l)))
                    (set! renderer (cadr l))]
                   [(== name 'pointer)
                    (unless (== value 'lock) (raise-syntax-error 'game '"expected [pointer lock]" (car functions)))
                    (set! pointer 1)]
                   [else (raise-syntax-error 'game '"the options are [renderer canvas], [renderer gpu] and [pointer lock]" (car functions))]))
           (set! functions (cdr functions)))
         (unless (== (length functions) 3)
           (raise-syntax-error 'game '"expected (game World [size width height] option ... init step draw)" s))
         (game-form-with s world width height renderer pointer (car functions) (cadr functions) (caddr functions)))]))

  ;; Whether a form is an option: [word word].
  (define (option? [x datum]) -> i32
    (let ([l (syntax->list x)])
      (and (!= l 0) (== (length l) 2) (identifier? (car l)) (identifier? (cadr l)))))

  (define (game-form-with [s datum] [world datum] [width datum] [height datum] [renderer datum] [pointer i32]
                          [init datum] [step datum] [draw datum]) -> datum
    (let* ([on-gpu (== (syntax-e renderer) 'gpu)]
           [fill (format '"width: min(100vw, calc(100vh * ~a / ~a));" `(,(syntax-e width) ,(syntax-e height)))]
           [style (datum->syntax #'here (string-append '"display: block; margin: 0 auto; image-rendering: pixelated; " fill) 0)]
           [box-style (datum->syntax #'here (string-append '"position: relative; margin: 0 auto; " fill) 0)]
           [layer-style (datum->syntax #'here '"display: block; width: 100%; image-rendering: pixelated;" 0)]
           [overlay-style (datum->syntax #'here '"display: block; width: 100%; position: absolute; left: 0; top: 0; pointer-events: none;" 0)]
           ;; The attributes of the canvas that gets the events, as a list
           ;; to splice into its attribute list. The screen asks for the
           ;; pointer when the loop's count of requests changes.
           [common (syntax->list #`([width #,width] [height #,height]
                                    [on-window frame (game-frame (event time))]
                                    [on-window keydown (game-key-down (event key))]
                                    [on-window keyup (game-key-up (event key))]
                                    [on-window blur game-blurred]
                                    [on mousedown (game-mouse-down (event button))]
                                    [on-window mouseup (game-mouse-up (event button))]
                                    [on-window mousemove (game-mouse-moved (event movement-x) (event movement-y))]
                                    [on-window pointerlockchange (game-pointer (event locked))]
                                    #,@(if pointer
                                           (syntax->list #`([pointer-lock (-> g loop lock-requests)] [on contextmenu game-menu]))
                                           nil)))]
           [screen (if on-gpu
                       #`(div ([style #,box-style])
                           (canvas (#,@common [style #,layer-style] [node (-> g loop surface-node)]))
                           (canvas ([width #,width] [height #,height] [style #,overlay-style]
                                    [draw (-> g loop frame) (when (game-loop-running? (& (-> g loop))) (draw-overlay!))])))
                       #`(canvas (#,@common [style #,style]
                                  [draw (-> g loop frame)
                                        (when (game-loop-running? (& (-> g loop)))
                                          (draw-begin! 0)
                                          (#,draw (& (-> g world))))])))])
      #`(begin
          (struct game-state [world #,world] [loop game-loop])
          (variant game-message
            [game-frame [time f64]] [game-key-down [key (ptr u8)]] [game-key-up [key (ptr u8)]] [game-blurred]
            [game-mouse-down [button i32]] [game-mouse-up [button i32]] [game-mouse-moved [dx i32] [dy i32]]
            [game-pointer [locked i32]] [game-menu])
          (messages game-message)
          (define (game-init [g (ptr game-state)])
            (game-loop-start! (& (-> g loop)) 60.0)
            (set! (-> g loop wants-pointer) #,(datum->syntax #'here (make-integer pointer) 0))
            (draw-start! #,(datum->syntax #'here (make-integer (if on-gpu 1 0)) 0) #,width #,height))
          (define (game-update [g (ptr game-state)] [e (ptr game-message)])
            (match e
              [(game-frame time)
               (unless (game-loop-stopped? (& (-> g loop)))
                 (when (game-loop-first-frame? (& (-> g loop))) (#,init (& (-> g world))))
                 (let ([steps (game-loop-steps! (& (-> g loop)) time)])
                   (for ([i u32 0]) (< i steps) (+= i 1)
                     (#,step (& (-> g world)) (& (-> g loop input)))
                     (game-loop-step-done! (& (-> g loop)))))
                 #,@(if on-gpu
                        `(,#`(when (game-loop-drawing? (& (-> g loop)))
                                (draw-begin! (game-loop-surface (& (-> g loop))))
                                (#,draw (& (-> g world)))
                                (draw-end!)))
                        nil)
                 (game-loop-frame-done! (& (-> g loop))))]
              [(game-key-down key) (when (game-loop-key! (& (-> g loop)) key 1) (prevent-default!))]
              [(game-key-up key) (game-loop-key! (& (-> g loop)) key 0)]
              [game-blurred (game-loop-blur! (& (-> g loop)))]
              [(game-mouse-down button) (game-loop-mouse-down! (& (-> g loop)) button)]
              [(game-mouse-up button) (game-loop-mouse-up! (& (-> g loop)) button)]
              [(game-mouse-moved dx dy) (game-loop-mouse-moved! (& (-> g loop)) dx dy)]
              [(game-pointer locked) (game-loop-pointer! (& (-> g loop)) locked)]
              [game-menu (prevent-default!)]))
          (define (game-trapped [g (ptr game-state)]) (game-loop-trapped! (& (-> g loop))))
          (define (on-gpu [kind u32] [id u32]) (game-loop-gpu-event! kind id))
          (view (game-screen [g (ptr game-state)])
            #,screen
            (when (game-loop-stopped? (& (-> g loop)))
              (div ([class "game-stopped"]
                    [style "position: fixed; left: 0; top: 0; right: 0; max-height: 100vh; overflow: auto; box-sizing: border-box; padding: 12px 16px; background: #5c1a1a; color: #ffffff; font: 13px/1.5 monospace;"])
                (p ([style "margin: 0 0 8px 0; font-weight: bold;"]) "The game has stopped.")
                (pre ([style "margin: 0; white-space: pre-wrap;"]) (text (game-loop-problem (& (-> g loop))))))))
          (app game-state game-message game-init game-update game-screen game-trapped)))))

(define-syntax game game-form)
