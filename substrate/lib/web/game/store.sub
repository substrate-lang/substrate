;; Lifecycle: experimental.
;;
;; A store: a collection of objects of one type that come and go, such as
;; the enemies or the bullets of a game.
;;
;; This file is part of the game library. It is not a standard library of
;; the language.
;;
;;   (struct world [enemies (store enemy)] ...)
;;
;; A store whose bytes are all zero is an empty store, so one that is a
;; field of a struct that starts out as zeros needs no setting up. In all
;; of the following, `s` is a pointer to the store.
;;
;;   (store-add! s)       Adds an object and returns a pointer to it. The
;;                        new object is all zero bytes.
;;   (store-count s)      Returns how many objects the store holds.
;;   (store-each ([e s]) body ...)
;;                        Runs the body once for each object, with e a
;;                        pointer to the object.
;;   (store-each ([e h s]) body ...)
;;                        The same, with h the object's handle (see
;;                        below).
;;   (store-clear! s)     Removes every object.
;;   (store-free! s)      Removes every object and gives the memory back.
;;                        The store can be used again, but handles from
;;                        before must not be: one could match a new
;;                        object. Use store-clear! to start over.
;;
;; Handles. An object can be removed at any time. So a pointer to an
;; object is only good for a short while: inside the body of a
;; store-each, or straight after store-add!. To remember an object for
;; later (the enemy that a missile follows, the object that a timer is
;; about), keep its handle instead, which is a value of type (handle T)
;; for a (store T):
;;
;;   (store-handle s p)   Returns the handle of the object at p.
;;   (store-find s h)     Returns a pointer to the object, or 0 if it has
;;                        been removed.
;;   (store-get s h)      Returns a pointer to the object, for when the
;;                        object must still be there: if it has been
;;                        removed, the program stops with a message
;;                        (trap.sub).
;;   (store-remove! s h)  Removes the object. Returns 1, or 0 if it had
;;                        already been removed.
;;
;; A handle that is all zero bytes refers to no object, so a handle field
;; of a struct that starts out as zeros means "none": store-find gives 0
;; for it.
;;
;; What this protects against. With a plain pointer, code that remembers
;; an object which has since been removed reads and writes whatever now
;; occupies that memory, without any sign that something is wrong. A
;; handle cannot do that: store-find answers "it is gone". The compiler
;; also checks that a handle is used with a store of the same type: a
;; (handle coin) given to a (store enemy) is a compile error.
;;
;; How it works. The objects live in numbered slots, in a vector
;; (vector.sub), so an object never moves. Each slot has a "generation":
;; a count that goes up by one when an object is put in the slot and
;; again when it is removed. It is therefore odd exactly while the slot is
;; in use. A handle holds a slot's number and the generation the slot had
;; when the handle was made. The handle is good while the slot's
;; generation is still the same. Free slots are kept on a list, and the
;; slot freed last is used again first.
;;
;; The body of a store-each may add and remove objects. An object that is
;; added there may or may not be visited by the same loop.
(require-unqualified base "../../../compiler/base/base.sub")
(require-unqualified trap "trap.sub")
(require-unqualified vector "vector.sub")

(provide store handle store-add! store-count store-handle store-find store-get store-remove! store-clear! store-free!
         store-each)

(memory from base)
(table from base)

;; One slot.
;;   generation   see above
;;   link         while the slot is in use: its own number. While it is
;;                free: the number of the next free slot, plus 1 (0 if
;;                there is none).
;;   item         the object
(struct #:forall (T) store-slot [generation u32] [link u32] [item T])

(struct #:forall (T) handle [index u32] [generation u32])

;;   slots   every slot, in use or free
;;   free    the number of the first free slot, plus 1 (0 if there is none)
;;   live    how many slots are in use
(struct #:forall (T) store [slots (vector (store-slot T))] [free u32] [live u32])

(define #:forall (T) (store-count [s (ptr (store T))]) -> u32 (-> s live))

(define #:forall (T) (store-add! [s (ptr (store T))]) -> (ptr T)
  (let ([index (-> s free)] [slot (ptr (store-slot T)) 0])
    (if (!= index 0)
        (begin
          (-= index 1)
          (set! slot (vector-at-unchecked (& (-> s slots)) index))
          (set! (-> s free) (-> slot link))
          (memset (& (-> slot item)) 0 (sizeof T)))
        ;; No free slot: a new one, which vector-add! fills with zeros.
        (begin
          (set! index (vector-count (& (-> s slots))))
          (set! slot (vector-add! (& (-> s slots))))))
    (+= (-> slot generation) 1)
    (set! (-> slot link) index)
    (+= (-> s live) 1)
    (& (-> slot item))))

(define #:forall (T) (store-find [s (ptr (store T))] [h (handle T)]) -> (ptr T)
  (if (< (-> h index) (vector-count (& (-> s slots))))
      (let ([slot (vector-at-unchecked (& (-> s slots)) (-> h index))])
        (if (== (-> slot generation) (-> h generation)) (& (-> slot item)) 0))
      0))

(define #:forall (T) (store-get [s (ptr (store T))] [h (handle T)]) -> (ptr T)
  (let ([p (store-find s h)])
    (when (== p 0)
      (trap (if (== (-> h generation) 0)
                "store-get: this handle refers to no object"
                "store-get: the object that this handle refers to has been removed")))
    p))

;; The slot's header lies just before the object, so the object's
;; address gives the slot's. The handle read from there is then checked
;; against the store: if `p` is not the address of one of this store's
;; objects, the check fails and the program stops, instead of returning a
;; handle made of unrelated bytes.
(define #:forall (T) (store-handle [s (ptr (store T))] [p (ptr T)]) -> (handle T)
  (let ([slot (cast (ptr (store-slot T)) (- (cast (ptr u8) p) (offsetof (store-slot T) item)))] [h (handle T)])
    (set! (-> h index) (-> slot link))
    (set! (-> h generation) (-> slot generation))
    (when (!= (store-find s h) p) (trap "store-handle: this is not the address of an object in the store"))
    h))

(define #:forall (T) (store-remove! [s (ptr (store T))] [h (handle T)]) -> i32
  (if (== (store-find s h) 0)
      0
      (let ([slot (vector-at-unchecked (& (-> s slots)) (-> h index))])
        (+= (-> slot generation) 1)
        (set! (-> slot link) (-> s free))
        (set! (-> s free) (+ (-> h index) 1))
        (-= (-> s live) 1)
        1)))

;; Every slot becomes free. The free list is rebuilt from the last slot
;; to the first, so that it starts at slot 0 and the store fills up in
;; order again.
(define #:forall (T) (store-clear! [s (ptr (store T))])
  (set! (-> s free) 0)
  (for ([i (vector-count (& (-> s slots)))]) (> i 0) (-= i 1)
    (let ([slot (vector-at-unchecked (& (-> s slots)) (- i 1))])
      (when (== (bit-and (-> slot generation) 1) 1) (+= (-> slot generation) 1))
      (set! (-> slot link) (-> s free))
      (set! (-> s free) i)))
  (set! (-> s live) 0))

(define #:forall (T) (store-free! [s (ptr (store T))])
  (vector-free! (& (-> s slots)))
  (set! (-> s free) 0)
  (set! (-> s live) 0))

;; For store-each: the number of slots, and the object in slot i, or 0 if
;; the slot is free, and its handle. store-each only asks for slots below
;; the count, so these do not check i again. (The same holds elsewhere in
;; this file: a slot number that was just compared with the count, or
;; that the store produced itself, is used without a second check.)
(define #:forall (T) (store-slot-count [s (ptr (store T))]) -> u32 (vector-count (& (-> s slots))))

(define #:forall (T) (store-item-at [s (ptr (store T))] [i u32]) -> (ptr T)
  (let ([slot (vector-at-unchecked (& (-> s slots)) i)])
    (if (== (bit-and (-> slot generation) 1) 1) (& (-> slot item)) 0)))

(define #:forall (T) (store-handle-at [s (ptr (store T))] [i u32]) -> (handle T)
  (let ([h (handle T)])
    (set! (-> h index) i)
    (set! (-> h generation) (-> (vector-at-unchecked (& (-> s slots)) i) generation))
    h))

;; The code below runs at compile time. It turns
;;
;;   (store-each ([e h s]) body ...)
;;
;; into a loop over the slots that skips the free ones:
;;
;;   (let ([the-store s])
;;     (for ([i u32 0]) (< i (store-slot-count the-store)) (+= i 1)
;;       (let ([e (store-item-at the-store i)])
;;         (when (!= e 0)
;;           (let ([h (store-handle-at the-store i)]) body ...)))))
(begin-for-syntax
  (require-unqualified base "../../../compiler/base/base.sub")
  (require-unqualified kd "../../../compiler/kernel.sub")
  (require sm "../../../compiler/base/syntax-match.sub" syntax-match _ ... ?)

  (define (store-each-form [s datum]) -> datum
    (syntax-match s
      [(_ (((? identifier? x) store)) body0 body ...)
       #`(let ([the-store #,store])
           (for ([i u32 0]) (< i (store-slot-count the-store)) (+= i 1)
             (let ([#,x (store-item-at the-store i)])
               (when (!= #,x 0) #,body0 #,@body))))]
      [(_ (((? identifier? x) (? identifier? h) store)) body0 body ...)
       #`(let ([the-store #,store])
           (for ([i u32 0]) (< i (store-slot-count the-store)) (+= i 1)
             (let ([#,x (store-item-at the-store i)])
               (when (!= #,x 0)
                 (let ([#,h (store-handle-at the-store i)]) #,body0 #,@body)))))]
      [_ (raise-syntax-error
          'store-each
          '"expected (store-each ([object store]) body ...) or (store-each ([object handle store]) body ...)"
          s)])))

(define-syntax store-each store-each-form)
