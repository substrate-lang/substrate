;; A store: objects of one type that come and go, remembered by handles.
(require-unqualified trap "trap.sub")
(require-unqualified vector "vector.sub")

(provide store handle store-add! store-count store-handle store-find store-get store-remove! store-clear! store-free!
         store-each)

;; generation is odd while the slot is in use; a handle is good while it is unchanged.
;; link is the slot's own number while in use, else the next free slot's plus 1 (0: none).
(struct #:forall (T) store-slot [generation u32] [link u32] [item T])

(struct #:forall (T) handle [index u32] [generation u32])

(struct #:forall (T) store [slots (vector (store-slot T))] [free u32] [live u32])

(define #:forall (T) (store-count [s (ptr (store T))]) -> u32 (-> s live))

(define #:forall (T) (store-add! [s (ptr (store T))]) -> (ptr T)
  (let ([index (-> s free)] [slot (ptr (store-slot T)) 0])
    (if (!= index 0)
        (begin
          (-= index 1)
          (set! slot (vector-at-unchecked (& (-> s slots)) index))
          (set! (-> s free) (-> slot link))
          (memset (& (-> slot item)) 0 (sizeof T)))
        (begin
          (set! index (vector-count (& (-> s slots))))
          (set! slot (vector-add! (& (-> s slots))))))
    (+= (-> slot generation) 1)
    (set! (-> slot link) index)
    (+= (-> s live) 1)
    (& (-> slot item))))

(define #:forall (T) (store-find [s (ptr (store T))] [h (handle T)]) -> (ptr T)
  (if (< (-> h index) (vector-count (& (-> s slots))))
      (let ([slot (vector-at-unchecked (& (-> s slots)) (-> h index))])
        (if (== (-> slot generation) (-> h generation)) (& (-> slot item)) 0))
      0))

(define #:forall (T) (store-get [s (ptr (store T))] [h (handle T)]) -> (ptr T)
  (let ([p (store-find s h)])
    (when (== p 0)
      (trap (if (== (-> h generation) 0)
                "store-get: this handle refers to no object"
                "store-get: the object that this handle refers to has been removed")))
    p))

(define #:forall (T) (store-handle [s (ptr (store T))] [p (ptr T)]) -> (handle T)
  (let ([slot (cast (ptr (store-slot T)) (- (cast (ptr u8) p) (offsetof (store-slot T) item)))] [h (handle T)])
    (set! (-> h index) (-> slot link))
    (set! (-> h generation) (-> slot generation))
    (when (!= (store-find s h) p) (trap "store-handle: this is not the address of an object in the store"))
    h))

(define #:forall (T) (store-remove! [s (ptr (store T))] [h (handle T)]) -> i32
  (if (== (store-find s h) 0)
      0
      (let ([slot (vector-at-unchecked (& (-> s slots)) (-> h index))])
        (+= (-> slot generation) 1)
        (set! (-> slot link) (-> s free))
        (set! (-> s free) (+ (-> h index) 1))
        (-= (-> s live) 1)
        1)))

;; Rebuilt from the last slot down, so that the free list starts at slot 0.
(define #:forall (T) (store-clear! [s (ptr (store T))])
  (set! (-> s free) 0)
  (for ([i (vector-count (& (-> s slots)))]) (> i 0) (-= i 1)
    (let ([slot (vector-at-unchecked (& (-> s slots)) (- i 1))])
      (when (== (bit-and (-> slot generation) 1) 1) (+= (-> slot generation) 1))
      (set! (-> slot link) (-> s free))
      (set! (-> s free) i)))
  (set! (-> s live) 0))

(define #:forall (T) (store-free! [s (ptr (store T))])
  (vector-free! (& (-> s slots)))
  (set! (-> s free) 0)
  (set! (-> s live) 0))

;; store-each asks only for slots below the count, so these take them unchecked.
(define #:forall (T) (store-slot-count [s (ptr (store T))]) -> u32 (vector-count (& (-> s slots))))

(define #:forall (T) (store-item-at [s (ptr (store T))] [i u32]) -> (ptr T)
  (let ([slot (vector-at-unchecked (& (-> s slots)) i)])
    (if (== (bit-and (-> slot generation) 1) 1) (& (-> slot item)) 0)))

(define #:forall (T) (store-handle-at [s (ptr (store T))] [i u32]) -> (handle T)
  (let ([h (handle T)])
    (set! (-> h index) i)
    (set! (-> h generation) (-> (vector-at-unchecked (& (-> s slots)) i) generation))
    h))

(begin-for-syntax
  (require-unqualified macros "../../../compiler/macros.sub")

  (define (store-each-form [s datum]) -> datum
    (syntax-match s
      [(_ (((? identifier? x) store)) body0 body ...)
       #`(let ([the-store #,store])
           (for ([i u32 0]) (< i (store-slot-count the-store)) (+= i 1)
             (let ([#,x (store-item-at the-store i)])
               (when (!= #,x 0) #,body0 #,@body))))]
      [(_ (((? identifier? x) (? identifier? h) store)) body0 body ...)
       #`(let ([the-store #,store])
           (for ([i u32 0]) (< i (store-slot-count the-store)) (+= i 1)
             (let ([#,x (store-item-at the-store i)])
               (when (!= #,x 0)
                 (let ([#,h (store-handle-at the-store i)]) #,body0 #,@body)))))]
      [_ (raise-syntax-error
          'store-each
          '"expected (store-each ([object store]) body ...) or (store-each ([object handle store]) body ...)"
          s)])))

(define-syntax store-each store-each-form)
