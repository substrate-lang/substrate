;; Timers for games: things that happen later.
(require-unqualified base "../../../compiler/base/base.sub")

(provide timers after! timers-step! timer-due! timers-waiting timers-clear! timers-free!)

(struct #:forall (M) timer [left u32] [message M])

;; All zero bytes are a valid set of no timers, so a struct field needs no setting up.
(struct #:forall (M) timers [items (ptr (timer M))] [count u32] [room u32])

(define #:forall (M) (after! [t (ptr (timers M))] [steps u32] [message M])
  (when (== (-> t count) (-> t room))
    (set! (-> t room) (if (== (-> t room) 0) 8 (* 2 (-> t room))))
    (set! (-> t items) (cast (ptr (timer M)) (realloc (-> t items) (* (-> t room) (sizeof (timer M)))))))
  (let ([item (+ (-> t items) (-> t count))])
    (set! (-> item left) (if (== steps 0) 1 steps)) ; nothing is due in the step that sets it
    (set! (-> item message) message))
  (+= (-> t count) 1))

(define #:forall (M) (timers-step! [t (ptr (timers M))])
  (for ([i u32 0]) (< i (-> t count)) (+= i 1)
    (let ([item (+ (-> t items) i)])
      (when (> (-> item left) 0) (-= (-> item left) 1)))))

;; The timers after it move down, which keeps them in the order they were set.
(define #:forall (M) (timer-due! [t (ptr (timers M))] [message (ptr M)]) -> i32
  (for ([i u32 0]) (< i (-> t count)) (+= i 1)
    (let ([item (+ (-> t items) i)])
      (when (== (-> item left) 0)
        (set! (@ message) (-> item message))
        (memcpy item (+ item 1) (* (- (- (-> t count) i) 1) (sizeof (timer M))))
        (-= (-> t count) 1)
        (return 1))))
  0)

(define #:forall (M) (timers-waiting [t (ptr (timers M))]) -> u32 (-> t count))

(define #:forall (M) (timers-clear! [t (ptr (timers M))]) (set! (-> t count) 0))

(define #:forall (M) (timers-free! [t (ptr (timers M))])
  (free (-> t items))
  (set! (-> t items) 0)
  (set! (-> t count) 0)
  (set! (-> t room) 0))
