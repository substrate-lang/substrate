;; Lifecycle: experimental.
;;
;; Formatting text, for games: numbers and strings are put into a piece
;; of text according to a pattern.
;;
;; This file is part of the game library. Nothing in it is about games,
;; but it has only been written and reviewed for the game library's use.
;; It is not a standard library of the language.
;;
;;   (format-into line 64 "coins ~d/~d" collected total)
;;
;; writes "coins 3/12" into the array `line`. A pattern is ordinary text
;; in which each directive, a ~ followed by a letter, is replaced by the
;; next argument:
;;
;;   ~d    an integer, in decimal                           42, -7
;;   ~u    an integer that is never negative, of up to 64
;;         bits (~d is right for everything smaller)
;;   ~x    an integer, in hexadecimal                       ff
;;   ~f    a number with decimals. At most six are          0.5, 12,
;;         written, and zeros at the end are left out       -3.141593
;;   ~.2f  a number with exactly two decimals (any count    3.14, 2.50
;;         up to 15 can be given)
;;   ~s    a string (a C string). A null pointer writes
;;         nothing
;;   ~c    one character, given as its number (its Unicode
;;         code point)
;;   ~~    a ~
;;
;; A number between the ~ and the letter is a width. The text is padded
;; with spaces on its left until it is that many bytes long: "~5d" writes
;; "   42". A - before the width pads on the right instead ("~-5d"), and
;; a 0 before it pads a number with zeros ("~05d" writes "00042").
;;
;; There are four forms, which differ in where the text goes:
;;
;;   (format-into bytes size pattern argument ...)
;;       Writes the text at `bytes`, which has room for `size` bytes, and
;;       ends it with a zero byte, so that it is a C string. Text that
;;       does not fit is cut short; nothing is ever written past `size`.
;;       Returns the length of what was written. It allocates nothing,
;;       so it suits text that is made again on every frame:
;;
;;         (let ([line (array u8 64)])
;;           (format-into line 64 "score ~d" score)
;;           (fill-text line 8 8))
;;
;;   (buffer-add-format! buffer pattern argument ...)
;;       Adds the text to a buffer (compiler/base/runtime.sub), which grows as
;;       needed.
;;       `buffer` is a pointer to one. Returns the number of bytes added.
;;
;;   (format-string pattern argument ...)
;;       Returns the text as a new C string, which the caller must free.
;;
;;   (print-format pattern argument ...)
;;       Writes the text to the program's standard output.
;;
;; The pattern is read when the program is compiled, not when it runs.
;; So a directive that does not exist, or a pattern with more or fewer
;; directives than there are arguments, is a compile error. Each
;; argument is checked like the argument of a function: a string where
;; ~d expects a number is a compile error too. (One mistake is not
;; caught: a number with decimals given to ~d is rounded towards zero
;; without complaint, because the language converts between kinds of
;; number silently, as C does.)
;;
;; ~f is meant for showing numbers to people. A number of 10^18 or more
;; is written as a digit, decimals and a power of ten ("1.5e+30"), and a
;; number too small for the decimals asked for is written as 0.
(require-unqualified base "../../../compiler/base/base.sub")
(require print "../../../compiler/print.sub")

(provide format-into buffer-add-format! format-string print-format)

(memory from base)
(table from base)

;; ---- Where the text goes ----

;; The destination of one use of a formatting form. It is either an array
;; of a fixed size or a buffer that grows.
;;   bytes, size   the array and its size in bytes. One byte is kept for
;;                 the zero byte at the end, so `room`, the number of
;;                 bytes of text that fit, is one less.
;;   buffer        or the buffer to add to (then `bytes` is not used)
;;   own           a buffer of the writer's own, which format-string and
;;                 print-format collect the text in
;;   length        how many bytes have been written
;;   cut           1 if some text did not fit in the array
(struct format-writer [bytes (ptr u8)] [size u32] [room u32] [buffer (ptr buffer)] [own buffer] [length u32] [cut i32])

(define (format-start! [w (ptr format-writer)] [bytes (ptr u8)] [size u32])
  (set! (-> w bytes) bytes)
  (set! (-> w size) size)
  (set! (-> w room) (if (> size 0) (- size 1) 0))
  (set! (-> w buffer) 0)
  (set! (-> w length) 0)
  (set! (-> w cut) 0))

(define (format-start-buffer! [w (ptr format-writer)] [b (ptr buffer)])
  (set! (-> w buffer) b)
  (set! (-> w length) 0)
  (set! (-> w cut) 0))

(define (format-start-own! [w (ptr format-writer)])
  (set! (-> w own) (make-buffer))
  (format-start-buffer! w (& (-> w own))))

;; Writes the n bytes at p.
(define (format-add! [w (ptr format-writer)] [p (ptr u8)] [n u32])
  (if (!= (-> w buffer) 0)
      (buffer-add! (-> w buffer) p n)
      (let ([fits (- (-> w room) (-> w length))])
        (when (> n fits)
          (set! n fits)
          (set! (-> w cut) 1))
        (memcpy (+ (-> w bytes) (-> w length)) p n)))
  (+= (-> w length) n))

;; Writes the byte `byte`, `count` times.
(define (format-fill! [w (ptr format-writer)] [byte u32] [count u32])
  (let ([one (array u8 1)])
    (set! (@ one 0) (cast u8 byte))
    (for ([i u32 0]) (< i count) (+= i 1) (format-add! w one 1))))

;; Ends the text written into an array with a zero byte, and returns its
;; length.
;;
;; If the text was cut short, the cut may have fallen in the middle of a
;; character: in UTF-8, a character outside ASCII takes two to four
;; bytes. Half a character is not valid text, so the bytes of an
;; incomplete last character are removed.
(define (format-finish! [w (ptr format-writer)]) -> u32
  (when (!= (-> w buffer) 0) (return (-> w length)))
  (when (and (-> w cut) (> (-> w length) 0))
    (let ([at (- (-> w length) 1)])
      ;; Step back over the bytes that continue a character (10xxxxxx) to
      ;; the byte that starts it.
      (while (and (> at 0) (== (bit-and (@ (-> w bytes) at) 192) 128)) (-= at 1))
      (let* ([first (cast u32 (@ (-> w bytes) at))]
             [needs (cond [(< first 128) 1] [(>= first 240) 4] [(>= first 224) 3] [(>= first 192) 2] [else 1])])
        (when (< (- (-> w length) at) needs) (set! (-> w length) at)))))
  ;; An array of no bytes at all has no room even for the zero byte.
  (when (> (-> w size) 0) (set! (@ (-> w bytes) (-> w length)) 0))
  (-> w length))

;; For format-string: returns the collected text as a C string. The
;; buffer's memory becomes the string, which the caller frees.
(define (format-finish-string! [w (ptr format-writer)]) -> (ptr u8)
  (buffer-add-byte! (& (-> w own)) 0)
  (-> w own bytes))

;; For print-format: writes the collected text to standard output in one
;; piece, then frees it.
(define (format-finish-print! [w (ptr format-writer)])
  (print:write-bytes (cast i32 (-> w own bytes)) (cast i32 (-> w own length)))
  (buffer-free! (& (-> w own))))

;; ---- The directives ----

;; What may come between the ~ and the letter.
(define flag-left u32 1)     ; -  pad on the right
(define flag-zeros u32 2)    ; 0  pad a number with zeros

;; Writes the n bytes at p, after a minus sign if `negative`, padded to
;; `width` bytes as the flags say. Zeros go between the sign and the
;; digits: -0042.
(define (format-padded! [w (ptr format-writer)] [negative i32] [p (ptr u8)] [n u32] [width u32] [flags u32])
  (let* ([length (+ n (if negative 1 0))] [pad (if (> width length) (- width length) 0)])
    (cond [(bit-and flags flag-left)
           (when negative (format-fill! w #\- 1))
           (format-add! w p n)
           (format-fill! w 32 pad)]
          [(bit-and flags flag-zeros)
           (when negative (format-fill! w #\- 1))
           (format-fill! w #\0 pad)
           (format-add! w p n)]
          [else
           (format-fill! w 32 pad)
           (when negative (format-fill! w #\- 1))
           (format-add! w p n)])))

;; Writes the digits of n in the given base at the end of the array
;; `text`, which is `size` bytes long, and returns the index of the first
;; digit.
(define (digits! [text (ptr u8)] [size u32] [n u64] [base u64]) -> u32
  (let ([at size])
    (while 1
      (-= at 1)
      (let ([digit (cast u32 (% n base))])
        (set! (@ text at) (cast u8 (if (< digit 10) (+ 48 digit) (+ 87 digit)))))
      (set! n (/ n base))
      (when (== n 0) (break)))
    at))

;; ~u and ~x.
(define (format-unsigned! [w (ptr format-writer)] [n u64] [base u32] [width u32] [flags u32])
  (let* ([text (array u8 24)] [start (digits! text 24 n (cast u64 base))])
    (format-padded! w 0 (+ text start) (- 24 start) width flags)))

;; ~d. The negation of the smallest 64-bit integer is itself, and as an
;; unsigned number that is the right magnitude, so no case is special.
(define (format-integer! [w (ptr format-writer)] [n i64] [width u32] [flags u32])
  (let* ([text (array u8 24)] [negative (< n 0)]
         [start (digits! text 24 (if negative (cast u64 (- 0 n)) (cast u64 n)) 10)])
    (format-padded! w negative (+ text start) (- 24 start) width flags)))

;; ~s.
(define (format-text! [w (ptr format-writer)] [s (ptr u8)] [width u32] [flags u32])
  (if (== s 0)
      (format-padded! w 0 "" 0 width (bit-and flags flag-left))
      (format-padded! w 0 s (strlen s) width (bit-and flags flag-left))))

;; ~c: the character with the code `c`, encoded as UTF-8.
(define (format-character! [w (ptr format-writer)] [c u32])
  (let ([text (array u8 4)] [n u32 0])
    (cond [(< c 128)
           (set! (@ text 0) (cast u8 c))
           (set! n 1)]
          [(< c 2048)
           (set! (@ text 0) (cast u8 (bit-or 192 (>> c 6))))
           (set! (@ text 1) (cast u8 (bit-or 128 (bit-and c 63))))
           (set! n 2)]
          [(< c 65536)
           (set! (@ text 0) (cast u8 (bit-or 224 (>> c 12))))
           (set! (@ text 1) (cast u8 (bit-or 128 (bit-and (>> c 6) 63))))
           (set! (@ text 2) (cast u8 (bit-or 128 (bit-and c 63))))
           (set! n 3)]
          [else
           (set! (@ text 0) (cast u8 (bit-or 240 (bit-and (>> c 18) 7))))
           (set! (@ text 1) (cast u8 (bit-or 128 (bit-and (>> c 12) 63))))
           (set! (@ text 2) (cast u8 (bit-or 128 (bit-and (>> c 6) 63))))
           (set! (@ text 3) (cast u8 (bit-or 128 (bit-and c 63))))
           (set! n 4)])
    (format-add! w text n)))

;; Writes x, which is not negative and not infinite, at `text`, and
;; returns the length. `decimals` is how many decimals to write, or -1
;; for "at most six, without zeros at the end". Sets `zero` to 1 if every
;; digit written is 0.
;;
;; The number is split into its whole part and its decimals, and each is
;; written as an integer. That needs the whole part to fit in 64 bits, so
;; a number of 10^18 or more is first divided by ten until it is below
;; ten, and the number of divisions is written after it as a power of
;; ten.
(define (float-digits! [text (ptr u8)] [x f64] [decimals i32] [zero (ptr i32)]) -> u32
  (let ([places (if (< decimals 0) 6 (if (> decimals 15) 15 decimals))] [power u32 0] [scale u64 1] [n u32 0]
        [digits (array u8 24)])
    (when (>= x 1000000000000000000.0)
      (while (>= x 10.0)
        (set! x (/ x 10.0))
        (+= power 1)))
    (for ([i 0]) (< i places) (+= i 1) (*= scale 10))
    (let* ([whole (floor x)] [units (cast u64 whole)]
           ;; The decimals, as an integer, rounded to the nearest.
           [part (cast u64 (+ (* (- x whole) (cast f64 scale)) 0.5))])
      ;; Rounding up can carry into the whole part: 0.9996 with three
      ;; decimals is 1.000.
      (when (>= part scale)
        (+= units 1)
        (-= part scale))
      ;; The same carry can turn 9.9999999e+20 into 10e+20, which is
      ;; written 1e+21.
      (when (and (> power 0) (>= units 10))
        (set! units 1)
        (+= power 1))
      (set! (@ zero) (and (== units 0) (== part 0)))
      (let ([start (digits! digits 24 units 10)])
        (memcpy text (+ digits start) (- 24 start))
        (set! n (- 24 start)))
      (when (> places 0)
        (set! (@ text n) #\.)
        (+= n 1)
        ;; The decimals, with zeros in front to make `places` digits.
        (let ([start (digits! digits 24 part 10)])
          (for ([i (- 24 start)]) (< i (cast u32 places)) (+= i 1)
            (set! (@ text n) #\0)
            (+= n 1))
          (memcpy (+ text n) (+ digits start) (- 24 start))
          (+= n (- 24 start)))
        (when (< decimals 0)
          (while (== (@ text (- n 1)) #\0) (-= n 1))
          (when (== (@ text (- n 1)) #\.) (-= n 1)))))
    (when (> power 0)
      (set! (@ text n) #\e)
      (set! (@ text (+ n 1)) #\+)
      (+= n 2)
      (let ([start (digits! digits 24 (cast u64 power) 10)])
        (memcpy (+ text n) (+ digits start) (- 24 start))
        (+= n (- 24 start))))
    n))

;; ~f. A number that is "not a number" is written as nan, and one that is
;; infinite as inf. Something that rounds to zero is written without a
;; minus sign.
(define (format-float! [w (ptr format-writer)] [x f64] [decimals i32] [width u32] [flags u32])
  (let ([text (array u8 64)] [negative (< x 0.0)] [zero 0])
    (cond [(!= x x) (format-padded! w 0 "nan" 3 width (bit-and flags flag-left))]
          [else
           (when negative (set! x (- 0.0 x)))
           ;; Only infinity is equal to its own double (besides zero).
           (if (and (!= x 0.0) (== x (* x 2.0)))
               (format-padded! w negative "inf" 3 width (bit-and flags flag-left))
               (let ([n (float-digits! text x decimals (& zero))])
                 (format-padded! w (and negative (not zero)) text n width flags)))])))

;; ---- The forms ----
;;
;; The code below runs at compile time. It reads the pattern and turns a
;; form into calls of the functions above. For example,
;;
;;   (format-into line 64 "coins ~d/~d" collected total)
;;
;; becomes
;;
;;   (let ([w format-writer])
;;     (format-start! (& w) line 64)
;;     (format-add! (& w) "coins " 6)
;;     (format-integer! (& w) collected 0 0)
;;     (format-add! (& w) "/" 1)
;;     (format-integer! (& w) total 0 0)
;;     (format-finish! (& w)))
(begin-for-syntax
  (require-unqualified base "../../../compiler/base/base.sub")
  (require-unqualified kd "../../../compiler/kernel.sub")
  (require sm "../../../compiler/base/syntax-match.sub" syntax-match _ ... ?)

  ;; Reports a compile error at the syntax `where`.
  (define (fail [where datum] [message datum]) -> datum (raise-syntax-error 'format message where))

  ;; Turns a value into code. `number` does the same for an integer.
  (define (literal [d datum]) -> datum (datum->syntax #'here d 0))
  (define (number [n i64]) -> datum (literal (make-integer n)))

  ;; Returns byte i of the n bytes at p, or 0 if there is no byte i.
  (define (byte-at [p (ptr u8)] [n u32] [i u32]) -> u32 (if (< i n) (cast u32 (@ p i)) 0))

  (define (digit? [c u32]) -> i32 (and (>= c #\0) (<= c #\9)))

  ;; Returns the statements that write the text of `pattern`, in order.
  ;; Each directive takes the next of `arguments`, a list of syntax.
  (define (statements [pattern datum] [arguments datum]) -> datum
    (unless (string? (syntax-e pattern))
      (fail pattern '"the pattern must be written as a string, so that it can be read when the program is compiled"))
    (let ([p (string-bytes (syntax-e pattern))] [n (string-length (syntax-e pattern))]
          [code nil] [left arguments] [start u32 0] [i u32 0])
      (while (< i n)
        (if (!= (@ p i) #\~)
            (+= i 1)
            (let ([flags u32 0] [width u32 0] [decimals i32 -1] [j (+ i 1)])
              ;; The plain text before this directive.
              (when (> i start)
                (set! code (cons #`(format-add! (& w) #,(literal (bytes->string (+ p start) (- i start))) #,(number (- i start)))
                                 code)))
              (when (== (byte-at p n j) #\-)
                (set! flags (bit-or flags 1))
                (+= j 1))
              (when (== (byte-at p n j) #\0)
                (set! flags (bit-or flags 2))
                (+= j 1))
              (while (digit? (byte-at p n j))
                (set! width (+ (* width 10) (- (byte-at p n j) #\0)))
                (+= j 1))
              (when (== (byte-at p n j) #\.)
                (set! decimals 0)
                (+= j 1)
                (while (digit? (byte-at p n j))
                  (set! decimals (+ (* decimals 10) (cast i32 (- (byte-at p n j) #\0))))
                  (+= j 1)))
              (let ([letter (byte-at p n j)])
                (when (== letter 0) (fail pattern '"the pattern ends in the middle of a directive"))
                (when (and (>= decimals 0) (!= letter #\f))
                  (fail pattern '"a number of decimals, such as the .2 of ~.2f, can only be given to ~f"))
                (if (== letter #\~)
                    (set! code (cons #'(format-add! (& w) "~" 1) code))
                    (begin
                      (unless (or (== letter #\d) (== letter #\u) (== letter #\x) (== letter #\f) (== letter #\s) (== letter #\c))
                        (fail pattern
                              (string-append (string-append '"~" (bytes->string (+ p j) 1))
                                             '" is not a formatting directive. The directives are ~d, ~u, ~x, ~f, ~s, ~c and ~~")))
                      (when (null? left) (fail pattern '"the pattern has more directives than there are arguments"))
                      (let ([a (car left)] [wide (number width)] [how (number flags)])
                        (set! left (cdr left))
                        (set! code
                              (cons (cond [(== letter #\d) #`(format-integer! (& w) #,a #,wide #,how)]
                                          [(== letter #\u) #`(format-unsigned! (& w) #,a 10 #,wide #,how)]
                                          [(== letter #\x) #`(format-unsigned! (& w) #,a 16 #,wide #,how)]
                                          [(== letter #\f) #`(format-float! (& w) #,a #,(number decimals) #,wide #,how)]
                                          [(== letter #\s) #`(format-text! (& w) #,a #,wide #,how)]
                                          [else #`(format-character! (& w) #,a)])
                                    code))))))
              (set! i (+ j 1))
              (set! start i))))
      (when (> n start)
        (set! code (cons #`(format-add! (& w) #,(literal (bytes->string (+ p start) (- n start))) #,(number (- n start))) code)))
      (unless (null? left) (fail (car left) '"there are more arguments than directives in the pattern"))
      (reverse code)))

  (define (format-into-form [s datum]) -> datum
    (syntax-match s
      [(_ bytes size pattern argument ...)
       #`(let ([w format-writer])
           (format-start! (& w) #,bytes #,size)
           #,@(statements pattern argument)
           (format-finish! (& w)))]
      [_ (fail s '"expected (format-into bytes size pattern argument ...)")]))

  (define (buffer-add-format-form [s datum]) -> datum
    (syntax-match s
      [(_ buffer pattern argument ...)
       #`(let ([w format-writer])
           (format-start-buffer! (& w) #,buffer)
           #,@(statements pattern argument)
           (format-finish! (& w)))]
      [_ (fail s '"expected (buffer-add-format! buffer pattern argument ...)")]))

  (define (format-string-form [s datum]) -> datum
    (syntax-match s
      [(_ pattern argument ...)
       #`(let ([w format-writer])
           (format-start-own! (& w))
           #,@(statements pattern argument)
           (format-finish-string! (& w)))]
      [_ (fail s '"expected (format-string pattern argument ...)")]))

  (define (print-format-form [s datum]) -> datum
    (syntax-match s
      [(_ pattern argument ...)
       #`(let ([w format-writer])
           (format-start-own! (& w))
           #,@(statements pattern argument)
           (format-finish-print! (& w)))]
      [_ (fail s '"expected (print-format pattern argument ...)")])))

(define-syntax format-into format-into-form)
(define-syntax buffer-add-format! buffer-add-format-form)
(define-syntax format-string format-string-form)
(define-syntax print-format print-format-form)
