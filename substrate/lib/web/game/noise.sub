;; Noise for making worlds: random-looking numbers, the same for the same place and seed.
(require-unqualified substrate "../../../compiler/substrate/substrate.sub")

(provide hash-noise value-noise fbm)

(define (hash-noise [x i32] [z i32] [seed u32]) -> f64
  (let ([h (+ (* (cast u32 x) 374761393) (* (cast u32 z) 668265263) (* seed 2246822519))])
    (set! h (* (bit-xor h (>> h 13)) 1274126177))
    (set! h (bit-xor h (>> h 16)))
    (/ (cast f64 (bit-and h 65535)) 65536.0)))

(define (value-noise [x f64] [z f64] [seed u32]) -> f64
  (let* ([x0 (cast i32 (floor x))] [z0 (cast i32 (floor z))]
         [fx (- x (floor x))] [fz (- z (floor z))]
         [sx (* fx fx (- 3.0 (* 2.0 fx)))] [sz (* fz fz (- 3.0 (* 2.0 fz)))]
         [top (+ (* (hash-noise x0 z0 seed) (- 1.0 sx)) (* (hash-noise (+ x0 1) z0 seed) sx))]
         [bottom (+ (* (hash-noise x0 (+ z0 1) seed) (- 1.0 sx)) (* (hash-noise (+ x0 1) (+ z0 1) seed) sx))])
    (+ (* top (- 1.0 sz)) (* bottom sz))))

(define (fbm [x f64] [z f64] [octaves u32] [seed u32]) -> f64
  (let ([sum 0.0] [amplitude 0.5] [px x] [pz z])
    (for ([i u32 0]) (< i octaves) (+= i 1)
      (+= sum (* (value-noise px pz (+ seed i)) amplitude))
      (set! px (+ (* px 2.1) 13.0))
      (set! pz (+ (* pz 2.1) 7.0))
      (*= amplitude 0.5))
    sum))
