;; Lifecycle: experimental.
;;
;; Worlds made of blocks: a grid of them, bodies that move through it
;; without passing through blocks, the block that a line of sight hits,
;; and the mesh that draws a part of the grid. It is tiles.sub for three
;; dimensions.
;;
;; The grid is `width` blocks along x, `height` along y (up) and `depth`
;; along z. Block (x, y, z) fills the space from (x, y, z) to
;; (x + 1, y + 1, z + 1). Each block is a kind, a byte: 0 is air, and
;; the game gives the other kinds their meaning (grass, stone, ...).
;; Any block that is not air is solid.
;;
;;   (voxels-init! v width height depth)   all air
;;   (voxels-free! v)
;;   (block-at v x y z) -> kind             0 outside the grid
;;   (block-set! v x y z kind)              outside the grid, a trap
;;   (solid-at? v x y z)                    0 outside the grid
;;
;; A body is a box that moves: its lowest corner (x, y, z), its size,
;; and its velocity, in blocks per step.
;;
;;   (move-body! v b)        moves the body by its velocity, one axis at
;;                           a time, and stops it at any solid block in
;;                           the way. Afterwards:
;;                             on-ground    1 if it stands on a block
;;                             hit-wall     1 if a block stopped it
;;                                          sideways
;;                             hit-ceiling  1 if it bumped its head
;;                           The velocity along a blocked axis is set
;;                           to 0. A body must not move more than one
;;                           block in a step.
;;   (body-free? v b dx dy dz)
;;                           1 if the body, moved by (dx, dy, dz), would
;;                           overlap no solid block: whether it can step
;;                           up, stand up, or be put somewhere.
;;
;; A ray is a line of sight: from (x, y, z), in the direction
;; (dx, dy, dz), which need not have length 1.
;;
;;   (ray-hit! v x y z dx dy dz reach h)
;;                           looks along the ray for `reach` blocks.
;;                           Returns 1 if it meets a solid block, with
;;                           the block's place and the face it entered
;;                           through in `h` (a struct hit): face is
;;                           0 -x, 1 +x, 2 -y, 3 +y, 4 -z or 5 +z. The
;;                           block in front of that face, where a new
;;                           block would be placed, is (hit-x + nx, ...)
;;                           for the face's normal n, which
;;                           face-normal gives.
;;   (face-normal face axis) -> -1, 0 or 1 for axis 0 (x), 1 (y), 2 (z)
;;
;; The mesh of a part of the grid: every face of a solid block that
;; touches air becomes a square of two triangles, textured from a tile
;; of an atlas (an image of square tiles in a row, `tile` texels wide
;; each). A table says which tile each kind shows on top, on its sides
;; and underneath.
;;
;;   (struct tiles [top u32] [side u32] [bottom u32])
;;   (mesh-blocks! v x0 y0 z0 w h d table tile vertices indices) -> faces
;;       The faces of the blocks in the box from (x0, y0, z0), w by h
;;       by d, appended to the two buffers: nine floats per vertex (x,
;;       y, z, relative to the box's corner; the normal; u, v in
;;       texels of the atlas; shade, 0 to 1), and three u32 indexes per
;;       triangle, as meshes.sub draws them.
;;       `table` has an entry for each kind, from 0 (whose entry is
;;       unused). Returns how many faces were made. The vertex order is
;;       counter-clockwise seen from outside, so a pipeline can cull
;;       back faces (gpu-ccw, gpu-cull-back).
;;
;; The shade says how open a corner is: one closed in by neighbouring
;; blocks is darker ("ambient occlusion"), which is what makes a world
;; of blocks look solid. The light itself comes from the normal, in the
;; shader.
(require-unqualified base "../../../compiler/base/base.sub")
(require-unqualified trap "trap.sub")

(provide voxels voxels-init! voxels-free! block-at block-set! solid-at?
         body move-body! body-free?
         hit ray-hit! face-normal
         tiles mesh-blocks!)

(memory from base)
(table from base)

;; ---- The grid ----

(struct voxels [width i32] [height i32] [depth i32] [blocks (ptr u8)])

(define (voxels-init! [v (ptr voxels)] [width i32] [height i32] [depth i32])
  (set! (-> v width) width)
  (set! (-> v height) height)
  (set! (-> v depth) depth)
  (set! (-> v blocks) (cast (ptr u8) (calloc (cast u32 (* width height depth)) 1))))

(define (voxels-free! [v (ptr voxels)])
  (free (-> v blocks))
  (set! (-> v blocks) 0))

(define (inside? [v (ptr voxels)] [x i32] [y i32] [z i32]) -> i32
  (and (>= x 0) (< x (-> v width)) (>= y 0) (< y (-> v height)) (>= z 0) (< z (-> v depth))))

(define (place [v (ptr voxels)] [x i32] [y i32] [z i32]) -> u32
  (cast u32 (+ (* (+ (* y (-> v depth)) z) (-> v width)) x)))

(define (block-at [v (ptr voxels)] [x i32] [y i32] [z i32]) -> u8
  (if (inside? v x y z) (@ (-> v blocks) (place v x y z)) 0))

(define (block-set! [v (ptr voxels)] [x i32] [y i32] [z i32] [kind u8])
  (unless (inside? v x y z)
    (trap-format "block-set!: (~d, ~d, ~d) is outside the grid of ~d by ~d by ~d" x y z (-> v width) (-> v height) (-> v depth)))
  (set! (@ (-> v blocks) (place v x y z)) kind))

(define (solid-at? [v (ptr voxels)] [x i32] [y i32] [z i32]) -> i32 (!= (block-at v x y z) 0))

;; ---- Bodies ----

(struct body [x f64] [y f64] [z f64] [vx f64] [vy f64] [vz f64] [width f64] [height f64] [depth f64]
  [on-ground i32] [hit-wall i32] [hit-ceiling i32])

;; The block that holds the coordinate c. A box from c to c + size
;; covers the blocks from (cell c) to (cell (- (+ c size) small)): the
;; far edge, exactly on a block boundary, does not count.
(define small f64 0.0001)
(define (cell [c f64]) -> i32 (cast i32 (floor c)))

;; Whether any solid block overlaps the body's box.
(define (blocked? [v (ptr voxels)] [b (ptr body)]) -> i32
  (let ([x1 (cell (- (+ (-> b x) (-> b width)) small))]
        [y1 (cell (- (+ (-> b y) (-> b height)) small))]
        [z1 (cell (- (+ (-> b z) (-> b depth)) small))])
    (for ([x i32 (cell (-> b x))]) (<= x x1) (+= x 1)
      (for ([y i32 (cell (-> b y))]) (<= y y1) (+= y 1)
        (for ([z i32 (cell (-> b z))]) (<= z z1) (+= z 1)
          (when (solid-at? v x y z) (return 1)))))
    0))

(define (body-free? [v (ptr voxels)] [b (ptr body)] [dx f64] [dy f64] [dz f64]) -> i32
  (+= (-> b x) dx)
  (+= (-> b y) dy)
  (+= (-> b z) dz)
  (let ([blocked (blocked? v b)])
    (-= (-> b x) dx)
    (-= (-> b y) dy)
    (-= (-> b z) dz)
    (not blocked)))

(define (move-body! [v (ptr voxels)] [b (ptr body)])
  (set! (-> b on-ground) 0)
  (set! (-> b hit-wall) 0)
  (set! (-> b hit-ceiling) 0)
  ;; Along x: on a collision the body is put against the block's face.
  (+= (-> b x) (-> b vx))
  (when (blocked? v b)
    (if (> (-> b vx) 0.0)
        (set! (-> b x) (- (floor (+ (-> b x) (-> b width))) (-> b width)))
        (set! (-> b x) (+ (floor (-> b x)) 1.0)))
    (set! (-> b vx) 0.0)
    (set! (-> b hit-wall) 1))
  (+= (-> b z) (-> b vz))
  (when (blocked? v b)
    (if (> (-> b vz) 0.0)
        (set! (-> b z) (- (floor (+ (-> b z) (-> b depth))) (-> b depth)))
        (set! (-> b z) (+ (floor (-> b z)) 1.0)))
    (set! (-> b vz) 0.0)
    (set! (-> b hit-wall) 1))
  (+= (-> b y) (-> b vy))
  (when (blocked? v b)
    (if (> (-> b vy) 0.0)
        (begin
          (set! (-> b y) (- (floor (+ (-> b y) (-> b height))) (-> b height)))
          (set! (-> b hit-ceiling) 1))
        (begin
          (set! (-> b y) (+ (floor (-> b y)) 1.0))
          (set! (-> b on-ground) 1)))
    (set! (-> b vy) 0.0))
  ;; Standing still on a block counts as being on the ground too: the
  ;; block just below the body's bottom, if the bottom is on a boundary.
  (unless (-> b on-ground)
    (when (and (<= (-> b vy) 0.0) (< (- (-> b y) (floor (-> b y))) small))
      (let ([below (- (cell (-> b y)) 1)]
            [x1 (cell (- (+ (-> b x) (-> b width)) small))]
            [z1 (cell (- (+ (-> b z) (-> b depth)) small))])
        (for ([x i32 (cell (-> b x))]) (<= x x1) (+= x 1)
          (for ([z i32 (cell (-> b z))]) (<= z z1) (+= z 1)
            (when (solid-at? v x below z) (set! (-> b on-ground) 1))))))))

;; ---- Rays ----

(struct hit [x i32] [y i32] [z i32] [face i32] [distance f64])

(define (face-normal [face i32] [axis i32]) -> i32
  (if (== (/ face 2) axis) (if (== (% face 2) 0) -1 1) 0))

;; Walks the ray from block to block (Amanatides and Woo): along each
;; axis, how far along the ray the next block boundary is (`next`) and
;; how far one block is (`span`); the axis whose boundary comes first
;; is crossed.
(define (ray-hit! [v (ptr voxels)] [x f64] [y f64] [z f64] [dx f64] [dy f64] [dz f64] [reach f64] [h (ptr hit)]) -> i32
  (let ([length (sqrt (+ (* dx dx) (* dy dy) (* dz dz)))])
    (when (== length 0.0) (return 0))
    (set! dx (/ dx length))
    (set! dy (/ dy length))
    (set! dz (/ dz length))
    (let ([at (array-of i32 (cell x) (cell y) (cell z))]
          [step (array-of i32 (if (< dx 0.0) -1 1) (if (< dy 0.0) -1 1) (if (< dz 0.0) -1 1))]
          [span (array-of f64 (if (== dx 0.0) 1e30 (fabs (/ 1.0 dx)))
                              (if (== dy 0.0) 1e30 (fabs (/ 1.0 dy)))
                              (if (== dz 0.0) 1e30 (fabs (/ 1.0 dz))))]
          [next (array f64 3)]
          [from (array-of f64 x y z)]
          [travelled f64 0.0])
      (for ([a u32 0]) (< a 3) (+= a 1)
        (let ([edge (if (> (@ step a) 0) (- (cast f64 (+ (@ at a) 1)) (@ from a)) (- (@ from a) (cast f64 (@ at a))))])
          (set! (@ next a) (* edge (@ span a)))))
      (while (<= travelled reach)
        (when (solid-at? v (@ at 0) (@ at 1) (@ at 2))
          (set! (-> h x) (@ at 0))
          (set! (-> h y) (@ at 1))
          (set! (-> h z) (@ at 2))
          (set! (-> h distance) travelled)
          (return 1))
        ;; Cross into the next block along the nearest boundary, and
        ;; remember which face that enters.
        (let ([a u32 (if (< (@ next 0) (@ next 1)) (if (< (@ next 0) (@ next 2)) 0 2) (if (< (@ next 1) (@ next 2)) 1 2))])
          (set! travelled (@ next a))
          (+= (@ next a) (@ span a))
          (+= (@ at a) (@ step a))
          (set! (-> h face) (+ (* (cast i32 a) 2) (if (> (@ step a) 0) 0 1)))))
      0)))

;; ---- Meshes ----

(struct tiles [top u32] [side u32] [bottom u32])

;; A face is described by its outward normal n and two directions u and
;; v across it, all along axes, with u x v = n so that the corners
;; p, p + u, p + u + v, p + v go counter-clockwise seen from outside.
;; The texture's u runs along u and its v along v, so for the sides v
;; points down (the grass is at the top of a side tile), and u is
;; v x n. For the top and the bottom u is +x and v is n x u. Writes
;; the nine numbers n, u, v into `axes`.
(define (face-axes! [axes (ptr i32)] [face u32])
  (let ([axis (/ face 2)] [sign (if (== (% face 2) 0) -1 1)])
    (for ([i u32 0]) (< i 9) (+= i 1) (set! (@ axes i) 0))
    (set! (@ axes axis) sign)
    (if (== axis 1)
        (begin
          (set! (@ axes 3) 1)
          (set! (@ axes 8) (- 0 sign)))
        (begin
          (set! (@ axes 7) -1)
          ;; v x n for v = (0, -1, 0): (-nz, 0, nx)
          (set! (@ axes 3) (- 0 (@ axes 2)))
          (set! (@ axes 5) (@ axes 0))))))

(define (add-float! [b (ptr buffer)] [x f64]) (buffer-add! b (cast (ptr u8) (array-of f32 (cast f32 x))) 4))
(define (add-u32! [b (ptr buffer)] [n u32]) (buffer-add! b (cast (ptr u8) (array-of u32 n)) 4))

;; How closed in a corner of a face is, from 0 (two neighbouring blocks
;; across the face's plane) to 3 (none). `nx ny nz` is the face's
;; normal, and the corner is in the directions s and t along the face.
(define (openness [v (ptr voxels)] [x i32] [y i32] [z i32] [nx i32] [ny i32] [nz i32]
                  [sx i32] [sy i32] [sz i32] [tx i32] [ty i32] [tz i32]) -> i32
  (let ([side1 (solid-at? v (+ x nx sx) (+ y ny sy) (+ z nz sz))]
        [side2 (solid-at? v (+ x nx tx) (+ y ny ty) (+ z nz tz))]
        [corner (solid-at? v (+ x nx sx tx) (+ y ny sy ty) (+ z nz sz tz))])
    (if (and side1 side2) 0 (- 3 (+ side1 side2 corner)))))

;; Appends one face of block (x, y, z) to the buffers: face number
;; `face`, whose axes (face-axes!) are in f. `ox oy oz` is the box's
;; corner, taken away from the positions.
(define (face! [v (ptr voxels)] [x i32] [y i32] [z i32] [face u32] [f (ptr i32)] [tile-at u32] [tile u32]
               [ox i32] [oy i32] [oz i32] [vertices (ptr buffer)] [indices (ptr buffer)])
  (let* ([nx (@ f 0)] [ny (@ f 1)] [nz (@ f 2)]
         [ux (@ f 3)] [uy (@ f 4)] [uz (@ f 5)]
         [vx (@ f 6)] [vy (@ f 7)] [vz (@ f 8)]
         ;; The corner where u and v are 0: forward along a positive
         ;; normal, and at the far end of a direction that points the
         ;; negative way.
         [px (+ x (if (> nx 0) 1 0) (if (< ux 0) 1 0) (if (< vx 0) 1 0))]
         [py (+ y (if (> ny 0) 1 0) (if (< uy 0) 1 0) (if (< vy 0) 1 0))]
         [pz (+ z (if (> nz 0) 1 0) (if (< uz 0) 1 0) (if (< vz 0) 1 0))]
         [first (/ (-> vertices length) 36)]
         [tu (cast f64 (* tile-at tile))])
    (for ([corner u32 0]) (< corner 4) (+= corner 1)
      (let* ([along-u (if (or (== corner 1) (== corner 2)) 1 0)]
             [along-v (if (or (== corner 2) (== corner 3)) 1 0)]
             ;; The corner's openness looks at the neighbours on its side
             ;; of the face: towards u if the corner is along u, else
             ;; away from u; the same for v.
             [su (if along-u 1 -1)] [sv (if along-v 1 -1)]
             [open (openness v x y z nx ny nz (* su ux) (* su uy) (* su uz) (* sv vx) (* sv vy) (* sv vz))])
        (add-float! vertices (cast f64 (- (+ px (* along-u ux) (* along-v vx)) ox)))
        (add-float! vertices (cast f64 (- (+ py (* along-u uy) (* along-v vy)) oy)))
        (add-float! vertices (cast f64 (- (+ pz (* along-u uz) (* along-v vz)) oz)))
        (add-float! vertices (cast f64 nx))
        (add-float! vertices (cast f64 ny))
        (add-float! vertices (cast f64 nz))
        (add-float! vertices (+ tu (cast f64 (* along-u tile))))
        (add-float! vertices (cast f64 (* along-v tile)))
        (add-float! vertices (+ 0.4 (* 0.2 (cast f64 open))))))
    (add-u32! indices first)
    (add-u32! indices (+ first 1))
    (add-u32! indices (+ first 2))
    (add-u32! indices first)
    (add-u32! indices (+ first 2))
    (add-u32! indices (+ first 3))))

(define (mesh-blocks! [v (ptr voxels)] [x0 i32] [y0 i32] [z0 i32] [w i32] [h i32] [d i32]
                      [table (ptr tiles)] [tile u32] [vertices (ptr buffer)] [indices (ptr buffer)]) -> u32
  (let ([faces u32 0])
    (for ([x i32 x0]) (< x (+ x0 w)) (+= x 1)
      (for ([y i32 y0]) (< y (+ y0 h)) (+= y 1)
        (for ([z i32 z0]) (< z (+ z0 d)) (+= z 1)
          (let ([kind (block-at v x y z)])
            (when (!= kind 0)
              (let ([t (+ table (cast u32 kind))])
                (for ([face u32 0]) (< face 6) (+= face 1)
                  (let ([f (array i32 9)])
                    (face-axes! f face)
                    (unless (solid-at? v (+ x (@ f 0)) (+ y (@ f 1)) (+ z (@ f 2)))
                      (face! v x y z face f
                             (cond [(== face 3) (-> t top)] [(== face 2) (-> t bottom)] [else (-> t side)])
                             tile x0 y0 z0 vertices indices)
                      (+= faces 1))))))))))
    faces))
