;; Lifecycle: experimental.
;;
;; Keyboard state for games.
;;
;; A page hears about keys as events: this key went down, that key came
;; up. A game's update function wants to ask questions instead, once per
;; step of the game:
;;
;;   (held? in key)       is the key down right now? (keep running while
;;                        the arrow is held)
;;   (pressed? in key)    did it go down since the last step? (jump once
;;                        per press, however long the key is held)
;;   (released? in key)   did it come up since the last step?
;;
;; `in` is a pointer to an `input`, which the game loop keeps up to date
;; and passes to the update function (game.sub). `key` is a key code:
;;
;;   key-left, key-right, key-up, key-down     the arrow keys
;;   key-space, key-enter, key-escape
;;   a letter or a digit: its character, in lower case, such as #\a
;;
;; A press is remembered until the next step even if the key has already
;; come up again by then, so a very quick tap is never lost.
;;
;; The functions below the line are for whoever feeds the input: the game
;; loop, or a test that plays the game without a browser.
;;
;;   (key-code name)             turns a key's name, as the browser gives
;;                               it ("ArrowUp", "a", " ", "Enter"), into
;;                               its code; key-none (0) for a key that
;;                               has no code
;;   (input-key-down! in code)   the key went down
;;   (input-key-up! in code)     the key came up
;;   (input-end-step! in)        a step of the game is over: forget which
;;                               keys were pressed and released during it
;;   (input-clear! in)           forget everything. Used when the window
;;                               loses the keyboard focus, because the
;;                               key-up events for keys still held then
;;                               never arrive.
;;
;; This file uses nothing from the browser, so it also works in a test.
(require-unqualified base "../../../compiler/base/base.sub")

(provide input held? pressed? released?
         key-none key-left key-right key-up key-down key-space key-enter key-escape
         key-code input-key-down! input-key-up! input-end-step! input-clear!)

(memory from base)
(table from base)

;; The codes of the keys that are not letters or digits. They are below
;; 32, so they cannot collide with a character.
(define key-none u32 0)
(define key-up u32 1)
(define key-down u32 2)
(define key-left u32 3)
(define key-right u32 4)
(define key-space u32 5)
(define key-enter u32 6)
(define key-escape u32 7)

;; One byte per key code (every code is below 128):
;;   held      1 while the key is down
;;   pressed   1 if the key went down since the last step
;;   released  1 if the key came up since the last step
(struct input [held (array u8 128)] [pressed (array u8 128)] [released (array u8 128)])

;; Returns 1 if `code` is a real key code. key-none stands for every key
;; that has no code, so it is never recorded.
(define (valid? [code u32]) -> i32 (and (!= code key-none) (< code 128)))

(define (held? [in (ptr input)] [code u32]) -> i32 (and (valid? code) (!= (@ (-> in held) code) 0)))
(define (pressed? [in (ptr input)] [code u32]) -> i32 (and (valid? code) (!= (@ (-> in pressed) code) 0)))
(define (released? [in (ptr input)] [code u32]) -> i32 (and (valid? code) (!= (@ (-> in released) code) 0)))

;; ---- Feeding the input ----

;; Returns 1 if the C strings a and b are equal.
(define (same? [a (ptr u8)] [b (ptr u8)]) -> i32
  (let ([i u32 0])
    (while (and (== (@ a i) (@ b i)) (!= (@ a i) 0)) (+= i 1))
    (== (@ a i) (@ b i))))

(define (key-code [name (ptr u8)]) -> u32
  (cond
    ;; A name that is one character long is that character's own key.
    [(and (!= (@ name 0) 0) (== (@ name 1) 0))
     (let ([c (cast u32 (@ name 0))])
       (cond [(== c 32) key-space]
             [(and (>= c #\A) (<= c #\Z)) (+ c 32)]
             [(or (and (>= c #\a) (<= c #\z)) (and (>= c #\0) (<= c #\9))) c]
             [else key-none]))]
    [(same? name "ArrowUp") key-up]
    [(same? name "ArrowDown") key-down]
    [(same? name "ArrowLeft") key-left]
    [(same? name "ArrowRight") key-right]
    [(same? name "Enter") key-enter]
    [(same? name "Escape") key-escape]
    [else key-none]))

;; A key that is held sends key-down events again and again (the keyboard's
;; auto-repeat). Only the first one counts as a press.
(define (input-key-down! [in (ptr input)] [code u32])
  (when (and (valid? code) (== (@ (-> in held) code) 0))
    (set! (@ (-> in held) code) 1)
    (set! (@ (-> in pressed) code) 1)))

(define (input-key-up! [in (ptr input)] [code u32])
  (when (and (valid? code) (!= (@ (-> in held) code) 0))
    (set! (@ (-> in held) code) 0)
    (set! (@ (-> in released) code) 1)))

(define (input-end-step! [in (ptr input)])
  (memset (-> in pressed) 0 128)
  (memset (-> in released) 0 128))

(define (input-clear! [in (ptr input)])
  (memset (-> in held) 0 128)
  (input-end-step! in))
