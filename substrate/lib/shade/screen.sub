;; Lifecycle: experimental.
;;
;; A Shade library for passes over the whole screen, which draw one
;; triangle that covers it, from three vertex numbers and no buffer:
;;
;;   (screen-corner index) -> vec4   the clip position of vertex `index`
;;                                   of the triangle, 0 to 2
;;   (screen-point position size) -> vec2
;;                                   where a fragment is, from -1 to 1
;;                                   across and up, from its position on
;;                                   a screen `size` pixels across
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified shade "shade.sub")

(provide screen)

(memory from base)
(table from base)

(shade-library screen
  (define (screen-corner [index u32]) -> vec4
    (vec4 (- (* (f32 (bit-and index 1)) 4.0) 1.0) (- (* (f32 (>> index 1)) 4.0) 1.0) 0.0 1.0))
  (define (screen-point [position vec4] [size vec2]) -> vec2
    (vec2 (- (* (/ position.x size.x) 2.0) 1.0) (- 1.0 (* (/ position.y size.y) 2.0)))))
