;; Shade, a language for GPU programs compiled to WGSL: its types, checker and writer.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified kd "../../compiler/kernel.sub")

(provide shade-begin! shade-struct! shade-global! shade-compile! shade-text shade-type shade-wgsl-type
         shade-wgsl-name shade-struct-name shade-fail)

(memory from base)
(table from base)

;; ---- Errors ----

(define (shade-fail [where datum] [message datum]) -> datum (raise-syntax-error 'shade message where))

(define (join [pieces datum]) -> datum
  (let ([s '""])
    (while (pair? pieces)
      (let ([p (car pieces)])
        (set! s (string-append s (cond [(string? p) p]
                                       [(symbol? p) (symbol->string p)]
                                       [(pair? p) (type-name p)]
                                       [else (format '"~a" `(,p))]))))
      (set! pieces (cdr pieces)))
    s))

;; ---- Names ----

(define (shade-wgsl-name [s datum]) -> datum
  (let* ([n (symbol-length s)] [bytes (cast (ptr u8) (malloc (+ n 1)))])
    (memcpy bytes (symbol-bytes s) n)
    (for ([i u32 0]) (< i n) (+= i 1)
      (when (or (== (@ bytes i) #\-) (== (@ bytes i) #\!) (== (@ bytes i) #\?)) (set! (@ bytes i) #\_)))
    (when (reserved-word? s)
      (set! (@ bytes n) #\_)
      (+= n 1))
    (bytes->string bytes n)))

;; Only the reserved words a program might plausibly use as a name.
(define (reserved-word? [s datum]) -> i32
  (let ([words '(move ref type await async yield delete demote discard do final from get set new null of own
                 package partition private protected public regardless static target typedef using virtual with
                 writeonly readonly resource restrict sampler texture buffer layout mat vec array mod handle
                 filter future impl macro match meta module namespace operator premerge priority require)])
    (while (pair? words)
      (when (== (car words) s) (return 1))
      (set! words (cdr words)))
    0))

(define (shade-struct-name [s datum]) -> datum
  (let* ([name (shade-wgsl-name s)] [n (string-length name)] [bytes (cast (ptr u8) (malloc n))])
    (memcpy bytes (string-bytes name) n)
    (when (and (> n 0) (>= (@ bytes 0) #\a) (<= (@ bytes 0) #\z)) (set! (@ bytes 0) (cast u8 (- (@ bytes 0) 32))))
    (bytes->string bytes n)))

;; ---- Types ----
;; A number written out has the type int or float until the place it is in decides.

(define (vec-type? [t datum]) -> i32 (and (pair? t) (== (car t) 'vec)))
(define (mat-type? [t datum]) -> i32 (and (pair? t) (== (car t) 'mat)))
(define (array-type? [t datum]) -> i32 (and (pair? t) (== (car t) 'array)))
(define (struct-type? [t datum]) -> i32 (and (pair? t) (== (car t) 'struct)))
(define (vec-size [t datum]) -> i64 (integer-value (cadr t)))
(define (vec-of [t datum]) -> datum (caddr t))
(define (mat-size [t datum]) -> i64 (integer-value (cadr t)))
(define (array-of [t datum]) -> datum (cadr t))
(define (struct-of [t datum]) -> datum (cadr t))

(define (literal-type? [t datum]) -> i32 (or (== t 'int) (== t 'float)))
(define (scalar-type? [t datum]) -> i32 (or (== t 'f32) (== t 'i32) (== t 'u32) (== t 'bool)))
(define (number-type? [t datum]) -> i32 (or (== t 'f32) (== t 'i32) (== t 'u32)))
(define (integer-type? [t datum]) -> i32 (or (== t 'i32) (== t 'u32)))

(define (element-of [t datum]) -> datum
  (cond [(vec-type? t) (vec-of t)] [(mat-type? t) 'f32] [else t]))

(define (type-equal? [a datum] [b datum]) -> i32 (equal? a b))

(define (type-name [t datum]) -> datum
  (cond [(vec-type? t)
         (join `("vec" ,(cadr t) ,(cond [(== (vec-of t) 'i32) '"i"] [(== (vec-of t) 'u32) '"u"] [(== (vec-of t) 'bool) '"b"] [else '""])))]
        [(mat-type? t) (join `("mat" ,(cadr t)))]
        [(array-type? t) (if (null? (cddr t)) (join `("(array " ,(type-name (array-of t)) ")")) (join `("(array " ,(type-name (array-of t)) " " ,(caddr t) ")")))]
        [(struct-type? t) (symbol->string (struct-of t))]
        [(== t 'int) '"a whole number"]
        [(== t 'float) '"a decimal number"]
        [else (symbol->string t)]))

(define (shade-wgsl-type [t datum]) -> datum
  (cond [(vec-type? t)
         (join `("vec" ,(cadr t) ,(cond [(== (vec-of t) 'f32) '"f"] [(== (vec-of t) 'i32) '"i"] [(== (vec-of t) 'u32) '"u"] [else '"<bool>"])))]
        [(mat-type? t) (join `("mat" ,(cadr t) "x" ,(cadr t) "f"))]
        [(array-type? t) (if (null? (cddr t))
                             (join `("array<" ,(shade-wgsl-type (array-of t)) ">"))
                             (join `("array<" ,(shade-wgsl-type (array-of t)) ", " ,(caddr t) ">")))]
        [(struct-type? t) (struct-wgsl-name (struct-of t))]
        [(== t 'texture-2d) '"texture_2d<f32>"]
        [(== t 'texture-depth-2d) '"texture_depth_2d"]
        [(== t 'texture-2d-array) '"texture_2d_array<f32>"]
        [(== t 'texture-depth-2d-array) '"texture_depth_2d_array"]
        [(== t 'sampler-comparison) '"sampler_comparison"]
        [else (symbol->string t)]))

(define (shade-type [form datum]) -> datum
  (let ([l (syntax->list form)])
    (if (== l 0)
        (let ([s (syntax-e form)])
          (unless (symbol? s) (shade-fail form '"expected a type"))
          (cond [(== s 'f32) 'f32] [(== s 'i32) 'i32] [(== s 'u32) 'u32] [(== s 'bool) 'bool]
                [(== s 'vec2) '(vec 2 f32)] [(== s 'vec3) '(vec 3 f32)] [(== s 'vec4) '(vec 4 f32)]
                [(== s 'vec2i) '(vec 2 i32)] [(== s 'vec3i) '(vec 3 i32)] [(== s 'vec4i) '(vec 4 i32)]
                [(== s 'vec2u) '(vec 2 u32)] [(== s 'vec3u) '(vec 3 u32)] [(== s 'vec4u) '(vec 4 u32)]
                [(== s 'mat2) '(mat 2)] [(== s 'mat3) '(mat 3)] [(== s 'mat4) '(mat 4)]
                [(== s 'texture-2d) 'texture-2d] [(== s 'texture-depth-2d) 'texture-depth-2d]
                [(== s 'texture-2d-array) 'texture-2d-array] [(== s 'texture-depth-2d-array) 'texture-depth-2d-array]
                [(== s 'sampler) 'sampler] [(== s 'sampler-comparison) 'sampler-comparison]
                [(or (== s 'global-invocation-id) (== s 'local-invocation-id) (== s 'workgroup-id) (== s 'num-workgroups)) '(vec 3 u32)]
                [(== s 'local-invocation-index) 'u32]
                [(!= (assq s structs) 0) `(struct ,s)]
                [else (shade-fail form (join `("unknown type " ,s)))]))
        (begin
          (unless (and (>= (length l) 2) (<= (length l) 3) (identifier? (car l)) (== (syntax-e (car l)) 'array))
            (shade-fail form '"expected a type, or (array T n)"))
          (if (== (length l) 2)
              `(array ,(shade-type (cadr l)))
              (begin
                (unless (and (integer? (syntax-e (caddr l))) (> (integer-value (syntax-e (caddr l))) 0))
                  (shade-fail (caddr l) '"the length of an array must be a positive number"))
                `(array ,(shade-type (cadr l)) ,(syntax-e (caddr l)))))))))

;; ---- The program being compiled ----
(define structs datum nil)
(define globals datum nil)
(define functions datum nil)
(define constants datum nil)
(define out buffer)
(define indent i32 0)

(define (shade-begin!)
  (set! structs nil)
  (set! globals nil)
  (set! functions nil)
  (set! constants nil)
  (set! (-> out length) 0)
  (set! indent 0))

(define (shade-struct! [name datum] [wgsl datum] [fields datum])
  (set! structs (cons `(,name ,wgsl ,fields) structs)))

(define (shade-global! [name datum] [type datum])
  (set! globals (cons (cons name type) globals)))

(define (struct-wgsl-name [name datum]) -> datum (cadr (assq name structs)))
(define (struct-fields [name datum]) -> datum (caddr (assq name structs)))

(define (shade-text) -> datum (bytes->string (-> out bytes) (-> out length)))

(define (emit! [s datum]) (buffer-add! (& out) (string-bytes s) (string-length s)))
(define (emit-text! [s (ptr u8)]) (buffer-add! (& out) s (strlen s)))
(define (emit-line! [s datum])
  (for ([i i32 0]) (< i indent) (+= i 1) (emit-text! "  "))
  (emit! s)
  (emit-text! "\n"))

;; ---- Numbers written out ----

(define (fits? [from datum] [to datum]) -> i32
  (cond [(type-equal? from to) 1]
        [(== from 'int) (or (number-type? to) (== to 'float))]
        [(== from 'float) (== to 'f32)]
        [else 0]))

(define (settled [t datum]) -> datum
  (cond [(== t 'int) 'i32] [(== t 'float) 'f32] [else t]))

;; ---- Expressions ----

(define (typed [t datum] [text datum]) -> datum (cons t text))
(define (type-of [r datum]) -> datum (car r))
(define (text-of [r datum]) -> datum (cdr r))

(define (expression-of [e datum] [scope datum] [want datum]) -> datum
  (let ([r (expression e scope want)])
    (unless (fits? (type-of r) want)
      (shade-fail e (join `("expected " ,(type-name want) ", got " ,(type-name (type-of r))))))
    (typed want (text-of r))))

(define (expression [e datum] [scope datum] [want datum]) -> datum
  (let ([d (syntax-e e)] [l (syntax->list e)])
    (cond
      [(integer? d)
       (if (and (!= want 0) (fits? 'int want))
           (typed want (format '"~a" `(,d)))
           (typed 'int (format '"~a" `(,d))))]
      [(flonum? d)
       (if (and (!= want 0) (fits? 'float want))
           (typed want (format '"~a" `(,d)))
           (typed 'float (format '"~a" `(,d))))]
      [(boolean? d) (typed 'bool (if (true? d) '"true" '"false"))]
      [(symbol? d) (variable e d scope)]
      [(and (!= l 0) (pair? l) (identifier? (car l))) (combination e (syntax-e (car l)) l scope want)]
      [else (shade-fail e '"expected an expression")])))

(define (true? [d datum]) -> i32 (== d (boolean 1)))

(define (variable [e datum] [name datum] [scope datum]) -> datum
  (let* ([text (symbol->string name)] [n (string-length text)] [bytes (string-bytes text)]
         [dot u32 0])
    (while (and (< dot n) (!= (@ bytes dot) #\.)) (+= dot 1))
    (let* ([head (if (== dot n) name (string->symbol (bytes->string bytes dot)))]
           [r (lookup e head scope)])
      (if (== dot n)
          r
          (parts e r (+ bytes dot 1) (- n dot 1))))))

(define (lookup [e datum] [name datum] [scope datum]) -> datum
  (let ([local (assq name scope)])
    (cond [(!= local 0) (typed (cdr local) (shade-wgsl-name name))]
          [(!= (assq name globals) 0) (typed (cdr (assq name globals)) (shade-wgsl-name name))]
          [(!= (assq name constants) 0) (typed (cdr (assq name constants)) (shade-wgsl-name name))]
          [(!= (assq name functions) 0) (shade-fail e (join `(,name " is a function; call it")))]
          [else (shade-fail e (join `("unknown variable " ,name)))])))

(define (parts [e datum] [r datum] [p (ptr u8)] [n u32]) -> datum
  (let ([start u32 0] [i u32 0])
    (while (<= i n)
      (when (or (== i n) (== (@ p i) #\.))
        (when (== i start) (shade-fail e '"a dot with no name after it"))
        (set! r (part e r (string->symbol (bytes->string (+ p start) (- i start)))))
        (set! start (+ i 1)))
      (+= i 1))
    r))

(define (part [e datum] [r datum] [name datum]) -> datum
  (let ([t (type-of r)])
    (cond
      [(struct-type? t)
       (let ([field (assq name (struct-fields (struct-of t)))])
         (when (== field 0) (shade-fail e (join `(,(type-name t) " has no field " ,name))))
         (typed (cdr field) (join `(,(text-of r) "." ,(shade-wgsl-name name)))))]
      [(vec-type? t)
       (let* ([s (symbol->string name)] [k (string-length s)] [bytes (string-bytes s)])
         (unless (and (>= k 1) (<= k 4)) (shade-fail e (join `("a swizzle has one to four letters, not " ,name))))
         (for ([i u32 0]) (< i k) (+= i 1)
           (let* ([c (@ bytes i)]
                  [place (cond [(or (== c #\x) (== c #\r)) 0] [(or (== c #\y) (== c #\g)) 1]
                               [(or (== c #\z) (== c #\b)) 2] [(or (== c #\w) (== c #\a)) 3] [else 4])])
             (when (== place 4) (shade-fail e (join `("a swizzle is made of x, y, z and w (or r, g, b and a), not " ,name))))
             (when (>= place (vec-size t)) (shade-fail e (join `(,(type-name t) " has no " ,(bytes->string (+ bytes i) 1)))))))
         (typed (if (== k 1) (vec-of t) `(vec ,(make-integer k) ,(vec-of t))) (join `(,(text-of r) "." ,s))))]
      [else (shade-fail e (join `(,(type-name t) " has no fields")))])))

;; ---- Combinations ----

(define (arguments [l datum]) -> datum (cdr l))

(define (combination [e datum] [head datum] [l datum] [scope datum] [want datum]) -> datum
  (cond
    [(== head '->) (accessor e l scope)]
    [(== head '@) (index e l scope)]
    [(or (== head '+) (== head '-) (== head '*) (== head '/) (== head '%)) (arithmetic e head (arguments l) scope want)]
    [(or (== head 'bit-and) (== head 'bit-or) (== head 'bit-xor) (== head '<<) (== head '>>)) (bitwise e head (arguments l) scope want)]
    [(== head 'array) (array-value e (arguments l) scope)]
    [(or (== head '==) (== head '!=) (== head '<) (== head '<=) (== head '>) (== head '>=)) (comparison e head (arguments l) scope)]
    [(or (== head 'and) (== head 'or)) (logic e head (arguments l) scope)]
    [(== head 'not)
     (unless (== (length l) 2) (shade-fail e '"expected (not e)"))
     (typed 'bool (join `("!" ,(text-of (expression-of (cadr l) scope 'bool)))))]
    [(== head 'if) (selection e l scope want)]
    [(constructor? head) (construction e head (arguments l) scope)]
    [(!= (assq head structs) 0) (struct-value e head (arguments l) scope)]
    [(!= (assq head builtins) 0) (builtin-call e head (arguments l) scope)]
    [(!= (assq head functions) 0) (call e head (arguments l) scope)]
    [(or (== head 'let) (== head 'let*) (== head 'set!) (== head 'when) (== head 'unless) (== head 'cond) (== head 'for)
         (== head 'while) (== head 'return) (== head 'discard) (== head 'break) (== head 'continue)
         (== head '+=) (== head '-=) (== head '*=) (== head '/=))
     (shade-fail e (join `(,head " is a statement; it has no value to use here")))]
    [else (shade-fail e (join `("unknown function " ,head)))]))

(define (accessor [e datum] [l datum] [scope datum]) -> datum
  (unless (>= (length l) 3) (shade-fail e '"expected (-> e name ...)"))
  ;; The expression's text is a name, a call or parenthesised already,
  ;; so a dot can follow it as it is.
  (let ([r (expression (cadr l) scope 0)] [names (cddr l)])
    (while (pair? names)
      (unless (identifier? (car names)) (shade-fail (car names) '"expected a field or swizzle name"))
      (set! r (part (car names) r (syntax-e (car names))))
      (set! names (cdr names)))
    r))

(define (index [e datum] [l datum] [scope datum]) -> datum
  (unless (== (length l) 3) (shade-fail e '"expected (@ a i)"))
  (let* ([a (expression (cadr l) scope 0)] [i (expression (caddr l) scope 'i32)] [t (type-of a)])
    (unless (or (integer-type? (type-of i)) (== (type-of i) 'int)) (shade-fail (caddr l) '"an index is an i32 or a u32"))
    (typed (cond [(array-type? t) (array-of t)]
                 [(vec-type? t) (vec-of t)]
                 [(mat-type? t) `(vec ,(cadr t) f32)]
                 [else (shade-fail e (join `(,(type-name t) " cannot be indexed")))])
           (join `(,(text-of a) "[" ,(text-of i) "]")))))

(define (arithmetic-type [e datum] [op datum] [a datum] [b datum]) -> datum
  (cond
    [(fits? b a) (settled a)]
    [(fits? a b) (settled b)]
    [(and (vec-type? a) (fits? b (vec-of a))) a]
    [(and (vec-type? b) (fits? a (vec-of b))) b]
    [(and (== op '*) (mat-type? a) (mat-type? b) (== (mat-size a) (mat-size b))) a]
    [(and (== op '*) (mat-type? a) (vec-type? b) (== (vec-of b) 'f32) (== (mat-size a) (vec-size b))) b]
    [(and (== op '*) (vec-type? a) (mat-type? b) (== (vec-of a) 'f32) (== (mat-size b) (vec-size a))) a]
    [(and (== op '*) (mat-type? a) (fits? b 'f32)) a]
    [(and (== op '*) (mat-type? b) (fits? a 'f32)) b]
    [(and (or (== op '+) (== op '-)) (mat-type? a) (type-equal? a b)) a]
    [else (shade-fail e (join `(,(type-name a) " " ,op " " ,(type-name b) " is not defined")))]))

(define (arithmetic [e datum] [op datum] [args datum] [scope datum] [want datum]) -> datum
  (when (null? args) (shade-fail e (join `("expected (" ,op " a b ...)"))))
  (if (and (== op '-) (null? (cdr args)))
      (let ([r (expression (car args) scope want)])
        (unless (or (number-type? (type-of r)) (literal-type? (type-of r)) (vec-type? (type-of r)) (mat-type? (type-of r)))
          (shade-fail e (join `("- is not defined on " ,(type-name (type-of r))))))
        (typed (type-of r) (join `("(-" ,(text-of r) ")"))))
      (let ([r (expression (car args) scope want)])
        (set! args (cdr args))
        (while (pair? args)
          (let* ([b (expression (car args) scope (if (literal-type? (type-of r)) want (type-of r)))]
                 [t (arithmetic-type (car args) op (type-of r) (type-of b))])
            (when (and (== op '%) (not (or (number-type? (element-of t)) (literal-type? t))))
              (shade-fail e (join `("% is not defined on " ,(type-name t)))))
            (when (and (== t 'bool) (not (== op '%))) (shade-fail e (join `(,op " is not defined on bools"))))
            (set! r (typed t (join `("(" ,(text-of r) " " ,op " " ,(text-of b) ")")))))
          (set! args (cdr args)))
        r)))

(define (comparison [e datum] [op datum] [args datum] [scope datum]) -> datum
  (unless (== (length args) 2) (shade-fail e (join `("expected (" ,op " a b)"))))
  (let* ([a (expression (car args) scope 0)]
         [b (expression (cadr args) scope (type-of a))]
         [t (cond [(fits? (type-of b) (type-of a)) (settled (type-of a))]
                  [(fits? (type-of a) (type-of b)) (settled (type-of b))]
                  [else (shade-fail e (join `("cannot compare " ,(type-name (type-of a)) " with " ,(type-name (type-of b)))))])])
    (when (or (mat-type? t) (array-type? t) (struct-type? t)) (shade-fail e (join `("cannot compare " ,(type-name t)))))
    (typed (if (vec-type? t) `(vec ,(cadr t) bool) 'bool)
           (join `("(" ,(text-of a) " " ,op " " ,(text-of b) ")")))))

(define (logic [e datum] [op datum] [args datum] [scope datum]) -> datum
  (unless (>= (length args) 2) (shade-fail e (join `("expected (" ,op " a b ...)"))))
  (let ([r (expression-of (car args) scope 'bool)])
    (set! args (cdr args))
    (while (pair? args)
      (let ([b (expression-of (car args) scope 'bool)])
        (set! r (typed 'bool (join `("(" ,(text-of r) ,(if (== op 'and) '" && " '" || ") ,(text-of b) ")")))))
      (set! args (cdr args)))
    r))

(define (bitwise [e datum] [op datum] [args datum] [scope datum] [want datum]) -> datum
  (unless (== (length args) 2) (shade-fail e (join `("expected (" ,op " a b)"))))
  (let* ([a (expression (car args) scope want)]
         [b (expression (cadr args) scope (if (literal-type? (type-of a)) 0 (type-of a)))]
         [t (cond [(fits? (type-of b) (type-of a)) (settled (type-of a))]
                  [(fits? (type-of a) (type-of b)) (settled (type-of b))]
                  [(and (vec-type? (type-of a)) (fits? (type-of b) (vec-of (type-of a)))) (type-of a)]
                  [else (shade-fail e (join `(,(type-name (type-of a)) " " ,op " " ,(type-name (type-of b)) " is not defined")))])]
         [text (cond [(== op 'bit-and) '"&"] [(== op 'bit-or) '"|"] [(== op 'bit-xor) '"^"] [(== op '<<) '"<<"] [else '">>"])])
    (unless (integer-type? (element-of t)) (shade-fail e (join `(,op " is not defined on " ,(type-name t)))))
    (when (and (or (== op '<<) (== op '>>)) (!= (element-of t) 'u32))
      (unless (or (== (type-of b) 'int) (== (element-of (type-of b)) 'u32)) (shade-fail (cadr args) '"a shift is by a u32")))
    (typed t (join `("(" ,(text-of a) " " ,text " " ,(text-of b) ")")))))

(define (array-value [e datum] [args datum] [scope datum]) -> datum
  (unless (>= (length args) 2) (shade-fail e '"expected (array T e ...)"))
  (let ([t (shade-type (car args))] [texts nil] [count i64 0])
    (set! args (cdr args))
    (while (pair? args)
      (set! texts (cons (text-of (expression-of (car args) scope t)) texts))
      (set! count (+ count 1))
      (set! args (cdr args)))
    (typed `(array ,t ,(make-integer count)) (join `("array<" ,(shade-wgsl-type t) ", " ,(make-integer count) ">(" ,(comma-list (reverse texts)) ")")))))

(define (selection [e datum] [l datum] [scope datum] [want datum]) -> datum
  (unless (== (length l) 4) (shade-fail e '"expected (if c a b), with both a and b, to make a value"))
  (let* ([c (expression-of (cadr l) scope 'bool)]
         [a (expression (caddr l) scope want)]
         [b (expression (cadddr l) scope (if (literal-type? (type-of a)) want (type-of a)))]
         [t (cond [(fits? (type-of b) (type-of a)) (settled (type-of a))]
                  [(fits? (type-of a) (type-of b)) (settled (type-of b))]
                  [else (shade-fail e (join `("the two values of an if differ: " ,(type-name (type-of a)) " and " ,(type-name (type-of b)))))])])
    (typed t (join `("select(" ,(text-of b) ", " ,(text-of a) ", " ,(text-of c) ")")))))

;; ---- Constructors ----

(define (constructor? [head datum]) -> i32
  (or (== head 'vec2) (== head 'vec3) (== head 'vec4) (== head 'vec2i) (== head 'vec3i) (== head 'vec4i)
      (== head 'vec2u) (== head 'vec3u) (== head 'vec4u) (== head 'f32) (== head 'i32) (== head 'u32) (== head 'bool)))

(define (construction [e datum] [head datum] [args datum] [scope datum]) -> datum
  (let ([t (shade-type (datum->syntax e head 0))])
    (if (scalar-type? t)
        (begin
          (unless (== (length args) 1) (shade-fail e (join `("expected (" ,head " x)"))))
          (let ([r (expression (car args) scope t)])
            (unless (or (scalar-type? (type-of r)) (literal-type? (type-of r)))
              (shade-fail e (join `("cannot make " ,(type-name t) " from " ,(type-name (type-of r))))))
            (typed t (join `(,(shade-wgsl-type t) "(" ,(text-of r) ")")))))
        (let ([texts nil] [sizes i64 0] [count (length args)] [vectors 0])
          (when (null? args) (shade-fail e (join `("expected (" ,head " x ...)"))))
          (while (pair? args)
            (let ([r (expression (car args) scope (vec-of t))])
              (cond [(vec-type? (type-of r)) (+= sizes (vec-size (type-of r))) (set! vectors 1)]
                    [(or (number-type? (type-of r)) (literal-type? (type-of r))) (+= sizes 1)]
                    [else (shade-fail (car args) (join `("a vector is made of numbers and vectors, not " ,(type-name (type-of r)))))])
              (set! texts (cons (text-of r) texts)))
            (set! args (cdr args)))
          (unless (or (== sizes (vec-size t)) (and (== count 1) (== vectors 0)))
            (shade-fail e (join `(,(type-name t) " needs " ,(cadr t) " numbers; these give " ,(make-integer sizes)))))
          (typed t (join `(,(shade-wgsl-type t) "(" ,(comma-list (reverse texts)) ")")))))))

(define (comma-list [texts datum]) -> datum
  (let ([s '""] [first 1])
    (while (pair? texts)
      (set! s (if first (car texts) (join `(,s ", " ,(car texts)))))
      (set! first 0)
      (set! texts (cdr texts)))
    s))

(define (struct-value [e datum] [name datum] [args datum] [scope datum]) -> datum
  (let ([fields (struct-fields name)] [texts nil] [given nil])
    (while (pair? args)
      (let ([l (syntax->list (car args))])
        (unless (and (!= l 0) (== (length l) 2) (identifier? (car l))) (shade-fail (car args) '"expected [field e]"))
        (let ([field (assq (syntax-e (car l)) fields)])
          (when (== field 0) (shade-fail (car l) (join `(,name " has no field " ,(syntax-e (car l))))))
          (when (!= (assq (syntax-e (car l)) given) 0) (shade-fail (car l) '"this field is given twice"))
          (set! given (cons (cons (syntax-e (car l)) (text-of (expression-of (cadr l) scope (cdr field)))) given))))
      (set! args (cdr args)))
    (let ([f fields])
      (while (pair? f)
        (let ([g (assq (car (car f)) given)])
          (set! texts (cons (if (== g 0) (join `(,(shade-wgsl-type (cdr (car f))) "()")) (cdr g)) texts)))
        (set! f (cdr f))))
    (typed `(struct ,name) (join `(,(struct-wgsl-name name) "(" ,(comma-list (reverse texts)) ")")))))

;; ---- Calls ----

(define (call [e datum] [name datum] [args datum] [scope datum]) -> datum
  (let* ([f (assq name functions)] [wgsl (cadr f)] [parameters (caddr f)] [result (cadddr f)] [texts nil])
    (unless (== (length args) (length parameters))
      (shade-fail e (join `(,name " takes " ,(make-integer (length parameters)) " arguments, not " ,(make-integer (length args))))))
    (while (pair? args)
      (set! texts (cons (text-of (expression-of (car args) scope (car parameters))) texts))
      (set! args (cdr args))
      (set! parameters (cdr parameters)))
    (typed result (join `(,wgsl "(" ,(comma-list (reverse texts)) ")")))))

;; Letters bind to the arguments' types: F f32 or a vector of f32, W a vector of f32, N a number or
;; a vector of numbers, I i32, u32 or a vector of them, V a vector, T any, E V's, F's or N's element, B V's bools.
(define builtins datum
  '((abs "abs" ((N) N))
    (sign "sign" ((F) F))
    (floor "floor" ((F) F)) (ceil "ceil" ((F) F)) (round "round" ((F) F)) (trunc "trunc" ((F) F)) (fract "fract" ((F) F))
    (sqrt "sqrt" ((F) F)) (inverse-sqrt "inverseSqrt" ((F) F))
    (exp "exp" ((F) F)) (exp2 "exp2" ((F) F)) (log "log" ((F) F)) (log2 "log2" ((F) F))
    (sin "sin" ((F) F)) (cos "cos" ((F) F)) (tan "tan" ((F) F)) (asin "asin" ((F) F)) (acos "acos" ((F) F)) (atan "atan" ((F) F))
    (atan2 "atan2" ((F F) F))
    (pow "pow" ((F F) F))
    (min "min" ((N N) N)) (max "max" ((N N) N))
    (clamp "clamp" ((N N N) N))
    (saturate "saturate" ((F) F))
    (mix "mix" ((F F F) F) ((F F f32) F))
    (step "step" ((F F) F))
    (smoothstep "smoothstep" ((F F F) F))
    (dot "dot" ((V V) E))
    (cross "cross" (((vec 3 f32) (vec 3 f32)) (vec 3 f32)))
    (length "length" ((F) f32))
    (distance "distance" ((F F) f32))
    (normalize "normalize" ((W) W))
    (reflect "reflect" ((W W) W))
    (select "select" ((T T bool) T) ((V V B) V))
    (any "any" ((B) bool)) (all "all" ((B) bool))
    (dpdx "dpdx" ((F) F)) (dpdy "dpdy" ((F) F)) (fwidth "fwidth" ((F) F))
    (texture-sample "textureSample" ((texture-2d sampler (vec 2 f32)) (vec 4 f32)) ((texture-2d-array sampler (vec 2 f32) i32) (vec 4 f32)))
    (texture-sample-level "textureSampleLevel" ((texture-2d sampler (vec 2 f32) f32) (vec 4 f32)) ((texture-2d-array sampler (vec 2 f32) i32 f32) (vec 4 f32)))
    (texture-sample-grad "textureSampleGrad" ((texture-2d sampler (vec 2 f32) (vec 2 f32) (vec 2 f32)) (vec 4 f32))
                         ((texture-2d-array sampler (vec 2 f32) i32 (vec 2 f32) (vec 2 f32)) (vec 4 f32)))
    (texture-sample-compare-level "textureSampleCompareLevel" ((texture-depth-2d sampler-comparison (vec 2 f32) f32) f32)
                                  ((texture-depth-2d-array sampler-comparison (vec 2 f32) i32 f32) f32))
    (texture-load "textureLoad" ((texture-2d (vec 2 i32) i32) (vec 4 f32)) ((texture-depth-2d (vec 2 i32) i32) f32)
                  ((texture-2d-array (vec 2 i32) i32 i32) (vec 4 f32)) ((texture-depth-2d-array (vec 2 i32) i32 i32) f32))
    (texture-dimensions "textureDimensions" ((texture-2d) (vec 2 u32)) ((texture-depth-2d) (vec 2 u32))
                        ((texture-2d-array) (vec 2 u32)) ((texture-depth-2d-array) (vec 2 u32)))
    (texture-num-layers "textureNumLayers" ((texture-2d-array) u32) ((texture-depth-2d-array) u32))))

(define (kind? [letter datum] [t datum]) -> i32
  (cond [(== letter 'F) (or (== t 'f32) (and (vec-type? t) (== (vec-of t) 'f32)))]
        [(== letter 'W) (and (vec-type? t) (== (vec-of t) 'f32))]
        [(== letter 'N) (or (number-type? t) (and (vec-type? t) (number-type? (vec-of t))))]
        [(== letter 'I) (or (integer-type? t) (and (vec-type? t) (integer-type? (vec-of t))))]
        [(== letter 'V) (and (vec-type? t) (number-type? (vec-of t)))]
        [(== letter 'B) (and (vec-type? t) (== (vec-of t) 'bool))]
        [(== letter 'T) (or (scalar-type? t) (vec-type? t) (mat-type? t))]
        [else 0]))

(define (pattern-letter? [p datum]) -> i32
  (or (== p 'F) (== p 'W) (== p 'N) (== p 'I) (== p 'V) (== p 'T) (== p 'E) (== p 'B)))

(define (match-signature [parameters datum] [args datum]) -> datum
  (when (!= (length parameters) (length args)) (return 0))
  (let ([bound nil] [ps parameters] [as args])
    ;; Settled arguments first: they bind the letters, which the numbers written out must then fit.
    (while (pair? ps)
      (let ([p (car ps)] [t (car as)])
        (unless (literal-type? t)
          (cond [(pattern-letter? p)
                 (cond [(== p 'E) (begin)]
                       [(== p 'B)
                        (unless (kind? 'B t) (return 0))
                        (let ([v (assq 'V bound)])
                          (when (and (!= v 0) (!= (vec-size (cdr v)) (vec-size t))) (return 0)))]
                       [(!= (assq p bound) 0) (unless (type-equal? (cdr (assq p bound)) t) (return 0))]
                       [else
                        (unless (kind? p t) (return 0))
                        (set! bound (cons (cons p t) bound))])]
                [else (unless (type-equal? p t) (return 0))])))
      (set! ps (cdr ps))
      (set! as (cdr as)))
    (set! ps parameters)
    (set! as args)
    (while (pair? ps)
      (let ([p (car ps)] [t (car as)])
        (when (literal-type? t)
          (cond [(pattern-letter? p)
                 (let ([b (assq p bound)])
                   (cond [(!= b 0) (unless (fits? t (cdr b)) (return 0))]
                         [(== p 'F) (unless (fits? t 'f32) (return 0)) (set! bound (cons (cons p 'f32) bound))]
                         [(or (== p 'N) (== p 'T)) (set! bound (cons (cons p (settled t)) bound))]
                         [(== p 'I) (unless (== t 'int) (return 0)) (set! bound (cons (cons p 'i32) bound))]
                         [else (return 0)]))]
                [else (unless (fits? t p) (return 0))])))
      (set! ps (cdr ps))
      (set! as (cdr as)))
    bound))

(define (result-type [result datum] [bound datum]) -> datum
  (cond [(== result 'E)
         (let ([v (if (!= (assq 'V bound) 0) (assq 'V bound) (if (!= (assq 'F bound) 0) (assq 'F bound) (assq 'N bound)))])
           (element-of (cdr v)))]
        [(pattern-letter? result) (cdr (assq result bound))]
        [else result]))

(define (builtin-call [e datum] [name datum] [args datum] [scope datum]) -> datum
  (let* ([b (assq name builtins)] [wgsl (cadr b)] [signatures (cddr b)] [checked nil] [types nil])
    (let ([a args])
      (while (pair? a)
        (let ([r (expression (car a) scope 0)])
          (set! checked (cons r checked))
          (set! types (cons (type-of r) types)))
        (set! a (cdr a))))
    (set! checked (reverse checked))
    (set! types (reverse types))
    (let ([s signatures])
      (while (pair? s)
        (let ([bound (match-signature (car (car s)) types)])
          (when (!= bound 0)
            (let ([texts nil] [c checked])
              (while (pair? c)
                (set! texts (cons (text-of (car c)) texts))
                (set! c (cdr c)))
              (return (typed (result-type (cadr (car s)) bound) (join `(,wgsl "(" ,(comma-list (reverse texts)) ")")))))))
        (set! s (cdr s))))
    (shade-fail e (join `(,name " is not defined on " ,(type-list types))))))

(define (type-list [types datum]) -> datum
  (let ([texts nil])
    (while (pair? types)
      (set! texts (cons (type-name (car types)) texts))
      (set! types (cdr types)))
    (if (null? texts) '"no arguments" (comma-list (reverse texts)))))

;; ---- Statements ----

(define (statements [forms datum] [scope datum] [result datum] [tail i32])
  (while (pair? forms)
    (statement (car forms) scope result (and tail (null? (cdr forms))))
    (set! forms (cdr forms))))

(define (statement [s datum] [scope datum] [result datum] [tail i32])
  (let* ([l (syntax->list s)] [head (if (and (!= l 0) (pair? l) (identifier? (car l))) (syntax-e (car l)) 0)])
    (cond
      [(or (== head 'let) (== head 'let*)) (binding s l scope result tail)]
      [(== head 'set!) (assignment s l scope '"=")]
      [(== head '+=) (assignment s l scope '"+=")]
      [(== head '-=) (assignment s l scope '"-=")]
      [(== head '*=) (assignment s l scope '"*=")]
      [(== head '/=) (assignment s l scope '"/=")]
      [(== head 'if) (branch s l scope result tail)]
      [(== head 'when) (conditional s l scope result tail 0)]
      [(== head 'unless) (conditional s l scope result tail 1)]
      [(== head 'cond) (conditions s l scope result tail)]
      [(== head 'for) (loop s l scope result)]
      [(== head 'while) (repetition s l scope result)]
      [(== head 'return)
       (cond [(== (length l) 1)
              (unless (== result 'void) (shade-fail s '"the function has a result; give it to return"))
              (emit-line! '"return;")]
             [(== (length l) 2)
              (when (== result 'void) (shade-fail s '"the function has no result; return nothing"))
              (emit-line! (join `("return " ,(text-of (expression-of (cadr l) scope result)) ";")))]
             [else (shade-fail s '"expected (return) or (return e)")])]
      [(== head 'discard) (emit-line! '"discard;")]
      [(== head 'break) (emit-line! '"break;")]
      [(== head 'continue) (emit-line! '"continue;")]
      [(and tail (!= result 'void))
       (emit-line! (join `("return " ,(text-of (expression-of s scope result)) ";")))]
      [else
       (let ([r (expression s scope 0)])
         (unless (== (type-of r) 'void) (shade-fail s '"this value is not used"))
         (emit-line! (join `(,(text-of r) ";"))))])))

(define (changed? [name datum] [forms datum]) -> i32
  (while (pair? forms)
    (let* ([f (car forms)] [l (syntax->list f)])
      (when (and (!= l 0) (pair? l))
        (when (and (identifier? (car l)) (>= (length l) 2)
                   (let ([h (syntax-e (car l))]) (or (== h 'set!) (== h '+=) (== h '-=) (== h '*=) (== h '/=))))
          (when (== (root-of (cadr l)) name) (return 1)))
        (when (changed? name l) (return 1))))
    (set! forms (cdr forms)))
  0)

(define (root-of [place datum]) -> datum
  (let ([l (syntax->list place)])
    (if (== l 0)
        (let ([d (syntax-e place)])
          (if (symbol? d)
              (let* ([text (symbol->string d)] [bytes (string-bytes text)] [n (string-length text)] [dot u32 0])
                (while (and (< dot n) (!= (@ bytes dot) #\.)) (+= dot 1))
                (if (== dot n) d (string->symbol (bytes->string bytes dot))))
              0))
        (if (and (pair? l) (pair? (cdr l))) (root-of (cadr l)) 0))))

(define (binding [s datum] [l datum] [scope datum] [result datum] [tail i32])
  (unless (>= (length l) 3) (shade-fail s '"expected (let ([x e] ...) body ...)"))
  (let ([bindings (syntax->list (cadr l))] [body (cddr l)] [inner scope])
    (when (== bindings 0) (shade-fail (cadr l) '"expected the bindings, ([x e] ...)"))
    (while (pair? bindings)
      (let ([b (syntax->list (car bindings))])
        (unless (and (!= b 0) (or (== (length b) 2) (== (length b) 3)) (identifier? (car b)))
          (shade-fail (car bindings) '"expected [x e] or [x T e]"))
        (let* ([name (syntax-e (car b))]
               [want (if (== (length b) 3) (shade-type (cadr b)) 0)]
               [r (if (== want 0) (expression (list-ref b 1) inner 0) (expression-of (list-ref b 2) inner want))]
               [t (if (== want 0) (settled (type-of r)) want)]
               [mutable (or (changed? name body) (array-type? t))])
          (when (== t 'void) (shade-fail (car bindings) '"this has no value to bind"))
          (emit-line! (join `(,(if mutable '"var " '"let ") ,(shade-wgsl-name name) ": " ,(shade-wgsl-type t) " = " ,(text-of r) ";")))
          (set! inner (cons (cons name t) inner))))
      (set! bindings (cdr bindings)))
    (statements body inner result tail)))

(define (assignment [s datum] [l datum] [scope datum] [op datum])
  (unless (== (length l) 3) (shade-fail s '"expected (set! place e)"))
  (let* ([place (expression (cadr l) scope 0)]
         [root (root-of (cadr l))]
         [value (expression-of (caddr l) scope (type-of place))])
    (when (== root 0) (shade-fail (cadr l) '"expected a place: a variable, a field, a swizzle or an element"))
    (when (!= (assq root globals) 0)
      (let ([t (cdr (assq root globals))])
        (unless (and (array-type? t) (null? (cddr t))) (shade-fail (cadr l) (join `(,root " cannot be changed"))))))
    (when (!= (assq root constants) 0) (shade-fail (cadr l) (join `(,root " is a constant"))))
    (emit-line! (join `(,(text-of place) " " ,op " " ,(text-of value) ";")))))

(define (block! [forms datum] [scope datum] [result datum] [tail i32])
  (+= indent 1)
  (statements forms scope result tail)
  (-= indent 1))

(define (branch [s datum] [l datum] [scope datum] [result datum] [tail i32])
  (unless (or (== (length l) 3) (== (length l) 4)) (shade-fail s '"expected (if c then else) or (if c then)"))
  (when (and tail (== (length l) 3)) (shade-fail s '"the function's result is this if, so it needs an else"))
  (let ([c (expression-of (cadr l) scope 'bool)])
    (emit-line! (join `("if (" ,(text-of c) ") {")))
    (block! `(,(caddr l)) scope result tail)
    (if (== (length l) 4)
        (begin
          (emit-line! '"} else {")
          (block! `(,(cadddr l)) scope result tail)
          (emit-line! '"}"))
        (emit-line! '"}"))))

(define (conditional [s datum] [l datum] [scope datum] [result datum] [tail i32] [negated i32])
  (unless (>= (length l) 3) (shade-fail s '"expected (when c body ...)"))
  (when tail (shade-fail s '"the function's result cannot be a when or an unless, which may not give a value; use if or cond"))
  (let ([c (expression-of (cadr l) scope 'bool)])
    (emit-line! (join `("if (" ,(if negated '"!" '"") ,(text-of c) ") {")))
    (block! (cddr l) scope result 0)
    (emit-line! '"}")))

(define (conditions [s datum] [l datum] [scope datum] [result datum] [tail i32])
  (unless (>= (length l) 2) (shade-fail s '"expected (cond [c body ...] ...)"))
  (let ([clauses (cdr l)] [first 1] [has-else 0])
    (while (pair? clauses)
      (let ([c (syntax->list (car clauses))])
        (unless (and (!= c 0) (>= (length c) 2)) (shade-fail (car clauses) '"expected [c body ...]"))
        (if (and (identifier? (car c)) (== (syntax-e (car c)) 'else))
            (begin
              (unless (null? (cdr clauses)) (shade-fail (car clauses) '"else must be the last clause"))
              (set! has-else 1)
              (if first (block! (cdr c) scope result tail) (begin (emit-line! '"} else {") (block! (cdr c) scope result tail))))
            (let ([test (expression-of (car c) scope 'bool)])
              (emit-line! (join `(,(if first '"if (" '"} else if (") ,(text-of test) ") {")))
              (block! (cdr c) scope result tail)))
        (set! first 0))
      (set! clauses (cdr clauses)))
    (when (and tail (not has-else)) (shade-fail s '"the function's result is this cond, so it needs an else"))
    (unless (and has-else (== (length l) 2)) (emit-line! '"}"))))

(define (loop [s datum] [l datum] [scope datum] [result datum])
  (unless (>= (length l) 5) (shade-fail s '"expected (for ([i init]) test step body ...)"))
  (let* ([bindings (syntax->list (cadr l))]
         [b (if (and (!= bindings 0) (== (length bindings) 1)) (syntax->list (car bindings)) 0)])
    (unless (and (!= b 0) (or (== (length b) 2) (== (length b) 3)) (identifier? (car b)))
      (shade-fail (cadr l) '"expected one binding, ([i init]) or ([i T init])"))
    (let* ([name (syntax-e (car b))]
           [want (if (== (length b) 3) (shade-type (cadr b)) 0)]
           [init (if (== want 0) (expression (list-ref b 1) scope 0) (expression-of (list-ref b 2) scope want))]
           [t (if (== want 0) (settled (type-of init)) want)]
           [inner (cons (cons name t) scope)]
           [test (expression-of (caddr l) inner 'bool)]
           [step (cadddr l)]
           [step-list (syntax->list step)])
      (unless (and (!= step-list 0) (== (length step-list) 3) (identifier? (car step-list))
                   (let ([h (syntax-e (car step-list))]) (or (== h 'set!) (== h '+=) (== h '-=) (== h '*=) (== h '/=))))
        (shade-fail step '"the step is an assignment, such as (+= i 1)"))
      (let* ([h (syntax-e (car step-list))]
             [op (cond [(== h 'set!) '"="] [(== h '+=) '"+="] [(== h '-=) '"-="] [(== h '*=) '"*="] [else '"/="])]
             [place (expression (cadr step-list) inner 0)]
             [value (expression-of (caddr step-list) inner (type-of place))])
        (emit-line! (join `("for (var " ,(shade-wgsl-name name) ": " ,(shade-wgsl-type t) " = " ,(text-of init) "; " ,(text-of test) "; "
                            ,(text-of place) " " ,op " " ,(text-of value) ") {")))
        (block! (list-tail l 4) inner result 0)
        (emit-line! '"}")))))

(define (repetition [s datum] [l datum] [scope datum] [result datum])
  (unless (>= (length l) 3) (shade-fail s '"expected (while c body ...)"))
  (let ([c (expression-of (cadr l) scope 'bool)])
    (emit-line! (join `("while (" ,(text-of c) ") {")))
    (block! (cddr l) scope result 0)
    (emit-line! '"}")))

;; ---- Definitions ----

(define (function-parts [d datum] [l datum]) -> datum
  (unless (>= (length l) 2) (shade-fail d '"expected (define (name [x T] ...) -> R body ...)"))
  (let ([head (syntax->list (cadr l))])
    (unless (and (!= head 0) (pair? head) (identifier? (car head))) (shade-fail (cadr l) '"expected the function's head, (name [x T] ...)"))
    (let ([parameters nil] [ps (cdr head)])
      (while (pair? ps)
        (let ([p (syntax->list (car ps))])
          (unless (and (!= p 0) (== (length p) 2) (identifier? (car p))) (shade-fail (car ps) '"expected a parameter, [x T]"))
          (set! parameters (cons (cons (syntax-e (car p)) (shade-type (cadr p))) parameters)))
        (set! ps (cdr ps)))
      (let ([rest (cddr l)] [result 'void])
        (when (and (pair? rest) (identifier? (car rest)) (== (syntax-e (car rest)) '->))
          (unless (pair? (cdr rest)) (shade-fail (car rest) '"expected the result type after ->"))
          (set! result (shade-type (cadr rest)))
          (set! rest (cddr rest)))
        (when (null? rest) (shade-fail d '"the function has no body"))
        `(,(syntax-e (car head)) ,(reverse parameters) ,result ,rest)))))

;; Everything is declared first, so that any definition may use any other.
(define (shade-compile! [definitions datum] [entries datum])
  (let ([ds definitions])
    (while (pair? ds)
      (let* ([d (car ds)] [l (syntax->list d)] [head (if (and (!= l 0) (pair? l) (identifier? (car l))) (syntax-e (car l)) 0)])
        (cond
          [(== head 'struct)
           (unless (>= (length l) 3) (shade-fail d '"expected (struct name [field T] ...)"))
           (unless (identifier? (cadr l)) (shade-fail (cadr l) '"expected the struct's name"))
           (let ([name (syntax-e (cadr l))] [fields nil] [fs (cddr l)])
             (when (!= (assq name structs) 0) (shade-fail (cadr l) (join `(,name " is defined twice"))))
             ;; Declared before its fields are read, so that a struct can hold one defined earlier.
             (set! structs (cons `(,name ,(shade-struct-name name) ()) structs))
             (while (pair? fs)
               (let ([f (syntax->list (car fs))])
                 (unless (and (!= f 0) (== (length f) 2) (identifier? (car f))) (shade-fail (car fs) '"expected a field, [name T]"))
                 (when (!= (assq (syntax-e (car f)) fields) 0) (shade-fail (car f) '"this field is named twice"))
                 (set! fields (cons (cons (syntax-e (car f)) (shade-type (cadr f))) fields)))
               (set! fs (cdr fs)))
             (set! structs (cons `(,name ,(shade-struct-name name) ,(reverse fields)) (cdr structs))))]
          [(== head 'define)
           (let* ([parts (function-parts d l)] [name (car parts)])
             (when (or (!= (assq name functions) 0) (!= (assq name builtins) 0)) (shade-fail (cadr l) (join `(,name " is defined twice"))))
             (set! functions (cons `(,name ,(shade-wgsl-name name) ,(types-of (cadr parts)) ,(caddr parts)) functions)))]
          [(== head 'const)
           (unless (and (== (length l) 4) (identifier? (cadr l))) (shade-fail d '"expected (const name T e)"))
           (when (!= (assq (syntax-e (cadr l)) constants) 0) (shade-fail (cadr l) '"this constant is defined twice"))
           (set! constants (cons (cons (syntax-e (cadr l)) (shade-type (caddr l))) constants))]
          [else (shade-fail d '"expected a definition: (define (f ...) ...), (struct ...) or (const ...)")]))
      (set! ds (cdr ds))))
  (let ([ds definitions])
    (while (pair? ds)
      (let* ([d (car ds)] [l (syntax->list d)] [head (syntax-e (car l))])
        (cond
          [(== head 'struct)
           (let* ([name (syntax-e (cadr l))] [fields (struct-fields name)] [s (join `("struct " ,(struct-wgsl-name name) " {"))])
             (while (pair? fields)
               (set! s (join `(,s " " ,(shade-wgsl-name (car (car fields))) ": " ,(shade-wgsl-type (cdr (car fields))) ",")))
               (set! fields (cdr fields)))
             (emit-line! (join `(,s " }"))))]
          [(== head 'const)
           (let ([t (shade-type (caddr l))])
             (emit-line! (join `("const " ,(shade-wgsl-name (syntax-e (cadr l))) ": " ,(shade-wgsl-type t) " = "
                                 ,(text-of (expression-of (cadddr l) nil t)) ";"))))]
          [else (begin)]))
      (set! ds (cdr ds))))
  (let ([ds definitions])
    (while (pair? ds)
      (let* ([d (car ds)] [l (syntax->list d)])
        (when (== (syntax-e (car l)) 'define) (function! d l '"" 0)))
      (set! ds (cdr ds))))
  (let ([es entries])
    (while (pair? es)
      (let* ([entry (car es)] [kind (car entry)] [d (cadr entry)] [l (syntax->list d)])
        (function! d l
                   (cond [(== kind 'vertex) '"@vertex "] [(== kind 'fragment) '"@fragment "]
                         [else (join `("@compute @workgroup_size(" ,(caddr entry) ") "))])
                   1))
      (set! es (cdr es)))))

(define (types-of [parameters datum]) -> datum
  (let ([types nil])
    (while (pair? parameters)
      (set! types (cons (cdr (car parameters)) types))
      (set! parameters (cdr parameters)))
    (reverse types)))

(define (function! [d datum] [l datum] [attribute datum] [entry i32])
  (let* ([parts (function-parts d l)] [name (car parts)] [parameters (cadr parts)] [result (caddr parts)] [body (cadddr parts)]
         [s (join `(,attribute "fn " ,(shade-wgsl-name name) "("))] [first 1] [ps parameters] [written (cdr (syntax->list (cadr l)))])
    (while (pair? ps)
      (let* ([type-form (cadr (syntax->list (car written)))] [kind (syntax-e type-form)]
             [builtin (and entry (symbol? kind)
                           (or (== kind 'global-invocation-id) (== kind 'local-invocation-id) (== kind 'workgroup-id)
                               (== kind 'num-workgroups) (== kind 'local-invocation-index)))])
        (set! s (join `(,s ,(if first '"" '", ") ,(if builtin (join `("@builtin(" ,(shade-wgsl-name kind) ") ")) '"")
                       ,(shade-wgsl-name (car (car ps))) ": " ,(shade-wgsl-type (cdr (car ps)))))))
      (set! first 0)
      (set! ps (cdr ps))
      (set! written (cdr written)))
    (set! s (join `(,s ")")))
    (cond [(and entry (type-equal? result '(vec 4 f32))) (set! s (join `(,s " -> @location(0) vec4f")))]
          [(!= result 'void) (set! s (join `(,s " -> " ,(shade-wgsl-type result))))])
    (emit-line! (join `(,s " {")))
    (+= indent 1)
    (statements body parameters result (!= result 'void))
    (-= indent 1)
    (emit-line! '"}")))
