;; A Shade library of noise: numbers that look random but are the same for the same place.
(require-unqualified substrate "../../compiler/substrate/substrate.sub")
(require-unqualified shade "shade.sub")

(provide noise)

(shade-library noise
  (define (hash [p vec2]) -> f32
    (fract (* (sin (dot p (vec2 127.1 311.7))) 43758.5453)))
  (define (noise [p vec2]) -> f32
    (let* ([i (floor p)] [f (fract p)] [u (* f f (- (vec2 3.0) (* 2.0 f)))])
      (mix (mix (hash i) (hash (+ i (vec2 1.0 0.0))) u.x)
           (mix (hash (+ i (vec2 0.0 1.0))) (hash (+ i (vec2 1.0 1.0))) u.x)
           u.y)))
  (define (fbm [p vec2] [octaves i32]) -> f32
    (let ([sum 0.0] [amplitude 0.5] [q p])
      (for ([i 0]) (< i octaves) (+= i 1)
        (+= sum (* (noise q) amplitude))
        (set! q (+ (* q 2.1) (vec2 13.0 7.0)))
        (*= amplitude 0.5))
      sum))
  (define (gradient [i vec2]) -> vec2
    (let ([a (* (hash i) 6.2831853)])
      (vec2 (cos a) (sin a))))
  ;; A quintic step, which keeps the second derivative smooth.
  (define (gradient-noise [p vec2]) -> f32
    (let* ([i (floor p)] [f (fract p)]
           [u (* f f f (+ (* f (- (* f 6.0) 15.0)) 10.0))]
           [a (dot (gradient i) f)]
           [b (dot (gradient (+ i (vec2 1.0 0.0))) (- f (vec2 1.0 0.0)))]
           [c (dot (gradient (+ i (vec2 0.0 1.0))) (- f (vec2 0.0 1.0)))]
           [d (dot (gradient (+ i (vec2 1.0 1.0))) (- f (vec2 1.0 1.0)))])
      (+ 0.5 (* 0.7 (mix (mix a b u.x) (mix c d u.x) u.y)))))
  (define (gradient-fbm [p vec2] [octaves i32]) -> f32
    (let ([sum 0.0] [amplitude 0.5] [q p])
      (for ([i 0]) (< i octaves) (+= i 1)
        (+= sum (* (gradient-noise q) amplitude))
        (set! q (+ (* q 2.1) (vec2 13.0 7.0)))
        (*= amplitude 0.5))
      sum))
  (define (wrapped [i vec2] [period vec2]) -> vec2
    (- i (* period (floor (/ i period)))))
  (define (tiled-noise [p vec2] [period vec2]) -> f32
    (let* ([i (floor p)] [f (fract p)]
           [u (* f f f (+ (* f (- (* f 6.0) 15.0)) 10.0))]
           [a (dot (gradient (wrapped i period)) f)]
           [b (dot (gradient (wrapped (+ i (vec2 1.0 0.0)) period)) (- f (vec2 1.0 0.0)))]
           [c (dot (gradient (wrapped (+ i (vec2 0.0 1.0)) period)) (- f (vec2 0.0 1.0)))]
           [d (dot (gradient (wrapped (+ i (vec2 1.0 1.0)) period)) (- f (vec2 1.0 1.0)))])
      (+ 0.5 (* 0.7 (mix (mix a b u.x) (mix c d u.x) u.y)))))
  (define (tiled-fbm [p vec2] [period vec2] [octaves i32]) -> f32
    (let ([sum 0.0] [amplitude 0.5] [q p] [n period])
      (for ([i 0]) (< i octaves) (+= i 1)
        (+= sum (* (tiled-noise q n) amplitude))
        (set! q (* q 2.0))
        (set! n (* n 2.0))
        (*= amplitude 0.5))
      sum)))
