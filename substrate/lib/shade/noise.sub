;; Lifecycle: experimental.
;;
;; A Shade library of noise: numbers that look random but are the same
;; for the same place, which clouds, terrain and textures are made from.
;;
;;   (hash p) -> f32          a number from 0 to 1 for a vec2, with no
;;                            pattern
;;   (noise p) -> f32         value noise: smooth, 0 to 1, with features
;;                            about one unit across
;;   (fbm p octaves) -> f32   noise at several scales added up, each
;;                            twice as fine and half as strong (fractal
;;                            Brownian motion); `octaves` is how many
;;   (gradient-noise p) -> f32
;;                            gradient noise (Perlin's): smooth, 0 to 1,
;;                            about 0.5 on average, with rounded
;;                            features about one unit across where
;;                            value noise shows its lattice; dearer
;;   (gradient-fbm p octaves) -> f32
;;                            fbm of gradient noise
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified shade "shade.sub")

(provide noise)

(memory from base)
(table from base)

(shade-library noise
  (define (hash [p vec2]) -> f32
    (fract (* (sin (dot p (vec2 127.1 311.7))) 43758.5453)))
  ;; The hash at the four lattice points around p, blended by a smooth
  ;; step.
  (define (noise [p vec2]) -> f32
    (let* ([i (floor p)] [f (fract p)] [u (* f f (- (vec2 3.0) (* 2.0 f)))])
      (mix (mix (hash i) (hash (+ i (vec2 1.0 0.0))) u.x)
           (mix (hash (+ i (vec2 0.0 1.0))) (hash (+ i (vec2 1.0 1.0))) u.x)
           u.y)))
  (define (fbm [p vec2] [octaves i32]) -> f32
    (let ([sum 0.0] [amplitude 0.5] [q p])
      (for ([i 0]) (< i octaves) (+= i 1)
        (+= sum (* (noise q) amplitude))
        (set! q (+ (* q 2.1) (vec2 13.0 7.0)))
        (*= amplitude 0.5))
      sum))
  ;; A unit vector at a lattice point, from its hash.
  (define (gradient [i vec2]) -> vec2
    (let ([a (* (hash i) 6.2831853)])
      (vec2 (cos a) (sin a))))
  ;; The dot of each corner's gradient with the offset from it, blended
  ;; by a quintic step, which keeps the second derivative smooth.
  (define (gradient-noise [p vec2]) -> f32
    (let* ([i (floor p)] [f (fract p)]
           [u (* f f f (+ (* f (- (* f 6.0) 15.0)) 10.0))]
           [a (dot (gradient i) f)]
           [b (dot (gradient (+ i (vec2 1.0 0.0))) (- f (vec2 1.0 0.0)))]
           [c (dot (gradient (+ i (vec2 0.0 1.0))) (- f (vec2 0.0 1.0)))]
           [d (dot (gradient (+ i (vec2 1.0 1.0))) (- f (vec2 1.0 1.0)))])
      (+ 0.5 (* 0.7 (mix (mix a b u.x) (mix c d u.x) u.y)))))
  (define (gradient-fbm [p vec2] [octaves i32]) -> f32
    (let ([sum 0.0] [amplitude 0.5] [q p])
      (for ([i 0]) (< i octaves) (+= i 1)
        (+= sum (* (gradient-noise q) amplitude))
        (set! q (+ (* q 2.1) (vec2 13.0 7.0)))
        (*= amplitude 0.5))
      sum)))
