;; Lifecycle: experimental.
;;
;; A Shade library of colour: between the screen's sRGB and the linear
;; values lighting is computed on, and from more range than a screen
;; has down to it.
;;
;;   (linear c) -> vec3       sRGB to linear, by the power 2.2
;;   (srgb c) -> vec3         linear to sRGB
;;   (tone c) -> vec3         a colour brought into 0 to 1 by ACES's
;;                            curve, as films and games use it (the
;;                            fit by Krzysztof Narkowicz)
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified shade "shade.sub")

(provide color)

(memory from base)
(table from base)

(shade-library color
  (define (linear [c vec3]) -> vec3 (pow c (vec3 2.2)))
  (define (srgb [c vec3]) -> vec3 (pow c (vec3 (/ 1.0 2.2))))
  (define (tone [c vec3]) -> vec3
    (clamp (/ (* c (+ (* 2.51 c) 0.03)) (+ (* c (+ (* 2.43 c) 0.59)) 0.14)) (vec3 0.0) (vec3 1.0))))
