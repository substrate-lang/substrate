;; A Shade library of colour: sRGB and linear values, and tone mapping.
(require-unqualified shade "shade.sub")

(provide color)

(shade-library color
  (define (linear [c vec3]) -> vec3 (pow c (vec3 2.2)))
  (define (srgb [c vec3]) -> vec3 (pow c (vec3 (/ 1.0 2.2))))
  (define (tone [c vec3]) -> vec3
    (clamp (/ (* c (+ (* 2.51 c) 0.03)) (+ (* c (+ (* 2.43 c) 0.59)) 0.14)) (vec3 0.0) (vec3 1.0))))
