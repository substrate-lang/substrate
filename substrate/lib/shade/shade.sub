;; Lifecycle: experimental.
;;
;; Shade, the forms a module writes it with. core.sub is the language
;; itself: its types, what its expressions and statements are, and how
;; they are checked and turned into WGSL. A shader form
;; (lib/web/scene/shader.sub) holds Shade definitions and entry points;
;; this file has the form that shares definitions between shaders:
;;
;;   (shade-library name definition ...)
;;       Binds `name`, at compile time, to the definitions: functions,
;;       structs and constants as core.sub has them. A shader form that
;;       says [use name] has them, checked in its own context, as if
;;       written in it. A module gets a library's name by requiring the
;;       module that defines it.
(require-unqualified base "../../compiler/base/base.sub")

(provide shade-library)

(memory from base)
(table from base)

(begin-for-syntax
  (require-unqualified base "../../compiler/base/base.sub")
  (require-unqualified kd "../../compiler/kernel.sub")
  (require sm "../../compiler/base/syntax-match.sub" syntax-match _ ... ?)

  (define (shade-library-form [s datum]) -> datum
    (syntax-match s
      [(_ (? identifier? name) d ...)
       #`(define-syntax #,name (shade-library-value (quote-syntax (#,@d))))]
      [_ (raise-syntax-error 'shade-library '"expected (shade-library name definition ...)" s)]))

  ;; The compile-time value a library's name is bound to: the list
  ;; (shade-library definitions), where definitions is syntax for the
  ;; definitions. A shader form's [use ...] reads it.
  (define (shade-library-value [definitions datum]) -> datum `(shade-library ,definitions)))

(define-syntax shade-library shade-library-form)
