;; Lifecycle: permanent library, part of the language built on the kernel.
;;
;; Output for tests and examples: bytes and integers, written with
;; host.write from this module's memory.
;;
;; A module that writes its own bytes shares this memory with
;; (memory from "print.sub"). Bytes 0..1023 belong to the printing
;; libraries; put your own data at 1024 or above.

(provide write-bytes write-byte newline write-int)

(memory 1)

(import host-write "host" "write" (i32 i32 i32 -> i32))

(func (write-bytes [p i32] [n i32]) (drop (host-write 1 p n)))
(func (write-byte [b i32]) (i32.store8 0 b) (write-bytes 0 1))
(func (newline) (write-byte 10))

;; A signed integer in decimal, formatted in bytes 32..63.
(func (write-int [n i32])
  (let ([p 64] [u n] [neg (i32.lt_s n 0)])
    (if neg (set! u (i32.sub 0 n)))
    (block done
      (loop next
        (set! p (i32.sub p 1))
        (i32.store8 p (i32.add 48 (i32.rem_u u 10)))
        (set! u (i32.div_u u 10))
        (br-if done (i32.eqz u))
        (br next)))
    (if neg
        (begin (set! p (i32.sub p 1)) (i32.store8 p 45)))
    (write-bytes p (i32.sub 64 p))))
