;; Lifecycle: experimental. Substrate on cells (next/cells): lib/substrate.sub
;; on core.sub here, whose values are the kernel module's cells. Its macros
;; are written in Substrate, at phase 1, on the core's forms, as
;; lib/substrate.sub's are: Substrate's data is the kernel module's, syntax
;; objects included, so a macro takes syntax apart with the same car and
;; cdr it takes lists apart with. A module written in Substrate takes its
;; forms with require-unqualified:
;;
;;   define, lambda, case-lambda, set!, calls, let, let*, letrec, struct:
;;                                  core.sub's, as lib/substrate.sub's
;;   quote, quasiquote              the kernel's: data as Substrate's values
;;   if, cond (with else), case (with else), when, unless, and, or, do
;;   (with-handlers ([pred handler] ...) body ...)
;;                                  body's value; if body raises a value
;;                                  that a pred is true of, the value of
;;                                  the first such pred's handler, called
;;                                  with it once body has been left
;;   (syntax-match subject [pattern body ...] ...)
;;   (match subject [pattern body ...] ...)
;;                                  the body of the first clause whose
;;                                  pattern subject matches, with the
;;                                  pattern's variables bound: syntax-match
;;                                  takes syntax apart, and match any
;;                                  value, structs included (patterns,
;;                                  below)
;;   (define-syntax (name stx) body ...), (define-syntax name expr)
;;                                  a macro, if the value is a procedure,
;;                                  which becomes its transformer; the
;;                                  module must also take Substrate at
;;                                  phase 1
;;   (define-syntax name (syntax-rules (literal ...) [pattern template] ...))
;;                                  a macro by patterns (rules.sub), which
;;                                  needs no Substrate at phase 1
;;
;; and the functions core.sub provides and those below, as
;; lib/substrate.sub has them.

(require-unqualified core "core.sub")
(require rules "rules.sub" syntax-rules define-rules)
(require pt "../c/patterns.sub" _ ... ?)
(begin-for-syntax (require-unqualified core "core.sub"))

(provide (except-out (all-from-out core) call-with-handlers define-syntax reverse) else when unless and or cond case do with-handlers quasiquote reverse
         syntax-match match _ ... ? [define-syntax substrate-define-syntax] syntax-rules
         list-tail list-ref last-pair take [drop list-drop] last findf range sort
         memq memv member assq assv assoc map for-each andmap ormap filter foldl foldr)

;; ---- forms -----------------------------------------------------------------------------

;; else is a keyword of clauses, such as cond's and case's last, which the
;; forms compare by binding; as an expression it is an error.
(define-syntax (else stx) (raise-syntax-error #f "not allowed as an expression" stx))

;; Helpers of the macros below, at phase 1.
(begin-for-syntax
  (define (else? x) (if (identifier? x) (free-identifier=? x #'else) #f))

  ;; The cond clauses of case's clauses cs, testing k: case binds it.
  (define (case-clauses cs)
    (if (null? cs)
        '()
        (let ([c (syntax->list (car cs))])
          (if (not c) (raise-syntax-error 'case "expected a clause: [(datum ...) body ...]" (car cs)))
          (cons (if (else? (car c))
                    #`[else #,@(cdr c)]
                    #`[#,(datum-test (car c)) #,@(cdr c)])
                (case-clauses (cdr cs))))))

  ;; The test that k is one of the datums ds, a syntax list. If equal?
  ;; compares them as references, an eq? test per datum, each inline:
  ;; (if (eq? k 'd1) '#t (if (eq? k 'd2) '#t ... '#f)). Otherwise member.
  (define (datum-test ds)
    (if (eq-datums? (syntax->datum ds))
        (eq-tests (syntax->list ds))
        #`(member k '#,ds)))

  (define (eq-tests ds)
    (if (null? ds) #''#f #`(if (eq? k '#,(car ds)) '#t #,(eq-tests (cdr ds)))))

  ;; Whether ds is a list of datums that equal? compares as references:
  ;; symbols and keywords, which are interned, fixnums, booleans and ().
  (define (eq-datums? ds)
    (if (null? ds)
        #t
        (if (pair? ds)
            (let ([d (car ds)])
              (if (if (symbol? d) #t (if (keyword? d) #t (if (fixnum? d) #t (if (boolean? d) #t (null? d)))))
                  (eq-datums? (cdr ds))
                  #f))
            #f)))

  ;; Part i of each of with-handlers' clauses cs, [pred handler].
  (define (clause-parts cs i)
    (if (null? cs)
        '()
        (let ([c (syntax->list (car cs))])
          (if (if c (= (length c) 2) #f)
              (cons (if (= i 0) (car c) (car (cdr c))) (clause-parts (cdr cs) i))
              (raise-syntax-error 'with-handlers "expected a clause: [pred handler]" (car cs))))))

  (define (do-inits specs)
    (if (null? specs)
        '()
        (let ([spec (syntax->list (car specs))])
          (cons #`[#,(car spec) #,(car (cdr spec))] (do-inits (cdr specs))))))

  (define (do-steps specs)
    (if (null? specs)
        '()
        (let ([spec (syntax->list (car specs))])
          (cons (if (null? (cdr (cdr spec))) (car spec) (car (cdr (cdr spec)))) (do-steps (cdr specs)))))))

(define-syntax (when stx)
  (let ([parts (syntax->list stx)])
    #`(if #,(car (cdr parts)) (begin #,@(cdr (cdr parts))))))

(define-syntax (unless stx)
  (let ([parts (syntax->list stx)])
    #`(if #,(car (cdr parts)) '#f (begin #,@(cdr (cdr parts))))))

(define-syntax (and stx)
  (let ([args (cdr (syntax->list stx))])
    (if (null? args)
        #''#t
        (if (null? (cdr args))
            (car args)
            #`(if #,(car args) (and #,@(cdr args)) '#f)))))

(define-syntax (or stx)
  (let ([args (cdr (syntax->list stx))])
    (if (null? args)
        #''#f
        (if (null? (cdr args))
            (car args)
            #`(let ([t #,(car args)]) (if t t (or #,@(cdr args))))))))

;; (cond [test body ...] ... [else body ...])
(define-syntax (cond stx)
  (let ([clauses (cdr (syntax->list stx))])
    (if (null? clauses)
        #''#f
        (let ([c (syntax->list (car clauses))])
          (if (else? (car c))
              #`(begin #,@(cdr c))
              #`(if #,(car c) (begin #,@(cdr c)) (cond #,@(cdr clauses))))))))

;; (case key [(datum ...) body ...] ... [else body ...]): the first clause
;; with a datum equal? to key. A clause whose datums equal? compares as
;; references is tested with eq?, which is inline, one datum at a time.
(define-syntax (case stx)
  (let ([parts (syntax->list stx)])
    #`(let ([k #,(car (cdr parts))]) (cond #,@(case-clauses (cdr (cdr parts)))))))

;; (do ([x init step] ...) (test result ...) body ...): a loop. A variable
;; without a step keeps its value.
(define-syntax (do stx)
  (let* ([parts (syntax->list stx)]
         [specs (syntax->list (car (cdr parts)))]
         [end (syntax->list (car (cdr (cdr parts))))])
    #`(let loop (#,@(do-inits specs))
        (if #,(car end)
            (begin '#f #,@(cdr end))
            (begin #,@(cdr (cdr (cdr parts))) (loop #,@(do-steps specs)))))))

;; (with-handlers ([pred handler] ...) body ...)
(define-syntax (with-handlers stx)
  (let* ([parts (syntax->list stx)] [clauses (syntax->list (car (cdr parts)))])
    #`(call-with-handlers (list #,@(clause-parts clauses 0)) (list #,@(clause-parts clauses 1))
                          (lambda () #,@(cdr (cdr parts))))))

;; `t: the datum template t, with ,e the value of e and ,@e the elements
;; of list e, made with Substrate's cons and append, which own what they
;; are given; the kernel's quasiquote makes it with the kernel module's
;; functions, which share what they are given without counting owners
;; (lower.sub). A part of t with no unquote in it is a constant. Inside a
;; nested quasiquote, an unquote is data, down to the depth it unquotes.
(begin-for-syntax
  (define (qq-named? x name) (if (identifier? x) (eq? (syntax-e x) name) #f))
  (define (qq-form? x name)
    (let ([e (if (syntax? x) (syntax-e x) x)])
      (if (pair? e) (if (qq-named? (car e) name) (pair? (cdr e)) #f) #f)))

  ;; Has template t, syntax or a list of it, no unquote or quasiquote?
  (define (qq-constant? t)
    (let ([e (if (syntax? t) (syntax-e t) t)])
      (if (pair? e)
          (if (qq-named? (car e) 'unquote) #f
              (if (qq-named? (car e) 'unquote-splicing) #f
                  (if (qq-named? (car e) 'quasiquote) #f
                      (if (qq-constant? (car e)) (qq-constant? (cdr e)) #f))))
          #t)))

  (define (qq-quote t stx) #`(quote #,(datum->syntax stx (syntax->datum t))))

  ;; (unquote e) or (quasiquote e) kept as data, e a template one level
  ;; down or up.
  (define (qq-keep head e depth stx) #`(cons (quote #,head) (cons #,(qq-template e depth stx) '())))

  (define (qq-template t depth stx)
    (let ([e (if (syntax? t) (syntax-e t) t)])
      (if (qq-constant? t)
          (qq-quote t stx)
          (if (qq-form? t 'unquote)
              (if (= depth 0) (car (cdr e)) (qq-keep 'unquote (car (cdr e)) (- depth 1) stx))
              (if (qq-form? t 'quasiquote)
                  (qq-keep 'quasiquote (car (cdr e)) (+ depth 1) stx)
                  (qq-list e depth stx))))))

  ;; The elements of template list l, then its tail, if it has one: (a .
  ;; ,e) is (a unquote e).
  (define (qq-list l depth stx)
    (if (qq-constant? l)
        (qq-quote l stx)
        (if (syntax? l)
            (qq-template l depth stx)
            (if (qq-named? (car l) 'unquote)
                (qq-template l depth stx)
                (if (qq-form? (car l) 'unquote-splicing)
                    (if (= depth 0)
                        #`(append #,(car (cdr (syntax-e (car l)))) #,(qq-list (cdr l) depth stx))
                        #`(cons #,(qq-keep 'unquote-splicing (car (cdr (syntax-e (car l)))) (- depth 1) stx) #,(qq-list (cdr l) depth stx)))
                    #`(cons #,(qq-template (car l) depth stx) #,(qq-list (cdr l) depth stx))))))))

(define-syntax (quasiquote stx)
  (let ([parts (syntax->list stx)])
    (if (if parts (= (length parts) 2) #f)
        (qq-template (car (cdr parts)) 0 stx)
        (raise-syntax-error 'quasiquote "expected (quasiquote template)" stx))))

;; (define-syntax name (syntax-rules (literal ...) clause ...)): a macro
;; by patterns, compiled into C (rules.sub); any other define-syntax is
;; the core's, whose transformer is Substrate code.
(begin-for-syntax
  (define (rules? x)
    (let ([l (syntax->list x)])
      (if (if l (pair? l) #f) (if (identifier? (car l)) (free-identifier=? (car l) #'syntax-rules) #f) #f))))

(define-syntax (substrate-define-syntax stx)
  (let ([parts (syntax->list stx)])
    (if (if (= (length parts) 3) (if (identifier? (car (cdr parts))) (rules? (car (cdr (cdr parts)))) #f) #f)
        #`(define-rules #,(car (cdr parts)) #,@(cdr (syntax->list (car (cdr (cdr parts))))))
        #`(define-syntax #,@(cdr parts)))))

;; ---- lists -----------------------------------------------------------------------------
;;
;; Each function checks its argument as it walks it, once, and names
;; itself and the whole list in its error, as the core's do. A loop is a
;; function calling itself in tail position; at the end, the tail must be
;; (). A parameter a function only reads, a list it walks or a function
;; it calls, is #:borrow (core.sub): its caller keeps the value, so the
;; walk counts nothing; one it gives away, as an accumulator consed onto,
;; or gives a value it made to in a tail call, which would then not be
;; one, is owned.

(define (not-a-list who l) (error who "expected a list, got ~s" l))

;; The end of list l, whose tail is t, for function who: v, or the error.
(define (ended who l t v) #:borrow (who l t) (if (null? t) v (not-a-list who l)))

;; The end of lists ls, whose tails are ts: v, or the error, for a list
;; that is not one or for lengths that differ.
(define (ended-n who ls ts v) #:borrow (who ls ts)
  (cond [(andmap null? ts) v]
        [else (for-each (lambda (l) (list-of l who)) ls) (error who "all lists must have the same size")]))
(define (ended-2 who a b ta tb v) #:borrow (who a b ta tb) (ended-n who (list a b) (list ta tb) v))

;; l, which must be a list, for function who.
(define (list-of l who) #:borrow (l who) (if (list? l) l (not-a-list who l)))

;; k, which must be a count: an integer from 0 up.
(define (count-of k who) #:borrow (k who)
  (cond [(and (fixnum? k) (>= k 0)) k]
        [(integer? k) (error who "index ~s is out of range" k)]
        [else (error who "expected an integer, got ~s" k)]))

;; l after its first n elements, for function who, given index k.
(define (tail-of l n k who) #:borrow (l k who)
  (cond [(= n 0) l]
        [(pair? l) (tail-of (cdr l) (- n 1) k who)]
        [else (error who "index ~s is out of range" k)]))

(define (list-tail l k) #:borrow (l k) (tail-of l (count-of k 'list-tail) k 'list-tail))
;; Provided as drop: in kernel code, drop is the wasm instruction.
(define (list-drop l k) #:borrow (l k) (tail-of l (count-of k 'drop) k 'drop))

(define (list-ref l k) #:borrow (l k)
  (let ([t (tail-of l (count-of k 'list-ref) k 'list-ref)])
    (if (pair? t) (car t) (error 'list-ref "index ~s is out of range" k))))

;; The first k elements of l.
(define (take l k) #:borrow (l k) (take-of l (count-of k 'take) k '()))

(define (take-of l n k acc) #:borrow (l k)
  (cond [(= n 0) (reverse-onto acc '())]
        [(pair? l) (take-of (cdr l) (- n 1) k (cons (car l) acc))]
        [else (error 'take "index ~s is out of range" k)]))

(define (last-pair l) #:borrow (l) (if (pair? l) (last-pair-of l) (error 'last-pair "expected a pair, got ~s" l)))
(define (last-pair-of p) #:borrow (p) (if (pair? (cdr p)) (last-pair-of (cdr p)) p))
(define (last l) #:borrow (l) (if (pair? l) (car (last-pair-of l)) (error 'last "expected a pair, got ~s" l)))

;; The first element of l that f is true of, or #f.
(define (findf f l) #:borrow (f l) (find-in f l l))
(define (find-in f l l0) #:borrow (f l l0)
  (cond [(pair? l) (if (f (car l)) (car l) (find-in f (cdr l) l0))]
        [else (ended 'findf l0 l #f)]))

;; (range end) or (range start end): the integers from start, or 0, up to
;; but not including end.
(define range
  (case-lambda
    [(end) (range-down (- (count-of end 'range) 1) 0 '())]
    [(start end) (let ([s (count-of start 'range)]) (range-down (- (count-of end 'range) 1) s '()))]))
(define (range-down i start acc) #:borrow (start) (if (< i start) acc (range-down (- i 1) start (cons i acc))))

;; l sorted by less?, keeping the order of elements neither is less than
;; the other: a stable merge sort.
(define (sort l less?) #:borrow (less?)
  (if (unshared-pair? l)
      (if (list? l) (sort-owned l less?) (not-a-list 'sort l))
      (merge-sort (list-of l 'sort) (length l) less?)))

;; A proper list sort owns, sorted: split into the elements at even and
;; odd places, each half sorted, the halves merged. Each step takes a
;; pair apart and a cons takes its cell back (lower.sub), so sorting
;; makes no cells but one per split.
(define (sort-owned l less?) #:borrow (less?)
  (if (pair? l)
      (if (pair? (cdr l)) (sort-halves (unzip l '() '()) less?) l)
      l))
(define (sort-halves ab less?) #:borrow (less?)
  (if (pair? ab) (merge-owned (sort-owned (car ab) less?) (sort-owned (cdr ab) less?) less? '()) ab))
(define (unzip l a b)
  (if (pair? l) (unzip (cdr l) (cons (car l) b) a) (cons a b)))
;; a and b, sorted, merged onto acc, reversed; a's first taken apart,
;; then b's, and the one not taken put back.
(define (merge-owned a b less? acc) #:borrow (less?)
  (if (pair? a) (merge-a (car a) (cdr a) b less? acc) (reverse-onto acc b)))
(define (merge-a xa ra b less? acc) #:borrow (less?)
  (if (pair? b) (merge-ab xa ra (car b) (cdr b) less? acc) (reverse-onto acc (cons xa ra))))
(define (merge-ab xa ra xb rb less? acc) #:borrow (less?)
  (if (less? xb xa)
      (merge-a xa ra rb less? (cons xb acc))
      (merge-owned ra (cons xb rb) less? (cons xa acc))))

(define (merge-sort l n less?) #:borrow (l less?)
  (if (<= n 1)
      l
      (let ([h (quotient n 2)])
        (merge (merge-sort (take-of l h h '()) h less?) (merge-sort (tail-of l h h 'sort) (- n h) less?) less? '()))))

;; Sorted lists a and b as one sorted list; of equal elements, a's first.
(define (merge a b less? acc) #:borrow (a b less?)
  (cond [(null? a) (reverse-onto acc b)]
        [(null? b) (reverse-onto acc a)]
        [(less? (car b) (car a)) (merge a (cdr b) less? (cons (car b) acc))]
        [else (merge (cdr a) b less? (cons (car a) acc))]))

;; acc reversed, followed by l.
(define (reverse-onto acc l) (if (pair? acc) (reverse-onto (cdr acc) (cons (car acc) l)) l))

;; l reversed: in place, its cells reused, when l is its caller's last
;; reference (lower.sub, a pair taken apart); the core's copies it.
(define (reverse l) (if (list? l) (reverse-onto l '()) (not-a-list 'reverse l)))

;; The first tail of l whose car is x, by eq?, eqv? or equal?.
(define (memq x l) #:borrow (x l) (cond [(not (pair? l)) #f] [(eq? x (car l)) l] [else (memq x (cdr l))]))
(define (memv x l) #:borrow (x l) (cond [(not (pair? l)) #f] [(eqv? x (car l)) l] [else (memv x (cdr l))]))
(define (member x l) #:borrow (x l) (cond [(not (pair? l)) #f] [(equal? x (car l)) l] [else (member x (cdr l))]))

;; The first pair of alist l whose car is x, by eq?, eqv? or equal?.
(define (assq x l) #:borrow (x l) (cond [(not (pair? l)) #f] [(eq? x (key-of (car l) 'assq)) (car l)] [else (assq x (cdr l))]))
(define (assv x l) #:borrow (x l) (cond [(not (pair? l)) #f] [(eqv? x (key-of (car l) 'assv)) (car l)] [else (assv x (cdr l))]))
(define (assoc x l) #:borrow (x l) (cond [(not (pair? l)) #f] [(equal? x (key-of (car l) 'assoc)) (car l)] [else (assoc x (cdr l))]))
(define (key-of p who) #:borrow (p who) (if (pair? p) (car p) (error who "expected a pair, got ~s" p)))

;; f applied to the elements of lists in order: their results as a list
;; (map), nothing (for-each), whether all are true (andmap) or the first
;; true one (ormap). The lists must have one length. Two lists are walked
;; together; more go through apply.
(define map
  (case-lambda
    [(f l) (if (unshared-pair? l) (map-consume f l '()) (map-in f l l '()))]
    [(f a b) (map-2 f a b a b '())]
    [(f l . ls) (map-n f (cons l ls) (cons l ls) '())]))
(define (map-in f l l0 acc) #:borrow (f l l0)
  (if (pair? l) (map-in f (cdr l) l0 (cons (f (car l)) acc)) (ended 'map l0 l (reverse-onto acc '()))))
;; map of a list it owns, its cells taken apart and reused (lower.sub).
(define (map-consume f l acc) #:borrow (f)
  (if (pair? l)
      (map-consume f (cdr l) (cons (f (car l)) acc))
      (if (null? l) (reverse-onto acc '()) (not-a-list 'map l))))
(define (map-2 f a b a0 b0 acc) #:borrow (f a b a0 b0)
  (if (and (pair? a) (pair? b))
      (map-2 f (cdr a) (cdr b) a0 b0 (cons (f (car a) (car b)) acc))
      (ended-2 'map a0 b0 a b (reverse-onto acc '()))))
(define (map-n f ls ls0 acc) #:borrow (f ls0)
  (if (andmap pair? ls) (map-n f (cdrs ls) ls0 (cons (apply f (cars ls)) acc)) (ended-n 'map ls0 ls (reverse-onto acc '()))))

(define for-each
  (case-lambda
    [(f l) (for-each-in f l l)]
    [(f a b) (for-each-2 f a b a b)]
    [(f l . ls) (for-each-n f (cons l ls) (cons l ls))]))
(define (for-each-in f l l0) #:borrow (f l l0) (if (pair? l) (begin (f (car l)) (for-each-in f (cdr l) l0)) (ended 'for-each l0 l #f)))
(define (for-each-2 f a b a0 b0) #:borrow (f a b a0 b0)
  (if (and (pair? a) (pair? b))
      (begin (f (car a) (car b)) (for-each-2 f (cdr a) (cdr b) a0 b0))
      (ended-2 'for-each a0 b0 a b #f)))
(define (for-each-n f ls ls0) #:borrow (f ls0)
  (if (andmap pair? ls) (begin (apply f (cars ls)) (for-each-n f (cdrs ls) ls0)) (ended-n 'for-each ls0 ls #f)))

(define andmap
  (case-lambda
    [(f l) (andmap-in f l l #t)]
    [(f a b) (andmap-2 f a b a b #t)]
    [(f l . ls) (andmap-n f (cons l ls) (cons l ls) #t)]))
(define (andmap-in f l l0 r) #:borrow (f l l0)
  (if (pair? l) (let ([v (f (car l))]) (if v (andmap-in f (cdr l) l0 v) #f)) (ended 'andmap l0 l r)))
(define (andmap-2 f a b a0 b0 r) #:borrow (f a b a0 b0)
  (if (and (pair? a) (pair? b))
      (let ([v (f (car a) (car b))]) (if v (andmap-2 f (cdr a) (cdr b) a0 b0 v) #f))
      (ended-2 'andmap a0 b0 a b r)))
(define (andmap-n f ls ls0 r) #:borrow (f ls0)
  (if (andmap pair? ls) (let ([v (apply f (cars ls))]) (if v (andmap-n f (cdrs ls) ls0 v) #f)) (ended-n 'andmap ls0 ls r)))

(define ormap
  (case-lambda
    [(f l) (ormap-in f l l)]
    [(f l . ls) (ormap-n f (cons l ls) (cons l ls))]))
(define (ormap-in f l l0) #:borrow (f l l0) (if (pair? l) (or (f (car l)) (ormap-in f (cdr l) l0)) (ended 'ormap l0 l #f)))
(define (ormap-n f ls ls0) #:borrow (f ls0) (if (andmap pair? ls) (or (apply f (cars ls)) (ormap-n f (cdrs ls) ls0)) (ended-n 'ormap ls0 ls #f)))

(define (cars ls) #:borrow (ls) (if (null? ls) '() (cons (car (car ls)) (cars (cdr ls)))))
(define (cdrs ls) #:borrow (ls) (if (null? ls) '() (cons (cdr (car ls)) (cdrs (cdr ls)))))

;; The elements of l that keep? is true of.
(define (filter keep? l) #:borrow (keep?) (if (unshared-pair? l) (filter-consume keep? l '()) (filter-in keep? l l '())))
(define (filter-consume keep? l acc) #:borrow (keep?)
  (if (pair? l)
      (filter-consume keep? (cdr l) (if (keep? (car l)) (cons (car l) acc) acc))
      (if (null? l) (reverse-onto acc '()) (not-a-list 'filter l))))
(define (filter-in keep? l l0 acc) #:borrow (keep? l l0)
  (if (pair? l)
      (filter-in keep? (cdr l) l0 (if (keep? (car l)) (cons (car l) acc) acc))
      (ended 'filter l0 l (reverse-onto acc '()))))

;; f called with an element of each list, then the value so far, from the
;; left (foldl) or the right (foldr).
(define foldl
  (case-lambda
    [(f init l) (foldl-in f init l l)]
    [(f init l . ls) (foldl-n f init (cons l ls) (cons l ls))]))
(define foldr
  (case-lambda
    [(f init l) (foldl-in f init (reverse (list-of l 'foldr)) l)]
    [(f init l . ls) (foldl-n f init (map reverse (cons l ls)) (cons l ls))]))
(define (foldl-in f acc l l0) #:borrow (f l l0) (if (pair? l) (foldl-in f (f (car l) acc) (cdr l) l0) (ended 'foldl l0 l acc)))
(define (foldl-n f acc ls ls0) #:borrow (f ls0)
  (if (andmap pair? ls) (foldl-n f (apply f (append (cars ls) (list acc))) (cdrs ls) ls0) (ended-n 'foldl ls0 ls acc)))

;; ---- patterns ----------------------------------------------------------------------
;;
;; (syntax-match subject [pattern body ...] ...) takes syntax apart, as
;; quasisyntax builds it, and (match subject [pattern body ...] ...) takes
;; any value apart. The clauses are tried in order: the first whose
;; pattern the subject matches binds the pattern's variables, and its body
;; gives the value. A pattern is:
;;
;;   x                  an identifier: anything, bound to x
;;   _                  anything
;;   #:kw "s" 5 #\c #t  a value equal? to it; syntax whose datum is
;;   'd                 a value equal? to d; syntax whose datum is: for a
;;                      symbol, an identifier of that name
;;   #'id               an identifier free-identifier=? to id, which asks
;;                      the expander, so only a macro can use it
;;   (p ...), (p ... . tail)
;;                      a list, or a syntax list, element by element
;;   p ...              in a list, as many elements that match p as there
;;                      can be while the rest of the list matches
;;   (? pred p ...)     x, if (pred x) is true and every p matches x
;;   (name p ...)       in match, when name is a struct's: one of it, whose
;;                      fields match p ...
;;
;; A variable is bound to what it matched, or under an ellipsis to the
;; list of what each element bound, which #,@ splices. _, ... and ? are
;; patterns.sub's, compared by binding. If no clause matches, syntax-match
;; raises a syntax error blamed on the subject: "expected" and the
;; patterns, each written as it is, but for a check (? pred p ...),
;; written as its last p, and a _ at a pattern's head, written as the
;; subject's head. match raises an error that shows the subject.
;;
;; A clause's pattern is compiled, at phase 1, in Substrate, into a test
;; of the subject: code true if the subject matches, which sets a local
;; for each of the pattern's variables to what it matched on the way. The
;; clause is (if test body next), next the following clauses', so each is
;; written once. A value the patterns use that is an identifier, such as
;; a struct's predicate or accessor, is called by name, and any other is
;; evaluated once, first. p ... ending a list is a loop; a list in which
;; p ... is followed by more of it backtracks, and is left to matches?,
;; which walks its description at run time.

(begin-for-syntax
  ;; A pattern is parsed into a description, a datum that the pattern's
  ;; code is compiled from (below), and matches? walks if it backtracks:
  ;; (var i name), the pattern's variable i; (any); (datum d); (bound i
  ;; name), an identifier free-identifier=? to value i; (check i p ...),
  ;; value i being the predicate; (struct i name (p ...)), value i being
  ;; the struct's predicate and the values after it its accessors; or
  ;; (list (element ...) tail), where an element is a description or
  ;; (repeat p (i ...)), p repeated, binding variables i ..., and tail is
  ;; a description or (null). The values are the form's predicates, #'id
  ;; identifiers and struct functions, which it evaluates first. A name
  ;; is as written, for errors.

  (define (pattern-keyword? x k) (if (identifier? x) (free-identifier=? x k) #f))

  ;; Is l a list of two elements?
  (define (two? l) (if (pair? l) (if (pair? (cdr l)) (null? (cdr (cdr l))) #f) #f))

  ;; The numbers from i below n.
  (define (numbers-from i n) (if (< i n) (cons i (numbers-from (+ i 1) n)) '()))

  (define (nth l i) (if (= i 0) (car l) (nth (cdr l) (- i 1))))

  ;; Is an identifier in ids named as id is?
  (define (named-in? id ids)
    (if (null? ids) #f (if (eq? (syntax-e (car ids)) (syntax-e id)) #t (named-in? id (cdr ids)))))

  ;; The information of the struct id names, if id is bound to a struct's
  ;; transformer (core.sub): the syntax (struct-info name constructor
  ;; predicate (accessor ...) (field ...)); else #f.
  (define (struct-info-of id)
    (let ([v (if (identifier? id) (syntax-local-value id) #f)])
      (if (if v (transformer? v) #f)
          (let ([l (syntax->list (transformer-env v))])
            (if (if l (pair? l) #f)
                (if (if (identifier? (car l)) (eq? (syntax-e (car l)) 'struct-info) #f) l #f)
                #f))
          #f)))

  ;; Patterns ps of a who form, match or syntax-match, parsed, as
  ;; (descriptions variables values): for each pattern its description
  ;; and its variables, in order, and the values the descriptions refer
  ;; to, in order.
  (define (parse-patterns ps who)
    (let ([values '()] [vars '()])
      (letrec
          ([value! (lambda (e) (set! values (cons e values)) (- (length values) 1))]
           [values! (lambda (es) (if (null? es) #f (begin (value! (car es)) (values! (cdr es)))))]
           [var! (lambda (id)
                   (if (named-in? id vars)
                       (raise-syntax-error who "this pattern variable appears twice in its pattern" id)
                       (begin (set! vars (cons id vars)) (- (length vars) 1))))]
           [parse (lambda (p)
                    (let ([e (syntax-e p)])
                      (if (symbol? e)
                          (if (pattern-keyword? p #'_)
                              '(any)
                              (if (if (pattern-keyword? p #'...) #t (pattern-keyword? p #'?))
                                  (raise-syntax-error who "not allowed here in a pattern" p)
                                  (list 'var (var! p) e)))
                          (if (pair? e) (parse-form p e) (if (null? e) '(list () (null)) (list 'datum e))))))]
           [parse-form (lambda (p e)
                         (if (if (two? e) (pattern-keyword? (car e) #'quote) #f)
                             (list 'datum (syntax->datum (cadr e)))
                             (if (if (two? e) (pattern-keyword? (car e) #'quote-syntax) #f)
                                 (if (identifier? (cadr e))
                                     (list 'bound (value! p) (syntax-e (cadr e)))
                                     (raise-syntax-error who "expected #'identifier" p))
                                 (if (pattern-keyword? (car e) #'?)
                                     (if (if (pair? (cdr e)) (list? (cdr e)) #f)
                                         (cons 'check (cons (value! (cadr e)) (parse-all (cddr e))))
                                         (raise-syntax-error who "expected (? predicate pattern ...)" p))
                                     (let ([info (if (eq? who 'match) (struct-info-of (car e)) #f)])
                                       (if info
                                           (parse-struct p e info)
                                           (let ([r (elements e)]) (list 'list (car r) (cdr r)))))))))]
           ;; (name p ...) for a struct: its predicate, then its accessors,
           ;; are values.
           [parse-struct (lambda (p e info)
                           (let ([fields (syntax->list (nth info 5))])
                             (if (= (length (cdr e)) (length fields))
                                 (let ([i (value! (nth info 3))])
                                   (values! (syntax->list (nth info 4)))
                                   (list 'struct i (syntax-e (cadr info)) (parse-all (cdr e))))
                                 (raise-syntax-error who
                                                     (format "~a has ~a field~a, not ~a" (syntax-e (cadr info))
                                                             (length fields) (if (= (length fields) 1) "" "s")
                                                             (length (cdr e)))
                                                     p))))]
           [parse-all (lambda (ps) (if (null? ps) '() (let ([d (parse (car ps))]) (cons d (parse-all (cdr ps))))))]
           ;; The elements and the tail of pair chain l, as (elements . tail).
           [elements (lambda (l)
                       (if (pair? l)
                           (if (pattern-keyword? (car l) #'...)
                               (raise-syntax-error who "... follows the pattern it repeats" (car l))
                               (if (if (pair? (cdr l)) (pattern-keyword? (cadr l) #'...) #f)
                                   (let* ([before (length vars)]
                                          [d (parse (car l))]
                                          [repeat (list 'repeat d (numbers-from before (length vars)))]
                                          [r (elements (cddr l))])
                                     (cons (cons repeat (car r)) (cdr r)))
                                   (let* ([d (parse (car l))] [r (elements (cdr l))])
                                     (cons (cons d (car r)) (cdr r)))))
                           (cons '() (if (null? l) '(null) (parse l)))))])
        (let loop ([ps ps] [descs '()] [varss '()])
          (if (null? ps)
              (list (reverse descs) (reverse varss) (reverse values))
              (begin
                (set! vars '())
                (let ([d (parse (car ps))])
                  (loop (cdr ps) (cons d descs) (cons (reverse vars) varss)))))))))

  ;; A who form's clauses, each [pattern body ...], as lists.
  (define (match-clauses cs who)
    (if (null? cs)
        '()
        (let ([c (syntax->list (car cs))])
          (if (if c (>= (length c) 2) #f)
              (cons c (match-clauses (cdr cs) who))
              (raise-syntax-error who "expected a clause [pattern body ...]" (car cs))))))

  (define (clause-patterns cs) (if (null? cs) '() (cons (car (car cs)) (clause-patterns (cdr cs)))))

  (define (literal d) (datum->syntax #'here d))

  ;; ---- compiling patterns ----
  ;;
  ;; A clause's pattern is compiled into a test of the subject: an
  ;; expression true if the subject matches, which sets a local for each
  ;; of the pattern's variables to what it matched on the way. The clause
  ;; is (if test body next), next the following clauses', so each is
  ;; written once. A value the patterns use that is an identifier, such as
  ;; a struct's predicate or accessor, is called by name, and any other is
  ;; evaluated once, first. p ... ending a list is a loop; a list in which
  ;; p ... is followed by more of it backtracks, and is left to matches?.

  (define temps 0)

  ;; A temporary: an identifier no other of this expansion is.
  (define (temp base)
    (set! temps (+ temps 1))
    (datum->syntax #'here (string->symbol (string-append base (number->string temps)))))

  (define (temps-for l base) (if (null? l) '() (cons (temp base) (temps-for (cdr l) base))))

  ;; The form's values vs, each (expression . identifier): itself if it is
  ;; an identifier, or else a temporary bound to it.
  (define (value-slots vs)
    (if (null? vs) '() (cons (cons (car vs) (if (identifier? (car vs)) (car vs) (temp "v"))) (value-slots (cdr vs)))))

  (define (value-bindings slots)
    (if (null? slots)
        '()
        (if (eq? (car (car slots)) (cdr (car slots)))
            (value-bindings (cdr slots))
            (cons #`[#,(cdr (car slots)) #,(car (car slots))] (value-bindings (cdr slots))))))

  (define (value-ref slots i) (cdr (nth slots i)))

  (define (value-refs slots) (if (null? slots) '() (cons (cdr (car slots)) (value-refs (cdr slots)))))

  (define (pairs-of xs f) (if (null? xs) '() (cons #`[#,(car xs) #,(f (car xs))] (pairs-of (cdr xs) f))))
  (define (zip-with xs ys f) (if (null? xs) '() (cons (f (car xs) (car ys)) (zip-with (cdr xs) (cdr ys) f))))

  ;; A test is code true if it matched, or (always statement ...), which
  ;; matched and sets variables: a test that only binds a variable is
  ;; nothing more.
  (define (always? t) (if (pair? t) (eq? (car t) 'always) #f))

  (define (test-code t) (if (always? t) #`(begin #,@(cdr t) #t) t))

  ;; a, then b.
  (define (both a b)
    (if (always? a)
        (if (always? b) (cons 'always (append (cdr a) (cdr b))) #`(begin #,@(cdr a) #,(test-code b)))
        #`(if #,a #,(test-code b) #f)))

  ;; The test of x, an identifier, against description d, setting vars,
  ;; the pattern's variables' locals by index. slots: the form's values.
  (define (compile-test d x vars slots)
    (let ([kind (car d)])
      (if (eq? kind 'var)
          (list 'always #`(set! #,(nth vars (cadr d)) #,x))
          (if (eq? kind 'any)
              (list 'always)
              (if (eq? kind 'datum)
                  #`(datum-matches? #,x '#,(literal (cadr d)))
                  (if (eq? kind 'bound)
                      #`(bound-matches? #,x #,(value-ref slots (cadr d)))
                      (if (eq? kind 'check)
                          (both #`(#,(value-ref slots (cadr d)) #,x) (compile-tests (cddr d) x vars slots))
                          (if (eq? kind 'struct)
                              (both #`(#,(value-ref slots (cadr d)) #,x) (compile-fields (cadddr d) (+ (cadr d) 1) x vars slots))
                              (compile-elements (cadr d) (caddr d) x vars slots)))))))))

  (define (compile-tests ds x vars slots)
    (if (null? ds)
        (list 'always)
        (if (null? (cdr ds))
            (compile-test (car ds) x vars slots)
            (both (compile-test (car ds) x vars slots) (compile-tests (cdr ds) x vars slots)))))

  ;; A struct's fields ps, read from x by the accessors, values j ....
  (define (compile-fields ps j x vars slots)
    (if (null? ps)
        (list 'always)
        (if (eq? (car (car ps)) 'any)
            (compile-fields (cdr ps) (+ j 1) x vars slots)
            (let ([y (temp "f")])
              #`(let ([#,y (#,(value-ref slots j) #,x)])
                  #,(test-code (both (compile-test (car ps) y vars slots) (compile-fields (cdr ps) (+ j 1) x vars slots))))))))

  ;; The elements es, then the tail, of r, a list or syntax list.
  (define (compile-elements es tail r vars slots)
    (if (null? es)
        (if (eq? (car tail) 'null)
            #`(null? (list-part #,r))
            (compile-test tail r vars slots))
        (if (eq? (car (car es)) 'repeat)
            (if (if (null? (cdr es)) (eq? (car tail) 'null) #f)
                (compile-repeat (car es) r vars slots)
                (compile-interpreted (list 'list es tail) r vars slots))
            (let ([m (temp "m")] [a (temp "a")] [d (temp "d")])
              #`(let ([#,m (list-pair #,r)])
                  (if #,m
                      #,(if (eq? (car (car es)) 'any)
                            #`(let ([#,d (unsafe-cdr #,m)]) #,(test-code (compile-elements (cdr es) tail d vars slots)))
                            #`(let ([#,a (unsafe-car #,m)] [#,d (unsafe-cdr #,m)])
                                #,(test-code (both (compile-test (car es) a vars slots) (compile-elements (cdr es) tail d vars slots)))))
                      #f))))))

  ;; e, (repeat p (i ...)), matching every element of r to its end: its
  ;; variables i ... set to the lists of what p matched.
  (define (compile-repeat e r vars slots)
    (let ([p (cadr e)] [is (caddr e)])
      (if (eq? (car p) 'var)
          (let ([xs (temp "xs")])
            #`(let ([#,xs (elements-of #,r)]) (if #,xs (begin (set! #,(nth vars (cadr p)) #,xs) #t) #f)))
          (if (eq? (car p) 'any)
              #`(if (elements-of #,r) #t #f)
              (let* ([loop (temp "loop")] [rest (temp "r")] [m (temp "m")] [a (temp "a")] [accs (temps-for is "acc")])
                #`(let #,loop ([#,rest #,r] #,@(pairs-of accs (lambda (acc) #''())))
                    (let ([#,m (list-part #,rest)])
                      (if (null? #,m)
                          (begin #,@(zip-with is accs (lambda (i acc) #`(set! #,(nth vars i) (reverse #,acc)))) #t)
                          (if (pair? #,m)
                              (let ([#,a (car #,m)])
                                (if #,(test-code (compile-test p a vars slots))
                                    (#,loop (cdr #,m) #,@(zip-with is accs (lambda (i acc) #`(cons #,(nth vars i) #,acc))))
                                    #f))
                              #f)))))))))

  ;; Description d, a list that backtracks, matched by matches?, as match
  ;; did before patterns were compiled.
  (define (compile-interpreted d r vars slots)
    (let ([vs (temp "vs")])
      #`(let ([#,vs (make-vector #,(literal (length vars)) #f)])
          (if (matches? '#,(literal d) #,r (vector #,@(value-refs slots)) #,vs)
              (begin #,@(vector-sets (description-vars d) vars vs) #t)
              #f))))

  (define (vector-sets is vars vs)
    (if (null? is)
        '()
        (cons #`(set! #,(nth vars (car is)) (vector-ref #,vs #,(literal (car is)))) (vector-sets (cdr is) vars vs))))

  ;; The variables description d binds.
  (define (description-vars d)
    (if (eq? (car d) 'var)
        (list (cadr d))
        (if (eq? (car d) 'list)
            (append (elements-vars (cadr d)) (description-vars (caddr d)))
            (if (eq? (car d) 'repeat)
                (description-vars (cadr d))
                (if (eq? (car d) 'check)
                    (elements-vars (cddr d))
                    (if (eq? (car d) 'struct) (elements-vars (cadddr d)) '()))))))

  (define (elements-vars ds) (if (null? ds) '() (append (description-vars (car ds)) (elements-vars (cdr ds)))))

  ;; Code that tries clauses cs, whose patterns have descriptions ds and
  ;; variables varss, against x, in turn, and runs last if none matches.
  (define (compile-clauses cs ds varss x last slots)
    (if (null? cs)
        last
        (let* ([vars (temps-for (car varss) "v")]
               [test (compile-test (car ds) x vars slots)]
               [body #`(let (#,@(zip-with (car varss) vars (lambda (name v) #`[#,name #,v]))) #,@(cdr (car cs)))])
          ;; A pattern that always matches leaves the clauses after it
          ;; unreachable.
          (if (always? test)
              #`(let (#,@(pairs-of vars (lambda (v) #''#f))) #,@(cdr test) #,body)
              #`(let (#,@(pairs-of vars (lambda (v) #''#f)))
                  (if #,test #,body #,(compile-clauses (cdr cs) (cdr ds) (cdr varss) x last slots)))))))

  ;; (who subject [pattern body ...] ...) expanded: the subject and the
  ;; values bound, then the clauses tried in turn, and if none matches
  ;; the code fail gives for every description and the subject.
  (define (match-form stx who fail)
    (let* ([parts (syntax->list stx)]
           [clauses (if (if parts (>= (length parts) 3) #f)
                        (match-clauses (cddr parts) who)
                        (raise-syntax-error who (format "expected (~a subject [pattern body ...] ...)" who) stx))]
           [parsed (parse-patterns (clause-patterns clauses) who)]
           [slots (value-slots (caddr parsed))]
           [x (temp "s")])
      #`(let ([#,x #,(cadr parts)] #,@(value-bindings slots))
          #,(compile-clauses clauses (car parsed) (cadr parsed) x (fail (car parsed) x) slots)))))

;; (syntax-match subject [pattern body ...] ...)
(define-syntax (syntax-match stx)
  (match-form stx 'syntax-match (lambda (all x) #`(no-match '#,(literal all) #,x))))

;; (match subject [pattern body ...] ...)
(define-syntax (match stx)
  (match-form stx 'match (lambda (all x) #`(no-value-match #,x))))

;; Does x match description d? The variables d binds are written in vs.
(define (matches? d x values vs)
  (let ([kind (car d)])
    (cond [(eq? kind 'list) (elements-match? (cadr d) (caddr d) x values vs)]
          [(eq? kind 'var) (vector-set! vs (cadr d) x) #t]
          [(eq? kind 'datum) (let ([v (cadr d)]) (equal? (if (pair? v) (syntax->datum x) (list-part x)) v))]
          [(eq? kind 'check) (and ((vector-ref values (cadr d)) x) (all-match? (cddr d) x values vs))]
          [(eq? kind 'any) #t]
          [(eq? kind 'struct) (struct-matches? d x values vs)]
          [else (and (identifier? x) (free-identifier=? x (vector-ref values (cadr d))))])))

(define (all-match? ds x values vs)
  (or (null? ds) (and (matches? (car ds) x values vs) (all-match? (cdr ds) x values vs))))

;; d is (struct i name (p ...)): is x of the struct whose predicate is
;; value i, with each field, read by the values after i, matching its p?
(define (struct-matches? d x values vs)
  (and ((vector-ref values (cadr d)) x)
       (let loop ([ps (cadddr d)] [j (+ (cadr d) 1)])
         (or (null? ps)
             (and (matches? (car ps) ((vector-ref values j) x) values vs)
                  (loop (cdr ps) (+ j 1)))))))

;; x's elements if it is a syntax list; otherwise x.
(define (list-part x) #:inline (if (syntax? x) (syntax-e x) x))

;; x's elements, if they are a pair: that pair; otherwise #f.
(define (list-pair x) (let ([m (list-part x)]) (if (pair? m) m #f)))

;; Does x match (datum v): is it v, or syntax whose datum is?
(define (datum-matches? x v) (equal? (if (pair? v) (syntax->datum x) (list-part x)) v))

;; Does x match #'id: is it an identifier free-identifier=? to id?
(define (bound-matches? x id) (and (identifier? x) (free-identifier=? x id)))

;; Do the elements of list l match descriptions es, and what follows them
;; tail?
(define (elements-match? es tail l values vs)
  (let ([m (list-part l)])
    (cond [(null? es) (if (eq? (car tail) 'null) (null? m) (matches? tail l values vs))]
          [(eq? (car (car es)) 'repeat)
           (if (and (null? (cdr es)) (eq? (car tail) 'null))
               (repeat-ends? (car es) m values vs)
               (repeat-matches? (car es) (cdr es) tail m values vs))]
          [else (and (pair? m) (matches? (car es) (car m) values vs)
                     (elements-match? (cdr es) tail (cdr m) values vs))])))

;; e is (repeat p (i ...)), the last element of its list: does every element
;; of l, to its end, match p? Variables i ... are bound to lists.
(define (repeat-ends? e l values vs)
  (let ([p (cadr e)] [vars (caddr e)])
    (if (eq? (car p) 'var)
        (let ([xs (elements-of l)]) (and xs (begin (vector-set! vs (cadr p) xs) #t)))
        (let collect ([l l] [rows '()])
          (let ([m (list-part l)])
            (cond [(null? m) (set-repeated! vars (reverse rows) vs) #t]
                  [(and (pair? m) (matches? p (car m) values vs)) (collect (cdr m) (cons (row vars vs) rows))]
                  [else #f]))))))

;; e is (repeat p (i ...)): do elements from the start of l match p, as
;; many as can while es and tail match the rest? Variables i ... are bound
;; to lists.
(define (repeat-matches? e es tail l values vs)
  (let ([p (cadr e)] [vars (caddr e)])
    ;; rows: for each element that matches p, the latest first, the values
    ;; of vars then and the rest of l after it.
    (let collect ([rest l] [rows '()])
      (let ([m (list-part rest)])
        (if (and (pair? m) (matches? p (car m) values vs))
            (collect (cdr m) (cons (cons (row vars vs) (cdr m)) rows))
            (let try ([rows rows])
              (set-repeated! vars (reverse (map car rows)) vs)
              (or (elements-match? es tail (if (null? rows) l (cdr (car rows))) values vs)
                  (and (pair? rows) (try (cdr rows))))))))))

;; The elements of list l, whose tails may be syntax lists, as a list; #f
;; if it is not a proper list.
(define (elements-of l)
  (let ([m (list-part l)])
    (cond [(null? m) '()]
          [(list? m) m]
          [(pair? m) (let ([r (elements-of (cdr m))]) (and r (cons (car m) r)))]
          [else #f])))

;; The values of vars in vs, in order.
(define (row vars vs) (if (null? vars) '() (cons (vector-ref vs (car vars)) (row (cdr vars) vs))))

;; Bind each of vars to the list of its values in rows, each row the values
;; of vars, in order.
(define (set-repeated! vars rows vs)
  (unless (null? vars)
    (vector-set! vs (car vars) (map car rows))
    (set-repeated! (cdr vars) (map cdr rows) vs)))

;; No clause of a syntax-match matched x, and ds are the descriptions of
;; the clauses' patterns: the error.
(define (no-match ds x)
  (raise-syntax-error #f (string-append "expected " (alternatives (map (lambda (d) (pattern-text d x)) ds))) x))

;; No clause of a match matched x.
(define (no-value-match x) (error 'match "no clause matches ~s" x))

;; "a", "a or b", "a, b or c".
(define (alternatives ts)
  (cond [(null? (cdr ts)) (car ts)]
        [(null? (cddr ts)) (string-append (car ts) " or " (cadr ts))]
        [else (string-append (car ts) ", " (alternatives (cdr ts)))]))

;; Description d written as its pattern is, in an error about x: a _ at its
;; head as x's head.
(define (pattern-text d x)
  (let ([l (list-part x)])
    (if (and (eq? (car d) 'list) (pair? (cadr d)) (equal? (car (cadr d)) '(any)) (pair? l) (identifier? (car l)))
        (description-text (list 'list (cons (list 'datum (syntax-e (car l))) (cdr (cadr d))) (caddr d)))
        (description-text d))))

(define (description-text d)
  (case (car d)
    [(var bound) (symbol->string (caddr d))]
    [(datum) (format "~s" (cadr d))]
    [(any) "_"]
    [(check) (if (null? (cddr d)) "_" (description-text (last (cddr d))))]
    [(repeat) (string-append (description-text (cadr d)) " ...")]
    [(struct) (string-append "(" (spaced (cons (symbol->string (caddr d)) (map description-text (cadddr d)))) ")")]
    [(list) (string-append "(" (spaced (map description-text (cadr d)))
                           (if (eq? (car (caddr d)) 'null) "" (string-append " . " (description-text (caddr d))))
                           ")")]))

;; Strings ts, with a space between each two.
(define (spaced ts) (if (null? ts) "" (foldl (lambda (t acc) (string-append acc " " t)) (car ts) (cdr ts))))
