;; Lifecycle: experimental. Part of the new compiler (next/), written in
;; the C example's C. The compiler's calls to the host (spec 4), as the
;; compiler's host.sub has them, with what that compiler takes from
;; Substrate: reading and writing files.
(require-unqualified c "../../examples/c/c.sub")

(provide read-file-bytes write-file-bytes)

(memory from c)
(table from c)

(import host-read-file "host" "read_file" (i32 i32 i32 i32 -> i32))
(import host-write-file "host" "write_file" (i32 i32 i32 i32 -> i32))

;; The bytes of the file named by C string path, followed by a 0, in
;; memory from malloc, and their count at n; or 0 if it cannot be read.
(define (read-file-bytes [path (ptr u8)] [n (ptr u32)]) -> (ptr u8)
  (let* ([length (strlen path)] [size (host-read-file (cast i32 path) length 0 0)])
    (if (< size 0)
        0
        (let ([p (cast (ptr u8) (malloc (+ size 1)))])
          (if (!= (host-read-file (cast i32 path) length (cast i32 p) size) size)
              (begin (free p) 0)
              (begin
                (set! (@ p size) 0)
                (set! (@ n) size)
                p))))))

;; The n bytes at p written to the file named by C string path, made or
;; replaced: 1, or 0 if it cannot be.
(define (write-file-bytes [path (ptr u8)] [p (ptr u8)] [n u32]) -> i32
  (>= (host-write-file (cast i32 path) (strlen path) (cast i32 p) n) 0))
