;; Lifecycle: experimental. Part of the new compiler (next/), written in
;; the C example's C: the compiler's reader.sub.
;;
;; Reader: text -> syntax objects with source locations and empty scopes.
;; It scans bytes: strings are UTF-8, and every character that shapes the
;; syntax is ASCII. Positions, spans and columns count characters, not
;; bytes.
(require-unqualified c "../../examples/c/c.sub")
(require-unqualified stx "syntax.sub")
(require-unqualified numbers "numbers.sub")
(require-unqualified host "host.sub")

(provide read-file read-all)

(memory from c)
(table from c)

;; The text being read, its length in bytes, the byte index of its next
;; character, that character's index, and its line and column; and the
;; file it is from, a symbol.
(define text (ptr u8) 0)
(define text-bytes u32 0)
(define bpos u32 0)
(define pos u32 0)
(define line u32 1)
(define col u32 0)
(define source datum 0)

;; Where a datum starts.
(struct place [pos u32] [line u32] [col u32])

;; The first byte of the next character, or -1 at the end; and of the one
;; after it.
(define (peek) -> i32 (if (< bpos text-bytes) (@ text bpos) -1))

(define (peek2) -> i32
  (let ([b (peek)])
    (if (< b 0)
        -1
        (let ([i (+ bpos (char-bytes b))]) (if (< i text-bytes) (@ text i) -1)))))

;; The length of the UTF-8 sequence whose first byte is b.
(define (char-bytes [b i32]) -> u32 (if (< b 128) 1 (if (< b 224) 2 (if (< b 240) 3 4))))

;; Advance past the next character; returns its first byte.
(define (next!) -> i32
  (let ([b (@ text bpos)])
    (+= bpos (char-bytes b))
    (+= pos 1)
    (if (== b 10)
        (begin (+= line 1) (set! col 0))
        (+= col 1))
    b))

(define (here) -> place
  (let ([p place])
    (set! (-> p pos) pos)
    (set! (-> p line) line)
    (set! (-> p col) col)
    p))

(define (loc-from [start (ptr place)]) -> (ptr srcloc)
  (make-srcloc source (-> start line) (-> start col) (-> start pos) (- pos (-> start pos))))

;; A compile error at start: template, with args (format-message).
(define (fail [start (ptr place)] [template (ptr u8)] [args datum])
  (raise-compile-error (make-srcloc source (-> start line) (-> start col) (-> start pos) 1) (format-message template args)))

(define (list1 [x datum]) -> datum (cons x nil))

;; The bytes of the text from byte index from to the next character's, as
;; a string.
(define (text-from [from u32]) -> datum (bytes->string (+ text from) (- bpos from)))

;; Space and the control characters tab to return are whitespace; ( ) [ ]
;; " ; and the end delimit.
(define (whitespace? [b i32]) -> i32 (or (== b 32) (and (>= b 9) (<= b 13))))

(define (delimiter? [b i32]) -> i32
  (or (< b 0) (whitespace? b) (== b #\() (== b #\)) (== b #\[) (== b #\]) (== b #\") (== b #\;)))

;; Skip whitespace and comments, up to what starts the next datum.
(define (skip-atmosphere!)
  (while 1
    (let ([b (peek)])
      (unless (>= b 0) (return))
      (if (whitespace? b)
          (next!)
          (if (== b #\;)
              ;; To the end of the line.
              (while (and (>= (peek) 0) (!= (peek) 10)) (next!))
              (if (and (== b #\#) (== (peek2) #\|))
                  (skip-block-comment!)
                  (if (and (== b #\#) (== (peek2) #\;))
                      ;; #; and the datum after it.
                      (begin (next!) (next!) (read-datum))
                      (return))))))))

;; #| ... |#, which nest.
(define (skip-block-comment!)
  (let ([start (here)] [depth 1])
    (next!)
    (next!)
    (while (> depth 0)
      (let ([b (peek)])
        (when (< b 0) (fail (& start) "read: unterminated block comment" nil))
        (if (and (== b #\|) (== (peek2) #\#))
            (begin (next!) (next!) (-= depth 1))
            (if (and (== b #\#) (== (peek2) #\|))
                (begin (next!) (next!) (+= depth 1))
                (next!)))))))

;; The characters up to the next delimiter: the byte index where they
;; start, the next character's being where they end.
(define (read-token) -> u32
  (let ([start bpos])
    (while (not (delimiter? (peek))) (next!))
    start))

(define (wrap [start (ptr place)] [e datum]) -> datum (make-syntax e no-scopes (loc-from start) nil))

;; The datum after a prefix, from start, the symbol named name, such as
;; quote, wrapped with it.
(define (prefix-form [start (ptr place)] [name (ptr u8)]) -> datum
  (let* ([head-loc (loc-from start)] [d (read-datum)])
    (when (== d 0) (fail start "read: expected a datum after ~a" (list1 (symbol-named name))))
    (wrap start (cons (make-syntax (symbol-named name) no-scopes head-loc nil) (list1 d)))))

;; A list from start, up to close: its elements' syntax, and a tail after
;; a dot.
(define (read-list [start (ptr place)] [close i32]) -> datum
  (let ([head nil] [last datum 0])
    (while 1
      (skip-atmosphere!)
      (let ([b (peek)])
        (when (< b 0) (fail start "read: unterminated list" nil))
        (when (or (== b #\)) (== b #\]))
          (unless (== b close)
            (let ([at (here)]) (fail (& at) "read: mismatched ~a" (list1 (integer->char b)))))
          (next!)
          (return (wrap start head)))
        (if (and (== b #\.) (delimiter? (peek2)) (!= last 0))
            (let ([tail datum 0])
              (next!)
              (set! tail (read-datum))
              (skip-atmosphere!)
              (unless (== (peek) close) (fail start "read: expected ~a after dotted tail" (list1 (integer->char close))))
              (next!)
              (set-cdr! last tail)
              (return (wrap start head)))
            (let ([p (list1 (read-datum))])
              (if (== last 0) (set! head p) (set-cdr! last p))
              (set! last p)))))
    0))

;; A string literal: its bytes, with the escapes \n \t \r \0 \\ \" and
;; \xH...; replaced, as a new string.
(define (read-string-lit [start (ptr place)]) -> datum
  (let ([b (make-buffer)] [s datum 0])
    (next!)
    (while 1
      (let ([c (peek)])
        (when (< c 0) (fail start "read: unterminated string" nil))
        (if (== c #\")
            (begin
              (next!)
              (set! s (wrap start (bytes->string (-> b bytes) (-> b length))))
              (buffer-free! (& b))
              (return s))
            (if (== c #\\)
                (let ([e 0])
                  (next!)
                  (set! e (peek))
                  (when (< e 0) (fail start "read: unterminated string" nil))
                  (next!)
                  (if (== e #\n)
                      (buffer-add-byte! (& b) 10)
                      (if (== e #\t)
                          (buffer-add-byte! (& b) 9)
                          (if (== e #\r)
                              (buffer-add-byte! (& b) 13)
                              (if (== e #\0)
                                  (buffer-add-byte! (& b) 0)
                                  (if (or (== e #\\) (== e #\"))
                                      (buffer-add-byte! (& b) e)
                                      (if (== e #\x)
                                          (buffer-add-utf-8! (& b) (hex-escape start))
                                          (fail start "read: unknown string escape \\~a" (list1 (integer->char e))))))))))
                ;; The next character's bytes.
                (let ([from bpos])
                  (next!)
                  (buffer-add! (& b) (+ text from) (- bpos from)))))))
    0))

;; The hex digits of a \x escape, up to the ; that ends it, as a code
;; point.
(define (hex-escape [start (ptr place)]) -> u32
  (let ([n u32 0] [any 0])
    (while 1
      (let ([h (peek)] [d 0])
        (when (< h 0) (fail start "read: unterminated \\x escape" nil))
        (when (== h #\;)
          (next!)
          (unless (and any (<= n 1114111)) (fail start "read: bad \\x escape" nil))
          (return n))
        (set! d (digit-value h 16))
        (when (< d 0) (fail start "read: bad \\x escape" nil))
        (next!)
        (unless (> n 1114111) (set! n (+ (* n 16) d)))
        (set! any 1)))
    0))

;; The code point of the UTF-8 sequence at p.
(define (code-point [p (ptr u8)]) -> u32
  (let ([b (@ p 0)])
    (if (< b 128)
        b
        (if (< b 224)
            (bit-or (<< (bit-and b 31) 6) (bit-and (@ p 1) 63))
            (if (< b 240)
                (bit-or (<< (bit-and b 15) 12) (<< (bit-and (@ p 1) 63) 6) (bit-and (@ p 2) 63))
                (bit-or (<< (bit-and b 7) 18) (<< (bit-and (@ p 1) 63) 12) (<< (bit-and (@ p 2) 63) 6) (bit-and (@ p 3) 63)))))))

;; Whether the text from byte index from to the next character's is C
;; string s.
(define (token=? [from u32] [s (ptr u8)]) -> i32
  (let ([n (strlen s)])
    (and (== (- bpos from) n) (bytes=? (+ text from) s n))))

(define (bytes=? [a (ptr u8)] [b (ptr u8)] [n u32]) -> i32
  (for ([i u32 0]) (< i n) (+= i 1)
    (when (!= (@ a i) (@ b i)) (return 0)))
  1)

;; A character after #\ : one character, then any that follow up to a
;; delimiter, which make its name, or #\xH... its code point.
(define (read-char-lit [start (ptr place)]) -> datum
  (when (< (peek) 0) (fail start "read: unexpected end after #\\" nil))
  (let* ([from bpos] [first (code-point (+ text bpos))] [rest (begin (next!) (read-token))] [n u64 0]
         [names (array (ptr u8) 10)] [codes (array u32 10)])
    (when (== rest bpos) (return (wrap start (integer->char first))))
    (set! (@ names 0) "space") (set! (@ codes 0) 32)
    (set! (@ names 1) "newline") (set! (@ codes 1) 10)
    (set! (@ names 2) "tab") (set! (@ codes 2) 9)
    (set! (@ names 3) "nul") (set! (@ codes 3) 0)
    (set! (@ names 4) "return") (set! (@ codes 4) 13)
    (set! (@ names 5) "linefeed") (set! (@ codes 5) 10)
    (set! (@ names 6) "delete") (set! (@ codes 6) 127)
    (set! (@ names 7) "alarm") (set! (@ codes 7) 7)
    (set! (@ names 8) "backspace") (set! (@ codes 8) 8)
    (set! (@ names 9) "escape") (set! (@ codes 9) 27)
    (for ([i 0]) (< i 10) (+= i 1)
      (when (token=? from (@ names i)) (return (wrap start (integer->char (@ codes i))))))
    (when (and (== first #\x) (digits? text rest bpos 16) (digits-integer text rest bpos 16 0 (& n)))
      (return (wrap start (integer->char (cast u32 n)))))
    (fail start "read: unknown character #\\~a" (list1 (text-from from)))
    0))

(define (read-hash [start (ptr place)]) -> datum
  (next!)
  (let ([b (peek)])
    (when (< b 0) (fail start "read: unexpected end after #" nil))
    (when (== b #\() (fail start "read: vector syntax #( is not part of the kernel" nil))
    (when (== b #\')
      (next!)
      (return (prefix-form start "quote-syntax")))
    (when (== b #\`)
      (next!)
      (return (prefix-form start "quasisyntax")))
    (when (== b #\,)
      (next!)
      (when (== (peek) #\@)
        (next!)
        (return (prefix-form start "unsyntax-splicing")))
      (return (prefix-form start "unsyntax")))
    (when (== b #\\)
      (next!)
      (return (read-char-lit start)))
    ;; #:name is a keyword.
    (when (== b #\:)
      (next!)
      (let ([t (read-token)]) (return (wrap start (bytes->keyword (+ text t) (- bpos t))))))
    ;; #%name is a symbol, used for implicit forms like #%app.
    (when (== b #\%)
      (let ([t (- (read-token) 1)]) (return (wrap start (bytes->symbol (+ text t) (- bpos t))))))
    (let* ([t (read-token)] [n (radix-number start t)])
      (when (or (token=? t "t") (token=? t "true")) (return (wrap start (boolean 1))))
      (when (or (token=? t "f") (token=? t "false")) (return (wrap start 0)))
      (when (!= n 0) (return (wrap start n)))
      (fail start "read: unknown syntax #~a" (list1 (text-from t)))
      0)))

(define (read-datum) -> datum
  (skip-atmosphere!)
  (let ([start (here)] [b (peek)])
    (when (< b 0) (return 0))
    (when (or (== b #\() (== b #\[))
      (next!)
      (return (read-list (& start) (if (== b #\() #\) #\]))))
    (when (or (== b #\)) (== b #\])) (fail (& start) "read: unexpected ~a" (list1 (integer->char b))))
    (when (== b #\')
      (next!)
      (return (prefix-form (& start) "quote")))
    (when (== b #\`)
      (next!)
      (return (prefix-form (& start) "quasiquote")))
    (when (== b #\,)
      (next!)
      (when (== (peek) #\@)
        (next!)
        (return (prefix-form (& start) "unquote-splicing")))
      (return (prefix-form (& start) "unquote")))
    (when (== b #\") (return (read-string-lit (& start))))
    (when (== b #\#) (return (read-hash (& start))))
    (let* ([t (read-token)] [n (if (token=? t ".") 0 (token-number (& start) t))])
      (wrap (& start) (if (!= n 0) n (bytes->symbol (+ text t) (- bpos t)))))))

;; ---- numbers ----
;;
;; The kernel's number literals are integers of up to 64 bits, from -2^63
;; to 2^64 - 1 as in wasm, and decimals (spec 5.4): an optional sign and
;; digits, or #x, #b, #o or #d and an integer in that radix; or a decimal
;; (read-decimal). A fraction, such as 1/2, is an error; any other token
;; is a symbol.

;; 1 if the text has a sign at byte index i, before end, else 0.
(define (sign-length [i u32] [end u32]) -> u32
  (if (and (< i end) (or (== (@ text i) #\+) (== (@ text i) #\-))) 1 0))

;; The integer of the digits from byte index from to end in radix, negated
;; if negative is not 0; the text from shown to end names it in the error
;; if it does not fit in 64 bits.
(define (integer-at [start (ptr place)] [from u32] [end u32] [radix i32] [negative i32] [shown u32]) -> datum
  (let ([bits u64 0])
    (unless (digits-integer text from end radix negative (& bits))
      (fail start "read: the integer ~a does not fit in 64 bits" (list1 (bytes->string (+ text shown) (- end shown)))))
    (if negative (make-integer (cast i64 bits)) (make-unsigned-integer bits))))

;; The number #tok reads as, tok the token from byte index t, for #x, #b,
;; #o and #d; #f otherwise.
(define (radix-number [start (ptr place)] [t u32]) -> datum
  (let* ([c (if (< t bpos) (@ text t) 0)]
         [radix (if (or (== c #\x) (== c #\X))
                    16
                    (if (or (== c #\b) (== c #\B))
                        2
                        (if (or (== c #\o) (== c #\O)) 8 (if (or (== c #\d) (== c #\D)) 10 0))))]
         [from (+ t 1 (sign-length (+ t 1) bpos))])
    (if (and (!= radix 0) (digits? text from bpos radix))
        (integer-at start from bpos radix (and (> from (+ t 1)) (== (@ text (+ t 1)) #\-)) (- t 1))
        0)))

;; The number the token from byte index t reads as, or #f if it is a
;; symbol.
(define (token-number [start (ptr place)] [t u32]) -> datum
  (let* ([end bpos] [from (+ t (sign-length t end))] [negative (and (> from t) (== (@ text t) #\-))] [x f64 0])
    (when (digits? text from end 10) (return (integer-at start from end 10 negative t)))
    (when (fraction? from end)
      (fail start "read: ~a is not a number literal: use integers and decimals" (list1 (text-from t))))
    ;; A decimal, or +inf.0, -inf.0, +nan.0 or -nan.0.
    (if (read-decimal (+ text t) (- end t) (& x)) (make-flonum x) 0)))

;; Digits, a slash and digits, from byte index from to end: only a token
;; that starts with a digit is looked through for the slash.
(define (fraction? [from u32] [end u32]) -> i32
  (when (or (>= from end) (< (digit-value (@ text from) 10) 0)) (return 0))
  (for ([i (+ from 1)]) (< i end) (+= i 1)
    (when (== (@ text i) #\/) (return (and (digits? text from i 10) (digits? text (+ i 1) end 10)))))
  0)

;; ---- entry ----

;; Every datum in the n bytes at p, as a list; src, a symbol, names the file
;; in their source locations.
(define (read-all [p (ptr u8)] [n u32] [src datum]) -> datum
  (set! text p)
  (set! text-bytes n)
  (set! bpos 0)
  (set! pos 0)
  (set! line 1)
  (set! col 0)
  (set! source src)
  (let ([head nil] [last datum 0] [d (read-datum)])
    (while (!= d 0)
      (let ([q (list1 d)])
        (if (== last 0) (set! head q) (set-cdr! last q))
        (set! last q))
      (set! d (read-datum)))
    head))

;; Every datum in the file named by string path, which names it in their
;; source locations.
(define (read-file [path datum]) -> datum
  (let* ([name (make-buffer)] [n u32 0] [p (ptr u8) 0] [forms datum 0])
    (buffer-add! (& name) (string-bytes path) (string-length path))
    (buffer-add-byte! (& name) 0)
    (set! p (read-file-bytes (-> name bytes) (& n)))
    (buffer-free! (& name))
    (when (== p 0) (raise-compile-error 0 (format-message "cannot read ~a" (list1 path))))
    (set! forms (read-all p n (string->symbol path)))
    (free p)
    forms))
