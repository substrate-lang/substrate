;; Lifecycle: experimental. Part of the new compiler (next/), written in
;; the C-like Lisp (next/c): the compiler's main.sub, but for compiled files and
;; the cache, which come later.
;;
;;   ROOT build FILE [-o DIR]       write FILE's program to DIR, for build/subhost:
;;                                  each linklet it instantiates at run time, as
;;                                  DIR/<name>.wasm, and DIR/program, their names in
;;                                  the order they are instantiated (spec 4)
;;   ROOT compile FILE [-o OUT]     write FILE's linklets: phase 0 to OUT, phase p
;;                                  to OUT with .phase<p>.wasm
;;   ROOT expand FILE               print FILE's fully expanded phase-0 forms
;;
;; ROOT is the repository. next/sub runs this on a host (spec 4) from the
;; package root, whose absolute path it gives with -p DIR: modules are
;; named relative to it (spec 3.6), and to ROOT without -p. The paths a
;; command is given, FILE and the one after -o, are relative to the
;; directory -d DIR names, where next/sub was run, or else to the working
;; directory. -r DIR names the directory of this compiler's own build,
;; whose kernel module compile-time code shares and programs carry
;; (expander.sub, the kernel module).
(require-unqualified c "../c/c.sub")
(require-unqualified k "kernel.sub")
(require-unqualified ex "expander.sub")
(require-unqualified host "host.sub")
(require print "../../lib/print.sub")

(provide print-expanded)

(memory from c)
(table from c)

(import host-arg "host" "arg" (i32 i32 i32 -> i32))
(import host-exit "host" "exit" (i32 ->))
(import host-write "host" "write" (i32 i32 i32 -> i32))

;; The program's arguments, as a list of strings: host.arg gives each's
;; length, and -1 past the last.
(define (arguments) -> datum
  (let ([args nil] [i 0] [n (host-arg 0 0 0)])
    (while (>= n 0)
      (let ([p (cast (ptr u8) (malloc (+ n 1)))])
        (host-arg i (cast i32 p) n)
        (set! args (cons (bytes->string p n) args))
        (free p))
      (+= i 1)
      (set! n (host-arg i 0 0)))
    (reverse args)))

;; The value after flag in args, or #f.
(define (option [args datum] [flag datum]) -> datum
  (let ([m (member flag args)]) (if (and (!= m 0) (pair? (cdr m))) (cadr m) 0)))

;; args without flag and its value.
(define (without-option [args datum] [flag datum]) -> datum
  (cond [(null? args) nil]
        [(and (string=? (car args) flag) (pair? (cdr args))) (cddr args)]
        [else (cons (car args) (without-option (cdr args) flag))]))

(define (absolute? [path datum]) -> i32 (and (> (string-length path) 0) (== (@ (string-bytes path) 0) #\/)))

(define (string-join [a datum] [b datum]) -> datum
  (let ([buf (make-buffer)] [s datum 0])
    (buffer-add! (& buf) (string-bytes a) (string-length a))
    (buffer-add! (& buf) (string-bytes b) (string-length b))
    (set! s (bytes->string (-> buf bytes) (-> buf length)))
    (buffer-free! (& buf))
    s))

(define (usage)
  (print-string "usage: sub ROOT build FILE [-o DIR] | compile FILE [-o OUT] | expand FILE\n")
  (host-exit 64))

;; path without its extension, the part after the last dot of its last
;; segment.
(define (strip-extension [path datum]) -> datum
  (let ([i (- (cast i32 (string-length path)) 1)] [bytes (string-bytes path)])
    (while (>= i 0)
      (when (== (@ bytes i) #\.) (return (bytes->string bytes (cast u32 i))))
      (when (== (@ bytes i) #\/) (return path))
      (-= i 1))
    path))

;; String s's bytes written to the file path names, or a compile error.
(define (write-file [path datum] [s datum])
  (let ([name (make-buffer)] [ok i32 0])
    (buffer-add! (& name) (string-bytes path) (string-length path))
    (buffer-add-byte! (& name) 0)
    (set! ok (write-file-bytes (-> name bytes) (string-bytes s) (string-length s)))
    (buffer-free! (& name))
    (unless ok (raise-compile-error 0 (format-message "cannot write ~a" (cons path nil))))))

;; strings joined, in the current arena.
(define (joined [strings datum]) -> datum
  (let ([b (make-buffer)] [s datum 0])
    (while (pair? strings)
      (buffer-add! (& b) (string-bytes (car strings)) (string-length (car strings)))
      (set! strings (cdr strings)))
    (set! s (bytes->string (-> b bytes) (-> b length)))
    (buffer-free! (& b))
    s))

;; ---- writing fully expanded code ----

(define line-width u32 80)

;; x written for reading, from column col, into b: on one line when it
;; fits in line-width; else a list as "(", its first element, and, when
;; that is a symbol, its second on the same line, then each other element
;; on a line of its own, two columns in.
(define (layout [b (ptr buffer)] [x datum] [col u32])
  (let* ([flat (make-buffer)] [prefix (abbreviation-of x)])
    (write-to (& flat) x 0)
    (cond [(or (<= (+ col (-> flat length)) line-width) (not (list? x)) (null? x))
           (buffer-add! b (-> flat bytes) (-> flat length))]
          [(!= prefix 0)
           (buffer-add-string! b prefix)
           (layout b (cadr x) (+ col (strlen prefix)))]
          [else
           (let* ([head (car x)] [inline (and (symbol? head) (pair? (cdr x)))] [rest (if inline (cddr x) (cdr x))])
             (buffer-add-byte! b 40)
             (layout b head (+ col 1))
             (when inline
               (buffer-add-byte! b 32)
               (layout b (cadr x) (+ col 2 (symbol-length head))))
             (while (pair? rest)
               (buffer-add-byte! b 10)
               (for ([i u32 0]) (< i (+ col 2)) (+= i 1) (buffer-add-byte! b 32))
               (layout b (car rest) (+ col 2))
               (set! rest (cdr rest)))
             (buffer-add-byte! b 41))])
    (buffer-free! (& flat))))

;; The prefix write abbreviates x with, a list (quote y) or its kin; or 0.
(define (abbreviation-of [x datum]) -> (ptr u8)
  (if (and (list? x) (== (length x) 2))
      (let ([head (car x)])
        (cond [(== head (sym quote)) "'"] [(== head (sym quasiquote)) "`"]
              [(== head (sym unquote)) ","] [(== head (sym unquote-splicing)) ",@"]
              [(== head (sym quote-syntax)) "#'"] [(== head (sym quasisyntax)) "#`"]
              [(== head (sym unsyntax)) "#,"] [(== head (sym unsyntax-splicing)) "#,@"]
              [else 0]))
      0))

(define (print-expanded [form datum])
  (let ([b (make-buffer)])
    (layout (& b) (syntax->datum form) 0)
    (buffer-add-byte! (& b) 10)
    (print:write-bytes (cast i32 (-> b bytes)) (-> b length))
    (buffer-free! (& b))))

;; ---- the command ----

(define (run [args datum])
  (when (null? args) (usage))
  (set-repository-root! (car args))
  (set-package-root! (option args `"-p"))
  (let ([dir (option args `"-r")]) (when (!= dir 0) (set-running-directory! dir)))
  (let* ([from (option args `"-d")]
         [rest (without-option (without-option (without-option (without-option (cdr args) `"-c") `"-p") `"-d") `"-r")]
         [given (lambda ([path datum]) -> datum
                  (if (and (!= from 0) (not (absolute? path))) (string-join from (string-join `"/" path)) path))]
         [command (if (pair? rest) (car rest) `"")]
         [file (if (and (pair? rest) (pair? (cdr rest))) (given (cadr rest)) 0)]
         [out (let ([o (option rest `"-o")]) (if (!= o 0) (given o) 0))])
    (cond
      [(and (!= file 0) (string=? command `"build"))
       (when (!= (option rest `"-m") 0) (raise-compile-error 0 `"compiled files are not yet in the new compiler"))
       (let* ([m (compile-module-file file)] [linklets (program-linklets m)] [dir (if (!= out 0) out (strip-extension file))]
              [ls linklets] [names nil])
         (while (pair? ls)
           (write-file (joined `(,dir "/" ,(car (car ls)) ".wasm")) (cdr (car ls)))
           (set! names (cons `"\n" (cons (car (car ls)) names)))
           (set! ls (cdr ls)))
         (write-file (joined `(,dir "/program")) (joined (reverse names))))]
      [(and (!= file 0) (string=? command `"compile"))
       (let* ([m (compile-module-file file)] [o (if (!= out 0) out (joined `(,(strip-extension file) ".wasm")))]
              [ls (module-linklet-list m)])
         (while (pair? ls)
           (write-file (if (== (integer-value (car (car ls))) 0)
                           o
                           (format-message "~a.phase~a.wasm" `(,(strip-extension o) ,(car (car ls)))))
                       (cdr (car ls)))
           (set! ls (cdr ls))))]
      [(and (!= file 0) (null? (cddr rest)) (string=? command `"expand"))
       (expand-module-file file (lambda ([f datum]) (print-expanded f)))]
      [else (usage)])))

(define (main)
  ;; A compile error stops the compiler.
  (try (run (arguments))
       [catch compile-error (message blamed loc)
        (let ([b (make-buffer)])
          (write-compile-error (& b) message blamed loc)
          (host-write 2 (cast i32 (-> b bytes)) (-> b length))
          (host-exit 1))]))

;; After a trap: report it where it happened (spec 4).
(define (on-trap)
  (let ([r (trap-report)]) (host-write 2 (cast i32 (string-bytes r)) (string-length r))))
