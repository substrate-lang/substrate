;; Lifecycle: experimental. Part of the new compiler (next/), written in
;; the C-like Lisp (next/c). Numbers below the kernel's data, as the compiler's
;; numbers.sub has them, with what that compiler takes from Substrate
;; (lib/substrate-core.sub): integers from their digits, and decimals read
;; and written exactly. A decimal reads as the f64 nearest its value, ties
;; to even (spec 5.4), and a flonum is written with the fewest digits that
;; read back as it, and of those the nearest.
;;
;; The exact arithmetic is on natural numbers of any size, as arrays of
;; 32-bit limbs, least significant first, each in a u64. The numbers of one
;; conversion are of one length, room for its largest, and are made in an
;; arena of its own.
(require-unqualified c "../c/c.sub")

(provide f64-bits bits-f64 f32-bits digit-value digits? digits-integer read-decimal flonum-digits)

(memory from c)
(table from c)

(func (f64-bits [x f64]) #:inline -> i64 (i64.reinterpret_f64 x))
(func (bits-f64 [b i64]) #:inline -> f64 (f64.reinterpret_i64 b))
(func (f32-bits [x f32]) #:inline -> i32 (i32.reinterpret_f32 x))
(func (leading-zeros [x i64]) #:inline -> i64 (i64.clz x))

;; ---- integers ----

;; The value of byte b as a digit in radix, or -1.
(define (digit-value [b i32] [radix i32]) -> i32
  (let ([d (cond [(and (>= b #\0) (<= b #\9)) (- b #\0)]
                 [(and (>= b #\a) (<= b #\z)) (+ (- b #\a) 10)]
                 [(and (>= b #\A) (<= b #\Z)) (+ (- b #\A) 10)]
                 [else 99])])
    (if (< d radix) d -1)))

;; Are the bytes of p from from to end digits in radix, and some?
(define (digits? [p (ptr u8)] [from u32] [end u32] [radix i32]) -> i32
  (when (>= from end) (return 0))
  (for ([i from]) (< i end) (+= i 1)
    (when (< (digit-value (@ p i) radix) 0) (return 0)))
  1)

;; The integer of the digits of p from from to end in radix, negated if
;; negative is not 0, as its 64 bits at to: 1, or 0 if it is outside -2^63
;; to 2^64 - 1, the range of the kernel's literals (spec 5.4).
(define (digits-integer [p (ptr u8)] [from u32] [end u32] [radix i32] [negative i32] [to (ptr u64)]) -> i32
  (let ([n u64 0] [r (cast u64 radix)] [d u64 0])
    (for ([i from]) (< i end) (+= i 1)
      (set! d (cast u64 (digit-value (@ p i) radix)))
      ;; n * r + d must be below 2^64.
      (when (> n (/ (- 18446744073709551615 d) r)) (return 0))
      (set! n (+ (* n r) d)))
    (when (and negative (> n 9223372036854775808)) (return 0))
    (set! (@ to) (if negative (- 0 n) n))
    1))

;; ---- reading decimals ----

;; Where a decimal's digits are put: room for room of them.
(define digit-values (ptr u8) 0)
(define digit-room u32 0)

;; Are the n bytes of s from i those of C string t?
(define (bytes-from? [s (ptr u8)] [n u32] [i u32] [t (ptr u8)]) -> i32
  (and (== (- n i) (strlen t)) (== (memcmp (+ s i) t (- n i)) 0)))

;; The decimal the n bytes at s write, as its f64 at to: 1, or 0 if they
;; are not one. A decimal is an optional sign, then digits with a point,
;; an exponent (e or E, an optional sign and digits) or both; or +inf.0,
;; -inf.0, +nan.0 or -nan.0. An exponent beyond 100000 in size makes any
;; decimal zero or infinite, as 100000 does.
(define (read-decimal [s (ptr u8)] [n u32] [to (ptr f64)]) -> i32
  (let ([i u32 0] [b 0] [negative 0] [digits 0] [point 0] [fraction 0]
        [exponent 0] [exponent-negative 0] [has-exponent 0])
    (when (== n 0) (return 0))
    (when (> n digit-room)
      (set! digit-room (* 2 n))
      (set! digit-values (cast (ptr u8) (realloc digit-values digit-room))))
    (set! b (@ s 0))
    (when (or (== b #\-) (== b #\+))
      (set! negative (== b #\-))
      (set! i 1)
      (when (bytes-from? s n 1 "inf.0")
        (set! (@ to) (if negative (/ -1.0 0.0) (/ 1.0 0.0)))
        (return 1))
      (when (bytes-from? s n 1 "nan.0")
        (set! (@ to) (/ 0.0 0.0))
        (return 1)))
    (while (< i n)
      (set! b (@ s i))
      (if (and (== b #\.) (not point))
          (set! point 1)
          (begin
            (when (or (< b #\0) (> b #\9)) (break))
            (set! (@ digit-values digits) (- b #\0))
            (+= digits 1)
            (when point (+= fraction 1))))
      (+= i 1))
    (when (== digits 0) (return 0))
    (when (< i n)
      (set! b (@ s i))
      (when (and (!= b #\e) (!= b #\E)) (return 0))
      (set! has-exponent 1)
      (+= i 1)
      (when (< i n)
        (set! b (@ s i))
        (when (or (== b #\-) (== b #\+))
          (set! exponent-negative (== b #\-))
          (+= i 1)))
      (when (>= i n) (return 0))
      (while (< i n)
        (set! b (@ s i))
        (when (or (< b #\0) (> b #\9)) (return 0))
        (when (< exponent 100000) (set! exponent (+ (* exponent 10) (- b #\0))))
        (+= i 1))
      (when (> exponent 100000) (set! exponent 100000)))
    (unless (or point has-exponent) (return 0))
    (set! (@ to) (decimal-flonum digit-values digits (- (if exponent-negative (- exponent) exponent) fraction) negative))
    1))

;; D times 10^k, negated if negative: D the integer of the nd digit values
;; at ds. The f64 nearest the exact value, ties to even: infinity above the
;; largest, zero below half the smallest.
(define (decimal-flonum [ds (ptr u8)] [nd i32] [k i32] [negative i32]) -> f64
  (let ([x f64 0])
    ;; Leading zeros add nothing.
    (while (and (> nd 0) (== (@ ds 0) 0))
      (+= ds 1)
      (-= nd 1))
    ;; D times 10^k is at least 10^(nd + k - 1) and below 10^(nd + k).
    (set! x (cond [(== nd 0) 0.0]
                  [(> (+ nd k) 310) (bits-f64 9218868437227405312)]
                  [(< (+ nd k) -330) 0.0]
                  [(and (<= nd 15) (>= k -22) (<= k 22)) (small-decimal ds nd k)]
                  [else (bits-f64 (big-decimal ds nd k))]))
    (if negative (- x) x)))

;; D times 10^k for D below 10^15, so below 2^53, and |k| at most 22: D
;; and 10^|k| are exact f64s, and one multiplication or division rounds
;; once.
(define (small-decimal [ds (ptr u8)] [nd i32] [k i32]) -> f64
  (let ([n u64 0] [p f64 1.0])
    (for ([i 0]) (< i nd) (+= i 1) (set! n (+ (* n 10) (@ ds i))))
    (for ([i 0]) (< i (if (>= k 0) k (- k))) (+= i 1) (set! p (* p 10)))
    (if (>= k 0) (* (cast f64 n) p) (/ (cast f64 n) p))))

;; The bits of the f64 nearest D times 10^k, D not 0 the nd digit values
;; at ds: as the quotient of integers N / M, D times 10^k over 1 or D over
;; 10^-k, shifted by s bits so that q = N 2^s / M has 54 bits, 53 and a
;; rounding bit, or fewer for a subnormal (s at most 1075, the smallest
;; f64 being 2^-1074).
(define (big-decimal [ds (ptr u8)] [nd i32] [k i32]) -> i64
  (let* ([ak (if (>= k 0) k (- k))]
         [len (cast u32 (+ (/ (+ (* (+ nd ak) 4) 1400) 32) 4))]
         [a (make-arena)] [n (big-new (& a) len)] [m (big-new (& a) len)] [r (big-new (& a) len)]
         [s 0] [q u64 0] [mant u64 0] [e2 0])
    (for ([i 0]) (< i nd) (+= i 1) (big-mul-add! n len 10 (@ ds i)))
    (set! (@ m 0) 1)
    (for ([i 0]) (< i ak) (+= i 1) (big-mul-add! (if (>= k 0) n m) len 10 0))
    (set! s (- 54 (- (big-bit-length n len) (big-bit-length m len))))
    (when (> s 1075) (set! s 1075))
    ;; The estimate is off by at most one: q has 53 to 55 bits.
    (while 1
      (set! q (big-quotient (& a) n m len s r))
      (if (>= q 18014398509481984)
          (-= s 1)
          (begin
            (when (or (>= q 9007199254740992) (== s 1075)) (break))
            (+= s 1))))
    ;; Round to nearest, ties to even, as the rounding bit and the
    ;; remainder say.
    (set! mant (>> q 1))
    (when (and (!= (bit-and q 1) 0) (or (not (big-zero? r len)) (!= (bit-and mant 1) 0)))
      (+= mant 1))
    (set! e2 (- 1 s))
    (when (== mant 9007199254740992)
      (set! mant 4503599627370496)
      (+= e2 1))
    (arena-free (& a))
    (cond [(< mant 4503599627370496) mant]
          [(> (+ e2 1075) 2046) 9218868437227405312]
          [else (bit-or (<< (cast u64 (+ e2 1075)) 52) (- mant 4503599627370496))])))

;; ---- writing flonums ----

;; The shortest digits of x > 0, as characters at ds, which has room for
;; 24 and is zero; returns k, where x is 0.d1d2... times 10^k. Burger and
;; Dybvig's free-format algorithm, for a reader that rounds to nearest,
;; ties to even: with x = f times 2^e, r / s = x and m+ / s and m- / s
;; half the gaps to the flonums above and below x, it finds k, then
;; generates digits until the number they make is within half a gap of x.
(define (flonum-digits [x f64] [ds (ptr u8)]) -> i32
  (let* ([bits (f64-bits x)]
         [biased (cast i32 (>> bits 52))]
         [fraction (bit-and bits 4503599627370495)]
         [e (if (== biased 0) -1074 (- biased 1075))]
         [f (if (== biased 0) fraction (bit-or fraction 4503599627370496))]
         ;; The gap above x is twice the one below when x is a power of two
         ;; above the smallest normal.
         [u (and (== f 4503599627370496) (> biased 1))]
         [even (== (bit-and f 1) 0)]
         [a (if (>= e 0) e 0)]
         [ar (make-arena)]
         [r (big-shl (& ar) (big-of (& ar) f) 36 (+ a 1 u))]
         [s (big-shl (& ar) (big-of (& ar) 1) 36 (+ (if (>= e 0) 0 (- e)) 1 u))]
         [m+ (big-shl (& ar) (big-of (& ar) 1) 36 (+ a u))]
         [m- (big-shl (& ar) (big-of (& ar) 1) 36 a)]
         [t (big-of (& ar) 0)]
         ;; An estimate of k, from x's binary exponent: k or k - 1.
         [k (cast i32 (ceil (- (* (cast f64 (- (+ e (- 64 (cast i32 (leading-zeros f)))) 1)) 0.30102999566398114) 1e-10)))]
         [d 0] [low 0] [high 0] [n 0])
    (if (>= k 0)
        (for ([i 0]) (< i k) (+= i 1) (big-mul-add! s 36 10 0))
        (for ([i 0]) (< i (- k)) (+= i 1)
          (big-mul-add! r 36 10 0)
          (big-mul-add! m+ 36 10 0)
          (big-mul-add! m- 36 10 0)))
    ;; k is one more if x + m+ reaches 10^k (with the gap above, which a
    ;; reader that rounds ties to even rounds to x when f is even).
    (big-sum! t r m+ 36)
    (when (> (big-compare t s 36) (- 0 even))
      (big-mul-add! s 36 10 0)
      (+= k 1))
    (while 1
      (big-mul-add! r 36 10 0)
      (big-mul-add! m+ 36 10 0)
      (big-mul-add! m- 36 10 0)
      (set! d 0)
      (while (>= (big-compare r s 36) 0)
        (big-sub! r s 36)
        (+= d 1))
      ;; Whether the digits so far are within the gap below x, and whether
      ;; they and one more in the last place are within the gap above; the
      ;; ends of a gap count when f is even.
      (set! low (< (big-compare r m- 36) even))
      (big-sum! t r m+ 36)
      (set! high (> (big-compare t s 36) (- 0 even)))
      (if (and low high)
          ;; Either ends it: the nearer, the larger on a tie.
          (begin
            (big-sum! t r r 36)
            (when (>= (big-compare t s 36) 0) (+= d 1)))
          (when high (+= d 1)))
      (set! (@ ds n) (+ 48 d))
      (+= n 1)
      (when (or low high) (break)))
    (arena-free (& ar))
    k))

;; ---- natural numbers ----

;; A new number, 0, of len limbs, in arena a.
(define (big-new [a (ptr arena)] [len u32]) -> (ptr u64)
  (let ([x (cast (ptr u64) (arena-alloc a (* 8 len)))])
    (memset x 0 (* 8 len))
    x))

;; n, below 2^64, as a number of 36 limbs, the length a flonum's digits
;; need: their numbers are below 2^1100.
(define (big-of [a (ptr arena)] [n u64]) -> (ptr u64)
  (let ([x (big-new a 36)])
    (set! (@ x 0) (bit-and n 4294967295))
    (set! (@ x 1) (>> n 32))
    x))

;; x := x times k plus c, for k and c below 2^32.
(define (big-mul-add! [x (ptr u64)] [len u32] [k u64] [c u64])
  (for ([i u32 0]) (< i len) (+= i 1)
    (let ([v (+ (* (@ x i) k) c)])
      (set! (@ x i) (bit-and v 4294967295))
      (set! c (>> v 32)))))

;; x := y + z.
(define (big-sum! [x (ptr u64)] [y (ptr u64)] [z (ptr u64)] [len u32])
  (let ([carry u64 0])
    (for ([i u32 0]) (< i len) (+= i 1)
      (let ([v (+ (@ y i) (@ z i) carry)])
        (set! (@ x i) (bit-and v 4294967295))
        (set! carry (>> v 32))))))

(define (big-bit-length [x (ptr u64)] [len u32]) -> i32
  (let ([i (cast i32 len)])
    (while (> i 0)
      (-= i 1)
      (when (!= (@ x i) 0)
        (return (+ (* i 32) (- 64 (cast i32 (leading-zeros (@ x i))))))))
    0))

(define (big-zero? [x (ptr u64)] [len u32]) -> i32 (== (big-bit-length x len) 0))

;; x shifted left by b bits, a new number in arena a.
(define (big-shl [a (ptr arena)] [x (ptr u64)] [len u32] [b i32]) -> (ptr u64)
  (let ([r (big-new a len)] [w (/ b 32)] [t (cast u64 (% b 32))])
    (for ([i w]) (< i (cast i32 len)) (+= i 1)
      (let ([v (<< (@ x (- i w)) t)])
        (when (and (!= t 0) (> i w))
          (set! v (bit-or v (>> (@ x (- i w 1)) (- 32 t)))))
        (set! (@ r i) (bit-and v 4294967295))))
    r))

;; x := x / 2.
(define (big-shr1! [x (ptr u64)] [len u32])
  (for ([i u32 0]) (< i len) (+= i 1)
    (let ([v (>> (@ x i) 1)])
      (when (< (+ i 1) len) (set! v (bit-or v (<< (bit-and (@ x (+ i 1)) 1) 31))))
      (set! (@ x i) v))))

;; -1, 0 or 1 as x is below, equal to or above y.
(define (big-compare [x (ptr u64)] [y (ptr u64)] [len u32]) -> i32
  (let ([i (cast i32 len)])
    (while (> i 0)
      (-= i 1)
      (when (< (@ x i) (@ y i)) (return -1))
      (when (> (@ x i) (@ y i)) (return 1)))
    0))

;; x := x - y, for x at least y.
(define (big-sub! [x (ptr u64)] [y (ptr u64)] [len u32])
  (let ([borrow i64 0])
    (for ([i u32 0]) (< i len) (+= i 1)
      (let ([v (- (cast i64 (@ x i)) (cast i64 (@ y i)) borrow)])
        (set! borrow (< v 0))
        (set! (@ x i) (bit-and v 4294967295))))))

;; The quotient of n 2^s / m, below 2^56, by long division; the remainder
;; goes to r. Its numbers are made in arena a.
(define (big-quotient [a (ptr arena)] [n (ptr u64)] [m (ptr u64)] [len u32] [s i32] [r (ptr u64)]) -> u64
  (let ([x (big-shl a n len (if (>= s 0) s 0))]
        [t (big-shl a (if (>= s 0) m (big-shl a m len (- s))) len 55)]
        [q u64 0])
    (for ([i 0]) (<= i 55) (+= i 1)
      (set! q (<< q 1))
      (when (>= (big-compare x t len) 0)
        (big-sub! x t len)
        (set! q (bit-or q 1)))
      (big-shr1! t len))
    (memcpy r x (* 8 len))
    q))
