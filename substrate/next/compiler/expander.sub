;; Lifecycle: experimental. Part of the new compiler (next/), written in
;; the C example's C: the compiler's expander.sub, but for compile-time
;; code, begin-for-syntax, define-syntax and the macros they make, the
;; cache and compiled files, which come later.
;;
;; Expander: syntax objects -> the compiler's input (core.sub), lowered
;; code, built as the code is expanded; or fully expanded code, syntax
;; (spec 6.4), where sub expand asks for it.
;;
;; Binding is by sets of scopes (spec 6.1). A module is a file; each of its
;; phases compiles to one wasm module, a linklet (spec 3.1).
;;
;; Memory. What lasts the run is in the run's arena (syntax.sub): the
;; bindings, the units, what they record, their linklets, and the
;; definitions (core.sub). What a module's expansion and compilation make,
;; its syntax, its lowered code and what compiling it needs, is in its
;; module arena, freed when the module is done.
(require-unqualified c "../../examples/c/c.sub")
(require-unqualified stx "syntax.sub")
(require-unqualified core "core.sub")
(require-unqualified ops "ops.sub")
(require-unqualified rd "reader.sub")
(require-unqualified host "host.sub")
(require-unqualified cmp "compile.sub")

(provide set-repository-root! set-package-root! compile-module-file expand-module-file content-hash
         linklet program-linklets module-linklet-list target-kernel-bytes)

(memory from c)
(table from c)

(define gc-forms datum
  `(struct.new struct.get struct.get_s struct.get_u struct.set
    array.new array.new_default array.new_fixed array.get array.get_s array.get_u array.set
    array.len array.copy array.fill
    ref.null ref.is_null ref.eq ref.as_non_null ref.test ref.cast ref.i31 i31.get_s i31.get_u))

;; The implicit forms (spec 5.3, 5.4), and facts, which a language records
;; about definitions (6.5).
(define core-forms datum
  (append (quoted (func global import memory table data type rec tag define-syntax begin-for-syntax
            begin require require-unqualified provide freestanding set! let let* lambda if block loop br br-if
            return
            call-indirect call-ref ref.func func-index data-address data-size select drop unreachable nop
            throw throw-ref try closure
            i32.const i64.const f32.const f64.const
            quote quasiquote unquote unquote-splicing quote-syntax quasisyntax unsyntax unsyntax-splicing
            #%app #%datum #%fact))
          gc-forms))

(define eqref datum (make-ref (boolean 1) (sym eq)))

;; ==== errors ====

;; A compile error at where, syntax or #f, with template and args
;; (format-message).
(define (fail-at [where datum] [template (ptr u8)] [args datum]) -> datum
  (raise-compile-error (if (syntax? where) (syntax-srcloc where) 0) (format-message template args))
  0)

;; What a form x that none of the patterns a syntax-match had would match
;; raises, as Substrate's syntax-match does: "expected" and the patterns,
;; texts, a syntax error blamed on x, named for x's head.
(define (no-match [x datum] [patterns (ptr u8)]) -> datum
  (let ([name (form-name x)] [message (format-message "expected ~a" (cons (bytes->string patterns (strlen patterns)) nil))])
    (throw compile-error (if (== name 0) message (format-message "~a: ~a" `(,name ,message))) x 0)
    0))

;; The name an error about x takes: an identifier's own, or that of the
;; identifier heading a list; or #f.
(define (form-name [x datum]) -> datum
  (cond [(identifier? x) (syntax-e x)]
        [(and (syntax? x) (pair? (syntax-e x)) (identifier? (car (syntax-e x)))) (syntax-e (car (syntax-e x)))]
        [else 0]))

(define (list1 [x datum]) -> datum (cons x nil))

;; ==== the run ====
;;
;; Everything below is shared by all modules compiled in one run of the
;; compiler: the binding table, scope ids, and compiled modules. A macro's
;; template identifiers keep resolving to its own module's bindings when
;; another module expands it, because those bindings stay in the table.

;; A binding: kept under the greatest scope of its set, or none if the
;; set is empty, with the others of the same symbol there, the latest
;; first; an identifier can refer to it only if the identifier has that
;; scope too. phase: a phase, or all-phases. namespace: type or value (spec
;; 6.1). key identifies the binding to compiled code (local-binding, spec
;; 2.3).
(struct binding [scopes (ptr scope-set)] [phase i32] [namespace datum] [key datum] [meaning datum] [next (ptr binding)])

(define all-phases i32 -1)

;; (symbol, slot) -> its bindings kept there; the slot of the empty set is
;; none-slot.
(define bindings hash-table)
(define none-slot u32 4294967295)

;; The bindings require-unqualified made, each -> 1, or 2 once a macro use
;; has relied on it: a definition of the same name may shadow one it has
;; not (spec 3.1).
(define unqualified-imports hash-table)
(define scope-counter u32 0)
(define base-installed i32 0)
(define registry hash-table)                ; path, a symbol -> its module
(define units-by-hash hash-table)           ; hash, a symbol -> its module

;; meaning: (core name) (prim name) (func info) (global info) (data info)
;;          (type info) (tag info) (local key) (label key) (compile-time-value getter-info)
;; A type meaning is in the type namespace, every other one in the value
;; namespace. Locals and labels are bound before their meaning is set, so
;; #f counts as a value.
(define (meaning-namespace [meaning datum]) -> datum
  (if (and (!= meaning 0) (== (car meaning) (sym type))) (sym type) (sym value)))

;; One phase of a module, compiled: bytes, a string; the instance names it
;; imports from (relative to the module at phase shift 0); whether it uses
;; GC; and the scope table of its syntax literals (spec 3.5): the run's
;; scope for each index. A module's linklets are a list, next.
(struct linklet [phase i32] [bytes datum] [imports datum] [gc i32] [scopes datum] [next (ptr linklet)])

;; A compiled (or compiling) module. linklets: its linklets, one per phase;
;; phase 0's is its program's. requires: list of (module . shift).
;; provides: list of (symbol . meaning). entries: its module-level
;; bindings, the latest first. scope: its module scope. code: its lowered
;; phase-0 forms, while it compiles. hash: its identity, of its source and
;; its requires' hashes (spec 3.2). name: what its instance names start
;; with, its stem and hash. path: its file, which its source locations name
;; (3.6). facts: the facts it recorded, newest first, each (definition
;; phase value): the definition it is about (fact-key), the phase, and its
;; datum or syntax. types and infos: the types and definitions it made,
;; newest first.
(struct unit [self datum] [path datum] [name datum] [hash datum] [state datum] [requires datum] [provides datum]
        [entries (ptr module-entry)] [code datum] [scope u32] [types datum] [infos datum] [facts datum]
        [linklets (ptr linklet)])

;; A module-level binding of a module, which one that requires it at a
;; phase shift can install a shifted copy of.
(struct module-entry [symbol datum] [scopes (ptr scope-set)] [phase i32] [binding (ptr binding)] [next (ptr module-entry)])

(define unit-kind u32 20)

(define (new-unit [path datum] [name datum]) -> datum
  (let ([m (cast (ptr unit) (alloc-in (& run-arena) (sizeof unit)))])
    (set! (-> m self) (make-record unit-kind m))
    (set! (-> m path) (keep path))
    (set! (-> m name) (keep name))
    (set! (-> m hash) 0)
    (set! (-> m state) (sym compiling))
    (set! (-> m requires) nil)
    (set! (-> m provides) nil)
    (set! (-> m entries) 0)
    (set! (-> m code) 0)
    (set! (-> m scope) 0)
    (set! (-> m types) nil)
    (set! (-> m infos) nil)
    (set! (-> m facts) nil)
    (set! (-> m linklets) 0)
    (-> m self)))

(define (unit-of [m datum]) -> (ptr unit) (cast (ptr unit) (record-pointer m)))

;; The state of one module's compilation. use-site-scopes: integers.
;; phase-forms, memories and tables: alists from phases to forms.
;; provide-ids: (name . id) ..., newest first. require-names: ((name .
;; phase) . module).
(struct comp [module datum] [use-site-scopes datum] [freestanding-form datum] [phase-forms datum] [memories datum]
        [tables datum] [provide-ids datum] [require-names datum])

(define current (ptr comp) 0)                ; the comp being expanded

(define (the-module) -> (ptr unit) (unit-of (-> current module)))

(define (new-comp [m datum]) -> (ptr comp)
  (let ([c (cast (ptr comp) (alloc-in (current-arena) (sizeof comp)))])
    (set! (-> c module) m)
    (set! (-> c use-site-scopes) nil)
    (set! (-> c freestanding-form) 0)
    (set! (-> c phase-forms) nil)
    (set! (-> c memories) nil)
    (set! (-> c tables) nil)
    (set! (-> c provide-ids) nil)
    (set! (-> c require-names) nil)
    c))

;; Scopes are even; a local binding form's (new-local-scope!) is odd, so
;; that quote-syntax can prune the local ones from a literal (spec 6.2).
(define (new-scope!) -> u32 (new-run-scope!))
(define (new-run-scope!) -> u32 (+= scope-counter 2) scope-counter)
(define (new-local-scope!) -> u32 (+= scope-counter 2) (+ scope-counter 1))

(define (even-scope? [sc u32]) -> i32 (== (% sc 2) 0))
(define (even-scopes [s (ptr scope-set)]) -> (ptr scope-set) (scopes-filter s even-scope?))
(define (prune-local-scopes [x datum]) -> datum (map-scopes x even-scopes))

(define core-scope u32 0)
(define core-scopes (ptr scope-set) (scopes-change no-scopes 0 0))

;; ==== the kernel module ====
;;
;; compiler/kernel.sub under the repository's root: the kernel's data and
;; the functions on it (spec 2), which the compiler carries into the
;; programs it writes. It is compiled once in a run, first, as a module
;; whose one linklet is the kernel, its instance named kernel, which
;; requires nothing. The source locations name it compiler/kernel.sub,
;; whatever the root is: the compiler's bytes do not depend on where the
;; repository is.

(define repository-root datum 0)
(define (set-repository-root! [root datum]) (set! repository-root (keep root)))

(define kernel datum 0)

(define (ensure-kernel!)
  (when (== kernel 0)
    (let* ([path `"compiler/kernel.sub"]
           [file (string-append-2 repository-root (string-append-2 `"/" path))]
           [text (source-text file file)]
           [m (new-unit path `"kernel")]
           [saved current])
      (set! kernel m)
      (set! (-> (unit-of m) hash) (keep (content-hash (list1 text))))
      (begin-module-arena)
      (set! current (new-comp m))
      (let* ([code (expand-module-body (read-all (string-bytes text) (string-length text) (string->symbol path)) 0)]
             [forms (append (storage-forms 0) code)])
        (note-definitions! m forms)
        (take-kernel-types! m)
        (set-current-source! (string->symbol path))
        (add-linklet! m 0 (compile-module forms `"kernel")))
      (set-kernel-definitions! (-> (unit-of m) infos))
      (set! (-> (unit-of m) state) (sym done))
      (set! current saved)
      (end-module-arena))))

;; The kernel module's string and table types, from its unit: quoted data
;; is read with them (spec 3.5).
(define (take-kernel-types! [m datum])
  (let ([ts (-> (unit-of m) types)] [string datum 0] [table datum 0])
    (while (pair? ts)
      (when (== (type-info-name (car ts)) (sym %string)) (set! string (car ts)))
      (when (== (type-info-name (car ts)) (sym %table)) (set! table (car ts)))
      (set! ts (cdr ts)))
    (set-syntax-types! string table)))

;; The kernel's bytes, for programs.
(define (target-kernel-bytes) -> datum
  (ensure-kernel!)
  (-> (unit-of kernel) linklets bytes))

;; The kernel module's function named name, which it must have.
(define (kernel-function [name datum]) -> datum
  (ensure-kernel!)
  (let ([infos (-> (unit-of kernel) infos)])
    (while (pair? infos)
      (when (and (func-info? (car infos)) (== (func-info-name (car infos)) name)) (return (car infos)))
      (set! infos (cdr infos)))
    (fail-at 0 "internal: the kernel module has no ~a" (list1 name))))

;; ==== bindings ====

(define (slot-key [symbol datum] [slot u32]) -> u64 (bit-or (<< (cast u64 symbol) 32) slot))

;; The scope a binding with these scopes is kept under.
(define (binding-slot [scopes (ptr scope-set)]) -> u32
  (if (== (-> scopes count) 0) none-slot (@ (-> scopes ids) 0)))

;; The bindings of sym kept under scope slot.
(define (bindings-under [sym datum] [slot u32]) -> (ptr binding)
  (cast (ptr binding) (hash-ref (& bindings) (slot-key sym slot))))

;; Bind sym with these scopes at phase to meaning: the binding.
(define (bind-raw! [sym datum] [scopes (ptr scope-set)] [phase i32] [meaning datum]) -> (ptr binding)
  (let ([b (cast (ptr binding) (alloc-in (& run-arena) (sizeof binding)))] [k (slot-key sym (binding-slot scopes))])
    (set! (-> b scopes) scopes)
    (set! (-> b phase) phase)
    (set! (-> b namespace) (meaning-namespace meaning))
    (set! (-> b key) (keep (fresh-key!)))
    (set! (-> b meaning) (keep meaning))
    (set! (-> b next) (cast (ptr binding) (hash-ref (& bindings) k)))
    (hash-set! (& bindings) k (cast u32 b))
    b))

;; A module-level binding of the current module: recorded, so that a
;; module requiring this one at a phase shift can install a shifted copy.
(define (bind-module-level! [sym datum] [scopes (ptr scope-set)] [phase i32] [meaning datum]) -> (ptr binding)
  (let ([b (bind-raw! sym scopes phase meaning)])
    (when (!= current 0)
      (let ([e (cast (ptr module-entry) (alloc-in (& run-arena) (sizeof module-entry)))] [m (the-module)])
        (set! (-> e symbol) sym)
        (set! (-> e scopes) scopes)
        (set! (-> e phase) phase)
        (set! (-> e binding) b)
        (set! (-> e next) (-> m entries))
        (set! (-> m entries) e)))
    b))

(define (bind! [id datum] [phase i32] [meaning datum]) -> (ptr binding)
  (bind-raw! (syntax-e id) (syntax-scopes id) phase meaning))

(define (check-unbound! [id datum] [phase i32] [meaning datum])
  (let ([b (bindings-under (syntax-e id) (binding-slot (syntax-scopes id)))])
    (while (!= b 0)
      (when (and (== (-> b phase) phase) (== (-> b scopes) (syntax-scopes id))
                 (== (-> b namespace) (meaning-namespace meaning))
                 (not (equal? (-> b meaning) meaning)))
        (fail-at id "~a is already bound~a"
                 `(,(syntax-e id) ,(if (> phase 0) (format-message " at phase ~a" (list1 (make-integer phase))) `""))))
      (set! b (-> b next)))))

;; Bind a module-level definition. Use-site scopes come off the name, so a
;; definition a macro makes from its input is visible to the rest of the
;; module (spec 6.2). A second binding of the same name with the same
;; scopes at the same phase is an error, except that a definition shadows
;; what require-unqualified imports (spec 3.1).
(define (bind-definition! [id0 datum] [phase i32] [meaning datum]) -> (ptr binding)
  (let ([id id0] [uses (-> current use-site-scopes)])
    (while (pair? uses)
      (set! id (remove-scope id (cast u32 (integer-value (car uses)))))
      (set! uses (cdr uses)))
    (shadow-import! id phase meaning)
    (check-unbound! id phase meaning)
    (bind-module-level! (syntax-e id) (syntax-scopes id) phase meaning)))

;; A definition shadows a binding require-unqualified made with the same
;; name, scopes, phase and namespace: that binding goes, here and in the
;; module's recorded entries (spec 3.1). It is an error if a macro use in
;; this module already relied on it.
(define (shadow-import! [id datum] [phase i32] [meaning datum])
  (let* ([k (slot-key (syntax-e id) (binding-slot (syntax-scopes id)))]
         [b (cast (ptr binding) (hash-ref (& bindings) k))]
         [before (ptr binding) 0])
    (while (!= b 0)
      (when (and (== (-> b phase) phase) (== (-> b scopes) (syntax-scopes id))
                 (== (-> b namespace) (meaning-namespace meaning))
                 (!= (hash-ref (& unqualified-imports) (cast u64 b)) 0))
        (when (== (hash-ref (& unqualified-imports) (cast u64 b)) 2)
          (fail-at id "~a is defined here, but a macro use before this definition used the ~a it imports"
                   `(,(syntax-e id) ,(syntax-e id))))
        (hash-set! (& unqualified-imports) (cast u64 b) 3)
        (if (== before 0) (hash-set! (& bindings) k (cast u32 (-> b next))) (set! (-> before next) (-> b next)))
        (remove-entry! b)
        (return))
      (set! before b)
      (set! b (-> b next)))))

;; Binding b out of the current module's entries.
(define (remove-entry! [b (ptr binding)])
  (let* ([m (the-module)] [e (-> m entries)] [before (ptr module-entry) 0])
    (while (!= e 0)
      (when (== (-> e binding) b)
        (if (== before 0) (set! (-> m entries) (-> e next)) (set! (-> before next) (-> e next)))
        (return))
      (set! before e)
      (set! e (-> e next)))))

(define (phase-matches? [b (ptr binding)] [phase i32]) -> i32
  (or (== (-> b phase) all-phases) (== (-> b phase) phase)))

;; Can an identifier with scopes refer to binding b at phase in namespace
;; ns?
(define (candidate? [b (ptr binding)] [phase i32] [ns datum] [scopes (ptr scope-set)]) -> i32
  (and (phase-matches? b phase) (== (-> b namespace) ns) (scopes-subset? (-> b scopes) scopes)))

;; The binding id refers to at phase in namespace ns, or 0 if unbound. A
;; binding whose scopes are a subset of id's is kept under one of id's
;; scopes, or none-slot, so only those are candidates: those of the empty
;; set first, then under each of id's scopes in turn. The best has the
;; most scopes, the first of those; every other must have a subset of its
;; scopes, and not the same ones with another meaning.
(define (resolve [id datum] [phase i32] [ns datum]) -> (ptr binding)
  (let* ([scopes (syntax-scopes id)] [sym (syntax-e id)] [best (ptr binding) 0] [count u32 0] [b (ptr binding) 0])
    (for ([i -1]) (< i (cast i32 (-> scopes count))) (+= i 1)
      (set! b (bindings-under sym (if (< i 0) none-slot (@ (-> scopes ids) i))))
      (while (!= b 0)
        (when (candidate? b phase ns scopes)
          (+= count 1)
          (when (or (== best 0) (> (-> b scopes count) (-> best scopes count))) (set! best b)))
        (set! b (-> b next))))
    (when (> count 1)
      (for ([i -1]) (< i (cast i32 (-> scopes count))) (+= i 1)
        (set! b (bindings-under sym (if (< i 0) none-slot (@ (-> scopes ids) i))))
        (while (!= b 0)
          (when (and (candidate? b phase ns scopes)
                     (or (not (scopes-subset? (-> b scopes) (-> best scopes)))
                         (and (!= b best) (== (-> b scopes) (-> best scopes)) (not (equal? (-> b meaning) (-> best meaning))))))
            (fail-at id "identifier ~a is ambiguous" (list1 sym)))
          (set! b (-> b next)))))
    best))

;; What id means at phase in the value namespace, or #f. Only type
;; positions (parse-heap, type-of) look in the type namespace, with
;; type-meaning-of.
(define (meaning-of [id datum] [phase i32]) -> datum
  (let ([b (resolve id phase (sym value))]) (if (== b 0) 0 (-> b meaning))))

(define (type-meaning-of [id datum] [phase i32]) -> datum
  (let ([b (resolve id phase (sym type))]) (if (== b 0) 0 (-> b meaning))))

;; Is id bound to the core form name?
(define (core-id? [id datum] [name datum] [phase i32]) -> i32
  (and (identifier? id)
       (let ([m (meaning-of id phase)])
         (and (!= m 0) (== (car m) (sym core)) (== (cadr m) name)))))

(define (internal-name? [sym datum]) -> i32 (== (@ (symbol-bytes sym) 0) #\%))

;; Core forms and primitive operators, at every phase (spec 5.5). Nothing
;; else is bound until a module requires it.
(define (install-base!)
  (unless base-installed
    (set! base-installed 1)
    (for-each (lambda ([name datum]) (bind-raw! name core-scopes all-phases `(core ,name))) core-forms)
    (for-each (lambda ([name datum]) (bind-raw! name core-scopes all-phases `(prim ,name))) (prim-names))))

;; ==== modules ====

;; path without its . and .. segments, absolute.
(define package-root datum 0)
(define (set-package-root! [dir datum]) (set! package-root (keep dir)))

(define (string-append-2 [a datum] [b datum]) -> datum
  (let ([buf (make-buffer)] [s datum 0])
    (buffer-add! (& buf) (string-bytes a) (string-length a))
    (buffer-add! (& buf) (string-bytes b) (string-length b))
    (set! s (bytes->string (-> buf bytes) (-> buf length)))
    (buffer-free! (& buf))
    s))

(define (substring [s datum] [from u32] [to u32]) -> datum (bytes->string (+ (string-bytes s) from) (- to from)))

(define (absolute-path? [p datum]) -> i32 (and (> (string-length p) 0) (== (@ (string-bytes p) 0) #\/)))

;; The name of the file at path p, which names the module in it and which
;; its source locations carry (spec 3.6), as Racket names a module: p
;; completed from the package root and its . and .. segments resolved,
;; then relative to the package root if it is in it, and absolute if not.
;; So a file has one name however a require spells it. Symbolic links are
;; not resolved. The root may be relative, to the working directory, as
;; in tests.
(define (package-directory) -> datum (if (!= package-root 0) package-root repository-root))

(define (canonical-path [p datum]) -> datum
  (let* ([root (resolve-segments (package-directory))]
         [full (resolve-segments (if (absolute-path? p) p (string-append-2 root (string-append-2 `"/" p))))]
         [n (+ (string-length root) 1)])
    (if (and (> (string-length full) n) (== (memcmp (string-bytes full) (string-bytes root) (- n 1)) 0)
             (== (@ (string-bytes full) (- n 1)) #\/))
        (substring full n (string-length full))
        full)))

;; Path p with its . and .. segments resolved: absolute if p is, else
;; with the .. segments that go above where it starts first.
(define (resolve-segments [p datum]) -> datum
  (let ([kept nil] [bytes (string-bytes p)] [n (string-length p)] [start u32 0] [out (make-buffer)] [s datum 0]
        [absolute (absolute-path? p)])
    (for ([i u32 0]) (<= i n) (+= i 1)
      (when (or (== i n) (== (@ bytes i) #\/))
        (let ([seg (substring p start i)])
          (cond [(or (== i start) (and (== (- i start) 1) (== (@ bytes start) #\.))) 0]
                [(and (== (- i start) 2) (== (@ bytes start) #\.) (== (@ bytes (+ start 1)) #\.))
                 (cond [(and (pair? kept) (not (string=? (car kept) `".."))) (set! kept (cdr kept))]
                       [(not absolute) (set! kept (cons seg kept))])]
                [else (set! kept (cons seg kept))]))
        (set! start (+ i 1))))
    (set! kept (reverse kept))
    (while (pair? kept)
      (when (or absolute (> (-> out length) 0)) (buffer-add-byte! (& out) #\/))
      (buffer-add! (& out) (string-bytes (car kept)) (string-length (car kept)))
      (set! kept (cdr kept)))
    (set! s (bytes->string (-> out bytes) (-> out length)))
    (buffer-free! (& out))
    s))

;; The byte index of the last byte b in string s, or -1.
(define (last-byte-index [s datum] [b i32]) -> i32
  (let ([i (- (cast i32 (string-length s)) 1)])
    (while (>= i 0)
      (when (== (@ (string-bytes s) i) b) (return i))
      (-= i 1))
    -1))

(define (directory-of [path datum]) -> datum
  (let ([slash (last-byte-index path #\/)])
    (if (>= slash 0) (substring path 0 (+ slash 1)) `"")))

;; The stem of the file name at path: its letters, digits, - and _, each
;; other character made _.
(define (file-stem [path datum]) -> datum
  (let* ([slash (last-byte-index path #\/)]
         [base (if (>= slash 0) (substring path (+ slash 1) (string-length path)) path)]
         [dot (last-byte-index base #\.)]
         [stem (if (>= dot 0) (substring base 0 dot) base)]
         [out (make-buffer)] [bytes (string-bytes stem)] [i u32 0] [s datum 0])
    ;; Each character, of one byte or more, is kept if it is one of those,
    ;; and is otherwise one _.
    (while (< i (string-length stem))
      (let ([b (@ bytes i)])
        (cond [(or (and (>= b #\a) (<= b #\z)) (and (>= b #\A) (<= b #\Z)) (and (>= b #\0) (<= b #\9)) (== b #\-) (== b #\_))
               (buffer-add-byte! (& out) b)
               (+= i 1)]
              [else
               (buffer-add-byte! (& out) #\_)
               (+= i 1)
               (while (and (< i (string-length stem)) (== (bit-and (@ bytes i) 192) 128)) (+= i 1))])))
    (set! s (bytes->string (-> out bytes) (-> out length)))
    (buffer-free! (& out))
    s))

;; A hash of the strings in list ss, as 12 hexadecimal digits: 64-bit
;; FNV-1a over their bytes, each string followed by a zero byte, keeping
;; the top 48 bits.
(define (content-hash [ss datum]) -> datum
  (let ([h u64 14695981039346656037] [digits (array u8 12)])
    (while (pair? ss)
      (let ([p (string-bytes (car ss))])
        (for ([i u32 0]) (< i (string-length (car ss))) (+= i 1)
          (set! h (* (bit-xor h (@ p i)) 1099511628211))))
      ;; The zero byte after the string: xor with it changes nothing.
      (set! h (* h 1099511628211))
      (set! ss (cdr ss)))
    (for ([k 0]) (< k 12) (+= k 1)
      (let ([d (cast i32 (bit-and (>> h (- 60 (* k 4))) 15))])
        (set! (@ digits k) (if (< d 10) (+ 48 d) (+ 87 d)))))
    (bytes->string digits 12)))

;; The hash that is a module's identity once it is expanded: of its path,
;; which its source locations name (spec 3.6), its source text, and the
;; hashes of the modules it requires, at the phase shifts it requires
;; them, each (hash shift) (spec 3.2). Modules with the same hash are the
;; same module, the same bytes.
(define (module-hash [path datum] [text datum] [requires datum]) -> datum
  (let ([parts `(,path ,text)])
    (while (pair? requires)
      (set! parts (append parts `(,(car (car requires)) ,(format-message "~a" (list1 (cadr (car requires)))))))
      (set! requires (cdr requires)))
    (content-hash parts)))

;; The file at a module's path, which is the package root's if relative.
(define (package-file [path datum]) -> datum
  (if (absolute-path? path) path (string-append-2 (package-directory) (string-append-2 `"/" path))))

;; The text of file, a string; or a compile error if there is none, which
;; names it path.
(define (source-text [file datum] [path datum]) -> datum
  (let* ([name (make-buffer)] [n u32 0] [p (ptr u8) 0] [s datum 0])
    (buffer-add! (& name) (string-bytes file) (string-length file))
    (buffer-add-byte! (& name) 0)
    (set! p (read-file-bytes (-> name bytes) (& n)))
    (buffer-free! (& name))
    (when (== p 0) (fail-at 0 "no module file ~a" (list1 path)))
    (set! s (bytes->string p n))
    (free p)
    s))

;; Compile the module in file source (and, first, what it requires).
;; Returns the module. Each module is compiled once per run.
(define (compile-module-file [source datum]) -> datum
  (let* ([path (canonical-path source)] [key (cast u64 (string->symbol path))]
         [known (cast datum (hash-ref (& registry) key))])
    (cond [(and (!= known 0) (== (-> (unit-of known) state) (sym done))) known]
          [(!= known 0) (fail-at 0 "cyclic require: ~a requires itself" (list1 path))]
          [else
           (ensure-kernel!)
           (let* ([text (source-text (package-file path) path)] [m (new-unit path (file-stem path))] [saved current])
             (hash-set! (& registry) key (cast u32 m))
             (begin-module-arena)
             (set! current (new-comp m))
             (set! (-> (unit-of m) code) (expand-module-body (read-all (string-bytes text) (string-length text) (string->symbol path)) 0))
             (finish-module! text)
             (set! current saved)
             (end-module-arena)
             m)])))

;; The fully expanded phase-0 forms of the module in file source (spec
;; 6.4), for sub expand: it is expanded, and what it requires compiled,
;; but it is not compiled itself. Each form is given to f, while the forms
;; last.
(define (expand-module-file [source datum] [f (closure (datum))])
  (let ([path (canonical-path source)])
    (ensure-kernel!)
    (let* ([text (source-text (package-file path) path)] [m (new-unit path (file-stem path))])
      (hash-set! (& registry) (cast u64 (string->symbol path)) (cast u32 m))
      (begin-module-arena)
      (set! current (new-comp m))
      (let ([forms (expand-module-body (read-all (string-bytes text) (string-length text) (string->symbol path)) 1)])
        (while (pair? forms)
          (f (car forms))
          (set! forms (cdr forms))))
      (end-module-arena))))

;; Expand a module body at phase 0. The result is its lowered code, or,
;; syntax being 1, its fully expanded code (spec 6.4).
(define (expand-module-body [forms datum] [syntax i32]) -> datum
  (install-base!)
  (let ([msc (new-scope!)] [saved to-syntax] [out datum 0])
    (set! (-> (the-module) scope) msc)
    (set! to-syntax syntax)
    (set! out (expand-body (map (lambda ([f datum]) -> datum (add-scope (add-scope f core-scope) msc)) forms) 0))
    (set! to-syntax saved)
    out))

;; Take the phase-0 code, resolve provides, take the module's hash and
;; name, and compile the linklets.
(define (finish-module! [text datum])
  (let ([m (the-module)] [items (reverse (-> current provide-ids))] [provides nil])
    ;; A provided name exports its binding in each namespace it has one.
    (while (pair? items)
      (let* ([item (car items)] [id (cdr item)]
             [v (meaning-of id 0)]
             [value (if (and (!= v 0) (!= (memq (car v) `(func global compile-time-value data tag)) 0)) v 0)]
             [t (type-meaning-of id 0)])
        (when (and (== t 0) (== value 0))
          (fail-at id "cannot provide ~a: it is not a module-level binding" (list1 (syntax-e id))))
        (when (!= t 0) (set! provides (cons (cons (syntax-e (car item)) t) provides)))
        (when (!= value 0) (set! provides (cons (cons (syntax-e (car item)) value) provides))))
      (set! items (cdr items)))
    (set! (-> m provides) (keep (reverse provides)))
    ;; Its requires known, the module takes its hash, and the name its
    ;; instance names start with: its stem and hash.
    (set! (-> m hash) (keep (module-hash (-> m path) text
                                         (map (lambda ([r datum]) -> datum `(,(-> (unit-of (car r)) hash) ,(cdr r)))
                                              (-> m requires)))))
    (set! (-> m name) (keep (format-message "~a.~a" `(,(file-stem (-> m path)) ,(-> m hash)))))
    (when (== (hash-ref (& units-by-hash) (cast u64 (string->symbol (-> m hash)))) 0)
      (hash-set! (& units-by-hash) (cast u64 (string->symbol (-> m hash))) (cast u32 (-> m self))))
    (compile-linklets!)))

;; ---- linklets ----

;; The memory and table forms declared for phase (spec 3.3).
(define (storage-forms [phase i32]) -> datum
  (let ([mem (assoc (make-integer phase) (-> current memories))] [tbl (assoc (make-integer phase) (-> current tables))])
    (append (if (!= mem 0) (list1 (cdr mem)) nil) (if (!= tbl 0) (list1 (cdr tbl)) nil))))

;; Module m's phase linklet, as compile-module gave it: (bytes imports
;; gc? scopes), kept.
(define (add-linklet! [m datum] [phase i32] [compiled datum])
  (let ([l (cast (ptr linklet) (alloc-in (& run-arena) (sizeof linklet)))] [u (unit-of m)])
    (set! (-> l phase) phase)
    (set! (-> l bytes) (keep (car compiled)))
    (set! (-> l imports) (keep (cadr compiled)))
    (set! (-> l gc) (!= (caddr compiled) 0))
    (set! (-> l scopes) (keep (cadddr compiled)))
    (set! (-> l next) (-> u linklets))
    (set! (-> u linklets) l)))

;; Module m's linklet of phase, or 0.
(define (linklet-of [m datum] [phase i32]) -> (ptr linklet)
  (let ([l (-> (unit-of m) linklets)])
    (while (and (!= l 0) (!= (-> l phase) phase)) (set! l (-> l next)))
    l))

;; Compile the linklet of the module being compiled, its phase 0's; check
;; (freestanding); done.
(define (compile-linklets!)
  (let* ([m (the-module)] [forms (append (storage-forms 0) (-> m code))])
    (set-current-source! (string->symbol (-> m path)))
    (add-linklet! (-> m self) 0 (compile-module forms (linklet-name (-> m self) 0 0)))
    (note-definitions! (-> m self) forms)
    (set! (-> m state) (sym done))
    (let ([form (-> current freestanding-form)])
      (when (!= form 0) (check-freestanding! (-> m self) form)))
    (set! (-> m code) 0)))

;; The modules whose linklets a program instantiates at run time: phase 0
;; at phase shift 0, reached through phase-0 requires.
(define (runtime-closure [m datum]) -> datum
  (let ([todo (list1 m)] [seen nil])
    (while (pair? todo)
      (let ([mm (car todo)])
        (set! todo (cdr todo))
        (when (== (memq mm seen) 0)
          (set! seen (cons mm seen))
          (let ([imports (-> (linklet-of mm 0) imports)])
            (while (pair? imports)
              (let ([r (linklet-ref (car imports))])
                (when (and (!= r 0) (== (integer-value (cadr r)) 0) (== (integer-value (caddr r)) 0))
                  (set! todo (append todo (list1 (car r))))))
              (set! imports (cdr imports)))))))
    (reverse seen)))

;; (freestanding): the program's run-time parts import only from the host
;; and each other, and use no GC (spec 3.4).
(define (check-freestanding! [m datum] [form datum])
  (let ([ms (runtime-closure m)])
    (while (pair? ms)
      (let* ([mm (car ms)] [p (linklet-of mm 0)] [extra nil] [imports (-> p imports)])
        (while (pair? imports)
          (unless (or (string=? (car imports) `"host") (!= (linklet-ref (car imports)) 0))
            (set! extra (cons (car imports) extra)))
          (set! imports (cdr imports)))
        (set! extra (reverse extra))
        (unless (and (null? extra) (not (-> p gc)))
          (fail-at form "this module is declared freestanding, but after expansion ~a ~a"
                   `(,(if (== mm m) `"it" (format-message "the module ~a it requires" (list1 (-> (unit-of mm) name))))
                     ,(if (pair? extra) (format-message "imports from ~a" (list1 extra)) `"uses GC objects")))))
      (set! ms (cdr ms)))))

;; The linklets m's program instantiates at run time, each after those it
;; imports from, as (instance-name . bytes): phase-0 linklets at phase
;; shift 0, and the kernel module if they use it. m's own comes last.
(define (program-linklets [m datum]) -> datum
  (let ([seen (make-table)] [out nil])
    (set! out (visit-linklets m seen out))
    (reverse out)))

(define (visit-linklets [m datum] [seen (ptr arena-table)] [out datum]) -> datum
  (let ([name (linklet-name m 0 0)])
    (when (!= (datum-get seen name) 0) (return out))
    (datum-put! seen name (boolean 1))
    (let* ([p (linklet-of m 0)] [imports (-> p imports)])
      (while (pair? imports)
        (let ([imp (car imports)] [l (linklet-ref (car imports))])
          (cond [(string=? imp `"kernel")
                 (when (== (datum-get seen imp) 0)
                   (datum-put! seen imp (boolean 1))
                   (set! out (cons (cons imp (target-kernel-bytes)) out)))]
                [(!= l 0)
                 (unless (and (== (integer-value (cadr l)) 0) (== (integer-value (caddr l)) 0))
                   (fail-at 0 "internal: a program imports from ~a" (list1 imp)))
                 (set! out (visit-linklets (car l) seen out))]))
        (set! imports (cdr imports)))
      (cons (cons name (-> p bytes)) out))))

;; (phase . bytes) for each linklet of m, in phase order.
(define (module-linklet-list [m datum]) -> datum
  (let ([l (-> (unit-of m) linklets)] [out nil])
    (while (!= l 0)
      (set! out (cons (cons (make-integer (-> l phase)) (-> l bytes)) out))
      (set! l (-> l next)))
    (sort out (lambda ([a datum] [b datum]) -> i32 (< (integer-value (car a)) (integer-value (car b)))))))

;; ==== module bodies ====

;; The core form name if s is (core-id ...), else #f.
(define (core-head [s datum] [phase i32]) -> datum
  (if (and (syntax? s) (pair? (syntax-e s)) (identifier? (car (syntax-e s))))
      (let ([m (meaning-of (car (syntax-e s)) phase)])
        (if (and (!= m 0) (== (car m) (sym core))) (cadr m) 0))
      0))

;; Expand macro uses at the head of s until it is something else: none
;; yet, until compile-time code.
(define (head-expand [s datum] [phase i32]) -> datum s)

;; A module body being expanded: its phase, whether its code is built as
;; fully expanded code, the items pass 1 found (reversed), and whether
;; pass 2 has started.
(struct body [phase i32] [syntax i32] [items datum] [pass2 i32])

(define current-body (ptr body) 0)          ; the innermost body being expanded

;; A module body -> its code: lowered forms for the compiler (core.sub),
;; or fully expanded code (spec 6.4). Other module-level forms take
;; effect during expansion and leave nothing.
(define (expand-body [forms datum] [phase i32]) -> datum
  (let ([b (cast (ptr body) (alloc-in (current-arena) (sizeof body)))] [saved current-body] [out datum 0])
    (set! (-> b phase) phase)
    (set! (-> b syntax) to-syntax)
    (set! (-> b items) nil)
    (set! (-> b pass2) 0)
    (set! current-body b)
    (for-each (lambda ([f datum]) (declare-form! f b 0)) forms)
    (set! out (finish-body! b))
    (set! current-body saved)
    out))

;; Pass 2 for body b: expand bodies and expressions, in the order pass 1
;; declared them.
(define (finish-body! [b (ptr body)]) -> datum
  (set! (-> b pass2) 1)
  (let ([items (reverse (-> b items))] [out nil])
    (while (pair? items)
      (set! out (append (reverse (expand-item (car items) (-> b phase))) out))
      (set! items (cdr items)))
    (reverse out)))

(define (item! [b (ptr body)] [x datum]) (set! (-> b items) (cons x (-> b items))))

;; Pass 1 for module-level form f0 of body b: expand macro uses at its
;; head, then declare it, run it, or keep it for pass 2.
(define (declare-form! [f0 datum] [b (ptr body)] [only (ptr u8)])
  (let* ([phase (-> b phase)] [f (head-expand f0 phase)] [kind (core-head f phase)])
    (case kind
      [((sym begin))
       (let ([forms (cdr (form-list f "(begin form ...)"))])
         (for-each (lambda ([g datum]) (declare-form! g b only)) forms))]
      [((sym require)) (require! f phase 0)]
      [((sym require-unqualified)) (require! f phase 1)]
      [((sym provide)) (provide! f phase)]
      [((sym freestanding)) (freestanding! f phase)]
      [((sym func)) (item! b (declare-func f phase))]
      [((sym global)) (item! b (declare-global f phase))]
      [((sym import)) (item! b (declare-import f phase))]
      [((sym memory) (sym table)) (declare-storage! f phase)]
      [((sym data)) (item! b (declare-data f phase))]
      [((sym type)) (item! b (declare-type f phase))]
      [((sym tag)) (item! b (declare-tag f phase))]
      [((sym rec)) (item! b (declare-rec f phase))]
      [((sym define-syntax) (sym begin-for-syntax))
       (fail-at f "~a is not yet in the new compiler: compile-time code comes later" (list1 kind))]
      [((sym #%fact)) (item! b `(done ,(fact! f phase) ()))]
      [else (item! b `(expr ,f))])))

;; The elements of syntax list f, or an error: f matched none of the
;; patterns.
(define (form-list [f datum] [patterns (ptr u8)]) -> datum
  (let ([l (syntax->list f)])
    (if (== l 0) (no-match f patterns) l)))

;; Pass 2 for one item: its forms, in the body's code.
(define (expand-item [item datum] [phase i32]) -> datum
  (case (car item)
    [((sym func)) (expand-func item phase)]
    [((sym global)) (expand-global item phase)]
    [((sym plain) (sym done)) (if to-syntax (list1 (cadr item)) (caddr item))]
    [else
     (let ([r (closures-noted-expr (cadr item) phase)])
       (if to-syntax (list1 (car r)) (list1 `(expr ,(car r) ,(cdr r)))))]))

;; ==== types ====

(define shorthand-refs datum
  `((anyref . any) (eqref . eq) (i31ref . i31) (structref . struct) (arrayref . array)
    (funcref . func) (externref . extern) (exnref . exn)))

;; A heap type: an abstract name, a type declared with `type`, or
;; (closure (t ... -> r ...)), the closure type of a signature (spec 5.3).
(define (parse-heap [s datum] [phase i32]) -> datum
  (cond [(and (identifier? s) (!= (memq (syntax-e s) abstract-heaps) 0)) (syntax-e s)]
        [(identifier? s)
         (let ([m (type-meaning-of s phase)])
           (when (== m 0) (fail-at s "~a is not a type" (list1 (syntax-e s))))
           (cadr m))]
        [(== (core-head s phase) (sym closure))
         (let ([l (syntax->list s)])
           (unless (and (!= l 0) (== (length l) 2)) (fail-at s "expected (closure (type ... -> type ...))" nil))
           (let ([sig (parse-signature (cadr l) phase)]) (closure-type (car sig) (cdr sig))))]
        [else (fail-at s "expected a heap type, got ~s" (list1 (syntax->datum s)))]))

;; A value type.
(define (parse-type [s datum] [phase i32]) -> datum
  (let* ([d (syntax-e s)] [short (assq d shorthand-refs)])
    (cond [(!= (memq d `(i32 i64 f32 f64)) 0) d]
          [(!= short 0) (make-ref (boolean 1) (cdr short))]
          [else
           (let ([l (syntax->list s)])
             (cond [(and (!= l 0) (== (length l) 2) (named? (car l) (sym ref))) (make-ref 0 (parse-heap (cadr l) phase))]
                   [(and (!= l 0) (== (length l) 3) (named? (car l) (sym ref)) (named? (cadr l) (sym null)))
                    (make-ref (boolean 1) (parse-heap (caddr l) phase))]
                   [(and (pair? d) (named? (car d) (sym ref))) (fail-at s "expected (ref T) or (ref null T)" nil)]
                   [else (fail-at s "expected a type (i32, i64, f32, f64 or a reference type), got ~s" (list1 (syntax->datum s)))]))])))

;; Is x an identifier named name? The words of type syntax are compared by
;; name, like wasm's keywords, so they are reserved: no declared type may
;; be named by one (spec 5.1).
(define (named? [x datum] [name datum]) -> i32 (and (identifier? x) (== (syntax-e x) name)))

(define (parse-reftype [s datum] [phase i32]) -> datum
  (let ([t (parse-type s phase)])
    (unless (ref-type? t) (fail-at s "expected a reference type" nil))
    t))

(define type-keywords datum `(ref null mut struct array field sub final func rec ->))

;; A kind of declared type, with its article, for messages.
(define (kind-word [kind datum]) -> datum
  (case kind [((sym struct)) `"a struct"] [((sym array)) `"an array"] [((sym func)) `"a function"] [else `"a"]))

(define (check-type-name! [id datum])
  (let ([name (syntax-e id)])
    (cond [(or (!= (memq name (append abstract-heaps `(i32 i64 f32 f64 i8 i16))) 0) (!= (assq name shorthand-refs) 0))
           (fail-at id "~a names a built-in type" (list1 name))]
          [(!= (memq name type-keywords) 0)
           (fail-at id "~a is a word of type syntax, so it cannot name a type" (list1 name))])))

;; A field or element type: a storage type, optionally (mut storage), as
;; (storage mutable?).
(define (parse-field-type [s datum] [phase i32]) -> datum
  (let ([l (syntax->list s)])
    (if (and (!= l 0) (== (length l) 2) (named? (car l) (sym mut)))
        `(,(parse-storage (cadr l) phase) #t)
        `(,(parse-storage s phase) #f))))

(define (parse-storage [s datum] [phase i32]) -> datum
  (if (and (identifier? s) (or (== (syntax-e s) (sym i8)) (== (syntax-e s) (sym i16)))) (syntax-e s) (parse-type s phase)))

;; ---- macros in types ----
;;
;; In a type position, a form whose head is a macro is expanded until it
;; is not (spec 5.1): a type function. None yet, until compile-time code;
;; the expand- functions give type syntax as it is fully expanded, which
;; the parse- functions read.

(define (expand-type-name [s datum] [phase i32]) -> datum
  (if (== (core-head s phase) (sym closure))
      (let ([l (syntax->list s)])
        (unless (and (!= l 0) (== (length l) 2)) (fail-at s "expected (closure (type ... -> type ...))" nil))
        (syntax-rewrap s `(,(car l) ,(expand-signature (cadr l) phase))))
      s))

;; A value type.
(define (expand-type [s0 datum] [phase i32]) -> datum
  (let* ([s (expand-type-name s0 phase)] [l (syntax->list s)])
    (if (and (!= l 0) (pair? l) (named? (car l) (sym ref)) (pair? (cdr l)))
        (syntax-rewrap s (append (take l (- (length l) 1)) (list1 (expand-type-name (last l) phase))))
        s)))

;; A field, element or global type: a type, i8, i16, or (mut ...) of one.
(define (expand-field-type [s datum] [phase i32]) -> datum
  (let ([l (syntax->list s)])
    (cond [(and (!= l 0) (== (length l) 2) (named? (car l) (sym mut)))
           (syntax-rewrap s `(,(car l) ,(expand-field-type (cadr l) phase)))]
          [(or (== (syntax-e s) (sym i8)) (== (syntax-e s) (sym i16))) s]
          [else (expand-type s phase)])))

;; A signature (t ... -> r ...).
(define (expand-signature [s datum] [phase i32]) -> datum
  (let ([l (syntax->list s)])
    (when (== l 0) (fail-at s "expected a signature (type ... -> type ...)" nil))
    (syntax-rewrap s (map (lambda ([t datum]) -> datum (if (named? t (sym ->)) t (expand-type t phase))) l))))

;; A type definition: (struct (field name t) ...), (array t), or (sub ... def).
(define (expand-type-def [s datum] [phase i32]) -> datum
  (let ([l (syntax->list s)])
    (cond [(and (!= l 0) (pair? l) (pair? (cdr l)) (named? (car l) (sym sub)))
           (syntax-rewrap s (append (take l (- (length l) 1)) (list1 (expand-type-def (last l) phase))))]
          [(and (!= l 0) (pair? l) (named? (car l) (sym struct)))
           (syntax-rewrap s (cons (car l) (map (lambda ([f datum]) -> datum
                                                 (let ([fl (syntax->list f)])
                                                   (if (and (!= fl 0) (== (length fl) 3))
                                                       (syntax-rewrap f `(,(car fl) ,(cadr fl) ,(expand-field-type (caddr fl) phase)))
                                                       f)))
                                               (cdr l))))]
          [(and (!= l 0) (== (length l) 2) (named? (car l) (sym func)))
           (syntax-rewrap s `(,(car l) ,(expand-signature (cadr l) phase)))]
          [(and (!= l 0) (== (length l) 2) (named? (car l) (sym array)))
           (syntax-rewrap s `(,(car l) ,(expand-field-type (cadr l) phase)))]
          [else s])))

;; (type name def), where def is (struct (field fname ftype) ...),
;; (array etype), or (sub [final] [super] def) as in wasm (spec 5.2). A def
;; without sub is final, with no supertype. The name is bound before the
;; fields are read, so a type may refer to itself.
(define (declare-type [f datum] [phase i32]) -> datum
  (let* ([m (begin-type-member f phase)] [xdef (finish-type-member! m phase)])
    (identify-group! (list1 (cadddr m)))
    `(plain ,(type-member-out m xdef) ((type ,(cadddr m))))))

;; (rec (type name def) ...): types that may refer to each other, one wasm
;; recursion group (spec 5.2). Every name is bound before any fields are
;; read. A supertype must still come earlier, as in wasm.
(define (declare-rec [f datum] [phase i32]) -> datum
  (let ([l (syntax->list f)])
    (unless (and (!= l 0) (>= (length l) 2)) (no-match f "(rec type0 type ...)"))
    (let* ([members (let ([ts (cdr l)] [ms nil])
                      (while (pair? ts)
                        (let ([t (car ts)])
                          (unless (== (core-head t phase) (sym type))
                            (fail-at t "a rec group holds (type name def) forms" nil))
                          (check-super-not-later t (cdr ts))
                          (set! ms (cons (begin-type-member t phase) ms)))
                        (set! ts (cdr ts)))
                      (reverse ms))]
           [infos (map (lambda ([m datum]) -> datum (cadddr m)) members)])
      (let ([xdefs (map (lambda ([m datum]) -> datum (finish-type-member! m phase)) members)] [outs nil])
        (for-each (lambda ([info datum]) (set-type-info-group! info infos)) infos)
        (identify-group! infos)
        (while (pair? members)
          (set! outs (cons (type-member-out (car members) (car xdefs)) outs))
          (set! members (cdr members))
          (set! xdefs (cdr xdefs)))
        `(plain ,(out f (sym rec) (reverse outs)) ,(map (lambda ([i datum]) -> datum `(type ,i)) infos))))))

;; A member of a rec group whose supertype is a later member.
(define (check-super-not-later [t datum] [later datum])
  (let ([l (syntax->list t)])
    (when (and (!= l 0) (== (length l) 3))
      (let* ([name (cadr l)] [def (syntax->list (caddr l))]
             [super (cond [(or (== def 0) (not (named? (car def) (sym sub)))) 0]
                          [(and (== (length def) 3) (named? (cadr def) (sym final))) 0]
                          [(and (== (length def) 4) (named? (cadr def) (sym final))) (caddr def)]
                          [(== (length def) 3) (cadr def)]
                          [else 0])])
        (when (and (identifier? super)
                   (ormap (lambda ([u datum]) -> i32
                            (let ([ul (syntax->list u)])
                              (and (!= ul 0) (>= (length ul) 2) (== (syntax-e (cadr ul)) (syntax-e super)))))
                          later))
          (fail-at super "~a must be declared before its subtype ~a, as in wasm" `(,(syntax-e super) ,(syntax-e name))))))))

;; A type declaration being read: (form name written info), the (type name
;; def) form and the declared type. Its fully expanded form holds xdef,
;; def with its types expanded, once read.
(define (type-member-out [m datum] [xdef datum]) -> datum (out (car m) (sym type) `(,(cadr m) ,xdef)))

;; Check (type name def), resolve its supertype, and bind name. The fields
;; are read afterwards (finish-type-member!).
(define (begin-type-member [f datum] [phase i32]) -> datum
  (let ([l (syntax->list f)])
    (unless (and (!= l 0) (== (length l) 3) (identifier? (cadr l)) (syntax? (caddr l)) (pair? (syntax->list (caddr l))))
      (no-match f "(type name (kind part ...))"))
    (let* ([name (cadr l)] [written (caddr l)])
      (check-type-name! name)
      (let* ([sub (parse-sub written phase)] [def (car sub)] [final (cadr sub)] [super (caddr sub)]
             [dl (syntax->list def)]
             [kind (if (and (!= dl 0) (pair? dl)) (syntax-e (car dl)) 0)])
        (unless (!= (memq kind `(struct array func)) 0)
          (fail-at def "a type is (struct field ...), (array type), (func signature) or (sub ...)" nil))
        (when (!= super 0)
          (unless (== (type-info-kind super) kind)
            (fail-at written "~a type cannot have ~a, ~a type, as its supertype"
                     `(,(kind-word kind) ,(type-info-name super) ,(kind-word (type-info-kind super)))))
          (when (type-info-final? super)
            (fail-at written "~a is final: it cannot be a supertype" (list1 (type-info-name super)))))
        (let ([info (make-type-info (syntax-e name) kind 0 super final 0)])
          (bind-definition! name phase `(type ,info))
          `(,f ,name ,written ,info))))))

;; Read the fields of a type whose name is bound. They are expanded after
;; the name is bound, so a type function may be given the type itself.
;; Returns def expanded.
(define (finish-type-member! [m datum] [phase i32]) -> datum
  (let* ([info (cadddr m)]
         [xdef (expand-type-def (caddr m) phase)]
         [xinner (car (parse-sub xdef phase))])
    (set-type-info-fields! info (parse-type-fields xinner (type-info-kind info) phase))
    (when (!= (type-info-super info) 0) (check-subtype-fields! info (type-info-super info) xinner))
    xdef))

;; (sub [final] [super] def) -> (def final? super-type-info-or-#f).
(define (parse-sub [s datum] [phase i32]) -> datum
  (let ([l (syntax->list s)])
    (cond [(or (== l 0) (not (pair? l)) (not (named? (car l) (sym sub)))) `(,s #t #f)]
          [(and (== (length l) 3) (named? (cadr l) (sym final))) `(,(caddr l) #t #f)]
          [(and (== (length l) 4) (named? (cadr l) (sym final))) `(,(cadddr l) #t ,(type-of (caddr l) phase))]
          [(== (length l) 2) `(,(cadr l) #f #f)]
          [(== (length l) 3) `(,(caddr l) #f ,(type-of (cadr l) phase))]
          [else (fail-at s "expected (sub [final] [supertype] (struct ...) or (array ...))" nil)])))

(define (parse-type-fields [def datum] [kind datum] [phase i32]) -> datum
  (let ([l (syntax->list def)])
    (case kind
      [((sym struct))
       (map (lambda ([f datum]) -> datum
              (let ([fl (syntax->list f)])
                (unless (and (!= fl 0) (== (length fl) 3) (named? (car fl) (sym field)) (identifier? (cadr fl)))
                  (no-match f "(field name type)"))
                (cons (syntax-e (cadr fl)) (parse-field-type (caddr fl) phase))))
            (cdr l))]
      [((sym func)) (let ([sig (parse-signature (cadr l) phase)]) `(,(car sig) ,(cdr sig)))]
      [else (parse-field-type (cadr l) phase)])))

;; Wasm's rule for a declared supertype: a struct starts with its
;; supertype's fields, and an array's element matches. An immutable field
;; may narrow its type; a mutable one keeps it.
(define (field<=? [a datum] [b datum]) -> i32               ; (storage mutable?)
  (and (== (cadr a) (cadr b))
       (if (or (== (car a) (sym i8)) (== (car a) (sym i16)) (== (car b) (sym i8)) (== (car b) (sym i16)))
           (== (car a) (car b))
           (and (valtype<=? (car a) (car b)) (or (not (cadr a)) (valtype<=? (car b) (car a)))))))

(define (check-subtype-fields! [info datum] [super datum] [where datum])
  (case (type-info-kind info)
    [((sym struct))
     (let ([mine (type-info-fields info)] [theirs (type-info-fields super)])
       (when (< (length mine) (length theirs))
         (fail-at where "~a has fewer fields than its supertype ~a" `(,(type-info-name info) ,(type-info-name super))))
       (while (pair? theirs)
         (unless (field<=? (cdr (car mine)) (cdr (car theirs)))
           (fail-at where "~a's field ~a does not match field ~a of its supertype ~a"
                    `(,(type-info-name info) ,(car (car mine)) ,(car (car theirs)) ,(type-info-name super))))
         (set! mine (cdr mine))
         (set! theirs (cdr theirs))))]
    [((sym array))
     (unless (field<=? (type-info-fields info) (type-info-fields super))
       (fail-at where "~a's element type does not match its supertype ~a's" `(,(type-info-name info) ,(type-info-name super))))]
    ;; A function subtype accepts at least its supertype's parameters and
    ;; returns at most its results.
    [else
     (let ([mine (type-info-fields info)] [theirs (type-info-fields super)])
       (unless (and (types<=? (car theirs) (car mine)) (types<=? (cadr mine) (cadr theirs)))
         (fail-at where "~a's signature does not fit its supertype ~a's" `(,(type-info-name info) ,(type-info-name super)))))]))

(define (type-of [id datum] [phase i32]) -> datum
  (let ([m (if (identifier? id) (type-meaning-of id phase) 0)])
    (when (== m 0) (fail-at id "~s is not a declared type" (list1 (syntax->datum id))))
    (cadr m)))

(define (field-index [tinfo datum] [id datum]) -> datum
  (unless (== (type-info-kind tinfo) (sym struct))
    (fail-at id "~a is not a struct type" (list1 (type-info-name tinfo))))
  (let ([fs (type-info-fields tinfo)] [i 0])
    (while (pair? fs)
      (when (and (identifier? id) (== (car (car fs)) (syntax-e id))) (return (make-integer i)))
      (set! fs (cdr fs))
      (+= i 1))
    (fail-at id "~a has no field ~s" `(,(type-info-name tinfo) ,(syntax->datum id)))))

;; ==== other module-level forms ====

;; A string literal, and a count: a fixnum from 0.
(define (string-literal? [s datum]) -> i32 (string? (syntax-e s)))
(define (count-literal? [s datum]) -> i32
  (let ([n (syntax-e s)]) (and (integer? n) (>= (integer-value n) 0) (< (integer-value n) 1073741824))))

;; `-> t` or `-> (t ...)`: (results . the rest of body).
(define (parse-results [body datum] [phase i32]) -> datum
  (cond [(and (pair? body) (named? (car body) (sym ->)) (pair? (cdr body)))
         (let* ([r (cadr body)] [l (syntax->list r)])
           (cons (cond [(and (!= l 0) (pair? l) (named? (car l) (sym ref))) (list1 (parse-type r phase))]
                       [(!= l 0) (map (lambda ([x datum]) -> datum (parse-type x phase)) l)]
                       [else (list1 (parse-type r phase))])
                 (cddr body)))]
        [(and (pair? body) (named? (car body) (sym ->))) (fail-at (car body) "expected a type after ->" nil)]
        [else (cons nil body)]))

;; The `-> r` that starts rest, a func's or a lambda's, as a list of the
;; two, or (). r is one type or a list of them, and has its types
;; expanded; a macro use is one type, though it looks like a list.
(define (arrow-of [rest datum] [phase i32]) -> datum
  (cond [(and (pair? rest) (named? (car rest) (sym ->)) (pair? (cdr rest)))
         (let* ([r (cadr rest)] [l (syntax->list r)])
           `(,(car rest) ,(cond [(and (!= l 0) (pair? l) (named? (car l) (sym ref))) (expand-type r phase)]
                                [(!= l 0) (syntax-rewrap r (map (lambda ([x datum]) -> datum (expand-type x phase)) l))]
                                [else (expand-type r phase)])))]
        [(and (pair? rest) (named? (car rest) (sym ->))) (fail-at (car rest) "expected a type after ->" nil)]
        [else nil]))

;; (t ... -> r ...): (params . results).
(define (parse-signature [s datum] [phase i32]) -> datum
  (let ([l (syntax->list s)] [params nil])
    (when (or (== l 0) (not (ormap (lambda ([t datum]) -> i32 (named? t (sym ->))) l)))
      (fail-at s "expected a signature (type ... -> type ...)" nil))
    (while (not (named? (car l) (sym ->)))
      (set! params (cons (car l) params))
      (set! l (cdr l)))
    (cons (map (lambda ([t datum]) -> datum (parse-type t phase)) (reverse params))
          (map (lambda ([t datum]) -> datum (parse-type t phase)) (cdr l)))))

;; The options after a func's head, [#:inline] [#:value g] (spec 5.2), as
;; (inline value rest): the #:inline keyword or #f, the list (#:value g)
;; or #f, and what follows them.
(define (func-options [rest datum]) -> datum
  (let* ([inline (if (and (pair? rest) (== (syntax-e (car rest)) `#:inline)) (car rest) 0)]
         [rest (if (!= inline 0) (cdr rest) rest)]
         [value (if (and (pair? rest) (== (syntax-e (car rest)) `#:value))
                    (begin
                      (unless (and (pair? (cdr rest)) (identifier? (cadr rest)))
                        (fail-at (car rest) "#:value needs the name of a global" nil))
                      `(,(car rest) ,(cadr rest)))
                    0)])
    `(,inline ,value ,(if (!= value 0) (cddr rest) rest))))

;; (func (name [p t] ...) [#:inline] [#:value g] [-> r] body ...)
(define (declare-func [f datum] [phase i32]) -> datum
  (let* ([l (syntax->list f)] [head (if (and (!= l 0) (>= (length l) 2)) (syntax->list (cadr l)) 0)])
    (unless (and (!= head 0) (pair? head) (identifier? (car head))) (no-match f "(func (name param ...) . body)"))
    (let* ([name (car head)]
           [params (map (lambda ([p datum]) -> datum (param-of p phase)) (cdr head))]
           [types (map (lambda ([pp datum]) -> datum (parse-type (cadr pp) phase)) params)]
           [options (func-options (cddr l))]
           [inline (car options)] [value (cadr options)] [rest (caddr options)]
           [arrow (arrow-of rest phase)]
           [rb (parse-results (append arrow (list-tail rest (length arrow))) phase)]
           [results (car rb)]
           [ct (func-type-clause (cdr rb) types results phase)]
           [info (func-info (syntax-e name) types results 0 0 (cadr ct))])
      (bind-definition! name phase `(func ,info))
      (when (!= value 0) (hash-set! (& function-values) (cast u64 info) (cast u32 (keep (cons (cadr value) (make-integer phase))))))
      `(func ,name ,params ,arrow ,(caddr ct) ,f ,(car ct) ,inline ,value ,info))))

;; A parameter [name type], as (name type) with the type expanded.
(define (param-of [p datum] [phase i32]) -> datum
  (let ([l (syntax->list p)])
    (unless (and (!= l 0) (== (length l) 2) (identifier? (car l))) (no-match p "(name type)"))
    `(,(car l) ,(expand-type (cadr l) phase))))

;; An optional (type T) first in a func's body declares its function type
;; T, as in wasm (spec 5.2): the type other modules and ref.func see it
;; at. Its parameters and results must be T's. Returns (clause T body).
(define (func-type-clause [body datum] [params datum] [results datum] [phase i32]) -> datum
  (let ([first (if (pair? body) (syntax->list (car body)) 0)])
    (if (and (!= first 0) (== (length first) 2) (named? (car first) (sym type)))
        (let* ([tname (expand-type-name (cadr first) phase)] [t (type-of tname phase)])
          (unless (func-type? t) (fail-at (cadr first) "~a is not a function type" (list1 (type-info-name t))))
          (unless (and (types=? params (car (type-info-fields t))) (types=? results (cadr (type-info-fields t))))
            (fail-at (car body) "the function's parameters and results are not those of ~a" (list1 (type-info-name t))))
          `(,(syntax-rewrap (car body) `(,(car first) ,tname)) ,t ,(cdr body)))
        `(#f #f ,body))))

;; The body forms of a function or a lambda, each expanded with scope sc
;; added: (forms . whether they have closures, #t or #f).
(define (expand-scoped [body datum] [sc u32] [phase i32]) -> datum
  (let ([outer lowered-closures] [r datum 0] [flag 0])
    (set! lowered-closures 0)
    (set! r (map (lambda ([b datum]) -> datum (expand-expr (add-scope b sc) phase)) body))
    (set! flag lowered-closures)
    (set! lowered-closures outer)
    (cons r (boolean flag))))

;; (func (name [p t] ...) [-> r] body ...), expanded: its lowered form,
;; for the compiler, or its fully expanded form.
(define (expand-func [p datum] [phase i32]) -> datum
  (let* ([name (list-ref p 1)] [params (list-ref p 2)] [arrow (list-ref p 3)] [body (list-ref p 4)]
         [f (list-ref p 5)] [clause (list-ref p 6)] [inline (list-ref p 7)] [value (list-ref p 8)] [info (list-ref p 9)]
         [sc (new-local-scope!)]
         [xs (map (lambda ([pp datum]) -> datum (add-scope (car pp) sc)) params)]
         [keys (map (lambda ([x datum]) -> datum (bind-local! x phase)) xs)]
         [saved current-function] [r datum 0])
    (set! current-function (list1 name))
    (set! r (expand-scoped body sc phase))
    (set! current-function saved)
    (if to-syntax
        (let ([ps nil] [x xs] [k keys] [pp params])
          (while (pair? x)
            (set! ps (cons (out-list (car x) `(,(with-local-binding (car x) (car k)) ,(cadr (car pp)))) ps))
            (set! x (cdr x)) (set! k (cdr k)) (set! pp (cdr pp)))
          (list1 (out f (sym func)
                      `(,(out-list (cadr (syntax->list f)) (cons name (reverse ps)))
                        ,@(if (!= inline 0) (list1 inline) nil) ,@(if (!= value 0) value nil) ,@arrow
                        ,@(if (!= clause 0) (list1 (core-headed clause (sym type))) nil)
                        ,@(car r)))))
        (let ([ps nil] [k keys] [types (func-info-params info)] [code (seq-at f (car r))])
          (while (pair? k)
            (set! ps (cons (cons (car k) (car types)) ps))
            (set! k (cdr k)) (set! types (cdr types)))
          (set! ps (reverse ps))
          (when (!= inline 0) (note-inline! info ps code name))
          (when (!= value 0) (function-value info))
          (list1 `(func ,info ,ps ,code ,(cdr r)))))))

;; (global name type init) or (global name (mut type) init), as in wasm.
(define (declare-global [f datum] [phase i32]) -> datum
  (let ([l (syntax->list f)])
    (unless (and (!= l 0) (== (length l) 4) (identifier? (cadr l))) (no-match f "(global name type init)"))
    (let* ([name (cadr l)] [xt (expand-field-type (caddr l) phase)] [xl (syntax->list xt)]
           [info (if (and (!= xl 0) (== (length xl) 2) (named? (car xl) (sym mut)))
                     (global-info (syntax-e name) (parse-type (cadr xl) phase) (boolean 1) 0 0)
                     (global-info (syntax-e name) (parse-type xt phase) 0 0 0))])
      (bind-definition! name phase `(global ,info))
      `(global ,f ,xt ,info))))

(define (expand-global [p datum] [phase i32]) -> datum
  (let* ([l (syntax->list (cadr p))] [r (expand-noted (cadddr l) phase)])
    (if to-syntax
        (list1 (out (cadr p) (sym global) `(,(cadr l) ,(caddr p) ,(car r))))
        (list1 `(global ,(cadddr p) ,(car r) ,(cdr r))))))

;; Expression e expanded: (its code . whether it has closures).
(define (expand-noted [e datum] [phase i32]) -> datum
  (let ([outer lowered-closures] [r datum 0] [flag 0])
    (set! lowered-closures 0)
    (set! r (expand-expr e phase))
    (set! flag lowered-closures)
    (set! lowered-closures outer)
    (cons r (boolean flag))))

(define (closures-noted-expr [e datum] [phase i32]) -> datum (expand-noted e phase))

;; (import name "module" "field" (t ... -> r ...)), or with a function
;; type's name in place of the signature, to import the function at that
;; type (spec 5.2).
(define (declare-import [f datum] [phase i32]) -> datum
  (let ([l (syntax->list f)])
    (unless (and (!= l 0) (== (length l) 5) (identifier? (cadr l)) (string-literal? (caddr l)) (string-literal? (cadddr l)))
      (no-match f "(import name module field signature)"))
    (let* ([name (cadr l)] [module (caddr l)] [field (cadddr l)] [signature (list-ref l 4)]
           [ftype (if (identifier? signature)
                      (let ([t (type-of (expand-type-name signature phase) phase)])
                        (unless (func-type? t) (fail-at signature "~a is not a function type" (list1 (type-info-name t))))
                        t)
                      0)]
           [sig (if (!= ftype 0) (expand-type-name signature phase) (expand-signature signature phase))]
           [pr (if (!= ftype 0)
                   (cons (car (type-info-fields ftype)) (cadr (type-info-fields ftype)))
                   (parse-signature sig phase))])
      (bind-definition! name phase `(func ,(func-info (syntax-e name) (car pr) (cdr pr) (syntax-e module) (syntax-e field) ftype)))
      `(plain ,(out f (sym import) `(,name ,module ,field ,sig)) ()))))

;; (data name offset "bytes" ...): an active segment in the module's memory.
(define (declare-data [f datum] [phase i32]) -> datum
  (let ([l (syntax->list f)])
    (unless (and (!= l 0) (>= (length l) 3) (identifier? (cadr l)) (count-literal? (caddr l))
                 (andmap (lambda ([b datum]) -> i32 (string-literal? b)) (cdddr l)))
      (no-match f "(data name offset bytes ...)"))
    (let* ([bytes (make-buffer)] [parts (cdddr l)] [s datum 0])
      (while (pair? parts)
        (buffer-add! (& bytes) (string-bytes (syntax-e (car parts))) (string-length (syntax-e (car parts))))
        (set! parts (cdr parts)))
      (set! s (bytes->string (-> bytes bytes) (-> bytes length)))
      (buffer-free! (& bytes))
      (let ([info (data-info (syntax-e (cadr l)) (syntax-e (caddr l)) s)])
        (bind-definition! (cadr l) phase `(data ,info))
        `(plain ,(core-headed f (sym data)) ((data ,info)))))))

;; (tag name (t ...)): a tag, whose exceptions carry values of types t ...
;; (spec 5.2).
(define (declare-tag [f datum] [phase i32]) -> datum
  (let ([l (syntax->list f)])
    (unless (and (!= l 0) (== (length l) 3) (identifier? (cadr l)) (syntax? (caddr l)) (!= (syntax->list (caddr l)) 0))
      (no-match f "(tag name (type ...))"))
    (let* ([types (caddr l)] [xs (map (lambda ([t datum]) -> datum (expand-type t phase)) (syntax->list types))]
           [info (tag-info (syntax-e (cadr l)) (map (lambda ([t datum]) -> datum (parse-type t phase)) xs) 0 0)])
      (bind-definition! (cadr l) phase `(tag ,info))
      `(plain ,(out f (sym tag) `(,(cadr l) ,(syntax-rewrap types xs))) ((tag ,info))))))

(define (tag-info-of [id datum] [phase i32]) -> datum
  (let ([m (if (identifier? id) (meaning-of id phase) 0)])
    (unless (and (!= m 0) (== (car m) (sym tag))) (fail-at id "~s is not a tag" (list1 (syntax->datum id))))
    (cadr m)))

;; ---- require, provide, storage ----

;; (require name source item ...), where source is "path" or kernel (the
;; kernel module). Everything the source provides is bound as name:thing.
;; Each item also binds one thing unqualified: x as itself, or [new old] as
;; new. A require at phase p imports at phase p (spec 3.1).
;; (require-unqualified name source) is require with every name the source
;; provides also bound unqualified, with the scopes of name. It is meant
;; for a language's core forms, and little else (spec 3.1).
(define (require! [f datum] [phase i32] [all i32])
  (let ([l (syntax->list f)])
    (if all
        (unless (and (!= l 0) (== (length l) 3) (identifier? (cadr l)) (module-source? (caddr l)))
          (no-match f "(require-unqualified name source)"))
        (unless (and (!= l 0) (>= (length l) 3) (identifier? (cadr l)) (module-source? (caddr l)))
          (no-match f "(require name source item ...)")))
    (let* ([name (cadr l)] [source (caddr l)]
           [provided (cond [(string? (syntax-e source)) (require-module! f name source phase)]
                           [(pair? (syntax-e source)) (fail-at source "compiled files are not yet in the new compiler" nil)]
                           [else (require-kernel! source phase)])])
      (for-each (lambda ([p datum]) (bind-import! (qualified name (car p)) phase (cdr p))) provided)
      (when all
        (for-each (lambda ([p datum])
                    (hash-set! (& unqualified-imports)
                               (cast u64 (bind-import! (datum->syntax name (car p) name) phase (cdr p)))
                               1))
                  provided))
      (let ([items (cdddr l)])
        (while (pair? items)
          (let* ([item (car items)] [il (syntax->list item)]
                 [names (cond [(identifier? item) (cons item item)]
                              [(and (!= il 0) (== (length il) 2) (identifier? (car il)) (identifier? (cadr il))) (cons (car il) (cadr il))]
                              [else (no-match item "name or (new-name name)")])]
                 [old (cdr names)]
                 [ps (filter (lambda ([p datum]) -> i32 (== (car p) (syntax-e old))) provided)])
            (when (null? ps) (fail-at old "~a does not provide ~a" `(,(syntax-e source) ,(syntax-e old))))
            (for-each (lambda ([p datum]) (bind-import! (car names) phase (cdr p))) ps))
          (set! items (cdr items)))))))

;; A module's source in a require: a path, kernel, or (compiled file).
(define (module-source? [s datum]) -> i32
  (let ([l (syntax->list s)])
    (or (string-literal? s) (named? s (sym kernel))
        (and (!= l 0) (== (length l) 2) (named? (car l) (sym compiled)) (string-literal? (cadr l))))))

;; name:thing, with the scopes of name.
(define (qualified [name datum] [sym datum]) -> datum
  (datum->syntax name (string->symbol (format-message "~a:~a" `(,(syntax-e name) ,sym))) name))

(define (bind-import! [id datum] [phase i32] [meaning datum]) -> (ptr binding)
  (check-unbound! id phase meaning)
  (bind-module-level! (syntax-e id) (syntax-scopes id) phase meaning))

(define (symbol<? [a datum] [b datum]) -> i32
  (let* ([x (symbol-bytes a)] [y (symbol-bytes b)] [n (symbol-length a)] [m (symbol-length b)]
         [c (memcmp x y (if (< n m) n m))])
    (or (< c 0) (and (== c 0) (< n m)))))

;; The kernel module's contract (spec 2.3): its functions, its tag and
;; its types, as (symbol . meaning), sorted by name for deterministic keys.
(define (require-kernel! [source datum] [phase i32]) -> datum
  (unless (== (-> (unit-of kernel) state) (sym done)) (fail-at source "the kernel module cannot require itself" nil))
  (let ([m (unit-of kernel)] [all nil] [infos datum 0])
    (set! infos (-> m infos))
    (while (pair? infos)
      (let ([info (car infos)])
        (cond [(func-info? info) (set! all (cons (cons (func-info-name info) `(func ,info)) all))]
              [(tag-info? info) (set! all (cons (cons (tag-info-name info) `(tag ,info)) all))]))
      (set! infos (cdr infos)))
    (set! all (append (reverse all) (map (lambda ([t datum]) -> datum (cons (type-info-name t) `(type ,t))) (reverse (-> m types)))))
    (sort (filter (lambda ([p datum]) -> i32 (not (internal-name? (car p)))) all)
          (lambda ([a datum] [b datum]) -> i32 (symbol<? (car a) (car b))))))

(define (module-path-of [f datum] [spec datum]) -> datum
  (let* ([loc (syntax-srcloc f)]
         [dir (if (!= loc 0) (directory-of (symbol->string (-> loc source))) `"")]
         [given (syntax-e spec)])
    (if (absolute-path? given) given (string-append-2 dir given))))

;; Compile the module if needed and make its own bindings resolvable for
;; its macros. Returns what it provides, as seen from phase.
(define (require-module! [f datum] [name datum] [spec datum] [phase i32]) -> datum
  (require-unit! name (compile-module-file (module-path-of f spec)) phase))

;; Module m, required as name at phase: recorded; what it provides, as
;; seen from phase. A module required at a phase above 0 comes with
;; compile-time code.
(define (require-unit! [name datum] [m datum] [phase i32]) -> datum
  (let* ([me (the-module)] [key (cons (syntax-e name) (make-integer phase))]
         [named (assoc key (-> current require-names))] [req (cons m (make-integer phase))])
    (when (and (!= named 0) (!= (cdr named) m))
      (fail-at name "~a already names another module at this phase" (list1 (syntax-e name))))
    (when (== named 0) (set! (-> current require-names) (cons (cons key m) (-> current require-names))))
    (when (!= phase 0) (fail-at name "requires at phase ~a are not yet in the new compiler" (list1 (make-integer phase))))
    (when (== (member req (-> me requires)) 0)
      (set! (-> me requires) (keep (append (-> me requires) (list1 req)))))
    (-> (unit-of m) provides)))

;; The module a require named at this phase.
(define (required-module [name datum] [phase i32]) -> datum
  (let ([named (if (identifier? name) (assoc (cons (syntax-e name) (make-integer phase)) (-> current require-names)) 0)])
    (when (== named 0) (fail-at name "~s is not the name of a module required at this phase" (list1 (syntax->datum name))))
    (cdr named)))

;; (provide item ...): x provides x, and [new old] provides old under the
;; name new; (all-from-out m) provides what module m, required at phase 0,
;; provides, and (except-out (all-from-out m) x ...) all that but the
;; names x ... (spec 3.1). Recorded as (name . id), resolved when the
;; module is done.
(define (provide! [f datum] [phase i32])
  (unless (== phase 0) (fail-at f "provide belongs at phase 0" nil))
  (let ([l (syntax->list f)] [items nil])
    (when (== l 0) (no-match f "(provide item ...)"))
    (for-each (lambda ([item datum]) (set! items (append items (provide-items item)))) (cdr l))
    (for-each (lambda ([item datum])
                (let ([earlier (let ([ids (-> current provide-ids)] [found datum 0])
                                 (while (and (pair? ids) (== found 0))
                                   (when (== (syntax-e (car (car ids))) (syntax-e (car item))) (set! found (car ids)))
                                   (set! ids (cdr ids)))
                                 found)])
                  (when (and (!= earlier 0) (!= (syntax-e (cdr earlier)) (syntax-e (cdr item))))
                    (fail-at (car item) "~a is provided twice, for ~a and for ~a"
                             `(,(syntax-e (car item)) ,(syntax-e (cdr earlier)) ,(syntax-e (cdr item)))))
                  (set! (-> current provide-ids) (cons item (-> current provide-ids)))))
              items)))

;; A provide item as a list of (name . id).
(define (provide-items [item datum]) -> datum
  (let ([l (syntax->list item)])
    (cond [(identifier? item) (list1 (cons item item))]
          [(and (!= l 0) (== (length l) 2) (named? (car l) (sym all-from-out))) (all-from-items (cadr l) nil)]
          [(and (!= l 0) (>= (length l) 2) (named? (car l) (sym except-out))
                (let ([inner (syntax->list (cadr l))]) (and (!= inner 0) (== (length inner) 2) (named? (car inner) (sym all-from-out))))
                (andmap (lambda ([x datum]) -> i32 (identifier? x)) (cddr l)))
           (all-from-items (cadr (syntax->list (cadr l))) (cddr l))]
          [(and (!= l 0) (== (length l) 2) (identifier? (car l)) (identifier? (cadr l))) (list1 (cons (car l) (cadr l)))]
          [else (no-match item "name, (all-from-out module), (except-out (all-from-out module) name ...) or (new-name name)")])))

;; What the module required as name provides, but the names excluded, as
;; provide items: each one's qualified binding, name:thing.
(define (all-from-items [name datum] [excluded datum]) -> datum
  (let* ([m (unit-of (required-module name 0))] [out (map (lambda ([x datum]) -> datum (syntax-e x)) excluded)]
         [syms nil] [ps (-> m provides)])
    (while (pair? ps)
      (when (== (memq (car (car ps)) syms) 0) (set! syms (cons (car (car ps)) syms)))
      (set! ps (cdr ps)))
    (for-each (lambda ([x datum])
                (when (== (memq (syntax-e x) syms) 0) (fail-at x "~a does not provide ~a" `(,(syntax-e name) ,(syntax-e x)))))
              excluded)
    (map (lambda ([sym datum]) -> datum (cons (datum->syntax name sym name) (qualified name sym)))
         (filter (lambda ([sym datum]) -> i32 (== (memq sym out) 0)) (reverse syms)))))

;; (memory pages) or (memory from name), and likewise (table ...): the
;; module's memory or table at this phase. name is a module required at
;; this phase (spec 3.3).
(define (declare-storage! [f datum] [phase i32])
  (let* ([l (syntax->list f)] [kind (syntax-e (car l))] [memory (== kind (sym memory))]
         [table (if memory (-> current memories) (-> current tables))] [form datum 0])
    (when (!= (assoc (make-integer phase) table) 0) (fail-at f "a second ~a declaration at this phase" (list1 kind)))
    (set! form (cond [(and (== (length l) 2) (count-literal? (cadr l))) `(,kind ,(syntax-e (cadr l)))]
                     [(and (== (length l) 3) (named? (cadr l) (sym from)))
                      `(,(if memory (sym memory-import) (sym table-import)) ,(linklet-name (required-module (caddr l) phase) 0 phase))]
                     [else (no-match f (if memory "(memory size) or (memory from module)" "(table size) or (table from module)"))]))
    (if memory
        (set! (-> current memories) (cons (cons (make-integer phase) form) (-> current memories)))
        (set! (-> current tables) (cons (cons (make-integer phase) form) (-> current tables))))))

;; Instance names (spec 3.2): "<module>@<phase>+<shift>" for a module's
;; linklet at a phase shift. The compiler reads a name back only through
;; this table: name, a symbol -> (module phase shift).
(define instance-refs hash-table)

;; The name of module m's phase-q linklet at phase shift t.
(define (linklet-name [m datum] [q i32] [t i32]) -> datum
  (let* ([name (format-message "~a@~a+~a" `(,(-> (unit-of m) name) ,(make-integer q) ,(make-integer t)))]
         [key (cast u64 (string->symbol name))])
    (when (== (hash-ref (& instance-refs) key) 0)
      (hash-set! (& instance-refs) key (cast u32 (keep `(,m ,(make-integer q) ,(make-integer t))))))
    name))

;; The module linklet an instance name names, as (module phase shift), or #f.
(define (linklet-ref [name datum]) -> datum (cast datum (hash-ref (& instance-refs) (cast u64 (string->symbol name)))))

;; (freestanding): after expansion, the program needs nothing beyond the
;; host at run time (spec 3.4).
(define (freestanding! [f datum] [phase i32])
  (let ([l (syntax->list f)])
    (unless (and (!= l 0) (== (length l) 1)) (no-match f "(freestanding)"))
    (unless (== phase 0) (fail-at f "(freestanding) belongs at phase 0" nil))
    (set! (-> current freestanding-form) f)))

;; ---- facts (spec 6.5) ----

;; (#%fact id 'datum) or (#%fact id #'stx): the datum, or the syntax as
;; quote-syntax keeps it (spec 6.2), recorded as a fact about the
;; definition id refers to at phase: data the module keeps. The form, as
;; fully expanded code holds it.
(define (fact! [f datum] [phase i32]) -> datum
  (let ([l (syntax->list f)])
    (unless (and (!= l 0) (== (length l) 3) (identifier? (cadr l)))
      (fail-at f "expected (#%fact id 'datum) or (#%fact id #'syntax)" nil))
    (let* ([id (cadr l)] [written (caddr l)]
           [key (fact-key id phase)]
           [kind (fact-quote written phase)]
           [d (cadr (syntax->list written))]
           [value (if (== kind (sym quote)) (syntax->datum d) (prune-local-scopes d))]
           [fact `(,key ,(make-integer phase) ,value)]
           [m (the-module)])
      (set! (-> m facts) (keep (cons fact (-> m facts))))
      (index-fact! (-> m self) fact)
      (core-headed f (sym #%fact)))))

;; The facts of every module compiled, by the definition each is about:
;; definition -> ((module phase value) ...), the latest first.
(define facts-by-key hash-table)

(define (index-fact! [m datum] [f datum])
  (let ([k (cast u64 (car f))])
    (hash-set! (& facts-by-key) k (cast u32 (keep (cons (cons m (cdr f)) (cast datum (hash-ref (& facts-by-key) k))))))))

;; What a fact is written with, quote or quote-syntax: whether it records
;; a datum or syntax.
(define (fact-quote [written datum] [phase i32]) -> datum
  (let ([kind (core-head written phase)] [l (syntax->list written)])
    (unless (and (!= (memq kind `(quote quote-syntax)) 0) (== (length l) 2))
      (fail-at written "a fact is a datum or syntax: expected (#%fact id 'datum) or (#%fact id #'syntax)" nil))
    kind))

;; The definition meaning m is of, if it is a module's: the info of its
;; function, global or tag, or the getter of its compile-time value;
;; otherwise #f. Core forms, locals and the kernel module's definitions,
;; which every language shares, are none.
(define (definition-of [m datum]) -> datum
  (let ([info (if (and (!= m 0) (!= (memq (car m) `(func global tag compile-time-value)) 0)) (cadr m) 0)])
    (if (and (!= info 0) (not (kernel-definition? info))) info 0)))

(define (kernel-definition? [info datum]) -> i32
  (let ([instance (cond [(func-info? info) (func-info-instance info)]
                        [(global-info? info) (global-info-instance info)]
                        [(tag-info? info) (tag-info-instance info)]
                        [else 0])])
    (and (string? instance) (string=? instance `"kernel"))))

;; The definition id refers to at phase, which a fact is about.
(define (fact-key [id datum] [phase i32]) -> datum
  (let* ([m (meaning-of id phase)] [base (definition-of m)])
    (when (== m 0) (fail-at id "~a is unbound: a fact is about a definition made before it" (list1 (syntax-e id))))
    (when (== base 0) (fail-at id "a fact is about a module's definition, and ~a is not one" (list1 (syntax-e id))))
    base))

;; The types and definitions in module m's lowered forms: its types in
;; order, and its functions, globals and tags, newest first.
(define (note-definitions! [m datum] [forms datum])
  (let ([u (unit-of m)])
    (for-each (lambda ([f datum])
                (case (car f)
                  [((sym type)) (set! (-> u types) (keep (cons (cadr f) (-> u types))))]
                  [((sym func) (sym global) (sym tag)) (set! (-> u infos) (keep (cons (cadr f) (-> u infos))))]))
              forms)))

;; ==== fully expanded code ====
;;
;; Fully expanded code (spec 6.4) is syntax in the kernel's core grammar,
;; with every macro use expanded and every application and literal
;; explicit: what local-expand gives a macro, and sub expand prints. The
;; walk below builds it in place of lowered code when asked (to-syntax).
;;
;; The core forms in fully expanded code are named by identifiers with only
;; the core scope, so they mean the core forms in any module, whatever it
;; binds. Everything else keeps its scopes. So fully expanded code can be
;; expanded again: macros can embed the result of local-expand.

(define (loc-of [where datum]) -> (ptr srcloc) (if (syntax? where) (syntax-srcloc where) 0))

;; The identifier for core form name in fully expanded code.
(define (core-id [name datum] [where datum]) -> datum (make-syntax name core-scopes (loc-of where) nil))

;; A list in fully expanded code, located at where.
(define (out-list [where datum] [items datum]) -> datum (make-syntax items core-scopes (loc-of where) nil))

;; The core form (name part ...), located at where.
(define (out [where datum] [name datum] [parts datum]) -> datum (out-list where (cons (core-id name where) parts)))

;; Module-level form f with its head replaced by the core identifier.
(define (core-headed [f datum] [name datum]) -> datum
  (out-list f (cons (core-id name (car (syntax-e f))) (cdr (syntax-e f)))))

;; An identifier for one of the kernel module's functions, for the calls
;; quasiquote and quasisyntax expand into. Its private scope is on no
;; module's code, so only fully expanded code can refer to it.
(define kernel-id-scopes (ptr scope-set) 0)
(define kernel-ids hash-table)

(define (kernel-id [name datum]) -> datum
  (when (== kernel-id-scopes 0) (set! kernel-id-scopes (scopes-change no-scopes (new-run-scope!) 0)))
  (let ([known (cast datum (hash-ref (& kernel-ids) (cast u64 name)))])
    (if (!= known 0)
        known
        (let ([id (keep (make-syntax name kernel-id-scopes 0 nil))])
          (bind-raw! name kernel-id-scopes all-phases `(func ,(kernel-function name)))
          (hash-set! (& kernel-ids) (cast u64 name) (cast u32 id))
          id))))

;; ==== expressions ====
;;
;; One walk expands an expression and builds its output: the compiler's
;; input (core.sub), lowered code, which a module's code becomes; or, for
;; sub expand, fully expanded code, syntax (spec 6.4). The walk resolves
;; and checks each form once, and builds either from what it found.

;; Whether the walk builds fully expanded code, rather than lowered code.
(define to-syntax i32 0)

;; Lowered expression e, at s (spec 3.6): s is the syntax whose source
;; location it is at.
(define (at [s datum] [e datum]) -> datum `(at ,s ,e))

;; The lowered expressions es in sequence, at s.
(define (seq-at [s datum] [es datum]) -> datum (at s (cons (sym seq) es)))

;; Whether the form being built has a lambda or an application of a
;; function value, which the compiler looks for closures in (core.sub).
(define lowered-closures i32 0)

;; s has no value binding. It may still name a type.
(define (unbound [s datum] [sym datum] [phase i32]) -> datum
  (if (!= (type-meaning-of s phase) 0)
      (fail-at s "~a is a type, not a value" (list1 sym))
      (fail-at s "unbound identifier ~a~a" `(,sym ,(if (> phase 0) (format-message " at phase ~a" (list1 (make-integer phase))) `"")))))

(define (expand-expr [s datum] [phase i32]) -> datum
  (let ([e (syntax-e s)])
    (cond
      [(symbol? e)
       (let ([m (meaning-of s phase)])
         (case (if (== m 0) 0 (car m))
           [((sym local)) (if to-syntax (with-local-binding s (cadr m)) (at s `(lref ,(cadr m))))]
           [((sym global)) (if to-syntax (with-local-binding s 0) (at s `(gref ,(cadr m))))]
           ;; A function's name as an expression is its value (5.2).
           [((sym func))
            (unless (has-value? (cadr m)) (fail-at s "~a is a function: call it, or use (func-index ~a)" `(,e ,e)))
            (if to-syntax (with-local-binding s 0) (at s `(gref ,(function-value (cadr m)))))]
           [((sym data)) (fail-at s "~a is data: use (data-address ~a) and (data-size ~a)" `(,e ,e ,e))]
           [((sym tag)) (fail-at s "~a is a tag: throw it with (throw ~a arg ...)" `(,e ,e))]
           [((sym core) (sym prim)) (fail-at s "bad use of ~a" (list1 e))]
           [((sym label)) (fail-at s "~a is a label" (list1 e))]
           [else (unbound s e phase)]))]
      [(pair? e)
       (let* ([head (car e)] [m (if (identifier? head) (meaning-of head phase) 0)])
         (case (if (== m 0) 0 (car m))
           [((sym core)) (expand-core (cadr m) s phase)]
           [((sym prim)) (expand-prim (cadr m) s phase)]
           [else
            ;; Any other form is an application: (#%app f arg ...), where
            ;; #%app has the scopes of the form (spec 5.3).
            (when (and (identifier? head) (== (syntax-e head) (sym #%app)))
              (if (!= m 0)
                  (fail-at s "#%app is bound here, but not to a macro or the core form" nil)
                  (unbound head (sym #%app) phase)))
            (expand-expr (syntax-rewrap s (cons (implicit-id s (sym #%app)) e)) phase)]))]
      [(null? e) (fail-at s "empty form ()" nil)]
      [(literal? e)
       ;; A literal is (#%datum literal), where #%datum has the scopes of the
       ;; literal (spec 5.4).
       (let* ([id (implicit-id s (sym #%datum))] [m (meaning-of id phase)])
         (if (and (!= m 0) (== (car m) (sym core)))
             (datum-out s s)
             (fail-at s "the literal ~s needs #%datum, which is ~a here"
                      `(,(syntax->datum s) ,(if (!= m 0) `"not a macro or the core form" `"unbound")))))]
      [(keyword? e) (fail-at s "~s: keyword misused as an expression" (list1 e))]
      [else (fail-at s "~s is not an expression" (list1 (syntax->datum s)))])))

(define (literal? [e datum]) -> i32 (or (integer? e) (flonum? e) (char? e) (boolean? e) (string? e)))

;; The identifier name with the scopes and srcloc of s: the implicit #%app
;; of a form or #%datum of a literal.
(define (implicit-id [s datum] [name datum]) -> datum (datum->syntax s name s))

;; The core #%datum: an unquoted literal is a wasm number (spec 5.4).
;; Checks the literal, and gives its lowered form.
(define (core-datum [s datum]) -> datum
  (let ([e (syntax-e s)])
    (cond [(integer? e) `(int ,e)]
          [(flonum? e) `(float ,e)]
          [(char? e) `(int ,(make-integer (char->integer e)))]
          [(== e (boolean 1)) `(const i32 1)]
          [(== e 0) `(const i32 0)]
          [(string? e)
           (fail-at s "a string is not a wasm value: use (data name offset \"...\") for bytes, or '\"...\" for a kernel string" nil)]
          [else (fail-at s "~s is not a literal" (list1 (syntax->datum s)))])))

;; (#%datum literal), the form where.
(define (datum-out [where datum] [literal datum]) -> datum
  (let ([d (core-datum literal)])
    (if to-syntax (out where (sym #%datum) (list1 literal)) (at where d))))

;; The core #%app: (#%app f arg ...) calls the function f, or is its body
;; if f is inline (inline-call); with any other head, an expression, it
;; applies a function value, a closure the compiler calls (spec 5.3).
(define (core-app [s datum] [f datum] [args datum] [phase i32]) -> datum
  (let* ([m (if (identifier? f) (meaning-of f phase) 0)]
         [info (if (and (!= m 0) (== (car m) (sym func))) (cadr m) 0)]
         [h (if (!= info 0) f (expand-expr f phase))]
         [a (map (lambda ([e datum]) -> datum (expand-expr e phase)) args)])
    (cond [to-syntax (out s (sym #%app) (cons h a))]
          [(!= info 0) (at s (let ([inlined (inline-call info a)]) (if (!= inlined 0) inlined `(call ,info ,a))))]
          [else (set! lowered-closures 1) (at s `(apply-value ,h ,a))])))

;; A numeric or memory instruction: (args . offset), its arguments and a
;; trailing literal offset if it has one, else #f.
(define (prim-args [name datum] [s datum]) -> datum
  (let* ([p (lookup-prim name)]
         [args (let ([l (syntax->list (cdr (syntax-e s)))]) (if (== l 0) (fail-at s "bad syntax" nil) l))]
         [n (length (-> p params))])
    (cond [(== (length args) n) (cons args 0)]
          [(and (== (-> p kind) (sym mem)) (== (length args) (+ n 1))
                (let ([off (syntax-e (list-ref args n))]) (and (integer? off) (>= (integer-value off) 0) (< (integer-value off) 1073741824))))
           (cons (take args n) (list-ref args n))]
          [else (fail-at s "~a takes ~a argument~a~a, got ~a"
                         `(,name ,(make-integer n) ,(if (== n 1) `"" `"s")
                           ,(if (== (-> p kind) (sym mem)) `" and an optional offset" `"")
                           ,(make-integer (length args))))])))

(define (expand-prim [name datum] [s datum] [phase i32]) -> datum
  (let* ([ao (prim-args name s)] [args (map (lambda ([a datum]) -> datum (expand-expr a phase)) (car ao))])
    (if to-syntax
        (out s name (append args (if (!= (cdr ao) 0) (list1 (cdr ao)) nil)))
        (at s `(prim ,name ,(if (!= (cdr ao) 0) (syntax-e (cdr ao)) 0) ,args)))))

(define (data-info-of [id datum] [phase i32]) -> datum
  (let ([m (if (identifier? id) (meaning-of id phase) 0)])
    (unless (and (!= m 0) (== (car m) (sym data))) (fail-at id "~s is not data" (list1 (syntax->datum id))))
    (cadr m)))

;; The declared type id names, which must be a struct or array type, as
;; kind says.
(define (kind-type-of [id datum] [kind datum] [phase i32]) -> datum
  (let ([t (type-of id phase)])
    (unless (== (type-info-kind t) kind)
      (fail-at id "~a is not a~a type" `(,(type-info-name t) ,(if (== kind (sym struct)) `" struct" `"n array"))))
    t))

;; GC form s: (op immediate ... arg ...). Immediates are types, fields and
;; reference types. Checks s and returns (immediates . arguments), the
;; immediates resolved.
(define (gc-parts [name datum] [s datum] [phase i32]) -> datum
  (let* ([l (syntax->list s)] [n (length l)] [text (lambda ([form (ptr u8)]) -> datum (no-match s form))])
    (case name
      [((sym struct.new))
       (if (>= n 2) (cons (list1 (kind-type-of (cadr l) (sym struct) phase)) (cddr l)) (text "(struct.new type arg ...)"))]
      [((sym array.new_fixed))
       (if (>= n 2) (cons (list1 (kind-type-of (cadr l) (sym array) phase)) (cddr l)) (text "(array.new_fixed type arg ...)"))]
      [((sym struct.get) (sym struct.get_s) (sym struct.get_u))
       (if (== n 4)
           (let ([t (type-of (cadr l) phase)]) (cons `(,t ,(field-index t (caddr l))) (list1 (cadddr l))))
           (no-match s (format-string "(~a type field ref)" name)))]
      [((sym struct.set))
       (if (== n 5)
           (let ([t (type-of (cadr l) phase)]) (cons `(,t ,(field-index t (caddr l))) `(,(cadddr l) ,(list-ref l 4))))
           (text "(struct.set type field ref value)"))]
      [((sym array.new))
       (if (== n 4) (cons (list1 (kind-type-of (cadr l) (sym array) phase)) (cddr l)) (text "(array.new type value size)"))]
      [((sym array.new_default))
       (if (== n 3) (cons (list1 (kind-type-of (cadr l) (sym array) phase)) (cddr l)) (text "(array.new_default type size)"))]
      [((sym array.get) (sym array.get_s) (sym array.get_u))
       (if (== n 4) (cons (list1 (kind-type-of (cadr l) (sym array) phase)) (cddr l)) (no-match s (format-string "(~a type ref index)" name)))]
      [((sym array.set))
       (if (== n 5) (cons (list1 (kind-type-of (cadr l) (sym array) phase)) (cddr l)) (text "(array.set type ref index value)"))]
      [((sym array.fill))
       (if (== n 6) (cons (list1 (kind-type-of (cadr l) (sym array) phase)) (cddr l)) (text "(array.fill type ref index value size)"))]
      [((sym array.copy))
       (if (== n 8)
           (cons `(,(type-of (cadr l) phase) ,(type-of (caddr l) phase)) (cdddr l))
           (text "(array.copy dst-type src-type dst dst-index src src-index size)"))]
      [((sym ref.null)) (if (== n 2) (cons (list1 (parse-heap (cadr l) phase)) nil) (text "(ref.null heap)"))]
      [((sym ref.test) (sym ref.cast))
       (if (== n 3) (cons (list1 (parse-reftype (cadr l) phase)) (cddr l)) (no-match s (format-string "(~a type ref)" name)))]
      [((sym ref.eq)) (if (== n 3) (cons nil (cdr l)) (text "(ref.eq a b)"))]
      [else (if (== n 2) (cons nil (cdr l)) (no-match s (format-string "(~a ref)" name)))])))

;; format-message's template with one ~a, as a C string for a message.
(define (format-string [template (ptr u8)] [x datum]) -> (ptr u8)
  (let* ([s (format-message template (list1 x))] [b (make-buffer)])
    (buffer-add! (& b) (string-bytes s) (string-length s))
    (buffer-add-byte! (& b) 0)
    (-> b bytes)))

;; parts of GC form (name immediate ... arg ...) with the type immediates
;; expanded (spec 5.1).
(define (expand-gc-immediates [name datum] [parts datum] [phase i32]) -> datum
  (let ([n (cond [(!= (memq name `(ref.null ref.test ref.cast)) 0) 1]
                 [(== name (sym array.copy)) 2]
                 [(!= (memq name `(ref.eq array.len ref.is_null ref.as_non_null ref.i31 i31.get_s i31.get_u)) 0) 0]
                 [else 1])])
    (if (< (length parts) (+ n 1))
        parts
        (cons (car parts)
              (append (map (lambda ([t datum]) -> datum
                             (if (!= (memq name `(ref.test ref.cast)) 0) (expand-type t phase) (expand-type-name t phase)))
                           (take (cdr parts) n))
                      (list-tail (cdr parts) n))))))

(define (expand-gc [name datum] [s datum] [phase i32]) -> datum
  (let* ([parts (expand-gc-immediates name (let ([l (syntax->list s)]) (if (== l 0) (fail-at s "bad ~a syntax" (list1 name)) l)) phase)]
         [ia (gc-parts name (syntax-rewrap s parts) phase)]
         [args (map (lambda ([a datum]) -> datum (expand-expr a phase)) (cdr ia))])
    (if to-syntax
        (out s name (append (take (cdr parts) (- (length (cdr parts)) (length args))) args))
        (at s `(gc ,name ,(car ia) ,args)))))

(define (expand-core [name datum] [s datum] [phase i32]) -> datum
  (let* ([l (syntax->list s)] [n (if (== l 0) -1 (cast i32 (length l)))]
         [ex (lambda ([x datum]) -> datum (expand-expr x phase))])
    (case name
      [((sym #%app))
       (when (< n 2) (no-match s "(#%app f arg ...)"))
       (core-app s (cadr l) (cddr l) phase)]
      [((sym #%datum))
       (unless (== n 2) (no-match s "(#%datum literal)"))
       (datum-out s (cadr l))]
      [((sym closure)) (fail-at s "closure is a type, (ref (closure (type ... -> type ...))), not an expression" nil)]
      [((sym quote))
       (unless (== n 2) (no-match s "(quote datum)"))
       (if to-syntax (out s name (list1 (cadr l))) (at s `(quote ,(syntax->datum (cadr l)))))]
      [((sym quote-syntax))
       (unless (== n 2) (no-match s "(quote-syntax datum)"))
       (let ([d (prune-local-scopes (cadr l))]) (if to-syntax (out s name (list1 d)) (at s `(quote ,d))))]
      ;; A quasi form is calls of the kernel module (quasi), expanded.
      [((sym quasiquote))
       (unless (== n 2) (no-match s "(quasiquote template)"))
       (ex (quasi s (cadr l) 0 phase (sym quasiquote) (sym unquote) (sym unquote-splicing) 0))]
      [((sym quasisyntax))
       (unless (== n 2) (no-match s "(quasisyntax template)"))
       (ex (quasi s (cadr l) 0 phase (sym quasisyntax) (sym unsyntax) (sym unsyntax-splicing) 1))]
      [((sym unquote) (sym unquote-splicing) (sym unsyntax) (sym unsyntax-splicing))
       (fail-at s "~a is not inside a quasi form" (list1 name))]
      [((sym data-address) (sym data-size))
       (unless (== n 2) (no-match s (format-string "(~a data)" name)))
       (let ([info (data-info-of (cadr l) phase)])
         (if to-syntax
             (out s name (list1 (cadr l)))
             (at s `(const i32 ,(if (== name (sym data-address))
                                    (data-info-offset info)
                                    (make-integer (string-length (data-info-bytes info))))))))]
      ;; wasm's constants: a literal of that type, whatever #%datum means
      ;; here (spec 5.3).
      [((sym i32.const) (sym i64.const) (sym f32.const) (sym f64.const))
       (unless (== n 2) (no-match s (format-string "(~a literal)" name)))
       (let ([v (const-literal name (cadr l))])
         (if to-syntax
             (out s name (list1 (cadr l)))
             (at s `(as (,(const-type name)) ,(if (integer? v) `(int ,v) `(float ,v))))))]
      [((sym set!))
       (unless (and (== n 3) (identifier? (cadr l))) (no-match s "(set! x value)"))
       (let* ([x (cadr l)] [m (meaning-of x phase)])
         (unless (and (!= m 0) (!= (memq (car m) `(local global)) 0))
           (fail-at x "set!: ~a is not a variable" (list1 (syntax-e x))))
         (let ([v (ex (caddr l))])
           (cond [to-syntax (out s name `(,(with-local-binding x (if (== (car m) (sym local)) (cadr m) 0)) ,v))]
                 [(== (car m) (sym local)) (at s `(lset ,(cadr m) ,v))]
                 [else (at s `(gset ,(cadr m) ,v))])))]
      [((sym let) (sym let*))
       (unless (and (>= n 2) (syntax? (cadr l)) (!= (syntax->list (cadr l)) 0)) (no-match s (format-string "(~a (binding ...) body ...)" name)))
       (let ([bs (map (lambda ([b datum]) -> datum (let-binding b phase)) (syntax->list (cadr l)))] [body (cddr l)])
         (if (== name (sym let))
             (let* ([inits (map (lambda ([bp datum]) -> datum (expand-expr (let-init bp) phase)) bs)]
                    [sc (new-local-scope!)]
                    [xs (map (lambda ([bp datum]) -> datum (add-scope (car bp) sc)) bs)]
                    [keys (map (lambda ([x datum]) -> datum (bind-local! x phase)) xs)])
               (let-out s (cadr l) bs xs keys inits (map (lambda ([x datum]) -> datum (expand-expr (add-scope x sc) phase)) body)))
             (expand-let* s bs body phase)))]
      ;; (lambda ([x t] ...) [-> r] body ...): a function that uses the
      ;; locals around it, a closure the compiler makes (spec 5.3). It
      ;; cannot branch to the labels around it.
      [((sym lambda))
       (unless (and (>= n 2) (syntax? (cadr l)) (!= (syntax->list (cadr l)) 0)) (no-match s "(lambda (p ...) . rest)"))
       (let* ([ps (cadr l)] [rest (cddr l)]
              [params (map (lambda ([x datum]) -> datum (param-of x phase)) (syntax->list ps))]
              [types (map (lambda ([pp datum]) -> datum (parse-type (cadr pp) phase)) params)]
              [arrow (arrow-of rest phase)]
              [results (car (parse-results arrow phase))]
              [body (list-tail rest (length arrow))]
              [sc (new-local-scope!)]
              [xs (map (lambda ([pp datum]) -> datum (add-scope (car pp) sc)) params)]
              [keys (map (lambda ([x datum]) -> datum (bind-local! x phase)) xs)]
              [saved current-function]
              [b datum 0])
         (set! current-function (list1 s))
         (set! b (map (lambda ([x datum]) -> datum (expand-expr (add-scope x sc) phase)) body))
         (set! current-function saved)
         (if to-syntax
             (let ([outs nil] [x xs] [k keys] [pp params])
               (while (pair? x)
                 (set! outs (cons (out-list (car x) `(,(with-local-binding (car x) (car k)) ,(cadr (car pp)))) outs))
                 (set! x (cdr x)) (set! k (cdr k)) (set! pp (cdr pp)))
               (out s name (cons (out-list ps (reverse outs)) (append arrow b))))
             (let ([pts nil] [k keys] [t types])
               (while (pair? k)
                 (set! pts (cons (cons (car k) (car t)) pts))
                 (set! k (cdr k)) (set! t (cdr t)))
               (set! lowered-closures 1)
               (at s `(lambda ,(fresh-key!) ,(reverse pts) ,results ,(seq-at s b))))))]
      [((sym begin))
       (when (< n 1) (no-match s "(begin e ...)"))
       (let ([es (map ex (cdr l))]) (if to-syntax (out s name es) (at s (cons (sym seq) es))))]
      [((sym if))
       (cond [(== n 3)
              (let* ([c (ex (cadr l))] [t (ex (caddr l))]) (if to-syntax (out s name `(,c ,t)) (at s `(if ,c ,t #f))))]
             [(== n 4)
              (let* ([c (ex (cadr l))] [t (ex (caddr l))] [e (ex (cadddr l))])
                (if to-syntax (out s name `(,c ,t ,e)) (at s `(if ,c ,t ,e))))]
             [else (no-match s "(if test then) or (if test then otherwise)")])]
      [((sym block) (sym loop))
       (unless (and (>= n 2) (identifier? (cadr l))) (no-match s (format-string "(~a label body ...)" name)))
       (let* ([sc (new-local-scope!)] [label (add-scope (cadr l) sc)] [key (fresh-label! label phase)]
              [b (map (lambda ([x datum]) -> datum (expand-expr (add-scope x sc) phase)) (cddr l))])
         (if to-syntax (out s name (cons label b)) (at s `(,name ,key ,(seq-at s b)))))]
      [((sym br))
       (cond [(== n 2)
              (let ([key (label-here (cadr l) phase)]) (if to-syntax (out s name (list1 (cadr l))) (at s `(br ,key #f))))]
             [(== n 3)
              (let* ([key (label-here (cadr l) phase)] [v (ex (caddr l))])
                (if to-syntax (out s name `(,(cadr l) ,v)) (at s `(br ,key ,v))))]
             [else (no-match s "(br label) or (br label value)")])]
      [((sym br-if))
       (unless (== n 3) (no-match s "(br-if label test)"))
       (let* ([key (label-here (cadr l) phase)] [c (ex (caddr l))])
         (if to-syntax (out s name `(,(cadr l) ,c)) (at s `(br-if ,key ,c))))]
      [((sym return))
       (cond [(== n 1) (if to-syntax (out s name nil) (at s `(return #f)))]
             [(== n 2) (let ([v (ex (cadr l))]) (if to-syntax (out s name (list1 v)) (at s `(return ,v))))]
             [else (no-match s "(return) or (return value)")])]
      [((sym call-indirect))
       (unless (>= n 3) (no-match s "(call-indirect signature index arg ...)"))
       (let* ([sig (expand-signature (cadr l) phase)] [pr (parse-signature sig phase)] [i (ex (caddr l))] [a (map ex (cdddr l))])
         (if to-syntax (out s name (cons sig (cons i a))) (at s `(call-indirect ,(car pr) ,(cdr pr) ,i ,a))))]
      ;; (ref.func f): a reference to f, at its declared function type.
      [((sym ref.func))
       (unless (and (== n 2) (identifier? (cadr l))) (no-match s "(ref.func f)"))
       (let* ([f (cadr l)] [m (meaning-of f phase)])
         (unless (and (!= m 0) (== (car m) (sym func))) (fail-at f "ref.func: ~a is not a function" (list1 (syntax-e f))))
         (when (== (func-info-type (cadr m)) 0)
           (fail-at f "ref.func: ~a has no declared function type; give it one with (type T)" (list1 (syntax-e f))))
         (if to-syntax (out s name (list1 f)) (at s `(ref-func ,(cadr m)))))]
      ;; (call-ref T f arg ...): call f, a (ref null T), with the args.
      [((sym call-ref))
       (unless (>= n 3) (no-match s "(call-ref type f arg ...)"))
       (let* ([tname (expand-type-name (cadr l) phase)] [t (type-of tname phase)])
         (unless (func-type? t) (fail-at (cadr l) "call-ref: ~a is not a function type" (list1 (type-info-name t))))
         (let ([h (ex (caddr l))] [a (map ex (cdddr l))])
           (if to-syntax (out s name (cons tname (cons h a))) (at s `(call-ref ,t ,h ,a)))))]
      [((sym func-index))
       (unless (and (== n 2) (identifier? (cadr l))) (no-match s "(func-index f)"))
       (let* ([f (cadr l)] [m (meaning-of f phase)])
         (unless (and (!= m 0) (== (car m) (sym func))) (fail-at f "func-index: ~a is not a function" (list1 (syntax-e f))))
         (if to-syntax (out s name (list1 f)) (at s `(func-index ,(cadr m)))))]
      [((sym select))
       (unless (== n 4) (no-match s "(select a b test)"))
       (let* ([x (ex (cadr l))] [y (ex (caddr l))] [c (ex (cadddr l))])
         (if to-syntax (out s name `(,x ,y ,c)) (at s `(select ,x ,y ,c))))]
      [((sym drop))
       (unless (== n 2) (no-match s "(drop value)"))
       (let ([v (ex (cadr l))]) (if to-syntax (out s name (list1 v)) (at s `(drop ,v))))]
      [((sym unreachable) (sym nop))
       (unless (== n 1) (no-match s (format-string "(~a)" name)))
       (if to-syntax (out s name nil) (at s (list1 name)))]
      ;; (throw tag arg ...): throw an exception of tag, carrying the args.
      [((sym throw))
       (unless (>= n 2) (no-match s "(throw tag arg ...)"))
       (let* ([info (tag-info-of (cadr l) phase)] [a (map ex (cddr l))])
         (if to-syntax (out s name (cons (cadr l) a)) (at s `(throw ,info ,a))))]
      [((sym throw-ref))
       (unless (== n 2) (no-match s "(throw-ref exn)"))
       (let ([v (ex (cadr l))]) (if to-syntax (out s name (list1 v)) (at s `(throw-ref ,v))))]
      ;; (try (clause ...) body ...): body, with the exceptions the clauses
      ;; catch handled by them (spec 5.3).
      [((sym try))
       (unless (and (>= n 2) (syntax? (cadr l)) (!= (syntax->list (cadr l)) 0)) (no-match s "(try (clause ...) body ...)"))
       (let* ([cs (map (lambda ([c datum]) -> datum (expand-catch c phase)) (syntax->list (cadr l)))] [b (map ex (cddr l))])
         (if to-syntax (out s name (cons (out-list (cadr l) cs) b)) (at s `(try ,cs ,(seq-at s b)))))]
      [else
       (if (!= (memq name gc-forms) 0)
           (expand-gc name s phase)
           (fail-at s "~a is only allowed at module level" (list1 name)))])))

;; The literal of constant form (name n): a number, and an integer for
;; i32.const and i64.const.
(define (const-literal [name datum] [s datum]) -> datum
  (let ([n (syntax-e s)] [integer (or (== name (sym i32.const)) (== name (sym i64.const)))])
    (unless (if integer (integer? n) (or (integer? n) (flonum? n)))
      (fail-at s "~a takes a literal ~a" `(,name ,(if integer `"integer" `"number"))))
    n))

(define (const-type [name datum]) -> datum
  (case name [((sym i32.const)) (sym i32)] [((sym i64.const)) (sym i64)] [((sym f32.const)) (sym f32)] [else (sym f64)]))

;; The parts of try clause c, [catch tag (x ...) body ...], [catch-ref tag
;; (x ... e) body ...], [catch-all body ...] or [catch-all-ref (e) body
;; ...], whose first word is compared by name: (kind tag-or-#f
;; variables-or-#f body). The variables are bound to the exception's
;; values, then, for the -ref kinds, to the exception itself.
(define (catch-parts [c datum]) -> datum
  (let* ([l (syntax->list c)] [n (if (== l 0) 0 (length l))]
         [ids? (lambda ([v datum] [least u32]) -> i32
                 (let ([vl (syntax->list v)])
                   (and (syntax? v) (!= vl 0) (>= (length vl) least) (andmap (lambda ([x datum]) -> i32 (identifier? x)) vl))))])
    (cond [(and (>= n 3) (named? (car l) (sym catch)) (ids? (caddr l) 0)) `(catch ,(cadr l) ,(caddr l) ,(cdddr l))]
          [(and (>= n 3) (named? (car l) (sym catch-ref)) (ids? (caddr l) 1)) `(catch-ref ,(cadr l) ,(caddr l) ,(cdddr l))]
          [(and (>= n 1) (named? (car l) (sym catch-all))) `(catch-all #f #f ,(cdr l))]
          [(and (>= n 2) (named? (car l) (sym catch-all-ref)) (ids? (cadr l) 1) (== (length (syntax->list (cadr l))) 1))
           `(catch-all-ref #f ,(cadr l) ,(cddr l))]
          [else (no-match c "(catch tag (x ...) body ...), (catch-ref tag (x ... e) body ...), (catch-all body ...) or (catch-all-ref (e) body ...)")])))

;; Try clause c, its variables bound and its body expanded: fully
;; expanded, or lowered as (kind tag-info-or-#f keys body).
(define (expand-catch [c datum] [phase i32]) -> datum
  (let* ([p (catch-parts c)] [kind (car p)] [tag (cadr p)] [vars (caddr p)] [body (cadddr p)]
         [xs (if (!= vars 0) (syntax->list vars) nil)]
         [info (if (!= tag 0) (tag-info-of tag phase) 0)]
         [n (+ (if (!= info 0) (length (tag-info-params info)) 0)
               (if (!= (memq kind `(catch-ref catch-all-ref)) 0) 1 0))]
         [sc (new-local-scope!)])
    (unless (== (length xs) n)
      (fail-at vars "this clause binds ~a variable~a, not ~a" `(,(make-integer n) ,(if (== n 1) `"" `"s") ,(make-integer (length xs)))))
    (let* ([scoped (map (lambda ([x datum]) -> datum (add-scope x sc)) xs)]
           [keys (map (lambda ([x datum]) -> datum (bind-local! x phase)) scoped)]
           [b (map (lambda ([x datum]) -> datum (expand-expr (add-scope x sc) phase)) body)])
      (if to-syntax
          (let ([bound nil] [x scoped] [k keys])
            (while (pair? x)
              (set! bound (cons (with-local-binding (car x) (car k)) bound))
              (set! x (cdr x)) (set! k (cdr k)))
            (out-list c `(,(core-id kind (car (syntax->list c)))
                          ,@(if (!= tag 0) (list1 tag) nil)
                          ,@(if (!= vars 0) (list1 (out-list vars (reverse bound))) nil)
                          ,@b)))
          `(,kind ,info ,keys ,(seq-at c b))))))

;; A let binding [x init] or [x type init], as (x type-syntax type init),
;; the type expanded and parsed, or #f and #f without one.
(define (let-binding [b datum] [phase i32]) -> datum
  (let ([l (syntax->list b)])
    (cond [(and (!= l 0) (== (length l) 2) (identifier? (car l))) `(,(car l) #f #f ,(cadr l))]
          [(and (!= l 0) (== (length l) 3) (identifier? (car l)))
           (let ([t (expand-type (cadr l) phase)]) `(,(car l) ,t ,(parse-type t phase) ,(caddr l)))]
          [else (no-match b "(name init) or (name type init)")])))

(define (let-init [bp datum]) -> datum (cadddr bp))

;; The let, the form s whose binding list is bindings, of bindings bs,
;; bound as the identifiers xs with the keys, to inits, around body.
(define (let-out [s datum] [bindings datum] [bs datum] [xs datum] [keys datum] [inits datum] [body datum]) -> datum
  (let ([outs nil])
    (while (pair? bs)
      (let* ([bp (car bs)] [x (car xs)] [key (car keys)] [init (car inits)])
        (set! outs (cons (if to-syntax
                             (let ([x (with-local-binding x key)])
                               (out-list (car bp) (if (!= (cadr bp) 0) `(,x ,(cadr bp) ,init) `(,x ,init))))
                             `(,key ,(caddr bp) ,init ,(syntax-e (car bp))))
                         outs)))
      (set! bs (cdr bs)) (set! xs (cdr xs)) (set! keys (cdr keys)) (set! inits (cdr inits)))
    (if to-syntax
        (out s (sym let) (cons (out-list bindings (reverse outs)) body))
        (at s `(let ,(reverse outs) ,(seq-at s body))))))

;; (let* (b ...) body ...) as nested lets, one binding each.
(define (expand-let* [s datum] [bs datum] [body datum] [phase i32]) -> datum
  (if (null? bs)
      (let-out s s nil nil nil nil (map (lambda ([x datum]) -> datum (expand-expr x phase)) body))
      (let* ([bp (car bs)]
             [init (expand-expr (let-init bp) phase)]
             [sc (new-local-scope!)]
             [x (add-scope (car bp) sc)]
             [key (bind-local! x phase)]
             [later (map (lambda ([b datum]) -> datum `(,(add-scope (car b) sc) ,(cadr b) ,(caddr b) ,(add-scope (let-init b) sc)))
                         (cdr bs))]
             [body (map (lambda ([y datum]) -> datum (add-scope y sc)) body)])
        (let-out s s (list1 bp) (list1 x) (list1 key) (list1 init)
                 (if (null? later) (map (lambda ([y datum]) -> datum (expand-expr y phase)) body) (list1 (expand-let* s later body phase)))))))

;; A local variable with id's name and scopes already is one the same form
;; binds: an error, rather than ambiguous uses.
(define (bind-local! [id datum] [phase i32]) -> datum
  (let ([b (bindings-under (syntax-e id) (binding-slot (syntax-scopes id)))])
    (while (!= b 0)
      (when (and (== (-> b phase) phase) (== (-> b scopes) (syntax-scopes id))
                 (pair? (-> b meaning)) (== (car (-> b meaning)) (sym local)))
        (fail-at id "~a is bound twice" (list1 (syntax-e id))))
      (set! b (-> b next))))
  (let ([b (bind! id phase 0)])
    (set! (-> b meaning) (keep `(local ,(-> b key))))
    (-> b key)))

;; id, recording that it binds or refers to the local variable with key,
;; or, key #f, that it refers to none: in fully expanded code an
;; identifier has the property if and only if it is a local variable's,
;; whatever properties a macro copied onto it (syntax-rewrap).
(define (with-local-binding [id datum] [key datum]) -> datum
  (if (or (!= key 0) (!= (syntax-property id (sym %local-binding)) 0))
      (syntax-property-set id (sym %local-binding) key)
      id))

;; The function or lambda whose body is being expanded, as a unique list,
;; or #f; and label key -> the one it was bound in. A branch must stay in
;; its function.
(define current-function datum 0)
(define label-functions hash-table)

(define (fresh-label! [id datum] [phase i32]) -> datum
  (let* ([b (bind! id phase 0)] [key (-> b key)])
    (set! (-> b meaning) (keep `(label ,key)))
    (hash-set! (& label-functions) (cast u64 (integer-value key)) (cast u32 (if (== current-function 0) 1 (cast u32 current-function))))
    key))

;; The key of label id, which must be a label of the function being
;; expanded: a lambda cannot branch to the labels around it.
(define (label-here [id datum] [phase i32]) -> datum
  (let ([key (label-key-of id phase)] [function (if (== current-function 0) 1 (cast u32 current-function))])
    (unless (== (hash-ref (& label-functions) (cast u64 (integer-value key))) function)
      (fail-at id "~a is a label of the function around this lambda, which a lambda cannot branch to" (list1 (syntax-e id))))
    key))

(define (label-key-of [id datum] [phase i32]) -> datum
  (let ([m (if (identifier? id) (meaning-of id phase) 0)])
    (unless (and (!= m 0) (== (car m) (sym label))) (fail-at id "~s is not a label" (list1 (syntax->datum id))))
    (cadr m)))

;; ==== quasiquote / quasisyntax ====
;;
;; One walker for both. The result is code that calls the kernel module,
;; in core forms with the unquoted expressions as written, for expand-expr
;; to expand. For quasisyntax, unchanged subtemplates become syntax
;; constants and changed lists are rewrapped with the template's own
;; scopes and srcloc (syntax-rewrap).

;; What a quasi form is: where it is, its phase, its names for itself, for
;; unquote and for unquote-splicing, and whether it is quasisyntax.
(struct quasi-form [where datum] [phase i32] [qname datum] [uname datum] [sname datum] [syntax i32])

(define (quasi [where datum] [t datum] [depth i32] [phase i32] [qname datum] [uname datum] [sname datum] [syntax i32]) -> datum
  (let ([q quasi-form])
    (set! (-> q where) where)
    (set! (-> q phase) phase)
    (set! (-> q qname) qname)
    (set! (-> q uname) uname)
    (set! (-> q sname) sname)
    (set! (-> q syntax) syntax)
    (quasi-walk (& q) t depth)))

(define (tagged? [q (ptr quasi-form)] [x datum] [name datum]) -> i32
  (let ([l (syntax->list x)])
    (and (!= l 0) (== (length l) 2) (core-id? (car l) name (-> q phase)))))

(define (changes? [q (ptr quasi-form)] [x datum] [depth i32]) -> i32
  (cond [(or (tagged? q x (-> q uname)) (tagged? q x (-> q sname)))
         (or (== depth 0) (changes? q (cadr (syntax->list x)) (- depth 1)))]
        [(tagged? q x (-> q qname)) (changes? q (cadr (syntax->list x)) (+ depth 1))]
        [(and (syntax? x) (pair? (syntax-e x)))
         (let ([e (syntax-e x)])
           (while (pair? e)
             (when (changes? q (car e) depth) (return 1))
             (set! e (cdr e)))
           (and (syntax? e) (changes? q e depth)))]
        [else 0]))

(define (quasi-call [q (ptr quasi-form)] [name datum] [args datum]) -> datum
  (out (-> q where) (sym #%app) (cons (kernel-id name) args)))

(define (quasi-constant [q (ptr quasi-form)] [x datum]) -> datum
  (if (-> q syntax) (out x (sym quote-syntax) (list1 (prune-local-scopes x))) (out x (sym quote) (list1 x))))

;; Rebuild the pair chain e (elements of template x) as an expression.
(define (quasi-list [q (ptr quasi-form)] [x datum] [e datum] [depth i32]) -> datum
  (cond [(null? e) (out x (sym quote) (list1 (make-syntax nil no-scopes 0 nil)))]
        [(syntax? e) (quasi-walk q e depth)]
        [(and (== depth 0) (tagged? q (car e) (-> q sname)))
         (let ([v (cadr (syntax->list (car e)))])
           (quasi-call q (sym append) `(,(if (-> q syntax) (quasi-call q (sym splice-list) (list1 v)) v) ,(quasi-list q x (cdr e) depth))))]
        [else (quasi-call q (sym cons) `(,(quasi-walk q (car e) depth) ,(quasi-list q x (cdr e) depth)))]))

(define (quasi-walk [q (ptr quasi-form)] [x datum] [depth i32]) -> datum
  (cond [(not (changes? q x depth)) (quasi-constant q x)]
        [(and (tagged? q x (-> q uname)) (== depth 0)) (cadr (syntax->list x))]
        [(pair? (syntax-e x))
         (let* ([l (syntax-e x)]
                [unq (or (tagged? q x (-> q uname)) (tagged? q x (-> q sname)))]
                [inner-depth (cond [unq (- depth 1)] [(tagged? q x (-> q qname)) (+ depth 1)] [else depth])]
                [head (if (or unq (tagged? q x (-> q qname)))
                          (quasi-call q (sym cons) `(,(quasi-constant q (car l)) ,(quasi-list q x (cdr l) inner-depth)))
                          (quasi-list q x l depth))])
           (if (-> q syntax) (quasi-call q (sym syntax-rewrap) `(,(quasi-constant q x) ,head)) head))]
        [else (quasi-constant q x)]))

;; ---- function values (spec 5.2) ----

;; A function declared with #:value g -> (g . phase), then g's info once
;; it is resolved: when the function's name is first expanded as an
;; expression, in the second pass, so the global may be declared after
;; the function, or lifted with it.
(define function-values hash-table)

(define (has-value? [info datum]) -> i32 (!= (hash-ref (& function-values) (cast u64 info)) 0))

;; The info of the global that is func info's value, or #f if info has
;; none.
(define (function-value [info datum]) -> datum
  (let ([v (cast datum (hash-ref (& function-values) (cast u64 info)))])
    (cond [(== v 0) 0]
          [(pair? v)
           (let ([m (meaning-of (car v) (cast i32 (integer-value (cdr v))))])
             (unless (and (!= m 0) (== (car m) (sym global)))
               (fail-at (car v) "#:value names ~a, which is not a global" (list1 (syntax-e (car v)))))
             (hash-set! (& function-values) (cast u64 info) (cast u32 (cadr m)))
             (cadr m))]
          [else v])))

;; ---- inline functions (spec 5.2) ----

;; The inline functions' bodies: info -> (params results body returns?
;; assigned), their parameters as (key . type), their result types, their
;; lowered bodies, whether each has a return, and the parameters the body
;; sets. Kept without source locations: an inlined call is at the call's.
(define inlines hash-table)

;; Check that the lowered body of inline function info, named by id, does
;; not depend on which module it is compiled in, and keep it.
(define (record-inline! [info datum] [params datum] [body datum] [id datum])
  (let ([returns (check-inline body id)])
    (hash-set! (& inlines) (cast u64 info)
               (cast u32 (keep `(,params ,(func-info-results info) ,(without-locations body) ,(boolean returns)
                                 ,(filter (lambda ([p datum]) -> i32 (assigns? body (car p))) params)))))))

(define (inline-fail [id datum] [what (ptr u8)]) -> i32
  (fail-at id "~a is inline, so it may not ~a" `(,(syntax-e id) ,(bytes->string what (strlen what))))
  0)

;; Check lowered form e of an inline body: 1 if it has a return.
(define (check-inline [e datum] [id datum]) -> i32
  (let ([check (lambda ([x datum]) -> i32 (check-inline x id))]
        [each (lambda ([l datum]) -> i32 (check-each l id))])
    (case (car e)
      [((sym at) (sym as) (sym lset) (sym gset)) (check (caddr e))]
      [((sym int) (sym float) (sym const) (sym lref) (sym gref) (sym ref-func) (sym unreachable) (sym nop)) 0]
      [((sym quote))
       (let ([d (cadr e)])
         (unless (or (and (integer? d) (>= (integer-value d) -1073741824) (< (integer-value d) 1073741824))
                     (boolean? d) (null? d) (symbol? d) (keyword? d))
           (inline-fail id "quote data other than fixnums, booleans, (), symbols and keywords"))
         0)]
      [((sym let))
       (let ([r (check-each (map (lambda ([b datum]) -> datum (caddr b)) (cadr e)) id)]) (or (check (caddr e)) r))]
      [((sym seq)) (each (cdr e))]
      [((sym if)) (let* ([a (check (cadr e))] [b (check (caddr e))] [c (if (!= (cadddr e) 0) (check (cadddr e)) 0)]) (or a b c))]
      [((sym block) (sym loop) (sym br-if)) (check (caddr e))]
      [((sym br)) (if (!= (caddr e) 0) (check (caddr e)) 0)]
      [((sym return)) (when (!= (cadr e) 0) (check (cadr e))) 1]
      [((sym call)) (each (caddr e))]
      [((sym prim))
       (when (or (== (-> (lookup-prim (cadr e)) kind) (sym mem))
                 (!= (memq (cadr e) `(memory.size memory.grow memory.copy memory.fill)) 0))
         (inline-fail id "use memory"))
       (each (cadddr e))]
      [((sym call-indirect) (sym func-index)) (inline-fail id "use a table")]
      [((sym call-ref)) (let ([a (check (caddr e))]) (or (each (cadddr e)) a))]
      [((sym gc)) (each (cadddr e))]
      [((sym select) (sym drop)) (each (cdr e))]
      [((sym throw)) (each (caddr e))]
      [((sym throw-ref)) (check (cadr e))]
      [((sym try))
       (let ([r (check-each (map (lambda ([c datum]) -> datum (cadddr c)) (cadr e)) id)]) (or (check (caddr e)) r))]
      [((sym lambda)) (check (list-ref e 4))]
      [((sym apply-value)) (let ([a (check (cadr e))]) (or (each (caddr e)) a))]
      [else (fail-at id "internal: lowered form ~a" (list1 (car e))) 0])))

;; check-inline of each of the forms in l, in order: 1 if one has a
;; return.
(define (check-each [l datum] [id datum]) -> i32
  (let ([returns 0])
    (while (pair? l)
      (when (check-inline (car l) id) (set! returns 1))
      (set! l (cdr l)))
    returns))

;; Whether lowered form e sets local key.
(define (assigns? [e datum] [key datum]) -> i32
  (cond [(not (pair? e)) 0]
        [(== (car e) (sym quote)) 0]
        [(and (== (car e) (sym lset)) (equal? (cadr e) key)) 1]
        [else (ormap (lambda ([x datum]) -> i32 (assigns? x key)) (cdr e))]))

;; e without the source locations around it.
(define (unlocated [e datum]) -> datum (if (== (car e) (sym at)) (unlocated (caddr e)) e))

;; Lowered form e without its source locations.
(define (without-locations [e datum]) -> datum
  (cond [(not (pair? e)) e]
        [(== (car e) (sym at)) (without-locations (caddr e))]
        [(== (car e) (sym quote)) e]
        [else (let ([head nil] [last datum 0] [l e])
                (while (pair? l)
                  (let ([p (list1 (without-locations (car l)))])
                    (if (== last 0) (set! head p) (set-cdr! last p))
                    (set! last p))
                  (set! l (cdr l)))
                (unless (== last 0) (set-cdr! last l))
                head)]))

;; A call of info with args, lowered, as info's body if it is inline and
;; takes that many arguments; #f otherwise.
(define (inline-call [info datum] [args datum]) -> datum
  (let ([b (cast datum (hash-ref (& inlines) (cast u64 info)))])
    (if (or (== b 0) (!= (length args) (length (car b))))
        0
        (let* ([keys (new-table)] [labels (new-table)]
               [ret (if (!= (cadddr b) 0) (fresh-key!) 0)]
               [bindings (inline-bindings (car b) args (list-ref b 4) (& keys))]
               [body (copy-inline (caddr b) (& keys) (& labels) ret)]
               [e `(let ,bindings ,body)])
          (hash-free! (& keys))
          (hash-free! (& labels))
          `(as ,(cadr b) ,(if (!= ret 0) `(block ,ret ,e) e))))))

(define (new-table) -> hash-table
  (let ([t hash-table])
    (memset (& t) 0 (sizeof hash-table))
    t))

;; The let bindings of an inlined call's parameters params to its arguments
;; args, recording each parameter's local in keys. A parameter the body
;; does not set, given a local that no later argument sets, is that local,
;; at the parameter's type, and needs no binding.
(define (inline-bindings [params datum] [args datum] [assigned datum] [keys (ptr hash-table)]) -> datum
  (if (null? params)
      nil
      (let* ([p (car params)] [a (unlocated (car args))])
        (if (and (== (car a) (sym lref)) (== (memq p assigned) 0)
                 (not (ormap (lambda ([later datum]) -> i32 (assigns? later (cadr a))) (cdr args))))
            (begin
              (hash-set! keys (cast u64 (integer-value (car p))) (cast u32 `(as (,(cdr p)) ,a)))
              (inline-bindings (cdr params) (cdr args) assigned keys))
            (let ([k (fresh-key!)])
              (hash-set! keys (cast u64 (integer-value (car p))) (cast u32 k))
              (cons `(,k ,(cdr p) ,(car args)) (inline-bindings (cdr params) (cdr args) assigned keys)))))))

;; The local or label key is copied as, made the first time.
(define (copied-key [table (ptr hash-table)] [key datum]) -> datum
  (let ([known (cast datum (hash-ref table (cast u64 (integer-value key))))])
    (if (!= known 0)
        known
        (let ([n (fresh-key!)])
          (hash-set! table (cast u64 (integer-value key)) (cast u32 n))
          n))))

;; The keys each of ks is copied as.
(define (copied-keys [ks datum] [table (ptr hash-table)]) -> datum
  (map (lambda ([k datum]) -> datum (copied-key table k)) ks))

;; Lowered form e of an inline body, for one inlined call: its locals and
;; labels new, and a return a br to label ret. A local that keys maps to a
;; form, a parameter given a local, reads that.
(define (copy-inline [e datum] [keys (ptr hash-table)] [labels (ptr hash-table)] [ret datum]) -> datum
  (let ([copy (lambda ([x datum]) -> datum (copy-inline x keys labels ret))]
        [copies (lambda ([l datum]) -> datum (copy-each l keys labels ret))]
        [copy? (lambda ([x datum]) -> datum (if (== x 0) 0 (copy-inline x keys labels ret)))])
    (case (car e)
      [((sym as)) `(as ,(cadr e) ,(copy (caddr e)))]
      [((sym int) (sym float) (sym const) (sym quote) (sym unreachable) (sym nop)) e]
      [((sym lref)) (let ([m (copied-key keys (cadr e))]) (if (pair? m) m `(lref ,m)))]
      [((sym lset)) `(lset ,(copied-key keys (cadr e)) ,(copy (caddr e)))]
      [((sym gref)) e]
      [((sym gset)) `(gset ,(cadr e) ,(copy (caddr e)))]
      [((sym let))
       `(let ,(map (lambda ([b datum]) -> datum (cons (copied-key keys (car b)) (cons (cadr b) (cons (copy-inline (caddr b) keys labels ret) (cdddr b)))))
                   (cadr e))
             ,(copy (caddr e)))]
      ;; A lambda copied has a key of its own, and its parameters new locals.
      [((sym lambda))
       (set! lowered-closures 1)
       `(lambda ,(fresh-key!) ,(map (lambda ([p datum]) -> datum (cons (copied-key keys (car p)) (cdr p))) (caddr e)) ,(cadddr e)
                ,(copy (list-ref e 4)))]
      [((sym apply-value)) `(apply-value ,(copy (cadr e)) ,(copies (caddr e)))]
      [((sym seq) (sym select) (sym drop)) (cons (car e) (copies (cdr e)))]
      [((sym if)) `(if ,(copy (cadr e)) ,(copy (caddr e)) ,(copy? (cadddr e)))]
      [((sym block) (sym loop)) `(,(car e) ,(copied-key labels (cadr e)) ,(copy (caddr e)))]
      [((sym br)) `(br ,(copied-key labels (cadr e)) ,(copy? (caddr e)))]
      [((sym br-if)) `(br-if ,(copied-key labels (cadr e)) ,(copy (caddr e)))]
      [((sym return)) `(br ,ret ,(copy? (cadr e)))]
      [((sym call)) `(call ,(cadr e) ,(copies (caddr e)))]
      [((sym ref-func)) e]
      [((sym prim)) `(prim ,(cadr e) ,(caddr e) ,(copies (cadddr e)))]
      [((sym call-ref)) `(call-ref ,(cadr e) ,(copy (caddr e)) ,(copies (cadddr e)))]
      [((sym gc)) `(gc ,(cadr e) ,(caddr e) ,(copies (cadddr e)))]
      [((sym throw)) `(throw ,(cadr e) ,(copies (caddr e)))]
      [((sym throw-ref)) `(throw-ref ,(copy (cadr e)))]
      [((sym try))
       `(try ,(map (lambda ([c datum]) -> datum
                     `(,(car c) ,(cadr c) ,(copied-keys (caddr c) keys)
                       ,(copy-inline (cadddr c) keys labels ret)))
                   (cadr e))
             ,(copy (caddr e)))]
      [else (fail-at 0 "internal: lowered form ~a" (list1 (car e)))])))

;; copy-inline of each form in l.
(define (copy-each [l datum] [keys (ptr hash-table)] [labels (ptr hash-table)] [ret datum]) -> datum
  (map (lambda ([x datum]) -> datum (copy-inline x keys labels ret)) l))

;; Keep inline function info's body code, of parameters params, named by
;; name.
(define (note-inline! [info datum] [params datum] [code datum] [name datum]) (record-inline! info params code name))
