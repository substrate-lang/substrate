;; Lifecycle: experimental. examples/c/runtime.sub as the new compiler
;; builds it (next/c): the C-like Lisp's allocator, arenas and memory
;; functions, written in it (lang.sub). The allocator is K&R's (The C Programming
;; Language, section 8.7), for blocks of more than 4 KiB: the free blocks
;; are a circular list in address order, from which malloc takes the first
;; that is large enough, and to which free gives a block back, joining it
;; to the free blocks on either side that it touches. When no block is
;; large enough, malloc takes more memory from sbrk, at least 8 KiB. Each
;; block starts with a header, and its size counts headers. A block of 4
;; KiB or less, once freed, is kept on a list of its own size, which
;; malloc takes it from again, whole: it is never joined to others, and
;; so free gives it back at once, where K&R's walks the list to its place.
;;
;; An arena gives out memory by moving a pointer past it, in chunks of 64
;; KiB or more from malloc, which arena-free frees all at once. (new a T)
;; is a new T in arena a.
;;
;; A buffer collects bytes, in memory from malloc that grows as they come.
;;
;; A hash table maps u64 keys to u32 values, none of either 0: an address,
;; or a hash of what a key stands for. Its slots are open addressed, a key
;; in the first free slot from where its hash puts it, and at most half
;; full, in memory from malloc.

(require-unqualified c "lang.sub")
(require print "../../lib/print.sub" write-bytes)

(provide malloc calloc realloc free memcpy memset memcmp strlen print-string arena make-arena arena-alloc arena-free new
         buffer make-buffer buffer-add! buffer-add-byte! buffer-add-string! buffer-free!
         hash-table hash-ref hash-set! hash-clear! hash-free!)

(memory from c)
(table from c)

(struct header [next (ptr header)] [size u32])

;; The list's own block, of size 0, and the block where the last search
;; ended, 0 until malloc first runs.
(define base header)
(define freep (ptr header) 0)

;; The freed blocks of at most small units, a list of each size in units,
;; linked through their headers.
(define small u32 512)
(define smalls (array (ptr header) 513))

(define (malloc [n u32]) -> (ptr void)
  (let ([units (+ (/ (+ n (sizeof header) -1) (sizeof header)) 1)] [prev freep])
    (when (and (<= units small) (!= (@ smalls units) 0))
      (let ([b (@ smalls units)])
        (set! (@ smalls units) (-> b next))
        (return (+ b 1))))
    (when (== prev 0)
      (set! (-> base next) (& base))
      (set! freep (& base))
      (set! prev freep))
    (let ([p (-> prev next)])
      (while 1
        (when (>= (-> p size) units)
          (if (== (-> p size) units)
              (set! (-> prev next) (-> p next))
              (begin
                (-= (-> p size) units)
                (+= p (-> p size))
                (set! (-> p size) units)))
          (set! freep prev)
          (return (+ p 1)))
        (when (== p freep)
          (set! p (more-memory units))
          (when (== p 0) (return 0)))
        (set! prev p)
        (set! p (-> p next))))
    0))

;; At least units more headers' worth of free memory, from sbrk: the free
;; block before them, or 0 if memory cannot grow.
(define (more-memory [units u32]) -> (ptr header)
  (let* ([n (if (< units 1024) 1024 units)] [p (cast (ptr header) (sbrk (* n (sizeof header))))])
    (if (== p 0)
        0
        (begin (set! (-> p size) n) (free-block p) freep))))

(define (free [block (ptr void)])
  (when (!= block 0)
    (let ([b (- (cast (ptr header) block) 1)])
      (if (<= (-> b size) small)
          (begin
            (set! (-> b next) (@ smalls (-> b size)))
            (set! (@ smalls (-> b size)) b))
          (free-block b)))))

;; Block b back on K&R's list.
(define (free-block [b (ptr header)])
  (let ([p freep])
    ;; p, the free block after which b goes: b is between p and the next,
    ;; or past the list's ends.
    (while (not (and (> b p) (< b (-> p next))))
      (when (and (>= p (-> p next)) (or (> b p) (< b (-> p next))))
        (break))
      (set! p (-> p next)))
    (if (== (+ b (-> b size)) (-> p next))
        (begin
          (+= (-> b size) (-> p next size))
          (set! (-> b next) (-> p next next)))
        (set! (-> b next) (-> p next)))
    (if (== (+ p (-> p size)) b)
        (begin
          (+= (-> p size) (-> b size))
          (set! (-> p next) (-> b next)))
        (set! (-> p next) b))
    (set! freep p)))

(define (calloc [count u32] [size u32]) -> (ptr void)
  (let ([p (malloc (* count size))])
    (when (!= p 0) (memset p 0 (* count size)))
    p))

;; A block of n bytes holding the first n of block's, which is freed.
(define (realloc [block (ptr void)] [n u32]) -> (ptr void)
  (if (== block 0)
      (malloc n)
      (let ([old (* (- (-> (- (cast (ptr header) block) 1) size) 1) (sizeof header))] [p (malloc n)])
        (when (!= p 0)
          (memcpy p block (if (< n old) n old))
          (free block))
        p)))

(define (memcpy [to (ptr void)] [from (ptr void)] [n u32]) -> (ptr void)
  (memory.copy to from n)
  to)

(define (memset [to (ptr void)] [byte i32] [n u32]) -> (ptr void)
  (memory.fill to byte n)
  to)

;; Less than 0, 0, or more than 0, as the first of the n bytes at a that
;; differs from b's is less or more, or none differs.
(define (memcmp [a (ptr void)] [b (ptr void)] [n u32]) -> i32
  (let ([x (cast (ptr u8) a)] [y (cast (ptr u8) b)])
    (for ([i u32 0]) (< i n) (+= i 1)
      (when (!= (@ x i) (@ y i)) (return (- (@ x i) (@ y i)))))
    0))

(define (strlen [s (ptr u8)]) -> u32
  (let ([p s])
    (while (!= (@ p) 0) (+= p 1))
    (- p s)))

(define (print-string [s (ptr u8)])
  (print:write-bytes (cast i32 s) (strlen s)))

;; ---- arenas ----

;; A chunk's header, before its bytes: the chunk before it.
(struct chunk [previous (ptr chunk)] [size u32])

;; An arena: its last chunk, and the part of it not yet given out.
(struct arena [last (ptr chunk)] [next (ptr u8)] [end (ptr u8)])

(define (make-arena) -> arena
  (let ([a arena])
    (set! (-> a last) 0)
    (set! (-> a next) 0)
    (set! (-> a end) 0)
    a))

;; n bytes, rounded up to a multiple of 8.
(define (arena-alloc [a (ptr arena)] [n u32]) -> (ptr void)
  (let ([size (bit-and (+ n 7) -8)])
    (when (> size (- (-> a end) (-> a next)))
      (arena-grow a size))
    (let ([p (-> a next)])
      (+= (-> a next) size)
      p)))

(define (arena-grow [a (ptr arena)] [n u32])
  (let* ([size (if (> n 65536) n 65536)]
         [c (cast (ptr chunk) (malloc (+ size (sizeof chunk))))])
    (set! (-> c previous) (-> a last))
    (set! (-> c size) size)
    (set! (-> a last) c)
    (set! (-> a next) (cast (ptr u8) (+ c 1)))
    (set! (-> a end) (+ (-> a next) size))))

(define (arena-free [a (ptr arena)])
  (let ([c (-> a last)])
    (while (!= c 0)
      (let ([previous (-> c previous)])
        (free c)
        (set! c previous))))
  (set! (-> a last) 0)
  (set! (-> a next) 0)
  (set! (-> a end) 0))

;; ---- buffers ----

;; Its bytes, length of them, in room for room.
(struct buffer [bytes (ptr u8)] [length u32] [room u32])

(define (make-buffer) -> buffer
  (let ([b buffer])
    (set! (-> b bytes) 0)
    (set! (-> b length) 0)
    (set! (-> b room) 0)
    b))

;; Room in b for n more bytes, twice what it had if that is more.
(define (buffer-reserve [b (ptr buffer)] [n u32])
  (let ([need (+ (-> b length) n)])
    (when (> need (-> b room))
      (set! (-> b room) (if (> need (* 2 (-> b room))) need (* 2 (-> b room))))
      (set! (-> b bytes) (cast (ptr u8) (realloc (-> b bytes) (-> b room)))))))

;; The n bytes at p added to b.
(define (buffer-add! [b (ptr buffer)] [p (ptr u8)] [n u32])
  (buffer-reserve b n)
  (memcpy (+ (-> b bytes) (-> b length)) p n)
  (+= (-> b length) n))

(define (buffer-add-byte! [b (ptr buffer)] [byte i32])
  (buffer-reserve b 1)
  (set! (@ (-> b bytes) (-> b length)) byte)
  (+= (-> b length) 1))

;; The bytes of C string s added to b.
(define (buffer-add-string! [b (ptr buffer)] [s (ptr u8)]) (buffer-add! b s (strlen s)))

(define (buffer-free! [b (ptr buffer)])
  (free (-> b bytes))
  (set! (-> b bytes) 0)
  (set! (-> b length) 0)
  (set! (-> b room) 0))

;; ---- hash tables ----

;; A table of none is all zero, as a global is.
;; Its slots number 2^(64 - shift).
(struct hash-table [keys (ptr u64)] [values (ptr u32)] [count u32] [capacity u32] [shift u32])

;; The slot where key's search starts: the top bits of key times 2^64
;; over the golden ratio, which all of key's bits reach.
(define (hash-slot [t (ptr hash-table)] [key u64]) -> u32
  (cast u32 (>> (* key 11400714819323198485) (-> t shift))))

;; The value of key in t, or 0 if it has none.
(define (hash-ref [t (ptr hash-table)] [key u64]) -> u32
  (if (== (-> t capacity) 0)
      0
      (let* ([keys (-> t keys)] [mask (- (-> t capacity) 1)] [i (hash-slot t key)])
        (while (!= (@ keys i) 0)
          (when (== (@ keys i) key) (return (@ (-> t values) i)))
          (set! i (bit-and (+ i 1) mask)))
        0)))

(define (hash-set! [t (ptr hash-table)] [key u64] [value u32])
  (when (>= (* 2 (+ (-> t count) 1)) (-> t capacity)) (hash-grow t))
  (let* ([keys (-> t keys)] [mask (- (-> t capacity) 1)] [i (hash-slot t key)])
    (while (!= (@ keys i) 0)
      (when (== (@ keys i) key)
        (set! (@ (-> t values) i) value)
        (return))
      (set! i (bit-and (+ i 1) mask)))
    (set! (@ keys i) key)
    (set! (@ (-> t values) i) value)
    (+= (-> t count) 1)))

;; t with twice the slots, or 16 at first, its keys put in them again.
(define (hash-grow [t (ptr hash-table)])
  (let ([keys (-> t keys)] [values (-> t values)] [n (-> t capacity)])
    (set! (-> t capacity) (if (== n 0) 16 (* 2 n)))
    (set! (-> t shift) (if (== n 0) 60 (- (-> t shift) 1)))
    (set! (-> t keys) (cast (ptr u64) (calloc (-> t capacity) 8)))
    (set! (-> t values) (cast (ptr u32) (malloc (* (-> t capacity) 4))))
    (set! (-> t count) 0)
    (for ([i u32 0]) (< i n) (+= i 1)
      (when (!= (@ keys i) 0) (hash-set! t (@ keys i) (@ values i))))
    (free keys)
    (free values)))

;; t with no keys, and its slots kept.
(define (hash-clear! [t (ptr hash-table)])
  (when (!= (-> t capacity) 0) (memset (-> t keys) 0 (* (-> t capacity) 8)))
  (set! (-> t count) 0))

(define (hash-free! [t (ptr hash-table)])
  (free (-> t keys))
  (free (-> t values))
  (set! (-> t keys) 0)
  (set! (-> t values) 0)
  (set! (-> t count) 0)
  (set! (-> t capacity) 0)
  (set! (-> t shift) 0))

(begin-for-syntax
  (require sm "syntax-match.sub" syntax-match _ ... ?)
  ;; (new a T): (cast (ptr T) (arena-alloc a (sizeof T))).
  (func (new-form [s i32]) -> i32
    (syntax-match s [(_ a t) #`(cast (ptr #,t) (arena-alloc #,a (sizeof #,t)))])))

(define-syntax new new-form)
