#!/usr/bin/env bash
# Lifecycle: experimental. Runs the new compiler (next/compiler/main.sub),
# as bin/sub runs the compiler: from the package root, this repository
# unless -p DIR names another, with paths taken relative to where this
# runs, which -d tells it; on build/subhost, or the host HOST names. The
# new compiler is built by itself, as the Makefile builds the compiler:
# the seed, a build of it checked in (next/seed), builds its sources into
# build/next/sub-1, which builds them again into build/next/sub, when they
# or the seed are newer than it; each is given the directory of the build
# that runs it (-r DIR), whose kernel module compile-time code links to.
# Compiled modules are kept in build/next/cache (spec 3.7), or in the
# directory -c DIR names; the stages building the compiler keep none.
# next/bootstrap.sh checks that the build builds itself. Needs the dev
# shell (nix develop).
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
here="$PWD"

# The new compiler's sources built by the build in directory $1 into
# directory $2.
stage() {
  rm -rf "${2:?}"
  mkdir -p "$2"
  (cd "$root" && "$root/${HOST:-build/subhost}" "$1" "$root" build next/compiler/main.sub -o "$2" -p "$root" -d "$root" -r "$1")
}

out="$root/build/next/sub"
if [ ! -f "$out/program" ] ||
   [ -n "$(find "$root/next/compiler" "$root/next/c" "$root/lib/print.sub" "$root/lib/memory.sub" "$root/next/seed/program" -newer "$out/program" | head -1)" ]; then
  stage "$root/next/seed" "$root/build/next/sub-1"
  stage "$root/build/next/sub-1" "$out"
fi

# -p DIR, taken out of the arguments.
package="$root"
n=$#
for ((k = 0; k < n; k++)); do
  if [ "$1" = -p ] && [ $((k + 1)) -lt $n ]; then package="$(cd "$2" && pwd)"; shift 2; k=$((k + 1))
  else set -- "$@" "$1"; shift; fi
done

# The compiler cannot make directories, so the cache's, -c DIR or
# build/next/cache, and build's output, -o DIR or FILE without its
# extension, are made here.
case " $* " in *" -c "*) ;; *) set -- "$@" -c "$root/build/next/cache" ;; esac
prev=""
for a in "$@"; do
  [ "$prev" = -c ] && mkdir -p "$a"
  [ "$prev" = -o ] && dest="$a"
  prev="$a"
done
if [ "${1:-}" = build ] && [ $# -ge 2 ]; then mkdir -p "${dest:-${2%.*}}"; fi

cd "$package"
exec "$root/${HOST:-build/subhost}" "$out" "$root" "$@" -p "$package" -d "$here" -r "$out"
