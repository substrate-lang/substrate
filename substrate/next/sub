#!/usr/bin/env bash
# Lifecycle: experimental. Runs the new compiler (next/compiler/main.sub),
# as bin/sub runs the compiler: from the package root, this repository
# unless -p DIR names another, with paths taken relative to where this
# runs, which -d tells it; on build/subhost, or the host HOST names. The
# compiler builds it into build/next/sub when its sources are newer. Needs
# the dev shell (nix develop).
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
here="$PWD"

out="$root/build/next/sub"
if [ ! -f "$out/program" ] || [ -n "$(find "$root/next/compiler" "$root/examples/c" -name '*.sub' -newer "$out/program" | head -1)" ]; then
  (cd "$root" && bin/sub build next/compiler/main.sub -o "$out" > /dev/null)
fi

# -p DIR, taken out of the arguments.
package="$root"
n=$#
for ((k = 0; k < n; k++)); do
  if [ "$1" = -p ] && [ $((k + 1)) -lt $n ]; then package="$(cd "$2" && pwd)"; shift 2; k=$((k + 1))
  else set -- "$@" "$1"; shift; fi
done

# The compiler cannot make directories, so build's output, -o DIR or FILE
# without its extension, is made here.
prev=""
for a in "$@"; do
  [ "$prev" = -o ] && dest="$a"
  prev="$a"
done
if [ "${1:-}" = build ] && [ $# -ge 2 ]; then mkdir -p "${dest:-${2%.*}}"; fi

cd "$package"
exec "$root/${HOST:-build/subhost}" "$out" "$root" "$@" -p "$package" -d "$here"
