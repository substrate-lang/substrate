;; Lifecycle: benchmark. The kernel's syntax objects (spec 2.3) as the
;; new compiler's (next/compiler/kernel.sub), for comparing the two: each
;; syntax object's datum and source location, with no scopes and no
;; properties, as a reader gives them. A kernel syntax object's scopes are
;; the compiler's expander's, which the contract does not show.
(require-unqualified c "../../examples/c/c.sub")
(require-unqualified stx "../compiler/kernel.sub")
(require k kernel)

(provide from-kernel)

(memory from c)
(table from c)

(import host-trap "host" "trap" (i32 i32 ->))

;; Where a kernel string's bytes are copied: room for room bytes.
(define buffer (ptr u8) 0)
(define buffer-room u32 0)

;; The bytes of kernel string s, in the buffer.
(define (bytes-of [s value]) -> (ptr u8)
  (let ([n (cast u32 (k:string-length s))])
    (when (> n buffer-room)
      (set! buffer-room (* 2 n))
      (set! buffer (cast (ptr u8) (realloc buffer buffer-room))))
    (for ([i u32 0]) (< i n) (+= i 1) (set! (@ buffer i) (k:string-byte s i)))
    buffer))

;; Kernel datum v, as next/compiler/kernel.sub's, in its current arena.
(define (from-kernel [v value]) -> datum
  (when (== v 0) (return 0))
  (when (k:syntax? v) (return (make-syntax (from-kernel (k:syntax-e v)) no-scopes (srcloc-of v) nil)))
  (when (k:pair? v) (return (cons (from-kernel (k:car v)) (from-kernel (k:cdr v)))))
  (when (k:null? v) (return nil))
  (when (k:symbol? v) (return (symbol-of v)))
  (when (k:keyword? v)
    (let ([name (k:keyword->string v)]) (return (bytes->keyword (bytes-of name) (k:string-length name)))))
  (when (k:string? v) (return (bytes->string (bytes-of v) (k:string-length v))))
  (when (k:integer? v)
    (return (if (k:integer-negative? v) (make-integer (k:integer-value v)) (make-unsigned-integer (k:integer-value v)))))
  (when (k:flonum? v) (return (make-flonum (k:flonum-value v))))
  (when (k:char? v) (return (integer->char (k:char->integer v))))
  (when (k:boolean? v) (return (boolean 1)))
  (let ([message "a kernel value that is not syntax data"])
    (host-trap (cast i32 message) (strlen message))
    0))

(define (symbol-of [s value]) -> datum
  (let ([name (k:symbol->string s)]) (bytes->symbol (bytes-of name) (k:string-length name))))

;; Where s is: its file, a symbol, its line and its column. The contract
;; gives no position or span.
(define (srcloc-of [s value]) -> (ptr srcloc)
  (let ([source (k:syntax-source s)])
    (if (== source 0)
        0
        (make-srcloc (if (k:symbol? source) (symbol-of source) (string->symbol (from-kernel source)))
                     (k:fixnum-value (k:syntax-line s)) (k:fixnum-value (k:syntax-column s)) 0 0))))
