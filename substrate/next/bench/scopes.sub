;; Lifecycle: benchmark. Scope changes on the syntax of a large file,
;; compiler/expander.sub as the compiler reads it, made by the kernel and
;; by the new compiler's syntax objects (next/compiler/kernel.sub), as an
;; expander makes them: at each syntax list, as at a macro use, an
;; introduction scope flipped on it, its datum looked at and made the
;; output, which is flipped again; then a binding form's scope added, and
;; its elements visited in turn. Ten passes over the file, after reading
;; it, in mode 0, and converting it to the new compiler's, in mode 1; with
;; the kernel's in mode 2 and the new compiler's in mode 3. Each prints the
;; number of scopes of the syntax objects that are not lists, which is
;; the same for both. Run from the repository's root by run.sh.
(require-unqualified c "../../examples/c/c.sub")
(require-unqualified stx "../compiler/kernel.sub")
(require-unqualified ks "kernel-syntax.sub")
(require k kernel)
(require rd "../../compiler/reader.sub" read-file)
(require print "../../lib/print.sub" write-int newline)
(memory from c)
(table from c)

;; The kernel's changes to scopes, which the contract does not give.
(import kernel-change "kernel" "%syntax-change" (eqref eqref eqref -> eqref))
(import kernel-scopes "kernel" "%syntax-scopes" (eqref -> eqref))
(import host-arg "host" "arg" (i32 i32 i32 -> i32))

(define next-scope u32 1000)
(define (fresh) -> u32 (+= next-scope 2) next-scope)

(define (kernel-change-scope [s value] [sc u32] [kind u32]) -> value (kernel-change s (k:fixnum sc) (k:fixnum kind)))

(define (kernel-visit [s value]) -> i32
  (if (k:pair? (k:syntax-e s))
      (let* ([i (fresh)] [in (kernel-change-scope s i 2)] [out (k:syntax-rewrap in (k:syntax-e in))]
             [b (kernel-change-scope (kernel-change-scope out i 2) (fresh) 0)] [n 0] [l (k:syntax-e b)])
        (while (k:pair? l) (+= n (kernel-visit (k:car l))) (set! l (k:cdr l)))
        n)
      (k:length (kernel-scopes s))))

(define (our-visit [s datum]) -> i32
  (if (pair? (syntax-e s))
      (let* ([i (fresh)] [in (flip-scope s i)] [out (syntax-rewrap in (syntax-e in))]
             [b (add-scope (flip-scope out i) (fresh))] [n 0] [l (syntax-e b)])
        (while (pair? l) (+= n (our-visit (car l))) (set! l (cdr l)))
        n)
      (-> (syntax-scopes s) count)))

(define (mode) -> i32
  (let ([b (array u8 8)])
    (host-arg 0 (cast i32 b) 8)
    (- (@ b 0) 48)))

(define (run [forms value] [m i32])
  (let ([n 0])
    (when (== m 1)
      (begin-module-arena)
      (from-kernel forms)
      (end-module-arena))
    (when (== m 2)
      (for ([r 0]) (< r 10) (+= r 1)
        (let ([l forms]) (while (k:pair? l) (+= n (kernel-visit (k:car l))) (set! l (k:cdr l))))))
    (when (== m 3)
      ;; The file's syntax in a module's arena, and each pass's in one
      ;; within it.
      (begin-module-arena)
      (let ([ours (from-kernel forms)])
        (for ([r 0]) (< r 10) (+= r 1)
          (begin-module-arena)
          (let ([l ours]) (while (pair? l) (+= n (our-visit (car l))) (set! l (cdr l))))
          (end-module-arena)))
      (end-module-arena))
    (write-int n)
    (newline)))

(func (main) (run (rd:read-file '"compiler/expander.sub") (mode)))
