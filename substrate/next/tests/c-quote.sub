;; The quote forms in C code, typed as the kernel module's datum: 'd and
;; #'id, and kernel.sub's `t and #`t with their unquotes, in macros whose
;; transformers are C functions.
(require-unqualified c "../c/c.sub")
(require print "../../lib/print.sub" write-int newline)
(memory from c)
(table from c)

(begin-for-syntax
  (require-unqualified c "../c/c.sub")
  (require-unqualified kd "../compiler/kernel.sub")

  ;; (swap! a b): a and b exchanged through a t of the template's, which
  ;; a t of the use's does not capture.
  (define (swap! [s datum]) -> datum
    (let ([a (cadr (syntax->list s))] [b (caddr (syntax->list s))])
      #`(let ([t #,a]) (set! #,a #,b) (set! #,b t))))

  ;; (sum e ...): (+ 0 e ...), spliced.
  (define (sum [s datum]) -> datum #`(+ 0 #,@(cdr (syntax->list s))))

  ;; (inc e): (+ e 1), a datum template with the use's scopes.
  (define (inc [s datum]) -> datum (datum->syntax s `(+ ,(cadr (syntax->list s)) 1) s))

  ;; (shape x): 1 if x is point, compared with #'point by binding; 2 if it
  ;; is (1 2); 3 if it is the symbol other; else 0.
  (define (shape [s datum]) -> datum
    (let ([x (cadr (syntax->list s))])
      (datum->syntax s (make-integer (cond [(and (identifier? x) (free-identifier=? x #'point)) 1]
                                           [(equal? (syntax->datum x) '(1 2)) 2]
                                           [(== (syntax-e x) 'other) 3]
                                           [else 0]))
                     s))))

(define-syntax swap! swap!)
(define-syntax sum sum)
(define-syntax inc inc)
(define-syntax shape shape)

(define (main)
  (let ([x 1] [t 2])
    (swap! x t)
    (write-int x) (newline)
    (write-int t) (newline))
  (write-int (sum 1 2 3)) (newline)
  (write-int (inc 41)) (newline)
  (write-int (shape point)) (write-int (shape (1 2))) (write-int (shape other)) (write-int (shape zzz)) (newline))
