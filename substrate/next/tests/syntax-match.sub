;; syntax-match (next/c/syntax-match.sub), as tests/syntax-match.sub:
;; patterns take syntax apart, in a program and in a macro.
(require print "../../lib/print.sub" write-bytes newline)
(require k kernel)
(require sm "../c/syntax-match.sub" syntax-match _ ... ?)
(begin-for-syntax
  (require k kernel)
  (require sm "../c/syntax-match.sub" syntax-match _ ... ?))

;; Two ellipses in one list.
(func (signature [s i32]) -> i32
  (syntax-match s
    [(param ... '-> result ...) `(,(k:syntax->datum param) ,(k:syntax->datum result))]))

;; Words compared by name, checks, and an element after an ellipsis.
(func (clause [c i32]) -> i32
  (syntax-match c
    [('catch tag ((? k:identifier? x) ...) body ...)
     `(catch ,(k:syntax-e tag) ,(k:syntax->datum x) ,(k:fixnum (k:length body)))]
    [('catch-ref tag (x ... e) body ...) `(catch-ref ,(k:syntax->datum x) ,(k:syntax-e e))]
    [('catch-all body ...) `(catch-all ,(k:fixnum (k:length body)))]
    [_ 'other]))

;; Nested ellipses, a keyword, a dotted tail, and a part bound and taken
;; apart.
(func (group [s i32]) -> i32
  (syntax-match s
    [(#:group (? k:syntax? whole ([x v ...] ...)) . rest)
     `(,(k:fixnum (k:length (k:syntax-e whole))) ,(k:syntax->datum x) ,(k:syntax->datum v) ,(k:fixnum (k:length rest)))]))

;; A list of syntax, not a syntax list; () and data.
(func (shape [l i32]) -> i32
  (syntax-match l
    [() 'empty]
    [(5 "five" #t) 'data]
    [(a) `(one ,(k:syntax-e a))]
    [(a . b) 'pair]))

;; A macro: #'else compared by binding, a _ head, and recursion.
(begin-for-syntax
  (func (my-cond [stx i32]) -> i32
    (syntax-match stx
      [(_) #''none]
      [(_ (#'else e ...)) #`(begin #,@e)]
      [(_ (test e ...) clause ...) #`(if #,test (begin #,@e) (my-cond #,@clause))])))
(define-syntax my-cond my-cond)

(func (display [s i32]) (write-bytes (k:string-bytes s) (k:string-length s)))

(func (main)
  (k:write-datum (signature #'(i32 eqref -> i64))) (newline)
  (k:write-datum (signature #'(->))) (newline)
  (k:write-datum `(,(clause #'(catch t (a b) x y)) ,(clause #'(catch-ref t (a b e) x)) ,(clause #'(catch-all 1 2 3))
                   ,(clause #'(catch t (1) x)) ,(clause #'(other))))
  (newline)
  (k:write-datum (group #'(#:group ([a 1 2] [b] [c 3]) z z))) (newline)
  (k:write-datum `(,(shape '()) ,(shape `(,#'5 ,#'"five" ,#'#t)) ,(shape `(,#'x)) ,(shape `(,#'x ,#'y)))) (newline)
  (k:write-datum `(,(my-cond [#f '1] [else '2]) ,(my-cond [#f '1]) ,(my-cond [(i32.eq 1 1) '3] [else '4]))) (newline)
  ;; The error when no clause matches, caught.
  (try ([catch k:compile-error (message blamed at) (display message)]) (drop (signature #'(i32 eqref))))
  (newline)
  (try ([catch k:compile-error (message blamed at) (display message)]) (drop (group #'(group x))))
  (newline)
  (try ([catch k:compile-error (message blamed at) (display message)])
    (drop (syntax-match #'(tag 5) [('tag (? k:identifier? name) (type ...)) name])))
  (newline))
