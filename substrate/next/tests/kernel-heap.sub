;; The kernel module's owners (next/compiler/kernel.sub): in a program
;; that frees, cells are made on the heap, owned once, and drop frees a
;; cell its last owner leaves, and what it holds; a literal, an interned
;; symbol and a cell made before freeing was enabled are permanent, and
;; drop leaves them.
(require-unqualified c "../c/c.sub")
(require-unqualified kd "../compiler/kernel.sub")
(require print "../../lib/print.sub" write-int newline)
(memory from c)
(table from c)

(define (show [n i32]) (write-int n) (newline))

(define (main)
  ;; Before freeing is enabled, as while compiling, cells are permanent.
  (let ([l (cons (bytes->string "a" 1) nil)])
    (drop l)
    (show (live-cells)))
  (enable-freeing!)
  ;; Two pairs and two strings; a second owner keeps them through one drop.
  (let ([l (cons (bytes->string "a" 1) (cons (bytes->string "ab" 2) nil))])
    (show (live-cells))
    (dup l)
    (drop l)
    (show (live-cells))
    (drop l)
    (show (live-cells)))
  ;; A literal and a symbol are permanent; the string the symbol was made
  ;; from is not.
  (drop '(1 2))
  (let ([s (bytes->string "sym" 3)]) (drop (string->symbol s)) (drop s))
  (show (live-cells))
  ;; A string held by two lists goes when the second does.
  (let* ([s (bytes->string "x" 1)] [a (cons (dup s) nil)] [b (cons s nil)])
    (drop a)
    (show (live-cells))
    (drop b)
    (show (live-cells))))
