;; For shift-literals.sub, as tests/fixtures/shift-n.sub: helper, and a
;; macro whose expansion is a syntax literal naming it.
(provide helper capture)
(func (helper [x i32]) -> i32 (i32.add x 1))
(begin-for-syntax
  (require s syntax)
  (func (capture [stx i32]) -> i32 (quote-syntax-datum (quote-syntax-datum helper))))
(define-syntax capture capture)
