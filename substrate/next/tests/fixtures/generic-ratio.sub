;; A generic function that traps, for the test of where a trap in an
;; instance of another module's generic is reported
;; (next/tests/c/err-generic-trap.sub).
(require-unqualified c "../../c/c.sub")
(provide box ratio)
(memory from c)
(table from c)
(struct #:forall (T) box [value T])
(define #:forall (T) (ratio [b (ptr (box T))] [d i32]) -> i32
  (when (== d 99) (return 0))
  (/ 100 d))
