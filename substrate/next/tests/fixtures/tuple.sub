;; A type function, as tests/fixtures/tuple.sub, Zig-style: (tuple T n),
;; for a type name T and a number n below 10, is a struct type with fields
;; f0 ... of type T. The first use in a module lifts its declaration into
;; the module, and later uses return its name, so the module declares it
;; once. A declaration in another module is the same type, since types are
;; identified by structure (spec 5.1).
(provide tuple)

(begin-for-syntax
  (require s syntax)

  ;; ((key . name) ...): the tuple types declared in the module being
  ;; compiled. A key is a symbol like tuple-i32-three.
  (global declared (mut i32) (quote-datum ()))

  (func (lookup [key i32] [l i32]) -> i32
    (if (s:null? l) (return 0))
    (if (i32.eq (s:car (s:car l)) key) (return (s:cdr (s:car l))))
    (lookup key (s:cdr l)))

  (func (nth [l i32] [i i32]) -> i32
    (if (i32.eqz i) (s:car l) (nth (s:cdr l) (i32.sub i 1))))

  ;; (field f<i> T) ... for i from i to n - 1.
  (func (fields [t i32] [i i32] [n i32]) -> i32
    (if (i32.ge_s i n) (return (quote-datum ())))
    (s:cons (quasisyntax-datum (field #,(s:datum->syntax (quote-syntax-datum here) (nth (quote-datum (f0 f1 f2 f3 f4 f5 f6 f7 f8 f9)) i) t) #,t))
            (fields t (i32.add i 1) n)))

  ;; (tuple T n)
  (func (tuple [stx i32]) -> i32
    (let* ([parts (s:syntax->list stx)]
           [t (s:cadr parts)]
           [n (i32.wrap_i64 (s:integer-value (s:syntax-e (s:caddr parts))))]
           [key (s:symbol-append (s:symbol-append (quote-datum tuple-) (s:syntax-e t))
                                 (s:symbol-append (quote-datum -) (nth (quote-datum (zero one two three four five six seven eight nine)) n)))]
           [known (lookup key declared)])
      ;; The name is kept as the module sees it (spec 2.3), and a use puts
      ;; it in its output as the macro sees it.
      (if (i32.ne known 0) (return (s:syntax-local-introduce known)))
      (let ([name (s:datum->syntax (quote-syntax-datum here) key stx)])
        (drop (s:syntax-local-lift-definition (quasisyntax-datum (type #,name (struct #,@(fields t 0 n))))))
        (set! declared (s:cons (s:cons key (s:syntax-local-introduce name)) declared))
        name))))
(define-syntax tuple tuple)
