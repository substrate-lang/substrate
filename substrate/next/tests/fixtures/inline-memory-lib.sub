;; Inline functions that use memory, for tests/inline-memory.sub: they
;; are inlined where the memory is the same (spec 5.2).
(require print "../../../lib/print.sub")
(provide peek poke)
(memory from print)
(func (peek [a i32]) #:inline -> i32 (i32.load a))
(func (poke [a i32] [v i32]) #:inline (i32.store a v))
