;; Helpers for transformers, as tests/fixtures/stx-util.sub. Modules
;; require this inside begin-for-syntax, so it runs only while they
;; compile; programs never load it.
(require s syntax)
(provide second third)
(func (second [stx i32]) -> i32 (s:cadr (s:syntax->list stx)))
(func (third [stx i32]) -> i32 (s:caddr (s:syntax->list stx)))
