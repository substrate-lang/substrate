;; For shift-literals.sub, as tests/fixtures/shift-m.sub: (emit) =>
;; (begin-for-syntax (show (helper 41))), where helper is shift-n's, named
;; by a literal this module's phase-1 code got from shift-n's macro. So the
;; literal holds shift-n's scope, not this module's.
(provide emit)
(begin-for-syntax
  (require s syntax)
  (require n "shift-n.sub" capture)
  (func (the-helper) -> i32 (capture))
  (func (emit [stx i32]) -> i32
    (quasisyntax-datum
     (begin-for-syntax
       (require print "../../../lib/print.sub")
       (print:write-int (#,(the-helper) 41))
       (print:newline)))))
(define-syntax emit emit)
