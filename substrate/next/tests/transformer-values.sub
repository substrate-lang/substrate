;; Transformers are values (spec 2.1, 6.3), as tests/transformer-values.sub.
;; make-transformer pairs a code function, by its table index, with an
;; environment, so one function makes many macros, and a transformer can
;; be computed. A name is a macro when its value is a transformer, and
;; syntax-local-value gives a macro's transformer.

(require print "../../lib/print.sub" write-int newline)
(begin-for-syntax
  (require s syntax)

  ;; A use of the macro expands to the number in its environment.
  (func (constant [env i32] [stx i32]) -> i32 (s:datum->syntax stx env stx))

  (func (constant-macro [n i32]) -> i32 (s:make-transformer (func-index constant) n)))

(define-syntax forty-two (constant-macro (quote-datum 42)))
(define-syntax seven (constant-macro (quote-datum 7)))
(define-syntax not-a-macro (quote-datum (1 2)))

;; (macro? id) expands to 1 if id is a macro with a transformer for its
;; value, and to 0 otherwise.
(begin-for-syntax
  (func (macro? [stx i32]) -> i32
    (let ([id (s:cadr (s:syntax->list stx))])
      (s:datum->syntax stx
                       (s:make-integer (i64.extend_i32_u
                                        (if (i32.eq (s:identifier-binding-kind id) (quote-datum macro))
                                            (i32.ne (s:syntax-local-value id) 0)
                                            0)))
                       stx))))
(define-syntax macro? macro?)

(func (main)
  (write-int forty-two) (newline)
  (write-int (seven)) (newline)
  (write-int (macro? seven)) (newline)
  (write-int (macro? not-a-macro)) (newline))
