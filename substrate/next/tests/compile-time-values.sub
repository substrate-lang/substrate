;; define-syntax binds a compile-time value that is not a transformer, as
;; tests/compile-time-values.sub: here a datum in memory. Macros read it
;; with syntax-local-value. This is how a struct form and a match form
;; will talk to each other.

(require print "../../lib/print.sub" write-int newline)
(begin-for-syntax (require s syntax))

(define-syntax point (quote-datum (x y)))
(define-syntax color (quote-datum (red green blue alpha)))

;; (field-count T) expands to the number of fields recorded for T.
(begin-for-syntax
  (func (field-count [stx i32]) -> i32
    (let* ([name (s:cadr (s:syntax->list stx))]
           [fields (s:syntax-local-value name)])
      (if (i32.eqz (s:pair? fields))
          (s:raise-syntax-error (quote-datum #f) (quote-datum "has no field information") name))
      (s:datum->syntax stx (s:make-integer (i64.extend_i32_u (s:length fields))) stx))))
(define-syntax field-count field-count)

;; (field-index T f) expands to f's position in T, or is a compile error.
(begin-for-syntax
  (func (field-index [stx i32]) -> i32
    (let* ([parts (s:syntax->list stx)]
           [fields (s:syntax-local-value (s:cadr parts))]
           [field (s:syntax-e (s:caddr parts))]
           [i 0])
      (block done
        (loop next
          (if (s:null? fields) (s:raise-syntax-error (quote-datum #f) (quote-datum "no such field") (s:caddr parts)))
          (br-if done (i32.eq (s:car fields) field))
          (set! fields (s:cdr fields))
          (set! i (i32.add i 1))
          (br next)))
      (s:datum->syntax stx (s:make-integer (i64.extend_i32_u i)) stx))))
(define-syntax field-index field-index)

(func (main)
  (write-int (field-count point)) (newline)
  (write-int (field-count color)) (newline)
  (write-int (field-index color blue)) (newline))
