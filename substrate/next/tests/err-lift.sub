;; A macro can lift only definitions (spec 6.4).
(begin-for-syntax
  (require s syntax)
  (func (lift-require [stx i32]) -> i32
    (drop (s:syntax-local-lift-definition (quote-syntax-datum (require p "../../lib/print.sub"))))
    (quote-syntax-datum (nop))))
(define-syntax lift-require lift-require)

(func (main) (lift-require))
