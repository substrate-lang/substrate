;; store-handle checks that it is given the address of an object in the
;; store. Any other address stops the program.
(require-unqualified c "../../c/c.sub")
(require-unqualified store "../../web/game/store.sub")
(memory from c)
(table from c)

(struct enemy [health i32] [armour i32])
(define enemies (store enemy))
(define elsewhere (array enemy 4))

(define (main)
  (store-add! (& enemies))
  (print-string "before\n")
  (store-handle (& enemies) (+ elsewhere 2))
  (print-string "not reached\n"))
