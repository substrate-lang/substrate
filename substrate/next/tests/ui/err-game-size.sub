;; Error test: the size of a game's screen must be written as two numbers,
;; because it becomes the width and height of the canvas in the page's
;; HTML. Here the width is a name.
(require-unqualified c "../../c/c.sub")
(require-unqualified input "../../web/game/input.sub")
(require-unqualified game "../../web/game/game.sub")
(memory from c)
(table from c)

(struct world [ticks u32])
(define wide i32 320)
(define (init [w (ptr world)]) 0)
(define (step [w (ptr world)] [in (ptr input)]) 0)
(define (draw [w (ptr world)]) 0)

(game world [size wide 180] init step draw)
