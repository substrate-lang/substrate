;; A regression test for views (next/web/ui.sub): a message type with
;; only one case, whose message carries event data. It needs no browser;
;; one-message.out is the expected output.
;;
;; To fill in the event data, ui.sub generates a `match` on the message.
;; That match used to end with a clause for "any other case", and when
;; the type has no other case the compiler rejects such a clause ("this
;; clause can never match"). So a page with a single kind of message did
;; not compile.
(require-unqualified c "../../c/c.sub")
(require-unqualified ui "../../web/ui.sub")
(require-unqualified trace "../../web/trace.sub")
(memory from c)
(table from c)

(struct model [id u32])
(variant msg [typed [text (ptr u8)]])
(messages msg)

(view (field [m (ptr model)])
  (input ([type "text"] [on input (typed (event value))])))

(define the-model model)
(define a-field field.state)

;; There is no browser here, so the test supplies the event's data itself.
(define (event-text [which u32]) -> (ptr u8) "hello")
(define (event-truths) -> u32 0)
(define (event-number [which u32]) -> f64 0.0)

(define (main)
  (field.mount (& a-field) 0 0 (& the-model))
  (trace-patches!)
  (ui-event-source! event-text event-truths event-number)
  (match (cast (ptr msg) (ui-heard (trace-listener 0)))
    [(typed text) (print-string "typed ") (print-string text) (print-string "\n")]))
