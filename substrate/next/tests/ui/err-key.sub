;; Error test: the key of an each must be an integer, and this one is a
;; string. The error must point at the key expression.
(require-unqualified c "../../c/c.sub")
(require-unqualified ui "../../web/ui.sub")
(memory from c)
(table from c)

(struct item [id u32] [name (ptr u8)])
(struct model [count i32] [title (ptr u8)] [items (array item 4)] [n u32])
(variant msg [increment] [typed [text (ptr u8)]])
(messages msg)

(view (row [x (ptr item)]) (li (text (-> x name))))

(view (page [m (ptr model)])
  (ul (each [x (-> m items) (-> m n)] #:key (-> x name)
        (row x))))
(define (main) 0)
