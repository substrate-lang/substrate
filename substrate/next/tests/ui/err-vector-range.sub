;; An index that is out of range stops the program, with a message that
;; names the index and the size.
(require-unqualified c "../../c/c.sub")
(require-unqualified vector "../../web/game/vector.sub")
(memory from c)
(table from c)

(define numbers (vector u32))

(define (main)
  (for ([i u32 0]) (< i 3) (+= i 1) (vector-push! (& numbers) i))
  (print-string "before\n")
  (vector-at (& numbers) 3)
  (print-string "not reached\n"))
