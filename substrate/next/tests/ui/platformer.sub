;; A test of the platformer example (next/web/examples/platformer/world.sub)
;; that needs no browser. A simple "bot" plays the game by pressing keys,
;; exactly as a player's key presses would arrive, and the test prints
;; where it got to. The game has no randomness, so the same thing happens
;; on every run.
;;
;; The bot holds the right arrow all the time, and jumps (holding Space
;; until it lands) whenever, just ahead of it, there is a wall, a hole in
;; the ground, spikes, or an enemy.
;;
;; The game reads its levels from files. The test is run in its own
;; directory, so it tells the game where they are from here.
(require-unqualified c "../../c/c.sub")
(require-unqualified format "../../web/game/format.sub")
(require-unqualified store "../../web/game/store.sub")
(require-unqualified tiles "../../web/game/tiles.sub")
(require-unqualified input "../../web/game/input.sub")
(require-unqualified sound "../../web/game/sound.sub")
(require-unqualified world "../../web/examples/platformer/world.sub")
(memory from c)
(table from c)

(define game world)
(define keys input)

(define (start!) (world-start! (& game) "../../web/examples/platformer/assets/levels/"))

;; Prints where the player is and how the game stands.
(define (status)
  (print-format "  level ~d, step ~d: player at ~d, ~d ~s, coins ~d/~d, deaths ~d~s\n"
                (-> game level) (-> game steps)
                (cast i32 (-> game player x)) (cast i32 (-> game player y))
                (if (-> game player on-ground) "on the ground" "in the air")
                (-> game collected) (-> game coin-count) (-> game deaths)
                (cond [(== (-> game state) world-won) ", won"]
                      [(== (-> game state) world-cleared) ", at the flag"]
                      [(== (-> game state) world-dying) ", dying"]
                      [else ""])))

(define (describe-level)
  (print-format "level ~d: ~d by ~d tiles, ~d coins, ~d enemies\n"
                (-> game level) (-> game map columns) (-> game map rows)
                (-> game coin-count) (store-count (& (-> game enemies)))))

;; One step of the game, then the end of the step for the keys, as the
;; game loop does it (next/web/game/game.sub).
(define (step)
  (world-step! (& game) (& keys))
  (input-end-step! (& keys)))

;; Returns the column or row of the tile that holds the pixel position p.
(define (cell [p f64]) -> i32 (cast i32 (floor (/ p 16.0))))

;; Returns 1 if the bot should jump now: it is on the ground and something
;; is in its way.
(define (obstacle-ahead?) -> i32
  (let* ([p (& (-> game player))] [map (& (-> game map))]
         [front (+ (-> p x) (-> p width))] [feet (+ (-> p y) (-> p height))])
    (unless (-> p on-ground) (return 0))
    ;; A wall: a solid tile at the height of the player's body.
    (when (solid-at? map (cell (+ front 6.0)) (cell (- feet 4.0))) (return 1))
    ;; A hole: no solid tile under the pixel just ahead.
    (unless (solid-at? map (cell (+ front 4.0)) (cell (+ feet 2.0))) (return 1))
    ;; Spikes.
    (when (== (tile-at map (cell (+ front 12.0)) (cell (- feet 4.0))) tile-spikes) (return 1))
    ;; A walking enemy within 26 pixels ahead, at about the same height.
    (store-each ([e (& (-> game enemies))])
      (let ([gap (- (-> e body x) front)])
        (when (and (not (-> e flat)) (> gap -4.0) (< gap 26.0) (< (fabs (- (-> e body y) (-> p y))) 20.0))
          (return 1))))
    0))

;; Presses and releases keys for the coming step. A jump needs a new
;; press of Space, so if the key is still down from the last jump when
;; the bot is back on the ground, it is let go first, and pressed again
;; on the step after if something is still in the way.
(define (bot!)
  (input-key-down! (& keys) key-right)
  (cond [(and (-> game player on-ground) (held? (& keys) key-space)) (input-key-up! (& keys) key-space)]
        [(obstacle-ahead?) (input-key-down! (& keys) key-space)]))

(define (main)
  (start!)
  (describe-level)

  (print-format "with no keys pressed, the player falls onto the ground and stays there\n")
  (for ([i u32 0]) (< i 30) (+= i 1) (step))
  (status)

  (print-format "holding right: the player speeds up to 2 pixels a step\n")
  (input-key-down! (& keys) key-right)
  (for ([i u32 0]) (< i 30) (+= i 1) (step))
  (status)
  (input-key-up! (& keys) key-right)

  (print-format "a jump makes a sound\n")
  (tones-clear!)
  (input-key-down! (& keys) key-space)
  (step)
  (input-key-up! (& keys) key-space)
  (print-format "  tones waiting: ~d\n" (tones-waiting))
  (status)

  ;; Walking into the first hole: the player dies, falls off the screen,
  ;; and the level starts again three quarters of a second later.
  (print-format "walking into a hole\n")
  (start!)
  (input-clear! (& keys))
  (input-key-down! (& keys) key-right)
  (let ([n u32 0])
    (while (and (== (-> game state) world-playing) (< n 600))
      (step)
      (+= n 1)))
  (status)
  (for ([i u32 0]) (< i 44) (+= i 1) (step))
  (status)
  (step)
  (status)

  ;; The bot plays every level. The status is printed every four seconds
  ;; of play, and when something changes.
  (print-format "the bot plays the game\n")
  (start!)
  (input-clear! (& keys))
  (let ([n u32 0] [state (-> game state)] [level (-> game level)])
    (while (and (!= (-> game state) world-won) (< n 6000))
      (bot!)
      (step)
      (+= n 1)
      (cond [(!= (-> game level) level)
             (set! level (-> game level))
             (describe-level)]
            [(!= (-> game state) state) (status)]
            [(== (% n 240) 0) (status)])
      (set! state (-> game state)))
    (print-format "~s, after ~d steps\n"
                  (if (== (-> game state) world-won) "the bot finished the last level" "the bot did not finish") n))

  (print-format "Enter starts the first level again\n")
  (input-clear! (& keys))
  (input-key-down! (& keys) key-enter)
  (step)
  (status))
