;; A handle belongs to one type of store. Using a coin's handle with the
;; store of enemies is a compile error.
(require-unqualified c "../../c/c.sub")
(require-unqualified store "../../web/game/store.sub")
(memory from c)
(table from c)

(struct coin [value u32])
(struct enemy [health i32])
(define coins (store coin))
(define enemies (store enemy))

(define (main)
  (let ([h (store-handle (& coins) (store-add! (& coins)))])
    (store-find (& enemies) h)))
