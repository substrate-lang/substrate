;; An attribute that is a number, given text that changes: the error is at the text.
(require-unqualified c "../../c/c.sub")
(require-unqualified ui "../../web/ui.sub")
(memory from c)
(table from c)

(struct item [id u32] [name (ptr u8)])
(struct model [count i32] [title (ptr u8)] [items (array item 4)] [n u32])
(variant msg [increment] [typed [text (ptr u8)]])
(messages msg)

(view (page [m (ptr model)])
  (table (tr (td ([colspan (-> m title)]) "x"))))
(define (main) 0)
