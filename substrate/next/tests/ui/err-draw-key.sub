;; Error test: the key of [draw key code] must be an integer, and this one
;; is a string. The error must point at the key.
(require-unqualified c "../../c/c.sub")
(require-unqualified ui "../../web/ui.sub")
(memory from c)
(table from c)

(struct model [count i32])
(variant msg [tick [time f64]] [pressed])
(messages msg)
(define (paint [m (ptr model)]) 0)

(view (page [m (ptr model)])
  (canvas ([draw "always" (paint m)])))
(define (main) 0)
