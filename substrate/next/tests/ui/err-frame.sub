;; Error test: `frame` is an event of the window, so it must be written
;; with on-window, not on. The error must point at the event name.
(require-unqualified c "../../c/c.sub")
(require-unqualified ui "../../web/ui.sub")
(memory from c)
(table from c)

(struct model [count i32])
(variant msg [tick [time f64]] [pressed])
(messages msg)
(define (paint [m (ptr model)]) 0)

(view (page [m (ptr model)])
  (canvas ([on frame (tick (event time))])))
(define (main) 0)
