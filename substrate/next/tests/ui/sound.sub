;; A test of the game library's sound requests (next/web/game/sound.sub)
;; that needs no browser. A game's calls only add to lists, which the
;; game loop hands to the browser at the end of a frame. The test looks at
;; the lists instead. sound.out is the expected output.
(require-unqualified c "../../c/c.sub")
(require-unqualified format "../../web/game/format.sub")
(require-unqualified sound "../../web/game/sound.sub")
(memory from c)
(table from c)

;; Prints everything the game has asked for, as the game loop would hand
;; it to the browser, and empties the lists as the loop does.
(define (frame)
  (for ([i u32 0]) (< i (sound-files-waiting)) (+= i 1)
    (print-format "  load sound ~d from ~s\n" (-> (sound-file-at i) id) (-> (sound-file-at i) path)))
  (sound-files-clear!)
  (for ([i u32 0]) (< i (tones-waiting)) (+= i 1)
    (let ([t (tone-at i)])
      (print-format "  tone, wave ~d, ~f to ~f Hz, ~f ms, volume ~f\n" (-> t wave) (-> t from) (-> t to) (-> t ms) (-> t volume))))
  (tones-clear!)
  (for ([i u32 0]) (< i (sounds-waiting)) (+= i 1)
    (print-format "  play sound ~d, volume ~f\n" (-> (sound-at i) sound) (-> (sound-at i) volume)))
  (sounds-clear!)
  (cond [(== (music-change) music-start) (print-format "  start music: sound ~d, volume ~f\n" (music-sound) (music-volume))]
        [(== (music-change) music-stop) (print-format "  stop the music\n")])
  (music-change-clear!)
  (print-format "  --\n"))

(define (main)
  (print-format "nothing asked for:\n")
  (frame)

  (print-format "two files to load, and music from the start:\n")
  (let ([name (array u8 32)])
    ;; The path is copied: changing the caller's string afterwards does
    ;; not change what is loaded.
    (format-into name 32 "assets/coin.wav")
    (let ([coin (load-sound name)])
      (format-into name 32 "something else")
      (let ([tune (load-sound "assets/tune.ogg")])
        (play-music tune 0.4)
        (frame)

        (print-format "a tone and two sounds in one frame:\n")
        (play-tone square-wave 300.0 600.0 120.0 0.2)
        (play-sound coin 0.5)
        (play-sound coin 0.25)
        (frame)

        (print-format "only the last request about the music counts:\n")
        (stop-music)
        (play-music coin 1.0)
        (frame)
        (stop-music)
        (frame)

        (print-format "at most 16 sounds in one frame:\n")
        (for ([i u32 0]) (< i 20) (+= i 1) (play-sound coin 0.1))
        (print-format "  ~d waiting\n" (sounds-waiting))
        (sounds-clear!)))))
