;; store-get is for an object that must still be there. If it has been
;; removed, the program stops with a message.
(require-unqualified c "../../c/c.sub")
(require-unqualified store "../../web/game/store.sub")
(memory from c)
(table from c)

(struct enemy [health i32])
(define enemies (store enemy))

(define (main)
  (let ([h (store-handle (& enemies) (store-add! (& enemies)))])
    (set! (-> (store-get (& enemies) h) health) 3)
    (store-remove! (& enemies) h)
    (print-string "before\n")
    (set! (-> (store-get (& enemies) h) health) 2)
    (print-string "not reached\n")))
