;; Two types can have the same name (spec 5.1), and when they are different
;; types the error says so: make-box lifts a box with an i64 field, which
;; the module's box, with an i32 field, is not.
(begin-for-syntax
  (require s syntax)
  (func (make-box [stx i32]) -> i32
    (drop (s:syntax-local-lift-definition (quote-syntax-datum (type box (struct (field v i64))))))
    (quote-syntax-datum (struct.new box 1))))
(define-syntax make-box make-box)

(type box (struct (field v i32)))
(func (unbox [b (ref box)]) -> i32 (struct.get box v b))

(func (main) (drop (unbox (make-box))))
