;; raise-syntax-error from a macro, blamed on the offending identifier.
(begin-for-syntax (require s syntax))
(define-syntax point (quote-datum (x y)))
(begin-for-syntax
  (func (field-index [stx i32]) -> i32
    (let* ([parts (s:syntax->list stx)]
           [fields (s:syntax-local-value (s:cadr parts))]
           [field (s:syntax-e (s:caddr parts))]
           [i 0])
      (block done
        (loop next
          (if (s:null? fields) (s:raise-syntax-error (quote-datum #f) (quote-datum "no such field") (s:caddr parts)))
          (br-if done (i32.eq (s:car fields) field))
          (set! fields (s:cdr fields))
          (set! i (i32.add i 1))
          (br next)))
      (s:datum->syntax stx (s:make-integer (i64.extend_i32_u i)) stx))))
(define-syntax field-index field-index)

(func (main) (drop (field-index point z)))
