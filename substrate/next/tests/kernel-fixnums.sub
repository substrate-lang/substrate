;; The kernel module's fixnums (next/compiler/kernel.sub): an integer from
;; -2^30 to 2^30 - 1 is kept in the datum itself, so equal fixnums are one
;; datum and making one allocates nothing; a larger integer is a cell.
(require-unqualified c "../c/c.sub")
(require-unqualified kd "../compiler/kernel.sub")
(require print "../../lib/print.sub" write-int write-i64 newline)
(memory from c)
(table from c)

(define (show [n i32]) (write-int n) (newline))

(define (main)
  (show (== (make-integer 5) (make-integer 5)))
  (show (== (fixnum 5) '5))
  (show (fixnum? (make-integer 1073741823)))
  (show (fixnum? (make-integer -1073741824)))
  (show (fixnum? (make-integer 1073741824)))
  (show (fixnum? (make-integer -1073741825)))
  (write-i64 (integer-value (make-integer -7))) (newline)
  (write-i64 (integer-value (make-integer 1073741824))) (newline)
  (write-i64 (integer-value (make-unsigned-integer 18446744073709551615))) (newline)
  (show (integer-negative? (make-integer -1)))
  (show (integer-negative? (make-unsigned-integer 18446744073709551615)))
  (show (integer? (make-integer 3)))
  (show (pair? (make-integer 3)))
  (show (equal? (make-integer 12) '12))
  (show (== (datum-hash (make-integer 12)) (datum-hash '12)))
  (write-datum (cons (make-integer -3) (cons (make-integer 1073741824) nil))) (newline)
  (use-heap!)
  (drop (make-integer 9))
  (show (live-cells))
  (dup (make-integer 9))
  (show (live-cells)))
