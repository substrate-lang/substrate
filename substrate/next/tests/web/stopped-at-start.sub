;; A test page for a game that traps while it is being set up.
;; next/tests/web/pages.mjs runs it in a browser.
;;
;; The game's init function stops the program (next/web/game/trap.sub). The game
;; loop (next/web/game/game.sub) must show the report on the page, and
;; must not call the step or draw functions, which would be working on a
;; world that was never set up.
(require-unqualified c "../../c/c.sub")
(require-unqualified trap "../../web/game/trap.sub")
(require-unqualified input "../../web/game/input.sub")
(require-unqualified game "../../web/game/game.sub")
(memory from c)
(table from c)

(struct world [ready i32])

(define (start! [w (ptr world)])
  (trap-format "the level file ~s is missing" "assets/levels/1.txt")
  (set! (-> w ready) 1))

;; If either of these ran, it would trap with a different message, which
;; the test would see.
(define (step! [w (ptr world)] [in (ptr input)])
  (unless (-> w ready) (trap "step was called for a world that was not set up")))

(define (draw [w (ptr world)])
  (unless (-> w ready) (trap "draw was called for a world that was not set up")))

(game world [size 64 36] start! step! draw)
