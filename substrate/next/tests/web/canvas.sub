;; A test page for canvas drawing, window listeners and animation frames
;; (next/web/ui.sub, next/web/canvas.sub). next/tests/web/pages.mjs runs it
;; in a browser.
;;
;; The page has a white canvas. Clicking the canvas draws a red square
;; where the click was, which tests [draw ...] and the mouse position in
;; a message, (event x) and (event y).
;;
;; The "toggle" button shows or hides a small "animating" label. The label
;; carries two window listeners: one counts animation frames, the other
;; counts keys pressed anywhere on the page. While the label is hidden,
;; both counts must stop: removing an element removes its window
;; listeners.
;;
;; The paragraph "shown" displays the model as
;; "X,Y clicks N frames N keys N", so the test can read it.
(require-unqualified c "../../c/c.sub")
(require-unqualified ui "../../web/ui.sub")
(require-unqualified web "../../web/web.sub")
(require-unqualified canvas "../../web/canvas.sub")
(memory from c)
(table from c)

(struct model [x i32] [y i32] [clicks u32] [frames u32] [keys u32] [animating i32])
(variant message [pointed [x i32] [y i32]] [tick [time f64]] [pressed] [toggle])
(messages message)

(define (init [m (ptr model)]) 0)

(define (update [m (ptr model)] [e (ptr message)])
  (match e
    [(pointed x y)
     (set! (-> m x) x)
     (set! (-> m y) y)
     (+= (-> m clicks) 1)]
    ;; A frame's time is never 0 in a browser, so a count that grows shows
    ;; that real frames arrive with their time.
    [(tick time) (when (> time 0.0) (+= (-> m frames) 1))]
    [pressed (+= (-> m keys) 1)]
    [toggle (set! (-> m animating) (not (-> m animating)))]))

;; A white background, and a red square, 10 pixels wide, centred on the
;; last click.
(define (paint [m (ptr model)])
  (fill-style "white")
  (fill-rect 0 0 200 100)
  (when (> (-> m clicks) 0)
    (fill-style "red")
    (fill-rect (- (-> m x) 5) (- (-> m y) 5) 10 10)))

(view (page [m (ptr model)])
  (canvas ([id "board"] [width 200] [height 100]
           [draw (-> m clicks) (paint m)]
           [on click (pointed (event x) (event y))]))
  (button ([id "toggle"] [on click toggle]) "toggle")
  (when (-> m animating)
    (span ([id "label"]
           [on-window frame (tick (event time))]
           [on-window keydown pressed])
      "animating"))
  (p ([id "shown"])
    (int (-> m x)) "," (int (-> m y)) " clicks " (int (-> m clicks))
    " frames " (int (-> m frames)) " keys " (int (-> m keys))))

(app model message init update page)
