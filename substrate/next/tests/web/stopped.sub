;; A test page for a game that traps. next/tests/web/pages.mjs runs it in
;; a browser.
;;
;; The game draws a green screen, and on its twentieth step asks a vector
;; for an item that it does not have, which stops the program
;; (next/web/game/vector.sub). The game loop (next/web/game/game.sub) must then
;; stop stepping and show the report of the trap on the page.
(require-unqualified c "../../c/c.sub")
(require-unqualified vector "../../web/game/vector.sub")
(require-unqualified canvas "../../web/canvas.sub")
(require-unqualified input "../../web/game/input.sub")
(require-unqualified game "../../web/game/game.sub")
(memory from c)
(table from c)

(struct world [steps u32] [numbers (vector u32)])

(define (start! [w (ptr world)]) (vector-push! (& (-> w numbers)) 1))

(define (step! [w (ptr world)] [in (ptr input)])
  (+= (-> w steps) 1)
  (when (== (-> w steps) 20) (vector-at (& (-> w numbers)) 5)))

(define (draw [w (ptr world)])
  (fill-style "#2e7d32")
  (fill-rect 0 0 64 36))

(game world [size 64 36] start! step! draw)
