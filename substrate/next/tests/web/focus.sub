;; A page whose patches cause events (next/tests/web/pages.mjs checks it):
;; the field is given the focus each time turns changes, by a patch of the
;; batch that shows the change, and the program listens for the focus. So
;; it is given that event while the host is applying its batch, and
;; handles it with a batch of its own; the first batch's patches are
;; applied once, whose copy, of the when's child, would show twice if not.
(require-unqualified c "../../c/c.sub")
(require-unqualified ui "../../web/ui.sub")
(require-unqualified web "../../web/web.sub")
(memory from c)
(table from c)

(struct model [turns u32] [focused u32] [blurred u32])
(variant message [turn] [got-focus] [lost-focus])
(messages message)

(define (init [m (ptr model)]) (set! (-> m turns) 0))

(define (update [m (ptr model)] [e (ptr message)])
  (match e
    [turn (+= (-> m turns) 1)]
    [got-focus (+= (-> m focused) 1)]
    [lost-focus (+= (-> m blurred) 1)]))

(view (page [m (ptr model)])
  (button ([id "turn"] [on click turn]) "turn")
  (input ([id "field"] [focus (-> m turns)] [on focus got-focus] [on blur lost-focus]))
  (p ([id "counts"]) (int (-> m turns)) " " (int (-> m focused)) " " (int (-> m blurred)))
  (when (> (-> m turns) 0) (span ([class "mark"]) "turned")))

(app model message init update page)
