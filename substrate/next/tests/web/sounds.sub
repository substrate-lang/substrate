;; A test page for sound files. next/tests/web/pages.mjs runs it in a
;; browser.
;;
;; The game loads assets/beep.wav, a tenth of a second of a tone, and a
;; file that does not exist, which must not keep the game from starting.
;; It asks for the sound as music straight away, as a game with background
;; music does. A browser allows no sound before the first key press, so
;; the music must start by itself when a key is pressed. S stops the
;; music, M starts it again, and Space plays the sound once. The screen is
;; green once the game is stepping.
(require-unqualified c "../../c/c.sub")
(require-unqualified canvas "../../web/canvas.sub")
(require-unqualified input "../../web/game/input.sub")
(require-unqualified sound "../../web/game/sound.sub")
(require-unqualified game "../../web/game/game.sub")
(memory from c)
(table from c)

(struct world [beep u32] [steps u32])

(define (start! [w (ptr world)])
  (set! (-> w beep) (load-sound "assets/beep.wav"))
  (load-sound "assets/nothing.wav")
  (play-music (-> w beep) 0.3))

(define (step! [w (ptr world)] [in (ptr input)])
  (+= (-> w steps) 1)
  (when (pressed? in key-space) (play-sound (-> w beep) 0.5))
  (when (pressed? in #\m) (play-music (-> w beep) 0.3))
  (when (pressed? in #\s) (stop-music)))

(define (draw [w (ptr world)])
  (fill-style (if (> (-> w steps) 0) "#2e7d32" "#444444"))
  (fill-rect 0 0 64 36))

(game world [size 64 36] start! step! draw)
