;; A game that draws many sprites, to measure a renderer. sprites.sub
;; puts it in a page drawn by the GPU, sprites-canvas.sub in one drawn
;; by the 2D canvas; next/tests/web/sprites.mjs times the frames of
;; each, and next/tests/web/pages.mjs checks that both draw the right
;; thing.
;;
;; The screen is 640 by 360 pixels. The number of sprites is the
;; program's first argument (the page takes it from the address, ?n=...).
;; Each sprite is a cell of the platformer's sprite sheet, moving across
;; the screen and bouncing off its edges; half of them face the other
;; way, which is drawn mirrored. Sprite 0 stands still at (8, 8) and is
;; the grass tile, so that a test can look at a known pixel. The number
;; of sprites is written at the top left.
(require-unqualified c "../../c/c.sub")
(require-unqualified draw "../../web/game/draw.sub")
(require-unqualified input "../../web/game/input.sub")
(require-unqualified format "../../web/game/format.sub")

(provide world world-init! world-step! world-draw)

(memory from c)
(table from c)

(import host-arg "host" "arg" (i32 i32 i32 -> i32))

(struct sprite [x f64] [y f64] [dx f64] [dy f64] [cell u32])
(struct world [count u32] [sprites (ptr sprite)] [sheet u32] [label (array u8 32)])

(define screen-width f64 640.0)
(define screen-height f64 360.0)

(define seed u32 2463534242)
(define (random) -> u32
  (set! seed (bit-xor seed (<< seed 13)))
  (set! seed (bit-xor seed (>> seed 17)))
  (set! seed (bit-xor seed (<< seed 5)))
  seed)

;; The first command-line argument as a number, or `otherwise` if there
;; is none.
(define (argument-number [otherwise u32]) -> u32
  (let ([text (array u8 32)] [n u32 0])
    (let ([length (host-arg 0 (cast i32 text) 31)])
      (when (<= length 0) (return otherwise))
      (for ([i i32 0]) (< i length) (+= i 1)
        (set! n (+ (* n 10) (- (cast u32 (@ text i)) 48))))
      n)))

(define (world-init! [w (ptr world)])
  (set! (-> w sheet) (load-sheet "assets/sprites.png" 16.0 16.0))
  (set! (-> w count) (argument-number 1000))
  (format-into (-> w label) 32 "~d sprites" (-> w count))
  (set! (-> w sprites) (cast (ptr sprite) (calloc (-> w count) (sizeof sprite))))
  (for ([i u32 0]) (< i (-> w count)) (+= i 1)
    (let ([s (+ (-> w sprites) i)])
      (set! (-> s x) (cast f64 (% (random) 624)))
      (set! (-> s y) (cast f64 (% (random) 344)))
      (set! (-> s dx) (- (cast f64 (% (random) 5)) 2.0))
      (set! (-> s dy) (- (cast f64 (% (random) 5)) 2.0))
      ;; The player's and the enemy's pictures: cells 8 to 13.
      (set! (-> s cell) (+ 8 (% (random) 6)))))
  (when (> (-> w count) 0)
    (let ([s (-> w sprites)])
      (set! (-> s x) 8.0)
      (set! (-> s y) 8.0)
      (set! (-> s dx) 0.0)
      (set! (-> s dy) 0.0)
      (set! (-> s cell) 0))))

(define (world-step! [w (ptr world)] [in (ptr input)])
  (for ([i u32 0]) (< i (-> w count)) (+= i 1)
    (let ([s (+ (-> w sprites) i)])
      (+= (-> s x) (-> s dx))
      (+= (-> s y) (-> s dy))
      (when (or (< (-> s x) 0.0) (> (-> s x) (- screen-width 16.0))) (set! (-> s dx) (- 0.0 (-> s dx))))
      (when (or (< (-> s y) 0.0) (> (-> s y) (- screen-height 16.0))) (set! (-> s dy) (- 0.0 (-> s dy)))))))

(define (world-draw [w (ptr world)])
  (fill-screen #x8fd3ffff)
  (for ([i u32 0]) (< i (-> w count)) (+= i 1)
    (let ([s (+ (-> w sprites) i)])
      (draw-sprite (-> w sheet) (-> s cell) (floor (-> s x)) (floor (-> s y)) (< (-> s dx) 0.0))))
  (text-color #x10141aff)
  (draw-text (-> w label) 24.0 8.0))
