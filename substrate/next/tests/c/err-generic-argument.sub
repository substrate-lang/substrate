;; An argument that does not fit a type parameter's type, once that type
;; is known from an earlier argument, is reported with the actual types,
;; not with the parameter's name.
(require-unqualified c "../../c/c.sub")
(memory from c)
(table from c)

(struct #:forall (T) box [value T])
(define #:forall (T) (same? [a (ptr (box T))] [b (ptr (box T))]) -> i32 (== (-> a value) (-> b value)))
(define (main)
  (let ([x (box i32)] [y (box f64)])
    (same? (& x) (& y))))
