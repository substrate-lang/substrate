;; The arguments of a call of a generic function, and of a generic
;; variant's construction. generic-arguments.out is the expected output.
;;
;; A type parameter takes its type from the arguments, from left to
;; right, except that a number written out does not decide a type
;; parameter when another argument does. Once a parameter's type is
;; known, its argument is accepted as an ordinary function's would be: a
;; number written out takes that type, and a number of another type is
;; converted.
(require-unqualified c "../../c/c.sub")
(require print "../../../lib/print.sub" write-int write-byte newline)
(memory from c)
(table from c)

(define (show [x i32]) (write-int x) (write-byte 32))

(struct #:forall (T) box [value T])

(define #:forall (T) (fill! [b (ptr (box T))] [x T]) (set! (-> b value) x))
;; The same, with the value first.
(define #:forall (T) (put! [x T] [b (ptr (box T))]) (set! (-> b value) x))
;; Two arguments of the type parameter's type.
(define #:forall (T) (sum [a T] [b T]) -> T (+ a b))
;; A pointer to T: 0 (a null pointer) must be accepted for it.
(define #:forall (T) (first-or [p (ptr T)] [b (ptr (box T))]) -> T (if p (@ p) (-> b value)))

(variant #:forall (T) pair [two [a T] [b T]])

(define (main)
  (let ([u (box u32)] [small (box u8)] [f (box f32)] [d (box f64)] [i (box i32)] [n i32 7] [m u32 9] [big u32 4000000000])
    ;; A number written out takes the type the box gives it.
    (fill! (& u) 5)
    (fill! (& small) 200)
    (fill! (& f) 1.5)
    (fill! (& d) 2.5)
    (show (-> u value))
    (show (-> small value))
    (show (cast i32 (* 10.0 (-> f value))))
    (show (cast i32 (* 10.0 (-> d value))))
    ;; So does one that comes before the box.
    (put! 6 (& u))
    (put! 2.5 (& f))
    (show (-> u value))
    (show (cast i32 (* 10.0 (-> f value))))
    ;; A number of another type is converted, as an ordinary function
    ;; converts its arguments, once the box has decided T.
    (fill! (& u) n)
    (show (-> u value))
    (fill! (& small) n)
    (show (-> small value))
    (fill! (& d) n)
    (show (cast i32 (-> d value)))
    ;; A variable that comes first decides T itself, since it has a type
    ;; of its own: here T is i32, so the box must be a box of i32.
    (put! n (& i))
    (show (-> i value))
    ;; The first argument with a type of its own decides T: here u32, so
    ;; the sum is a u32, and a number written out takes that type.
    (show (cast i32 (/ (sum big 294967295) 1000000000)))
    (show (sum 1 2))
    ;; A null pointer for a (ptr T).
    (show (first-or 0 (& u)))
    (show (first-or (& m) (& u)))
    ;; A generic variant's construction works the same way.
    (match (two 3 big) [(two a b) (show (cast i32 (/ (+ a b) 1000000000)))])
    (match (two big 3) [(two a b) (show (cast i32 (/ (+ a b) 1000000000)))])
    (match (two 3 4) [(two a b) (show (+ a b))])
    (newline)))
