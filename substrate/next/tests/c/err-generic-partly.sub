;; When an argument's type does not even have the shape of its
;; parameter's, the message shows the parameter's type with the type
;; parameters that are known already filled in.
(require-unqualified c "../../c/c.sub")
(memory from c)
(table from c)

(struct #:forall (T) box [value T])
(struct #:forall (T U) pair [a T] [b U])
(define #:forall (T U) (join [a (ptr (box T))] [b (ptr (pair T U))]) -> i32 0)
(define (main)
  (let ([x (box i32)] [n 5])
    (join (& x) (& n))))
