;; The C example's generics (examples/c/lang.sub): functions and types
;; with type parameters, an instance of each made at the types a use
;; gives them.
(require-unqualified c "../../c/c.sub")
(require print "../../../lib/print.sub" write-int write-byte newline)
(memory from c)
(table from c)

(define (show [x i32]) (write-int x) (write-byte 32))

(define #:forall (T) (swap [a (ptr T)] [b (ptr T)])
  (let ([t T (@ a)])
    (set! (@ a) (@ b))
    (set! (@ b) t)))

;; An array that grows, of any type of item.
(struct #:forall (T) vec [items (ptr T)] [count u32] [capacity u32])

(define #:forall (T) (clear [v (ptr (vec T))])
  (set! (-> v items) 0)
  (set! (-> v count) 0)
  (set! (-> v capacity) 0))

(define #:forall (T) (push [v (ptr (vec T))] [x T])
  (when (== (-> v count) (-> v capacity))
    (set! (-> v capacity) (if (== (-> v capacity) 0) 4 (* 2 (-> v capacity))))
    (set! (-> v items) (realloc (-> v items) (* (-> v capacity) (sizeof T)))))
  (set! (@ (-> v items) (-> v count)) x)
  (+= (-> v count) 1))

(define #:forall (T) (get [v (ptr (vec T))] [i u32]) -> T (@ (-> v items) i))

(variant #:forall (T) option [none] [some [value T]])

;; The first item at least n, if there is one.
(define #:forall (T) (first-from [v (ptr (vec T))] [n T]) -> (option T)
  (let ([found (option T) none])
    (for ([i u32 0]) (< i (-> v count)) (+= i 1)
      (when (>= (get v i) n)
        (set! found (some (get v i)))
        (break)))
    found))

(define (main)
  (let ([a 1] [b 2])
    (swap (& a) (& b))
    (show a)
    (show b))
  (let ([x f64 1.5] [y f64 2.5])
    (swap (& x) (& y))
    (show (cast i32 (* 10 x))))
  (let ([v (vec i32)])
    (clear (& v))
    (for ([i 0]) (< i 10) (+= i 1) (push (& v) (* i i)))
    (show (get (& v) 9))
    (show (-> v count))
    (match (first-from (& v) 50) [(some x) (show x)] [none (show -1)])
    (match (first-from (& v) 100) [(some x) (show x)] [none (show -1)]))
  (let ([words (vec (ptr u8))])
    (clear (& words))
    (push (& words) "one ")
    (push (& words) "two ")
    (print-string (get (& words) 1)))
  (let ([f (fn ((ptr i32) (ptr i32))) (inst swap i32)] [a 3] [b 4])
    (f (& a) (& b))
    (show (- a b)))
  (newline))
