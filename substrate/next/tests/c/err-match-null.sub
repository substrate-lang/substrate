;; A match of a variant, not a pointer to one, has no #f clause.
(require-unqualified c "../../c/c.sub")
(memory from c)
(table from c)

(variant shape [circle [r i32]] [square [side i32]])

(define (area [s shape]) -> i32
  (match s
    [#f 0]
    [(circle r) r]
    [(square side) side]))

(define (main) (area (circle 1)))
