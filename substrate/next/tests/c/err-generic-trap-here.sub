;; A trap inside an instance of a generic function defined in this file
;; is reported in this file, even when the function's body is a single
;; expression, whose own location the function's definition stands in for.
(require-unqualified c "../../c/c.sub")
(memory from c)
(table from c)
(struct #:forall (T) box [value T])
(define #:forall (T) (ratio [b (ptr (box T))] [d i32]) -> i32 (/ 100 d))
(define b (box i32))
(define (main) (ratio (& b) 0))
