;; Macros written in Substrate (next/cells/substrate.sub): define-syntax with a
;; Substrate procedure, written there or computed, which runs at phase 1 in
;; the module that defines it, with helper functions there too. Hygienic:
;; swap!'s tmp captures nothing.
;; while and for come from another module (tests/fixtures/substrate-loops.sub).
(require-unqualified substrate "../../cells/substrate.sub")
(begin-for-syntax (require-unqualified substrate "../../cells/substrate.sub"))
(require loops "fixtures/substrate-loops.sub" while for in)

(define-syntax (swap! stx)
  (let ([parts (syntax->list stx)])
    #`(let ([tmp #,(cadr parts)])
        (set! #,(cadr parts) #,(caddr parts))
        (set! #,(caddr parts) tmp))))

;; (my-or e ...), recursively.
(define-syntax my-or
  (lambda (stx)
    (let ([args (cdr (syntax->list stx))])
      (cond [(null? args) #'#f]
            [(null? (cdr args)) (car args)]
            [else #`(let ([t #,(car args)]) (if t t (my-or #,@(cdr args))))]))))

;; Transformers are values: one made by a procedure, one by a lambda inside
;; a let. Each use becomes the number.
(begin-for-syntax
  (define (constant-macro n) (lambda (stx) (datum->syntax stx n))))
(define-syntax seven (constant-macro 7))
(define-syntax eight (let ([n 8]) (lambda (stx) (datum->syntax stx n))))

(define (run)
  (let ([a 1] [b 2] [tmp 3])
    (swap! a b)
    (swap! tmp a)
    (display (list a b tmp)) (newline))
  (let ([t 5])
    (display (list (my-or #f t) (my-or) (my-or #f #f 7))) (newline))
  (let ([i 0] [acc '()])
    (while (< i 3) (set! acc (cons i acc)) (set! i (+ i 1)))
    (for x in '(a b c) (set! acc (cons x acc)))
    (display acc) (newline))
  (display (list (seven) (eight))) (newline))

(func (main) (run))
