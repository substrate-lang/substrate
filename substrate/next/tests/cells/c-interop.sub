;; A macro written in Substrate calls a function written in the C-like
;; Lisp on its syntax (fixtures/count-c.sub), and gives its result, a
;; datum, back to the expander: Substrate's values are the kernel module's
;; cells, so nothing is converted.
(require-unqualified substrate "../../cells/substrate.sub")
(begin-for-syntax
  (require-unqualified substrate "../../cells/substrate.sub")
  (require cf "fixtures/count-c.sub" count-items))

(define-syntax (count stx) (datum->syntax stx (count-items stx) stx))

(define (main) (write (list (count) (count a b c) (+ (count x) 10))) (newline))
