;; A Substrate lambda in a kernel function captures a parameter, an i32 it
;; also assigns: its calls share it, in a box (next/cells/lower.sub).
(require-unqualified substrate "../../cells/substrate.sub")
(func (count-from [n i32]) -> i32 (lambda () (set! n (i32.add n n)) (fixnum n)))
(define (run) (let ([c (count-from (i32.const 3))]) (c) (display (c)) (newline)))
(func (main) (run))
