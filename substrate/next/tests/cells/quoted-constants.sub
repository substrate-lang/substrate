;; Quoted data in kernel globals, as tests/quoted-constants.sub: the
;; kernel's quote makes the kernel module's cells, which are Substrate's
;; values on cells, when the module starts, so the globals are mutable.
(require print "../../../lib/print.sub" newline)
(require sub "../../cells/substrate.sub" write cons)

(global empty (mut i32) '())
(global yes (mut i32) '#t)
(global no (mut i32) '#f)
(global five (mut i32) '5)
(global built (mut i32) '(1 2))

(func (main)
  (write (cons five (cons yes (cons no empty)))) (print:newline)
  (write built) (print:newline))
