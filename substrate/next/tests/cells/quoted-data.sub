;; Quoted data, the kernel module's cells, is made when the module starts,
;; as tests/quoted-data.sub: each kind of datum survives, and equal symbols
;; are one cell.
(require kd "../../compiler/kernel.sub" flonum-value)
(require print "../../../lib/print.sub" write-int newline)
(require sub "../../cells/substrate.sub" write)

(func (show [x i32]) (write x) (print:newline))

(func (main)
  (show '(a "b" #\c -7 1073741824 -9223372036854775808 18446744073709551615 (#t #f ()) 2.5))
  (show '(lambda (x) (f x "s" 3)))
  (print:write-int (i32.eq 'same 'same)) (print:newline)
  (print:write-int (f64.eq (kd:flonum-value '2.5) 2.5)) (print:newline))
