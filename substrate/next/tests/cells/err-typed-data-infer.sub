;; A constructor takes its data type's types from its arguments' types or
;; from the type its place expects (examples/typed/typed.sub); a let's
;; variable expects none, so None's is given with inst.
(require-unqualified typed "typed/typed.sub")
(data (Option T) [None] [Some T])
(define (f) : Int (let ([o None]) 0))
(func (main) (drop (f)))
