;; A generic is checked where it is defined, its type parameters types of
;; their own (examples/typed/typed.sub): bad adds 1 to a T, used or not.
(require-unqualified typed "typed/typed.sub")
(define #:forall (T) (bad [x : T]) : T
  (+ x 1))
(define (f) : Int (if (bad #t) 1 0))
(func (main) (drop (f)))
