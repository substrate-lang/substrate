;; A define-syntax's value can be computed from the values of those
;; before it (spec 3.1): b's from a's, and c's from m's, a lambda's,
;; which waits to run with other lambdas until c needs it.
(require-unqualified substrate "../../cells/substrate.sub")
(begin-for-syntax (require-unqualified substrate "../../cells/substrate.sub"))

(define-syntax a 5)
(define-syntax b (+ 1 (syntax-local-value #'a)))
(define-syntax (m stx) (datum->syntax stx (syntax-local-value #'b) stx))
(define-syntax c (transformer? (syntax-local-value #'m)))
(define-syntax (n stx) (datum->syntax stx (syntax-local-value #'c) stx))

(define (run) (write (list (m) (n))) (newline))
(func (main) (run))
