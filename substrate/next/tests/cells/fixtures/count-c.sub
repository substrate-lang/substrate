;; Fixture: a function written in the C-like Lisp on syntax, for a macro
;; written in Substrate (next/tests/cells/c-interop.sub): both work on the
;; kernel module's cells, so the macro calls it as it calls any function.
(require-unqualified c "../../../c/c.sub")
(require-unqualified kd "../../../compiler/kernel.sub")
(provide count-items)
(memory from c)
(table from c)

;; The number of elements of syntax list s after its head, as a datum.
(define (count-items [s datum]) -> datum (make-integer (- (length (syntax->list s)) 1)))
