;; A macro can handle a syntax error from local-expand, the expander's or
;; another macro's, and expansion goes on (spec 2.3).
(require-unqualified substrate "../../cells/substrate.sub")
(begin-for-syntax (require-unqualified substrate "../../cells/substrate.sub"))

;; (or-else e fallback): e, or fallback if e does not expand.
(define-syntax (or-else stx)
  (let ([parts (syntax->list stx)])
    (with-handlers ([syntax-error? (lambda (e) (car (cdr (cdr parts))))])
      (local-expand (car (cdr parts))))))

(define-syntax (fails stx) (raise-syntax-error #f "never expands" stx))

(define (main)
  (write (or-else undefined-name 1)) (newline)
  (write (or-else (fails) 2)) (newline)
  (write (or-else (lambda (x) (undefined-too x)) 3)) (newline)
  (write (or-else (+ 1 2) 4)) (newline)
  (write ((lambda (x) (let loop ([i x]) (if (> i 0) (loop (- i 1)) i))) 5)) (newline))
