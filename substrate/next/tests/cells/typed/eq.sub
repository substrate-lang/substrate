;; Lifecycle: example. A trait of the typed example (typed.sub), its impls
;; for Int and Bool, which it defines, and a generic that needs it.
(require-unqualified typed "typed.sub")
(provide Eq eq ne)

(trait (Eq T) [eq : (-> T T Bool)])
(impl (Eq Int) [eq (a b) (= a b)])
(impl (Eq Bool) [eq (a b) (if a b (if b #f #t))])

(define #:forall ((T Eq)) (ne [a : T] [b : T]) : Bool (if (eq a b) #f #t))
