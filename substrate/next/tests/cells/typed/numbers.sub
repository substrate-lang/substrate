;; Lifecycle: example. Functions of the typed example (typed.sub) that
;; another module imports, with their types.
(require-unqualified typed "typed.sub")
(require e "eq.sub" Eq eq)
(provide square compose twice iterate Both swap)

(define (square [x : Int]) : Int (* x x))

;; A lambda that captures two function values.
(define (compose [f : (-> Int Int)] [g : (-> Int Int)]) : (-> Int Int)
  (lambda ([x : Int]) (f (g x))))

(define (twice [f : (-> Int Int)] [x : Int]) : Int (f (f x)))

;; A generic, for another module to use at its types: f applied n times,
;; starting from x.
(define #:forall (T) (iterate [n : Int] [f : (-> T T)] [x : T]) : T
  (if (= n 0) x (iterate (- n 1) f (f x))))
;; A data type, and a generic on it. A module can use swap without
;; importing Pair: the type comes in swap's signature.
(data (Pair A B) [Both A B])
(define #:forall (A B) (swap [p : (Pair A B)]) : (Pair B A)
  (match p [(Both a b) (Both b a)]))

;; Pair's impl of Eq, from eq.sub, here with Pair: a module that uses both
;; sees it.
(impl #:forall ((A Eq) (B Eq)) (Eq (Pair A B))
  [eq (p q) (match p [(Both a b) (match q [(Both c d) (if (eq a c) (eq b d) #f)])])])
