;; A syntax-match that no clause matches is a syntax error blamed on its
;; subject: "expected" and the patterns, a _ at a pattern's head written as
;; the subject's head.
(require-unqualified substrate "../../cells/substrate.sub")
(begin-for-syntax (require-unqualified substrate "../../cells/substrate.sub"))
(define-syntax (swap! stx)
  (syntax-match stx
    [(_ (? identifier? a) (? identifier? b)) #`(let ([t #,a]) (set! #,a #,b) (set! #,b t))]))
(define (run) (let ([x 1]) (swap! x 2)))
(func (main) (run))
