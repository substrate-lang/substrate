;; A generic's type parameters are inferred from its arguments' types
;; (examples/typed/typed.sub); one its arguments do not show is given
;; with inst.
(require-unqualified typed "typed/typed.sub")
(define #:forall (T) (nothing [n : Int]) : Int n)
(define (f) : Int (nothing 1))
(func (main) (drop (f)))
