;; quote-syntax-datum prunes the scopes of local binding forms (spec 6.2),
;; as quote-syntax does, so a macro can build its output from templates
;; written in different functions, or inside let, and their identifiers
;; refer to each other.
(require print "../../lib/print.sub" write-int newline)

(begin-for-syntax
  (require s syntax)
  (func (use-x) -> i32 (quote-syntax-datum (i32.add x 1)))
  (func (with-x [stx i32]) -> i32
    (let ([body (use-x)])
      (quasisyntax-datum (let ([x 41]) #,body)))))
(define-syntax with-x with-x)

(func (main) (write-int (with-x)) (newline))
