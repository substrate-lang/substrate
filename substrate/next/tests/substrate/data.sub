;; Substrate's data and literals (next/substrate/data.sub), from kernel
;; code: quoted data made as Substrate's values, GC objects, once each.
(require print "../../../lib/print.sub" write-int write-i64 newline)
(require-unqualified d "../../substrate/data.sub")

(func (show [x i32]) (write-int x) (newline))

;; The same literal, each time: one global, made when the module starts.
(func (fruits) -> eqref '(apple pear))

(func (main)
  ;; Symbols and keywords are interned, when the module starts or later.
  (show (ref.eq 'apple (string->symbol (symbol->string 'apple))))
  (show (ref.eq (car (fruits)) 'apple))
  (show (ref.eq '#:key (string->keyword '"key")))
  ;; Strings are UTF-8 bytes.
  (show (string-length '"héllo"))
  (show (string-byte '"abc" 1))
  ;; Lists, nested, of every kind of datum.
  (show (length '(a b (c d) "e" 5 #\x #t #f)))
  (show (fixnum-value (car (cdr (car (cddr '(1 2 (3 4))))))))
  (show (null? '()))
  (show (boolean? '#f))
  (show (ref.eq '#t (car (cdr (cdr '(1 2 #t))))))
  ;; Integers past a fixnum, and past 63 bits; a flonum; a character.
  (write-i64 (integer-value '9007199254740993)) (newline)
  (show (integer-negative? '18446744073709551615))
  (write-i64 (integer-value '18446744073709551615)) (newline)
  (show (i32.trunc_f64_s (f64.mul (flonum-value '2.5) (f64.const 2))))
  (show (char->integer '#\λ))
  ;; One literal, one value.
  (show (ref.eq (fruits) (fruits))))
