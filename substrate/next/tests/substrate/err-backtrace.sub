;; A trap's backtrace gives each frame's source location (spec 3.6): the
;; call of car, inlined, is located where this file calls it. (A frame
;; that made a tail call is gone: the call of car is not one here.)
(require-unqualified substrate "../../substrate/substrate.sub")
(define (first-of x)
  (list (car x)))
(define (main) (first-of 5))
