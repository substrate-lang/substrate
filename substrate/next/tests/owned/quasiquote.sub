;; quasiquote in a module written in Substrate (the kernel's,
;; as substrate.sub provides it): splices, nesting and a dotted tail.
(require-unqualified substrate "../../owned/substrate.sub")
(define (main)
  (let ([xs '(2 3)] [n 4])
    (write `(1 ,@xs ,n (nested ,(car xs)) `(deeper ,(n ,n)) . ,n)) (newline)))
