;; local-binding (spec 2.3): in fully expanded code, a local variable's
;; binder and its uses give the same integer, two variables give
;; different ones, and a global gives #f. (check) expands to 111 if all
;; three hold. Integers in memory are compared with equal?.
(require print "../../lib/print.sub" write-int newline)
(begin-for-syntax
  (require s syntax)
  (func (check [stx i32]) -> i32
    (let* ([e (s:syntax->list (s:local-expand (quote-syntax-datum (let ([x 1] [y 2]) (i32.add x (i32.add y g))))))]
           [bs (s:syntax->list (s:cadr e))]
           [x (s:local-binding (s:car (s:syntax->list (s:car bs))))]
           [y (s:local-binding (s:car (s:syntax->list (s:cadr bs))))]
           [body (s:syntax->list (s:caddr e))]
           [inner (s:syntax->list (s:caddr body))]
           [same (i32.and (i32.ne x 0) (s:equal? x (s:local-binding (s:cadr body))))]
           [different (i32.and (i32.ne y 0) (i32.eqz (s:equal? x y)))]
           [global (i32.eqz (s:local-binding (s:caddr inner)))])
      (s:datum->syntax stx (s:make-integer (i64.extend_i32_u (i32.add (i32.mul 100 same) (i32.add (i32.mul 10 different) global)))) stx))))
(define-syntax check check)

(global g i32 3)
(func (main) (write-int (check)) (newline))
