;; A session in Bend (next/bend): each definition is checked as it is
;; entered, and one that does not check leaves the session as it was. Bend
;; has no #%top-interaction, so a term's value is written with print.
(require-unqualified bend "../../bend/bend.sub")
(require-unqualified base "../../bend/base.sub")
(def (double [+ n : Nat]) Nat (Nat.add n n))
(print (double (nat 21)))
(def (sum [xs : (List Nat)] [acc : Nat]) Nat
  (match xs
    [Nil acc]
    [(Con h t) (sum t (Nat.add h acc))]))
(print (sum (Con (nat 1) (Con (nat 2) (Con (nat 3) Nil))) Zero))
;; n is used twice, and is not marked +.
(def (twice [n : Nat]) Nat (Nat.add n n))
(print (double True))
(print (twice (nat 1)))
(print (double (nat 4)))
