;; A session test in kernel code. `next/sub eval` evaluates this file one
;; form at a time; each form is one input of the session (see "sessions"
;; in next/compiler/expander.sub). It checks that: a definition can be
;; used by later inputs; defining a name again replaces it for later
;; inputs, but code compiled earlier keeps using the old one; a failed
;; input changes nothing; and macros defined by one input work in the next.
(require print "../../../lib/print.sub")
(func (show [n i32]) (print:write-int n) (print:newline))
(func (sq [x i32]) -> i32 (i32.mul x x))
(show (sq 7))
(func (cube [x i32]) -> i32 (i32.mul x (sq x)))
(show (cube 3))
;; Redefine sq. cube was compiled earlier and keeps using the first sq.
(func (sq [x i32]) -> i32 (i32.add x x))
(begin (show (sq 7)) (show (cube 3)))
;; Two inputs that fail to compile. In the second, the first definition is
;; fine and the second is not. Neither input leaves a definition behind.
(show (nope 1))
(begin (func (lost [x i32]) -> i32 x) (func (bad) -> i32 (nope 2)))
(show (lost 1))
(show (sq 100))
;; Defining a name twice within one input is an error, as it is in a file.
(begin (func (twice) -> i32 1) (func (twice) -> i32 2))
;; Global variables, and a type definition.
(global counter (mut i32) 10)
(func (bump) -> i32 (set! counter (i32.add counter 1)) counter)
(begin (show (bump)) (show (bump)))
(type pair (struct (field a i32) (field b i32)))
(func (sum [p (ref pair)]) -> i32 (i32.add (struct.get pair a p) (struct.get pair b p)))
(show (sum (struct.new pair 3 4)))
;; Code that runs at compile time (it prints when it runs), and a macro.
(begin-for-syntax
  (require print "../../../lib/print.sub")
  (require k kernel)
  (print:write-int 111)
  (print:newline)
  (func (double-form [s i32]) -> i32
    (let ([x (k:cadr (k:syntax->list s))]) (k:datum->syntax s (k:cons 'i32.add (k:cons x (k:cons x '()))) s))))
(define-syntax double double-form)
(show (double 21))
;; The session declares its own memory instead of using the compiler's,
;; puts data in it, and a later input changes that data.
(memory 1)
(import host-write "host" "write" (i32 i32 i32 -> i32))
(data greeting 16 "hello\n")
(drop (host-write 1 (data-address greeting) (data-size greeting)))
(begin (i32.store8 17 97) (drop (host-write 1 (data-address greeting) (data-size greeting))))
