;; A session in kernel code (next/compiler/expander.sub, sessions), each
;; form an input, as next/sub eval gives them: a definition is there for
;; the inputs after; one of a name defined before shadows it for them,
;; while code compiled before keeps the one it referred to; an input that
;; fails leaves the session as it was; and compile-time code, a macro
;; among it, works on the input after it, as on a module's next line.
(require print "../../../lib/print.sub")
(func (show [n i32]) (print:write-int n) (print:newline))
(func (sq [x i32]) -> i32 (i32.mul x x))
(show (sq 7))
(func (cube [x i32]) -> i32 (i32.mul x (sq x)))
(show (cube 3))
;; sq again: cube keeps the first.
(func (sq [x i32]) -> i32 (i32.add x x))
(begin (show (sq 7)) (show (cube 3)))
;; An input that does not compile, and one whose first definition does
;; but whose second does not: neither leaves a definition.
(show (nope 1))
(begin (func (lost [x i32]) -> i32 x) (func (bad) -> i32 (nope 2)))
(show (lost 1))
(show (sq 100))
;; Twice in one input is an error, as in a module.
(begin (func (twice) -> i32 1) (func (twice) -> i32 2))
;; Globals, and a type.
(global counter (mut i32) 10)
(func (bump) -> i32 (set! counter (i32.add counter 1)) counter)
(begin (show (bump)) (show (bump)))
(type pair (struct (field a i32) (field b i32)))
(func (sum [p (ref pair)]) -> i32 (i32.add (struct.get pair a p) (struct.get pair b p)))
(show (sum (struct.new pair 3 4)))
;; Compile-time code, which prints as it runs, and a macro.
(begin-for-syntax
  (require print "../../../lib/print.sub")
  (require k kernel)
  (print:write-int 111)
  (print:newline)
  (func (double-form [s i32]) -> i32
    (let ([x (k:cadr (k:syntax->list s))]) (k:datum->syntax s (k:cons 'i32.add (k:cons x (k:cons x '()))) s))))
(define-syntax double double-form)
(show (double 21))
;; A memory of the session's own, in place of the compiler's, and data in
;; it, which an input after changes.
(memory 1)
(import host-write "host" "write" (i32 i32 i32 -> i32))
(data greeting 16 "hello\n")
(drop (host-write 1 (data-address greeting) (data-size greeting)))
(begin (i32.store8 17 97) (drop (host-write 1 (data-address greeting) (data-size greeting))))
