;; A session whose language changes: what a later require-unqualified
;; binds shadows what an earlier one bound, for the inputs after it. And a
;; require of a module that does not compile, which fails each time it is
;; tried, and leaves the session as it was.
(require-unqualified substrate "../../substrate/substrate.sub")
(define (sq x) (* x x))
(sq 7)
(require broken "fixtures/broken.sub")
(sq 8)
(require broken "fixtures/broken.sub")
(require-unqualified c "../../c/c.sub")
(define (cube [x i32]) -> i32 (* x (* x x)))
(cube 3)
(+ (cube 2) 1)
