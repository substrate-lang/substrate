;; A session in Substrate (next/substrate): an expression's value is
;; written, as Substrate's #%top-interaction has it, on a line of its own;
;; an error in an input's code, which traps, is reported with where it
;; was, and the session goes on; macros are defined by patterns.
(require-unqualified substrate "../../substrate/substrate.sub")
(define (sq x) (* x x))
(sq 7)
(map sq '(1 2 3))
(display "hi")
(define counter (let ([n 0]) (lambda () (set! n (+ n 1)) n)))
(counter)
(counter)
(define-syntax swap! (syntax-rules () [(_ a b) (let ([t a]) (set! a b) (set! b t))]))
(define x 1)
(define y 2)
(swap! x y)
(list x y)
(car 5)
(error "my error" 42)
(list x y)
(define (sq x) (* x x x))
(sq 3)
"a string"
'sym
(= 1 2)
(nope)
(begin (define a 10) (define b (+ a 1)) (* a b))
(with-handlers ([exn? (lambda (e) (list 'caught (exn-message e)))]) (car 5))
(struct point (x y))
(point-x (point 3 4))
(let loop ([i 0] [acc '()]) (if (= i 5) (reverse acc) (loop (+ i 1) (cons (* i i) acc))))
