;; datum->syntax gives new syntax a source location (spec 2.3), so an error
;; in code a macro builds points at the code the user wrote: here the use
;; of use-missing, whose expansion names something unbound.
(begin-for-syntax
  (require s syntax)
  (func (use-missing [stx i32]) -> i32
    (s:datum->syntax stx (quote-datum no-such-thing) stx)))
(define-syntax use-missing use-missing)

(func (main) (drop (use-missing)))
