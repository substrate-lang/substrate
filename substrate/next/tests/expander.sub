;; The new compiler's expander (next/compiler/expander.sub): the fully
;; expanded code of modules that need neither compile-time code nor the
;; kernel module, and its errors, the same as the compiler's: code whose
;; meaning the new compiler keeps. This test's .out is what the
;; compiler prints for the files, each after a line naming it:
;;
;;   for f in FILE ...; do echo ";; $f"; bin/sub expand $f 2>&1; done
;;
;; next/compare.sh compares every file of the repository.
(require-unqualified c "../c/c.sub")
(require-unqualified stx "../compiler/kernel.sub")
(require-unqualified ex "../compiler/expander.sub")
(require-unqualified main "../compiler/main.sub")
(require print "../../lib/print.sub" newline)
(memory from c)
(table from c)

;; The file at path, relative to the repository, expanded; or the error
;; expanding it gives, as the compiler writes it.
(define (expand [path datum])
  (print-string ";; ")
  (print:write-bytes (cast i32 (string-bytes path)) (string-length path))
  (newline)
  (try (expand-module-file path (lambda ([f datum]) (print-expanded f)))
       [catch compile-error (message blamed loc)
        (let ([b (make-buffer)])
          (write-compile-error (& b) message blamed loc)
          (print:write-bytes (cast i32 (-> b bytes)) (-> b length))
          (buffer-free! (& b)))]))

(define (main)
  (set-repository-root! `"../..")
  (for-each (lambda ([f datum]) (expand f))
            `("tests/basics.sub" "tests/gc.sub" "tests/hook.sub"
              "tests/func-refs.sub" "tests/subtypes.sub" "tests/rec.sub" "tests/globals.sub"
              "tests/decimals.sub" "tests/namespaces.sub"
              "tests/module-copies.sub" "tests/interface-tags.sub" "tests/provide-all.sub"
              "tests/call-indirect-type.sub" "lib/print.sub"
              "tests/err-unbound.sub" "tests/err-duplicate.sub" "tests/err-type.sub"
              "tests/err-cycle.sub" "tests/err-provide-twice.sub" "tests/err-number-range.sub"
              "tests/err-immutable.sub" "tests/err-uncaught.sub" "tests/err-try-clause.sub"
              "tests/err-type-identity-order.sub"
              "tests/err-global-init.sub" "tests/err-fact-before.sub")))
