;; A syntax property can hold any datum, which stays with the syntax a
;; macro returns: here a list a macro puts on its output, which another
;; macro reads back from the expansion, as tests/syntax-property-object.sub
;; does with a GC struct.
(require print "../../lib/print.sub" write-int newline)
(begin-for-syntax
  (require s syntax)
  ;; (boxed e): e, with (42) in its property box.
  (func (boxed [stx i32]) -> i32
    (s:syntax-property-set (s:cadr (s:syntax->list stx)) (quote-datum box) (quote-datum (42))))
  ;; (unbox-of e): the number in the box on what e expands to.
  (func (unbox-of [stx i32]) -> i32
    (let ([e (s:local-expand (s:cadr (s:syntax->list stx)))])
      (s:datum->syntax stx (s:car (s:syntax-property (found e) (quote-datum box))) stx)))
  ;; The syntax in e that has a box property: e, or its second part.
  (func (found [e i32]) -> i32
    (if (i32.eqz (s:syntax-property e (quote-datum box))) (s:cadr (s:syntax->list e)) e)))
(define-syntax boxed boxed)
(define-syntax unbox-of unbox-of)

(func (main) (write-int (unbox-of (boxed 1))) (newline))
