;; Lifecycle: experimental.
;;
;; Guests: running another program in a sandbox, from the C-like Lisp.
;;
;; A "guest" is a second program that the host runs for this program in
;; an isolated sandbox. The guest has its own memory and its own wasm
;; instances. Nothing is shared: the two programs only exchange messages,
;; which are byte strings that the host copies from one to the other.
;; The guest can therefore run untrusted code. Whatever that code does
;; (loop forever, crash, overwrite memory) happens to the guest, and this
;; program can end the guest at any time.
;;
;; These functions wrap the host module named "guest". A program that
;; requires this file only runs on a host that provides that module. At
;; the moment that is the browser host (host/web/guest.mjs, where a guest
;; is a Web Worker). That file also documents the spec format and the
;; details of each event.
;;
;; Starting and talking to a guest:
;;
;;   (guest-start spec)        Starts a guest. `spec` is text that says
;;                             which program to run and what it may use,
;;                             for example:
;;                               "program /worker\nread /data\ntime 500"
;;                             Returns the guest's number (1 or more), or
;;                             0 if it could not be started; then
;;                             (guest-error) gives the reason.
;;   (guest-send g p n)        Sends the n bytes at p to guest g as one
;;                             message. Returns 0, or -1 if there is no
;;                             guest g (for example, it has ended).
;;   (guest-send-text g s)     The same, for a C string.
;;   (guest-stop g)            Ends guest g immediately, whatever it is
;;                             doing. No more events arrive from it.
;;
;; Hearing from a guest: a program that starts guests defines a function
;;
;;   (define (on-guest [g u32] [kind u32]) ...)
;;
;; The host calls it, by name, each time something happens in guest g.
;; `kind` is one of:
;;
;;   guest-message   the guest sent a message
;;   guest-stdout    the guest wrote to its standard output
;;   guest-stderr    the guest wrote to its standard error
;;   guest-done      the guest finished handling its start-up or one
;;                   message. The data is empty, or, if that work ended in
;;                   a trap (a crash), the trap's message. This event
;;                   arrives even if the guest never sends a reply, so it
;;                   can be used to detect a guest that failed silently.
;;   guest-ended     the guest is gone: it exited, ran out of time, or
;;                   crashed. The data says why, as text.
;;
;; While on-guest runs, these read the data that came with the event:
;;
;;   (guest-take! b)           Appends the data to buffer b and returns
;;                             its length.
;;   (guest-take-text)         Returns the data as a new C string, which
;;                             the caller must free.
;;
;; Being a guest: a guest is an ordinary program. The host calls its
;; `main` once when it starts. Then, for each message from the program
;; that started it, the host calls the guest's function
;;
;;   (define (on-message) ...)
;;
;; during which guest-take! and guest-take-text read the message. A guest
;; replies with (guest-send 0 p n): guest number 0 always means "the
;; program that started me".
(require-unqualified c "../c/c.sub")

(provide guest-start guest-send guest-send-text guest-stop guest-take! guest-take-text guest-error
         guest-message guest-stdout guest-stderr guest-done guest-ended)

(memory from c)
(table from c)

;; The host's functions. Pointers are addresses in this program's memory.
(import start "guest" "start" (i32 i32 -> i32))
(import send "guest" "send" (i32 i32 i32 -> i32))
(import take "guest" "take" (i32 i32 -> i32))
(import stop "guest" "stop" (i32 ->))
(import error-message "host" "error_message" (i32 i32 -> i32))

;; The event kinds that on-guest receives.
(define guest-message u32 1)
(define guest-stdout u32 2)
(define guest-stderr u32 3)
(define guest-done u32 4)
(define guest-ended u32 5)

(define (guest-start [spec (ptr u8)]) -> u32 (cast u32 (start (cast i32 spec) (cast i32 (strlen spec)))))

(define (guest-send [g u32] [p (ptr u8)] [n u32]) -> i32 (send (cast i32 g) (cast i32 p) (cast i32 n)))

(define (guest-send-text [g u32] [s (ptr u8)]) -> i32 (guest-send g s (strlen s)))

(define (guest-stop [g u32]) (stop (cast i32 g)))

;; The host's `take` copies at most `cap` bytes and returns the full
;; length, so calling it with a capacity of 0 just asks for the length.
(define (guest-take-text) -> (ptr u8)
  (let* ([n (cast u32 (take 0 0))] [p (cast (ptr u8) (malloc (+ n 1)))])
    (take (cast i32 p) (cast i32 n))
    (set! (@ p n) 0)
    p))

(define (guest-take! [b (ptr buffer)]) -> u32
  (let ([n (cast u32 (take 0 0))] [p (guest-take-text)])
    (buffer-add! b p n)
    (free p)
    n))

;; Returns the reason the last guest-start failed, as a new C string,
;; which the caller must free.
(define (guest-error) -> (ptr u8)
  (let* ([p (cast (ptr u8) (malloc 1024))] [n (error-message (cast i32 p) 1023)])
    (set! (@ p n) 0)
    p))
