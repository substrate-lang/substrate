;; Lifecycle: experimental.
;;
;; Timers for games: things that happen later.
;;
;; A timer holds a message and a number of steps. When that many steps of
;; the game have passed, the game is handed the message. A message is a
;; value of a variant type that the game defines, with one case for each
;; kind of thing that can happen later:
;;
;;   (variant event
;;     [enemy-gone [who (handle enemy)]]
;;     [restart])
;;
;;   (struct world [timers (timers event)] ...)
;;
;; To make something happen later, set a timer:
;;
;;   ;; An enemy was squashed. Remove it half a second from now.
;;   (after! (& (-> w timers)) 30 (enemy-gone h))
;;
;; and, in the game's step function, let a step pass and deal with the
;; messages that are due:
;;
;;   (timers-step! (& (-> w timers)))
;;   (let ([e event])
;;     (while (timer-due! (& (-> w timers)) (& e))
;;       (match e
;;         [(enemy-gone who) (store-remove! (& (-> w enemies)) who)]
;;         [restart (load-level! w)])))
;;
;; In all of the following, `t` is a pointer to the timers. Timers whose
;; bytes are all zero are a valid set of no timers, so a field of a struct
;; that starts out as zeros needs no setting up.
;;
;;   (after! t steps message)   Sets a timer: `message` becomes due after
;;                              `steps` more calls of timers-step!. A
;;                              game takes 60 steps a second (game.sub),
;;                              so 30 steps is half a second. 0 counts as
;;                              1: nothing becomes due in the step that
;;                              asks for it.
;;   (timers-step! t)           One step has passed.
;;   (timer-due! t (& m))       If a message is due, copies it to m,
;;                              forgets its timer and returns 1.
;;                              Otherwise returns 0. Messages that are
;;                              due at the same time come out in the
;;                              order in which their timers were set.
;;   (timers-waiting t)         Returns how many timers are set.
;;   (timers-clear! t)          Forgets every timer.
;;   (timers-free! t)           Forgets every timer and gives the memory
;;                              back.
;;
;; Why a message, and not a function to call. In many languages a timer
;; takes a function, which is called when the time comes and which can
;; use the variables that were around when it was written. In this
;; language such a function (a closure) lasts only as long as the call
;; that made it, so it cannot be kept for later. A message does the same
;; job with plain data, and has advantages of its own: every delayed
;; action of the game is listed in one type and handled in one place; a
;; message can be printed, compared and saved; and since it names objects
;; by their handles (store.sub), a message about an object that
;; has been removed in the meantime is harmless.
;;
;; This file uses nothing from the browser, so it also works in a test.
(require-unqualified c "../../c/c.sub")

(provide timers after! timers-step! timer-due! timers-waiting timers-clear! timers-free!)

(memory from c)
(table from c)

;; One timer: how many steps are left before the message is due.
(struct #:forall (M) timer [left u32] [message M])

;; The timers that are set, in the order they were set: `count` of them,
;; in memory with room for `room`.
(struct #:forall (M) timers [items (ptr (timer M))] [count u32] [room u32])

(define #:forall (M) (after! [t (ptr (timers M))] [steps u32] [message M])
  (when (== (-> t count) (-> t room))
    (set! (-> t room) (if (== (-> t room) 0) 8 (* 2 (-> t room))))
    (set! (-> t items) (cast (ptr (timer M)) (realloc (-> t items) (* (-> t room) (sizeof (timer M)))))))
  (let ([item (+ (-> t items) (-> t count))])
    (set! (-> item left) (if (== steps 0) 1 steps))
    (set! (-> item message) message))
  (+= (-> t count) 1))

(define #:forall (M) (timers-step! [t (ptr (timers M))])
  (for ([i u32 0]) (< i (-> t count)) (+= i 1)
    (let ([item (+ (-> t items) i)])
      (when (> (-> item left) 0) (-= (-> item left) 1)))))

;; Takes the first timer that has no steps left. The timers after it move
;; down by one place, which keeps them in order.
(define #:forall (M) (timer-due! [t (ptr (timers M))] [message (ptr M)]) -> i32
  (for ([i u32 0]) (< i (-> t count)) (+= i 1)
    (let ([item (+ (-> t items) i)])
      (when (== (-> item left) 0)
        (set! (@ message) (-> item message))
        (memcpy item (+ item 1) (* (- (- (-> t count) i) 1) (sizeof (timer M))))
        (-= (-> t count) 1)
        (return 1))))
  0)

(define #:forall (M) (timers-waiting [t (ptr (timers M))]) -> u32 (-> t count))

(define #:forall (M) (timers-clear! [t (ptr (timers M))]) (set! (-> t count) 0))

(define #:forall (M) (timers-free! [t (ptr (timers M))])
  (free (-> t items))
  (set! (-> t items) 0)
  (set! (-> t count) 0)
  (set! (-> t room) 0))
