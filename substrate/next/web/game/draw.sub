;; Lifecycle: experimental.
;;
;; Drawing for games: sprites, rectangles and text.
;;
;; A game's draw function (game.sub) calls these. They work the same on
;; either of the renderers a game can choose, the 2D canvas or the GPU,
;; so a game is written once. Positions and sizes are in the pixels of
;; the game's screen, from its top left corner, and colours are 32-bit
;; numbers, #xRRGGBBAA: red, green, blue and opacity, each 0 to 255,
;; such as #x8fd3ffff for a sky blue or #x00000080 for a half-see-through
;; black.
;;
;;   (load-sheet path cell-width cell-height) -> sheet
;;       A sprite sheet: an image file that holds a grid of pictures of
;;       one size, cell-width by cell-height, numbered from 0, left to
;;       right and then top to bottom. `path` is usually one of the
;;       program's assets, such as "assets/sprites.png". Call it from
;;       the game's init function; the game does not start until the
;;       file has arrived. Returns a number that stands for the sheet.
;;   (fill-screen color)
;;       Paints the whole screen. Usually the first thing a frame draws.
;;   (draw-rect x y w h color)
;;       A filled rectangle with its top left corner at (x, y).
;;   (draw-sprite sheet frame x y flip)
;;       Cell `frame` of the sheet, at its own size, with its top left
;;       corner at (x, y). If `flip` is 1 the cell is mirrored left to
;;       right, so that a character drawn facing right can face left.
;;       Positions that are whole numbers keep the picture sharp; floor
;;       them first.
;;   (draw-text text x y)
;;       Text, with the top of its letters at y and, depending on the
;;       alignment, its left edge, its centre or its right edge at x.
;;   (text-font font) (text-color color) (text-align align)
;;       How text is drawn from then on: the font, in CSS syntax, such
;;       as "8px monospace" (the default); the colour (black); the
;;       alignment, "left" (the default), "center" or "right". The font
;;       and the alignment are kept as pointers, so give them as string
;;       literals or strings that last.
;;   (rgb r g b) (rgba r g b a)
;;       A colour from its parts, each 0 to 255.
;;
;; A frame is drawn in the order of the calls: what is drawn later is on
;; top. On the GPU, text is the exception: it is drawn on a see-through
;; canvas that lies over the game's screen, so it is always on top of
;; the sprites, which is what text in a game usually wants anyway.
;;
;; ---- How it works ----
;;
;; On the canvas renderer, each function is a call of ../canvas.sub: a
;; sheet is an image, a rectangle is fill-style and fill-rect, text is
;; fill-text. The calls go into the canvas's drawing commands, so they
;; only work while the game's draw function is running.
;;
;; On the GPU, sprites and rectangles go into a batch (sprites.sub) that
;; is drawn with a few commands at the end of the frame, and text is
;; kept until the overlay canvas is drawn, which happens when the page
;; is updated after the frame (draw-overlay!, called from the view that
;; game.sub generates).
;;
;; What game.sub calls:
;;   (draw-start! renderer width height)   once, before the game's init:
;;                                         0 for the canvas, 1 for the GPU
;;   (draw-begin!)                         before the game's draw function
;;   (draw-end! surface)                   after it, on the GPU: draws the
;;                                         batch on the surface
;;   (draw-overlay!)                       from the overlay's [draw ...]
(require-unqualified c "../../c/c.sub")
(require canvas "../canvas.sub")
(require-unqualified gpu "../gpu.sub")
(require-unqualified sprites "sprites.sub")
(require-unqualified format "format.sub")

(provide load-sheet fill-screen draw-rect draw-sprite draw-text text-font text-color text-align rgb rgba
         draw-start! draw-begin! draw-end! draw-overlay!)

(memory from c)
(table from c)

(define (rgb [r u32] [g u32] [b u32]) -> u32 (rgba r g b 255))

(define (rgba [r u32] [g u32] [b u32] [a u32]) -> u32
  (bit-or (<< (bit-and r 255) 24) (<< (bit-and g 255) 16) (<< (bit-and b 255) 8) (bit-and a 255)))

;; ---- The renderer and the screen ----

;; 0 for the canvas, 1 for the GPU.
(define renderer i32 0)
(define screen-width f64 0.0)
(define screen-height f64 0.0)

;; The GPU batch, drawn on the game's screen at the end of each frame.
(define batch sprites)

(define (draw-start! [r i32] [width u32] [height u32])
  (set! renderer r)
  (set! screen-width (cast f64 width))
  (set! screen-height (cast f64 height))
  (when (== r 1) (sprites-init! (& batch))))

;; ---- Sheets ----

;; What load-sheet returns is an index into this table, from 1. `image`
;; is the canvas renderer's image number or the GPU batch's sheet number.
(struct sheet [image u32] [cell-width f64] [cell-height f64])

(define sheets (ptr sheet) 0)
(define sheet-count u32 0)
(define sheet-capacity u32 0)

(define (load-sheet [path (ptr u8)] [cell-width f64] [cell-height f64]) -> u32
  (when (== sheet-count sheet-capacity)
    (set! sheet-capacity (if (== sheet-capacity 0) 8 (* 2 sheet-capacity)))
    (set! sheets (cast (ptr sheet) (realloc sheets (* sheet-capacity (sizeof sheet))))))
  (let ([s (+ sheets sheet-count)])
    (set! (-> s image) (if (== renderer 1) (sprites-sheet! (& batch) path) (canvas:load-image path)))
    (set! (-> s cell-width) cell-width)
    (set! (-> s cell-height) cell-height)
    (+= sheet-count 1)
    sheet-count))

;; ---- A frame ----

(define (draw-begin!)
  (set! told 0)
  (when (== renderer 1)
    (sprites-begin! (& batch))
    (set! (-> overlay length) 0)))

(define (draw-end! [surface u32])
  (when (== renderer 1)
    (sprites-draw! (& batch) gpu-on-surface surface gpu-format-surface
                   (cast u32 screen-width) (cast u32 screen-height) #x000000ff)))

;; A colour as the canvas wants it: "#rrggbbaa", written into `into`,
;; which has room for 10 bytes.
(define (color-text [c u32] [into (ptr u8)]) -> (ptr u8)
  (format-into into 10 "#~08x" c)
  into)

;; A rectangle on the canvas. Its colour replaces the text colour the
;; canvas was told, so the canvas is told again before the next text.
(define (canvas-rect! [x f64] [y f64] [w f64] [h f64] [c u32])
  (let ([text (array u8 10)])
    (canvas:fill-style (color-text c text))
    (canvas:fill-rect x y w h)
    (set! told 0)))

(define (fill-screen [c u32])
  (if (== renderer 1)
      (sprites-rect! (& batch) 0.0 0.0 screen-width screen-height c)
      (canvas-rect! 0.0 0.0 screen-width screen-height c)))

(define (draw-rect [x f64] [y f64] [w f64] [h f64] [c u32])
  (if (== renderer 1)
      (sprites-rect! (& batch) x y w h c)
      (canvas-rect! x y w h c)))

(define (draw-sprite [s u32] [frame u32] [x f64] [y f64] [flip i32])
  (let ([sh (+ sheets (- s 1))])
    (if (== renderer 1)
        (sprites-add! (& batch) (-> sh image) frame (-> sh cell-width) (-> sh cell-height) flip
                      x y (-> sh cell-width) (-> sh cell-height) #xffffffff)
        (canvas:draw-sprite (-> sh image) (-> sh cell-width) (-> sh cell-height) frame x y flip))))

;; ---- Text ----

;; The settings in force, and whether the canvas has been told them
;; since they last changed: it is told when text is drawn.
(define font (ptr u8) "8px monospace")
(define color u32 #x000000ff)
(define align (ptr u8) "left")
(define told i32 0)

(define (text-font [f (ptr u8)]) (set! font f) (set! told 0))
(define (text-color [c u32]) (set! color c) (set! told 0))
(define (text-align [a (ptr u8)]) (set! align a) (set! told 0))

(define (tell-canvas!)
  (unless told
    (let ([text (array u8 10)])
      (canvas:set-font font)
      (canvas:fill-style (color-text color text))
      (canvas:text-align align)
      (canvas:text-baseline "top"))
    (set! told 1)))

;; On the GPU, the frame's text is kept here until the overlay is drawn:
;; for each piece, its settings and position, then its bytes.
(struct kept-text [x f32] [y f32] [color u32] [font (ptr u8)] [align (ptr u8)] [length u32])
(define overlay buffer)
(define kept kept-text)

(define (draw-text [text (ptr u8)] [x f64] [y f64])
  (if (== renderer 1)
      (begin
        (set! (-> kept x) (cast f32 x))
        (set! (-> kept y) (cast f32 y))
        (set! (-> kept color) color)
        (set! (-> kept font) font)
        (set! (-> kept align) align)
        (set! (-> kept length) (strlen text))
        (buffer-add! (& overlay) (cast (ptr u8) (& kept)) (sizeof kept-text))
        (buffer-add! (& overlay) text (-> kept length)))
      (begin
        (tell-canvas!)
        (canvas:fill-text text x y))))

;; Draws the frame's text on the overlay canvas, after clearing it. The
;; settings are given to the canvas when they differ from the piece
;; before. A piece of text is cut to 255 bytes.
(define (draw-overlay!)
  (canvas:clear-rect 0.0 0.0 screen-width screen-height)
  (canvas:text-baseline "top")
  (let ([p (-> overlay bytes)] [end (+ (-> overlay bytes) (-> overlay length))]
        [last-font (ptr u8) 0] [last-color u32 0] [last-align (ptr u8) 0]
        [text (array u8 10)] [copy (array u8 256)])
    (while (< p end)
      (let* ([k (cast (ptr kept-text) p)] [bytes (+ p (sizeof kept-text))] [n (if (< (-> k length) 255) (-> k length) 255)])
        (when (!= (-> k font) last-font)
          (set! last-font (-> k font))
          (canvas:set-font last-font))
        (when (or (!= (-> k color) last-color) (== last-align 0))
          (set! last-color (-> k color))
          (canvas:fill-style (color-text last-color text)))
        (when (!= (-> k align) last-align)
          (set! last-align (-> k align))
          (canvas:text-align last-align))
        (memcpy copy bytes n)
        (set! (@ copy n) 0)
        (canvas:fill-text copy (cast f64 (-> k x)) (cast f64 (-> k y)))
        (set! p (+ bytes (-> k length)))))))
