;; Lifecycle: experimental.
;;
;; Sound for games: sound files, and short synthesized tones, the kind a
;; retro game uses for a jump or a coin.
;;
;; Sound files:
;;
;;   (load-sound path)           starts loading a sound file and returns
;;                               a number that stands for it. `path` is
;;                               usually one of the game's assets, such
;;                               as "assets/coin.wav" (next/web/site.sh);
;;                               it can also be the URL of a sound
;;                               anywhere. Any format that the browser
;;                               can decode will do: WAV, MP3, Ogg. Call
;;                               it once, when the game starts. The game
;;                               loop waits for the file before the first
;;                               step.
;;   (play-sound sound volume)   plays a sound once. `volume` is from 0
;;                               to 1.
;;   (play-music sound volume)   plays a sound again and again, in place
;;                               of any music that was playing.
;;   (stop-music)                stops the music.
;;
;; Tones need no file:
;;
;;   (play-tone wave from to ms volume)
;;
;; plays one tone. `wave` is the shape of the sound wave, which gives the
;; sound its character: square-wave (the classic game beep), sawtooth-wave
;; (harsher), triangle-wave (softer) or sine-wave (pure). The pitch slides
;; from `from` to `to`, in hertz, over `ms` milliseconds, while the tone
;; fades out. `volume` is from 0 to 1. Examples:
;;
;;   (play-tone square-wave 300 600 120 0.2)       ; a rising "jump"
;;   (play-tone square-wave 990 1320 90 0.2)       ; a bright "coin"
;;   (play-tone sawtooth-wave 300 60 400 0.3)      ; a falling "ouch"
;;
;; None of these functions makes a sound itself. Each one adds a request
;; to a short list, and the game loop hands the lists to the browser at
;; the end of each frame (game.sub; the browser's side is
;; host/web/audio.mjs). This keeps the browser out of a game's own code,
;; so a game that plays sounds can still run in a test, and the test can
;; look at the lists:
;;
;;   (tones-waiting)          how many tones are in the list
;;   (tone-at i)              the i-th of them
;;   (tones-clear!)           empties the list
;;
;;   (sounds-waiting)         the same, for the sounds to play once
;;   (sound-at i)
;;   (sounds-clear!)
;;
;;   (sound-files-waiting)    the same, for the files to load
;;   (sound-file-at i)
;;   (sound-files-clear!)
;;
;;   (music-change)           what was last asked of the music: music-same
;;                            (nothing), music-start or music-stop
;;   (music-sound)            for music-start: the sound, and its volume
;;   (music-volume)
;;   (music-change-clear!)    back to music-same
;;
;; The lists of tones and of sounds hold 16 each. More than that in one
;; frame are dropped; they would only be noise.
(require-unqualified c "../../c/c.sub")
(require-unqualified vector "vector.sub")

(provide play-tone square-wave sawtooth-wave triangle-wave sine-wave
         tone tones-waiting tone-at tones-clear!
         load-sound play-sound play-music stop-music
         sound-play sounds-waiting sound-at sounds-clear!
         sound-file sound-files-waiting sound-file-at sound-files-clear!
         music-same music-start music-stop music-change music-sound music-volume music-change-clear!)

(memory from c)
(table from c)

;; ---- Tones ----

;; The wave shapes, as host/web/audio.mjs numbers them.
(define square-wave u32 0)
(define sawtooth-wave u32 1)
(define triangle-wave u32 2)
(define sine-wave u32 3)

(struct tone [wave u32] [from f64] [to f64] [ms f64] [volume f64])

(define tones (array tone 16))
(define tone-count u32 0)

(define (play-tone [wave u32] [from f64] [to f64] [ms f64] [volume f64])
  (when (< tone-count 16)
    (let ([t (+ tones tone-count)])
      (set! (-> t wave) wave)
      (set! (-> t from) from)
      (set! (-> t to) to)
      (set! (-> t ms) ms)
      (set! (-> t volume) volume))
    (+= tone-count 1)))

(define (tones-waiting) -> u32 tone-count)
(define (tone-at [i u32]) -> (ptr tone) (+ tones i))
(define (tones-clear!) (set! tone-count 0))

;; ---- Sound files ----

;; A file to load: the number that load-sound gave it, and its path.
(struct sound-file [id u32] [path (ptr u8)])

(define files (vector sound-file))

;; The number given to the next sound that load-sound loads. 0 is never
;; a sound.
(define next-sound u32 1)

;; The path is copied, because the list is read later, at the end of the
;; frame, when the caller's string may have changed.
(define (load-sound [path (ptr u8)]) -> u32
  (let* ([id next-sound] [n (strlen path)] [copy (cast (ptr u8) (malloc (+ n 1)))] [f (vector-add! (& files))])
    (+= next-sound 1)
    (memcpy copy path (+ n 1))
    (set! (-> f id) id)
    (set! (-> f path) copy)
    id))

(define (sound-files-waiting) -> u32 (vector-count (& files)))
(define (sound-file-at [i u32]) -> (ptr sound-file) (vector-at (& files) i))
(define (sound-files-clear!)
  (vector-each ([f (& files)]) (free (-> f path)))
  (vector-clear! (& files)))

;; A sound to play once.
(struct sound-play [sound u32] [volume f64])

(define plays (array sound-play 16))
(define play-count u32 0)

(define (play-sound [sound u32] [volume f64])
  (when (< play-count 16)
    (let ([p (+ plays play-count)])
      (set! (-> p sound) sound)
      (set! (-> p volume) volume))
    (+= play-count 1)))

(define (sounds-waiting) -> u32 play-count)
(define (sound-at [i u32]) -> (ptr sound-play) (+ plays i))
(define (sounds-clear!) (set! play-count 0))

;; ---- Music ----

;; What was last asked of the music. Only the last request of a frame
;; counts: starting one piece and then another starts the second.
(define music-same u32 0)
(define music-start u32 1)
(define music-stop u32 2)

(define change u32 0)
(define wanted u32 0)
(define level f64 0.0)

(define (play-music [sound u32] [volume f64])
  (set! change music-start)
  (set! wanted sound)
  (set! level volume))

(define (stop-music) (set! change music-stop))

(define (music-change) -> u32 change)
(define (music-sound) -> u32 wanted)
(define (music-volume) -> f64 level)
(define (music-change-clear!) (set! change music-same))
