;; Lifecycle: experimental.
;;
;; Sound effects for games: short synthesized tones, the kind a retro game
;; uses for a jump or a coin.
;;
;;   (play-tone wave from to ms volume)
;;
;; plays one tone. `wave` is the shape of the sound wave, which gives the
;; sound its character: square-wave (the classic game beep), sawtooth-wave
;; (harsher), triangle-wave (softer) or sine-wave (pure). The pitch slides
;; from `from` to `to`, in hertz, over `ms` milliseconds, while the tone
;; fades out. `volume` is from 0 to 1. Examples:
;;
;;   (play-tone square-wave 300 600 120 0.2)       ; a rising "jump"
;;   (play-tone square-wave 990 1320 90 0.2)       ; a bright "coin"
;;   (play-tone sawtooth-wave 300 60 400 0.3)      ; a falling "ouch"
;;
;; play-tone does not make the sound itself. It adds the tone to a short
;; list, and the game loop hands the list to the browser at the end of
;; each frame (game.sub; the browser's side is host/web/audio.mjs). This
;; keeps the browser out of a game's own code, so a game that calls
;; play-tone can still run in a test, and the test can look at the list:
;;
;;   (tones-waiting)     how many tones are in the list
;;   (tone-at i)         the i-th of them
;;   (tones-clear!)      empties the list
;;
;; The list holds 16 tones. More than that in one frame are dropped; they
;; would only be noise.
(require-unqualified c "../../c/c.sub")

(provide play-tone square-wave sawtooth-wave triangle-wave sine-wave
         tone tones-waiting tone-at tones-clear!)

(memory from c)
(table from c)

;; The wave shapes, as host/web/audio.mjs numbers them.
(define square-wave u32 0)
(define sawtooth-wave u32 1)
(define triangle-wave u32 2)
(define sine-wave u32 3)

(struct tone [wave u32] [from f64] [to f64] [ms f64] [volume f64])

(define waiting (array tone 16))
(define count u32 0)

(define (play-tone [wave u32] [from f64] [to f64] [ms f64] [volume f64])
  (when (< count 16)
    (let ([t (+ waiting count)])
      (set! (-> t wave) wave)
      (set! (-> t from) from)
      (set! (-> t to) to)
      (set! (-> t ms) ms)
      (set! (-> t volume) volume))
    (+= count 1)))

(define (tones-waiting) -> u32 count)
(define (tone-at [i u32]) -> (ptr tone) (+ waiting i))
(define (tones-clear!) (set! count 0))
