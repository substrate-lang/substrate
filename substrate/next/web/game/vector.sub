;; Lifecycle: experimental.
;;
;; A vector: a row of items of one type, numbered from 0, that grows as
;; items are added.
;;
;; This file is part of the game library, which uses it for its own
;; lists and for the store (store.sub). It is not a standard library of
;; the language: it has what the game library needs and no more (there
;; is no inserting, sorting or reserving, for example).
;;
;;   (struct world [points (vector point)] ...)
;;
;; A vector whose bytes are all zero is an empty vector. So a vector that
;; is a global variable, or a field of a struct that starts out as zeros,
;; needs no setting up. In all of the following, `v` is a pointer to the
;; vector.
;;
;;   (vector-add! v)          Adds an item at the end and returns a
;;                            pointer to it. The new item is all zero
;;                            bytes.
;;   (vector-push! v x)       Adds a copy of the value x at the end.
;;   (vector-at v i)          Returns a pointer to item i. Stops the
;;                            program if there is no item i.
;;   (vector-at-unchecked v i)
;;                            The same, without the check, for code that
;;                            has already made sure that item i exists:
;;                            a loop that counts up to (vector-count v),
;;                            say. With any other number it returns the
;;                            address of some other memory, as indexing
;;                            an array does.
;;   (vector-count v)         Returns how many items the vector holds.
;;   (vector-remove-last! v)  Removes the last item.
;;   (vector-clear! v)        Removes every item. The vector keeps its
;;                            memory, for the items that are added next.
;;   (vector-free! v)         Removes every item and gives the memory
;;                            back. The vector is empty and can be used
;;                            again.
;;
;;   (vector-each ([x v]) body ...)
;;                            Runs the body once for each item, in order,
;;                            with x a pointer to the item.
;;   (vector-each ([x i v]) body ...)
;;                            The same, with i the item's number.
;;
;; Two things make a vector safer than an array that is indexed by hand.
;;
;; An index is checked. vector-at with a number that is not an item's,
;; or vector-remove-last! on an empty vector, stops the program with a
;; message that says so (trap.sub). An array would hand back whatever
;; bytes lie beyond its end, and writing to them would damage some other
;; part of the program's data, to be noticed much later or never. The
;; check is one comparison. Code that has just made sure that its index
;; is good can use vector-at-unchecked, which leaves the check out;
;; vector-each does, since it produces the numbers itself.
;;
;; Items never move. The items are kept in blocks of 32, and a vector
;; grows by adding a block, not by copying its items to a larger piece of
;; memory. So a pointer to an item stays good while the vector grows: it
;; is good until the item is removed. (A pointer to a removed item still
;; points at memory that belongs to the vector, and to the item of the
;; same number if one is added again.)
(require-unqualified c "../../c/c.sub")
(require-unqualified trap "trap.sub")

(provide vector vector-add! vector-push! vector-at vector-at-unchecked vector-count vector-remove-last!
         vector-clear! vector-free! vector-each)

(memory from c)
(table from c)

;;   blocks        the addresses of the blocks, each of 32 items
;;   count         how many items the vector holds
;;   block-count   how many blocks have been allocated
;;   room          how many addresses `blocks` has room for
(struct #:forall (T) vector [blocks (ptr (ptr T))] [count u32] [block-count u32] [room u32])

;; Item i is in block i / 32, at place i mod 32 in it.
(define (block-of [i u32]) -> u32 (>> i 5))
(define (place-of [i u32]) -> u32 (bit-and i 31))

;; Stops the program: `function` was asked for item i of a vector of
;; `count` items.
(define (no-such-item [function (ptr u8)] [i u32] [count u32])
  (trap-format "~s: there is no item ~d: the vector holds ~d" function i count))

(define #:forall (T) (vector-count [v (ptr (vector T))]) -> u32 (-> v count))

(define #:forall (T) (vector-at-unchecked [v (ptr (vector T))] [i u32]) -> (ptr T)
  (+ (@ (-> v blocks) (block-of i)) (place-of i)))

(define #:forall (T) (vector-at [v (ptr (vector T))] [i u32]) -> (ptr T)
  (when (>= i (-> v count)) (no-such-item "vector-at" i (-> v count)))
  (vector-at-unchecked v i))

(define #:forall (T) (vector-add! [v (ptr (vector T))]) -> (ptr T)
  (let ([i (-> v count)])
    ;; A new block is needed when the blocks so far are full. Blocks
    ;; that vector-clear! emptied are used again first.
    (when (== (block-of i) (-> v block-count))
      (when (== (-> v block-count) (-> v room))
        (set! (-> v room) (if (== (-> v room) 0) 4 (* 2 (-> v room))))
        (set! (-> v blocks) (cast (ptr (ptr T)) (realloc (-> v blocks) (* (-> v room) (sizeof (ptr void)))))))
      (set! (@ (-> v blocks) (-> v block-count)) (cast (ptr T) (malloc (* 32 (sizeof T)))))
      (+= (-> v block-count) 1))
    (+= (-> v count) 1)
    (let ([item (vector-at-unchecked v i)])
      (memset item 0 (sizeof T))
      item)))

(define #:forall (T) (vector-push! [v (ptr (vector T))] [x T])
  (set! (@ (vector-add! v)) x))

(define #:forall (T) (vector-remove-last! [v (ptr (vector T))])
  (when (== (-> v count) 0) (trap "vector-remove-last!: the vector is empty"))
  (-= (-> v count) 1))

(define #:forall (T) (vector-clear! [v (ptr (vector T))])
  (set! (-> v count) 0))

(define #:forall (T) (vector-free! [v (ptr (vector T))])
  (for ([i u32 0]) (< i (-> v block-count)) (+= i 1) (free (@ (-> v blocks) i)))
  (free (-> v blocks))
  (set! (-> v blocks) 0)
  (set! (-> v count) 0)
  (set! (-> v block-count) 0)
  (set! (-> v room) 0))

;; The code below runs at compile time. It turns
;;
;;   (vector-each ([x i v]) body ...)
;;
;; into a loop over the item numbers:
;;
;;   (let ([the-vector v])
;;     (for ([i u32 0]) (< i (vector-count the-vector)) (+= i 1)
;;       (let ([x (vector-at-unchecked the-vector i)]) body ...)))
;;
;; The count is read again on every turn, so the body may add or remove
;; items at the end. The loop has just compared i with the count when it
;; takes item i, which is why it needs no second check.
(begin-for-syntax
  (require-unqualified c "../../c/c.sub")
  (require-unqualified kd "../../compiler/kernel.sub")
  (require sm "../../c/c-syntax-match.sub" syntax-match _ ... ?)

  (define (vector-each-form [s datum]) -> datum
    (syntax-match s
      [(_ (((? identifier? x) v)) body0 body ...)
       #`(let ([the-vector #,v])
           (for ([i u32 0]) (< i (vector-count the-vector)) (+= i 1)
             (let ([#,x (vector-at-unchecked the-vector i)]) #,body0 #,@body)))]
      [(_ (((? identifier? x) (? identifier? i) v)) body0 body ...)
       #`(let ([the-vector #,v])
           (for ([#,i u32 0]) (< #,i (vector-count the-vector)) (+= #,i 1)
             (let ([#,x (vector-at-unchecked the-vector #,i)]) #,body0 #,@body)))]
      [_ (raise-syntax-error
          'vector-each
          '"expected (vector-each ([item vector]) body ...) or (vector-each ([item index vector]) body ...)"
          s)])))

(define-syntax vector-each vector-each-form)
