;; Lifecycle: experimental.
;;
;; Reading and writing files, from the C-like Lisp.
;;
;; This file is kept with the web libraries, which are its users so far.
;; Nothing in it is about the web, but it is not a standard library of
;; the language.
;;
;; These functions wrap the host's standard file functions (host.read_file
;; and host.write_file, spec section 4), which every host provides. What
;; a "file" is depends on the host:
;;
;;   - On the command line (build/subhost and host/subhost.mjs) it is a
;;     file on disk. A relative path starts from the directory that the
;;     program is run in.
;;   - In a web page it is one of the files that the page gave the
;;     program (host/web/subhost-web.mjs). A page made by next/web/site.sh
;;     gives a program its assets, under "assets/". A file that the
;;     program writes is only kept in memory, until the page is closed.
;;
;; So a program that reads "assets/level.txt" works the same way in a
;; page and on the command line, when it is run in its own directory.
;;
;;   (read-file path (& size))   Returns the content of the file, in new
;;                               memory that the caller must free, and
;;                               stores the content's size in bytes in
;;                               `size`. A zero byte follows the content,
;;                               so that a text file can be used as a C
;;                               string. Returns 0 if the file cannot be
;;                               read.
;;   (read-text-file path)       The same, without the size.
;;   (write-file path p n)       Creates the file, or replaces its
;;                               content, with the n bytes at p. Returns
;;                               0, or -1 if the file cannot be written.
;;   (file-error)                The host's explanation of the last read
;;                               or write that failed, as a new C string,
;;                               which the caller must free.
(require-unqualified c "../c/c.sub")

(provide read-file read-text-file write-file file-error)

(memory from c)
(table from c)

;; The host's functions. Pointers are addresses in this program's memory.
(import host-read-file "host" "read_file" (i32 i32 i32 i32 -> i32))
(import host-write-file "host" "write_file" (i32 i32 i32 i32 -> i32))
(import host-error-message "host" "error_message" (i32 i32 -> i32))

;; The host's read_file copies at most `cap` bytes of the file and returns
;; the file's full size (or -1). So the first call below, with a capacity
;; of 0, only asks for the size. If the file has grown by the second call,
;; only the first `n` bytes are taken.
(define (read-file [path (ptr u8)] [size (ptr u32)]) -> (ptr u8)
  (let* ([length (cast i32 (strlen path))] [n (host-read-file (cast i32 path) length 0 0)])
    (when (< n 0) (return 0))
    (let* ([p (cast (ptr u8) (malloc (+ (cast u32 n) 1)))] [again (host-read-file (cast i32 path) length (cast i32 p) n)])
      (when (< again 0)
        (free p)
        (return 0))
      (when (< again n) (set! n again))
      (set! (@ p n) 0)
      (set! (@ size) (cast u32 n))
      p)))

(define (read-text-file [path (ptr u8)]) -> (ptr u8)
  (let ([size u32 0])
    (read-file path (& size))))

(define (write-file [path (ptr u8)] [p (ptr u8)] [n u32]) -> i32
  (host-write-file (cast i32 path) (cast i32 (strlen path)) (cast i32 p) (cast i32 n)))

(define (file-error) -> (ptr u8)
  (let* ([p (cast (ptr u8) (malloc 1024))] [n (host-error-message (cast i32 p) 1023)])
    (set! (@ p n) 0)
    p))
