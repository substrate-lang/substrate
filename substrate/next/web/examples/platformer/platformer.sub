;; Lifecycle: experimental.
;;
;; A small platformer, as a web page.
;;
;; The game is in world.sub. This file only hands its three functions to
;; the game loop (next/web/game/game.sub), which calls world-step! 60
;; times a second and world-draw on every frame, on a screen of 320 by 180
;; pixels, drawn by the GPU. (Without [renderer gpu] the browser's 2D
;; canvas would draw it, which this small game would not notice; the
;; example shows the GPU in use.)
;;
;; The directory `assets` holds the game's levels, which are text files,
;; and its sheet of sprites. next/web/site.sh puts them in the site, as it
;; does for any program.
;;
;; To play, in the dev shell:
;;
;;   next/web/site.sh next/web/examples/platformer/platformer.sub \
;;     build/next/web/platformer next/web/examples/platformer/page.html
;;   host/web/serve.mjs build/next/web/platformer
(require-unqualified c "../../../c/c.sub")
(require-unqualified game "../../game/game.sub")
(require-unqualified world "world.sub")

(memory from c)
(table from c)

(game world [size 320 180] [renderer gpu] world-init! world-step! world-draw)
