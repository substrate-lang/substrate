;; Lifecycle: experimental.
;;
;; Blocks, a small world of blocks to walk through and dig in, as a web
;; page.
;;
;; The game is in world.sub. This file hands its three functions to the
;; game loop (next/web/game/game.sub), which calls world-step! 60 times a
;; second and world-draw on every frame, on a screen of 640 by 360
;; pixels drawn by the GPU, which a 3D scene needs.
;;
;; The directory `assets` holds the texture atlas of the blocks, which
;; next/web/site.sh puts in the site, as it does for any program. To
;; play, in the dev shell:
;;
;;   next/web/site.sh next/web/examples/blocks/blocks.sub \
;;     build/next/web/blocks next/web/examples/blocks/page.html
;;   host/web/serve.mjs build/next/web/blocks
(require-unqualified c "../../../c/c.sub")
(require-unqualified game "../../game/game.sub")
(require-unqualified world "world.sub")

(memory from c)
(table from c)

(game world [size 640 360] [renderer gpu] world-init! world-step! world-draw)
