;; Lifecycle: experimental. A page's program: a model, the messages that
;; change it, and a view of it (ui.sub), on the host module dom
;; (host/web/dom.mjs), which a page's host gives a program
;; (host/web/subhost-web.mjs). The model is all the program's state; an
;; event's listener gives the program a message; update changes the model
;; for it; and the view is brought up to date, its patches applied as one
;; batch. That is the whole loop, and what a page's code is written as:
;;
;;   (app M E init update v)    the program of model type M, a struct's,
;;   (app M E init update v trapped)
;;                              and message type E, (messages E): init is
;;                              (init [m (ptr M)]), which makes the first
;;                              model; update is (update [m (ptr M)] [e
;;                              (ptr E)]); and v is the view (v [m (ptr
;;                              M)]). It defines main, which the host calls
;;                              once, and on-event, which it calls for each
;;                              event, with the message. With trapped,
;;                              (trapped [m (ptr M)]), the program goes on
;;                              after a trap in an update (spec 4,
;;                              on-trap): trapped puts the model right, and
;;                              the view is brought up to date.
;;   (flush!)                   apply the patches written so far
;;
;; and, in update, of the event the message is for:
;;
;;   (event-value)              the value of the element it came from, as
;;                              a text field's text: a (ptr u8) that lasts
;;                              until the update's patches are applied
;;   (event-key)                the key of a keyboard event, by its name,
;;                              such as "Enter" or "a", likewise
;;   (event-shift?), (event-control?), (event-alt?), (event-meta?)
;;                              whether the key was held with it
;;   (prevent-default!)         the event does not do what it would, as a
;;                              key typing its character
(require-unqualified c "../c/c.sub")
(require-unqualified ui "ui.sub")

(provide app flush! event-value event-key event-shift? event-control? event-alt? event-meta? prevent-default!)

(memory from c)
(table from c)

(import dom-apply "dom" "apply" (i32 i32 ->))
(import dom-event-value "dom" "event_value" (i32 i32 -> i32))
(import dom-event-key "dom" "event_key" (i32 i32 -> i32))
(import dom-event-flags "dom" "event_flags" (-> i32))
(import dom-prevent-default "dom" "prevent_default" (->))

;; The batch is the host's once it is given it: what applying it causes,
;; as giving an element the focus is an event its listener hears, the
;; program handles then and there, with a batch of its own. So the buffer
;; is empty before the host has the batch, whose patches it has read by
;; the time it gives the program an event (host/web/dom.mjs).
(define (flush!)
  (let* ([b (ui-patches)] [n (-> b length)])
    (when (> n 0)
      (set! (-> b length) 0)
      (dom-apply (cast i32 (-> b bytes)) n))
    (ui-patches-done!)))

(define (event-value) -> (ptr u8)
  (let* ([n (dom-event-value 0 0)] [p (cast (ptr u8) (ui-frame-alloc (+ n 1)))])
    (dom-event-value (cast i32 p) n)
    (set! (@ p n) 0)
    p))

(define (event-key) -> (ptr u8)
  (let* ([n (dom-event-key 0 0)] [p (cast (ptr u8) (ui-frame-alloc (+ n 1)))])
    (dom-event-key (cast i32 p) n)
    (set! (@ p n) 0)
    p))

(define (event-shift?) -> i32 (!= (bit-and (dom-event-flags) 1) 0))
(define (event-control?) -> i32 (!= (bit-and (dom-event-flags) 2) 0))
(define (event-alt?) -> i32 (!= (bit-and (dom-event-flags) 4) 0))
(define (event-meta?) -> i32 (!= (bit-and (dom-event-flags) 8) 0))
(define (prevent-default!) (dom-prevent-default))

(begin-for-syntax
  (require-unqualified c "../c/c.sub")
  (require-unqualified kd "../compiler/kernel.sub")
  (require sm "../c/c-syntax-match.sub" syntax-match _ ... ?)

  ;; (app M E init update v [trapped]): the model and v's instance,
  ;; globals; main, which makes them; on-event, which is given a message's
  ;; address, as a listener holds it (ui.sub); and, with trapped, on-trap.
  (define (app-form [s datum]) -> datum
    (syntax-match s
      [(_ model message init update (? identifier? v) trapped ...)
       (let* ([value (if (== (identifier-binding-kind v) 'compile-time-value) (syntax-local-value v) 0)]
              [names (if (and (pair? value) (== (car value) 'ui-view)) (syntax->list (cadr value)) 0)])
         (when (== names 0) (raise-syntax-error 'app '"expected a view" v))
         (when (and (pair? trapped) (pair? (cdr trapped))) (raise-syntax-error 'app '"expected (app M E init update v [trapped])" s))
         #`(begin
             (define app-model #,model)
             (define app-view #,(car names))
             (define (main)
               (#,init (& app-model))
               (#,(cadr names) (& app-view) 0 0 (& app-model))
               (flush!))
             (define (on-event [at u32])
               (#,update (& app-model) (cast (ptr #,message) at))
               (#,(caddr names) (& app-view) (& app-model))
               (flush!))
             #,@(if (null? trapped)
                    nil
                    ;; A trap unwinds the functions it was in without
                    ;; their giving back their frames: the stack is empty
                    ;; again before any C code runs. The patches a trap
                    ;; left unfinished are not applied.
                    `(,#`(func (on-trap) (reset-stack!) (after-trap))
                      ,#`(define (after-trap)
                           (ui-patches-done!)
                           (#,(car trapped) (& app-model))
                           (#,(caddr names) (& app-view) (& app-model))
                           (flush!))))))])))

(define-syntax app app-form)
