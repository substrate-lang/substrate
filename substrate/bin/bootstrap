#!/usr/bin/env bash
# Lifecycle: permanent. The compiler's fixpoint (spec 1.4): build/sub,
# which bin/sub builds from the seed, builds its sources again, into
# build/sub-2, the same bytes, its program and each linklet. With seed,
# the build then becomes the seed (seed/). In the dev shell:
#
#   bin/bootstrap [seed]
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

# bin/sub builds build/sub if its sources changed; expanding an empty
# module needs no more.
empty="build/empty.sub"
mkdir -p build
: > "$empty"
bin/sub expand "$empty" > /dev/null

out=build/sub-2
rm -rf "${out:?}"
mkdir -p "$out"
"${HOST:-build/subhost}" "$root/build/sub" "$root" build compiler/main.sub -o "$out" -p "$root" -d "$root" -r "$root/build/sub"
cmp -s build/sub/program "$out/program" || { echo "bootstrap: the program lists differ"; exit 1; }
while read -r l; do
  cmp -s "build/sub/$l.wasm" "$out/$l.wasm" || { echo "bootstrap: $l differs"; exit 1; }
done < build/sub/program
echo "bootstrap: build/sub builds itself"

if [ "${1:-}" = seed ]; then
  rm -rf seed
  mkdir seed
  cp build/sub/program build/sub/*.wasm seed/
  echo "bootstrap: build/sub is the seed"
fi
