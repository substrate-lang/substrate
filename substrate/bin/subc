#!/usr/bin/env bash
# Lifecycle: stage0. Runs stage0, the bootstrap compiler, until it is
# retired.
# Needs the dev shell (nix develop) and make.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export SUBSTRATE_ROOT="$root"
export SUBHOST_LIB="$root/build/libsubhost.so"
exec scheme -q --libdirs "$root" --compile-imported-libraries --script "$root/stage0/subc.ss" "$@"
