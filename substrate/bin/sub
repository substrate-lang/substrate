#!/usr/bin/env bash
# Lifecycle: permanent entry point. Runs the compiler (compiler/main.sub)
# from the package root, this repository unless -p DIR names another, with
# paths taken relative to where this runs, which -d tells it; on
# build/subhost, or the host HOST names. The compiler is built by itself:
# the seed, a build of it checked in (seed/), builds its sources into
# build/sub-1, which builds them again into build/sub, when they or the
# seed are newer than it; each is given the directory of the build that
# runs it (-r DIR), whose kernel module compile-time code links to.
# Compiled modules are kept in build/cache (spec 3.7), or in the directory
# -c DIR names; the stages building the compiler keep none. bin/bootstrap
# checks that the build builds itself. Needs the dev shell (nix develop).
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
here="$PWD"

# The compiler's sources built by the build in directory $1 into
# directory $2.
stage() {
  rm -rf "${2:?}"
  mkdir -p "$2"
  (cd "$root" && "$root/${HOST:-build/subhost}" "$1" "$root" build compiler/main.sub -o "$2" -p "$root" -d "$root" -r "$1")
}

out="$root/build/sub"
if [ ! -f "$out/program" ] ||
   [ -n "$(find "$root/compiler" "$root/lib/print.sub" "$root/seed/program" -newer "$out/program" | head -1)" ]; then
  stage "$root/seed" "$root/build/sub-1"
  stage "$root/build/sub-1" "$out"
fi

# -p DIR, taken out of the arguments.
package="$root"
n=$#
for ((k = 0; k < n; k++)); do
  if [ "$1" = -p ] && [ $((k + 1)) -lt $n ]; then package="$(cd "$2" && pwd)"; shift 2; k=$((k + 1))
  else set -- "$@" "$1"; shift; fi
done

# The compiler cannot make directories, so the cache's, -c DIR or
# build/cache, and build's output, -o DIR or FILE without its
# extension, are made here.
case " $* " in *" -c "*) ;; *) set -- "$@" -c "$root/build/cache" ;; esac
prev=""
for a in "$@"; do
  [ "$prev" = -c ] && mkdir -p "$a"
  [ "$prev" = -o ] && dest="$a"
  prev="$a"
done
if [ "${1:-}" = build ] && [ $# -ge 2 ]; then mkdir -p "${dest:-${2%.*}}"; fi

cd "$package"
exec "$root/${HOST:-build/subhost}" "$out" "$root" "$@" -p "$package" -d "$here" -r "$out"
