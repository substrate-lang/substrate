#!/usr/bin/env bash
# Lifecycle: permanent entry point. Runs the compiler written in Substrate
# (compiler/main.sub), which make builds into build/sub from the seed, on
# Node's V8 (host/subhost.mjs), or on the host HOST names, such as
# build/subhost. Compiled modules are kept in build/cache (spec 3.7), or
# in the directory -c DIR names. Needs the dev shell (nix develop) and make.
#
# The compiler runs from the package root, this repository unless -p DIR
# names another: module paths are relative to the working directory, and
# a module's bytes name its source (spec 3.6), so a module is the same
# bytes wherever it is built from. FILE and -o, relative to the directory
# this runs from as usual, are passed relative to the package.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# -p DIR, taken out of the arguments.
package="$root"
n=$#
for ((k = 0; k < n; k++)); do
  if [ "$1" = -p ] && [ $# -ge 2 ]; then package="$(cd "$2" && pwd)"; shift 2; k=$((k + 1))
  else set -- "$@" "$1"; shift; fi
done

# Path $1, whose directory exists, relative to the package if it is in
# it, else absolute.
placed() {
  local p
  p="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
  case "$p" in "$package"/*) printf '%s\n' "${p#"$package"/}" ;; *) printf '%s\n' "$p" ;; esac
}

case "${1:-}" in
  build|compile|expand)
    if [ $# -ge 2 ]; then
      # The output goes next to FILE unless -o says where; the compiler
      # cannot make its directory.
      file="$2"
      prev=""
      for a in "$@"; do [ "$prev" = -o ] && out="$a"; prev="$a"; done
      if [ -z "${out:-}" ] && [ "$1" != expand ]; then
        out="${file%.*}"; [ "$1" = compile ] && out="$out.wasm"
        set -- "$@" -o "$out"
      fi
      [ "$1" = build ] && mkdir -p "$out"
      case " $* " in *" -c "*) ;; *) set -- "$@" -c "$root/build/cache" ;; esac
      prev=""
      n=$#
      for ((k = 0; k < n; k++)); do
        a="$1"; shift
        [ "$prev" = -c ] && mkdir -p "$a"
        if [ $k = 1 ] || [ "$prev" = -o ] || [ "$prev" = -c ]; then prev="$a"; a="$(placed "$a")"; else prev="$a"; fi
        set -- "$@" "$a"
      done
    fi ;;
esac
cd "$package"
exec "$root/${HOST:-host/subhost.mjs}" "$root/build/sub" "$root" "$@"
