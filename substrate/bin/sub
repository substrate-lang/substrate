#!/usr/bin/env bash
# Runs the compiler, first building it from the seed if its sources changed.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
here="$PWD"

stage() {
  rm -rf "${2:?}"
  mkdir -p "$2"
  (cd "$root" && "$root/${HOST:-build/subhost}" "$1" "$root" build compiler/main.sub -o "$2" -p "$root" -d "$root" -r "$1")
}

# Built twice: compile-time code links to the kernel module of the build running it (-r).
out="$root/build/sub"
if [ ! -f "$out/program" ] ||
   [ -n "$(find "$root/compiler" "$root/seed/program" -newer "$out/program" | head -1)" ]; then
  stage "$root/seed" "$root/build/sub-1"
  stage "$root/build/sub-1" "$out"
fi

package="$root"
n=$#
for ((k = 0; k < n; k++)); do
  if [ "$1" = -p ] && [ $((k + 1)) -lt $n ]; then package="$(cd "$2" && pwd)"; shift 2; k=$((k + 1))
  else set -- "$@" "$1"; shift; fi
done

# The compiler cannot make directories: the cache's and the build's output are made here.
case " $* " in *" -c "*) ;; *) set -- "$@" -c "$root/build/cache" ;; esac
prev=""
for a in "$@"; do
  [ "$prev" = -c ] && mkdir -p "$a"
  [ "$prev" = -o ] && dest="$a"
  prev="$a"
done
if [ "${1:-}" = build ] && [ $# -ge 2 ]; then mkdir -p "${dest:-${2%.*}}"; fi

cd "$package"
exec "$root/${HOST:-build/subhost}" "$out" "$root" "$@" -p "$package" -d "$here" -r "$out"
