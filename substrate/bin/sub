#!/usr/bin/env bash
# Lifecycle: permanent.
#
# Runs the compiler (compiler/main.sub) on build/subhost, or on the host
# that HOST names. Usage: bin/sub COMMAND ARGS... (see compiler/main.sub).
#
# The compiler runs from the package root, which is this repository unless
# -p DIR names another; paths on the command line are relative to the
# directory bin/sub was run from (passed as -d). Compiled modules are kept
# in build/cache (spec 3.7), or in the directory -c DIR names.
#
# The compiler builds itself. When its sources or the seed (seed/, a
# checked-in build) are newer than build/sub, the seed builds the sources
# into build/sub-1, which builds them again into build/sub. Each build is
# given the directory of the build that runs it (-r DIR), whose kernel
# module compile-time code links to. These stages keep no cache.
# bin/bootstrap checks that build/sub builds itself. Needs the dev shell
# (nix develop).
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
here="$PWD"

# The compiler's sources built by the build in directory $1 into
# directory $2.
stage() {
  rm -rf "${2:?}"
  mkdir -p "$2"
  (cd "$root" && "$root/${HOST:-build/subhost}" "$1" "$root" build compiler/main.sub -o "$2" -p "$root" -d "$root" -r "$1")
}

out="$root/build/sub"
if [ ! -f "$out/program" ] ||
   [ -n "$(find "$root/compiler" "$root/seed/program" -newer "$out/program" | head -1)" ]; then
  stage "$root/seed" "$root/build/sub-1"
  stage "$root/build/sub-1" "$out"
fi

# -p DIR, taken out of the arguments.
package="$root"
n=$#
for ((k = 0; k < n; k++)); do
  if [ "$1" = -p ] && [ $((k + 1)) -lt $n ]; then package="$(cd "$2" && pwd)"; shift 2; k=$((k + 1))
  else set -- "$@" "$1"; shift; fi
done

# The compiler cannot make directories, so the cache's, -c DIR or
# build/cache, and build's output, -o DIR or FILE without its
# extension, are made here.
case " $* " in *" -c "*) ;; *) set -- "$@" -c "$root/build/cache" ;; esac
prev=""
for a in "$@"; do
  [ "$prev" = -c ] && mkdir -p "$a"
  [ "$prev" = -o ] && dest="$a"
  prev="$a"
done
if [ "${1:-}" = build ] && [ $# -ge 2 ]; then mkdir -p "${dest:-${2%.*}}"; fi

cd "$package"
exec "$root/${HOST:-build/subhost}" "$out" "$root" "$@" -p "$package" -d "$here" -r "$out"
