#!/usr/bin/env bash
# Lifecycle: permanent entry point. Runs the compiler written in Substrate
# (compiler/main.sub), which stage0 builds into build/sub, on Node's V8
# (host/subhost.mjs), or on the host HOST names, such as build/subhost.
# Needs the dev shell (nix develop) and make.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# The compiler cannot create directories, so make build's output one here.
if [ "${1:-}" = build ] && [ $# -ge 2 ]; then
  dir="${2%.*}"
  prev=""
  for a in "$@"; do
    if [ "$prev" = -o ]; then dir="$a"; fi
    prev="$a"
  done
  mkdir -p "$dir"
fi
exec "$root/${HOST:-host/subhost.mjs}" "$root/build/sub" "$root" "$@"
