#!/usr/bin/env bash
# Lifecycle: permanent entry point. Runs the compiler written in Substrate
# (compiler/main.sub), which make builds into build/sub from the seed, on
# Node's V8 (host/subhost.mjs), or on the host HOST names, such as
# build/subhost. Compiled modules are kept in build/cache (spec 3.7), or
# in the directory -c DIR names. Needs the dev shell (nix develop) and make.
#
# The compiler runs from the package root, this repository unless -p DIR
# names another, and names modules relative to it (spec 3.6), so a
# module's bytes are the same wherever the package is. It takes the paths
# it is given relative to where this runs, which -d tells it.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
here="$PWD"

# -p DIR, taken out of the arguments.
package="$root"
n=$#
for ((k = 0; k < n; k++)); do
  if [ "$1" = -p ] && [ $((k + 1)) -lt $n ]; then package="$(cd "$2" && pwd)"; shift 2; k=$((k + 1))
  else set -- "$@" "$1"; shift; fi
done

# The compiler cannot make directories, so the cache's, -c DIR or
# build/cache, and build's output, -o DIR or FILE without its extension,
# are made here.
case " $* " in *" -c "*) ;; *) set -- "$@" -c "$root/build/cache" ;; esac
prev=""
for a in "$@"; do
  [ "$prev" = -c ] && mkdir -p "$a"
  [ "$prev" = -o ] && out="$a"
  prev="$a"
done
if [ "${1:-}" = build ] && [ $# -ge 2 ]; then mkdir -p "${out:-${2%.*}}"; fi

cd "$package"
exec "$root/${HOST:-host/subhost.mjs}" "$root/build/sub" "$root" "$@" -p "$package" -d "$here"
