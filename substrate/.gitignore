# What make, the tests and the tools build.
build/
# nix build's output links, and direnv's cache of the dev shell.
result
result-*
.direnv/
# bin/sub without -o writes next to its source: a module's linklets, or a
# program's directory of linklets and its list, program. The seeds', the
# compiler's and the new compiler's (next/seed), are checked in.
*.wasm
!/seed/*.wasm
!/next/seed/*.wasm
program
!/seed/program
!/next/seed/program
# Profiles: node --cpu-prof, and perf.
*.cpuprofile
perf.data*
# Editors and the OS.
*~
.*.swp
.DS_Store
