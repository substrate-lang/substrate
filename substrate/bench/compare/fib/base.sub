;; Lifecycle: benchmark. Recursive fib, calls and integer arithmetic, in
;; the C-like Lisp: the same program as bend.sub and substrate.sub here.
(require-unqualified base "../../../compiler/base/base.sub")
(require print "../../../compiler/print.sub" write-i64 newline)
(memory from base)
(table from base)

(define (fib [n i32]) -> i32 (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))

(define (main) (write-i64 (fib 35)) (newline))
