;; A list of 1 to 1000 built, mapped, filtered and summed, 5000 times, in Substrate.
(require-unqualified substrate "../../../lib/substrate/substrate.sub")

(define (range n) (let loop ([i n] [acc '()]) (if (= i 0) acc (loop (- i 1) (cons i acc)))))

(define (round k acc)
  (if (= k 0)
      acc
      (round (- k 1) (+ acc (foldl + 0 (filter even? (map (lambda (x) (+ x 1)) (range 1000))))))))

(display (round 5000 0))
(newline)
