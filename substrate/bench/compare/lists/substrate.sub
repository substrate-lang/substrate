;; A list of 1 to 1000 built, mapped, filtered and summed, 5000 times, in Substrate.

(struct cell [value u32] [next (ptr cell)])

(define (cons-cell [value u32] [next (ptr cell)]) -> (ptr cell)
  (let ([c (cast (ptr cell) (malloc (sizeof cell)))])
    (set! (-> c value) value)
    (set! (-> c next) next)
    c))

(define (range [n u32]) -> (ptr cell)
  (let ([l (ptr cell) 0])
    (for ([i n]) (> i 0) (-= i 1) (set! l (cons-cell i l)))
    l))

(define (successors [l (ptr cell)]) -> (ptr cell)
  (if (== l 0) 0 (cons-cell (+ (-> l value) 1) (successors (-> l next)))))

(define (evens [l (ptr cell)]) -> (ptr cell)
  (cond [(== l 0) 0]
        [(== (% (-> l value) 2) 0) (cons-cell (-> l value) (evens (-> l next)))]
        [else (evens (-> l next))]))

(define (sum [l (ptr cell)]) -> u32
  (let ([s u32 0])
    (while (!= l 0)
      (+= s (-> l value))
      (set! l (-> l next)))
    s))

(define (release [l (ptr cell)])
  (while (!= l 0)
    (let ([next (-> l next)])
      (free l)
      (set! l next))))

(define (main)
  (let ([total u32 0])
    (for ([k 0]) (< k 5000) (+= k 1)
      (let* ([xs (range 1000)] [ys (successors xs)] [zs (evens ys)])
        (+= total (sum zs))
        (release xs)
        (release ys)
        (release zs)))
    (write-i64 (cast i64 total))
    (newline)))
