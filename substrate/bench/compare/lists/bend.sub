;; Lifecycle: benchmark. Lists in Bend: 5000 times, the list of 1 to 1000
;; built, mapped to its successors, filtered to the even ones and summed,
;; each list freed as the next walks it, and map a template, instanced at
;; inc, as Bend passes functions. The same program as base.sub and
;; substrate.sub here.
(require-unqualified bend "../../../lib/bend/bend.sub")
(require-unqualified base "../../../lib/bend/base.sub")

;; 1 to n, before acc: a list whose elements may be used twice, as evens
;; uses each, to test it and to keep it.
(def (range [+ n : Nat] [acc : (List &2 U32)]) (List &2 U32)
  (match n
    [Zero acc]
    [(Succ p) (range p (Con (U32.from_nat (Succ p)) acc))]))

(def (inc [x : U32]) U32 (U32.add x 1))

(def (map [~ f : (-> U32 U32)] [xs : (List &2 U32)]) (List &2 U32)
  (match xs
    [Nil Nil]
    [(Con h t) (Con (f h) (map f t))]))

(def (keep [b : Bool] [h : U32] [rest : (List U32)]) (List U32)
  (match b
    [True (Con h rest)]
    [False rest]))

(def (evens [xs : (List &2 U32)]) (List U32)
  (match xs
    [Nil Nil]
    [(Con (+ h) t) (keep (U32.is_even h) h (evens t))]))

(def (sum [xs : (List U32)] [acc : U32]) U32
  (match xs
    [Nil acc]
    [(Con h t) (sum t (U32.add acc h))]))

;; k rounds over the list of 1 to n: 50 times 100 of them, and n made
;; once, since a Nat literal is a term of as many Succs to the checker,
;; which walks it.
(def (round [+ k : Nat] [+ n : Nat] [acc : U32]) U32
  (match k
    [Zero acc]
    [(Succ p) (round p n (U32.add acc (sum (evens (map inc (range n Nil))) 0)))]))

(def (rounds [+ j : Nat] [+ n : Nat] [acc : U32]) U32
  (match j
    [Zero acc]
    [(Succ p) (rounds p n (round (nat 100) n acc))]))

(func (main) (print (rounds (nat 50) (Nat.mul (nat 10) (nat 100)) 0)))
