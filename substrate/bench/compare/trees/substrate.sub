;; Lifecycle: benchmark. Binary trees, in Substrate: 50 trees of depth 16
;; made of pairs, a leaf #f, counted and dropped. The same program as
;; base.sub and bend.sub here.
(require-unqualified substrate "../../../lib/substrate/substrate.sub")

(define (make d) (if (= d 0) #f (cons (make (- d 1)) (make (- d 1)))))

(define (check t) (if t (+ 1 (check (car t)) (check (cdr t))) 1))

(define (rounds k acc) (if (= k 0) acc (rounds (- k 1) (+ acc (check (make 16))))))

(display (rounds 50 0))
(newline)
