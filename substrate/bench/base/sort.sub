;; Quicksort of 5 million integers, comparing through a function pointer.
(require-unqualified base "../../compiler/base/base.sub")
(require print "../../compiler/print.sub" write-i64 newline)
(memory from base)
(table from base)

(define (less [a i32] [b i32]) -> i32 (< a b))

(define (quicksort [a (ptr i32)] [lo i32] [hi i32] [before (fn (i32 i32) -> i32)])
  (while (< lo hi)
    (let ([pivot (@ a (+ lo (/ (- hi lo) 2)))] [i lo] [j hi])
      (while (<= i j)
        (while (before (@ a i) pivot) (+= i 1))
        (while (before pivot (@ a j)) (-= j 1))
        (when (<= i j)
          (let ([t (@ a i)]) (set! (@ a i) (@ a j)) (set! (@ a j) t))
          (+= i 1)
          (-= j 1)))
      (if (< (- j lo) (- hi i))
          (begin (quicksort a lo j before) (set! lo i))
          (begin (quicksort a i hi before) (set! hi j))))))

(define (main)
  (let* ([n 5000000] [a (cast (ptr i32) (malloc (* n (sizeof i32))))] [x u32 1] [sum i64 0])
    (for ([i 0]) (< i n) (+= i 1)
      (set! x (+ (* x 1103515245) 12345))
      (set! (@ a i) (cast i32 (>> x 1))))
    (quicksort a 0 (- n 1) less)
    (for ([i 1]) (< i n) (+= i 1)
      (when (> (@ a (- i 1)) (@ a i)) (set! sum -1) (break))
      (+= sum (* (cast i64 (@ a i)) (% i 7))))
    (write-i64 sum)
    (newline)))
