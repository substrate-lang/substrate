;; Lifecycle: benchmark. Binary trees, as the Benchmarks Game's: trees of
;; depths 4 to 16 made, walked and freed, 2 million nodes a depth; malloc,
;; free and pointers.
(require-unqualified base "../../compiler/base/base.sub")
(require print "../../compiler/print.sub" write-i64 newline)
(memory from base)
(table from base)

(struct node [left (ptr node)] [right (ptr node)])

(define (make [depth i32]) -> (ptr node)
  (let ([n (cast (ptr node) (malloc (sizeof node)))])
    (if (== depth 0)
        (begin (set! (-> n left) 0) (set! (-> n right) 0))
        (begin (set! (-> n left) (make (- depth 1))) (set! (-> n right) (make (- depth 1)))))
    n))

(define (check [n (ptr node)]) -> i32
  (if (== (-> n left) 0) 1 (+ 1 (check (-> n left)) (check (-> n right)))))

(define (release [n (ptr node)])
  (when (!= (-> n left) 0)
    (release (-> n left))
    (release (-> n right)))
  (free n))

(define (main)
  (let ([total i64 0] [max-depth 16])
    (for ([d 4]) (<= d max-depth) (+= d 2)
      (for ([k 0]) (< k (<< 1 (+ (- max-depth d) 4))) (+= k 1)
        (let ([t (make d)])
          (+= total (check t))
          (release t))))
    (write-i64 total)
    (newline)))
