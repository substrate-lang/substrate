;; Lifecycle: benchmark. 10 million calls, a tenth of which throw an
;; exception that the caller catches.
(require-unqualified base "../../compiler/base/base.sub")
(require print "../../compiler/print.sub" write-i64 newline)
(memory from base)
(table from base)

(exception odd-one i32)

(define (check [i i32]) -> i32
  (when (== (% i 10) 0) (throw odd-one i))
  i)

(define (main)
  (let ([sum i64 0])
    (for ([i 0]) (< i 10000000) (+= i 1)
      (+= sum (try (check i) [catch odd-one (v) (- 0 v)])))
    (write-i64 sum)
    (newline)))
