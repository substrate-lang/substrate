;; A sum and a count over 10 million integers, through a closure over its caller's variables.

(define (each [a (ptr i32)] [n i32] [f (closure (i32))])
  (for ([i 0]) (< i n) (+= i 1) (f (@ a i))))

(define (sum [a (ptr i32)] [n i32]) -> i64
  (let ([total i64 0])
    (each a n (lambda ([x i32]) (+= total x)))
    total))

(define (count-above [a (ptr i32)] [n i32] [limit i32]) -> i64
  (let ([count i64 0])
    (each a n (lambda ([x i32]) (when (> x limit) (+= count 1))))
    count))

(define (main)
  (let* ([n 10000000] [a (cast (ptr i32) (malloc (* n (sizeof i32))))] [result i64 0])
    (for ([i 0]) (< i n) (+= i 1) (set! (@ a i) (% (* i 7) 1000)))
    (for ([k 0]) (< k 10) (+= k 1)
      (+= result (sum a n))
      (+= result (count-above a n (* k 100))))
    (write-i64 result)
    (newline)))
