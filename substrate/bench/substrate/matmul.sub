;; A product of 500 by 500 matrices of f64.

(define (matmul [n i32] [a (ptr f64)] [b (ptr f64)] [c (ptr f64)])
  (for ([i 0]) (< i n) (+= i 1)
    (for ([k 0]) (< k n) (+= k 1)
      (let ([aik (@ a (+ (* i n) k))] [bk (+ b (* k n))] [ci (+ c (* i n))])
        (for ([j 0]) (< j n) (+= j 1)
          (+= (@ ci j) (* aik (@ bk j))))))))

(define (main)
  (let* ([n 500]
         [a (cast (ptr f64) (malloc (* n n (sizeof f64))))]
         [b (cast (ptr f64) (malloc (* n n (sizeof f64))))]
         [c (cast (ptr f64) (calloc (* n n) (sizeof f64)))]
         [sum 0.0])
    (for ([i 0]) (< i n) (+= i 1)
      (for ([j 0]) (< j n) (+= j 1)
        (set! (@ a (+ (* i n) j)) (% (+ i j) 10))
        (set! (@ b (+ (* i n) j)) (% (* i j) 10))))
    (matmul n a b c)
    (for ([i 0]) (< i (* n n)) (+= i 1) (+= sum (@ c i)))
    (write-i64 (cast i64 sum))
    (newline)))
