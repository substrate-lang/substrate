;; A random tree of expressions, variants in an arena, evaluated by match.
(require-unqualified substrate "../../compiler/substrate/substrate.sub")
(require print "../../compiler/print.sub" write-i64 newline)

(variant expr
  [num [n u32]]
  [add [a (ptr expr)] [b (ptr expr)]]
  [mul [a (ptr expr)] [b (ptr expr)]]
  [neg [a (ptr expr)]])

(define (build [a (ptr arena)] [depth i32] [seed u32]) -> (ptr expr)
  (let ([e (new a expr)] [next (+ (* seed 1103515245) 12345)])
    (if (== depth 0)
        (set! (@ e) (num (>> seed 16)))
        (let ([k (% (>> seed 16) 3)])
          (if (== k 0)
              (set! (@ e) (add (build a (- depth 1) next) (build a (- depth 1) (+ next 1))))
              (if (== k 1)
                  (set! (@ e) (mul (build a (- depth 1) next) (build a (- depth 1) (+ next 1))))
                  (set! (@ e) (neg (build a (- depth 1) next)))))))
    e))

(define (eval [e (ptr expr)] [k u32]) -> u32
  (match e
    [(num n) (+ n k)]
    [(add a b) (+ (eval a k) (eval b k))]
    [(mul a b) (* (eval a k) (eval b k))]
    [(neg a) (- 0 (eval a k))]))

(define (main)
  (let ([a (make-arena)] [sum u64 0])
    (let ([tree (build (& a) 21 1)])
      (for ([i 0]) (< i 400) (+= i 1) (+= sum (eval tree i))))
    (arena-free (& a))
    (write-i64 (cast i64 sum))
    (newline)))
