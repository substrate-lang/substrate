;; The primes below 100 million, by the sieve of Eratosthenes.
(require-unqualified substrate "../../compiler/substrate/substrate.sub")
(require print "../../compiler/print.sub" write-i64 newline)

(define (sieve [n u32]) -> u32
  (let ([composite (cast (ptr u8) (calloc n 1))] [count u32 0])
    (for ([i u32 2]) (< i n) (+= i 1)
      (when (== (@ composite i) 0)
        (+= count 1)
        (for ([j u64 (* (cast u64 i) i)]) (< j n) (+= j i)
          (set! (@ composite j) 1))))
    (free composite)
    count))

(define (main) (write-i64 (sieve 100000000)) (newline))
