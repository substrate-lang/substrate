;; An open-addressing hash table of 64-bit keys that doubles as it fills.
(require-unqualified substrate "../../compiler/substrate/substrate.sub")
(require print "../../compiler/print.sub" write-i64 newline)

(struct entry [key u64] [value u64])

(struct table [slots (ptr entry)] [size u64] [count u64])

(define (slot-of [t (ptr table)] [key u64]) -> (ptr entry)
  (let ([mask (- (-> t size) 1)] [slots (-> t slots)])
    (let ([i (bit-and (>> (* key 11400714819323198485) 32) mask)])
      (while (and (!= (-> (+ slots i) key) 0) (!= (-> (+ slots i) key) key))
        (set! i (bit-and (+ i 1) mask)))
      (+ slots i))))

(define (grow [t (ptr table)])
  (let ([old (-> t slots)] [n (-> t size)])
    (set! (-> t size) (* n 2))
    (set! (-> t slots) (cast (ptr entry) (calloc (cast u32 (* n 2)) (sizeof entry))))
    (for ([i u64 0]) (< i n) (+= i 1)
      (let ([e (+ old i)])
        (when (!= (-> e key) 0)
          (let ([s (slot-of t (-> e key))])
            (set! (-> s key) (-> e key))
            (set! (-> s value) (-> e value))))))
    (free old)))

(define (put [t (ptr table)] [key u64] [value u64])
  (when (>= (* 2 (+ (-> t count) 1)) (-> t size)) (grow t))
  (let ([e (slot-of t key)])
    (when (== (-> e key) 0)
      (set! (-> e key) key)
      (+= (-> t count) 1))
    (set! (-> e value) value)))

(define (get [t (ptr table)] [key u64]) -> u64 (-> (slot-of t key) value))

(define (next [x u64]) -> u64 (+ (* x 6364136223846793005) 1442695040888963407))

(define (main)
  (let ([t table] [x u64 1] [sum u64 0] [n 4000000])
    (set! (-> t size) 16)
    (set! (-> t slots) (cast (ptr entry) (calloc 16 (sizeof entry))))
    (for ([i 0]) (< i n) (+= i 1)
      (set! x (next x))
      (put (& t) (bit-or x 1) i))
    (set! x 1)
    (for ([i 0]) (< i (* 2 n)) (+= i 1)
      (set! x (next x))
      (+= sum (get (& t) (bit-or x 1))))
    (write-i64 (cast i64 (+ sum (-> t count))))
    (newline)))
