;; A generic array that grows, at i32 and at a struct: 10 million items pushed and summed.

(struct #:forall (T) vec [items (ptr T)] [count u32] [capacity u32])

(define #:forall (T) (clear [v (ptr (vec T))])
  (set! (-> v items) 0)
  (set! (-> v count) 0)
  (set! (-> v capacity) 0))

(define #:forall (T) (push [v (ptr (vec T))] [x T])
  (when (== (-> v count) (-> v capacity))
    (set! (-> v capacity) (if (== (-> v capacity) 0) 16 (* 2 (-> v capacity))))
    (set! (-> v items) (realloc (-> v items) (* (-> v capacity) (sizeof T)))))
  (set! (@ (-> v items) (-> v count)) x)
  (+= (-> v count) 1))

(define #:forall (T) (get [v (ptr (vec T))] [i u32]) -> T (@ (-> v items) i))

(struct point [x i32] [y i32])

(define (main)
  (let ([ints (vec i32)] [points (vec point)] [p point] [sum i64 0] [n 10000000])
    (clear (& ints))
    (clear (& points))
    (for ([i 0]) (< i n) (+= i 1)
      (push (& ints) i)
      (set! (-> p x) i)
      (set! (-> p y) (* 2 i))
      (push (& points) p))
    (for ([i u32 0]) (< i (-> ints count)) (+= i 1)
      (+= sum (get (& ints) i))
      (+= sum (-> (get (& points) i) y)))
    (write-i64 sum)
    (newline)))
