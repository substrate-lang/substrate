;; The reader: source text to syntax objects, with locations and no scopes.
(require-unqualified substrate "substrate/substrate.sub")
(require-unqualified k "kernel.sub")
(require-unqualified numbers "numbers.sub")
(require-unqualified host "host.sub")

(provide read-file read-all)

;; Positions, spans and columns count characters, not bytes: pos is not bpos.
(define text (ptr u8) 0)
(define text-bytes u32 0)
(define bpos u32 0)
(define pos u32 0)
(define line u32 1)
(define col u32 0)
(define source datum 0)

(struct place [pos u32] [line u32] [col u32])

(define (peek) -> i32 (if (< bpos text-bytes) (@ text bpos) -1))

(define (peek2) -> i32
  (let ([b (peek)])
    (if (< b 0)
        -1
        (let ([i (+ bpos (char-bytes b))]) (if (< i text-bytes) (@ text i) -1)))))

(define (char-bytes [b i32]) -> u32
  (cond [(< b 128) 1] [(< b 224) 2] [(< b 240) 3] [else 4]))

(define (next!) -> i32
  (let ([b (@ text bpos)])
    (+= bpos (char-bytes b))
    (+= pos 1)
    (if (== b 10)
        (begin (+= line 1) (set! col 0))
        (+= col 1))
    b))

(define (here) -> place
  (let ([p place])
    (set! (-> p pos) pos)
    (set! (-> p line) line)
    (set! (-> p col) col)
    p))

(define (loc-from [start (ptr place)]) -> (ptr srcloc)
  (make-srcloc source (-> start line) (-> start col) (-> start pos) (- pos (-> start pos))))

(define (fail [start (ptr place)] [template (ptr u8)] [args datum]) -> datum
  (raise-compile-error (make-srcloc source (-> start line) (-> start col) (-> start pos) 1) (format-message template args))
  0)

(define (list1 [x datum]) -> datum (cons x nil))

(define (text-from [from u32]) -> datum (bytes->string (+ text from) (- bpos from)))

(define (token=? [from u32] [s (ptr u8)]) -> i32
  (let ([n (strlen s)])
    (and (== (- bpos from) n) (== (memcmp (+ text from) s n) 0))))

(define (whitespace? [b i32]) -> i32 (or (== b 32) (and (>= b 9) (<= b 13))))

(define (delimiter? [b i32]) -> i32
  (or (< b 0) (whitespace? b) (== b #\() (== b #\)) (== b #\[) (== b #\]) (== b #\") (== b #\;)))

(define (skip-atmosphere!)
  (while 1
    (let ([b (peek)])
      (cond [(< b 0) (return)]
            [(whitespace? b) (next!)]
            [(== b #\;) (while (and (>= (peek) 0) (!= (peek) 10)) (next!))]
            [(and (== b #\#) (== (peek2) #\|)) (skip-block-comment!)]
            [(and (== b #\#) (== (peek2) #\;)) (next!) (next!) (read-datum)]
            [else (return)]))))

(define (skip-block-comment!)
  (let ([start (here)] [depth 1])
    (next!)
    (next!)
    (while (> depth 0)
      (let ([b (peek)])
        (cond [(< b 0) (fail (& start) "read: unterminated block comment" nil)]
              [(and (== b #\|) (== (peek2) #\#)) (next!) (next!) (-= depth 1)]
              [(and (== b #\#) (== (peek2) #\|)) (next!) (next!) (+= depth 1)]
              [else (next!)])))))

(define (read-token) -> u32
  (let ([start bpos])
    (while (not (delimiter? (peek))) (next!))
    start))

(define (wrap [start (ptr place)] [e datum]) -> datum (make-syntax e no-scopes (loc-from start) nil))

(define (prefix-form [start (ptr place)] [name datum]) -> datum
  (let* ([head-loc (loc-from start)] [d (read-datum)])
    (when (== d 0) (fail start "read: expected a datum after ~a" (list1 name)))
    (wrap start (cons (make-syntax name no-scopes head-loc nil) (list1 d)))))

(define (read-list [start (ptr place)] [close i32]) -> datum
  (let ([head nil] [last datum 0])
    (while 1
      (skip-atmosphere!)
      (let ([b (peek)])
        (cond [(< b 0) (fail start "read: unterminated list" nil)]
              [(or (== b #\)) (== b #\]))
               (unless (== b close)
                 (let ([at (here)]) (fail (& at) "read: mismatched ~a" (list1 (integer->char b)))))
               (next!)
               (return (wrap start head))]
              [(and (== b #\.) (delimiter? (peek2)) (!= last 0))
               (next!)
               (set-cdr! last (read-datum))
               (skip-atmosphere!)
               (unless (== (peek) close) (fail start "read: expected ~a after dotted tail" (list1 (integer->char close))))
               (next!)
               (return (wrap start head))]
              [else
               (let ([p (list1 (read-datum))])
                 (if (== last 0) (set! head p) (set-cdr! last p))
                 (set! last p))])))))

(define (read-string-lit [start (ptr place)]) -> datum
  (let ([b (make-buffer)] [s datum 0])
    (next!)
    (while 1
      (let ([c (peek)] [from bpos])
        (cond [(< c 0) (fail start "read: unterminated string" nil)]
              [(== c #\")
               (next!)
               (set! s (wrap start (bytes->string (-> b bytes) (-> b length))))
               (buffer-free! (& b))
               (return s)]
              [(== c #\\)
               (next!)
               (let ([e (peek)])
                 (when (< e 0) (fail start "read: unterminated string" nil))
                 (next!)
                 (case e
                   [(#\n) (buffer-add-byte! (& b) 10)]
                   [(#\t) (buffer-add-byte! (& b) 9)]
                   [(#\r) (buffer-add-byte! (& b) 13)]
                   [(#\0) (buffer-add-byte! (& b) 0)]
                   [(#\\ #\") (buffer-add-byte! (& b) e)]
                   [(#\x) (buffer-add-utf-8! (& b) (hex-escape start))]
                   [else (fail start "read: unknown string escape \\~a" (list1 (integer->char e)))]))]
              [else
               (next!)
               (buffer-add! (& b) (+ text from) (- bpos from))])))))

(define (hex-escape [start (ptr place)]) -> u32
  (let ([n u32 0] [any 0])
    (while 1
      (let ([h (peek)])
        (cond [(< h 0) (fail start "read: unterminated \\x escape" nil)]
              [(== h #\;)
               (next!)
               (unless (and any (<= n 1114111)) (fail start "read: bad \\x escape" nil))
               (return n)]
              [(< (digit-value h 16) 0) (fail start "read: bad \\x escape" nil)]
              [else
               (next!)
               (unless (> n 1114111) (set! n (+ (* n 16) (digit-value h 16))))
               (set! any 1)])))))

(define (code-point [p (ptr u8)]) -> u32
  (let ([b (@ p 0)])
    (cond [(< b 128) b]
          [(< b 224) (bit-or (<< (bit-and b 31) 6) (bit-and (@ p 1) 63))]
          [(< b 240) (bit-or (<< (bit-and b 15) 12) (<< (bit-and (@ p 1) 63) 6) (bit-and (@ p 2) 63))]
          [else (bit-or (<< (bit-and b 7) 18) (<< (bit-and (@ p 1) 63) 12) (<< (bit-and (@ p 2) 63) 6) (bit-and (@ p 3) 63))])))

(define char-names (array (ptr u8) 10)
  (array-of (ptr u8) "space" "newline" "tab" "nul" "return" "linefeed" "delete" "alarm" "backspace" "escape"))
(define char-codes (array u32 10) (array-of u32 32 10 9 0 13 10 127 7 8 27))

(define (read-char-lit [start (ptr place)]) -> datum
  (when (< (peek) 0) (fail start "read: unexpected end after #\\" nil))
  (let* ([from bpos] [first (code-point (+ text bpos))] [rest (begin (next!) (read-token))] [n u64 0])
    (when (== rest bpos) (return (wrap start (integer->char first))))
    (for ([i 0]) (< i 10) (+= i 1)
      (when (token=? from (@ char-names i)) (return (wrap start (integer->char (@ char-codes i))))))
    (if (and (== first #\x) (digits? text rest bpos 16) (digits-integer text rest bpos 16 0 (& n)))
        (wrap start (integer->char (cast u32 n)))
        (fail start "read: unknown character #\\~a" (list1 (text-from from))))))

(define (read-hash [start (ptr place)]) -> datum
  (next!)
  (let ([b (peek)])
    (cond [(< b 0) (fail start "read: unexpected end after #" nil)]
          [(== b #\() (fail start "read: vector syntax #( is not part of the kernel" nil)]
          [(== b #\') (next!) (prefix-form start (sym quote-syntax))]
          [(== b #\`) (next!) (prefix-form start (sym quasisyntax))]
          [(and (== b #\,) (== (peek2) #\@)) (next!) (next!) (prefix-form start (sym unsyntax-splicing))]
          [(== b #\,) (next!) (prefix-form start (sym unsyntax))]
          [(== b #\\) (next!) (read-char-lit start)]
          [(== b #\:) (next!) (let ([t (read-token)]) (wrap start (bytes->keyword (+ text t) (- bpos t))))]
          [(== b #\%) (let ([t (- (read-token) 1)]) (wrap start (bytes->symbol (+ text t) (- bpos t))))]
          [else
           (let* ([t (read-token)] [n (radix-number start t)])
             (cond [(or (token=? t "t") (token=? t "true")) (wrap start (boolean 1))]
                   [(or (token=? t "f") (token=? t "false")) (wrap start 0)]
                   [(!= n 0) (wrap start n)]
                   [else (fail start "read: unknown syntax #~a" (list1 (text-from t)))]))])))

(define (read-datum) -> datum
  (skip-atmosphere!)
  (let ([start (here)] [b (peek)])
    (cond [(< b 0) 0]
          [(== b #\() (next!) (read-list (& start) #\))]
          [(== b #\[) (next!) (read-list (& start) #\])]
          [(or (== b #\)) (== b #\])) (fail (& start) "read: unexpected ~a" (list1 (integer->char b)))]
          [(== b #\') (next!) (prefix-form (& start) (sym quote))]
          [(== b #\`) (next!) (prefix-form (& start) (sym quasiquote))]
          [(and (== b #\,) (== (peek2) #\@)) (next!) (next!) (prefix-form (& start) (sym unquote-splicing))]
          [(== b #\,) (next!) (prefix-form (& start) (sym unquote))]
          [(== b #\") (read-string-lit (& start))]
          [(== b #\#) (read-hash (& start))]
          [else
           (let* ([t (read-token)] [n (if (token=? t ".") 0 (token-number (& start) t))])
             (wrap (& start) (if (!= n 0) n (bytes->symbol (+ text t) (- bpos t)))))])))

(define (sign-length [i u32] [end u32]) -> u32
  (if (and (< i end) (or (== (@ text i) #\+) (== (@ text i) #\-))) 1 0))

(define (integer-at [start (ptr place)] [from u32] [end u32] [radix i32] [negative i32] [shown u32]) -> datum
  (let ([bits u64 0])
    (cond [(not (digits-integer text from end radix negative (& bits)))
           (fail start "read: the integer ~a does not fit in 64 bits" (list1 (bytes->string (+ text shown) (- end shown))))]
          [negative (make-integer (cast i64 bits))]
          [else (make-unsigned-integer bits)])))

(define (radix-number [start (ptr place)] [t u32]) -> datum
  (let* ([radix (case (if (< t bpos) (@ text t) 0)
                  [(#\x #\X) 16] [(#\b #\B) 2] [(#\o #\O) 8] [(#\d #\D) 10] [else 0])]
         [from (+ t 1 (sign-length (+ t 1) bpos))])
    (if (and (!= radix 0) (digits? text from bpos radix))
        (integer-at start from bpos radix (and (> from (+ t 1)) (== (@ text (+ t 1)) #\-)) (- t 1))
        0)))

(define (token-number [start (ptr place)] [t u32]) -> datum
  (let* ([end bpos] [from (+ t (sign-length t end))] [negative (and (> from t) (== (@ text t) #\-))] [x f64 0])
    (cond [(digits? text from end 10) (integer-at start from end 10 negative t)]
          [(fraction? from end) (fail start "read: ~a is not a number literal: use integers and decimals" (list1 (text-from t)))]
          [(read-decimal (+ text t) (- end t) (& x)) (make-flonum x)]
          [else 0])))

(define (fraction? [from u32] [end u32]) -> i32
  (when (or (>= from end) (< (digit-value (@ text from) 10) 0)) (return 0))
  (for ([i (+ from 1)]) (< i end) (+= i 1)
    (when (== (@ text i) #\/) (return (and (digits? text from i 10) (digits? text (+ i 1) end 10)))))
  0)

(define (read-all [p (ptr u8)] [n u32] [src datum]) -> datum
  (set! text p)
  (set! text-bytes n)
  (set! bpos 0)
  (set! pos 0)
  (set! line 1)
  (set! col 0)
  (set! source src)
  (let ([head nil] [last datum 0] [d (read-datum)])
    (while (!= d 0)
      (let ([q (list1 d)])
        (if (== last 0) (set! head q) (set-cdr! last q))
        (set! last q))
      (set! d (read-datum)))
    head))

(define (read-file [path datum]) -> datum
  (let* ([name (make-buffer)] [n u32 0] [p (ptr u8) 0] [forms datum 0])
    (buffer-add! (& name) (string-bytes path) (string-length path))
    (buffer-add-byte! (& name) 0)
    (set! p (read-file-bytes (-> name bytes) (& n)))
    (buffer-free! (& name))
    (when (== p 0) (raise-compile-error 0 (format-message "cannot read ~a" (list1 path))))
    (set! forms (read-all p n (string->symbol path)))
    (free p)
    forms))
