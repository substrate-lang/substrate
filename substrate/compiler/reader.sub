;; Lifecycle: permanent. Part of the compiler.
;;
;; Reader: text -> syntax objects with source locations and empty scopes.
;; Positions, spans and columns count characters, not bytes.
(require-unqualified substrate "../lib/substrate.sub")
(require stx "stx.sub" make-stx make-srcloc raise-compile-error)
(require num "numbers.sub" digits->integer)

(provide read-file read-string-all)

(define (read-file path) (read-string-all (file->string path) (string->symbol path)))

;; The text being read, the byte index of its next character, that
;; character's index, and its line and column.
(define text "")
(define text-bytes 0)
(define bpos 0)
(define pos 0)
(define line 1)
(define col 0)
(define source #f)

(define (peek) (if (< bpos text-bytes) (string-ref/utf-8 text bpos) #f))
(define (peek2)
  (if (< bpos text-bytes)
      (let ([b (+ bpos (char-utf-8-length (string-ref/utf-8 text bpos)))])
        (if (< b text-bytes) (string-ref/utf-8 text b) #f))
      #f))
(define (next!)
  (let ([c (string-ref/utf-8 text bpos)])
    (set! bpos (+ bpos (char-utf-8-length c)))
    (set! pos (+ pos 1))
    (if (char=? c #\newline)
        (begin (set! line (+ line 1)) (set! col 0))
        (set! col (+ col 1)))
    c))

(define (here) (list pos line col))
(define (loc-from start)
  (make-srcloc source (cadr start) (caddr start) (car start) (- pos (car start))))
(define (fail start form . args)
  (apply raise-compile-error (make-srcloc source (cadr start) (caddr start) (car start) 1)
         (string-append "read: " form) args))

(define (delimiter? c)
  (or (not c) (char-whitespace? c) (memv c '(#\( #\) #\[ #\] #\" #\;))))

;; Skip whitespace and comments. Returns when the next char starts a datum.
(define (skip-atmosphere!)
  (let ([c (peek)])
    (cond [(not c) #f]
          [(char-whitespace? c) (next!) (skip-atmosphere!)]
          [(char=? c #\;)
           (let loop () (let ([c (peek)]) (when (and c (not (char=? c #\newline))) (next!) (loop))))
           (skip-atmosphere!)]
          [(and (char=? c #\#) (eqv? (peek2) #\|))
           (let ([start (here)])
             (next!) (next!)
             (let loop ([depth 1])
               (cond [(= depth 0) #f]
                     [(not (peek)) (fail start "unterminated block comment")]
                     [(and (char=? (peek) #\|) (eqv? (peek2) #\#)) (next!) (next!) (loop (- depth 1))]
                     [(and (char=? (peek) #\#) (eqv? (peek2) #\|)) (next!) (next!) (loop (+ depth 1))]
                     [else (next!) (loop depth)])))
           (skip-atmosphere!)]
          [(and (char=? c #\#) (eqv? (peek2) #\;))
           (next!) (next!)
           (read-datum)
           (skip-atmosphere!)]
          [else #f])))

(define (read-token)
  (let loop ([acc '()])
    (if (delimiter? (peek))
        (list->string (reverse acc))
        (loop (cons (next!) acc)))))

(define (wrap start e) (make-stx e '() (loc-from start) '()))

;; (prefix-form start 'quote) reads the next datum and wraps it.
(define (prefix-form start sym)
  (let* ([head-loc (loc-from start)]
         [d (read-datum)])
    (unless d (fail start "expected a datum after ~a" sym))
    (wrap start (list (make-stx sym '() head-loc '()) d))))

(define (read-list start close)
  (let loop ([acc '()])
    (skip-atmosphere!)
    (let ([c (peek)])
      (cond [(not c) (fail start "unterminated list")]
            [(memv c '(#\) #\]))
             (unless (char=? c close) (fail (here) "mismatched ~a" c))
             (next!)
             (wrap start (reverse acc))]
            [(and (char=? c #\.) (delimiter? (peek2)) (pair? acc))
             (next!)
             (let ([tail (read-datum)])
               (skip-atmosphere!)
               (unless (eqv? (peek) close) (fail start "expected ~a after dotted tail" close))
               (next!)
               (wrap start (append (reverse acc) tail)))]
            [else (loop (cons (read-datum) acc))]))))

(define (read-string-lit start)
  (next!)
  (let loop ([acc '()])
    (let ([c (peek)])
      (cond [(not c) (fail start "unterminated string")]
            [(char=? c #\") (next!) (wrap start (list->string (reverse acc)))]
            [(char=? c #\\)
             (next!)
             (let ([e (and (peek) (next!))])
               (case e
                 [(#\n) (loop (cons #\newline acc))]
                 [(#\t) (loop (cons #\tab acc))]
                 [(#\r) (loop (cons (integer->char 13) acc))]
                 [(#\0) (loop (cons (integer->char 0) acc))]
                 [(#\\ #\") (loop (cons e acc))]
                 [(#\x)
                  (let hex ([digits '()])
                    (let ([h (peek)])
                      (cond [(not h) (fail start "unterminated \\x escape")]
                            [(char=? h #\;)
                             (next!)
                             (let ([n (digits-value (reverse digits) 16)])
                               (unless n (fail start "bad \\x escape"))
                               (loop (cons (integer->char n) acc)))]
                            [else (next!) (hex (cons h digits))])))]
                 [else (fail start "unknown string escape \\~a" e)]))]
            [else (next!) (loop (cons c acc))]))))

(define char-names
  (list (cons "space" #\space) (cons "newline" #\newline) (cons "tab" #\tab)
        (cons "nul" (integer->char 0)) (cons "return" (integer->char 13))
        (cons "linefeed" #\newline) (cons "delete" (integer->char 127))
        (cons "alarm" (integer->char 7)) (cons "backspace" (integer->char 8))
        (cons "escape" (integer->char 27))))

(define (read-char-lit start)
  ;; after #\ : one char, then any following non-delimiters
  (let* ([first (next!)]
         [rest (read-token)]
         [tok (string-append (string first) rest)]
         [named (assoc tok char-names)]
         [n (and (char=? first #\x) (digits-value (string->list rest) 16))])
    (cond [(= (string-utf-8-length tok) (char-utf-8-length first)) (wrap start first)]
          [named (wrap start (cdr named))]
          [n (wrap start (integer->char n))]
          [else (fail start "unknown character #\\~a" tok)])))

(define (read-hash start)
  (next!)
  (let ([c (peek)])
    (cond [(not c) (fail start "unexpected end after #")]
          [(char=? c #\() (fail start "vector syntax #( is not part of the kernel")]
          [(char=? c #\') (next!) (prefix-form start 'quote-syntax)]
          [(char=? c #\`) (next!) (prefix-form start 'quasisyntax)]
          [(char=? c #\,)
           (next!)
           (if (eqv? (peek) #\@)
               (begin (next!) (prefix-form start 'unsyntax-splicing))
               (prefix-form start 'unsyntax))]
          [(char=? c #\\) (next!) (read-char-lit start)]
          ;; #:name is a keyword.
          [(char=? c #\:) (next!) (wrap start (string->keyword (read-token)))]
          ;; #%name is a symbol, used for implicit forms like #%app.
          [(char=? c #\%) (wrap start (string->symbol (string-append "#" (read-token))))]
          [else
           (let* ([tok (read-token)]
                  [n (radix-number start tok)])
             (cond [(member tok '("t" "true")) (wrap start #t)]
                   [(member tok '("f" "false")) (wrap start #f)]
                   [n (wrap start n)]
                   [else (fail start "unknown syntax #~a" tok)]))])))

(define (read-datum)
  (skip-atmosphere!)
  (let ([start (here)] [c (peek)])
    (cond [(not c) #f]
          [(memv c '(#\( #\[)) (next!) (read-list start (if (char=? c #\() #\) #\]))]
          [(memv c '(#\) #\])) (fail start "unexpected ~a" c)]
          [(char=? c #\') (next!) (prefix-form start 'quote)]
          [(char=? c #\`) (next!) (prefix-form start 'quasiquote)]
          [(char=? c #\,)
           (next!)
           (if (eqv? (peek) #\@)
               (begin (next!) (prefix-form start 'unquote-splicing))
               (prefix-form start 'unquote))]
          [(char=? c #\") (read-string-lit start)]
          [(char=? c #\#) (read-hash start)]
          [else
           (let* ([tok (read-token)]
                  [n (and (not (string=? tok ".")) (token-number start tok))])
             (wrap start (if n n (string->symbol tok))))])))

;; ---- numbers ----
;;
;; The kernel's number literals are integers of up to 64 bits, from -2^63
;; to 2^64 - 1 as in wasm, and decimals (spec 5.4): an optional sign and
;; digits, or #x, #b, #o or #d and an integer in that radix; or a decimal,
;; as Substrate's string->number reads it. A fraction, such as 1/2, is an
;; error; any other token is a symbol.

(define (digit-value c radix)
  (let* ([n (char->integer c)]
         [d (cond [(and (>= n 48) (<= n 57)) (- n 48)]
                  [(and (>= n 97) (<= n 122)) (- n 87)]
                  [(and (>= n 65) (<= n 90)) (- n 55)]
                  [else 99])])
    (and (< d radix) d)))

;; The value of the digits in list cs, in radix, or #f if they are not
;; all digits, there are none, or it is 2^64 or more.
(define (digits-value cs radix) (digits-integer cs radix #f))

;; The same, negated if negative; #f below -2^63 too.
(define (digits-integer cs radix negative)
  (let ([ds (map (lambda (c) (digit-value c radix)) cs)])
    (and (pair? cs) (andmap (lambda (d) d) ds) (digits->integer ds radix negative))))

;; Whether the digits cs, in radix, are all digits; there must be one.
(define (all-digits? cs radix) (and (pair? cs) (andmap (lambda (c) (digit-value c radix)) cs)))

;; An integer with sign (1 or -1) and digits cs, checked to fit in 64 bits.
(define (signed-integer start sign cs radix tok)
  (let ([n (digits-integer cs radix (= sign -1))])
    (unless n (fail start "the integer ~a does not fit in 64 bits" tok))
    n))

;; (sign . rest) for a token's characters: its sign and what follows it.
(define (split-sign cs)
  (cond [(null? cs) (cons 1 cs)]
        [(char=? (car cs) #\+) (cons 1 (cdr cs))]
        [(char=? (car cs) #\-) (cons -1 (cdr cs))]
        [else (cons 1 cs)]))

;; The number #tok reads as, for #x, #b, #o and #d; #f otherwise.
(define (radix-number start tok)
  (let* ([cs (string->list tok)]
         [radix (and (pair? cs)
                     (case (car cs) [(#\x #\X) 16] [(#\b #\B) 2] [(#\o #\O) 8] [(#\d #\D) 10] [else #f]))])
    (and radix
         (let ([s (split-sign (cdr cs))])
           (and (all-digits? (cdr s) radix)
                (signed-integer start (car s) (cdr s) radix (string-append "#" tok)))))))

;; The number tok reads as, or #f if it is a symbol.
(define (token-number start tok)
  (let* ([s (split-sign (string->list tok))] [cs (cdr s)])
    (cond [(all-digits? cs 10) (signed-integer start (car s) cs 10 tok)]
          [(fraction? cs) (fail start "~a is not a number literal: use integers and decimals" tok)]
          ;; A decimal, or +inf.0, -inf.0, +nan.0 or -nan.0.
          [else (string->number tok)])))

;; Digits, a slash and digits.
(define (fraction? cs)
  (let ([slash (memv #\/ cs)])
    (and slash (all-digits? (take cs (- (length cs) (length slash))) 10) (all-digits? (cdr slash) 10))))

;; ---- entry ----

;; Read every datum in text; source names the file in srclocs.
(define (read-string-all s src)
  (set! text s)
  (set! text-bytes (string-utf-8-length s))
  (set! bpos 0)
  (set! pos 0)
  (set! line 1)
  (set! col 0)
  (set! source src)
  (let loop ([acc '()])
    (let ([d (read-datum)])
      (if d (loop (cons d acc)) (reverse acc)))))
