;; Lifecycle: experimental. examples/c/math.sub as the new compiler builds
;; it (compiler/c): the C-like Lisp's math, as C's <math.h> has it: the
;; functions wasm has an instruction for that computes C's result, for
;; doubles, and for floats under their names with an f. Each is a kernel
;; function that is inline (spec 5.2), so a call is its instruction.
;; fmin and fmax are not here: wasm's min and max give NaN if either is
;; NaN, C's the other.

(provide sqrt fabs floor ceil trunc nearbyint copysign sqrtf fabsf floorf ceilf truncf nearbyintf copysignf)

(func (sqrt [x f64]) #:inline -> f64 (f64.sqrt x))
(func (fabs [x f64]) #:inline -> f64 (f64.abs x))
(func (floor [x f64]) #:inline -> f64 (f64.floor x))
(func (ceil [x f64]) #:inline -> f64 (f64.ceil x))
(func (trunc [x f64]) #:inline -> f64 (f64.trunc x))
;; Halves to even, as C's in its default rounding.
(func (nearbyint [x f64]) #:inline -> f64 (f64.nearest x))
(func (copysign [x f64] [y f64]) #:inline -> f64 (f64.copysign x y))

(func (sqrtf [x f32]) #:inline -> f32 (f32.sqrt x))
(func (fabsf [x f32]) #:inline -> f32 (f32.abs x))
(func (floorf [x f32]) #:inline -> f32 (f32.floor x))
(func (ceilf [x f32]) #:inline -> f32 (f32.ceil x))
(func (truncf [x f32]) #:inline -> f32 (f32.trunc x))
(func (nearbyintf [x f32]) #:inline -> f32 (f32.nearest x))
(func (copysignf [x f32] [y f32]) #:inline -> f32 (f32.copysign x y))
