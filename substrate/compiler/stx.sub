;; Lifecycle: permanent. Part of the compiler, ported from stage0/syntax.sls.
;;
;; Syntax objects and source locations are the syntax library's (spec 2),
;; read and built through its internal functions (spec appendix A). A scope
;; set is a list of fixnum scope ids, newest (greatest) first. A compile error
;; stops the compiler: it writes the error and exits with status 1.
(require-unqualified substrate "../lib/substrate.sub")
(require s syntax)

(provide make-stx stx? stx-e stx-scopes stx-srcloc stx-props
         make-srcloc srcloc? srcloc-source srcloc-line srcloc-col srcloc-pos srcloc-span
         id? stx->datum datum->stx stx->list stx-rewrap
         scopes-add scopes-remove scopes-flip scopes-subset? add-scope flip-scope remove-scopes
         filter-scopes format-srcloc raise-compile-error)

(import %make-syntax "syntax" "%make-syntax" (eqref eqref eqref eqref -> eqref))
(import %make-srcloc "syntax" "%make-srcloc" (eqref i32 i32 i32 i32 -> eqref))
(import stx-scopes "syntax" "%syntax-scopes" (eqref -> eqref))
(import stx-srcloc "syntax" "%syntax-srcloc" (eqref -> eqref))
(import stx-props "syntax" "%syntax-props" (eqref -> eqref))
(import syntax-change "syntax" "%syntax-change" (eqref eqref eqref -> eqref))
(import srcloc? "syntax" "%srcloc?" (eqref -> eqref))
(import srcloc-source "syntax" "%srcloc-source" (eqref -> eqref))
(import srcloc-line "syntax" "%srcloc-line" (eqref -> eqref))
(import srcloc-col "syntax" "%srcloc-col" (eqref -> eqref))
(import srcloc-pos "syntax" "%srcloc-pos" (eqref -> eqref))
(import srcloc-span "syntax" "%srcloc-span" (eqref -> eqref))

(func (make-stx [e eqref] [scopes eqref] [srcloc eqref] [props eqref]) -> eqref
  (%make-syntax e scopes srcloc props))

(func (make-srcloc [source eqref] [line eqref] [col eqref] [pos eqref] [span eqref]) -> eqref
  (%make-srcloc source (s:fixnum-value line) (s:fixnum-value col) (s:fixnum-value pos) (s:fixnum-value span)))

(define (stx? x) (syntax? x))
(define (stx-e x) (syntax-e x))
(define (id? x) (identifier? x))

;; ---- scope sets ----

(define (scopes-add set sc)
  (cond [(null? set) (list sc)]
        [(= (car set) sc) set]
        [(> sc (car set)) (cons sc set)]
        [else (cons (car set) (scopes-add (cdr set) sc))]))

(define (scopes-remove set sc)
  (cond [(null? set) set]
        [(= (car set) sc) (cdr set)]
        [else (cons (car set) (scopes-remove (cdr set) sc))]))

(define (scopes-flip set sc)
  (if (memv sc set) (scopes-remove set sc) (scopes-add set sc)))

(define (scopes-subset? a b)
  (cond [(null? a) #t]
        [(null? b) #f]
        [(= (car a) (car b)) (scopes-subset? (cdr a) (cdr b))]
        [(< (car a) (car b)) (scopes-subset? a (cdr b))]
        [else #f]))

;; Add scope sc (change 0), remove it (1) or flip it (2) in every syntax
;; object inside x. The syntax library makes the change to a syntax
;; object's datum when something looks inside (spec 6.1).
(define (change-scope x sc change)
  (cond [(stx? x) (syntax-change x sc change)]
        [(pair? x) (cons (change-scope (car x) sc change) (change-scope (cdr x) sc change))]
        [else x]))

(define (add-scope x sc) (change-scope x sc 0))
(define (remove-scopes x scs) (foldl (lambda (sc x) (change-scope x sc 1)) x scs))
(define (flip-scope x sc) (change-scope x sc 2))

;; Apply op to the scopes of every syntax object inside x, now.
(define (map-scopes x op)
  (cond [(stx? x) (make-stx (map-scopes (stx-e x) op) (op (stx-scopes x)) (stx-srcloc x) (stx-props x))]
        [(pair? x) (cons (map-scopes (car x) op) (map-scopes (cdr x) op))]
        [else x]))

(define (filter-scopes x keep?) (map-scopes x (lambda (s) (filter keep? s))))

;; ---- conversions ----

(define (stx->datum x) (syntax->datum x))

;; Wrap datum d with the scopes of ctx (a syntax object or #f) and source
;; location srcloc.
(define (datum->stx ctx d srcloc)
  (let ([scopes (if ctx (stx-scopes ctx) '())])
    (letrec ([wrap-list (lambda (d)
                          (cond [(pair? d) (cons (wrap (car d)) (wrap-list (cdr d)))]
                                [(null? d) '()]
                                [else (wrap d)]))]
             [wrap (lambda (d)
                     (cond [(stx? d) d]
                           [(pair? d) (make-stx (wrap-list d) scopes srcloc '())]
                           [else (make-stx d scopes srcloc '())]))])
      (wrap d))))

;; The elements of a syntax list, or #f if x is not a proper syntax list.
(define (stx->list x)
  (let ([e (if (stx? x) (stx-e x) x)])
    (and (list? e) e)))

(define (stx-rewrap x e) (make-stx e (stx-scopes x) (stx-srcloc x) (stx-props x)))

;; ---- errors ----

(define (format-srcloc loc)
  (if (srcloc? loc)
      (format "~a:~a:~a" (srcloc-source loc) (srcloc-line loc) (+ 1 (srcloc-col loc)))
      "<unknown>"))

;; (raise-compile-error stx-or-srcloc-or-#f form arg ...): write the error
;; and stop.
(define (raise-compile-error where form . args)
  (let ([loc (cond [(stx? where) (stx-srcloc where)]
                   [(srcloc? where) where]
                   [else #f])])
    (eprintf "~a: error: ~a~n" (format-srcloc loc) (apply format form args))
    (exit 1)))
