;; Lifecycle: permanent. Part of the compiler.
;;
;; Syntax objects and source locations are the kernel module's (spec 2),
;; read and built through its internal functions (spec appendix A). A scope
;; set is a list of fixnum scope ids, newest (greatest) first. A compile error
;; is a syntax error (spec 2.3), raised: a macro around local-expand may
;; handle it, and otherwise the compiler writes it and exits with status 1.
(require-unqualified substrate "../lib/substrate.sub")

(provide make-stx stx? stx-e stx-scopes stx-srcloc stx-props
         make-srcloc srcloc? srcloc-source srcloc-line srcloc-col srcloc-pos srcloc-span
         id? stx->datum datum->stx stx->list stx-rewrap
         scopes-add scopes-remove scopes-subset? add-scope flip-scope remove-scopes
         filter-scopes format-srcloc raise-compile-error write-syntax-error unlocated-error? located-error)

(import make-stx "kernel" "%make-syntax" (eqref eqref eqref eqref -> eqref))
(import make-srcloc "kernel" "%make-srcloc" (eqref eqref eqref eqref eqref -> eqref))
(import stx-scopes "kernel" "%syntax-scopes" (eqref -> eqref))
(import stx-srcloc "kernel" "%syntax-srcloc" (eqref -> eqref))
(import stx-props "kernel" "%syntax-props" (eqref -> eqref))
(import syntax-change "kernel" "%syntax-change" (eqref eqref eqref -> eqref))
(import scope-set-change "kernel" "%scope-set-change" (eqref eqref eqref -> eqref))
(import scopes-subset? "kernel" "%scope-subset?" (eqref eqref -> eqref))
(import srcloc? "kernel" "%srcloc?" (eqref -> eqref))
(import srcloc-source "kernel" "%srcloc-source" (eqref -> eqref))
(import srcloc-line "kernel" "%srcloc-line" (eqref -> eqref))
(import srcloc-col "kernel" "%srcloc-col" (eqref -> eqref))
(import srcloc-pos "kernel" "%srcloc-pos" (eqref -> eqref))
(import srcloc-span "kernel" "%srcloc-span" (eqref -> eqref))
(import make-syntax-error "kernel" "%make-syntax-error" (eqref eqref eqref -> eqref))
(import syntax-error-syntax "kernel" "syntax-error-syntax" (eqref -> eqref))
(import syntax-error-srcloc "kernel" "%syntax-error-srcloc" (eqref -> eqref))

(define (stx? x) (syntax? x))
(define (stx-e x) (syntax-e x))
(define (id? x) (identifier? x))

;; ---- scope sets ----
;;
;; The kernel module's: scopes-subset? is its %scope-subset?, imported
;; above.

(define (scopes-add set sc) (scope-set-change set sc 0))
(define (scopes-remove set sc) (scope-set-change set sc 1))

;; Add scope sc (change 0), remove it (1) or flip it (2) in every syntax
;; object inside x. The kernel module makes the change to a syntax
;; object's datum when something looks inside (spec 6.1).
(define (change-scope x sc change)
  (cond [(stx? x) (syntax-change x sc change)]
        [(pair? x) (cons (change-scope (car x) sc change) (change-scope (cdr x) sc change))]
        [else x]))

(define (add-scope x sc) (change-scope x sc 0))
(define (remove-scopes x scs) (foldl (lambda (sc x) (change-scope x sc 1)) x scs))
(define (flip-scope x sc) (change-scope x sc 2))

;; Apply op to the scopes of every syntax object inside x, now.
(define (map-scopes x op)
  (cond [(stx? x) (make-stx (map-scopes (stx-e x) op) (op (stx-scopes x)) (stx-srcloc x) (stx-props x))]
        [(pair? x) (cons (map-scopes (car x) op) (map-scopes (cdr x) op))]
        [else x]))

(define (filter-scopes x keep?) (map-scopes x (lambda (s) (filter keep? s))))

;; ---- conversions ----

(define (stx->datum x) (syntax->datum x))

;; Wrap datum d with the scopes of ctx (a syntax object or #f) and source
;; location srcloc.
(define (datum->stx ctx d srcloc)
  (let ([scopes (if ctx (stx-scopes ctx) '())])
    (letrec ([wrap-list (lambda (d)
                          (cond [(pair? d) (cons (wrap (car d)) (wrap-list (cdr d)))]
                                [(null? d) '()]
                                [else (wrap d)]))]
             [wrap (lambda (d)
                     (cond [(stx? d) d]
                           [(pair? d) (make-stx (wrap-list d) scopes srcloc '())]
                           [else (make-stx d scopes srcloc '())]))])
      (wrap d))))

;; The elements of a syntax list, or #f if x is not a proper syntax list.
(define (stx->list x)
  (let ([e (if (stx? x) (stx-e x) x)])
    (and (list? e) e)))

(define (stx-rewrap x e) (make-stx e (stx-scopes x) (stx-srcloc x) (stx-props x)))

;; ---- errors ----

(define (format-srcloc loc)
  (if (srcloc? loc)
      (format "~a:~a:~a" (srcloc-source loc) (srcloc-line loc) (+ 1 (srcloc-col loc)))
      "<unknown>"))

;; (raise-compile-error stx-or-srcloc-or-#f form arg ...): raise a syntax
;; error located there.
(define (raise-compile-error where form . args)
  (let ([loc (cond [(stx? where) (stx-srcloc where)]
                   [(srcloc? where) where]
                   [else #f])])
    (raise (make-syntax-error (apply format form args) #f loc))))

;; Syntax error e has no location: none of its own, and no syntax with one.
(define (unlocated-error? e)
  (and (syntax-error? e)
       (not (syntax-error-srcloc e))
       (let ([s (syntax-error-syntax e)]) (not (and (stx? s) (stx-srcloc s))))))

;; Syntax error e, located at syntax object where.
(define (located-error e where)
  (make-syntax-error (exn-message e) (syntax-error-syntax e) (stx-srcloc where)))

;; Write syntax error e where it is located: its location, or else that of
;; the syntax it blames, which it shows.
(define (write-syntax-error e)
  (let* ([s (syntax-error-syntax e)]
         [loc (or (syntax-error-srcloc e) (and (stx? s) (stx-srcloc s)))])
    (eprintf "~a: error: ~a~a~n" (format-srcloc loc) (exn-message e)
             (if (stx? s) (format "\n  in: ~s" (stx->datum s)) ""))))
