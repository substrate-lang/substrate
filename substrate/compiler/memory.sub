;; Lifecycle: permanent.
;;
;; The program's memory, which every module of a program shares. A module
;; takes it from a module it requires with (memory from name), and the
;; chain ends here, where the memory is defined (spec 3.3). This module
;; holds no data of its own. Layout: the bytes below heap-start belong to
;; print.sub, which writes output from them; above heap-start is every
;; module's data, including the C-like Lisp's heap and stack
;; (base/lang.sub). The memory grows as the program needs it (sbrk calls
;; memory.grow).

(provide heap-start)

(memory 1)

(global heap-start i32 1024)
