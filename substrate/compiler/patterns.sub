;; Lifecycle: permanent.
;;
;; The pattern language of syntax-match, shared by its two versions:
;; syntax-match.sub, which compiles patterns to kernel code, and
;; base/syntax-match.sub, which compiles them to C. This file, written in
;; kernel code, provides:
;;   - the pattern words _, ... and ?;
;;   - the parser (parse-patterns, parse-match-patterns), which each
;;     version runs at compile time to turn patterns into descriptions
;;     that it then compiles into code;
;;   - no-match, the error that the compiled code raises when no clause
;;     matches.
;; Substrate's match (lib/substrate/substrate.sub) parses its patterns
;; here too, including patterns on structs.

(require k kernel)
(provide _ ... ? parse-patterns parse-match-patterns match-clauses clause-patterns nth numbers-from no-match
         no-match-message)

(begin-for-syntax
  (require k kernel)
  (func (pattern-only [stx i32]) -> i32 (k:raise-syntax-error 0 '"allowed only in a pattern" stx)))

(define-syntax _ pattern-only)
(define-syntax ... pattern-only)
(define-syntax ? pattern-only)

;; ---- parsing ----
;;
;; A pattern is parsed into a description, a datum that its code is
;; compiled from. A description is one of:
;;   (var i name)          the pattern's variable i
;;   (any)                 _
;;   (datum d)             a literal d
;;   (bound i name)        an identifier free-identifier=? to value i
;;   (check i p ...)       p ..., with value i as a predicate on the input
;;   (list (element ...) tail)
;;                         a list; an element is a description or
;;                         (repeat p (i ...)), p repeated, binding the
;;                         variables i ...; tail is a description or (null)
;;   (struct i name (p ...))  only in match (below)
;; The values are the form's predicates and #'id forms, which the
;; compiled code uses where it tests them. A name is as written, for
;; error messages. Indexes are fixnums.

;; The form's name, for errors; the values and the variables of the
;; pattern being parsed, the latest first; and the words patterns are
;; parsed with, _, ..., ?, quote and quote-syntax, as the form's module
;; sees them, compared by binding.
(global who (mut i32) 0)
(global pattern-values (mut i32) 0)
(global pattern-vars (mut i32) 0)
(global word-any (mut i32) 0)
(global word-repeat (mut i32) 0)
(global word-check (mut i32) 0)
(global word-quote (mut i32) 0)
(global word-quote-syntax (mut i32) 0)

(func (pattern-keyword? [x i32] [kw i32]) -> i32 (if (k:identifier? x) (k:free-identifier=? x kw) 0))

;; Is l a list of two elements?
(func (two? [l i32]) -> i32 (if (k:pair? l) (if (k:pair? (k:cdr l)) (k:null? (k:cddr l)) 0) 0))

;; The numbers from i below n.
(func (numbers-from [i i32] [n i32]) -> i32
  (if (i32.lt_s i n) (k:cons (k:fixnum i) (numbers-from (i32.add i 1) n)) '()))

(func (nth [l i32] [i i32]) -> i32 (k:list-ref l (k:fixnum-value i)))

;; Is an identifier in ids named as id is?
(func (named-in? [id i32] [ids i32]) -> i32
  (if (k:null? ids) 0 (if (i32.eq (k:syntax-e (k:car ids)) (k:syntax-e id)) 1 (named-in? id (k:cdr ids)))))

(func (value! [e i32]) -> i32
  (set! pattern-values (k:cons e pattern-values))
  (k:fixnum (i32.sub (k:length pattern-values) 1)))

(func (var! [id i32]) -> i32
  (if (named-in? id pattern-vars)
      (k:raise-syntax-error who '"this pattern variable appears twice in its pattern" id))
  (set! pattern-vars (k:cons id pattern-vars))
  (k:fixnum (i32.sub (k:length pattern-vars) 1)))

(func (parse [p i32]) -> i32
  (let ([e (k:syntax-e p)])
    (if (k:symbol? e)
        (if (pattern-keyword? p word-any)
            '(any)
            (if (if (pattern-keyword? p word-repeat) 1 (pattern-keyword? p word-check))
                (k:raise-syntax-error who '"not allowed here in a pattern" p)
                `(var ,(var! p) ,e)))
        (if (k:pair? e) (parse-form p e) (if (k:null? e) '(list () (null)) `(datum ,e))))))

(func (parse-form [p i32] [e i32]) -> i32
  (if (if (two? e) (pattern-keyword? (k:car e) word-quote) 0)
      `(datum ,(k:syntax->datum (k:cadr e)))
      (if (if (two? e) (pattern-keyword? (k:car e) word-quote-syntax) 0)
          (if (k:identifier? (k:cadr e))
              `(bound ,(value! p) ,(k:syntax-e (k:cadr e)))
              (k:raise-syntax-error who '"expected #'identifier" p))
          (if (pattern-keyword? (k:car e) word-check)
              (if (if (k:pair? (k:cdr e)) (k:list? (k:cdr e)) 0)
                  (let ([i (value! (k:cadr e))]) (k:cons 'check (k:cons i (parse-all (k:cddr e)))))
                  (k:raise-syntax-error who '"expected (? predicate pattern ...)" p))
              (let ([info (if structs (struct-info-of (k:car e)) 0)])
                (if info
                    (parse-struct p e info)
                    (let ([r (elements e)]) `(list ,(k:car r) ,(k:cdr r)))))))))

(func (parse-all [ps i32]) -> i32
  (if (k:null? ps) '() (let ([d (parse (k:car ps))]) (k:cons d (parse-all (k:cdr ps))))))

;; The elements and the tail of pair chain l, as (elements . tail).
(func (elements [l i32]) -> i32
  (if (k:pair? l)
      (if (pattern-keyword? (k:car l) word-repeat)
          (k:raise-syntax-error who '"... follows the pattern it repeats" (k:car l))
          (if (if (k:pair? (k:cdr l)) (pattern-keyword? (k:cadr l) word-repeat) 0)
              (let* ([before (k:length pattern-vars)]
                     [d (parse (k:car l))]
                     [repeat `(repeat ,d ,(numbers-from before (k:length pattern-vars)))]
                     [r (elements (k:cddr l))])
                (k:cons (k:cons repeat (k:car r)) (k:cdr r)))
              (let* ([d (parse (k:car l))] [r (elements (k:cdr l))])
                (k:cons (k:cons d (k:car r)) (k:cdr r)))))
      (k:cons '() (if (k:null? l) '(null) (parse l)))))

;; Patterns ps of form name, parsed with words, (_ ... ? quote
;; quote-syntax) as the form's module sees them, as (descriptions
;; variables values): for each pattern its description and its variables,
;; in order, and the values the descriptions refer to, in order.
(func (parse-patterns [ps i32] [name i32] [words i32]) -> i32
  (let ([descs '()] [varss '()])
    (set! who name)
    (set! word-any (k:car words))
    (set! word-repeat (k:cadr words))
    (set! word-check (k:caddr words))
    (set! word-quote (k:cadddr words))
    (set! word-quote-syntax (k:list-ref words 4))
    (set! pattern-values '())
    (block done
      (loop next
        (br-if done (k:null? ps))
        (set! pattern-vars '())
        (set! descs (k:cons (parse (k:car ps)) descs))
        (set! varss (k:cons (k:reverse pattern-vars) varss))
        (set! ps (k:cdr ps))
        (br next)))
    `(,(k:reverse descs) ,(k:reverse varss) ,(k:reverse pattern-values))))

;; Form name's clauses, each [pattern body ...], as lists.
(func (match-clauses [cs i32] [name i32]) -> i32
  (if (k:null? cs)
      '()
      (let ([c (k:syntax->list (k:car cs))])
        (if (if c (i32.ge_u (k:length c) 2) 0)
            (k:cons c (match-clauses (k:cdr cs) name))
            (k:raise-syntax-error name '"expected a clause [pattern body ...]" (k:car cs))))))

(func (clause-patterns [cs i32]) -> i32
  (if (k:null? cs) '() (k:cons (k:car (k:car cs)) (clause-patterns (k:cdr cs)))))


;; ---- structs, for match ----
;;
;; In match (parse-match-patterns), a pattern (name p ...) whose name is
;; bound to a struct's transformer (lib/substrate/core.sub) matches an
;; instance of that struct. It is described as (struct i name (p ...)):
;; value i is the struct's predicate, and the values after it are its
;; accessors, one for each p.

(global structs (mut i32) 0)

;; The information of the struct id names, if id is bound to a struct's
;; transformer: the syntax (struct-info name constructor predicate
;; (accessor ...) (field ...)); else #f.
(func (struct-info-of [id i32]) -> i32
  (let ([v (if (k:identifier? id) (k:syntax-local-value id) 0)])
    (if (if v (k:transformer? v) 0)
        (let ([l (k:syntax->list (k:transformer-env v))])
          (if (if l (k:pair? l) 0)
              (if (if (k:identifier? (k:car l)) (i32.eq (k:syntax-e (k:car l)) 'struct-info) 0) l 0)
              0))
        0)))

(func (values! [es i32])
  (if (k:pair? es) (begin (drop (value! (k:car es))) (values! (k:cdr es)))))

;; (name p ...), e, of the struct with information info.
(func (parse-struct [p i32] [e i32] [info i32]) -> i32
  (let ([n (k:length (k:syntax->list (k:list-ref info 5)))] [name (k:syntax-e (k:cadr info))])
    (if (i32.ne (k:length (k:cdr e)) n)
        (k:raise-syntax-error who (k:format '"~a has ~a field~a, not ~a"
                                            `(,name ,(k:fixnum n) ,(if (i32.eq n 1) '"" '"s") ,(k:fixnum (k:length (k:cdr e)))))
                              p))
    (let ([i (value! (k:list-ref info 3))])
      (values! (k:syntax->list (k:list-ref info 4)))
      `(struct ,i ,name ,(parse-all (k:cdr e))))))

;; Patterns ps of match, as parse-patterns parses them, with structs.
(func (parse-match-patterns [ps i32] [name i32] [words i32]) -> i32
  (set! structs 1)
  (let ([parsed (parse-patterns ps name words)])
    (set! structs 0)
    parsed))


;; ---- what the compiled code calls ----

;; No clause of a syntax-match matched x, and ds are the descriptions of
;; the clauses' patterns: the error.
(func (no-match [ds i32] [x i32]) -> i32
  (k:raise-syntax-error 0 (k:string-append '"expected " (alternatives (pattern-texts ds x))) x))

;; The error's message, as raise-syntax-error writes it, for code that
;; throws the kernel module's compile-error itself: "expected" and the
;; patterns, after the name x gives, if it gives one.
(func (no-match-message [ds i32] [x i32]) -> i32
  (let ([message (k:string-append '"expected " (alternatives (pattern-texts ds x)))] [name (named-by x)])
    (if name (k:format '"~a: ~a" `(,name ,message)) message)))

;; The name stx gives: an identifier's own, or that of the identifier
;; heading a list; or #f.
(func (named-by [stx i32]) -> i32
  (if (k:identifier? stx)
      (k:syntax-e stx)
      (if (k:syntax? stx)
          (let ([e (k:syntax-e stx)]) (if (k:pair? e) (if (k:identifier? (k:car e)) (k:syntax-e (k:car e)) 0) 0))
          0)))

(func (pattern-texts [ds i32] [x i32]) -> i32
  (if (k:null? ds) '() (let ([t (pattern-text (k:car ds) x)]) (k:cons t (pattern-texts (k:cdr ds) x)))))

;; "a", "a or b", "a, b or c".
(func (alternatives [ts i32]) -> i32
  (if (k:null? (k:cdr ts))
      (k:car ts)
      (if (k:null? (k:cddr ts))
          (k:format '"~a or ~a" ts)
          (k:string-append (k:string-append (k:car ts) '", ") (alternatives (k:cdr ts))))))

;; Description d written as its pattern is, in an error about x: a _ at its
;; head as x's head.
(func (pattern-text [d i32] [x i32]) -> i32
  (let ([l (k:splice-list x)])
    (if (if (i32.eq (k:car d) 'list)
            (if (k:pair? (k:cadr d))
                (if (k:equal? (k:car (k:cadr d)) '(any)) (if (k:pair? l) (k:identifier? (k:car l)) 0) 0)
                0)
            0)
        (description-text `(list ,(k:cons `(datum ,(k:syntax-e (k:car l))) (k:cdr (k:cadr d))) ,(k:caddr d)))
        (description-text d))))

(func (description-text [d i32]) -> i32
  (let ([kind (k:car d)])
    (if (if (i32.eq kind 'var) 1 (i32.eq kind 'bound))
        (k:symbol->string (k:caddr d))
        (if (i32.eq kind 'datum)
            (k:format '"~s" (k:cdr d))
            (if (i32.eq kind 'any)
                '"_"
                (if (i32.eq kind 'check)
                    (if (k:null? (k:cddr d)) '"_" (description-text (k:last (k:cddr d))))
                    (if (i32.eq kind 'repeat)
                        (k:string-append (description-text (k:cadr d)) '" ...")
                        (k:format '"(~a~a)"
                                  `(,(spaced (description-texts (k:cadr d)))
                                    ,(if (i32.eq (k:car (k:caddr d)) 'null)
                                         '""
                                         (k:string-append '" . " (description-text (k:caddr d)))))))))))))

(func (description-texts [ds i32]) -> i32
  (if (k:null? ds) '() (let ([t (description-text (k:car ds))]) (k:cons t (description-texts (k:cdr ds))))))

;; Strings ts, with a space between each two.
(func (spaced [ts i32]) -> i32
  (if (k:null? ts)
      '""
      (if (k:null? (k:cdr ts))
          (k:car ts)
          (k:string-append (k:string-append (k:car ts) '" ") (spaced (k:cdr ts))))))
