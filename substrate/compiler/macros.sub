;; The macro tools: syntax-match, whose pattern language Scheme's match shares, quasiquote and
;; quasisyntax, for/each, for/list and for/fold, fmt and define-macro, with the syntax module they
;; work on. Each is an ordinary macro, whose function takes the form's context, which the code it
;; makes names what it means as, and a use of the form, and gives the use's expansion.
(require-unqualified syntax "syntax.sub")

(provide (all-from-out syntax) syntax-match _ ... ? quasiquote quasisyntax for/each for/list for/fold fmt define-macro
         syntax-match-expansion quasiquote-expansion quasisyntax-expansion for/each-expansion for/list-expansion
         for/fold-expansion fmt-expansion define-macro-expansion pattern-word-expansion
         parse-patterns parse-match-patterns match-clauses pattern-texts)

;; This module is written with the forms it binds, so the functions they run are the running
;; compiler's copy of it, which the module's compile-time code gets by requiring the module.
(begin-for-syntax
  (require-unqualified syntax "syntax.sub")
  (require macros "macros.sub" syntax-match-expansion quasiquote-expansion quasisyntax-expansion for/each-expansion
           for/list-expansion for/fold-expansion fmt-expansion define-macro-expansion pattern-word-expansion))

(define-syntax syntax-match syntax-match-expansion #'here)
(define-syntax _ pattern-word-expansion #'here)
(define-syntax ... pattern-word-expansion #'here)
(define-syntax ? pattern-word-expansion #'here)
(define-syntax quasiquote quasiquote-expansion #'here)
(define-syntax quasisyntax quasisyntax-expansion #'here)
(define-syntax for/each for/each-expansion #'here)
(define-syntax for/list for/list-expansion #'here)
(define-syntax for/fold for/fold-expansion #'here)
(define-syntax fmt fmt-expansion #'here)
(define-syntax define-macro define-macro-expansion #'here)

;; ---- expansions ----

(define context datum 0)
(define counter i32 0)

;; The names an expansion makes need differ only from each other: each expansion's are its own.
(define (begin-expansion! [env datum])
  (set! context env)
  (set! counter 0))

(define (src [d datum]) -> datum (datum->syntax context d 0))

(define (at [where datum] [form datum]) -> datum (datum->syntax form (syntax-e form) where))

(define (fresh [base datum]) -> datum
  (+= counter 1)
  (src (string->symbol (format-message "~a~a" `(,base ,(fixnum counter))))))

;; ---- syntax-match ----

(define (syntax-match-expansion [env datum] [s datum]) -> datum
  (begin-expansion! env)
  (let* ([parts (syntax->list s)]
         [clauses (if (and (!= parts 0) (>= (length parts) 3))
                      (match-clauses (cddr parts) 'syntax-match)
                      (raise-syntax-error 'syntax-match '"expected (syntax-match subject [pattern body ...] ...)" s))]
         [parsed (parse-patterns (for/list ([c clauses]) (car c)) 'syntax-match
                                 (for/list ([w '(_ ... ? quote quote-syntax)]) (src w)))]
         [x (fresh 's)])
    (at s (src `(let ([,x ,(cadr parts)])
                  ,(compile-clauses clauses (car parsed) (cadr parsed) x
                                    `(throw compile-error (match-failure (quote ,(pattern-texts (car parsed))) ,x) ,x 0)
                                    (caddr parsed)))))))

(define (nth [l datum] [i datum]) -> datum (list-ref l (fixnum-value i)))

;; A test is code, or (always code ...): code that always matches.
(define (always? [t datum]) -> i32 (and (pair? t) (== (car t) 'always)))

(define (test-code [t datum]) -> datum (if (always? t) `(begin ,@(cdr t) 1) t))

(define (both [a datum] [b datum]) -> datum
  (cond [(and (always? a) (always? b)) (cons 'always (append (cdr a) (cdr b)))]
        [(always? a) `(begin ,@(cdr a) ,(test-code b))]
        [else `(if ,a ,(test-code b) 0)]))

(define (compile-clauses [cs datum] [ds datum] [varss datum] [x datum] [last datum] [values datum]) -> datum
  (if (null? cs)
      last
      (let* ([vars (for/list ([v (car varss)]) (fresh 'v))]
             [test (compile-test (car ds) x vars values)]
             [body `(let (,@(for/list ([v (car varss)] [t vars]) `[,v ,t])) ,@(cdr (car cs)))])
        (if (always? test)
            `(let (,@(for/list ([t vars]) `[,t datum 0])) ,@(cdr test) ,body)
            `(let (,@(for/list ([t vars]) `[,t datum 0]))
               (if ,test ,body ,(compile-clauses (cdr cs) (cdr ds) (cdr varss) x last values)))))))

(define (compile-test [d datum] [x datum] [vars datum] [values datum]) -> datum
  (case (car d)
    [('var) `(always (set! ,(nth vars (cadr d)) ,x))]
    [('any) '(always)]
    [('datum) `(match-datum? ,x (quote ,(cadr d)))]
    [('bound) `(match-bound? ,x ,(nth values (cadr d)))]
    [('check) (both `(,(nth values (cadr d)) ,x) (compile-tests (cddr d) x vars values))]
    [else (compile-elements (cadr d) (caddr d) x vars values)]))

(define (compile-tests [ds datum] [x datum] [vars datum] [values datum]) -> datum
  (cond [(null? ds) '(always)]
        [(null? (cdr ds)) (compile-test (car ds) x vars values)]
        [else (both (compile-test (car ds) x vars values) (compile-tests (cdr ds) x vars values))]))

(define (compile-elements [es datum] [tail datum] [r datum] [vars datum] [values datum]) -> datum
  (cond [(null? es) (if (== (car tail) 'null) `(null? (splice-list ,r)) (compile-test tail r vars values))]
        [(== (car (car es)) 'repeat)
         (if (and (null? (cdr es)) (== (car tail) 'null))
             (compile-repeat (car es) r vars values)
             (compile-backtrack (car es) (cdr es) tail r vars values))]
        [else
         (let ([m (fresh 'm)] [a (fresh 'a)] [d (fresh 'd)])
           `(let ([,m (match-pair ,r)])
              (if ,m
                  ,(if (== (car (car es)) 'any)
                       `(let ([,d (cdr ,m)]) ,(test-code (compile-elements (cdr es) tail d vars values)))
                       `(let ([,a (car ,m)] [,d (cdr ,m)])
                          ,(test-code (both (compile-test (car es) a vars values) (compile-elements (cdr es) tail d vars values)))))
                  0)))]))

(define (acc-sets [is datum] [accs datum] [vars datum] [last i32]) -> datum
  (for/list ([i is] [acc accs])
    (if last `(set! ,(nth vars i) (reverse ,acc)) `(set! ,acc (cons ,(nth vars i) ,acc)))))

(define (compile-repeat [e datum] [r datum] [vars datum] [values datum]) -> datum
  (let ([p (cadr e)] [is (caddr e)])
    (cond [(== (car p) 'var)
           (let ([xs (fresh 'xs)]) `(let ([,xs (match-elements ,r)]) (if ,xs (begin (set! ,(nth vars (cadr p)) ,xs) 1) 0)))]
          [(== (car p) 'any) `(if (match-elements ,r) 1 0)]
          [else
           (let ([ok (fresh 'ok)] [rest (fresh 'r)] [m (fresh 'm)] [a (fresh 'a)] [accs (for/list ([i is]) (fresh 'acc))])
             `(let ([,ok i32 0] [,rest ,r] ,@(for/list ([acc accs]) `[,acc datum nil]))
                (while 1
                  (let ([,m (splice-list ,rest)])
                    (if (null? ,m) (begin ,@(acc-sets is accs vars 1) (set! ,ok 1) (break)))
                    (if (not (pair? ,m)) (break))
                    (let ([,a (car ,m)])
                      (if (not ,(test-code (compile-test p a vars values))) (break))
                      ,@(acc-sets is accs vars 0)
                      (set! ,rest (cdr ,m)))))
                ,ok))])))

(define (compile-backtrack [e datum] [es datum] [tail datum] [r datum] [vars datum] [values datum]) -> datum
  (let ([p (cadr e)] [is (caddr e)] [ok (fresh 'ok)] [n (fresh 'n)] [rest (fresh 'r)] [m (fresh 'm)] [a (fresh 'a)]
        [after (fresh 'after)] [i (fresh 'i)] [accs (for/list ([j (caddr e)]) (fresh 'acc))])
    `(let ([,ok i32 0] [,n i32 0] [,rest ,r])
       (while 1
         (let ([,m (splice-list ,rest)])
           (if (not (pair? ,m)) (break))
           (let ([,a (car ,m)])
             (if (not ,(test-code (compile-test p a vars values))) (break))
             (+= ,n 1)
             (set! ,rest (cdr ,m)))))
       (while 1
         (let ([,after (match-after ,r ,n)])
           (if ,(test-code (compile-elements es tail after vars values))
               (let ([,i i32 0] [,rest ,r] ,@(for/list ([acc accs]) `[,acc datum nil]))
                 (while (< ,i ,n)
                   (let* ([,m (splice-list ,rest)] [,a (car ,m)])
                     ,(test-code (compile-test p a vars values))
                     ,@(acc-sets is accs vars 0)
                     (set! ,rest (cdr ,m))
                     (+= ,i 1)))
                 ,@(acc-sets is accs vars 1)
                 (set! ,ok 1)
                 (break))))
         (if (== ,n 0) (break))
         (-= ,n 1))
       ,ok)))

;; ---- quasiquote, quasisyntax ----

(define (quasiquote-expansion [env datum] [s datum]) -> datum (begin-expansion! env) (quasi-form s 0))
(define (quasisyntax-expansion [env datum] [s datum]) -> datum (begin-expansion! env) (quasi-form s 1))

;; A part of the template with no unquote in it is quoted.
(define unquoting datum 0)
(define splicing datum 0)
(define syntaxes i32 0)

(define (quasi-form [s datum] [syntax i32]) -> datum
  (syntax-match s
    [(_ t)
     (set! syntaxes syntax)
     (set! unquoting (if syntax 'unsyntax 'unquote))
     (set! splicing (if syntax 'unsyntax-splicing 'unquote-splicing))
     (at s (template t))]))

(define (named? [x datum] [name datum]) -> i32 (and (identifier? x) (== (syntax-e x) name)))

(define (fixed? [t datum]) -> i32
  (let ([e (if (syntax? t) (syntax-e t) t)])
    (or (not (pair? e))
        (and (not (named? (car e) unquoting)) (not (named? (car e) splicing)) (fixed? (car e)) (fixed? (cdr e))))))

(define (template [t datum]) -> datum
  (cond [(fixed? t) (quasi-constant t)]
        [(named? (car (syntax-e t)) unquoting) (cadr (syntax-e t))]
        [syntaxes (src `(syntax-rewrap (quote-syntax ,(syntax-rewrap t nil)) ,(template-list (syntax-e t))))]
        [else (template-list (syntax-e t))]))

(define (template-list [l datum]) -> datum
  (cond [(and (not syntaxes) (fixed? l)) (quasi-constant l)]
        [(null? l) (src 'nil)]
        [(syntax? l) (template l)]
        [(named? (car l) unquoting) (cadr l)]
        [(let ([e (if (syntax? (car l)) (syntax-e (car l)) 0)]) (and (pair? e) (named? (car e) splicing)))
         (let ([v (cadr (syntax-e (car l)))]) (src `(append ,(if syntaxes `(splice-list ,v) v) ,(template-list (cdr l)))))]
        [else (src `(cons ,(template (car l)) ,(template-list (cdr l))))]))

;; The empty list is nil, so that syntax.sub, which defines quoted data, can make lists.
(define (quasi-constant [t datum]) -> datum
  (cond [syntaxes (src `(quote-syntax ,t))]
        [(null? (syntax->datum t)) (src 'nil)]
        [else (src `(quote ,t))]))

;; ---- for/each, for/list, for/fold ----

(define (for/each-expansion [env datum] [s datum]) -> datum (begin-expansion! env) (for-form 'for/each s))
(define (for/list-expansion [env datum] [s datum]) -> datum (begin-expansion! env) (for-form 'for/list s))
(define (for/fold-expansion [env datum] [s datum]) -> datum (begin-expansion! env) (for-form 'for/fold s))

(define (for-form [kind datum] [s datum]) -> datum
  (case kind
    [('for/each)
     (syntax-match s
       [(_ (c ...) body0 body ...) (at s (src (for-loop s c `(begin ,body0 ,@body))))]
       [_ (raise-syntax-error 0 '"expected (for/each (clause ...) body ...)" s)])]
    [('for/list)
     (syntax-match s
       [(_ (c ...) body0 body ...)
        (let ([acc (fresh 'acc)])
          (at s (src `(let ([,acc nil]) ,(for-loop s c `(set! ,acc (cons (begin ,body0 ,@body) ,acc))) (reverse ,acc)))))]
       [_ (raise-syntax-error 0 '"expected (for/list (clause ...) body ...)" s)])]
    [else
     (syntax-match s
       [(_ (((? identifier? acc) init)) (c ...) body0 body ...)
        (at s (src `(let ([,acc ,init]) ,(for-loop s c `(set! ,acc (begin ,body0 ,@body))) ,acc)))]
       [_ (raise-syntax-error 0 '"expected (for/fold ([acc init]) (clause ...) body ...)" s)])]))

;; The lists step before the body, so that continue takes the next elements.
(define (for-loop [s datum] [cs datum] [each datum]) -> datum
  (syntax-match cs
    [(((? identifier? x) l) ... #:when g) (for-code s x l `(when ,g ,each))]
    [(((? identifier? x) l) ...) (for-code s x l each)]
    [_ (raise-syntax-error 0 '"expected ([x list] ... [#:when test])" s)]))

(define (for-code [s datum] [xs datum] [ls datum] [each datum]) -> datum
  (when (null? xs) (raise-syntax-error 0 '"expected ([x list] ... [#:when test])" s))
  (let ([ts (for/list ([x xs]) (fresh 'l))])
    `(let (,@(for/list ([t ts] [l ls]) `[,t ,l]))
       (while ,(all-pairs ts)
         (let (,@(for/list ([x xs] [t ts]) `[,x (car ,t)]))
           ,@(for/list ([t ts]) `(set! ,t (cdr ,t)))
           ,each)))))

(define (all-pairs [ts datum]) -> datum (if (null? (cdr ts)) `(pair? ,(car ts)) `(and (pair? ,(car ts)) ,(all-pairs (cdr ts)))))

;; ---- fmt, define-macro, the pattern words ----

(define (fmt-expansion [env datum] [s datum]) -> datum
  (begin-expansion! env)
  (syntax-match s [(_ t a ...) (at s (src `(format-message ,t ,(for/fold ([l 'nil]) ([x (reverse a)]) `(cons ,x ,l)))))]))

;; The macro's function is the module's compile-time code: its define and datum are the module's.
(define (define-macro-expansion [env datum] [s datum]) -> datum
  (begin-expansion! env)
  (syntax-match s
    [(_ ((? identifier? name) (? identifier? x)) body ...)
     (let ([d (datum->syntax name 'datum 0)])
       (at s (core-syntax context `(begin (begin-for-syntax (,(datum->syntax name 'define 0) (,name (,x ,d)) -> ,d ,@body))
                                          (define-syntax ,name ,name))
                          0)))]
    [_ (raise-syntax-error 0 '"expected (define-macro (name stx) body ...)" s)]))

;; _, ... and ? are words of a pattern.
(define (pattern-word-expansion [env datum] [s datum]) -> datum (raise-syntax-error 0 '"allowed only in a pattern" s))

;; ---- patterns ----

;; A pattern is parsed into a description:
;;   (any)  (var i name)  (datum d)  (bound i name)  (check i pattern ...)  (null)
;;   (list (element ...) tail), an element (repeat pattern (i ...)) or a pattern
;;   (struct i name (pattern ...)), in match only
;; A var's i is its place among its pattern's variables; a bound's, check's or struct's is its place
;; among the values the patterns name, which the parse also gives.

(define who datum 0)
(define words datum nil)
(define pattern-values datum nil)
(define pattern-vars datum nil)
(define structs i32 0)

;; words are the caller's _, ..., ?, quote and quote-syntax.
(define (word? [x datum] [n u32]) -> i32 (and (identifier? x) (free-identifier=? x (list-ref words n))))

(define (two? [l datum]) -> i32 (and (pair? l) (pair? (cdr l)) (null? (cddr l))))

(define (numbers-from [i u32] [n u32]) -> datum (if (< i n) (cons (fixnum i) (numbers-from (+ i 1) n)) nil))

(define (value! [e datum]) -> datum
  (set! pattern-values (cons e pattern-values))
  (fixnum (- (length pattern-values) 1)))

(define (var! [id datum]) -> datum
  (when (ormap (lambda ([v datum]) -> i32 (== (syntax-e v) (syntax-e id))) pattern-vars)
    (raise-syntax-error who '"this pattern variable appears twice in its pattern" id))
  (set! pattern-vars (cons id pattern-vars))
  (fixnum (- (length pattern-vars) 1)))

(define (parse [p datum]) -> datum
  (let ([e (syntax-e p)])
    (cond [(symbol? e)
           (cond [(word? p 0) '(any)]
                 [(or (word? p 1) (word? p 2)) (raise-syntax-error who '"not allowed here in a pattern" p)]
                 [else `(var ,(var! p) ,e)])]
          [(pair? e) (parse-form p e)]
          [(null? e) '(list () (null))]
          [else `(datum ,e)])))

(define (parse-form [p datum] [e datum]) -> datum
  (cond [(and (two? e) (word? (car e) 3)) `(datum ,(syntax->datum (cadr e)))]
        [(and (two? e) (word? (car e) 4))
         (unless (identifier? (cadr e)) (raise-syntax-error who '"expected #'identifier" p))
         `(bound ,(value! p) ,(syntax-e (cadr e)))]
        [(word? (car e) 2)
         (unless (and (pair? (cdr e)) (list? (cdr e))) (raise-syntax-error who '"expected (? predicate pattern ...)" p))
         (let ([i (value! (cadr e))]) (cons 'check (cons i (parse-all (cddr e)))))]
        [else
         (let ([info (if structs (struct-info-of (car e)) 0)])
           (if (!= info 0) (parse-struct p e info) (let ([r (elements e)]) `(list ,(car r) ,(cdr r)))))]))

(define (parse-all [ps datum]) -> datum (if (null? ps) nil (let ([d (parse (car ps))]) (cons d (parse-all (cdr ps))))))

(define (elements [l datum]) -> datum
  (cond [(not (pair? l)) (cons nil (if (null? l) '(null) (parse l)))]
        [(word? (car l) 1) (raise-syntax-error who '"... follows the pattern it repeats" (car l))]
        [(and (pair? (cdr l)) (word? (cadr l) 1))
         (let* ([before (length pattern-vars)] [d (parse (car l))]
                [repeat `(repeat ,d ,(numbers-from before (length pattern-vars)))] [r (elements (cddr l))])
           (cons (cons repeat (car r)) (cdr r)))]
        [else (let* ([d (parse (car l))] [r (elements (cdr l))]) (cons (cons d (car r)) (cdr r)))]))

;; ((description ...) (variables ...) (value ...)), the patterns ps of the form name.
(define (parse-patterns [ps datum] [name datum] [ws datum]) -> datum
  (let ([descs nil] [varss nil])
    (set! who name)
    (set! words ws)
    (set! pattern-values nil)
    (for/each ([p ps])
      (set! pattern-vars nil)
      (set! descs (cons (parse p) descs))
      (set! varss (cons (reverse pattern-vars) varss)))
    `(,(reverse descs) ,(reverse varss) ,(reverse pattern-values))))

(define (parse-match-patterns [ps datum] [name datum] [ws datum]) -> datum
  (let ([outer structs] [parsed datum 0])
    (set! structs 1)
    (set! parsed (try (parse-patterns ps name ws) [catch-all (set! structs outer) (rethrow)]))
    (set! structs outer)
    parsed))

(define (match-clauses [cs datum] [name datum]) -> datum
  (for/list ([c cs])
    (let ([l (syntax->list c)])
      (unless (and (!= l 0) (>= (length l) 2)) (raise-syntax-error name '"expected a clause [pattern body ...]" c))
      l)))

;; A struct of Scheme's: its name is bound to a transformer whose environment is (struct-info ...).
(define (struct-info-of [id datum]) -> datum
  (let ([v (if (identifier? id) (syntax-local-value id) 0)])
    (if (and (!= v 0) (transformer? v))
        (let ([l (syntax->list (transformer-env v))])
          (if (and (!= l 0) (pair? l) (identifier? (car l)) (== (syntax-e (car l)) 'struct-info)) l 0))
        0)))

(define (parse-struct [p datum] [e datum] [info datum]) -> datum
  (let ([n (length (syntax->list (list-ref info 5)))] [name (syntax-e (cadr info))])
    (unless (== (length (cdr e)) n)
      (raise-syntax-error who (format '"~a has ~a field~a, not ~a"
                                      `(,name ,(fixnum n) ,(if (== n 1) '"" '"s") ,(fixnum (length (cdr e)))))
                          p))
    (let ([i (value! (list-ref info 3))])
      (for/each ([x (syntax->list (list-ref info 4))]) (value! x))
      `(struct ,i ,name ,(parse-all (cdr e))))))

;; ---- texts ----

;; Each pattern of ds as match-failure shows it: a pattern that starts with _ is (text), the text
;; that follows the head of the form it is used on.
(define (pattern-texts [ds datum]) -> datum
  (for/list ([d ds])
    (if (and (== (car d) 'list) (pair? (cadr d)) (== (car (car (cadr d))) 'any))
        `(,(format '"~a~a)" `(,(for/fold ([s '""]) ([x (cdr (cadr d))]) (format '"~a ~a" `(,s ,(description x))))
                              ,(tail-text (caddr d)))))
        (description d))))

(define (description [d datum]) -> datum
  (case (car d)
    [('var 'bound) (symbol->string (caddr d))]
    [('datum) (format '"~s" (cdr d))]
    [('any) '"_"]
    [('check) (if (null? (cddr d)) '"_" (description (last (cddr d))))]
    [('repeat) (format '"~a ..." `(,(description (cadr d))))]
    [else (format '"(~a~a)" `(,(spaced (for/list ([x (cadr d)]) (description x))) ,(tail-text (caddr d))))]))

(define (tail-text [t datum]) -> datum (if (== (car t) 'null) '"" (format '" . ~a" `(,(description t)))))

(define (spaced [ts datum]) -> datum
  (cond [(null? ts) '""]
        [(null? (cdr ts)) (car ts)]
        [else (format '"~a ~a" `(,(car ts) ,(spaced (cdr ts))))]))
