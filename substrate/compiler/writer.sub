;; Characters into a buffer, as the reader reads them.

(provide write-char)

(define (write-char [b (ptr buffer)] [c u32])
  (let ([name (char-name c)])
    (buffer-add-string! b "#\\")
    (cond [(!= (-> name length) 0) (buffer-add-string! b name)]
          [(< c #\space) (buffer-add-byte! b #\x) (write-digits b c 16)]
          [else (buffer-add-utf-8! b c)])))

(define (char-name [c u32]) -> string
  (case c
    [(#\space) "space"] [(#\newline) "newline"] [(#\tab) "tab"] [(#\return) "return"] [(#\nul) "nul"]
    [(#\alarm) "alarm"] [(#\backspace) "backspace"] [(#\escape) "escape"] [(#\delete) "delete"]
    [else ""]))
