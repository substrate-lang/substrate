;; Lifecycle: permanent. Part of the kernel: its data and the functions on
;; it, which the compiler carries into the programs it writes.
;;
;; The kernel module (spec section 2): the data of every language built on
;; the kernel, syntax objects among them, and the functions macros use on
;; it. The data are immutable wasm GC objects. This module defines their
;; types and exports the functions macros use to take syntax apart and
;; build it; those functions are the macro contract. Code gets them with
;; (require name kernel). Compile-time code links to the running
;; compiler's instance of this module, and is compiled against it (spec
;; 1.4).
;;
;; Functions whose names start with % are internal: the compiler uses them,
;; and (require name kernel) does not bind them.
;; The type definitions are private too (spec appendix A).
;;
;; Contract conventions: data are eqref values; #f is the null reference.
;; Counts, indices, bytes and predicate results are i32 (predicates return
;; 1 or 0).

;; The memory holds error messages only. No syntax data lives in it.
(memory 1)

(import %host-trap "host" "trap" (i32 i32 ->))

(data %msg-pair 0 "expected a pair")
(data %msg-symbol 32 "expected a symbol")
(data %msg-string 64 "expected a string")
(data %msg-syntax 96 "expected a syntax object")
(data %msg-char 128 "expected a character")
(data %msg-fixnum 160 "expected a fixnum")
(data %msg-range 192 "index out of range")
(data %msg-integer 224 "expected an integer")
(data %msg-flonum 256 "expected a flonum")
(data %msg-builder 288 "expected a string builder")
(data %msg-keyword 320 "expected a keyword")
(data %name-local-binding 352 "%local-binding")
(data %msg-no-expander 384 "an expander query was used outside the expander")
(data %msg-syntax-error 448 "expected a syntax error")
(data %msg-transformer 480 "expected a transformer")

;; A transformer's code (spec 2.1): called with the transformer's
;; environment and the syntax. It is a group of its own, so a module that
;; makes transformers can declare it too, and give its functions this type.
(type %transformer-code (func (eqref eqref -> eqref)))

;; Bytes: a mutable byte array and nothing else, a type the contract
;; provides (spec 2.3) and quoted data holds (3.5). It is declared on its
;; own, as %transformer-code is, so that a module declaring the same type
;; has this one whatever kernel it runs with: its shape is its whole
;; meaning, and no other byte array of the kernel's is outside the group,
;; so nothing else is bytes by accident.
(type bytes (array (mut i8)))

;; One recursion group, so that no type declared elsewhere is the same wasm
;; type as one of these, unless it copies this whole group: wasm compares
;; types group by group (spec 5.2). Otherwise a program's struct of two
;; eqref fields would pass pair?.
(rec
  (type %string (array (mut i8)))
  (type %pair (struct (field car eqref) (field cdr eqref)))
  (type %symbol (struct (field name (ref %string)) (field hash i32)))
  (type %atom (struct (field kind i32) (field value i32)))    ; kind 0 char, 1 #t, 2 ()
  (type %syntax (struct (field e (mut eqref)) (field scopes eqref) (field srcloc eqref) (field props eqref)
                       (field pending (mut eqref))))
  (type %srcloc (struct (field source eqref) (field line i32) (field col i32) (field pos i32) (field span i32)))
  (type %table (array (mut eqref)))
  (type %integer (struct (field negative i32) (field magnitude i64)))
  (type %flonum (struct (field value f64)))
  (type %builder (struct (field bytes (mut (ref %string))) (field length (mut i32))))
  (type %keyword (struct (field name (ref %string))))
  (type %transformer (struct (field code (ref %transformer-code)) (field env eqref)))
  (type %syntax-error (struct (field message eqref) (field syntax eqref) (field srcloc eqref))))

(global %true eqref (struct.new %atom 1 0))
(global %nil eqref (struct.new %atom 2 0))
(global %symbols (mut (ref %table)) (array.new %table (ref.null eq) 1024))
(global %symbol-count (mut i32) 0)
(global %keywords (ref null %table) (array.new %table (ref.null eq) 64))

(func (%fail [addr i32] [len i32])
  (%host-trap addr len)
  (unreachable))

;; ---- atoms ------------------------------------------------------------------

(func (fixnum [n i32]) #:inline -> eqref (ref.i31 n))
(func (fixnum? [v eqref]) #:inline -> i32 (ref.test (ref i31) v))
;; A checked accessor, inlined, is a test, a cast and a get; its message
;; comes from a call, made only when the test fails.
(func (%fixnum-expected) -> i32 (%fail (data-address %msg-fixnum) (data-size %msg-fixnum)) (unreachable))
(func (fixnum-value [v eqref]) #:inline -> i32
  (if (ref.test (ref i31) v) (i31.get_s (ref.cast (ref i31) v)) (%fixnum-expected)))

;; Integers beyond the fixnum range: literals of up to 64 bits, which run
;; from -2^63 to 2^64 - 1 as in wasm. They are kept exactly, as a sign and
;; a 64-bit magnitude.
(func (integer [n i64]) #:inline -> eqref
  (if (i32.and (i64.ge_s n -1073741824) (i64.le_s n 1073741823))
      (fixnum (i32.wrap_i64 n))
      (if (i64.lt_s n 0)
          (struct.new %integer 1 (i64.sub 0 n))
          (struct.new %integer 0 n))))

(func (integer? [v eqref]) #:inline -> i32 (i32.or (fixnum? v) (ref.test (ref %integer) v)))

(func (%integer-expected) -> (ref %integer) (%fail (data-address %msg-integer) (data-size %msg-integer)) (unreachable))
(func (%as-integer [v eqref]) #:inline -> (ref %integer)
  (if (ref.test (ref %integer) v) (ref.cast (ref %integer) v) (%integer-expected)))

;; The value's 64-bit two's complement.
(func (integer-value [v eqref]) #:inline -> i64
  (if (fixnum? v) (return (i64.extend_i32_s (fixnum-value v))))
  (let ([x (%as-integer v)])
    (if (struct.get %integer negative x)
        (i64.sub 0 (struct.get %integer magnitude x))
        (struct.get %integer magnitude x))))

;; 1 if the value is negative. With integer-value it gives the exact value:
;; a non-negative one is integer-value read as unsigned.
(func (integer-negative? [v eqref]) #:inline -> i32
  (if (fixnum? v) (return (i32.lt_s (fixnum-value v) 0)))
  (struct.get %integer negative (%as-integer v)))

(func (%make-integer [negative i32] [magnitude i64]) -> eqref
  (struct.new %integer negative magnitude))

(func (flonum [x f64]) -> eqref (struct.new %flonum x))
(func (flonum? [v eqref]) #:inline -> i32 (ref.test (ref %flonum) v))
(func (flonum-value [v eqref]) -> f64
  (if (i32.eqz (flonum? v)) (%fail (data-address %msg-flonum) (data-size %msg-flonum)))
  (struct.get %flonum value (ref.cast (ref %flonum) v)))

(func (%atom? [v eqref] [kind i32]) #:inline -> i32
  (if (ref.test (ref %atom) v)
      (i32.eq (struct.get %atom kind (ref.cast (ref %atom) v)) kind)
      0))

(func (char? [v eqref]) #:inline -> i32 (%atom? v 0))
(func (integer->char [n i32]) -> eqref (struct.new %atom 0 n))
(func (char->integer [c eqref]) -> i32
  (if (i32.eqz (char? c)) (%fail (data-address %msg-char) (data-size %msg-char)))
  (struct.get %atom value (ref.cast (ref %atom) c)))

(func (null? [v eqref]) #:inline -> i32 (ref.eq v %nil))
(func (boolean? [v eqref]) #:inline -> i32 (i32.or (ref.is_null v) (ref.eq v %true)))

;; ---- pairs and lists ----------------------------------------------------------

(func (cons [a eqref] [d eqref]) #:inline -> eqref (struct.new %pair a d))
;; %pair is final, so the test compares one type.
(func (pair? [v eqref]) #:inline -> i32 (ref.test (ref %pair) v))

(func (%pair-expected) -> (ref %pair) (%fail (data-address %msg-pair) (data-size %msg-pair)) (unreachable))
(func (%as-pair [v eqref]) #:inline -> (ref %pair)
  (if (ref.test (ref %pair) v) (ref.cast (ref %pair) v) (%pair-expected)))

(func (car [p eqref]) #:inline -> eqref (struct.get %pair car (%as-pair p)))
(func (cdr [p eqref]) #:inline -> eqref (struct.get %pair cdr (%as-pair p)))
;; For code that has tested pair? itself: given anything else they trap
;; on the cast, without the message.
(func (unsafe-car [p eqref]) #:inline -> eqref (struct.get %pair car (ref.cast (ref %pair) p)))
(func (unsafe-cdr [p eqref]) #:inline -> eqref (struct.get %pair cdr (ref.cast (ref %pair) p)))
(func (cadr [p eqref]) #:inline -> eqref (car (cdr p)))
(func (cddr [p eqref]) #:inline -> eqref (cdr (cdr p)))
(func (caddr [p eqref]) #:inline -> eqref (car (cddr p)))
(func (cdddr [p eqref]) #:inline -> eqref (cdr (cddr p)))

(func (list? [l eqref]) -> i32
  (block done
    (loop next
      (br-if done (i32.eqz (pair? l)))
      (set! l (cdr l))
      (br next)))
  (null? l))

(func (length [l eqref]) -> i32
  (let ([n 0])
    (block done
      (loop next
        (br-if done (i32.eqz (pair? l)))
        (set! n (i32.add n 1))
        (set! l (cdr l))
        (br next)))
    n))

;; a's elements, then b, shared: made from the last, by a loop, so a
;; list of any length can be appended.
(func (append [a eqref] [b eqref]) -> eqref
  (let ([r (reverse a)])
    (block done
      (loop next
        (br-if done (i32.eqz (pair? r)))
        (set! b (cons (car r) b))
        (set! r (cdr r))
        (br next)))
    b))

(func (reverse [l eqref]) -> eqref
  (let ([acc %nil])
    (block done
      (loop next
        (br-if done (i32.eqz (pair? l)))
        (set! acc (cons (car l) acc))
        (set! l (cdr l))
        (br next)))
    acc))

;; ---- strings and symbols --------------------------------------------------------

(func (string? [v eqref]) #:inline -> i32 (ref.test (ref %string) v))

(func (%as-string [v eqref]) #:inline -> (ref %string)
  (if (i32.eqz (string? v)) (%fail (data-address %msg-string) (data-size %msg-string)))
  (ref.cast (ref %string) v))

(func (string-length [s eqref]) #:inline -> i32 (array.len (%as-string s)))

(func (string-byte [s eqref] [i i32]) #:inline -> i32
  (let ([a (%as-string s)])
    (if (i32.ge_u i (array.len a)) (%fail (data-address %msg-range) (data-size %msg-range)))
    (array.get_u %string a i)))

(func (string=? [a eqref] [b eqref]) -> i32
  (let* ([x (%as-string a)] [y (%as-string b)] [n (array.len x)] [i 0])
    (if (i32.ne n (array.len y)) (return 0))
    (block done
      (loop next
        (br-if done (i32.ge_u i n))
        (if (i32.ne (array.get_u %string x i) (array.get_u %string y i)) (return 0))
        (set! i (i32.add i 1))
        (br next)))
    1))

(func (string-append [a eqref] [b eqref]) -> eqref
  (let* ([x (%as-string a)] [y (%as-string b)]
         [nx (array.len x)] [ny (array.len y)]
         [s (array.new_default %string (i32.add nx ny))])
    (array.copy %string %string s 0 x 0 nx)
    (array.copy %string %string s nx y 0 ny)
    s))

;; FNV-1a over the bytes.
(func (%string-hash [s (ref %string)]) -> i32
  (let ([h #x811c9dc5] [i 0] [n (array.len s)])
    (block done
      (loop next
        (br-if done (i32.ge_u i n))
        (set! h (i32.mul (i32.xor h (array.get_u %string s i)) 16777619))
        (set! i (i32.add i 1))
        (br next)))
    h))

;; Strings are immutable UTF-8. A builder collects bytes, and makes a new
;; string of them if they are UTF-8.

(func (make-string-builder) -> eqref
  (struct.new %builder (array.new_default %string 16) 0))

(func (%as-builder [b eqref]) -> (ref %builder)
  (if (i32.eqz (ref.test (ref %builder) b)) (%fail (data-address %msg-builder) (data-size %msg-builder)))
  (ref.cast (ref %builder) b))

;; Room in builder b for n more bytes.
(func (%builder-reserve [b (ref %builder)] [n i32])
  (let ([need (i32.add (struct.get %builder length b) n)] [bytes (struct.get %builder bytes b)])
    (if (i32.gt_u need (array.len bytes))
        (let ([bigger (array.new_default %string (i32.add need (array.len bytes)))])
          (array.copy %string %string bigger 0 bytes 0 (struct.get %builder length b))
          (struct.set %builder bytes b bigger)))))

(func (string-builder-add-byte! [b eqref] [byte i32])
  (let ([x (%as-builder b)])
    (%builder-reserve x 1)
    (array.set %string (struct.get %builder bytes x) (struct.get %builder length x) byte)
    (struct.set %builder length x (i32.add (struct.get %builder length x) 1))))

;; Add bytes start to end of string s.
(func (string-builder-add! [b eqref] [s eqref] [start i32] [end i32])
  (let ([x (%as-builder b)] [str (%as-string s)])
    (if (i32.or (i32.gt_u start end) (i32.gt_u end (array.len str)))
        (%fail (data-address %msg-range) (data-size %msg-range)))
    (%builder-reserve x (i32.sub end start))
    (array.copy %string %string (struct.get %builder bytes x) (struct.get %builder length x)
                str start (i32.sub end start))
    (struct.set %builder length x (i32.add (struct.get %builder length x) (i32.sub end start)))))

;; A new string of the builder's bytes, or #f if they are not UTF-8.
(func (string-builder->string [b eqref]) -> eqref
  (let* ([x (%as-builder b)] [n (struct.get %builder length x)] [bytes (struct.get %builder bytes x)])
    (if (i32.eqz (%utf8? bytes n)) (return (ref.null eq)))
    (let ([s (array.new_default %string n)])
      (array.copy %string %string s 0 bytes 0 n)
      s)))

;; Are the first n bytes of a UTF-8: shortest forms of scalar values only?
(func (%utf8? [a (ref %string)] [n i32]) -> i32
  (let ([i 0] [b 0] [k 0] [lo 128] [hi 191])
    (block done
      (loop next
        (br-if done (i32.ge_u i n))
        (set! b (array.get_u %string a i))
        (set! lo 128)
        (set! hi 191)
        (if (i32.lt_u b 128)
            (set! k 0)
            (if (i32.lt_u b 194)
                (return 0)
                (if (i32.lt_u b 224)
                    (set! k 1)
                    (if (i32.lt_u b 240)
                        (begin
                          (set! k 2)
                          (if (i32.eq b 224) (set! lo 160))
                          (if (i32.eq b 237) (set! hi 159)))
                        (if (i32.lt_u b 245)
                            (begin
                              (set! k 3)
                              (if (i32.eq b 240) (set! lo 144))
                              (if (i32.eq b 244) (set! hi 143)))
                            (return 0))))))
        (set! i (i32.add i 1))
        ;; k continuation bytes, the first in lo..hi, the others in 128..191.
        (block conts
          (loop cont
            (br-if conts (i32.eqz k))
            (if (i32.ge_u i n) (return 0))
            (set! b (array.get_u %string a i))
            (if (i32.or (i32.lt_u b lo) (i32.gt_u b hi)) (return 0))
            (set! lo 128)
            (set! hi 191)
            (set! i (i32.add i 1))
            (set! k (i32.sub k 1))
            (br cont)))
        (br next)))
    1))

(func (symbol? [v eqref]) #:inline -> i32 (ref.test (ref %symbol) v))

(func (symbol->string [s eqref]) -> eqref
  (if (i32.eqz (symbol? s)) (%fail (data-address %msg-symbol) (data-size %msg-symbol)))
  (struct.get %symbol name (ref.cast (ref %symbol) s)))

;; The symbol named by string `name`, made on first use. Two symbols with
;; the same name are the same reference. The table of symbols doubles when
;; it holds twice as many as it has buckets, so that a bucket stays short.
(func (string->symbol [name eqref]) -> eqref
  (let* ([str (%as-string name)]
         [hash (%string-hash str)]
         [l (array.get %table %symbols (i32.and hash (i32.sub (array.len %symbols) 1)))])
    (block done
      (loop next
        (br-if done (i32.eqz (pair? l)))
        (if (string=? (symbol->string (car l)) name) (return (car l)))
        (set! l (cdr l))
        (br next)))
    (if (i32.ge_u %symbol-count (i32.shl (array.len %symbols) 1))
        (let ([old %symbols] [i 0])
          (set! %symbols (array.new %table (ref.null eq) (i32.shl (array.len old) 1)))
          (block done
            (loop next
              (br-if done (i32.ge_u i (array.len old)))
              (set! l (array.get %table old i))
              (block moved (loop each (br-if moved (i32.eqz (pair? l))) (drop (%symbol-add (car l))) (set! l (cdr l)) (br each)))
              (set! i (i32.add i 1))
              (br next)))))
    (set! %symbol-count (i32.add %symbol-count 1))
    (%symbol-add (struct.new %symbol str hash))))

;; Symbol sym, put in its bucket.
(func (%symbol-add [sym eqref]) -> eqref
  (let ([slot (i32.and (symbol-hash sym) (i32.sub (array.len %symbols) 1))])
    (array.set %table %symbols slot (cons sym (array.get %table %symbols slot)))
    sym))


;; Keywords: #:name. Interned by name, like symbols, so equal keywords are
;; ref.eq.
(func (keyword? [v eqref]) #:inline -> i32 (ref.test (ref %keyword) v))

(func (keyword->string [k eqref]) -> eqref
  (if (i32.eqz (keyword? k)) (%fail (data-address %msg-keyword) (data-size %msg-keyword)))
  (struct.get %keyword name (ref.cast (ref %keyword) k)))

(func (string->keyword [name eqref]) -> eqref
  (let* ([str (%as-string name)]
         [slot (i32.and (%string-hash str) 63)]
         [l (array.get %table %keywords slot)])
    (block done
      (loop next
        (br-if done (i32.eqz (pair? l)))
        (if (string=? (keyword->string (car l)) name) (return (car l)))
        (set! l (cdr l))
        (br next)))
    (let ([k (struct.new %keyword str)])
      (array.set %table %keywords slot (cons k (array.get %table %keywords slot)))
      k)))
;; The hash of a symbol's name, kept in the symbol: the same for the same
;; name, so hash tables keyed by symbols need no other identity.
(func (symbol-hash [s eqref]) -> i32
  (if (i32.eqz (symbol? s)) (%fail (data-address %msg-symbol) (data-size %msg-symbol)))
  (struct.get %symbol hash (ref.cast (ref %symbol) s)))

(func (symbol-append [a eqref] [b eqref]) -> eqref
  (string->symbol (string-append (symbol->string a) (symbol->string b))))

;; ---- syntax objects -------------------------------------------------------------

;; The syntax literals a linklet builds name their scopes by index into
;; the linklet's scope table (spec 3.5). While the compiler instantiates a
;; linklet in a compile-time store, %scope-map holds the run's scope for
;; each index, which the compiler sets first and clears after. A linklet
;; a program runs has no map, and its literals keep the indexes, which
;; nothing reads at run time.
(global %scope-map (mut (ref null %table)) (ref.null %table))
(func (%scope-map-new [n i32]) (set! %scope-map (array.new %table (ref.null eq) n)))
(func (%scope-map-add [index i32] [scope i32]) (array.set %table %scope-map index (fixnum scope)))
(func (%scope-map-clear) (set! %scope-map (ref.null %table)))

;; The run's scopes come in any order, so each is added to the set in
;; turn, which keeps the set in order.
(func (%shift-scopes [scopes eqref]) -> eqref
  (let ([out %nil])
    (if (ref.is_null %scope-map) (return scopes))
    (block done
      (loop next
        (br-if done (i32.eqz (pair? scopes)))
        (set! out (%scopes-change out (fixnum-value (array.get %table %scope-map (fixnum-value (car scopes)))) 0))
        (set! scopes (cdr scopes))
        (br next)))
    out))

;; A syntax literal, as compiled code builds it: its scopes are mapped by
;; %scope-map. Other syntax objects are made directly.
(func (%make-syntax [e eqref] [scopes eqref] [srcloc eqref] [props eqref]) -> eqref
  (struct.new %syntax e (%shift-scopes scopes) srcloc props %nil))

;; A source location; line, col, pos and span are fixnums.
(func (%make-srcloc [source eqref] [line eqref] [col eqref] [pos eqref] [span eqref]) -> eqref
  (struct.new %srcloc source (fixnum-value line) (fixnum-value col) (fixnum-value pos) (fixnum-value span)))

(func (syntax? [v eqref]) #:inline -> i32 (ref.test (ref %syntax) v))

(func (%syntax-expected) -> (ref %syntax) (%fail (data-address %msg-syntax) (data-size %msg-syntax)) (unreachable))
(func (%as-syntax [v eqref]) #:inline -> (ref %syntax)
  (if (ref.test (ref %syntax) v) (ref.cast (ref %syntax) v) (%syntax-expected)))

(func (syntax-e [s eqref]) #:inline -> eqref
  (let ([x (%as-syntax s)])
    (if (pair? (struct.get %syntax pending x))
        (begin
          (struct.set %syntax e x (%push (struct.get %syntax e x) (struct.get %syntax pending x)))
          (struct.set %syntax pending x %nil)))
    (struct.get %syntax e x)))

;; Changes pending for the syntax objects inside a syntax object do not
;; change the shape of its datum, so these read it as it is.
(func (%syntax-datum [s eqref]) #:inline -> eqref (struct.get %syntax e (%as-syntax s)))
(func (identifier? [v eqref]) #:inline -> i32 (if (syntax? v) (symbol? (%syntax-datum v)) 0))

;; ---- scope changes ----
;;
;; Adding, removing or flipping a scope on a syntax object makes the same
;; change to every syntax object inside it (spec 6.1). Its own scopes change
;; at once; the change to its datum is pending, and syntax-e makes it one
;; level down when something looks inside. Pending changes are a list of
;; (scope . change), change 0 to add, 1 to remove or 2 to flip, at most
;; one per scope. Scope sets are lists of fixnums, newest (greatest)
;; first, so a change to a new scope is made at the front.

;; Scope set s with change made to scope sc.
(func (%scopes-change [s eqref] [sc i32] [change i32]) -> eqref
  (if (i32.eqz (pair? s)) (return (if (i32.eq change 1) s (cons (fixnum sc) %nil))))
  (let ([first (fixnum-value (car s))] [rest %nil])
    (if (i32.eq first sc) (return (if (i32.eqz change) s (cdr s))))
    (if (i32.lt_s first sc) (return (if (i32.eq change 1) s (cons (fixnum sc) s))))
    (set! rest (%scopes-change (cdr s) sc change))
    (if (ref.eq rest (cdr s)) s (cons (car s) rest))))

;; Scope set s with changes made.
(func (%scopes-apply [s eqref] [changes eqref]) -> eqref
  (block done
    (loop next
      (br-if done (i32.eqz (pair? changes)))
      (set! s (%scopes-change s (fixnum-value (car (car changes))) (fixnum-value (cdr (car changes)))))
      (set! changes (cdr changes))
      (br next)))
  s)

;; Changes, then change to scope sc. An add or a remove replaces an earlier
;; change to sc; a flip turns an add into a remove, a remove into an add,
;; and undoes a flip.
(func (%changes-add [changes eqref] [sc i32] [change i32]) -> eqref
  (if (i32.eqz (pair? changes)) (return (cons (cons (fixnum sc) (fixnum change)) %nil)))
  (if (i32.eq (fixnum-value (car (car changes))) sc)
      (let ([before (fixnum-value (cdr (car changes)))])
        (if (i32.ne change 2) (return (cons (cons (fixnum sc) (fixnum change)) (cdr changes))))
        (if (i32.eq before 2) (return (cdr changes)))
        (return (cons (cons (fixnum sc) (fixnum (i32.sub 1 before))) (cdr changes)))))
  (cons (car changes) (%changes-add (cdr changes) sc change)))

;; Changes, then later ones.
(func (%changes-compose [changes eqref] [later eqref]) -> eqref
  (if (null? changes) (return later))
  (block done
    (loop next
      (br-if done (i32.eqz (pair? later)))
      (set! changes (%changes-add changes (fixnum-value (car (car later))) (fixnum-value (cdr (car later)))))
      (set! later (cdr later))
      (br next)))
  changes)

;; Syntax object s with changes made to it and, pending, to its datum.
(func (%syntax-change-all [s eqref] [changes eqref]) -> eqref
  (let* ([x (%as-syntax s)] [e (struct.get %syntax e x)])
    (struct.new %syntax e (%scopes-apply (struct.get %syntax scopes x) changes)
                (struct.get %syntax srcloc x) (struct.get %syntax props x)
                (if (i32.or (pair? e) (syntax? e))
                    (%changes-compose (struct.get %syntax pending x) changes)
                    %nil))))

;; Datum d with changes made to the syntax objects in it, outside any
;; syntax object. A list's elements are pushed in order, and its spine
;; rebuilt from the last, by loops, so a list of any length can be.
(func (%push [d eqref] [changes eqref]) -> eqref
  (if (syntax? d) (return (%syntax-change-all d changes)))
  (let ([pushed %nil])
    (block done
      (loop next
        (br-if done (i32.eqz (pair? d)))
        (set! pushed (cons (%push (car d) changes) pushed))
        (set! d (cdr d))
        (br next)))
    (set! d (if (syntax? d) (%syntax-change-all d changes) d))
    (block rebuilt
      (loop next
        (br-if rebuilt (i32.eqz (pair? pushed)))
        (set! d (cons (car pushed) d))
        (set! pushed (cdr pushed))
        (br next)))
    d))


;; A copy of s holding datum e: same scopes, srcloc and props. Used by
;; quasisyntax to rebuild a template around new parts.
(func (syntax-rewrap [s eqref] [e eqref]) -> eqref
  (let ([x (%as-syntax s)])
    (struct.new %syntax e (struct.get %syntax scopes x) (struct.get %syntax srcloc x)
                (struct.get %syntax props x) %nil)))

;; Properties: a syntax object's props are a list of (key . value) pairs.
;; Keys are compared with ref.eq, so symbols make good keys.

;; The value of property key on s, or #f.
(func (syntax-property [s eqref] [key eqref]) -> eqref
  (let ([ps (struct.get %syntax props (%as-syntax s))])
    (block done
      (loop next
        (br-if done (i32.eqz (pair? ps)))
        (if (ref.eq (car (car ps)) key) (return (cdr (car ps))))
        (set! ps (cdr ps))
        (br next)))
    (ref.null eq)))

;; A copy of s with property key set to value.
(func (syntax-property-set [s eqref] [key eqref] [value eqref]) -> eqref
  (let ([x (%as-syntax s)])
    (struct.new %syntax (struct.get %syntax e x) (struct.get %syntax scopes x) (struct.get %syntax srcloc x)
                (cons (cons key value) (%props-without (struct.get %syntax props x) key))
                (struct.get %syntax pending x))))

(func (%props-without [ps eqref] [key eqref]) -> eqref
  (if (i32.eqz (pair? ps)) (return ps))
  (if (ref.eq (car (car ps)) key) (return (%props-without (cdr ps) key)))
  (cons (car ps) (%props-without (cdr ps) key)))

;; The local variable identifier id binds or refers to, in fully expanded
;; code, as a fixnum unique to that variable in the compilation; #f if id
;; is not a local variable there. The expander records it on id, in a
;; property whose key only this module names.
(global %local-binding-key (mut eqref) (ref.null eq))

(func (local-binding [id eqref]) -> eqref
  (if (i32.eqz (identifier? id)) (return (ref.null eq)))
  (if (ref.is_null %local-binding-key)
      (set! %local-binding-key (%memory-symbol (data-address %name-local-binding) (data-size %name-local-binding))))
  (syntax-property id %local-binding-key))

;; The symbol named by the len bytes of memory at addr.
(func (%memory-symbol [addr i32] [len i32]) -> eqref
  (let ([s (array.new_default %string len)] [i 0])
    (block done
      (loop next
        (br-if done (i32.ge_u i len))
        (array.set %string s i (i32.load8_u (i32.add addr i)))
        (set! i (i32.add i 1))
        (br next)))
    (string->symbol s)))

;; The elements of a syntax list, or x itself if it is already a list.
(func (splice-list [x eqref]) -> eqref (if (syntax? x) (syntax-e x) x))

;; The elements of a proper syntax list, or #f.
(func (syntax->list [x eqref]) -> eqref
  (let ([e (splice-list x)]) (if (list? e) e (ref.null eq))))

(func (syntax->datum [x eqref]) -> eqref
  (if (syntax? x) (return (syntax->datum (%syntax-datum x))))
  (if (pair? x) (return (cons (syntax->datum (car x)) (syntax->datum (cdr x)))))
  x)

;; Wrap datum d, giving every new syntax object the scopes of ctx and the
;; source location of loc, each a syntax object or #f for none. Syntax
;; objects already in d are kept as they are.
(func (datum->syntax [ctx eqref] [d eqref] [loc eqref]) -> eqref
  (%wrap d
         (if (syntax? ctx) (struct.get %syntax scopes (%as-syntax ctx)) %nil)
         (if (syntax? loc) (struct.get %syntax srcloc (%as-syntax loc)) (ref.null eq))))

(func (%wrap [d eqref] [scopes eqref] [loc eqref]) -> eqref
  (if (syntax? d) (return d))
  (if (pair? d) (return (struct.new %syntax (%wrap-list d scopes loc) scopes loc %nil %nil)))
  (struct.new %syntax d scopes loc %nil %nil))

(func (%wrap-list [d eqref] [scopes eqref] [loc eqref]) -> eqref
  (if (pair? d) (return (cons (%wrap (car d) scopes loc) (%wrap-list (cdr d) scopes loc))))
  (if (null? d) (return %nil))
  (%wrap d scopes loc))

;; ---- quoted data --------------------------------------------------------------------
;;
;; A compiled module's quoted data, other than the constants, is one passive
;; data segment, which the module turns into a table of objects when it
;; starts (spec 3.5): code refers to a quoted datum by its index there. The
;; bytes are the number of objects, then each object, after the objects it
;; is made of: its kind, numbered as below, and its fields.
;; A field that is an object is the index of that object. Numbers are LEB128.
;;
;;   0 #f    1 fixnum: signed    2 #t    3 ()    4 char: code
;;   5 pair: car cdr    6 symbol: length, UTF-8 bytes    7 string: likewise
;;   8 syntax: e scopes srcloc props    9 srcloc: source, then signed line col pos span
;;   10 integer: sign byte, magnitude as 8 bytes, little-endian
;;   11 flonum: its 8 bytes, little-endian
;;   13 keyword: length, UTF-8 bytes
;;
;; Syntax objects are made with %make-syntax, which maps their scopes.

(global %in (mut (ref null %string)) (ref.null %string))
(global %at (mut i32) 0)

(func (%in-byte) -> i32
  (let ([b (array.get_u %string %in %at)])
    (set! %at (i32.add %at 1))
    b))

(func (%in-uleb) -> i32
  (let ([n 0] [shift 0] [b 0])
    (loop next
      (set! b (%in-byte))
      (set! n (i32.or n (i32.shl (i32.and b 127) shift)))
      (set! shift (i32.add shift 7))
      (br-if next (i32.and b 128)))
    n))

(func (%in-sleb) -> i32
  (let ([n 0] [shift 0] [b 0])
    (loop next
      (set! b (%in-byte))
      (set! n (i32.or n (i32.shl (i32.and b 127) shift)))
      (set! shift (i32.add shift 7))
      (br-if next (i32.and b 128)))
    (if (i32.lt_u shift 32)
        (if (i32.and b 64) (return (i32.or n (i32.shl -1 shift)))))
    n))

(func (%in-u64) -> i64
  (let ([n i64 0] [i 0])
    (loop next
      (set! n (i64.or n (i64.shl (i64.extend_i32_u (%in-byte)) (i64.extend_i32_u (i32.mul i 8)))))
      (set! i (i32.add i 1))
      (br-if next (i32.lt_u i 8)))
    n))

(func (%in-string) -> (ref %string)
  (let* ([n (%in-uleb)] [s (array.new_default %string n)])
    (array.copy %string %string s 0 %in %at n)
    (set! %at (i32.add %at n))
    s))

(func (%in-bytes) -> (ref bytes)
  (let* ([n (%in-uleb)] [s (array.new_default bytes n)])
    (array.copy bytes %string s 0 %in %at n)
    (set! %at (i32.add %at n))
    s))

(func (%in-object [objs (ref %table)]) -> eqref
  (array.get %table objs (%in-uleb)))

(func (%in-entry [objs (ref %table)]) -> eqref
  (let ([kind (%in-byte)])
    (if (i32.eq kind 0) (return (ref.null eq)))
    (if (i32.eq kind 1) (return (fixnum (%in-sleb))))
    (if (i32.eq kind 2) (return %true))
    (if (i32.eq kind 3) (return %nil))
    (if (i32.eq kind 4) (return (integer->char (%in-uleb))))
    (if (i32.eq kind 5) (return (cons (%in-object objs) (%in-object objs))))
    (if (i32.eq kind 6) (return (string->symbol (%in-string))))
    (if (i32.eq kind 7) (return (%in-string)))
    (if (i32.eq kind 8)
        (return (%make-syntax (%in-object objs) (%in-object objs) (%in-object objs) (%in-object objs))))
    (if (i32.eq kind 9)
        (return (struct.new %srcloc (%in-object objs) (%in-sleb) (%in-sleb) (%in-sleb) (%in-sleb))))
    (if (i32.eq kind 10) (return (%make-integer (%in-byte) (%in-u64))))
    (if (i32.eq kind 11) (return (flonum (f64.reinterpret_i64 (%in-u64)))))
    (if (i32.eq kind 13) (return (string->keyword (%in-string))))
    (if (i32.eq kind 14) (return (%in-bytes)))
    (unreachable)))

;; The last object the bytes in builder b describe: quoted data read from
;; a file, such as a module's interface (spec 3.7).
(func (%builder-data [b eqref]) -> eqref
  (let ([objs (%deserialize (struct.get %builder bytes (%as-builder b)))])
    (array.get %table objs (i32.sub (array.len objs) 1))))

;; The objects that bytes describe, in order.
(func (%deserialize [bytes (ref %string)]) -> (ref %table)
  (set! %in bytes)
  (set! %at 0)
  (let* ([n (%in-uleb)] [objs (array.new %table (ref.null eq) n)] [i 0])
    (block done
      (loop next
        (br-if done (i32.ge_u i n))
        (array.set %table objs i (%in-entry objs))
        (set! i (i32.add i 1))
        (br next)))
    (set! %in (ref.null %string))
    objs))

;; ---- transformers -----------------------------------------------------------------

;; A transformer (spec 2.1): the expander calls code with env and the syntax
;; of a macro use.
(func (make-transformer [code (ref %transformer-code)] [env eqref]) -> eqref
  (struct.new %transformer code env))

(func (transformer? [v eqref]) -> i32 (ref.test (ref %transformer) v))

;; The environment transformer t was made with: what a language keeps
;; with a binding, such as a struct's fields.
(func (transformer-env [t eqref]) -> eqref
  (if (i32.eqz (ref.test (ref %transformer) t)) (%fail (data-address %msg-transformer) (data-size %msg-transformer)))
  (struct.get %transformer env (ref.cast (ref %transformer) t)))

;; ---- exceptions -------------------------------------------------------------------
;;
;; The tag every language throws values with (spec 2.3). A store has one
;; instance of this module, so the compiler and all compile-time code
;; catch one another's exceptions with it.
(tag exn (eqref))

;; A syntax error: its message, the syntax it blames or #f, and where the
;; compiler reports it, a source location, or #f for the syntax's own.
(func (%make-syntax-error [message eqref] [stx eqref] [srcloc eqref]) -> eqref
  (struct.new %syntax-error message stx srcloc))

(func (syntax-error? [v eqref]) -> i32 (ref.test (ref %syntax-error) v))

(func (%as-syntax-error [v eqref]) -> (ref %syntax-error)
  (if (i32.eqz (syntax-error? v)) (%fail (data-address %msg-syntax-error) (data-size %msg-syntax-error)))
  (ref.cast (ref %syntax-error) v))

(func (syntax-error-message [e eqref]) -> eqref (struct.get %syntax-error message (%as-syntax-error e)))
(func (syntax-error-syntax [e eqref]) -> eqref (struct.get %syntax-error syntax (%as-syntax-error e)))
(func (%syntax-error-srcloc [e eqref]) -> eqref (struct.get %syntax-error srcloc (%as-syntax-error e)))

;; ---- expander queries -------------------------------------------------------------
;;
;; The compiler's expander answers the queries, through function references
;; it registers with %set-queries. Until it does, as in a run-time store,
;; a query traps.

(type %query1 (func (eqref -> eqref)))
(type %query2 (func (eqref eqref -> eqref)))

(func (%no-expander) (%fail (data-address %msg-no-expander) (data-size %msg-no-expander)))
(func (%no-expander1 [a eqref]) -> eqref (type %query1) (%no-expander) (unreachable))
(func (%no-expander2 [a eqref] [b eqref]) -> eqref (type %query2) (%no-expander) (unreachable))

(global %q-local-value (mut (ref %query1)) (ref.func %no-expander1))
(global %q-free-identifier=? (mut (ref %query2)) (ref.func %no-expander2))
(global %q-binding-kind (mut (ref %query1)) (ref.func %no-expander1))
(global %q-local-expand (mut (ref %query1)) (ref.func %no-expander1))
(global %q-lift (mut (ref %query1)) (ref.func %no-expander1))
(global %q-signature (mut (ref %query1)) (ref.func %no-expander1))
(global %q-introduce (mut (ref %query1)) (ref.func %no-expander1))
(global %q-local-facts (mut (ref %query1)) (ref.func %no-expander1))
(global %q-identifier-name (mut (ref %query1)) (ref.func %no-expander1))
(global %q-name-identifier (mut (ref %query1)) (ref.func %no-expander1))

;; free-identifier=? returns #t or #f.
(func (%set-queries [local-value (ref %query1)] [free-identifier=? (ref %query2)] [binding-kind (ref %query1)]
                    [local-expand (ref %query1)] [lift (ref %query1)] [signature (ref %query1)]
                    [introduce (ref %query1)] [local-facts (ref %query1)] [identifier-name (ref %query1)]
                    [name-identifier (ref %query1)])
  (set! %q-local-value local-value)
  (set! %q-free-identifier=? free-identifier=?)
  (set! %q-binding-kind binding-kind)
  (set! %q-local-expand local-expand)
  (set! %q-lift lift)
  (set! %q-signature signature)
  (set! %q-introduce introduce)
  (set! %q-local-facts local-facts)
  (set! %q-identifier-name identifier-name)
  (set! %q-name-identifier name-identifier))

;; The compile-time value define-syntax bound id to, or #f.
(func (syntax-local-value [id eqref]) -> eqref (call-ref %query1 %q-local-value id))

;; Throw a syntax error (above) with message, a string, blamed on stx. The
;; message is prefixed with "name: ", or if name is #f with the name stx
;; gives: an identifier's own, or that of the identifier heading a list.
(func (raise-syntax-error [name eqref] [message eqref] [stx eqref])
  (let* ([who (if (symbol? name) name (%form-name stx))]
         [text (if (ref.is_null who) message (%prefixed (symbol->string who) message))])
    (throw exn (%make-syntax-error text stx (ref.null eq)))))

(func (%form-name [stx eqref]) -> eqref
  (if (identifier? stx) (return (syntax-e stx)))
  (if (syntax? stx)
      (let ([e (syntax-e stx)])
        (if (pair? e)
            (if (identifier? (car e)) (return (syntax-e (car e)))))))
  (ref.null eq))

;; "who: message"
(func (%prefixed [who eqref] [message eqref]) -> eqref
  (let ([b (make-string-builder)])
    (string-builder-add! b who 0 (string-length who))
    (string-builder-add-byte! b 58)
    (string-builder-add-byte! b 32)
    (string-builder-add! b message 0 (string-length message))
    (string-builder->string b)))

(func (free-identifier=? [a eqref] [b eqref]) -> i32
  (i32.eqz (ref.is_null (call-ref %query2 %q-free-identifier=? a b))))

;; What identifier id is bound to as a value, as a symbol: function,
;; variable, macro, compile-time-value, data, label or core; #f if it is
;; unbound.
(func (identifier-binding-kind [id eqref]) -> eqref (call-ref %query1 %q-binding-kind id))

;; The signature of the function id is bound to, (t ... -> r ...), each
;; type written as in the kernel: a numeric type's name, or (ref T) or
;; (ref null T) with T a heap type's name; #f if id is not a function.
(func (identifier-function-signature [id eqref]) -> eqref (call-ref %query1 %q-signature id))

;; Expression stx, expanded (spec 6.4): its macros expanded and its
;; applications and literals explicit.
(func (local-expand [stx eqref]) -> eqref (call-ref %query1 %q-local-expand stx))

;; Add definition form (func, global, import, type or data) to the module
;; being expanded, before the form the running macro is expanding. It is
;; declared as the macro's output is, with the macro's introduction scope.
;; Returns the form as given, so its names can go in the macro's output.
(func (syntax-local-lift-definition [form eqref]) -> eqref (call-ref %query1 %q-lift form))

;; stx with the running macro's introduction scope flipped: syntax as the
;; module sees it, from syntax as the macro sees it, and back. A macro
;; keeping syntax from one of its uses for another, such as the names of a
;; definition it lifted, keeps the module's view, and flips it again to put
;; it in its output.
(func (syntax-local-introduce [stx eqref]) -> eqref (call-ref %query1 %q-introduce stx))

;; The facts about the definition id refers to (spec 6.5), each (module
;; phase stx): from the module being expanded and the modules it requires,
;; dependencies first.
(func (syntax-local-facts [id eqref]) -> eqref (call-ref %query1 %q-local-facts id))

;; The name of the definition id refers to (spec 6.6): a symbol, the same
;; whatever name, module or phase shift it is seen under; or #f.
(func (identifier-name [id eqref]) -> eqref (call-ref %query1 %q-identifier-name id))

;; An identifier that refers to the definition name names (spec 6.6), if it
;; is the module being expanded's or a module's it requires.
(func (name-identifier [name eqref]) -> eqref (call-ref %query1 %q-name-identifier name))

;; ---- for the compiler ---------------------------------------------------------------
;;
;; The compiler reads syntax objects and source locations, and calls
;; transformers, through these (spec appendix A). Macros use the contract
;; functions above.

(func (%syntax-scopes [s eqref]) -> eqref (struct.get %syntax scopes (%as-syntax s)))

;; Syntax object s with scope sc added (change 0), removed (1) or flipped
;; (2), in it and in every syntax object inside it.
(func (%syntax-change [s eqref] [sc eqref] [change eqref]) -> eqref
  (%syntax-change-all s (cons (cons sc change) %nil)))

;; Scope set s with the same change made to scope sc.
(func (%scope-set-change [s eqref] [sc eqref] [change eqref]) -> eqref
  (%scopes-change s (fixnum-value sc) (fixnum-value change)))

;; #t if every scope of set a is in set b.
(func (%scope-subset? [a eqref] [b eqref]) -> eqref
  (let ([x 0] [y 0])
    (block done
      (loop next
        (br-if done (i32.eqz (pair? a)))
        (if (i32.eqz (pair? b)) (return (ref.null eq)))
        (set! x (fixnum-value (car a)))
        (set! y (fixnum-value (car b)))
        (if (i32.gt_s x y) (return (ref.null eq)))
        ;; Both sets are newest first: a scope of b greater than a's next
        ;; is not in a.
        (if (i32.eq x y) (set! a (cdr a)))
        (set! b (cdr b))
        (br next)))
    %true))
(func (%syntax-srcloc [s eqref]) -> eqref (struct.get %syntax srcloc (%as-syntax s)))
(func (%syntax-props [s eqref]) -> eqref (struct.get %syntax props (%as-syntax s)))

(func (%srcloc? [v eqref]) -> eqref (if (ref.test (ref %srcloc) v) %true (ref.null eq)))
(func (%srcloc-source [l eqref]) -> eqref (struct.get %srcloc source (ref.cast (ref %srcloc) l)))
(func (%srcloc-line [l eqref]) -> eqref (fixnum (struct.get %srcloc line (ref.cast (ref %srcloc) l))))
(func (%srcloc-col [l eqref]) -> eqref (fixnum (struct.get %srcloc col (ref.cast (ref %srcloc) l))))
(func (%srcloc-pos [l eqref]) -> eqref (fixnum (struct.get %srcloc pos (ref.cast (ref %srcloc) l))))
(func (%srcloc-span [l eqref]) -> eqref (fixnum (struct.get %srcloc span (ref.cast (ref %srcloc) l))))

;; Where s is, as Racket gives it: its file, as errors name it, its line
;; from 1 and its column from 0; #f if it has no location.
(func (syntax-source [s eqref]) -> eqref
  (let ([l (%syntax-srcloc s)]) (if (ref.is_null l) l (%srcloc-source l))))
(func (syntax-line [s eqref]) -> eqref
  (let ([l (%syntax-srcloc s)]) (if (ref.is_null l) l (%srcloc-line l))))
(func (syntax-column [s eqref]) -> eqref
  (let ([l (%syntax-srcloc s)]) (if (ref.is_null l) l (%srcloc-col l))))

;; Call transformer t on syntax stx.
(func (%call-transformer [t eqref] [stx eqref]) -> eqref
  (let ([x (ref.cast (ref %transformer) t)])
    (call-ref %transformer-code (struct.get %transformer code x) (struct.get %transformer env x) stx)))
