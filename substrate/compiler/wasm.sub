;; Lifecycle: permanent. Part of the compiler.
;;
;; Binary wasm encoder and assembler. The compiler assembles each body an
;; instruction at a time (instr!), links it once the module's indices are
;; known (link-body), and builds a module description, which this turns
;; into bytes; nothing here knows about the kernel language.
;;
;; Instructions are lists (op imm ...), flat: a block, loop, if or
;; try_table is opened by its instruction and closed by (end), with
;; (else) between an if's arms; a block type is () | valtype | (type n).
;;
;; Value types are resolved: i32 i64 f32 f64, or (ref nullable? heap) where
;; heap is an abstract heap type symbol or a type index.
(require-unqualified substrate "../lib/substrate.sub")
(require ops "ops.sub" lookup-prim prim-op-code prim-op-kind)
(require leb "leb128.sub" write-uleb write-sleb)
(require num "numbers.sub" flonum-bits flonum32-bits)

(provide wmodule encode-module new-asm asm-size instr! link-body cell cell? cell-value set-cell-value!)

;; types:   list of (func (param ...) (result ...)) | (struct ((storage mut?) ...))
;;          | (array (storage mut?)) | (sub final? (supertypeidx ...) comptype)
;;          | (rec entry ...), a recursion group of sub or comptype entries;
;;          storage is a valtype, i8 or i16
;; imports: list of (module field kind desc); kind func or tag: typeidx,
;;          memory/table: (min max-or-#f), global: (valtype mutable?)
;; funcs:   list of (typeidx locals body name), body linked (link-body)
;; tables, memories: list of (min max-or-#f)
;; tags:    list of typeidx, each a function type with no results
;; globals: list of (valtype mutable? init-bytes), the bytes linked
;; exports: list of (name kind idx)
;; start:   funcidx or #f
;; declared: funcidxs referenced by ref.func (declarative elem segment)
;; datas:   list of (offset . bytes): an active segment in memory 0, or a
;;          passive one if offset is #f
;; names:   (module-name (funcidx . name) ...) for the name section, or #f
(struct wmodule (types imports funcs tables memories tags globals exports start declared datas names))

;; ---- byte output ----

(define (name! p s)
  (let ([bs (string->bytes/utf-8 s)])
    (write-uleb (bytes-length bs) p)
    (write-bytes bs p)))

(define (vec! p items item!)
  (write-uleb (length items) p)
  (for-each (lambda (x) (item! p x)) items))

(define (section! p id body-proc)
  (let ([body (call-with-output-bytes body-proc)])
    (write-byte id p)
    (write-uleb (bytes-length body) p)
    (write-bytes body p)))

;; The low n bytes of integer x, little-endian.
(define (le-bytes! p x n)
  (for-each (lambda (i) (write-byte (bitwise-and (arithmetic-shift x (* -8 i)) 255) p)) (range n)))

;; ---- types ----

(define (heap! p h)
  (if (integer? h)
      (write-sleb h p)
      (write-byte (case h
                    [(func) #x70] [(extern) #x6F] [(any) #x6E] [(eq) #x6D] [(i31) #x6C]
                    [(struct) #x6B] [(array) #x6A] [(none) #x71] [(noextern) #x72] [(nofunc) #x73]
                    [(exn) #x69] [(noexn) #x74]
                    [else (error 'encode "unknown heap type ~s" h)])
                  p)))

(define (valtype! p t)
  (cond [(pair? t)
         (write-byte (if (cadr t) #x63 #x64) p)
         (heap! p (caddr t))]
        [else
         (write-byte (case t
                       [(i32) #x7F] [(i64) #x7E] [(f32) #x7D] [(f64) #x7C] [(v128) #x7B]
                       [(funcref) #x70] [(externref) #x6F]
                       [else (error 'encode "unknown value type ~s" t)])
                     p)]))

(define (storage! p s)
  (case s
    [(i8) (write-byte #x78 p)]
    [(i16) (write-byte #x77 p)]
    [else (valtype! p s)]))

(define (field! p f)
  (storage! p (car f))
  (write-byte (if (cadr f) 1 0) p))

(define (limits! p lim)
  (let ([min (car lim)] [max (cadr lim)])
    (if max
        (begin (write-byte 1 p) (write-uleb min p) (write-uleb max p))
        (begin (write-byte 0 p) (write-uleb min p)))))

(define (blocktype! p bt)
  (cond [(null? bt) (write-byte #x40 p)]
        [(and (pair? bt) (eq? (car bt) 'type)) (write-sleb (cadr bt) p)]
        [else (valtype! p bt)]))

;; ---- assembly ----
;;
;; Code is assembled as it is compiled, an instruction at a time (instr!),
;; into an asm: its bytes, and the fields they cannot hold yet. A field
;; the compiler resolves only once every function, global, type and tag
;; has its index, or decides after the code that follows it, is deferred:
;; the asm holds no bytes for it, but records (offset kind key), and
;; link-body writes it as (resolve kind key) says. The kinds are func,
;; ref-func, global, type and tag, an index; heap, valtype and blocktype,
;; written as those; and const, a whole constant instruction. A source
;; location is recorded the same way, at the offset of the instruction
;; it is of.
(struct asm (port [relocs #:mutable] [locations #:mutable] [pending #:mutable] [current #:mutable] [start #:mutable]
             [else-pending? #:mutable]))   ; an else to write before the next instruction, if any comes

(define (new-asm) (asm (open-output-bytes) '() '() location-none location-none #f #f))
(define (asm-size a) (file-position (asm-port a)))

;; A value the compiler settles later, which a deferred field holds: a
;; block's type once its body is compiled, or a constant once the
;; branches around it are.
(struct cell ([value #:mutable]))

(define (reloc! a kind key)
  (set-asm-relocs! a (cons (list (asm-size a) kind key) (asm-relocs a))))

;; ---- source locations ----
;;
;; Code carries the pseudo-instruction (location file line col), file #f
;; for none, which says where the instructions after it come from. The
;; asm records a location where an instruction that can call or trap
;; starts at a new one, and the first location a body gives, at its start,
;; is the function's own: those are where a backtrace's frames are, one
;; that overflowed the stack at the body's start. The module's
;; source-locations section lists them (spec 3.6).
(define location-none (list #f 0 0))
(define code-locations '())               ; (offset file line col), in the code section, reversed

;; The instructions that can call or trap, but for memory's loads and
;; stores.
(define calls-or-traps
  (make-hasheq
   (map (lambda (op) (cons op #t))
        '(unreachable call call_indirect return_call return_call_indirect call_ref return_call_ref
          ref.cast ref.as_non_null struct.get struct.get_s struct.get_u struct.set
          array.new array.new_default array.new_data array.get array.get_s array.get_u array.set
          array.len array.fill array.copy i31.get_s i31.get_u
          i32.div_s i32.div_u i32.rem_s i32.rem_u i64.div_s i64.div_u i64.rem_s i64.rem_u
          i32.trunc_f32_s i32.trunc_f32_u i32.trunc_f64_s i32.trunc_f64_u
          i64.trunc_f32_s i64.trunc_f32_u i64.trunc_f64_s i64.trunc_f64_u
          memory.copy memory.fill))))

(define (records-location? op)
  (or (hash-ref calls-or-traps op #f)
      (let ([p (lookup-prim op)]) (and p (eq? (prim-op-kind p) 'mem)))))

(define (note-location! a op)
  (unless (eq? (asm-pending a) (asm-current a))
    (when (and (records-location? op) (not (equal? (asm-pending a) (asm-current a))))
      (set-asm-locations! a (cons (cons (asm-size a) (asm-pending a)) (asm-locations a)))
      (set-asm-current! a (asm-pending a)))))

;; The bytes of n as unsigned LEB128.
(define (uleb-length n) (if (< n 128) 1 (+ 1 (uleb-length (arithmetic-shift n -7)))))

(define (source-locations! p entries)
  (let ([files (let loop ([es entries] [acc '()])
                 (cond [(null? es) (reverse acc)]
                       [(or (not (cadr (car es))) (member (cadr (car es)) acc)) (loop (cdr es) acc)]
                       [else (loop (cdr es) (cons (cadr (car es)) acc))]))])
    (name! p "source-locations")
    (vec! p files name!)
    (write-uleb (length entries) p)
    (let loop ([es entries] [at 0])
      (unless (null? es)
        (let ([e (car es)])
          (write-uleb (- (car e) at) p)
          (write-uleb (if (cadr e) (- (length files) (length (member (cadr e) files))) 0) p)
          (write-uleb (caddr e) p)
          (write-uleb (cadddr e) p)
          (loop (cdr es) (car e)))))))

;; ---- instructions ----

(define (gc! p n) (write-byte #xFB p) (write-uleb n p))

;; A constant instruction, (i32.const n), (i64.const n), (f32.const x) or
;; (f64.const x).
(define (const! p i)
  (case (car i)
    [(i32.const) (write-byte #x41 p) (write-sleb (cadr i) p)]
    [(i64.const) (write-byte #x42 p) (write-sleb (cadr i) p)]
    [(f32.const) (write-byte #x43 p) (le-bytes! p (flonum32-bits (cadr i)) 4)]
    [(f64.const) (write-byte #x44 p) (le-bytes! p (flonum-bits (cadr i)) 8)]
    [else (error 'encode "not a constant instruction ~s" i)]))

;; Instruction i, (op imm ...), assembled into a. An index is a key for
;; link-body: a function's, global's or tag's is the compiler's record of
;; it, a type's its record or the signature (func params results), a heap
;; type a record or its abstract name. A block's type and a deferred
;; constant are cells, settled later. An else is written once an
;; instruction follows it, so an empty else arm leaves nothing.
(define (instr! a i)
  (let ([op (car i)] [args (cdr i)] [p (asm-port a)])
    (unless (memq op '(location end))
      (when (asm-else-pending? a) (set-asm-else-pending?! a #f) (write-byte #x05 p))
      (note-location! a op))
    (case op
      [(location)
       (when (and (not (asm-start a)) (= (file-position p) 0))
         (set-asm-start! a args)
         (set-asm-current! a args))
       (set-asm-pending! a args)]
      [(const-deferred) (reloc! a 'const (car args))]
      [(unreachable) (write-byte #x00 p)]
      [(nop) (write-byte #x01 p)]
      [(block) (write-byte #x02 p) (reloc! a 'blocktype (car args))]
      [(loop) (write-byte #x03 p) (reloc! a 'blocktype (car args))]
      [(if) (write-byte #x04 p) (reloc! a 'blocktype (car args))]
      [(else) (set-asm-else-pending?! a #t)]
      [(end) (set-asm-else-pending?! a #f) (write-byte #x0B p)]
      [(throw) (write-byte #x08 p) (reloc! a 'tag (car args))]
      [(throw_ref) (write-byte #x0A p)]
      ;; (try_table bt catches), each catch (catch tag label), (catch_ref
      ;; tag label), (catch_all label) or (catch_all_ref label); the body
      ;; follows, then end.
      [(try_table)
       (write-byte #x1F p)
       (reloc! a 'blocktype (car args))
       (write-uleb (length (cadr args)) p)
       (for-each (lambda (c) (catch! a c)) (cadr args))]
      [(br) (write-byte #x0C p) (write-uleb (car args) p)]
      [(br_if) (write-byte #x0D p) (write-uleb (car args) p)]
      [(return) (write-byte #x0F p)]
      [(call) (write-byte #x10 p) (reloc! a 'func (car args))]
      [(call_indirect) (write-byte #x11 p) (reloc! a 'type (car args)) (write-uleb (cadr args) p)]
      [(return_call) (write-byte #x12 p) (reloc! a 'func (car args))]
      [(return_call_indirect) (write-byte #x13 p) (reloc! a 'type (car args)) (write-uleb (cadr args) p)]
      [(call_ref) (write-byte #x14 p) (reloc! a 'type (car args))]
      [(return_call_ref) (write-byte #x15 p) (reloc! a 'type (car args))]
      [(drop) (write-byte #x1A p)]
      [(select) (write-byte #x1B p)]
      [(select-typed) (write-byte #x1C p) (write-uleb 1 p) (reloc! a 'valtype (car args))]
      [(local.get) (write-byte #x20 p) (write-uleb (car args) p)]
      [(local.set) (write-byte #x21 p) (write-uleb (car args) p)]
      [(local.tee) (write-byte #x22 p) (write-uleb (car args) p)]
      [(global.get) (write-byte #x23 p) (reloc! a 'global (car args))]
      [(global.set) (write-byte #x24 p) (reloc! a 'global (car args))]
      [(i32.const i64.const f32.const f64.const) (const! p i)]
      [(ref.null) (write-byte #xD0 p) (reloc! a 'heap (car args))]
      [(ref.is_null) (write-byte #xD1 p)]
      [(ref.func) (write-byte #xD2 p) (reloc! a 'ref-func (car args))]
      [(ref.eq) (write-byte #xD3 p)]
      [(ref.as_non_null) (write-byte #xD4 p)]
      [(table.grow) (write-byte #xFC p) (write-uleb 15 p) (write-uleb (car args) p)]
      [(table.size) (write-byte #xFC p) (write-uleb 16 p) (write-uleb (car args) p)]
      ;; GC (0xFB prefix)
      [(struct.new) (gc! p 0) (reloc! a 'type (car args))]
      [(struct.get) (gc! p 2) (reloc! a 'type (car args)) (write-uleb (cadr args) p)]
      [(struct.get_s) (gc! p 3) (reloc! a 'type (car args)) (write-uleb (cadr args) p)]
      [(struct.get_u) (gc! p 4) (reloc! a 'type (car args)) (write-uleb (cadr args) p)]
      [(struct.set) (gc! p 5) (reloc! a 'type (car args)) (write-uleb (cadr args) p)]
      [(array.new) (gc! p 6) (reloc! a 'type (car args))]
      [(array.new_default) (gc! p 7) (reloc! a 'type (car args))]
      [(array.new_fixed) (gc! p 8) (reloc! a 'type (car args)) (write-uleb (cadr args) p)]
      [(array.new_data) (gc! p 9) (reloc! a 'type (car args)) (write-uleb (cadr args) p)]
      [(array.get) (gc! p 11) (reloc! a 'type (car args))]
      [(array.get_s) (gc! p 12) (reloc! a 'type (car args))]
      [(array.get_u) (gc! p 13) (reloc! a 'type (car args))]
      [(array.set) (gc! p 14) (reloc! a 'type (car args))]
      [(array.len) (gc! p 15)]
      [(array.fill) (gc! p 16) (reloc! a 'type (car args))]
      [(array.copy) (gc! p 17) (reloc! a 'type (car args)) (reloc! a 'type (cadr args))]
      ;; (ref.test nullable? heap) / (ref.cast nullable? heap)
      [(ref.test) (gc! p (if (car args) 21 20)) (reloc! a 'heap (cadr args))]
      [(ref.cast) (gc! p (if (car args) 23 22)) (reloc! a 'heap (cadr args))]
      [(ref.i31) (gc! p 28)]
      [(i31.get_s) (gc! p 29)]
      [(i31.get_u) (gc! p 30)]
      [else
       (let ([prim (lookup-prim op)])
         (unless prim (error 'encode "unknown instruction ~s" i))
         (for-each (lambda (b) (write-byte b p)) (prim-op-code prim))
         (when (eq? (prim-op-kind prim) 'mem)
           ;; args: (align offset)
           (write-uleb (car args) p)
           (write-uleb (cadr args) p)))])))

(define (catch! a c)
  (let ([p (asm-port a)])
    (case (car c)
      [(catch) (write-byte 0 p) (reloc! a 'tag (cadr c)) (write-uleb (caddr c) p)]
      [(catch_ref) (write-byte 1 p) (reloc! a 'tag (cadr c)) (write-uleb (caddr c) p)]
      [(catch_all) (write-byte 2 p) (write-uleb (cadr c) p)]
      [(catch_all_ref) (write-byte 3 p) (write-uleb (cadr c) p)])))

;; ---- linking ----

;; segments, each an asm, linked in sequence as the bytes of one body:
;; each deferred field written as (resolve kind key) gives it, an index,
;; a heap type, a value type, a block type or a constant instruction by
;; its kind. Returns (bytes start locations): the first segment's start
;; location, and the locations recorded, at their offsets in the bytes.
(define (link-body segments resolve)
  (let* ([locations '()]
         [bytes (call-with-output-bytes
                 (lambda (q)
                   (for-each (lambda (a)
                               ;; A later segment's first location is where its code starts.
                               (when (and (not (eq? a (car segments))) (asm-start a))
                                 (set! locations (cons (cons (file-position q) (asm-start a)) locations)))
                               (link-segment! q a resolve (lambda (l) (set! locations (cons l locations)))))
                             segments)))])
    (list bytes (or (asm-start (car segments)) location-none) (reverse locations))))

(define (link-segment! q a resolve note!)
  (let ([raw (get-output-bytes (asm-port a))] [n (asm-size a)])
    (let loop ([pos 0] [relocs (reverse (asm-relocs a))] [locs (reverse (asm-locations a))])
      (let* ([r (and (pair? relocs) (car (car relocs)))]
             [l (and (pair? locs) (car (car locs)))]
             [next (cond [(and r l) (min r l)] [r r] [l l] [else n])])
        (when (< pos next) (write-bytes (subbytes raw pos next) q))
        ;; A deferred field at the offset of an instruction's location
        ;; belongs to the instruction before it.
        (cond [(and r (= r next))
               (deferred! q (car relocs) resolve)
               (loop next (cdr relocs) locs)]
              [(and l (= l next))
               (note! (cons (file-position q) (cdr (car locs))))
               (loop next relocs (cdr locs))]
              [else #f])))))

(define (deferred! q reloc resolve)
  (let* ([kind (cadr reloc)] [v (resolve kind (caddr reloc))])
    (case kind
      [(func ref-func global type tag) (write-uleb v q)]
      [(heap) (heap! q v)]
      [(valtype) (valtype! q v)]
      [(blocktype) (blocktype! q v)]
      [(const) (const! q v)])))

;; ---- module ----

(define (type-entry! p t)
  (case (car t)
    [(func) (write-byte #x60 p) (vec! p (cadr t) valtype!) (vec! p (caddr t) valtype!)]
    [(struct) (write-byte #x5F p) (vec! p (cadr t) field!)]
    [(array) (write-byte #x5E p) (field! p (cadr t))]
    ;; A final type with no supertype is written as its comptype alone.
    [(sub) (let ([final? (cadr t)] [supers (caddr t)])
             (unless (and final? (null? supers))
               (write-byte (if final? #x4F #x50) p)
               (vec! p supers (lambda (p i) (write-uleb i p))))
             (type-entry! p (cadddr t)))]
    ;; A recursion group: one entry, but each member has its own type index.
    [(rec) (write-byte #x4E p) (vec! p (cdr t) type-entry!)]
    [else (error 'encode "unknown type ~s" t)]))

(define (import! p imp)
  (name! p (car imp))
  (name! p (cadr imp))
  (let ([desc (cadddr imp)])
    (case (caddr imp)
      [(func) (write-byte 0 p) (write-uleb desc p)]
      [(table) (write-byte 1 p) (write-byte #x70 p) (limits! p desc)]
      [(memory) (write-byte 2 p) (limits! p desc)]
      [(global) (write-byte 3 p) (valtype! p (car desc)) (write-byte (if (cadr desc) 1 0) p)]
      [(tag) (write-byte 4 p) (write-byte 0 p) (write-uleb desc p)])))

(define (global! p g)
  (valtype! p (car g))
  (write-byte (if (cadr g) 1 0) p)
  (write-bytes (caddr g) p)
  (write-byte #x0B p))

(define (export! p e)
  (name! p (car e))
  (write-byte (case (cadr e) [(func) 0] [(table) 1] [(memory) 2] [(global) 3] [(tag) 4]) p)
  (write-uleb (caddr e) p))

;; A function's entry: its locals, then its body, linked (bytes start
;; locations). The locations, the start's at offset 0, are kept for the
;; code section, at their offsets in the module.
(define (code! p f)
  (let* ([linked (caddr f)]
         [locations '()]
         [body (call-with-output-bytes
                (lambda (q)
                  (vec! q (group-locals (cadr f)) (lambda (q g) (write-uleb (cdr g) q) (valtype! q (car g))))
                  (let ([shift (file-position q)])
                    (set! locations (cons (cons 0 (cadr linked))
                                          (map (lambda (l) (cons (+ shift (car l)) (cdr l))) (caddr linked)))))
                  (write-bytes (car linked) q)
                  (write-byte #x0B q)))])
    (write-uleb (bytes-length body) p)
    (let ([base (file-position p)])
      (for-each (lambda (l) (set! code-locations (cons (cons (+ base (car l)) (cdr l)) code-locations)))
                locations))
    (write-bytes body p)))

(define (data! p d)
  (if (car d)
      (begin (write-byte 0 p)                ; active, memory 0
             (const! p (list 'i32.const (car d)))
             (write-byte #x0B p))
      (write-byte 1 p))                      ; passive
  (write-uleb (bytes-length (cdr d)) p)
  (write-bytes (cdr d) p))

(define (subsection! p id proc)
  (let ([sub (call-with-output-bytes proc)])
    (write-byte id p)
    (write-uleb (bytes-length sub) p)
    (write-bytes sub p)))

(define (encode-module m)
  (call-with-output-bytes
   (lambda (p)
     (write-bytes (bytes #x00 #x61 #x73 #x6D #x01 #x00 #x00 #x00) p)
     (let ([types (wmodule-types m)])
       (unless (null? types) (section! p 1 (lambda (p) (vec! p types type-entry!)))))
     (let ([imports (wmodule-imports m)])
       (unless (null? imports) (section! p 2 (lambda (p) (vec! p imports import!)))))
     (let ([funcs (wmodule-funcs m)])
       (unless (null? funcs) (section! p 3 (lambda (p) (vec! p funcs (lambda (p f) (write-uleb (car f) p)))))))
     (let ([tables (wmodule-tables m)])
       (unless (null? tables)
         (section! p 4 (lambda (p) (vec! p tables (lambda (p t) (write-byte #x70 p) (limits! p t)))))))
     (let ([mems (wmodule-memories m)])
       (unless (null? mems) (section! p 5 (lambda (p) (vec! p mems limits!)))))
     (let ([tags (wmodule-tags m)])
       (unless (null? tags)
         (section! p 13 (lambda (p) (vec! p tags (lambda (p t) (write-byte 0 p) (write-uleb t p)))))))
     (let ([globals (wmodule-globals m)])
       (unless (null? globals) (section! p 6 (lambda (p) (vec! p globals global!)))))
     (let ([exports (wmodule-exports m)])
       (unless (null? exports) (section! p 7 (lambda (p) (vec! p exports export!)))))
     (when (wmodule-start m)
       (section! p 8 (lambda (p) (write-uleb (wmodule-start m) p))))
     (let ([declared (wmodule-declared m)])
       (unless (null? declared)
         (section! p 9
           (lambda (p)
             (write-uleb 1 p)
             (write-byte 3 p)          ; declarative, elemkind + funcidx vector
             (write-byte #x00 p)
             (vec! p declared (lambda (p i) (write-uleb i p)))))))
     ;; The data count, which code referring to segments needs.
     (let ([datas (wmodule-datas m)])
       (unless (null? datas) (section! p 12 (lambda (p) (write-uleb (length datas) p)))))
     ;; The code section, written here to know where each body is: the
     ;; source locations give offsets in the module.
     (set! code-locations '())
     (let* ([funcs (wmodule-funcs m)]
            [code (call-with-output-bytes (lambda (q) (vec! q funcs code!)))]
            [start (+ (file-position p) 1 (uleb-length (bytes-length code)))])
       (unless (null? funcs)
         (write-byte 10 p)
         (write-uleb (bytes-length code) p)
         (write-bytes code p))
       (set! code-locations (map (lambda (l) (cons (+ start (car l)) (cdr l))) (reverse code-locations))))
     (let ([datas (wmodule-datas m)])
       (unless (null? datas) (section! p 11 (lambda (p) (vec! p datas data!)))))
     (let ([names (wmodule-names m)])
       (when names
         (section! p 0
           (lambda (p)
             (name! p "name")
             (subsection! p 0 (lambda (q) (name! q (car names))))
             (subsection! p 1 (lambda (q) (vec! q (cdr names) (lambda (q n) (write-uleb (car n) q) (name! q (cdr n))))))))))
     (unless (null? code-locations)
       (section! p 0 (lambda (p) (source-locations! p code-locations)))))))

;; Run-length group consecutive equal local types: ((type . count) ...)
(define (group-locals types)
  (let loop ([ts types] [acc '()])
    (cond [(null? ts) (reverse acc)]
          [(and (pair? acc) (equal? (caar acc) (car ts)))
           (loop (cdr ts) (cons (cons (caar acc) (+ 1 (cdar acc))) (cdr acc)))]
          [else (loop (cdr ts) (cons (cons (car ts) 1) acc))])))
