;; Wasm's own forms: its instructions, its blocks and branches, its memories, tables and tags, and its
;; try and throw on tags; and func and global, a wasm function and a wasm global with Substrate code
;; for the body and the value. A module writes them as wasm:name after (require wasm "wasm.sub"),
;; from where it is, and they see only wasm types.
(provide (all-wasm-forms) func global)

(define-syntax func (quote-syntax (#%form func)))
(define-syntax global (quote-syntax (#%form global)))
