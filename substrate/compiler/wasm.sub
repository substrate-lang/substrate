;; Lifecycle: permanent. Part of the compiler, ported from stage0/wasm.sls.
;;
;; Binary wasm encoder. The compiler builds a module description and this
;; turns it into bytes; nothing here knows about the kernel language.
;;
;; Instructions are lists (op imm ...). Structured ones nest:
;;   (block bt instrs) (loop bt instrs) (if bt then-instrs else-instrs)
;; where bt is () | valtype | (type n).
;;
;; Value types are resolved: i32 i64 f32 f64, or (ref nullable? heap) where
;; heap is an abstract heap type symbol or a type index.
(require-unqualified substrate "../lib/substrate.sub")
(require ops "ops.sub" lookup-prim prim-op-code prim-op-kind)
(require buf "buffer.sub" put-byte! put-bytes! uleb! sleb! with-output)
(require num "numbers.sub" flonum-bits flonum32-bits)

(provide wmodule encode-module)

;; types:   list of (func (param ...) (result ...)) | (struct ((storage mut?) ...))
;;          | (array (storage mut?)) | (sub final? (supertypeidx ...) comptype)
;;          | (rec entry ...), a recursion group of sub or comptype entries;
;;          storage is a valtype, i8 or i16
;; imports: list of (module field kind desc); kind func: typeidx,
;;          memory/table: (min max-or-#f), global: (valtype mutable?)
;; funcs:   list of (typeidx locals instrs name)
;; tables, memories: list of (min max-or-#f)
;; globals: list of (valtype mutable? init-instrs)
;; exports: list of (name kind idx)
;; start:   funcidx or #f
;; declared: funcidxs referenced by ref.func (declarative elem segment)
;; datas:   list of (offset . bytes): an active segment in memory 0, or a
;;          passive one if offset is #f
;; names:   (module-name (funcidx . name) ...) for the name section, or #f
(struct wmodule (types imports funcs tables memories globals exports start declared datas names))

;; ---- byte output ----

(define (name! p s)
  (let ([bs (string->bytes/utf-8 s)])
    (uleb! p (bytes-length bs))
    (put-bytes! p bs)))

(define (vec! p items item!)
  (uleb! p (length items))
  (for-each (lambda (x) (item! p x)) items))

(define (section! p id body-proc)
  (let ([body (with-output body-proc)])
    (put-byte! p id)
    (uleb! p (bytes-length body))
    (put-bytes! p body)))

;; The low n bytes of integer x, little-endian.
(define (le-bytes! p x n)
  (for-each (lambda (i) (put-byte! p (bitwise-and (arithmetic-shift x (* -8 i)) 255))) (range n)))

;; ---- types ----

(define (heap! p h)
  (if (integer? h)
      (sleb! p h)
      (put-byte! p
                 (case h
                   [(func) #x70] [(extern) #x6F] [(any) #x6E] [(eq) #x6D] [(i31) #x6C]
                   [(struct) #x6B] [(array) #x6A] [(none) #x71] [(noextern) #x72] [(nofunc) #x73]
                   [else (error 'encode "unknown heap type ~s" h)]))))

(define (valtype! p t)
  (cond [(pair? t)
         (put-byte! p (if (cadr t) #x63 #x64))
         (heap! p (caddr t))]
        [else
         (put-byte! p
                    (case t
                      [(i32) #x7F] [(i64) #x7E] [(f32) #x7D] [(f64) #x7C] [(v128) #x7B]
                      [(funcref) #x70] [(externref) #x6F]
                      [else (error 'encode "unknown value type ~s" t)]))]))

(define (storage! p s)
  (case s
    [(i8) (put-byte! p #x78)]
    [(i16) (put-byte! p #x77)]
    [else (valtype! p s)]))

(define (field! p f)
  (storage! p (car f))
  (put-byte! p (if (cadr f) 1 0)))

(define (limits! p lim)
  (let ([min (car lim)] [max (cadr lim)])
    (if max
        (begin (put-byte! p 1) (uleb! p min) (uleb! p max))
        (begin (put-byte! p 0) (uleb! p min)))))

(define (blocktype! p bt)
  (cond [(null? bt) (put-byte! p #x40)]
        [(and (pair? bt) (eq? (car bt) 'type)) (sleb! p (cadr bt))]
        [else (valtype! p bt)]))

;; ---- instructions ----

(define (instrs! p instrs) (for-each (lambda (i) (instr! p i)) instrs))

(define (gc! p n) (put-byte! p #xFB) (uleb! p n))

(define (instr! p i)
  (let ([op (car i)] [args (cdr i)])
    (case op
      [(unreachable) (put-byte! p #x00)]
      [(nop) (put-byte! p #x01)]
      [(block) (put-byte! p #x02) (blocktype! p (car args)) (instrs! p (cadr args)) (put-byte! p #x0B)]
      [(loop) (put-byte! p #x03) (blocktype! p (car args)) (instrs! p (cadr args)) (put-byte! p #x0B)]
      [(if) (put-byte! p #x04) (blocktype! p (car args)) (instrs! p (cadr args))
            (unless (null? (caddr args)) (put-byte! p #x05) (instrs! p (caddr args)))
            (put-byte! p #x0B)]
      [(br) (put-byte! p #x0C) (uleb! p (car args))]
      [(br_if) (put-byte! p #x0D) (uleb! p (car args))]
      [(return) (put-byte! p #x0F)]
      [(call) (put-byte! p #x10) (uleb! p (car args))]
      [(call_indirect) (put-byte! p #x11) (uleb! p (car args)) (uleb! p (cadr args))]
      [(return_call) (put-byte! p #x12) (uleb! p (car args))]
      [(return_call_indirect) (put-byte! p #x13) (uleb! p (car args)) (uleb! p (cadr args))]
      [(call_ref) (put-byte! p #x14) (uleb! p (car args))]
      [(return_call_ref) (put-byte! p #x15) (uleb! p (car args))]
      [(drop) (put-byte! p #x1A)]
      [(select) (put-byte! p #x1B)]
      [(select-typed) (put-byte! p #x1C) (uleb! p 1) (valtype! p (car args))]
      [(local.get) (put-byte! p #x20) (uleb! p (car args))]
      [(local.set) (put-byte! p #x21) (uleb! p (car args))]
      [(local.tee) (put-byte! p #x22) (uleb! p (car args))]
      [(global.get) (put-byte! p #x23) (uleb! p (car args))]
      [(global.set) (put-byte! p #x24) (uleb! p (car args))]
      [(i32.const) (put-byte! p #x41) (sleb! p (car args))]
      [(i64.const) (put-byte! p #x42) (sleb! p (car args))]
      [(f32.const) (put-byte! p #x43) (le-bytes! p (flonum32-bits (car args)) 4)]
      [(f64.const) (put-byte! p #x44) (le-bytes! p (flonum-bits (car args)) 8)]
      [(ref.null) (put-byte! p #xD0) (heap! p (car args))]
      [(ref.is_null) (put-byte! p #xD1)]
      [(ref.func) (put-byte! p #xD2) (uleb! p (car args))]
      [(ref.eq) (put-byte! p #xD3)]
      [(ref.as_non_null) (put-byte! p #xD4)]
      [(table.grow) (put-byte! p #xFC) (uleb! p 15) (uleb! p (car args))]
      [(table.size) (put-byte! p #xFC) (uleb! p 16) (uleb! p (car args))]
      ;; GC (0xFB prefix)
      [(struct.new) (gc! p 0) (uleb! p (car args))]
      [(struct.get) (gc! p 2) (uleb! p (car args)) (uleb! p (cadr args))]
      [(struct.get_s) (gc! p 3) (uleb! p (car args)) (uleb! p (cadr args))]
      [(struct.get_u) (gc! p 4) (uleb! p (car args)) (uleb! p (cadr args))]
      [(struct.set) (gc! p 5) (uleb! p (car args)) (uleb! p (cadr args))]
      [(array.new) (gc! p 6) (uleb! p (car args))]
      [(array.new_default) (gc! p 7) (uleb! p (car args))]
      [(array.new_fixed) (gc! p 8) (uleb! p (car args)) (uleb! p (cadr args))]
      [(array.new_data) (gc! p 9) (uleb! p (car args)) (uleb! p (cadr args))]
      [(array.get) (gc! p 11) (uleb! p (car args))]
      [(array.get_s) (gc! p 12) (uleb! p (car args))]
      [(array.get_u) (gc! p 13) (uleb! p (car args))]
      [(array.set) (gc! p 14) (uleb! p (car args))]
      [(array.len) (gc! p 15)]
      [(array.fill) (gc! p 16) (uleb! p (car args))]
      [(array.copy) (gc! p 17) (uleb! p (car args)) (uleb! p (cadr args))]
      ;; (ref.test nullable? heap) / (ref.cast nullable? heap)
      [(ref.test) (gc! p (if (car args) 21 20)) (heap! p (cadr args))]
      [(ref.cast) (gc! p (if (car args) 23 22)) (heap! p (cadr args))]
      [(ref.i31) (gc! p 28)]
      [(i31.get_s) (gc! p 29)]
      [(i31.get_u) (gc! p 30)]
      [else
       (let ([prim (lookup-prim op)])
         (unless prim (error 'encode "unknown instruction ~s" i))
         (for-each (lambda (b) (put-byte! p b)) (prim-op-code prim))
         (when (eq? (prim-op-kind prim) 'mem)
           ;; args: (align offset)
           (uleb! p (car args))
           (uleb! p (cadr args))))])))

;; ---- module ----

(define (type-entry! p t)
  (case (car t)
    [(func) (put-byte! p #x60) (vec! p (cadr t) valtype!) (vec! p (caddr t) valtype!)]
    [(struct) (put-byte! p #x5F) (vec! p (cadr t) field!)]
    [(array) (put-byte! p #x5E) (field! p (cadr t))]
    ;; A final type with no supertype is written as its comptype alone.
    [(sub) (let ([final? (cadr t)] [supers (caddr t)])
             (unless (and final? (null? supers))
               (put-byte! p (if final? #x4F #x50))
               (vec! p supers (lambda (p i) (uleb! p i))))
             (type-entry! p (cadddr t)))]
    ;; A recursion group: one entry, but each member has its own type index.
    [(rec) (put-byte! p #x4E) (vec! p (cdr t) type-entry!)]
    [else (error 'encode "unknown type ~s" t)]))

(define (import! p imp)
  (name! p (car imp))
  (name! p (cadr imp))
  (let ([desc (cadddr imp)])
    (case (caddr imp)
      [(func) (put-byte! p 0) (uleb! p desc)]
      [(table) (put-byte! p 1) (put-byte! p #x70) (limits! p desc)]
      [(memory) (put-byte! p 2) (limits! p desc)]
      [(global) (put-byte! p 3) (valtype! p (car desc)) (put-byte! p (if (cadr desc) 1 0))])))

(define (global! p g)
  (valtype! p (car g))
  (put-byte! p (if (cadr g) 1 0))
  (instrs! p (caddr g))
  (put-byte! p #x0B))

(define (export! p e)
  (name! p (car e))
  (put-byte! p (case (cadr e) [(func) 0] [(table) 1] [(memory) 2] [(global) 3]))
  (uleb! p (caddr e)))

(define (code! p f)
  (let ([body (with-output
               (lambda (q)
                 (vec! q (group-locals (cadr f)) (lambda (q g) (uleb! q (cdr g)) (valtype! q (car g))))
                 (instrs! q (caddr f))
                 (put-byte! q #x0B)))])
    (uleb! p (bytes-length body))
    (put-bytes! p body)))

(define (data! p d)
  (if (car d)
      (begin (put-byte! p 0)                ; active, memory 0
             (instr! p (list 'i32.const (car d)))
             (put-byte! p #x0B))
      (put-byte! p 1))                      ; passive
  (uleb! p (bytes-length (cdr d)))
  (put-bytes! p (cdr d)))

(define (subsection! p id proc)
  (let ([sub (with-output proc)])
    (put-byte! p id)
    (uleb! p (bytes-length sub))
    (put-bytes! p sub)))

(define (encode-module m)
  (with-output
   (lambda (p)
     (put-bytes! p (bytes #x00 #x61 #x73 #x6D #x01 #x00 #x00 #x00))
     (let ([types (wmodule-types m)])
       (unless (null? types) (section! p 1 (lambda (p) (vec! p types type-entry!)))))
     (let ([imports (wmodule-imports m)])
       (unless (null? imports) (section! p 2 (lambda (p) (vec! p imports import!)))))
     (let ([funcs (wmodule-funcs m)])
       (unless (null? funcs) (section! p 3 (lambda (p) (vec! p funcs (lambda (p f) (uleb! p (car f))))))))
     (let ([tables (wmodule-tables m)])
       (unless (null? tables)
         (section! p 4 (lambda (p) (vec! p tables (lambda (p t) (put-byte! p #x70) (limits! p t)))))))
     (let ([mems (wmodule-memories m)])
       (unless (null? mems) (section! p 5 (lambda (p) (vec! p mems limits!)))))
     (let ([globals (wmodule-globals m)])
       (unless (null? globals) (section! p 6 (lambda (p) (vec! p globals global!)))))
     (let ([exports (wmodule-exports m)])
       (unless (null? exports) (section! p 7 (lambda (p) (vec! p exports export!)))))
     (when (wmodule-start m)
       (section! p 8 (lambda (p) (uleb! p (wmodule-start m)))))
     (let ([declared (wmodule-declared m)])
       (unless (null? declared)
         (section! p 9
           (lambda (p)
             (uleb! p 1)
             (put-byte! p 3)          ; declarative, elemkind + funcidx vector
             (put-byte! p #x00)
             (vec! p declared uleb!)))))
     ;; The data count, which code referring to segments needs.
     (let ([datas (wmodule-datas m)])
       (unless (null? datas) (section! p 12 (lambda (p) (uleb! p (length datas))))))
     (let ([funcs (wmodule-funcs m)])
       (unless (null? funcs) (section! p 10 (lambda (p) (vec! p funcs code!)))))
     (let ([datas (wmodule-datas m)])
       (unless (null? datas) (section! p 11 (lambda (p) (vec! p datas data!)))))
     (let ([names (wmodule-names m)])
       (when names
         (section! p 0
           (lambda (p)
             (name! p "name")
             (subsection! p 0 (lambda (q) (name! q (car names))))
             (subsection! p 1 (lambda (q) (vec! q (cdr names) (lambda (q n) (uleb! q (car n)) (name! q (cdr n)))))))))))))

;; Run-length group consecutive equal local types: ((type . count) ...)
(define (group-locals types)
  (let loop ([ts types] [acc '()])
    (cond [(null? ts) (reverse acc)]
          [(and (pair? acc) (equal? (caar acc) (car ts)))
           (loop (cdr ts) (cons (cons (caar acc) (+ 1 (cdar acc))) (cdr acc)))]
          [else (loop (cdr ts) (cons (cons (car ts) 1) acc))])))
