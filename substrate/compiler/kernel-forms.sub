;; Control forms for kernel code on the kernel module's data: cond, and, or, case, for.

(require k kernel)
(provide cond and or when unless case for/each for/list for/fold for/and for/or)

(begin-for-syntax
  (require k kernel)
  (require sm "syntax-match.sub" syntax-match _ ... ?)

  (func (else? [x i32]) -> i32 (if (k:identifier? x) (i32.eq (k:syntax-e x) 'else) 0))

  (func (cond-form [s i32]) -> i32
    (syntax-match s
      [(_) #'(nop)]
      [(_ ((? else? e) body ...)) #`(begin #,@body)]
      [(_ ((? else? e) . _) . _) (k:raise-syntax-error 'cond '"else is the last clause of a cond" e)]
      [(_ (test body ...)) #`(if #,test (begin #,@body))]
      [(_ (test body ...) clause ...) #`(if #,test (begin #,@body) (cond #,@clause))]))

  (func (and-form [s i32]) -> i32
    (syntax-match s
      [(_) #'1]
      [(_ e) e]
      [(_ e rest ...) #`(if #,e (and #,@rest) 0)]))

  (func (or-form [s i32]) -> i32
    (syntax-match s
      [(_) #'0]
      [(_ e) e]
      [(_ e rest ...) #`(let ([v #,e]) (if v v (or #,@rest)))]))

  (func (when-form [s i32]) -> i32 (syntax-match s [(_ test body ...) #`(if #,test (begin #,@body))]))
  (func (unless-form [s i32]) -> i32 (syntax-match s [(_ test body ...) #`(if (i32.eqz #,test) (begin #,@body))]))

  (func (same-as [key i32] [d i32]) -> i32
    (let ([e (k:syntax-e d)])
      (if (if (k:symbol? e) 1 (if (k:boolean? e) 1 (k:null? e)))
          #`(i32.eq #,key '#,d)
          #`(k:equal? #,key '#,d))))

  (func (case-clauses [key i32] [cs i32]) -> i32
    (if (k:null? cs)
        '()
        (k:cons (syntax-match (k:car cs)
                  [((? else? e) body ...) (k:car cs)]
                  [((d ...) body ...) #`[(or #,@(same-as-each key d)) #,@body]]
                  [_ (k:raise-syntax-error 'case '"expected [(datum ...) body ...] or [else body ...]" (k:car cs))])
                (case-clauses key (k:cdr cs)))))

  (func (same-as-each [key i32] [ds i32]) -> i32
    (if (k:null? ds) '() (let ([c (same-as key (k:car ds))]) (k:cons c (same-as-each key (k:cdr ds))))))

  (func (case-form [s i32]) -> i32
    (syntax-match s
      [(_ e clause ...) #`(let ([key #,e]) (cond #,@(case-clauses #'key clause)))]))

  (global temps (mut i32) 0)

  (func (temp) -> i32
    (set! temps (i32.add temps 1))
    (k:datum->syntax #'here (k:string->symbol (k:format '"l~a" `(,(k:fixnum temps)))) 0))

  (func (for-clauses [s i32] [cs i32]) -> i32
    (syntax-match cs
      [(((? k:identifier? x) l) ... #:when guard) `(,x ,l ,guard)]
      [(((? k:identifier? x) l) ...) `(,x ,l #f)]
      [_ (k:raise-syntax-error 0 '"expected ([x list] ... [#:when test])" s)]))

  (func (temps-for [l i32]) -> i32 (if (k:null? l) '() (let ([t (temp)]) (k:cons t (temps-for (k:cdr l))))))

  (func (pairs [xs i32] [es i32]) -> i32
    (if (k:null? xs) '() (k:cons #`[#,(k:car xs) #,(k:car es)] (pairs (k:cdr xs) (k:cdr es)))))

  (func (element-bindings [xs i32] [ts i32]) -> i32
    (if (k:null? xs) '() (k:cons #`[#,(k:car xs) (k:car #,(k:car ts))] (element-bindings (k:cdr xs) (k:cdr ts)))))

  (func (ends [ts i32] [done i32]) -> i32
    (if (k:null? ts) '() (k:cons #`(br-if #,done (i32.eqz (k:pair? #,(k:car ts)))) (ends (k:cdr ts) done))))

  (func (steps [ts i32]) -> i32
    (if (k:null? ts) '() (k:cons #`(set! #,(k:car ts) (k:cdr #,(k:car ts))) (steps (k:cdr ts)))))

  (func (for-loop [s i32] [cs i32] [bindings i32] [done i32] [each i32]) -> i32
    (let* ([c (for-clauses s cs)] [ts (temps-for (k:car c))] [guard (k:caddr c)])
      #`(let (#,@bindings #,@(pairs ts (k:cadr c)))
          (block #,done
            (loop next
              #,@(ends ts done)
              (let (#,@(element-bindings (k:car c) ts))
                #,(if guard #`(if #,guard #,each) each))
              #,@(steps ts)
              (br next))))))

  (func (for/each-form [s i32]) -> i32
    (syntax-match s
      [(_ (clause ...) body ...) (for-loop s clause '() #'done #`(begin #,@body))]))

  (func (for/list-form [s i32]) -> i32
    (syntax-match s
      [(_ (clause ...) body ...)
       #`(k:reverse
          (let ([acc '()])
            #,(for-loop s clause '() #'done #`(set! acc (k:cons (begin #,@body) acc)))
            acc))]))

  (func (for/fold-form [s i32]) -> i32
    (syntax-match s
      [(_ (((? k:identifier? acc) init)) (clause ...) body ...)
       #`(let ([#,acc #,init])
           #,(for-loop s clause '() #'done #`(set! #,acc (begin #,@body)))
           #,acc)]))

  (func (for/and-form [s i32]) -> i32
    (syntax-match s
      [(_ (clause ...) body ...)
       #`(let ([result 1])
           #,(for-loop s clause '() #'done #`(begin (set! result (begin #,@body)) (br-if done (i32.eqz result))))
           result)]))

  (func (for/or-form [s i32]) -> i32
    (syntax-match s
      [(_ (clause ...) body ...)
       #`(let ([result 0])
           #,(for-loop s clause '() #'done #`(begin (set! result (begin #,@body)) (br-if done result)))
           result)])))

(define-syntax cond cond-form)
(define-syntax and and-form)
(define-syntax or or-form)
(define-syntax when when-form)
(define-syntax unless unless-form)
(define-syntax case case-form)
(define-syntax for/each for/each-form)
(define-syntax for/list for/list-form)
(define-syntax for/fold for/fold-form)
(define-syntax for/and for/and-form)
(define-syntax for/or for/or-form)
