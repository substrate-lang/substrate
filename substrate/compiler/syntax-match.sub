;; syntax-match, for macros written in kernel code: patterns that take syntax apart.

(require k kernel)
(require pt "kernel-patterns.sub" _ ... ? no-match)
(provide syntax-match _ ... ?)

(begin-for-syntax
  (require k kernel)
  (require pt "kernel-patterns.sub")

  (global who (mut i32) 0)

  (func (literal [d i32]) -> i32 (k:datum->syntax #'here d 0))

  (global temps (mut i32) 0)

  (func (temp [base i32]) -> i32
    (set! temps (i32.add temps 1))
    (k:datum->syntax #'here (k:string->symbol (k:format '"~a~a" `(,base ,(k:fixnum temps)))) 0))

  (func (temps-for [l i32] [base i32]) -> i32
    (if (k:null? l) '() (let ([t (temp base)]) (k:cons t (temps-for (k:cdr l) base)))))

  (func (bindings [xs i32] [es i32]) -> i32
    (if (k:null? xs) '() (k:cons #`[#,(k:car xs) #,(k:car es)] (bindings (k:cdr xs) (k:cdr es)))))

  (func (empty-bindings [xs i32]) -> i32
    (if (k:null? xs) '() (k:cons #`[#,(k:car xs) '()] (empty-bindings (k:cdr xs)))))

  (func (zero-bindings [xs i32]) -> i32
    (if (k:null? xs) '() (k:cons #`[#,(k:car xs) 0] (zero-bindings (k:cdr xs)))))

  (func (acc-sets [is i32] [accs i32] [vars i32] [last i32]) -> i32
    (if (k:null? is)
        '()
        (k:cons (if last
                    #`(set! #,(pt:nth vars (k:car is)) (k:reverse #,(k:car accs)))
                    #`(set! #,(k:car accs) (k:cons #,(pt:nth vars (k:car is)) #,(k:car accs))))
                (acc-sets (k:cdr is) (k:cdr accs) vars last))))

  (func (always? [t i32]) -> i32 (if (k:pair? t) (i32.eq (k:car t) 'always) 0))

  (func (test-code [t i32]) -> i32 (if (always? t) #`(begin #,@(k:cdr t) 1) t))

  (func (both [a i32] [b i32]) -> i32
    (if (always? a)
        (if (always? b) (k:cons 'always (k:append (k:cdr a) (k:cdr b))) #`(begin #,@(k:cdr a) #,(test-code b)))
        #`(if #,a #,(test-code b) 0)))

  (func (compile-test [d i32] [x i32] [vars i32] [values i32]) -> i32
    (let ([kind (k:car d)])
      (if (i32.eq kind 'var)
          `(always ,#`(set! #,(pt:nth vars (k:cadr d)) #,x))
          (if (i32.eq kind 'any)
              '(always)
              (if (i32.eq kind 'datum)
                  #`(datum-matches? #,x '#,(literal (k:cadr d)))
                  (if (i32.eq kind 'bound)
                      #`(bound-matches? #,x #,(pt:nth values (k:cadr d)))
                      (if (i32.eq kind 'check)
                          (both #`(#,(pt:nth values (k:cadr d)) #,x) (compile-tests (k:cddr d) x vars values))
                          (compile-elements (k:cadr d) (k:caddr d) x vars values))))))))

  (func (compile-tests [ds i32] [x i32] [vars i32] [values i32]) -> i32
    (if (k:null? ds)
        '(always)
        (if (k:null? (k:cdr ds))
            (compile-test (k:car ds) x vars values)
            (both (compile-test (k:car ds) x vars values) (compile-tests (k:cdr ds) x vars values)))))

  (func (compile-elements [es i32] [tail i32] [r i32] [vars i32] [values i32]) -> i32
    (if (k:null? es)
        (if (i32.eq (k:car tail) 'null)
            #`(k:null? (k:splice-list #,r))
            (compile-test tail r vars values))
        (if (i32.eq (k:car (k:car es)) 'repeat)
            (if (if (k:null? (k:cdr es)) (i32.eq (k:car tail) 'null) 0)
                (compile-repeat (k:car es) r vars values)
                (compile-backtrack (k:car es) (k:cdr es) tail r vars values))
            (let ([m (temp '"m")] [a (temp '"a")] [d (temp '"d")])
              #`(let ([#,m (list-pair #,r)])
                  (if #,m
                      #,(if (i32.eq (k:car (k:car es)) 'any)
                            #`(let ([#,d (k:unsafe-cdr #,m)]) #,(test-code (compile-elements (k:cdr es) tail d vars values)))
                            #`(let ([#,a (k:unsafe-car #,m)] [#,d (k:unsafe-cdr #,m)])
                                #,(test-code (both (compile-test (k:car es) a vars values)
                                                   (compile-elements (k:cdr es) tail d vars values)))))
                      0))))))

  (func (compile-repeat [e i32] [r i32] [vars i32] [values i32]) -> i32
    (let ([p (k:cadr e)] [is (k:caddr e)])
      (if (i32.eq (k:car p) 'var)
          (let ([xs (temp '"xs")])
            #`(let ([#,xs (elements-of #,r)]) (if #,xs (begin (set! #,(pt:nth vars (k:cadr p)) #,xs) 1) 0)))
          (if (i32.eq (k:car p) 'any)
              #`(if (elements-of #,r) 1 0)
              (let* ([ok (temp '"ok")] [done (temp '"done")] [next (temp '"next")] [rest (temp '"r")] [m (temp '"m")]
                     [a (temp '"a")] [accs (temps-for is '"acc")])
                #`(let ([#,ok 0] [#,rest #,r] #,@(empty-bindings accs))
                    (block #,done
                      (loop #,next
                        (let ([#,m (k:splice-list #,rest)])
                          (if (k:null? #,m) (begin #,@(acc-sets is accs vars 1) (set! #,ok 1) (br #,done)))
                          (br-if #,done (i32.eqz (k:pair? #,m)))
                          (let ([#,a (k:unsafe-car #,m)])
                            (br-if #,done (i32.eqz #,(test-code (compile-test p a vars values))))
                            #,@(acc-sets is accs vars 0)
                            (set! #,rest (k:unsafe-cdr #,m))
                            (br #,next)))))
                    #,ok))))))

  (func (compile-backtrack [e i32] [es i32] [tail i32] [r i32] [vars i32] [values i32]) -> i32
    (let* ([p (k:cadr e)] [is (k:caddr e)]
           [ok (temp '"ok")] [n (temp '"n")] [rest (temp '"r")] [m (temp '"m")] [a (temp '"a")] [after (temp '"after")]
           [counted (temp '"counted")] [count (temp '"count")] [done (temp '"done")] [again (temp '"again")]
           [collected (temp '"collected")] [collect (temp '"collect")] [i (temp '"i")] [accs (temps-for is '"acc")])
      #`(let ([#,ok 0] [#,n 0] [#,rest #,r])
          (block #,counted
            (loop #,count
              (let ([#,m (k:splice-list #,rest)])
                (br-if #,counted (i32.eqz (k:pair? #,m)))
                (let ([#,a (k:unsafe-car #,m)])
                  (br-if #,counted (i32.eqz #,(test-code (compile-test p a vars values))))
                  (set! #,n (i32.add #,n 1))
                  (set! #,rest (k:unsafe-cdr #,m))
                  (br #,count)))))
          (block #,done
            (loop #,again
              (let ([#,after (list-after #,r #,n)])
                (if #,(test-code (compile-elements es tail after vars values))
                    (let ([#,i 0] [#,rest #,r] #,@(empty-bindings accs))
                      (block #,collected
                        (loop #,collect
                          (br-if #,collected (i32.eq #,i #,n))
                          (let* ([#,m (k:splice-list #,rest)] [#,a (k:unsafe-car #,m)])
                            (drop #,(test-code (compile-test p a vars values)))
                            #,@(acc-sets is accs vars 0)
                            (set! #,rest (k:unsafe-cdr #,m))
                            (set! #,i (i32.add #,i 1))
                            (br #,collect))))
                      #,@(acc-sets is accs vars 1)
                      (set! #,ok 1)
                      (br #,done))))
              (br-if #,done (i32.eqz #,n))
              (set! #,n (i32.sub #,n 1))
              (br #,again)))
          #,ok)))

  (func (compile-clauses [cs i32] [ds i32] [varss i32] [x i32] [last i32] [values i32]) -> i32
    (if (k:null? cs)
        last
        (let* ([vars (temps-for (k:car varss) '"v")]
               [test (compile-test (k:car ds) x vars values)]
               [body #`(let (#,@(bindings (k:car varss) vars)) #,@(k:cdr (k:car cs)))])
          (if (always? test)
              #`(let (#,@(zero-bindings vars)) #,@(k:cdr test) #,body)
              #`(let (#,@(zero-bindings vars))
                  (if #,test #,body #,(compile-clauses (k:cdr cs) (k:cdr ds) (k:cdr varss) x last values)))))))

  (func (syntax-match-form [stx i32]) -> i32
    (set! who 'syntax-match)
    (let* ([parts (k:syntax->list stx)]
           [clauses (if (if parts (i32.ge_u (k:length parts) 3) 0)
                        (pt:match-clauses (k:cddr parts) who)
                        (k:raise-syntax-error who '"expected (syntax-match subject [pattern body ...] ...)" stx))]
           [parsed (pt:parse-patterns (pt:clause-patterns clauses) who `(,#'_ ,#'... ,#'? ,#'quote ,#'quote-syntax))]
           [x (temp '"s")])
      #`(let ([#,x #,(k:cadr parts)])
          #,(compile-clauses clauses (k:car parsed) (k:cadr parsed) x
                             #`(no-match '#,(literal (k:car parsed)) #,x)
                             (k:caddr parsed))))))

(define-syntax syntax-match syntax-match-form)

(func (list-pair [x i32]) -> i32 (let ([m (k:splice-list x)]) (if (k:pair? m) m 0)))

(func (datum-matches? [x i32] [v i32]) -> i32
  (k:equal? (if (k:pair? v) (k:syntax->datum x) (k:splice-list x)) v))

(func (bound-matches? [x i32] [id i32]) -> i32 (if (k:identifier? x) (k:free-identifier=? x id) 0))

(func (elements-of [l i32]) -> i32
  (let ([m (k:splice-list l)])
    (if (k:null? m)
        '()
        (if (k:list? m)
            m
            (if (k:pair? m)
                (let ([r (elements-of (k:cdr m))]) (if r (k:cons (k:car m) r) 0))
                0)))))

(func (list-after [l i32] [n i32]) -> i32
  (block done
    (loop next
      (br-if done (i32.eqz n))
      (set! l (k:unsafe-cdr (k:splice-list l)))
      (set! n (i32.sub n 1))
      (br next)))
  l)
