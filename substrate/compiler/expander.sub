;; Lifecycle: permanent.
;;
;; The expander. It turns a module's syntax into the compiler's input, the
;; lowered code of core.sub, building it as it expands; or, when
;; `sub expand` or a macro's local-expand asks, into fully expanded code
;; (spec 6.4). It also owns modules, the cache and compiled files, and
;; sessions.
;;
;; Entry points: compile-module-file and expand-module-file (used by
;; main.sub); program-linklets and module-linklet-list, which give what a
;; program loads; set-cache-directory! and compiled-file-bytes (spec 3.7);
;; and the session functions session-open!, session-eval!,
;; session-eval-text!, session-eval-file! and session-recover!.
;;
;; Binding uses sets of scopes (spec 6.1). A module is a file, and each of
;; its phases compiles to one wasm module, a linklet (spec 3.1). While a
;; module is expanded, each begin-for-syntax is compiled into a linklet and
;; run at once in the module's compile-time store (spec 3.2), and macros
;; are called there. Macros work on the kernel module's data, which lives
;; in the running compiler's memory ("the kernel module", below).
;;
;; Memory. What lasts the whole run lives in the run's arena (kernel.sub):
;; the binding table, the compiled modules and what they record, their
;; linklets, and the definitions (core.sub). Everything a module's
;; expansion and compilation make lives in its module arena and is freed
;; when the module is done, along with its compile-time store.
(require-unqualified base "base/base.sub")
(require-unqualified k "kernel.sub")
(require-unqualified core "core.sub")
(require-unqualified ops "ops.sub")
(require-unqualified rd "reader.sub")
(require-unqualified host "host.sub")
(require-unqualified cmp "compile.sub")
(require-unqualified running "running.sub")
(require-unqualified ser "serialize.sub")

(provide set-repository-root! set-package-root! set-running-directory! compile-module-file expand-module-file
         content-hash linklet program-linklets module-linklet-list trap-report set-cache-directory! compiled-file-bytes
         session-open! session-eval! session-eval-text! session-eval-file! session-error session-recover!)

(memory from base)
(table from base)

(define gc-forms datum
  `(struct.new struct.get struct.get_s struct.get_u struct.set
    array.new array.new_default array.new_fixed array.get array.get_s array.get_u array.set
    array.len array.copy array.fill
    ref.null ref.is_null ref.eq ref.as_non_null ref.test ref.cast ref.i31 i31.get_s i31.get_u))

;; The implicit forms (spec 5.3, 5.4), and facts, which a language records
;; about definitions (6.5).
(define core-forms datum
  (append (quoted (func global import memory table data type rec tag define-syntax begin-for-syntax
            begin require require-unqualified provide freestanding set! let let* lambda if block loop br br-if br-table
            return
            call-indirect call-ref ref.func func-index data-address data-size select drop values unreachable nop
            throw throw-ref try closure
            i32.const i64.const f32.const f64.const
            quote quasiquote unquote unquote-splicing quote-syntax quasisyntax unsyntax unsyntax-splicing
            #%app #%datum #%fact))
          gc-forms))

(define eqref datum (make-ref (boolean 1) (sym eq)))

;; ==== errors ====

;; A compile error at where, syntax or #f, with template and args
;; (format-message).
(define (fail-at [where datum] [template (ptr u8)] [args datum]) -> datum
  (raise-compile-error (if (syntax? where) (syntax-srcloc where) 0) (format-message template args))
  0)

;; What a form x that none of the patterns a syntax-match had would match
;; raises, as Substrate's syntax-match does: "expected" and the patterns,
;; texts, a syntax error blamed on x, named for x's head.
(define (no-match [x datum] [patterns (ptr u8)]) -> datum
  (let ([name (form-name x)] [message (format-message "expected ~a" (cons (bytes->string patterns (strlen patterns)) nil))])
    (throw compile-error (if (== name 0) message (format-message "~a: ~a" `(,name ,message))) x 0)
    0))

;; The name an error about x takes: an identifier's own, or that of the
;; identifier heading a list; or #f.
(define (form-name [x datum]) -> datum
  (cond [(identifier? x) (syntax-e x)]
        [(and (syntax? x) (pair? (syntax-e x)) (identifier? (car (syntax-e x)))) (syntax-e (car (syntax-e x)))]
        [else 0]))

(define (list1 [x datum]) -> datum (cons x nil))

;; ==== the run ====
;;
;; Everything below is shared by all modules compiled in one run of the
;; compiler: the binding table, scope ids, and compiled modules. A macro's
;; template identifiers keep resolving to its own module's bindings when
;; another module expands it, because those bindings stay in the table.

;; A binding: kept under the greatest scope of its set, or none if the
;; set is empty, with the others of the same symbol there, the latest
;; first; an identifier can refer to it only if the identifier has that
;; scope too. phase: a phase, or all-phases. namespace: type or value (spec
;; 6.1). key identifies the binding to compiled code (local-binding, spec
;; 2.3).
(struct binding [scopes (ptr scope-set)] [phase i32] [namespace datum] [key datum] [meaning datum] [next (ptr binding)])

(define all-phases i32 -1)

;; (symbol, slot) -> its bindings kept there; the slot of the empty set is
;; none-slot.
(define bindings hash-table)
(define none-slot u32 4294967295)

;; The bindings require-unqualified made, each -> 1, or 2 once a macro use
;; has relied on it: a definition of the same name may shadow one it has
;; not (spec 3.1).
(define unqualified-imports hash-table)
(define scope-counter u32 0)
(define base-installed i32 0)
(define registry hash-table)                ; path, a symbol -> its module
(define units-by-hash hash-table)           ; hash, a symbol -> its module

;; meaning: (core name) (prim name) (func info) (global info) (data info)
;;          (type info) (tag info) (local key) (label key) (compile-time-value getter-info)
;; A type meaning is in the type namespace, every other one in the value
;; namespace. Locals and labels are bound before their meaning is set, so
;; #f counts as a value.
(define (meaning-namespace [meaning datum]) -> datum
  (if (and (!= meaning 0) (== (car meaning) (sym type))) (sym type) (sym value)))

;; One phase of a module, compiled: bytes, a string; the instance names it
;; imports from (relative to the module at phase shift 0); whether it uses
;; GC; and the scope table of its syntax literals (spec 3.5): the run's
;; scope for each index. A module's linklets are a list, next.
(struct linklet [phase i32] [bytes datum] [imports datum] [gc i32] [scopes datum] [next (ptr linklet)])

;; A compiled (or compiling) module. linklets: its linklets, one per phase;
;; phase 0's is its program's. requires: list of (module . shift).
;; provides: list of (symbol . meaning). entries: its module-level
;; bindings, the latest first. scope: its module scope. code: its lowered
;; phase-0 forms, while it compiles. hash: its identity, of its source and
;; its requires' hashes (spec 3.2). name: what its instance names start
;; with, its stem and hash. path: its file, which its source locations name
;; (3.6). facts: the facts it recorded, newest first, each (definition
;; phase value): the definition it is about (fact-key), the phase, and its
;; datum or syntax. types and infos: the types and definitions it made,
;; newest first. scope-count and type-count: how many scopes its
;; expansion made and types it declared, each numbered in it, so that an
;; interface can name them (the cache). A module loaded from a compiled
;; file has (compiled file hash) for its path (3.7).
(struct unit [self datum] [path datum] [name datum] [hash datum] [state datum] [requires datum] [provides datum]
        [entries (ptr module-entry)] [code datum] [scope u32] [types datum] [infos datum] [facts datum]
        [linklets (ptr linklet)] [scope-count u32] [type-count u32] [memories datum])

;; A module-level binding of a module, which one that requires it at a
;; phase shift can install a shifted copy of.
(struct module-entry [symbol datum] [scopes (ptr scope-set)] [phase i32] [binding (ptr binding)] [next (ptr module-entry)])

(define unit-kind u32 20)

(define (new-unit [path datum] [name datum]) -> datum
  (let ([m (cast (ptr unit) (alloc-in (& run-arena) (sizeof unit)))])
    (set! (-> m self) (make-record unit-kind m))
    (set! (-> m path) (keep path))
    (set! (-> m name) (keep name))
    (set! (-> m hash) 0)
    (set! (-> m state) (sym compiling))
    (set! (-> m requires) nil)
    (set! (-> m provides) nil)
    (set! (-> m entries) 0)
    (set! (-> m code) 0)
    (set! (-> m scope) 0)
    (set! (-> m types) nil)
    (set! (-> m memories) nil)
    (set! (-> m infos) nil)
    (set! (-> m facts) nil)
    (set! (-> m linklets) 0)
    (set! (-> m scope-count) 0)
    (set! (-> m type-count) 0)
    (-> m self)))

(define (unit-of [m datum]) -> (ptr unit) (cast (ptr unit) (record-pointer m)))

;; The state of one module's compilation. use-site-scopes: integers.
;; phase-forms, memories and tables: alists from phases to forms.
;; provide-ids: (name . id) ..., newest first. require-names: ((name .
;; phase) . module).
;; Its compile-time store (spec 3.2), a namespace in the compiler's: ns,
;; the namespace's name; instances, the instance names instantiated in it,
;; as symbols; values, getter -> (value), the compile-time values fetched
;; so far; linklet-counter, the number of compile-time linklets so far;
;; storage-linklets, ((memory-or-table . phase) . the compile-time linklet
;; that defines it).
(struct comp [module datum] [use-site-scopes datum] [freestanding-form datum] [phase-forms datum] [memories datum]
        [tables datum] [provide-ids datum] [require-names datum]
        [ns datum] [instances (ptr arena-table)] [values (ptr arena-table)] [linklet-counter u32] [storage-linklets datum])

(define current (ptr comp) 0)                ; the comp being expanded

(define (the-module) -> (ptr unit) (unit-of (-> current module)))

(define namespace-counter u32 0)

(define (new-comp [m datum]) -> (ptr comp)
  (let ([c (cast (ptr comp) (alloc-in (current-arena) (sizeof comp)))])
    (set! (-> c module) m)
    (set! (-> c use-site-scopes) nil)
    (set! (-> c freestanding-form) 0)
    (set! (-> c phase-forms) nil)
    (set! (-> c memories) nil)
    (set! (-> c tables) nil)
    (set! (-> c provide-ids) nil)
    (set! (-> c require-names) nil)
    (+= namespace-counter 1)
    (set! (-> c ns) (format-message "c~a" (list1 (make-integer namespace-counter))))
    (set! (-> c instances) (make-table))
    (set! (-> c values) (make-table))
    (set! (-> c linklet-counter) 0)
    (set! (-> c storage-linklets) nil)
    c))

;; Scopes are even; a local binding form's (new-local-scope!) is odd, so
;; that quote-syntax can prune the local ones from a literal (spec 6.2).
;; A scope of the module being expanded is numbered in it (own-scope!); a
;; module scope's copy for a phase shift, and the kernel ids' scope,
;; belong to the run.
(define (new-scope!) -> u32
  (let ([sc (new-run-scope!)])
    (when (!= current 0) (own-scope! (-> current module) sc))
    sc))
(define (new-run-scope!) -> u32 (+= scope-counter 2) scope-counter)
(define (new-local-scope!) -> u32
  (+= scope-counter 2)
  (let ([sc (+ scope-counter 1)])
    (when (!= current 0) (own-scope! (-> current module) sc))
    sc))

(define (even-scope? [sc u32]) -> i32 (== (% sc 2) 0))
(define (even-scopes [s (ptr scope-set)]) -> (ptr scope-set) (scopes-filter s even-scope?))
(define (prune-local-scopes [x datum]) -> datum (map-scopes x even-scopes))

(define core-scope u32 0)
(define core-scopes (ptr scope-set) (scopes-change no-scopes 0 0))

;; ==== the kernel module ====
;;
;; The kernel module is kernel.sub together with the run-time modules that
;; give it its memory and allocator. Compile-time code links to the
;; running compiler's instances of these modules (spec 1.4), so the
;; compiler and every macro share the kernel module's data and state:
;;   - (require k kernel) binds kernel.sub's functions and tags, at any
;;     phase;
;;   - (memory from k) and (table from k) take its memory and table, and a
;;     linklet at phase 1 or above that declares neither takes them too;
;;   - quote and its relatives make its data.
;; A program whose code uses the kernel module carries the running build's
;; linklets of it (program-linklets).
;;
;; bin/sub passes the directory of the running build (-r DIR). Its program
;; file lists the linklets the host registered, and the kernel module's
;; functions are read from kernel.sub's linklet there (running.sub). When
;; the compiler builds itself, kernel.sub compiled from source gets that
;; linklet's name (kernel-infos).

(define repository-root datum 0)
(define (set-repository-root! [root datum]) (set! repository-root (keep root)))

(define running-directory datum 0)
(define (set-running-directory! [dir datum]) (set! running-directory (keep dir)))

;; The running kernel module: a unit whose provides are kernel.sub's
;; functions and tags, sorted by name; the name of kernel.sub's instance;
;; and the running build's linklets, their names in the order its program
;; lists them.
(define kernel datum 0)
(define kernel-instance datum 0)
(define running-names datum 0)

;; The infos of the kernel module's functions and tags, which its
;; bindings hold. When the compiler builds itself, kernel.sub compiled from
;; source has infos of its own, and its linklet the name of the running
;; build's (kernel-name?): the same module, by its hash (spec 3.2), but
;; its definitions are a module's, while the kernel module's are none, and
;; at compile time the kernel module is the running build's.
(define kernel-infos hash-table)

(define (kernel-name? [name datum]) -> i32 (and (!= kernel-instance 0) (string=? name kernel-instance)))

;; The kernel module's group: its linklet, and the running build's
;; linklets it imports, directly or not, which give it its memory and
;; allocator (print, lang, runtime, c, numbers): one instance of each in
;; the compiler's store, the running compiler's, which compile-time code
;; links to at any phase shift, whether it requires the kernel module as
;; kernel or requires these modules by path. They are the same modules,
;; by their hashes (spec 3.2), when the sources are the running build's,
;; as bin/sub keeps them. So compile-time code, C code included, works
;; in the memory that holds the compiler's syntax, with its allocator and
;; stack.
(define kernel-group datum 0)

(define (group-of [name datum]) -> datum
  (let ([out nil] [todo (list1 name)] [n datum 0] [imports datum 0])
    (while (pair? todo)
      (set! n (car todo))
      (set! todo (cdr todo))
      (when (== (member n out) 0)
        (set! out (cons n out))
        (set! imports (let ([bytes (running-bytes n)]) (linklet-imports (string-bytes bytes) (string-length bytes))))
        (while (pair? imports)
          (when (running-linklet? (car imports)) (set! todo (cons (car imports) todo)))
          (set! imports (cdr imports)))))
    out))

;; The running build's instance of the kernel module's group that instance
;; name stands for: for S@0+t, S@0+0 if it is one of the group's; or #f.
(define (group-instance [name datum]) -> datum
  (when (== running-directory 0) (return 0))
  (ensure-kernel!)
  (let* ([b (string-bytes name)] [n (string-length name)] [i u32 0] [l kernel-group])
    (while (and (< i n) (!= (@ b i) #\@)) (+= i 1))
    (unless (and (< (+ i 2) n) (== (@ b (+ i 1)) #\0) (== (@ b (+ i 2)) #\+)) (return 0))
    (while (pair? l)
      (let ([g (car l)])
        (when (and (== (string-length g) (+ i 4)) (== (memcmp (string-bytes g) b (+ i 1)) 0)) (return g)))
      (set! l (cdr l)))
    0))

(define (ensure-kernel!)
  (when (== kernel 0)
    (when (== running-directory 0)
      (fail-at 0 "this code needs the kernel module, which is the running compiler's: give its build's directory with -r DIR" nil))
    (let* ([program (file-string (string-append-2 running-directory `"/program"))]
           [name (if (== program 0) 0 (kernel-linklet (program-names program)))]
           [bytes datum 0] [exports datum 0] [provides nil] [m datum 0])
      (when (== name 0) (fail-at 0 "~a/program lists no kernel module" (list1 running-directory)))
      (set! running-names (keep (program-names program)))
      (set! compiler-hash (keep (content-hash running-names)))
      (set! kernel-instance (keep name))
      (set! kernel-group (keep (group-of name)))
      (set! bytes (running-bytes name))
      (set! exports (linklet-exports (string-bytes bytes) (string-length bytes)))
      (while (pair? exports)
        (let* ([e (car exports)] [named (string->symbol (cadr e))]
               [info (if (== (car e) (sym func))
                         (func-info named (caddr e) (cadddr e) kernel-instance (cadr e) 0)
                         (tag-info named (caddr e) kernel-instance (cadr e)))])
          (hash-set! (& kernel-infos) (cast u64 info) 1)
          (set! provides (cons (cons named `(,(if (== (car e) (sym func)) (sym func) (sym tag)) ,info)) provides)))
        (set! exports (cdr exports)))
      (set! m (new-unit `"kernel" `"kernel"))
      (set! (-> (unit-of m) provides) (keep (sort provides (lambda ([a datum] [b datum]) -> i32 (symbol<? (car a) (car b))))))
      (set! (-> (unit-of m) state) (sym done))
      (set! kernel m)
      (set-kernel-definitions! (kernel-function (sym literal-buffer)) (kernel-function (sym deserialize))))))

;; The name of kernel.sub's linklet among names: the one of the module
;; whose stem is kernel.
(define (kernel-linklet [names datum]) -> datum
  (while (pair? names)
    (let ([n (car names)])
      (when (and (> (string-length n) 7) (== (memcmp (string-bytes n) "kernel." 7) 0)) (return n)))
    (set! names (cdr names)))
  0)

;; The bytes of the running build's linklet named name.
(define (running-bytes [name datum]) -> datum
  (let ([bytes (file-string (string-append-2 running-directory (string-append-2 `"/" (string-append-2 name `".wasm"))))])
    (when (== bytes 0) (fail-at 0 "cannot read the running compiler's linklet ~a" (list1 name)))
    bytes))

;; Is name one of the running build's linklets?
(define (running-linklet? [name datum]) -> i32
  (and (!= running-names 0) (!= (member name running-names) 0)))

;; The kernel module's function named name.
(define (kernel-function [name datum]) -> datum
  (ensure-kernel!)
  (let ([p (assq name (-> (unit-of kernel) provides))])
    (unless (and (!= p 0) (== (car (cdr p)) (sym func))) (fail-at 0 "internal: the kernel module has no function ~a" (list1 name)))
    (cadr (cdr p))))

;; Returns the memory or table declaration (`kind` says which) that a
;; linklet at `phase` gets when its module declares none: an import of the
;; running kernel module's memory or table. Returns 0 if there is none.
;;
;; This applies to compile-time code (phase 1 and above), and to a
;; session's code at any phase, provided the compiler was told where the
;; build that is running it is (running-directory).
(define (running-storage [kind datum] [phase i32]) -> datum
  (if (or (and (== phase 0) (not (in-session?))) (== running-directory 0))
      0
      (begin
        (ensure-kernel!)
        `(,(if (== kind (sym memory)) (sym memory-import) (sym table-import)) ,kernel-instance))))

;; ==== bindings ====

(define (slot-key [symbol datum] [slot u32]) -> u64 (bit-or (<< (cast u64 symbol) 32) slot))

;; The scope a binding with these scopes is kept under.
(define (binding-slot [scopes (ptr scope-set)]) -> u32
  (if (== (-> scopes count) 0) none-slot (@ (-> scopes ids) 0)))

;; The bindings of sym kept under scope slot.
(define (bindings-under [sym datum] [slot u32]) -> (ptr binding)
  (cast (ptr binding) (hash-ref (& bindings) (slot-key sym slot))))

;; Bind sym with these scopes at phase to meaning: the binding.
(define (bind-raw! [sym datum] [scopes (ptr scope-set)] [phase i32] [meaning datum]) -> (ptr binding)
  (let ([b (cast (ptr binding) (alloc-in (& run-arena) (sizeof binding)))] [k (slot-key sym (binding-slot scopes))])
    (set! (-> b scopes) scopes)
    (set! (-> b phase) phase)
    (set! (-> b namespace) (meaning-namespace meaning))
    (set! (-> b key) (keep (fresh-key!)))
    (set! (-> b meaning) (keep meaning))
    (set! (-> b next) (cast (ptr binding) (hash-ref (& bindings) k)))
    (hash-set! (& bindings) k (cast u32 b))
    b))

;; A module-level binding of the current module: recorded, so that a
;; module requiring this one at a phase shift can install a shifted copy.
(define (bind-module-level! [sym datum] [scopes (ptr scope-set)] [phase i32] [meaning datum]) -> (ptr binding)
  (let ([b (bind-raw! sym scopes phase meaning)])
    (when (!= current 0)
      (let ([e (cast (ptr module-entry) (alloc-in (& run-arena) (sizeof module-entry)))] [m (the-module)])
        (set! (-> e symbol) sym)
        (set! (-> e scopes) scopes)
        (set! (-> e phase) phase)
        (set! (-> e binding) b)
        (set! (-> e next) (-> m entries))
        (set! (-> m entries) e)))
    b))

(define (bind! [id datum] [phase i32] [meaning datum]) -> (ptr binding)
  (bind-raw! (syntax-e id) (syntax-scopes id) phase meaning))

(define (check-unbound! [id datum] [phase i32] [meaning datum])
  (let ([b (bindings-under (syntax-e id) (binding-slot (syntax-scopes id)))])
    (while (!= b 0)
      (when (and (== (-> b phase) phase) (== (-> b scopes) (syntax-scopes id))
                 (== (-> b namespace) (meaning-namespace meaning))
                 (not (equal? (-> b meaning) meaning)))
        (fail-at id "~a is already bound~a"
                 `(,(syntax-e id) ,(if (> phase 0) (format-message " at phase ~a" (list1 (make-integer phase))) `""))))
      (set! b (-> b next)))))

;; Bind a module-level definition. Use-site scopes come off the name, so a
;; definition a macro makes from its input is visible to the rest of the
;; module (spec 6.2). A second binding of the same name with the same
;; scopes at the same phase is an error, except that a definition shadows
;; what require-unqualified imports (spec 3.1).
(define (bind-definition! [id0 datum] [phase i32] [meaning datum]) -> (ptr binding)
  (let ([id id0] [uses (-> current use-site-scopes)])
    (while (pair? uses)
      (set! id (remove-scope id (cast u32 (integer-value (car uses)))))
      (set! uses (cdr uses)))
    (set! id (session-binding-id id phase meaning))
    (shadow-import! id phase meaning)
    (check-unbound! id phase meaning)
    (bind-module-level! (syntax-e id) (syntax-scopes id) phase meaning)))

;; A definition shadows a binding require-unqualified made with the same
;; name, scopes, phase and namespace: that binding goes, here and in the
;; module's recorded entries (spec 3.1). It is an error if a macro use in
;; this module already relied on it.
(define (shadow-import! [id datum] [phase i32] [meaning datum])
  (let* ([k (slot-key (syntax-e id) (binding-slot (syntax-scopes id)))]
         [b (cast (ptr binding) (hash-ref (& bindings) k))]
         [before (ptr binding) 0])
    (while (!= b 0)
      (when (and (== (-> b phase) phase) (== (-> b scopes) (syntax-scopes id))
                 (== (-> b namespace) (meaning-namespace meaning))
                 (!= (hash-ref (& unqualified-imports) (cast u64 b)) 0))
        (when (== (hash-ref (& unqualified-imports) (cast u64 b)) 2)
          (fail-at id "~a is defined here, but a macro use before this definition used the ~a it imports"
                   `(,(syntax-e id) ,(syntax-e id))))
        (hash-set! (& unqualified-imports) (cast u64 b) 3)
        (if (== before 0) (hash-set! (& bindings) k (cast u32 (-> b next))) (set! (-> before next) (-> b next)))
        (remove-entry! b)
        (return))
      (set! before b)
      (set! b (-> b next)))))

;; Binding b out of the current module's entries.
(define (remove-entry! [b (ptr binding)])
  (let* ([m (the-module)] [e (-> m entries)] [before (ptr module-entry) 0])
    (while (!= e 0)
      (when (== (-> e binding) b)
        (if (== before 0) (set! (-> m entries) (-> e next)) (set! (-> before next) (-> e next)))
        (return))
      (set! before e)
      (set! e (-> e next)))))

(define (phase-matches? [b (ptr binding)] [phase i32]) -> i32
  (or (== (-> b phase) all-phases) (== (-> b phase) phase)))

;; Can an identifier with scopes refer to binding b at phase in namespace
;; ns?
(define (candidate? [b (ptr binding)] [phase i32] [ns datum] [scopes (ptr scope-set)]) -> i32
  (and (phase-matches? b phase) (== (-> b namespace) ns) (scopes-subset? (-> b scopes) scopes)))

;; The binding id refers to at phase in namespace ns, or 0 if unbound. A
;; binding whose scopes are a subset of id's is kept under one of id's
;; scopes, or none-slot, so only those are candidates: those of the empty
;; set first, then under each of id's scopes in turn. The best has the
;; most scopes, the first of those; every other must have a subset of its
;; scopes, and not the same ones with another meaning.
(define (resolve [id datum] [phase i32] [ns datum]) -> (ptr binding)
  (let* ([scopes (syntax-scopes id)] [sym (syntax-e id)] [best (ptr binding) 0] [count u32 0] [b (ptr binding) 0])
    (for ([i -1]) (< i (cast i32 (-> scopes count))) (+= i 1)
      (set! b (bindings-under sym (if (< i 0) none-slot (@ (-> scopes ids) i))))
      (while (!= b 0)
        (when (candidate? b phase ns scopes)
          (+= count 1)
          (when (or (== best 0) (> (-> b scopes count) (-> best scopes count))) (set! best b)))
        (set! b (-> b next))))
    (when (> count 1)
      (for ([i -1]) (< i (cast i32 (-> scopes count))) (+= i 1)
        (set! b (bindings-under sym (if (< i 0) none-slot (@ (-> scopes ids) i))))
        (while (!= b 0)
          (when (and (candidate? b phase ns scopes)
                     (or (not (scopes-subset? (-> b scopes) (-> best scopes)))
                         (and (!= b best) (== (-> b scopes) (-> best scopes)) (not (equal? (-> b meaning) (-> best meaning))))))
            (fail-at id "identifier ~a is ambiguous" (list1 sym)))
          (set! b (-> b next)))))
    best))

;; What id means at phase in the value namespace, or #f. Only type
;; positions (parse-heap, type-of) look in the type namespace, with
;; type-meaning-of.
(define (meaning-of [id datum] [phase i32]) -> datum
  (let ([b (resolve id phase (sym value))]) (if (== b 0) 0 (-> b meaning))))

(define (type-meaning-of [id datum] [phase i32]) -> datum
  (let ([b (resolve id phase (sym type))]) (if (== b 0) 0 (-> b meaning))))

;; Is id bound to the core form name?
(define (core-id? [id datum] [name datum] [phase i32]) -> i32
  (and (identifier? id)
       (let ([m (meaning-of id phase)])
         (and (!= m 0) (== (car m) (sym core)) (== (cadr m) name)))))

(define (internal-name? [sym datum]) -> i32 (== (@ (symbol-bytes sym) 0) #\%))

;; Core forms and primitive operators, at every phase (spec 5.5). Nothing
;; else is bound until a module requires it.
(define (install-base!)
  (unless base-installed
    (set! base-installed 1)
    (for-each (lambda ([name datum]) (bind-raw! name core-scopes all-phases `(core ,name))) core-forms)
    (for-each (lambda ([name datum]) (bind-raw! name core-scopes all-phases `(prim ,name))) (prim-names))
    ;; The kernel module's queries are answered here from now on.
    (set-queries! query-local-value query-free-identifier=? query-binding-kind query-local-expand query-lift
                  query-function-signature query-introduce query-local-facts query-identifier-name query-name-identifier)))

;; ---- phase shifting ----

;; A pair of a record and a phase shift, as a table's key.
(define (shift-key [d datum] [k u32]) -> u64 (bit-or (<< (cast u64 d) 32) k))

;; A meaning as seen k phases up: its linklet instances move by the phase
;; shift. Shifted infos are cached so each is one record.
(define shifted-infos hash-table)           ; (info . k) -> info

(define (shift-instance [inst datum] [k u32]) -> datum
  (let ([r (if (string? inst) (linklet-ref inst) 0)])
    (if (!= r 0)
        (linklet-name (car r) (cast i32 (integer-value (cadr r))) (+ (cast i32 (integer-value (caddr r))) (cast i32 k)))
        inst)))

(define (shift-info [info datum] [k u32]) -> datum
  (if (or (== k 0) (kernel-definition? info))
      info
      (let ([hit (cast datum (hash-ref (& shifted-infos) (shift-key info k)))] [new datum 0] [o datum 0])
        (if (!= hit 0)
            hit
            (begin
              (set! new (cond [(func-info? info)
                               (func-info (func-info-name info) (func-info-params info) (func-info-results info)
                                          (shift-instance (func-info-instance info) k) (func-info-export info) (func-info-type info))]
                              [(global-info? info)
                               (global-info (global-info-name info) (global-info-type info) (global-info-mutable? info)
                                            (shift-instance (global-info-instance info) k) (global-info-export info))]
                              [(tag-info? info)
                               (tag-info (tag-info-name info) (tag-info-params info) (shift-instance (tag-info-instance info) k)
                                         (tag-info-export info))]
                              [else info]))
              (hash-set! (& shifted-infos) (shift-key info k) (cast u32 new))
              (set! o (cast datum (hash-ref (& shift-origins) (cast u64 info))))
              (hash-set! (& shift-origins) (cast u64 new)
                         (cast u32 (keep (if (!= o 0) (cons (car o) (make-integer (+ (integer-value (cdr o)) k))) (cons info (make-integer k))))))
              new)))))

;; A shifted info -> (info . k): the unshifted info it is a copy of, at
;; phase shift k.
(define shift-origins hash-table)

(define (shift-meaning [meaning datum] [k u32]) -> datum
  (if (and (!= meaning 0) (!= (memq (car meaning) `(func global compile-time-value tag)) 0))
      `(,(car meaning) ,(shift-info (cadr meaning) k))
      meaning))

;; The unshifted info that info is, or is a copy of.
(define (base-info [info datum]) -> datum
  (let ([o (cast datum (hash-ref (& shift-origins) (cast u64 info)))]) (if (!= o 0) (car o) info)))

;; The phase shift of info from its base-info.
(define (info-shift [info datum]) -> u32
  (let ([o (cast datum (hash-ref (& shift-origins) (cast u64 info)))]) (if (!= o 0) (cast u32 (integer-value (cdr o))) 0)))

;; A module's scope at phase shift s (spec 6.1). A module used at two phase
;; shifts has bindings at the same phase from both; giving each phase
;; shift its own copy of the module scope keeps them apart. Phase shift 0
;; uses the module scope itself.
(define shifted-scopes hash-table)          ; (module . shift) -> scope

(define (module-scope-at [m datum] [s u32]) -> u32
  (if (== s 0)
      (-> (unit-of m) scope)
      (let ([sc (hash-ref (& shifted-scopes) (shift-key m s))])
        (when (== sc 0)
          (set! sc (new-run-scope!))
          (hash-set! (& shifted-scopes) (shift-key m s) sc)
          (hash-set! (& module-scope-origins) (scope-key sc) (cast u32 (keep (cons m (make-integer s))))))
        sc)))

;; Every module scope, and its copies, as scope -> (module . shift).
(define module-scope-origins hash-table)
(define (scope-key [sc u32]) -> u64 (bit-or (<< (cast u64 1) 32) sc))
(define (scope-origin [sc u32]) -> datum (cast datum (hash-ref (& module-scope-origins) (scope-key sc))))

;; Scope set scopes at phase shift s: each module scope in it, some
;; module's copy for a phase shift, becomes that module's copy for the
;; shift + s (spec 6.1). A definition a macro from another module made can
;; carry that module's scopes.
(define (shift-scopes [scopes (ptr scope-set)] [s u32]) -> (ptr scope-set)
  (let ([out scopes] [origin datum 0])
    (for ([i u32 0]) (< i (-> scopes count)) (+= i 1)
      (set! origin (scope-origin (@ (-> scopes ids) i)))
      (when (!= origin 0)
        (set! out (scopes-change (scopes-change out (@ (-> scopes ids) i) 1)
                                 (module-scope-at (car origin) (+ (cast u32 (integer-value (cdr origin))) s)) 0))))
    out))

;; Make module m's bindings resolvable at phase shift s, and those of the
;; modules it requires. Needed for m's macros: their templates carry m's
;; scopes.
(define installed hash-table)               ; (module . shift) -> 1

(define (install-module-bindings! [m datum] [s u32])
  (when (== (hash-ref (& installed) (shift-key m s)) 0)
    (hash-set! (& installed) (shift-key m s) 1)
    (unless (== s 0)
      (let ([entries nil] [e (-> (unit-of m) entries)])
        (while (!= e 0)
          (set! entries (cons (cast datum e) entries))
          (set! e (-> e next)))
        (while (pair? entries)
          (let ([e (cast (ptr module-entry) (car entries))])
            (bind-raw! (-> e symbol) (shift-scopes (-> e scopes) s) (+ (-> e phase) (cast i32 s))
                       (shift-meaning (-> e binding meaning) s)))
          (set! entries (cdr entries)))))
    (let ([rs (-> (unit-of m) requires)])
      (while (pair? rs)
        (install-module-bindings! (car (car rs)) (+ s (cast u32 (integer-value (cdr (car rs))))))
        (set! rs (cdr rs))))))

;; ==== modules ====

;; path without its . and .. segments, absolute.
(define package-root datum 0)
(define (set-package-root! [dir datum]) (set! package-root (keep dir)))

(define (string-append-2 [a datum] [b datum]) -> datum
  (let ([buf (make-buffer)] [s datum 0])
    (buffer-add! (& buf) (string-bytes a) (string-length a))
    (buffer-add! (& buf) (string-bytes b) (string-length b))
    (set! s (bytes->string (-> buf bytes) (-> buf length)))
    (buffer-free! (& buf))
    s))

(define (substring [s datum] [from u32] [to u32]) -> datum (bytes->string (+ (string-bytes s) from) (- to from)))

(define (absolute-path? [p datum]) -> i32 (and (> (string-length p) 0) (== (@ (string-bytes p) 0) #\/)))

;; The name of the file at path p, which names the module in it and which
;; its source locations carry (spec 3.6), as Racket names a module: p
;; completed from the package root and its . and .. segments resolved,
;; then relative to the package root if it is in it, and absolute if not.
;; So a file has one name however a require spells it. Symbolic links are
;; not resolved. The root may be relative, to the working directory, as
;; in tests.
(define (package-directory) -> datum (if (!= package-root 0) package-root repository-root))

(define (canonical-path [p datum]) -> datum
  (let* ([root (resolve-segments (package-directory))]
         [full (resolve-segments (if (absolute-path? p) p (string-append-2 root (string-append-2 `"/" p))))]
         [n (+ (string-length root) 1)])
    (if (and (> (string-length full) n) (== (memcmp (string-bytes full) (string-bytes root) (- n 1)) 0)
             (== (@ (string-bytes full) (- n 1)) #\/))
        (substring full n (string-length full))
        full)))

;; Path p with its . and .. segments resolved: absolute if p is, else
;; with the .. segments that go above where it starts first.
(define (resolve-segments [p datum]) -> datum
  (let ([kept nil] [bytes (string-bytes p)] [n (string-length p)] [start u32 0] [out (make-buffer)] [s datum 0]
        [absolute (absolute-path? p)])
    (for ([i u32 0]) (<= i n) (+= i 1)
      (when (or (== i n) (== (@ bytes i) #\/))
        (let ([seg (substring p start i)])
          (cond [(or (== i start) (and (== (- i start) 1) (== (@ bytes start) #\.))) 0]
                [(and (== (- i start) 2) (== (@ bytes start) #\.) (== (@ bytes (+ start 1)) #\.))
                 (cond [(and (pair? kept) (not (string=? (car kept) `".."))) (set! kept (cdr kept))]
                       [(not absolute) (set! kept (cons seg kept))])]
                [else (set! kept (cons seg kept))]))
        (set! start (+ i 1))))
    (set! kept (reverse kept))
    (while (pair? kept)
      (when (or absolute (> (-> out length) 0)) (buffer-add-byte! (& out) #\/))
      (buffer-add! (& out) (string-bytes (car kept)) (string-length (car kept)))
      (set! kept (cdr kept)))
    (set! s (bytes->string (-> out bytes) (-> out length)))
    (buffer-free! (& out))
    s))

;; The byte index of the last byte b in string s, or -1.
(define (last-byte-index [s datum] [b i32]) -> i32
  (let ([i (- (cast i32 (string-length s)) 1)])
    (while (>= i 0)
      (when (== (@ (string-bytes s) i) b) (return i))
      (-= i 1))
    -1))

(define (directory-of [path datum]) -> datum
  (let ([slash (last-byte-index path #\/)])
    (if (>= slash 0) (substring path 0 (+ slash 1)) `"")))

;; A module's name while it is expanded, for its compile-time linklets:
;; its stem, numbered to be unique in this run.
(define provisional-names hash-table)

(define (provisional-name [path datum]) -> datum
  (let ([stem (file-stem path)] [n i64 1] [name datum 0])
    (while 1
      (set! name (if (== n 1) stem (format-message "~a-~a" `(,stem ,(make-integer n)))))
      (when (== (hash-ref (& provisional-names) (cast u64 (string->symbol name))) 0)
        (hash-set! (& provisional-names) (cast u64 (string->symbol name)) 1)
        (return name))
      (+= n 1))))

;; The stem of the file name at path: its letters, digits, - and _, each
;; other character made _.
(define (file-stem [path datum]) -> datum
  (let* ([slash (last-byte-index path #\/)]
         [base (if (>= slash 0) (substring path (+ slash 1) (string-length path)) path)]
         [dot (last-byte-index base #\.)]
         [stem (if (>= dot 0) (substring base 0 dot) base)]
         [out (make-buffer)] [bytes (string-bytes stem)] [i u32 0] [s datum 0])
    ;; Each character, of one byte or more, is kept if it is one of those,
    ;; and is otherwise one _.
    (while (< i (string-length stem))
      (let ([b (@ bytes i)])
        (cond [(or (and (>= b #\a) (<= b #\z)) (and (>= b #\A) (<= b #\Z)) (and (>= b #\0) (<= b #\9)) (== b #\-) (== b #\_))
               (buffer-add-byte! (& out) b)
               (+= i 1)]
              [else
               (buffer-add-byte! (& out) #\_)
               (+= i 1)
               (while (and (< i (string-length stem)) (== (bit-and (@ bytes i) 192) 128)) (+= i 1))])))
    (set! s (bytes->string (-> out bytes) (-> out length)))
    (buffer-free! (& out))
    s))

;; A hash of the strings in list ss, as 12 hexadecimal digits: 64-bit
;; FNV-1a over their bytes, each string followed by a zero byte, keeping
;; the top 48 bits.
(define (content-hash [ss datum]) -> datum
  (let ([h u64 14695981039346656037] [digits (array u8 12)])
    (while (pair? ss)
      (let ([p (string-bytes (car ss))])
        (for ([i u32 0]) (< i (string-length (car ss))) (+= i 1)
          (set! h (* (bit-xor h (@ p i)) 1099511628211))))
      ;; The zero byte after the string: xor with it changes nothing.
      (set! h (* h 1099511628211))
      (set! ss (cdr ss)))
    (for ([k 0]) (< k 12) (+= k 1)
      (let ([d (cast i32 (bit-and (>> h (- 60 (* k 4))) 15))])
        (set! (@ digits k) (if (< d 10) (+ 48 d) (+ 87 d)))))
    (bytes->string digits 12)))

;; The hash that is a module's identity once it is expanded: of its path,
;; which its source locations name (spec 3.6), its source text, and the
;; hashes of the modules it requires, at the phase shifts it requires
;; them, each (hash shift) (spec 3.2). Modules with the same hash are the
;; same module, the same bytes.
(define (module-hash [path datum] [text datum] [requires datum]) -> datum
  (let ([parts `(,path ,text)])
    (while (pair? requires)
      (set! parts (append parts `(,(car (car requires)) ,(format-message "~a" (list1 (cadr (car requires)))))))
      (set! requires (cdr requires)))
    (content-hash parts)))

;; The file at a module's path, which is the package root's if relative.
(define (package-file [path datum]) -> datum
  (if (absolute-path? path) path (string-append-2 (package-directory) (string-append-2 `"/" path))))

;; The text of file, a string; or a compile error if there is none, which
;; names it path.
(define (source-text [file datum] [path datum]) -> datum
  (let* ([name (make-buffer)] [n u32 0] [p (ptr u8) 0] [s datum 0])
    (buffer-add! (& name) (string-bytes file) (string-length file))
    (buffer-add-byte! (& name) 0)
    (set! p (read-file-bytes (-> name bytes) (& n)))
    (buffer-free! (& name))
    (when (== p 0) (fail-at 0 "no module file ~a" (list1 path)))
    (set! s (bytes->string p n))
    (free p)
    s))

;; Compile the module in file source (and, first, what it requires), or
;; load it from the cache. Returns the module. Each module is compiled
;; once per run.
(define (compile-module-file [source datum]) -> datum
  (let* ([path (canonical-path source)] [key (cast u64 (string->symbol path))]
         [known (cast datum (hash-ref (& registry) key))] [cached datum 0])
    (cond [(and (!= known 0) (== (-> (unit-of known) state) (sym done))) known]
          [(!= known 0) (fail-at 0 "cyclic require: ~a requires itself" (list1 path))]
          [(begin (set! cached (load-cached path)) (!= cached 0)) cached]
          [else
           (let* ([text (source-text (package-file path) path)] [m (new-unit path (provisional-name path))] [saved current])
             (hash-set! (& registry) key (cast u32 m))
             (set! compiling (keep-cons (string->symbol path) compiling))
             (begin-module-arena)
             (set! current (new-comp m))
             (set! (-> (unit-of m) code) (expand-module-body (read-all (string-bytes text) (string-length text) (string->symbol path)) 0))
             (finish-module! text)
             (set! current saved)
             (end-module-arena)
             (set! compiling (cdr compiling))
             m)])))

;; The modules that are being compiled right now, innermost first, as a
;; list of their paths (symbols). If an error interrupts a session input
;; while modules it required are half compiled, session-recover! uses this
;; list to forget them.
(define compiling datum nil)

;; The fully expanded phase-0 forms of the module in file source (spec
;; 6.4), for sub expand: it is expanded, and what it requires compiled,
;; but it is not compiled itself. Each form is given to f, while the forms
;; last.
(define (expand-module-file [source datum] [f (closure (datum))])
  (let ([path (canonical-path source)])
    (let* ([text (source-text (package-file path) path)] [m (new-unit path (provisional-name path))])
      (hash-set! (& registry) (cast u64 (string->symbol path)) (cast u32 m))
      (begin-module-arena)
      (set! current (new-comp m))
      (let ([forms (expand-module-body (read-all (string-bytes text) (string-length text) (string->symbol path)) 1)])
        (while (pair? forms)
          (f (car forms))
          (set! forms (cdr forms))))
      (end-module-arena))))

;; Expand a module body at phase 0. The result is its lowered code, or,
;; syntax being 1, its fully expanded code (spec 6.4).
(define (expand-module-body [forms datum] [syntax i32]) -> datum
  (install-base!)
  (let ([msc (new-scope!)] [saved to-syntax] [out datum 0])
    (set! (-> (the-module) scope) msc)
    (hash-set! (& module-scope-origins) (scope-key msc) (cast u32 (keep (cons (-> (the-module) self) (make-integer 0)))))
    (set! to-syntax syntax)
    (set! out (expand-body (map (lambda ([f datum]) -> datum (add-scope (add-scope f core-scope) msc)) forms) 0))
    (set! to-syntax saved)
    out))

;; Take the phase-0 code, resolve provides, take the module's hash and
;; name, and compile the linklets.
(define (finish-module! [text datum])
  (let ([m (the-module)] [items (reverse (-> current provide-ids))] [provides nil])
    (add-phase-forms! 0 (-> m code))
    ;; A provided name exports its binding in each namespace it has one.
    (while (pair? items)
      (let* ([item (car items)] [id (cdr item)]
             [v (meaning-of id 0)]
             [value (if (and (!= v 0) (!= (memq (car v) `(func global compile-time-value data tag)) 0)) v 0)]
             [t (type-meaning-of id 0)])
        (when (and (== t 0) (== value 0))
          (fail-at id "cannot provide ~a: it is not a module-level binding" (list1 (syntax-e id))))
        (when (!= t 0) (set! provides (cons (cons (syntax-e (car item)) t) provides)))
        (when (!= value 0) (set! provides (cons (cons (syntax-e (car item)) value) provides))))
      (set! items (cdr items)))
    (set! (-> m provides) (keep (reverse provides)))
    ;; Its requires known, the module takes its hash, and the name its
    ;; instance names start with: its stem and hash.
    (set! (-> m hash) (keep (module-hash (-> m path) text
                                         (map (lambda ([r datum]) -> datum `(,(-> (unit-of (car r)) hash) ,(cdr r)))
                                              (-> m requires)))))
    (set! (-> m name) (keep (format-message "~a.~a" `(,(file-stem (-> m path)) ,(-> m hash)))))
    (when (== (hash-ref (& units-by-hash) (cast u64 (string->symbol (-> m hash)))) 0)
      (hash-set! (& units-by-hash) (cast u64 (string->symbol (-> m hash))) (cast u32 (-> m self))))
    (compile-linklets!)))

;; ---- linklets ----

;; The memory and table forms declared for phase (spec 3.3).
(define (storage-forms [phase i32]) -> datum
  (let ([mem (storage-form (sym memory) phase)] [tbl (storage-form (sym table) phase)])
    (append (if (!= mem 0) (list1 mem) nil) (if (!= tbl 0) (list1 tbl) nil))))

;; The memory or table form, kind, declared for phase, or else the running
;; kernel module's at phase 1 and above; or #f.
(define (storage-form [kind datum] [phase i32]) -> datum
  (let ([f (assoc (make-integer phase) (if (== kind (sym memory)) (-> current memories) (-> current tables)))])
    (if (!= f 0) (cdr f) (running-storage kind phase))))

;; Rejects a `data` form in code that would share the running compiler's
;; memory: the data would overwrite whatever the compiler has at that
;; address. That is the case for compile-time code (phase 1 and above) and
;; for a session's code at any phase, unless the module declares a memory
;; of its own for that phase.
(define (check-phase-data! [forms datum] [phase i32] [where datum])
  (when (and (or (> phase 0) (in-session?)) (== (assoc (make-integer phase) (-> current memories)) 0))
    (while (pair? forms)
      (when (== (car (car forms)) (sym data))
        (fail-at where "data at phase ~a needs a memory of its own, which compile-time code shares with the compiler otherwise: add (memory pages)"
                 (list1 (make-integer phase))))
      (set! forms (cdr forms)))))

;; Module m's phase linklet, as compile-module gave it: (bytes imports
;; gc? scopes), kept.
(define (add-linklet! [m datum] [phase i32] [compiled datum])
  (let ([l (cast (ptr linklet) (alloc-in (& run-arena) (sizeof linklet)))] [u (unit-of m)])
    (set! (-> l phase) phase)
    (set! (-> l bytes) (keep (car compiled)))
    (set! (-> l imports) (keep (cadr compiled)))
    (set! (-> l gc) (!= (caddr compiled) 0))
    (set! (-> l scopes) (keep (cadddr compiled)))
    (set! (-> l next) (-> u linklets))
    (set! (-> u linklets) l)))

;; Module m's linklet of phase, or 0.
(define (linklet-of [m datum] [phase i32]) -> (ptr linklet)
  (let ([l (-> (unit-of m) linklets)])
    (while (and (!= l 0) (!= (-> l phase) phase)) (set! l (-> l next)))
    l))

;; Compile the linklet of the module being compiled, its phase 0's; check
;; (freestanding); done.
(define (compile-linklets!)
  (let* ([m (the-module)] [forms datum 0]
         [phases (sort (let ([ps (map (lambda ([e datum]) -> datum (car e)) (-> current phase-forms))])
                         (if (!= (member (make-integer 0) ps) 0) ps (cons (make-integer 0) ps)))
                       (lambda ([a datum] [b datum]) -> i32 (< (integer-value a) (integer-value b))))])
    (while (pair? phases)
      (let* ([p (cast i32 (integer-value (car phases)))] [e (assoc (car phases) (-> current phase-forms))])
        (set! forms (append (storage-forms p) (if (!= e 0) (reverse (cdr e)) nil)))
        (set-current-source! (string->symbol (-> m path)))
        (add-linklet! (-> m self) p (compile-module forms (linklet-name (-> m self) p 0)))
        (set! (-> m memories) (keep-cons (cons (make-integer p) (storage-form (sym memory) p)) (-> m memories)))
        (note-definitions! (-> m self) forms))
      (set! phases (cdr phases)))
    ;; Its functions' values, resolved now for its interface (5.2).
    (for-each (lambda ([f datum]) (when (and (func-info? f) (has-value? f)) (function-value f))) (-> m infos))
    (hash-set! (& installed) (shift-key (-> m self) 0) 1)
    (set! (-> m state) (sym done))
    (let ([form (-> current freestanding-form)])
      (when (!= form 0) (check-freestanding! (-> m self) form)))
    (set! (-> m code) 0)
    (store-cached! (-> m self))))

;; The modules whose linklets a program instantiates at run time: phase 0
;; at phase shift 0, reached through phase-0 requires.
(define (runtime-closure [m datum]) -> datum
  (let ([todo (list1 m)] [seen nil])
    (while (pair? todo)
      (let ([mm (car todo)])
        (set! todo (cdr todo))
        (when (== (memq mm seen) 0)
          (set! seen (cons mm seen))
          (let ([imports (-> (linklet-of mm 0) imports)])
            (while (pair? imports)
              (let ([r (linklet-ref (car imports))])
                (when (and (!= r 0) (== (integer-value (cadr r)) 0) (== (integer-value (caddr r)) 0))
                  (set! todo (append todo (list1 (car r))))))
              (set! imports (cdr imports)))))))
    (reverse seen)))

;; (freestanding): the program's run-time parts import only from the host
;; and each other, and use no GC (spec 3.4).
(define (check-freestanding! [m datum] [form datum])
  (let ([ms (runtime-closure m)])
    (while (pair? ms)
      (let* ([mm (car ms)] [p (linklet-of mm 0)] [extra nil] [imports (-> p imports)])
        ;; The kernel module's instance is named kernel here, as the old
        ;; compiler's is.
        (while (pair? imports)
          (unless (or (string=? (car imports) `"host") (!= (linklet-ref (car imports)) 0))
            (set! extra (cons (if (and (!= kernel-instance 0) (string=? (car imports) kernel-instance)) `"kernel" (car imports))
                              extra)))
          (set! imports (cdr imports)))
        (set! extra (reverse extra))
        (unless (and (null? extra) (not (-> p gc)))
          (fail-at form "this module is declared freestanding, but after expansion ~a ~a"
                   `(,(if (== mm m) `"it" (format-message "the module ~a it requires" (list1 (-> (unit-of mm) name))))
                     ,(if (pair? extra) (format-message "imports from ~a" (list1 extra)) `"uses GC objects")))))
      (set! ms (cdr ms)))))

;; The linklets m's program instantiates at run time, each after those it
;; imports from, as (instance-name . bytes): phase-0 linklets at phase
;; shift 0, and the running build's linklets of the kernel module if they
;; use it. m's own comes last. A linklet compiled in this run is taken
;; over the running build's of the same name, the same module's (spec
;; 3.2), so that when the compiler builds itself, its program is the bytes
;; it compiled.
(define (program-linklets [m datum]) -> datum
  (let ([seen (make-table)] [out nil])
    (set! out (visit-linklets m seen out))
    (reverse out)))

(define (visit-linklets [m datum] [seen (ptr arena-table)] [out datum]) -> datum
  (let ([name (linklet-name m 0 0)])
    (when (!= (datum-get seen name) 0) (return out))
    (datum-put! seen name (boolean 1))
    (let* ([p (linklet-of m 0)] [imports (-> p imports)])
      (while (pair? imports)
        (set! out (visit-import (car imports) seen out))
        (set! imports (cdr imports)))
      (cons (cons name (-> p bytes)) out))))

;; The linklets of a program that an import imp names: a module's
;; compiled in this run, or else the running build's.
(define (visit-import [imp datum] [seen (ptr arena-table)] [out datum]) -> datum
  (let ([l (linklet-ref imp)])
    (cond [(!= l 0)
           (unless (and (== (integer-value (cadr l)) 0) (== (integer-value (caddr l)) 0))
             (fail-at 0 "internal: a program imports from ~a" (list1 imp)))
           (visit-linklets (car l) seen out)]
          [(running-linklet? imp) (visit-running imp seen out)]
          [else out])))

;; The running build's linklet named name, a linklet of the kernel module,
;; after the linklets it imports from.
(define (visit-running [name datum] [seen (ptr arena-table)] [out datum]) -> datum
  (when (!= (datum-get seen name) 0) (return out))
  (datum-put! seen name (boolean 1))
  (let* ([bytes (running-bytes name)] [imports (linklet-imports (string-bytes bytes) (string-length bytes))])
    (while (pair? imports)
      (set! out (visit-import (car imports) seen out))
      (set! imports (cdr imports)))
    (cons (cons name bytes) out)))

;; (phase . bytes) for each linklet of m, in phase order.
(define (module-linklet-list [m datum]) -> datum
  (let ([l (-> (unit-of m) linklets)] [out nil])
    (while (!= l 0)
      (set! out (cons (cons (make-integer (-> l phase)) (-> l bytes)) out))
      (set! l (-> l next)))
    (sort out (lambda ([a datum] [b datum]) -> i32 (< (integer-value (car a)) (integer-value (car b)))))))

;; ==== the cache ====
;;
;; With a cache directory (build -c DIR), a module that was compiled once
;; is loaded from the cache for as long as its source and its requires are
;; unchanged (spec 3.7). What is cached is the module's interface: what
;; the expander keeps of a compiled module, with its linklets inside, as
;; quoted data in the kernel's format (spec 3.5). An interface starts with
;; what it was built from: the interface format, the compiler, and the
;; module and its requires, by hash. The compiler is identified by the
;; names of its build's linklets, which carry the hashes of its modules
;; (spec 3.2). So any change to the compiler invalidates the cache, and
;; the cache needs -r, which names the running build. The cache holds one
;; file per source path (cache-name), which each compilation of the path
;; replaces, so the cache does not grow as sources change.

(define cache-directory datum 0)
(define (set-cache-directory! [dir datum]) (set! cache-directory (keep dir)))

(define interface-format i64 2)

;; The running compiler, by the hash of its build's linklet names, read
;; with the kernel module (ensure-kernel!).
(define compiler-hash datum 0)

;; The compiler the cache is for, when there is a cache directory and the
;; running build is known; else #f.
(define (cache-compiler) -> datum
  (if (or (== cache-directory 0) (== running-directory 0))
      0
      (begin (ensure-kernel!) compiler-hash)))

(define (cache-file [name datum]) -> datum (string-append-2 cache-directory (string-append-2 `"/" name)))

;; Datum d in the kernel's data format, a string.
(define (data-bytes [d datum]) -> datum
  (let ([s (make-serializer)])
    (serialize! s d)
    (serializer-bytes s)))

;; The datum in the file at path, as data-bytes wrote it: the last of its
;; objects, which serialize! writes after those it is made of; or #f if
;; there is no such file.
(define (read-data [path datum]) -> datum
  (let ([s (file-string path)])
    (if (or (== s 0) (== (string-length s) 0))
        0
        (let ([p (string-bytes s)] [count u64 0] [shift u64 0] [i u32 0] [b u32 128])
          (while (and (!= (bit-and b 128) 0) (< i (string-length s)))
            (set! b (@ p i))
            (+= i 1)
            (set! count (bit-or count (<< (cast u64 (bit-and b 127)) shift)))
            (+= shift 7))
          (if (== count 0) 0 (@ (deserialize p (string-length s)) (cast u32 (- count 1))))))))

;; d written to the file at path: 1, or 0 if it cannot be.
(define (write-data [path datum] [d datum]) -> i32
  (let ([name (make-buffer)] [bytes (data-bytes d)] [ok i32 0])
    (buffer-add! (& name) (string-bytes path) (string-length path))
    (buffer-add-byte! (& name) 0)
    (set! ok (write-file-bytes (-> name bytes) (string-bytes bytes) (string-length bytes)))
    (buffer-free! (& name))
    ok))

;; Section key of interface d.
(define (section [d datum] [key datum]) -> datum (cdr (assq key d)))

;; Is d an interface of this format, by this compiler?
(define (current-interface? [d datum]) -> i32
  (and (pair? d) (!= (assq (sym format) d) 0)
       (equal? (section d (sym format)) (make-integer interface-format))
       (equal? (section d (sym compiler)) compiler-hash)))

;; The module at path, from the cache, if the cache has one for it that
;; is of this format and compiler, and of the source and requires as they
;; are now; else #f. The source is checked first, with the hashes its
;; requires had; then the requires are compiled or loaded in order, as
;; they would be, until one is not as it was. What it reads is in an
;; arena of its own.
(define (load-cached [path datum]) -> datum
  (if (== (cache-compiler) 0)
      0
      (begin
        (begin-module-arena)
        (let ([m (load-cached-in path)])
          (end-module-arena)
          m))))

(define (load-cached-in [path datum]) -> datum
  (let* ([ds (read-data (cache-file (cache-name path)))]
         [d (if (pair? ds) (car ds) 0)]
         [key (cast u64 (string->symbol path))]
         [hash datum 0] [requires datum 0] [known datum 0] [m datum 0])
    (unless (current-interface? d) (return 0))
    (set! hash (section d (sym hash)))
    (set! requires (section d (sym requires)))            ; each (path hash shift)
    (unless (and (string? hash)
                 (string=? (module-hash path (source-text (package-file path) path)
                                        (map (lambda ([r datum]) -> datum (cdr r)) requires))
                           hash))
      (return 0))
    ;; A cycle through the requires is an error, as when compiling.
    (hash-set! (& registry) key (cast u32 (new-unit path path)))
    (while (pair? requires)
      (unless (string=? (-> (unit-of (module-of (car (car requires)))) hash) (cadr (car requires)))
        (hash-set! (& registry) key 0)
        (return 0))
      (set! requires (cdr requires)))
    ;; A module a compiled file brought is the one the run has (3.7).
    (set! known (cast datum (hash-ref (& units-by-hash) (cast u64 (string->symbol hash)))))
    (set! m (if (!= known 0) known (load-compiled-module d path)))
    (hash-set! (& registry) key (cast u32 m))
    m))

;; The module a recorded require names: the module in a file, compiled
;; or loaded as it would be, or the entry of a compiled file.
(define (module-of [spec datum]) -> datum
  (if (pair? spec) (load-compiled-file (cadr spec)) (compile-module-file spec)))

;; Write module m to the cache, in the file for its source path, over
;; whatever was there. A cache that cannot be written is passed over.
(define (store-cached! [m datum])
  (when (!= (cache-compiler) 0)
    (let ([u (unit-of m)])
      (write-data (cache-file (cache-name (-> u path))) (list1 (write-interface m))))))

;; The name of the cache's file for the module at path: one file per
;; source path, so the cache does not grow as sources change.
(define (cache-name [path datum]) -> datum (string-append-2 (content-hash (list1 path)) `".subc"))

;; ---- compiled files ----
;;
;; A compiled file (spec 3.7) holds modules, each as its interface with
;; its linklets inside. Every module comes after the modules it requires,
;; and the entry module is last. A cache file holds one module; build -m
;; writes a program's module and everything it requires to one file, for
;; (require name (compiled file)).

;; The bytes of the compiled file of module m and its requires.
(define (compiled-file-bytes [m datum]) -> datum
  (ensure-kernel!)
  (data-bytes (map (lambda ([x datum]) -> datum (write-interface x)) (module-closure m))))

;; Module m and every module it requires, at any phase shift,
;; transitively, each once, after those it requires.
(define (module-closure [m datum]) -> datum
  (let ([seen (make-table)] [out nil])
    (set! out (closure-visit m seen out))
    (reverse out)))

(define (closure-visit [m datum] [seen (ptr arena-table)] [out datum]) -> datum
  (when (!= (table-ref seen (cast u64 m)) 0) (return out))
  (table-set! seen (cast u64 m) 1)
  (let ([rs (-> (unit-of m) requires)])
    (while (pair? rs)
      (set! out (closure-visit (car (car rs)) seen out))
      (set! rs (cdr rs))))
  (cons m out))

;; The entry of the compiled file at path, its modules loaded in order,
;; but for those this run has made already.
(define (load-compiled-file [path datum]) -> datum
  (ensure-kernel!)
  (begin-module-arena)
  (let ([ds (read-data path)] [entry datum 0])
    (unless (pair? ds) (fail-at 0 "no compiled file ~a" (list1 path)))
    (while (pair? ds)
      (let* ([d (car ds)] [hash (if (and (pair? d) (!= (assq (sym hash) d) 0)) (section d (sym hash)) 0)]
             [known (if (string? hash) (cast datum (hash-ref (& units-by-hash) (cast u64 (string->symbol hash)))) 0)])
        (set! entry (if (!= known 0) known (load-compiled-module d `(compiled ,path ,hash)))))
      (set! ds (cdr ds)))
    (end-module-arena)
    entry))

;; Module d of a compiled file or the cache, loaded, its requires being
;; modules this run has; known by path. It must be of this interface
;; format and compiler.
(define (load-compiled-module [d datum] [path datum]) -> datum
  (unless (and (pair? d) (!= (assq (sym format) d) 0) (equal? (section d (sym format)) (make-integer interface-format)))
    (fail-at 0 "the compiled module ~a is of another interface format" (list1 path)))
  (unless (current-interface? d)
    (fail-at 0 "the compiled module ~a was compiled by another compiler" (list1 path)))
  (let ([m (new-unit path (section d (sym name)))])
    (set! (-> (unit-of m) requires)
          (keep (map (lambda ([r datum]) -> datum
                       (let ([req (cast datum (hash-ref (& units-by-hash) (cast u64 (string->symbol (cadr r)))))])
                         (when (== req 0)
                           (fail-at 0 "the compiled module ~a requires ~a, which is not with it" `(,path ,(cadr r))))
                         (cons req (caddr r))))
                     (section d (sym requires)))))
    (load-module! m d)
    m))

;; ---- interfaces ----
;;
;; An interface is an alist of sections of quoted data; the first three
;; say what it was built from. Scopes and definitions belong to one run of
;; the compiler, so an interface names them relative to modules, by hash:
;;   - a scope is core, kernel-ids, (m hash shift) for a module scope's
;;     copy at a phase shift, or (s hash index) for the index-th scope
;;     that a module's expansion made;
;;   - a type is (%type i), the module's i-th type, (%type hash i), another
;;     module's, or a closure, code or box type described by its contents;
;;   - a definition is (%info own i), the i-th entry of the infos section;
;;     (%info foreign instance kind export), another module's;
;;     (%info kernel kind export), the kernel module's; or
;;     (%info shifted d k), definition d shifted by k phases (spec 6.1);
;;   - a syntax object is (%syntax e scopes srcloc props), where srcloc is
;;     (source line col pos span) or #f.
;; A list that starts with %type, %info, %syntax or %quote as ordinary
;; data gets %quote put in front of it. encode writes these forms, and
;; load-module! reads them back with decode.

;; Each scope a module's expansion made, by its number in the module, and
;; each type it declared, by its number among its types.
(define scope-owners hash-table)            ; scope -> its module
(define scope-numbers hash-table)           ; scope -> its number
(define module-scopes hash-table)           ; (module . number) -> scope
(define type-owners hash-table)             ; type -> its module
(define type-numbers hash-table)            ; type -> its number
(define module-types hash-table)            ; (module . number) -> type

(define (own-scope! [m datum] [sc u32])
  (let ([u (unit-of m)])
    (hash-set! (& scope-owners) (scope-key sc) (cast u32 m))
    (hash-set! (& scope-numbers) (scope-key sc) (-> u scope-count))
    (hash-set! (& module-scopes) (shift-key m (-> u scope-count)) sc)
    (+= (-> u scope-count) 1)))

;; Scope i of module m: made now, if m was loaded from the cache.
(define (unit-scope-at [m datum] [i u32]) -> u32
  (let ([sc (hash-ref (& module-scopes) (shift-key m i))])
    (when (== sc 0)
      (set! sc (new-run-scope!))
      (hash-set! (& scope-owners) (scope-key sc) (cast u32 m))
      (hash-set! (& scope-numbers) (scope-key sc) i)
      (hash-set! (& module-scopes) (shift-key m i) sc))
    sc))

(define (own-type! [m datum] [t datum])
  (when (== (hash-ref (& type-owners) (cast u64 t)) 0)
    (let ([u (unit-of m)])
      (hash-set! (& type-owners) (cast u64 t) (cast u32 m))
      (hash-set! (& type-numbers) (cast u64 t) (-> u type-count))
      (hash-set! (& module-types) (shift-key m (-> u type-count)) (cast u32 t))
      (+= (-> u type-count) 1))))

(define (unit-type [m datum] [i u32]) -> datum (cast datum (hash-ref (& module-types) (shift-key m i))))

(define (unit-type-list [m datum]) -> datum
  (let ([out nil] [n (-> (unit-of m) type-count)])
    (while (> n 0)
      (-= n 1)
      (set! out (cons (unit-type m n) out)))
    out))

(define (unit-with-hash [hash datum]) -> datum
  (let ([m (cast datum (hash-ref (& units-by-hash) (cast u64 (string->symbol hash))))])
    (when (== m 0) (fail-at 0 "the cache is inconsistent: no module ~a" (list1 hash)))
    m))

(define (info-kind [info datum]) -> datum
  (cond [(func-info? info) (sym func)] [(global-info? info) (sym global)] [else (sym tag)]))

(define (info-export [info datum]) -> datum
  (cond [(func-info? info) (func-info-export info)] [(global-info? info) (global-info-export info)] [else (tag-info-export info)]))

;; The definition of kind with export name export in the instance named
;; instance, one of a module's linklets, or #f. A module's definitions
;; are indexed at the first search, by "instance kind export".
(define definition-indexes hash-table)      ; module -> (ptr arena-table)

(define (definition-key [instance datum] [kind datum] [export datum]) -> u64
  (cast u64 (string->symbol (format-message "~a ~a ~a" `(,instance ,kind ,export)))))

(define (find-info [instance datum] [kind datum] [export datum]) -> datum
  (let ([m (instance-unit instance)] [index (ptr arena-table) 0])
    (when (== m 0) (return 0))
    (set! index (cast (ptr arena-table) (hash-ref (& definition-indexes) (cast u64 m))))
    (when (== index 0)
      (let ([saved (use-arena (& run-arena))] [infos (-> (unit-of m) infos)])
        (set! index (make-table))
        (while (pair? infos)
          (let ([info (car infos)])
            (table-set! index (definition-key (info-instance info) (info-kind info) (info-export info)) (cast u32 info)))
          (set! infos (cdr infos)))
        (use-arena saved))
      (hash-set! (& definition-indexes) (cast u64 m) (cast u32 index)))
    (cast datum (table-ref index (definition-key instance kind export)))))

;; The kernel module's definition of kind with export name export.
(define (kernel-definition [kind datum] [export datum]) -> datum
  (ensure-kernel!)
  (let ([p (assq (string->symbol export) (-> (unit-of kernel) provides))])
    (unless (and (!= p 0) (== (car (cdr p)) kind))
      (fail-at 0 "the cache is inconsistent: the kernel module has no ~a ~a" `(,kind ,export)))
    (cadr (cdr p))))

;; ---- writing an interface ----

;; The module whose interface is being written, and its own definitions
;; so far: info -> its number + 1, and the list of them, the latest first.
(define writing datum 0)
(define own-numbers (ptr arena-table) 0)
(define own-list datum 0)
(define own-count u32 0)

(define (write-interface [m datum]) -> datum
  (let ([u (unit-of m)] [infos datum 0] [types (unit-type-list m)])
    (set! writing m)
    (set! own-numbers (make-table))
    (set! own-list nil)
    (set! own-count 0)
    ;; Every definition, in order, before what else is referred to.
    (for-each (lambda ([info datum]) (own-ref info)) (reverse (-> u infos)))
    (let* ([linklets (linklet-forms m)]
           [provides (map (lambda ([p datum]) -> datum (cons (car p) (encode (cdr p)))) (-> u provides))]
           [entries (entry-forms m)]
           [own (reverse (-> u infos))]
           [value-forms (filter-out-false
                    (map (lambda ([f datum]) -> datum
                           (if (and (func-info? f) (has-value? f))
                               (let ([g (function-value f)]) (if (!= g 0) (encode `(,f ,g)) 0))
                               0))
                         own))]
           [inline-forms (filter-out-false
                     (map (lambda ([f datum]) -> datum
                            (let ([b (cast datum (hash-ref (& inlines) (cast u64 f)))])
                              (if (== b 0)
                                  0
                                  (encode `(,f ,(car b) ,(cadr b) ,(caddr b) ,(cadddr b)
                                            ,(map (lambda ([p datum]) -> datum (car p)) (list-ref b 4)) ,(list-ref b 5))))))
                          own))]
           [macro-forms (filter-out-false
                    (map (lambda ([f datum]) -> datum
                           (if (== (cast datum (hash-ref (& macro-modules) (cast u64 f))) m) (encode (list1 f)) 0))
                         own))]
           [type-forms (map (lambda ([t datum]) -> datum
                              `(,(type-info-name t) ,(type-info-kind t) ,(type-info-final? t)
                                ,(encode (type-info-super t)) ,(encode (type-info-fields t))))
                            types)]
           [groups (group-forms types)]
           [fact-forms (map (lambda ([f datum]) -> datum `(,(encode (car f)) ,(cadr f) ,(encode (caddr f))))
                       (reverse (-> u facts)))]
           [require-forms (map (lambda ([r datum]) -> datum
                            `(,(-> (unit-of (car r)) path) ,(-> (unit-of (car r)) hash) ,(cdr r)))
                          (-> u requires))])
      ;; Last, as the other sections may refer to definitions of its own.
      (set! infos (map (lambda ([info datum]) -> datum (encode (info->list info))) (reverse own-list)))
      (set! writing 0)
      `((format . ,(make-integer interface-format)) (compiler . ,compiler-hash) (hash . ,(-> u hash))
        (definitions . ,(make-integer (length (-> u infos)))) (requires . ,require-forms) (name . ,(-> u name))
        (types . ,type-forms) (groups . ,groups) (infos . ,infos) (provides . ,provides) (entries . ,entries)
        (values . ,value-forms) (inlines . ,inline-forms) (macros . ,macro-forms) (facts . ,fact-forms) (linklets . ,linklets)
        (memories . ,(-> u memories))))))

(define (filter-out-false [l datum]) -> datum (filter (lambda ([x datum]) -> i32 (!= x 0)) l))

;; Module m's linklets, in phase order: (phase bytes imports gc? scopes).
(define (linklet-forms [m datum]) -> datum
  (let ([l (-> (unit-of m) linklets)] [out nil])
    (while (!= l 0)
      (set! out (cons `(,(make-integer (-> l phase)) ,(-> l bytes) ,(-> l imports) ,(boolean (-> l gc))
                        ,(map (lambda ([sc datum]) -> datum (scope-ref (cast u32 (integer-value sc)))) (-> l scopes)))
                      out))
      (set! l (-> l next)))
    (sort out (lambda ([a datum] [b datum]) -> i32 (< (integer-value (car a)) (integer-value (car b)))))))

;; Module m's module-level bindings, the oldest first: (symbol scopes
;; phase meaning).
(define (entry-forms [m datum]) -> datum
  (let ([e (-> (unit-of m) entries)] [out nil])
    (while (!= e 0)
      (set! out (cons `(,(-> e symbol) ,(scope-refs (-> e scopes)) ,(make-integer (-> e phase)) ,(encode (-> e binding meaning)))
                      out))
      (set! e (-> e next)))
    out))

;; The recursion groups of types, a module's in order, as lists of their
;; members' numbers; a group's members are consecutive.
(define (group-forms [types datum]) -> datum
  (let ([out nil] [i i64 0] [ts types])
    (while (pair? ts)
      (let ([g (type-info-group (car ts))])
        (if (and (!= g 0) (== (car g) (car ts)))
            (let ([n (length g)] [members nil])
              (for ([k u32 0]) (< k n) (+= k 1) (set! members (cons (make-integer (+ i (cast i64 k))) members)))
              (set! out (cons (reverse members) out))
              (+= i (cast i64 n))
              (set! ts (list-tail ts n)))
            (begin (+= i 1) (set! ts (cdr ts))))))
    (reverse out)))

(define (tag-symbol? [x datum]) -> i32 (or (object-tag? x) (== x (sym %quote))))
(define (object-tag? [x datum]) -> i32 (or (== x (sym %type)) (== x (sym %info)) (== x (sym %syntax))))

;; x with what belongs to the run named relative to modules (above).
(define (encode [x datum]) -> datum
  (cond [(pair? x)
         ;; A list's spine is walked, as encode of its cdr would be.
         (let ([head nil] [last datum 0] [l x] [p datum 0])
           (while (pair? l)
             (set! p (if (tag-symbol? (car l)) `(%quote ,(car l)) (list1 (encode (car l)))))
             (if (== last 0) (set! head p) (set-cdr! last p))
             (set! last (if (pair? (cdr p)) (cdr p) p))
             (set! l (cdr l)))
           (set-cdr! last (encode l))
           head)]
        [(syntax? x)
         `(%syntax ,(encode (syntax-e x)) ,(scope-refs (syntax-scopes x)) ,(srcloc-form (syntax-srcloc x))
                   ,(encode (syntax-props x)))]
        [(type-info? x) (cons (sym %type) (type-ref x))]
        [(or (func-info? x) (global-info? x) (tag-info? x) (data-info? x)) (cons (sym %info) (info-ref x))]
        [else x]))

(define (srcloc-form [l (ptr srcloc)]) -> datum
  (if (== l 0)
      0
      `(,(-> l source) ,(make-integer (-> l line)) ,(make-integer (-> l col)) ,(make-integer (-> l pos))
        ,(make-integer (-> l span)))))

(define (type-ref [t datum]) -> datum
  (let ([owner (cast datum (hash-ref (& type-owners) (cast u64 t)))]
        [i (make-integer (hash-ref (& type-numbers) (cast u64 t)))])
    (cond [(== owner writing) (list1 i)]
          [(!= owner 0) `(,(-> (unit-of owner) hash) ,i)]
          [(!= (box-value-type t) 0) `(box ,(encode (box-value-type t)))]
          [(!= (closure-code t) 0)
           (let ([sig (type-info-fields (closure-code t))])
             `(closure ,(encode (cdr (car sig))) ,(encode (cadr sig))))]
          [(!= (code-closure t) 0) `(code ,(encode (code-closure t)))]
          [else (fail-at 0 "internal: the type ~a belongs to no module" (list1 (type-info-name t))) 0])))

;; The closure type whose code type t is, or #f: its first parameter is
;; the closure.
(define (code-closure [t datum]) -> datum
  (let ([fields (type-info-fields t)])
    (if (and (== (type-info-kind t) (sym func)) (pair? (car fields)) (ref-type? (car (car fields))))
        (let ([c (ref-heap (car (car fields)))])
          (if (and (type-info? c) (== (closure-code c) t)) c 0))
        0)))

(define (info-ref [info datum]) -> datum
  (let ([origin (cast datum (hash-ref (& shift-origins) (cast u64 info)))] [instance (info-instance info)] [owner datum 0])
    (cond [(!= origin 0) `(shifted ,(encode (car origin)) ,(cdr origin))]
          [(kernel-definition? info) `(kernel ,(info-kind info) ,(info-export info))]
          [(data-info? info) (own-ref info)]
          [else
           (set! owner (if (string? instance) (instance-unit instance) 0))
           (if (and (!= owner 0) (!= owner writing))
               `(foreign ,instance ,(info-kind info) ,(info-export info))
               (own-ref info))])))

(define (own-ref [info datum]) -> datum
  (let ([i (table-ref own-numbers (cast u64 info))])
    (when (== i 0)
      (set! own-list (cons info own-list))
      (+= own-count 1)
      (set! i own-count)
      (table-set! own-numbers (cast u64 info) i))
    `(own ,(make-integer (- i 1)))))

;; Definition info as a list, (kind field ...), its fields in the order its
;; constructor takes them; and the definition such a list describes.
(define (info->list [info datum]) -> datum
  (cond [(func-info? info)
         `(func ,(func-info-name info) ,(func-info-params info) ,(func-info-results info) ,(func-info-instance info)
                ,(func-info-export info) ,(func-info-type info))]
        [(global-info? info)
         `(global ,(global-info-name info) ,(global-info-type info) ,(global-info-mutable? info) ,(global-info-instance info)
                  ,(global-info-export info))]
        [(tag-info? info) `(tag ,(tag-info-name info) ,(tag-info-params info) ,(tag-info-instance info) ,(tag-info-export info))]
        [else `(data ,(data-info-name info) ,(data-info-offset info) ,(data-info-bytes info))]))

(define (list->info [l datum]) -> datum
  (case (car l)
    [((sym func)) (func-info (list-ref l 1) (list-ref l 2) (list-ref l 3) (list-ref l 4) (list-ref l 5) (list-ref l 6))]
    [((sym global)) (global-info (list-ref l 1) (list-ref l 2) (list-ref l 3) (list-ref l 4) (list-ref l 5))]
    [((sym tag)) (tag-info (list-ref l 1) (list-ref l 2) (list-ref l 3) (list-ref l 4))]
    [else (data-info (list-ref l 1) (list-ref l 2) (list-ref l 3))]))

(define (scope-ref [sc u32]) -> datum
  (let ([origin (scope-origin sc)] [owner (cast datum (hash-ref (& scope-owners) (scope-key sc)))])
    (cond [(== sc core-scope) (sym core)]
          [(and (!= kernel-id-scopes 0) (== sc (@ (-> kernel-id-scopes ids) 0))) (sym kernel-ids)]
          [(!= origin 0) `(m ,(-> (unit-of (car origin)) hash) ,(cdr origin))]
          [(!= owner 0) `(s ,(-> (unit-of owner) hash) ,(make-integer (hash-ref (& scope-numbers) (scope-key sc))))]
          [else (fail-at 0 "internal: scope ~a belongs to no module" (list1 (make-integer sc))) 0])))

;; A scope set's scopes, in an order that does not depend on the run.
(define (scope-refs [s (ptr scope-set)]) -> datum
  (let ([out nil])
    (for ([i u32 0]) (< i (-> s count)) (+= i 1) (set! out (cons (scope-ref (@ (-> s ids) i)) out)))
    (sort out (lambda ([a datum] [b datum]) -> i32 (scope-ref<? a b)))))

;; A module's copies first, then a module's own, then core and kernel-ids;
;; each by its module's hash, then its number.
(define (scope-ref<? [a datum] [b datum]) -> i32
  (let ([ra (scope-ref-rank a)] [rb (scope-ref-rank b)])
    (cond [(!= ra rb) (< ra rb)]
          [(>= ra 2) 0]
          [else
           (let ([c (string-compare (cadr a) (cadr b))])
             (or (< c 0) (and (== c 0) (< (integer-value (caddr a)) (integer-value (caddr b))))))])))

(define (scope-ref-rank [r datum]) -> i32
  (cond [(== r (sym core)) 2] [(== r (sym kernel-ids)) 3] [(== (car r) (sym m)) 0] [else 1]))

;; -1, 0 or 1, as string a is before, the same as or after string b.
(define (string-compare [a datum] [b datum]) -> i32
  (let* ([n (string-length a)] [k (string-length b)] [c (memcmp (string-bytes a) (string-bytes b) (if (< n k) n k))])
    (cond [(< c 0) -1] [(> c 0) 1] [(< n k) -1] [(> n k) 1] [else 0])))

;; ---- loading an interface ----

;; The module being loaded: its type forms, its types as they are made,
;; and its definitions, each by number.
(define loading datum 0)
(define loaded-type-forms (ptr datum) 0)
(define loaded-types (ptr datum) 0)
(define loaded-infos (ptr datum) 0)

;; The elements of list l in a new array of n, in the current arena.
(define (array-of [l datum] [n u32]) -> (ptr datum)
  (let ([a (cast (ptr datum) (alloc-in (current-arena) (* 4 (+ n 1))))] [i u32 0])
    (while (< i n)
      (set! (@ a i) (if (pair? l) (car l) 0))
      (when (pair? l) (set! l (cdr l)))
      (+= i 1))
    a))

;; Load module m from its interface d, as if it had been compiled in this
;; run.
(define (load-module! [m datum] [d datum])
  (let* ([u (unit-of m)] [type-forms (section d (sym types))] [infos (section d (sym infos))]
         [nt (length type-forms)] [ni (length infos)]
         [definitions (cast u32 (integer-value (section d (sym definitions))))])
    (set! (-> u name) (keep (section d (sym name))))
    (set! (-> u hash) (keep (section d (sym hash))))
    (hash-set! (& units-by-hash) (cast u64 (string->symbol (-> u hash))) (cast u32 m))
    (set! (-> u scope) (new-run-scope!))
    (hash-set! (& module-scope-origins) (scope-key (-> u scope)) (cast u32 (keep (cons m (make-integer 0)))))
    (set! loading m)
    (set! loaded-type-forms (array-of type-forms nt))
    (set! loaded-types (array-of nil nt))
    (set! loaded-infos (array-of nil ni))
    ;; Types, in any order: each made, then its fields, which may name any
    ;; of them, then their groups and identities.
    (for ([i u32 0]) (< i nt) (+= i 1) (type-shell i))
    (for ([i u32 0]) (< i nt) (+= i 1)
      (set-type-info-fields! (@ loaded-types i) (decode (list-ref (@ loaded-type-forms i) 4))))
    (for-each (lambda ([g datum])
                (let ([members (map (lambda ([i datum]) -> datum (@ loaded-types (cast u32 (integer-value i)))) g)])
                  (for-each (lambda ([t datum]) (set-type-info-group! t members)) members)))
              (section d (sym groups)))
    (for ([i u32 0]) (< i nt) (+= i 1) (identify! (@ loaded-types i)))
    (for ([i u32 0]) (< i nt) (+= i 1)
      (own-type! m (@ loaded-types i))
      (set! (-> u types) (keep-cons (@ loaded-types i) (-> u types))))
    ;; Its linklets, their names known.
    (for-each (lambda ([l datum])
                (let ([phase (cast i32 (integer-value (car l)))])
                  (add-linklet! m phase `(,(cadr l) ,(caddr l) ,(cadddr l)
                                          ,(map (lambda ([r datum]) -> datum (make-integer (scope-at r))) (list-ref l 4))))
                  (linklet-name m phase 0)))
              (section d (sym linklets)))
    ;; Definitions: the first are its own, as note-definitions! notes them;
    ;; the rest are what else its sections refer to.
    (for ([i u32 0]) (< i ni) (+= i 1)
      (let ([info (list->info (decode (car infos)))])
        (set! (@ loaded-infos i) info)
        (when (< i definitions) (set! (-> u infos) (keep-cons info (-> u infos)))))
      (set! infos (cdr infos)))
    ;; Its bindings, provides, function values, inline bodies, macros and
    ;; facts.
    (for-each (lambda ([e datum])
                (let* ([scopes (scope-set-of (cadr e))] [phase (cast i32 (integer-value (caddr e)))]
                       [b (bind-raw! (car e) scopes phase (decode (cadddr e)))]
                       [me (cast (ptr module-entry) (alloc-in (& run-arena) (sizeof module-entry)))])
                  (set! (-> me symbol) (car e))
                  (set! (-> me scopes) scopes)
                  (set! (-> me phase) phase)
                  (set! (-> me binding) b)
                  (set! (-> me next) (-> u entries))
                  (set! (-> u entries) me)))
              (section d (sym entries)))
    (set! (-> u provides) (keep (map (lambda ([p datum]) -> datum (cons (car p) (decode (cdr p)))) (section d (sym provides)))))
    (for-each (lambda ([v datum])
                (let ([x (decode v)]) (hash-set! (& function-values) (cast u64 (car x)) (cast u32 (cadr x)))))
              (section d (sym values)))
    (for-each (lambda ([v datum]) (load-inline! (decode v))) (section d (sym inlines)))
    (set! (-> u memories) (keep (section d (sym memories))))
    (for-each (lambda ([g datum]) (hash-set! (& macro-modules) (cast u64 (decode (car g))) (cast u32 m)))
              (section d (sym macros)))
    (let ([facts (map (lambda ([f datum]) -> datum (decode f)) (section d (sym facts)))])
      (set! (-> u facts) (keep (reverse facts)))
      (for-each (lambda ([f datum]) (index-fact! m f)) (reverse (-> u facts))))
    (set! loading 0)
    (set! (-> u state) (sym done))
    ;; As its requires would have when it was compiled: its own bindings
    ;; are made, and its requires' installed at their shifts.
    (install-module-bindings! m 0)))

;; An inline body, x (info params results body returns? assigned-keys
;; memory?), kept as record-inline! keeps one.
(define (load-inline! [x datum])
  (let* ([saved (use-arena (& run-arena))] [params (keep (cadr x))]
         [assigned (filter (lambda ([p datum]) -> i32 (!= (member (car p) (list-ref x 5)) 0)) params)]
         [b `(,params ,(keep (caddr x)) ,(keep (cadddr x)) ,(list-ref x 4) ,assigned ,(list-ref x 6))])
    (use-arena saved)
    (hash-set! (& inlines) (cast u64 (car x)) (cast u32 b))))

;; Its i-th type, made the first time something names it: a supertype is
;; made before its subtypes, wherever it is listed.
(define (type-shell [i u32]) -> datum
  (let ([t (@ loaded-types i)])
    (if (!= t 0)
        t
        (let* ([f (@ loaded-type-forms i)] [super (decode (cadddr f))]
               [new (make-type-info (car f) (cadr f) 0 super (caddr f) 0)])
          (set! (@ loaded-types i) new)
          new))))

;; The identity of t's group, once the groups of the types its members
;; name have theirs; wasm allows no cycle between groups.
(define (identify! [t datum])
  (when (== (type-info-identity t) 0)
    (let ([group (if (!= (type-info-group t) 0) (type-info-group t) (list1 t))] [members datum 0] [refs datum 0])
      (set! members group)
      (while (pair? members)
        (set! refs (type-references (car members)))
        (while (pair? refs)
          (when (== (memq (car refs) group) 0) (identify! (car refs)))
          (set! refs (cdr refs)))
        (set! members (cdr members)))
      (identify-group! group))))

;; The declared types type t names: its supertype, and those its fields or
;; signature refer to.
(define (type-references [t datum]) -> datum
  (let* ([fs (type-info-fields t)] [kind (type-info-kind t)]
         [vals (cond [(== kind (sym struct)) (map (lambda ([f datum]) -> datum (cadr f)) fs)]
                     [(== kind (sym array)) (list1 (car fs))]
                     [else (append (car fs) (cadr fs))])]
         [out (if (!= (type-info-super t) 0) (list1 (type-info-super t)) nil)])
    (while (pair? vals)
      (let ([v (car vals)])
        (when (and (ref-type? v) (type-info? (ref-heap v))) (set! out (cons (ref-heap v) out))))
      (set! vals (cdr vals)))
    out))

;; x as encode wrote it, read back.
(define (decode [x datum]) -> datum
  (if (not (pair? x))
      x
      (case (car x)
        [((sym %type)) (type-at (cdr x))]
        [((sym %info)) (info-at (cdr x))]
        [((sym %syntax))
         (make-syntax (decode (cadr x)) (scope-set-of (caddr x)) (srcloc-of (cadddr x)) (decode (list-ref x 4)))]
        [else
         ;; A list's spine is walked: a tail that starts with %type, %info or
         ;; %syntax is an object, and %quote quotes the next element.
         (let ([head nil] [last datum 0] [l x] [p datum 0])
           (while (and (pair? l) (not (object-tag? (car l))))
             (if (== (car l) (sym %quote))
                 (begin (set! p (list1 (cadr l))) (set! l (cddr l)))
                 (begin (set! p (list1 (decode (car l)))) (set! l (cdr l))))
             (if (== last 0) (set! head p) (set-cdr! last p))
             (set! last p))
           (set-cdr! last (decode l))
           head)])))

(define (srcloc-of [d datum]) -> (ptr srcloc)
  (if (== d 0)
      0
      (make-srcloc (car d) (cast u32 (integer-value (cadr d))) (cast u32 (integer-value (caddr d)))
                   (cast u32 (integer-value (cadddr d))) (cast u32 (integer-value (list-ref d 4))))))

(define (type-at [r datum]) -> datum
  (cond [(null? (cdr r)) (type-shell (cast u32 (integer-value (car r))))]
        [(== (car r) (sym closure)) (closure-type (decode (cadr r)) (decode (caddr r)))]
        [(== (car r) (sym code)) (closure-code (decode (cadr r)))]
        [(== (car r) (sym box)) (box-type (decode (cadr r)))]
        [else
         (let ([t (unit-type (unit-with-hash (car r)) (cast u32 (integer-value (cadr r))))])
           (when (== t 0) (fail-at 0 "the cache is inconsistent: no type ~a of ~a" `(,(cadr r) ,(car r))))
           t)]))

(define (info-at [r datum]) -> datum
  (case (car r)
    [((sym own)) (@ loaded-infos (cast u32 (integer-value (cadr r))))]
    [((sym shifted)) (shift-info (decode (cadr r)) (cast u32 (integer-value (caddr r))))]
    [((sym kernel)) (kernel-definition (cadr r) (caddr r))]
    [else
     (let ([info (find-info (cadr r) (caddr r) (cadddr r))])
       (when (== info 0)
         (fail-at 0 "the cache is inconsistent: no ~a ~a in ~a" `(,(caddr r) ,(cadddr r) ,(cadr r))))
       info)]))

(define (scope-at [r datum]) -> u32
  (cond [(== r (sym core)) core-scope]
        [(== r (sym kernel-ids)) (kernel-id-scope)]
        [(== (car r) (sym m)) (module-scope-at (unit-with-hash (cadr r)) (cast u32 (integer-value (caddr r))))]
        [else (unit-scope-at (unit-with-hash (cadr r)) (cast u32 (integer-value (caddr r))))]))

(define (scope-set-of [refs datum]) -> (ptr scope-set)
  (let ([s no-scopes])
    (while (pair? refs)
      (set! s (scopes-change s (scope-at (car refs)) 0))
      (set! refs (cdr refs)))
    s))

;; ==== module bodies ====

;; The core form name if s is (core-id ...), else #f.
(define (core-head [s datum] [phase i32]) -> datum
  (if (and (syntax? s) (pair? (syntax-e s)) (identifier? (car (syntax-e s))))
      (let ([m (meaning-of (car (syntax-e s)) phase)])
        (if (and (!= m 0) (== (car m) (sym core))) (cadr m) 0))
      0))

;; Expand macro uses at the head of s until it is something else.
(define (head-expand [s datum] [phase i32]) -> datum
  (let* ([head (cond [(identifier? s) s]
                     [(and (syntax? s) (pair? (syntax-e s)) (identifier? (car (syntax-e s)))) (car (syntax-e s))]
                     [else 0])]
         [t (if (!= head 0) (transformer-of (meaning-of head phase)) 0)])
    (if (!= t 0)
        (head-expand (apply-macro head t s phase 1) phase)
        s)))

;; A module body being expanded: its phase, whether its code is built as
;; fully expanded code, the items pass 1 found (reversed), whether pass 2
;; has started, and the forms lifted while pass 2 expands the current
;; item (reversed).
(struct body [phase i32] [syntax i32] [items datum] [pass2 i32] [lifted datum])

(define current-body (ptr body) 0)          ; the innermost body being expanded

;; A module body -> its code: lowered forms for the compiler (core.sub),
;; or fully expanded code (spec 6.4). Other module-level forms take
;; effect during expansion and leave nothing.
(define (expand-body [forms datum] [phase i32]) -> datum
  (let ([b (cast (ptr body) (alloc-in (current-arena) (sizeof body)))] [saved current-body] [out datum 0])
    (set! (-> b phase) phase)
    (set! (-> b syntax) to-syntax)
    (set! (-> b items) nil)
    (set! (-> b pass2) 0)
    (set! (-> b lifted) nil)
    (set! current-body b)
    (for-each (lambda ([f datum]) (declare-form! f b 0)) forms)
    (set! out (finish-body! b))
    (set! current-body saved)
    out))

;; Pass 2 for body b: expand bodies and expressions, in the order pass 1
;; declared them. What an item lifts goes before it.
(define (finish-body! [b (ptr body)]) -> datum
  (set! (-> b pass2) 1)
  (let ([items (reverse (-> b items))] [out nil] [item-out datum 0] [lifted datum 0])
    (while (pair? items)
      (set! (-> b lifted) nil)
      (set! item-out (expand-item (car items) (-> b phase)))
      (set! lifted (reverse (-> b lifted)))
      (while (pair? lifted)
        (set! out (append (reverse (car lifted)) out))
        (set! lifted (cdr lifted)))
      (set! out (append (reverse item-out) out))
      (set! items (cdr items)))
    (reverse out)))

(define (item! [b (ptr body)] [x datum]) (set! (-> b items) (cons x (-> b items))))

;; Pass 1 for module-level form f0 of body b: expand macro uses at its
;; head, then declare it, run it, or keep it for pass 2. only is 0, or
;; says where the form came from if it may only be a definition or an
;; expression (what a macro lifts).
(define (declare-form! [f0 datum] [b (ptr body)] [only (ptr u8)])
  (let* ([phase (-> b phase)] [f (head-expand f0 phase)] [kind (core-head f phase)])
    (when (and (!= only 0)
               (!= (memq kind `(require require-unqualified provide freestanding memory table define-syntax begin-for-syntax)) 0))
      (fail-at f "~a (~a ...), but only func, global, import, type, tag, data and #%fact forms and expressions are allowed there"
               `(,(bytes->string only (strlen only)) ,kind)))
    (case kind
      ;; A form a macro's begin splices is its output too (spec 6.2).
      [((sym begin))
       (let ([forms (cdr (form-list f "(begin form ...)"))])
         (for-each (lambda ([g datum]) (declare-form! (at-use f g) b only)) forms))]
      [((sym require)) (require! f phase 0)]
      [((sym require-unqualified)) (require! f phase 1)]
      [((sym provide)) (provide! f phase)]
      [((sym freestanding)) (freestanding! f phase)]
      [((sym func)) (item! b (declare-func f phase))]
      [((sym global)) (item! b (declare-global f phase))]
      [((sym import)) (item! b (declare-import f phase))]
      [((sym memory) (sym table)) (declare-storage! f phase)]
      [((sym data)) (item! b (declare-data f phase))]
      [((sym type)) (item! b (declare-type f phase))]
      [((sym tag)) (item! b (declare-tag f phase))]
      [((sym rec)) (item! b (declare-rec f phase))]
      [((sym define-syntax)) (define-syntax! f phase)]
      [((sym begin-for-syntax)) (begin-for-syntax! f phase)]
      [((sym #%fact)) (item! b `(done ,(fact! f phase) ()))]
      [else
       (if (and (in-session?) (== phase 0) (== only 0) (not interacting))
           (interact! f0 f b)
           (item! b `(expr ,f)))])))

;; Lift form, from a macro, to the module level of the body being expanded
;; (spec 6.4): declare it now, so its names can be used at once, and put
;; its code before the form whose expansion lifted it.
(define (lift! [form datum] [where datum] [phase i32])
  (let ([b current-body] [before datum 0] [new nil] [l datum 0] [saved to-syntax])
    (unless (and (!= b 0) (== (-> b phase) phase))
      (fail-at where "syntax-local-lift-definition: no module body is being expanded at phase ~a" (list1 (make-integer phase))))
    (set! before (-> b items))
    (declare-form! form b "syntax-local-lift-definition was given")
    ;; In pass 2 the new items, those before the old ones, are expanded
    ;; now, in order; in pass 1 they wait for pass 2 like the others.
    (when (-> b pass2)
      (set! l (-> b items))
      (while (!= l before)
        (set! new (cons (car l) new))
        (set! l (cdr l)))
      (set! (-> b items) before)
      (set! to-syntax (-> b syntax))
      (while (pair? new)
        (set! (-> b lifted) (cons (expand-item (car new) phase) (-> b lifted)))
        (set! new (cdr new)))
      (set! to-syntax saved))))

;; The elements of syntax list f, or an error: f matched none of the
;; patterns.
(define (form-list [f datum] [patterns (ptr u8)]) -> datum
  (let ([l (syntax->list f)])
    (if (== l 0) (no-match f patterns) l)))

;; Pass 2 for one item: its forms, in the body's code.
(define (expand-item [item datum] [phase i32]) -> datum
  (case (car item)
    [((sym func)) (expand-func item phase)]
    [((sym global)) (expand-global item phase)]
    [((sym plain) (sym done)) (if to-syntax (list1 (cadr item)) (caddr item))]
    [else
     (let ([r (closures-noted-expr (cadr item) phase)])
       (if to-syntax (list1 (car r)) (list1 `(expr ,(car r) ,(cdr r)))))]))

;; ==== types ====

(define shorthand-refs datum
  `((anyref . any) (eqref . eq) (i31ref . i31) (structref . struct) (arrayref . array)
    (funcref . func) (externref . extern) (exnref . exn)))

;; A heap type: an abstract name, a type declared with `type`, or
;; (closure (t ... -> r ...)), the closure type of a signature (spec 5.3).
(define (parse-heap [s datum] [phase i32]) -> datum
  (cond [(and (identifier? s) (!= (memq (syntax-e s) abstract-heaps) 0)) (syntax-e s)]
        [(identifier? s)
         (let ([m (type-meaning-of s phase)])
           (when (== m 0) (fail-at s "~a is not a type" (list1 (syntax-e s))))
           (cadr m))]
        [(== (core-head s phase) (sym closure))
         (let ([l (syntax->list s)])
           (unless (and (!= l 0) (== (length l) 2)) (fail-at s "expected (closure (type ... -> type ...))" nil))
           (let ([sig (parse-signature (cadr l) phase)]) (closure-type (car sig) (cdr sig))))]
        [else (fail-at s "expected a heap type, got ~s" (list1 (syntax->datum s)))]))

;; A value type.
(define (parse-type [s datum] [phase i32]) -> datum
  (let* ([d (syntax-e s)] [short (assq d shorthand-refs)])
    (cond [(!= (memq d `(i32 i64 f32 f64)) 0) d]
          [(!= short 0) (make-ref (boolean 1) (cdr short))]
          [else
           (let ([l (syntax->list s)])
             (cond [(and (!= l 0) (== (length l) 2) (named? (car l) (sym ref))) (make-ref 0 (parse-heap (cadr l) phase))]
                   [(and (!= l 0) (== (length l) 3) (named? (car l) (sym ref)) (named? (cadr l) (sym null)))
                    (make-ref (boolean 1) (parse-heap (caddr l) phase))]
                   [(and (pair? d) (named? (car d) (sym ref))) (fail-at s "expected (ref T) or (ref null T)" nil)]
                   [else (fail-at s "expected a type (i32, i64, f32, f64 or a reference type), got ~s" (list1 (syntax->datum s)))]))])))

;; Is x an identifier named name? The words of type syntax are compared by
;; name, like wasm's keywords, so they are reserved: no declared type may
;; be named by one (spec 5.1).
(define (named? [x datum] [name datum]) -> i32 (and (identifier? x) (== (syntax-e x) name)))

(define (parse-reftype [s datum] [phase i32]) -> datum
  (let ([t (parse-type s phase)])
    (unless (ref-type? t) (fail-at s "expected a reference type" nil))
    t))

(define type-keywords datum `(ref null mut struct array field sub final func rec ->))

;; A kind of declared type, with its article, for messages.
(define (kind-word [kind datum]) -> datum
  (case kind [((sym struct)) `"a struct"] [((sym array)) `"an array"] [((sym func)) `"a function"] [else `"a"]))

(define (check-type-name! [id datum])
  (let ([name (syntax-e id)])
    (cond [(or (!= (memq name (append abstract-heaps `(i32 i64 f32 f64 i8 i16))) 0) (!= (assq name shorthand-refs) 0))
           (fail-at id "~a names a built-in type" (list1 name))]
          [(!= (memq name type-keywords) 0)
           (fail-at id "~a is a word of type syntax, so it cannot name a type" (list1 name))])))

;; A field or element type: a storage type, optionally (mut storage), as
;; (storage mutable?).
(define (parse-field-type [s datum] [phase i32]) -> datum
  (let ([l (syntax->list s)])
    (if (and (!= l 0) (== (length l) 2) (named? (car l) (sym mut)))
        `(,(parse-storage (cadr l) phase) #t)
        `(,(parse-storage s phase) #f))))

(define (parse-storage [s datum] [phase i32]) -> datum
  (if (and (identifier? s) (or (== (syntax-e s) (sym i8)) (== (syntax-e s) (sym i16)))) (syntax-e s) (parse-type s phase)))

;; ---- macros in types ----
;;
;; In a type position, a form whose head is a macro is expanded until its
;; head is not a macro (a type function, spec 5.1). The expand- functions
;; return type syntax with every such use expanded, which is what fully
;; expanded code holds; the parse- functions then read that syntax.

;; The transformer of s's head if s is (macro ...), else #f.
(define (type-macro-use [s datum] [phase i32]) -> datum
  (if (and (syntax? s) (pair? (syntax-e s)) (identifier? (car (syntax-e s))))
      (transformer-of (meaning-of (car (syntax-e s)) phase))
      0))

;; A type name or heap type: macro uses at its head expanded, and the
;; types in a closure type's signature.
(define (expand-type-name [s datum] [phase i32]) -> datum
  (let ([t (type-macro-use s phase)])
    (cond [(!= t 0) (expand-type-name (apply-macro (car (syntax-e s)) t s phase 0) phase)]
          [(== (core-head s phase) (sym closure))
           (let ([l (syntax->list s)])
             (unless (and (!= l 0) (== (length l) 2)) (fail-at s "expected (closure (type ... -> type ...))" nil))
             (syntax-rewrap s `(,(car l) ,(expand-signature (cadr l) phase))))]
          [else s])))

;; A value type.
(define (expand-type [s0 datum] [phase i32]) -> datum
  (let* ([s (expand-type-name s0 phase)] [l (syntax->list s)])
    (if (and (!= l 0) (pair? l) (named? (car l) (sym ref)) (pair? (cdr l)))
        (syntax-rewrap s (append (take l (- (length l) 1)) (list1 (expand-type-name (last l) phase))))
        s)))

;; A field, element or global type: a type, i8, i16, or (mut ...) of one.
(define (expand-field-type [s datum] [phase i32]) -> datum
  (let ([l (syntax->list s)])
    (cond [(and (!= l 0) (== (length l) 2) (named? (car l) (sym mut)))
           (syntax-rewrap s `(,(car l) ,(expand-field-type (cadr l) phase)))]
          [(or (== (syntax-e s) (sym i8)) (== (syntax-e s) (sym i16))) s]
          [else (expand-type s phase)])))

;; A signature (t ... -> r ...).
(define (expand-signature [s datum] [phase i32]) -> datum
  (let ([l (syntax->list s)])
    (when (== l 0) (fail-at s "expected a signature (type ... -> type ...)" nil))
    (syntax-rewrap s (map (lambda ([t datum]) -> datum (if (named? t (sym ->)) t (expand-type t phase))) l))))

;; A type definition: (struct (field name t) ...), (array t), or (sub ... def).
(define (expand-type-def [s datum] [phase i32]) -> datum
  (let ([l (syntax->list s)])
    (cond [(and (!= l 0) (pair? l) (pair? (cdr l)) (named? (car l) (sym sub)))
           (syntax-rewrap s (append (take l (- (length l) 1)) (list1 (expand-type-def (last l) phase))))]
          [(and (!= l 0) (pair? l) (named? (car l) (sym struct)))
           (syntax-rewrap s (cons (car l) (map (lambda ([f datum]) -> datum
                                                 (let ([fl (syntax->list f)])
                                                   (if (and (!= fl 0) (== (length fl) 3))
                                                       (syntax-rewrap f `(,(car fl) ,(cadr fl) ,(expand-field-type (caddr fl) phase)))
                                                       f)))
                                               (cdr l))))]
          [(and (!= l 0) (== (length l) 2) (named? (car l) (sym func)))
           (syntax-rewrap s `(,(car l) ,(expand-signature (cadr l) phase)))]
          [(and (!= l 0) (== (length l) 2) (named? (car l) (sym array)))
           (syntax-rewrap s `(,(car l) ,(expand-field-type (cadr l) phase)))]
          [else s])))

;; (type name def), where def is (struct (field fname ftype) ...),
;; (array etype), or (sub [final] [super] def) as in wasm (spec 5.2). A def
;; without sub is final, with no supertype. The name is bound before the
;; fields are read, so a type may refer to itself.
(define (declare-type [f datum] [phase i32]) -> datum
  (let* ([m (begin-type-member f phase)] [xdef (finish-type-member! m phase)])
    (identify-group! (list1 (cadddr m)))
    `(plain ,(type-member-out m xdef) ((type ,(cadddr m))))))

;; (rec (type name def) ...): types that may refer to each other, one wasm
;; recursion group (spec 5.2). Every name is bound before any fields are
;; read. A supertype must still come earlier, as in wasm.
(define (declare-rec [f datum] [phase i32]) -> datum
  (let ([l (syntax->list f)])
    (unless (and (!= l 0) (>= (length l) 2)) (no-match f "(rec type0 type ...)"))
    (let* ([members (let ([ts (cdr l)] [ms nil])
                      (while (pair? ts)
                        (let ([t (car ts)])
                          (unless (== (core-head t phase) (sym type))
                            (fail-at t "a rec group holds (type name def) forms" nil))
                          (check-super-not-later t (cdr ts))
                          (set! ms (cons (begin-type-member t phase) ms)))
                        (set! ts (cdr ts)))
                      (reverse ms))]
           [infos (map (lambda ([m datum]) -> datum (cadddr m)) members)])
      (let ([xdefs (map (lambda ([m datum]) -> datum (finish-type-member! m phase)) members)] [outs nil])
        (for-each (lambda ([info datum]) (set-type-info-group! info infos)) infos)
        (identify-group! infos)
        (while (pair? members)
          (set! outs (cons (type-member-out (car members) (car xdefs)) outs))
          (set! members (cdr members))
          (set! xdefs (cdr xdefs)))
        `(plain ,(out f (sym rec) (reverse outs)) ,(map (lambda ([i datum]) -> datum `(type ,i)) infos))))))

;; A member of a rec group whose supertype is a later member.
(define (check-super-not-later [t datum] [later datum])
  (let ([l (syntax->list t)])
    (when (and (!= l 0) (== (length l) 3))
      (let* ([name (cadr l)] [def (syntax->list (caddr l))]
             [super (cond [(or (== def 0) (not (named? (car def) (sym sub)))) 0]
                          [(and (== (length def) 3) (named? (cadr def) (sym final))) 0]
                          [(and (== (length def) 4) (named? (cadr def) (sym final))) (caddr def)]
                          [(== (length def) 3) (cadr def)]
                          [else 0])])
        (when (and (identifier? super)
                   (ormap (lambda ([u datum]) -> i32
                            (let ([ul (syntax->list u)])
                              (and (!= ul 0) (>= (length ul) 2) (== (syntax-e (cadr ul)) (syntax-e super)))))
                          later))
          (fail-at super "~a must be declared before its subtype ~a, as in wasm" `(,(syntax-e super) ,(syntax-e name))))))))

;; A type declaration being read: (form name written info), the (type name
;; def) form and the declared type. Its fully expanded form holds xdef,
;; def with its types expanded, once read.
(define (type-member-out [m datum] [xdef datum]) -> datum (out (car m) (sym type) `(,(cadr m) ,xdef)))

;; Check (type name def), resolve its supertype, and bind name. The fields
;; are read afterwards (finish-type-member!).
(define (begin-type-member [f datum] [phase i32]) -> datum
  (let ([l (syntax->list f)])
    (unless (and (!= l 0) (== (length l) 3) (identifier? (cadr l)) (syntax? (caddr l)) (pair? (syntax->list (caddr l))))
      (no-match f "(type name (kind part ...))"))
    (let* ([name (cadr l)] [written (caddr l)])
      (check-type-name! name)
      (let* ([sub (parse-sub written phase)] [def (car sub)] [final (cadr sub)] [super (caddr sub)]
             [dl (syntax->list def)]
             [kind (if (and (!= dl 0) (pair? dl)) (syntax-e (car dl)) 0)])
        (unless (!= (memq kind `(struct array func)) 0)
          (fail-at def "a type is (struct field ...), (array type), (func signature) or (sub ...)" nil))
        (when (!= super 0)
          (unless (== (type-info-kind super) kind)
            (fail-at written "~a type cannot have ~a, ~a type, as its supertype"
                     `(,(kind-word kind) ,(type-info-name super) ,(kind-word (type-info-kind super)))))
          (when (type-info-final? super)
            (fail-at written "~a is final: it cannot be a supertype" (list1 (type-info-name super)))))
        (let ([info (make-type-info (syntax-e name) kind 0 super final 0)])
          (bind-definition! name phase `(type ,info))
          `(,f ,name ,written ,info))))))

;; Read the fields of a type whose name is bound. They are expanded after
;; the name is bound, so a type function may be given the type itself.
;; Returns def expanded.
(define (finish-type-member! [m datum] [phase i32]) -> datum
  (let* ([info (cadddr m)]
         [xdef (expand-type-def (caddr m) phase)]
         [xinner (car (parse-sub xdef phase))])
    (set-type-info-fields! info (parse-type-fields xinner (type-info-kind info) phase))
    (when (!= (type-info-super info) 0) (check-subtype-fields! info (type-info-super info) xinner))
    xdef))

;; (sub [final] [super] def) -> (def final? super-type-info-or-#f).
(define (parse-sub [s datum] [phase i32]) -> datum
  (let ([l (syntax->list s)])
    (cond [(or (== l 0) (not (pair? l)) (not (named? (car l) (sym sub)))) `(,s #t #f)]
          [(and (== (length l) 3) (named? (cadr l) (sym final))) `(,(caddr l) #t #f)]
          [(and (== (length l) 4) (named? (cadr l) (sym final))) `(,(cadddr l) #t ,(type-of (caddr l) phase))]
          [(== (length l) 2) `(,(cadr l) #f #f)]
          [(== (length l) 3) `(,(caddr l) #f ,(type-of (cadr l) phase))]
          [else (fail-at s "expected (sub [final] [supertype] (struct ...) or (array ...))" nil)])))

(define (parse-type-fields [def datum] [kind datum] [phase i32]) -> datum
  (let ([l (syntax->list def)])
    (case kind
      [((sym struct))
       (map (lambda ([f datum]) -> datum
              (let ([fl (syntax->list f)])
                (unless (and (!= fl 0) (== (length fl) 3) (named? (car fl) (sym field)) (identifier? (cadr fl)))
                  (no-match f "(field name type)"))
                (cons (syntax-e (cadr fl)) (parse-field-type (caddr fl) phase))))
            (cdr l))]
      [((sym func)) (let ([sig (parse-signature (cadr l) phase)]) `(,(car sig) ,(cdr sig)))]
      [else (parse-field-type (cadr l) phase)])))

;; Wasm's rule for a declared supertype: a struct starts with its
;; supertype's fields, and an array's element matches. An immutable field
;; may narrow its type; a mutable one keeps it.
(define (field<=? [a datum] [b datum]) -> i32               ; (storage mutable?)
  (and (== (cadr a) (cadr b))
       (if (or (== (car a) (sym i8)) (== (car a) (sym i16)) (== (car b) (sym i8)) (== (car b) (sym i16)))
           (== (car a) (car b))
           (and (valtype<=? (car a) (car b)) (or (not (cadr a)) (valtype<=? (car b) (car a)))))))

(define (check-subtype-fields! [info datum] [super datum] [where datum])
  (case (type-info-kind info)
    [((sym struct))
     (let ([mine (type-info-fields info)] [theirs (type-info-fields super)])
       (when (< (length mine) (length theirs))
         (fail-at where "~a has fewer fields than its supertype ~a" `(,(type-info-name info) ,(type-info-name super))))
       (while (pair? theirs)
         (unless (field<=? (cdr (car mine)) (cdr (car theirs)))
           (fail-at where "~a's field ~a does not match field ~a of its supertype ~a"
                    `(,(type-info-name info) ,(car (car mine)) ,(car (car theirs)) ,(type-info-name super))))
         (set! mine (cdr mine))
         (set! theirs (cdr theirs))))]
    [((sym array))
     (unless (field<=? (type-info-fields info) (type-info-fields super))
       (fail-at where "~a's element type does not match its supertype ~a's" `(,(type-info-name info) ,(type-info-name super))))]
    ;; A function subtype accepts at least its supertype's parameters and
    ;; returns at most its results.
    [else
     (let ([mine (type-info-fields info)] [theirs (type-info-fields super)])
       (unless (and (types<=? (car theirs) (car mine)) (types<=? (cadr mine) (cadr theirs)))
         (fail-at where "~a's signature does not fit its supertype ~a's" `(,(type-info-name info) ,(type-info-name super)))))]))

(define (type-of [id datum] [phase i32]) -> datum
  (let ([m (if (identifier? id) (type-meaning-of id phase) 0)])
    (when (== m 0) (fail-at id "~s is not a declared type" (list1 (syntax->datum id))))
    (cadr m)))

(define (field-index [tinfo datum] [id datum]) -> datum
  (unless (== (type-info-kind tinfo) (sym struct))
    (fail-at id "~a is not a struct type" (list1 (type-info-name tinfo))))
  (let ([fs (type-info-fields tinfo)] [i 0])
    (while (pair? fs)
      (when (and (identifier? id) (== (car (car fs)) (syntax-e id))) (return (make-integer i)))
      (set! fs (cdr fs))
      (+= i 1))
    (fail-at id "~a has no field ~s" `(,(type-info-name tinfo) ,(syntax->datum id)))))

;; ==== other module-level forms ====

;; A string literal, and a count: a fixnum from 0.
(define (string-literal? [s datum]) -> i32 (string? (syntax-e s)))
(define (count-literal? [s datum]) -> i32
  (let ([n (syntax-e s)]) (and (integer? n) (>= (integer-value n) 0) (< (integer-value n) 1073741824))))

;; `-> t` or `-> (t ...)`: (results . the rest of body).
(define (parse-results [body datum] [phase i32]) -> datum
  (cond [(and (pair? body) (named? (car body) (sym ->)) (pair? (cdr body)))
         (let* ([r (cadr body)] [l (syntax->list r)])
           (cons (cond [(and (!= l 0) (pair? l) (named? (car l) (sym ref))) (list1 (parse-type r phase))]
                       [(!= l 0) (map (lambda ([x datum]) -> datum (parse-type x phase)) l)]
                       [else (list1 (parse-type r phase))])
                 (cddr body)))]
        [(and (pair? body) (named? (car body) (sym ->))) (fail-at (car body) "expected a type after ->" nil)]
        [else (cons nil body)]))

;; The `-> r` that starts rest, a func's or a lambda's, as a list of the
;; two, or (). r is one type or a list of them, and has its types
;; expanded; a macro use is one type, though it looks like a list.
(define (arrow-of [rest datum] [phase i32]) -> datum
  (cond [(and (pair? rest) (named? (car rest) (sym ->)) (pair? (cdr rest)))
         (let* ([r (cadr rest)] [l (syntax->list r)])
           `(,(car rest) ,(cond [(and (!= l 0) (pair? l) (named? (car l) (sym ref))) (expand-type r phase)]
                                [(!= l 0) (syntax-rewrap r (map (lambda ([x datum]) -> datum (expand-type x phase)) l))]
                                [else (expand-type r phase)])))]
        [(and (pair? rest) (named? (car rest) (sym ->))) (fail-at (car rest) "expected a type after ->" nil)]
        [else nil]))

;; (t ... -> r ...): (params . results).
(define (parse-signature [s datum] [phase i32]) -> datum
  (let ([l (syntax->list s)] [params nil])
    (when (or (== l 0) (not (ormap (lambda ([t datum]) -> i32 (named? t (sym ->))) l)))
      (fail-at s "expected a signature (type ... -> type ...)" nil))
    (while (not (named? (car l) (sym ->)))
      (set! params (cons (car l) params))
      (set! l (cdr l)))
    (cons (map (lambda ([t datum]) -> datum (parse-type t phase)) (reverse params))
          (map (lambda ([t datum]) -> datum (parse-type t phase)) (cdr l)))))

;; The options after a func's head, [#:inline] [#:value g] (spec 5.2), as
;; (inline value rest): the #:inline keyword or #f, the list (#:value g)
;; or #f, and what follows them.
(define (func-options [rest datum]) -> datum
  (let* ([inline (if (and (pair? rest) (== (syntax-e (car rest)) `#:inline)) (car rest) 0)]
         [rest (if (!= inline 0) (cdr rest) rest)]
         [value (if (and (pair? rest) (== (syntax-e (car rest)) `#:value))
                    (begin
                      (unless (and (pair? (cdr rest)) (identifier? (cadr rest)))
                        (fail-at (car rest) "#:value needs the name of a global" nil))
                      `(,(car rest) ,(cadr rest)))
                    0)])
    `(,inline ,value ,(if (!= value 0) (cddr rest) rest))))

;; (func (name [p t] ...) [#:inline] [#:value g] [-> r] body ...)
(define (declare-func [f datum] [phase i32]) -> datum
  (let* ([l (syntax->list f)] [head (if (and (!= l 0) (>= (length l) 2)) (syntax->list (cadr l)) 0)])
    (unless (and (!= head 0) (pair? head) (identifier? (car head))) (no-match f "(func (name param ...) . body)"))
    (let* ([name (car head)]
           [params (map (lambda ([p datum]) -> datum (param-of p phase)) (cdr head))]
           [types (map (lambda ([pp datum]) -> datum (parse-type (cadr pp) phase)) params)]
           [options (func-options (cddr l))]
           [inline (car options)] [value (cadr options)] [rest (caddr options)]
           [arrow (arrow-of rest phase)]
           [rb (parse-results (append arrow (list-tail rest (length arrow))) phase)]
           [results (car rb)]
           [ct (func-type-clause (cdr rb) types results phase)]
           [info (func-info (syntax-e name) types results 0 0 (cadr ct))])
      (bind-definition! name phase `(func ,info))
      (when (!= value 0) (hash-set! (& function-values) (cast u64 info) (cast u32 (keep (cons (cadr value) (make-integer phase))))))
      `(func ,name ,params ,arrow ,(caddr ct) ,f ,(car ct) ,inline ,value ,info))))

;; A parameter [name type], as (name type) with the type expanded.
(define (param-of [p datum] [phase i32]) -> datum
  (let ([l (syntax->list p)])
    (unless (and (!= l 0) (== (length l) 2) (identifier? (car l))) (no-match p "(name type)"))
    `(,(car l) ,(expand-type (cadr l) phase))))

;; An optional (type T) first in a func's body declares its function type
;; T, as in wasm (spec 5.2): the type other modules and ref.func see it
;; at. Its parameters and results must be T's. Returns (clause T body).
(define (func-type-clause [body datum] [params datum] [results datum] [phase i32]) -> datum
  (let ([first (if (pair? body) (syntax->list (car body)) 0)])
    (if (and (!= first 0) (== (length first) 2) (named? (car first) (sym type)))
        (let* ([tname (expand-type-name (cadr first) phase)] [t (type-of tname phase)])
          (unless (func-type? t) (fail-at (cadr first) "~a is not a function type" (list1 (type-info-name t))))
          (unless (and (types=? params (car (type-info-fields t))) (types=? results (cadr (type-info-fields t))))
            (fail-at (car body) "the function's parameters and results are not those of ~a" (list1 (type-info-name t))))
          `(,(syntax-rewrap (car body) `(,(car first) ,tname)) ,t ,(cdr body)))
        `(#f #f ,body))))

;; The body forms of a function or a lambda, each expanded with scope sc
;; added: (forms . whether they have closures, #t or #f).
(define (expand-scoped [body datum] [sc u32] [phase i32]) -> datum
  (let ([outer lowered-closures] [r datum 0] [flag 0])
    (set! lowered-closures 0)
    (set! r (map (lambda ([b datum]) -> datum (expand-expr (add-scope b sc) phase)) body))
    (set! flag lowered-closures)
    (set! lowered-closures outer)
    (cons r (boolean flag))))

;; (func (name [p t] ...) [-> r] body ...), expanded: its lowered form,
;; for the compiler, or its fully expanded form.
(define (expand-func [p datum] [phase i32]) -> datum
  (let* ([name (list-ref p 1)] [params (list-ref p 2)] [arrow (list-ref p 3)] [body (list-ref p 4)]
         [f (list-ref p 5)] [clause (list-ref p 6)] [inline (list-ref p 7)] [value (list-ref p 8)] [info (list-ref p 9)]
         [sc (new-local-scope!)]
         [xs (map (lambda ([pp datum]) -> datum (add-scope (car pp) sc)) params)]
         [keys (map (lambda ([x datum]) -> datum (bind-local! x phase)) xs)]
         [saved current-function] [r datum 0])
    (set! current-function (list1 name))
    (set! r (expand-scoped body sc phase))
    (set! current-function saved)
    (if to-syntax
        (let ([ps nil] [x xs] [k keys] [pp params])
          (while (pair? x)
            (set! ps (cons (out-list (car x) `(,(with-local-binding (car x) (car k)) ,(cadr (car pp)))) ps))
            (set! x (cdr x)) (set! k (cdr k)) (set! pp (cdr pp)))
          (list1 (out f (sym func)
                      `(,(out-list (cadr (syntax->list f)) (cons name (reverse ps)))
                        ,@(if (!= inline 0) (list1 inline) nil) ,@(if (!= value 0) value nil) ,@arrow
                        ,@(if (!= clause 0) (list1 (core-headed clause (sym type))) nil)
                        ,@(car r)))))
        (let ([ps nil] [k keys] [types (func-info-params info)] [code (seq-at f (car r))])
          (while (pair? k)
            (set! ps (cons (cons (car k) (car types)) ps))
            (set! k (cdr k)) (set! types (cdr types)))
          (set! ps (reverse ps))
          (when (!= inline 0) (note-inline! info ps code name))
          (when (!= value 0) (function-value info))
          (list1 `(func ,info ,ps ,code ,(cdr r)))))))

;; (global name type init) or (global name (mut type) init), as in wasm.
(define (declare-global [f datum] [phase i32]) -> datum
  (let ([l (syntax->list f)])
    (unless (and (!= l 0) (== (length l) 4) (identifier? (cadr l))) (no-match f "(global name type init)"))
    (let* ([name (cadr l)] [xt (expand-field-type (caddr l) phase)] [xl (syntax->list xt)]
           [info (if (and (!= xl 0) (== (length xl) 2) (named? (car xl) (sym mut)))
                     (global-info (syntax-e name) (parse-type (cadr xl) phase) (boolean 1) 0 0)
                     (global-info (syntax-e name) (parse-type xt phase) 0 0 0))])
      (bind-definition! name phase `(global ,info))
      `(global ,f ,xt ,info))))

(define (expand-global [p datum] [phase i32]) -> datum
  (let* ([l (syntax->list (cadr p))] [r (expand-noted (cadddr l) phase)])
    (if to-syntax
        (list1 (out (cadr p) (sym global) `(,(cadr l) ,(caddr p) ,(car r))))
        (list1 `(global ,(cadddr p) ,(car r) ,(cdr r))))))

;; Expression e expanded: (its code . whether it has closures).
(define (expand-noted [e datum] [phase i32]) -> datum
  (let ([outer lowered-closures] [r datum 0] [flag 0])
    (set! lowered-closures 0)
    (set! r (expand-expr e phase))
    (set! flag lowered-closures)
    (set! lowered-closures outer)
    (cons r (boolean flag))))

(define (closures-noted-expr [e datum] [phase i32]) -> datum (expand-noted e phase))

;; (import name "module" "field" (t ... -> r ...)), or with a function
;; type's name in place of the signature, to import the function at that
;; type (spec 5.2).
(define (declare-import [f datum] [phase i32]) -> datum
  (let ([l (syntax->list f)])
    (unless (and (!= l 0) (== (length l) 5) (identifier? (cadr l)) (string-literal? (caddr l)) (string-literal? (cadddr l)))
      (no-match f "(import name module field signature)"))
    (let* ([name (cadr l)] [module (caddr l)] [field (cadddr l)] [signature (list-ref l 4)]
           [ftype (if (identifier? signature)
                      (let ([t (type-of (expand-type-name signature phase) phase)])
                        (unless (func-type? t) (fail-at signature "~a is not a function type" (list1 (type-info-name t))))
                        t)
                      0)]
           [sig (if (!= ftype 0) (expand-type-name signature phase) (expand-signature signature phase))]
           [pr (if (!= ftype 0)
                   (cons (car (type-info-fields ftype)) (cadr (type-info-fields ftype)))
                   (parse-signature sig phase))])
      (bind-definition! name phase `(func ,(func-info (syntax-e name) (car pr) (cdr pr) (syntax-e module) (syntax-e field) ftype)))
      `(plain ,(out f (sym import) `(,name ,module ,field ,sig)) ()))))

;; (data name offset "bytes" ...): an active segment in the module's memory.
(define (declare-data [f datum] [phase i32]) -> datum
  (let ([l (syntax->list f)])
    (unless (and (!= l 0) (>= (length l) 3) (identifier? (cadr l)) (count-literal? (caddr l))
                 (andmap (lambda ([b datum]) -> i32 (string-literal? b)) (cdddr l)))
      (no-match f "(data name offset bytes ...)"))
    (let* ([bytes (make-buffer)] [parts (cdddr l)] [s datum 0])
      (while (pair? parts)
        (buffer-add! (& bytes) (string-bytes (syntax-e (car parts))) (string-length (syntax-e (car parts))))
        (set! parts (cdr parts)))
      (set! s (bytes->string (-> bytes bytes) (-> bytes length)))
      (buffer-free! (& bytes))
      (let ([info (data-info (syntax-e (cadr l)) (syntax-e (caddr l)) s)])
        (bind-definition! (cadr l) phase `(data ,info))
        `(plain ,(core-headed f (sym data)) ((data ,info)))))))

;; (tag name (t ...)): a tag, whose exceptions carry values of types t ...
;; (spec 5.2).
(define (declare-tag [f datum] [phase i32]) -> datum
  (let ([l (syntax->list f)])
    (unless (and (!= l 0) (== (length l) 3) (identifier? (cadr l)) (syntax? (caddr l)) (!= (syntax->list (caddr l)) 0))
      (no-match f "(tag name (type ...))"))
    (let* ([types (caddr l)] [xs (map (lambda ([t datum]) -> datum (expand-type t phase)) (syntax->list types))]
           [info (tag-info (syntax-e (cadr l)) (map (lambda ([t datum]) -> datum (parse-type t phase)) xs) 0 0)])
      (bind-definition! (cadr l) phase `(tag ,info))
      `(plain ,(out f (sym tag) `(,(cadr l) ,(syntax-rewrap types xs))) ((tag ,info))))))

(define (tag-info-of [id datum] [phase i32]) -> datum
  (let ([m (if (identifier? id) (meaning-of id phase) 0)])
    (unless (and (!= m 0) (== (car m) (sym tag))) (fail-at id "~s is not a tag" (list1 (syntax->datum id))))
    (cadr m)))

;; ---- require, provide, storage ----

;; (require name source item ...), where source is "path" or kernel (the
;; kernel module). Everything the source provides is bound as name:thing.
;; Each item also binds one thing unqualified: x as itself, or [new old] as
;; new. A require at phase p imports at phase p (spec 3.1).
;; (require-unqualified name source) is require with every name the source
;; provides also bound unqualified, with the scopes of name. It is meant
;; for a language's core forms, and little else (spec 3.1).
(define (require! [f datum] [phase i32] [all i32])
  (let ([l (syntax->list f)])
    (if all
        (unless (and (!= l 0) (== (length l) 3) (identifier? (cadr l)) (module-source? (caddr l)))
          (no-match f "(require-unqualified name source)"))
        (unless (and (!= l 0) (>= (length l) 3) (identifier? (cadr l)) (module-source? (caddr l)))
          (no-match f "(require name source item ...)")))
    (let* ([name (cadr l)] [source (caddr l)]
           [provided (cond [(string? (syntax-e source)) (require-module! f name source phase)]
                           [(pair? (syntax-e source)) (require-compiled! f name source phase)]
                           [else (require-kernel! name phase)])])
      (for-each (lambda ([p datum]) (bind-import! (qualified name (car p)) phase (cdr p))) provided)
      (when all
        (for-each (lambda ([p datum])
                    (hash-set! (& unqualified-imports)
                               (cast u64 (bind-import! (datum->syntax name (car p) name) phase (cdr p)))
                               1))
                  provided))
      (let ([items (cdddr l)])
        (while (pair? items)
          (let* ([item (car items)] [il (syntax->list item)]
                 [names (cond [(identifier? item) (cons item item)]
                              [(and (!= il 0) (== (length il) 2) (identifier? (car il)) (identifier? (cadr il))) (cons (car il) (cadr il))]
                              [else (no-match item "name or (new-name name)")])]
                 [old (cdr names)]
                 [ps (filter (lambda ([p datum]) -> i32 (== (car p) (syntax-e old))) provided)])
            (when (null? ps) (fail-at old "~a does not provide ~a" `(,(syntax-e source) ,(syntax-e old))))
            (for-each (lambda ([p datum]) (bind-import! (car names) phase (cdr p))) ps))
          (set! items (cdr items)))))))

;; A module's source in a require: a path, kernel, or (compiled file).
(define (module-source? [s datum]) -> i32
  (let ([l (syntax->list s)])
    (or (string-literal? s) (named? s (sym kernel))
        (and (!= l 0) (== (length l) 2) (named? (car l) (sym compiled)) (string-literal? (cadr l))))))

;; name:thing, with the scopes of name.
(define (qualified [name datum] [sym datum]) -> datum
  (datum->syntax name (string->symbol (format-message "~a:~a" `(,(syntax-e name) ,sym))) name))

(define (bind-import! [id0 datum] [phase i32] [meaning datum]) -> (ptr binding)
  (let ([id (session-binding-id id0 phase meaning)])
    (check-unbound! id phase meaning)
    (bind-module-level! (syntax-e id) (syntax-scopes id) phase meaning)))

(define (symbol<? [a datum] [b datum]) -> i32
  (let* ([x (symbol-bytes a)] [y (symbol-bytes b)] [n (symbol-length a)] [m (symbol-length b)]
         [c (memcmp x y (if (< n m) n m))])
    (or (< c 0) (and (== c 0) (< n m)))))

;; The kernel module's contract (spec 2.3), required as name at phase:
;; kernel.sub's functions and tags, sorted by name, from the running
;; compiler's instance, the same at every phase.
(define (require-kernel! [name datum] [phase i32]) -> datum
  (ensure-kernel!)
  (let* ([key (cons (syntax-e name) (make-integer phase))] [named (assoc key (-> current require-names))])
    (when (and (!= named 0) (!= (cdr named) kernel))
      (fail-at name "~a already names another module at this phase" (list1 (syntax-e name))))
    (when (== named 0) (set! (-> current require-names) (cons (cons key kernel) (-> current require-names))))
    (-> (unit-of kernel) provides)))

;; The file that require form f's source spec names. A relative path is
;; resolved from the file the spec is written in, or, if the spec has no
;; location, from the file f is in. So a require that a macro makes names
;; a file relative to the macro's own file.
(define (module-path-of [f datum] [spec datum]) -> datum
  (let* ([loc (if (!= (syntax-srcloc spec) 0) (syntax-srcloc spec) (syntax-srcloc f))]
         [dir (if (!= loc 0) (directory-of (symbol->string (-> loc source))) `"")]
         [given (syntax-e spec)])
    (if (absolute-path? given) given (string-append-2 dir given))))

;; Compile the module if needed and make its own bindings resolvable for
;; its macros. Returns what it provides, as seen from phase.
(define (require-module! [f datum] [name datum] [spec datum] [phase i32]) -> datum
  (require-unit! name (compile-module-file (module-path-of f spec)) phase))

;; (require name (compiled file) item ...): the entry of the compiled
;; file, loaded with its requires (spec 3.7).
(define (require-compiled! [f datum] [name datum] [spec datum] [phase i32]) -> datum
  (require-unit! name (load-compiled-file (canonical-path (module-path-of f (cadr (syntax-e spec))))) phase))

;; Module m, required as name at phase: recorded; what it provides, as
;; seen from phase. A module required at a phase above 0 comes with
;; compile-time code.
(define (require-unit! [name datum] [m datum] [phase i32]) -> datum
  (let* ([me (the-module)] [key (cons (syntax-e name) (make-integer phase))]
         [named (assoc key (-> current require-names))] [req (cons m (make-integer phase))])
    (when (and (!= named 0) (!= (cdr named) m))
      (fail-at name "~a already names another module at this phase" (list1 (syntax-e name))))
    (when (== named 0) (set! (-> current require-names) (cons (cons key m) (-> current require-names))))
    (when (== (member req (-> me requires)) 0)
      (set! (-> me requires) (keep (append (-> me requires) (list1 req))))
      (install-module-bindings! m (cast u32 phase)))
    (map (lambda ([p datum]) -> datum (cons (car p) (shift-meaning (cdr p) (cast u32 phase)))) (-> (unit-of m) provides))))

;; The module a require named at this phase.
(define (required-module [name datum] [phase i32]) -> datum
  (let ([named (if (identifier? name) (assoc (cons (syntax-e name) (make-integer phase)) (-> current require-names)) 0)])
    (when (== named 0) (fail-at name "~s is not the name of a module required at this phase" (list1 (syntax->datum name))))
    (cdr named)))

;; (provide item ...): x provides x, and [new old] provides old under the
;; name new; (all-from-out m) provides what module m, required at phase 0,
;; provides, and (except-out (all-from-out m) x ...) all that but the
;; names x ... (spec 3.1). Recorded as (name . id), resolved when the
;; module is done.
(define (provide! [f datum] [phase i32])
  (unless (== phase 0) (fail-at f "provide belongs at phase 0" nil))
  (let ([l (syntax->list f)] [items nil])
    (when (== l 0) (no-match f "(provide item ...)"))
    (for-each (lambda ([item datum]) (set! items (append items (provide-items item)))) (cdr l))
    (for-each (lambda ([item datum])
                (let ([earlier (let ([ids (-> current provide-ids)] [found datum 0])
                                 (while (and (pair? ids) (== found 0))
                                   (when (== (syntax-e (car (car ids))) (syntax-e (car item))) (set! found (car ids)))
                                   (set! ids (cdr ids)))
                                 found)])
                  (when (and (!= earlier 0) (!= (syntax-e (cdr earlier)) (syntax-e (cdr item))))
                    (fail-at (car item) "~a is provided twice, for ~a and for ~a"
                             `(,(syntax-e (car item)) ,(syntax-e (cdr earlier)) ,(syntax-e (cdr item)))))
                  (set! (-> current provide-ids) (cons item (-> current provide-ids)))))
              items)))

;; A provide item as a list of (name . id).
(define (provide-items [item datum]) -> datum
  (let ([l (syntax->list item)])
    (cond [(identifier? item) (list1 (cons item item))]
          [(and (!= l 0) (== (length l) 2) (named? (car l) (sym all-from-out))) (all-from-items (cadr l) nil)]
          [(and (!= l 0) (>= (length l) 2) (named? (car l) (sym except-out))
                (let ([inner (syntax->list (cadr l))]) (and (!= inner 0) (== (length inner) 2) (named? (car inner) (sym all-from-out))))
                (andmap (lambda ([x datum]) -> i32 (identifier? x)) (cddr l)))
           (all-from-items (cadr (syntax->list (cadr l))) (cddr l))]
          [(and (!= l 0) (== (length l) 2) (identifier? (car l)) (identifier? (cadr l))) (list1 (cons (car l) (cadr l)))]
          [else (no-match item "name, (all-from-out module), (except-out (all-from-out module) name ...) or (new-name name)")])))

;; What the module required as name provides, but the names excluded, as
;; provide items: each one's qualified binding, name:thing.
(define (all-from-items [name datum] [excluded datum]) -> datum
  (let* ([m (unit-of (required-module name 0))] [out (map (lambda ([x datum]) -> datum (syntax-e x)) excluded)]
         [syms nil] [ps (-> m provides)])
    (while (pair? ps)
      (when (== (memq (car (car ps)) syms) 0) (set! syms (cons (car (car ps)) syms)))
      (set! ps (cdr ps)))
    (for-each (lambda ([x datum])
                (when (== (memq (syntax-e x) syms) 0) (fail-at x "~a does not provide ~a" `(,(syntax-e name) ,(syntax-e x)))))
              excluded)
    (map (lambda ([sym datum]) -> datum (cons (datum->syntax name sym name) (qualified name sym)))
         (filter (lambda ([sym datum]) -> i32 (== (memq sym out) 0)) (reverse syms)))))

;; (memory pages) or (memory from name), and likewise (table ...): the
;; module's memory or table at this phase. name is a module required at
;; this phase (spec 3.3).
(define (declare-storage! [f datum] [phase i32])
  (let* ([l (syntax->list f)] [kind (syntax-e (car l))] [memory (== kind (sym memory))]
         [table (if memory (-> current memories) (-> current tables))] [form datum 0])
    (when (!= (assoc (make-integer phase) table) 0) (fail-at f "a second ~a declaration at this phase" (list1 kind)))
    (set! form (cond [(and (== (length l) 2) (count-literal? (cadr l))) `(,kind ,(syntax-e (cadr l)))]
                     [(and (== (length l) 3) (named? (cadr l) (sym from)))
                      (let ([m (required-module (caddr l) phase)])
                        `(,(if memory (sym memory-import) (sym table-import))
                          ,(if (== m kernel) kernel-instance (linklet-name m 0 phase))))]
                     [else (no-match f (if memory "(memory size) or (memory from module)" "(table size) or (table from module)"))]))
    (if memory
        (set! (-> current memories) (cons (cons (make-integer phase) form) (-> current memories)))
        (set! (-> current tables) (cons (cons (make-integer phase) form) (-> current tables))))))

;; Instance names (spec 3.2): "<module>@<phase>+<shift>" for a module's
;; linklet at a phase shift. The compiler reads a name back only through
;; this table: name, a symbol -> (module phase shift).
(define instance-refs hash-table)

;; The name of module m's phase-q linklet at phase shift t.
(define (linklet-name [m datum] [q i32] [t i32]) -> datum
  (let* ([name (format-message "~a@~a+~a" `(,(-> (unit-of m) name) ,(make-integer q) ,(make-integer t)))]
         [key (cast u64 (string->symbol name))])
    (when (== (hash-ref (& instance-refs) key) 0)
      (hash-set! (& instance-refs) key (cast u32 (keep `(,m ,(make-integer q) ,(make-integer t))))))
    name))

;; The module linklet an instance name names, as (module phase shift), or
;; #f. The table also names compile-time linklets, as (module phase).
(define (linklet-ref [name datum]) -> datum
  (let ([r (cast datum (hash-ref (& instance-refs) (cast u64 (string->symbol name))))])
    (if (and (!= r 0) (pair? (cddr r))) r 0)))

;; The module whose linklet the instance named name is, or #f: the kernel
;; module's is its unit, unless kernel.sub compiled from source has the
;; name (kernel-infos).
(define (instance-unit [name datum]) -> datum
  (let ([r (linklet-ref name)])
    (cond [(!= r 0) (car r)]
          [(kernel-name? name) kernel]
          [else 0])))

;; (freestanding): after expansion, the program needs nothing beyond the
;; host at run time (spec 3.4).
(define (freestanding! [f datum] [phase i32])
  (let ([l (syntax->list f)])
    (unless (and (!= l 0) (== (length l) 1)) (no-match f "(freestanding)"))
    (unless (== phase 0) (fail-at f "(freestanding) belongs at phase 0" nil))
    (set! (-> current freestanding-form) f)))

;; ==== compile-time evaluation ====
;;
;; A module's compile-time code runs while the module is expanded. Each
;; begin-for-syntax, and each define-syntax whose value needs code to run,
;; is compiled into a linklet and instantiated in the module's
;; compile-time store (spec 3.2), after the linklets of the modules it
;; requires. The same code also goes into the module's linklet for that
;; phase. The compile-time store is a namespace inside the compiler's own
;; store; the running compiler's instances, including the kernel module,
;; are outside it ("the kernel module", above).

;; The name of the next compile-time linklet of module m's phase q.
(define (next-linklet-name! [m datum] [q i32]) -> datum
  (let ([name (format-message "~a@~a#~a" `(,(-> (unit-of m) name) ,(make-integer q) ,(make-integer (-> current linklet-counter))))])
    (+= (-> current linklet-counter) 1)
    (hash-set! (& instance-refs) (cast u64 (string->symbol name)) (cast u32 (keep `(,m ,(make-integer q)))))
    name))

;; Instance name, in the namespace of the module being compiled.
(define (ns-name [name datum]) -> datum (format-message "~a/~a" `(,(-> current ns) ,name)))

;; Is the instance named name one of a namespace: a module's linklet or a
;; compile-time linklet? The running compiler's, the kernel module's among
;; them, and the host's are the store's own.
(define (namespaced? [name datum]) -> i32
  (and (== (group-instance name) 0) (!= (hash-ref (& instance-refs) (cast u64 (string->symbol name))) 0)))

(define (integer-at [l datum] [n u32]) -> i32 (cast i32 (integer-value (list-ref l n))))

;; What a linklet's imports link to when it is instantiated at phase shift
;; t: each (import . instance) for the module names its code imports from
;; that are linklets. A linklet of the kernel module's group is the running
;; build's at any shift (kernel-group); another module linklet's name,
;; relative to shift 0, moves by t; a compile-time linklet is in the
;; namespace; the others keep their names.
(define (import-map [imports datum] [t u32]) -> datum
  (let ([out nil] [r datum 0] [g datum 0])
    (while (pair? imports)
      (set! g (group-instance (car imports)))
      (set! r (if (!= g 0) 0 (cast datum (hash-ref (& instance-refs) (cast u64 (string->symbol (car imports)))))))
      (cond [(!= g 0) (set! out (cons (cons (car imports) g) out))]
            [(== r 0) 0]
            [(pair? (cddr r))
             (set! out (cons (cons (car imports) (ns-name (linklet-name (car r) (integer-at r 1) (+ (integer-at r 2) (cast i32 t))))) out))]
            [else (set! out (cons (cons (car imports) (ns-name (car imports))) out))])
      (set! imports (cdr imports)))
    out))

;; Make sure the instance an import names exists: imp is relative to a
;; linklet instantiated at phase shift shift.
(define (ensure-import! [imp datum] [shift u32])
  (let ([r (if (!= (group-instance imp) 0) 0 (linklet-ref imp))])
    (when (!= r 0) (ensure-linklet! (car r) (integer-at r 1) (+ (cast u32 (integer-at r 2)) shift)))))

;; Instantiate module m's phase-q linklet at phase shift t, dependencies
;; first.
(define (ensure-linklet! [m datum] [q i32] [t u32])
  (let* ([name (ns-name (linklet-name m q (cast i32 t)))] [key (cast u64 (string->symbol name))] [p (ptr linklet) 0])
    (when (== (table-ref (-> current instances) key) 0)
      (set! p (linklet-of m q))
      (when (== p 0) (fail-at 0 "internal: ~a has no phase ~a linklet" `(,(-> (unit-of m) name) ,(make-integer q))))
      (for-each (lambda ([imp datum]) (ensure-import! imp t)) (-> p imports))
      (instantiate! name (-> p bytes) (-> p imports) (-> p scopes) t 0)
      (table-set! (-> current instances) key 1))))

;; Instantiate bytes as the instance named name, its imports linked as
;; import-map says for phase shift t, while the kernel module maps the
;; linklet's scope table, scopes, to the run's scopes at t (spec 3.5). If
;; that fails, the compile error is at where, the code it comes from.
(define (instantiate! [name datum] [bytes datum] [imports datum] [scopes datum] [t u32] [where datum])
  (let ([m (make-buffer)] [map (import-map imports t)] [ok i32 0])
    (while (pair? map)
      (buffer-add! (& m) (string-bytes (car (car map))) (string-length (car (car map))))
      (buffer-add-byte! (& m) 0)
      (buffer-add! (& m) (string-bytes (cdr (car map))) (string-length (cdr (car map))))
      (buffer-add-byte! (& m) 0)
      (set! map (cdr map)))
    (set-scope-map! (scope-map-of scopes t) (length scopes))
    (try (set! ok (instantiate-bytes (string-bytes name) (string-length name) (string-bytes bytes) (string-length bytes)
                                     (-> m bytes) (-> m length)))
         [catch compile-error (message blamed loc)
          (set-scope-map! 0 0)
          (buffer-free! (& m))
          (throw compile-error message blamed loc)])
    (set-scope-map! 0 0)
    (buffer-free! (& m))
    (unless ok
      (if session-running
          (fail-at where "~a" (list1 (session-failure (host-error))))
          (fail-at where "compile-time code failed: ~a" (list1 (host-error)))))))

;; The run's scope for each index of a linklet's scope table, at phase
;; shift t: a module scope, module X's copy for phase shift s, becomes X's
;; copy for s + t, which shifts the literals of a linklet instantiated at a
;; phase shift (spec 6.1); any other scope is itself.
(define (scope-map-of [scopes datum] [t u32]) -> (ptr u32)
  (let ([p (cast (ptr u32) (alloc-in (current-arena) (* 4 (+ (length scopes) 1))))] [i u32 0] [sc u32 0] [o datum 0])
    (while (pair? scopes)
      (set! sc (cast u32 (integer-value (car scopes))))
      (set! o (scope-origin sc))
      (set! (@ p i) (if (!= o 0) (module-scope-at (car o) (+ (cast u32 (integer-value (cdr o))) t)) sc))
      (+= i 1)
      (set! scopes (cdr scopes)))
    p))

;; The host's message for its last failure.
(define (host-error) -> datum
  (let* ([p (cast (ptr u8) (alloc-in (current-arena) 2048))] [n (error-message p 2048)])
    (bytes->string p n)))

;; Compile forms as the linklet named name and instantiate it, after what
;; it imports. A trap is reported at where.
(define (instantiate-linklet! [name datum] [forms datum] [where datum])
  (set-current-source! (module-source))
  (let ([compiled (compile-module forms name)])
    (for-each (lambda ([imp datum]) (ensure-import! imp 0)) (cadr compiled))
    (instantiate! (ns-name name) (car compiled) (cadr compiled) (cadddr compiled) 0 where)
    (table-set! (-> current instances) (cast u64 (string->symbol (ns-name name))) 1)))

;; A linklet of this module's phase-phase code, run now, as each
;; begin-for-syntax is. Its code also goes into the module's linklet of
;; that phase.
(define (run-compile-time-linklet! [forms datum] [phase i32] [where datum])
  (check-phase-data! forms phase where)
  (add-phase-forms! phase forms)
  (let ([name (next-linklet-name! (-> current module) phase)])
    (instantiate-linklet! name (append (linklet-storage-forms phase name) forms) where)))

;; Adds `forms` to the code that will be compiled into the module's
;; linklet for `phase`. A session skips this: its inputs are compiled and
;; run straight away, and it never produces a linklet per phase.
(define (add-phase-forms! [phase i32] [forms datum])
  (unless (in-session?)
    (let ([e (assoc (make-integer phase) (-> current phase-forms))])
      (if (!= e 0)
          (set-cdr! e (append (reverse forms) (cdr e)))
          (set! (-> current phase-forms) (cons (cons (make-integer phase) (reverse forms)) (-> current phase-forms)))))))

;; The memory and table forms for a compile-time linklet at phase, named
;; name (spec 3.3). A phase's linklets share one memory: the first linklet
;; after (memory pages) defines it, and later ones import it from that
;; linklet. Tables likewise.
(define (linklet-storage-forms [phase i32] [name datum]) -> datum
  (let ([out nil] [kinds `(memory table)] [form datum 0] [owner datum 0])
    (while (pair? kinds)
      (set! form (storage-form (car kinds) phase))
      (set! owner (assoc (cons (car kinds) (make-integer phase)) (-> current storage-linklets)))
      (cond [(== form 0) 0]
            [(!= (car form) (car kinds)) (set! out (cons form out))]
            [(!= owner 0)
             (set! out (cons `(,(if (== (car kinds) (sym memory)) (sym memory-import) (sym table-import)) ,(cdr owner)) out))]
            [else
             (set! (-> current storage-linklets) (cons (cons (cons (car kinds) (make-integer phase)) name) (-> current storage-linklets)))
             (set! out (cons form out))])
      (set! kinds (cdr kinds)))
    (reverse out)))

;; The index in the compiler's table of function info, whose instance is
;; made if need be.
(define (function-index [info datum]) -> i32
  (let* ([instance (func-info-instance info)] [export (func-info-export info)] [target datum 0] [i i32 -1])
    (ensure-import! instance 0)
    (set! target (let ([g (group-instance instance)]) (cond [(!= g 0) g] [(namespaced? instance) (ns-name instance)] [else instance])))
    (set! i (export-index (string-bytes target) (string-length target) (string-bytes export) (string-length export)))
    (when (< i 0) (fail-at 0 "internal: no function ~a in ~a" `(,export ,instance)))
    i))

;; A compile-time value, from its getter function. Fetched when first
;; needed.
(define (compile-time-value [getter datum]) -> datum
  (let ([cached (cast datum (table-ref (-> current values) (cast u64 getter)))] [v datum 0])
    (if (!= cached 0)
        (car cached)
        (let ([f (cast (fn () -> datum) (function-index getter))])
          (set! v (f))
          (table-set! (-> current values) (cast u64 getter) (cast u32 (cons v nil)))
          v))))

;; The transformer meaning m is bound to, if m is a compile-time value
;; that is a transformer; otherwise #f.
(define (transformer-of [m datum]) -> datum
  (if (and (!= m 0) (== (car m) (sym compile-time-value)))
      (let ([v (compile-time-value (cadr m))]) (if (transformer? v) v 0))
      0))

;; (define-syntax name expr): name is bound to expr's value at phase+1, a
;; datum in memory, a compile-time value, which macros read with
;; syntax-local-value; if the value is a transformer, name is a macro.
;; In (define-syntax name f), where f names a phase+1 function of type
;; (i32) -> i32, the value is a transformer that calls f. The value lives
;; in a global of the phase+1 linklet, computed when the linklet is
;; instantiated; while this module is expanded, it is computed now, and
;; only new code is compiled for it (spec 3.1). A value that needs none, a
;; transformer that calls f or what plain? accepts, the expander makes
;; itself; any other is compiled and run now.
(define (define-syntax! [f datum] [phase i32])
  (let ([l (syntax->list f)])
    (unless (and (!= l 0) (== (length l) 3) (identifier? (cadr l))) (no-match f "(define-syntax id rhs)"))
    (let* ([id (cadr l)] [rhs (caddr l)]
           [m (if (identifier? rhs) (meaning-of rhs (+ phase 1)) 0)]
           [name (string->symbol (format-message "__value.~a" (list1 (syntax-e id))))]
           [function (if (and (!= m 0) (== (car m) (sym func))) (syntax-function-of rhs phase) 0)]
           [init datum 0] [global datum 0] [getter datum 0] [forms datum 0] [saved to-syntax])
      (if (!= function 0)
          (set! init `(call ,(kernel-function (sym make-function-transformer)) ((func-index ,function))))
          (begin
            (set! to-syntax 0)
            (set! init (expand-expr rhs (+ phase 1)))
            (set! to-syntax saved)
            (when (gc-value? init)
              (fail-at rhs "the value of ~a is a GC value, but a compile-time value must be a datum, an i32 (spec 6.3)"
                       (list1 (syntax-e id))))))
      (set! global (global-info name (sym i32) (boolean 1) 0 0))
      (set! getter (func-info name nil `(i32) 0 0 0))
      (set! forms `((global ,global ,init) (func ,getter () (gref ,global))))
      (cond [(and (!= function 0) (callable? function 1))
             (add-phase-forms! (+ phase 1) forms)
             (made-value! getter (make-function-transformer (cast u32 (function-index function))))]
            [(and (== function 0) (plain? init))
             (add-phase-forms! (+ phase 1) forms)
             (made-value! getter (plain-value init rhs))]
            [else (run-compile-time-linklet! forms (+ phase 1) f)])
      (hash-set! (& macro-modules) (cast u64 getter) (cast u32 (-> current module)))
      (bind-definition! id phase `(compile-time-value ,getter)))))

;; The define-syntax getter of each macro -> the module that defines it.
(define macro-modules hash-table)

;; Is lowered expression e plainly a GC value, not a datum in memory: a
;; closure, or what a function of another result gives?
(define (gc-value? [e datum]) -> i32
  (cond [(or (== (car e) (sym at)) (== (car e) (sym as))) (gc-value? (caddr e))]
        [(== (car e) (sym lambda)) 1]
        [(== (car e) (sym call)) (not (equal? (func-info-results (cadr e)) `(i32)))]
        [else 0]))

;; ---- values the expander makes (spec 3.1) ----

;; The compile-time value of getter, made by the expander: the getter,
;; whose unit is not compiled until the module's linklet is, is never
;; called in this compilation.
(define (made-value! [getter datum] [v datum])
  (table-set! (-> current values) (cast u64 getter) (cast u32 (cons v nil))))

;; Can the expander make the value of lowered expression e itself, with no
;; new code? Quoted data can, and so can a call, on such values, of an
;; instantiated function from data to a datum.
(define (plain? [e datum]) -> i32
  (cond [(== (car e) (sym at)) (plain? (caddr e))]
        [(== (car e) (sym quote)) 1]
        [(== (car e) (sym call))
         (and (callable? (cadr e) (length (caddr e))) (andmap (lambda ([a datum]) -> i32 (plain? a)) (caddr e)))]
        [else 0]))

;; Can the expander call function info with n data: is it instantiated,
;; from data to a datum, and are there few enough for call-function?
(define (callable? [info datum] [n u32]) -> i32
  (let ([ps (func-info-params info)])
    (unless (and (!= (func-info-instance info) 0) (<= n 6) (== (length ps) n) (equal? (func-info-results info) `(i32)))
      (return 0))
    (while (pair? ps)
      (unless (== (car ps) (sym i32)) (return 0))
      (set! ps (cdr ps)))
    1))

;; The value of lowered expression e, which plain? accepts. While its calls
;; run, a trap in them is reported at where, the code they come from.
(define (plain-value [e datum] [where datum]) -> datum
  (cond [(== (car e) (sym at)) (plain-value (caddr e) where)]
        [(== (car e) (sym quote)) (cadr e)]
        [else
         (let ([args (map (lambda ([a datum]) -> datum (plain-value a where)) (caddr e))] [saved api-where] [v datum 0])
           (set! api-where where)
           (set! v (call-function (function-index (cadr e)) args))
           (set! api-where saved)
           v)]))

;; The function at index in the compiler's table, of as many data as args
;; holds, called with them.
(define (call-function [index i32] [args datum]) -> datum
  (let ([n (length args)] [a datum 0] [b datum 0] [c datum 0] [d datum 0] [e datum 0] [g datum 0])
    (when (> n 0) (set! a (list-ref args 0)))
    (when (> n 1) (set! b (list-ref args 1)))
    (when (> n 2) (set! c (list-ref args 2)))
    (when (> n 3) (set! d (list-ref args 3)))
    (when (> n 4) (set! e (list-ref args 4)))
    (when (> n 5) (set! g (list-ref args 5)))
    (case n
      [(0) (let ([f (cast (fn () -> datum) index)]) (f))]
      [(1) (let ([f (cast (fn (datum) -> datum) index)]) (f a))]
      [(2) (let ([f (cast (fn (datum datum) -> datum) index)]) (f a b))]
      [(3) (let ([f (cast (fn (datum datum datum) -> datum) index)]) (f a b c))]
      [(4) (let ([f (cast (fn (datum datum datum datum) -> datum) index)]) (f a b c d))]
      [(5) (let ([f (cast (fn (datum datum datum datum datum) -> datum) index)]) (f a b c d e))]
      [else (let ([f (cast (fn (datum datum datum datum datum datum) -> datum) index)]) (f a b c d e g))])))

;; The phase+1 function id names, checked to take and return syntax and
;; to be defined already: a transformer.
(define (syntax-function-of [id datum] [phase i32]) -> datum
  (let ([m (meaning-of id (+ phase 1))] [info datum 0])
    (unless (and (!= m 0) (== (car m) (sym func)))
      (fail-at id "~a is not a function at phase ~a" `(,(syntax-e id) ,(make-integer (+ phase 1)))))
    (set! info (cadr m))
    (when (equal? (func-info-params info) (list1 eqref))
      (fail-at id "~a takes an eqref, but a transformer takes syntax as a datum, an i32 (spec 2.1)"
               (list1 (syntax-e id))))
    (unless (and (equal? (func-info-params info) `(i32)) (equal? (func-info-results info) `(i32)))
      (fail-at id "a transformer takes one i32 (syntax) and returns one i32" nil))
    (when (== (func-info-instance info) 0)
      (fail-at id "~a must be defined by an earlier begin-for-syntax" (list1 (syntax-e id))))
    info))

;; (begin-for-syntax form ...): phase+1 code, compiled into a linklet and
;; run now (spec 3.1).
(define (begin-for-syntax! [f datum] [phase i32])
  (let ([forms (cdr (form-list f "(begin-for-syntax form ...)"))] [saved to-syntax] [code datum 0])
    (set! to-syntax 0)
    (set! code (expand-body forms (+ phase 1)))
    (set! to-syntax saved)
    (run-compile-time-linklet! code (+ phase 1) f)))

;; After a trap, which wasm code cannot catch, the host calls the
;; compiler's on-trap (spec 4). A trap unwinds without restoring the state
;; below, so it still says what was running: the report, a line, is at
;; where the running macro or other compile-time function was used, or
;; else in the module being compiled.
(define (trap-report) -> datum
  (let ([msg (host-error)] [loc (if (syntax? api-where) (syntax-srcloc api-where) 0)])
    (cond [(!= loc 0)
           (format-message "~a:~a:~a: error: ~a\n"
                           `(,(-> loc source) ,(make-integer (-> loc line)) ,(make-integer (+ (-> loc col) 1)) ,msg))]
          [(!= current 0) (format-message "~a: error: ~a\n" `(,(-> (the-module) path) ,msg))]
          [else (format-message "error: ~a\n" (list1 msg))])))

;; ---- facts (spec 6.5) ----

;; (#%fact id 'datum) or (#%fact id #'stx): the datum, or the syntax as
;; quote-syntax keeps it (spec 6.2), recorded as a fact about the
;; definition id refers to at phase: data the module keeps. The form, as
;; fully expanded code holds it.
(define (fact! [f datum] [phase i32]) -> datum
  (let ([l (syntax->list f)])
    (unless (and (!= l 0) (== (length l) 3) (identifier? (cadr l)))
      (fail-at f "expected (#%fact id 'datum) or (#%fact id #'syntax)" nil))
    (let* ([id (cadr l)] [written (caddr l)]
           [key (fact-key id phase)]
           [kind (fact-quote written)]
           [d (cadr (syntax->list written))]
           [value (if (== kind (sym quote)) (syntax->datum d) (prune-local-scopes d))]
           [fact `(,key ,(make-integer phase) ,value)]
           [m (the-module)])
      (set! (-> m facts) (keep-cons fact (-> m facts)))
      (index-fact! (-> m self) fact)
      (core-headed f (sym #%fact)))))

;; The facts of every module compiled, by the definition each is about:
;; definition -> ((module phase value) ...), the latest first.
(define facts-by-key hash-table)

(define (index-fact! [m datum] [f datum])
  (let ([k (cast u64 (car f))])
    (hash-set! (& facts-by-key) k (cast u32 (keep-cons (cons m (cdr f)) (cast datum (hash-ref (& facts-by-key) k)))))))

;; (cons x l) in the run's arena, x kept, for l a list already kept, which
;; is not copied again: keep of the whole would copy it at each cons.
(define (keep-cons [x datum] [l datum]) -> datum
  (let* ([k (keep x)] [saved (use-arena (& run-arena))] [p (cons k l)])
    (use-arena saved)
    p))

;; What a fact is written with, quote or quote-syntax, by name: whether
;; it records a datum or syntax. The position holds data, not an
;; expression, so a module that binds quote to a form of its own, as
;; Substrate does, writes its facts as any module does.
(define (fact-quote [written datum]) -> datum
  (let* ([l (syntax->list written)]
         [kind (if (and (!= l 0) (== (length l) 2) (identifier? (car l))) (syntax-e (car l)) 0)])
    (unless (!= (memq kind `(quote quote-syntax)) 0)
      (fail-at written "a fact is a datum or syntax: expected (#%fact id 'datum) or (#%fact id #'syntax)" nil))
    kind))

;; The definition meaning m is of, if it is a module's: the info of its
;; function, global or tag, or the getter of its compile-time value;
;; otherwise #f. Core forms, locals and the kernel module's definitions,
;; which every language shares, are none.
(define (definition-of [m datum]) -> datum
  (let ([info (if (and (!= m 0) (!= (memq (car m) `(func global tag compile-time-value)) 0)) (base-info (cadr m)) 0)])
    (if (and (!= info 0) (not (kernel-definition? info))) info 0)))

(define (kernel-definition? [info datum]) -> i32 (!= (hash-ref (& kernel-infos) (cast u64 info)) 0))

;; The definition id refers to at phase, which a fact is about.
(define (fact-key [id datum] [phase i32]) -> datum
  (let* ([m (meaning-of id phase)] [base (definition-of m)])
    (when (== m 0) (fail-at id "~a is unbound: a fact is about a definition made before it" (list1 (syntax-e id))))
    (when (== base 0) (fail-at id "a fact is about a module's definition, and ~a is not one" (list1 (syntax-e id))))
    base))

;; The types and definitions in module m's lowered forms: its types in
;; order, and its functions, globals and tags, newest first.
(define (note-definitions! [m datum] [forms datum])
  (let ([u (unit-of m)])
    (for-each (lambda ([f datum])
                (case (car f)
                  [((sym type)) (set! (-> u types) (keep-cons (cadr f) (-> u types))) (own-type! m (cadr f))]
                  [((sym func) (sym global) (sym tag)) (set! (-> u infos) (keep-cons (cadr f) (-> u infos)))]))
              forms)))

;; ==== sessions ====
;;
;; A session compiles and runs code one piece at a time, as a REPL does.
;; `bin/sub eval FILE` uses it, and so does the REPL web page
;; (lib/web/repl).
;;
;; How it works. A session is like a module whose source arrives in
;; pieces, called inputs. Each input is compiled into a wasm module of its
;; own (a "linklet"), which is instantiated at once, in the compiler's own
;; store: the set of wasm instances that the compiler itself runs in.
;; This is the mechanism the compiler already uses to run macros and other
;; compile-time code (see "compile-time evaluation" above). The difference
;; is that a session also runs ordinary run-time code (phase 0) this way.
;; For a normal module, phase-0 code is only compiled into the program; the
;; compiler never runs it.
;;
;; Two consequences:
;;   - A session has no language of its own. As in a file, the language
;;     is whatever the inputs `require`. The compiler treats an input just
;;     like the text of a file.
;;   - An input's code uses the compiler's memory and function table,
;;     unless the session declares its own (see running-storage). It is
;;     therefore exactly as trusted as the compiler: it can call or
;;     overwrite anything in it. To run code that is not trusted, run the
;;     whole compiler in a sandbox, as lib/web/repl does (lib/web/guest.sub).
;;
;; Definitions and redefinitions. Each input is expanded as a body of its
;; own (expand-body), so its forms can refer to each other and to what
;; earlier inputs defined. A later input may define a name again. That
;; must not disturb code that was compiled earlier, so bindings are
;; recorded as follows (using the "sets of scopes" model of binding):
;;   - Every input gets a fresh scope, which is added to all of its forms.
;;   - Normally a definition made by an input is recorded WITHOUT that
;;     scope, so that later inputs, which do not have the scope, see it.
;;   - If an earlier input already defined the same name as something
;;     else, the new definition is recorded WITH the input's scope, and
;;     from then on that scope is added to every later input too. Later
;;     inputs therefore see the new definition, while code compiled
;;     earlier keeps referring to the old one.
;;   - Defining a name twice within one input is an error, as it is in a
;;     module.
;; So the number of scopes grows with the number of redefinitions, not
;; with the number of inputs. (An earlier version kept a scope for every
;; input; a session of 1,600 inputs then took 50 seconds.)
;;
;; Printing values. When an input contains an expression e, the compiler
;; rewrites it to (#%top-interaction e) if the name #%top-interaction is
;; bound to a macro in the session's language. That macro decides what to
;; do with the value, usually print it. (A function call becomes
;; (#%app f arg ...) by the same convention; see spec 5.3.) If there is no
;; such macro, the expression is simply run.
;;
;; Errors. If an input fails, the session is left as it was before the
;; input, except for whatever the input's code had already done when it
;; failed. An input can fail in three ways:
;;   - a compile error;
;;   - a wasm exception that escapes the input's code;
;;   - a trap in the input's code. The host reports a trap as a failed
;;     `instantiate` call, so the compiler sees an ordinary error.
;; One case is different: a trap inside a macro, which is code that the
;; compiler calls directly. That unwinds the compiler's own stack all the
;; way out to the host. The host then calls the program's on-trap
;; function, and that function must call session-recover! to make the
;; session usable again.

;; The state of the open session. There is at most one.
;;   session             the session's compilation state (a comp), or 0 if
;;                       no session is open
;;   session-mark        marks the session's memory arena; session-recover!
;;                       frees every module arena opened after it
;;                       (kernel.sub)
;;   session-set         the scopes that are added to every input's forms
;;   session-scope       the fresh scope of the input being evaluated, or 0
;;                       between inputs
;;   session-scope-kept  1 if the current input made a definition that
;;                       kept its scope (that is, a redefinition)
;;   session-first-key   a binding key taken when the current input began;
;;                       a binding with a larger key was made by this
;;                       input
;;   session-source      the source name of the current input (a symbol),
;;                       used in error locations
;;   session-message     the error message of the last input that failed
;;                       (a string)
;;   session-running     1 while an input's compiled code is being
;;                       instantiated, that is, run
;;   interacting         1 while the result of a #%top-interaction macro is
;;                       being processed

(define session (ptr comp) 0)
(define session-mark (ptr void) 0)
(define session-set (ptr scope-set) 0)
(define session-scope u32 0)
(define session-scope-kept i32 0)
(define session-first-key i64 0)
(define session-source datum 0)
(define session-message datum 0)
(define session-running i32 0)
(define interacting i32 0)

;; Returns 1 if the code being compiled right now is a session input
;; itself, and not a module that an input requires.
(define (in-session?) -> i32 (and (!= session 0) (== current session)))

;; Returns the source name (a symbol) to record in the source locations of
;; the code being compiled (spec 3.6): the module's file, or, in a
;; session, the source of the current input.
(define (module-source) -> datum (if (in-session?) session-source (string->symbol (-> (the-module) path))))

;; Opens a session called `name` (a string). The name appears in the names
;; of the linklets compiled for the session's inputs. It also stands in
;; for the session's file name when an input requires a file by a relative
;; path, so such paths are relative to the package root.
;;
;; If a session is already open, it is abandoned: the new session replaces
;; it, and the old one's memory is not freed.
(define (session-open! [name datum])
  (let ([m (new-unit name (provisional-name name))])
    (begin-module-arena)
    (set! session-mark (module-arena-mark))
    (set! current (new-comp m))
    (set! session current)
    (install-base!)
    (let ([msc (new-scope!)])
      (set! (-> (the-module) scope) msc)
      (hash-set! (& module-scope-origins) (scope-key msc) (cast u32 (keep (cons (-> (the-module) self) (make-integer 0)))))
      (set! session-set (scopes-change core-scopes msc 0)))
    (set! to-syntax 0)))

;; Chooses the identifier under which a module-level definition is
;; recorded. `id` is the name being defined, at `phase`, with the meaning
;; `meaning`.
;;
;; Outside a session, or for a name that does not carry the current
;; input's scope, the result is `id` itself. In a session, the current
;; input's scope is removed, so that later inputs can see the definition.
;; The exception is a redefinition: if an earlier input bound the name to
;; something else, the scope is kept (see the section comment above).
(define (session-binding-id [id datum] [phase i32] [meaning datum]) -> datum
  (if (and (in-session?) (!= session-scope 0) (!= (scopes-change (syntax-scopes id) session-scope 1) (syntax-scopes id)))
      (let ([base (remove-scope id session-scope)])
        (if (bound-earlier? base phase meaning)
            (begin (set! session-scope-kept 1) id)
            base))
      id))

;; Returns 1 if an earlier input bound `id` (at the same phase, with the
;; same scopes, in the same namespace) to something other than `meaning`.
;;
;; Binding keys increase over time, so a binding whose key is greater than
;; session-first-key was made by the current input. Finding one of those
;; makes this return 0. The definition is then treated as a duplicate
;; within one input, which is reported as an error ("already bound"), just
;; as in a module.
(define (bound-earlier? [id datum] [phase i32] [meaning datum]) -> i32
  (let ([b (bindings-under (syntax-e id) (binding-slot (syntax-scopes id)))] [found i32 0])
    (while (!= b 0)
      (when (and (== (-> b phase) phase) (== (-> b scopes) (syntax-scopes id))
                 (== (-> b namespace) (meaning-namespace meaning))
                 (not (equal? (-> b meaning) meaning)))
        (when (> (integer-value (-> b key)) session-first-key) (return 0))
        (set! found 1))
      (set! b (-> b next)))
    found))

;; Removes the module-level bindings that the session's module made after
;; `entries` (a saved position in the module's list of bindings). Used to
;; undo the definitions of an input that failed.
(define (session-unbind! [entries (ptr module-entry)])
  (let ([e (-> (the-module) entries)])
    (while (and (!= e 0) (!= e entries))
      (let* ([b (-> e binding)] [k (slot-key (-> e symbol) (binding-slot (-> b scopes)))]
             [c (cast (ptr binding) (hash-ref (& bindings) k))] [before (ptr binding) 0])
        (while (and (!= c 0) (!= c b))
          (set! before c)
          (set! c (-> c next)))
        (when (!= c 0)
          (if (== before 0) (hash-set! (& bindings) k (cast u32 (-> b next))) (set! (-> before next) (-> b next)))))
      (set! e (-> e next)))
    (set! (-> (the-module) entries) entries)))

;; Evaluates `forms` (syntax, as the reader returns it) as the session's
;; next input. Returns 1 on success. On failure, returns 0, and
;; (session-error) gives the message.
;;
;; After a failure, everything the input declared for the session is
;; undone: its bindings, the names of the modules it required, and its
;; memory and table declarations. This is done by restoring `was`, a copy
;; of the session's comp struct taken before the input. Only the linklet
;; counter is kept, so that a linklet name is never used twice.
(define (session-eval! [forms datum]) -> i32
  (let* ([sc (new-scope!)] [scopes (scopes-change session-set sc 0)] [entries (-> (the-module) entries)] [ok i32 0]
         [was comp (@ session)])
    (set! session-scope sc)
    (set! session-scope-kept 0)
    (set! session-first-key (integer-value (fresh-key!)))
    (set! session-source (if (and (pair? forms) (!= (syntax-srcloc (car forms)) 0))
                             (-> (syntax-srcloc (car forms)) source)
                             (string->symbol (-> (the-module) path))))
    (try
      (run-session-linklet! (expand-body (map (lambda ([f datum]) -> datum (add-scopes f scopes)) forms) 0))
      (set! ok 1)
      [catch compile-error (message blamed loc) (session-fail! message blamed loc)]
      [catch-all (session-fail! `"an exception escaped the input's code" 0 0)])
    (if ok
        (when session-scope-kept (set! session-set scopes))
        (let ([n (-> session linklet-counter)])
          (session-unbind! entries)
          (set! (@ session) was)
          (set! (-> session linklet-counter) n)))
    (set! session-scope 0)
    ok))

;; Reads `text` (a string) and evaluates the forms in it as one input.
;; `source` (a string) is the name given to the input in source locations.
;; Returns 1 or 0, as session-eval! does.
(define (session-eval-text! [text datum] [source datum]) -> i32
  (let ([forms datum 0] [ok i32 0])
    (try
      (set! forms (read-all (string-bytes text) (string-length text) (string->symbol source)))
      (set! ok 1)
      [catch compile-error (message blamed loc) (session-fail! message blamed loc)])
    (if ok (session-eval! forms) 0)))

;; Reads the file `source` and evaluates each of its top-level forms as an
;; input of its own. When an input fails, `report` is called with the
;; error message, and evaluation continues with the next form.
(define (session-eval-file! [source datum] [report (closure (datum))])
  (let* ([path (canonical-path source)] [text (source-text (package-file path) path)]
         [forms (read-all (string-bytes text) (string-length text) (string->symbol path))])
    (while (pair? forms)
      (unless (session-eval! (list1 (car forms))) (report (session-error)))
      (set! forms (cdr forms)))))

;; Returns the error message of the last input that failed, formatted the
;; way the compiler formats errors (a string).
(define (session-error) -> datum session-message)

;; Compiles the expanded forms of an input into the session's next
;; linklet and instantiates it. Instantiating it runs the input: its
;; definitions are made and its expressions are evaluated, in order.
(define (run-session-linklet! [forms datum])
  (check-phase-data! forms 0 0)
  (let ([name (next-linklet-name! (-> current module) 0)])
    (set-current-source! (module-source))
    (let ([compiled (compile-module (append (linklet-storage-forms 0 name) forms) name)])
      (for-each (lambda ([imp datum]) (ensure-import! imp 0)) (cadr compiled))
      (set! session-running 1)
      (instantiate! (ns-name name) (car compiled) (cadr compiled) (cadddr compiled) 0 0)
      (set! session-running 0)
      (table-set! (-> current instances) (cast u64 (string->symbol (ns-name name))) 1))))

;; Records that the current input failed, and recovers. The error message
;; is formatted first, because formatting needs data (such as the syntax
;; that is blamed) that lives in arenas which session-recover! frees.
(define (session-fail! [message datum] [blamed datum] [loc (ptr srcloc)])
  (let ([b (make-buffer)])
    ;; An error that has no source location is printed as just
    ;; "error: message". A trap in the input's code is one: its message
    ;; contains a backtrace instead.
    (if (and (== loc 0) (not (and (syntax? blamed) (!= (syntax-srcloc blamed) 0))))
        (begin
          (buffer-add-string! (& b) "error: ")
          (write-to (& b) message 1)
          (buffer-add-byte! (& b) 10))
        (write-compile-error (& b) message blamed loc))
    (session-recover!)
    (set! session-message (bytes->string (-> b bytes) (-> b length)))
    (buffer-free! (& b))))

;; Puts the compiler back into the state it has between inputs. It is
;; called after every failure. That includes a trap that unwound the
;; compiler in the middle of expanding an input, in which case the
;; program's on-trap function calls it.
;;   - Frees the arenas of the modules that were being compiled when the
;;     failure happened.
;;   - Forgets those half-compiled modules, so that they are compiled
;;     again from the start the next time they are required.
;;   - Resets the expander's global state to "expanding the session".
(define (session-recover!)
  (end-module-arenas-to! session-mark)
  (while (pair? compiling)
    (hash-set! (& registry) (cast u64 (car compiling)) 0)
    (set! compiling (cdr compiling)))
  (set! current session)
  (set! current-body 0)
  (set! current-function 0)
  (set! to-syntax 0)
  (set! lowered-closures 0)
  (set! api-phase 0)
  (set! api-where 0)
  (set! api-intro 0)
  (set! session-running 0)
  (set! interacting 0)
  (set-scope-map! 0 0))

;; Tidies the host's message about a trap in an input's code, before it
;; is shown to the user. `said` is the message of the failed `instantiate`
;; call. This removes the leading "instantiate: ", and cuts the backtrace
;; off at the frame where the compiler called the host (instantiate-bytes):
;; the frames from there on are the compiler's, not the input's.
(define (session-failure [said datum]) -> datum
  (let* ([p (string-bytes said)] [n (string-length said)] [from u32 0] [to n] [at (find-bytes p n "instantiate-bytes")])
    (when (and (>= n 13) (== (memcmp p "instantiate: " 13) 0)) (set! from 13))
    (when (>= at 0)
      (set! to (cast u32 at))
      (while (and (> to from) (!= (@ p (- to 1)) 10)) (-= to 1)))
    (while (and (> to from) (== (@ p (- to 1)) 10)) (-= to 1))
    (bytes->string (+ p from) (- to from))))

;; Returns the index of the first occurrence of the C string s in the n
;; bytes at p, or -1 if there is none.
(define (find-bytes [p (ptr u8)] [n u32] [s (ptr u8)]) -> i32
  (let ([m (strlen s)])
    (for ([i u32 0]) (<= (+ i m) n) (+= i 1)
      (when (== (memcmp (+ p i) s m) 0) (return (cast i32 i))))
    -1))

;; Handles an expression among the forms of a session input. `f0` is the
;; expression as written. `f` is the same expression after any macro at
;; its head has been expanded. `b` is the body being built.
;;
;; If #%top-interaction is bound to a macro where f0 was written, the
;; expression becomes (#%top-interaction f), and the macro's expansion is
;; processed in its place. Otherwise the expression is added to the body
;; unchanged, as it would be in a module.
;;
;; The name #%top-interaction is looked up with the scopes of f0, the
;; original form, in the same way that #%app is looked up with the scopes
;; of the call it wraps. Looking it up with f's scopes fails when the
;; expression starts with a macro.
(define (interact! [f0 datum] [f datum] [b (ptr body)])
  (let* ([id (implicit-id f0 (sym #%top-interaction))] [t (transformer-of (meaning-of id 0))])
    (if (== t 0)
        (item! b `(expr ,f))
        (begin
          (set! interacting 1)
          (declare-form! (apply-macro id t (syntax-rewrap f0 `(,id ,f)) 0 1) b 0)
          (set! interacting 0)))))

;; ==== macros ====

;; State the queries read: the running macro's phase, the form it was
;; given, and its introduction scope.
(define api-phase i32 0)
(define api-where datum 0)
(define api-intro u32 0)

;; Hygiene (spec 6.2): a fresh introduction scope is flipped on the input
;; and on the output, so only what the transformer introduced carries it.
;; In a definition context (use-site 1), a macro the module being expanded
;; defines also gets a fresh use-site scope on its input, which stays. t
;; is a transformer.
(define (apply-macro [head datum] [t datum] [s0 datum] [phase i32] [use-site i32]) -> datum
  (note-macro-use! head phase)
  (let* ([intro (new-scope!)] [s (flip-scope s0 intro)])
    (when (and use-site (defined-here? head phase))
      (let ([use (new-scope!)])
        (set! (-> current use-site-scopes) (cons (make-integer use) (-> current use-site-scopes)))
        (set! s (add-scope s use))))
    (at-use s0 (flip-scope (call-syntax-function (format-message "macro ~a" (list1 (syntax-e head))) t s phase intro) intro))))

;; Is head bound to a macro the module being expanded defines?
(define (defined-here? [head datum] [phase i32]) -> i32
  (let ([m (meaning-of head phase)])
    (and (!= m 0) (== (car m) (sym compile-time-value))
         (== (cast datum (hash-ref (& macro-modules) (cast u64 (cadr m)))) (-> current module)))))

;; A macro's output, located at its use if the output comes from another
;; file, as a library macro's template does (spec 6.2): what the macro
;; introduced then has the use's location (spec 3.6).
(define (at-use [use datum] [out datum]) -> datum
  (let ([u (if (syntax? use) (syntax-srcloc use) 0)] [o (if (syntax? out) (syntax-srcloc out) 0)])
    (if (and (!= u 0) (syntax? out) (not (and (!= o 0) (== (-> o source) (-> u source)))))
        (make-syntax (syntax-e out) (syntax-scopes out) u (syntax-props out))
        out)))

;; Call transformer t with s. While it runs, the queries answer for phase,
;; blame s, and local-expand uses intro, its introduction scope. Calls
;; nest: a query can expand code, which calls more macros. A compile error
;; from the call that has no location is located at s, the use.
(define (call-syntax-function [who datum] [t datum] [s datum] [phase i32] [intro u32]) -> datum
  (let ([saved-phase api-phase] [saved-where api-where] [saved-intro api-intro] [result datum 0])
    (set! api-phase phase)
    (set! api-where s)
    (set! api-intro intro)
    (try (set! result (call-transformer t s))
         [catch compile-error (message blamed loc)
          (set! api-phase saved-phase)
          (set! api-where saved-where)
          (set! api-intro saved-intro)
          (throw compile-error message blamed
                 (if (and (== loc 0) (not (and (syntax? blamed) (!= (syntax-srcloc blamed) 0)))) (syntax-srcloc s) loc))])
    (set! api-phase saved-phase)
    (set! api-where saved-where)
    (set! api-intro saved-intro)
    (unless (syntax? result) (fail-at s "~a returned a non-syntax value: ~s" `(,who ,(syntax->datum result))))
    result))

;; A macro use relied on id's binding: if require-unqualified made it, no
;; definition may shadow it now.
(define (note-macro-use! [id datum] [phase i32])
  (let ([b (resolve id phase (sym value))])
    (when (and (!= b 0) (== (hash-ref (& unqualified-imports) (cast u64 b)) 1))
      (hash-set! (& unqualified-imports) (cast u64 b) 2))))

;; ---- the queries ----
;;
;; The expander's answers to the kernel module's queries (spec 2.3), for
;; the macro that is running. The kernel module calls them through the
;; functions registered with set-queries!.

(define (query-local-value [id datum]) -> datum
  (let ([m (if (identifier? id) (meaning-of id api-phase) 0)])
    (if (and (!= m 0) (== (car m) (sym compile-time-value))) (compile-time-value (cadr m)) 0)))

;; The same meanings, as a value and as a type, so an import and what it
;; imports are equal.
(define (query-free-identifier=? [x datum] [y datum]) -> datum
  (unless (and (identifier? x) (identifier? y)) (fail-at api-where "free-identifier=?: expected identifiers" nil))
  (let ([vx (meaning-of x api-phase)] [vy (meaning-of y api-phase)]
        [tx (type-meaning-of x api-phase)] [ty (type-meaning-of y api-phase)])
    (boolean (if (or (!= vx 0) (!= vy 0) (!= tx 0) (!= ty 0))
                 (and (equal? vx vy) (equal? tx ty))
                 (== (syntax-e x) (syntax-e y))))))

(define (query-binding-kind [id datum]) -> datum
  (unless (identifier? id) (fail-at api-where "identifier-binding-kind: expected an identifier" nil))
  (let ([m (meaning-of id api-phase)])
    (case (if (== m 0) 0 (car m))
      [((sym func)) (sym function)]
      [((sym local) (sym global)) (sym variable)]
      [((sym compile-time-value)) (if (!= (transformer-of m) 0) (sym macro) (sym compile-time-value))]
      [((sym data)) (sym data)]
      [((sym tag)) (sym tag)]
      [((sym label)) (sym label)]
      [((sym core) (sym prim)) (sym core)]
      [else (if (!= (type-meaning-of id api-phase) 0) (sym type) 0)])))

;; The signature of the function id is bound to, (t ... -> r ...), each
;; type written as in the kernel: a numeric type's name, (ref T) or (ref
;; null T) with T a heap type's name; #f if id is not a function.
(define (query-function-signature [id datum]) -> datum
  (unless (identifier? id) (fail-at api-where "identifier-function-signature: expected an identifier" nil))
  (let ([m (meaning-of id api-phase)])
    (if (and (!= m 0) (== (car m) (sym func)))
        (let ([info (cadr m)])
          (append (map (lambda ([t datum]) -> datum (type->datum t)) (func-info-params info))
                  (cons (sym ->) (map (lambda ([t datum]) -> datum (type->datum t)) (func-info-results info)))))
        0)))

(define (type->datum [t datum]) -> datum
  (if (ref-type? t)
      (let* ([h (ref-heap t)] [name (if (type-info? h) (type-info-name h) h)])
        (if (!= (ref-nullable? t) 0) `(ref null ,name) `(ref ,name)))
      t))

;; s, expanded to fully expanded code (spec 6.4). The running macro's
;; introduction scope is flipped around the expansion, so code from the
;; macro's input expands as it would at the use site. If a compile error
;; leaves the expansion, the expander is as it was, since the macro may
;; handle it and go on.
(define (query-local-expand [s datum]) -> datum
  (unless (syntax? s) (fail-at api-where "local-expand: expected syntax" nil))
  (let ([saved current-function] [saved-output to-syntax] [out datum 0])
    (set! to-syntax 1)
    (try (set! out (flip-scope (expand-expr (flip-scope s api-intro) api-phase) api-intro))
         [catch compile-error (message blamed loc)
          (set! current-function saved)
          (set! to-syntax saved-output)
          (throw compile-error message blamed loc)])
    (set! current-function saved)
    (set! to-syntax saved-output)
    out))

;; The form gets the macro's introduction scope, as its output does. The
;; macro gets back the form it gave, which its output can hold.
(define (query-lift [form datum]) -> datum
  (unless (syntax? form) (fail-at api-where "syntax-local-lift-definition: expected syntax" nil))
  (lift! (flip-scope form api-intro) api-where api-phase)
  form)

(define (query-introduce [s datum]) -> datum
  (unless (syntax? s) (fail-at api-where "syntax-local-introduce: expected syntax" nil))
  (flip-scope s api-intro))

;; The module being expanded and each module it requires, directly or
;; not, as (module . shift): dependencies first, in the order of their
;; requires, each module once at each phase shift it is required at.
(define (dependencies) -> datum
  (reverse (visit-dependencies (-> current module) 0 (make-table) nil)))

(define (visit-dependencies [m datum] [shift u32] [seen (ptr arena-table)] [out datum]) -> datum
  (when (!= (table-ref seen (shift-key m shift)) 0) (return out))
  (table-set! seen (shift-key m shift) 1)
  (let ([rs (-> (unit-of m) requires)])
    (while (pair? rs)
      (set! out (visit-dependencies (car (car rs)) (+ shift (cast u32 (integer-value (cdr (car rs))))) seen out))
      (set! rs (cdr rs))))
  (cons (cons m (make-integer shift)) out))

;; The facts about the definition id refers to, at the running macro's
;; phase (spec 6.5): those of the module being expanded, recorded so far,
;; and of each module it requires (dependencies). Each is (module phase
;; value): the file of the module that recorded it, the phase that module
;; recorded it at, and its datum or syntax.
(define (query-local-facts [id datum]) -> datum
  (unless (identifier? id) (fail-at api-where "syntax-local-facts: expected an identifier" nil))
  (let* ([facts (reverse (cast datum (hash-ref (& facts-by-key) (cast u64 (fact-key id api-phase)))))]
         [deps (if (null? facts) nil (dependencies))] [out nil])
    (while (pair? deps)
      (let ([m (car (car deps))] [shift (cast u32 (integer-value (cdr (car deps))))] [fs facts])
        (while (pair? fs)
          (let ([f (car fs)])
            (when (and (== (car f) m) (== (+ (cast i32 (integer-value (cadr f))) (cast i32 shift)) api-phase))
              (set! out (cons `(,(string->symbol (-> (unit-of m) path)) ,(cadr f) ,(shift-fact (caddr f) shift)) out))))
          (set! fs (cdr fs))))
      (set! deps (cdr deps)))
    (reverse out)))

;; A fact's datum or syntax v, seen at phase shift k: its syntax's module
;; scopes shifted, as a linklet's literals are (spec 3.5, 6.1).
(define fact-shift u32 0)
(define (shift-by-fact-shift [s (ptr scope-set)]) -> (ptr scope-set) (shift-scopes s fact-shift))
(define (shift-fact [v datum] [k u32]) -> datum
  (if (== k 0)
      v
      (begin (set! fact-shift k) (map-scopes v shift-by-fact-shift))))

;; ---- names (spec 6.6) ----

;; The module that makes definition base: the module being compiled for a
;; function not yet compiled.
(define (definition-module [base datum]) -> datum
  (let ([m (cast datum (hash-ref (& macro-modules) (cast u64 base)))] [i datum 0])
    (when (!= m 0) (return m))
    (set! i (info-instance base))
    (set! m (if (string? i) (instance-unit i) 0))
    (if (!= m 0) m (-> current module))))

(define (info-instance [info datum]) -> datum
  (cond [(func-info? info) (func-info-instance info)]
        [(global-info? info) (global-info-instance info)]
        [(tag-info? info) (tag-info-instance info)]
        [else 0]))

;; Module m's names, from its entries in order: each of its own
;; definitions -> its name, in by-base, and each name -> its entry, in
;; by-name. The n-th definition of a symbol at a phase, which hygiene can
;; make, is file:symbol@phase#n, without @0 and #0; counts has how many
;; there are so far. Kept, in the run's arena, as m's entries are, with the
;; entry they were made up to, and extended as m's entries grow, so a
;; module's names are made once each however often they are asked, as the
;; compiler's are (compiler/expander.sub).
(struct names [upto (ptr module-entry)] [by-base (ptr arena-table)] [by-name (ptr arena-table)] [counts (ptr arena-table)])
(define name-tables hash-table)             ; module -> (ptr names)

(define (module-names [m datum]) -> (ptr names)
  (let ([head (-> (unit-of m) entries)] [known (cast (ptr names) (hash-ref (& name-tables) (cast u64 m)))])
    (when (and (!= known 0) (== (-> known upto) head)) (return known))
    (let ([saved (use-arena (& run-arena))] [n known] [new nil] [e head])
      ;; Entries only grow at the front, so the tables named the ones they
      ;; were made from, and the new ones are named after them; entries
      ;; that are otherwise are named anew.
      (when (!= n 0)
        (while (and (!= e 0) (!= e (-> n upto)))
          (set! new (cons (cast datum e) new))
          (set! e (-> e next)))
        (when (!= e (-> n upto)) (set! n 0)))
      (when (== n 0)
        (set! n (cast (ptr names) (alloc-in (& run-arena) (sizeof names))))
        (set! (-> n by-base) (make-table))
        (set! (-> n by-name) (make-table))
        (set! (-> n counts) (make-table))
        (set! new nil)
        (set! e head)
        (while (!= e 0)
          (set! new (cons (cast datum e) new))
          (set! e (-> e next))))
      (name-entries! m n new)
      (set! (-> n upto) head)
      (hash-set! (& name-tables) (cast u64 m) (cast u32 n))
      (use-arena saved)
      n)))

;; Name m's entries, oldest first, in n.
(define (name-entries! [m datum] [n (ptr names)] [entries datum])
  (while (pair? entries)
    (let* ([e (cast (ptr module-entry) (car entries))] [base (definition-of (-> e binding meaning))])
      (when (and (!= base 0) (== (table-ref (-> n by-base) (cast u64 base)) 0) (== (definition-module base) m))
        (let* ([key (cons (-> e symbol) (make-integer (-> e phase)))] [c (datum-get (-> n counts) key)]
               [k (if (== c 0) 0 (integer-value c))]
               [name (string->symbol (format-message "~a:~a~a~a"
                                                     `(,(-> (unit-of m) path) ,(-> e symbol)
                                                       ,(if (== (-> e phase) 0) `"" (format-message "@~a" (list1 (make-integer (-> e phase)))))
                                                       ,(if (== k 0) `"" (format-message "#~a" (list1 (make-integer k)))))))])
          (datum-put! (-> n counts) key (make-integer (+ k 1)))
          (table-set! (-> n by-base) (cast u64 base) (cast u32 name))
          (table-set! (-> n by-name) (cast u64 name) (cast u32 e)))))
    (set! entries (cdr entries))))

;; The name of the definition id refers to at the running macro's phase,
;; or #f (spec 6.6).
(define (query-identifier-name [id datum]) -> datum
  (unless (identifier? id) (fail-at api-where "identifier-name: expected an identifier" nil))
  (let ([base (definition-of (meaning-of id api-phase))])
    (if (== base 0)
        0
        (cast datum (table-ref (-> (module-names (definition-module base)) by-base) (cast u64 base))))))

;; An identifier that refers to the definition name names, at the running
;; macro's phase, if the module being expanded made it or requires,
;; directly or not, the module that did: its symbol, with its scopes at
;; the phase shift that module is required at (spec 6.6).
(define (query-name-identifier [name datum]) -> datum
  (unless (symbol? name) (fail-at api-where "name-identifier: expected a name, a symbol" nil))
  (let ([deps (dependencies)])
    (while (pair? deps)
      (let* ([m (car (car deps))] [shift (cast u32 (integer-value (cdr (car deps))))]
             [e (cast (ptr module-entry) (table-ref (-> (module-names m) by-name) (cast u64 name)))])
        (when (and (!= e 0) (== (+ (-> e phase) (cast i32 shift)) api-phase))
          (return (make-syntax (-> e symbol) (shift-scopes (-> e scopes) shift) 0 nil))))
      (set! deps (cdr deps)))
    (fail-at api-where "name-identifier: ~a names no definition of this module, or of one it requires, at this phase" (list1 name))))

;; ==== fully expanded code ====
;;
;; Fully expanded code (spec 6.4) is syntax in the kernel's core grammar,
;; with every macro use expanded and every application and literal made
;; explicit. local-expand gives it to macros and sub expand prints it.
;; The expression walk builds it instead of lowered code when asked to
;; (to-syntax).
;;
;; Core forms in fully expanded code are named by identifiers that have
;; only the core scope, so they mean the core forms in any module,
;; whatever that module binds. Every other identifier keeps its scopes. So
;; fully expanded code can be expanded again, and macros can embed the
;; result of local-expand in their output.

(define (loc-of [where datum]) -> (ptr srcloc) (if (syntax? where) (syntax-srcloc where) 0))

;; The identifier for core form name in fully expanded code.
(define (core-id [name datum] [where datum]) -> datum (make-syntax name core-scopes (loc-of where) nil))

;; A list in fully expanded code, located at where.
(define (out-list [where datum] [items datum]) -> datum (make-syntax items core-scopes (loc-of where) nil))

;; The core form (name part ...), located at where.
(define (out [where datum] [name datum] [parts datum]) -> datum (out-list where (cons (core-id name where) parts)))

;; Module-level form f with its head replaced by the core identifier.
(define (core-headed [f datum] [name datum]) -> datum
  (out-list f (cons (core-id name (car (syntax-e f))) (cdr (syntax-e f)))))

;; An identifier for one of the kernel module's functions, for the calls
;; quasiquote and quasisyntax expand into. Its private scope is on no
;; module's code, so only fully expanded code can refer to it.
(define kernel-id-scopes (ptr scope-set) 0)
(define kernel-ids hash-table)

;; The kernel ids' scope, made the first time it is needed.
(define (kernel-id-scope) -> u32
  (when (== kernel-id-scopes 0) (set! kernel-id-scopes (scopes-change no-scopes (new-run-scope!) 0)))
  (@ (-> kernel-id-scopes ids) 0))

(define (kernel-id [name datum]) -> datum
  (kernel-id-scope)
  (let ([known (cast datum (hash-ref (& kernel-ids) (cast u64 name)))])
    (if (!= known 0)
        known
        (let ([id (keep (make-syntax name kernel-id-scopes 0 nil))])
          (bind-raw! name kernel-id-scopes all-phases `(func ,(kernel-function name)))
          (hash-set! (& kernel-ids) (cast u64 name) (cast u32 id))
          id))))

;; ==== expressions ====
;;
;; One walk expands an expression and builds its output: either lowered
;; code (core.sub), which is what a module's code becomes, or fully
;; expanded code (spec 6.4) for local-expand and sub expand. The walk
;; resolves and checks each form once and builds either output from the
;; same result.

;; Whether the walk builds fully expanded code, rather than lowered code.
(define to-syntax i32 0)

;; Lowered expression e, at s (spec 3.6): s is the syntax whose source
;; location it is at.
(define (at [s datum] [e datum]) -> datum `(at ,s ,e))

;; The lowered expressions es in sequence, at s.
(define (seq-at [s datum] [es datum]) -> datum (at s (cons (sym seq) es)))

;; Whether the form being built has a lambda or an application of a
;; function value, which the compiler looks for closures in (core.sub).
(define lowered-closures i32 0)

;; s has no value binding. It may still name a type.
(define (unbound [s datum] [sym datum] [phase i32]) -> datum
  (if (!= (type-meaning-of s phase) 0)
      (fail-at s "~a is a type, not a value" (list1 sym))
      (fail-at s "unbound identifier ~a~a" `(,sym ,(if (> phase 0) (format-message " at phase ~a" (list1 (make-integer phase))) `"")))))

(define (expand-expr [s datum] [phase i32]) -> datum
  (let ([e (syntax-e s)])
    (cond
      [(symbol? e)
       (let ([m (meaning-of s phase)])
         (case (if (== m 0) 0 (car m))
           [((sym local)) (if to-syntax (with-local-binding s (cadr m)) (at s `(lref ,(cadr m))))]
           [((sym global)) (if to-syntax (with-local-binding s 0) (at s `(gref ,(cadr m))))]
           [((sym compile-time-value))
            (let ([t (transformer-of m)])
              (when (== t 0) (fail-at s "~a is bound to a compile-time value: read it with syntax-local-value" (list1 e)))
              (expand-expr (apply-macro s t s phase 0) phase))]
           ;; A function's name as an expression is its value (5.2).
           [((sym func))
            (unless (has-value? (cadr m)) (fail-at s "~a is a function: call it, or use (func-index ~a)" `(,e ,e)))
            (if to-syntax (with-local-binding s 0) (at s `(gref ,(function-value (cadr m)))))]
           [((sym data)) (fail-at s "~a is data: use (data-address ~a) and (data-size ~a)" `(,e ,e ,e))]
           [((sym tag)) (fail-at s "~a is a tag: throw it with (throw ~a arg ...)" `(,e ,e))]
           [((sym core) (sym prim)) (fail-at s "bad use of ~a" (list1 e))]
           [((sym label)) (fail-at s "~a is a label" (list1 e))]
           [else (unbound s e phase)]))]
      [(pair? e)
       (let* ([head (car e)] [m (if (identifier? head) (meaning-of head phase) 0)] [t (transformer-of m)])
         (if (!= t 0)
             (expand-expr (apply-macro head t s phase 0) phase)
             (case (if (== m 0) 0 (car m))
               [((sym core)) (expand-core (cadr m) s phase)]
               [((sym prim)) (expand-prim (cadr m) s phase)]
               [else
                ;; Any other form is an application: (#%app f arg ...), where
                ;; #%app has the scopes of the form (spec 5.3).
                (when (and (identifier? head) (== (syntax-e head) (sym #%app)))
                  (if (!= m 0)
                      (fail-at s "#%app is bound here, but not to a macro or the core form" nil)
                      (unbound head (sym #%app) phase)))
                (expand-expr (syntax-rewrap s (cons (implicit-id s (sym #%app)) e)) phase)])))]
      [(null? e) (fail-at s "empty form ()" nil)]
      [(literal? e)
       ;; A literal is (#%datum literal), where #%datum has the scopes of the
       ;; literal (spec 5.4).
       (let* ([id (implicit-id s (sym #%datum))] [m (meaning-of id phase)] [t (transformer-of m)])
         (cond [(!= t 0) (expand-expr (apply-macro id t (syntax-rewrap s `(,id ,s)) phase 0) phase)]
               [(and (!= m 0) (== (car m) (sym core))) (datum-out s s)]
               [else (fail-at s "the literal ~s needs #%datum, which is ~a here"
                              `(,(syntax->datum s) ,(if (!= m 0) `"not a macro or the core form" `"unbound")))]))]
      [(keyword? e) (fail-at s "~s: keyword misused as an expression" (list1 e))]
      [else (fail-at s "~s is not an expression" (list1 (syntax->datum s)))])))

(define (literal? [e datum]) -> i32 (or (integer? e) (flonum? e) (char? e) (boolean? e) (string? e)))

;; The identifier name with the scopes and srcloc of s: the implicit #%app
;; of a form or #%datum of a literal.
(define (implicit-id [s datum] [name datum]) -> datum (datum->syntax s name s))

;; The core #%datum: an unquoted literal is a wasm number (spec 5.4).
;; Checks the literal, and gives its lowered form.
(define (core-datum [s datum]) -> datum
  (let ([e (syntax-e s)])
    (cond [(integer? e) `(int ,e)]
          [(flonum? e) `(float ,e)]
          [(char? e) `(int ,(make-integer (char->integer e)))]
          [(== e (boolean 1)) `(const i32 1)]
          [(== e 0) `(const i32 0)]
          [(string? e)
           (fail-at s "a string is not a wasm value: use (data name offset \"...\") for bytes, or '\"...\" for a kernel string" nil)]
          [else (fail-at s "~s is not a literal" (list1 (syntax->datum s)))])))

;; (#%datum literal), the form where.
(define (datum-out [where datum] [literal datum]) -> datum
  (let ([d (core-datum literal)])
    (if to-syntax (out where (sym #%datum) (list1 literal)) (at where d))))

;; The core #%app: (#%app f arg ...) calls the function f, or is its body
;; if f is inline (inline-call); with any other head, an expression, it
;; applies a function value, a closure the compiler calls (spec 5.3).
(define (core-app [s datum] [f datum] [args datum] [phase i32]) -> datum
  (let* ([m (if (identifier? f) (meaning-of f phase) 0)]
         [info (if (and (!= m 0) (== (car m) (sym func))) (cadr m) 0)]
         [h (if (!= info 0) f (expand-expr f phase))]
         [a (map (lambda ([e datum]) -> datum (expand-expr e phase)) args)])
    (cond [to-syntax (out s (sym #%app) (cons h a))]
          [(!= info 0) (at s (let ([inlined (inline-call info a phase)]) (if (!= inlined 0) inlined `(call ,info ,a))))]
          [else (set! lowered-closures 1) (at s `(apply-value ,h ,a))])))

;; A numeric or memory instruction: (args . offset), its arguments and a
;; trailing literal offset if it has one, else #f.
(define (prim-args [name datum] [s datum]) -> datum
  (let* ([p (lookup-prim name)]
         [args (let ([l (syntax->list (cdr (syntax-e s)))]) (if (== l 0) (fail-at s "bad syntax" nil) l))]
         [n (length (-> p params))])
    (cond [(== (length args) n) (cons args 0)]
          [(and (== (-> p kind) (sym mem)) (== (length args) (+ n 1))
                (let ([off (syntax-e (list-ref args n))]) (and (integer? off) (>= (integer-value off) 0) (< (integer-value off) 1073741824))))
           (cons (take args n) (list-ref args n))]
          [else (fail-at s "~a takes ~a argument~a~a, got ~a"
                         `(,name ,(make-integer n) ,(if (== n 1) `"" `"s")
                           ,(if (== (-> p kind) (sym mem)) `" and an optional offset" `"")
                           ,(make-integer (length args))))])))

(define (expand-prim [name datum] [s datum] [phase i32]) -> datum
  (let* ([ao (prim-args name s)] [args (map (lambda ([a datum]) -> datum (expand-expr a phase)) (car ao))])
    (if to-syntax
        (out s name (append args (if (!= (cdr ao) 0) (list1 (cdr ao)) nil)))
        (at s `(prim ,name ,(if (!= (cdr ao) 0) (syntax-e (cdr ao)) 0) ,args)))))

(define (data-info-of [id datum] [phase i32]) -> datum
  (let ([m (if (identifier? id) (meaning-of id phase) 0)])
    (unless (and (!= m 0) (== (car m) (sym data))) (fail-at id "~s is not data" (list1 (syntax->datum id))))
    (cadr m)))

;; The declared type id names, which must be a struct or array type, as
;; kind says.
(define (kind-type-of [id datum] [kind datum] [phase i32]) -> datum
  (let ([t (type-of id phase)])
    (unless (== (type-info-kind t) kind)
      (fail-at id "~a is not a~a type" `(,(type-info-name t) ,(if (== kind (sym struct)) `" struct" `"n array"))))
    t))

;; GC form s: (op immediate ... arg ...). Immediates are types, fields and
;; reference types. Checks s and returns (immediates . arguments), the
;; immediates resolved.
(define (gc-parts [name datum] [s datum] [phase i32]) -> datum
  (let* ([l (syntax->list s)] [n (length l)] [text (lambda ([form (ptr u8)]) -> datum (no-match s form))])
    (case name
      [((sym struct.new))
       (if (>= n 2) (cons (list1 (kind-type-of (cadr l) (sym struct) phase)) (cddr l)) (text "(struct.new type arg ...)"))]
      [((sym array.new_fixed))
       (if (>= n 2) (cons (list1 (kind-type-of (cadr l) (sym array) phase)) (cddr l)) (text "(array.new_fixed type arg ...)"))]
      [((sym struct.get) (sym struct.get_s) (sym struct.get_u))
       (if (== n 4)
           (let ([t (type-of (cadr l) phase)]) (cons `(,t ,(field-index t (caddr l))) (list1 (cadddr l))))
           (no-match s (format-string "(~a type field ref)" name)))]
      [((sym struct.set))
       (if (== n 5)
           (let ([t (type-of (cadr l) phase)]) (cons `(,t ,(field-index t (caddr l))) `(,(cadddr l) ,(list-ref l 4))))
           (text "(struct.set type field ref value)"))]
      [((sym array.new))
       (if (== n 4) (cons (list1 (kind-type-of (cadr l) (sym array) phase)) (cddr l)) (text "(array.new type value size)"))]
      [((sym array.new_default))
       (if (== n 3) (cons (list1 (kind-type-of (cadr l) (sym array) phase)) (cddr l)) (text "(array.new_default type size)"))]
      [((sym array.get) (sym array.get_s) (sym array.get_u))
       (if (== n 4) (cons (list1 (kind-type-of (cadr l) (sym array) phase)) (cddr l)) (no-match s (format-string "(~a type ref index)" name)))]
      [((sym array.set))
       (if (== n 5) (cons (list1 (kind-type-of (cadr l) (sym array) phase)) (cddr l)) (text "(array.set type ref index value)"))]
      [((sym array.fill))
       (if (== n 6) (cons (list1 (kind-type-of (cadr l) (sym array) phase)) (cddr l)) (text "(array.fill type ref index value size)"))]
      [((sym array.copy))
       (if (== n 8)
           (cons `(,(type-of (cadr l) phase) ,(type-of (caddr l) phase)) (cdddr l))
           (text "(array.copy dst-type src-type dst dst-index src src-index size)"))]
      [((sym ref.null)) (if (== n 2) (cons (list1 (parse-heap (cadr l) phase)) nil) (text "(ref.null heap)"))]
      [((sym ref.test) (sym ref.cast))
       (if (== n 3) (cons (list1 (parse-reftype (cadr l) phase)) (cddr l)) (no-match s (format-string "(~a type ref)" name)))]
      [((sym ref.eq)) (if (== n 3) (cons nil (cdr l)) (text "(ref.eq a b)"))]
      [else (if (== n 2) (cons nil (cdr l)) (no-match s (format-string "(~a ref)" name)))])))

;; format-message's template with one ~a, as a C string for a message.
(define (format-string [template (ptr u8)] [x datum]) -> (ptr u8)
  (let* ([s (format-message template (list1 x))] [b (make-buffer)])
    (buffer-add! (& b) (string-bytes s) (string-length s))
    (buffer-add-byte! (& b) 0)
    (-> b bytes)))

;; parts of GC form (name immediate ... arg ...) with the type immediates
;; expanded (spec 5.1).
(define (expand-gc-immediates [name datum] [parts datum] [phase i32]) -> datum
  (let ([n (cond [(!= (memq name `(ref.null ref.test ref.cast)) 0) 1]
                 [(== name (sym array.copy)) 2]
                 [(!= (memq name `(ref.eq array.len ref.is_null ref.as_non_null ref.i31 i31.get_s i31.get_u)) 0) 0]
                 [else 1])])
    (if (< (length parts) (+ n 1))
        parts
        (cons (car parts)
              (append (map (lambda ([t datum]) -> datum
                             (if (!= (memq name `(ref.test ref.cast)) 0) (expand-type t phase) (expand-type-name t phase)))
                           (take (cdr parts) n))
                      (list-tail (cdr parts) n))))))

(define (expand-gc [name datum] [s datum] [phase i32]) -> datum
  (let* ([parts (expand-gc-immediates name (let ([l (syntax->list s)]) (if (== l 0) (fail-at s "bad ~a syntax" (list1 name)) l)) phase)]
         [ia (gc-parts name (syntax-rewrap s parts) phase)]
         [args (map (lambda ([a datum]) -> datum (expand-expr a phase)) (cdr ia))])
    (if to-syntax
        (out s name (append (take (cdr parts) (- (length (cdr parts)) (length args))) args))
        (at s `(gc ,name ,(car ia) ,args)))))

(define (expand-core [name datum] [s datum] [phase i32]) -> datum
  (let* ([l (syntax->list s)] [n (if (== l 0) -1 (cast i32 (length l)))]
         [ex (lambda ([x datum]) -> datum (expand-expr x phase))])
    (case name
      [((sym #%app))
       (when (< n 2) (no-match s "(#%app f arg ...)"))
       (core-app s (cadr l) (cddr l) phase)]
      [((sym #%datum))
       (unless (== n 2) (no-match s "(#%datum literal)"))
       (datum-out s (cadr l))]
      [((sym closure)) (fail-at s "closure is a type, (ref (closure (type ... -> type ...))), not an expression" nil)]
      ;; Quoted data is the kernel module's, in memory, which compiled code
      ;; builds with its functions.
      [((sym quote))
       (unless (== n 2) (no-match s "(quote datum)"))
       (unless to-syntax (ensure-kernel!))
       (if to-syntax (out s name (list1 (cadr l))) (at s `(quote ,(syntax->datum (cadr l)))))]
      [((sym quote-syntax))
       (unless (== n 2) (no-match s "(quote-syntax datum)"))
       (unless to-syntax (ensure-kernel!))
       (let ([d (prune-local-scopes (cadr l))]) (if to-syntax (out s name (list1 d)) (at s `(quote ,d))))]
      ;; A quasi form is calls of the kernel module (quasi), expanded.
      [((sym quasiquote))
       (unless (== n 2) (no-match s "(quasiquote template)"))
       (ex (quasi s (cadr l) 0 phase (sym quasiquote) (sym unquote) (sym unquote-splicing) 0))]
      [((sym quasisyntax))
       (unless (== n 2) (no-match s "(quasisyntax template)"))
       (ex (quasi s (cadr l) 0 phase (sym quasisyntax) (sym unsyntax) (sym unsyntax-splicing) 1))]
      [((sym unquote) (sym unquote-splicing) (sym unsyntax) (sym unsyntax-splicing))
       (fail-at s "~a is not inside a quasi form" (list1 name))]
      [((sym data-address) (sym data-size))
       (unless (== n 2) (no-match s (format-string "(~a data)" name)))
       (let ([info (data-info-of (cadr l) phase)])
         (if to-syntax
             (out s name (list1 (cadr l)))
             (at s `(const i32 ,(if (== name (sym data-address))
                                    (data-info-offset info)
                                    (make-integer (string-length (data-info-bytes info))))))))]
      ;; wasm's constants: a literal of that type, whatever #%datum means
      ;; here (spec 5.3).
      [((sym i32.const) (sym i64.const) (sym f32.const) (sym f64.const))
       (unless (== n 2) (no-match s (format-string "(~a literal)" name)))
       (let ([v (const-literal name (cadr l))])
         (if to-syntax
             (out s name (list1 (cadr l)))
             (at s `(as (,(const-type name)) ,(if (integer? v) `(int ,v) `(float ,v))))))]
      [((sym set!))
       (unless (and (== n 3) (identifier? (cadr l))) (no-match s "(set! x value)"))
       (let* ([x (cadr l)] [m (meaning-of x phase)])
         (unless (and (!= m 0) (!= (memq (car m) `(local global)) 0))
           (fail-at x "set!: ~a is not a variable" (list1 (syntax-e x))))
         (let ([v (ex (caddr l))])
           (cond [to-syntax (out s name `(,(with-local-binding x (if (== (car m) (sym local)) (cadr m) 0)) ,v))]
                 [(== (car m) (sym local)) (at s `(lset ,(cadr m) ,v))]
                 [else (at s `(gset ,(cadr m) ,v))])))]
      [((sym let) (sym let*))
       (unless (and (>= n 2) (syntax? (cadr l)) (!= (syntax->list (cadr l)) 0)) (no-match s (format-string "(~a (binding ...) body ...)" name)))
       (let ([bs (map (lambda ([b datum]) -> datum (let-binding b phase)) (syntax->list (cadr l)))] [body (cddr l)])
         (if (== name (sym let))
             (let* ([inits (map (lambda ([bp datum]) -> datum (expand-expr (let-init bp) phase)) bs)]
                    [sc (new-local-scope!)]
                    [xs (map (lambda ([bp datum]) -> datum (scoped (car bp) sc)) bs)]
                    [keys (map (lambda ([x datum]) -> datum (bind-locals! x phase)) xs)])
               (let-out s (cadr l) bs xs keys inits (map (lambda ([x datum]) -> datum (expand-expr (add-scope x sc) phase)) body)))
             (expand-let* s bs body phase)))]
      ;; (lambda ([x t] ...) [-> r] body ...): a function that uses the
      ;; locals around it, a closure the compiler makes (spec 5.3). It
      ;; cannot branch to the labels around it.
      [((sym lambda))
       (unless (and (>= n 2) (syntax? (cadr l)) (!= (syntax->list (cadr l)) 0)) (no-match s "(lambda (p ...) . rest)"))
       (let* ([ps (cadr l)] [rest (cddr l)]
              [params (map (lambda ([x datum]) -> datum (param-of x phase)) (syntax->list ps))]
              [types (map (lambda ([pp datum]) -> datum (parse-type (cadr pp) phase)) params)]
              [arrow (arrow-of rest phase)]
              [results (car (parse-results arrow phase))]
              [body (list-tail rest (length arrow))]
              [sc (new-local-scope!)]
              [xs (map (lambda ([pp datum]) -> datum (add-scope (car pp) sc)) params)]
              [keys (map (lambda ([x datum]) -> datum (bind-local! x phase)) xs)]
              [saved current-function]
              [b datum 0])
         (set! current-function (list1 s))
         (set! b (map (lambda ([x datum]) -> datum (expand-expr (add-scope x sc) phase)) body))
         (set! current-function saved)
         (if to-syntax
             (let ([outs nil] [x xs] [k keys] [pp params])
               (while (pair? x)
                 (set! outs (cons (out-list (car x) `(,(with-local-binding (car x) (car k)) ,(cadr (car pp)))) outs))
                 (set! x (cdr x)) (set! k (cdr k)) (set! pp (cdr pp)))
               (out s name (cons (out-list ps (reverse outs)) (append arrow b))))
             (let ([pts nil] [k keys] [t types])
               (while (pair? k)
                 (set! pts (cons (cons (car k) (car t)) pts))
                 (set! k (cdr k)) (set! t (cdr t)))
               (set! lowered-closures 1)
               (at s `(lambda ,(fresh-key!) ,(reverse pts) ,results ,(seq-at s b))))))]
      [((sym begin))
       (when (< n 1) (no-match s "(begin e ...)"))
       (let ([es (map ex (cdr l))]) (if to-syntax (out s name es) (at s (cons (sym seq) es))))]
      [((sym if))
       (cond [(== n 3)
              (let* ([c (ex (cadr l))] [t (ex (caddr l))]) (if to-syntax (out s name `(,c ,t)) (at s `(if ,c ,t #f))))]
             [(== n 4)
              (let* ([c (ex (cadr l))] [t (ex (caddr l))] [e (ex (cadddr l))])
                (if to-syntax (out s name `(,c ,t ,e)) (at s `(if ,c ,t ,e))))]
             [else (no-match s "(if test then) or (if test then otherwise)")])]
      [((sym block) (sym loop))
       (unless (and (>= n 2) (identifier? (cadr l))) (no-match s (format-string "(~a label body ...)" name)))
       (let* ([sc (new-local-scope!)] [label (add-scope (cadr l) sc)] [key (fresh-label! label phase)]
              [b (map (lambda ([x datum]) -> datum (expand-expr (add-scope x sc) phase)) (cddr l))])
         (if to-syntax (out s name (cons label b)) (at s `(,name ,key ,(seq-at s b)))))]
      [((sym br))
       (cond [(== n 2)
              (let ([key (label-here (cadr l) phase)]) (if to-syntax (out s name (list1 (cadr l))) (at s `(br ,key #f))))]
             [(== n 3)
              (let* ([key (label-here (cadr l) phase)] [v (ex (caddr l))])
                (if to-syntax (out s name `(,(cadr l) ,v)) (at s `(br ,key ,v))))]
             [else (no-match s "(br label) or (br label value)")])]
      [((sym br-if))
       (unless (== n 3) (no-match s "(br-if label test)"))
       (let* ([key (label-here (cadr l) phase)] [c (ex (caddr l))])
         (if to-syntax (out s name `(,(cadr l) ,c)) (at s `(br-if ,key ,c))))]
      [((sym br-table))
       (unless (and (== n 4) (names? (cadr l)) (identifier? (caddr l))) (no-match s "(br-table (label ...) default index)"))
       (let* ([keys (map (lambda ([x datum]) -> datum (label-here x phase)) (syntax->list (cadr l)))]
              [d (label-here (caddr l) phase)] [i (ex (cadddr l))])
         (if to-syntax (out s name `(,(cadr l) ,(caddr l) ,i)) (at s `(br-table ,keys ,d ,i))))]
      [((sym return))
       (cond [(== n 1) (if to-syntax (out s name nil) (at s `(return #f)))]
             [(== n 2) (let ([v (ex (cadr l))]) (if to-syntax (out s name (list1 v)) (at s `(return ,v))))]
             [else (no-match s "(return) or (return value)")])]
      [((sym call-indirect))
       (unless (>= n 3) (no-match s "(call-indirect signature index arg ...)"))
       (let* ([sig (expand-signature (cadr l) phase)] [pr (parse-signature sig phase)] [i (ex (caddr l))] [a (map ex (cdddr l))])
         (if to-syntax (out s name (cons sig (cons i a))) (at s `(call-indirect ,(car pr) ,(cdr pr) ,i ,a))))]
      ;; (ref.func f): a reference to f, at its declared function type.
      [((sym ref.func))
       (unless (and (== n 2) (identifier? (cadr l))) (no-match s "(ref.func f)"))
       (let* ([f (cadr l)] [m (meaning-of f phase)])
         (unless (and (!= m 0) (== (car m) (sym func))) (fail-at f "ref.func: ~a is not a function" (list1 (syntax-e f))))
         (when (== (func-info-type (cadr m)) 0)
           (fail-at f "ref.func: ~a has no declared function type; give it one with (type T)" (list1 (syntax-e f))))
         (if to-syntax (out s name (list1 f)) (at s `(ref-func ,(cadr m)))))]
      ;; (call-ref T f arg ...): call f, a (ref null T), with the args.
      [((sym call-ref))
       (unless (>= n 3) (no-match s "(call-ref type f arg ...)"))
       (let* ([tname (expand-type-name (cadr l) phase)] [t (type-of tname phase)])
         (unless (func-type? t) (fail-at (cadr l) "call-ref: ~a is not a function type" (list1 (type-info-name t))))
         (let ([h (ex (caddr l))] [a (map ex (cdddr l))])
           (if to-syntax (out s name (cons tname (cons h a))) (at s `(call-ref ,t ,h ,a)))))]
      [((sym func-index))
       (unless (and (== n 2) (identifier? (cadr l))) (no-match s "(func-index f)"))
       (let* ([f (cadr l)] [m (meaning-of f phase)])
         (unless (and (!= m 0) (== (car m) (sym func))) (fail-at f "func-index: ~a is not a function" (list1 (syntax-e f))))
         (if to-syntax (out s name (list1 f)) (at s `(func-index ,(cadr m)))))]
      [((sym select))
       (unless (== n 4) (no-match s "(select a b test)"))
       (let* ([x (ex (cadr l))] [y (ex (caddr l))] [c (ex (cadddr l))])
         (if to-syntax (out s name `(,x ,y ,c)) (at s `(select ,x ,y ,c))))]
      ;; (values e ...): each e's value, in order, as several values.
      [((sym values))
       (let ([vs (map (lambda ([x datum]) -> datum (expand-expr x phase)) (cdr l))])
         (if to-syntax (out s name vs) (at s `(values ,@vs))))]
      [((sym drop))
       (unless (== n 2) (no-match s "(drop value)"))
       (let ([v (ex (cadr l))]) (if to-syntax (out s name (list1 v)) (at s `(drop ,v))))]
      [((sym unreachable) (sym nop))
       (unless (== n 1) (no-match s (format-string "(~a)" name)))
       (if to-syntax (out s name nil) (at s (list1 name)))]
      ;; (throw tag arg ...): throw an exception of tag, carrying the args.
      [((sym throw))
       (unless (>= n 2) (no-match s "(throw tag arg ...)"))
       (let* ([info (tag-info-of (cadr l) phase)] [a (map ex (cddr l))])
         (if to-syntax (out s name (cons (cadr l) a)) (at s `(throw ,info ,a))))]
      [((sym throw-ref))
       (unless (== n 2) (no-match s "(throw-ref exn)"))
       (let ([v (ex (cadr l))]) (if to-syntax (out s name (list1 v)) (at s `(throw-ref ,v))))]
      ;; (try (clause ...) body ...): body, with the exceptions the clauses
      ;; catch handled by them (spec 5.3).
      [((sym try))
       (unless (and (>= n 2) (syntax? (cadr l)) (!= (syntax->list (cadr l)) 0)) (no-match s "(try (clause ...) body ...)"))
       (let* ([cs (map (lambda ([c datum]) -> datum (expand-catch c phase)) (syntax->list (cadr l)))] [b (map ex (cddr l))])
         (if to-syntax (out s name (cons (out-list (cadr l) cs) b)) (at s `(try ,cs ,(seq-at s b)))))]
      [else
       (if (!= (memq name gc-forms) 0)
           (expand-gc name s phase)
           (fail-at s "~a is only allowed at module level" (list1 name)))])))

;; The literal of constant form (name n): a number, and an integer for
;; i32.const and i64.const.
(define (const-literal [name datum] [s datum]) -> datum
  (let ([n (syntax-e s)] [integer (or (== name (sym i32.const)) (== name (sym i64.const)))])
    (unless (if integer (integer? n) (or (integer? n) (flonum? n)))
      (fail-at s "~a takes a literal ~a" `(,name ,(if integer `"integer" `"number"))))
    n))

(define (const-type [name datum]) -> datum
  (case name [((sym i32.const)) (sym i32)] [((sym i64.const)) (sym i64)] [((sym f32.const)) (sym f32)] [else (sym f64)]))

;; The parts of try clause c, [catch tag (x ...) body ...], [catch-ref tag
;; (x ... e) body ...], [catch-all body ...] or [catch-all-ref (e) body
;; ...], whose first word is compared by name: (kind tag-or-#f
;; variables-or-#f body). The variables are bound to the exception's
;; values, then, for the -ref kinds, to the exception itself.
(define (catch-parts [c datum]) -> datum
  (let* ([l (syntax->list c)] [n (if (== l 0) 0 (length l))]
         [ids? (lambda ([v datum] [least u32]) -> i32
                 (let ([vl (syntax->list v)])
                   (and (syntax? v) (!= vl 0) (>= (length vl) least) (andmap (lambda ([x datum]) -> i32 (identifier? x)) vl))))])
    (cond [(and (>= n 3) (named? (car l) (sym catch)) (ids? (caddr l) 0)) `(catch ,(cadr l) ,(caddr l) ,(cdddr l))]
          [(and (>= n 3) (named? (car l) (sym catch-ref)) (ids? (caddr l) 1)) `(catch-ref ,(cadr l) ,(caddr l) ,(cdddr l))]
          [(and (>= n 1) (named? (car l) (sym catch-all))) `(catch-all #f #f ,(cdr l))]
          [(and (>= n 2) (named? (car l) (sym catch-all-ref)) (ids? (cadr l) 1) (== (length (syntax->list (cadr l))) 1))
           `(catch-all-ref #f ,(cadr l) ,(cddr l))]
          [else (no-match c "(catch tag (x ...) body ...), (catch-ref tag (x ... e) body ...), (catch-all body ...) or (catch-all-ref (e) body ...)")])))

;; Try clause c, its variables bound and its body expanded: fully
;; expanded, or lowered as (kind tag-info-or-#f keys body).
(define (expand-catch [c datum] [phase i32]) -> datum
  (let* ([p (catch-parts c)] [kind (car p)] [tag (cadr p)] [vars (caddr p)] [body (cadddr p)]
         [xs (if (!= vars 0) (syntax->list vars) nil)]
         [info (if (!= tag 0) (tag-info-of tag phase) 0)]
         [n (+ (if (!= info 0) (length (tag-info-params info)) 0)
               (if (!= (memq kind `(catch-ref catch-all-ref)) 0) 1 0))]
         [sc (new-local-scope!)])
    (unless (== (length xs) n)
      (fail-at vars "this clause binds ~a variable~a, not ~a" `(,(make-integer n) ,(if (== n 1) `"" `"s") ,(make-integer (length xs)))))
    (let* ([scoped (map (lambda ([x datum]) -> datum (add-scope x sc)) xs)]
           [keys (map (lambda ([x datum]) -> datum (bind-local! x phase)) scoped)]
           [b (map (lambda ([x datum]) -> datum (expand-expr (add-scope x sc) phase)) body)])
      (if to-syntax
          (let ([bound nil] [x scoped] [k keys])
            (while (pair? x)
              (set! bound (cons (with-local-binding (car x) (car k)) bound))
              (set! x (cdr x)) (set! k (cdr k)))
            (out-list c `(,(core-id kind (car (syntax->list c)))
                          ,@(if (!= tag 0) (list1 tag) nil)
                          ,@(if (!= vars 0) (list1 (out-list vars (reverse bound))) nil)
                          ,@b)))
          `(,kind ,info ,keys ,(seq-at c b))))))

;; A let binding [x init] or [x type init], as (x type-syntax type init),
;; the type expanded and parsed, or #f and #f without one; or [(x ...)
;; init] or [(x ...) (type ...) init], which binds each x to one of the
;; values init gives, in order, as ((x ...) types-syntax types init).
(define (let-binding [b datum] [phase i32]) -> datum
  (let ([l (syntax->list b)])
    (cond [(and (!= l 0) (== (length l) 2) (identifier? (car l))) `(,(car l) #f #f ,(cadr l))]
          [(and (!= l 0) (== (length l) 3) (identifier? (car l)))
           (let ([t (expand-type (cadr l) phase)]) `(,(car l) ,t ,(parse-type t phase) ,(caddr l)))]
          [(and (!= l 0) (== (length l) 2) (names? (car l))) `(,(syntax->list (car l)) #f #f ,(cadr l))]
          [(and (!= l 0) (== (length l) 3) (names? (car l)) (!= (syntax->list (cadr l)) 0)
                (== (length (syntax->list (cadr l))) (length (syntax->list (car l)))))
           (let ([ts (map (lambda ([t datum]) -> datum (expand-type t phase)) (syntax->list (cadr l)))])
             `(,(syntax->list (car l)) ,ts ,(map (lambda ([t datum]) -> datum (parse-type t phase)) ts) ,(caddr l)))]
          [else (no-match b "(name init), (name type init), ((name ...) init) or ((name ...) (type ...) init)")])))

;; Is x a list of identifiers, one or more?
(define (names? [x datum]) -> i32
  (let ([l (syntax->list x)])
    (when (or (== l 0) (null? l)) (return 0))
    (while (pair? l)
      (unless (identifier? (car l)) (return 0))
      (set! l (cdr l)))
    1))

;; A binding's name, or its names, with scope sc added; and each bound.
(define (scoped [x datum] [sc u32]) -> datum
  (if (pair? x) (map (lambda ([y datum]) -> datum (add-scope y sc)) x) (add-scope x sc)))

(define (bind-locals! [x datum] [phase i32]) -> datum
  (if (pair? x) (map (lambda ([y datum]) -> datum (bind-local! y phase)) x) (bind-local! x phase)))

(define (let-init [bp datum]) -> datum (cadddr bp))

;; The let, the form s whose binding list is bindings, of bindings bs,
;; bound as the identifiers xs with the keys, to inits, around body.
(define (let-out [s datum] [bindings datum] [bs datum] [xs datum] [keys datum] [inits datum] [body datum]) -> datum
  (let ([outs nil])
    (while (pair? bs)
      (let* ([bp (car bs)] [x (car xs)] [key (car keys)] [init (car inits)])
        (set! outs (cons (cond [(and to-syntax (pair? x))
                                (let ([ids nil] [y x] [k key])
                                  (while (pair? y)
                                    (set! ids (cons (with-local-binding (car y) (car k)) ids))
                                    (set! y (cdr y))
                                    (set! k (cdr k)))
                                  (let ([names (out-list (car x) (reverse ids))])
                                    (out-list (car x) (if (!= (cadr bp) 0) `(,names ,(out-list (car x) (cadr bp)) ,init) `(,names ,init)))))]
                               [to-syntax
                                (let ([x (with-local-binding x key)])
                                  (out-list (car bp) (if (!= (cadr bp) 0) `(,x ,(cadr bp) ,init) `(,x ,init))))]
                               [(pair? x) `(,key ,(caddr bp) ,init ,(map (lambda ([y datum]) -> datum (syntax-e y)) (car bp)))]
                               [else `(,key ,(caddr bp) ,init ,(syntax-e (car bp)))])
                         outs)))
      (set! bs (cdr bs)) (set! xs (cdr xs)) (set! keys (cdr keys)) (set! inits (cdr inits)))
    (if to-syntax
        (out s (sym let) (cons (out-list bindings (reverse outs)) body))
        (at s `(let ,(reverse outs) ,(seq-at s body))))))

;; (let* (b ...) body ...) as nested lets, one binding each.
(define (expand-let* [s datum] [bs datum] [body datum] [phase i32]) -> datum
  (if (null? bs)
      (let-out s s nil nil nil nil (map (lambda ([x datum]) -> datum (expand-expr x phase)) body))
      (let* ([bp (car bs)]
             [init (expand-expr (let-init bp) phase)]
             [sc (new-local-scope!)]
             [x (scoped (car bp) sc)]
             [key (bind-locals! x phase)]
             [later (map (lambda ([b datum]) -> datum `(,(scoped (car b) sc) ,(cadr b) ,(caddr b) ,(add-scope (let-init b) sc)))
                         (cdr bs))]
             [body (map (lambda ([y datum]) -> datum (add-scope y sc)) body)])
        (let-out s s (list1 bp) (list1 x) (list1 key) (list1 init)
                 (if (null? later) (map (lambda ([y datum]) -> datum (expand-expr y phase)) body) (list1 (expand-let* s later body phase)))))))

;; A local variable with id's name and scopes already is one the same form
;; binds: an error, rather than ambiguous uses.
(define (bind-local! [id datum] [phase i32]) -> datum
  (let ([b (bindings-under (syntax-e id) (binding-slot (syntax-scopes id)))])
    (while (!= b 0)
      (when (and (== (-> b phase) phase) (== (-> b scopes) (syntax-scopes id))
                 (pair? (-> b meaning)) (== (car (-> b meaning)) (sym local)))
        (fail-at id "~a is bound twice" (list1 (syntax-e id))))
      (set! b (-> b next))))
  (let ([b (bind! id phase 0)])
    (set! (-> b meaning) (keep `(local ,(-> b key))))
    (-> b key)))

;; id, recording that it binds or refers to the local variable with key,
;; or, key #f, that it refers to none: in fully expanded code an
;; identifier has the property if and only if it is a local variable's,
;; whatever properties a macro copied onto it (syntax-rewrap).
(define (with-local-binding [id datum] [key datum]) -> datum
  (if (or (!= key 0) (!= (syntax-property id (sym %local-binding)) 0))
      (syntax-property-set id (sym %local-binding) key)
      id))

;; The function or lambda whose body is being expanded, as a unique list,
;; or #f; and label key -> the one it was bound in. A branch must stay in
;; its function.
(define current-function datum 0)
(define label-functions hash-table)

(define (fresh-label! [id datum] [phase i32]) -> datum
  (let* ([b (bind! id phase 0)] [key (-> b key)])
    (set! (-> b meaning) (keep `(label ,key)))
    (hash-set! (& label-functions) (cast u64 (integer-value key)) (cast u32 (if (== current-function 0) 1 (cast u32 current-function))))
    key))

;; The key of label id, which must be a label of the function being
;; expanded: a lambda cannot branch to the labels around it.
(define (label-here [id datum] [phase i32]) -> datum
  (let ([key (label-key-of id phase)] [function (if (== current-function 0) 1 (cast u32 current-function))])
    (unless (== (hash-ref (& label-functions) (cast u64 (integer-value key))) function)
      (fail-at id "~a is a label of the function around this lambda, which a lambda cannot branch to" (list1 (syntax-e id))))
    key))

(define (label-key-of [id datum] [phase i32]) -> datum
  (let ([m (if (identifier? id) (meaning-of id phase) 0)])
    (unless (and (!= m 0) (== (car m) (sym label))) (fail-at id "~s is not a label" (list1 (syntax->datum id))))
    (cadr m)))

;; ==== quasiquote / quasisyntax ====
;;
;; One walker for both. The result is code that calls the kernel module,
;; in core forms with the unquoted expressions as written, for expand-expr
;; to expand. For quasisyntax, unchanged subtemplates become syntax
;; constants and changed lists are rewrapped with the template's own
;; scopes and srcloc (syntax-rewrap).

;; What a quasi form is: where it is, its phase, its names for itself, for
;; unquote and for unquote-splicing, and whether it is quasisyntax.
(struct quasi-form [where datum] [phase i32] [qname datum] [uname datum] [sname datum] [syntax i32])

(define (quasi [where datum] [t datum] [depth i32] [phase i32] [qname datum] [uname datum] [sname datum] [syntax i32]) -> datum
  (let ([q quasi-form])
    (set! (-> q where) where)
    (set! (-> q phase) phase)
    (set! (-> q qname) qname)
    (set! (-> q uname) uname)
    (set! (-> q sname) sname)
    (set! (-> q syntax) syntax)
    (quasi-walk (& q) t depth)))

(define (tagged? [q (ptr quasi-form)] [x datum] [name datum]) -> i32
  (let ([l (syntax->list x)])
    (and (!= l 0) (== (length l) 2) (core-id? (car l) name (-> q phase)))))

(define (changes? [q (ptr quasi-form)] [x datum] [depth i32]) -> i32
  (cond [(or (tagged? q x (-> q uname)) (tagged? q x (-> q sname)))
         (or (== depth 0) (changes? q (cadr (syntax->list x)) (- depth 1)))]
        [(tagged? q x (-> q qname)) (changes? q (cadr (syntax->list x)) (+ depth 1))]
        [(and (syntax? x) (pair? (syntax-e x)))
         (let ([e (syntax-e x)])
           (while (pair? e)
             (when (changes? q (car e) depth) (return 1))
             (set! e (cdr e)))
           (and (syntax? e) (changes? q e depth)))]
        [else 0]))

(define (quasi-call [q (ptr quasi-form)] [name datum] [args datum]) -> datum
  (out (-> q where) (sym #%app) (cons (kernel-id name) args)))

(define (quasi-constant [q (ptr quasi-form)] [x datum]) -> datum
  (if (-> q syntax)
      (out x (sym quote-syntax) (list1 (prune-local-scopes x)))
      (out x (sym quote) (list1 x))))

;; Rebuild the pair chain e (elements of template x) as an expression.
(define (quasi-list [q (ptr quasi-form)] [x datum] [e datum] [depth i32]) -> datum
  (cond [(null? e) (out x (sym quote) (list1 (make-syntax nil no-scopes 0 nil)))]
        [(syntax? e) (quasi-walk q e depth)]
        [(and (== depth 0) (tagged? q (car e) (-> q sname)))
         (let ([v (cadr (syntax->list (car e)))])
           (quasi-call q (sym append) `(,(if (-> q syntax) (quasi-call q (sym splice-list) (list1 v)) v) ,(quasi-list q x (cdr e) depth))))]
        [else (quasi-call q (sym cons) `(,(quasi-walk q (car e) depth) ,(quasi-list q x (cdr e) depth)))]))

(define (quasi-walk [q (ptr quasi-form)] [x datum] [depth i32]) -> datum
  (cond [(not (changes? q x depth)) (quasi-constant q x)]
        [(and (tagged? q x (-> q uname)) (== depth 0)) (cadr (syntax->list x))]
        [(pair? (syntax-e x))
         (let* ([l (syntax-e x)]
                [unq (or (tagged? q x (-> q uname)) (tagged? q x (-> q sname)))]
                [inner-depth (cond [unq (- depth 1)] [(tagged? q x (-> q qname)) (+ depth 1)] [else depth])]
                [head (if (or unq (tagged? q x (-> q qname)))
                          (quasi-call q (sym cons) `(,(quasi-constant q (car l)) ,(quasi-list q x (cdr l) inner-depth)))
                          (quasi-list q x l depth))])
           (if (-> q syntax) (quasi-call q (sym syntax-rewrap) `(,(quasi-constant q x) ,head)) head))]
        [else (quasi-constant q x)]))

;; ---- function values (spec 5.2) ----

;; A function declared with #:value g -> (g . phase), then g's info once
;; it is resolved: when the function's name is first expanded as an
;; expression, in the second pass, so the global may be declared after
;; the function, or lifted with it.
(define function-values hash-table)

(define (has-value? [info datum]) -> i32 (!= (hash-ref (& function-values) (cast u64 (base-info info))) 0))

;; The info of the global that is func info's value, shifted as info is,
;; or #f if info has none.
(define (function-value [info datum]) -> datum
  (let* ([base (base-info info)] [v (cast datum (hash-ref (& function-values) (cast u64 base)))] [g datum 0])
    (cond [(== v 0) 0]
          [(pair? v)
           (let ([m (meaning-of (car v) (cast i32 (integer-value (cdr v))))])
             (unless (and (!= m 0) (== (car m) (sym global)))
               (fail-at (car v) "#:value names ~a, which is not a global" (list1 (syntax-e (car v)))))
             (hash-set! (& function-values) (cast u64 base) (cast u32 (cadr m)))
             (set! g (cadr m)))]
          [else (set! g v)])
    (shift-info g (info-shift info))))

;; ---- inline functions (spec 5.2) ----

;; The inline functions' bodies: info -> (params results body returns?
;; assigned), their parameters as (key . type), their result types, their
;; lowered bodies, whether each has a return, and the parameters the body
;; sets. Kept without source locations: an inlined call is at the call's.
(define inlines hash-table)

;; Check that the lowered body of inline function info, named by id, does
;; not depend on which module it is compiled in, and keep it, with
;; whether it uses memory: then it is inlined only where that memory is
;; the same (inline-call).
(define inline-memory i32 0)

(define (record-inline! [info datum] [params datum] [body datum] [id datum])
  (set! inline-memory 0)
  (let ([returns (check-inline body id)])
    (hash-set! (& inlines) (cast u64 info)
               (cast u32 (keep `(,params ,(func-info-results info) ,(without-locations body) ,(boolean returns)
                                 ,(filter (lambda ([p datum]) -> i32 (assigns? body (car p))) params)
                                 ,(boolean inline-memory)))))))

(define (inline-fail [id datum] [what (ptr u8)]) -> i32
  (fail-at id "~a is inline, so it may not ~a" `(,(syntax-e id) ,(bytes->string what (strlen what))))
  0)

;; Check lowered form e of an inline body: 1 if it has a return.
(define (check-inline [e datum] [id datum]) -> i32
  (let ([check (lambda ([x datum]) -> i32 (check-inline x id))]
        [each (lambda ([l datum]) -> i32 (check-each l id))])
    (case (car e)
      [((sym at) (sym as) (sym lset) (sym gset)) (check (caddr e))]
      ;; Quoted data goes into the table of the module a call is compiled
      ;; in, which needs the kernel module's memory as any quote does.
      [((sym int) (sym float) (sym const) (sym lref) (sym gref) (sym ref-func) (sym unreachable) (sym nop) (sym quote)) 0]
      [((sym let))
       (let ([r (check-each (map (lambda ([b datum]) -> datum (caddr b)) (cadr e)) id)]) (or (check (caddr e)) r))]
      [((sym seq)) (each (cdr e))]
      [((sym if)) (let* ([a (check (cadr e))] [b (check (caddr e))] [c (if (!= (cadddr e) 0) (check (cadddr e)) 0)]) (or a b c))]
      [((sym block) (sym loop) (sym br-if)) (check (caddr e))]
      [((sym br-table)) (check (cadddr e))]
      [((sym br)) (if (!= (caddr e) 0) (check (caddr e)) 0)]
      [((sym return)) (when (!= (cadr e) 0) (check (cadr e))) 1]
      [((sym call)) (each (caddr e))]
      [((sym prim))
       (when (or (== (-> (lookup-prim (cadr e)) kind) (sym mem))
                 (!= (memq (cadr e) `(memory.size memory.grow memory.copy memory.fill)) 0))
         (set! inline-memory 1))
       (each (cadddr e))]
      [((sym call-indirect) (sym func-index)) (inline-fail id "use a table")]
      [((sym call-ref)) (let ([a (check (caddr e))]) (or (each (cadddr e)) a))]
      [((sym gc)) (each (cadddr e))]
      [((sym select) (sym drop) (sym values)) (each (cdr e))]
      [((sym throw)) (each (caddr e))]
      [((sym throw-ref)) (check (cadr e))]
      [((sym try))
       (let ([r (check-each (map (lambda ([c datum]) -> datum (cadddr c)) (cadr e)) id)]) (or (check (caddr e)) r))]
      [((sym lambda)) (check (list-ref e 4))]
      [((sym apply-value)) (let ([a (check (cadr e))]) (or (each (caddr e)) a))]
      [else (fail-at id "internal: lowered form ~a" (list1 (car e))) 0])))

;; check-inline of each of the forms in l, in order: 1 if one has a
;; return.
(define (check-each [l datum] [id datum]) -> i32
  (let ([returns 0])
    (while (pair? l)
      (when (check-inline (car l) id) (set! returns 1))
      (set! l (cdr l)))
    returns))

;; Whether lowered form e sets local key.
(define (assigns? [e datum] [key datum]) -> i32
  (cond [(not (pair? e)) 0]
        [(== (car e) (sym quote)) 0]
        [(and (== (car e) (sym lset)) (equal? (cadr e) key)) 1]
        [else (ormap (lambda ([x datum]) -> i32 (assigns? x key)) (cdr e))]))

;; e without the source locations around it.
(define (unlocated [e datum]) -> datum (if (== (car e) (sym at)) (unlocated (caddr e)) e))

;; Lowered form e without its source locations.
(define (without-locations [e datum]) -> datum
  (cond [(not (pair? e)) e]
        [(== (car e) (sym at)) (without-locations (caddr e))]
        [(== (car e) (sym quote)) e]
        [else (let ([head nil] [last datum 0] [l e])
                (while (pair? l)
                  (let ([p (list1 (without-locations (car l)))])
                    (if (== last 0) (set! head p) (set-cdr! last p))
                    (set! last p))
                  (set! l (cdr l)))
                (unless (== last 0) (set-cdr! last l))
                head)]))

;; A call of info with args, at phase, lowered, as info's body if it is
;; inline, takes that many arguments and, if it uses memory, was
;; compiled for the memory the code being compiled uses; #f otherwise.
(define (inline-call [info datum] [args datum] [phase i32]) -> datum
  (let ([b (cast datum (hash-ref (& inlines) (cast u64 (base-info info))))])
    (if (or (== b 0) (!= (length args) (length (car b)))
            (and (!= (list-ref b 5) 0) (not (same-memory? info phase))))
        0
        (let* ([keys (new-table)] [labels (new-table)]
               [ret (if (!= (cadddr b) 0) (fresh-key!) 0)]
               [bindings (inline-bindings (car b) args (list-ref b 4) (& keys))]
               [body (begin (set! inline-shift (info-shift info)) (copy-inline (caddr b) (& keys) (& labels) ret))]
               [e `(let ,bindings ,body)])
          (hash-free! (& keys))
          (hash-free! (& labels))
          `(as ,(cadr b) ,(if (!= ret 0) `(block ,ret ,e) e))))))

(define (new-table) -> hash-table
  (let ([t hash-table])
    (memset (& t) 0 (sizeof hash-table))
    t))

;; Does the code being compiled at phase use the memory the body of
;; inline function info was compiled for? Each is known by the instance
;; that owns it, the one whose linklet declares it, at run time, found
;; through the instances each takes its memory from (spec 3.3).
(define (same-memory? [info datum] [phase i32]) -> i32
  (let* ([i (info-instance (base-info info))]
         [def (cond [(== i 0) (use-memory-owner (- phase (cast i32 (info-shift info))))]
                    [(string? i) (memory-owner (shifted-instance i (cast i32 (info-shift info))))]
                    [else 0])]
         [use (use-memory-owner phase)])
    (and (!= def 0) (!= use 0) (string=? def use))))

;; The instance that owns the memory of the module being compiled at
;; phase, or 0 if it has none.
(define (use-memory-owner [phase i32]) -> datum
  (let ([form (storage-form (sym memory) phase)])
    (cond [(== form 0) 0]
          [(== (car form) (sym memory)) (linklet-name (-> current module) phase 0)]
          [else (memory-owner (cadr form))])))

;; The instance that owns the memory of the instance named name: name
;; itself if its linklet declares one, or the owner of the instance its
;; memory is from, at name's shift; or 0. An instance of the kernel
;; module's group, at any shift, is the running build's (group-instance),
;; whose memory its linklet's bytes say.
(define (memory-owner [name datum]) -> datum
  (cond [(== name 0) 0]
        [(!= (group-instance name) 0) (group-memory-owner (group-instance name))]
        [else
         (let ([r (linklet-ref name)])
           (if (== r 0)
               0
               (let* ([m (car r)] [q (cast i32 (integer-value (cadr r)))] [t (cast i32 (integer-value (caddr r)))]
                      [form (module-memory m q)])
                 (cond [(== form 0) 0]
                       [(== (car form) (sym memory)) name]
                       [else (memory-owner (shifted-instance (cadr form) t))]))))]))

;; The owners of the memories of the running build's linklets, by name,
;; as found: (name . owner).
(define memory-owners datum nil)

;; The instance that owns the memory of the running build's linklet named
;; name: name if its linklet declares one, else the owner of the linklet
;; it imports its memory from.
(define (group-memory-owner [name datum]) -> datum
  (let ([p (assoc name memory-owners)])
    (if (!= p 0)
        (cdr p)
        (let* ([bytes (running-bytes name)]
               [from (linklet-memory-import (string-bytes bytes) (string-length bytes))]
               [owner (if (== from 0) name (group-memory-owner from))])
          (set! memory-owners (keep-cons (cons name owner) memory-owners))
          (cdr (car memory-owners))))))

;; The instance named name, at t more phase shift.
(define (shifted-instance [name datum] [t i32]) -> datum
  (if (or (== t 0) (kernel-name? name))
      name
      (let ([r (linklet-ref name)])
        (if (== r 0) 0 (linklet-name (car r) (cast i32 (integer-value (cadr r))) (+ (cast i32 (integer-value (caddr r))) t))))))

;; The memory form of module m's phase-q linklet: the module being
;; compiled's as declared, another's as its interface says; or 0.
(define (module-memory [m datum] [q i32]) -> datum
  (if (== m (-> current module))
      (storage-form (sym memory) q)
      (let ([p (assoc (make-integer q) (-> (unit-of m) memories))])
        (if (== p 0) 0 (cdr p)))))

;; The let bindings of an inlined call's parameters params to its arguments
;; args, recording each parameter's local in keys. A parameter the body
;; does not set, given a local that no later argument sets, is that local,
;; at the parameter's type, and needs no binding.
(define (inline-bindings [params datum] [args datum] [assigned datum] [keys (ptr hash-table)]) -> datum
  (if (null? params)
      nil
      (let* ([p (car params)] [a (unlocated (car args))])
        (if (and (== (car a) (sym lref)) (== (assoc (car p) assigned) 0)
                 (not (ormap (lambda ([later datum]) -> i32 (assigns? later (cadr a))) (cdr args))))
            (begin
              (hash-set! keys (cast u64 (integer-value (car p))) (cast u32 `(as (,(cdr p)) ,a)))
              (inline-bindings (cdr params) (cdr args) assigned keys))
            (let ([k (fresh-key!)])
              (hash-set! keys (cast u64 (integer-value (car p))) (cast u32 k))
              (cons `(,k ,(cdr p) ,(car args)) (inline-bindings (cdr params) (cdr args) assigned keys)))))))

;; The local or label key is copied as, made the first time.
(define (copied-key [table (ptr hash-table)] [key datum]) -> datum
  (let ([known (cast datum (hash-ref table (cast u64 (integer-value key))))])
    (if (!= known 0)
        known
        (let ([n (fresh-key!)])
          (hash-set! table (cast u64 (integer-value key)) (cast u32 n))
          n))))

;; The keys each of ks is copied as.
(define (copied-keys [ks datum] [table (ptr hash-table)]) -> datum
  (map (lambda ([k datum]) -> datum (copied-key table k)) ks))

;; Lowered form e of an inline body, for one inlined call: its locals and
;; labels new, its infos shifted by inline-shift, as the inlined function
;; is, and a return a br to label ret. A local that keys maps to a form, a
;; parameter given a local, reads that.
(define inline-shift u32 0)

(define (copy-inline [e datum] [keys (ptr hash-table)] [labels (ptr hash-table)] [ret datum]) -> datum
  (let ([copy (lambda ([x datum]) -> datum (copy-inline x keys labels ret))]
        [copies (lambda ([l datum]) -> datum (copy-each l keys labels ret))]
        [copy? (lambda ([x datum]) -> datum (if (== x 0) 0 (copy-inline x keys labels ret)))])
    (case (car e)
      [((sym as)) `(as ,(cadr e) ,(copy (caddr e)))]
      [((sym int) (sym float) (sym const) (sym quote) (sym unreachable) (sym nop)) e]
      [((sym lref)) (let ([m (copied-key keys (cadr e))]) (if (pair? m) m `(lref ,m)))]
      [((sym lset)) `(lset ,(copied-key keys (cadr e)) ,(copy (caddr e)))]
      [((sym gref)) `(gref ,(shift-info (cadr e) inline-shift))]
      [((sym gset)) `(gset ,(shift-info (cadr e) inline-shift) ,(copy (caddr e)))]
      [((sym let))
       `(let ,(map (lambda ([b datum]) -> datum
                     (cons (if (pair? (car b)) (copied-keys (car b) keys) (copied-key keys (car b)))
                           (cons (cadr b) (cons (copy-inline (caddr b) keys labels ret) (cdddr b)))))
                   (cadr e))
             ,(copy (caddr e)))]
      ;; A lambda copied has a key of its own, and its parameters new locals.
      [((sym lambda))
       (set! lowered-closures 1)
       `(lambda ,(fresh-key!) ,(map (lambda ([p datum]) -> datum (cons (copied-key keys (car p)) (cdr p))) (caddr e)) ,(cadddr e)
                ,(copy (list-ref e 4)))]
      [((sym apply-value)) `(apply-value ,(copy (cadr e)) ,(copies (caddr e)))]
      [((sym seq) (sym select) (sym drop) (sym values)) (cons (car e) (copies (cdr e)))]
      [((sym if)) `(if ,(copy (cadr e)) ,(copy (caddr e)) ,(copy? (cadddr e)))]
      [((sym block) (sym loop)) `(,(car e) ,(copied-key labels (cadr e)) ,(copy (caddr e)))]
      [((sym br)) `(br ,(copied-key labels (cadr e)) ,(copy? (caddr e)))]
      [((sym br-if)) `(br-if ,(copied-key labels (cadr e)) ,(copy (caddr e)))]
      [((sym br-table))
       `(br-table ,(map (lambda ([k datum]) -> datum (copied-key labels k)) (cadr e)) ,(copied-key labels (caddr e)) ,(copy (cadddr e)))]
      [((sym return)) `(br ,ret ,(copy? (cadr e)))]
      [((sym call)) `(call ,(shift-info (cadr e) inline-shift) ,(copies (caddr e)))]
      [((sym ref-func)) `(ref-func ,(shift-info (cadr e) inline-shift))]
      [((sym prim)) `(prim ,(cadr e) ,(caddr e) ,(copies (cadddr e)))]
      [((sym call-ref)) `(call-ref ,(cadr e) ,(copy (caddr e)) ,(copies (cadddr e)))]
      [((sym gc)) `(gc ,(cadr e) ,(caddr e) ,(copies (cadddr e)))]
      [((sym throw)) `(throw ,(shift-info (cadr e) inline-shift) ,(copies (caddr e)))]
      [((sym throw-ref)) `(throw-ref ,(copy (cadr e)))]
      [((sym try))
       `(try ,(map (lambda ([c datum]) -> datum
                     `(,(car c) ,(if (!= (cadr c) 0) (shift-info (cadr c) inline-shift) 0) ,(copied-keys (caddr c) keys)
                       ,(copy-inline (cadddr c) keys labels ret)))
                   (cadr e))
             ,(copy (caddr e)))]
      [else (fail-at 0 "internal: lowered form ~a" (list1 (car e)))])))

;; copy-inline of each form in l.
(define (copy-each [l datum] [keys (ptr hash-table)] [labels (ptr hash-table)] [ret datum]) -> datum
  (map (lambda ([x datum]) -> datum (copy-inline x keys labels ret)) l))

;; Keep inline function info's body code, of parameters params, named by
;; name.
(define (note-inline! [info datum] [params datum] [code datum] [name datum]) (record-inline! info params code name))
