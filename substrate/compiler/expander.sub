;; Lifecycle: permanent. Part of the compiler.
;;
;; Expander: syntax objects -> fully expanded code, which is syntax too (spec
;; 6.4) -> after #%linklet (spec 6.5), lowered to the compiler's input (core.sub).
;;
;; Binding is by sets of scopes (spec 6.1). A module is a file; each of its
;; phases compiles to one wasm module, a linklet (spec 3.1). While a module is
;; expanded, each begin-for-syntax is compiled into a linklet and run. A
;; macro's transformer is a value (spec 2.1).
;;
;; The compiler runs in a store of its own, with the kernel module its
;; macros share. Each module compilation instantiates its compile-time
;; linklets in a namespace of that store (spec 3.2), and calls macros and
;; compile-time functions directly. The expander answers the kernel
;; module's queries through functions it registers (register-queries!).
(require-unqualified substrate "../lib/substrate.sub")
(require stx "stx.sub"
         make-stx stx? stx-e stx-scopes stx-srcloc stx-props make-srcloc srcloc? srcloc-source
         id? stx->datum datum->stx stx->list stx-rewrap
         scopes-add scopes-remove scopes-subset? add-scope flip-scope remove-scopes filter-scopes
         raise-compile-error format-srcloc unlocated-error? located-error)
(require core "core.sub"
         func-info func-info? func-info-name func-info-params func-info-results func-info-instance
         func-info-export func-info-type data-info? data-info-name
         global-info global-info? global-info-name global-info-type global-info-mutable? global-info-instance
         global-info-export tag-info tag-info? tag-info-name tag-info-params tag-info-instance tag-info-export
         data-info data-info-offset data-info-bytes
         make-type-info type-info-name type-info-kind type-info-fields set-type-info-fields!
         type-info-super type-info-final? type-info-group set-type-info-group! identify-group! same-type? func-type?
         make-ref ref-type? ref-nullable? ref-heap type-info? abstract-heaps valtype<=? types<=? types=? fresh-key!)
(require ops "ops.sub" lookup-prim prim-op-params prim-op-kind prim-names)
(require cmp "compile.sub" compile-module set-syntax-lookup! set-syntax-types! set-current-source!)
(require rd "reader.sub" read-file read-string-all)
(require num "numbers.sub" content-hash)
(require host "host.sub" export-index call-getter scope-map-new scope-map-add scope-map-clear error-string read-data)
(require ser "serialize.sub" make-serializer serialize! serializer-bytes)

(provide report-trap set-repository-root! set-package-root! set-cache-directory! compile-module-file module-linklet-list
         module-expanded-forms keep-expanded-forms! target-kernel-bytes target-kernel-interface compiled-file-bytes program-linklets register-queries!)

(import %call-transformer "kernel" "%call-transformer" (eqref eqref -> eqref))

(define gc-forms
  '(struct.new struct.get struct.get_s struct.get_u struct.set
    array.new array.new_default array.new_fixed array.get array.get_s array.get_u array.set
    array.len array.copy array.fill
    ref.null ref.is_null ref.eq ref.as_non_null ref.test ref.cast ref.i31 i31.get_s i31.get_u))

;; The implicit forms (spec 5.3, 5.4) and the linklet hook (spec 6.5).
(define app-sym '#%app)
(define datum-sym '#%datum)
(define linklet-sym '#%linklet)

(define core-forms
  (append
   '(func global import memory table data type rec tag define-syntax begin-for-syntax
     begin require require-unqualified provide freestanding set! let let* lambda if block loop br br-if
     return
     call-indirect call-ref ref.func func-index data-address data-size select drop unreachable nop
     throw throw-ref try
     i32.const i64.const f32.const f64.const
     quote quasiquote unquote unquote-splicing quote-syntax quasisyntax unsyntax unsyntax-splicing)
   (list app-sym datum-sym linklet-sym)
   gc-forms))

(define eqref (make-ref #t 'eq))

;; ==== the run ====
;;
;; Everything below is shared by all modules compiled in one run of the
;; compiler: the binding table, scope ids, and compiled modules. A macro's
;; template identifiers keep resolving to its own module's bindings when
;; another module expands it, because those bindings stay in the table.

;; symbol -> scope -> list of binding, the latest first. A binding is kept
;; under the greatest scope of its set, or -1 if the set is empty: an
;; identifier can refer to it only if the identifier has that scope too.
(define bindings (make-hasheq))
;; The keys of bindings require-unqualified made, each -> whether a macro
;; use has relied on it: a definition of the same name may shadow one it
;; has not (spec 3.1).
(define unqualified-imports (make-hasheqv))
(define scope-counter 0)
(define base-installed? #f)
(define registry (make-hash))                ; normalized path -> module
(define installed (make-hash))               ; "path|shift" -> #t

;; phase: an integer, or 'all. namespace: type or value (spec 6.1). key
;; identifies the binding to compiled code (local-binding, spec 2.3).
(struct binding (scopes phase namespace key [meaning #:mutable]))

;; meaning: (core name) (prim name) (func info) (global info) (data info)
;;          (type info) (tag info) (local key) (label key) (compile-time-value getter-info)
;; A name bound to a compile-time value that is a transformer is a macro.
;; A type meaning is in the type namespace, every other one in the value
;; namespace. Locals and labels are bound before their meaning is set, so
;; #f counts as a value.
(define (meaning-namespace meaning)
  (if (and meaning (eq? (car meaning) 'type)) 'type 'value))

;; A compiled (or compiling) module. linklets: phase -> linklet, compiled
;; against the running kernel, for compile time. program: its phase-0
;; linklet compiled against the target kernel, for programs. requires:
;; list of (module . shift). provides: list of (symbol . meaning). entries:
;; its module-level bindings, as (symbol scopes phase binding). scope: its
;; module scope. hash: its identity, of its source and its requires'
;; hashes (spec 3.2). name: what its instance names start with, its
;; stem and hash. path: its file, which its source locations name (3.6),
;; or (compiled file hash) for a module loaded from a compiled file (3.7).
(struct unit (path [name #:mutable] [hash #:mutable] [state #:mutable] linklets [requires #:mutable] [provides #:mutable]
              [entries #:mutable] [expanded #:mutable] [scope #:mutable] [program #:mutable]
              scopes                                  ; index -> the scopes its expansion made, in order
              [types #:mutable]                       ; the types it declared, in order
              [infos #:mutable]))                     ; its functions, globals and tags, newest first

(define (new-unit path name)
  (unit path name #f 'compiling (make-hasheqv) '() '() '() #f #f #f (make-hasheqv) '() '()))

(define units-by-hash (make-hash))           ; hash -> unit
(define scope-owners (make-hasheqv))         ; scope -> (unit . index): the unit whose expansion made it
(define type-owners (make-hasheq))           ; type-info -> (unit . index) in the unit's types

;; One phase of a module, compiled: bytes, the instance names it imports
;; from (relative to the module at phase shift 0), whether it uses GC, and
;; the scope table of its syntax literals (spec 3.5): the run's scope for
;; each index.
(struct linklet (bytes imports gc? scopes))

;; The compile-time instances of one module compilation: a namespace in
;; the compiler's store (spec 3.2). instances: names instantiated in it.
;; values: getter info -> (value), the compile-time values fetched so far.
(struct cstore (ns instances values [counter #:mutable]))

;; The state of one module's compilation.
(struct comp (module store [linklet-counter #:mutable] [use-site-scopes #:mutable]
              [freestanding-form #:mutable] phase-forms memories tables [provide-ids #:mutable]
              [require-names #:mutable]            ; ((name . phase) . module)
              [definitions #:mutable]              ; the bindings of its phase-0 definitions
              [storage-linklets #:mutable]         ; ((memory-or-table . phase) . linklet that defines it)
              [pending #:mutable]))                ; define-syntax units not yet run: (phase where . forms), newest first

(define current #f)                      ; the comp being expanded

;; A scope of the module being expanded: numbered in it, so an interface
;; can name it (3.7). A module scope's copy for a phase shift, and the
;; kernel functions' scope, belong to the run.
(define (new-scope!)
  (let ([sc (new-run-scope!)])
    (when current (own-scope! (comp-module current) sc))
    sc))

(define (new-run-scope!) (set! scope-counter (+ scope-counter 1)) scope-counter)

(define (own-scope! m sc)
  (let ([i (hash-count (unit-scopes m))])
    (hash-set! (unit-scopes m) i sc)
    (hash-set! scope-owners sc (cons m i))))

;; Scope i of module m: made now, if m was loaded from the cache.
(define (unit-scope-at m i)
  (or (hash-ref (unit-scopes m) i #f)
      (let ([sc (new-run-scope!)])
        (hash-set! (unit-scopes m) i sc)
        (hash-set! scope-owners sc (cons m i))
        sc)))

;; The scopes of local binding forms: func, let, let*, block and loop.
;; quote-syntax prunes them from its literal (spec 6.2).
(define local-scopes (make-hasheqv))
(define (new-local-scope!)
  (let ([sc (new-scope!)]) (hash-set! local-scopes sc #t) sc))
(define (prune-local-scopes x)
  (filter-scopes x (lambda (sc) (not (hash-has-key? local-scopes sc)))))

(define core-scope 0)

;; ---- the kernel module ----
;;
;; compiler/kernel.sub under the repository's root: the kernel's data and
;; the functions on it (spec 2), which the compiler carries into the
;; programs it writes. There are two builds of it, which are one except
;; while a compiler builds a new one whose kernel module changed (spec
;; 1.4): the running kernel, the one this compiler runs with, whose
;; instance it shares with its macros, and the target kernel,
;; compiler/kernel.sub, which the programs it writes link to. Compile-time
;; code is compiled against the running kernel, and programs against the
;; target kernel. The compiler carries the running kernel, compiled; when
;; compiler/kernel.sub hashes to it, the two are one. Names are bound to
;; the target kernel's definitions, and code compiled against the running
;; kernel uses its definitions of the same names. The source locations of
;; both name them compiler/kernel.sub, whatever the root is: the
;; compiler's bytes do not depend on where the repository is.

(define kernel-path "compiler/kernel.sub")

(define repository-root #f)
(define (set-repository-root! root) (set! repository-root root))

;; The kernel this compiler runs with, compiled: the module in
;; build/kernel.subc under the root when this compiler was compiled (spec
;; 3.7), which the compiler compiling it wrote from its target kernel
;; (sub kernel), the kernel it gives this compiler to run with; or #f
;; when there was none.
(begin-for-syntax
  (require-unqualified substrate "../lib/substrate.sub")
  (require host "host.sub" read-data)
  (require num "numbers.sub" content-hash))
(define-syntax (compiled-kernel stx)
  (let* ([root (vector-ref (current-command-line-arguments) 0)]
         [ds (read-data (string-append root "/build/kernel.subc"))])
    (cond [(not ds) (datum->syntax stx #f stx)]
          [(not (equal? (cdr (assq 'hash (car ds))) (content-hash (list (file->string (string-append root "/compiler/kernel.sub"))))))
           (error 'compiled-kernel "build/kernel.subc is not of compiler/kernel.sub: write it again with sub kernel")]
          [else (datum->syntax stx (list 'quote (car ds)) stx)])))
(define embedded-kernel (compiled-kernel))

;; A build of the kernel module: its unit, whose one linklet it is and
;; whose hash is of its source; the lowered bodies of the inline
;; functions that code compiled against it inlines, its own and those of
;; the modules compiled against it; and its string and table types, which
;; quoted data is read with (spec 3.5).
(struct kernel (unit inlines [string-type #:mutable] [table-type #:mutable]))

(define (kernel-hash k) (unit-hash (kernel-unit k)))
(define (kernel-bytes k) (linklet-bytes (unit-program (kernel-unit k))))

;; Kernel k's definition of kind named name, or #f; and its function
;; named name, which it must have.
(define (kernel-definition k kind name) (unit-definition (kernel-unit k) "kernel" kind (symbol->string name)))
(define (kernel-function k name)
  (or (kernel-definition k 'func name) (raise-compile-error #f "internal: the kernel module has no ~a" name)))

(define running-kernel #f)
(define target-kernel #f)

;; The kernel that code is lowered and compiled against: the running
;; kernel, but for a program's phase-0 linklets (finish-module!), and
;; while a kernel is compiled, that kernel, whose infos are #f.
(define lowering-kernel #f)

(define (set-lowering-kernel! k)
  (set! lowering-kernel k)
  (set-syntax-lookup! (and (eq? (unit-state (kernel-unit k)) 'done) (lambda (kind name) (kernel-definition k kind name))))
  (set-syntax-types! (kernel-string-type k) (kernel-table-type k)))

;; (thunk), with code lowered and compiled against kernel k.
(define (with-kernel k thunk)
  (let ([saved lowering-kernel])
    (set-lowering-kernel! k)
    (let ([r (thunk)])
      (when saved (set-lowering-kernel! saved))
      r)))

(define (ensure-kernels!)
  (unless target-kernel
    (let ([text (file->string (string-append repository-root "/" kernel-path))] [d embedded-kernel])
      ;; The running kernel is the embedded one, unless there is none or
      ;; it is of a format this compiler does not read: then
      ;; compiler/kernel.sub is its source.
      (set! running-kernel
            (if (and d (eqv? (section d 'format) interface-format)) (load-kernel d) (compile-kernel text)))
      (set! target-kernel
            (if (string=? (kernel-hash running-kernel) (content-hash (list text))) running-kernel (compile-kernel text)))
      (unless (eq? running-kernel target-kernel) (check-shared-types! running-kernel target-kernel))
      (set-lowering-kernel! running-kernel))))

;; A type the kernel declares on its own is the same type in every module
;; that declares it, so it may not differ between the kernel a build runs
;; with and the one it builds for (spec 1.4): stop if one does.
(define (check-shared-types! running target)
  (for-each (lambda (t)
              (let ([r (findf (lambda (x) (eq? (type-info-name x) (type-info-name t))) (unit-types (kernel-unit running)))])
                (when (and r (not (same-type? r t)))
                  (raise-compile-error #f "the kernel's type ~a, shared by structure, differs from the running kernel's: change it in a build of its own (spec 1.4)"
                                       (type-info-name t)))))
            (filter (lambda (t) (not (type-info-group t))) (unit-types (kernel-unit target)))))

;; The kernel module whose source is text, compiled: a unit whose one
;; linklet is the kernel, its instance named kernel.
(define (compile-kernel text)
  (let* ([m (new-unit kernel-path "kernel")]
         [k (kernel m (make-hasheq) #f #f)]
         [c (comp m #f 0 '() #f (make-hasheqv) (make-hasheqv) (make-hasheqv) '() '() '() '() #f)])
    (set-unit-hash! m (content-hash (list text)))
    (hash-set! units-by-hash (unit-hash m) m)
    (with-comp c
      (lambda ()
        (with-kernel k
          (lambda ()
            (let* ([forms (lower-forms (expand-module-body (read-string-all text (string->symbol kernel-path))) 0)]
                   [forms (append (storage-forms 0) forms)])
              (note-definitions! m forms)
              (take-kernel-types! k)
              (set-current-source! (string->symbol kernel-path))
              (hash-set! (unit-linklets m) 0 (compiled-linklet (compile-module forms "kernel")))
              (set-unit-program! m (hash-ref (unit-linklets m) 0))
              (set-unit-state! m 'done))))))
    k))

;; The kernel module whose compiled form is d.
(define (load-kernel d)
  (let* ([m (new-unit kernel-path "kernel")] [k (kernel m (make-hasheq) #f #f)])
    (with-kernel k (lambda () (load-module! m d)))
    (take-kernel-types! k)
    k))

;; Kernel k's string and table types, from its unit: quoted data is read
;; with them (spec 3.5).
(define (take-kernel-types! k)
  (let ([type (lambda (name) (findf (lambda (t) (eq? (type-info-name t) name)) (unit-types (kernel-unit k))))])
    (set-kernel-string-type! k (type '%string))
    (set-kernel-table-type! k (type '%table))
    (set-syntax-types! (kernel-string-type k) (kernel-table-type k))))

(define (target-kernel-bytes) (ensure-kernels!) (kernel-bytes target-kernel))

;; The target kernel as a compiled file's bytes (spec 3.7): what the
;; compiler compiled next embeds.
(define (target-kernel-interface)
  (ensure-kernels!)
  (data-bytes (list (with-kernel target-kernel (lambda () (write-interface (kernel-unit target-kernel)))))))

;; info, a definition that code names, as the kernel the code is lowered
;; against has it: if info is the target kernel's, and code is lowered
;; against the running kernel, the running kernel's definition of the same
;; name. id is where it is named.
(define (in-lowering-kernel info id)
  (if (or (not target-kernel) (eq? lowering-kernel target-kernel) (data-info? info))
      info
      (let ([name (info-name info)] [kind (info-kind info)])
        (if (eq? (kernel-definition target-kernel kind name) info)
            (or (kernel-definition lowering-kernel kind name)
                (raise-compile-error id "~a is not in the kernel this compiler runs with: compile-time code can use it once the compiler that compiles it has it (spec 1.4)"
                                     name))
            info))))

;; ==== the cache ====
;;
;; With a cache directory (sub build -c DIR), a module compiled once is
;; loaded from the cache while its source and its requires are as they
;; were (spec 3.7): its interface, what the expander keeps of a module it
;; compiled, its linklets inside, as quoted data in the kernel's format
;; (spec 3.5). An interface starts with what it is of: the interface
;; format, the kernel, the module and its requires, by hash. The cache
;; holds one kernel's code, so it is neither read nor written while the
;; running and target kernels differ (spec 1.4).

(define cache-directory #f)
(define (set-cache-directory! dir) (set! cache-directory dir))

(define interface-format 6)

;; Does the run have one kernel, the running and target kernels being one?
(define (one-kernel?) (eq? running-kernel target-kernel))

;; The kernel the cache is for, by hash: the run's one kernel, when there
;; is a cache directory; else #f.
(define (cache-kernel) (and cache-directory (one-kernel?) (kernel-hash target-kernel)))

(define (cache-file name) (string-append cache-directory "/" name))

;; datum, in the kernel's data format.
(define (data-bytes datum)
  (let ([s (make-serializer)])
    (serialize! s datum)
    (serializer-bytes s)))

;; Section key of interface d.
(define (section d key) (cdr (assq key d)))

;; The module at path, from the cache, if the cache has one for it that
;; is of this format and kernel, and of the source and requires as they
;; are now; else #f. The source is checked first, with the hashes its
;; requires had; then the requires are compiled or loaded in order, as
;; they would be, until one is not as it was.
(define (load-cached path)
  (let* ([kernel (cache-kernel)]
         [hash (and kernel (read-data (cache-file (string-append (content-hash (list path)) ".path"))))]
         [ds (and hash (read-data (cache-file (string-append hash ".subc"))))]
         [d (and ds (car ds))])
    (and d (eqv? (section d 'format) interface-format) (equal? (section d 'kernel) kernel)
         (let ([requires (section d 'requires)])                     ; each (path hash shift)
           (and (string=? (module-hash path (file->string path) (map cdr requires)) hash)
                (begin
                  (hash-set! registry path (new-unit path hash))    ; a cycle through the requires is an error, as when compiling
                  (cond [(andmap (lambda (r) (string=? (unit-hash (module-of (car r))) (cadr r))) requires)
                         (let ([m (or (hash-ref units-by-hash hash #f)          ; brought by a compiled file (3.7)
                                      (load-compiled-module d path))])
                           (hash-set! registry path m)
                           m)]
                        [else (hash-remove! registry path) #f])))))))

;; The module a recorded require names: the module in a file, compiled
;; or loaded as it would be, or the entry of a compiled file.
(define (module-of spec)
  (if (pair? spec) (load-compiled-file (cadr spec)) (compile-module-file spec)))

;; Module m's interface, written once for the cache and a compiled file.
(define interfaces (make-hasheq))              ; unit -> its interface
(define (interface-of m)
  (or (hash-ref interfaces m #f)
      (let ([d (write-interface m)]) (hash-set! interfaces m d) d)))

;; Write module m to the cache: its compiled file, and the index entry
;; for its path.
(define (store-cached! m)
  (when (cache-kernel)
    (with-handlers ([exn? (lambda (e) #f)])
      (display-to-file (data-bytes (list (interface-of m))) (cache-file (string-append (unit-hash m) ".subc")))
      (store-index! m))))

;; ---- compiled files ----
;;
;; A compiled file (spec 3.7) holds modules, each its interface with its
;; linklets inside: those a module requires before it, the entry last.
;; The cache's files hold one module each; sub build -m writes a
;; program's closure to one, for (require name (compiled file)).

;; The bytes of the compiled file of module m and its requires.
(define (compiled-file-bytes m)
  (unless (one-kernel?)
    (raise-compile-error #f "a compiled file holds one kernel's code, and this build has two (spec 1.4)"))
  (data-bytes (map interface-of (module-closure m))))

;; Module m and every module it requires, at any phase shift,
;; transitively, each once, after those it requires.
(define (module-closure m)
  (let ([seen (make-hasheq)] [out '()])
    (let visit ([m m])
      (unless (hash-ref seen m #f)
        (hash-set! seen m #t)
        (for-each (lambda (r) (visit (car r))) (unit-requires m))
        (set! out (cons m out))))
    (reverse out)))

;; The entry of the compiled file at path, its modules loaded in order,
;; but for those this run has made already.
(define (load-compiled-file path)
  (let ([ds (read-data path)])
    (unless ds (raise-compile-error #f "no compiled file ~a" path))
    (foldl (lambda (d entry)
             (or (hash-ref units-by-hash (section d 'hash) #f)
                 (load-compiled-module d (list 'compiled path (section d 'hash)))))
           #f ds)))

;; Module d of a compiled file, loaded, its requires being modules this
;; run has; known by path. It must be of this interface format and of
;; the run's kernel.
(define (load-compiled-module d path)
  (let ([m (new-unit path (section d 'hash))])
    (unless (eqv? (section d 'format) interface-format)
      (raise-compile-error #f "the compiled module ~a is of another interface format" path))
    (unless (equal? (section d 'kernel) (kernel-hash target-kernel))
      (raise-compile-error #f "the compiled module ~a was compiled for another kernel" path))
    (set-unit-requires! m (map (lambda (r)
                                 (cons (or (hash-ref units-by-hash (cadr r) #f)
                                           (raise-compile-error #f "the compiled module ~a requires ~a, which is not with it" path (cadr r)))
                                       (caddr r)))
                               (section d 'requires)))
    (load-module! m d)
    m))

;; The cache's entry for m's path: the hash of the module there.
(define (store-index! m)
  (when (cache-kernel)
    (with-handlers ([exn? (lambda (e) #f)])
      (display-to-file (data-bytes (unit-hash m)) (cache-file (string-append (content-hash (list (unit-path m))) ".path"))))))

;; ---- interfaces ----
;;
;; An interface names what belongs to a run relative to modules, by hash.
;; A scope is core, kernel-ids, (m hash shift), a module scope's copy for
;; a phase shift, or (s hash index), the index-th scope a module's
;; expansion made. The other sections hold the module's data as the
;; expander keeps it, written with encode: a type in them is (%type i),
;; the module's i-th, or (%type hash i), another module's; a definition is
;; (%info own i), the i-th of the infos section, (%info foreign instance
;; kind export), another module's, the kernel module's among them, or
;; (%info shifted d k), definition d shifted by k (6.1); and a list that
;; starts with %type, %info or %quote, such as a struct field named so,
;; has %quote put before it. load-module! reads them back with decode.
;; Its sections are an alist of quoted data, the first four saying what it
;; is of.

(define (write-interface m)
  (let ([own (make-hasheq)] [own-list '()] [type-index (make-hasheq)] [types (unit-types m)])
    (for-each (lambda (t i) (hash-set! type-index t i)) types (range (length types)))
    (letrec
        ([encode (lambda (x)
                   (cond [(type-info? x) (cons '%type (type-ref x))]
                         [(or (func-info? x) (global-info? x) (tag-info? x) (data-info? x)) (cons '%info (info-ref x))]
                         [(and (pair? x) (memq (car x) '(%type %info %quote))) (cons '%quote (cons (car x) (encode (cdr x))))]
                         [(pair? x) (cons (encode (car x)) (encode (cdr x)))]
                         [else x]))]
         [type-ref (lambda (t)
                     (let ([i (hash-ref type-index t #f)] [o (hash-ref type-owners t #f)])
                       (cond [i (list i)]
                             [o (list (unit-hash (car o)) (cdr o))]
                             [else (raise-compile-error #f "internal: the type ~a belongs to no module" (type-info-name t))])))]
         [own-ref (lambda (info)
                    (list 'own (or (hash-ref own info #f)
                                   (let ([i (hash-count own)])
                                     (hash-set! own info i)
                                     (set! own-list (cons info own-list))
                                     i))))]
         [info-ref (lambda (info)
                     (let ([origin (hash-ref shift-origins info #f)] [instance (info-instance info)])
                       (cond [origin (list 'shifted (encode (car origin)) (cdr origin))]
                             [(data-info? info) (own-ref info)]
                             [(and instance (instance-unit instance) (not (own-instance? m instance)))
                              (list 'foreign instance (info-kind info) (info-export info))]
                             [else (own-ref info)])))]
         [sref (lambda (sc)
                 (let ([origin (hash-ref module-scope-origins sc #f)] [owner (hash-ref scope-owners sc #f)])
                   (cond [(= sc core-scope) 'core]
                         [(eqv? sc kernel-id-scope) 'kernel-ids]
                         [origin (list 'm (unit-hash (car origin)) (cdr origin))]
                         [owner (list 's (unit-hash (car owner)) (cdr owner))]
                         [else (raise-compile-error #f "internal: scope ~a belongs to no module" sc)])))]
         [own? (lambda (info) (own-instance? m (info-instance info)))]
         ;; Encoded lists that start with one of its own definitions, in
         ;; the order of their indexes.
         [by-index (lambda (l) (sort l (lambda (a b) (< (caddr (car a)) (caddr (car b))))))])
      (for-each own-ref (reverse (unit-infos m)))     ; every definition, in order, before what else is referred to
      (let* ([linklets (map (lambda (p)
                              (let ([l (hash-ref (unit-linklets m) p)])
                                (list p (linklet-bytes l) (linklet-imports l) (linklet-gc? l) (map sref (linklet-scopes l)))))
                            (sort (hash-keys (unit-linklets m)) <))]
             [provides (map (lambda (p) (cons (car p) (encode (cdr p)))) (unit-provides m))]
             [entries (map (lambda (e)
                             (list (car e) (sort (map sref (cadr e)) scope-ref<?) (caddr e) (encode (binding-meaning (cadddr e)))))
                           (reverse (unit-entries m)))]
             [values (by-index (filter (lambda (v) v)
                                       (map (lambda (f) (let ([g (function-value f)]) (and g (encode (list f g)))))
                                            (filter own? (hash-keys function-values)))))]
             [inlines (by-index (map (lambda (f)
                                       (let ([b (hash-ref (kernel-inlines lowering-kernel) f)])
                                         (encode (list f (car b) (cadr b) (without-locations (caddr b)) (cadddr b)
                                                       (map car (list-ref b 4))))))
                                     (filter own? (hash-keys (kernel-inlines lowering-kernel)))))]
             [macros (by-index (map (lambda (g) (encode (list g)))
                                    (filter (lambda (g) (eq? (hash-ref macro-modules g) m)) (hash-keys macro-modules))))]
             [type-forms (map (lambda (t)
                                (list (type-info-name t) (type-info-kind t) (type-info-final? t)
                                      (encode (type-info-super t)) (encode (type-info-fields t))))
                              types)]
             [groups (let loop ([ts types] [i 0] [acc '()])
                       (cond [(null? ts) (reverse acc)]
                             [(and (type-info-group (car ts)) (eq? (car ts) (car (type-info-group (car ts)))))
                              (let ([n (length (type-info-group (car ts)))])
                                (loop (list-tail ts n) (+ i n) (cons (range i (+ i n)) acc)))]
                             [else (loop (cdr ts) (+ i 1) acc)]))]
             [infos (map (lambda (info) (encode (info->list info))) (reverse own-list))])
        (list (cons 'format interface-format) (cons 'kernel (kernel-hash target-kernel)) (cons 'hash (unit-hash m))
              (cons 'definitions (length (unit-infos m)))
              (cons 'requires (map (lambda (r) (list (unit-path (car r)) (unit-hash (car r)) (cdr r))) (unit-requires m)))
              (cons 'name (unit-name m)) (cons 'types type-forms) (cons 'groups groups)
              (cons 'infos infos) (cons 'provides provides) (cons 'entries entries) (cons 'values values)
              (cons 'inlines inlines) (cons 'macros macros) (cons 'linklets linklets))))))

;; Scope references in an order that does not depend on the run, for a
;; binding's scope set; loaded, a set is sorted by the run's numbers.
(define (scope-ref<? a b) (string<? (format "~s" a) (format "~s" b)))

;; Lowered form e without its source locations, for an inline body, whose
;; code takes the location of the call it is inlined at (spec 3.6).
(define (without-locations e)
  (cond [(not (pair? e)) e]
        [(eq? (car e) 'at) (without-locations (caddr e))]
        [(eq? (car e) 'quote) e]
        [else (let loop ([l e]) (if (pair? l) (cons (without-locations (car l)) (loop (cdr l))) l))]))

;; Definition info as a list, (kind field ...), its fields in the order
;; its constructor takes them; and the definition such a list describes.
(define (info->list info)
  (cond [(func-info? info)
         (list 'func (func-info-name info) (func-info-params info) (func-info-results info)
               (func-info-instance info) (func-info-export info) (func-info-type info))]
        [(global-info? info)
         (list 'global (global-info-name info) (global-info-type info) (global-info-mutable? info)
               (global-info-instance info) (global-info-export info))]
        [(tag-info? info) (list 'tag (tag-info-name info) (tag-info-params info) (tag-info-instance info) (tag-info-export info))]
        [else (list 'data (data-info-name info) (data-info-offset info) (data-info-bytes info))]))

(define (list->info l)
  (apply (case (car l) [(func) func-info] [(global) global-info] [(tag) tag-info] [else data-info]) (cdr l)))

;; Load module m from its interface d, as if it had been compiled in
;; this run.
(define (load-module! m d)
  (set-unit-name! m (section d 'name))
  (set-unit-hash! m (section d 'hash))
  (hash-set! units-by-hash (unit-hash m) m)
  (set-unit-scope! m (new-run-scope!))
  (hash-set! module-scope-origins (unit-scope m) (cons m 0))
  (let* ([type-forms (section d 'types)]
         [shells (make-vector (length type-forms) #f)]
         [infos (make-vector (length (section d 'infos)) #f)])
    (letrec
        ([decode (lambda (x)
                   (cond [(not (pair? x)) x]
                         [(eq? (car x) '%type) (type-at (cdr x))]
                         [(eq? (car x) '%info) (info-at (cdr x))]
                         [(eq? (car x) '%quote) (cons (cadr x) (decode (cddr x)))]
                         [else (cons (decode (car x)) (decode (cdr x)))]))]
         [type-at (lambda (r)
                    (if (null? (cdr r))
                        (vector-ref shells (car r))
                        (list-ref (unit-types (unit-with-hash (car r))) (cadr r))))]
         [info-at (lambda (r)
                    (case (car r)
                      [(own) (vector-ref infos (cadr r))]
                      [(shifted) (shift-info (decode (cadr r)) (caddr r))]
                      [else (or (find-info (cadr r) (caddr r) (cadddr r))
                                (raise-compile-error #f "the cache is inconsistent: no ~a ~a in ~a" (caddr r) (cadddr r) (cadr r)))]))]
         [sres (lambda (r)
                 (cond [(eq? r 'core) core-scope]
                       [(eq? r 'kernel-ids) (kernel-id-scope!)]
                       [(eq? (car r) 'm) (module-scope-at (unit-with-hash (cadr r)) (caddr r))]
                       [else (unit-scope-at (unit-with-hash (cadr r)) (caddr r))]))])
      ;; Types: each after its supertype; fields, which may name later
      ;; types of a group, once all exist; identities in order.
      (for-each (lambda (f i)
                  (vector-set! shells i (make-type-info (car f) (cadr f) #f (decode (cadddr f)) (caddr f) #f)))
                type-forms (range (length type-forms)))
      (for-each (lambda (f t) (set-type-info-fields! t (decode (list-ref f 4)))) type-forms (vector->list shells))
      (for-each (lambda (g)
                  (let ([members (map (lambda (i) (vector-ref shells i)) g)])
                    (for-each (lambda (t) (set-type-info-group! t members)) members)))
                (section d 'groups))
      (for-each (lambda (t)
                  (let ([g (type-info-group t)])
                    (cond [(not g) (identify-group! (list t))]
                          [(eq? t (car g)) (identify-group! g)]
                          [else #f])))
                (vector->list shells))
      (for-each (lambda (t) (own-type! m t)) (vector->list shells))
      ;; Its linklets; the program is phase 0's.
      (for-each (lambda (l)
                  (hash-set! (unit-linklets m) (car l)
                             (linklet (cadr l) (caddr l) (cadddr l) (map sres (list-ref l 4))))
                  (linklet-name m (car l) 0))
                (section d 'linklets))
      ;; Definitions: the first are its own, as note-definitions! notes
      ;; them; the rest are what else its sections refer to.
      (for-each (lambda (f i)
                  (let ([info (list->info (decode f))])
                    (vector-set! infos i info)
                    (when (< i (section d 'definitions)) (note-info! m info))))
                (section d 'infos) (range (length (section d 'infos))))
      ;; What the expander keeps of a module: its bindings, provides,
      ;; function values, inline bodies and macros.
      (set-unit-entries! m (reverse (map (lambda (e)
                                           (let ([scopes (sort (map sres (cadr e)) >)])
                                             (list (car e) scopes (caddr e)
                                                   (bind-raw! (car e) scopes (caddr e) (decode (cadddr e))))))
                                         (section d 'entries))))
      (set-unit-provides! m (map (lambda (p) (cons (car p) (decode (cdr p)))) (section d 'provides)))
      (for-each (lambda (v) (let ([v (decode v)]) (hash-set! function-values (car v) (cadr v)))) (section d 'values))
      (for-each (lambda (x)
                  (let* ([x (decode x)] [params (cadr x)])
                    (hash-set! (kernel-inlines lowering-kernel) (car x)
                               (list params (caddr x) (cadddr x) (list-ref x 4)
                                     (filter (lambda (p) (memv (car p) (list-ref x 5))) params)))))
                (section d 'inlines))
      (for-each (lambda (g) (hash-set! macro-modules (decode (car g)) m)) (section d 'macros))
      (set-unit-program! m (hash-ref (unit-linklets m) 0))
      (set-unit-state! m 'done)
      ;; As its requires would have when it was compiled: its own
      ;; bindings are made, and its requires' installed at their shifts.
      (install-module-bindings! m 0))))

(define (unit-with-hash hash)
  (or (hash-ref units-by-hash hash #f)
      (raise-compile-error #f "the cache is inconsistent: no module ~a" hash)))

(define (kernel-id-scope!)
  (unless kernel-id-scope (set! kernel-id-scope (new-run-scope!)))
  kernel-id-scope)

;; ---- instances ----

(define namespace-counter 0)

(define (new-cstore)
  (ensure-kernels!)
  (set! namespace-counter (+ namespace-counter 1))
  (cstore (format "c~a" namespace-counter) (make-hash) (make-hasheq) 0))

;; Instance name, in st's namespace.
(define (ns-name st name) (string-append (cstore-ns st) "/" name))

;; Instance names (spec 3.2): "<module>@<phase>+<shift>" for a module's
;; linklet at a phase shift, and "<module>@<phase>#<n>" for the n-th
;; compile-time linklet of a module being compiled. The compiler reads a
;; name back only through this table: name -> (module phase shift), or
;; (module phase) for a compile-time linklet.
(define instance-refs (make-hash))

(define (linklet-name m q t)
  (let ([name (format "~a@~a+~a" (unit-name m) q t)])
    (unless (hash-has-key? instance-refs name) (hash-set! instance-refs name (list m q t)))
    name))

;; The module linklet an instance name names, as (module phase shift), or #f.
(define (linklet-ref name)
  (let ([r (hash-ref instance-refs name #f)])
    (and r (pair? (cddr r)) r)))

;; The module whose linklet the instance named name is, or #f: the
;; kernel module's instance is named kernel.
(define (instance-unit name)
  (if (string=? name "kernel")
      (kernel-unit target-kernel)
      (let ([r (linklet-ref name)]) (and r (car r)))))

;; Is instance one of module m's linklets?
(define (own-instance? m instance) (and instance (eq? (instance-unit instance) m)))

;; What linklet p's imports link to in st when it is instantiated at phase
;; shift t: an alist from each module name its code imports from to the
;; instance that is. A module linklet's name, relative to shift 0, moves
;; by t; a compile-time linklet is in st; the kernel module and the host
;; keep their names.
(define (import-map st imports t)
  (foldl (lambda (imp acc)
           (let ([r (hash-ref instance-refs imp #f)])
             (cond [(not r) acc]
                   [(pair? (cddr r)) (cons (cons imp (ns-name st (linklet-name (car r) (cadr r) (+ (caddr r) t)))) acc)]
                   [else (cons (cons imp (ns-name st imp)) acc)])))
         '() imports))

;; Make sure the instance an import names exists in st. imp is relative to
;; a module instantiated at phase shift `shift`. The kernel module is the
;; store's own.
(define (ensure-import! st imp shift)
  (let ([r (linklet-ref imp)])
    (when r (ensure-linklet! st (car r) (cadr r) (+ (caddr r) shift)))))

;; Instantiate module m's phase-q linklet at phase shift t in st,
;; dependencies first.
(define (ensure-linklet! st m q t)
  (let ([name (linklet-name m q t)])
    (unless (hash-ref (cstore-instances st) name #f)
      (let ([p (hash-ref (unit-linklets m) q #f)])
        (unless p (raise-compile-error #f "internal: ~a has no phase ~a linklet" (unit-name m) q))
        (for-each (lambda (imp) (ensure-import! st imp t)) (linklet-imports p))
        (let ([err (with-scope-map (linklet-scopes p) t
                     (lambda () (instantiate (ns-name st name) (linklet-bytes p) (import-map st (linklet-imports p) t))))])
          (when err
            (eprintf "error: ~a~n" err)
            (exit 2)))
        (hash-set! (cstore-instances st) name #t)))))

;; (thunk), while the kernel module maps a linklet's scope table to the
;; run's scopes at phase shift t (spec 3.5): a module scope, module X's
;; copy for phase shift s, to X's copy for s + t, which shifts the
;; literals of a linklet instantiated at a phase shift (spec 6.1); any
;; other scope to itself.
(define (with-scope-map scopes t thunk)
  (scope-map-new (length scopes))
  (for-each (lambda (i sc)
              (let ([origin (hash-ref module-scope-origins sc #f)])
                (scope-map-add i (if origin (module-scope-at (car origin) (+ (cdr origin) t)) sc))))
            (range (length scopes)) scopes)
  (let ([r (thunk)])
    (scope-map-clear)
    r))


;; ---- bindings ----

;; The scope a binding with these scopes is kept under.
(define (binding-slot scopes) (if (null? scopes) -1 (car scopes)))

;; The bindings of sym kept under scope sc.
(define (bindings-under sym sc)
  (let ([t (hash-ref bindings sym #f)])
    (if t (hash-ref t sc '()) '())))

(define (update-bindings-under! sym sc f)
  (let ([t (or (hash-ref bindings sym #f)
               (let ([t (make-hasheqv)]) (hash-set! bindings sym t) t))])
    (hash-set! t sc (f (hash-ref t sc '())))))

;; Bind sym with these scopes at phase to meaning: the binding.
(define (bind-raw! sym scopes phase meaning)
  (let ([b (binding scopes phase (meaning-namespace meaning) (fresh-key!) meaning)])
    (update-bindings-under! sym (binding-slot scopes) (lambda (l) (cons b l)))
    b))

;; A module-level binding of the current module: recorded, so that a
;; module requiring this one at a phase shift can install a shifted copy.
(define (bind-module-level! sym scopes phase meaning)
  (let ([b (bind-raw! sym scopes phase meaning)])
    (when current
      (let ([m (comp-module current)])
        (set-unit-entries! m (cons (list sym scopes phase b) (unit-entries m)))))
    b))

(define (bind! id phase meaning) (bind-raw! (stx-e id) (stx-scopes id) phase meaning))

(define (check-unbound! id phase meaning)
  (for-each (lambda (b)
              (when (and (eqv? (binding-phase b) phase) (equal? (binding-scopes b) (stx-scopes id))
                         (eq? (binding-namespace b) (meaning-namespace meaning))
                         (not (equal? (binding-meaning b) meaning)))
                (raise-compile-error id "~a is already bound~a" (stx-e id)
                                     (if (> phase 0) (format " at phase ~a" phase) ""))))
            (bindings-under (stx-e id) (binding-slot (stx-scopes id)))))

;; Bind a module-level definition. Use-site scopes come off the name, so a
;; definition a macro makes from its input is visible to the rest of the
;; module (spec 6.2). A second binding of the same name with the same
;; scopes at the same phase is an error, except that a definition shadows
;; what require-unqualified imports (spec 3.1), and in what #%linklet
;; returns, where it replaces this module's definition (spec 6.5).
(define (bind-definition! id0 phase meaning)
  (let ([id (remove-scopes id0 (comp-use-site-scopes current))])
    (unless (and redefining? (redefine! id phase meaning))
      (shadow-import! id phase meaning)
      (check-unbound! id phase meaning)
      (let ([b (bind-module-level! (stx-e id) (stx-scopes id) phase meaning)])
        (when (eqv? phase 0)
          (set-comp-definitions! current (cons b (comp-definitions current))))))))

;; A definition shadows a binding require-unqualified made with the same
;; name, scopes, phase and namespace: that binding goes, here and in the
;; module's recorded entries (spec 3.1). It is an error if a macro use in
;; this module already relied on it.
(define (shadow-import! id phase meaning)
  (let ([b (findf (lambda (b)
                    (and (eqv? (binding-phase b) phase) (equal? (binding-scopes b) (stx-scopes id))
                         (eq? (binding-namespace b) (meaning-namespace meaning))
                         (hash-has-key? unqualified-imports b)))
                  (bindings-under (stx-e id) (binding-slot (stx-scopes id))))])
    (when b
      (when (hash-ref unqualified-imports b #f)
        (raise-compile-error id "~a is defined here, but a macro use before this definition used the ~a it imports"
                             (stx-e id) (stx-e id)))
      (hash-remove! unqualified-imports b)
      (update-bindings-under! (stx-e id) (binding-slot (binding-scopes b))
                              (lambda (l) (filter (lambda (x) (not (eq? x b))) l)))
      (let ([m (comp-module current)])
        (set-unit-entries! m (filter (lambda (e) (not (eq? (cadddr e) b))) (unit-entries m)))))))

;; A macro use relied on id's binding: if require-unqualified made it, no
;; definition may shadow it now.
(define (note-macro-use! id phase)
  (let ([b (resolve id phase 'value)])
    (when (and b (hash-has-key? unqualified-imports b))
      (hash-set! unqualified-imports b #t))))

;; Give this module's definition of id, if it has one in the namespace of
;; meaning, the new meaning: the binding with id's name, scopes and phase,
;; kept under id's name and greatest scope. Returns #f if there is none.
(define (redefine! id phase meaning)
  (let ([b (findf (lambda (b)
                    (and (eqv? (binding-phase b) phase) (equal? (binding-scopes b) (stx-scopes id))
                         (eq? (binding-namespace b) (meaning-namespace meaning))))
                  (bindings-under (stx-e id) (binding-slot (stx-scopes id))))])
    (and b (begin (set-binding-meaning! b meaning) #t))))

(define (phase-matches? b phase)
  (let ([p (binding-phase b)])
    (or (eq? p 'all) (eqv? p phase))))

;; The bindings in bs that an identifier with scopes can refer to at phase
;; in namespace ns, consed onto rest.
(define (candidates bs phase ns scopes rest)
  (cond [(null? bs) rest]
        [(let ([b (car bs)])
           (and (phase-matches? b phase) (eq? (binding-namespace b) ns)
                (scopes-subset? (binding-scopes b) scopes)))
         (cons (car bs) (candidates (cdr bs) phase ns scopes rest))]
        [else (candidates (cdr bs) phase ns scopes rest)]))

;; The candidates kept under the scopes in scs.
(define (candidates-under table scs phase ns scopes)
  (if (null? scs)
      '()
      (candidates (hash-ref table (car scs) '()) phase ns scopes
                  (candidates-under table (cdr scs) phase ns scopes))))

;; The binding id refers to at phase in namespace ns, or #f if unbound. A
;; binding whose scopes are a subset of id's is kept under one of id's
;; scopes, or -1, so only those are candidates.
(define (resolve id phase ns)
  (let* ([scopes (stx-scopes id)]
         [table (hash-ref bindings (stx-e id) #f)]
         [cands (if table
                    (candidates (hash-ref table -1 '()) phase ns scopes
                                (candidates-under table scopes phase ns scopes))
                    '())])
    (cond
      [(null? cands) #f]
      [(null? (cdr cands)) (car cands)]
      [else
        (let ([best (foldl (lambda (b best)
                             (if (> (length (binding-scopes b)) (length (binding-scopes best))) b best))
                           (car cands) (cdr cands))])
          (for-each (lambda (b)
                      (when (or (not (scopes-subset? (binding-scopes b) (binding-scopes best)))
                                (and (not (eq? b best)) (equal? (binding-scopes b) (binding-scopes best))
                                     (not (equal? (binding-meaning b) (binding-meaning best)))))
                        (raise-compile-error id "identifier ~a is ambiguous" (stx-e id))))
                    cands)
          best)])))

;; What id means at phase in the value namespace. Only type positions
;; (parse-heap, type-of) look in the type namespace, with type-meaning-of.
(define (meaning-of id phase)
  (let ([b (resolve id phase 'value)])
    (and b (binding-meaning b))))

(define (type-meaning-of id phase)
  (let ([b (resolve id phase 'type)])
    (and b (binding-meaning b))))

;; Is id bound to the core form `name`?
(define (core-id? id name phase)
  (and (id? id)
       (let ([m (meaning-of id phase)])
         (and m (eq? (car m) 'core) (eq? (cadr m) name)))))

(define (internal-name? sym) (= (string-utf-8-byte (symbol->string sym) 0) 37))

;; Core forms and primitive operators, at every phase (spec 5.5). Nothing
;; else is bound until a module requires it.
(define (install-base!)
  (unless base-installed?
    (set! base-installed? #t)
    (for-each (lambda (name) (bind-raw! name (list core-scope) 'all (list 'core name))) core-forms)
    (for-each (lambda (name) (bind-raw! name (list core-scope) 'all (list 'prim name))) (prim-names))))

;; ---- phase shifting ----

;; A meaning as seen `shift` phases up: its linklet instances move by the
;; phase shift. Shifted infos are cached so each is one record.
(define shifted-infos (make-hasheq))   ; info -> alist shift -> info

(define (shift-instance inst k)
  (let ([r (and (string? inst) (linklet-ref inst))])
    (if r (linklet-name (car r) (cadr r) (+ (caddr r) k)) inst)))

(define (shift-info info k)
  (if (= k 0)
      info
      (let* ([cache (hash-ref shifted-infos info '())]
             [hit (assv k cache)])
        (if hit
            (cdr hit)
            (let ([new (cond [(func-info? info)
                              (func-info (func-info-name info) (func-info-params info) (func-info-results info)
                                         (shift-instance (func-info-instance info) k) (func-info-export info)
                                         (func-info-type info))]
                             [(global-info? info)
                              (global-info (global-info-name info) (global-info-type info) (global-info-mutable? info)
                                           (shift-instance (global-info-instance info) k) (global-info-export info))]
                             [(tag-info? info)
                              (tag-info (tag-info-name info) (tag-info-params info)
                                        (shift-instance (tag-info-instance info) k) (tag-info-export info))]
                             [else info])])
              (hash-set! shifted-infos info (cons (cons k new) cache))
              (hash-set! shift-origins new
                         (let ([o (hash-ref shift-origins info #f)])
                           (if o (cons (car o) (+ (cdr o) k)) (cons info k))))
              new)))))

;; A shifted info -> (info . k): the unshifted info it is a copy of, at
;; phase shift k.
(define shift-origins (make-hasheq))

(define (shift-meaning meaning k)
  (if (and meaning (memq (car meaning) '(func global compile-time-value tag)))
      (list (car meaning) (shift-info (cadr meaning) k))
      meaning))

;; A module's scope at phase shift s (spec 6.1). A module used at two phase
;; shifts has bindings at the same phase from both; giving each phase
;; shift its own copy of the module scope keeps them apart. Phase shift 0
;; uses the module scope itself.
(define shifted-scopes (make-hash))
(define (module-scope-at m s)
  (if (= s 0)
      (unit-scope m)
      (let ([key (format "~a|~a" (unit-path m) s)])
        (or (hash-ref shifted-scopes key #f)
            (let ([sc (new-run-scope!)])
              (hash-set! shifted-scopes key sc)
              (hash-set! module-scope-origins sc (cons m s))
              sc)))))

;; Every module scope, and its copies, as scope -> (module . shift).
(define module-scope-origins (make-hasheqv))

;; The linklet compile-module compiled: its bytes, imports, whether it uses
;; GC, and its scope table.
(define (compiled-linklet compiled) (apply linklet compiled))

;; Make module m's bindings resolvable at phase shift s, and those of the
;; modules it requires. Needed for m's macros: their templates carry m's
;; scopes.
(define (install-module-bindings! m s)
  (let ([key (format "~a|~a" (unit-path m) s)])
    (unless (hash-has-key? installed key)
      (hash-set! installed key #t)
      (unless (= s 0)
        (for-each (lambda (e)
                    (bind-raw! (car e) (shift-scopes (cadr e) s) (+ (caddr e) s)
                               (shift-meaning (binding-meaning (cadddr e)) s)))
                  (reverse (unit-entries m))))
      (for-each (lambda (r) (install-module-bindings! (car r) (+ s (cdr r)))) (unit-requires m)))))

;; Scope set scopes at phase shift s: each module scope in it, some
;; module's copy for a phase shift, becomes that module's copy for the
;; shift + s (spec 6.1). A definition a macro from another module made
;; can carry that module's scopes.
(define (shift-scopes scopes s)
  (foldl (lambda (sc set)
           (let ([origin (hash-ref module-scope-origins sc #f)])
             (if origin
                 (scopes-add (scopes-remove set sc) (module-scope-at (car origin) (+ (cdr origin) s)))
                 set)))
         scopes scopes))

;; ==== modules ====

(define (with-comp c thunk)
  (let ([saved current])
    (set! current c)
    (let ([r (thunk)])
      (set! current saved)
      r)))

;; The segments of path p between its slashes.
(define (path-segments p)
  (let ([n (string-utf-8-length p)])
    (let loop ([i 0] [start 0] [acc '()])
      (cond [(= i n) (reverse (cons (substring/utf-8 p start n) acc))]
            [(= (string-utf-8-byte p i) 47) (loop (+ i 1) (+ i 1) (cons (substring/utf-8 p start i) acc))]
            [else (loop (+ i 1) start acc)]))))

;; The package root, an absolute path: the working directory, which
;; module names are relative to (spec 3.6). bin/sub gives it with -p;
;; otherwise it is the repository root.
(define package-root #f)
(define (set-package-root! dir) (set! package-root dir))

(define (absolute-path? p) (and (> (string-utf-8-length p) 0) (= (string-utf-8-byte p 0) 47)))

;; The name of the file at path p, which names the module in it and which
;; its source locations carry (spec 3.6), as Racket names a module: p
;; completed from the package root and its . and .. segments resolved,
;; then relative to the package root if it is in it, and absolute if not.
;; So a file has one name however a require spells it. Symbolic links are
;; not resolved.
(define (canonical-path p)
  (let* ([root (resolve-segments (or package-root repository-root))]
         [full (resolve-segments (if (absolute-path? p) p (string-append root "/" p)))]
         [n (+ (string-utf-8-length root) 1)])
    (if (and (> (string-utf-8-length full) n) (string=? (substring/utf-8 full 0 n) (string-append root "/")))
        (substring/utf-8 full n)
        full)))

;; Absolute path p with its . and .. segments resolved.
(define (resolve-segments p)
  (let ([kept (foldl (lambda (seg acc)
                       (cond [(or (string=? seg "") (string=? seg ".")) acc]
                             [(string=? seg "..") (if (pair? acc) (cdr acc) acc)]
                             [else (cons seg acc)]))
                     '() (path-segments p))])
    (let loop ([segs (reverse kept)])
      (if (null? segs) "" (string-append "/" (car segs) (loop (cdr segs)))))))

;; The byte index of the last byte b in string s, or #f.
(define (last-byte-index s b)
  (let loop ([i (- (string-utf-8-length s) 1)])
    (cond [(< i 0) #f]
          [(= (string-utf-8-byte s i) b) i]
          [else (loop (- i 1))])))

(define (directory-of path)
  (let ([slash (last-byte-index path 47)])
    (if slash (substring/utf-8 path 0 (+ slash 1)) "")))

;; The stem of the file name at path: its letters, digits, - and _.
(define (file-stem path)
  (let* ([slash (last-byte-index path 47)]
         [base (if slash (substring/utf-8 path (+ slash 1) (string-utf-8-length path)) path)]
         [dot (last-byte-index base 46)]
         [stem (if dot (substring/utf-8 base 0 dot) base)])
    (list->string (map (lambda (c) (if (or (char-alphabetic? c) (char-numeric? c) (memv c '(#\- #\_))) c #\_))
                       (string->list stem)))))

;; A module's name while it is expanded, for its compile-time linklets:
;; its stem, numbered to be unique in this run.
(define provisional-names (make-hash))
(define (provisional-name path)
  (let ([stem (file-stem path)])
    (let loop ([n 1])
      (let ([name (if (= n 1) stem (format "~a-~a" stem n))])
        (if (hash-has-key? provisional-names name)
            (loop (+ n 1))
            (begin (hash-set! provisional-names name #t) name))))))

;; The hash that is a module's identity once it is expanded: of its path,
;; which its source locations name (spec 3.6), its source text, and the
;; hashes of the modules it requires, at the phase shifts it requires
;; them, each (hash shift) (spec 3.2). Modules with the same hash are the
;; same module, the same bytes.
(define (module-hash path text requires)
  (content-hash (cons path (cons text (apply append (map (lambda (r) (list (car r) (number->string (cadr r)))) requires))))))

;; Compile the module in file `source` (and, first, what it requires).
;; Returns the module. Each module is compiled once per run.
(define (compile-module-file source)
  (let* ([path (canonical-path source)]
         [known (hash-ref registry path #f)])
    (cond
      [(and known (eq? (unit-state known) 'done)) known]
      [known (raise-compile-error #f "cyclic require: ~a requires itself" path)]
      [else
       (unless (file-exists? path) (raise-compile-error #f "no module file ~a" path))
       (ensure-kernels!)
       (or (load-cached path)
           (let* ([text (file->string path)]
                  [m (new-unit path (provisional-name path))]
                  [c (comp m (new-cstore) 0 '() #f (make-hasheqv) (make-hasheqv) (make-hasheqv) '() '() '() '() #f)])
             (hash-set! registry path m)
             (let ([m (with-comp c
                        (lambda ()
                          (set-unit-expanded! m (expand-module-body (read-string-all text (string->symbol path))))
                          (finish-module! c text)))])
               (hash-set! registry path m)
               m)))])))

;; Expand a module body at phase 0; phase >= 1 code runs as it goes.
(define (expand-module-body forms)
  (install-base!)
  (let ([msc (new-scope!)])
    (set-unit-scope! (comp-module current) msc)
    (hash-set! module-scope-origins msc (cons (comp-module current) 0))
    (let ([out (expand-body (map (lambda (f) (add-scope (add-scope f core-scope) msc)) forms) 0)])
      (run-pending!)
      out)))

(define (add-phase-forms! phase forms)
  (let ([t (comp-phase-forms current)])
    (hash-set! t phase (append (reverse forms) (hash-ref t phase '())))))

;; The memory and table forms declared for phase (spec 3.3).
(define (storage-forms phase)
  (let ([mem (hash-ref (comp-memories current) phase #f)]
        [tbl (hash-ref (comp-tables current) phase #f)])
    (append (if mem (list mem) '()) (if tbl (list tbl) '()))))

;; Run #%linklet over the expanded phase-0 code, resolve provides, and
;; compile the linklets. Returns the module: the one this run already has
;; by its hash, if a compiled file brought it (spec 3.7), or else this one.
(define (finish-module! c text)
  (let ([m (comp-module c)])
    (set-unit-expanded! m (apply-linklet-hook 'module (unit-expanded m)
                                              (make-stx 'module (list (unit-scope m) core-scope) #f '()) 0))
    (set! removed-definitions (definitions-removed c (unit-expanded m)))
    (add-phase-forms! 0 (lower-forms (unit-expanded m) 0))
    ;; A provided name exports its binding in each namespace it has one.
    (set-unit-provides!
     m
     (apply append
            (map (lambda (item)
                   (let* ([id (cdr item)]
                          [value (let ([v (meaning-of id 0)])
                                   (and v (memq (car v) '(func global compile-time-value data tag)) v))]
                          [found (filter (lambda (x) x) (list (type-meaning-of id 0) value))])
                     (when (null? found)
                       (raise-compile-error id "cannot provide ~a: it is not a module-level binding" (stx-e id)))
                     (for-each (lambda (meaning) (check-not-removed (cadr meaning) id)) found)
                     (map (lambda (meaning) (cons (stx-e (car item)) meaning)) found)))
                 (reverse (comp-provide-ids c)))))
    (set! removed-definitions #f)
    ;; Its requires known, the module takes its hash, and the name its
    ;; instance names start with: its stem and hash.
    (set-unit-hash! m (module-hash (unit-path m) text (map (lambda (r) (list (unit-hash (car r)) (cdr r))) (unit-requires m))))
    (set-unit-name! m (format "~a.~a" (file-stem (unit-path m)) (unit-hash m)))
    (or (hash-ref units-by-hash (unit-hash m) #f)
        (begin (hash-set! units-by-hash (unit-hash m) m)
               (compile-linklets! c)
               m))))

;; Compile each phase's linklet of the module c compiles, and its program;
;; check (freestanding); store it.
(define (compile-linklets! c)
  (let ([m (comp-module c)])
    (let ([phases (sort (let ([ps (hash-keys (comp-phase-forms c))]) (if (memv 0 ps) ps (cons 0 ps))) <)])
      (for-each (lambda (p)
                  (let* ([forms (append (storage-forms p) (reverse (hash-ref (comp-phase-forms c) p '())))]
                         [compiled (begin (set-current-source! (string->symbol (unit-path m)))
                                          (compile-module forms (linklet-name m p 0)))])
                    (hash-set! (unit-linklets m) p (compiled-linklet compiled))
                    (note-definitions! m forms)))
                phases))
    ;; Its functions' values, resolved now for its interface (5.2).
    (for-each function-value (filter (lambda (f) (own-instance? m (info-instance f))) (hash-keys function-values)))
    ;; Programs link to the target kernel: when it is not the host,
    ;; the phase-0 code is lowered and compiled again, against it.
    (set-unit-program!
     m
     (if (eq? running-kernel target-kernel)
         (hash-ref (unit-linklets m) 0)
         (with-kernel target-kernel
           (lambda ()
             (compiled-linklet (compile-module (append (storage-forms 0) (lower-forms (unit-expanded m) 0))
                                               (linklet-name m 0 0)))))))
    (hash-set! installed (format "~a|0" (unit-path m)) #t)
    (set-unit-state! m 'done)
    (let ([form (comp-freestanding-form c)])
      (when form (check-freestanding! m form)))
    ;; The expanded code has served, unless sub expand wants it.
    (unless keep-expanded? (set-unit-expanded! m #f))
    (store-cached! m)))

;; The types and definitions in module m's lowered forms, for the
;; interfaces (3.7): its types in order, and its functions, globals and
;; tags.
(define (note-definitions! m forms)
  (for-each (lambda (f)
              (case (car f)
                [(type) (own-type! m (cadr f))]
                [(func global tag) (note-info! m (cadr f))]
                [else #f]))
            forms))

(define (own-type! m t)
  (unless (hash-has-key? type-owners t)
    (hash-set! type-owners t (cons m (length (unit-types m))))
    (set-unit-types! m (append (unit-types m) (list t)))))

(define (note-info! m info) (set-unit-infos! m (cons info (unit-infos m))))

;; The definition of kind with export name export in the instance named
;; instance, one of module m's linklets, or #f. A module's definitions are
;; indexed at the first search.
(define definition-indexes (make-hasheq))    ; unit -> "instance kind export" -> info
(define (unit-definition m instance kind export)
  (hash-ref (or (hash-ref definition-indexes m #f)
                (let ([index (make-hash)])
                  (for-each (lambda (info) (hash-set! index (info-key info) info)) (unit-infos m))
                  (hash-set! definition-indexes m index)
                  index))
            (string-append instance " " (symbol->string kind) " " export) #f))

(define (find-info instance kind export)
  (let ([m (instance-unit instance)]) (and m (unit-definition m instance kind export))))

;; "instance kind export" of a function, global or tag.
(define (info-key info)
  (string-append (or (info-instance info) "") " " (symbol->string (info-kind info)) " " (info-export info)))

(define (info-kind info) (cond [(func-info? info) 'func] [(global-info? info) 'global] [else 'tag]))

(define (info-instance info)
  (cond [(func-info? info) (func-info-instance info)]
        [(global-info? info) (global-info-instance info)]
        [(tag-info? info) (tag-info-instance info)]
        [else #f]))

(define (info-export info)
  (cond [(func-info? info) (func-info-export info)]
        [(global-info? info) (global-info-export info)]
        [else (tag-info-export info)]))

(define (info-name info)
  (cond [(func-info? info) (func-info-name info)]
        [(global-info? info) (global-info-name info)]
        [(tag-info? info) (tag-info-name info)]
        [else (data-info-name info)]))

;; Keep every module's fully expanded code after it is compiled, for
;; module-expanded-forms.
(define keep-expanded? #f)
(define (keep-expanded-forms!) (set! keep-expanded? #t))

;; The linklets a program instantiates at run time: phase 0 at phase
;; shift 0, reached through phase-0 requires.
(define (runtime-closure m)
  (let loop ([todo (list m)] [seen '()])
    (cond [(null? todo) (reverse seen)]
          [(memq (car todo) seen) (loop (cdr todo) seen)]
          [else
           (let* ([p (unit-program (car todo))]
                  [deps (filter (lambda (x) x)
                                (map (lambda (imp)
                                       (let ([r (linklet-ref imp)])
                                         (and r (= (cadr r) 0) (= (caddr r) 0) (car r))))
                                     (linklet-imports p)))])
             (loop (append (cdr todo) deps) (cons (car todo) seen)))])))

;; (freestanding): the program's run-time parts import only from the host
;; and each other, and use no GC (spec 3.4).
(define (check-freestanding! m form)
  (for-each (lambda (mm)
              (let* ([p (unit-program mm)]
                     [extra (filter (lambda (imp) (not (or (string=? imp "host") (linklet-ref imp))))
                                    (linklet-imports p))])
                (unless (and (null? extra) (not (linklet-gc? p)))
                  (raise-compile-error form
                                       "this module is declared freestanding, but after expansion ~a ~a"
                                       (if (eq? mm m) "it" (format "the module ~a it requires" (unit-name mm)))
                                       (if (pair? extra) (format "imports from ~a" extra) "uses GC objects")))))
            (runtime-closure m)))

;; The fully expanded phase-0 forms of m.
(define (module-expanded-forms m) (unit-expanded m))

;; The linklets m's program instantiates at run time, each after those it
;; imports from, as (instance-name . bytes): phase-0 linklets at phase
;; shift 0, and the kernel module if they use it. m's own comes last.
(define (program-linklets m)
  (let ([seen (make-hash)] [out '()])
    (let visit ([m m])
      (let ([name (linklet-name m 0 0)])
        (unless (hash-has-key? seen name)
          (hash-set! seen name #t)
          (let ([p (unit-program m)])
            (for-each (lambda (imp)
                        (let ([l (linklet-ref imp)])
                          (cond [(string=? imp "kernel")
                                 (unless (hash-has-key? seen imp)
                                   (hash-set! seen imp #t)
                                   (set! out (cons (cons imp (kernel-bytes target-kernel)) out)))]
                                [l
                                 (unless (and (= (cadr l) 0) (= (caddr l) 0))
                                   (raise-compile-error #f "internal: a program imports from ~a" imp))
                                 (visit (car l))]
                                [else #f])))
                      (linklet-imports p))
            (set! out (cons (cons name (linklet-bytes p)) out))))))
    (reverse out)))

;; (phase . bytes) for each linklet of m, in phase order.
(define (module-linklet-list m)
  (sort (map (lambda (p) (cons p (linklet-bytes (if (= p 0) (unit-program m) (hash-ref (unit-linklets m) p #f)))))
             (hash-keys (unit-linklets m)))
        (lambda (a b) (< (car a) (car b)))))

;; ==== module bodies ====

;; The core form name if s is (core-id ...), else #f.
(define (core-head s phase)
  (and (stx? s) (pair? (stx-e s)) (id? (car (stx-e s)))
       (let ([m (meaning-of (car (stx-e s)) phase)])
         (and m (eq? (car m) 'core) (cadr m)))))

;; Expand macro uses at the head of s until it is something else.
(define (head-expand s phase)
  (let* ([head (cond [(id? s) s]
                     [(and (pair? (stx-e s)) (id? (car (stx-e s)))) (car (stx-e s))]
                     [else #f])]
         [t (and head (transformer-of (meaning-of head phase)))])
    (if t
        (head-expand (apply-macro head t s phase #t) phase)
        s)))

;; While expanding the forms #%linklet returned, what returned them (spec
;; 6.5); otherwise #f.
(define redefining? #f)

;; A module body being expanded: its phase, the items pass 1 found
;; (reversed), whether pass 2 has started, and the expanded forms lifted
;; while pass 2 expands the current item (reversed).
(struct body (phase [items #:mutable] [pass2? #:mutable] [lifted #:mutable]))

(define current-body #f)                 ; the innermost body being expanded

;; A module body -> its fully expanded code: func, global, import, type
;; and data forms and expressions (spec 6.4). Other module-level forms take
;; effect during expansion and leave nothing.
;; A form in a body that is already expanded, and bound: a form #%linklet
;; returned unchanged (spec 6.5). Both passes keep it as it is.
(struct expanded (form))

(define (expand-body forms phase)
  (let ([b (body phase '() #f '())] [saved current-body])
    (set! current-body b)
    ;; Pass 1: find definitions, run compile-time forms, splice begins.
    (for-each (lambda (f)
                (if (expanded? f)
                    (set-body-items! b (cons (list 'done (expanded-form f)) (body-items b)))
                    (declare-form! f b redefining?)))
              forms)
    ;; Pass 2: expand bodies and expressions. What an item lifts goes
    ;; before it.
    (set-body-pass2?! b #t)
    (let ([out (apply append
                      (map (lambda (item)
                             (set-body-lifted! b '())
                             (let ([out (expand-item item phase)])
                               (append (reverse (body-lifted b)) (list out))))
                           (reverse (body-items b))))])
      (set! current-body saved)
      out)))

;; Pass 1 for module-level form f0 of body b: expand macro uses at its
;; head, then declare it, run it, or keep it for pass 2. only is #f, or
;; says where the form came from if it may only be a definition or an
;; expression (what #%linklet returns, or what a macro lifts).
(define (declare-form! f0 b only)
  (let* ([phase (body-phase b)]
         [f (head-expand f0 phase)]
         [kind (core-head f phase)]
         [item! (lambda (x) (set-body-items! b (cons x (body-items b))))])
    (when (and only
               (memq kind '(require require-unqualified provide freestanding memory table
                            define-syntax begin-for-syntax)))
      (raise-compile-error f "~a (~a ...), but only func, global, import, type, tag and data forms and expressions are allowed there"
                           only kind))
    (case kind
      [(begin) (syntax-match f [('begin form ...) (for-each (lambda (g) (declare-form! g b only)) form)])]
      [(require) (require! f phase #f)]
      [(require-unqualified) (require! f phase #t)]
      [(provide) (provide! f phase)]
      [(freestanding) (freestanding! f phase)]
      [(func) (item! (declare-func f phase))]
      [(global) (item! (declare-global f phase))]
      [(import) (item! (declare-import f phase))]
      [(memory table) (declare-storage! f phase)]
      [(data) (item! (declare-data f phase))]
      [(type) (item! (declare-type f phase))]
      [(tag) (item! (declare-tag f phase))]
      [(rec) (item! (declare-rec f phase))]
      [(define-syntax) (define-syntax! f phase)]
      [(begin-for-syntax) (begin-for-syntax! f phase)]
      [else (item! (list 'expr f))])))

;; Pass 2 for one item: its fully expanded code.
(define (expand-item item phase)
  (case (car item)
    [(func) (expand-func item phase)]
    [(global) (expand-global item phase)]
    [(plain done) (cadr item)]
    [(expr) (expand-expr (cadr item) phase)]))

;; Lift form, from a macro, to the module level of the body being expanded
;; (spec 6.4): declare it now, so its names can be used at once, and put
;; its fully expanded code before the form whose expansion lifted it.
(define (lift! form where phase)
  (let ([b current-body])
    (unless (and b (eqv? (body-phase b) phase))
      (raise-compile-error where "syntax-local-lift-definition: no module body is being expanded at phase ~a" phase))
    (let ([before (body-items b)])
      (declare-form! form b "syntax-local-lift-definition was given")
      ;; In pass 2 the new items are expanded now; in pass 1 they wait for
      ;; pass 2 like the others.
      (when (body-pass2? b)
        (let ([new (take (body-items b) (- (length (body-items b)) (length before)))])
          (set-body-items! b before)
          (for-each (lambda (item)
                      (let ([out (expand-item item phase)])
                        (set-body-lifted! b (cons out (body-lifted b)))))
                    (reverse new)))))))

;; ==== types ====

(define shorthand-refs
  '((anyref . any) (eqref . eq) (i31ref . i31) (structref . struct) (arrayref . array)
    (funcref . func) (externref . extern) (exnref . exn)))

;; A heap type: an abstract name, or a type declared with `type`.
(define (parse-heap s phase)
  (cond [(and (id? s) (memq (stx-e s) abstract-heaps)) (stx-e s)]
        [(id? s)
         (let ([m (type-meaning-of s phase)])
           (unless m (raise-compile-error s "~a is not a type" (stx-e s)))
           (cadr m))]
        [else (raise-compile-error s "expected a heap type, got ~s" (stx->datum s))]))

(define (parse-type s phase)
  (let* ([d (stx-e s)] [short (assq d shorthand-refs)])
    (cond [(memq d '(i32 i64 f32 f64)) d]
          [short (make-ref #t (cdr short))]
          [else (syntax-match s
                  [('ref heap) (make-ref #f (parse-heap heap phase))]
                  [('ref 'null heap) (make-ref #t (parse-heap heap phase))]
                  [('ref . _) (raise-compile-error s "expected (ref T) or (ref null T)")]
                  [_ (raise-compile-error s "expected a type (i32, i64, f32, f64 or a reference type), got ~s"
                                          (stx->datum s))])])))

(define (parse-reftype s phase)
  (let ([t (parse-type s phase)])
    (unless (ref-type? t) (raise-compile-error s "expected a reference type"))
    t))

;; The words of type syntax are compared by name, like wasm's keywords, so
;; they are reserved: no declared type may be named by one (spec 5.1).
(define (core-name? s name) (and (id? s) (eq? (stx-e s) name)))

(define type-keywords '(ref null mut struct array field sub final func rec ->))

;; A kind of declared type, with its article, for messages.
(define (kind-word kind)
  (case kind [(struct) "a struct"] [(array) "an array"] [(func) "a function"] [else "a"]))

(define (check-type-name! id)
  (let ([name (stx-e id)])
    (cond [(or (memq name (append abstract-heaps '(i32 i64 f32 f64 i8 i16)))
               (assq name shorthand-refs))
           (raise-compile-error id "~a names a built-in type" name)]
          [(memq name type-keywords)
           (raise-compile-error id "~a is a word of type syntax, so it cannot name a type" name)])))

;; A field or element type: a storage type, optionally (mut storage).
(define (parse-field-type s phase)
  (syntax-match s
    [('mut storage) (list (parse-storage storage phase) #t)]
    [_ (list (parse-storage s phase) #f)]))

(define (parse-storage s phase)
  (if (and (id? s) (memq (stx-e s) '(i8 i16))) (stx-e s) (parse-type s phase)))

;; ---- macros in types ----
;;
;; In a type position, a form whose head is a macro is expanded until it
;; is not (spec 5.1): a type function. The expand- functions return type
;; syntax with every such use expanded, which is what fully expanded code
;; holds; the parse- functions then read it.

;; The transformer of s's head if s is (macro ...), else #f.
(define (type-macro-use s phase)
  (and (stx? s) (pair? (stx-e s)) (id? (car (stx-e s)))
       (transformer-of (meaning-of (car (stx-e s)) phase))))

;; A type name or heap type: macro uses at its head expanded.
(define (expand-type-name s phase)
  (let ([t (type-macro-use s phase)])
    (if t (expand-type-name (apply-macro (car (stx-e s)) t s phase #f) phase) s)))

;; A value type.
(define (expand-type s0 phase)
  (let ([s (expand-type-name s0 phase)])
    (syntax-match s
      [((? id? ref 'ref) word ... heap) (stx-rewrap s (append (cons ref word) (list (expand-type-name heap phase))))]
      [_ s])))

;; A field, element or global type: a type, i8, i16, or (mut ...) of one.
(define (expand-field-type s phase)
  (syntax-match s
    [((? id? mut 'mut) t) (stx-rewrap s (list mut (expand-field-type t phase)))]
    [_ (if (memq (stx-e s) '(i8 i16)) s (expand-type s phase))]))

;; A signature (t ... -> r ...).
(define (expand-signature s phase)
  (syntax-match s
    [(part ...) (stx-rewrap s (map (lambda (t) (if (core-name? t '->) t (expand-type t phase))) part))]
    [_ (raise-compile-error s "expected a signature (type ... -> type ...)")]))

;; A type definition: (struct (field name t) ...), (array t), or (sub ... def).
(define (expand-type-def s phase)
  (syntax-match s
    [((? id? sub 'sub) part ... def) (stx-rewrap s (append (cons sub part) (list (expand-type-def def phase))))]
    [((? id? struct 'struct) field ...)
     (stx-rewrap s (cons struct (map (lambda (f)
                                       (syntax-match f
                                         [(word name t) (stx-rewrap f (list word name (expand-field-type t phase)))]
                                         [_ f]))
                                     field)))]
    [((? id? func 'func) signature) (stx-rewrap s (list func (expand-signature signature phase)))]
    [((? id? array 'array) t) (stx-rewrap s (list array (expand-field-type t phase)))]
    [_ s]))

;; (type name def), where def is (struct (field fname ftype) ...),
;; (array etype), or (sub [final] [super] def) as in wasm (spec 5.2). A def
;; without sub is final, with no supertype. The name is bound before the
;; fields are read, so a type may refer to itself.
(define (declare-type f phase)
  (let ([m (begin-type-member f phase)])
    (finish-type-member! m phase)
    (identify-group! (list (type-member-info m)))
    (list 'plain (type-member-out m))))

;; (rec (type name def) ...): types that may refer to each other, one wasm
;; recursion group (spec 5.2). Every name is bound before any fields are
;; read. A supertype must still come earlier, as in wasm.
(define (declare-rec f phase)
  (syntax-match f
    [('rec type0 type ...)
     (let* ([members (let loop ([ts (cons type0 type)])
                       (if (null? ts)
                           '()
                           (let ([t (car ts)])
                             (unless (eq? (core-head t phase) 'type)
                               (raise-compile-error t "a rec group holds (type name def) forms"))
                             (check-super-not-later t (cdr ts))
                             (let ([m (begin-type-member t phase)])
                               (cons m (loop (cdr ts)))))))]
            [infos (map type-member-info members)])
       (for-each (lambda (m) (finish-type-member! m phase)) members)
       (for-each (lambda (info) (set-type-info-group! info infos)) infos)
       (identify-group! infos)
       (list 'plain (apply out f 'rec (map type-member-out members))))]))

;; A member of a rec group whose supertype is a later member.
(define (check-super-not-later t later)
  (syntax-match t
    [(_ name def)
     (let ([super (syntax-match def
                    [('sub 'final _) #f]
                    [('sub 'final super _) super]
                    [('sub super _) super]
                    [_ #f])])
       (when (and (id? super) (ormap (lambda (u) (syntax-match u [(_ n . _) (eq? (stx-e n) (stx-e super))] [_ #f])) later))
         (raise-compile-error super "~a must be declared before its subtype ~a, as in wasm" (stx-e super) (stx-e name))))]
    [_ #f]))

;; A type declaration being read: the (type name def) form and the
;; declared type; xdef is def with its types expanded, once read.
(struct type-member (form name def info [xdef #:mutable]))

(define (type-member-out m)
  (out (type-member-form m) 'type (type-member-name m) (type-member-xdef m)))

;; Check (type name def), resolve its supertype, and bind name. The fields
;; are read afterwards (finish-type-member!).
(define (begin-type-member f phase)
  (syntax-match f
    [('type (? id? name) (? stx? written (kind part ...)))
     (check-type-name! name)
     (let* ([sub (parse-sub written phase)] [def (car sub)] [final? (cadr sub)] [super (caddr sub)]
            [kind (syntax-match def [(word . _) (stx-e word)] [_ #f])])
       (unless (memq kind '(struct array func))
         (raise-compile-error def "a type is (struct field ...), (array type), (func signature) or (sub ...)"))
       (when super
         (unless (eq? (type-info-kind super) kind)
           (raise-compile-error written "~a type cannot have ~a, ~a type, as its supertype"
                                (kind-word kind) (type-info-name super)
                                (kind-word (type-info-kind super))))
         (when (type-info-final? super)
           (raise-compile-error written "~a is final: it cannot be a supertype" (type-info-name super))))
       (let ([info (make-type-info (stx-e name) kind #f super final? #f)])
         (bind-definition! name phase (list 'type info))
         (type-member f name written info #f)))]))

;; Read the fields of a type whose name is bound. They are expanded after
;; the name is bound, so a type function may be given the type itself.
(define (finish-type-member! m phase)
  (let* ([info (type-member-info m)]
         [xdef (expand-type-def (type-member-def m) phase)]
         [xinner (car (parse-sub xdef phase))])
    (set-type-info-fields! info (parse-type-fields xinner (type-info-kind info) phase))
    (when (type-info-super info) (check-subtype-fields! info (type-info-super info) xinner))
    (set-type-member-xdef! m xdef)))

;; (sub [final] [super] def) -> (def final? super-type-info-or-#f).
(define (parse-sub s phase)
  (syntax-match s
    [('sub 'final def) (list def #t #f)]
    [('sub 'final super def) (list def #t (type-of super phase))]
    [('sub def) (list def #f #f)]
    [('sub super def) (list def #f (type-of super phase))]
    [('sub . _) (raise-compile-error s "expected (sub [final] [supertype] (struct ...) or (array ...))")]
    [_ (list s #t #f)]))

(define (parse-type-fields def kind phase)
  (case kind
    [(struct)
     (syntax-match def
       [('struct field ...)
        (map (lambda (f) (syntax-match f [('field (? id? name) type) (cons (stx-e name) (parse-field-type type phase))]))
             field)])]
    [(func) (syntax-match def [('func signature) (let ([sig (parse-signature signature phase)]) (list (car sig) (cdr sig)))])]
    [else (syntax-match def [('array type) (parse-field-type type phase)])]))

;; Wasm's rule for a declared supertype: a struct starts with its
;; supertype's fields, and an array's element matches. An immutable field
;; may narrow its type; a mutable one keeps it.
(define (field<=? a b)                 ; (storage mutable?)
  (and (eq? (cadr a) (cadr b))
       (if (or (memq (car a) '(i8 i16)) (memq (car b) '(i8 i16)))
           (eq? (car a) (car b))
           (and (valtype<=? (car a) (car b)) (or (not (cadr a)) (valtype<=? (car b) (car a)))))))

(define (check-subtype-fields! info super where)
  (case (type-info-kind info)
    [(struct)
     (let ([mine (type-info-fields info)] [theirs (type-info-fields super)])
       (when (< (length mine) (length theirs))
         (raise-compile-error where "~a has fewer fields than its supertype ~a"
                              (type-info-name info) (type-info-name super)))
       (for-each (lambda (a b)
                   (unless (field<=? (cdr a) (cdr b))
                     (raise-compile-error where "~a's field ~a does not match field ~a of its supertype ~a"
                                          (type-info-name info) (car a) (car b) (type-info-name super))))
                 (take mine (length theirs)) theirs))]
    [(array)
     (unless (field<=? (type-info-fields info) (type-info-fields super))
       (raise-compile-error where "~a's element type does not match its supertype ~a's"
                            (type-info-name info) (type-info-name super)))]
    ;; A function subtype accepts at least its supertype's parameters and
    ;; returns at most its results.
    [(func)
     (let ([mine (type-info-fields info)] [theirs (type-info-fields super)])
       (unless (and (types<=? (car theirs) (car mine)) (types<=? (cadr mine) (cadr theirs)))
         (raise-compile-error where "~a's signature does not fit its supertype ~a's"
                              (type-info-name info) (type-info-name super))))]))

(define (type-of id phase)
  (let ([m (and (id? id) (type-meaning-of id phase))])
    (unless m (raise-compile-error id "~s is not a declared type" (stx->datum id)))
    (cadr m)))

(define (field-index tinfo id)
  (unless (eq? (type-info-kind tinfo) 'struct)
    (raise-compile-error id "~a is not a struct type" (type-info-name tinfo)))
  (let loop ([fs (type-info-fields tinfo)] [i 0])
    (cond [(null? fs) (raise-compile-error id "~a has no field ~s" (type-info-name tinfo) (stx->datum id))]
          [(and (id? id) (eq? (car (car fs)) (stx-e id))) i]
          [else (loop (cdr fs) (+ i 1))])))

;; ==== other module-level forms ====

;; A string literal, and a count: a fixnum from 0.
(define (string-literal? s) (string? (stx-e s)))
(define (count-literal? s) (let ([n (stx-e s)]) (and (fixnum? n) (>= n 0))))

;; `-> t` or `-> (t ...)`: (results . the rest of body).
(define (parse-results body phase)
  (syntax-match body
    [('-> r . rest) (cons (syntax-match r
                            [('ref . _) (list (parse-type r phase))]
                            [(t ...) (map (lambda (x) (parse-type x phase)) t)]
                            [_ (list (parse-type r phase))])
                          rest)]
    [('->) (raise-compile-error (car body) "expected a type after ->")]
    [_ (cons '() body)]))

;; The `-> r` that starts rest, a func's or a lambda's, as a list of the
;; two, or (). r is one type or a list of them, and has its types
;; expanded; a macro use is one type, though it looks like a list.
(define (arrow-of rest phase)
  (syntax-match rest
    [('-> r . _)
     (list (car rest) (syntax-match r
                        [('ref . _) (expand-type r phase)]
                        [(t ...) (if (type-macro-use r phase)
                                     (expand-type r phase)
                                     (stx-rewrap r (map (lambda (x) (expand-type x phase)) t)))]
                        [_ (expand-type r phase)]))]
    [('->) (raise-compile-error (car rest) "expected a type after ->")]
    [_ '()]))

;; (t ... -> r ...): (params . results).
(define (parse-signature s phase)
  (syntax-match s
    [(param ... '-> result ...)
     (cons (map (lambda (t) (parse-type t phase)) param) (map (lambda (t) (parse-type t phase)) result))]
    [_ (raise-compile-error s "expected a signature (type ... -> type ...)")]))

;; The options after a func's head, [#:inline] [#:value g] (spec 5.2), as
;; (inline value rest): the #:inline keyword or #f, the list (#:value g)
;; or #f, and what follows them.
(define (func-options rest)
  (let* ([inline (and (pair? rest) (eq? (stx-e (car rest)) '#:inline) (car rest))]
         [rest (if inline (cdr rest) rest)]
         [value (and (pair? rest) (eq? (stx-e (car rest)) '#:value)
                     (begin
                       (unless (and (pair? (cdr rest)) (id? (cadr rest)))
                         (raise-compile-error (car rest) "#:value needs the name of a global"))
                       (list (car rest) (cadr rest))))])
    (list inline value (if value (cddr rest) rest))))

;; (func (name [p t] ...) [#:inline] [#:value g] [-> r] body ...)
(define (declare-func f phase)
  (syntax-match f
    [('func ((? id? name) param ...) . body)
     (let* ([params (map (lambda (p) (param-of p phase)) param)]
            [types (map (lambda (pp) (parse-type (cadr pp) phase)) params)]
            [options (func-options body)]
            [inline (car options)] [value (cadr options)] [rest (caddr options)]
            [arrow (arrow-of rest phase)]
            [rb (parse-results (append arrow (list-tail rest (length arrow))) phase)]
            [results (car rb)]
            [ct (func-type-clause (cdr rb) types results phase)]
            [info (func-info (stx-e name) types results #f #f (cadr ct))])
       (bind-definition! name phase (list 'func info))
       (when value (hash-set! function-values info (cons (cadr value) phase)))
       (list 'func name params arrow (caddr ct) f (car ct) inline value))]))

;; A parameter [name type], as (name type) with the type expanded.
(define (param-of p phase)
  (syntax-match p [((? id? name) type) (list name (expand-type type phase))]))

(define (type-clause? s) (syntax-match s [('type _) #t] [_ #f]))

;; An optional (type T) first in a func's body declares its function type
;; T, as in wasm (spec 5.2): the type other modules and ref.func see it
;; at. Its parameters and results must be T's. Returns (clause T body).
(define (func-type-clause body params results phase)
  (syntax-match body
    [(((? id? word 'type) name) . rest)
     (let* ([tname (expand-type-name name phase)]
            [t (type-of tname phase)])
       (unless (func-type? t)
         (raise-compile-error name "~a is not a function type" (type-info-name t)))
       (unless (and (types=? params (car (type-info-fields t))) (types=? results (cadr (type-info-fields t))))
         (raise-compile-error (car body) "the function's parameters and results are not those of ~a"
                              (type-info-name t)))
       (list (stx-rewrap (car body) (list word tname)) t rest))]
    [_ (list #f #f body)]))

;; (func (name [p t] ...) [-> r] body ...), expanded.
(define (expand-func p phase)
  (let* ([name (list-ref p 1)] [params (list-ref p 2)] [arrow (list-ref p 3)] [body (list-ref p 4)]
         [f (list-ref p 5)] [clause (list-ref p 6)] [inline (list-ref p 7)] [value (list-ref p 8)]
         [sc (new-local-scope!)]
         [xs (map (lambda (pp) (bound-local (add-scope (car pp) sc) phase)) params)]
         [saved current-function])
    (set! current-function (list name))
    (let ([r (apply out f 'func
                    (out-list (cadr (stx->list f))
                              (cons name (map (lambda (x pp) (out-list x (list x (cadr pp)))) xs params)))
                    (append (if inline (list inline) '()) (or value '()) arrow
                            (if clause (list (core-headed clause 'type)) '())
                            (map (lambda (b) (expand-expr (add-scope b sc) phase)) body)))])
      (set! current-function saved)
      r)))

;; (global name type init) or (global name (mut type) init), as in wasm.
(define (declare-global f phase)
  (syntax-match f
    [('global (? id? name) type init)
     (let* ([xt (expand-field-type type phase)]
            [info (syntax-match xt
                    [('mut t) (global-info (stx-e name) (parse-type t phase) #t #f #f)]
                    [t (global-info (stx-e name) (parse-type t phase) #f #f #f)])])
       (bind-definition! name phase (list 'global info))
       (list 'global f xt))]))

(define (expand-global p phase)
  (syntax-match (cadr p) [(_ name _ init) (out (cadr p) 'global name (caddr p) (expand-expr init phase))]))

;; (import name "module" "field" (t ... -> r ...)), or with a function
;; type's name in place of the signature, to import the function at that
;; type (spec 5.2).
(define (declare-import f phase)
  (syntax-match f
    [('import (? id? name) (? string-literal? module) (? string-literal? field) signature)
     (let* ([ftype (and (or (id? signature) (type-macro-use signature phase))
                        (let ([t (type-of (expand-type-name signature phase) phase)])
                          (unless (func-type? t)
                            (raise-compile-error signature "~a is not a function type" (type-info-name t)))
                          t))]
            [sig (if ftype (expand-type-name signature phase) (expand-signature signature phase))]
            [pr (if ftype
                    (cons (car (type-info-fields ftype)) (cadr (type-info-fields ftype)))
                    (parse-signature sig phase))])
       (bind-definition! name phase
                         (list 'func (func-info (stx-e name) (car pr) (cdr pr) (stx-e module) (stx-e field) ftype)))
       (list 'plain (out f 'import name module field sig)))]))

;; (data name offset "bytes" ...): an active segment in the module's memory.
(define (declare-data f phase)
  (syntax-match f
    [('data (? id? name) (? count-literal? offset) (? string-literal? bytes) ...)
     (let ([info (data-info (stx-e name) (stx-e offset) (string->bytes/utf-8 (apply string-append (map stx-e bytes))))])
       (bind-definition! name phase (list 'data info))
       (list 'plain (core-headed f 'data)))]))

;; (tag name (t ...)): a tag, whose exceptions carry values of types t ...
;; (spec 5.2).
(define (declare-tag f phase)
  (syntax-match f
    [('tag (? id? name) (? stx? types (type ...)))
     (let* ([xs (map (lambda (t) (expand-type t phase)) type)]
            [info (tag-info (stx-e name) (map (lambda (t) (parse-type t phase)) xs) #f #f)])
       (bind-definition! name phase (list 'tag info))
       (list 'plain (out f 'tag name (stx-rewrap types xs))))]))

(define (tag-info-of id phase)
  (let ([m (and (id? id) (meaning-of id phase))])
    (unless (and m (eq? (car m) 'tag))
      (raise-compile-error id "~s is not a tag" (stx->datum id)))
    (cadr m)))

;; ---- require, provide, storage ----

;; (require name source item ...), where source is "path" or kernel (the
;; kernel module). Everything the source provides is bound as name:thing.
;; Each item also binds one thing unqualified: x as itself, or [new old] as
;; new. A require at phase p imports at phase p; inside begin-for-syntax it
;; imports for compile-time code (spec 3.1). (require-unqualified name
;; source) is require with every name the source provides also bound
;; unqualified, with the scopes of name. It is meant for a language's core
;; forms, and little else (spec 3.1).
(define (require! f phase all?)
  (let* ([parts (if all?
                    (syntax-match f
                      [('require-unqualified (? id? name) (? module-source? source)) (list name source '())])
                    (syntax-match f
                      [('require (? id? name) (? module-source? source) item ...) (list name source item)]))]
         [name (car parts)]
         [source (cadr parts)]
         [provided (cond [(string? (stx-e source)) (require-module! f name source phase)]
                         [(pair? (stx-e source)) (require-compiled! f name source phase)]
                         [else (require-kernel! source phase)])])
    (for-each (lambda (p) (bind-import! (qualified name (car p)) phase (cdr p))) provided)
    (when all?
      (for-each (lambda (p)
                  (hash-set! unqualified-imports
                             (bind-import! (datum->stx name (car p) (stx-srcloc name)) phase (cdr p))
                             #f))
                provided))
    (for-each (lambda (item)
                (let* ([names (syntax-match item
                                [(? id? name) (cons name name)]
                                [((? id? new-name) (? id? name)) (cons new-name name)])]
                       [old (cdr names)]
                       [ps (filter (lambda (p) (eq? (car p) (stx-e old))) provided)])
                  (when (null? ps)
                    (raise-compile-error old "~a does not provide ~a" (stx-e source) (stx-e old)))
                  (for-each (lambda (p) (bind-import! (car names) phase (cdr p))) ps)))
              (caddr parts))))

;; A module's source in a require: a path, kernel, or (compiled file).
(define (module-source? s)
  (or (string-literal? s) (core-name? s 'kernel) (syntax-match s [('compiled (? string-literal? _)) #t] [_ #f])))

;; name:thing, with the scopes of name.
(define (qualified name sym)
  (datum->stx name (string->symbol (format "~a:~a" (stx-e name) sym)) (stx-srcloc name)))

(define (bind-import! id phase meaning)
  (check-unbound! id phase meaning)
  (bind-module-level! (stx-e id) (stx-scopes id) phase meaning))

;; The kernel module's contract (spec 2.3): its functions, its tag and
;; its types, as (symbol . meaning), sorted by name for deterministic keys.
(define (require-kernel! source phase)
  (unless (eq? (unit-state (kernel-unit lowering-kernel)) 'done)
    (raise-compile-error source "the kernel module cannot require itself"))
  (let ([m (kernel-unit target-kernel)])
    (sort (filter (lambda (p) (not (internal-name? (car p))))
                  (append (filter (lambda (x) x)
                                  (map (lambda (info)
                                         (cond [(func-info? info) (cons (func-info-name info) (list 'func info))]
                                               [(tag-info? info) (cons (tag-info-name info) (list 'tag info))]
                                               [else #f]))
                                       (unit-infos m)))
                          (map (lambda (t) (cons (type-info-name t) (list 'type t))) (unit-types m))))
          (lambda (a b) (symbol<? (car a) (car b))))))

(define (module-path-of f spec)
  (let* ([loc (stx-srcloc f)]
         [dir (if loc (directory-of (symbol->string (srcloc-source loc))) "")]
         [given (stx-e spec)])
    (if (absolute-path? given) given (string-append dir given))))

;; Compile the module if needed and make its own bindings resolvable for
;; its macros. Returns what it provides, as seen from phase.
(define (require-module! f name spec phase)
  (require-unit! name (compile-module-file (module-path-of f spec)) phase))

;; (require name (compiled file) item ...): the entry of the compiled
;; file, loaded with its requires (spec 3.7).
(define (require-compiled! f name spec phase)
  (require-unit! name (load-compiled-file (canonical-path (module-path-of f (cadr (stx-e spec))))) phase))

;; Module m, required as name at phase: recorded, its bindings made
;; resolvable for its macros; what it provides, as seen from phase.
(define (require-unit! name m phase)
  (let* ([me (comp-module current)]
         [req (cons m phase)]
         [key (cons (stx-e name) phase)]
         [named (assoc key (comp-require-names current))])
    (when (and named (not (eq? (cdr named) m)))
      (raise-compile-error name "~a already names another module at this phase" (stx-e name)))
    (unless named
      (set-comp-require-names! current (cons (cons key m) (comp-require-names current))))
    (unless (member req (unit-requires me))
      (set-unit-requires! me (append (unit-requires me) (list req)))
      (install-module-bindings! m phase))
    (map (lambda (p) (cons (car p) (shift-meaning (cdr p) phase))) (unit-provides m))))

;; The module a require named at this phase.
(define (required-module name phase)
  (let ([named (and (id? name) (assoc (cons (stx-e name) phase) (comp-require-names current)))])
    (unless named
      (raise-compile-error name "~s is not the name of a module required at this phase" (stx->datum name)))
    (cdr named)))

;; (provide item ...): x provides x, and [new old] provides old under the
;; name new; (all-from-out m) provides what module m, required at phase 0,
;; provides, and (except-out (all-from-out m) x ...) all that but the
;; names x ... (spec 3.1). Recorded as (name . id), resolved when the
;; module is done.
(define (provide! f phase)
  (unless (= phase 0) (raise-compile-error f "provide belongs at phase 0"))
  (syntax-match f
    [('provide item ...)
     (for-each (lambda (item)
                 (let ([earlier (assq (stx-e (car item)) (map (lambda (p) (cons (stx-e (car p)) p))
                                                              (comp-provide-ids current)))])
                   (when (and earlier (not (eq? (stx-e (cddr earlier)) (stx-e (cdr item)))))
                     (raise-compile-error (car item) "~a is provided twice, for ~a and for ~a" (stx-e (car item))
                                          (stx-e (cddr earlier)) (stx-e (cdr item))))
                   (set-comp-provide-ids! current (cons item (comp-provide-ids current)))))
               (apply append (map provide-items item)))]))

;; A provide item as a list of (name . id).
(define (provide-items item)
  (syntax-match item
    [(? id? name) (list (cons name name))]
    [('all-from-out module) (all-from-items module '())]
    [('except-out ('all-from-out module) (? id? name) ...) (all-from-items module name)]
    [((? id? new-name) (? id? name)) (list (cons new-name name))]))

;; What the module required as name provides, but the names excluded, as
;; provide items: each one's qualified binding, name:thing.
(define (all-from-items name excluded)
  (let* ([m (required-module name 0)]
         [out (map stx-e excluded)]
         [syms (foldl (lambda (p acc) (if (memq (car p) acc) acc (cons (car p) acc))) '() (unit-provides m))])
    (for-each (lambda (x)
                (unless (memq (stx-e x) syms) (raise-compile-error x "~a does not provide ~a" (stx-e name) (stx-e x))))
              excluded)
    (map (lambda (sym) (cons (datum->stx name sym (stx-srcloc name)) (qualified name sym)))
         (filter (lambda (sym) (not (memq sym out))) (reverse syms)))))

;; (memory pages) or (memory from name), and likewise (table ...): the
;; module's memory or table at this phase. name is a module required at
;; this phase (spec 3.3).
(define (declare-storage! f phase)
  (let* ([kind (syntax-match f [(word . _) (stx-e word)])]
         [table (if (eq? kind 'memory) (comp-memories current) (comp-tables current))])
    (when (hash-ref table phase #f)
      (raise-compile-error f "a second ~a declaration at this phase" kind))
    (hash-set! table phase
               (syntax-match f
                 [(_ (? count-literal? size)) (list kind (stx-e size))]
                 [(_ 'from module) (list (if (eq? kind 'memory) 'memory-import 'table-import)
                                         (linklet-name (required-module module phase) 0 phase))]))))

;; (freestanding): after expansion, the program needs nothing beyond the
;; host at run time (spec 3.4).
(define (freestanding! f phase)
  (syntax-match f
    [('freestanding)
     (unless (= phase 0) (raise-compile-error f "(freestanding) belongs at phase 0"))
     (set-comp-freestanding-form! current f)]))

;; ==== compile-time evaluation ====

;; The name of the next compile-time linklet of module m's phase q.
(define (next-linklet-name! m q)
  (let* ([n (comp-linklet-counter current)] [name (format "~a@~a#~a" (unit-name m) q n)])
    (set-comp-linklet-counter! current (+ n 1))
    (hash-set! instance-refs name (list m q))
    name))

;; Compile forms and instantiate them in st, after what they import.
(define (instantiate-linklet! st name forms where)
  (set-current-source! (and current (string->symbol (unit-path (comp-module current)))))
  (let ([compiled (compile-module forms name)])
    (for-each (lambda (imp) (ensure-import! st imp 0)) (cadr compiled))
    (let ([err (with-scope-map (cadddr compiled) 0
                 (lambda () (instantiate (ns-name st name) (car compiled) (import-map st (cadr compiled) 0))))])
      (when err (raise-compile-error where "compile-time code failed: ~a" err)))
    (hash-set! (cstore-instances st) name #t)
    name))

;; A linklet of this module's phase-`phase` code, run now, as each
;; begin-for-syntax is, after the define-syntax units waiting. Its code
;; also goes into the module's phase-`phase` linklet.
(define (run-compile-time-linklet! forms phase where)
  (run-pending!)
  (add-phase-forms! phase forms)
  (let ([name (next-linklet-name! (comp-module current) phase)])
    (instantiate-linklet! (comp-store current) name (append (linklet-storage-forms phase name) forms) where)))

;; A define-syntax unit's forms, kept to be run with the other units
;; waiting, as one linklet, before anything can see their values: at the
;; first use of one of them, before any other compile-time linklet runs,
;; and at the end of the module. where is the first unit's form.
(define (defer-unit! forms phase where)
  (let ([p (comp-pending current)])
    (unless (and p (eqv? (car p) phase)) (run-pending!))
    (add-phase-forms! phase forms)
    (let ([p (comp-pending current)])
      (set-comp-pending! current (if p (cons (car p) (cons (cadr p) (cons forms (cddr p)))) (list phase where forms))))))

(define (run-pending!)
  (let ([p (comp-pending current)])
    (when p
      (set-comp-pending! current #f)
      (let ([name (next-linklet-name! (comp-module current) (car p))])
        (instantiate-linklet! (comp-store current) name
                              (append (linklet-storage-forms (car p) name) (apply append (reverse (cddr p)))) (cadr p))))))

;; The memory and table forms for a linklet at phase, named name (spec
;; 3.3). A phase's linklets share one memory: the first linklet after
;; (memory pages) defines it, and later ones import it from that linklet.
;; Tables likewise.
(define (linklet-storage-forms phase name)
  (filter (lambda (x) x)
          (map (lambda (kind table)
                 (let* ([form (hash-ref table phase #f)]
                        [owner (assoc (cons kind phase) (comp-storage-linklets current))])
                   (cond [(not (and form (eq? (car form) kind))) form]
                         [owner (list (if (eq? kind 'memory) 'memory-import 'table-import) (cdr owner))]
                         [else
                          (set-comp-storage-linklets! current (cons (cons (cons kind phase) name)
                                                                    (comp-storage-linklets current)))
                          form])))
               '(memory table)
               (list (comp-memories current) (comp-tables current)))))

;; The index in the host glue's table of function info, in st.
(define (function-index st info)
  (ensure-import! st (func-info-instance info) 0)
  (or (export-index (ns-name st (func-info-instance info)) (func-info-export info))
      (raise-compile-error #f "internal: no function ~a in ~a" (func-info-export info) (func-info-instance info))))

;; A compile-time value in st, from its getter function. Fetched when
;; first needed.
(define (compile-time-value st getter)
  (let ([cached (hash-ref (cstore-values st) getter #f)])
    (if cached
        (car cached)
        ;; A getter without an instance is in a unit still waiting.
        (let ([v (begin (unless (func-info-instance getter) (run-pending!))
                        (call-getter (function-index st getter)))])
          (hash-set! (cstore-values st) getter (list v))
          v))))

;; The transformer meaning m is bound to, if m is a compile-time value
;; that is a transformer; otherwise #f.
(define (transformer-of m)
  (and m (eq? (car m) 'compile-time-value)
       (let ([v (compile-time-value (comp-store current) (cadr m))])
         (and (transformer? v) v))))

;; (define-syntax name expr): name is bound to expr's value at phase+1, a
;; compile-time value, which macros read with syntax-local-value; if the
;; value is a transformer, name is a macro. expr is a unit for #%linklet.
;; In (define-syntax name f), where f names a phase+1 function of type
;; (eqref) -> eqref, the value is a transformer that calls f. The value
;; lives in a global of the phase+1 linklet, computed when the linklet is
;; instantiated. A unit whose value is made by a lambda, or by f, runs no
;; code of its own, so it waits to run with others (defer-unit!); any
;; other runs now, since its code can read the values of those before it.
(define (define-syntax! f phase)
  (syntax-match f
    [('define-syntax (? id? id) rhs)
     (let* ([m (and (id? rhs) (meaning-of rhs (+ phase 1)))]
            [base (symbol->string (stx-e id))]
            [name (string->symbol (string-append "__value." base))]
            [adapter (and m (eq? (car m) 'func)
                          (transformer-adapter (string->symbol (string-append "__transformer." base))
                                               (syntax-function-of rhs phase "a transformer")))]
            [expanded (and (not adapter) (expand-expr rhs (+ phase 1)))]
            [unit (if adapter
                      (list adapter)
                      (let* ([out (apply-linklet-hook 'define-syntax (list expanded) rhs (+ phase 1))]
                             [value (last out)])
                        (when (memq (core-head value (+ phase 1)) '(func global import type rec data tag))
                          (raise-compile-error f "#%linklet returned a define-syntax unit that does not end with an expression"))
                        (append (lower-forms (take out (- (length out) 1)) (+ phase 1))
                                (list (list 'expr (lower-expr value (+ phase 1)))))))]
            [init (if adapter
                      (list 'call (kernel-function lowering-kernel 'make-transformer)
                            (list (list 'ref-func (cadr adapter)) (list 'quote #f)))
                      (cadr (last unit)))]
            [global (global-info name eqref #t #f #f)]
            [getter (func-info name '() (list eqref) #f #f #f)]
            [forms (append (if adapter unit (take unit (- (length unit) 1)))
                           (list (list 'global global init)
                                 (list 'func getter '() (list 'gref global))))])
       (if (or adapter (eq? (core-head expanded (+ phase 1)) 'lambda))
           (defer-unit! forms (+ phase 1) f)
           (run-compile-time-linklet! forms (+ phase 1) f))
       (hash-set! macro-modules getter (comp-module current))
       (bind-definition! id phase (list 'compile-time-value getter)))]))

;; The func form of transformer code named name, of the kernel module's
;; type for it, that calls function info on the syntax.
(define (transformer-adapter name info)
  (let ([code-type (ref-heap (car (func-info-params (kernel-function lowering-kernel 'make-transformer))))]
        [env (fresh-key!)] [s (fresh-key!)])
    (list 'func (func-info name (list eqref eqref) (list eqref) #f #f code-type)
          (list (cons env eqref) (cons s eqref))
          (list 'call info (list (list 'lref s))))))

;; The phase+1 function id names, checked to take and return syntax and
;; to be defined already: a transformer.
(define (syntax-function-of id phase what)
  (let ([m (meaning-of id (+ phase 1))])
    (unless (and m (eq? (car m) 'func))
      (raise-compile-error id "~a is not a function at phase ~a" (stx-e id) (+ phase 1)))
    (let ([info (cadr m)])
      (unless (and (equal? (func-info-params info) (list eqref))
                   (types<=? (func-info-results info) (list eqref)))
        (raise-compile-error id "~a takes one eqref (syntax) and returns one eqref" what))
      (unless (func-info-instance info)
        (raise-compile-error id "~a must be defined by an earlier begin-for-syntax" (stx-e id)))
      info)))

;; (begin-for-syntax form ...): a unit for #%linklet.
(define (begin-for-syntax! f phase)
  (syntax-match f
    [('begin-for-syntax form ...)
     (let* ([forms (expand-body form (+ phase 1))]
            [forms (apply-linklet-hook 'begin-for-syntax forms f (+ phase 1))])
       (run-compile-time-linklet! (lower-forms forms (+ phase 1)) (+ phase 1) f))]))

;; ==== the linklet hook ====
;;
;; A unit is code that becomes a linklet or part of one (spec 6.5): a
;; module's phase-0 code, a begin-for-syntax, or the right-hand side of a
;; define-syntax. Once a unit is expanded, the transformer #%linklet is
;; bound to where the unit's code was written, at the unit's phase,
;; rewrites it; the core #%linklet leaves it as it is. That is where the
;; module was, for its phase-0 code; where the begin-for-syntax form was;
;; and where the right-hand side was, for a define-syntax. What the
;; transformer returns is expanded again, only to bind the names it
;; introduces: it must be fully expanded, so a macro use in it is an
;; error, and its definitions replace the unit's own.

;; The unit forms of kind (module, begin-for-syntax or define-syntax) at
;; phase, written where ctx was, after #%linklet.
(define (apply-linklet-hook kind forms ctx phase)
  (let* ([id (make-stx linklet-sym (stx-scopes ctx) (stx-srcloc ctx) '())]
         [m (meaning-of id phase)]
         [t (transformer-of m)])
    (cond
      [t
       (let* ([intro (new-scope!)]
              [in (flip-scope (out-list ctx (cons id (cons (datum->stx ctx kind #f) forms))) intro)]
              [result (call-syntax-function "#%linklet" (lambda (s) (%call-transformer t s)) in phase intro #t)]
              [returned (or (stx->list result)
                            (raise-compile-error ctx "#%linklet returned something other than a list of forms"))]
              ;; A form returned unchanged is one of the forms the hook was
              ;; given: it stays the unit's form, and is not expanded again.
              [fv (list->vector forms)]
              [new (map (lambda (r p) (if (>= p 0) (expanded (vector-ref fv p)) (flip-scope r intro)))
                        returned (same-positions returned (cddr (stx->list in))))]
              [saved-redefining redefining?] [saved-hook hook-output?])
         (set! redefining? "#%linklet returned")
         (set! hook-output? #t)
         (let ([r (expand-body new phase)])
           (set! redefining? saved-redefining)
           (set! hook-output? saved-hook)
           r))]
      [(or (not m) (eq? (car m) 'core)) forms]
      [else (raise-compile-error ctx "#%linklet is bound here, but not to a transformer")])))

;; True while expanding what #%linklet returned.
(define hook-output? #f)

;; After a trap, which wasm code cannot catch, the host calls the
;; compiler's on-trap (spec 4). A trap unwinds without restoring the state
;; below, so it still says what was running: the message is written where
;; the running macro or other compile-time function was used, or else in
;; the module being compiled.
(define (report-trap)
  (let ([msg (error-string)]
        [loc (cond [(and (stx? api-where) (stx-srcloc api-where)) (format-srcloc (stx-srcloc api-where))]
                   [current (unit-path (comp-module current))]
                   [else #f])])
    (if loc (eprintf "~a: error: ~a~n" loc msg) (eprintf "error: ~a~n" msg))))

;; For each form #%linklet returned, the position of the form it was given
;; that it is, or -1. Given forms are matched in order: each returned form
;; is looked for after the last one matched.
(define (same-positions returned given)
  (let loop ([rs returned] [gs given] [i 0] [out '()])
    (if (null? rs)
        (reverse out)
        (let ([k (position-of (car rs) gs)])
          (if k
              (loop (cdr rs) (list-tail gs (+ k 1)) (+ i k 1) (cons (+ i k) out))
              (loop (cdr rs) gs i (cons -1 out)))))))

;; The position of x in list l, by eq?, or #f.
(define (position-of x l)
  (let loop ([l l] [i 0])
    (cond [(null? l) #f]
          [(eq? (car l) x) i]
          [else (loop (cdr l) (+ i 1))])))

;; ==== macros ====

;; State the queries read.
(define api-phase 0)
(define api-where #f)               ; the form the running macro was given
(define api-intro #f)               ; its introduction scope

;; Hygiene (spec 6.2): a fresh introduction scope is flipped on the input
;; and on the output, so only what the transformer introduced carries it.
;; In a definition context (use-site? is true), a macro the module being
;; expanded defines also gets a fresh use-site scope on its input, which
;; stays. transformer is a transformer value.
(define (apply-macro head transformer s0 phase use-site?)
  (when hook-output?
    (raise-compile-error head "#%linklet returned code that uses the macro ~a, but it must return fully expanded code"
                         (stx-e head)))
  (note-macro-use! head phase)
  (let* ([intro (new-scope!)]
         [s (flip-scope s0 intro)]
         [s (if (and use-site? (defined-here? head phase))
                (let ([use (new-scope!)])
                  (set-comp-use-site-scopes! current (cons use (comp-use-site-scopes current)))
                  (add-scope s use))
                s)])
    (at-use s0 (flip-scope (call-syntax-function (format "macro ~a" (stx-e head))
                                                 (lambda (s) (%call-transformer transformer s))
                                                 s phase intro #f)
                           intro))))

;; The define-syntax getter of each macro -> the module that defines it.
(define macro-modules (make-hasheq))

;; Is head bound to a macro the module being expanded defines?
(define (defined-here? head phase)
  (let ([m (meaning-of head phase)])
    (and m (eq? (car m) 'compile-time-value)
         (eq? (hash-ref macro-modules (cadr m) #f) (comp-module current)))))

;; A macro's output, located at its use if the output comes from another
;; file, as a library macro's template does (spec 6.2): what the macro
;; introduced then has the use's location (spec 3.6).
(define (at-use use out)
  (let ([u (and (stx? use) (stx-srcloc use))] [o (and (stx? out) (stx-srcloc out))])
    (if (and u (stx? out) (not (and o (eq? (srcloc-source o) (srcloc-source u)))))
        (make-stx (stx-e out) (stx-scopes out) u (stx-props out))
        out)))

;; Call a phase-1 function from syntax to syntax, (call s): a transformer,
;; or #%linklet, which may also return a plain list (list-ok?). While
;; it runs, the queries answer for phase, blame s, and local-expand uses
;; intro, its introduction scope. Calls nest: a query can expand code,
;; which calls more macros. A syntax error from the call that has no
;; location is located at s, the use.
(define (call-syntax-function who call s phase intro list-ok?)
  (let* ([saved-phase api-phase] [saved-where api-where] [saved-intro api-intro]
         [result (dynamic-wind
                  (lambda () (set! api-phase phase) (set! api-where s) (set! api-intro intro))
                  (lambda () (with-handlers ([unlocated-error? (lambda (e) (raise (located-error e s)))]) (call s)))
                  (lambda () (set! api-phase saved-phase) (set! api-where saved-where) (set! api-intro saved-intro)))])
    (unless (or (stx? result) (and list-ok? (list? result)))
      (raise-compile-error s "~a returned a non-syntax value: ~s" who (stx->datum result)))
    result))

;; ---- the queries ----
;;
;; The kernel module's expander queries (spec 2.3), answered for the
;; running macro.

(define (query-local-value id)
  (let ([m (and (id? id) (meaning-of id api-phase))])
    (if (and m (eq? (car m) 'compile-time-value))
        (compile-time-value (comp-store current) (cadr m))
        #f)))

;; The same meanings, as a value and as a type, so an import and what it
;; imports are equal.
(define (query-free-identifier=? x y)
  (unless (and (id? x) (id? y)) (raise-compile-error api-where "free-identifier=?: expected identifiers"))
  (let ([vx (meaning-of x api-phase)] [vy (meaning-of y api-phase)]
        [tx (type-meaning-of x api-phase)] [ty (type-meaning-of y api-phase)])
    (if (or vx vy tx ty)
        (and (equal? vx vy) (equal? tx ty))
        (eq? (stx-e x) (stx-e y)))))

(define (query-binding-kind id)
  (unless (id? id) (raise-compile-error api-where "identifier-binding-kind: expected an identifier"))
  (let ([m (meaning-of id api-phase)])
    (case (and m (car m))
      [(func) 'function]
      [(local global) 'variable]
      [(compile-time-value) (if (transformer-of m) 'macro 'compile-time-value)]
      [(data) 'data]
      [(tag) 'tag]
      [(label) 'label]
      [(core prim) 'core]
      [else (and (type-meaning-of id api-phase) 'type)])))

;; The signature of the function id is bound to, (t ... -> r ...), each
;; type written as in the kernel: a numeric type's name, or (ref T) or
;; (ref null T) with T a heap type's name; #f if id is not a function.
(define (query-function-signature id)
  (unless (id? id) (raise-compile-error api-where "identifier-function-signature: expected an identifier"))
  (let ([m (meaning-of id api-phase)])
    (and m (eq? (car m) 'func)
         (let ([info (cadr m)])
           (append (map type->datum (func-info-params info)) '(->) (map type->datum (func-info-results info)))))))

(define (type->datum t)
  (if (ref-type? t)
      (let* ([h (ref-heap t)] [name (if (type-info? h) (type-info-name h) h)])
        (if (ref-nullable? t) (list 'ref 'null name) (list 'ref name)))
      t))

;; The running macro's introduction scope is flipped around the expansion,
;; so code from the macro's input expands as it would at the use site. If
;; an exception leaves the expansion, the expander is as it was, since the
;; macro may handle it and go on.
(define (query-local-expand s)
  (unless (stx? s) (raise-compile-error api-where "local-expand: expected syntax"))
  (let ([saved current-function])
    (dynamic-wind (lambda () #f)
                  (lambda () (flip-scope (expand-expr (flip-scope s api-intro) api-phase) api-intro))
                  (lambda () (set! current-function saved)))))

;; The form gets the macro's introduction scope, as its output does. The
;; macro gets back the form it gave, which its output can hold.
(define (query-lift form)
  (unless (stx? form) (raise-compile-error api-where "syntax-local-lift-definition: expected syntax"))
  (lift! (flip-scope form api-intro) api-where api-phase)
  form)

(define (query-introduce s)
  (unless (stx? s) (raise-compile-error api-where "syntax-local-introduce: expected syntax"))
  (flip-scope s api-intro))

(type query1 (func (eqref -> eqref)))
(type query2 (func (eqref eqref -> eqref)))
(func (q-local-value [id eqref]) -> eqref (type query1) (query-local-value id))
(func (q-free-identifier=? [a eqref] [b eqref]) -> eqref (type query2) (query-free-identifier=? a b))
(func (q-binding-kind [id eqref]) -> eqref (type query1) (query-binding-kind id))
(func (q-local-expand [s eqref]) -> eqref (type query1) (query-local-expand s))
(func (q-lift [form eqref]) -> eqref (type query1) (query-lift form))
(func (q-signature [id eqref]) -> eqref (type query1) (query-function-signature id))
(func (q-introduce [s eqref]) -> eqref (type query1) (query-introduce s))
(import %set-queries "kernel" "%set-queries"
        ((ref query1) (ref query2) (ref query1) (ref query1) (ref query1) (ref query1) (ref query1) ->))

;; Answer the kernel module's queries from here from now on.
(func (register-queries!) -> eqref
  (%set-queries (ref.func q-local-value) (ref.func q-free-identifier=?) (ref.func q-binding-kind)
                (ref.func q-local-expand) (ref.func q-lift) (ref.func q-signature) (ref.func q-introduce))
  (ref.null eq))

;; ==== fully expanded code ====
;;
;; Expansion turns code into fully expanded code (spec 6.4): syntax in the
;; kernel's core grammar, with every macro use expanded and every
;; application and literal explicit. Lowering (below) turns fully expanded
;; code into the compiler's input (core.sub).
;;
;; The core forms in fully expanded code are named by identifiers with only
;; the core scope, so they mean the core forms in any module, whatever it
;; binds. Everything else keeps its scopes. So fully expanded code can be
;; expanded again: macros can embed the result of local-expand, and
;; #%linklet returns fully expanded code.

;; The identifier for core form `name` in fully expanded code.
(define (core-id name where) (make-stx name (list core-scope) (and where (stx-srcloc where)) '()))

;; A list in fully expanded code, located at where.
(define (out-list where items) (make-stx items (list core-scope) (and where (stx-srcloc where)) '()))

;; The core form (name part ...), located at where.
(define (out where name . parts) (out-list where (cons (core-id name where) parts)))

;; Module-level form f with its head replaced by the core identifier.
(define (core-headed f name) (out-list f (cons (core-id name (car (stx-e f))) (cdr (stx-e f)))))

;; An identifier for one of the kernel module's functions, for the calls
;; quasiquote and quasisyntax expand into. Its private scope is on no
;; module's code, so only fully expanded code can refer to it.
(define kernel-id-scope #f)
(define kernel-ids (make-hasheq))
(define (kernel-id name)
  (kernel-id-scope!)
  (or (hash-ref kernel-ids name #f)
      (let ([id (make-stx name (list kernel-id-scope) #f '())])
        (bind-raw! name (list kernel-id-scope) 'all (list 'func (kernel-function target-kernel name)))
        (hash-set! kernel-ids name id)
        id)))

;; ==== expressions ====

;; s has no value binding. It may still name a type.
(define (unbound s sym phase)
  (if (type-meaning-of s phase)
      (raise-compile-error s "~a is a type, not a value" sym)
      (raise-compile-error s "unbound identifier ~a~a" sym (if (> phase 0) (format " at phase ~a" phase) ""))))

(define (expand-expr s phase)
  (let ([e (stx-e s)])
    (cond
      [(symbol? e)
       (let ([m (meaning-of s phase)])
         (case (and m (car m))
           [(local) (with-local-binding s (cadr m))]
           [(global) s]
           [(compile-time-value)
            (let ([t (transformer-of m)])
              (if t
                  (expand-expr (apply-macro s t s phase #f) phase)
                  (raise-compile-error s "~a is bound to a compile-time value: read it with syntax-local-value" e)))]
           [(func)
            (if (has-value? (cadr m))
                s
                (raise-compile-error s "~a is a function: call it, or use (func-index ~a)" e e))]
           [(data) (raise-compile-error s "~a is data: use (data-address ~a) and (data-size ~a)" e e e)]
           [(tag) (raise-compile-error s "~a is a tag: throw it with (throw ~a arg ...)" e e)]
           [(core prim) (raise-compile-error s "bad use of ~a" e)]
           [(label) (raise-compile-error s "~a is a label" e)]
           [else (unbound s e phase)]))]
      [(pair? e)
       (let* ([head (car e)]
              [m (and (id? head) (meaning-of head phase))]
              [t (transformer-of m)])
         (if t
             (expand-expr (apply-macro head t s phase #f) phase)
             (case (and m (car m))
               [(core) (expand-core (cadr m) s phase)]
               [(prim) (expand-prim (cadr m) s phase)]
               [else
                ;; Any other form is an application: (#%app f arg ...), where
                ;; #%app has the scopes of the form (spec 5.3).
                (when (and (id? head) (eq? (stx-e head) app-sym))
                  (if m
                      (raise-compile-error s "#%app is bound here, but not to a macro or the core form")
                      (unbound head app-sym phase)))
                (expand-expr (stx-rewrap s (cons (implicit-id s app-sym) e)) phase)])))]
      [(null? e) (raise-compile-error s "empty form ()")]
      [(literal? e)
       ;; A literal is (#%datum literal), where #%datum has the scopes of the
       ;; literal (spec 5.4).
       (let* ([id (implicit-id s datum-sym)]
              [m (meaning-of id phase)]
              [t (transformer-of m)])
         (cond
           [t (expand-expr (apply-macro id t (stx-rewrap s (list id s)) phase #f) phase)]
           [(and m (eq? (car m) 'core)) (core-datum s) (out s datum-sym s)]
           [else (raise-compile-error s "the literal ~s needs #%datum, which is ~a here" (stx->datum s)
                                      (if m "not a macro or the core form" "unbound"))]))]
      [(keyword? e) (raise-compile-error s "~s: keyword misused as an expression" e)]
      [else (raise-compile-error s "~s is not an expression" (stx->datum s))])))

(define (literal? e)
  (or (number? e) (char? e) (boolean? e) (string? e)))

;; The identifier `name` with the scopes and srcloc of s: the implicit
;; #%app of a form or #%datum of a literal.
(define (implicit-id s name) (datum->stx s name (stx-srcloc s)))

;; The core #%datum: an unquoted literal is a wasm number (spec 5.4).
;; Checks the literal, and gives its lowered form.
(define (core-datum s)
  (let ([e (stx-e s)])
    (cond [(integer? e) (list 'int e)]
          [(number? e) (list 'float e)]
          [(char? e) (list 'int (char->integer e))]
          [(eq? e #t) '(const i32 1)]
          [(eq? e #f) '(const i32 0)]
          [(string? e)
           (raise-compile-error s "a string is not a wasm value: use (data name offset \"...\") for bytes, or '\"...\" for a kernel string")]
          [else (raise-compile-error s "~s is not a literal" (stx->datum s))])))

;; The core #%app: (#%app f arg ...) calls the function f; with any other
;; head, an expression, it applies a function value, which the language
;; lowers (spec 5.3).
(define (core-app s f args phase)
  (let ([ex (lambda (e) (expand-expr e phase))])
    (apply out s app-sym (if (function-name? f phase) f (ex f)) (map ex args))))

(define (function-name? f phase)
  (let ([m (and (id? f) (meaning-of f phase))])
    (and m (eq? (car m) 'func))))

;; A numeric or memory instruction: (args . offset), its arguments and a
;; trailing literal offset if it has one, else #f.
(define (prim-args name s)
  (let* ([p (lookup-prim name)]
         [args (or (stx->list (cdr (stx-e s))) (raise-compile-error s "bad syntax"))]
         [n (length (prim-op-params p))])
    (cond [(= (length args) n) (cons args #f)]
          [(and (eq? (prim-op-kind p) 'mem) (= (length args) (+ n 1))
                (let ([off (stx-e (list-ref args n))]) (and (fixnum? off) (>= off 0))))
           (cons (take args n) (list-ref args n))]
          [else (raise-compile-error s "~a takes ~a argument~a~a, got ~a" name n (if (= n 1) "" "s")
                                     (if (eq? (prim-op-kind p) 'mem) " and an optional offset" "")
                                     (length args))])))

(define (expand-prim name s phase)
  (let ([ao (prim-args name s)])
    (apply out s name (append (map (lambda (a) (expand-expr a phase)) (car ao))
                              (if (cdr ao) (list (cdr ao)) '())))))

(define (data-info-of id phase)
  (let ([m (and (id? id) (meaning-of id phase))])
    (unless (and m (eq? (car m) 'data))
      (raise-compile-error id "~s is not data" (stx->datum id)))
    (cadr m)))

;; The declared type id names, which must be a struct or array type, as
;; kind says.
(define (kind-type-of id kind phase)
  (let ([t (type-of id phase)])
    (unless (eq? (type-info-kind t) kind)
      (raise-compile-error id "~a is not a~a type" (type-info-name t) (if (eq? kind 'struct) " struct" "n array")))
    t))

;; GC form s: (op immediate ... arg ...). Immediates are types, fields and
;; reference types. Checks s and returns (immediates . arguments), the
;; immediates resolved.
(define (gc-parts name s phase)
  (let ([array-type (lambda (t) (list (kind-type-of t 'array phase)))])
    (case name
      [(struct.new) (syntax-match s [(_ type arg ...) (cons (list (kind-type-of type 'struct phase)) arg)])]
      [(array.new_fixed) (syntax-match s [(_ type arg ...) (cons (array-type type) arg)])]
      [(struct.get struct.get_s struct.get_u)
       (syntax-match s
         [(_ type field ref) (let ([t (type-of type phase)]) (cons (list t (field-index t field)) (list ref)))])]
      [(struct.set)
       (syntax-match s
         [(_ type field ref value) (let ([t (type-of type phase)]) (cons (list t (field-index t field)) (list ref value)))])]
      [(array.new) (syntax-match s [(_ type value size) (cons (array-type type) (list value size))])]
      [(array.new_default) (syntax-match s [(_ type size) (cons (array-type type) (list size))])]
      [(array.get array.get_s array.get_u) (syntax-match s [(_ type ref index) (cons (array-type type) (list ref index))])]
      [(array.set) (syntax-match s [(_ type ref index value) (cons (array-type type) (list ref index value))])]
      [(array.fill)
       (syntax-match s [(_ type ref index value size) (cons (array-type type) (list ref index value size))])]
      [(array.copy)
       (syntax-match s
         [(_ dst-type src-type dst dst-index src src-index size)
          (cons (list (type-of dst-type phase) (type-of src-type phase)) (list dst dst-index src src-index size))])]
      [(ref.null) (syntax-match s [(_ heap) (cons (list (parse-heap heap phase)) '())])]
      [(ref.test ref.cast) (syntax-match s [(_ type ref) (cons (list (parse-reftype type phase)) (list ref))])]
      [(ref.eq) (syntax-match s [(_ a b) (cons '() (list a b))])]
      [else (syntax-match s [(_ ref) (cons '() (list ref))])])))

;; parts of GC form (name immediate ... arg ...) with the type immediates
;; expanded (spec 5.1).
(define (expand-gc-immediates name parts phase)
  (let ([n (case name
             [(ref.null ref.test ref.cast) 1]
             [(array.copy) 2]
             [(ref.eq array.len ref.is_null ref.as_non_null ref.i31 i31.get_s i31.get_u) 0]
             [else 1])])
    (if (< (length parts) (+ n 1))
        parts
        (cons (car parts)
              (append (map (lambda (t) (if (memq name '(ref.test ref.cast))
                                           (expand-type t phase)
                                           (expand-type-name t phase)))
                           (take (cdr parts) n))
                      (list-tail (cdr parts) n))))))

(define (expand-gc name s phase)
  (let* ([parts (expand-gc-immediates name (or (stx->list s) (raise-compile-error s "bad ~a syntax" name)) phase)]
         [args (cdr (gc-parts name (stx-rewrap s parts) phase))])
    (apply out s name (append (take (cdr parts) (- (length (cdr parts)) (length args)))
                              (map (lambda (a) (expand-expr a phase)) args)))))

(define (expand-core name s phase)
  (let ([ex (lambda (x) (expand-expr x phase))]
        [o (lambda parts (apply out s name parts))])
    (case name
      [(#%app) (syntax-match s [(_ f arg ...) (core-app s f arg phase)])]
      [(#%datum) (syntax-match s [(_ literal) (core-datum literal) (o literal)])]
      [(#%linklet) (raise-compile-error s "#%linklet is not a form: it names the hook for a unit's code (spec 6.5)")]
      [(quote) (syntax-match s [(_ datum) (o datum)])]
      [(quote-syntax) (syntax-match s [(_ datum) (o (prune-local-scopes datum))])]
      [(quasiquote) (syntax-match s [(_ template) (quasi s template 0 phase 'quasiquote 'unquote 'unquote-splicing #f)])]
      [(quasisyntax) (syntax-match s [(_ template) (quasi s template 0 phase 'quasisyntax 'unsyntax 'unsyntax-splicing #t)])]
      [(unquote unquote-splicing unsyntax unsyntax-splicing)
       (raise-compile-error s "~a is not inside a quasi form" name)]
      [(data-address data-size) (syntax-match s [(_ data) (data-info-of data phase) (o data)])]
      ;; wasm's constants: a literal of that type, whatever #%datum means
      ;; here (spec 5.3).
      [(i32.const i64.const f32.const f64.const) (syntax-match s [(_ literal) (const-literal name literal) (o literal)])]
      [(set!)
       (syntax-match s
         [(_ (? id? x) value)
          (let ([m (meaning-of x phase)])
            (unless (and m (memq (car m) '(local global)))
              (raise-compile-error x "set!: ~a is not a variable" (stx-e x)))
            (o (if (eq? (car m) 'local) (with-local-binding x (cadr m)) x) (ex value)))])]
      [(let let*)
       (syntax-match s
         [(_ (? stx? bindings (binding ...)) body ...)
          (let ([bs (map (lambda (b) (let-binding b phase)) binding)])
            (if (eq? name 'let)
                (let* ([inits (map (lambda (bp) (ex (binding-init bp))) bs)]
                       [sc (new-local-scope!)]
                       [xs (map (lambda (bp) (bound-local (add-scope (car bp) sc) phase)) bs)])
                  (apply o (out-list bindings (map binding-out bs xs inits))
                         (map (lambda (x) (ex (add-scope x sc))) body)))
                (expand-let* s bs body phase)))])]
      ;; (lambda ([x t] ...) [-> r] body ...): a function that uses the
      ;; locals around it (spec 5.3). It cannot branch to the labels
      ;; around it.
      [(lambda)
       (syntax-match s
         [(_ (? stx? ps (p ...)) . rest)
          (let* ([params (map (lambda (x) (param-of x phase)) p)]
                 [arrow (arrow-of rest phase)]
                 [body (list-tail rest (length arrow))]
                 [sc (new-local-scope!)]
                 [xs (map (lambda (pp) (bound-local (add-scope (car pp) sc) phase)) params)]
                 [saved current-function])
            (for-each (lambda (pp) (parse-type (cadr pp) phase)) params)
            (parse-results arrow phase)
            (set! current-function (list s))
            (let ([r (apply o (out-list ps (map (lambda (x pp) (out-list x (list x (cadr pp)))) xs params))
                            (append arrow (map (lambda (b) (ex (add-scope b sc))) body)))])
              (set! current-function saved)
              r))])]
      [(begin) (syntax-match s [(_ e ...) (apply o (map ex e))])]
      [(if) (syntax-match s
              [(_ test then) (o (ex test) (ex then))]
              [(_ test then otherwise) (o (ex test) (ex then) (ex otherwise))])]
      [(block loop)
       (syntax-match s
         [(_ (? id? label) body ...)
          (let* ([sc (new-local-scope!)] [l (add-scope label sc)])
            (fresh-label! l phase)
            (apply o l (map (lambda (x) (ex (add-scope x sc))) body)))])]
      [(br) (syntax-match s
              [(_ label) (check-label-here label phase) (o label)]
              [(_ label value) (check-label-here label phase) (o label (ex value))])]
      [(br-if) (syntax-match s [(_ label test) (check-label-here label phase) (o label (ex test))])]
      [(return) (syntax-match s [(_) (o)] [(_ value) (o (ex value))])]
      [(call-indirect)
       (syntax-match s
         [(_ signature index arg ...)
          (let ([sig (expand-signature signature phase)])
            (parse-signature sig phase)
            (apply o sig (ex index) (map ex arg)))])]
      ;; (ref.func f): a reference to f, at its declared function type.
      [(ref.func)
       (syntax-match s
         [(_ (? id? f))
          (let ([m (meaning-of f phase)])
            (unless (and m (eq? (car m) 'func))
              (raise-compile-error f "ref.func: ~a is not a function" (stx-e f)))
            (unless (func-info-type (cadr m))
              (raise-compile-error f "ref.func: ~a has no declared function type; give it one with (type T)" (stx-e f))))
          (o f)])]
      ;; (call-ref T f arg ...): call f, a (ref null T), with the args.
      [(call-ref)
       (syntax-match s
         [(_ type f arg ...)
          (let* ([tname (expand-type-name type phase)] [t (type-of tname phase)])
            (unless (func-type? t)
              (raise-compile-error type "call-ref: ~a is not a function type" (type-info-name t)))
            (apply o tname (ex f) (map ex arg)))])]
      [(func-index)
       (syntax-match s
         [(_ (? id? f))
          (let ([m (meaning-of f phase)])
            (unless (and m (eq? (car m) 'func))
              (raise-compile-error f "func-index: ~a is not a function" (stx-e f))))
          (o f)])]
      [(select) (syntax-match s [(_ a b test) (o (ex a) (ex b) (ex test))])]
      [(drop) (syntax-match s [(_ value) (o (ex value))])]
      [(unreachable nop) (syntax-match s [(_) (o)])]
      ;; (throw tag arg ...): throw an exception of tag, carrying the args.
      [(throw) (syntax-match s [(_ tag arg ...) (tag-info-of tag phase) (apply o tag (map ex arg))])]
      [(throw-ref) (syntax-match s [(_ exn) (o (ex exn))])]
      ;; (try (clause ...) body ...): body, with the exceptions the clauses
      ;; catch handled by them (spec 5.3).
      [(try)
       (syntax-match s
         [(_ (? stx? clauses (clause ...)) body ...)
          (apply o (out-list clauses (map (lambda (c) (expand-catch c phase)) clause)) (map ex body))])]
      [else
       (if (memq name gc-forms)
           (expand-gc name s phase)
           (raise-compile-error s "~a is only allowed at module level" name))])))

;; The literal n of constant form (name n): a number, and an integer for
;; i32.const and i64.const.
(define (const-literal name s)
  (let ([n (stx-e s)] [integer (memq name '(i32.const i64.const))])
    (unless (if integer (integer? n) (number? n))
      (raise-compile-error s "~a takes a literal ~a" name (if integer "integer" "number")))
    n))

(define (const-type name)
  (case name [(i32.const) 'i32] [(i64.const) 'i64] [(f32.const) 'f32] [else 'f64]))

;; The parts of try clause c, [catch tag (x ...) body ...], [catch-ref tag
;; (x ... e) body ...], [catch-all body ...] or [catch-all-ref (e) body
;; ...], whose first word is compared by name: (kind tag-or-#f
;; variables-or-#f body). The variables are bound to the exception's
;; values, then, for the -ref kinds, to the exception itself.
(define (catch-parts c)
  (syntax-match c
    [('catch tag (? stx? vars ((? id? x) ...)) body ...) (list 'catch tag vars body)]
    [('catch-ref tag (? stx? vars ((? id? x) ... (? id? e))) body ...) (list 'catch-ref tag vars body)]
    [('catch-all body ...) (list 'catch-all #f #f body)]
    [('catch-all-ref (? stx? vars ((? id? e))) body ...) (list 'catch-all-ref #f vars body)]))

(define (expand-catch c phase)
  (let* ([p (catch-parts c)] [kind (car p)] [tag (cadr p)] [vars (caddr p)] [body (cadddr p)]
         [xs (if vars (stx->list vars) '())]
         [n (+ (if tag (length (tag-info-params (tag-info-of tag phase))) 0)
               (if (memq kind '(catch-ref catch-all-ref)) 1 0))]
         [sc (new-local-scope!)])
    (unless (= (length xs) n)
      (raise-compile-error vars "this clause binds ~a variable~a, not ~a" n (if (= n 1) "" "s") (length xs)))
    (let ([bound (map (lambda (x) (bound-local (add-scope x sc) phase)) xs)])
      (out-list c (append (list (core-id kind (car (stx->list c))))
                          (if tag (list tag) '())
                          (if vars (list (out-list vars bound)) '())
                          (map (lambda (b) (expand-expr (add-scope b sc) phase)) body))))))

;; A let binding [x init] or [x type init], as the list (x init) or
;; (x type init), the type expanded.
(define (let-binding b phase)
  (syntax-match b
    [((? id? name) init) (list name init)]
    [((? id? name) type init) (let ([t (expand-type type phase)]) (parse-type t phase) (list name t init))]))

;; A let binding [x init] or [x type init].
(define (binding-init bp) (if (= (length bp) 3) (caddr bp) (cadr bp)))
(define (binding-out bp x init)
  (out-list (car bp) (if (= (length bp) 3) (list x (cadr bp) init) (list x init))))

;; (let* (b ...) body ...) as nested lets, one binding each.
(define (expand-let* s bs body phase)
  (let ([ex (lambda (x) (expand-expr x phase))])
    (if (null? bs)
        (apply out s 'let (out-list s '()) (map ex body))
        (let* ([bp (car bs)]
               [init (ex (binding-init bp))]
               [sc (new-local-scope!)]
               [x (bound-local (add-scope (car bp) sc) phase)]
               [later (map (lambda (bp) (map (lambda (y) (add-scope y sc)) bp)) (cdr bs))]
               [body (map (lambda (y) (add-scope y sc)) body)])
          (apply out s 'let (out-list s (list (binding-out bp x init)))
                 (if (null? later)
                     (map ex body)
                     (list (expand-let* s later body phase))))))))

(define (bind-local! id phase)
  (let ([b (bind! id phase #f)])
    (set-binding-meaning! b (list 'local (binding-key b)))
    (binding-key b)))

;; Local variable id, bound, as fully expanded code holds it: recording its
;; binding for local-binding (spec 2.3).
(define (bound-local id phase) (with-local-binding id (bind-local! id phase)))

;; id, recording that it binds or refers to the local variable with key.
;; The property's key is private to the kernel module (appendix A).
(define local-binding-sym '%local-binding)
(define (with-local-binding id key)
  (make-stx (stx-e id) (stx-scopes id) (stx-srcloc id)
            (cons (cons local-binding-sym key)
                  (filter (lambda (p) (not (eq? (car p) local-binding-sym))) (stx-props id)))))

;; The function or lambda whose body is being expanded, as a unique list,
;; or #f; and label key -> the one it was bound in. A branch must stay in
;; its function.
(define current-function #f)
(define label-functions (make-hasheqv))

(define (fresh-label! id phase)
  (let* ([b (bind! id phase #f)] [key (binding-key b)])
    (set-binding-meaning! b (list 'label key))
    (hash-set! label-functions key current-function)
    key))

(define (check-label-here id phase)
  (unless (eq? (hash-ref label-functions (label-key-of id phase) #f) current-function)
    (raise-compile-error id "~a is a label of the function around this lambda, which a lambda cannot branch to"
                         (stx-e id))))

(define (label-key-of id phase)
  (let ([m (and (id? id) (meaning-of id phase))])
    (unless (and m (eq? (car m) 'label))
      (raise-compile-error id "~s is not a label" (stx->datum id)))
    (cadr m)))

;; ==== quasiquote / quasisyntax ====
;;
;; One walker for both. The result is fully expanded code that calls the
;; kernel module. For quasisyntax, unchanged subtemplates become syntax
;; constants and changed lists are rewrapped with the template's own
;; scopes and srcloc (syntax-rewrap).

(define (quasi where t depth phase qname uname sname syntax?)
  (letrec ([tagged? (lambda (x name)
                      (let ([l (stx->list x)])
                        (and l (= (length l) 2) (core-id? (car l) name phase))))]
           [changes? (lambda (x depth)
                       (cond [(tagged? x uname) (or (= depth 0) (changes? (cadr (stx->list x)) (- depth 1)))]
                             [(tagged? x sname) (or (= depth 0) (changes? (cadr (stx->list x)) (- depth 1)))]
                             [(tagged? x qname) (changes? (cadr (stx->list x)) (+ depth 1))]
                             [(pair? (stx-e x))
                              (let loop ([e (stx-e x)])
                                (cond [(null? e) #f]
                                      [(stx? e) (changes? e depth)]
                                      [else (or (changes? (car e) depth) (loop (cdr e)))]))]
                             [else #f]))]
           [call (lambda (name . args) (apply out where app-sym (kernel-id name) args))]
           [constant (lambda (x)
                       (if syntax?
                           (out x 'quote-syntax (prune-local-scopes x))
                           (out x 'quote x)))]
           ;; Rebuild the pair chain e (elements of template x) as an
           ;; expression.
           [build-list (lambda (x e depth)
                         (let loop ([e e])
                           (cond [(null? e) (out x 'quote (make-stx '() '() #f '()))]
                                 [(stx? e) (walk e depth)]
                                 [(and (= depth 0) (tagged? (car e) sname))
                                  (let ([v (expand-expr (cadr (stx->list (car e))) phase)])
                                    (call 'append (if syntax? (call 'splice-list v) v) (loop (cdr e))))]
                                 [else (call 'cons (walk (car e) depth) (loop (cdr e)))])))]
           [walk (lambda (x depth)
                   (cond [(not (changes? x depth)) (constant x)]
                         [(and (tagged? x uname) (= depth 0)) (expand-expr (cadr (stx->list x)) phase)]
                         [(pair? (stx-e x))
                          (let* ([l (stx-e x)]
                                 [inner-depth (cond [(or (tagged? x uname) (tagged? x sname)) (- depth 1)]
                                                    [(tagged? x qname) (+ depth 1)]
                                                    [else depth])]
                                 [head (if (or (tagged? x uname) (tagged? x sname) (tagged? x qname))
                                           (call 'cons (constant (car l)) (build-list x (cdr l) inner-depth))
                                           (build-list x l depth))])
                            (if syntax? (call 'syntax-rewrap (constant x) head) head))]
                         [else (constant x)]))])
    (walk t depth)))

;; ==== lowering ====
;;
;; Fully expanded code -> the compiler's input (core.sub). Lowering only
;; resolves names: expansion has already checked the code and bound every
;; variable and label, so anything else is an internal error.

(define (at s ast) (list 'at (stx-srcloc s) ast))

(define (not-expanded s)
  (raise-compile-error s "internal: not fully expanded code: ~s" (stx->datum s)))

(define (lower-forms forms phase)
  (apply append (map (lambda (f) (lower-form f phase)) forms)))

;; A module-level form, as a list of forms for the compiler: none for an
;; import, one per type for a recursion group.
(define (lower-form f phase)
  (case (core-head f phase)
    [(func)
     (syntax-match f
       [(_ (name (param _) ...) . rest)
        (let* ([info (func-info-of name phase)]
               [options (func-options rest)]
               [inline? (car options)]
               [body (cdr (parse-results (caddr options) phase))]
               [params (map (lambda (p t) (cons (local-key-of p phase) t)) param (func-info-params info))]
               ;; A (type T) clause first is in the info already.
               [code (lower-seq (if (and (pair? body) (type-clause? (car body))) (cdr body) body) f phase)])
          (when inline? (record-inline! info params code name))
          (when (cadr options) (function-value info))
          (list (list 'func info params code)))])]
    [(global) (syntax-match f [(_ name _ init) (list (list 'global (cadr (meaning-of name phase)) (lower-expr init phase)))])]
    [(import) '()]
    [(type) (syntax-match f [(_ name _) (list (list 'type (type-of name phase)))])]
    [(rec) (syntax-match f [(_ (_ name _) ...) (map (lambda (n) (list 'type (type-of n phase))) name)])]
    [(data) (syntax-match f [(_ name . _) (list (list 'data (data-info-of name phase)))])]
    [(tag) (syntax-match f [(_ name _) (list (list 'tag (tag-info-of name phase)))])]
    [else (list (list 'expr (lower-expr f phase)))]))

(define (lower-seq forms where phase)
  (at where (cons 'seq (map (lambda (f) (lower-expr f phase)) forms))))

(define (func-info-of id phase)
  (let ([m (and (id? id) (meaning-of id phase))])
    (unless (and m (eq? (car m) 'func)) (not-expanded id))
    (check-not-removed (cadr m) id)
    (in-lowering-kernel (cadr m) id)))

;; ---- function values (spec 5.2) ----

;; A function declared with #:value g -> (g . phase), then g's info once
;; it is resolved. In fully expanded code a function's name stays a name,
;; and lowering reads its value then: a linklet hook's output may
;; redefine the global (6.5).
(define function-values (make-hasheq))

(define (value-base info)
  (let ([origin (hash-ref shift-origins info #f)]) (if origin (car origin) info)))

(define (has-value? info) (hash-has-key? function-values (value-base info)))

;; The info of the global that is func info's value, shifted as info is,
;; or #f if info has none.
(define (function-value info)
  (let* ([origin (hash-ref shift-origins info #f)]
         [base (value-base info)]
         [v (hash-ref function-values base #f)])
    (and v
         (let ([g (if (pair? v)
                      (let ([m (meaning-of (car v) (cdr v))])
                        (unless (and m (eq? (car m) 'global))
                          (raise-compile-error (car v) "#:value names ~a, which is not a global" (stx-e (car v))))
                        (hash-set! function-values base (cadr m))
                        (cadr m))
                      v)])
           (shift-info g (if origin (cdr origin) 0))))))

;; ---- inline functions (spec 5.2) ----

;; The kernel code is lowered against keeps its inline functions' bodies
;; (kernel-inlines): info -> (params results body returns?), their
;; parameters as (key . type), their result types, their lowered bodies,
;; and whether each has a return.

;; Check that the lowered body of inline function info, named by id, does
;; not depend on which module it is compiled in, and keep it.
(define (record-inline! info params body id)
  (let* ([returns? #f]
         [fail (lambda (what) (raise-compile-error id "~a is inline, so it may not ~a" (stx-e id) what))])
    (let check ([e body])
      (case (car e)
        [(at as lset gset) (check (caddr e))]
        [(int float const lref gref ref-func unreachable nop) #f]
        [(quote)
         (let ([d (cadr e)])
           (unless (or (fixnum? d) (boolean? d) (null? d) (symbol? d) (keyword? d))
             (fail "quote data other than fixnums, booleans, (), symbols and keywords")))]
        [(let) (for-each (lambda (b) (check (caddr b))) (cadr e)) (check (caddr e))]
        [(seq) (for-each check (cdr e))]
        [(if) (check (cadr e)) (check (caddr e)) (when (cadddr e) (check (cadddr e)))]
        [(block loop br-if) (check (caddr e))]
        [(br) (when (caddr e) (check (caddr e)))]
        [(return) (set! returns? #t) (when (cadr e) (check (cadr e)))]
        [(call) (for-each check (caddr e))]
        [(prim)
         (when (or (eq? (prim-op-kind (lookup-prim (cadr e))) 'mem)
                   (memq (cadr e) '(memory.size memory.grow memory.copy memory.fill)))
           (fail "use memory"))
         (for-each check (cadddr e))]
        [(call-indirect func-index) (fail "use a table")]
        [(call-ref) (check (caddr e)) (for-each check (cadddr e))]
        [(gc) (for-each check (cadddr e))]
        [(select drop) (for-each check (cdr e))]
        [(throw) (for-each check (caddr e))]
        [(throw-ref) (check (cadr e))]
        [(try) (for-each (lambda (c) (check (cadddr c))) (cadr e)) (check (caddr e))]
        [else (raise-compile-error id "internal: lowered form ~a" (car e))]))
    (hash-set! (kernel-inlines lowering-kernel) info
               (list params (func-info-results info) body returns?
                     (filter (lambda (p) (assigns? body (car p))) params)))))

;; Whether lowered form e sets local key.
(define (assigns? e key)
  (cond [(not (pair? e)) #f]
        [(eq? (car e) 'quote) #f]
        [(and (eq? (car e) 'lset) (eqv? (cadr e) key)) #t]
        [else (ormap (lambda (x) (assigns? x key)) (cdr e))]))

;; e without the source locations around it.
(define (unlocated e) (if (eq? (car e) 'at) (unlocated (caddr e)) e))

;; A call of info with args, lowered, as info's body if it is inline and
;; takes that many arguments; #f otherwise. A shifted info's body is its
;; original's, shifted alike.
(define (inline-call info args)
  (let* ([origin (hash-ref shift-origins info #f)]
         [b (hash-ref (kernel-inlines lowering-kernel) (if origin (car origin) info) #f)])
    (and b (= (length args) (length (car b)))
         (let* ([keys (make-hasheqv)] [labels (make-hasheqv)]
                [ret (and (cadddr b) (fresh-key!))]
                [bindings (inline-bindings (car b) args (list-ref b 4) keys)]
                [body (copy-inline (caddr b) keys labels (if origin (cdr origin) 0) ret)])
           (list 'as (cadr b)
                 (let ([e (list 'let bindings body)]) (if ret (list 'block ret e) e)))))))

;; The let bindings of an inlined call's parameters params to its arguments
;; args, recording each parameter's local in keys. A parameter the body
;; does not set, given a local that no later argument sets, is that local,
;; at the parameter's type, and needs no binding.
(define (inline-bindings params args assigned keys)
  (if (null? params)
      '()
      (let* ([p (car params)] [a (unlocated (car args))])
        (if (and (eq? (car a) 'lref) (not (memq p assigned))
                 (not (ormap (lambda (later) (assigns? later (cadr a))) (cdr args))))
            (begin
              (hash-set! keys (car p) (list 'as (list (cdr p)) a))
              (inline-bindings (cdr params) (cdr args) assigned keys))
            (let ([k (fresh-key!)])
              (hash-set! keys (car p) k)
              (cons (list k (cdr p) (car args)) (inline-bindings (cdr params) (cdr args) assigned keys)))))))

;; Lowered form e of an inline body, for one inlined call: its locals and
;; labels new, its infos shifted by k, and a return a br to label ret. A
;; local that keys maps to a form, a parameter given a local, reads that. Its
;; source locations go: the code is at the call's (spec 3.6).
(define (copy-inline e keys labels k ret)
  (let* ([copy (lambda (x) (copy-inline x keys labels k ret))]
         [copy? (lambda (x) (and x (copy x)))]
         [local (lambda (key) (or (hash-ref keys key #f) (let ([n (fresh-key!)]) (hash-set! keys key n) n)))]
         [label (lambda (key) (or (hash-ref labels key #f) (let ([n (fresh-key!)]) (hash-set! labels key n) n)))]
         [shift (lambda (info) (shift-info info k))])
    (case (car e)
      [(at) (copy (caddr e))]
      [(as) (list 'as (cadr e) (copy (caddr e)))]
      [(int float const quote unreachable nop) e]
      [(lref) (let ([m (local (cadr e))]) (if (pair? m) m (list 'lref m)))]
      [(lset) (list 'lset (local (cadr e)) (copy (caddr e)))]
      [(gref) (list 'gref (shift (cadr e)))]
      [(gset) (list 'gset (shift (cadr e)) (copy (caddr e)))]
      [(let) (let ([bs (map (lambda (b) (list (local (car b)) (cadr b) (copy (caddr b)))) (cadr e))])
               (list 'let bs (copy (caddr e))))]
      [(seq select drop) (cons (car e) (map copy (cdr e)))]
      [(if) (list 'if (copy (cadr e)) (copy (caddr e)) (copy? (cadddr e)))]
      [(block loop) (list (car e) (label (cadr e)) (copy (caddr e)))]
      [(br) (list 'br (label (cadr e)) (copy? (caddr e)))]
      [(br-if) (list 'br-if (label (cadr e)) (copy (caddr e)))]
      [(return) (list 'br ret (copy? (cadr e)))]
      [(call) (list 'call (shift (cadr e)) (map copy (caddr e)))]
      [(ref-func) (list 'ref-func (shift (cadr e)))]
      [(prim) (list 'prim (cadr e) (caddr e) (map copy (cadddr e)))]
      [(call-ref) (list 'call-ref (cadr e) (copy (caddr e)) (map copy (cadddr e)))]
      [(gc) (list 'gc (cadr e) (caddr e) (map copy (cadddr e)))]
      [(throw) (list 'throw (shift (cadr e)) (map copy (caddr e)))]
      [(throw-ref) (list 'throw-ref (copy (cadr e)))]
      [(try) (list 'try
                   (map (lambda (c) (list (car c) (and (cadr c) (shift (cadr c))) (map local (caddr c)) (copy (cadddr c))))
                        (cadr e))
                   (copy (caddr e)))]
      [else (raise-compile-error #f "internal: lowered form ~a" (car e))])))

(define (lowered-data-info id phase)
  (let ([info (data-info-of id phase)])
    (check-not-removed info id)
    info))

(define (lowered-tag-info id phase)
  (let ([info (tag-info-of id phase)])
    (check-not-removed info id)
    (in-lowering-kernel info id)))

;; While lowering a module's phase-0 code: the infos of its definitions
;; that #%linklet removed, which its code must not use.
(define removed-definitions #f)

(define (check-not-removed info id)
  (when (and removed-definitions (hash-has-key? removed-definitions info))
    (raise-compile-error id "~a is used, but #%linklet removed its definition" (stx-e id))))

;; The infos of c's phase-0 definitions (functions, imports, globals, data)
;; that forms, its code after #%linklet, no longer defines.
(define (definitions-removed c forms)
  (let ([kept (make-hasheq)] [removed (make-hasheq)])
    (for-each (lambda (f)
                (case (core-head f 0)
                  [(func) (syntax-match f [(_ (name . _) . _) (hash-set! kept (cadr (meaning-of name 0)) #t)])]
                  [(import global data tag) (syntax-match f [(_ name . _) (hash-set! kept (cadr (meaning-of name 0)) #t)])]
                  [else #f]))
              forms)
    (for-each (lambda (b)
                (let ([m (binding-meaning b)])
                  (when (and m (memq (car m) '(func global data tag)) (not (hash-has-key? kept (cadr m))))
                    (hash-set! removed (cadr m) #t))))
              (comp-definitions c))
    removed))

(define (local-key-of id phase)
  (let ([m (and (id? id) (meaning-of id phase))])
    (unless (and m (eq? (car m) 'local)) (not-expanded id))
    (cadr m)))

(define (lower-expr s phase)
  (let ([e (stx-e s)])
    (at s
        (cond
          [(symbol? e)
           (let ([m (meaning-of s phase)])
             (case (and m (car m))
               [(local) (list 'lref (cadr m))]
               [(global) (check-not-removed (cadr m) s) (list 'gref (in-lowering-kernel (cadr m) s))]
               ;; A function's name as an expression is its value (5.2).
               [(func)
                (let ([g (function-value (cadr m))])
                  (unless g (not-expanded s))
                  (check-not-removed g s)
                  (list 'gref g))]
               [else (not-expanded s)]))]
          [(pair? e)
           (let* ([parts (stx->list s)]
                  [m (and parts (id? (car parts)) (meaning-of (car parts) phase))])
             (case (and m (car m))
               [(core) (lower-core (cadr m) s phase)]
               [(prim)
                (let ([ao (prim-args (cadr m) s)])
                  (list 'prim (cadr m) (and (cdr ao) (stx-e (cdr ao)))
                        (map (lambda (a) (lower-expr a phase)) (car ao))))]
               [else (not-expanded s)]))]
          [else (not-expanded s)]))))

(define (lower-core name s phase)
  (let ([lo (lambda (x) (lower-expr x phase))])
    (case name
      [(#%app)
       (syntax-match s
         [(_ f arg ...)
          (unless (function-name? f phase)
            (raise-compile-error s "~aan application of a function value must be lowered to other kernel code before it is compiled (spec 5.3)"
                                 (if (id? f) (format "~a is a variable, not a function: " (stx-e f)) "")))
          (let ([info (func-info-of f phase)] [args (map lo arg)])
            (or (inline-call info args) (list 'call info args)))])]
      [(#%datum) (syntax-match s [(_ literal) (core-datum literal)])]
      [(quote) (syntax-match s [(_ datum) (list 'quote (stx->datum datum))])]
      [(quote-syntax) (syntax-match s [(_ datum) (list 'quote datum)])]
      [(i32.const i64.const f32.const f64.const)
       (syntax-match s
         [(_ literal)
          (let ([n (const-literal name literal)])
            (list 'as (list (const-type name)) (if (integer? n) (list 'int n) (list 'float n))))])]
      [(data-address) (syntax-match s [(_ data) (list 'const 'i32 (data-info-offset (lowered-data-info data phase)))])]
      [(data-size)
       (syntax-match s [(_ data) (list 'const 'i32 (bytes-length (data-info-bytes (lowered-data-info data phase))))])]
      [(set!)
       (syntax-match s
         [(_ x value)
          (let ([m (meaning-of x phase)])
            (case (and m (car m))
              [(local) (list 'lset (cadr m) (lo value))]
              [(global) (check-not-removed (cadr m) x)
                        (list 'gset (in-lowering-kernel (cadr m) x) (lo value))]
              [else (not-expanded s)]))])]
      [(let)
       (syntax-match s
         [(_ (binding ...) body ...)
          (list 'let
                (map (lambda (b)
                       (syntax-match b
                         [(x init) (list (local-key-of x phase) #f (lo init))]
                         [(x type init) (list (local-key-of x phase) (parse-type type phase) (lo init))]))
                     binding)
                (lower-seq body s phase))])]
      [(lambda)
       (raise-compile-error s "lambda: a lambda must be lowered to other kernel code before it is compiled (spec 5.3)")]
      [(begin) (syntax-match s [(_ e ...) (cons 'seq (map lo e))])]
      [(if) (syntax-match s
              [(_ test then) (list 'if (lo test) (lo then) #f)]
              [(_ test then otherwise) (list 'if (lo test) (lo then) (lo otherwise))])]
      [(block loop) (syntax-match s [(_ label body ...) (list name (label-key-of label phase) (lower-seq body s phase))])]
      [(br) (syntax-match s
              [(_ label) (list 'br (label-key-of label phase) #f)]
              [(_ label value) (list 'br (label-key-of label phase) (lo value))])]
      [(br-if) (syntax-match s [(_ label test) (list 'br-if (label-key-of label phase) (lo test))])]
      [(return) (syntax-match s [(_) (list 'return #f)] [(_ value) (list 'return (lo value))])]
      [(call-indirect)
       (syntax-match s
         [(_ signature index arg ...)
          (let ([sig (parse-signature signature phase)])
            (list 'call-indirect (car sig) (cdr sig) (lo index) (map lo arg)))])]
      [(func-index) (syntax-match s [(_ f) (list 'func-index (func-info-of f phase))])]
      [(ref.func) (syntax-match s [(_ f) (list 'ref-func (func-info-of f phase))])]
      [(call-ref) (syntax-match s [(_ type f arg ...) (list 'call-ref (type-of type phase) (lo f) (map lo arg))])]
      [(select) (syntax-match s [(_ a b test) (list 'select (lo a) (lo b) (lo test))])]
      [(drop) (syntax-match s [(_ value) (list 'drop (lo value))])]
      [(unreachable) '(unreachable)]
      [(nop) '(nop)]
      [(throw) (syntax-match s [(_ tag arg ...) (list 'throw (lowered-tag-info tag phase) (map lo arg))])]
      [(throw-ref) (syntax-match s [(_ exn) (list 'throw-ref (lo exn))])]
      [(try)
       (syntax-match s
         [(_ (clause ...) body ...)
          (list 'try
                (map (lambda (c)
                       (let* ([p (catch-parts c)] [tag (cadr p)] [vars (caddr p)])
                         (list (car p) (and tag (lowered-tag-info tag phase))
                               (map (lambda (x) (local-key-of x phase)) (if vars (stx->list vars) '()))
                               (lower-seq (cadddr p) c phase))))
                     clause)
                (lower-seq body s phase))])]
      [else
       (if (memq name gc-forms)
           (let ([ia (gc-parts name s phase)])
             (list 'gc name (car ia) (map lo (cdr ia))))
           (not-expanded s))])))
