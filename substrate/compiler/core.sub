;; The records and types the expander and the back end share.
(require-unqualified base "base/base.sub")
(require-unqualified k "kernel.sub")

(provide func-info func-info? func-info-name func-info-params func-info-results
         func-info-instance set-func-info-instance! func-info-export set-func-info-export! func-info-type
         global-info global-info? global-info-name global-info-type global-info-mutable?
         global-info-instance set-global-info-instance! global-info-export set-global-info-export!
         tag-info tag-info? tag-info-name tag-info-params tag-info-instance set-tag-info-instance!
         tag-info-export set-tag-info-export!
         data-info data-info? data-info-name data-info-offset data-info-bytes
         make-type-info type-info? type-info-name type-info-fields set-type-info-fields! type-info-identity
         identify-type! same-type?
         ref-type? make-ref ref-nullable? ref-heap abstract-heaps numeric-type?
         heap<=? valtype<=? types<=? types=? valtype-join valtype->string defaultable?
         fresh-key! reset-keys!)

(const func-kind u32 1)
(const global-kind u32 2)
(const tag-kind u32 3)
(const data-kind u32 4)
(const type-kind u32 5)

(struct func-record [self datum] [name datum] [params datum] [results datum] [instance datum] [export datum] [type datum])

(struct global-record [self datum] [name datum] [type datum] [mutable datum] [instance datum] [export datum])

(struct tag-record [self datum] [name datum] [params datum] [instance datum] [export datum])

(struct data-record [self datum] [name datum] [offset datum] [bytes datum])

(struct type-record [self datum] [name datum] [fields datum] [identity u32])

(define (new-record [kind u32] [size u32]) -> (ptr void)
  (let ([p (alloc-in (& run-arena) size)])
    (set! (@ (cast (ptr datum) p)) (make-record kind p))
    p))

(define (checked [d datum] [kind u32] [what (ptr u8)]) -> (ptr void)
  (unless (record? d kind) (raise-compile-error 0 (format-message "internal: expected ~a" (cons (bytes->string what (strlen what)) nil))))
  (record-pointer d))

(define (func-of [d datum]) -> (ptr func-record) (cast (ptr func-record) (checked d func-kind "a function")))
(define (global-of [d datum]) -> (ptr global-record) (cast (ptr global-record) (checked d global-kind "a global")))
(define (tag-of [d datum]) -> (ptr tag-record) (cast (ptr tag-record) (checked d tag-kind "a tag")))
(define (data-of [d datum]) -> (ptr data-record) (cast (ptr data-record) (checked d data-kind "data")))
(define (type-of-info [d datum]) -> (ptr type-record) (cast (ptr type-record) (checked d type-kind "a type")))

(define (func-info [name datum] [params datum] [results datum] [instance datum] [export datum] [type datum]) -> datum
  (let ([f (cast (ptr func-record) (new-record func-kind (sizeof func-record)))])
    (set! (-> f name) (keep name))
    (set! (-> f params) (keep params))
    (set! (-> f results) (keep results))
    (set! (-> f instance) (keep instance))
    (set! (-> f export) (keep export))
    (set! (-> f type) type)
    (-> f self)))

(define (func-info? [d datum]) -> i32 (record? d func-kind))
(define (func-info-name [d datum]) -> datum (-> (func-of d) name))
(define (func-info-params [d datum]) -> datum (-> (func-of d) params))
(define (func-info-results [d datum]) -> datum (-> (func-of d) results))
(define (func-info-instance [d datum]) -> datum (-> (func-of d) instance))
(define (func-info-export [d datum]) -> datum (-> (func-of d) export))
(define (func-info-type [d datum]) -> datum (-> (func-of d) type))
(define (set-func-info-instance! [d datum] [v datum]) (set! (-> (func-of d) instance) (keep v)))
(define (set-func-info-export! [d datum] [v datum]) (set! (-> (func-of d) export) (keep v)))

(define (global-info [name datum] [type datum] [mutable datum] [instance datum] [export datum]) -> datum
  (let ([g (cast (ptr global-record) (new-record global-kind (sizeof global-record)))])
    (set! (-> g name) (keep name))
    (set! (-> g type) (keep type))
    (set! (-> g mutable) mutable)
    (set! (-> g instance) (keep instance))
    (set! (-> g export) (keep export))
    (-> g self)))

(define (global-info? [d datum]) -> i32 (record? d global-kind))
(define (global-info-name [d datum]) -> datum (-> (global-of d) name))
(define (global-info-type [d datum]) -> datum (-> (global-of d) type))
(define (global-info-mutable? [d datum]) -> datum (-> (global-of d) mutable))
(define (global-info-instance [d datum]) -> datum (-> (global-of d) instance))
(define (global-info-export [d datum]) -> datum (-> (global-of d) export))
(define (set-global-info-instance! [d datum] [v datum]) (set! (-> (global-of d) instance) (keep v)))
(define (set-global-info-export! [d datum] [v datum]) (set! (-> (global-of d) export) (keep v)))

(define (tag-info [name datum] [params datum] [instance datum] [export datum]) -> datum
  (let ([t (cast (ptr tag-record) (new-record tag-kind (sizeof tag-record)))])
    (set! (-> t name) (keep name))
    (set! (-> t params) (keep params))
    (set! (-> t instance) (keep instance))
    (set! (-> t export) (keep export))
    (-> t self)))

(define (tag-info? [d datum]) -> i32 (record? d tag-kind))
(define (tag-info-name [d datum]) -> datum (-> (tag-of d) name))
(define (tag-info-params [d datum]) -> datum (-> (tag-of d) params))
(define (tag-info-instance [d datum]) -> datum (-> (tag-of d) instance))
(define (tag-info-export [d datum]) -> datum (-> (tag-of d) export))
(define (set-tag-info-instance! [d datum] [v datum]) (set! (-> (tag-of d) instance) (keep v)))
(define (set-tag-info-export! [d datum] [v datum]) (set! (-> (tag-of d) export) (keep v)))

(define (data-info [name datum] [offset datum] [bytes datum]) -> datum
  (let ([d (cast (ptr data-record) (new-record data-kind (sizeof data-record)))])
    (set! (-> d name) (keep name))
    (set! (-> d offset) (keep offset))
    (set! (-> d bytes) (keep bytes))
    (-> d self)))

(define (data-info? [d datum]) -> i32 (record? d data-kind))
(define (data-info-name [d datum]) -> datum (-> (data-of d) name))
(define (data-info-offset [d datum]) -> datum (-> (data-of d) offset))
(define (data-info-bytes [d datum]) -> datum (-> (data-of d) bytes))

;; A declared type is a function type: its fields are its parameters and its results.
(define (make-type-info [name datum] [fields datum]) -> datum
  (let ([t (cast (ptr type-record) (new-record type-kind (sizeof type-record)))])
    (set! (-> t name) name)
    (set! (-> t fields) (keep fields))
    (set! (-> t identity) 0)
    (-> t self)))

(define (type-info? [d datum]) -> i32 (record? d type-kind))
(define (type-info-name [d datum]) -> datum (-> (type-of-info d) name))
(define (type-info-fields [d datum]) -> datum (-> (type-of-info d) fields))
(define (type-info-identity [d datum]) -> u32 (-> (type-of-info d) identity))
(define (set-type-info-fields! [d datum] [v datum]) (set! (-> (type-of-info d) fields) (keep v)))

;; A type is identified as wasm identifies it, by its structure: names are not part of it.

(define identity-count u32 0)
(define identities hash-table)

(define (identify-type! [t datum])
  (let* ([fields (type-info-fields t)]
         [form `(,(map (lambda ([v datum]) -> datum (canonical-valtype v)) (car fields))
                 ,(map (lambda ([v datum]) -> datum (canonical-valtype v)) (cadr fields)))]
         [id (datum-ref (& identities) form)])
    (when (== id 0)
      (+= identity-count 1)
      (set! id (make-integer identity-count))
      (datum-set! (& identities) form id))
    (set! (-> (type-of-info t) identity) (cast u32 (integer-value id)))))

(define (canonical-valtype [v datum]) -> datum
  (let ([h (if (ref-type? v) (ref-heap v) 0)])
    (cond [(not (type-info? h)) v]
          [(== (type-info-identity h) 0)
           (raise-compile-error 0 (format-message "internal: the type ~a has no identity yet" (cons (type-info-name h) nil)))
           0]
          [else `(ref ,(ref-nullable? v) (type ,(make-integer (type-info-identity h))))])))

(define (same-type? [a datum] [b datum]) -> i32
  (or (== a b)
      (let ([x (type-info-identity a)]) (and (!= x 0) (== x (type-info-identity b))))))

(define abstract-heaps datum `(func extern exn noexn))

(define (numeric-type? [t datum]) -> i32 (!= (memq t `(i32 i64 f32 f64)) 0))
(define (ref-type? [t datum]) -> i32 (and (pair? t) (== (car t) (sym ref))))
(define (make-ref [nullable datum] [heap datum]) -> datum `(ref ,nullable ,heap))
(define (ref-nullable? [t datum]) -> datum (cadr t))
(define (ref-heap [t datum]) -> datum (caddr t))

;; A declared function type is below func.
(define (heap<=? [a datum] [b datum]) -> i32
  (cond [(== a b) 1]
        [(and (type-info? a) (type-info? b) (same-type? a b)) 1]
        [(== a (sym noexn)) (== b (sym exn))]
        [(type-info? a) (== b (sym func))]
        [else 0]))

(define (heap-join [a datum] [b datum]) -> datum
  (cond [(heap<=? b a) a]
        [(heap<=? a b) b]
        [(type-info? a) (heap-join (sym func) b)]
        [else 0]))

(define (valtype<=? [a datum] [b datum]) -> i32
  (if (and (ref-type? a) (ref-type? b))
      (and (or (not (ref-nullable? a)) (ref-nullable? b)) (heap<=? (ref-heap a) (ref-heap b)))
      (== a b)))

(define (types<=? [as datum] [bs datum]) -> i32
  (unless (== (length as) (length bs)) (return 0))
  (while (pair? as)
    (unless (valtype<=? (car as) (car bs)) (return 0))
    (set! as (cdr as))
    (set! bs (cdr bs)))
  1)

(define (types=? [as datum] [bs datum]) -> i32 (and (types<=? as bs) (types<=? bs as)))

(define (valtype-join [a datum] [b datum]) -> datum
  (cond [(valtype<=? a b) b]
        [(valtype<=? b a) a]
        [(and (ref-type? a) (ref-type? b))
         (let ([h (heap-join (ref-heap a) (ref-heap b))])
           (if (== h 0) 0 (make-ref (boolean (or (ref-nullable? a) (ref-nullable? b))) h)))]
        [else 0]))

(define (defaultable? [t datum]) -> i32 (or (numeric-type? t) (and (ref-type? t) (!= (ref-nullable? t) 0))))

(define (valtype->string [t datum]) -> datum
  (cond [(symbol? t) (symbol->string t)]
        [(ref-type? t)
         (let ([h (ref-heap t)])
           (if (and (!= (ref-nullable? t) 0) (!= (memq h `(func extern exn)) 0))
               (format-message "~aref" (cons h nil))
               (format-message (if (!= (ref-nullable? t) 0) "(ref null ~a)" "(ref ~a)")
                               (cons (if (type-info? h) (type-info-name h) h) nil))))]
        [else (format-message "~a" (cons t nil))]))

(define key-counter i64 0)
(define (reset-keys!) (set! key-counter 0))
(define (fresh-key!) -> datum (+= key-counter 1) (make-integer key-counter))
