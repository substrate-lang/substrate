;; Lifecycle: permanent. Part of the compiler.
;;
;; Records and types shared by the expander and the compiler.
;;
;; The compiler's input is made of lists. The expander lowers fully expanded
;; code (spec 6.4) to it:
;;
;;  module forms:
;;    (func info ((key . type) ...) body)   (global info init-or-#f)
;;    (memory pages)   (table size)   (data dinfo)   (type tinfo)   (tag tginfo)   (expr e)
;;    (memory-import instance)   (table-import instance)
;;  expressions:
;;    (int n) (float x) (const type n)
;;    (lref key) (lset key e) (gref ginfo) (gset ginfo e)
;;    (let ((key type-or-#f init) ...) body)   (seq e ...)   (if c t e-or-#f)
;;    (block key body) (loop key body) (br key e-or-#f) (br-if key c) (return e-or-#f)
;;    (call finfo (arg ...))  (prim name offset-or-#f (arg ...))
;;    (call-indirect (param ...) (result ...) idx (arg ...))  (func-index finfo)
;;    (gc op (immediate ...) (arg ...))
;;    (select a b c) (drop e) (unreachable) (nop) (quote datum)
;;    (throw tginfo (arg ...))   (throw-ref e)
;;    (try ((kind tginfo-or-#f (key ...) body) ...) body), kind catch,
;;      catch-ref, catch-all or catch-all-ref, and key ... the variables
;;      the clause binds
;;
;; Local and label keys are integers. Functions, globals, data, types and tags are
;; referred to by their info records, which say which instance defines them.
;;
;; Value types are i32, i64, f32, f64, or (ref nullable? heap), where heap
;; is one of the abstract heap types (any eq i31 struct array func extern
;; exn none nofunc noextern noexn) or a type-info.
(require-unqualified substrate "../lib/substrate.sub")

(provide func-info func-info? func-info-name func-info-params func-info-results
         func-info-instance set-func-info-instance! func-info-export set-func-info-export! func-info-type
         global-info global-info? global-info-name global-info-type global-info-mutable?
         global-info-instance set-global-info-instance! global-info-export set-global-info-export!
         tag-info tag-info? tag-info-name tag-info-params tag-info-instance set-tag-info-instance!
         tag-info-export set-tag-info-export!
         data-info data-info? data-info-name data-info-offset data-info-bytes
         make-type-info type-info? type-info-name type-info-kind type-info-fields set-type-info-fields!
         type-info-super type-info-final? type-info-group set-type-info-group! type-info-identity
         identify-group! same-type? func-type?
         ref-type? make-ref ref-nullable? ref-heap abstract-heaps numeric-type?
         heap<=? valtype<=? types<=? types=? valtype-join valtype->string unpacked defaultable?
         closure-type closure-code box-type box-value-type
         fresh-key! reset-keys!)

;; instance: name of the instance that defines it, or #f while it is being
;; compiled. export: the export (or import field) name. type: its declared
;; function type (a type-info), or #f if it has only its signature.
(struct func-info (name params results [instance #:mutable] [export #:mutable] type))

(struct global-info (name type mutable? [instance #:mutable] [export #:mutable]))

;; A tag (spec 5.2): the types of its exceptions' values.
(struct tag-info (name params [instance #:mutable] [export #:mutable]))

;; An active data segment: bytes placed at offset in the module's memory.
(struct data-info (name offset bytes))

;; A declared type. kind is struct, array or func. A struct's fields are a
;; list of (name storage mutable?); an array's are one (storage mutable?);
;; a function type's are (params results).
;; storage is a value type, or i8 or i16. super: the declared supertype's
;; type-info, or #f. final?: whether other types may declare it as their
;; supertype. group: the type-infos of its recursion group in order, or
;; #f if it is alone in one. identity: the type it is, once its group is
;; declared (identify-group!); two declarations of the same type share it.
(struct type-info (name kind [fields #:mutable] super final? [group #:mutable] [identity #:mutable]))

(define (make-type-info name kind fields super final? group) (type-info name kind fields super final? group #f))

;; ---- type identity ----

;; A declared type is what wasm makes it (spec 5.1): its recursion group's
;; structure and its place in the group. Names, including field names, are
;; not part of it. A group's canonical form lists its members' kinds,
;; finality, supertypes and field or signature types, with a reference to a
;; member as (member i) and to another group's type as that type's
;; identity. Identical forms get the same identities, so two declarations
;; of one type, in any modules, are the same type.
(struct type-identity (id index))

(define identity-count 0)
(define identities (make-hash))    ; form -> vector of type-identity

;; Give the type-infos of a recursion group, in order, their identities.
(define (identify-group! members)
  (let* ([form (map (lambda (t) (canonical-type t members)) members)]
         [ids (or (hash-ref identities form #f)
                  (let ([v (list->vector
                            (map (lambda (i)
                                   (set! identity-count (+ identity-count 1))
                                   (type-identity identity-count i))
                                 (range (length members))))])
                    (hash-set! identities form v)
                    v))])
    (for-each (lambda (t i) (set-type-info-identity! t (vector-ref ids i))) members (range (length members)))))

(define (canonical-type t members)
  (letrec ([ref (lambda (u)
                  (let ([tail (memq u members)])
                    (if tail
                        (list 'member (- (length members) (length tail)))
                        (let ([x (type-info-identity u)])
                          (unless x (error 'canonical-type "a type outside the group has no identity yet: ~a"
                                           (type-info-name u)))
                          (list 'type (type-identity-id x))))))]
           [valtype (lambda (v)
                      (if (ref-type? v)
                          (list 'ref (ref-nullable? v) (let ([h (ref-heap v)]) (if (type-info? h) (ref h) h)))
                          v))]
           [storage (lambda (s) (if (memq s '(i8 i16)) s (valtype s)))])
    (let ([fields (type-info-fields t)])
      (list (type-info-kind t) (type-info-final? t)
            (and (type-info-super t) (ref (type-info-super t)))
            (case (type-info-kind t)
              [(struct) (map (lambda (f) (list (storage (cadr f)) (caddr f))) fields)]
              [(array) (list (storage (car fields)) (cadr fields))]
              [(func) (list (map valtype (car fields)) (map valtype (cadr fields)))])))))

;; Are a and b the same type?
(define (same-type? a b)
  (or (eq? a b)
      (let ([x (type-info-identity a)])
        (and x (eq? x (type-info-identity b))))))

;; ---- value types ----

(define abstract-heaps '(any eq i31 struct array func extern exn none nofunc noextern noexn))

(define (numeric-type? t) (memq t '(i32 i64 f32 f64)))
(define (ref-type? t) (and (pair? t) (eq? (car t) 'ref)))
(define (make-ref nullable? heap) (list 'ref nullable? heap))
(define (ref-nullable? t) (cadr t))
(define (ref-heap t) (caddr t))

;; A declared type is a subtype of itself, of the supertypes it names, and
;; of the abstract types above them. Declared types are compared by
;; identity: two declarations of the same type are one (spec 5.1).
(define (heap<=? a b)
  (cond [(eq? a b) #t]
        [(and (type-info? a) (type-info? b) (same-type? a b)) #t]
        [(eq? a 'none) (or (and (type-info? b) (not (func-type? b))) (memq b '(any eq i31 struct array)))]
        [(eq? a 'nofunc) (or (eq? b 'func) (and (type-info? b) (func-type? b)))]
        [(eq? a 'noexn) (eq? b 'exn)]
        [(eq? a 'noextern) (eq? b 'extern)]
        [(memq a '(i31 struct array)) (memq b '(eq any))]
        [(eq? a 'eq) (eq? b 'any)]
        ;; A declared function type is below func only: functions are not
        ;; in the any hierarchy.
        [(type-info? a)
         (or (and (not (func-type? a)) (memq b '(eq any)))
             (eq? b (type-info-kind a))
             (and (type-info-super a) (heap<=? (type-info-super a) b)))]
        [else #f]))

(define (func-type? t) (eq? (type-info-kind t) 'func))

;; The least heap type above both a and b.
(define (heap-join a b)
  (cond [(heap<=? b a) a]
        [(heap<=? a b) b]
        [(type-info? a) (heap-join (or (type-info-super a) (type-info-kind a)) b)]
        [(and (heap<=? a 'eq) (heap<=? b 'eq)) 'eq]
        [(and (heap<=? a 'any) (heap<=? b 'any)) 'any]
        [else #f]))

(define (valtype<=? a b)
  (cond [(and (ref-type? a) (ref-type? b))
         (and (or (not (ref-nullable? a)) (ref-nullable? b))
              (heap<=? (ref-heap a) (ref-heap b)))]
        [else (eq? a b)]))

(define (types<=? as bs)
  (and (= (length as) (length bs)) (andmap valtype<=? as bs)))

;; Are as and bs the same types? Two declarations of one type are (5.1).
(define (types=? as bs) (and (types<=? as bs) (types<=? bs as)))

;; The least type both a and b fit, or #f.
(define (valtype-join a b)
  (cond [(valtype<=? a b) b]
        [(valtype<=? b a) a]
        [(and (ref-type? a) (ref-type? b))
         (let ([h (heap-join (ref-heap a) (ref-heap b))])
           (and h (make-ref (or (ref-nullable? a) (ref-nullable? b)) h)))]
        [else #f]))

(define (unpacked storage) (if (memq storage '(i8 i16)) 'i32 storage))

;; ---- closures and boxes ----
;;
;; A function value of signature (t ... -> r ...) is a closure (spec 5.3): a
;; struct whose first field, code, is a function of the closure and the
;; parameters. The closure type and its code's type are one recursion
;; group, made once for each signature: two declarations of a signature's
;; closure type, in any modules, are one type (5.1). A lambda that
;; captures variables is of a final subtype with a field per variable,
;; which the compiler declares (compile.sub). A captured variable that is
;; also assigned lives in a box, a struct of one mutable field, one type
;; per value type.

(define closure-types (make-hash))     ; canonical signature -> (closure . code)
(define closure-codes (make-hasheq))   ; closure type-info -> its code type-info
(define box-types (make-hash))         ; canonical value type -> box type-info
(define box-infos (make-hasheq))       ; box type-info -> the type of its value

;; Value type t as a datum that names its identity: two types with one
;; canonical datum are one type.
(define (canonical-valtype t)
  (if (ref-type? t)
      (let ([h (ref-heap t)])
        (list 'ref (ref-nullable? t) (if (type-info? h) (type-identity-id (type-info-identity h)) h)))
      t))

;; The closure type of signature params -> results.
(define (closure-type params results)
  (let ([key (list (map canonical-valtype params) (map canonical-valtype results))])
    (or (hash-ref closure-types key #f)
        (let ([closure (make-type-info 'closure 'struct #f #f #f #f)]
              [code (make-type-info 'code 'func #f #f #t #f)])
          (set-type-info-fields! closure (list (list 'code (make-ref #f code) #f)))
          (set-type-info-fields! code (list (cons (make-ref #f closure) params) results))
          (set-type-info-group! closure (list closure code))
          (set-type-info-group! code (list closure code))
          (identify-group! (list closure code))
          (hash-set! closure-types key closure)
          (hash-set! closure-codes closure code)
          closure))))

;; The code type of closure type t, or of a closure type it is a subtype
;; of; #f if t is not one.
(define (closure-code t)
  (and (type-info? t)
       (or (hash-ref closure-codes t #f)
           (and (type-info-super t) (closure-code (type-info-super t))))))

;; The box type for values of type t.
(define (box-type t)
  (let ([key (canonical-valtype t)])
    (or (hash-ref box-types key #f)
        (let ([box (make-type-info 'box 'struct (list (list 'value t #t)) #f #t #f)])
          (identify-group! (list box))
          (hash-set! box-types key box)
          (hash-set! box-infos box t)
          box))))

;; The type of the values box type t holds, or #f if t is not a box type.
(define (box-value-type t) (and (type-info? t) (hash-ref box-infos t #f)))

;; Can a local or global of this type start without an explicit value?
(define (defaultable? t) (or (numeric-type? t) (and (ref-type? t) (ref-nullable? t))))

(define (valtype->string t)
  (cond [(symbol? t) (symbol->string t)]
        [(ref-type? t)
         (let ([h (ref-heap t)])
           (if (and (ref-nullable? t) (memq h '(any eq i31 struct array func extern exn)))
               (format "~aref" h)
               (format "(ref ~a~a)" (if (ref-nullable? t) "null " "")
                       (if (type-info? h) (type-info-name h) h))))]
        [else (format "~a" t)]))

(define key-counter 0)
(define (reset-keys!) (set! key-counter 0))
(define (fresh-key!) (set! key-counter (+ key-counter 1)) key-counter)
