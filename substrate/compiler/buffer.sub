;; Lifecycle: permanent. Part of the compiler.
;;
;; A growable byte buffer, where the wasm encoder and the serializer write
;; what stage0 writes to Chez's bytevector ports.
(require-unqualified substrate "../lib/substrate.sub")

(provide make-buffer buffer-size put-byte! put-bytes! uleb! sleb! buffer->bytes with-output)

(struct buffer ([data #:mutable] [size #:mutable]))

(define (make-buffer) (buffer (make-bytes 256 0) 0))

;; Room for n more bytes.
(define (reserve! b n)
  (let ([need (+ (buffer-size b) n)] [have (bytes-length (buffer-data b))])
    (when (> need have)
      (let ([bigger (make-bytes (max need (* 2 have)) 0)])
        (bytes-copy! bigger 0 (buffer-data b) 0 (buffer-size b))
        (set-buffer-data! b bigger)))))

(define (put-byte! b x)
  (reserve! b 1)
  (bytes-set! (buffer-data b) (buffer-size b) x)
  (set-buffer-size! b (+ (buffer-size b) 1)))

(define (put-bytes! b bs)
  (let ([n (bytes-length bs)])
    (reserve! b n)
    (bytes-copy! (buffer-data b) (buffer-size b) bs 0 n)
    (set-buffer-size! b (+ (buffer-size b) n))))

;; n, a non-negative integer, as unsigned LEB128.
(define (uleb! b n)
  (let ([x (bitwise-and n 127)] [rest (arithmetic-shift n -7)])
    (if (= rest 0)
        (put-byte! b x)
        (begin (put-byte! b (bitwise-ior x 128)) (uleb! b rest)))))

;; n as signed LEB128.
(define (sleb! b n)
  (let ([x (bitwise-and n 127)] [rest (arithmetic-shift n -7)])
    (if (or (and (= rest 0) (= 0 (bitwise-and x 64)))
            (and (= rest -1) (not (= 0 (bitwise-and x 64)))))
        (put-byte! b x)
        (begin (put-byte! b (bitwise-ior x 128)) (sleb! b rest)))))

(define (buffer->bytes b) (subbytes (buffer-data b) 0 (buffer-size b)))

;; The bytes proc writes to a new buffer.
(define (with-output proc)
  (let ([b (make-buffer)])
    (proc b)
    (buffer->bytes b)))
