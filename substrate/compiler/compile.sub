;; Lifecycle: permanent. Part of the compiler.
;;
;; Compiler: fully expanded kernel forms (see core.sub) -> wasm module bytes.
;;
;; Expressions are assembled as they are compiled (wasm.sub), an
;; instruction at a time; an index, known only once every import, type
;; and synthesized global is, is a deferred field, written when the code
;; is linked. Compiling an expression emits its code and gives its type.
;;
;; A module imports only what its code uses (spec 3.3). Code that needs a
;; memory or table must be given one: defined, or imported from a module.
(require-unqualified substrate "../lib/substrate.sub")
(require stx "stx.sub" raise-compile-error srcloc? srcloc-source srcloc-line srcloc-col)
(require core "core.sub"
         func-info func-info? func-info-name func-info-params func-info-results func-info-instance
         set-func-info-instance! func-info-export set-func-info-export! func-info-type
         global-info? global-info-name global-info-type global-info-mutable? global-info-instance
         set-global-info-instance! global-info-export set-global-info-export!
         tag-info-name tag-info-params tag-info-instance set-tag-info-instance! tag-info-export set-tag-info-export!
         data-info-offset data-info-bytes
         make-type-info type-info? type-info-name type-info-kind type-info-fields type-info-super type-info-final?
         type-info-group func-type?
         ref-type? make-ref ref-nullable? ref-heap numeric-type?
         valtype<=? types<=? valtype-join valtype->string unpacked defaultable?
         closure-type closure-code box-type box-value-type identify-group!)
(require cl "closures.sub" analyze-closures closures-boxed? closures-known-of closures-captures-of head-local
         known-lambda known-captures known-info set-known-info! known-name known-lifted set-known-lifted!)
(require ops "ops.sub" lookup-prim prim-op-kind prim-op-params prim-op-results prim-op-align)
(require w "wasm.sub" wmodule encode-module new-asm asm-size instr! link-body cell cell? cell-value set-cell-value!)
(require ser "serialize.sub" make-serializer serialize! serializer-bytes serializer-scope-table)
(require num "numbers.sub" integer->flonum i32-bits i64-bits)

(provide compile-module set-syntax-lookup! set-syntax-types! set-current-source!)

;; (kind name) -> the kernel module's definition of that kind, or #f; the
;; function itself is #f while the kernel module is compiled.
(define syntax-lookup #f)
(define (set-syntax-lookup! f) (set! syntax-lookup f))

;; The kernel module's string and table types, set once the module is
;; compiled. A module's quoted data is a string of bytes that the kernel
;; turns into a table of objects (spec 3.5), so a module that quotes data
;; declares the kernel's recursion group, and wasm makes these the
;; kernel's types (spec appendix A).
(define string-type #f)
(define table-type #f)
(define (set-syntax-types! string table) (set! string-type string) (set! table-type table))

(define eqref (make-ref #t 'eq))
(define exnref (make-ref #t 'exn))

;; ---- error locations ----

(define current-loc #f)

;; The file of the module being compiled, as its source locations name it
;; (a symbol), or #f. A location in another file, in what a macro from
;; another module introduced, gives way to an enclosing one in this file,
;; if there is one (spec 3.6).
(define current-source #f)
(define (set-current-source! s) (set! current-source s))
(define (fail form . args) (apply raise-compile-error current-loc form args))

;; ---- types ----

(define (type->string t)
  (cond [(eq? t 'bottom) "nothing (unreachable)"]
        [(null? t) "no value"]
        [(null? (cdr t)) (valtype->string (car t))]
        [else (format "(~a)" (apply string-append
                                    (let loop ([ts t])
                                      (if (null? ts) '()
                                          (cons (valtype->string (car ts))
                                                (if (null? (cdr ts)) '() (cons " " (loop (cdr ts)))))))))]))

(define (single? t) (and (pair? t) (null? (cdr t))))

;; Make the code just emitted, of type `type`, fit `expected`: drop unused
;; values, or fail. A subtype fits without any code. Returns the type the
;; code has then.
(define (fit fc type expected)
  (cond [(not expected) type]
        [(eq? type 'bottom) expected]
        [(types<=? type expected) expected]
        [(null? expected) (for-each (lambda (_) (emit! fc '(drop))) type) '()]
        [else
         (let ([e (type->string expected)] [g (type->string type)])
           ;; Two declarations can have the same name, for example one in
           ;; each module (spec 5.1).
           (fail "type mismatch: expected ~a, got ~a~a" e g
                 (if (string=? e g) ", a different type declared with the same name" "")))]))

(define (join-types a b)
  (cond [(eq? a 'bottom) b]
        [(eq? b 'bottom) a]
        [(= (length a) (length b))
         (let ([j (map valtype-join a b)])
           (and (andmap (lambda (x) x) j) j))]
        [else #f]))

;; Is lowered expression e a literal alone?
(define (bare-literal? e)
  (case (car e)
    [(at) (bare-literal? (caddr e))]
    [(int float) #t]
    [else #f]))

;; The constant instruction for the literal (int n) or (float x) at type
;; t, with the type it has: an integer takes any numeric type, a float
;; f32 or f64.
(define (literal-instr lit t)
  (let ([n (cadr lit)])
    (if (eq? (car lit) 'int)
        (cons (case t
                [(i64) (list 'i64.const (s64 n))]
                [(f32) (list 'f32.const (integer->flonum n))]
                [(f64) (list 'f64.const (integer->flonum n))]
                [else (list 'i32.const (s32 n))])
              (if (memq t '(i64 f32 f64)) t 'i32))
        (if (eq? t 'f32)
            (cons (list 'f32.const n) 'f32)
            (cons (list 'f64.const n) 'f64)))))

;; The branches es, of an if or a try, each compiled by (compile i e
;; expected) in its place, as their types. Without an expected type, a
;; branch takes the numeric type of a branch compiled before it, so that
;; literals take the others' type, as in (if c 0 x) with x an i64: a
;; branch that is a literal alone, compiled before any has given a type,
;; emits its constant deferred, in a cell the literal takes
;; (deferred-literal), settled once the branches have.
(define deferred-literal #f)

(define (compile-branches es compile expected)
  (let* ([known expected]
         [types (map (lambda (i e)
                       (if (and (not known) (bare-literal? e))
                           (let ([c (cell #f)])
                             (set! deferred-literal c)
                             (compile i e #f)
                             (set! deferred-literal #f)
                             c)
                           (let ([t (compile i e known)])
                             (when (and (not known) (pair? t) (andmap numeric-type? t)) (set! known t))
                             t)))
                     (range (length es)) es)])
    (map (lambda (t)
           (if (cell? t)
               (let ([r (literal-instr (cell-value t) (if (single? known) (car known) #f))])
                 (set-cell-value! t (car r))
                 (list (cdr r)))
               t))
         types)))

(define (s32 n) (or (i32-bits n) (fail "integer ~a does not fit in i32" n)))
(define (s64 n) (i64-bits n))

;; ---- per-function state ----

(struct fctx (locals              ; hasheqv: key -> (index . type)
              [extra #:mutable]   ; types of locals after the params, reversed
              [next #:mutable]    ; next local index
              results             ; the function's result types
              [analysis #:mutable] ; what closures.sub decided of the function, or #f
              asm))               ; its code, assembled (wasm.sub)

(define (new-fctx params results)
  (let ([fc (fctx (make-hasheqv) '() 0 results #f (new-asm))])
    (for-each (lambda (p) (add-local! fc (car p) (cdr p))) params)
    (set-fctx-extra! fc '())
    fc))

;; Instruction i, assembled into the function's code.
(define (emit! fc i) (instr! (fctx-asm fc) i))

(define (add-local! fc key type)
  (note-type! current-ms type)
  (let ([i (fctx-next fc)])
    (hash-set! (fctx-locals fc) key (cons i type))
    (set-fctx-extra! fc (cons type (fctx-extra fc)))
    (set-fctx-next! fc (+ i 1))
    i))

;; Keys of locals the compiler makes: negative, unlike the expander's.
(define temp-counter 0)
(define (temp-local! fc type)
  (set! temp-counter (- temp-counter 1))
  (add-local! fc temp-counter type))

(define (lookup-local fc key)
  (or (hash-ref (fctx-locals fc) key #f)
      (fail "internal: unknown local ~a in ~a" key compiling)))

;; The name of the function being compiled, for internal errors.
(define compiling #f)

;; kind: block | loop | if. type: the block's result type once known.
(struct label (key kind [type #:mutable]))

;; (depth . label) of the label with key.
(define (label-depth labels key)
  (let loop ([ls labels] [d 0])
    (cond [(null? ls) (fail "internal: unknown label ~a" key)]
          [(eqv? (label-key (car ls)) key) (cons d (car ls))]
          [else (loop (cdr ls) (+ d 1))])))

;; ---- module state ----

;; A synthesized global: a function's table index (kind fidx), or the
;; table of quoted data (kind literals).
(struct synth (kind datum))

(struct mstate (self
                [func-imports #:mutable]   ; external func-infos, reversed
                [global-imports #:mutable] ; external global-infos, reversed
                [tag-imports #:mutable]    ; external tag-infos, reversed
                [synths #:mutable]         ; synth records, reversed
                [fidx #:mutable]           ; alist func-info -> synth
                [uses-memory #:mutable]    ; where code first needs a memory, or #f
                [uses-table #:mutable]     ; where code first needs a table, or #f
                [uses-gc #:mutable]        ; does code allocate or inspect GC objects?
                [literals #:mutable]       ; the quoted data, or #f
                [pending #:mutable]        ; the functions lifted from lambdas, to compile, reversed
                namer                      ; gives export names
                [fname #:mutable]          ; the name of the function being compiled
                [types #:mutable]          ; the declared types the code uses, reversed
                noted                      ; and as a set
                imported))                 ; the external infos noted so far, as a set

(define (external? ms info-instance) (not (equal? info-instance (mstate-self ms))))

;; An external definition the code uses is imported, once.
(define (new-import? ms info)
  (and (not (hash-ref (mstate-imported ms) info #f))
       (begin (hash-set! (mstate-imported ms) info #t) #t)))

(define (note-func! ms info)
  (when (and (external? ms (func-info-instance info)) (new-import? ms info))
    (set-mstate-func-imports! ms (cons info (mstate-func-imports ms)))))

(define (note-global! ms info)
  (when (and (global-info? info) (external? ms (global-info-instance info)) (new-import? ms info))
    (set-mstate-global-imports! ms (cons info (mstate-global-imports ms)))))

(define (note-tag! ms info)
  (when (and (external? ms (tag-info-instance info)) (new-import? ms info))
    (set-mstate-tag-imports! ms (cons info (mstate-tag-imports ms)))))

;; The code uses declared type t, or a reference type to one: the module
;; declares it (collect-types).
(define (note-type! ms t)
  (let ([t (if (ref-type? t) (ref-heap t) t)])
    (when (and (type-info? t) (not (hash-ref (mstate-noted ms) t #f)))
      (hash-set! (mstate-noted ms) t #t)
      (set-mstate-types! ms (cons t (mstate-types ms))))))

(define (note-memory! ms) (unless (mstate-uses-memory ms) (set-mstate-uses-memory! ms (or current-loc #t))))
(define (note-table! ms) (unless (mstate-uses-table ms) (set-mstate-uses-table! ms (or current-loc #t))))

(define (new-synth! ms kind datum)
  (let ([s (synth kind datum)])
    (set-mstate-synths! ms (cons s (mstate-synths ms)))
    s))

(define (fidx-synth! ms info)
  (note-table! ms)
  (let ([found (assq info (mstate-fidx ms))])
    (if found
        (cdr found)
        (let ([s (new-synth! ms 'fidx info)])
          (note-func! ms info)
          (set-mstate-fidx! ms (cons (cons info s) (mstate-fidx ms)))
          s))))

;; ---- closures ----
;;
;; A lambda is a closure (core.sub): its code is lifted, a function of the
;; closure and the lambda's parameters, compiled after the function it is
;; in (pending), and the lambda itself makes the struct, with the values
;; of the variables it captures in its fields. What closures.sub decided
;; of the function is in its fctx: a boxed variable's local holds its box,
;; which a read or an assignment goes through and its binder makes; a
;; known function's calls are direct calls of its lifted code, given the
;; variables it captures after the arguments.

(define (boxed? fc key) (let ([a (fctx-analysis fc)]) (and a (closures-boxed? a key))))
(define (known-of fc key) (let ([a (fctx-analysis fc)]) (and a (closures-known-of a key))))

;; Put local key, of type type, in a new box, in a new local that key
;; names from now on.
(define (box-local! fc key type)
  (let* ([old (car (lookup-local fc key))] [box (box-type type)] [new (add-local! fc key (make-ref #f box))])
    (emit! fc (list 'local.get old))
    (emit! fc (list 'struct.new box))
    (emit! fc (list 'local.set new))))

;; Box the boxed parameters among params, each (key . type).
(define (box-params! fc params)
  (for-each (lambda (p) (when (boxed? fc (car p)) (box-local! fc (car p) (cdr p)))) params))

;; A function lifted from a lambda, named after the function it is in:
;; its info, given its parameter and result types and its declared type.
(define (lifted-info ms base params results type)
  (let ([name (string->symbol (format "~a.~a" (mstate-fname ms) base))])
    (func-info name params results (mstate-self ms) ((mstate-namer ms) name) type)))

;; A lifted function to compile: its info, its parameters, each (key .
;; type), the lambda's own among them, its body, the analysis of the
;; function it was in, and, for a closure's code, the closure's type and
;; its captures, each (key . type), which the code reads from the
;; closure's fields.
(define (lift! ms info params own body analysis csub captures)
  (set-mstate-pending! ms (cons (list info params own body analysis csub captures) (mstate-pending ms))))

;; The function of known function k, made when first called or defined:
;; it takes the lambda's parameters, then the variables it captures.
(define (known-info! ms fc k)
  (or (known-info k)
      (let* ([node (known-lambda k)]
             [captures (map (lambda (key) (cons key (cdr (lookup-local fc key)))) (known-captures k))]
             [info (lifted-info ms (known-name k) (append (map cdr (caddr node)) (map cdr captures)) (cadddr node) #f)])
        (set-known-info! k info)
        info)))

;; Known function k's code, lifted where its lambda is.
(define (lift-known! ms fc k)
  (let ([info (known-info! ms fc k)] [node (known-lambda k)])
    (unless (known-lifted k)
      (set-known-lifted! k #t)
      (lift! ms info (append (caddr node) (map (lambda (key) (cons key (cdr (lookup-local fc key)))) (known-captures k)))
             (caddr node) (list 'at current-loc (list-ref node 4)) (fctx-analysis fc) #f '()))))

;; The type of a closure of closure type closure with captures of types
;; types: a final subtype with a field per capture.
(define (capture-type closure types)
  (let ([t (make-type-info 'closure 'struct
                           (cons (list 'code (make-ref #f (closure-code closure)) #f)
                                 (map (lambda (ct i) (list (string->symbol (format "v~a" i)) ct #f)) types (range (length types))))
                           closure #t #f)])
    (identify-group! (list t))
    t))

;; ---- expressions ----

;; A function of the kernel module, by name. While compiling the kernel
;; module itself, its own functions are found with `local`.
(define (syntax-func ms local name)
  (let ([info (if syntax-lookup (syntax-lookup 'func name) (local name))])
    (unless info (fail "internal: the kernel module has no function ~a" name))
    (note-func! ms info)
    info))

;; The kernel module's immutable global holding datum d, when d is '() or
;; #t and another module is being compiled; else #f. Reading it is a
;; constant expression.
(define (datum-global d)
  (and syntax-lookup
       (or (null? d) (eq? d #t))
       (let ([info (syntax-lookup 'global (if (null? d) '%nil '%true))])
         (unless (global-info? info) (fail "internal: the kernel module has no global for ~s" d))
         info)))

(define (struct-field tinfo index) (list-ref (type-info-fields tinfo) index))

;; e compiled, its value made to fit type.
(define (code-of ms fc labels e type) (cx ms fc labels e (list type) #f))

;; The location pseudo-instruction for srcloc loc, or for no location.
(define (location-marker loc)
  (if (srcloc? loc)
      (list 'location (symbol->string (srcloc-source loc)) (srcloc-line loc) (srcloc-col loc))
      (list 'location #f 0 0)))

;; args compiled, each to fit its type in types.
(define (args-code ms fc labels args types)
  (unless (= (length args) (length types))
    (fail "expected ~a arguments, got ~a" (length types) (length args)))
  (for-each (lambda (a t) (code-of ms fc labels a t)) args types))

;; Reference expression e compiled: its type, a reftype.
(define (ref-arg ms fc labels e who)
  (let ([t (cx ms fc labels e #f #f)])
    (unless (and (single? t) (ref-type? (car t)))
      (fail "~a needs a reference, got ~a" who (type->string t)))
    (car t)))

(define (blocktype t)
  (cond [(null? t) '()]
        [(single? t) (car t)]
        [else (list 'type (list 'func '() t))]))

;; The tail-call instruction for call instruction op.
(define (tail-call-op op)
  (case op [(call) 'return_call] [(call_indirect) 'return_call_indirect] [else 'return_call_ref]))

;; GC operations (spec 5.3). imms hold type-infos, field indices and
;; reference types resolved by the expander.
(define (compile-gc ms fc labels op imms args expected)
  (let* ([tref (lambda (t) (make-ref #t t))]
         [element (lambda (t) (unpacked (car (type-info-fields t))))]
         [op! (lambda (i) (emit! fc i))]
         [done (lambda (type) (fit fc type expected))]
         ;; The arguments compiled at types, then instruction i, whose
         ;; value is of type result.
         [gc! (lambda (types i result) (args-code ms fc labels args types) (op! i) (done result))])
    (for-each (lambda (i) (note-type! ms i)) imms)
    (case op
      [(struct.new)
       (let ([t (car imms)])
         (gc! (map (lambda (f) (unpacked (cadr f))) (type-info-fields t)) (list 'struct.new t) (list (make-ref #f t))))]
      [(struct.get struct.get_s struct.get_u)
       (let* ([t (car imms)] [i (cadr imms)] [f (struct-field t i)] [packed? (memq (cadr f) '(i8 i16))])
         (when (and packed? (eq? op 'struct.get))
           (fail "field ~a is packed: use struct.get_s or struct.get_u" (car f)))
         (when (and (not packed?) (not (eq? op 'struct.get)))
           (fail "~a is only for packed fields" op))
         (gc! (list (tref t)) (list op t i) (list (unpacked (cadr f)))))]
      [(struct.set)
       (let* ([t (car imms)] [i (cadr imms)] [f (struct-field t i)])
         (unless (caddr f) (fail "field ~a is not mutable" (car f)))
         (gc! (list (tref t) (unpacked (cadr f))) (list 'struct.set t i) '()))]
      [(array.new) (let ([t (car imms)]) (gc! (list (element t) 'i32) (list 'array.new t) (list (make-ref #f t))))]
      [(array.new_default) (let ([t (car imms)]) (gc! '(i32) (list 'array.new_default t) (list (make-ref #f t))))]
      [(array.new_fixed)
       (let ([t (car imms)])
         (gc! (map (lambda (a) (element t)) args) (list 'array.new_fixed t (length args)) (list (make-ref #f t))))]
      [(array.get array.get_s array.get_u)
       (let* ([t (car imms)] [storage (car (type-info-fields t))] [packed? (memq storage '(i8 i16))])
         (when (and packed? (eq? op 'array.get))
           (fail "~a has packed elements: use array.get_s or array.get_u" (type-info-name t)))
         (when (and (not packed?) (not (eq? op 'array.get)))
           (fail "~a is only for packed elements" op))
         (gc! (list (tref t) 'i32) (list op t) (list (unpacked storage))))]
      [(array.set)
       (let ([t (car imms)])
         (unless (cadr (type-info-fields t)) (fail "~a is not mutable" (type-info-name t)))
         (gc! (list (tref t) 'i32 (element t)) (list 'array.set t) '()))]
      [(array.len) (gc! (list (make-ref #t 'array)) '(array.len) '(i32))]
      [(array.fill) (let ([t (car imms)]) (gc! (list (tref t) 'i32 (element t) 'i32) (list 'array.fill t) '()))]
      [(array.copy)
       (let ([dst (car imms)] [src (cadr imms)])
         (gc! (list (tref dst) 'i32 (tref src) 'i32 'i32) (list 'array.copy dst src) '()))]
      [(ref.null) (gc! '() (list 'ref.null (car imms)) (list (make-ref #t (car imms))))]
      [(ref.is_null)
       (ref-arg ms fc labels (car args) "ref.is_null")
       (op! '(ref.is_null))
       (done '(i32))]
      [(ref.eq) (gc! (list eqref eqref) '(ref.eq) '(i32))]
      [(ref.as_non_null)
       (let ([r (ref-arg ms fc labels (car args) "ref.as_non_null")])
         (op! '(ref.as_non_null))
         (done (list (make-ref #f (ref-heap r)))))]
      [(ref.test ref.cast)
       (let ([target (car imms)])
         (ref-arg ms fc labels (car args) (symbol->string op))
         (op! (list (if (ref-nullable? target) (if (eq? op 'ref.test) 'ref.test-null 'ref.cast-null) op) (ref-heap target)))
         (done (if (eq? op 'ref.test) '(i32) (list target))))]
      [(ref.i31) (gc! '(i32) '(ref.i31) (list (make-ref #f 'i31)))]
      [(i31.get_s i31.get_u) (gc! (list (make-ref #t 'i31)) (list op) '(i32))]
      [else (fail "internal: unknown GC operation ~a" op)])))

;; (try clauses body) (spec 5.3). The body is in a try_table whose catches
;; branch to a block per clause; after its block, a clause sets its
;; variables to the values the block received, and runs. The body and each
;; clause end the try's own block:
;;
;;   block T
;;     block P_n ... block P_1
;;           try_table T (catch ... 0) ... (catch ... n-1)  body  end
;;           br n
;;         end  clause 1  br n-1
;;       ...
;;     end  clause n
;;   end
;;
;; A call in the body is not a tail call, which would leave the try.
(define (compile-try ms fc labels clauses body expected tail?)
  (let* ([n (length clauses)]
         [blocks (map (lambda (c) (label #f 'block #f)) clauses)]
         [outer (cons (label #f 'block #f) labels)]
         ;; The values each clause's block receives.
         [payloads (map (lambda (c)
                          (append (if (cadr c) (tag-info-params (cadr c)) '())
                                  (if (memq (car c) '(catch-ref catch-all-ref)) (list exnref) '())))
                        clauses)]
         [tcell (cell '())]
         [catches (map (lambda (c i)
                         (when (cadr c) (note-tag! ms (cadr c)))
                         (case (car c)
                           [(catch) (list 'catch (cadr c) i)]
                           [(catch-ref) (list 'catch_ref (cadr c) i)]
                           [(catch-all) (list 'catch_all i)]
                           [else (list 'catch_all_ref i)]))
                       clauses (range n))])
    (emit! fc (list 'block tcell))
    (for-each (lambda (p) (emit! fc (list 'block (blocktype p)))) (reverse payloads))
    (emit! fc (list 'try_table tcell catches))
    (let* ([ts (compile-branches
                (cons body (map cadddr clauses))
                (lambda (i e expected)
                  (if (= i 0)
                      (let ([t (cx ms fc (cons (label #f 'block #f) (append blocks outer)) e expected #f)])
                        (emit! fc '(end))
                        (emit! fc (list 'br n))
                        (emit! fc '(end))
                        t)
                      (let ([c (list-ref clauses (- i 1))] [p (list-ref payloads (- i 1))])
                        (for-each (lambda (key t) (add-local! fc key t)) (caddr c) p)
                        ;; The values, the last on the stack first.
                        (for-each (lambda (key) (emit! fc (list 'local.set (car (lookup-local fc key))))) (reverse (caddr c)))
                        (box-params! fc (map cons (caddr c) p))
                        (let ([t (cx ms fc (append (list-tail blocks i) outer) e expected tail?)])
                          (when (< i n) (emit! fc (list 'br (- n i))))
                          (emit! fc '(end))
                          t))))
                expected)]
           [t (or expected
                  (foldl (lambda (bt t) (and t (join-types t bt))) 'bottom ts)
                  (fail "the body and the clauses of try have different types: ~a"
                        (apply string-append (map (lambda (bt) (format " ~a" (type->string bt))) ts))))]
           [t (if (eq? t 'bottom) '() t)])
      (set-cell-value! tcell (blocktype t))
      t)))

;; Compile e, emitting its code. expected: #f or a list of valtypes.
;; tail?: e's value is the function's return value. Returns e's type.
(define (cx ms fc labels e expected tail?)
  (let* ([sub (lambda (e expected tail?) (cx ms fc labels e expected tail?))]
         [sub-in (lambda (labels e expected tail?) (cx ms fc labels e expected tail?))]
         [code-of (lambda (e type) (code-of ms fc labels e type))]
         [op! (lambda (i) (emit! fc i))]
         [done (lambda (type) (fit fc type expected))]
         ;; A call, instruction i, of a function returning results: a tail
         ;; call if it is the function's return value and the results fit.
         [call! (lambda (i results)
                  (if (and tail? (types<=? results (fctx-results fc)))
                      (begin (op! (cons (tail-call-op (car i)) (cdr i))) results)
                      (begin (op! i) (done results))))]
         [args (cdr e)])
    (case (car e)
      ;; (at loc e): e's code, at source location loc. The pseudo-instruction
      ;; (location file line col) says where the code after it comes from,
      ;; and after e's code the enclosing location resumes (spec 3.6).
      [(at)
       (let* ([saved current-loc]
              [given (car args)]
              [loc (cond [(not given) saved]
                         [(eq? (srcloc-source given) current-source) given]
                         [else (or saved given)])])
         (set! current-loc loc)
         (unless (eq? loc saved) (op! (location-marker loc)))
         (let ([t (sub (cadr args) expected tail?)])
           (set! current-loc saved)
           (unless (eq? loc saved) (op! (location-marker saved)))
           t))]
      ;; (as types e): e at types, which it must fit: an inlined call's body
      ;; at the function's result types (spec 5.2).
      [(as) (done (sub (cadr args) (car args) tail?))]
      ;; A literal alone in a branch may be deferred (compile-branches).
      [(int float)
       (if (and (not expected) deferred-literal)
           (let ([c deferred-literal])
             (set-cell-value! c e)
             (set! deferred-literal #f)
             (op! (list 'const-deferred c))
             '(i32))
           (let ([r (literal-instr e (cond [(eq? (car e) 'float) (if (equal? expected '(f32)) 'f32 'f64)]
                                           [(single? expected) (car expected)]
                                           [else 'i32]))])
             (op! (car r))
             (done (list (cdr r)))))]
      [(const)
       (let ([t (car args)] [n (cadr args)])
         (op! (case t
                [(i32) (list 'i32.const (s32 n))]
                [(i64) (list 'i64.const (s64 n))]
                [else (list (const-op t) n)]))
         (done (list t)))]
      [(lref)
       (let* ([l (lookup-local fc (car args))] [box (and (boxed? fc (car args)) (ref-heap (cdr l)))])
         (op! (list 'local.get (car l)))
         (if box
             (begin (op! (list 'struct.get box 0)) (done (list (box-value-type box))))
             (done (list (cdr l)))))]
      [(lset)
       (let ([k (known-of fc (car args))])
         (cond [k (lift-known! ms fc k) (done '())]
               [else
                (let* ([l (lookup-local fc (car args))] [box (and (boxed? fc (car args)) (ref-heap (cdr l)))])
                  (if box
                      (begin (op! (list 'local.get (car l)))
                             (code-of (cadr args) (box-value-type box))
                             (op! (list 'struct.set box 0)))
                      (begin (code-of (cadr args) (cdr l))
                             (op! (list 'local.set (car l)))))
                  (done '()))]))]
      [(gref)
       (let ([info (car args)])
         (note-global! ms info)
         (op! (list 'global.get info))
         (done (list (global-info-type info))))]
      [(gset)
       (let ([info (car args)])
         (unless (global-info-mutable? info)
           (fail "~a is immutable: declare it (global ~a (mut type) init) to set it"
                 (global-info-name info) (global-info-name info)))
         (note-global! ms info)
         (code-of (cadr args) (global-info-type info))
         (op! (list 'global.set info))
         (done '()))]
      [(let)
       (for-each (lambda (b)
                   (let* ([key (car b)] [declared (cadr b)] [init (caddr b)] [k (known-of fc key)])
                     ;; A known function has no local: its lambda is its code,
                     ;; lifted once every variable of the let is bound, since
                     ;; it may capture one bound after it.
                     (unless k
                       (let ([t (sub init (and declared (list declared)) #f)])
                         (unless (single? t)
                           (fail "a let binding needs a single value, got ~a~a" (type->string t)
                                 (if (eq? t 'bottom) "; give it a type" "")))
                         (if (boxed? fc key)
                             (let* ([box (box-type (car t))] [i (add-local! fc key (make-ref #f box))])
                               (op! (list 'struct.new box))
                               (op! (list 'local.set i)))
                             (op! (list 'local.set (add-local! fc key (car t)))))))))
                 (car args))
       (for-each (lambda (b) (let ([k (known-of fc (car b))]) (when k (lift-known! ms fc k)))) (car args))
       (sub (cadr args) expected tail?)]
      [(seq)
       (if (null? args)
           (done '())
           (let loop ([es args])
             (if (null? (cdr es))
                 (sub (car es) expected tail?)
                 (begin (sub (car es) '() #f) (loop (cdr es))))))]
      [(if)
       (let* ([test (car args)] [then (cadr args)] [els (caddr args)]
              [lbls (cons (label #f 'if #f) labels)]
              [c (cell '())])
         (sub test '(i32) #f)
         (op! (list 'if c))
         (if (not els)
             (begin (sub-in lbls then '() #f)
                    (op! '(end))
                    (done '()))
             (let* ([ts (compile-branches (list then els)
                                          (lambda (i e expected)
                                            (when (= i 1) (op! '(else)))
                                            (sub-in lbls e expected tail?))
                                          expected)]
                    [t1 (car ts)] [t2 (cadr ts)]
                    [t (or expected
                           (join-types t1 t2)
                           (fail "the branches of if have different types: ~a and ~a"
                                 (type->string t1) (type->string t2)))]
                    [t (if (eq? t 'bottom) '() t)])
               (op! '(end))
               (set-cell-value! c (blocktype t))
               t)))]
      [(block)
       (let* ([lbl (label (car args) 'block expected)] [c (cell '())])
         (op! (list 'block c))
         (let* ([t (sub-in (cons lbl labels) (cadr args) expected tail?)]
                [t (cond [(not (eq? t 'bottom))
                          (when (and (label-type lbl) (not (types<=? t (label-type lbl))))
                            (fail "block result is ~a but a br carries ~a"
                                  (type->string t) (type->string (label-type lbl))))
                          (or (label-type lbl) t)]
                         [(label-type lbl) (label-type lbl)]
                         [else '()])])
           (op! '(end))
           (set-cell-value! c (blocktype t))
           t))]
      [(loop)
       (let* ([lbl (label (car args) 'loop '())] [c (cell '())])
         (op! (list 'loop c))
         (let* ([t (sub-in (cons lbl labels) (cadr args) expected tail?)]
                [t (if (eq? t 'bottom) (or expected '()) t)])
           (op! '(end))
           (set-cell-value! c (blocktype t))
           t))]
      [(br)
       (let* ([dl (label-depth labels (car args))] [depth (car dl)] [lbl (cdr dl)] [v (cadr args)])
         (if (eq? (label-kind lbl) 'loop)
             (begin
               (when v (fail "br to a loop label cannot carry a value"))
               (op! (list 'br depth))
               'bottom)
             (let ([t (if v (sub v (label-type lbl) #f) '())])
               (cond [(not (label-type lbl)) (set-label-type! lbl t)]
                     [(not (types<=? t (label-type lbl)))
                      (fail "br carries ~a but the block produces ~a"
                            (type->string t) (type->string (label-type lbl)))])
               (op! (list 'br depth))
               'bottom)))]
      [(br-if)
       (let* ([dl (label-depth labels (car args))] [depth (car dl)] [lbl (cdr dl)])
         (sub (cadr args) '(i32) #f)
         (unless (eq? (label-kind lbl) 'loop)
           (cond [(not (label-type lbl)) (set-label-type! lbl '())]
                 [(not (null? (label-type lbl)))
                  (fail "br-if cannot exit a block that produces ~a" (type->string (label-type lbl)))]))
         (op! (list 'br_if depth))
         (done '()))]
      [(return)
       (let ([v (car args)])
         (when v (sub v (fctx-results fc) #t))
         (unless (or v (null? (fctx-results fc)))
           (fail "return needs a value of type ~a" (type->string (fctx-results fc))))
         (op! '(return))
         'bottom)]
      [(call)
       (let ([info (car args)])
         (note-func! ms info)
         (args-code ms fc labels (cadr args) (func-info-params info))
         (call! (list 'call info) (func-info-results info)))]
      [(prim)
       (let* ([name (car args)] [offset (cadr args)] [p (lookup-prim name)])
         (when (or (eq? (prim-op-kind p) 'mem) (memq name '(memory.size memory.grow memory.copy memory.fill)))
           (note-memory! ms))
         (args-code ms fc labels (caddr args) (prim-op-params p))
         (op! (if (eq? (prim-op-kind p) 'mem)
                  (list name (prim-op-align p) (or offset 0))
                  (list name)))
         (done (prim-op-results p)))]
      [(call-indirect)
       (note-table! ms)
       (for-each (lambda (t) (note-type! ms t)) (append (car args) (cadr args)))
       (let ([params (car args)] [results (cadr args)])
         (args-code ms fc labels (cadddr args) params)
         (code-of (caddr args) 'i32)
         (call! (list 'call_indirect (list 'func params results) 0) results))]
      [(func-index)
       (op! (list 'global.get (fidx-synth! ms (car args))))
       (done '(i32))]
      [(ref-func)
       (let ([info (car args)])
         (note-func! ms info)
         (unless (func-info-type info)
           (fail "internal: ref.func of ~a, which has no declared function type" (func-info-name info)))
         (op! (list 'ref.func info))
         (done (list (make-ref #f (func-info-type info)))))]
      [(call-ref)
       (let ([t (car args)])
         (note-type! ms t)
         (args-code ms fc labels (caddr args) (car (type-info-fields t)))
         (code-of (cadr args) (make-ref #t t))
         (call! (list 'call_ref t) (cadr (type-info-fields t))))]
      [(gc)
       ;; A null, and testing for one, touch no GC object.
       (unless (memq (car args) '(ref.null ref.is_null ref.as_non_null)) (set-mstate-uses-gc! ms #t))
       (compile-gc ms fc labels (car args) (cadr args) (caddr args) expected)]
      [(select)
       (let ([ta (sub (car args) #f #f)])
         (unless (single? ta) (fail "select needs single values, got ~a" (type->string ta)))
         (sub (cadr args) ta #f)
         (sub (caddr args) '(i32) #f)
         (note-type! ms (car ta))
         (op! (if (ref-type? (car ta)) (list 'select-typed (car ta)) '(select)))
         (done ta))]
      [(drop)
       (let ([t (sub (car args) #f #f)])
         (unless (eq? t 'bottom) (for-each (lambda (_) (op! '(drop))) t))
         (done '()))]
      [(unreachable) (op! '(unreachable)) 'bottom]
      [(nop) (op! '(nop)) (done '())]
      [(throw)
       (let ([info (car args)])
         (note-tag! ms info)
         (args-code ms fc labels (cadr args) (tag-info-params info))
         (op! (list 'throw info))
         'bottom)]
      [(throw-ref) (code-of (car args) exnref) (op! '(throw_ref)) 'bottom]
      [(try) (compile-try ms fc labels (car args) (cadr args) expected tail?)]
      ;; (lambda key params results body): a closure of the lambda's
      ;; signature, of a subtype with a field per captured variable if it
      ;; captures any; its code, lifted, takes the closure first.
      [(lambda)
       (let* ([key (car args)] [params (cadr args)] [results (caddr args)] [body (cadddr args)]
              [a (or (fctx-analysis fc) (fail "internal: a lambda in a function that was not analyzed"))]
              [captures (map (lambda (k) (cons k (cdr (lookup-local fc k)))) (closures-captures-of a key))]
              [closure (closure-type (map cdr params) results)]
              [csub (if (null? captures) closure (capture-type closure (map cdr captures)))]
              [info (lifted-info ms 'lambda (cons (make-ref #f closure) (map cdr params)) results (closure-code closure))])
         (note-type! ms csub)
         (note-type! ms (closure-code closure))
         (lift! ms info (cons (cons key (make-ref #f closure)) params) params (list 'at current-loc body) a csub captures)
         (set-mstate-uses-gc! ms #t)
         (op! (list 'ref.func info))
         (for-each (lambda (c) (op! (list 'local.get (car (lookup-local fc (car c)))))) captures)
         (op! (list 'struct.new csub))
         (done (list (make-ref #f csub))))]
      ;; (apply-value head args): a call of the code of head, a closure,
      ;; given the closure; of a known function, a direct call of its
      ;; code, given the variables it captures, whatever check the head
      ;; makes of the variable (head-local).
      [(apply-value)
       (let* ([h (head-local (car args))]
              [k (and h (known-of fc (car h)))])
         (if k
             ;; The captures go as they are, a boxed one as its box.
             (let ([info (known-info! ms fc k)])
               (args-code ms fc labels (cadr args) (map cdr (caddr (known-lambda k))))
               (for-each (lambda (key) (op! (list 'local.get (car (lookup-local fc key))))) (known-captures k))
               (call! (list 'call info) (func-info-results info)))
             (let* ([t (sub (car args) #f #f)]
                    [code (and (single? t) (ref-type? (car t)) (closure-code (ref-heap (car t))))])
               (unless code
                 (fail "an application of ~a, which is not a function value: a function value has a closure type, (ref (closure (type ... -> type ...)))"
                       (type->string t)))
               (let* ([closure (ref-heap (car t))] [sig (type-info-fields code)]
                      [tmp (begin (note-type! ms code) (temp-local! fc (car t)))])
                 (op! (list 'local.tee tmp))
                 (when (ref-nullable? (car t)) (op! '(ref.as_non_null)))
                 (args-code ms fc labels (cadr args) (cdr (car sig)))
                 (op! (list 'local.get tmp))
                 (op! (list 'struct.get closure 0))
                 (set-mstate-uses-gc! ms #t)
                 (call! (list 'call_ref code) (cadr sig))))))]
      [(quote)
       ;; A quoted fixnum or #f is a constant, and so are '() and #t, which
       ;; are globals of the kernel module. Other data is an entry in the
       ;; module's table of quoted data.
       (let* ([d (car args)] [g (datum-global d)])
         (cond [(fixnum? d) (op! (list 'i32.const d)) (op! '(ref.i31)) (done (list (make-ref #f 'i31)))]
               [(eq? d #f) (op! '(ref.null eq)) (done (list eqref))]
               [g (sub (list 'gref g) expected tail?)]
               [else
                (let* ([lits (module-literals ms)] [i (serialize! (literals-serializer lits) d)])
                  (set-mstate-uses-gc! ms #t)
                  (op! (list 'global.get (literals-table lits)))
                  (op! (list 'i32.const i))
                  (op! (list 'array.get table-type))
                  (done (list eqref)))]))]
      [else (fail "internal: unknown kernel form ~s" (car e))])))

;; ---- quoted data ----

;; A module's quoted data, other than the constants, is serialized as it is
;; met (compiler/serialize.sub) into one passive data segment, which the
;; kernel module's %deserialize turns into a table of objects when the
;; module starts (spec 3.5). table: the synth holding the table.
(struct literals (serializer table))

(define (module-literals ms)
  (or (mstate-literals ms)
      (let ([lits (literals (make-serializer) (new-synth! ms 'literals #f))])
        (set-mstate-literals! ms lits)
        lits)))

;; ---- functions ----

;; The analysis of a form's code (closures.sub), given its parameters'
;; keys; #f if the form says it has no lambda or application of a
;; function value, in the element at index flag, which the expander sets.
(define (form-analysis form flag body params)
  (let ([r (list-tail form flag)])
    (if (and (pair? r) (not (car r))) #f (analyze-closures body params))))

;; Function info compiled: (info signature local-types asm). params are
;; its parameters, each (key . type), own the lambda's own among them,
;; whose boxed ones are put in boxes first; analysis is closures.sub's of
;; the function it was in, or its own. A closure's code, of closure type
;; csub, reads its captures from the closure's fields into locals first.
(define (compile-function ms info params own body analysis csub captures)
  (let ([fc (new-fctx params (func-info-results info))])
    (set-fctx-analysis! fc analysis)
    (set-mstate-fname! ms (func-info-name info))
    (set! compiling (func-info-name info))
    (set! current-loc #f)
    ;; The body's location, the function's own, comes first, then the
    ;; prologue.
    (let ([loc (loc-of body)]) (when loc (emit! fc (location-marker loc))))
    (when csub
      (let ([env (temp-local! fc (make-ref #f csub))])
        (emit! fc '(local.get 0))
        (emit! fc (list 'ref.cast csub))
        (emit! fc (list 'local.set env))
        (for-each (lambda (c i)
                    (let ([l (add-local! fc (car c) (cdr c))])
                      (emit! fc (list 'local.get env))
                      (emit! fc (list 'struct.get csub (+ i 1)))
                      (emit! fc (list 'local.set l))))
                  captures (range (length captures)))))
    (box-params! fc own)
    (cx ms fc '() body (func-info-results info) #t)
    (list info (list 'func (map cdr params) (func-info-results info)) (reverse (fctx-extra fc)) (fctx-asm fc))))

;; The functions lifted so far, compiled, in the order they were lifted;
;; compiling one may lift more.
(define (compile-pending! ms)
  (let loop ([acc '()])
    (if (null? (mstate-pending ms))
        (reverse acc)
        (let ([batch (reverse (mstate-pending ms))])
          (set-mstate-pending! ms '())
          (loop (foldl (lambda (e acc) (cons (apply compile-function ms e) acc)) acc batch))))))

;; ---- module ----

;; Is e a constant expression in wasm's sense (spec 5.2)? It may read
;; immutable globals that are imported or among `earlier`, this module's
;; globals defined before the one e initializes.
(define (constant-expr? ms e earlier)
  (let loop ([e e])
    (case (car e)
      [(at as) (loop (caddr e))]
      [(int float const ref-func lambda) #t]
      [(quote) (let ([d (cadr e)])
                 (or (fixnum? d) (eq? d #f) (and (datum-global d) #t)))]
      [(gref) (let ([g (cadr e)])
                (and (not (global-info-mutable? g))
                     (or (external? ms (global-info-instance g)) (hash-ref earlier g #f))))]
      [(prim) (and (memq (cadr e) '(i32.add i32.sub i32.mul i64.add i64.sub i64.mul))
                   (andmap loop (cadddr e)))]
      [(gc) (and (memq (cadr e) '(struct.new array.new array.new_default array.new_fixed ref.null ref.i31))
                 (andmap loop (cadddr e)))]
      [else #f])))

(define (loc-of e) (and (pair? e) (eq? (car e) 'at) (cadr e)))

(define (const-op t) (string->symbol (string-append (symbol->string t) ".const")))

;; The code of a value of type t that is zero or null, assembled: a
;; global's initial value until its initializer runs.
(define (zero-asm t)
  (let ([a (new-asm)])
    (instr! a (cond [(ref-type? t) (list 'ref.null (ref-heap t))]
                    [(eq? t 'f32) (list 'f32.const (integer->flonum 0))]
                    [(eq? t 'f64) (list 'f64.const (integer->flonum 0))]
                    [else (list (const-op t) 0)]))
    a))

;; Every type-info mentioned anywhere in x, dependencies first: its
;; supertype, then the types its fields mention. A recursion group comes as
;; a unit: the types its members mention outside the group first, then the
;; members in order. Outside a group a type may mention itself, but not a
;; later type.
(define (collect-types x)
  (let ([found '()] [seen (make-hasheq)])
    (letrec ([add! (lambda (t)
                     (unless (hash-ref seen t #f)
                       (let ([members (or (type-info-group t) (list t))])
                         (for-each (lambda (m) (hash-set! seen m #t)) members)
                         (for-each (lambda (m) (walk (type-info-super m)) (walk (type-info-fields m))) members)
                         (for-each (lambda (m) (set! found (cons m found))) members))))]
             [walk (lambda (x)
                     (cond [(type-info? x) (add! x)]
                           [(pair? x) (walk (car x)) (walk (cdr x))]
                           [else #f]))])
      (walk x)
      (reverse found))))

;; The instance names imports come from, in order, each once.
(define (import-instances imports)
  (let loop ([is imports] [acc '()])
    (cond [(null? is) (reverse acc)]
          [(member (caar is) acc) (loop (cdr is) acc)]
          [else (loop (cdr is) (cons (caar is) acc))])))

(define (export-namer)
  (let ([exported (make-hash)])
    (lambda (name)
      (let loop ([n 0])
        (let ([s (if (= n 0) (symbol->string name) (format "~a.~a" name n))])
          (if (hash-ref exported s #f)
              (loop (+ n 1))
              (begin (hash-set! exported s #t) s)))))))

;; Global initializers (spec 5.2). A constant expression is compiled into
;; the global itself: a table info -> its code, assembled. Any other
;; initializer runs in the start function, so its global must be mutable
;; and start with a default value.
(define (constant-inits ms global-forms analyses)
  (let ([earlier (make-hasheq)] [constants (make-hasheq)])
    (for-each (lambda (f)
                (let* ([info (cadr f)] [init (caddr f)] [t (global-info-type info)])
                  (set! current-loc (loc-of init))
                  (cond
                    [(and init (constant-expr? ms init earlier))
                     (let ([fc (new-fctx '() '())])
                       (set-fctx-analysis! fc (hash-ref analyses info))
                       (set-mstate-fname! ms (global-info-name info))
                       (cx ms fc '() init (list t) #f)
                       (hash-set! constants info (fctx-asm fc)))]
                    [(not (global-info-mutable? info))
                     (fail "global ~a is immutable, so its initializer must be a constant expression; declare it (mut ~a) to compute it when the module starts"
                           (global-info-name info) (valtype->string t))]
                    [(not (defaultable? t))
                     (fail "global ~a: a global computed when the module starts must have a numeric or nullable reference type"
                           (global-info-name info))])
                  (hash-set! earlier info #t)))
              global-forms)
    constants))

;; forms: fully expanded module forms. self: this module's instance name.
;; Assigns instance and export names to the infos it defines. Returns
;; (bytes imported-instance-names uses-gc? scope-table), the last the
;; scope table of its quoted data (spec 3.5).
(define current-ms #f)

(define (compile-module forms self)
  (set! current-loc #f)
  (let* ([export-name! (export-namer)]
         [ms (let ([m (mstate self '() '() '() '() '() #f #f #f #f '() export-name! #f '() (make-hasheq) (make-hasheq))])
               (set! current-ms m)
               m)]
         [kind? (lambda (k) (lambda (f) (eq? (car f) k)))]
         [func-forms (filter (kind? 'func) forms)]
         [global-forms (filter (kind? 'global) forms)]
         [data-forms (filter (kind? 'data) forms)]
         [type-forms (filter (kind? 'type) forms)]
         [tag-forms (filter (kind? 'tag) forms)]
         ;; (memory pages) defines memory 0; (memory-import instance)
         ;; imports the memory another instance exports. Tables likewise.
         [memory-form (findf (lambda (f) (memq (car f) '(memory memory-import))) forms)]
         [table-form (findf (lambda (f) (memq (car f) '(table table-import))) forms)]
         [imported? (lambda (form) (and form (memq (car form) '(memory-import table-import)) #t))]
         [local (lambda (name)
                  (let ([f (findf (lambda (f) (eq? (func-info-name (cadr f)) name)) func-forms)])
                    (and f (cadr f))))]
         [ex (lambda (name) (syntax-func ms local name))]
         [assigned
          (begin
            (for-each (lambda (f)
                        (let ([info (cadr f)])
                          (set-func-info-instance! info self)
                          (set-func-info-export! info (export-name! (func-info-name info)))))
                      func-forms)
            (for-each (lambda (f)
                        (let ([info (cadr f)])
                          (set-global-info-instance! info self)
                          (set-global-info-export! info (export-name! (global-info-name info)))))
                      global-forms)
            (for-each (lambda (f)
                        (let ([info (cadr f)])
                          (set-tag-info-instance! info self)
                          (set-tag-info-export! info (export-name! (tag-info-name info)))))
                      tag-forms))]
         [global-analyses (let ([t (make-hasheq)]) (for-each (lambda (f) (hash-set! t (cadr f) (and (caddr f) (form-analysis f 3 (caddr f) '())))) global-forms) t)]
         [constant-inits (constant-inits ms global-forms global-analyses)]
         ;; Function bodies.
         [compiled-funcs
          (map (lambda (f)
                 (let ([info (cadr f)] [params (caddr f)] [body (cadddr f)])
                   (compile-function ms info params params body (form-analysis f 4 body (map car params)) #f '())))
               func-forms)]
         ;; Start function: run-time global inits and module-level
         ;; expressions, in source order.
         [start-fc (new-fctx '() '())]
         [init-code
          (for-each (lambda (f)
                      (case (car f)
                        [(global)
                         (let ([info (cadr f)] [init (caddr f)])
                           (unless (or (not init) (hash-ref constant-inits info #f))
                             (set-fctx-analysis! start-fc (hash-ref global-analyses info))
                             (set-mstate-fname! ms (global-info-name info))
                             (cx ms start-fc '() init (list (global-info-type info)) #f)
                             (emit! start-fc (list 'global.set info))))]
                        [(expr)
                         (set-fctx-analysis! start-fc (form-analysis f 2 (cadr f) '()))
                         (set-mstate-fname! ms '__start)
                         (cx ms start-fc '() (cadr f) '() #f)]
                        [else #f]))
                    forms)]
         ;; The functions lifted from lambdas, compiled after the code they
         ;; were lifted from.
         [compiled-funcs (append compiled-funcs (compile-pending! ms))]
         ;; The quoted data, complete now that all code is compiled. Its
         ;; segment follows the module's own data segments.
         [literal-segment (and (mstate-literals ms) (serializer-bytes (literals-serializer (mstate-literals ms))))]
         ;; Table registration for func-index and quoted constants, in the
         ;; order the code above met them: the start function's first code.
         [setup (new-asm)]
         [setup-code
          (for-each (lambda (s)
                      (if (eq? (synth-kind s) 'fidx)
                          (begin (instr! setup (list 'ref.func (synth-datum s)))
                                 (instr! setup '(i32.const 1))
                                 (instr! setup '(table.grow 0))
                                 (instr! setup (list 'global.set s)))
                          (begin (instr! setup '(i32.const 0))
                                 (instr! setup (list 'i32.const (bytes-length literal-segment)))
                                 (instr! setup (list 'array.new_data string-type (length data-forms)))
                                 (instr! setup (list 'call (ex '%deserialize)))
                                 (instr! setup (list 'global.set s)))))
                    (reverse (mstate-synths ms)))]
         [has-start? (or (> (asm-size setup) 0) (> (asm-size (fctx-asm start-fc)) 0))]
         [checked
          (begin
            (when (and (mstate-uses-memory ms) (not memory-form))
              (raise-compile-error (and (srcloc? (mstate-uses-memory ms)) (mstate-uses-memory ms))
                                   "this code uses memory, but the module defines none: add (memory pages)"))
            (when (and (not (null? data-forms)) (not memory-form))
              (fail "data needs a memory: add (memory pages)"))
            (when (and (mstate-uses-table ms) (not table-form))
              (raise-compile-error (and (srcloc? (mstate-uses-table ms)) (mstate-uses-table ms))
                                   "this code uses a table, but the module defines none: add (table size)")))]

         ;; ---- index assignment ----
         [func-imports (reverse (mstate-func-imports ms))]
         [global-imports (reverse (mstate-global-imports ms))]
         [tag-imports (reverse (mstate-tag-imports ms))]
         [tag-index (make-hasheq)]
         [n-tags
          (let loop ([ts (append tag-imports (map cadr tag-forms))] [i 0])
            (if (null? ts) i (begin (hash-set! tag-index (car ts) i) (loop (cdr ts) (+ i 1)))))]
         [synths (reverse (mstate-synths ms))]
         [n-func-imports (length func-imports)]
         [func-index (make-hasheq)]
         [global-index (make-hasheq)]
         [start-index
          (let loop ([fs (append func-imports (map car compiled-funcs))] [i 0])
            (if (null? fs) i (begin (hash-set! func-index (car fs) i) (loop (cdr fs) (+ i 1)))))]
         [n-globals
          (let loop ([gs (append global-imports (map cadr global-forms) synths)] [i 0])
            (if (null? gs) i (begin (hash-set! global-index (car gs) i) (loop (cdr gs) (+ i 1)))))]

         ;; GC types come first in the type section, dependencies first:
         ;; the declared types, those the code uses (note-type!), and
         ;; those of signatures, globals and tags. Function types follow
         ;; as they are needed.
         [gc-types
          (collect-types (list (map cadr type-forms)
                               (reverse (mstate-types ms))
                               (map cadr compiled-funcs)
                               (map (lambda (info) (list (func-info-params info) (func-info-results info)
                                                         (func-info-type info)))
                                    func-imports)
                               (map (lambda (cf) (func-info-type (car cf))) compiled-funcs)
                               (map global-info-type global-imports)
                               (map (lambda (f) (global-info-type (cadr f))) global-forms)
                               (map tag-info-params (append tag-imports (map cadr tag-forms)))))]
         [gc-index
          (let ([table (make-hasheq)])
            (let loop ([ts gc-types] [i 0])
              (unless (null? ts) (hash-set! table (car ts) i) (loop (cdr ts) (+ i 1))))
            table)]
         [heap-index (lambda (h) (if (type-info? h) (hash-ref gc-index h #f) h))]
         [rv (lambda (t) (if (ref-type? t) (make-ref (ref-nullable? t) (heap-index (ref-heap t))) t))]
         [rstorage (lambda (s) (if (memq s '(i8 i16)) s (rv s)))]

         [func-types '()]
         [type-index
          (lambda (sig)
            (let ([sig (list 'func (map rv (cadr sig)) (map rv (caddr sig)))])
              (let loop ([ts func-types] [i (hash-count gc-index)])
                (cond [(null? ts) (set! func-types (append func-types (list sig))) i]
                      [(equal? (car ts) sig) i]
                      [else (loop (cdr ts) (+ i 1))]))))]
         [fi (lambda (info)
               (or (hash-ref func-index info #f)
                   (fail "internal: function ~a has no index" (func-info-name info))))]
         [gi (lambda (g) (or (hash-ref global-index g #f) (fail "internal: global has no index")))]
         [ti (lambda (t) (or (hash-ref gc-index t #f) (fail "internal: type has no index")))]
         [tgi (lambda (t) (or (hash-ref tag-index t #f) (fail "internal: tag ~a has no index" (tag-info-name t))))]
         [tag-type-index (lambda (t) (type-index (list 'func (tag-info-params t) '())))]
         ;; A function's type index: its declared function type's, or else
         ;; its signature's.
         [func-type-index (lambda (info sig) (if (func-info-type info) (ti (func-info-type info)) (type-index sig)))]

         ;; Linking (wasm.sub): each deferred field of the code, by kind
         ;; and key. A function ref.func refers to is declared.
         [declared '()]
         [declared? (make-hasheqv)]
         [resolve-bt (lambda (bt)
                       (cond [(and (pair? bt) (eq? (car bt) 'type)) (list 'type (type-index (cadr bt)))]
                             [(null? bt) bt]
                             [else (rv bt)]))]
         [resolve
          (lambda (kind key)
            (case kind
              [(func) (fi key)]
              [(ref-func) (let ([n (fi key)])
                            (unless (hash-ref declared? n #f)
                              (hash-set! declared? n #t)
                              (set! declared (cons n declared)))
                            n)]
              [(global) (gi key)]
              [(type) (if (type-info? key) (ti key) (type-index key))]
              [(tag) (tgi key)]
              [(heap) (heap-index key)]
              [(valtype) (rv key)]
              [(blocktype) (resolve-bt (if (cell? key) (cell-value key) key))]
              [(const) (cell-value key)]
              [else (fail "internal: a deferred field of kind ~a" kind)]))]

         [imports
          (append
           (map (lambda (info)
                  (list (func-info-instance info) (func-info-export info) 'func
                        (func-type-index info (list 'func (func-info-params info) (func-info-results info)))))
                func-imports)
           (map (lambda (g) (list (global-info-instance g) (global-info-export g) 'global
                                  (list (rv (global-info-type g)) (global-info-mutable? g))))
                global-imports)
           (map (lambda (t) (list (tag-info-instance t) (tag-info-export t) 'tag (tag-type-index t))) tag-imports)
           (if (imported? memory-form) (list (list (cadr memory-form) "memory" 'memory '(0 #f))) '())
           (if (imported? table-form) (list (list (cadr table-form) "table" 'table '(0 #f))) '()))]

         [wfuncs
          (append
           (map (lambda (cf)
                  (list (func-type-index (car cf) (cadr cf)) (map rv (caddr cf)) (link-body (list (cadddr cf)) resolve)
                        (func-info-export (car cf))))
                compiled-funcs)
           (if has-start?
               (list (list (type-index '(func () ())) (map rv (reverse (fctx-extra start-fc)))
                           (link-body (list setup (fctx-asm start-fc)) resolve)
                           "__start"))
               '()))]

         [init-bytes (lambda (a) (car (link-body (list a) resolve)))]
         [wglobals
          (append
           (map (lambda (f)
                  (let* ([info (cadr f)] [t (global-info-type info)] [init (hash-ref constant-inits info #f)])
                    (list (rv t) (global-info-mutable? info) (init-bytes (or init (zero-asm t))))))
                global-forms)
           (map (lambda (s) (if (eq? (synth-kind s) 'fidx)
                                (list 'i32 #t (init-bytes (zero-asm 'i32)))
                                (list (rv (make-ref #t table-type)) #t (init-bytes (zero-asm (make-ref #t table-type))))))
                synths))]

         ;; A module's memory and table are exported as "memory" and
         ;; "table": host imports find the caller's memory that way (spec
         ;; section 4).
         [exports
          (append
           (map (lambda (cf) (list (func-info-export (car cf)) 'func (fi (car cf)))) compiled-funcs)
           (map (lambda (f) (list (global-info-export (cadr f)) 'global (gi (cadr f)))) global-forms)
           (map (lambda (f) (list (tag-info-export (cadr f)) 'tag (tgi (cadr f)))) tag-forms)
           (if memory-form '(("memory" memory 0)) '())
           (if table-form '(("table" table 0)) '()))]

         [names
          (append
           (map (lambda (info) (cons (fi info) (format "~a.~a" (func-info-instance info) (func-info-export info))))
                func-imports)
           (map (lambda (f i) (cons i (cadddr f))) wfuncs (range n-func-imports (+ n-func-imports (length wfuncs)))))]

         [type-entry
          (lambda (t)
            (list 'sub (type-info-final? t)
                  (if (type-info-super t) (list (heap-index (type-info-super t))) '())
                  (case (type-info-kind t)
                    [(struct) (list 'struct (map (lambda (f) (list (rstorage (cadr f)) (caddr f))) (type-info-fields t)))]
                    [(array) (list 'array (list (rstorage (car (type-info-fields t))) (cadr (type-info-fields t))))]
                    [(func) (list 'func (map rv (car (type-info-fields t))) (map rv (cadr (type-info-fields t))))])))]

         ;; One entry per recursion group: collect-types keeps a group's
         ;; members together and in order.
         [gc-type-entries
          (let loop ([ts gc-types] [acc '()])
            (cond [(null? ts) (reverse acc)]
                  [(type-info-group (car ts))
                   (let ([n (length (type-info-group (car ts)))])
                     (loop (list-tail ts n) (cons (cons 'rec (map type-entry (take ts n))) acc)))]
                  [else (loop (cdr ts) (cons (type-entry (car ts)) acc))]))]

         [wtags (map (lambda (f) (tag-type-index (cadr f))) tag-forms)]

         [module-bytes
          (encode-module
           (wmodule (append gc-type-entries func-types) imports
                    (map (lambda (f) (list (car f) (cadr f) (caddr f) (cadddr f))) wfuncs)
                    (if (and table-form (not (imported? table-form))) (list (list (cadr table-form) #f)) '())
                    (if (and memory-form (not (imported? memory-form))) (list (list (cadr memory-form) #f)) '())
                    wtags wglobals exports
                    (and has-start? start-index)
                    (reverse declared)
                    (append (map (lambda (f) (cons (data-info-offset (cadr f)) (data-info-bytes (cadr f)))) data-forms)
                            (if literal-segment (list (cons #f literal-segment)) '()))
                    (cons self names)))])
    (list module-bytes
          (import-instances imports)
          (or (mstate-uses-gc ms) (ormap (lambda (t) (not (func-type? t))) gc-types))
          (if (mstate-literals ms) (serializer-scope-table (literals-serializer (mstate-literals ms))) '()))))
