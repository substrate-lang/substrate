;; The back end: a module's lowered code to wasm bytes.
(require-unqualified macros "macros.sub")
(require-unqualified core "core.sub")
(require-unqualified ops "ops.sub")
(require-unqualified binary "binary.sub")
(require-unqualified ser "serialize.sub")

(provide compile-module set-literal-functions! set-current-source!)

;; ---- state ----

(struct fctx [locals (ptr hash-table)] [extra datum] [next u32] [results datum] [asm (ptr asm)])

(struct label [key datum] [kind datum] [type datum] [next (ptr label)])

(struct synth [self datum] [kind datum] [info datum])
(const synth-kind u32 40)

(struct mstate [self datum] [func-imports datum] [global-imports datum] [tag-imports datum] [synths datum] [fidx datum]
        [uses-memory i32] [memory-loc (ptr srcloc)] [uses-table i32] [table-loc (ptr srcloc)]
        [literals (ptr serializer)] [literals-table datum] [exported (ptr hash-table)]
        [fname datum] [imported (ptr hash-table)])

(struct compiled [info datum] [sig datum] [locals datum] [asm (ptr asm)] [next (ptr compiled)])

(struct linker [funcs (ptr hash-table)] [globals (ptr hash-table)] [tags (ptr hash-table)]
        [func-types datum] [func-type-count u32] [func-type-index (ptr hash-table)]
        [declared datum] [declared-set (ptr hash-table)])

(define literal-buffer-info datum 0)
(define deserialize-info datum 0)
(define (set-literal-functions! [buffer datum] [deserialize datum])
  (set! literal-buffer-info buffer)
  (set! deserialize-info deserialize))

;; ---- error locations ----

(define current-loc (ptr srcloc) 0)
;; The form at current-loc, which a failure shows as the checker's do.
(define current-form datum 0)

;; A location in another file, in code a macro from another module introduced, gives way
;; to an enclosing one in this file, if there is one.
(define current-source datum 0)
(define (set-current-source! [s datum]) (set! current-source s))

(define (fail [template (ptr u8)] [args datum]) -> datum
  (throw compile-error (format-message template args) current-form current-loc)
  0)

(define (carrier-loc [c datum]) -> (ptr srcloc) (if (syntax? c) (syntax-srcloc c) 0))

(define (loc-of [e datum]) -> datum (if (and (pair? e) (== (car e) 'at)) (cadr e) 0))

;; ---- types ----

(define (type->string [t datum]) -> datum
  (cond [(== t 'bottom) '"nothing (unreachable)"]
        [(null? t) '"no value"]
        [(null? (cdr t)) (symbol->string (car t))]
        [else
         (let ([b (make-buffer)] [s datum 0])
           (buffer-add-byte! (& b) 40)
           (while (pair? t)
             (let ([v (symbol->string (car t))]) (buffer-add! (& b) (string-bytes v) (string-length v)))
             (when (pair? (cdr t)) (buffer-add-byte! (& b) 32))
             (set! t (cdr t)))
           (buffer-add-byte! (& b) 41)
           (set! s (bytes->string (-> b bytes) (-> b length)))
           (buffer-free! (& b))
           s)]))

(define (single? [t datum]) -> i32 (and (pair? t) (null? (cdr t))))

(define (map-cdr [l datum]) -> datum (map (lambda ([p datum]) -> datum (cdr p)) l))

(define (fit [fc (ptr fctx)] [type datum] [expected datum]) -> datum
  (cond [(== expected 0) type]
        [(== type 'bottom) expected]
        [(equal? type expected) expected]
        [(null? expected)
         (while (pair? type)
           (emit! fc '(drop))
           (set! type (cdr type)))
         nil]
        [else (fail "internal: expected ~a, got ~a" `(,(type->string expected) ,(type->string type)))]))

(define (literal-instr [lit datum] [t datum]) -> datum
  (let ([n (cadr lit)])
    (if (== (car lit) 'int)
        (cond [(== t 'i64) (cons `(i64.const ,(s64 n)) 'i64)]
              [(== t 'f32) (cons `(f32.const ,(integer->flonum n)) 'f32)]
              [(== t 'f64) (cons `(f64.const ,(integer->flonum n)) 'f64)]
              [else (cons `(i32.const ,(s32 n)) 'i32)])
        (if (== t 'f32)
            (cons `(f32.const ,n) 'f32)
            (cons `(f64.const ,n) 'f64)))))

(define (s32 [n datum]) -> datum
  (let ([v (integer-value n)])
    (unless (if (integer-negative? n) (>= v -2147483648) (<= (cast u64 v) 4294967295))
      (fail "integer ~a does not fit in i32" (cons n nil)))
    (make-integer (cast i64 (cast i32 v)))))

(define (s64 [n datum]) -> datum n)

(define (integer->flonum [n datum]) -> datum
  (make-flonum (if (integer-negative? n) (cast f64 (integer-value n)) (cast f64 (cast u64 (integer-value n))))))

(define (small [n i64]) -> datum (make-integer n))

;; ---- per-function state ----

(define (new-fctx [params datum] [results datum]) -> (ptr fctx)
  (let ([fc (cast (ptr fctx) (arena-alloc (current-arena) (sizeof fctx)))])
    (set! (-> fc locals) (make-table))
    (set! (-> fc extra) nil)
    (set! (-> fc next) 0)
    (set! (-> fc results) results)
    (set! (-> fc asm) (new-asm))
    (while (pair? params)
      (add-local! fc (car (car params)) (cdr (car params)))
      (set! params (cdr params)))
    (set! (-> fc extra) nil)
    fc))

(define (emit! [fc (ptr fctx)] [i datum]) (instr! (-> fc asm) i))

(define (key-slot [key datum]) -> u64 (cast u64 (integer-value key)))

(define (add-local! [fc (ptr fctx)] [key datum] [type datum]) -> u32
  (let ([i (-> fc next)])
    (hash-set! (-> fc locals) (key-slot key) (cast u32 (cons (small i) type)))
    (set! (-> fc extra) (cons type (-> fc extra)))
    (+= (-> fc next) 1)
    i))

;; Keys of locals the compiler makes: negative, unlike the expander's.
(define temp-counter i64 0)
(define (temp-local! [fc (ptr fctx)] [type datum]) -> u32
  (-= temp-counter 1)
  (add-local! fc (small temp-counter) type))

(define (lookup-local [fc (ptr fctx)] [key datum]) -> datum
  (let ([l (cast datum (hash-ref (-> fc locals) (key-slot key)))])
    (when (== l 0) (fail "internal: unknown local ~a in ~a" `(,key ,compiling)))
    l))

(define compiling datum 0)

(define (push-label [key datum] [kind datum] [type datum] [next (ptr label)]) -> (ptr label)
  (let ([l (cast (ptr label) (arena-alloc (current-arena) (sizeof label)))])
    (set! (-> l key) key)
    (set! (-> l kind) kind)
    (set! (-> l type) type)
    (set! (-> l next) next)
    l))

(define (anonymous-blocks [n u32] [rest (ptr label)]) -> (ptr label)
  (for ([i u32 0]) (< i n) (+= i 1) (set! rest (push-label 0 'block 0 rest)))
  rest)

(define (label-find [labels (ptr label)] [key datum]) -> (ptr label)
  (while (!= labels 0)
    (when (and (!= (-> labels key) 0) (equal? (-> labels key) key)) (return labels))
    (set! labels (-> labels next)))
  (fail "internal: unknown label ~a" (cons key nil))
  0)

(define (label-depth [labels (ptr label)] [key datum]) -> u32
  (let ([d u32 0])
    (while (not (and (!= (-> labels key) 0) (equal? (-> labels key) key)))
      (+= d 1)
      (set! labels (-> labels next)))
    d))

;; ---- module state ----

(define (synth-of [d datum]) -> (ptr synth) (cast (ptr synth) (record-pointer d)))

(define (new-mstate [self datum]) -> (ptr mstate)
  (let ([ms (cast (ptr mstate) (arena-alloc (current-arena) (sizeof mstate)))])
    (set! (-> ms self) self)
    (set! (-> ms func-imports) nil)
    (set! (-> ms global-imports) nil)
    (set! (-> ms tag-imports) nil)
    (set! (-> ms synths) nil)
    (set! (-> ms fidx) nil)
    (set! (-> ms uses-memory) 0)
    (set! (-> ms memory-loc) 0)
    (set! (-> ms uses-table) 0)
    (set! (-> ms table-loc) 0)
    (set! (-> ms literals) 0)
    (set! (-> ms literals-table) 0)
    (set! (-> ms exported) (make-table))
    (set! (-> ms fname) 0)
    (set! (-> ms imported) (make-table))
    ms))

(define (external? [ms (ptr mstate)] [instance datum]) -> i32 (not (equal? instance (-> ms self))))

(define (new-import? [ms (ptr mstate)] [info datum]) -> i32
  (if (!= (hash-ref (-> ms imported) (cast u64 info)) 0)
      0
      (begin (hash-set! (-> ms imported) (cast u64 info) 1) 1)))

(define (note-func! [ms (ptr mstate)] [info datum])
  (when (and (external? ms (func-info-instance info)) (new-import? ms info))
    (set! (-> ms func-imports) (cons info (-> ms func-imports)))))

(define (note-global! [ms (ptr mstate)] [info datum])
  (when (and (global-info? info) (external? ms (global-info-instance info)) (new-import? ms info))
    (set! (-> ms global-imports) (cons info (-> ms global-imports)))))

(define (note-tag! [ms (ptr mstate)] [info datum])
  (when (and (external? ms (tag-info-instance info)) (new-import? ms info))
    (set! (-> ms tag-imports) (cons info (-> ms tag-imports)))))

(define (note-memory! [ms (ptr mstate)])
  (unless (-> ms uses-memory)
    (set! (-> ms uses-memory) 1)
    (set! (-> ms memory-loc) current-loc)))

(define (note-table! [ms (ptr mstate)])
  (unless (-> ms uses-table)
    (set! (-> ms uses-table) 1)
    (set! (-> ms table-loc) current-loc)))

(define (new-synth! [ms (ptr mstate)] [kind datum] [info datum]) -> datum
  (let ([s (cast (ptr synth) (arena-alloc (current-arena) (sizeof synth)))])
    (set! (-> s self) (make-record-in (current-arena) synth-kind s))
    (set! (-> s kind) kind)
    (set! (-> s info) info)
    (set! (-> ms synths) (cons (-> s self) (-> ms synths)))
    (-> s self)))

(define (fidx-synth! [ms (ptr mstate)] [info datum]) -> datum
  (note-table! ms)
  (let ([found (assq info (-> ms fidx))])
    (if (!= found 0)
        (cdr found)
        (let ([s (new-synth! ms 'fidx info)])
          (note-func! ms info)
          (set! (-> ms fidx) (cons (cons info s) (-> ms fidx)))
          s))))

(define (export-name! [ms (ptr mstate)] [name datum]) -> datum
  (let ([n i64 0] [s datum 0])
    (while 1
      (set! s (if (== n 0) (symbol->string name) (format-message "~a.~a" `(,name ,(small n)))))
      (when (== (datum-get (-> ms exported) s) 0)
        (datum-put! (-> ms exported) s (boolean 1))
        (return s))
      (+= n 1))))

;; ---- expressions ----

(define (code-of [ms (ptr mstate)] [fc (ptr fctx)] [labels (ptr label)] [e datum] [type datum]) -> datum
  (cx ms fc labels e (cons type nil) 0))

(define (args-code [ms (ptr mstate)] [fc (ptr fctx)] [labels (ptr label)] [args datum] [types datum])
  (unless (== (length args) (length types))
    (fail "internal: expected ~a arguments, got ~a" `(,(small (length types)) ,(small (length args)))))
  (while (pair? args)
    (code-of ms fc labels (car args) (car types))
    (set! args (cdr args))
    (set! types (cdr types))))

(define (blocktype [t datum]) -> datum
  (cond [(null? t) nil]
        [(single? t) (car t)]
        [else `(type (func () ,t))]))

(define (call! [fc (ptr fctx)] [i datum] [results datum] [expected datum] [tail i32]) -> datum
  (if (and tail (equal? results (-> fc results)))
      (begin (emit! fc (cons (if (== (car i) 'call) 'return_call 'return_call_indirect) (cdr i))) results)
      (begin (emit! fc i) (fit fc results expected))))

;; A call in a try's body is not a tail call, which would leave the try.
(define (compile-try [ms (ptr mstate)] [fc (ptr fctx)] [labels (ptr label)] [clauses datum] [body datum]
                     [expected datum] [tail i32]) -> datum
  (let* ([n (length clauses)]
         [outer (push-label 0 'block 0 labels)]
         [payloads (map (lambda ([c datum]) -> datum
                          (append (if (!= (cadr c) 0) (tag-info-params (cadr c)) nil)
                                  (if (!= (memq (car c) '(catch-ref catch-all-ref)) 0) '(exnref) nil)))
                        clauses)]
         [tcell (cell nil)]
         [catches (try-catches ms clauses)]
         [es (cons body (map (lambda ([c datum]) -> datum (cadddr c)) clauses))]
         [i u32 0])
    (when (== expected 0) (fail "internal: a try without a type" nil))
    (emit! fc `(block ,tcell))
    (for-each (lambda ([p datum]) (emit! fc `(block ,(blocktype p)))) (reverse payloads))
    (emit! fc `(try_table ,tcell ,catches))
    (while (pair? es)
      (try-branch ms fc outer clauses payloads n i (car es) expected tail)
      (+= i 1)
      (set! es (cdr es)))
    (set-cell-value! tcell (blocktype expected))
    expected))

(define (try-catches [ms (ptr mstate)] [clauses datum]) -> datum
  (let ([out nil] [i i64 0])
    (while (pair? clauses)
      (let* ([c (car clauses)] [kind (car c)])
        (when (!= (cadr c) 0) (note-tag! ms (cadr c)))
        (set! out (cons (cond [(== kind 'catch) `(catch ,(cadr c) ,(small i))]
                              [(== kind 'catch-ref) `(catch_ref ,(cadr c) ,(small i))]
                              [(== kind 'catch-all) `(catch_all ,(small i))]
                              [else `(catch_all_ref ,(small i))])
                        out)))
      (+= i 1)
      (set! clauses (cdr clauses)))
    (reverse out)))

(define (try-branch [ms (ptr mstate)] [fc (ptr fctx)] [outer (ptr label)] [clauses datum] [payloads datum] [n u32]
                    [i u32] [e datum] [expected datum] [tail i32]) -> datum
  (if (== i 0)
      (let ([t (cx ms fc (push-label 0 'block 0 (anonymous-blocks n outer)) e expected 0)])
        (emit! fc '(end))
        (emit! fc `(br ,(small n)))
        (emit! fc '(end))
        t)
      (let ([c (list-ref clauses (- i 1))] [p (list-ref payloads (- i 1))] [t datum 0])
        (let ([ks (caddr c)] [ts p])
          (while (pair? ks)
            (add-local! fc (car ks) (car ts))
            (set! ks (cdr ks))
            (set! ts (cdr ts))))
        ;; The values, the last on the stack first.
        (for-each (lambda ([key datum]) (emit! fc `(local.set ,(car (lookup-local fc key))))) (reverse (caddr c)))
        (set! t (cx ms fc (anonymous-blocks (- n i) outer) e expected tail))
        (when (< i n) (emit! fc `(br ,(small (- n i)))))
        (emit! fc '(end))
        t)))

(define (cx [ms (ptr mstate)] [fc (ptr fctx)] [labels (ptr label)] [e datum] [expected datum] [tail i32]) -> datum
  (unless (pair? e) (fail "internal: not lowered code: ~s" (cons e nil)))
  (let ([kind (car e)] [args (cdr e)])
    (cond
      [(== kind 'at)
       (let* ([saved current-loc]
              [saved-form current-form]
              [given (carrier-loc (car args))]
              [loc (cond [(== given 0) saved]
                         [(== (-> given source) current-source) given]
                         [(!= saved 0) saved]
                         [else given])]
              [t datum 0])
         (set! current-loc loc)
         (when (and (!= given 0) (== loc given)) (set! current-form (car args)))
         (unless (== loc saved) (asm-location! (-> fc asm) loc))
         (set! t (cx ms fc labels (cadr args) expected tail))
         (set! current-loc saved)
         (set! current-form saved-form)
         (unless (== loc saved) (asm-location! (-> fc asm) saved))
         t)]
      [(== kind 'as) (fit fc (cx ms fc labels (cadr args) (car args) tail) expected)]
      [(or (== kind 'int) (== kind 'float))
       (let ([r (literal-instr e (cond [(== kind 'float) (if (equal? expected '(f32)) 'f32 'f64)]
                                       [(single? expected) (car expected)]
                                       [else 'i32]))])
         (emit! fc (car r))
         (fit fc (cons (cdr r) nil) expected))]
      [(== kind 'const)
       (let ([t (car args)] [n (cadr args)])
         (emit! fc (cond [(== t 'i32) `(i32.const ,(s32 n))]
                         [(== t 'i64) `(i64.const ,(s64 n))]
                         [else `(,(const-op t) ,n)]))
         (fit fc (cons t nil) expected))]
      [(== kind 'lref)
       (let ([l (lookup-local fc (car args))])
         (emit! fc `(local.get ,(car l)))
         (fit fc (cons (cdr l) nil) expected))]
      [(== kind 'lset)
       (let ([l (lookup-local fc (car args))])
         (code-of ms fc labels (cadr args) (cdr l))
         (emit! fc `(local.set ,(car l)))
         (fit fc nil expected))]
      [(== kind 'gref)
       (let ([info (car args)])
         (note-global! ms info)
         (emit! fc `(global.get ,info))
         (fit fc (cons (global-info-type info) nil) expected))]
      [(== kind 'gset)
       (let ([info (car args)])
         (when (== (global-info-mutable? info) 0) (fail "internal: ~a is immutable" (cons (global-info-name info) nil)))
         (note-global! ms info)
         (code-of ms fc labels (cadr args) (global-info-type info))
         (emit! fc `(global.set ,info))
         (fit fc nil expected))]
      [(== kind 'let) (cx-let ms fc labels args expected tail)]
      [(== kind 'seq)
       (if (null? args)
           (fit fc nil expected)
           (begin
             (while (pair? (cdr args))
               (cx ms fc labels (car args) nil 0)
               (set! args (cdr args)))
             (cx ms fc labels (car args) expected tail)))]
      [(== kind 'if) (cx-if ms fc labels args expected tail)]
      [(== kind 'block) (cx-block ms fc labels args expected tail)]
      [(== kind 'loop)
       (let ([lbl (push-label (car args) 'loop nil labels)] [c (cell nil)])
         (when (== expected 0) (fail "internal: a loop without a type" nil))
         (emit! fc `(loop ,c))
         (cx ms fc lbl (cadr args) expected tail)
         (emit! fc '(end))
         (set-cell-value! c (blocktype expected))
         expected)]
      [(== kind 'br)
       (let ([lbl (label-find labels (car args))] [depth (label-depth labels (car args))] [v (cadr args)])
         (if (== (-> lbl kind) 'loop)
             (when (!= v 0) (fail "internal: br to a loop label cannot carry a value" nil))
             (fit fc (if (!= v 0) (cx ms fc labels v (-> lbl type) 0) nil) (-> lbl type)))
         (emit! fc `(br ,(small depth)))
         'bottom)]
      [(== kind 'br-if)
       (let ([lbl (label-find labels (car args))] [depth (label-depth labels (car args))])
         (cx ms fc labels (cadr args) '(i32) 0)
         (unless (or (== (-> lbl kind) 'loop) (== (-> lbl type) 0) (null? (-> lbl type)))
           (fail "internal: br-if cannot exit a block that produces ~a" (cons (type->string (-> lbl type)) nil)))
         (emit! fc `(br_if ,(small depth)))
         (fit fc nil expected))]
      [(== kind 'br-table)
       (let ([depths nil] [ks (append (car args) (cons (cadr args) nil))])
         (cx ms fc labels (caddr args) '(i32) 0)
         (while (pair? ks)
           (let ([lbl (label-find labels (car ks))])
             (unless (or (== (-> lbl kind) 'loop) (== (-> lbl type) 0) (null? (-> lbl type)))
               (fail "internal: br-table cannot exit a block that produces ~a" (cons (type->string (-> lbl type)) nil)))
             (set! depths (cons (small (label-depth labels (car ks))) depths)))
           (set! ks (cdr ks)))
         (emit! fc `(br_table ,(reverse (cdr depths)) ,(car depths)))
         'bottom)]
      [(== kind 'return)
       (let ([v (car args)])
         (when (!= v 0) (cx ms fc labels v (-> fc results) 1))
         (unless (or (!= v 0) (null? (-> fc results)))
           (fail "internal: return needs a value of type ~a" (cons (type->string (-> fc results)) nil)))
         (emit! fc '(return))
         'bottom)]
      [(== kind 'call)
       (let ([info (car args)])
         (note-func! ms info)
         (args-code ms fc labels (cadr args) (func-info-params info))
         (call! fc `(call ,info) (func-info-results info) expected tail))]
      [(== kind 'prim)
       (let* ([name (car args)] [offset (cadr args)] [p (lookup-prim name)])
         (when (or (== (-> p kind) 'mem) (!= (memq name '(memory.size memory.grow memory.copy memory.fill)) 0))
           (note-memory! ms))
         (args-code ms fc labels (caddr args) (-> p params))
         (emit! fc (if (== (-> p kind) 'mem)
                       `(,name ,(-> p align) ,(if (!= offset 0) offset (small 0)))
                       (cons name nil)))
         (fit fc (-> p results) expected))]
      [(== kind 'call-indirect)
       (note-table! ms)
       (let ([params (car args)] [results (cadr args)])
         (args-code ms fc labels (cadddr args) params)
         (code-of ms fc labels (caddr args) 'i32)
         (call! fc `(call_indirect (func ,params ,results) 0) results expected tail))]
      [(== kind 'func-index)
       (emit! fc `(global.get ,(fidx-synth! ms (car args))))
       (fit fc '(i32) expected)]
      [(== kind 'select)
       (unless (single? expected) (fail "internal: select without a single type" nil))
       (cx ms fc labels (car args) expected 0)
       (cx ms fc labels (cadr args) expected 0)
       (cx ms fc labels (caddr args) '(i32) 0)
       (emit! fc (if (== (car expected) 'exnref) '(select-typed exnref) '(select)))
       expected]
      [(== kind 'values)
       (unless (and (!= expected 0) (== (length expected) (length args))) (fail "internal: values without its types" nil))
       (let ([es args] [ex expected])
         (while (pair? es)
           (when (== (cx ms fc labels (car es) (cons (car ex) nil) 0) 'bottom) (return 'bottom))
           (set! es (cdr es))
           (set! ex (cdr ex)))
         expected)]
      [(== kind 'drop)
       (let ([t (cx ms fc labels (car args) 0 0)])
         (unless (== t 'bottom)
           (while (pair? t)
             (emit! fc '(drop))
             (set! t (cdr t))))
         (fit fc nil expected))]
      [(== kind 'unreachable) (emit! fc '(unreachable)) 'bottom]
      [(== kind 'nop) (emit! fc '(nop)) (fit fc nil expected)]
      [(== kind 'throw)
       (let ([info (car args)])
         (note-tag! ms info)
         (args-code ms fc labels (cadr args) (tag-info-params info))
         (emit! fc `(throw ,info))
         'bottom)]
      [(== kind 'throw-ref)
       (code-of ms fc labels (car args) 'exnref)
       (emit! fc '(throw_ref))
       'bottom]
      [(== kind 'try) (compile-try ms fc labels (car args) (cadr args) expected tail)]
      [(== kind 'quote)
       (let ([d (car args)])
         (if (== d 0)
             (emit! fc '(i32.const 0))
             (let ([i (serialize! (module-literals ms) d)])
               (emit! fc `(global.get ,(-> ms literals-table)))
               (emit! fc `(i32.load 2 ,(small (* 4 i))))))
         (fit fc '(i32) expected))]
      [else (fail "internal: unknown lowered form ~s" (cons kind nil))])))

(define (const-op [t datum]) -> datum
  (cond [(== t 'i32) 'i32.const]
        [(== t 'i64) 'i64.const]
        [(== t 'f32) 'f32.const]
        [else 'f64.const]))

(define (cx-let [ms (ptr mstate)] [fc (ptr fctx)] [labels (ptr label)] [args datum] [expected datum] [tail i32]) -> datum
  (let ([bs (car args)])
    (while (pair? bs)
      (let* ([b (car bs)] [key (car b)] [declared (cadr b)] [init (caddr b)])
        (when (== declared 0) (fail "internal: a let binding without a type" nil))
        ;; Several keys take the values of their init, the last on top of
        ;; the stack, so set first.
        (if (pair? key)
            (let ([ks (reverse key)] [t (reverse declared)])
              (cx ms fc labels init declared 0)
              (while (pair? ks)
                (emit! fc `(local.set ,(small (add-local! fc (car ks) (car t)))))
                (set! ks (cdr ks))
                (set! t (cdr t))))
            (begin
              (cx ms fc labels init (cons declared nil) 0)
              (emit! fc `(local.set ,(small (add-local! fc key declared)))))))
      (set! bs (cdr bs)))
    (cx ms fc labels (cadr args) expected tail)))

(define (cx-if [ms (ptr mstate)] [fc (ptr fctx)] [labels (ptr label)] [args datum] [expected datum] [tail i32]) -> datum
  (let* ([test (car args)] [then (cadr args)] [els (caddr args)]
         [lbls (push-label 0 'if 0 labels)]
         [c (cell nil)])
    (cx ms fc labels test '(i32) 0)
    (emit! fc `(if ,c))
    (if (== els 0)
        (begin (cx ms fc lbls then nil 0)
               (emit! fc '(end))
               (fit fc nil expected))
        (begin
          (when (== expected 0) (fail "internal: an if without a type" nil))
          (cx ms fc lbls then expected tail)
          (emit! fc '(else))
          (cx ms fc lbls els expected tail)
          (emit! fc '(end))
          (set-cell-value! c (blocktype expected))
          expected))))

(define (cx-block [ms (ptr mstate)] [fc (ptr fctx)] [labels (ptr label)] [args datum] [expected datum] [tail i32]) -> datum
  (let ([lbl (push-label (car args) 'block expected labels)] [c (cell nil)])
    (when (== expected 0) (fail "internal: a block without a type" nil))
    (emit! fc `(block ,c))
    (cx ms fc lbl (cadr args) expected tail)
    (emit! fc '(end))
    (set-cell-value! c (blocktype expected))
    expected))

;; ---- quoted data ----

(define (module-literals [ms (ptr mstate)]) -> (ptr serializer)
  (when (== (-> ms literals) 0)
    (when (== deserialize-info 0) (fail "internal: quoted data needs the syntax module" nil))
    (set! (-> ms literals) (make-serializer))
    (set! (-> ms literals-table) (new-synth! ms 'literals 0)))
  (-> ms literals))

;; ---- functions ----

(define (compile-function [ms (ptr mstate)] [info datum] [params datum] [body datum]) -> (ptr compiled)
  (let ([fc (new-fctx params (func-info-results info))]
        [cf (cast (ptr compiled) (arena-alloc (current-arena) (sizeof compiled)))])
    (set! (-> ms fname) (func-info-name info))
    (set! compiling (func-info-name info))
    (set! current-loc 0)
    (set! current-form 0)
    (let ([loc (carrier-loc (loc-of body))]) (when (!= loc 0) (asm-location! (-> fc asm) loc)))
    (cx ms fc 0 body (func-info-results info) 1)
    (set! (-> cf info) info)
    (set! (-> cf sig) `(func ,(map-cdr params) ,(func-info-results info)))
    (set! (-> cf locals) (reverse (-> fc extra)))
    (set! (-> cf asm) (-> fc asm))
    (set! (-> cf next) 0)
    cf))

;; ---- module ----

;; A constant expression reads only imported globals, as wasm 2.0 allows.
(define (constant-expr? [ms (ptr mstate)] [e datum]) -> i32
  (let ([kind (car e)])
    (cond [(or (== kind 'at) (== kind 'as)) (constant-expr? ms (caddr e))]
          [(!= (memq kind '(int float const)) 0) 1]
          [(== kind 'quote) (== (cadr e) 0)]
          [(== kind 'gref)
           (let ([g (cadr e)]) (and (== (global-info-mutable? g) 0) (external? ms (global-info-instance g))))]
          [(== kind 'prim)
           (and (!= (memq (cadr e) '(i32.add i32.sub i32.mul i64.add i64.sub i64.mul)) 0) (all-constant? ms (cadddr e)))]
          [else 0])))

(define (all-constant? [ms (ptr mstate)] [es datum]) -> i32
  (while (pair? es)
    (unless (constant-expr? ms (car es)) (return 0))
    (set! es (cdr es)))
  1)

(define (zero-asm [t datum]) -> (ptr asm)
  (let ([a (new-asm)])
    (instr! a (cond [(== t 'exnref) '(ref.null exn)]
                    [(== t 'f32) `(f32.const ,(make-flonum 0.0))]
                    [(== t 'f64) `(f64.const ,(make-flonum 0.0))]
                    [else `(,(const-op t) 0)]))
    a))

(define (import-instances [imports datum]) -> datum
  (let ([acc nil])
    (while (pair? imports)
      (when (== (member (car (car imports)) acc) 0) (set! acc (cons (car (car imports)) acc)))
      (set! imports (cdr imports)))
    (reverse acc)))

(define (constant-inits [ms (ptr mstate)] [global-forms datum]) -> (ptr hash-table)
  (let ([constants (make-table)])
    (while (pair? global-forms)
      (let* ([f (car global-forms)] [info (cadr f)] [init (caddr f)] [t (global-info-type info)])
        (set! current-loc (carrier-loc (loc-of init)))
        (set! current-form (if (!= current-loc 0) (loc-of init) 0))
        (cond
          [(and (!= init 0) (constant-expr? ms init))
           (let ([fc (new-fctx nil nil)])
             (set! (-> ms fname) (global-info-name info))
             (cx ms fc 0 init (cons t nil) 0)
             (hash-set! constants (cast u64 info) (cast u32 (-> fc asm))))]
          [(== (global-info-mutable? info) 0)
           (fail "global ~a is immutable, so its initializer must be a constant expression; declare it (mut ~a) to compute it when the module starts"
                 `(,(global-info-name info) ,t))]))
      (set! global-forms (cdr global-forms)))
    constants))

(define (forms-of [forms datum] [kind datum]) -> datum
  (let ([out nil])
    (while (pair? forms)
      (when (== (car (car forms)) kind) (set! out (cons (car forms) out)))
      (set! forms (cdr forms)))
    (reverse out)))

(define (form-of [forms datum] [a datum] [b datum]) -> datum
  (while (pair? forms)
    (when (or (== (car (car forms)) a) (== (car (car forms)) b)) (return (car forms)))
    (set! forms (cdr forms)))
  0)

(define (imported-storage? [form datum]) -> i32
  (and (!= form 0) (or (== (car form) 'memory-import) (== (car form) 'table-import))))

(define (compile-module [forms datum] [self datum]) -> datum
  (set! current-loc 0)
  (set! current-form 0)
  (let* ([ms (new-mstate self)]
         [func-forms (forms-of forms 'func)]
         [global-forms (forms-of forms 'global)]
         [tag-forms (forms-of forms 'tag)]
         [memory-form (form-of forms 'memory 'memory-import)]
         [table-form (form-of forms 'table 'table-import)]
         [constants (ptr hash-table) 0]
         [first (ptr compiled) 0]
         [last (ptr compiled) 0]
         [start-fc (ptr fctx) 0]
         [setup (ptr asm) 0]
         [literal-segment datum 0])
    (for-each (lambda ([f datum])
                (set-func-info-instance! (cadr f) self)
                (set-func-info-export! (cadr f) (export-name! ms (func-info-name (cadr f)))))
              func-forms)
    (for-each (lambda ([f datum])
                (set-global-info-instance! (cadr f) self)
                (set-global-info-export! (cadr f) (export-name! ms (global-info-name (cadr f)))))
              global-forms)
    (for-each (lambda ([f datum])
                (set-tag-info-instance! (cadr f) self)
                (set-tag-info-export! (cadr f) (export-name! ms (tag-info-name (cadr f)))))
              tag-forms)
    (set! constants (constant-inits ms global-forms))
    (set! last (cast (ptr compiled) (arena-alloc (current-arena) (sizeof compiled))))
    (set! (-> last next) 0)
    (set! first last)
    (for-each (lambda ([f datum])
                (let ([cf (compile-function ms (cadr f) (caddr f) (cadddr f))])
                  (set! (-> last next) cf)
                  (set! last cf)))
              func-forms)
    ;; As a function does, the start function begins with no location: constant-inits leaves
    ;; the last global's.
    (set! start-fc (new-fctx nil nil))
    (set! current-loc 0)
    (set! current-form 0)
    (for-each (lambda ([f datum]) (start-code! ms start-fc f constants)) forms)
    ;; The quoted data is complete only once all code is compiled.
    (when (!= (-> ms literals) 0) (set! literal-segment (serializer-bytes (-> ms literals))))
    ;; Table registration is the start function's first code, in the order the code met it.
    (set! setup (new-asm))
    (for-each (lambda ([s datum])
                (setup-code! ms setup start-fc s literal-segment))
              (reverse (-> ms synths)))
    (when (and (-> ms uses-memory) (== memory-form 0))
      (raise-compile-error (-> ms memory-loc) '"this code uses memory, but the module defines none: add (memory pages)"))
    ;; Quoted data is in the syntax module's memory, so a module that quotes data cannot
    ;; have a memory of its own.
    (when (!= (-> ms literals) 0)
      (cond [(== memory-form 0) (set! memory-form `(memory-import ,(func-info-instance literal-buffer-info)))]
            [(== (car memory-form) 'memory)
             (fail "quoted data is the syntax module's, in its memory, which this module's own memory is not: take it with (memory from s), s the syntax module"
                   nil)]))
    (when (and (-> ms uses-table) (== table-form 0))
      (raise-compile-error (-> ms table-loc) '"this code uses a table, but the module defines none: add (table size)"))
    (link-module ms (-> first next) start-fc setup literal-segment global-forms tag-forms memory-form table-form
                 constants)))

(define (start-code! [ms (ptr mstate)] [fc (ptr fctx)] [f datum] [constants (ptr hash-table)])
  (cond [(== (car f) 'global)
         (let ([info (cadr f)] [init (caddr f)])
           (unless (or (== init 0) (!= (hash-ref constants (cast u64 info)) 0))
             (set! (-> ms fname) (global-info-name info))
             (cx ms fc 0 init (cons (global-info-type info) nil) 0)
             (emit! fc `(global.set ,info))))]
        [(== (car f) 'expr)
         (set! (-> ms fname) '__start)
         (cx ms fc 0 (cadr f) nil 0)]))

(define (setup-code! [ms (ptr mstate)] [setup (ptr asm)] [fc (ptr fctx)] [s datum] [segment datum])
  (let ([sy (synth-of s)])
    (if (== (-> sy kind) 'fidx)
        (begin
          (instr! setup `(ref.func ,(-> sy info)))
          (instr! setup '(i32.const 1))
          (instr! setup '(table.grow 0))
          (instr! setup `(global.set ,s)))
        (let ([n (small (string-length segment))] [at (small (temp-local! fc 'i32))])
          (note-func! ms literal-buffer-info)
          (note-func! ms deserialize-info)
          (instr! setup `(i32.const ,n))
          (instr! setup `(call ,literal-buffer-info))
          (instr! setup `(local.tee ,at))
          (instr! setup '(i32.const 0))
          (instr! setup `(i32.const ,n))
          (instr! setup '(memory.init 0 0))
          (instr! setup '(data.drop 0))
          (instr! setup `(local.get ,at))
          (instr! setup `(i32.const ,n))
          (instr! setup `(call ,deserialize-info))
          (instr! setup `(global.set ,s))))))

;; ---- linking ----

(define (index-of [t (ptr hash-table)] [key datum] [what (ptr u8)]) -> datum
  (let ([i (hash-ref t (cast u64 key))])
    (when (== i 0) (fail "internal: ~a has no index" (cons (bytes->string what (strlen what)) nil)))
    (small (- i 1))))

(define (type-index [lk (ptr linker)] [sig datum]) -> datum
  (let ([known (datum-get (-> lk func-type-index) sig)])
    (if (!= known 0)
        known
        (let ([i (small (-> lk func-type-count))])
          (set! (-> lk func-types) (cons sig (-> lk func-types)))
          (+= (-> lk func-type-count) 1)
          (datum-put! (-> lk func-type-index) sig i)
          i))))

(define (tag-type-index [lk (ptr linker)] [t datum]) -> datum (type-index lk `(func ,(tag-info-params t) ())))

;; A function that ref.func refers to is declared, as wasm requires.
(define (resolve [lk (ptr linker)] [kind datum] [key datum]) -> datum
  (cond [(== kind 'func) (index-of (-> lk funcs) key "a function")]
        [(== kind 'ref-func)
         (let ([n (index-of (-> lk funcs) key "a function")])
           (when (== (datum-get (-> lk declared-set) n) 0)
             (datum-put! (-> lk declared-set) n (boolean 1))
             (set! (-> lk declared) (cons n (-> lk declared))))
           n)]
        [(== kind 'global) (index-of (-> lk globals) key "a global")]
        [(== kind 'type) (type-index lk key)]
        [(== kind 'tag) (index-of (-> lk tags) key "a tag")]
        [(== kind 'blocktype)
         (let ([bt (if (cell? key) (cell-value key) key)])
           (if (and (pair? bt) (== (car bt) 'type)) `(type ,(type-index lk (cadr bt))) bt))]
        [(== kind 'const) (cell-value key)]
        [else (fail "internal: a deferred field of kind ~a" (cons kind nil))]))

(define (link [lk (ptr linker)] [a (ptr asm)] [b (ptr asm)]) -> datum
  (link-body a b (lambda ([kind datum] [key datum]) -> datum (resolve lk kind key))))

(define (number! [t (ptr hash-table)] [items datum] [n u32]) -> u32
  (while (pair? items)
    (hash-set! t (cast u64 (car items)) (+ n 1))
    (+= n 1)
    (set! items (cdr items)))
  n)

(define (link-module [ms (ptr mstate)] [compiled (ptr compiled)] [start-fc (ptr fctx)] [setup (ptr asm)]
                     [literal-segment datum] [global-forms datum] [tag-forms datum] [memory-form datum]
                     [table-form datum] [constants (ptr hash-table)]) -> datum
  (let* ([lk (cast (ptr linker) (arena-alloc (current-arena) (sizeof linker)))]
         [has-start (or (> (asm-size setup) 0) (> (asm-size (-> start-fc asm)) 0))]
         [func-imports (reverse (-> ms func-imports))]
         [global-imports (reverse (-> ms global-imports))]
         [tag-imports (reverse (-> ms tag-imports))]
         [synths (reverse (-> ms synths))]
         [n-func-imports (length func-imports)]
         [infos nil] [cf compiled] [start-index u32 0]
         [imports datum nil] [wfuncs nil] [wglobals nil] [exports nil] [names nil]
         [m wmodule] [out (make-buffer)] [bytes datum 0])
    (set! (-> lk funcs) (make-table))
    (set! (-> lk globals) (make-table))
    (set! (-> lk tags) (make-table))
    (set! (-> lk func-types) nil)
    (set! (-> lk func-type-count) 0)
    (set! (-> lk func-type-index) (make-table))
    (set! (-> lk declared) nil)
    (set! (-> lk declared-set) (make-table))
    ;; ---- index assignment ----
    (number! (-> lk tags) (append tag-imports (map (lambda ([f datum]) -> datum (cadr f)) tag-forms)) 0)
    (while (!= cf 0)
      (set! infos (cons (-> cf info) infos))
      (set! cf (-> cf next)))
    (set! start-index (number! (-> lk funcs) (append func-imports (reverse infos)) 0))
    (number! (-> lk globals) (append global-imports (append (map (lambda ([f datum]) -> datum (cadr f)) global-forms) synths)) 0)
    ;; ---- imports ----
    (for-each (lambda ([info datum])
                (set! imports (cons `(,(func-info-instance info) ,(func-info-export info) func
                                      ,(type-index lk `(func ,(func-info-params info) ,(func-info-results info))))
                                    imports)))
              func-imports)
    (for-each (lambda ([g datum])
                (set! imports (cons `(,(global-info-instance g) ,(global-info-export g) global
                                      (,(global-info-type g) ,(global-info-mutable? g)))
                                    imports)))
              global-imports)
    (for-each (lambda ([t datum])
                (set! imports (cons `(,(tag-info-instance t) ,(tag-info-export t) tag ,(tag-type-index lk t)) imports)))
              tag-imports)
    (when (imported-storage? memory-form) (set! imports (cons `(,(cadr memory-form) "memory" memory (0 #f)) imports)))
    (when (imported-storage? table-form) (set! imports (cons `(,(cadr table-form) "table" table (0 #f)) imports)))
    (set! imports (reverse imports))
    ;; ---- functions ----
    (set! cf compiled)
    (while (!= cf 0)
      (set! wfuncs (cons `(,(type-index lk (-> cf sig)) ,(-> cf locals) ,(link lk (-> cf asm) 0) ,(func-info-export (-> cf info)))
                         wfuncs))
      (set! cf (-> cf next)))
    (when has-start
      (set! wfuncs (cons `(,(type-index lk '(func () ())) ,(reverse (-> start-fc extra)) ,(link lk setup (-> start-fc asm)) "__start")
                         wfuncs)))
    (set! wfuncs (reverse wfuncs))
    ;; ---- globals ----
    (for-each (lambda ([f datum])
                (let* ([info (cadr f)] [t (global-info-type info)] [init (cast (ptr asm) (hash-ref constants (cast u64 info)))])
                  (set! wglobals (cons `(,t ,(global-info-mutable? info)
                                         ,(linked-bytes (link lk (if (!= init 0) init (zero-asm t)) 0)))
                                       wglobals))))
              global-forms)
    (for-each (lambda ([s datum])
                (set! wglobals (cons `(i32 #t ,(linked-bytes (link lk (zero-asm 'i32) 0))) wglobals)))
              synths)
    (set! wglobals (reverse wglobals))
    ;; ---- exports ----
    ;; Memory and table are exported as "memory" and "table": the host finds the caller's that way.
    (set! cf compiled)
    (while (!= cf 0)
      (set! exports (cons `(,(func-info-export (-> cf info)) func ,(index-of (-> lk funcs) (-> cf info) "a function")) exports))
      (set! cf (-> cf next)))
    (for-each (lambda ([f datum])
                (set! exports (cons `(,(global-info-export (cadr f)) global ,(index-of (-> lk globals) (cadr f) "a global")) exports)))
              global-forms)
    (for-each (lambda ([f datum])
                (set! exports (cons `(,(tag-info-export (cadr f)) tag ,(index-of (-> lk tags) (cadr f) "a tag")) exports)))
              tag-forms)
    (when (!= memory-form 0) (set! exports (cons '("memory" memory 0) exports)))
    (when (!= table-form 0) (set! exports (cons '("table" table 0) exports)))
    (set! exports (reverse exports))
    ;; ---- names ----
    (for-each (lambda ([info datum])
                (set! names (cons (cons (index-of (-> lk funcs) info "a function")
                                        (format-message "~a.~a" `(,(func-info-instance info) ,(func-info-export info))))
                                  names)))
              func-imports)
    (let ([i i64 n-func-imports] [fs wfuncs])
      (while (pair? fs)
        (set! names (cons (cons (small i) (cadddr (car fs))) names))
        (+= i 1)
        (set! fs (cdr fs))))
    (set! names (reverse names))
    ;; ---- the module ----
    (set! (-> m tags) (map (lambda ([f datum]) -> datum (tag-type-index lk (cadr f))) tag-forms))
    (set! (-> m types) (reverse (-> lk func-types)))
    (set! (-> m imports) imports)
    (set! (-> m funcs) wfuncs)
    (set! (-> m tables) (if (and (!= table-form 0) (not (imported-storage? table-form))) `((,(cadr table-form) #f)) nil))
    (set! (-> m memories) (if (and (!= memory-form 0) (not (imported-storage? memory-form))) `((,(cadr memory-form) #f)) nil))
    (set! (-> m globals) wglobals)
    (set! (-> m exports) exports)
    (set! (-> m start) (if has-start (small start-index) 0))
    (set! (-> m declared) (reverse (-> lk declared)))
    (set! (-> m datas) (if (!= literal-segment 0) (cons literal-segment nil) nil))
    (set! (-> m names) (cons (-> ms self) names))
    (encode-module (& m) (& out))
    (set! bytes (bytes->string (-> out bytes) (-> out length)))
    (buffer-free! (& out))
    `(,bytes ,(import-instances imports) ,(if (!= (-> ms literals) 0) (serializer-scope-table (-> ms literals)) nil))))
