;; Lifecycle: permanent. Part of the compiler.
;;
;; The byte format of kernel data (compiler/kernel.sub, "quoted
;; data"). The compiler writes a linklet's quoted data in it (spec 3.5).
(require-unqualified substrate "../lib/substrate.sub")
(require stx "stx.sub" stx? stx-e stx-scopes stx-srcloc stx-props
         srcloc? srcloc-source srcloc-line srcloc-col srcloc-pos srcloc-span)
(require leb "leb128.sub" write-uleb write-sleb)
(require num "numbers.sub" flonum-bits integer-negative integer-magnitude-byte)

(provide make-serializer serialize! serializer-bytes serializer-scope-table)

;; Objects are written as they are met, each after the objects it is made
;; of. Equal objects, all immutable, are written once and shared, as Scheme
;; allows of literals: a fixnum, symbol or keyword is its own key, a pair
;; is keyed by its parts' indexes, in a table per car, and the rest by
;; their parts in a list. A syntax object's scopes are written as indexes into
;; the scope table, the scopes met so far in order (spec 3.5), so the
;; bytes do not depend on the run that assigned the scopes.
(struct serializer (out [count #:mutable] shared fixnums atoms pairs scopes [table #:mutable]))

(define (make-serializer)
  (serializer (open-output-bytes) 0 (make-hash) (make-hasheqv) (make-hasheq) (make-hasheqv) (make-hasheqv) '()))

;; The index of scope sc in the table, added if it is new.
(define (scope-index! s sc)
  (or (hash-ref (serializer-scopes s) sc #f)
      (let ([i (hash-count (serializer-scopes s))])
        (hash-set! (serializer-scopes s) sc i)
        (set-serializer-table! s (cons sc (serializer-table s)))
        i)))

;; The scope table: the run's scope for each index.
(define (serializer-scope-table s) (reverse (serializer-table s)))

;; Write an object with write!, unless one with the same key in table was.
;; Returns its index.
(define (object! s table key write!)
  (or (hash-ref table key #f)
      (let ([i (serializer-count s)])
        (write!)
        (set-serializer-count! s (+ i 1))
        (hash-set! table key i)
        i)))

(define (shared! s key write!) (object! s (serializer-shared s) key write!))

(define (bytes! p bs)
  (write-uleb (bytes-length bs) p)
  (write-bytes bs p))

(define (utf8! p str) (bytes! p (string->bytes/utf-8 str)))

;; The index of datum d, writing it if need be.
(define (serialize! s d)
  (let ([p (serializer-out s)])
    (let loop ([d d])
      (cond
        [(eq? d #f) (shared! s '(0) (lambda () (write-byte 0 p)))]
        [(fixnum? d) (object! s (serializer-fixnums s) d (lambda () (write-byte 1 p) (write-sleb d p)))]
        [(integer? d)
         ;; Beyond the fixnum range: a sign and a 64-bit magnitude.
         (let ([sign (if (integer-negative d) 1 0)]
               [magnitude (map (lambda (i) (integer-magnitude-byte d i)) (range 8))])
           (shared! s (cons 10 (cons sign magnitude))
                    (lambda ()
                      (write-byte 10 p)
                      (write-byte sign p)
                      (for-each (lambda (b) (write-byte b p)) magnitude))))]
        [(eq? d #t) (shared! s '(2) (lambda () (write-byte 2 p)))]
        [(null? d) (shared! s '(3) (lambda () (write-byte 3 p)))]
        [(char? d) (shared! s (list 4 d) (lambda () (write-byte 4 p) (write-uleb (char->integer d) p)))]
        ;; A list: its elements, its tail, then its pairs from the last,
        ;; the order recursion on car then cdr writes them in, without
        ;; that recursion's depth.
        [(pair? d)
         (let spine ([l d] [cars '()])
           (if (pair? l)
               (spine (cdr l) (cons (loop (car l)) cars))
               (foldl (lambda (a b)
                        (object! s (or (hash-ref (serializer-pairs s) a #f)
                                       (let ([t (make-hasheqv)]) (hash-set! (serializer-pairs s) a t) t))
                                 b (lambda () (write-byte 5 p) (write-uleb a p) (write-uleb b p))))
                      (loop l) cars)))]
        [(symbol? d) (object! s (serializer-atoms s) d (lambda () (write-byte 6 p) (utf8! p (symbol->string d))))]
        [(string? d) (shared! s (list 7 d) (lambda () (write-byte 7 p) (utf8! p d)))]
        [(bytes? d) (shared! s (list 14 d) (lambda () (write-byte 14 p) (bytes! p d)))]
        [(keyword? d) (object! s (serializer-atoms s) d (lambda () (write-byte 13 p) (utf8! p (keyword->string d))))]
        [(stx? d)
         (let* ([e (loop (stx-e d))] [sc (loop (map (lambda (x) (scope-index! s x)) (stx-scopes d)))]
                [l (loop (stx-srcloc d))] [r (loop (stx-props d))])
           (shared! s (list 8 e sc l r)
                    (lambda () (write-byte 8 p) (for-each (lambda (i) (write-uleb i p)) (list e sc l r)))))]
        [(srcloc? d)
         (let ([src (loop (srcloc-source d))]
               [fields (list (srcloc-line d) (srcloc-col d) (srcloc-pos d) (srcloc-span d))])
           (shared! s (cons 9 (cons src fields))
                    (lambda () (write-byte 9 p) (write-uleb src p) (for-each (lambda (n) (write-sleb n p)) fields))))]
        [(number? d)
         (let ([bits (flonum-bits d)])
           (shared! s (list 11 bits)
                    (lambda ()
                      (write-byte 11 p)
                      (for-each (lambda (i) (write-byte (bitwise-and (arithmetic-shift bits (* -8 i)) 255) p))
                                (range 8)))))]
        [else (error 'serialize "cannot quote ~s" d)]))))

;; The bytes: the number of objects, then the objects.
(define (serializer-bytes s)
  (call-with-output-bytes
   (lambda (p)
     (write-uleb (serializer-count s) p)
     (write-bytes (get-output-bytes (serializer-out s)) p))))
