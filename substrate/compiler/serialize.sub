;; The serializer: kernel data as bytes, in the format kernel.sub's deserialize reads.
(require-unqualified k "kernel.sub")
(require-unqualified leb "leb128.sub")
(require-unqualified numbers "numbers.sub")

(provide serializer make-serializer serialize! serializer-bytes serializer-scope-table)

(struct serializer [out buffer] [count u32] [shared (ptr arena-table)] [fixnums (ptr arena-table)]
        [atoms (ptr arena-table)] [pairs (ptr arena-table)] [scopes (ptr arena-table)] [table datum])

(define (make-serializer) -> (ptr serializer)
  (let ([s (cast (ptr serializer) (alloc-in (current-arena) (sizeof serializer)))])
    (set! (-> s out) (make-buffer))
    (set! (-> s count) 0)
    (set! (-> s shared) (make-table))
    (set! (-> s fixnums) (make-table))
    (set! (-> s atoms) (make-table))
    (set! (-> s pairs) (make-table))
    (set! (-> s scopes) (make-table))
    (set! (-> s table) nil)
    s))

;; Scopes are written as their indexes in the scope table, so the bytes do not
;; depend on the run that made the scopes.
(define (scope-index! [s (ptr serializer)] [sc u32]) -> u32
  (let ([known (table-ref (-> s scopes) (+ (cast u64 sc) 1))])
    (if (!= known 0)
        (- known 1)
        (let ([i (table-count (-> s scopes))])
          (table-set! (-> s scopes) (+ (cast u64 sc) 1) (+ i 1))
          (set! (-> s table) (cons (make-integer sc) (-> s table)))
          i))))

(define (serializer-scope-table [s (ptr serializer)]) -> datum (reverse (-> s table)))

(define (added! [s (ptr serializer)] [t (ptr arena-table)] [key u64]) -> u32
  (let ([i (-> s count)])
    (+= (-> s count) 1)
    (table-set! t key (+ i 1))
    i))

(define (shared-index [s (ptr serializer)] [key datum]) -> u32
  (let ([i (datum-get (-> s shared) key)]) (if (== i 0) 0 (+ (cast u32 (integer-value i)) 1))))

(define (shared-added! [s (ptr serializer)] [key datum]) -> u32
  (let ([i (-> s count)])
    (+= (-> s count) 1)
    (datum-put! (-> s shared) key (make-integer i))
    i))

(define (bytes! [p (ptr buffer)] [bytes (ptr u8)] [n u32])
  (write-uleb p n)
  (buffer-add! p bytes n))

(define (small [n i64]) -> datum (make-integer n))

(define (serialize! [s (ptr serializer)] [d datum]) -> u32
  (let ([p (& (-> s out))] [i u32 0])
    (cond
      [(== d 0)
       (set! i (shared-index s `(0)))
       (if (!= i 0) (- i 1) (begin (buffer-add-byte! p 0) (shared-added! s `(0))))]
      [(fixnum? d)
       (let ([key (+ (cast u64 (integer-value d)) 1099511627776)])
         (set! i (table-ref (-> s fixnums) key))
         (if (!= i 0)
             (- i 1)
             (begin (buffer-add-byte! p 1) (write-sleb p (integer-value d)) (added! s (-> s fixnums) key))))]
      [(integer? d)
       (let* ([negative (integer-negative? d)] [v (integer-value d)]
              [magnitude (if negative (- 0 v) v)]
              [key `(10 ,(small negative) ,(make-unsigned-integer (cast u64 magnitude)))])
         (set! i (shared-index s key))
         (if (!= i 0)
             (- i 1)
             (begin (buffer-add-byte! p 10)
                    (buffer-add-byte! p negative)
                    (for ([k u32 0]) (< k 8) (+= k 1)
                      (buffer-add-byte! p (cast i32 (bit-and (>> (cast u64 magnitude) (* 8 k)) 255))))
                    (shared-added! s key))))]
      [(== d (boolean 1))
       (set! i (shared-index s `(2)))
       (if (!= i 0) (- i 1) (begin (buffer-add-byte! p 2) (shared-added! s `(2))))]
      [(null? d)
       (set! i (shared-index s `(3)))
       (if (!= i 0) (- i 1) (begin (buffer-add-byte! p 3) (shared-added! s `(3))))]
      [(char? d)
       (let ([key `(4 ,d)])
         (set! i (shared-index s key))
         (if (!= i 0)
             (- i 1)
             (begin (buffer-add-byte! p 4) (write-uleb p (char->integer d)) (shared-added! s key))))]
      [(pair? d) (serialize-list! s d)]
      [(symbol? d)
       (set! i (table-ref (-> s atoms) (cast u64 d)))
       (if (!= i 0)
           (- i 1)
           (begin (buffer-add-byte! p 6) (bytes! p (symbol-bytes d) (symbol-length d)) (added! s (-> s atoms) (cast u64 d))))]
      [(string? d)
       (let ([key `(7 ,d)])
         (set! i (shared-index s key))
         (if (!= i 0)
             (- i 1)
             (begin (buffer-add-byte! p 7) (bytes! p (string-bytes d) (string-length d)) (shared-added! s key))))]
      [(keyword? d)
       (set! i (table-ref (-> s atoms) (cast u64 d)))
       (if (!= i 0)
           (- i 1)
           (let ([name (keyword->string d)])
             (buffer-add-byte! p 13)
             (bytes! p (string-bytes name) (string-length name))
             (added! s (-> s atoms) (cast u64 d))))]
      [(syntax? d) (serialize-syntax! s d)]
      [(flonum? d)
       (let* ([bits (f64-bits (flonum-value d))] [key `(11 ,(make-integer bits))])
         (set! i (shared-index s key))
         (if (!= i 0)
             (- i 1)
             (begin (buffer-add-byte! p 11)
                    (for ([k u32 0]) (< k 8) (+= k 1)
                      (buffer-add-byte! p (cast i32 (bit-and (>> (cast u64 bits) (* 8 k)) 255))))
                    (shared-added! s key))))]
      [else (raise-compile-error 0 (format-message "internal: serialize: cannot quote ~s" (cons d nil))) 0])))

;; In the order that recursion on car then cdr would write, without its depth.
(define (serialize-list! [s (ptr serializer)] [d datum]) -> u32
  (let ([cars nil] [l d] [b u32 0] [key u64 0] [i u32 0] [p (& (-> s out))])
    (while (pair? l)
      (set! cars (cons (make-integer (serialize! s (car l))) cars))
      (set! l (cdr l)))
    (set! b (serialize! s l))
    (while (pair? cars)
      (let ([a (cast u32 (integer-value (car cars)))])
        (set! key (bit-or (<< (+ (cast u64 a) 1) 32) b))
        (set! i (table-ref (-> s pairs) key))
        (set! b (if (!= i 0)
                    (- i 1)
                    (begin (buffer-add-byte! p 5) (write-uleb p a) (write-uleb p b) (added! s (-> s pairs) key)))))
      (set! cars (cdr cars)))
    b))

(define (serialize-syntax! [s (ptr serializer)] [d datum]) -> u32
  (let* ([e (serialize! s (syntax-e d))]
         [sc (serialize! s (scope-indexes s (syntax-scopes d)))]
         [l (serialize-srcloc! s (syntax-srcloc d))]
         [r (serialize! s (syntax-props d))]
         [key `(8 ,(small e) ,(small sc) ,(small l) ,(small r))]
         [i (shared-index s key)]
         [p (& (-> s out))])
    (if (!= i 0)
        (- i 1)
        (begin (buffer-add-byte! p 8) (write-uleb p e) (write-uleb p sc) (write-uleb p l) (write-uleb p r)
               (shared-added! s key)))))

(define (scope-indexes [s (ptr serializer)] [set (ptr scope-set)]) -> datum
  (let ([out nil])
    (for ([k u32 0]) (< k (-> set count)) (+= k 1)
      (set! out (cons (make-integer (scope-index! s (@ (-> set ids) k))) out)))
    (reverse out)))

(define (serialize-srcloc! [s (ptr serializer)] [l (ptr srcloc)]) -> u32
  (if (== l 0)
      (serialize! s 0)
      (let* ([src (serialize! s (-> l source))]
             [key `(9 ,(small src) ,(small (-> l line)) ,(small (-> l col)) ,(small (-> l pos)) ,(small (-> l span)))]
             [i (shared-index s key)]
             [p (& (-> s out))])
        (if (!= i 0)
            (- i 1)
            (begin (buffer-add-byte! p 9)
                   (write-uleb p src)
                   (write-sleb p (-> l line))
                   (write-sleb p (-> l col))
                   (write-sleb p (-> l pos))
                   (write-sleb p (-> l span))
                   (shared-added! s key))))))

(define (serializer-bytes [s (ptr serializer)]) -> datum
  (let ([q (make-buffer)] [out datum 0])
    (write-uleb (& q) (-> s count))
    (buffer-add! (& q) (-> s out bytes) (-> s out length))
    (set! out (bytes->string (-> q bytes) (-> q length)))
    (buffer-free! (& q))
    (buffer-free! (& (-> s out)))
    out))
