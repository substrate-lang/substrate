;; Lifecycle: permanent. Part of the compiler.
;;
;; The byte format of kernel data (compiler/kernel.sub, "quoted
;; data"). The compiler writes a linklet's quoted data in it (spec 3.5).
(require-unqualified substrate "../lib/substrate.sub")
(require stx "stx.sub" stx? stx-e stx-scopes stx-srcloc stx-props
         srcloc? srcloc-source srcloc-line srcloc-col srcloc-pos srcloc-span)
(require leb "leb128.sub" write-uleb write-sleb)
(require num "numbers.sub" flonum-bits integer-negative integer-magnitude-byte)

(provide make-serializer serialize! serializer-bytes)

;; Objects are written as they are met, each after the objects it is made
;; of. Equal objects, all immutable, are written once and shared, as Scheme
;; allows of literals.
(struct serializer (out [count #:mutable] shared))

(define (make-serializer) (serializer (open-output-bytes) 0 (make-hash)))

;; Write an object with write!, unless one with the same key was; a key of
;; #f is never shared. Returns its index.
(define (object! s key write!)
  (or (and key (hash-ref (serializer-shared s) key #f))
      (let ([i (serializer-count s)])
        (write!)
        (set-serializer-count! s (+ i 1))
        (when key (hash-set! (serializer-shared s) key i))
        i)))

(define (utf8! p str)
  (let ([bs (string->bytes/utf-8 str)])
    (write-uleb (bytes-length bs) p)
    (write-bytes bs p)))

;; The index of datum d, writing it if need be.
(define (serialize! s d)
  (let ([p (serializer-out s)])
    (let loop ([d d])
      (cond
        [(eq? d #f) (object! s '(0) (lambda () (write-byte 0 p)))]
        [(fixnum? d) (object! s (list 1 d) (lambda () (write-byte 1 p) (write-sleb d p)))]
        [(integer? d)
         ;; Beyond the fixnum range: a sign and a 64-bit magnitude.
         (let ([sign (if (integer-negative d) 1 0)]
               [magnitude (map (lambda (i) (integer-magnitude-byte d i)) (range 8))])
           (object! s (cons 10 (cons sign magnitude))
                    (lambda ()
                      (write-byte 10 p)
                      (write-byte sign p)
                      (for-each (lambda (b) (write-byte b p)) magnitude))))]
        [(eq? d #t) (object! s '(2) (lambda () (write-byte 2 p)))]
        [(null? d) (object! s '(3) (lambda () (write-byte 3 p)))]
        [(char? d) (object! s (list 4 d) (lambda () (write-byte 4 p) (write-uleb (char->integer d) p)))]
        [(pair? d)
         (let* ([a (loop (car d))] [b (loop (cdr d))])
           (object! s (list 5 a b) (lambda () (write-byte 5 p) (write-uleb a p) (write-uleb b p))))]
        [(symbol? d) (object! s (list 6 d) (lambda () (write-byte 6 p) (utf8! p (symbol->string d))))]
        [(string? d) (object! s (list 7 d) (lambda () (write-byte 7 p) (utf8! p d)))]
        [(keyword? d) (object! s (list 13 d) (lambda () (write-byte 13 p) (utf8! p (keyword->string d))))]
        [(stx? d)
         (let* ([e (loop (stx-e d))] [sc (loop (stx-scopes d))]
                [l (loop (stx-srcloc d))] [r (loop (stx-props d))])
           (object! s (list 8 e sc l r)
                    (lambda () (write-byte 8 p) (for-each (lambda (i) (write-uleb i p)) (list e sc l r)))))]
        [(srcloc? d)
         (let ([src (loop (srcloc-source d))]
               [fields (list (srcloc-line d) (srcloc-col d) (srcloc-pos d) (srcloc-span d))])
           (object! s (cons 9 (cons src fields))
                    (lambda () (write-byte 9 p) (write-uleb src p) (for-each (lambda (n) (write-sleb n p)) fields))))]
        [(number? d)
         (let ([bits (flonum-bits d)])
           (object! s (list 11 bits)
                    (lambda ()
                      (write-byte 11 p)
                      (for-each (lambda (i) (write-byte (bitwise-and (arithmetic-shift bits (* -8 i)) 255) p))
                                (range 8)))))]
        [else (error 'serialize "cannot quote ~s" d)]))))

;; The bytes: the number of objects, then the objects.
(define (serializer-bytes s)
  (call-with-output-bytes
   (lambda (p)
     (write-uleb (serializer-count s) p)
     (write-bytes (get-output-bytes (serializer-out s)) p))))
