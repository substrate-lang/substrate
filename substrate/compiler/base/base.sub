;; Lifecycle: permanent.
;;
;; The C-like Lisp in one module: the language (lang.sub), its allocator,
;; arenas, buffers and hash tables (runtime.sub), and its math (math.sub).
;; A module takes it with require-unqualified and shares its memory and
;; table with (memory from base) and (table from base).
(require-unqualified lang "lang.sub")
(require-unqualified runtime "runtime.sub")
(require-unqualified math "math.sub")

(provide (all-from-out lang) (all-from-out runtime) (all-from-out math))

(memory from lang)
(table from lang)
