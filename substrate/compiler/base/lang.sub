;; Base: C's types, memory and control as s-expressions, compiled to wasm.

(require memory "../memory.sub")
(require print "../print.sub")
;; The kernel module is required only for c-interaction, which prints floats in a session;
;; nothing else here calls it, so ordinary programs do not import it.
(require kd kernel)
(begin-for-syntax
  (require k kernel)
  (require sm "../syntax-match.sub" syntax-match _ ... ?)
  (require-unqualified kf "../kernel-forms.sub"))

(provide [define c-define] [struct c-struct] [union c-union] [variant c-variant] [match c-match] [exception c-exception] [throw c-throw] [try c-try] [lambda c-lambda] inst typedef const [let c-let] [let* c-let*] [set! c-set!]
         [#%datum c-datum] [#%top-interaction c-interaction] [#%module-begin c-module-begin]
         when unless cond case while for break continue and or not cast sizeof offsetof array-of @ & ->
         + - * / % == != < <= > >= bit-and bit-or bit-xor bit-not << >>
         += -= *= /= %= <<= >>= bit-and= bit-or= bit-xor= sbrk reset-stack!)

(memory from memory)

;; Table index 0 holds no function: it is the null function pointer.
(table 1)

;; Memory past the heap's end has not been given out, so it is zero.
(global brk (mut i32) memory:heap-start)

;; Memory grows by at least as much as it has: an engine may pay for each growth, as V8 does.
(func (sbrk [n i32]) -> i32
  (let* ([p brk] [end (i32.and (i32.add (i32.add brk n) 7) -8)] [size (i32.shl (memory.size) 16)]
         [need (i32.shr_u (i32.add (i32.sub end size) 65535) 16)])
    (if (i32.gt_u end size)
        (if (i32.lt_s (memory.grow (if (i32.gt_u (memory.size) need) (memory.size) need)) 0)
            (if (i32.lt_s (memory.grow need) 0) (return 0))))
    (set! brk end)
    p))

;; 4 MiB, as deep as the engine's own call stack.
(global stack-base (mut i32) (sbrk 4194304))
(global sp (mut i32) (i32.add stack-base 4194304))

;; Call it first thing after a trap, which abandons the running functions' frames without
;; popping them.
(func (reset-stack!) (set! sp (i32.add stack-base 4194304)))

(begin-for-syntax
  (func (c-error [where i32] [form i32] [args i32]) -> i32 (k:raise-syntax-error 'c (k:format form args) (written where)))

  (func (written [e i32]) -> i32
    (syntax-match e
      [('#%datum d) d]
      [('quote ('#%c-string s)) s]
      [('quote ('#%c-sizeof t)) (k:syntax-rewrap e `(sizeof ,t))]
      [('quote ('#%c-offsetof t f)) (k:syntax-rewrap e `(offsetof ,t ,f))]
      [('quote ('#%c-function f)) (k:syntax-rewrap e `(& ,f))]
      [('quote ('#%c-construct _ _ n)) n]
      [('quote ('#%c-generic (f . _))) f]
      [('quote ('#%c-inst (f . _) ts)) (k:syntax-rewrap e (k:cons 'inst (k:cons f (k:syntax->list ts))))]
      [('#%app ('quote ((? k:identifier? m) . data)) arg ...)
       (let ([ws (for/list ([a arg]) (written a))] [data (k:syntax->list data)])
         (k:syntax-rewrap e (case (k:syntax-e m)
                              [(#%c-op) (k:cons (k:car data) ws)]
                              [(#%c-cast) (k:cons 'cast (k:cons (k:car data) ws))]
                              [(#%c-update) (k:cons (k:string->symbol (k:format '"~a=" `(,(k:syntax-e (k:car data))))) ws)]
                              [(#%c-arrow) `(-> ,(k:car ws) ,(k:car data))]
                              [(#%c-deref) (k:cons '@ ws)]
                              [(#%c-addr) (k:cons '& ws)]
                              [(#%c-set!) (k:cons 'set! ws)]
                              [(#%c-while) (k:cons 'while ws)]
                              [(#%c-break) '(break)]
                              [(#%c-continue) '(continue)]
                              [(#%c-construct) (k:cons (k:caddr data) ws)]
                              [(#%c-lambda) (k:cons 'lambda ws)]
                              [(#%c-array-of) (k:cons 'array-of (k:cons (k:car data) ws))]
                              [(#%c-generic) (k:cons (k:car (k:syntax-e (k:car data))) ws)]
                              [(#%c-throw) (k:cons 'throw (k:cons (k:car data) ws))]
                              [(#%c-try) (k:cons 'try ws)]
                              [(#%c-match)
                               (k:cons 'match
                                       (k:cons (k:car ws)
                                               (for/list ([n data] [c (k:cdr ws)])
                                                 (syntax-match c
                                                   [('let ((x _) ...) body ...) (k:cons (k:cons n x) body)]
                                                   [(_ body ...) (k:cons n body)]))))]
                              [else (k:cons (k:syntax-e m) ws)])))]
      [('#%app f arg ...) (k:syntax-rewrap e (k:cons f (for/list ([a arg]) (written a))))]
      [(x ...) (k:syntax-rewrap e (for/list ([y x]) (written y)))]
      [_ e]))

  (func (syn [d i32]) -> i32 (k:datum->syntax #'here d 0))

  (func (at [where i32] [form i32]) -> i32 (k:datum->syntax form (k:syntax-e form) where))

  (global counter (mut i32) 0)
  (func (fresh [base i32]) -> i32
    (set! counter (i32.add counter 1))
    (syn (k:string->symbol (k:format '"~a~a" `(,base ,(k:fixnum counter))))))

  ;; ---- lists and numbers ----

  (func (max [a i32] [b i32]) -> i32 (if (i32.gt_s a b) a b))

  (func (numbers-below [n i32]) -> i32
    (let ([l '()])
      (block done
        (loop next
          (br-if done (i32.le_s n 0))
          (set! n (i32.sub n 1))
          (set! l (k:cons (k:fixnum n) l))
          (br next)))
      l))

  (func (append-all [ls i32]) -> i32 (for/fold ([acc '()]) ([l (k:reverse ls)]) (k:append l acc)))

  (func (but-last [l i32]) -> i32 (k:take l (i32.sub (k:length l) 1)))

  (func (plural [n i32]) -> i32 (if (i32.eq n 1) '"" '"s"))

  ;; ---- types ----

  (func (integer-type? [t i32]) -> i32 (k:memq t '(i8 u8 i16 u16 i32 u32 i64 u64 lit)))
  (func (float-type? [t i32]) -> i32 (k:memq t '(f32 f64 flit)))
  (func (arithmetic? [t i32]) -> i32 (or (integer-type? t) (float-type? t)))
  (func (pointer? [t i32]) -> i32 (and (k:pair? t) (i32.eq (k:car t) 'ptr)))
  (func (fn-type? [t i32]) -> i32 (and (k:pair? t) (i32.eq (k:car t) 'fn)))
  (func (address-type? [t i32]) -> i32 (or (pointer? t) (fn-type? t)))
  (func (closure-type? [t i32]) -> i32 (and (k:pair? t) (i32.eq (k:car t) 'closure)))
  (func (array-type? [t i32]) -> i32 (and (k:pair? t) (i32.eq (k:car t) 'array)))
  (func (struct-type? [t i32]) -> i32 (and (k:pair? t) (i32.eq (k:car t) 'struct)))
  (func (aggregate? [t i32]) -> i32 (or (array-type? t) (struct-type? t)))

  (func (promoted [t i32]) -> i32 (if (k:memq t '(i8 u8 i16 u16)) 'i32 t))

  (func (settled-type [t i32]) -> i32 (case t [(lit) 'i32] [(flit) 'f64] [else t]))

  (func (kernel-type [t i32]) -> i32
    (cond [(or (k:memq t '(i64 u64)) (closure-type? t)) 'i64]
          [(k:memq t '(f32 f64)) t]
          [(i32.eq t 'flit) 'f64]
          [else 'i32]))

  (func (shown [t i32]) -> i32
    (cond [(pointer? t) `(ptr ,(shown (k:cadr t)))]
          [(or (fn-type? t) (closure-type? t))
           `(,(k:car t) ,(for/list ([u (k:cadr t)]) (shown u)) ,@(if (i32.eq (k:caddr t) 'void) '() `(-> ,(shown (k:caddr t)))))]
          [(array-type? t) `(array ,(shown (k:cadr t)) ,(k:caddr t))]
          [(struct-type? t) (if (k:pair? (k:cdddr t)) (k:cons (k:caddr t) (for/list ([u (k:cadddr t)]) (shown u))) (k:caddr t))]
          [(and (k:pair? t) (i32.eq (k:car t) 'tvar)) (k:cadr t)]
          [(i32.eq t 'none) 'void]
          [else (settled-type t)]))

  (global type-arguments (mut i32) 0)

  (func (type-variables [ps i32]) -> i32 (for/list ([p ps]) (k:cons p `(tvar ,p))))

  (func (parse-types-with [s i32] [ts i32]) -> i32
    (let ([saved type-arguments] [r '()])
      (set! type-arguments s)
      (set! r (for/list ([t ts]) (parse-type t)))
      (set! type-arguments saved)
      r))

  (func (parse-type [s i32]) -> i32
    (syntax-match s
      [('quote t) (k:syntax->datum t)]
      [(? k:identifier? x)
       (let ([bound (k:assq (k:syntax-e x) type-arguments)])
         (cond [bound (k:cdr bound)]
               [(k:memq (k:syntax-e x) '(void i8 u8 i16 u16 i32 u32 i64 u64 f32 f64)) (k:syntax-e x)]
               [else (named-type x)]))]
      [('ptr t) `(ptr ,(parse-type t))]
      [('array t n)
       (let ([m (k:syntax-e n)])
         (unless (and (k:integer? m) (i32.eqz (k:integer-negative? m))) (c-error n '"an array's length is a count" '())))
       `(array ,(kept! (complete! (parse-type t) t) t) ,(k:syntax-e n))]
      [('fn (t ...) '-> r) `(fn ,(for/list ([u t]) (value-type! (parse-type u) u)) ,(result-type! r))]
      [('fn (t ...)) `(fn ,(for/list ([u t]) (value-type! (parse-type u) u)) void)]
      [('closure (t ...) '-> r) `(closure ,(for/list ([u t]) (value-type! (parse-type u) u)) ,(scalar! (parse-type r) r))]
      [('closure (t ...)) `(closure ,(for/list ([u t]) (value-type! (parse-type u) u)) void)]
      [((? k:identifier? h) a ...) (applied-type s h a)]
      [_ (c-error s '"expected a type" '())]))

  (func (applied-type [s i32] [h i32] [a i32]) -> i32
    (let ([v (type-binding h)])
      (unless (and v (i32.eq (k:car v) 'c-struct) (k:pair? (parameters-of v)))
        (c-error h '"~a is not a type that takes types" `(,(k:syntax-e h))))
      (unless (i32.eq (k:length a) (k:length (parameters-of v)))
        (c-error s '"~a takes ~a type~a, not ~a"
                 `(,(k:syntax-e h) ,(k:fixnum (k:length (parameters-of v))) ,(plural (k:length (parameters-of v))) ,(k:fixnum (k:length a)))))
      `(struct ,(k:identifier-name h) ,(k:cadr v) ,(for/list ([t a]) (kept! (complete! (parse-type t) t) t)))))

  (func (parameters-of [v i32]) -> i32 (if (i32.gt_u (k:length v) 4) (k:list-ref v 4) '()))

  (func (type-binding [x i32]) -> i32
    (let ([v (and (i32.eq (k:identifier-binding-kind x) 'compile-time-value) (k:syntax-local-value x))])
      (and (k:pair? v) (k:memq (k:car v) '(c-struct c-typedef)) v)))

  (func (named-type [x i32]) -> i32
    (let ([v (or (type-binding x) (c-error x '"~a is not a type" `(,(k:syntax-e x))))])
      (cond [(i32.eq (k:car v) 'c-typedef) (k:cadr v)]
            [(k:pair? (parameters-of v)) (c-error x '"~a takes types: write (~a type ...)" `(,(k:syntax-e x) ,(k:syntax-e x)))]
            [else `(struct ,(k:identifier-name x) ,(k:cadr v))])))

  (func (type-syntax? [s i32]) -> i32
    (syntax-match s
      [(? k:identifier? x)
       (if (or (k:memq (k:syntax-e x) '(i8 u8 i16 u16 i32 u32 i64 u64 f32 f64)) (type-binding x)) 1 0)]
      [((? k:identifier? h) . _)
       (if (k:memq (k:syntax-e h) '(ptr array fn closure))
           1
           (let ([v (type-binding h)]) (if (and v (i32.eq (k:car v) 'c-struct) (k:pair? (parameters-of v))) 1 0)))]
      [_ 0]))

  (func (scalar! [t i32] [where i32]) -> i32
    (unless (or (arithmetic? t) (address-type? t))
      (c-error where '"expected a number or pointer type, not ~s" `(,(shown t))))
    t)

  (func (value-type! [t i32] [where i32]) -> i32
    (if (or (struct-type? t) (closure-type? t)) t (scalar! t where)))

  (func (result-type! [r i32]) -> i32
    (let ([t (parse-type r)])
      (cond [(i32.eq t 'void) t]
            [(closure-type? t) (c-error r '"a closure cannot be a result: it lasts only as long as the call that made it" '())]
            [else (value-type! t r)])))

  (func (kept! [t i32] [where i32]) -> i32
    (when (closure-type? t) (c-error where '"a closure cannot be kept in memory: it lasts only as long as the call that made it" '()))
    t)

  (func (complete! [t i32] [where i32]) -> i32
    (cond [(i32.eq t 'void) (c-error where '"void has no size" '())]
          [(array-type? t) (complete! (k:cadr t) where)]
          [(and (struct-type? t) (i32.eq (k:datum-get (layouts) (k:cdr t)) 'laying-out))
           (c-error where '"~a holds itself" `(,(k:caddr t)))])
    t)

  (func (size-of [t i32]) -> i32
    (cond [(k:memq t '(i8 u8)) 1]
          [(k:memq t '(i16 u16)) 2]
          [(or (k:memq t '(i64 u64 f64)) (closure-type? t)) 8]
          [(array-type? t) (i32.mul (k:fixnum-value (k:caddr t)) (size-of (k:cadr t)))]
          [(struct-type? t) (k:fixnum-value (k:car (layout t)))]
          [else 4]))

  (func (alignment [t i32]) -> i32
    (cond [(array-type? t) (alignment (k:cadr t))]
          [(struct-type? t) (k:fixnum-value (k:cadr (layout t)))]
          [else (size-of t)]))

  (func (round-up [n i32] [a i32]) -> i32 (i32.mul (i32.div_s (i32.sub (i32.add n a) 1) a) a))

  (global layout-table (mut i32) 0)
  (func (layouts) -> i32
    (when (i32.eqz layout-table) (set! layout-table (k:make-table)))
    layout-table)

  (func (layout [t i32]) -> i32
    (or (k:datum-get (layouts) (k:cdr t))
        (let* ([v (k:syntax-local-value (k:name-identifier (k:cadr t)))] [items (k:syntax->list (k:caddr v))]
               [saved type-arguments] [l 0])
          (k:datum-put! (layouts) (k:cdr t) 'laying-out)
          (set! type-arguments (for/list ([p (parameters-of v)] [a (if (k:pair? (k:cdddr t)) (k:cadddr t) '())]) (k:cons p a)))
          (set! l (if (i32.eq (k:cadddr v) 'variant)
                      (variant-layout items)
                      (let ([r (lay-out items (i32.eq (k:cadddr v) 'union))])
                        `(,(k:fixnum (round-up (k:fixnum-value (k:car r)) (k:fixnum-value (k:cadr r)))) ,(k:cadr r) ,(k:caddr r)))))
          (set! type-arguments saved)
          (k:datum-put! (layouts) (k:cdr t) l)
          l)))

  (func (variant-layout [items i32]) -> i32
    (let* ([cases (for/list ([c items]) (syntax-match c [(n f ...) (k:cons (k:syntax-e n) (lay-out f 0))]))]
           [align (for/fold ([a 4]) ([c cases]) (max a (k:fixnum-value (k:caddr c))))]
           [start (round-up 4 align)]
           [end (for/fold ([e start]) ([c cases]) (max e (i32.add start (k:fixnum-value (k:cadr c)))))])
      `(,(k:fixnum (round-up end align)) ,(k:fixnum align) ((tag u32 0))
        ,(for/list ([c cases])
           (k:cons (k:car c)
                   (for/list ([f (k:cadddr c)])
                     `(,(k:car f) ,(k:cadr f) ,(k:fixnum (i32.add start (k:fixnum-value (k:caddr f)))))))))))

  (func (lay-out [fs i32] [union i32]) -> i32 (lay-out-from fs union 0 1 '()))

  (func (lay-out-from [fs i32] [union i32] [end i32] [align i32] [out i32]) -> i32
    (if (k:null? fs)
        `(,(k:fixnum end) ,(k:fixnum align) ,(k:reverse out))
        (syntax-match (k:car fs)
          [(f ft)
           (let* ([ty (kept! (complete! (parse-type ft) ft) ft)] [a (alignment ty)] [o (if union 0 (round-up end a))])
             (lay-out-from (k:cdr fs) union (max end (i32.add o (size-of ty))) (max align a)
                           (k:cons `(,(k:syntax-e f) ,ty ,(k:fixnum o)) out)))])))

  (func (variant-type? [t i32]) -> i32 (and (struct-type? t) (i32.eq (k:length (layout t)) 4)))
  (func (cases-of [t i32]) -> i32 (k:cadddr (layout t)))

  ;; ---- definitions ----

  ;; (let () form) waits for the module's second pass, once every definition is declared.
  (func (second-pass [form i32]) -> i32 #`(let () #,form))

  (func (c-define [s i32]) -> i32
    (syntax-match s
      [(_ #:forall ((? k:identifier? p) ...) ((? k:identifier? f) ((? k:identifier? x) t) ...) '-> r body ...) (generic s p f x t r body)]
      [(_ #:forall ((? k:identifier? p) ...) ((? k:identifier? f) ((? k:identifier? x) t) ...) body ...) (generic s p f x t #'void body)]
      [(_ ((? k:identifier? f) ((? k:identifier? x) t) ...) #:inline '-> r body ...) (function s f x t r body f 1)]
      [(_ ((? k:identifier? f) ((? k:identifier? x) t) ...) #:inline body ...) (function s f x t #'void body f 1)]
      [(_ ((? k:identifier? f) ((? k:identifier? x) t) ...) '-> r body ...) (function s f x t r body f 0)]
      [(_ ((? k:identifier? f) ((? k:identifier? x) t) ...) body ...) (function s f x t #'void body f 0)]
      [(_ (? k:identifier? x) t) (global-definition s x t '())]
      [(_ (? k:identifier? x) t init) (global-definition s x t `(,init))]
      [_ (c-error s '"expected (define (f [x type] ...) -> type body ...) or (define x type [value])" '())]))

  (func (function [s i32] [f i32] [xs i32] [ts i32] [r i32] [body i32] [definer i32] [inline i32]) -> i32
    (let* ([ps (for/list ([t ts]) (value-type! (parse-type t) t))]
           [rt (result-type! r)]
           [to (and (struct-type? rt) (fresh 'to))]
           [value (syn (k:string->symbol (k:format '"~a.pointer" `(,(k:syntax-e f)))))])
      #`(begin
          #,(at s #`(func (#,f #,@(if to `(,#`[#,to i32]) '()) #,@(for/list ([x xs] [p ps]) #`[#,x #,(syn (kernel-type p))]))
                      #,@(if inline `(,#'#:inline) '())
                      #:value #,value
                      #,@(if (i32.eq rt 'void) '() `(,#'-> ,(syn (kernel-type rt))))
                      (c-body #,definer (#,@xs) #,(or to #'#f) '#,(syn (k:cons rt ps)) #,@body)))
          (global #,value (mut i32) (func-index #,f))
          (#%fact #,f '#,(syn `(c-function ,ps ,rt))))))

  (func (generic [s i32] [ps i32] [f i32] [xs i32] [ts i32] [r i32] [body i32]) -> i32
    (drop (parse-types-with (type-variables (for/list ([p ps]) (k:syntax-e p))) (k:cons r ts)))
    #`(define-syntax #,f
        (mark-transformer (quote-syntax (#%c-generic (#,f (#,@ps) (#,@(for/list ([x xs] [t ts]) #`[#,x #,t])) #,r (#,@body) #,s))))))

  (func (global-definition [s i32] [x i32] [t i32] [init i32]) -> i32
    (let ([ty (kept! (complete! (parse-type t) t) t)])
      #`(begin
          #,(at s #`(global #,x (mut i32) (c-static #,x '#,(syn ty) #,@init)))
          (#%fact #,x '#,(syn `(c-global ,ty))))))

  ;; A constant is (cast type literal) wherever its name is used.
  (func (c-const [s i32]) -> i32
    (syntax-match s
      [(_ (? k:identifier? x) t (? literal? c)) #`(define-syntax #,x (const-transformer (quote-syntax (cast #,t #,c))))]
      [_ (c-error s '"expected (const name type literal)" '())]))

  (func (literal? [c i32]) -> i32
    (let ([d (k:syntax-e c)]) (or (k:integer? d) (k:flonum? d) (k:char? d) (k:boolean? d) (k:string? d))))

  (func (const-transformer [c i32]) -> i32 (k:make-transformer (func-index const-use) c))

  (func (const-use [c i32] [s i32]) -> i32
    (if (k:identifier? s) (at s c) (c-error s '"a constant is not a function" '())))

  (func (c-static [s i32]) -> i32
    (syntax-match s
      [(_ _ ('quote t)) #`(sbrk #,(syn (k:fixnum (size-of (k:syntax->datum t)))))]
      [(_ x ('quote t) init)
       (let* ([ty (k:syntax->datum t)] [p (fresh 'p)] [e (begin (set! quoter x) (start-function! 'void 0) (k:local-expand init))])
         #`(let ([#,p (sbrk #,(syn (k:fixnum (size-of ty))))])
             #,(with-frame (func-index static-walk) `(,p ,e ,ty))
             #,p))]))

  (func (static-walk [a i32]) -> i32
    (let ([p (k:car a)] [e (k:cadr a)] [t (k:caddr a)])
      (framed '() (k:cons 'void (if (aggregate? t) (as-void (copy-into p e t '())) (store t p 0 (expect e t '() 1)))))))

  ;; A struct is laid out when a type needs it, so a field may point to a struct defined later.
  (func (c-struct [s i32]) -> i32 (aggregate-type s 'struct))
  (func (c-union [s i32]) -> i32 (aggregate-type s 'union))

  (func (aggregate-type [s i32] [kind i32]) -> i32
    (syntax-match s
      [(_ #:forall ((? k:identifier? p) ...) (? k:identifier? name) field ...) (aggregate name field kind p)]
      [(_ (? k:identifier? name) field ...) (aggregate name field kind '())]))

  (func (aggregate [name i32] [fields i32] [kind i32] [ps i32]) -> i32
    (distinct! (for/list ([f fields]) (syntax-match f [((? k:identifier? g) _) g] [_ (c-error f '"expected [field type]" '())])) '"field")
    #`(begin (define-syntax #,name `(c-struct #,name ,(quote-syntax (#,@fields)) #,(syn kind) #,(syn (for/list ([p ps]) (k:syntax-e p)))))
             #,(second-pass #`(c-struct-check #,name))))

  (func (distinct! [ids i32] [what i32])
    (let ([seen '()])
      (for/each ([id ids])
        (when (k:memq (k:syntax-e id) seen) (c-error id '"~a is a ~a twice" `(,(k:syntax-e id) ,what)))
        (set! seen (k:cons (k:syntax-e id) seen)))))

  (func (c-variant [s i32]) -> i32
    (syntax-match s
      [(_ #:forall ((? k:identifier? p) ...) (? k:identifier? name) c ...) (variant-form name c p)]
      [(_ (? k:identifier? name) c ...) (variant-form name c '())]))

  (func (variant-form [name i32] [cs i32] [ps i32]) -> i32
    (let ([cases (for/list ([c cs])
                   (syntax-match c
                     [((? k:identifier? n) f ...)
                      (distinct! (for/list ([g f]) (syntax-match g [((? k:identifier? h) _) h] [_ (c-error g '"expected [field type]" '())]))
                                 '"field")
                      (k:cons n f)]
                     [(? k:identifier? n) `(,n)]
                     [_ (c-error c '"expected [case [field type] ...]" '())]))])
      (distinct! (for/list ([c cases]) (k:car c)) '"case")
      #`(begin (define-syntax #,name `(c-struct #,name ,(quote-syntax (#,@(for/list ([c cases]) #`(#,@c)))) variant
                                                #,(syn (for/list ([p ps]) (k:syntax-e p)))))
               #,@(for/list ([c cases] [i (numbers-below (k:length cases))])
                    #`(define-syntax #,(k:car c) (mark-transformer (quote-syntax (#%c-construct #,name #,(syn i) #,(k:car c))))))
               #,(second-pass #`(c-struct-check #,name)))))

  (func (c-struct-check [s i32]) -> i32
    (syntax-match s
      [(_ name) (when (k:null? (parameters-of (type-binding name))) (drop (layout (named-type name)))) #'(begin)]))

  (func (c-exception [s i32]) -> i32
    (syntax-match s
      [(_ (? k:identifier? name) t ...)
       (let ([ts (for/list ([u t]) (scalar! (parse-type u) u))])
         #`(begin (tag #,name (#,@(for/list ([u ts]) (syn (kernel-type u)))))
                  (#%fact #,name '#,(syn `(c-exception ,ts)))))]))

  (func (c-typedef [s i32]) -> i32
    (syntax-match s
      [(_ (? k:identifier? n) t) #`(define-syntax #,n `(c-typedef #,(syn (parse-type t))))]))

  ;; ---- forms ----

  (func (mark-transformer [mark i32]) -> i32 (k:make-transformer (func-index mark-use) mark))

  (func (mark-use [mark i32] [s i32]) -> i32
    (syntax-match s
      [(_ arg ...) (at s #`(#%app '#,(syn mark) #,@arg))]
      [_ (at s #`'#,(syn mark))]))

  (func (c-let [s i32]) -> i32
    (syntax-match s
      [(_ (b ...) body ...)
       (at s #`(let (#,@(for/list ([c b])
                          (syntax-match c
                            [((? k:identifier? x) t init) #`[#,(k:syntax-property-set x 'c-type (parse-type t)) #,init]]
                            [((? k:identifier? x) (? type-syntax? t)) #`[#,(k:syntax-property-set x 'c-type (parse-type t)) '(#%c-zero)]]
                            [((? k:identifier? x) init) #`[#,x #,init]]
                            [_ (c-error c '"expected [x type value], [x type] or [x value]" '())])))
                 #,@body))]))

  (func (c-let* [s i32]) -> i32
    (syntax-match s
      [(_ () body ...) (at s #`(c-let () #,@body))]
      [(_ (b rest ...) body ...) (at s #`(c-let (#,b) (c-let* (#,@rest) #,@body)))]))

  (func (c-datum [s i32]) -> i32
    (syntax-match s [(_ d) (if (k:string? (k:syntax-e d)) (at s #`'(#%c-string #,d)) #`(#%datum #,d))]))

  (func (c-when [s i32]) -> i32 (syntax-match s [(_ c body ...) (at s #`(if #,c (begin #,@body)))]))
  (func (c-unless [s i32]) -> i32 (syntax-match s [(_ c body ...) (at s #`(if #,c (begin) (begin #,@body)))]))

  (func (else? [x i32]) -> i32 (and (k:identifier? x) (i32.eq (k:syntax-e x) 'else)))

  (func (c-cond [s i32]) -> i32
    (syntax-match s
      [(_) (at s #'(begin))]
      [(_ ((? else? e) body0 body ...) clause ...)
       (unless (k:null? clause) (c-error e '"else is the last clause of a cond" '()))
       (at s #`(begin #,body0 #,@body))]
      [(_ (c body0 body ...) clause ...) (at s #`(if #,c (begin #,body0 #,@body) (cond #,@clause)))]
      [(_ c . _) (c-error c '"expected [test body ...] or [else body ...]" '())]))

  (func (c-case [s i32]) -> i32
    (syntax-match s
      [(_ e clause ...)
       (at s #`(let ([key #,e])
                 (cond #,@(for/list ([c clause])
                            (syntax-match c
                              [((? else? x) body ...) c]
                              [((d ...) body0 body ...) #`[(or #,@(for/list ([v d]) #`(== key #,v))) #,body0 #,@body]]
                              [_ (c-error c '"expected [(datum ...) body ...] or [else body ...]" '())])))))]))

  (func (c-while [s i32]) -> i32
    (syntax-match s [(_ c body ...) (at s #`(#%app '(#%c-while) #,c (begin #,@body)))]))

  (func (c-for [s i32]) -> i32
    (syntax-match s
      [(_ (b ...) c step body ...) (at s #`(c-let (#,@b) (#%app '(#%c-while) #,c (begin #,@body) #,step)))]))

  (func (c-cast [s i32]) -> i32 (syntax-match s [(_ t e) (at s #`(#%app '(#%c-cast #,t) #,e))]))

  (func (c-array-of [s i32]) -> i32 (syntax-match s [(_ t e ...) (at s #`(#%app '(#%c-array-of #,t) #,@e))]))

  (func (c-lambda [s i32]) -> i32
    (syntax-match s
      [(_ (((? k:identifier? x) t) ...) '-> r body0 body ...) (lambda-form s x t r (k:cons body0 body))]
      [(_ (((? k:identifier? x) t) ...) body0 body ...) (lambda-form s x t #'void (k:cons body0 body))]
      [_ (c-error s '"expected (lambda ([x type] ...) -> type body ...) or (lambda ([x type] ...) body ...)" '())]))

  (func (lambda-form [s i32] [xs i32] [ts i32] [r i32] [body i32]) -> i32
    (at s #`(#%app '(#%c-lambda #,r)
                   (let (#,@(for/list ([x xs] [t ts]) #`[#,(k:syntax-property-set x 'c-type (parse-type t)) '(#%c-field)])) #,@body))))

  (func (c-inst [s i32]) -> i32
    (syntax-match s
      [(_ f t ...)
       (syntax-match (k:local-expand f)
         [('quote ('#%c-generic g)) (at s #`'(#%c-inst #,g (#,@t)))]
         [_ (c-error f '"~a is not a generic function" `(,(k:syntax->datum f)))])]))

  (func (c-throw [s i32]) -> i32 (syntax-match s [(_ (? k:identifier? t) arg ...) (at s #`(#%app '(#%c-throw #,t) #,@arg))]))

  (func (c-try [s i32]) -> i32
    (syntax-match s [(_ form ...) (try-clauses s (k:reverse form) '())]))

  (func (try-clauses [s i32] [forms i32] [clauses i32]) -> i32
    (let ([clause (and (k:pair? forms)
                       (syntax-match (k:car forms)
                         [('catch (? k:identifier? t) ((? k:identifier? x) ...) h0 h ...)
                          (k:cons t #`(let (#,@(for/list ([y x]) #`[#,y '(#%c-field)])) #,h0 #,@h))]
                         [('catch-all h0 h ...) (k:cons #'_ #`(begin #,h0 #,@h))]
                         [_ 0]))])
      (cond [clause (try-clauses s (k:cdr forms) (k:cons clause clauses))]
            [(or (k:null? forms) (k:null? clauses)) (c-error s '"expected (try body ... [catch E (x ...) h ...] ... [catch-all h ...])" '())]
            [else (at s #`(#%app '(#%c-try #,@(for/list ([c clauses]) (k:car c))) (begin #,@(k:reverse forms)) #,@(for/list ([c clauses]) (k:cdr c))))])))

  (func (false-literal? [x i32]) -> i32 (and (k:syntax? x) (i32.eqz (k:syntax-e x))))

  (func (c-match [s i32]) -> i32
    (syntax-match s
      [(_ v clause ...)
       (let ([cs (for/list ([c clause])
                   (syntax-match c
                     [((? false-literal? n) body0 body ...) (k:cons n #`(begin #,body0 #,@body))]
                     [(((? k:identifier? n) (? k:identifier? x) ...) body0 body ...)
                      (k:cons n #`(let (#,@(for/list ([y x]) #`[#,(if (i32.eq (k:syntax-e y) '_) (fresh '_) y) '(#%c-field)])) #,body0 #,@body))]
                     [((? k:identifier? n) body0 body ...) (k:cons n #`(begin #,body0 #,@body))]
                     [_ (c-error c '"expected [(case x ...) body ...], [case body ...], [#f body ...] or [_ body ...]" '())]))])
         (at s #`(#%app '(#%c-match #,@(for/list ([c cs]) (k:car c))) #,v #,@(for/list ([c cs]) (k:cdr c)))))]))

  (func (c-addr [s i32]) -> i32
    (syntax-match s
      [(_ (? function-name? f)) (at s #`'(#%c-function #,f))]
      [(_ x) (at s #`(#%app '(#%c-addr) #,x))]))
  (func (c-sizeof [s i32]) -> i32 (syntax-match s [(_ t) (at s #`'(#%c-sizeof #,t))]))
  (func (c-offsetof [s i32]) -> i32 (syntax-match s [(_ t (? k:identifier? f)) (at s #`'(#%c-offsetof #,t #,f))]))

  (func (c-arrow [s i32]) -> i32
    (syntax-match s
      [(_ e (? k:identifier? f) (? k:identifier? g) ...)
       (for/fold ([acc e]) ([h (k:cons f g)]) (at s #`(#%app '(#%c-arrow #,h) #,acc)))]))

  ;; ---- bodies ----

  (global result (mut i32) 0)
  (global loops (mut i32) 0)
  (global frame (mut i32) 0)
  (global frame-size (mut i32) 0)
  (global addressed (mut i32) 0)
  (global to (mut i32) 0)
  (global returned (mut i32) 0)
  (global returns (mut i32) 0)
  (global binders (mut i32) 0)
  (global broken (mut i32) 0)

  (global quoter (mut i32) 0)

  (func (start-function! [r i32] [result-to i32])
    (set! result r) (set! loops '()) (set! frame 0) (set! frame-size 0) (set! addressed '()) (set! to result-to)
    (set! returned 0) (set! returns '()) (set! binders '()) (set! lambdas '()) (set! broken '()))

  ;; Thrown by frame-slot! in a function with no frame; with-frame then checks it again with one.
  (tag needs-frame ())

  (func (frame-slot! [t i32]) -> i32
    (unless frame (throw needs-frame))
    (let ([o (round-up frame-size (alignment t))])
      (set! frame-size (i32.add o (size-of t)))
      o))

  (func (frame-place [t i32] [offset i32]) -> i32 `(,t memory ,(k:car frame) ,(k:fixnum offset)))

  (func (with-frame [walk i32] [arg i32]) -> i32
    (set! frame 0)
    (set! frame-size 0)
    (or (try ([catch needs-frame () 0]) (call-indirect (i32 -> i32) walk arg))
        (begin (set! frame (k:cons (fresh 'fp) (fresh 'saved))) (set! frame-size 0) (call-indirect (i32 -> i32) walk arg))))

  (func (scan [e i32])
    (syntax-match e
      [('quote . _) (nop)]
      [('#%app ('quote ('#%c-addr)) (? k:identifier? x))
       (let ([b (k:local-binding x)]) (when b (set! addressed (k:cons b addressed))))]
      [('let ((x init) ...) body ...)
       (set! binders (k:append (for/list ([y x] [i init])
                                 (and (i32.eqz (syntax-match i [('quote ('#%c-field)) 1] [_ 0])) (k:local-binding y)))
                               binders))
       (for/each ([i init]) (scan i))
       (for/each ([b body]) (scan b))]
      [('return v) (set! returns (k:cons v returns)) (scan v)]
      [('#%app ('quote ('#%c-lambda _)) body) (set! addressed (k:append (free-locals body) addressed)) (scan body)]
      [(x ...) (for/each ([y x]) (scan y))]
      [_ (nop)]))

  (global free-bound (mut i32) 0)
  (global free-used (mut i32) 0)

  (func (free-locals [e i32]) -> i32
    (set! free-bound '())
    (set! free-used '())
    (free-walk e)
    (for/list ([b free-used] #:when (i32.eqz (k:member b free-bound))) b))

  (func (free-walk [e i32])
    (syntax-match e
      [('quote . _) (nop)]
      [(? k:identifier? x) (let ([b (k:local-binding x)]) (when b (set! free-used (k:cons b free-used))))]
      [('let ((x init) ...) body ...)
       (set! free-bound (k:append (for/list ([y x]) (k:local-binding y)) free-bound))
       (for/each ([i init]) (free-walk i))
       (for/each ([b body]) (free-walk b))]
      [(x ...) (for/each ([y x]) (free-walk y))]
      [_ (nop)]))

  (func (returned-variable [forms i32]) -> i32
    (let ([v (value-variable (k:last forms))])
      (and v (k:member v binders) (for/and ([e returns]) (k:equal? (value-variable e) v)) v)))

  (func (value-variable [e i32]) -> i32
    (syntax-match e
      [(? k:identifier? x) (k:local-binding x)]
      [('return v) (value-variable v)]
      [('let _ body ... v) (value-variable v)]
      [('begin body ... v) (value-variable v)]
      [_ 0]))

  (func (c-body [s i32]) -> i32
    (syntax-match s
      [(_ f (x ...) result-to ('quote types) body ...)
       (let* ([ts (k:syntax->datum types)] [xs (for/list ([y x]) (k:local-expand y))] [forms (for/list ([b body]) (k:local-expand b))])
         (set! quoter f)
         (start-function! (k:car ts) (if (k:identifier? result-to) result-to 0))
         (for/each ([f forms]) (scan f))
         (when (and to (k:pair? forms)) (set! returned (returned-variable forms)))
         (with-frame (func-index body-walk) `(,s ,forms ,xs ,(k:cdr ts) ,(k:car ts))))]))

  (func (body-walk [a i32]) -> i32
    (let* ([s (k:car a)] [forms (k:cadr a)] [params (for/list ([x (k:caddr a)] [t (k:cadddr a)]) (parameter x t))])
      (framed (append-all (for/list ([p params]) (k:cdr p)))
              (function-body s forms (for/list ([p params]) (k:car p)) (k:list-ref a 4)))))

  (func (parameter [x i32] [t i32]) -> i32
    (let ([key (k:local-binding x)])
      (cond [(struct-type? t) `((,key ,t at))]
            [(k:member key addressed)
             (let ([o (frame-slot! (kept! t x))]) `((,key ,t ,(k:fixnum o)) ,(store t (k:car frame) o x)))]
            [else `((,key ,t))])))

  (func (function-body [s i32] [forms i32] [env i32] [r i32]) -> i32
    (cond [(i32.eq r 'void) (k:cons 'void (as-void (check-sequence s forms env 'void)))]
          [(struct-type? r)
           (when (k:null? forms) (c-error s '"expected a body" '()))
           (let ([codes (for/list ([f (but-last forms)]) (as-void (check f env 'void)))]
                 [v (result-value (k:last forms) env)])
             (k:cons (k:car v) (at s #`(begin #,@codes #,(k:cdr v)))))]
          [else (let ([b (check-sequence s forms env r)])
                  (k:cons (if (i32.eq (k:car b) 'none) 'none r) (convert b r (if (k:null? forms) s (k:last forms)) 0)))]))

  (func (result-value [e i32] [env i32]) -> i32
    (if returned
        (let ([r (check e env result)]) (if (i32.eq (k:car r) 'none) r (k:cons 'i32 (convert r result e 0))))
        (copy-into to e result env)))

  (func (framed [entry i32] [b i32]) -> i32
    (if frame
        (let ([fp (k:car frame)] [saved (k:cdr frame)])
          #`(let ([#,saved sp])
              (let ([#,fp (i32.sub #,saved #,(i32-const (round-up frame-size 8)))])
                (if (i32.lt_u #,fp stack-base) (unreachable))
                (set! sp #,fp)
                #,@entry
                #,(leave b))))
        (k:cdr b)))

  (func (leave [r i32]) -> i32
    (cond [(or (i32.eqz frame) (i32.eq (k:car r) 'none)) (k:cdr r)]
          [(i32.eq (k:car r) 'void) #`(begin #,(k:cdr r) (set! sp #,(k:cdr frame)))]
          [else (let ([v (fresh 'v)]) #`(let ([#,v #,(k:cdr r)]) (set! sp #,(k:cdr frame)) #,v))]))

  (func (check [e i32] [env i32] [hint i32]) -> i32
    (let ([r (check-expression e env hint)])
      (if (and (k:syntax? (k:cdr r)) (k:pair? (k:syntax-e (k:cdr r)))) (k:cons (k:car r) (k:syntax-rewrap e (k:syntax-e (k:cdr r)))) r)))

  (func (expect [e i32] [t i32] [env i32] [stored i32]) -> i32 (convert (check e env t) t e stored))

  (func (check-expression [e i32] [env i32] [hint i32]) -> i32
    (syntax-match e
      [(? function-name? f) (function-pointer f)]
      [(? k:identifier? x) (read-place (variable-place x env) e)]
      [('#%datum d) (literal e (k:syntax-e d))]
      [('quote ('#%c-string s)) (string-literal (k:syntax-e s))]
      [('quote ('#%c-sizeof t)) (k:cons 'lit (k:fixnum (size-of (complete! (parse-type t) t))))]
      [('quote ('#%c-offsetof t f))
       (let ([ty (parse-type t)])
         (unless (struct-type? ty) (c-error t '"~s is not a struct" `(,(shown ty))))
         (k:cons 'lit (k:caddr (field-of ty f))))]
      [('#%app ('quote ('#%c-op o)) arg ...) (check-op e (k:syntax-e o) arg env)]
      [('#%app ('quote ('#%c-cast t)) x) (check-cast t x env)]
      [('#%app ('quote ('#%c-set!)) place v) (check-set place v env hint)]
      [('#%app ('quote ('#%c-update o)) place v) (check-update e (k:syntax-e o) place v env hint)]
      [('quote ('#%c-function f)) (function-pointer f)]
      [('quote ('#%c-construct v i n)) (let ([t (construct-type e v i '() env hint)]) (k:cons t (construct e t i n '() env (temp t))))]
      [('#%app ('quote ('#%c-construct v i n)) arg ...) (let ([t (construct-type e v i arg env hint)]) (k:cons t (construct e t i n arg env (temp t))))]
      [('#%app ('quote ('#%c-generic g)) arg ...) (check-generic-call e g arg env hint)]
      [('quote ('#%c-generic (f . _))) (c-error e '"~a is generic: give its types, (inst ~a type ...)" `(,(k:syntax-e f) ,(k:syntax-e f)))]
      [('quote ('#%c-inst g (t ...)))
       (let ([f (instance g (for/list ([u t]) (parse-type u)) e)]) (k:cons (k:cons 'fn (function-type (k:syntax-local-introduce f))) f))]
      [('#%app ('quote ('#%c-match n ...)) v clause ...) (check-match e n v clause env hint)]
      [('#%app ('quote ('#%c-array-of t)) arg ...) (let ([ty (array-of-type t arg)]) (k:cons `(ptr ,(k:cadr ty)) (construct-array e ty arg env (temp ty))))]
      [('#%app ('quote ('#%c-throw t)) arg ...) (check-throw e t arg env)]
      [('#%app ('quote ('#%c-lambda r)) ('let ((x _) ...) body ...)) (check-lambda e r x body env)]
      [('#%app ('quote ('#%c-try n ...)) body clause ...) (check-try n body clause env hint)]
      [('#%app ('quote ('#%c-addr)) place) (let ([p (check-place place env)]) (k:cons `(ptr ,(k:car p)) (address p place)))]
      [('#%app ('quote ('#%c-while)) c body step ...) (check-while c body step env)]
      [('#%app ('quote ('#%c-break))) (jump e 1)]
      [('#%app ('quote ('#%c-continue))) (jump e 0)]
      [('#%app ('quote ('#%c-deref)) . _) (read-place (check-place e env) e)]
      [('#%app ('quote ('#%c-arrow _)) . _) (read-place (check-place e env) e)]
      [('#%app ('quote _) . _) (c-error e '"bad syntax" '())]
      [('quote d) (k:cons (datum-type e) e)]
      [('quote-syntax d) (k:cons (datum-type e) e)]
      [('#%app f arg ...) (check-call e f (callee f env) arg env)]
      [('let (b ...) body ...) (check-let e b body env hint)]
      [('if c a) (k:cons 'void #`(if #,(truth (check c env 0) c) #,(as-void (check a env 'void))))]
      [('if c a b)
       (let* ([t (truth (check c env 0) c)] [ra (check a env hint)] [rb (check b env hint)]
              [ty (promoted (settled-for (join (k:car ra) (k:car rb)) hint))])
         (k:cons ty #`(if #,t #,(as ra ty a) #,(as rb ty b))))]
      [('begin body ...) (check-sequence e body env hint)]
      [('return) (unless (i32.eq result 'void) (c-error e '"expected a value to return" '())) (k:cons 'none (void-return e))]
      [('return v)
       (if (i32.eq result 'void)
           (let ([r (check v env 'void)])
             (unless (k:memq (k:car r) '(void none)) (c-error e '"this function returns no value" '()))
             (k:cons 'none #`(begin #,(k:cdr r) #,(void-return e))))
           (k:cons 'none #`(return #,(leave (if (struct-type? result) (result-value v env) (k:cons result (expect v result env 0)))))))]
      [('memory.size) (k:cons 'i32 e)]
      [('memory.grow n) (k:cons 'i32 #`(memory.grow #,(expect n 'i32 env 0)))]
      [('memory.copy d s n) (k:cons 'void #`(memory.copy #,(address-value d env) #,(address-value s env) #,(expect n 'i32 env 0)))]
      [('memory.fill d v n) (k:cons 'void #`(memory.fill #,(address-value d env) #,(expect v 'i32 env 0) #,(expect n 'i32 env 0)))]
      [_ (c-error e '"this is not C code" '())]))

  (func (void-return [e i32]) -> i32 (if frame #`(begin (set! sp #,(k:cdr frame)) (return)) (at e #'(return))))

  (func (check-sequence [where i32] [forms i32] [env i32] [hint i32]) -> i32
    (cond [(k:null? forms) (k:cons 'void #'(nop))]
          [(k:null? (k:cdr forms)) (check (k:car forms) env hint)]
          [else (let* ([codes (for/list ([f (but-last forms)]) (as-void (check f env 'void)))]
                       [r (settle (check (k:last forms) env hint) hint (k:last forms))])
                  (k:cons (k:car r) (at where #`(begin #,@codes #,(k:cdr r)))))]))

  ;; A macro that defines a function that quotes its input names the datum type where it
  ;; defines the function, not where its input was written.
  (func (datum-type [e i32]) -> i32
    (let ([t (type-binding (k:datum->syntax quoter 'datum 0))])
      (if (and t (i32.eq (k:car t) 'c-typedef))
          (k:cadr t)
          (c-error e '"quoted data is the kernel module's, of its type datum: require kernel.sub, which names it" '()))))

  (func (literal [e i32] [d i32]) -> i32
    (cond [(k:integer? d) (k:cons 'lit d)]
          [(k:flonum? d) (k:cons 'flit d)]
          [(k:char? d) (k:cons 'lit (k:fixnum (k:char->integer d)))]
          [(k:boolean? d) (k:cons 'lit (k:fixnum (if d 1 0)))]
          [else (c-error e '"~s is not a C literal" `(,d))]))

  (func (check-let [e i32] [bindings i32] [body i32] [env i32] [hint i32]) -> i32
    (let* ([vs (for/list ([b bindings]) (syntax-match b [(x init) (let-variable x init env)]))]
           [r (settle (check-sequence e body (k:append (for/list ([v vs]) (k:car v)) env) hint) hint e)]
           [code #`(let (#,@(for/list ([v vs] #:when (k:caddr v)) (k:caddr v))) #,(k:cdr r))]
           [stores (for/list ([v vs] #:when (k:cadr v)) (k:cadr v))])
      (k:cons (k:car r) (if (k:null? stores) code #`(begin #,@stores #,code)))))

  (func (let-variable [x i32] [init i32] [env i32]) -> i32
    (let* ([declared (k:syntax-property x 'c-type)] [key (k:local-binding x)]
           [zero (syntax-match init [('quote ('#%c-zero)) 1] [_ 0])]
           [call (and (i32.eqz declared) (produced-type init))]
           [r (and (i32.eqz zero) (i32.eqz (aggregate? declared)) (i32.eqz call) (check init env declared))]
           [t (cond [declared (complete! declared x)]
                    [call call]
                    [(or (struct-type? (k:car r)) (closure-type? (k:car r))) (k:car r)]
                    [else (scalar! (settled-type (k:car r)) x)])])
      (cond [(k:equal? key returned)
             (unless (k:equal? t result)
               (c-error x '"~a is returned, so it is a ~s, not a ~s" `(,(k:syntax-e x) ,(shown result) ,(shown t))))
             `((,key ,t result) ,(and (i32.eqz zero) (let-put r to t init env)) #f)]
            [(or (aggregate? t) (k:member key addressed))
             (let* ([o (frame-slot! (kept! t x))] [p (frame-place t o)])
               `((,key ,t ,(k:fixnum o))
                 ,(cond [(i32.eqz (aggregate? t)) (store t (k:car frame) o (let-value zero r t x init 1))]
                        [zero 0]
                        [else (let-put r (address p x) t init env)])
                 #f))]
            [else `((,key ,t) #f ,#`[#,x #,(syn (kernel-type t)) #,(let-value zero r t x init 0)])])))

  (func (let-value [zero i32] [r i32] [t i32] [x i32] [init i32] [stored i32]) -> i32
    (if zero (constant (k:fixnum 0) t x) (convert r t init stored)))

  (func (let-put [r i32] [dst i32] [t i32] [init i32] [env i32]) -> i32
    (if r (copy-bytes dst (k:cdr r) (size-of t)) (as-void (copy-into dst init t env))))

  ;; ---- calls ----

  (func (check-call [e i32] [f i32] [c i32] [args i32] [env i32]) -> i32
    (let ([r (k:cadr (k:car c))])
      (if (struct-type? r)
          (k:cons r (call e f c args env (temp r)))
          (k:cons (promoted r) (call e f c args env 0)))))

  (func (callee [f i32] [env i32]) -> i32
    (if (function-name? f)
        `(,(function-type f) #f direct)
        (let ([r (check f env 0)])
          (cond [(fn-type? (k:car r)) `(,(k:cdr (k:car r)) ,(k:cdr r) pointer)]
                [(closure-type? (k:car r)) `(,(k:cdr (k:car r)) ,(k:cdr r) closure)]
                [else (c-error f '"expected a function, got ~s" `(,(shown (k:car r))))]))))

  (func (call [e i32] [f i32] [c i32] [args i32] [env i32] [to i32]) -> i32
    (let ([ps (k:car (k:car c))])
      (unless (i32.eq (k:length ps) (k:length args))
        (c-error e '"~a takes ~a argument~a, got ~a"
                 `(,(k:syntax->datum (written f)) ,(k:fixnum (k:length ps)) ,(plural (k:length ps)) ,(k:fixnum (k:length args)))))
      (let ([as (k:append (if to `(,to) '())
                          (for/list ([a args] [p ps])
                            (if (struct-type? p)
                                (k:cdr (copy-into (address (frame-place p (frame-slot! p)) a) a p env))
                                (expect a p env 0))))])
        (case (k:caddr c)
          [(direct) #`(#%app #,f #,@as)]
          [(pointer) #`(call-indirect #,(syn (signature (k:car c))) #,(k:cadr c) #,@as)]
          [else (let ([kk (fresh 'k)])
                  #`(let ([#,kk #,(k:cadr c)])
                      (call-indirect #,(syn (k:cons 'i32 (signature (k:car c)))) (i32.wrap_i64 (i64.shr_u #,kk (i64.const 32)))
                                     (i32.wrap_i64 #,kk) #,@as)))]))))

  (func (signature [sig i32]) -> i32
    (let ([r (k:cadr sig)])
      (k:append (for/list ([t (if (struct-type? r) (k:cons 'i32 (k:car sig)) (k:car sig))]) (kernel-type t))
                (k:cons '-> (if (i32.eq r 'void) '() `(,(kernel-type r)))))))

  (func (function-name? [f i32]) -> i32 (and (k:identifier? f) (i32.eq (k:identifier-binding-kind f) 'function)))

  (func (function-pointer [f i32]) -> i32
    (k:cons (k:cons 'fn (function-type f)) (if (fact f 'c-function) f #`(func-index #,f))))

  (func (function-type [f i32]) -> i32
    (unless (i32.eq (k:identifier-binding-kind f) 'function) (c-error f '"~a is not a function" `(,(k:syntax-e f))))
    (or (fact f 'c-function)
        (let* ([sig (k:identifier-function-signature f)]
               [rs (k:cdr (k:memq '-> sig))])
          (for/each ([t sig])
            (unless (k:memq t '(i32 i64 f32 f64 ->)) (c-error f '"~a takes or returns ~s, which C has not" `(,(k:syntax-e f) ,t))))
          (when (and (k:pair? rs) (k:pair? (k:cdr rs))) (c-error f '"~a returns more than one value" `(,(k:syntax-e f))))
          `(,(k:take sig (i32.sub (i32.sub (k:length sig) (k:length rs)) 1)) ,(if (k:null? rs) 'void (k:car rs))))))

  (func (struct-call? [f i32]) -> i32
    (and (k:identifier? f) (i32.eq (k:identifier-binding-kind f) 'function)
         (let ([sig (fact f 'c-function)]) (and sig (struct-type? (k:cadr sig))))))

  (func (fact [id i32] [kind i32]) -> i32
    ;; The kernel module's definitions, which have no name, have none.
    (and (k:identifier-name id)
         (let ([f (for/or ([v (k:syntax-local-facts id)]) (let ([d (k:caddr v)]) (and (k:pair? d) (i32.eq (k:car d) kind) d)))])
           (and f (k:cdr f)))))

  ;; dst must be fresh, bytes no one reads until this is done: a new variable's, a copy's, or
  ;; the function's own result's.
  (func (copy-into [dst i32] [e i32] [t i32] [env i32]) -> i32
    (let ([produced (produced-type e)])
      (if produced
          (begin
            (unless (k:equal? produced t) (c-error e '"expected ~s, got ~s" `(,(shown t) ,(shown produced))))
            (k:cons 'i32 (syntax-match e
                           [('#%app ('quote ('#%c-construct _ i n)) arg ...) (construct e t i n arg env dst)]
                           [('#%app ('quote ('#%c-array-of _)) arg ...) (construct-array e t arg env dst)]
                           [('quote ('#%c-construct _ i n)) (construct e t i n '() env dst)]
                           [('#%app f arg ...) (call e f (callee f env) arg env dst)])))
          (let ([r (check e env t)] [d (fresh 'to)])
            (if (i32.eq (k:car r) 'none)
                r
                (k:cons 'i32 #`(let ([#,d #,dst]) #,(copy-bytes d (convert r t e 0) (size-of t)) #,d)))))))

  ;; A generic variant's construction is not one: its type may be the one its place expects.
  (func (produced-type [e i32]) -> i32
    (syntax-match e
      [('#%app (? struct-call? f) . _) (k:cadr (function-type f))]
      [('#%app ('quote ('#%c-array-of t)) arg ...) (array-of-type t arg)]
      [('#%app ('quote ('#%c-construct v . _)) . _) (and (k:null? (parameters-of (type-binding v))) (named-type v))]
      [('quote ('#%c-construct v . _)) (and (k:null? (parameters-of (type-binding v))) (named-type v))]
      [_ 0]))

  (func (temp [t i32]) -> i32 (address (frame-place t (frame-slot! t)) 0))

  ;; ---- generics ----

  (func (check-generic-call [e i32] [g i32] [args i32] [env i32] [hint i32]) -> i32
    (syntax-match g
      [(f (p ...) ((x a) ...) r _ _)
       (let* ([ps (for/list ([q p]) (k:syntax-e q))]
              [s (infer e (parse-types-with (type-variables ps) a) args env)]
              [i (instance g (for/list ([q ps]) (bound-type e s q (k:syntax-e f))) e)])
         ;; i as the module sees it has the function's binding.
         (check-call e i `(,(function-type (k:syntax-local-introduce i)) #f direct) args env))]))

  ;; The arguments are gone through twice: first a constant such as 5 decides nothing, since
  ;; it takes the type its place needs; then constants decide what is still unknown.
  (func (infer [e i32] [ts i32] [args i32] [env i32]) -> i32
    (unless (i32.eq (k:length ts) (k:length args))
      (c-error e '"expected ~a argument~a, got ~a" `(,(k:fixnum (k:length ts)) ,(plural (k:length ts)) ,(k:fixnum (k:length args)))))
    (infer-from ts args env (infer-from ts args env '() 0) 1))

  (func (infer-from [ts i32] [args i32] [env i32] [s i32] [constants i32]) -> i32
    (cond [(k:null? ts) s]
          [(known-type? (k:car ts) s) (infer-from (k:cdr ts) (k:cdr args) env s constants)]
          [else
           (let ([r (check (k:car args) env 0)])
             (infer-from (k:cdr ts) (k:cdr args) env
                         (if (and (i32.eqz constants) (k:memq (k:car r) '(lit flit)))
                             s
                             (or (unify (k:car ts) (settled-type (k:car r)) s)
                                 (c-error (k:car args) '"expected ~s, got ~s" `(,(shown (applied (k:car ts) s)) ,(shown (k:car r))))))
                         constants))]))

  (func (known-type? [t i32] [s i32]) -> i32
    (cond [(and (k:pair? t) (i32.eq (k:car t) 'tvar)) (if (k:assq (k:cadr t) s) 1 0)]
          [(k:pair? t) (for/and ([u t]) (known-type? u s))]
          [else 1]))

  (func (applied [t i32] [s i32]) -> i32
    (cond [(and (k:pair? t) (i32.eq (k:car t) 'tvar)) (let ([b (k:assq (k:cadr t) s)]) (if b (k:cdr b) t))]
          [(k:pair? t) (for/list ([u t]) (applied u s))]
          [else t]))

  (func (unify [t i32] [u i32] [s i32]) -> i32
    (cond [(and (k:pair? t) (i32.eq (k:car t) 'tvar))
           (let ([b (k:assq (k:cadr t) s)])
             (cond [(i32.eqz b) (k:cons (k:cons (k:cadr t) u) s)] [(k:equal? (k:cdr b) u) s] [else 0]))]
          [(and (k:pair? t) (k:pair? u) (i32.eq (k:length t) (k:length u))) (unify-each t u s)]
          [(k:equal? t u) s]
          [else 0]))

  (func (unify-each [t i32] [u i32] [s i32]) -> i32
    (if (k:null? t) s (let ([s2 (unify (k:car t) (k:car u) s)]) (and s2 (unify-each (k:cdr t) (k:cdr u) s2)))))

  (func (bound-type [e i32] [s i32] [p i32] [f i32]) -> i32
    (let ([b (k:assq p s)])
      (if b (k:cdr b) (c-error e '"~a's type ~a is not known from its arguments: give it, (inst ~a type ...)" `(,f ,p ,f)))))

  ;; An instance's name is known before its body is checked, so the body can call it.
  (global instance-table (mut i32) 0)
  (func (instances) -> i32
    (when (i32.eqz instance-table) (set! instance-table (k:make-table)))
    instance-table)

  (func (instance [g i32] [ts i32] [where i32]) -> i32
    (syntax-match g
      [(f (p ...) ((x a) ...) r (body ...) s)
       (let* ([key (k:cons (k:identifier-name f) ts)] [known (k:datum-get (instances) key)])
         (if known
             (k:syntax-local-introduce known)
             (let ([name (fresh (k:format '"~a<~a>" `(,(k:syntax-e f) ,(joined (for/list ([t ts]) (k:format '"~s" `(,(shown t))))))))]
                   [sub (for/list ([q p] [t ts]) (k:cons (k:syntax-e q) t))])
               (k:datum-put! (instances) key (k:syntax-local-introduce name))
               ;; The lifted begin is located at the generic's definition, s, so that the
               ;; instance's function is located in the generic's file rather than here.
               (let ([s-result result] [s-loops loops] [s-frame frame] [s-frame-size frame-size] [s-addressed addressed]
                     [s-to to] [s-returned returned] [s-returns returns] [s-binders binders] [s-lambdas lambdas])
                 (drop (k:syntax-local-lift-definition
                        (at s (function s name x (for/list ([y a]) (replace y sub)) (replace r sub) (for/list ([b body]) (replace b sub)) f 0))))
                 (set! result s-result) (set! loops s-loops) (set! frame s-frame) (set! frame-size s-frame-size)
                 (set! addressed s-addressed) (set! to s-to) (set! returned s-returned) (set! returns s-returns)
                 (set! binders s-binders) (set! lambdas s-lambdas))
               name)))]))

  (func (replace [x i32] [sub i32]) -> i32
    (cond [(k:identifier? x)
           (let ([b (k:assq (k:syntax-e x) sub)]) (if b (k:datum->syntax x (k:cons 'quote (k:cons (k:cdr b) '())) x) x))]
          [(k:syntax->list x) (k:syntax-rewrap x (for/list ([y (k:syntax->list x)]) (replace y sub)))]
          [else x]))

  ;; ---- closures ----

  (global lambdas (mut i32) 0)

  (func (check-lambda [e i32] [r i32] [xs i32] [body i32] [env i32]) -> i32
    (let* ([ps (for/list ([x xs]) (value-type! (k:syntax-property x 'c-type) x))]
           [rt (let ([t (parse-type r)]) (if (i32.eq t 'void) t (scalar! t r)))]
           [name (let ([known (k:assq e lambdas)])
                   (if known
                       (k:cdr known)
                       (let ([n (lift-lambda e xs ps rt body env)]) (set! lambdas (k:cons (k:cons e n) lambdas)) n)))])
      (k:cons `(closure ,ps ,rt)
              #`(i64.or (i64.shl (i64.extend_i32_u (func-index #,name)) (i64.const 32))
                        (i64.extend_i32_u #,(if frame (k:car frame) #'(i32.const 0)))))))

  (func (lift-lambda [e i32] [xs i32] [ps i32] [rt i32] [body i32] [env i32]) -> i32
    (let* ([name (fresh 'lambda)] [base (fresh 'frame)]
           [outside (for/list ([b env])
                      (if (and (k:pair? (k:cddr b)) (k:integer? (k:caddr b)))
                          `(,(k:car b) ,(k:cadr b) alias (,(k:cadr b) memory ,base ,(k:caddr b)))
                          `(,(k:car b) ,(k:cadr b) outside)))]
           [s-result result] [s-loops loops] [s-frame frame] [s-frame-size frame-size] [s-to to] [s-returned returned]
           [code (begin
                   (set! result rt) (set! loops '()) (set! to 0) (set! returned 0)
                   (with-frame (func-index lambda-walk) `(,e ,body ,xs ,ps ,outside ,rt)))])
      (set! result s-result) (set! loops s-loops) (set! frame s-frame)
      (set! frame-size s-frame-size) (set! to s-to) (set! returned s-returned)
      (drop (k:syntax-local-lift-definition
             (at e #`(func (#,name [#,base i32] #,@(for/list ([x xs] [p ps]) #`[#,x #,(syn (kernel-type p))]))
                       #,@(if (i32.eq rt 'void) '() `(,#'-> ,(syn (kernel-type rt))))
                       #,code))))
      name))

  (func (lambda-walk [a i32]) -> i32
    (let* ([e (k:car a)] [body (k:cadr a)] [params (for/list ([x (k:caddr a)] [p (k:cadddr a)]) (parameter x p))])
      (framed (append-all (for/list ([q params]) (k:cdr q)))
              (function-body e body (k:append (for/list ([q params]) (k:car q)) (k:list-ref a 4)) (k:list-ref a 5)))))

  ;; ---- variants ----

  (func (construct [e i32] [t i32] [i i32] [n i32] [args i32] [env i32] [dst i32]) -> i32
    (let* ([j (k:syntax-e i)] [fields (case-fields e t j n args)] [d (fresh 'to)])
      #`(let ([#,d #,dst])
          (i32.store #,d #,(const 'i32 j))
          #,@(for/list ([f fields] [a args])
               (let ([p `(,(k:cadr f) memory ,d ,(k:caddr f))])
                 (if (aggregate? (k:cadr f))
                     (as-void (copy-into (address p a) a (k:cadr f) env))
                     (store (k:cadr f) d (k:fixnum-value (k:caddr f)) (expect a (k:cadr f) env 1)))))
          #,d)))

  (func (array-of-type [t i32] [args i32]) -> i32 `(array ,(kept! (complete! (parse-type t) t) t) ,(k:fixnum (k:length args))))

  (func (construct-array [e i32] [t i32] [args i32] [env i32] [dst i32]) -> i32
    (let ([d (fresh 'to)] [et (k:cadr t)] [size (size-of (k:cadr t))])
      #`(let ([#,d #,dst])
          #,@(for/list ([a args] [i (numbers-below (k:length args))])
               (let ([o (i32.mul (k:fixnum-value i) size)])
                 (if (aggregate? et)
                     (as-void (copy-into (address `(,et memory ,d ,(k:fixnum o)) a) a et env))
                     (store et d o (expect a et env 1)))))
          #,d)))

  (func (case-fields [e i32] [t i32] [i i32] [n i32] [args i32]) -> i32
    (let ([fields (k:cdr (k:list-ref (cases-of t) (k:fixnum-value i)))])
      (unless (i32.eq (k:length fields) (k:length args))
        (c-error e '"~a has ~a field~a, not ~a"
                 `(,(k:syntax-e n) ,(k:fixnum (k:length fields)) ,(plural (k:length fields)) ,(k:fixnum (k:length args)))))
      fields))

  (func (scalar-construction [v i32] [t i32]) -> i32
    (let ([c (syntax-match v
               [('#%app ('quote ('#%c-construct w i n)) arg ...) `(,w ,i ,n ,arg)]
               [('quote ('#%c-construct w i n)) `(,w ,i ,n ())]
               [_ 0])])
      (and c (variant-type? t) (i32.eq (k:identifier-name (k:car c)) (k:cadr t))
           (for/and ([f (k:cdr (k:list-ref (cases-of t) (k:fixnum-value (k:syntax-e (k:cadr c)))))]) (i32.eqz (aggregate? (k:cadr f))))
           (k:cdr c))))

  (func (construct-in-place [e i32] [c i32] [t i32] [dst i32] [env i32]) -> i32
    (let* ([i (k:syntax-e (k:car c))] [fields (case-fields e t i (k:cadr c) (k:caddr c))] [d (fresh 'to)]
           [xs (for/list ([f fields]) (fresh 'x))])
      #`(let ([#,d #,dst] #,@(for/list ([x xs] [f fields] [a (k:caddr c)]) #`[#,x #,(expect a (k:cadr f) env 1)]))
          (i32.store #,d #,(const 'i32 i))
          #,@(for/list ([x xs] [f fields]) (store (k:cadr f) d (k:fixnum-value (k:caddr f)) x)))))

  (func (check-match [e i32] [names i32] [v i32] [clauses i32] [env i32] [hint i32]) -> i32
    (let* ([p (struct-base v env)] [t (k:car p)] [a (fresh 'a)] [tag (fresh 'tag)] [nullable (pointer-base? p)]
           [pairs (for/list ([n names] [c clauses]) (k:cons n c))]
           [nulls (for/list ([nc pairs] #:when (i32.eqz (k:syntax-e (k:car nc)))) nc)]
           [cases (for/list ([nc pairs] #:when (k:syntax-e (k:car nc))) nc)])
      (unless (variant-type? t) (c-error v '"match takes a variant, or a pointer to one, not ~s" `(,(shown t))))
      (when (and (k:pair? nulls) (i32.eqz nullable))
        (c-error (k:car (k:car nulls)) '"this match takes a variant, not a pointer to one, which is never #f" '()))
      (when (and (k:pair? nulls) (k:pair? (k:cdr nulls))) (c-error (k:car (k:cadr nulls)) '"#f is matched twice" '()))
      (match-arms e p t a tag nullable nulls (for/list ([c cases]) (k:car c)) (for/list ([c cases]) (k:cdr c)) '()
                  (numbers-below (k:length (cases-of t))) env hint)))

  (func (match-arms [e i32] [p i32] [t i32] [a i32] [tag i32] [nullable i32] [nulls i32] [names i32] [clauses i32]
                    [arms i32] [left i32] [env i32] [hint i32]) -> i32
    (if (k:null? names)
        (let* ([arms (k:reverse arms)]
               [default (and (k:pair? arms) (i32.eqz (k:car (k:last arms))) (k:last arms))]
               [tested (for/list ([x arms] #:when (k:car x)) x)]
               [null-arm (and (k:pair? nulls) (arm (k:cdr (k:car nulls)) 0 t a (k:fixnum 0) env hint))]
               [ty (promoted (settled-for (for/fold ([ty (if null-arm (k:car null-arm) 'none)]) ([x arms]) (join ty (k:car (k:cadr x)))) hint))]
               [load-tag (load 'u32 a (k:fixnum-value (k:cadddr p)))])
          (when (and (k:pair? left) (i32.eqz default))
            (c-error e '"this match does not cover ~a" `(,(joined (for/list ([i left]) (k:car (k:list-ref (cases-of t) (k:fixnum-value i))))))))
          ;; A null pointer takes the #f clause, else _'s, whose tag,
          ;; -1, no case has; else it traps.
          (k:cons ty #`(let ([#,a #,(k:caddr p)])
                         #,(cond [null-arm #`(if (i32.eqz #,a) #,(as null-arm ty (k:cdr (k:car nulls))) #,(dispatch tag tested default ty load-tag))]
                                 [(i32.eqz nullable) (dispatch tag tested default ty load-tag)]
                                 [default (dispatch tag tested default ty #`(if (i32.eqz #,a) (i32.const -1) #,load-tag))]
                                 [else #`(begin (if (i32.eqz #,a) (unreachable)) #,(dispatch tag tested default ty load-tag))]))))
        (let* ([n (k:car names)] [c (k:car clauses)]
               [i (if (i32.eq (k:syntax-e n) '_) 0 (case-index n t))])
          (when (and i (i32.eqz (k:member i left))) (c-error n '"~a is matched twice" `(,(k:syntax-e n))))
          (when (k:null? left) (c-error c '"this clause can never match" '()))
          (match-arms e p t a tag nullable nulls (k:cdr names) (k:cdr clauses)
                      (k:cons `(,i ,(arm c i t a (k:cadddr p) env hint) ,c) arms)
                      (if i (for/list ([j left] #:when (i32.eqz (k:equal? j i))) j) '())
                      env hint))))

  (func (dispatch [tag i32] [tested i32] [default i32] [ty i32] [tag-code i32]) -> i32
    #`(let ([#,tag #,tag-code]) #,(chain tested default ty tag)))

  (func (chain [arms i32] [default i32] [ty i32] [tag i32]) -> i32
    (cond [(k:null? arms) (arm-code default ty)]
          [(and (k:null? (k:cdr arms)) (i32.eqz default)) (arm-code (k:car arms) ty)]
          [else #`(if (i32.eq #,tag #,(const 'i32 (k:car (k:car arms)))) #,(arm-code (k:car arms) ty) #,(chain (k:cdr arms) default ty tag))]))

  (func (arm-code [x i32] [ty i32]) -> i32 (as (k:cadr x) ty (k:caddr x)))

  (func (arm [c i32] [i i32] [t i32] [a i32] [o i32] [env i32] [hint i32]) -> i32
    (syntax-match c
      [('let ((x _) ...) body ...)
       (let ([fields (k:cdr (k:list-ref (cases-of t) (k:fixnum-value i)))])
         (unless (i32.eq (k:length x) (k:length fields))
           (c-error c '"~a has ~a field~a, not ~a"
                    `(,(k:car (k:list-ref (cases-of t) (k:fixnum-value i))) ,(k:fixnum (k:length fields)) ,(plural (k:length fields)) ,(k:fixnum (k:length x)))))
         (settle (check-sequence c body
                                 (k:append (for/list ([y x] [f fields])
                                             `(,(k:local-binding y) ,(k:cadr f) alias
                                               (,(k:cadr f) memory ,a ,(k:fixnum (i32.add (k:fixnum-value o) (k:fixnum-value (k:caddr f)))))))
                                           env)
                                 hint)
                 hint c))]
      [('begin body ...) (check-sequence c body env hint)]))

  (func (construct-type [e i32] [v i32] [i i32] [args i32] [env i32] [hint i32]) -> i32
    (let ([b (type-binding v)])
      (cond [(k:null? (parameters-of b)) (named-type v)]
            [(and (struct-type? hint) (i32.eq (k:cadr hint) (k:identifier-name v))) hint]
            [else
             (let* ([ps (parameters-of b)]
                    [fields (parse-types-with (type-variables ps)
                                              (for/list ([f (k:cdr (k:syntax->list (k:list-ref (k:syntax->list (k:caddr b)) (k:fixnum-value (k:syntax-e i)))))])
                                                (syntax-match f [(_ ft) ft])))]
                    [s (infer e fields args env)])
               `(struct ,(k:identifier-name v) ,(k:cadr b) ,(for/list ([p ps]) (bound-type e s p (k:syntax-e v)))))])))

  (func (case-index [n i32] [t i32]) -> i32
    (syntax-match (if (i32.eq (k:identifier-binding-kind n) 'macro) (k:local-expand n) 0)
      [('quote ('#%c-construct v i _))
       (if (i32.eq (k:identifier-name v) (k:cadr t)) (k:syntax-e i) (c-error n '"~a is not a case of ~a" `(,(k:syntax-e n) ,(shown t))))]
      [_ (c-error n '"~a is not a case of ~a" `(,(k:syntax-e n) ,(shown t)))]))

  (func (joined [xs i32]) -> i32
    (if (k:null? xs)
        '""
        (for/fold ([acc (k:format '"~a" `(,(k:car xs)))]) ([x (k:cdr xs)]) (k:format '"~a, ~a" `(,acc ,x)))))

  ;; Small copies are loads and stores, which the engine compiles in line; memory.copy is a call.
  (func (copy-bytes [dst i32] [src i32] [n i32]) -> i32
    (if (or (i32.eqz n) (i32.gt_s n 64))
        #`(memory.copy #,dst #,src #,(i32-const n))
        (let ([d (fresh 'd)] [s (fresh 's)])
          #`(let ([#,d #,dst] [#,s #,src])
              #,@(for/list ([p (pieces n 0)])
                   (store (k:car p) d (k:fixnum-value (k:cdr p)) (load (k:car p) s (k:fixnum-value (k:cdr p)))))))))

  (func (pieces [n i32] [o i32]) -> i32
    (let ([left (i32.sub n o)])
      (cond [(i32.ge_s left 8) (k:cons (k:cons 'u64 (k:fixnum o)) (pieces n (i32.add o 8)))]
            [(i32.ge_s left 4) (k:cons (k:cons 'u32 (k:fixnum o)) (pieces n (i32.add o 4)))]
            [(i32.ge_s left 2) (k:cons (k:cons 'u16 (k:fixnum o)) (pieces n (i32.add o 2)))]
            [(i32.ge_s left 1) (k:cons (k:cons 'u8 (k:fixnum o)) (pieces n (i32.add o 1)))]
            [else '()])))

  ;; ---- places ----

  (func (check-place [e i32] [env i32]) -> i32
    (syntax-match e
      [(? k:identifier? x) (variable-place x env)]
      [('#%app ('quote ('#%c-deref)) p) (let ([r (check p env 0)]) `(,(pointee r p) memory ,(k:cdr r) 0))]
      [('#%app ('quote ('#%c-deref)) p i) (index-place p i env)]
      [('#%app ('quote ('#%c-arrow f)) s) (field-place s f env)]
      [_ (c-error e '"expected a place: a variable, (@ p), (@ p i) or (-> p field)" '())]))

  (func (place-form? [e i32]) -> i32
    (syntax-match e
      [(? k:identifier? _) 1]
      [('#%app ('quote ((? k:identifier? m) . _)) . _) (if (k:memq (k:syntax-e m) '(#%c-deref #%c-arrow)) 1 0)]
      [_ 0]))

  (func (variable-place [x i32] [env i32]) -> i32
    (let ([b (k:assoc (k:local-binding x) env)])
      (cond [(and b (k:null? (k:cddr b))) `(,(k:cadr b) local ,x)]
            [(and b (i32.eq (k:caddr b) 'at)) `(,(k:cadr b) memory ,x 0)]
            [(and b (i32.eq (k:caddr b) 'result)) `(,(k:cadr b) memory ,to 0)]
            [(and b (i32.eq (k:caddr b) 'alias)) (k:cadddr b)]
            [(and b (i32.eq (k:caddr b) 'outside))
             (c-error x '"~a cannot be used in this lambda: a lambda uses the variables of the function it is in, not those of a match, a struct parameter or another lambda" `(,(k:syntax-e x)))]
            [b (frame-place (k:cadr b) (k:fixnum-value (k:caddr b)))]
            [(and (i32.eq (k:identifier-binding-kind x) 'variable) (fact x 'c-global)) `(,(k:car (fact x 'c-global)) memory ,x 0)]
            [(i32.eq (k:identifier-binding-kind x) 'function) (c-error x '"~a is a function, not a value" `(,(k:syntax-e x)))]
            [else (c-error x '"~a is not a C variable" `(,(k:syntax-e x)))])))

  (func (pointee [r i32] [where i32]) -> i32
    (unless (pointer? (k:car r)) (c-error where '"expected a pointer, got ~s" `(,(shown (k:car r)))))
    (when (i32.eq (k:cadr (k:car r)) 'void) (c-error where '"a (ptr void) points to no type: cast it" '()))
    (k:cadr (k:car r)))

  (func (index-place [p i32] [i i32] [env i32]) -> i32
    (let* ([r (check p env 0)] [t (pointee r p)] [n (check i env 0)] [size (size-of (complete! t p))])
      (unless (integer-type? (k:car n)) (c-error i '"an index is an integer, not ~s" `(,(shown (k:car n)))))
      (if (and (i32.eq (k:car n) 'lit) (i32.eqz (k:integer-negative? (k:cdr n))))
          `(,t memory ,(k:cdr r) ,(k:make-integer (i64.mul (k:integer-value (k:cdr n)) (i64.extend_i32_u size))))
          `(,t memory ,#`(i32.add #,(k:cdr r) #,(scaled n size i)) 0))))

  (func (field-place [s i32] [f i32] [env i32]) -> i32
    (let* ([base (struct-base s env)] [field (field-of (k:car base) f)])
      `(,(k:cadr field) memory ,(k:caddr base) ,(k:fixnum (i32.add (k:fixnum-value (k:cadddr base)) (k:fixnum-value (k:caddr field)))))))

  (func (struct-base [s i32] [env i32]) -> i32
    (let ([p (and (place-form? s) (check-place s env))])
      (if (and p (struct-type? (k:car p)))
          p
          (let ([r (if p (read-place p s) (check s env 0))])
            (cond [(struct-type? (k:car r)) `(,(k:car r) memory ,(k:cdr r) 0)]
                  [(and (pointer? (k:car r)) (struct-type? (k:cadr (k:car r)))) `(,(k:cadr (k:car r)) memory ,(k:cdr r) 0 pointer)]
                  [else (c-error s '"expected a struct, or a pointer to one, not ~s" `(,(shown (k:car r))))])))))

  (func (pointer-base? [p i32]) -> i32 (and (i32.eq (k:length p) 5) (i32.eq (k:list-ref p 4) 'pointer)))

  (func (field-of [t i32] [f i32]) -> i32
    (or (k:assq (k:syntax-e f) (k:caddr (layout t))) (c-error f '"~a has no field ~a" `(,(shown t) ,(k:syntax-e f)))))

  (func (read-place [p i32] [e i32]) -> i32
    (let ([t (k:car p)])
      (cond [(array-type? t) (k:cons `(ptr ,(k:cadr t)) (address p e))]
            [(struct-type? t) (k:cons t (address p e))]
            [(i32.eq (k:cadr p) 'local) (k:cons (promoted t) (k:caddr p))]
            [else (k:cons (promoted t) (load t (k:caddr p) (k:fixnum-value (k:cadddr p))))])))

  (func (address [p i32] [where i32]) -> i32
    (when (i32.eq (k:cadr p) 'local)
      (c-error where '"~a is a local variable, not in memory: it has no address" `(,(k:syntax-e (k:caddr p)))))
    (if (i32.eqz (k:fixnum-value (k:cadddr p))) (k:caddr p) #`(i32.add #,(k:caddr p) #,(const 'i32 (k:cadddr p)))))

  (func (check-set [place i32] [v i32] [env i32] [hint i32]) -> i32
    (let* ([p (check-place place env)] [t (k:car p)] [c (and (struct-type? t) (scalar-construction v t))])
      ;; A place may be read while a call runs, so a call's struct goes first where the call
      ;; puts it, and is copied; so does a construction with a struct or array field.
      (cond [c (k:cons 'void (construct-in-place v c t (address p place) env))]
            [(struct-type? t) (k:cons 'void (copy-bytes (address p place) (expect v t env 0) (size-of t)))]
            [(array-type? t) (c-error place '"an array cannot be assigned: copy it with memcpy" '())]
            [else (assign p (check v env t) v hint)])))

  (func (check-update [e i32] [o i32] [place i32] [v i32] [env i32] [hint i32]) -> i32
    (let* ([p (check-place place env)] [a (fresh 'a)]
           [q (if (i32.eq (k:cadr p) 'local) p `(,(k:car p) memory ,a ,(k:cadddr p)))]
           [r (assign q (binary e o (read-place q place) (check v env 0)) e hint)])
      (k:cons (k:car r) (if (i32.eq (k:cadr p) 'local) (k:cdr r) #`(let ([#,a #,(k:caddr p)]) #,(k:cdr r))))))

  (func (assign [p i32] [r i32] [where i32] [hint i32]) -> i32
    (let ([t (k:car p)] [x (k:caddr p)])
      (cond [(i32.eq (k:cadr p) 'local)
             (let ([c (convert r t where 0)])
               (if (i32.eq hint 'void) (k:cons 'void #`(set! #,x #,c)) (k:cons (promoted t) #`(begin (set! #,x #,c) #,x))))]
            [(i32.eq hint 'void) (k:cons 'void (store t x (k:fixnum-value (k:cadddr p)) (convert r t where 1)))]
            [else (let ([v (fresh 'v)])
                    (k:cons (promoted t) #`(let ([#,v #,(convert r t where 0)]) #,(store t x (k:fixnum-value (k:cadddr p)) v) #,v)))])))

  (func (memory-op [name i32] [a i32] [o i32] [vs i32]) -> i32
    (let ([op (syn name)])
      (if (i32.eqz o) #`(#,op #,a #,@vs) #`(#,op #,a #,@vs #,(syn (k:fixnum o))))))

  (func (load [t i32] [a i32] [o i32]) -> i32
    (memory-op (case t
                 [(i8) 'i32.load8_s] [(u8) 'i32.load8_u] [(i16) 'i32.load16_s] [(u16) 'i32.load16_u]
                 [else (k:string->symbol (k:format '"~a.load" `(,(kernel-type t))))])
               a o '()))

  (func (store [t i32] [a i32] [o i32] [v i32]) -> i32
    (memory-op (case t
                 [(i8 u8) 'i32.store8] [(i16 u16) 'i32.store16]
                 [else (k:string->symbol (k:format '"~a.store" `(,(kernel-type t))))])
               a o `(,v)))

  (func (address-value [e i32] [env i32]) -> i32
    (let ([r (check e env 0)]) (if (pointer? (k:car r)) (k:cdr r) (convert r 'i32 e 0))))

  ;; ---- values ----

  (func (const [t i32] [n i32]) -> i32 #`(#,(syn (k:string->symbol (k:format '"~a.const" `(,t)))) #,(syn n)))
  (func (i32-const [n i32]) -> i32 (const 'i32 (k:fixnum n)))
  (func (op-name [t i32] [name i32]) -> i32 (syn (k:string->symbol (k:format '"~a.~a" `(,(kernel-type t) ,name)))))

  (func (settle [r i32] [hint i32] [where i32]) -> i32
    (let ([t (settled-for (k:car r) hint)])
      (if (i32.eq t (k:car r)) r (k:cons (promoted t) (convert r t where 0)))))

  (func (settled-for [t i32] [hint i32]) -> i32
    (if (and hint (i32.ne hint 'void) (k:memq t '(lit flit))) hint (settled-type t)))

  (func (as-void [r i32]) -> i32
    (cond [(k:memq (k:car r) '(void none)) (k:cdr r)]
          [(k:memq (k:car r) '(lit flit)) #'(nop)]
          [else #`(drop #,(k:cdr r))]))

  (func (as [r i32] [ty i32] [where i32]) -> i32 (if (i32.eq ty 'void) (as-void r) (convert r ty where 0)))

  (func (join [a i32] [b i32]) -> i32
    (cond [(i32.eq a 'none) b]
          [(i32.eq b 'none) a]
          [(or (i32.eq a 'void) (i32.eq b 'void)) 'void]
          [(k:equal? a b) a]
          [(and (arithmetic? a) (arithmetic? b)) (common a b)]
          [(and (address-type? a) (i32.eq b 'lit)) a]
          [(and (address-type? b) (i32.eq a 'lit)) b]
          [(and (pointer? a) (pointer? b) (or (i32.eq (k:cadr a) 'void) (i32.eq (k:cadr b) 'void))) '(ptr void)]
          [else 'void]))

  (func (common [a i32] [b i32]) -> i32
    (cond [(i32.eq a 'lit) (if (i32.eq b 'flit) 'f64 (settled-type b))]
          [(i32.eq b 'lit) (common b a)]
          [(i32.eq a 'flit) (if (i32.eq b 'f32) 'f32 'f64)]
          [(i32.eq b 'flit) (common b a)]
          [else (let ([ranks '(i32 u32 i64 u64 f32 f64)])
                  (if (i32.lt_u (k:length (k:memq a ranks)) (k:length (k:memq b ranks))) a b))]))

  (func (truth [r i32] [where i32]) -> i32
    (let* ([s (settle r 0 where)] [t (k:car s)])
      (cond [(or (k:memq t '(i32 u32)) (address-type? t)) (k:cdr s)]
            [(arithmetic? t) #`(#,(op-name t 'ne) #,(k:cdr s) #,(const (kernel-type t) (k:fixnum 0)))]
            [else (c-error where '"expected a number or a pointer, got ~s" `(,(shown t)))])))

  (func (boolean [r i32] [where i32]) -> i32
    (let ([s (settle r 0 where)])
      (if (or (k:memq (k:car s) '(i32 u32)) (address-type? (k:car s))) #`(i32.ne #,(k:cdr s) (i32.const 0)) (truth s where))))

  ;; A narrower integer is normalized unless it is stored in memory, which cuts it anyway.
  (func (convert [r i32] [t i32] [where i32] [stored i32]) -> i32
    (let ([from (k:car r)] [c (k:cdr r)] [normalize (i32.eqz stored)])
      (cond [(i32.eq from 'none) c]
            [(i32.eq from 'void) (c-error where '"this has no value, but ~s is expected" `(,(shown t)))]
            [(i32.eq from 'lit) (constant c t where)]
            [(i32.eq from 'flit) (if (float-type? t) (const t c) (convert (k:cons 'f64 (const 'f64 c)) t where stored))]
            [(or (struct-type? t) (struct-type? from) (closure-type? t) (closure-type? from))
             (unless (k:equal? from t) (c-error where '"expected ~s, got ~s" `(,(shown t) ,(shown from))))
             c]
            [(address-type? t)
             (unless (or (k:equal? from t)
                         (and (pointer? from) (pointer? t) (or (i32.eq (k:cadr from) 'void) (i32.eq (k:cadr t) 'void))))
               (c-error where '"expected ~s, got ~s" `(,(shown t) ,(shown from))))
             c]
            [(or (address-type? from) (i32.eqz (arithmetic? t))) (c-error where '"expected ~s, got ~s" `(,(shown t) ,(shown from)))]
            [else (numeric c from t normalize)])))

  (func (zero? [n i32]) -> i32 (and (k:integer? n) (i64.eqz (k:integer-value n))))

  (func (constant [n i32] [t i32] [where i32]) -> i32
    (cond [(address-type? t) (if (zero? n) (i32-const 0) (c-error where '"~a is not a pointer: cast it" `(,n)))]
          [(float-type? t) (const t n)]
          [(integer-type? t)
           (let ([v (k:integer-value n)])
             (const (kernel-type t)
                    (case t
                      [(u8) (k:make-integer (i64.and v (i64.const 255)))]
                      [(u16) (k:make-integer (i64.and v (i64.const 65535)))]
                      [(i8) (k:make-integer (i64.sub (i64.and (i64.add v (i64.const 128)) (i64.const 255)) (i64.const 128)))]
                      [(i16) (k:make-integer (i64.sub (i64.and (i64.add v (i64.const 32768)) (i64.const 65535)) (i64.const 32768)))]
                      [else n])))]
          [else (c-error where '"expected ~s, got ~a" `(,(shown t) ,n))]))

  (func (numeric [c i32] [from i32] [t i32] [normalize i32]) -> i32
    (let* ([to (promoted t)] [kf (kernel-type from)] [kt (kernel-type to)] [signed (k:memq from '(i32 i64))]
           [v (cond [(i32.eq kf kt) c]
                    [(and (i32.eq kf 'i32) (i32.eq kt 'i64)) #`(#,(if signed #'i64.extend_i32_s #'i64.extend_i32_u) #,c)]
                    [(and (i32.eq kf 'i64) (i32.eq kt 'i32)) #`(i32.wrap_i64 #,c)]
                    [(float-type? from)
                     (if (float-type? to)
                         #`(#,(if (i32.eq kt 'f64) #'f64.promote_f32 #'f32.demote_f64) #,c)
                         #`(#,(op-name to (k:format '"trunc_~a_~a" `(,kf ,(if (k:memq to '(i32 i64)) 's 'u)))) #,c))]
                    [else #`(#,(op-name to (k:format '"convert_~a_~a" `(,kf ,(if signed 's 'u)))) #,c)])])
      (if normalize
          (case t
            [(i8) #`(i32.extend8_s #,v)] [(i16) #`(i32.extend16_s #,v)]
            [(u8) #`(i32.and #,v (i32.const 255))] [(u16) #`(i32.and #,v (i32.const 65535))]
            [else v])
          v)))

  (func (check-cast [t i32] [x i32] [env i32]) -> i32
    (let* ([to (parse-type t)] [r (check x env 0)] [from (k:car r)])
      (cond [(i32.eq to 'void) (k:cons 'void (as-void r))]
            [(address-type? to)
             (cond [(i32.eq from 'lit) (k:cons to (const 'i32 (k:cdr r)))]
                   [(or (address-type? from) (k:memq from '(i32 u32))) (k:cons to (k:cdr r))]
                   [(k:memq from '(i64 u64)) (k:cons to #`(i32.wrap_i64 #,(k:cdr r)))]
                   [else (c-error x '"cannot cast ~s to ~s" `(,(shown from) ,(shown to)))])]
            [(and (address-type? from) (integer-type? to)) (k:cons (promoted to) (numeric (k:cdr r) 'u32 to 1))]
            [else (k:cons (promoted (scalar! to t)) (convert r to x 0))])))

  ;; ---- operators ----

  (func (check-op [e i32] [o i32] [args i32] [env i32]) -> i32
    (let ([rs (for/list ([a args]) (check a env 0))] [n (k:length args)])
      (case o
        [(+ * bit-and bit-or bit-xor)
         (arity! e o (i32.ge_u n 2) '"two or more arguments")
         (for/fold ([acc (k:car rs)]) ([b (k:cdr rs)]) (binary e o acc b))]
        [(-)
         (arity! e o (i32.ge_u n 1) '"one or more arguments")
         (if (i32.eq n 1) (negate e (k:car rs)) (for/fold ([acc (k:car rs)]) ([b (k:cdr rs)]) (binary e o acc b)))]
        [(and or) (logical o rs args)]
        [(not) (arity! e o (i32.eq n 1) '"one argument") (k:cons 'i32 #`(i32.eqz #,(truth (k:car rs) (k:car args))))]
        [(bit-not)
         (arity! e o (i32.eq n 1) '"one argument")
         (let ([t (settled-type (k:car (k:car rs)))])
           (unless (integer-type? t) (c-error e '"bit-not takes an integer, not ~s" `(,(shown t))))
           (k:cons t #`(#,(op-name t 'xor) #,(convert (k:car rs) t e 0) #,(const (kernel-type t) (k:fixnum -1)))))]
        [else (arity! e o (i32.eq n 2) '"two arguments") (binary e o (k:car rs) (k:cadr rs))])))

  (func (arity! [e i32] [o i32] [ok i32] [what i32]) (unless ok (c-error e '"~a takes ~a" `(,o ,what))))

  (func (binary [e i32] [o i32] [a i32] [b i32]) -> i32
    (let ([ta (k:car a)] [tb (k:car b)])
      (cond [(and (k:memq o '(+ -)) (pointer? ta) (integer-type? tb)) (offset e o a b)]
            [(and (i32.eq o '+) (integer-type? ta) (pointer? tb)) (offset e o b a)]
            [(and (i32.eq o '-) (pointer? ta) (pointer? tb))
             (unless (k:equal? ta tb) (c-error e '"- takes pointers of one type, not ~s and ~s" `(,(shown ta) ,(shown tb))))
             (let ([size (size-of (complete! (k:cadr ta) e))] [d #`(i32.sub #,(k:cdr a) #,(k:cdr b))])
               (k:cons 'i32 (if (i32.eq size 1) d #`(i32.div_s #,d #,(i32-const size)))))]
            [(k:memq o '(== != < <= > >=))
             (let ([t (cond [(address-type? ta) ta]
                            [(address-type? tb) tb]
                            [(and (arithmetic? ta) (arithmetic? tb)) (common ta tb)]
                            [else (c-error e '"~a compares numbers or pointers, not ~s and ~s" `(,o ,(shown ta) ,(shown tb)))])])
               (k:cons 'i32 #`(#,(instruction o t) #,(convert a t e 0) #,(convert b t e 0))))]
            [(and (arithmetic? ta) (arithmetic? tb))
             (let ([t (if (k:memq o '(<< >>)) (settled-type ta) (common ta tb))])
               (when (and (k:memq o '(% bit-and bit-or bit-xor << >>)) (i32.eqz (and (integer-type? t) (integer-type? tb))))
                 (c-error e '"~a takes integers, not ~s and ~s" `(,o ,(shown ta) ,(shown tb))))
               (k:cons t #`(#,(instruction o t) #,(convert a t e 0) #,(convert b t e 0))))]
            [else (c-error e '"~a takes numbers, not ~s and ~s" `(,o ,(shown ta) ,(shown tb)))])))

  (func (instruction [o i32] [t i32]) -> i32
    (let ([u (or (k:memq t '(u32 u64)) (address-type? t))] [f (float-type? t)])
      (op-name t (case o
                   [(+) 'add] [(-) 'sub] [(*) 'mul] [(/) (if f 'div (if u 'div_u 'div_s))] [(%) (if u 'rem_u 'rem_s)]
                   [(bit-and) 'and] [(bit-or) 'or] [(bit-xor) 'xor] [(<<) 'shl] [(>>) (if u 'shr_u 'shr_s)]
                   [(==) 'eq] [(!=) 'ne]
                   [(<) (if f 'lt (if u 'lt_u 'lt_s))] [(<=) (if f 'le (if u 'le_u 'le_s))]
                   [(>) (if f 'gt (if u 'gt_u 'gt_s))] [(>=) (if f 'ge (if u 'ge_u 'ge_s))] [else 0]))))

  (func (offset [e i32] [o i32] [p i32] [n i32]) -> i32
    (k:cons (k:car p) #`(#,(instruction o 'i32) #,(k:cdr p) #,(scaled n (size-of (complete! (k:cadr (k:car p)) e)) e))))

  (func (scaled [n i32] [size i32] [where i32]) -> i32
    (if (i32.eq (k:car n) 'lit)
        (const 'i32 (k:make-integer (i64.mul (k:integer-value (k:cdr n)) (i64.extend_i32_s size))))
        (let ([i (convert n 'i32 where 0)]) (if (i32.eq size 1) i #`(i32.mul #,i #,(i32-const size))))))

  (func (negate [e i32] [r i32]) -> i32
    (let ([t (k:car r)])
      (cond [(i32.eq t 'lit) (k:cons t (k:make-integer (i64.sub (i64.const 0) (k:integer-value (k:cdr r)))))]
            [(i32.eq t 'flit) (k:cons t (k:make-flonum (f64.neg (k:flonum-value (k:cdr r)))))]
            [(float-type? t) (k:cons t #`(#,(op-name t 'neg) #,(k:cdr r)))]
            [(integer-type? t) (k:cons t #`(#,(op-name t 'sub) #,(const (kernel-type t) (k:fixnum 0)) #,(k:cdr r)))]
            [else (c-error e '"- takes a number, not ~s" `(,(shown t)))])))

  (func (logical [o i32] [rs i32] [args i32]) -> i32
    (cond [(k:null? rs) (k:cons 'lit (k:fixnum (if (i32.eq o 'and) 1 0)))]
          [(k:null? (k:cdr rs)) (k:cons 'i32 (boolean (k:car rs) (k:car args)))]
          [else (let ([t (truth (k:car rs) (k:car args))] [rest (k:cdr (logical o (k:cdr rs) (k:cdr args)))])
                  (k:cons 'i32 (if (i32.eq o 'and) #`(if #,t #,rest (i32.const 0)) #`(if #,t (i32.const 1) #,rest))))]))

  ;; ---- control ----

  (func (exception-types [t i32]) -> i32
    (k:car (or (and (i32.eq (k:identifier-binding-kind t) 'tag) (fact t 'c-exception))
               (c-error t '"~a is not an exception" `(,(k:syntax-e t))))))

  ;; A throw is a call of a function that throws, one per exception: a function with a throw in
  ;; it is slower to call, in wasmtime by some ten times a short function's cost.
  (func (check-throw [e i32] [t i32] [args i32] [env i32]) -> i32
    (let ([ts (exception-types t)])
      (unless (i32.eq (k:length ts) (k:length args))
        (c-error e '"~a carries ~a value~a, not ~a" `(,(k:syntax-e t) ,(k:fixnum (k:length ts)) ,(plural (k:length ts)) ,(k:fixnum (k:length args)))))
      (k:cons 'none #`(begin (#%app #,(thrower t ts) #,@(for/list ([a args] [u ts]) (expect a u env 0))) (unreachable)))))

  (global thrower-table (mut i32) 0)
  (func (throwers) -> i32
    (when (i32.eqz thrower-table) (set! thrower-table (k:make-table)))
    thrower-table)

  (func (thrower [t i32] [ts i32]) -> i32
    (let ([known (k:datum-get (throwers) (k:identifier-name t))])
      (if known
          (k:syntax-local-introduce known)
          (let ([f (fresh (k:format '"throw-~a" `(,(k:syntax-e t))))] [xs (for/list ([u ts]) (fresh 'x))])
            (drop (k:syntax-local-lift-definition
                   #`(func (#,f #,@(for/list ([x xs] [u ts]) #`[#,x #,(syn (kernel-type u))])) (throw #,t #,@xs))))
            (k:datum-put! (throwers) (k:identifier-name t) (k:syntax-local-introduce f))
            f))))

  ;; Each handler first gives the stack back to where it was when the try began: the frames of
  ;; the calls the exception left were not given back.
  (func (check-try [names i32] [body i32] [clauses i32] [env i32] [hint i32]) -> i32
    (let* ([b (check body env hint)]
           [hs (for/list ([n names] [c clauses])
                 (if (i32.eq (k:syntax-e n) '_)
                     (syntax-match c [('begin h ...) `(#f () ,(check-sequence c h env hint) ,c)])
                     (syntax-match c
                       [('let ((x _) ...) h ...)
                        (let ([ts (exception-types n)])
                          (unless (i32.eq (k:length x) (k:length ts))
                            (c-error c '"~a carries ~a value~a, not ~a"
                                     `(,(k:syntax-e n) ,(k:fixnum (k:length ts)) ,(plural (k:length ts)) ,(k:fixnum (k:length x)))))
                          `(,n ,x ,(check-sequence c h (k:append (for/list ([y x] [u ts]) `(,(k:local-binding y) ,u)) env) hint) ,c))])))]
           [ty (promoted (settled-for (for/fold ([ty (k:car b)]) ([h hs]) (join ty (k:car (k:caddr h)))) hint))]
           [s (fresh 'sp)])
      (k:cons ty #`(let ([#,s sp])
                     (try (#,@(for/list ([h hs])
                                (let ([code #`(begin (set! sp #,s) #,(as (k:caddr h) ty (k:cadddr h)))])
                                  (if (k:car h) #`(catch #,(k:car h) (#,@(k:cadr h)) #,code) #`(catch-all #,code)))))
                       #,(as b ty body))))))

  (func (check-while [c i32] [body i32] [step i32] [env i32]) -> i32
    (let* ([brk (fresh 'break)] [cont (fresh 'continue)] [top (fresh 'loop)]
           [r (check c env 0)]
           [forever (and (i32.eq (k:car r) 'lit) (i32.eqz (zero? (k:cdr r))))]
           [t (truth r c)]
           [b (let ([l0 loops] [v 0])
                (set! loops (k:cons (k:cons brk cont) loops))
                (set! v (try ([catch needs-frame () (set! loops l0) (throw needs-frame)]) (as-void (check body env 'void))))
                (set! loops l0)
                v)]
           [s (for/list ([x step]) (as-void (check x env 'void)))])
      (if forever
          (let ([code #`(block #,brk (loop #,top (block #,cont #,b) #,@s (br #,top)))])
            (if (k:memq brk broken) (k:cons 'void code) (k:cons 'none #`(begin #,code (unreachable)))))
          (k:cons 'void #`(block #,brk (loop #,top (br-if #,brk (i32.eqz #,t)) (block #,cont #,b) #,@s (br #,top)))))))

  (func (jump [e i32] [leaving i32]) -> i32
    (when (k:null? loops) (c-error e '"not in a loop" '()))
    (when leaving (set! broken (k:cons (k:car (k:car loops)) broken)))
    (k:cons 'none #`(br #,(if leaving (k:car (k:car loops)) (k:cdr (k:car loops))))))

  ;; ---- string literals ----

  (global string-table (mut i32) 0)
  (func (strings) -> i32
    (when (i32.eqz string-table) (set! string-table (k:make-table)))
    string-table)

  ;; A session drops what a failed input defined, this global among them, so s is lifted again
  ;; if it is gone.
  (func (string-literal [s i32]) -> i32
    (let ([known (k:datum-get (strings) s)])
      (k:cons '(ptr u8)
              (if (and known (k:identifier-binding-kind (k:syntax-local-introduce known)))
                  (k:syntax-local-introduce known)
                  (let* ([bs (k:string-bytes s)] [len (k:string-length s)] [g (fresh 'string)] [p (fresh 'p)])
                    (drop (k:syntax-local-lift-definition
                           #`(global #,g (mut i32)
                                     (let ([#,p (sbrk #,(syn (k:fixnum (i32.add len 1))))])
                                       #,@(string-stores p bs len 0)
                                       #,p))))
                    (k:datum-put! (strings) s (k:syntax-local-introduce g))
                    g)))))

  (func (string-stores [p i32] [bs i32] [len i32] [i i32]) -> i32
    (let ([n (i32.add len 1)])
      (cond [(i32.le_u (i32.add i 8) n) (k:cons (store 'u64 p i (const 'i64 (k:make-integer (word bs len i)))) (string-stores p bs len (i32.add i 8)))]
            [(i32.lt_u i n) (k:cons (store 'u8 p i (i32-const (byte-at bs len i))) (string-stores p bs len (i32.add i 1)))]
            [else '()])))

  (func (byte-at [bs i32] [len i32] [i i32]) -> i32 (if (i32.lt_u i len) (i32.load8_u (i32.add bs i)) 0))

  (func (word [bs i32] [len i32] [i i32]) -> i64
    (let ([w (i64.const 0)] [j 7])
      (block done
        (loop next
          (set! w (i64.or (i64.shl w (i64.const 8)) (i64.extend_i32_u (byte-at bs len (i32.add i j)))))
          (br-if done (i32.eqz j))
          (set! j (i32.sub j 1))
          (br next)))
      w))

  ;; ---- modules ----
  ;; The require's path is relative to this file, where it is written.
  (func (c-module-begin [s i32]) -> i32
    #`(begin #,(k:datum->syntax #'here '(begin (require %lang "lang.sub") (memory from %lang) (table from %lang)) #'here)
             #,@(k:cdr (k:syntax->list s))))

  ;; ---- sessions ----
  (func (c-interaction [s i32]) -> i32
    (syntax-match s
      [(_ e)
       (let ([x (begin (set! quoter s) (start-function! 'void 0) (k:local-expand e))])
         (scan x)
         (with-frame (func-index interaction-walk) x))]))

  (func (interaction-walk [e i32]) -> i32
    (framed '() (k:cons 'void (written-value (settle (check e '() 0) 0 e) e))))

  (func (written-value [r i32] [e i32]) -> i32
    (let ([t (k:car r)] [c (k:cdr r)])
      (cond [(k:memq t '(void none)) c]
            [(i32.eq t 'i32) #`(begin (print:write-int #,c) (print:newline))]
            [(i32.eq t 'u32) #`(begin (print:write-u64 (i64.extend_i32_u #,c)) (print:newline))]
            [(i32.eq t 'i64) #`(begin (print:write-i64 #,c) (print:newline))]
            [(i32.eq t 'u64) #`(begin (print:write-u64 #,c) (print:newline))]
            [(i32.eq t 'f64) #`(begin (kd:write-datum (kd:make-flonum #,c)) (print:newline))]
            [(i32.eq t 'f32) #`(begin (kd:write-datum (kd:make-flonum (f64.promote_f32 #,c))) (print:newline))]
            [(k:equal? t '(ptr u8))
             #`(let ([p #,c] [n 0])
                 (if p
                     (begin
                       (block done
                         (loop next
                           (br-if done (i32.eqz (i32.load8_u (i32.add p n))))
                           (set! n (i32.add n 1))
                           (br next)))
                       (print:write-byte 34)
                       (print:write-bytes p n)
                       (print:write-byte 34))
                     (print:write-int 0))
                 (print:newline))]
            [(address-type? t) #`(begin (print:write-u64 (i64.extend_i32_u #,c)) (print:newline))]
            [else
             (let ([text (k:format '"#<~s>" `(,(shown t)))])
               #`(begin
                   #,(as-void r)
                   (print:write-bytes #,(k:cdr (string-literal text)) #,(i32-const (k:string-length text)))
                   (print:newline)))]))))

