;; Closure analysis of a function: its known functions and its boxed variables.
(require-unqualified base "base/base.sub")
(require-unqualified k "kernel.sub")
(require-unqualified core "core.sub")

(provide closures analyze-closures closures-boxed? closures-known-of closures-captures-of head-local
         known-fn)

(struct closures [boxed (ptr arena-table)] [known (ptr arena-table)] [captures (ptr arena-table)])

(struct known-fn [lambda datum] [captures datum] [info datum] [lifted i32] [name datum])

(define (slot [key datum]) -> u64 (cast u64 (integer-value key)))

(define (closures-boxed? [a (ptr closures)] [key datum]) -> i32 (!= (table-ref (-> a boxed) (slot key)) 0))
(define (closures-known-of [a (ptr closures)] [key datum]) -> (ptr known-fn)
  (cast (ptr known-fn) (table-ref (-> a known) (slot key))))
(define (closures-captures-of [a (ptr closures)] [lambda-key datum]) -> datum
  (let ([c (cast datum (table-ref (-> a captures) (slot lambda-key)))]) (if (== c 0) nil c)))

(define (unwrapped [e datum]) -> datum
  (if (or (== (car e) (sym at)) (== (car e) (sym as))) (unwrapped (caddr e)) e))

(define (lambda-node? [e datum]) -> i32 (== (car (unwrapped e)) (sym lambda)))
(define (false-node? [e datum]) -> i32
  (let ([u (unwrapped e)]) (and (== (car u) (sym quote)) (== (cadr u) 0))))

(define (head-local [head datum]) -> datum
  (let* ([h (unwrapped head)] [kind (car h)])
    (cond [(== kind (sym lref)) (cons (cadr h) 0)]
          [(== kind (sym gc)) (if (== (cadr h) (sym ref.cast)) (cast-of h) 0)]
          [(== kind (sym if))
           (let ([t (unwrapped (cadr h))] [c (unwrapped (caddr h))] [x datum 0] [y datum 0])
             (unless (and (== (car t) (sym gc)) (== (cadr t) (sym ref.test)) (== (car c) (sym gc)) (== (cadr c) (sym ref.cast)))
               (return 0))
             (set! x (cast-of t))
             (set! y (cast-of c))
             (if (and (!= x 0) (!= y 0) (equal? (car x) (car y)) (== (cdr x) (cdr y)) (!= (cadddr h) 0)
                      (not (mentions? (cadddr h) (car x))))
                 x
                 0))]
          [else 0])))

(define (cast-of [g datum]) -> datum
  (let ([x (unwrapped (car (cadddr g)))])
    (if (== (car x) (sym lref)) (cons (cadr x) (ref-heap (car (caddr g)))) 0)))

(define (mentions? [e datum] [key datum]) -> i32
  (cond [(not (pair? e)) 0]
        [(== (car e) (sym quote)) 0]
        [(and (== (car e) (sym lref)) (equal? (cadr e) key)) 1]
        [else (let ([l (cdr e)])
                (while (pair? l)
                  (when (mentions? (car l) key) (return 1))
                  (set! l (cdr l)))
                0)]))

(struct frame [lambda datum] [bound (ptr arena-table)] [next (ptr frame)])

(struct walk [assigned (ptr arena-table)] [free (ptr arena-table)] [lambdas (ptr arena-table)]
        [bound-to (ptr arena-table)] [sets (ptr arena-table)] [set-to (ptr arena-table)] [escapes (ptr arena-table)]
        [casts (ptr arena-table)] [names (ptr arena-table)] [frames (ptr frame)]
        [assigned-keys datum] [lambda-keys datum] [bound-keys datum])

(define (ref [t (ptr arena-table)] [key datum]) -> datum (cast datum (table-ref t (slot key))))
(define (put! [t (ptr arena-table)] [key datum] [value datum]) (table-set! t (slot key) (cast u32 value)))

(define (bind! [w (ptr walk)] [key datum]) (table-set! (-> w frames bound) (slot key) 1))

(define (reference! [w (ptr walk)] [key datum])
  (let ([f (-> w frames)])
    (while (and (!= f 0) (== (table-ref (-> f bound) (slot key)) 0))
      (let ([l (-> f lambda)])
        (when (and (!= l 0) (== (member key (list-or-nil (ref (-> w free) l))) 0))
          (put! (-> w free) l (cons key (list-or-nil (ref (-> w free) l))))))
      (set! f (-> f next)))))

(define (list-or-nil [l datum]) -> datum (if (== l 0) nil l))

(define (walk-lambda [w (ptr walk)] [node datum])
  (let ([f (cast (ptr frame) (alloc-in (current-arena) (sizeof frame)))] [ps (caddr node)])
    (set! (-> f lambda) (cadr node))
    (set! (-> f bound) (make-table))
    (while (pair? ps)
      (table-set! (-> f bound) (slot (car (car ps))) 1)
      (set! ps (cdr ps)))
    (when (== (ref (-> w lambdas) (cadr node)) 0) (set! (-> w lambda-keys) (cons (cadr node) (-> w lambda-keys))))
    (put! (-> w lambdas) (cadr node) node)
    (set! (-> f next) (-> w frames))
    (set! (-> w frames) f)
    (walk! w (list-ref node 4))
    (set! (-> w frames) (-> f next))))

(define (walk-all! [w (ptr walk)] [es datum])
  (while (pair? es)
    (walk! w (car es))
    (set! es (cdr es))))

(define (note-bound-to! [w (ptr walk)] [key datum] [v datum])
  (when (== (ref (-> w bound-to) key) 0) (set! (-> w bound-keys) (cons key (-> w bound-keys))))
  (put! (-> w bound-to) key v))

(define (walk! [w (ptr walk)] [e datum])
  (let ([kind (car e)])
    (cond
      [(or (== kind (sym at)) (== kind (sym as))) (walk! w (caddr e))]
      [(== kind (sym lref)) (reference! w (cadr e)) (put! (-> w escapes) (cadr e) (boolean 1))]
      [(== kind (sym lset))
       (let ([key (cadr e)] [v (caddr e)])
         (reference! w key)
         (when (== (ref (-> w assigned) key) 0) (set! (-> w assigned-keys) (cons key (-> w assigned-keys))))
         (put! (-> w assigned) key (boolean 1))
         (table-set! (-> w sets) (slot key) (+ (table-ref (-> w sets) (slot key)) 1))
         (if (lambda-node? v)
             (begin
               (when (and (== (ref (-> w bound-to) key) (sym false)) (== (table-ref (-> w sets) (slot key)) 1))
                 (put! (-> w set-to) key (cadr (unwrapped v))))
               (walk-lambda w (unwrapped v)))
             (walk! w v)))]
      [(== kind (sym gset)) (walk! w (caddr e))]
      [(== kind (sym let))
       (let ([bs (cadr e)])
         (while (pair? bs)
           (let* ([b (car bs)] [key (car b)] [init (caddr b)])
             (cond [(pair? key) (walk! w init)]
                   [else
                    (when (pair? (cdddr b)) (put! (-> w names) key (cadddr b)))
                    (cond [(lambda-node? init)
                           (note-bound-to! w key (cadr (unwrapped init)))
                           (walk-lambda w (unwrapped init))]
                          [(false-node? init) (note-bound-to! w key (sym false))]
                          [else (walk! w init)])]))
           (set! bs (cdr bs))))
       (let ([bs (cadr e)])
         (while (pair? bs)
           (let ([ks (car (car bs))])
             (if (pair? ks)
                 (while (pair? ks) (bind! w (car ks)) (set! ks (cdr ks)))
                 (bind! w ks)))
           (set! bs (cdr bs))))
       (walk! w (caddr e))]
      [(== kind (sym lambda)) (walk-lambda w e)]
      [(== kind (sym apply-value))
       (let ([h (head-local (cadr e))])
         (if (!= h 0)
             (begin
               (reference! w (car h))
               (when (!= (cdr h) 0) (put! (-> w casts) (car h) (cons (cdr h) (list-or-nil (ref (-> w casts) (car h)))))))
             (walk! w (cadr e))))
       (walk-all! w (caddr e))]
      [(or (== kind (sym seq)) (== kind (sym select)) (== kind (sym drop)) (== kind (sym values))) (walk-all! w (cdr e))]
      [(== kind (sym if))
       (walk! w (cadr e))
       (walk! w (caddr e))
       (when (!= (cadddr e) 0) (walk! w (cadddr e)))]
      [(or (== kind (sym block)) (== kind (sym loop)) (== kind (sym br-if))) (walk! w (caddr e))]
      [(== kind (sym br-table)) (walk! w (cadddr e))]
      [(== kind (sym br)) (when (!= (caddr e) 0) (walk! w (caddr e)))]
      [(or (== kind (sym return)) (== kind (sym throw-ref))) (when (!= (cadr e) 0) (walk! w (cadr e)))]
      [(or (== kind (sym call)) (== kind (sym throw))) (walk-all! w (caddr e))]
      [(or (== kind (sym prim)) (== kind (sym gc))) (walk-all! w (cadddr e))]
      [(== kind (sym call-indirect)) (walk! w (cadddr e)) (walk-all! w (list-ref e 4))]
      [(== kind (sym call-ref)) (walk! w (caddr e)) (walk-all! w (cadddr e))]
      [(== kind (sym try))
       (let ([cs (cadr e)])
         (while (pair? cs)
           (for-each (lambda ([key datum]) (bind! w key)) (caddr (car cs)))
           (walk! w (cadddr (car cs)))
           (set! cs (cdr cs))))
       (walk! w (caddr e))])))

(define (lambda-key-of [w (ptr walk)] [key datum]) -> datum
  (let ([b (ref (-> w bound-to) key)]) (if (== b (sym false)) (ref (-> w set-to) key) b)))

(define (free-of [w (ptr walk)] [lambda-key datum]) -> datum (reverse (list-or-nil (ref (-> w free) lambda-key))))

(define (known-key? [w (ptr walk)] [key datum]) -> i32
  (let* ([b (ref (-> w bound-to) key)] [n (table-ref (-> w sets) (slot key))]
         [l (if (== b (sym false)) (ref (-> w set-to) key) b)]
         [node (if (!= l 0) (ref (-> w lambdas) l) 0)])
    (and (!= node 0) (== (ref (-> w escapes) key) 0)
         (if (== b (sym false)) (== n 1) (== n 0))
         (let ([c (closure-type (map (lambda ([p datum]) -> datum (cdr p)) (caddr node)) (cadddr node))]
               [casts (list-or-nil (ref (-> w casts) key))])
           (while (pair? casts)
             (unless (== (car casts) c) (return 0))
             (set! casts (cdr casts)))
           1))))

(define (not-known [known datum] [keys datum]) -> datum
  (let ([acc nil])
    (while (pair? keys)
      (when (== (member (car keys) known) 0) (set! acc (cons (car keys) acc)))
      (set! keys (cdr keys)))
    (reverse acc)))

(define (expanded [known datum] [captures (ptr arena-table)] [keys datum]) -> datum
  (let ([acc nil])
    (while (pair? keys)
      (let ([x (car keys)])
        (if (!= (member x known) 0)
            (let ([ys (list-or-nil (ref captures x))])
              (while (pair? ys)
                (when (== (member (car ys) acc) 0) (set! acc (append acc (cons (car ys) nil))))
                (set! ys (cdr ys))))
            (when (== (member x acc) 0) (set! acc (append acc (cons x nil))))))
      (set! keys (cdr keys)))
    acc))

(define (grow-once! [w (ptr walk)] [known datum] [captures (ptr arena-table)]) -> i32
  (let ([keys known])
    (while (pair? keys)
      (let ([key (car keys)] [xs (free-of w (lambda-key-of w (car keys)))])
        (while (pair? xs)
          (when (!= (member (car xs) known) 0)
            (let ([ys (list-or-nil (ref captures (car xs)))] [mine (list-or-nil (ref captures key))])
              (while (pair? ys)
                (when (== (member (car ys) mine) 0)
                  (put! captures key (append mine (cons (car ys) nil)))
                  (return 1))
                (set! ys (cdr ys)))))
          (set! xs (cdr xs))))
      (set! keys (cdr keys)))
    0))

(define (analyze-closures [body datum] [params datum]) -> (ptr closures)
  (let ([w (cast (ptr walk) (alloc-in (current-arena) (sizeof walk)))]
        [top (cast (ptr frame) (alloc-in (current-arena) (sizeof frame)))])
    (set! (-> w assigned) (make-table))
    (set! (-> w free) (make-table))
    (set! (-> w lambdas) (make-table))
    (set! (-> w bound-to) (make-table))
    (set! (-> w sets) (make-table))
    (set! (-> w set-to) (make-table))
    (set! (-> w escapes) (make-table))
    (set! (-> w casts) (make-table))
    (set! (-> w names) (make-table))
    (set! (-> w assigned-keys) nil)
    (set! (-> w lambda-keys) nil)
    (set! (-> w bound-keys) nil)
    (set! (-> top lambda) 0)
    (set! (-> top bound) (make-table))
    (set! (-> top next) 0)
    (for-each (lambda ([key datum]) (table-set! (-> top bound) (slot key) 1)) params)
    (set! (-> w frames) top)
    (walk! w body)
    (finish-analysis w)))

(define (finish-analysis [w (ptr walk)]) -> (ptr closures)
  (let ([known (filter (lambda ([key datum]) -> i32 (known-key? w key)) (reverse (-> w bound-keys)))]
        [captures (make-table)] [lambda-captures (make-table)] [captured (make-table)] [known-table (make-table)]
        [boxed (make-table)] [a (cast (ptr closures) (alloc-in (current-arena) (sizeof closures)))])
    (for-each (lambda ([key datum]) (put! captures key (not-known known (free-of w (lambda-key-of w key))))) known)
    (let ([more 1]) (while more (set! more (grow-once! w known captures))))
    (for-each (lambda ([lambda-key datum])
                (let ([xs (free-of w lambda-key)])
                  (while (pair? xs)
                    (table-set! captured (slot (car xs)) 1)
                    (set! xs (cdr xs))))
                (put! lambda-captures lambda-key (expanded known captures (free-of w lambda-key))))
              (reverse (-> w lambda-keys)))
    (for-each (lambda ([key datum])
                (let ([k (cast (ptr known-fn) (alloc-in (current-arena) (sizeof known-fn)))] [l (lambda-key-of w key)]
                      [name (ref (-> w names) key)])
                  (set! (-> k lambda) (ref (-> w lambdas) l))
                  (set! (-> k captures) (list-or-nil (ref lambda-captures l)))
                  (set! (-> k info) 0)
                  (set! (-> k lifted) 0)
                  (set! (-> k name) (if (== name 0) (sym f) name))
                  (table-set! known-table (slot key) (cast u32 k))))
              known)
    (for-each (lambda ([key datum])
                (when (and (!= (table-ref captured (slot key)) 0) (== (member key known) 0))
                  (table-set! boxed (slot key) 1)))
              (-> w assigned-keys))
    (set! (-> a boxed) boxed)
    (set! (-> a known) known-table)
    (set! (-> a captures) lambda-captures)
    a))
