;; The host's functions, each declared once: here, or for write and trap in substrate.sub, which
;; Substrate itself rests on. Their pointers are typed, so a caller passes them without casts. The
;; kernel module and what it rests on, which compile-time code shares, must not require this.

(provide host-arg host-exit host-read-file host-write-file host-make-dir host-instantiate
         host-export-index host-error-message host-program-modules host-module-bytes read-file-bytes
         write-file-bytes instantiate-bytes)

(import arg "host" "arg" (i32 i32 i32 -> i32))
(import exit "host" "exit" (i32 ->))
(import read_file "host" "read_file" (i32 i32 i32 i32 -> i32))
(import write_file "host" "write_file" (i32 i32 i32 i32 -> i32))
(import make_dir "host" "make_dir" (i32 i32 -> i32))
(import instantiate "host" "instantiate" (i32 i32 i32 i32 i32 i32 i32 -> i32))
(import export_index "host" "export_index" (i32 i32 i32 i32 -> i32))
(import error_message "host" "error_message" (i32 i32 -> i32))
(import program_modules "host" "program_modules" (i32 i32 -> i32))
(import module_bytes "host" "module_bytes" (i32 i32 i32 i32 -> i32))

(define (host-arg [i i32] [p (ptr u8)] [cap i32]) #:inline -> i32 (arg i (cast i32 p) cap))
(define (host-exit [code i32]) #:inline (exit code))
(define (host-read-file [pp (ptr u8)] [pl i32] [p (ptr u8)] [cap i32]) #:inline -> i32
  (read_file (cast i32 pp) pl (cast i32 p) cap))
(define (host-write-file [pp (ptr u8)] [pl i32] [p (ptr u8)] [n i32]) #:inline -> i32
  (write_file (cast i32 pp) pl (cast i32 p) n))
(define (host-make-dir [pp (ptr u8)] [pl i32]) #:inline -> i32 (make_dir (cast i32 pp) pl))
(define (host-instantiate [np (ptr u8)] [nl i32] [bp (ptr u8)] [bl i32] [mp (ptr u8)] [ml i32] [compile-time i32])
  #:inline -> i32
  (instantiate (cast i32 np) nl (cast i32 bp) bl (cast i32 mp) ml compile-time))
(define (host-export-index [ip (ptr u8)] [il i32] [fp (ptr u8)] [fl i32]) #:inline -> i32
  (export_index (cast i32 ip) il (cast i32 fp) fl))
(define (host-error-message [p (ptr u8)] [cap i32]) #:inline -> i32 (error_message (cast i32 p) cap))
(define (host-program-modules [p (ptr u8)] [cap i32]) #:inline -> i32 (program_modules (cast i32 p) cap))
(define (host-module-bytes [np (ptr u8)] [nl i32] [p (ptr u8)] [cap i32]) #:inline -> i32
  (module_bytes (cast i32 np) nl (cast i32 p) cap))

;; A file's bytes, with a 0 after them, or 0 if it cannot be read. Its size goes to n, unless n is 0.
(define (read-file-bytes [path (ptr u8)] [n (ptr u32)]) -> (ptr u8)
  (let* ([length (strlen path)] [size (host-read-file path length 0 0)])
    (if (< size 0)
        0
        (let ([p (cast (ptr u8) (malloc (+ size 1)))])
          (if (!= (host-read-file path length p size) size)
              (begin (free p) 0)
              (begin
                (set! (@ p size) 0)
                (when (!= n 0) (set! (@ n) size))
                p))))))

(define (write-file-bytes [path (ptr u8)] [p (ptr u8)] [n u32]) -> i32
  (>= (host-write-file path (strlen path) p n) 0))

(define (instantiate-bytes [np (ptr u8)] [nl u32] [b (ptr u8)] [bl u32] [mp (ptr u8)] [ml u32] [compile-time i32]) -> i32
  (== (host-instantiate np nl b bl mp ml compile-time) 0))
