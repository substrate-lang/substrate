;; Lifecycle: permanent. Part of the compiler.
;;
;; The compiler's calls to the host (spec 4): instantiating linklets
;; through the hook, and calling functions of instances through this
;; module's table. Kernel code, so that its literals are wasm numbers;
;; names are strings and linklets Substrate byte strings, passed through
;; this module's memory.
(require s syntax)
(require sub "../lib/substrate.sub")

(provide instantiate-linklet export-index call-getter call-pass scope-map-add scope-map-clear)

(memory 1)
(table 1)

(import host-instantiate "host" "instantiate" (i32 i32 i32 i32 i32 -> i32))
(import host-export-index "host" "export_index" (i32 i32 i32 i32 -> i32))
(import host-error-message "host" "error_message" (i32 i32 -> i32))
(import %scope-map-add "syntax" "%scope-map-add" (i32 i32 ->))
(import %scope-map-clear "syntax" "%scope-map-clear" (->))

;; Room for n bytes from address 0.
(func (reserve [n i32])
  (let ([have (i32.mul (memory.size) 65536)])
    (if (i32.gt_u n have)
        (drop (memory.grow (i32.div_u (i32.add (i32.sub n have) 65535) 65536))))))

;; String s's bytes at address at.
(func (store-string [s eqref] [at i32])
  (let ([n (s:string-length s)] [i 0])
    (block done
      (loop next
        (br-if done (i32.ge_u i n))
        (i32.store8 (i32.add at i) (s:string-byte s i))
        (set! i (i32.add i 1))
        (br next)))))

;; The host's message for its last failure, as a string.
(func (error-string) -> eqref
  (reserve 4096)
  (let ([n (host-error-message 0 4096)] [b (s:make-string-builder)] [i 0])
    (block done
      (loop next
        (br-if done (i32.ge_u i n))
        (s:string-builder-add-byte! b (i32.load8_u i))
        (set! i (i32.add i 1))
        (br next)))
    (s:string-builder->string b)))

;; Instantiate byte string code as instance name, a string, at phase shift
;; shift, linking its imports by name (spec 3.2, 4). #f, or the host's
;; error message.
(func (instantiate-linklet [name eqref] [code eqref] [shift eqref]) -> eqref
  (let ([b (ref.cast (ref sub:bytes) code)] [nl (s:string-length name)] [i 0])
    (reserve (i32.add nl (array.len b)))
    (store-string name 0)
    (block done
      (loop next
        (br-if done (i32.ge_u i (array.len b)))
        (i32.store8 (i32.add nl i) (array.get_u sub:bytes b i))
        (set! i (i32.add i 1))
        (br next)))
    (if (host-instantiate 0 nl nl (array.len b) (s:fixnum-value shift))
        (error-string)
        (ref.null eq))))

;; The index in this module's table of function field of instance inst,
;; both strings, or #f if there is none.
(func (export-index [inst eqref] [field eqref]) -> eqref
  (let ([il (s:string-length inst)] [fl (s:string-length field)] [k 0])
    (reserve (i32.add il fl))
    (store-string inst 0)
    (store-string field il)
    (set! k (host-export-index 0 il il fl))
    (if (i32.lt_s k 0) (ref.null eq) (s:fixnum k))))

;; Call the function at a table index: a getter of a compile-time value,
;; or a module pass given syntax.
(func (call-getter [index eqref]) -> eqref (call-indirect (-> eqref) (s:fixnum-value index)))
(func (call-pass [index eqref] [arg eqref]) -> eqref (call-indirect (eqref -> eqref) (s:fixnum-value index) arg))

;; The syntax library's scope map, for the literals of a linklet
;; instantiated at a phase shift (spec 6.1).
(func (scope-map-add [from eqref] [to eqref]) -> eqref
  (%scope-map-add (s:fixnum-value from) (s:fixnum-value to))
  (ref.null eq))
(func (scope-map-clear) -> eqref (%scope-map-clear) (ref.null eq))
