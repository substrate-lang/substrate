;; Lifecycle: permanent. Part of the compiler.
;;
;; The compiler's calls to the host (spec 4) for running compile-time
;; code, beyond Substrate's instantiate: calling functions of instances
;; through this module's table, and the host's message after a trap.
;; Kernel code, so that its literals are wasm numbers; names are strings,
;; passed through this module's memory.
(require k kernel)

(provide export-index call-getter scope-map-add scope-map-clear error-string)

(memory 1)
(table 1)

(import host-export-index "host" "export_index" (i32 i32 i32 i32 -> i32))
(import host-error-message "host" "error_message" (i32 i32 -> i32))
(import %scope-map-add "kernel" "%scope-map-add" (i32 i32 ->))
(import %scope-map-clear "kernel" "%scope-map-clear" (->))

;; Room for n bytes from address 0.
(func (reserve [n i32])
  (let ([have (i32.mul (memory.size) 65536)])
    (if (i32.gt_u n have)
        (drop (memory.grow (i32.div_u (i32.add (i32.sub n have) 65535) 65536))))))

;; String s's bytes at address at.
(func (store-string [s eqref] [at i32])
  (let ([n (k:string-length s)] [i 0])
    (block done
      (loop next
        (br-if done (i32.ge_u i n))
        (i32.store8 (i32.add at i) (k:string-byte s i))
        (set! i (i32.add i 1))
        (br next)))))

;; The host's message for its last failure, as a string.
(func (error-string) -> eqref
  (reserve 4096)
  (let ([n (host-error-message 0 4096)] [b (k:make-string-builder)] [i 0])
    (block done
      (loop next
        (br-if done (i32.ge_u i n))
        (k:string-builder-add-byte! b (i32.load8_u i))
        (set! i (i32.add i 1))
        (br next)))
    (k:string-builder->string b)))

;; The index in this module's table of function field of instance inst,
;; both strings, or #f if there is none.
(func (export-index [inst eqref] [field eqref]) -> eqref
  (let ([il (k:string-length inst)] [fl (k:string-length field)] [k 0])
    (reserve (i32.add il fl))
    (store-string inst 0)
    (store-string field il)
    (set! k (host-export-index 0 il il fl))
    (if (i32.lt_s k 0) (ref.null eq) (k:fixnum k))))

;; Call the getter of a compile-time value at a table index.
(func (call-getter [index eqref]) -> eqref (call-indirect (-> eqref) (k:fixnum-value index)))

;; The kernel module's scope map, for the literals of a linklet
;; instantiated at a phase shift (spec 6.1).
(func (scope-map-add [from eqref] [to eqref]) -> eqref
  (%scope-map-add (k:fixnum-value from) (k:fixnum-value to))
  (ref.null eq))
(func (scope-map-clear) -> eqref (%scope-map-clear) (ref.null eq))
