;; Lifecycle: permanent.
;;
;; The compiler's calls to the host (spec 4): reading and writing files
;; (read-file-bytes, write-file-bytes), and instantiating compile-time
;; code (instantiate-bytes), finding its functions (export-index) and
;; reading the message of the last error (error-message).
(require-unqualified base "base/base.sub")

(provide read-file-bytes write-file-bytes instantiate-bytes export-index error-message)

(memory from base)
(table from base)

(import host-read-file "host" "read_file" (i32 i32 i32 i32 -> i32))
(import host-write-file "host" "write_file" (i32 i32 i32 i32 -> i32))

;; The bytes of the file named by C string path, followed by a 0, in
;; memory from malloc, and their count at n; or 0 if it cannot be read.
(define (read-file-bytes [path (ptr u8)] [n (ptr u32)]) -> (ptr u8)
  (let* ([length (strlen path)] [size (host-read-file (cast i32 path) length 0 0)])
    (if (< size 0)
        0
        (let ([p (cast (ptr u8) (malloc (+ size 1)))])
          (if (!= (host-read-file (cast i32 path) length (cast i32 p) size) size)
              (begin (free p) 0)
              (begin
                (set! (@ p size) 0)
                (set! (@ n) size)
                p))))))

;; The n bytes at p written to the file named by C string path, made or
;; replaced: 1, or 0 if it cannot be.
(define (write-file-bytes [path (ptr u8)] [p (ptr u8)] [n u32]) -> i32
  (>= (host-write-file (cast i32 path) (strlen path) (cast i32 p) n) 0))

;; ---- compile-time code ----

(import host-instantiate "host" "instantiate" (i32 i32 i32 i32 i32 i32 -> i32))
(import host-export-index "host" "export_index" (i32 i32 i32 i32 -> i32))
(import host-error-message "host" "error_message" (i32 i32 -> i32))

;; Compile the bl bytes at b and instantiate them as the instance named
;; by the nl bytes at np, each import linked to the instance the ml bytes
;; of the import map at mp name for its module, or else to the instance of
;; its module's name (spec 4): 1, or 0 if that fails, error-message saying
;; why.
(define (instantiate-bytes [np (ptr u8)] [nl u32] [b (ptr u8)] [bl u32] [mp (ptr u8)] [ml u32]) -> i32
  (== (host-instantiate (cast i32 np) nl (cast i32 b) bl (cast i32 mp) ml) 0))

;; The index in the caller's table of the function the instance named by
;; the il bytes at ip exports as the fl bytes at fp, which the host adds
;; to the table; or -1 if it has none.
(define (export-index [ip (ptr u8)] [il u32] [fp (ptr u8)] [fl u32]) -> i32
  (host-export-index (cast i32 ip) il (cast i32 fp) fl))

;; The host's message for its last failure, as far as cap bytes of it at
;; p: their count.
(define (error-message [p (ptr u8)] [cap u32]) -> u32 (cast u32 (host-error-message (cast i32 p) cap)))
