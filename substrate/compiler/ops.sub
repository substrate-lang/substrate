;; The wasm numeric and memory instructions that the kernel exposes as operators.
(require-unqualified base "base/base.sub")
(require-unqualified k "kernel.sub")

(provide prim-op lookup-prim prim-names)

(struct prim-op [name datum] [code datum] [params datum] [results datum] [kind datum] [align datum] [traps i32])

(define ops hash-table)
(define names datum nil)

(define trapping datum
  `(i32.div_s i32.div_u i32.rem_s i32.rem_u i64.div_s i64.div_u i64.rem_s i64.rem_u
    i32.trunc_f32_s i32.trunc_f32_u i32.trunc_f64_s i32.trunc_f64_u
    i64.trunc_f32_s i64.trunc_f32_u i64.trunc_f64_s i64.trunc_f64_u
    memory.copy memory.fill))

(define (def! [name datum] [code datum] [params datum] [results datum] [align i32])
  (let ([op (cast (ptr prim-op) (alloc-in (& run-arena) (sizeof prim-op)))])
    (set! (-> op name) name)
    (set! (-> op code) code)
    (set! (-> op params) params)
    (set! (-> op results) results)
    (set! (-> op kind) (if (< align 0) (sym plain) (sym mem)))
    (set! (-> op align) (if (< align 0) 0 (make-integer align)))
    (set! (-> op traps) (or (>= align 0) (!= (memq name trapping) 0)))
    (hash-set! (& ops) (cast u64 name) (cast u32 op))
    (set! names (cons name names))))

(define (lookup-prim [name datum]) -> (ptr prim-op) (cast (ptr prim-op) (hash-ref (& ops) (cast u64 name))))
(define (prim-names) -> datum (reverse names))

(define (defs! [params datum] [results datum] [specs datum])
  (for-each (lambda ([s datum]) (def! (car s) (cons (cdr s) nil) params results -1)) specs))

(define (define-all!)
  (def! (sym i32.eqz) `(#x45) `(i32) `(i32) -1)
  (defs! `(i32 i32) `(i32)
         `((i32.eq . #x46) (i32.ne . #x47) (i32.lt_s . #x48) (i32.lt_u . #x49) (i32.gt_s . #x4A)
           (i32.gt_u . #x4B) (i32.le_s . #x4C) (i32.le_u . #x4D) (i32.ge_s . #x4E) (i32.ge_u . #x4F)))
  (def! (sym i64.eqz) `(#x50) `(i64) `(i32) -1)
  (defs! `(i64 i64) `(i32)
         `((i64.eq . #x51) (i64.ne . #x52) (i64.lt_s . #x53) (i64.lt_u . #x54) (i64.gt_s . #x55)
           (i64.gt_u . #x56) (i64.le_s . #x57) (i64.le_u . #x58) (i64.ge_s . #x59) (i64.ge_u . #x5A)))
  (defs! `(f32 f32) `(i32)
         `((f32.eq . #x5B) (f32.ne . #x5C) (f32.lt . #x5D) (f32.gt . #x5E) (f32.le . #x5F) (f32.ge . #x60)))
  (defs! `(f64 f64) `(i32)
         `((f64.eq . #x61) (f64.ne . #x62) (f64.lt . #x63) (f64.gt . #x64) (f64.le . #x65) (f64.ge . #x66)))

  (defs! `(i32) `(i32) `((i32.clz . #x67) (i32.ctz . #x68) (i32.popcnt . #x69)))
  (defs! `(i32 i32) `(i32)
         `((i32.add . #x6A) (i32.sub . #x6B) (i32.mul . #x6C) (i32.div_s . #x6D) (i32.div_u . #x6E)
           (i32.rem_s . #x6F) (i32.rem_u . #x70) (i32.and . #x71) (i32.or . #x72) (i32.xor . #x73)
           (i32.shl . #x74) (i32.shr_s . #x75) (i32.shr_u . #x76) (i32.rotl . #x77) (i32.rotr . #x78)))
  (defs! `(i64) `(i64) `((i64.clz . #x79) (i64.ctz . #x7A) (i64.popcnt . #x7B)))
  (defs! `(i64 i64) `(i64)
         `((i64.add . #x7C) (i64.sub . #x7D) (i64.mul . #x7E) (i64.div_s . #x7F) (i64.div_u . #x80)
           (i64.rem_s . #x81) (i64.rem_u . #x82) (i64.and . #x83) (i64.or . #x84) (i64.xor . #x85)
           (i64.shl . #x86) (i64.shr_s . #x87) (i64.shr_u . #x88) (i64.rotl . #x89) (i64.rotr . #x8A)))

  (defs! `(f32) `(f32)
         `((f32.abs . #x8B) (f32.neg . #x8C) (f32.ceil . #x8D) (f32.floor . #x8E) (f32.trunc . #x8F)
           (f32.nearest . #x90) (f32.sqrt . #x91)))
  (defs! `(f32 f32) `(f32)
         `((f32.add . #x92) (f32.sub . #x93) (f32.mul . #x94) (f32.div . #x95) (f32.min . #x96)
           (f32.max . #x97) (f32.copysign . #x98)))
  (defs! `(f64) `(f64)
         `((f64.abs . #x99) (f64.neg . #x9A) (f64.ceil . #x9B) (f64.floor . #x9C) (f64.trunc . #x9D)
           (f64.nearest . #x9E) (f64.sqrt . #x9F)))
  (defs! `(f64 f64) `(f64)
         `((f64.add . #xA0) (f64.sub . #xA1) (f64.mul . #xA2) (f64.div . #xA3) (f64.min . #xA4)
           (f64.max . #xA5) (f64.copysign . #xA6)))

  (def! (sym i32.wrap_i64) `(#xA7) `(i64) `(i32) -1)
  (defs! `(f32) `(i32) `((i32.trunc_f32_s . #xA8) (i32.trunc_f32_u . #xA9) (i32.reinterpret_f32 . #xBC)))
  (defs! `(f64) `(i32) `((i32.trunc_f64_s . #xAA) (i32.trunc_f64_u . #xAB)))
  (defs! `(i32) `(i64) `((i64.extend_i32_s . #xAC) (i64.extend_i32_u . #xAD)))
  (defs! `(f32) `(i64) `((i64.trunc_f32_s . #xAE) (i64.trunc_f32_u . #xAF)))
  (defs! `(f64) `(i64) `((i64.trunc_f64_s . #xB0) (i64.trunc_f64_u . #xB1) (i64.reinterpret_f64 . #xBD)))
  (defs! `(i32) `(f32) `((f32.convert_i32_s . #xB2) (f32.convert_i32_u . #xB3) (f32.reinterpret_i32 . #xBE)))
  (defs! `(i64) `(f32) `((f32.convert_i64_s . #xB4) (f32.convert_i64_u . #xB5)))
  (def! (sym f32.demote_f64) `(#xB6) `(f64) `(f32) -1)
  (defs! `(i32) `(f64) `((f64.convert_i32_s . #xB7) (f64.convert_i32_u . #xB8)))
  (defs! `(i64) `(f64) `((f64.convert_i64_s . #xB9) (f64.convert_i64_u . #xBA) (f64.reinterpret_i64 . #xBF)))
  (def! (sym f64.promote_f32) `(#xBB) `(f32) `(f64) -1)
  (defs! `(i32) `(i32) `((i32.extend8_s . #xC0) (i32.extend16_s . #xC1)))
  (defs! `(i64) `(i64) `((i64.extend8_s . #xC2) (i64.extend16_s . #xC3) (i64.extend32_s . #xC4)))
  (for-each (lambda ([s datum]) (def! (car s) `(#xFC ,(cadr s)) (caddr s) (cadddr s) -1))
            `((i32.trunc_sat_f32_s 0 (f32) (i32)) (i32.trunc_sat_f32_u 1 (f32) (i32))
              (i32.trunc_sat_f64_s 2 (f64) (i32)) (i32.trunc_sat_f64_u 3 (f64) (i32))
              (i64.trunc_sat_f32_s 4 (f32) (i64)) (i64.trunc_sat_f32_u 5 (f32) (i64))
              (i64.trunc_sat_f64_s 6 (f64) (i64)) (i64.trunc_sat_f64_u 7 (f64) (i64))))

  (for-each (lambda ([s datum])
              (def! (car s) (cons (cadr s) nil) `(i32) (cons (caddr s) nil) (cast i32 (integer-value (cadddr s)))))
            `((i32.load #x28 i32 2) (i64.load #x29 i64 3) (f32.load #x2A f32 2) (f64.load #x2B f64 3)
              (i32.load8_s #x2C i32 0) (i32.load8_u #x2D i32 0) (i32.load16_s #x2E i32 1)
              (i32.load16_u #x2F i32 1) (i64.load8_s #x30 i64 0) (i64.load8_u #x31 i64 0)
              (i64.load16_s #x32 i64 1) (i64.load16_u #x33 i64 1) (i64.load32_s #x34 i64 2)
              (i64.load32_u #x35 i64 2)))
  (for-each (lambda ([s datum])
              (def! (car s) (cons (cadr s) nil) `(i32 ,(caddr s)) nil (cast i32 (integer-value (cadddr s)))))
            `((i32.store #x36 i32 2) (i64.store #x37 i64 3) (f32.store #x38 f32 2) (f64.store #x39 f64 3)
              (i32.store8 #x3A i32 0) (i32.store16 #x3B i32 1) (i64.store8 #x3C i64 0)
              (i64.store16 #x3D i64 1) (i64.store32 #x3E i64 2)))
  (def! (sym memory.size) `(#x3F #x00) nil `(i32) -1)
  (def! (sym memory.grow) `(#x40 #x00) `(i32) `(i32) -1)
  (def! (sym memory.copy) `(#xFC 10 #x00 #x00) `(i32 i32 i32) nil -1)
  (def! (sym memory.fill) `(#xFC 11 #x00) `(i32 i32 i32) nil -1))

(define defined i32 (begin (define-all!) 1))
