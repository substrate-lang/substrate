;; Substrate: C's types, memory and control as s-expressions, compiled to wasm.

(require memory "../memory.sub")
(require print "../print.sub")
;; The kernel module is required only for substrate-interaction, which prints floats in a session;
;; nothing else here calls it, so ordinary programs do not import it.
(require kd kernel)

(provide [define substrate-define] [struct substrate-struct] [union substrate-union] [variant substrate-variant] [match substrate-match] [exception substrate-exception] [throw substrate-throw] [try substrate-try] [lambda substrate-lambda] inst typedef const [let substrate-let] [let* substrate-let*] [set! substrate-set!]
         [#%datum substrate-datum] [#%top-interaction substrate-interaction] [#%module-begin substrate-module-begin]
         when unless cond case while for break continue rethrow and or not cast sizeof offsetof array-of @ & ->
         + - * / % == != < <= > >= bit-and bit-or bit-xor bit-not << >>
         += -= *= /= %= <<= >>= bit-and= bit-or= bit-xor= sbrk reset-stack!)

(memory from memory)

;; Table index 0 holds no function: it is the null function pointer.
(table 1)

;; Memory past the heap's end has not been given out, so it is zero.
(global brk (mut i32) memory:heap-start)

;; Memory grows by at least as much as it has: an engine may pay for each growth, as V8 does.
(func (sbrk [n i32]) -> i32
  (let* ([p brk] [end (i32.and (i32.add (i32.add brk n) 7) -8)] [size (i32.shl (memory.size) 16)]
         [need (i32.shr_u (i32.add (i32.sub end size) 65535) 16)])
    (if (i32.gt_u end size)
        (if (i32.lt_s (memory.grow (if (i32.gt_u (memory.size) need) (memory.size) need)) 0)
            (if (i32.lt_s (memory.grow need) 0) (return 0))))
    (set! brk end)
    p))

;; 4 MiB, as deep as the engine's own call stack.
(global stack-base (mut i32) (sbrk 4194304))
(global sp (mut i32) (i32.add stack-base 4194304))

;; Call it first thing after a trap, which abandons the running functions' frames without
;; popping them.
(func (reset-stack!) (set! sp (i32.add stack-base 4194304)))

(begin-for-syntax
  (require k kernel)
  ;; Substrate's forms are the compiler's, in checker.sub: each use goes to it with here, an
  ;; identifier of this module, so that the code a form makes means what it would here.
  (func (substrate-form [kind i32] [s i32]) -> i32 (k:substrate-form kind 0 s #'here))
  (func (mark-use [mark i32] [s i32]) -> i32 (k:substrate-form 'mark mark s #'here))
  (func (const-use [c i32] [s i32]) -> i32 (k:substrate-form 'constant c s #'here))
  (func (form [kind i32]) -> i32 (k:make-transformer (func-index substrate-form) kind))
  (func (mark-transformer [mark i32]) -> i32 (k:make-transformer (func-index mark-use) mark))
  (func (const-transformer [c i32]) -> i32 (k:make-transformer (func-index const-use) c)))

(define-syntax substrate-module-begin (form '#%module-begin))
(define-syntax substrate-interaction (form '#%top-interaction))
(define-syntax substrate-define (form 'define))
(define-syntax substrate-body (form 'substrate-body))
(define-syntax substrate-static (form 'substrate-static))
(define-syntax substrate-struct (form 'struct))
(define-syntax substrate-union (form 'union))
(define-syntax substrate-variant (form 'variant))
(define-syntax substrate-match (form 'match))
(define-syntax substrate-exception (form 'exception))
(define-syntax substrate-throw (form 'throw))
(define-syntax substrate-try (form 'try))
(define-syntax substrate-lambda (form 'lambda))
(define-syntax inst (form 'inst))
(define-syntax substrate-struct-check (form 'substrate-struct-check))
(define-syntax typedef (form 'typedef))
(define-syntax const (form 'const))
(define-syntax substrate-let (form 'let))
(define-syntax substrate-let* (form 'let*))
(define-syntax substrate-datum (form '#%datum))
(define-syntax when (form 'when))
(define-syntax unless (form 'unless))
(define-syntax cond (form 'cond))
(define-syntax case (form 'case))
(define-syntax array-of (form 'array-of))
(define-syntax while (form 'while))
(define-syntax for (form 'for))
(define-syntax cast (form 'cast))
(define-syntax sizeof (form 'sizeof))
(define-syntax offsetof (form 'offsetof))
(define-syntax -> (form '->))
(define-syntax & (form '&))
(define-syntax substrate-set! (mark-transformer '(#%substrate-set!)))
(define-syntax @ (mark-transformer '(#%substrate-deref)))
(define-syntax break (mark-transformer '(#%substrate-break)))
(define-syntax continue (mark-transformer '(#%substrate-continue)))
(define-syntax rethrow (mark-transformer '(#%substrate-rethrow)))
(define-syntax + (mark-transformer '(#%substrate-op +)))
(define-syntax - (mark-transformer '(#%substrate-op -)))
(define-syntax * (mark-transformer '(#%substrate-op *)))
(define-syntax / (mark-transformer '(#%substrate-op /)))
(define-syntax % (mark-transformer '(#%substrate-op %)))
(define-syntax == (mark-transformer '(#%substrate-op ==)))
(define-syntax != (mark-transformer '(#%substrate-op !=)))
(define-syntax < (mark-transformer '(#%substrate-op <)))
(define-syntax <= (mark-transformer '(#%substrate-op <=)))
(define-syntax > (mark-transformer '(#%substrate-op >)))
(define-syntax >= (mark-transformer '(#%substrate-op >=)))
(define-syntax and (mark-transformer '(#%substrate-op and)))
(define-syntax or (mark-transformer '(#%substrate-op or)))
(define-syntax not (mark-transformer '(#%substrate-op not)))
(define-syntax bit-and (mark-transformer '(#%substrate-op bit-and)))
(define-syntax bit-or (mark-transformer '(#%substrate-op bit-or)))
(define-syntax bit-xor (mark-transformer '(#%substrate-op bit-xor)))
(define-syntax bit-not (mark-transformer '(#%substrate-op bit-not)))
(define-syntax << (mark-transformer '(#%substrate-op <<)))
(define-syntax >> (mark-transformer '(#%substrate-op >>)))
(define-syntax += (mark-transformer '(#%substrate-update +)))
(define-syntax -= (mark-transformer '(#%substrate-update -)))
(define-syntax *= (mark-transformer '(#%substrate-update *)))
(define-syntax /= (mark-transformer '(#%substrate-update /)))
(define-syntax %= (mark-transformer '(#%substrate-update %)))
(define-syntax <<= (mark-transformer '(#%substrate-update <<)))
(define-syntax >>= (mark-transformer '(#%substrate-update >>)))
(define-syntax bit-and= (mark-transformer '(#%substrate-update bit-and)))
(define-syntax bit-or= (mark-transformer '(#%substrate-update bit-or)))
(define-syntax bit-xor= (mark-transformer '(#%substrate-update bit-xor)))
