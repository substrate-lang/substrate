;; Lifecycle: permanent. The compiler's driver.
;;
;;   ROOT build FILE [-o DIR]       write FILE's program to DIR, for build/subhost:
;;                                  each linklet it instantiates at run time, as
;;                                  DIR/<name>.wasm, and DIR/program, their names in
;;                                  the order they are instantiated (spec 4)
;;   ROOT compile FILE [-o OUT]     write FILE's linklets: phase 0 to OUT, phase p
;;                                  to OUT with .phase<p>.wasm
;;   ROOT expand FILE               print FILE's fully expanded phase-0 forms
;;   ROOT kernel [-o OUT]           write the compiled kernel module
;;
;; ROOT is the repository, where compiler/kernel.sub is; FILE and OUT are
;; relative to the working directory. bin/sub runs this on a host (spec
;; 4), host/subhost.mjs unless HOST names another, from the package root.
;; With -c DIR, build and compile keep compiled modules in DIR (spec 3.7).
(require-unqualified substrate "../lib/substrate.sub")
(require stx "stx.sub" write-syntax-error)
(require ex "expander.sub" report-trap set-repository-root! set-cache-directory! compile-module-file
         module-linklet-list module-expanded-forms keep-expanded-forms! target-kernel-bytes program-linklets
         register-queries!)

;; The value after flag in args, or default.
(define (option args flag default)
  (let ([m (member flag args)])
    (if (and m (pair? (cdr m))) (cadr m) default)))

;; args without flag and its value.
(define (without-option args flag)
  (cond [(null? args) '()]
        [(and (string=? (car args) flag) (pair? (cdr args))) (cddr args)]
        [else (cons (car args) (without-option (cdr args) flag))]))

;; path without its extension, the part after the last dot of its last
;; segment.
(define (strip-extension path)
  (let loop ([i (- (string-utf-8-length path) 1)])
    (cond [(< i 0) path]
          [(= (string-utf-8-byte path i) 46) (substring/utf-8 path 0 i)]
          [(= (string-utf-8-byte path i) 47) path]
          [else (loop (- i 1))])))

(define (usage)
  (eprintf "usage: sub ROOT build FILE [-o DIR] | compile FILE [-o OUT] | expand FILE | kernel [-o OUT]~n")
  (exit 64))

(define line-width 80)

(define (spaces n) (if (<= n 0) "" (string-append " " (spaces (- n 1)))))

;; The prefixes write abbreviates (quote x) and its kin with.
(define abbreviations
  '((quote . "'") (quasiquote . "`") (unquote . ",") (unquote-splicing . ",@")
    (quote-syntax . "#'") (quasisyntax . "#`") (unsyntax . "#,") (unsyntax-splicing . "#,@")))

;; x written for reading, from column col, as strings in reverse onto acc:
;; on one line when it fits in line-width; else a list as "(", its first
;; element, and, when that is a symbol, its second on the same line, then
;; each other element on a line of its own, two columns in.
(define (layout x col acc)
  (let* ([flat (format "~s" x)]
         [abbreviation (and (list? x) (= (length x) 2) (assq (car x) abbreviations))])
    (cond
      [(or (<= (+ col (string-utf-8-length flat)) line-width) (not (list? x)) (null? x))
       (cons flat acc)]
      [abbreviation
       (let ([prefix (cdr abbreviation)])
         (layout (cadr x) (+ col (string-utf-8-length prefix)) (cons prefix acc)))]
      [else
        (let* ([head (car x)]
               [inline? (and (symbol? head) (pair? (cdr x)))]
               [acc (layout head (+ col 1) (cons "(" acc))]
               [acc (if inline?
                        (layout (cadr x) (+ col 2 (string-utf-8-length (symbol->string head))) (cons " " acc))
                        acc)])
          (cons ")"
                (foldl (lambda (e acc) (layout e (+ col 2) (cons (spaces (+ col 2)) (cons "\n" acc))))
                       acc
                       (if inline? (cddr x) (cdr x)))))])))

(define (print-expanded form)
  (display (apply string-append (reverse (layout (syntax->datum form) 0 '()))))
  (newline))

(define (run)
  (register-queries!)
  ;; A compile error, a syntax error that nothing handled, stops the
  ;; compiler.
  (with-handlers ([syntax-error? (lambda (e) (write-syntax-error e) (exit 1))])
    (compile-command (vector->list (current-command-line-arguments)))))

(define (compile-command args)
  (when (null? args) (usage))
  (set-repository-root! (car args))
  (let* ([cache (option args "-c" #f)] [args (without-option (cdr args) "-c")])
    ;; expand prints the entry's expansion, which a cached module has not.
    (when (and cache (pair? args) (member (car args) '("build" "compile"))) (set-cache-directory! cache))
    (cond
      [(and (>= (length args) 2) (string=? (car args) "build"))
       (let ([linklets (program-linklets (compile-module-file (cadr args)))]
             [dir (option args "-o" (strip-extension (cadr args)))])
         (for-each (lambda (l) (display-to-file (cdr l) (string-append dir "/" (car l) ".wasm"))) linklets)
         (display-to-file (apply string-append (map (lambda (l) (string-append (car l) "\n")) linklets))
                          (string-append dir "/program")))]
      [(and (>= (length args) 2) (string=? (car args) "compile"))
       (let* ([m (compile-module-file (cadr args))]
              [out (option args "-o" (string-append (strip-extension (cadr args)) ".wasm"))])
         (for-each (lambda (p)
                     (display-to-file (cdr p)
                                      (if (= (car p) 0)
                                          out
                                          (format "~a.phase~a.wasm" (strip-extension out) (car p)))))
                   (module-linklet-list m)))]
      [(and (= (length args) 2) (string=? (car args) "expand"))
       (keep-expanded-forms!)
       (for-each print-expanded (module-expanded-forms (compile-module-file (cadr args))))]
      [(and (>= (length args) 1) (string=? (car args) "kernel"))
       (display-to-file (target-kernel-bytes) (option args "-o" "build/kernel.wasm"))]
      [else (usage)])))

(func (main) (run))

;; After a trap: report it where it happened (spec 4).
(define (on-trap) (report-trap))
