;; Lifecycle: permanent. Part of the compiler.
;;
;; Integers in LEB128, as the wasm encoder and the serializer write them,
;; to Substrate's ports.
(require-unqualified substrate "../lib/substrate.sub")

(provide write-uleb write-sleb)

;; n, a non-negative integer, as unsigned LEB128.
(define (write-uleb n p)
  (let ([x (bitwise-and n 127)] [rest (arithmetic-shift n -7)])
    (if (= rest 0)
        (write-byte x p)
        (begin (write-byte (bitwise-ior x 128) p) (write-uleb rest p)))))

;; n as signed LEB128.
(define (write-sleb n p)
  (let ([x (bitwise-and n 127)] [rest (arithmetic-shift n -7)])
    (if (or (and (= rest 0) (= 0 (bitwise-and x 64)))
            (and (= rest -1) (not (= 0 (bitwise-and x 64)))))
        (write-byte x p)
        (begin (write-byte (bitwise-ior x 128) p) (write-sleb rest p)))))
