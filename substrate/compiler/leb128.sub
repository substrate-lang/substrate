;; LEB128 integers, written into buffers.
(require-unqualified base "base/base.sub")

(provide write-uleb write-sleb uleb-length)

(memory from base)
(table from base)

(define (write-uleb [b (ptr buffer)] [n u64])
  (while 1
    (let ([byte (cast i32 (bit-and n 127))])
      (set! n (>> n 7))
      (when (== n 0)
        (buffer-add-byte! b byte)
        (return))
      (buffer-add-byte! b (bit-or byte 128)))))

(define (write-sleb [b (ptr buffer)] [n i64])
  (while 1
    (let ([byte (cast i32 (bit-and n 127))] [sign i32 0])
      (set! n (>> n 7))
      (set! sign (!= (bit-and byte 64) 0))
      (when (or (and (== n 0) (not sign)) (and (== n -1) sign))
        (buffer-add-byte! b byte)
        (return))
      (buffer-add-byte! b (bit-or byte 128)))))

(define (uleb-length [n u64]) -> u32 (if (< n 128) 1 (+ 1 (uleb-length (>> n 7)))))
