;; Lifecycle: permanent. Part of the compiler.
;;
;; Integers in LEB128, as the wasm encoder and the serializer write them,
;; to Substrate's ports: a byte at a time, from the integer's 64 bits.
;; Kernel code, so that its literals are wasm numbers.
(require k kernel)
(require s "../lib/substrate.sub" write-byte)

(provide write-uleb write-sleb)

;; n, a non-negative integer, as unsigned LEB128.
(func (write-uleb [n eqref] [p eqref]) -> eqref
  (let ([x (k:integer-value n)] [b 0])
    (block done
      (loop next
        (set! b (i32.wrap_i64 (i64.and x 127)))
        (set! x (i64.shr_u x 7))
        (if (i64.eqz x) (begin (write-byte (k:fixnum b) p) (br done)))
        (write-byte (k:fixnum (i32.or b 128)) p)
        (br next)))
    '#f))

;; n as signed LEB128.
(func (write-sleb [n eqref] [p eqref]) -> eqref
  (let ([x (k:integer-value n)] [b 0] [sign 0])
    (block done
      (loop next
        (set! b (i32.wrap_i64 (i64.and x 127)))
        (set! x (i64.shr_s x 7))
        (set! sign (i32.ne (i32.and b 64) 0))
        (if (i32.or (i32.and (i64.eqz x) (i32.eqz sign)) (i32.and (i64.eq x -1) sign))
            (begin (write-byte (k:fixnum b) p) (br done)))
        (write-byte (k:fixnum (i32.or b 128)) p)
        (br next)))
    '#f))
