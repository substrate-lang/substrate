;; Lifecycle: permanent.
;;
;; Output for tests and programs: write-bytes, write-byte, newline,
;; write-int, write-i64 and write-u64 write to standard output with the
;; host's write, from the program's memory (memory.sub).
;;
;; A module that writes bytes of its own shares that memory: it requires
;; this module (as print, say) and declares (memory from print). The bytes
;; below heap-start (1024) belong to this module; put your own data at
;; heap-start or above.

(provide write-bytes write-byte newline write-int write-i64 write-u64)

(require memory "memory.sub")
(memory from memory)

(import host-write "host" "write" (i32 i32 i32 -> i32))

(func (write-bytes [p i32] [n i32]) (drop (host-write 1 p n)))
(func (write-byte [b i32]) (i32.store8 0 b) (write-bytes 0 1))
(func (newline) (write-byte 10))

;; A signed integer in decimal, formatted in bytes 32..63.
(func (write-int [n i32])
  (let ([p 64] [u n] [neg (i32.lt_s n 0)])
    (if neg (set! u (i32.sub 0 n)))
    (block done
      (loop next
        (set! p (i32.sub p 1))
        (i32.store8 p (i32.add 48 (i32.rem_u u 10)))
        (set! u (i32.div_u u 10))
        (br-if done (i32.eqz u))
        (br next)))
    (if neg
        (begin (set! p (i32.sub p 1)) (i32.store8 p 45)))
    (write-bytes p (i32.sub 64 p))))

;; An unsigned 64-bit integer in decimal, formatted in bytes 64..95.
(func (write-u64 [n i64])
  (let ([p 96] [u n])
    (block done
      (loop next
        (set! p (i32.sub p 1))
        (i32.store8 p (i32.add 48 (i32.wrap_i64 (i64.rem_u u 10))))
        (set! u (i64.div_u u 10))
        (br-if done (i64.eqz u))
        (br next)))
    (write-bytes p (i32.sub 96 p))))

;; A signed 64-bit integer in decimal.
(func (write-i64 [n i64])
  (if (i64.lt_s n 0)
      (begin (write-byte 45) (write-u64 (i64.sub 0 n)))
      (write-u64 n)))
