;; A projection on a type parameter needs the trait from its bounds
;; (examples/typed/typed.sub).
(require-unqualified typed "../examples/typed/typed.sub")
(data (Option T) [None] [Some T])
(trait (Container C) (type Elem) [front : (-> C (Option Elem))])
(define #:forall (C) (front-or [c : C] [d : (Elem C)]) : Int 0)
(func (main))
