;; Macros written in the Lisp (lib/lisp.sub): define-syntax with a Lisp
;; procedure, which runs at phase 1 in the module that defines it, with
;; helper functions there too. Hygienic: swap!'s tmp captures nothing.
;; while and for come from another module (tests/fixtures/lisp-loops.sub).
(require-unqualified l "../lib/lisp.sub")
(begin-for-syntax (require-unqualified l "../lib/lisp.sub"))
(require loops "fixtures/lisp-loops.sub" while for in)

(define-syntax (swap! stx)
  (let ([parts (syntax->list stx)])
    #`(let ([tmp #,(cadr parts)])
        (set! #,(cadr parts) #,(caddr parts))
        (set! #,(caddr parts) tmp))))

;; (my-or e ...), recursively.
(define-syntax my-or
  (lambda (stx)
    (let ([args (cdr (syntax->list stx))])
      (cond [(null? args) #'#f]
            [(null? (cdr args)) (car args)]
            [else #`(let ([t #,(car args)]) (if t t (my-or #,@(cdr args))))]))))

(define (run)
  (let ([a 1] [b 2] [tmp 3])
    (swap! a b)
    (swap! tmp a)
    (display (list a b tmp)) (newline))
  (let ([t 5])
    (display (list (my-or #f t) (my-or) (my-or #f #f 7))) (newline))
  (let ([i 0] [acc '()])
    (while (< i 3) (set! acc (cons i acc)) (set! i (+ i 1)))
    (for x in '(a b c) (set! acc (cons x acc)))
    (display acc) (newline)))

(func (main) (run))
