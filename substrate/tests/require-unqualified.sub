;; (require-unqualified name source) binds everything the source provides
;; unqualified as well as qualified (spec 3.1). It is for a language's core
;; forms: here mini-lang's show, newline, and #%app, under which calling
;; the variable f calls through the table.
(require-unqualified ml "fixtures/mini-lang.sub")

(table 1)
(func (double [x i32]) -> i32 (i32.mul x 2))

(func (main)
  (let ([f (func-index double)])
    (show (f 21)) (newline)
    (ml:show 7) (ml:newline)))
