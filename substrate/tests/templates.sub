;; quote-syntax prunes local binding scopes, so templates written apart refer to each other.
(require print "../compiler/print.sub" write-int newline)

(begin-for-syntax
  (require k kernel)
  (func (use-x) -> i32 #'(i32.add x 1))
  (func (with-x [stx i32]) -> i32
    (let ([body (use-x)])
      #`(let ([x 41]) #,body))))
(define-syntax with-x with-x)

(func (main) (write-int (with-x)) (newline))
