;; A mismatch with a type parameter known from an earlier argument shows the actual types.
(require-unqualified base "../../compiler/base/base.sub")
(memory from base)
(table from base)

(struct #:forall (T) box [value T])
(define #:forall (T) (same? [a (ptr (box T))] [b (ptr (box T))]) -> i32 (== (-> a value) (-> b value)))
(define (main)
  (let ([x (box i32)] [y (box f64)])
    (same? (& x) (& y))))
