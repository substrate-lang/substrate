;; A trap in C code is reported where the C code that traps is.
(require-unqualified base "../../compiler/base/base.sub")
(require print "../../compiler/print.sub" write-int)
(memory from base)
(table from base)

(define (ratio [a i32] [b i32]) -> i32 (+ 1 (/ a b)))
(define (main) (write-int (ratio 10 0)))
