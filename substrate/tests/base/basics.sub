;; Base's layouts, places, conversions, constants, control and pointers, a line each.
(require-unqualified base "../../compiler/base/base.sub")
(require print "../../compiler/print.sub" write-int write-i64 write-u64 write-byte newline)

(typedef size u32)
(struct inner [a u8] [b i64] [c u16])
(struct outer [tag i32] [in inner] [name (array u8 8)] [self (ptr outer)])

(define (show [x i32]) (write-int x) (write-byte 32))

(define (layouts)
  (show (sizeof inner))
  (show (sizeof outer))
  (show (sizeof (array u16 5)))
  (let ([o (ptr outer) 0])
    (show (cast i32 (& (-> o in c))))
    (show (cast i32 (& (-> o self)))))
  (show (offsetof outer name))
  (newline))

(define (places)
  (let ([o (cast (ptr outer) (calloc 1 (sizeof outer)))])
    (set! (-> o in b) -5)
    (set! (-> o in c) 65535)
    (set! (-> o self) o)
    (set! (@ (-> o name) 0) #\o)
    (set! (@ (-> o name) 1) #\k)
    (write-i64 (-> o self in b)) (write-byte 32)
    (show (-> o in c))
    (print-string (-> o name))
    (free o))
  (newline))

(define (narrow)
  (let ([p (cast (ptr u8) (malloc 8))])
    (set! (@ p 0) 200)
    (show (@ p 0))
    (show (@ (cast (ptr i8) p) 0))
    (set! (@ (cast (ptr u16) p) 1) 40000)
    (show (@ (cast (ptr i16) p) 1))
    (show (@ (cast (ptr u16) p) 1))
    (let ([c i8 127]) (+= c 1) (show c))
    (free p))
  (newline))

(define (floats)
  (let ([x f32 1.5] [y (/ 7 2.0)])
    (set! x (* x 0.5))
    (show (cast i32 (* x 100)))
    (show (cast i32 (* y 4)))
    (show (cast i32 -2.7))
    (show (cast i32 (cast f32 16777217)))
    (write-i64 (cast i64 (cast f64 (cast u32 -1))))
    (write-byte 32)
    (show (cast i32 (sqrt 2.0e6)))
    (show (cast i32 (floor -2.5)))
    (show (cast i32 (ceilf 2.1)))
    (show (cast i32 (copysign 3.0 -1.0)))
    (show (cast i32 (nearbyint 2.5)))
    (show (cast i32 (* 10 (fabsf (truncf -1.75))))))
  (newline))

(define (wide)
  (let ([a u64 -1] [b i64 -9])
    (write-u64 a) (write-byte 32)
    (show (> a 1))
    (write-i64 (/ b 2)) (write-byte 32)
    (write-u64 (>> a 60)) (write-byte 32)
    (write-u64 (cast u64 (cast u32 -1))) (write-byte 32)
    (write-i64 (<< (cast i64 1) 40)))
  (newline))

(const ten u8 10)
(const all u64 -1)
(define twenty i32 (* 2 ten))

(define (constants)
  (show (case 10 [(ten) twenty] [else 0]))
  (show (> all 1))
  (newline))

(define count i32 0)
(define (tick [v i32]) -> i32 (+= count 1) v)

(define (logic)
  (show (and (tick 1) (tick 0) (tick 1)))
  (show (or (tick 0) (tick 5)))
  (show count)
  (show (not 7))
  (unless (== count 3) (show 99))
  (let* ([a 2] [b (* a 3)]) (show b))
  (show (if (> count 3) 10 20))
  (newline))

(define (two-squares [n i32]) -> i32
  (for ([i 1]) (< (* i i) n) (+= i 1)
    (for ([j (+ i 1)]) (<= (+ (* i i) (* j j)) n) (+= j 1)
      (when (== (+ (* i i) (* j j)) n) (return (+ (* i 100) j)))))
  -1)

(define (odd-sum [n i32]) -> i32
  (let ([s 0])
    (for ([i 0]) (< i n) (+= i 1)
      (when (== (% i 2) 0) (continue))
      (+= s i))
    s))

(define (even [n size]) -> i32 (if (== n 0) 1 (odd (- n 1))))
(define (odd [n size]) -> i32 (if (== n 0) 0 (even (- n 1))))

(define limit i32 (two-squares 50))
(define limit-at (ptr i32) (& limit))

(define (control)
  (show (two-squares 25))
  (show (two-squares 50))
  (show (two-squares 3))
  (show (odd-sum 10))
  (show (even 100001))
  (show (@ limit-at))
  (newline))

(define (pointers)
  (let* ([a (cast (ptr i32) (malloc (* 5 (sizeof i32))))] [end (+ a 5)] [k 0])
    (for ([p a]) (< p end) (+= p 1)
      (set! (@ p) (* k k))
      (+= k 1))
    (show (- end a))
    (show (@ end -1))
    (let ([i -2]) (show (@ end i)))
    (show (- (cast i32 end) (cast i32 a)))
    (show (@ (+ 1 a) 1))
    (set! a (cast (ptr i32) (realloc a (* 100 (sizeof i32)))))
    (show (@ a 4))
    (free a))
  (newline))

(define (strings)
  (print-string "tab\there\n")
  (show (cast i32 (strlen "hello")))
  (show (@ "AB" 1))
  (show #\z)
  (newline))

(define (main)
  (layouts)
  (places)
  (narrow)
  (floats)
  (wide)
  (constants)
  (logic)
  (control)
  (pointers)
  (strings))
