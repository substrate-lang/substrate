;; The C example's closures (examples/base/lang.sub): lambdas that use the
;; variables of the function they are in, passed down to the functions it
;; calls.
(require-unqualified base "../../compiler/base/base.sub")
(require print "../../compiler/print.sub" write-int write-byte newline)
(memory from base)
(table from base)

(define (show [x i32]) (write-int x) (write-byte 32))

(struct node [value i32] [next (ptr node)])

(define (each [list (ptr node)] [f (closure ((ptr node)))])
  (while (!= list 0)
    (f list)
    (set! list (-> list next))))

(define (sum [list (ptr node)]) -> i32
  (let ([total 0])
    (each list (lambda ([n (ptr node)]) (+= total (-> n value))))
    total))

(define (count [a (ptr i32)] [n i32] [keep (closure (i32) -> i32)]) -> i32
  (let ([c 0])
    (for ([i 0]) (< i n) (+= i 1)
      (when (keep (@ a i)) (+= c 1)))
    c))

(define (main)
  (let ([list (ptr node) 0])
    (for ([i 1]) (<= i 10) (+= i 1)
      (let ([cell (cast (ptr node) (malloc (sizeof node)))])
        (set! (-> cell value) i)
        (set! (-> cell next) list)
        (set! list cell)))
    (show (sum list)))
  (let ([a (array i32 10)] [limit 5])
    (for ([i 0]) (< i 10) (+= i 1) (set! (@ a i) i))
    (show (count a 10 (lambda ([x i32]) -> i32 (< x limit))))
    (set! limit 8)
    (show (count a 10 (lambda ([x i32]) -> i32 (< x limit))))
    (show (count a 10 (lambda ([x i32]) -> i32 (== (% x 2) 0)))))
  ;; A closure in a variable sees an assignment to what it uses.
  (let* ([k 1] [times (lambda ([x i32]) -> i32 (* x k))])
    (show (times 5))
    (set! k 3)
    (show (times 5)))
  (newline))
