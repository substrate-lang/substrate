;; A closure returned, which would outlast its frame.
(require-unqualified base "../../compiler/base/base.sub")
(memory from base)
(table from base)

(define (adder [n i32]) -> (closure (i32) -> i32) (lambda ([x i32]) -> i32 (+ x n)))
(define (main) (drop-it ((adder 1) 2)))
(define (drop-it [x i32]) x)
