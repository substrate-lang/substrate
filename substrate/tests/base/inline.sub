;; Inline functions of the C-like Lisp, (define (f ...) #:inline ...),
;; called from another module (tests/fixtures/c-inline-lib.sub): memory
;; through a pointer, an early return, a loop, a struct in the stack
;; frame, a string literal and one inline function calling another.
(require-unqualified base "../../compiler/base/base.sub")
(require print "../../compiler/print.sub" write-int newline)
(require lib "../fixtures/c-inline-lib.sub" counter bump! clamp sum-to dist2 greeting twice-clamped)
(memory from base)
(table from base)

(define (show [x i32]) (print:write-int x) (print:newline))

(define (main)
  (let ([c counter])
    (set! (-> (& c) n) 40)
    (bump! (& c) 2)
    (show (-> (& c) n)))
  (show (clamp -5 0 10))
  (show (clamp 50 0 10))
  (show (clamp 7 0 10))
  (show (sum-to 10))
  (show (dist2 3 4))
  (show (strlen (greeting)))
  (show (twice-clamped 99)))
