;; An inline C function may not call through a function pointer, which uses the table.
(require-unqualified base "../../compiler/base/base.sub")
(memory from base)
(table from base)

(define (apply1 [f (fn (i32) -> i32)] [x i32]) #:inline -> i32 (f x))
(define (double [x i32]) -> i32 (* x 2))
(define (main) (apply1 double 4))
