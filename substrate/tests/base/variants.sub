;; Variants: tagged unions, made in place and taken apart by match.
(require-unqualified base "../../compiler/base/base.sub")
(require print "../../compiler/print.sub" write-int write-byte newline)
(memory from base)
(table from base)

(define (show [x i32]) (write-int x) (write-byte 32))

(struct point [x i32] [y i32])

(variant shape
  [circle [r i32]]
  [rect [w i32] [h i32]]
  [at [p point] [s (ptr shape)]]
  [none])

(define (area [s shape]) -> i32
  (match s
    [(circle r) (* 3 r r)]
    [(rect w h) (* w h)]
    [(at _ inner) (area (@ inner))]
    [none 0]))

(define (grow [s (ptr shape)])
  (match s
    [(circle r) (+= r 1)]
    [(rect w h) (*= w 2) (*= h 2)]
    [_ 0]))

(variant expr
  [num [n i32]]
  [add [a (ptr expr)] [b (ptr expr)]]
  [mul [a (ptr expr)] [b (ptr expr)]]
  [neg [a (ptr expr)]])

(define (make [e expr]) -> (ptr expr)
  (let ([p (cast (ptr expr) (malloc (sizeof expr)))])
    (set! (@ p) e)
    p))

(define (eval [e (ptr expr)]) -> i32
  (match e
    [(num n) n]
    [(add a b) (+ (eval a) (eval b))]
    [(mul a b) (* (eval a) (eval b))]
    [(neg a) (- (eval a))]))

(define (main)
  (let ([c (circle 5)] [r (rect 2 3)] [n shape none] [pt point])
    (show (area c))
    (show (area r))
    (show (area n))
    (show (-> r tag))
    (show (sizeof shape))
    (set! (-> pt x) 1)
    (show (area (at pt (& r))))
    (grow (& c))
    (show (area c))
    (grow (& r))
    (show (area r)))
  (show (eval (make (mul (make (add (make (num 2)) (make (num 3)))) (make (neg (make (num 4))))))))
  (newline))
