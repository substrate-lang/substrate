;; for/each, for/list, fmt and define-macro, at run time and in macros.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified kd "../../compiler/kernel.sub")
(require-unqualified forms "../../compiler/base/forms.sub")
(require print "../../compiler/print.sub" write-int newline)
(memory from base)
(table from base)
(begin-for-syntax
  (require-unqualified base "../../compiler/base/base.sub")
  (require-unqualified kd "../../compiler/kernel.sub")
  (require-unqualified forms "../../compiler/base/forms.sub"))

(define-macro (count-syms stx)
  (let ([n i32 0])
    (for/each ([a (cdr (syntax->list stx))]) (when (symbol? (syntax-e a)) (+= n 1)))
    (datum->syntax stx (fixnum n) stx)))

(define-macro (squares stx)
  (datum->syntax stx (cons 'quote (cons (for/list ([a (cdr (syntax->list stx))])
                                          (let ([v (fixnum-value (syntax-e a))]) (fixnum (* v v))))
                                        nil))
                 stx))

(begin-for-syntax (define (twice [stx datum]) -> datum (let ([x (cadr (syntax->list stx))]) (datum->syntax stx `(+ ,x ,x) stx))))
(define-syntax twice twice)

(define (main)
  (write-int (count-syms a 1 b "s" c)) (newline)
  (write-datum (squares 1 2 3 4)) (newline)
  (write-int (twice 21)) (newline)
  (let ([l (cons (fixnum 1) (cons (fixnum 2) (cons (fixnum 3) (cons (fixnum 4) nil))))] [sum i32 0])
    (for/each ([x l])
      (when (== (fixnum-value x) 2) (continue))
      (when (== (fixnum-value x) 4) (break))
      (+= sum (fixnum-value x)))
    (write-int sum) (newline)
    (write-datum (for/list ([x l]) (fixnum (* 10 (fixnum-value x))))) (newline)
    (write-datum (for/list ([x l] [y (cdr l)]) (fixnum (+ (fixnum-value x) (fixnum-value y))))) (newline)
    (write-datum (for/list ([x l] #:when (== (% (fixnum-value x) 2) 1)) x)) (newline)
    (write-datum (fmt "~a and ~a, ~a" (fixnum 1) 'two (for/list ([x l]) x))) (newline)))
