;; A syntax-match that no clause matches, in a macro written in C, is a
;; syntax error blamed on its subject, as tests/err-syntax-match.sub.
(require-unqualified base "../../compiler/base/base.sub")
(memory from base)
(table from base)
(begin-for-syntax
  (require-unqualified base "../../compiler/base/base.sub")
  (require-unqualified kd "../../compiler/kernel.sub")
  (require sm "../../compiler/base/syntax-match.sub" syntax-match _ ... ?)
  (define (swap! [stx datum]) -> datum
    (syntax-match stx
      [(_ (? identifier? a) (? identifier? b)) #`(let ([t #,a]) (set! #,a #,b) (set! #,b t))])))
(define-syntax swap! swap!)
(define (run) (let ([x 1]) (swap! x 2)))
(define (main) (run))
