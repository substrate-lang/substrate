;; syntax-match for C code (compiler/base/syntax-match.sub), as
;; tests/syntax-match.sub: patterns take syntax apart, in a program and in
;; a macro, all C.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified kd "../../compiler/kernel.sub")
(require sm "../../compiler/base/syntax-match.sub" syntax-match _ ... ?)
(require print "../../compiler/print.sub" write-bytes newline)
(memory from base)
(table from base)
(begin-for-syntax
  (require-unqualified base "../../compiler/base/base.sub")
  (require-unqualified kd "../../compiler/kernel.sub")
  (require sm "../../compiler/base/syntax-match.sub" syntax-match _ ... ?))

;; Two ellipses in one list.
(define (signature [s datum]) -> datum
  (syntax-match s
    [(param ... '-> result ...) `(,(syntax->datum param) ,(syntax->datum result))]))

;; Words compared by name, checks, and an element after an ellipsis.
(define (clause [c datum]) -> datum
  (syntax-match c
    [('catch tag ((? identifier? x) ...) body ...) `(catch ,(syntax-e tag) ,(syntax->datum x) ,(make-integer (length body)))]
    [('catch-ref tag (x ... e) body ...) `(catch-ref ,(syntax->datum x) ,(syntax-e e))]
    [('catch-all body ...) `(catch-all ,(make-integer (length body)))]
    [_ 'other]))

;; Nested ellipses, a keyword, a dotted tail, and a part bound and taken
;; apart.
(define (group [s datum]) -> datum
  (syntax-match s
    [(#:group (? syntax? whole ([x v ...] ...)) . rest)
     `(,(make-integer (length (syntax-e whole))) ,(syntax->datum x) ,(syntax->datum v) ,(make-integer (length rest)))]))

;; A list of syntax, not a syntax list; () and data.
(define (shape [l datum]) -> datum
  (syntax-match l
    [() 'empty]
    [(5 "five" #t) 'data]
    [(a) `(one ,(syntax-e a))]
    [(a . b) 'pair]))

;; A macro: #'else compared by binding, a _ head, and recursion.
(begin-for-syntax
  (define (my-cond [stx datum]) -> datum
    (syntax-match stx
      [(_) #''none]
      [(_ (#'else e ...)) #`(begin #,@e)]
      [(_ (test e ...) clause ...) #`(if #,test (begin #,@e) (my-cond #,@clause))])))
(define-syntax my-cond my-cond)

(define (display [s datum]) (write-bytes (cast i32 (string-bytes s)) (cast i32 (string-length s))))

(define (main)
  (write-datum (signature #'(i32 eqref -> i64))) (newline)
  (write-datum (signature #'(->))) (newline)
  (write-datum `(,(clause #'(catch t (a b) x y)) ,(clause #'(catch-ref t (a b e) x)) ,(clause #'(catch-all 1 2 3))
                 ,(clause #'(catch t (1) x)) ,(clause #'(other))))
  (newline)
  (write-datum (group #'(#:group ([a 1 2] [b] [c 3]) z z))) (newline)
  (write-datum `(,(shape nil) ,(shape (cons #'5 (cons #'"five" (cons #'#t nil)))) ,(shape (cons #'x nil)) ,(shape (cons #'x (cons #'y nil)))))
  (newline)
  (write-datum `(,(my-cond [#f '1] [else '2]) ,(my-cond [#f '1]) ,(my-cond [(== 1 1) '3] [else '4]))) (newline)
  ;; The error when no clause matches, caught.
  (try (signature #'(i32 eqref)) [catch compile-error (message blamed at) (display message)])
  (newline)
  (try (group #'(group x)) [catch compile-error (message blamed at) (display message)])
  (newline)
  (try (syntax-match #'(tag 5) [('tag (? identifier? name) (type ...)) name])
       [catch compile-error (message blamed at) (display message)])
  (newline))
