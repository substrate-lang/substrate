;; The C example's cond, case, array-of, loops that do not finish, returns
;; of what gives no value, and match of a pointer that may be null
;; (examples/base/lang.sub).
(require-unqualified base "../../compiler/base/base.sub")
(require print "../../compiler/print.sub" write-int write-byte newline)
(memory from base)
(table from base)

(define (show [x i32]) (write-int x) (write-byte 32))

(define (sign [x i32]) -> i32
  (cond [(< x 0) -1]
        [(== x 0) 0]
        [else 1]))

;; A cond with no else, which gives nothing.
(define (note [x i32])
  (cond [(> x 100) (show 100)]
        [(> x 10) (show 10)]))

(define (kind [c i32]) -> i32
  (case c
    [(#\a #\e #\i #\o #\u) 1]
    [(#\space #\tab #\newline) 2]
    [else 0]))

;; A key found once.
(define counter i32 0)
(define (next) -> i32 (+= counter 1) counter)

;; A loop forever, left only by a return, so the function needs no value
;; after it.
(define (first-square-above [n i32]) -> i32
  (let ([i 0])
    (while 1
      (when (> (* i i) n) (return (* i i)))
      (+= i 1))))

;; One a break leaves finishes.
(define (count-to [n i32]) -> i32
  (let ([i 0])
    (while #t
      (when (== i n) (break))
      (+= i 1))
    i))

(define (twice [x i32]) (show (* 2 x)))

(define (early [x i32])
  (when (> x 0) (return (twice x)))
  (show -1))

(struct point [x i32] [y i32])

(define primes (array i32 5) (array-of i32 2 3 5 7 11))

(define (arrays)
  (let ([names (array-of (ptr u8) "zero " "one " "two ")] [ps (array-of point (point-at 1 2) (point-at 3 4))])
    (print-string (@ names 2))
    (show (+ (-> (@ ps 1) x) (-> (@ ps 0) y)))
    (show (@ primes 4))))

(define (point-at [x i32] [y i32]) -> point
  (let ([p point])
    (set! (-> p x) x)
    (set! (-> p y) y)
    p))

(variant shape [circle [r i32]] [square [side i32]])

(define (area [s (ptr shape)]) -> i32
  (match s
    [#f 0]
    [(circle r) (* 3 r r)]
    [(square side) (* side side)]))

(define (named [s (ptr shape)]) -> i32
  (match s
    [(circle r) 1]
    [_ 0]))

(define (main)
  (show (sign -5)) (show (sign 0)) (show (sign 7))
  (note 50) (note 500) (note 5)
  (show (kind #\e)) (show (kind #\space)) (show (kind #\z))
  (show (case (next) [(1) 10] [(2) 20] [else 30]))
  (show counter)
  (newline)
  (show (first-square-above 50)) (show (count-to 7))
  (early 4) (early -4)
  (newline)
  (arrays)
  (newline)
  (let ([c shape (circle 2)])
    (show (area (& c)))
    (show (area 0))
    (show (named (& c)))
    (show (named 0)))
  (newline))
