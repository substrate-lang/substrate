;; A pattern names a struct or variant (lib/match.sub).
(require st "../lib/struct.sub" struct enum)
(require m "../lib/match.sub" match else _)
(enum shape (circle [r i32]) (square [side i32]) (rect [w i32] [h i32]))

(func (area [s (ref shape)]) -> i32
  (match s [(circle r) r] [(triangle a b) a] [else 0]))
(func (main))
