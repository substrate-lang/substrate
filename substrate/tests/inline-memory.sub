;; An inline function may use memory (spec 5.2): a call of it in a module
;; that shares the function's module's memory, through memory from, is
;; inlined, and reads and writes the memory the caller sees.
(require print "../compiler/print.sub" write-int newline)
(require lib "fixtures/inline-memory-lib.sub" peek poke)
(memory from print)
(func (main)
  (lib:poke 2048 41)
  (write-int (lib:peek 2048))
  (newline)
  (lib:poke 2048 (i32.add (lib:peek 2048) 1))
  (write-int (lib:peek 2048))
  (newline))
