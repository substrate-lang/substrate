;; A handler needs a clause for each operation of its effect, found by
;; binding (examples/effects/handlers.sub).
(require-unqualified fx "../examples/effects/handlers.sub")
(effect Log (info x) (warn x))
(define (run)
  (with-handler (Log [(info x) x] [(warning x) x])
    (info 1)))
(func (main) (run))
