;; define-syntax binds a compile-time value that is not a transformer, as
;; tests/compile-time-values.sub: here a datum in memory. Macros read it
;; with syntax-local-value. This is how a struct form and a match form
;; will talk to each other.

(require print "../compiler/print.sub" write-int newline)
(begin-for-syntax (require k kernel))

(define-syntax point '(x y))
(define-syntax color '(red green blue alpha))

;; (field-count T) expands to the number of fields recorded for T.
(begin-for-syntax
  (func (field-count [stx i32]) -> i32
    (let* ([name (k:cadr (k:syntax->list stx))]
           [fields (k:syntax-local-value name)])
      (if (i32.eqz (k:pair? fields))
          (k:raise-syntax-error '#f '"has no field information" name))
      (k:datum->syntax stx (k:fixnum (k:length fields)) stx))))
(define-syntax field-count field-count)

;; (field-index T f) expands to f's position in T, or is a compile error.
(begin-for-syntax
  (func (field-index [stx i32]) -> i32
    (let* ([parts (k:syntax->list stx)]
           [fields (k:syntax-local-value (k:cadr parts))]
           [field (k:syntax-e (k:caddr parts))]
           [i 0])
      (block done
        (loop next
          (if (k:null? fields) (k:raise-syntax-error '#f '"no such field" (k:caddr parts)))
          (br-if done (i32.eq (k:car fields) field))
          (set! fields (k:cdr fields))
          (set! i (i32.add i 1))
          (br next)))
      (k:datum->syntax stx (k:fixnum i) stx))))
(define-syntax field-index field-index)

(func (main)
  (write-int (field-count point)) (newline)
  (write-int (field-count color)) (newline)
  (write-int (field-index color blue)) (newline))
