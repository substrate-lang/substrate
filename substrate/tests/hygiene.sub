;; Hygiene (spec 6.2). Every macro use gets a fresh introduction scope, so
;; what a macro introduces cannot capture the user's code or be captured by
;; it. Uses at module level also get a use-site scope.

(require "../lib/print.sub" "../lib/macro.sub" (for-syntax syntax))

;; 1. A binding the macro introduces does not capture the user's variable,
;; even when the user's variable has the same name.
;; (swap! a b) => (let ([tmp a]) (set! a b) (set! b tmp))
(define-macro (swap! stx)
  (let ([p (syntax->list stx)])
    #`(let ([tmp #,(cadr p)]) (set! #,(cadr p) #,(caddr p)) (set! #,(caddr p) tmp))))

;; 2. Each use gets its own bindings. (define-counter name) defines a global
;; `count` and a function `name` that bumps it. Two uses make two counters,
;; and neither `count` is the user's.
(define-macro (define-counter stx)
  #`(begin
      (global count i32 0)
      (func (#,(cadr (syntax->list stx))) -> i32
        (set! count (i32.add count 1))
        count)))

(define-counter tick)
(define-counter tock)
(global count i32 1000)

;; 3. A binding made from the macro's input does not capture a reference the
;; macro introduced, even at module level, where the use site and the
;; macro's definition share the module's scopes. That is the use-site
;; scope's job. (getter name id) => (func (name) -> i32 (let ([id 5]) x))
(global x i32 100)
(define-macro (getter stx)
  (let ([p (syntax->list stx)])
    #`(func (#,(cadr p)) -> i32 (let ([#,(caddr p) 5]) x))))
(getter get-x x)

;; 4. Capture on purpose: datum->syntax with the use's context makes an
;; identifier as if the user had written it.
(define-macro (define-it stx)
  #`(global #,(datum->syntax stx 'it) i32 42))
(define-it)

(func (main)
  (let ([tmp 1] [other 2])
    (swap! tmp other)
    (write-int tmp) (write-int other) (newline))
  (drop (tick)) (drop (tick))
  (write-int (tick)) (write-int (tock)) (write-int count) (newline)
  (write-int (get-x)) (newline)
  (write-int it) (newline))
