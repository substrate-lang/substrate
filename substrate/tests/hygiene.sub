;; Hygiene: what a macro introduces neither captures the user's code nor is captured by it.

(require print "../compiler/print.sub" write-int newline)
(require m "fixtures/macro.sub" define-macro)
(begin-for-syntax (require k kernel))

(define-macro (swap! stx)
  (let ([p (k:syntax->list stx)])
    #`(let ([tmp #,(k:cadr p)]) (set! #,(k:cadr p) #,(k:caddr p)) (set! #,(k:caddr p) tmp))))

(define-macro (define-counter stx)
  #`(begin
     (global count (mut i32) 0)
     (func (#,(k:cadr (k:syntax->list stx))) -> i32
       (set! count (i32.add count 1))
       count)))

(define-counter tick)
(define-counter tock)
(global count i32 1000)

(global x i32 100)
(define-macro (getter stx)
  (let ([p (k:syntax->list stx)])
    #`(func (#,(k:cadr p)) -> i32 (let ([#,(k:caddr p) 5]) x))))
(getter get-x x)

(define-macro (define-it stx)
  #`(global #,(k:datum->syntax stx 'it stx) i32 42))
(define-it)

(func (main)
  (let ([tmp 1] [other 2])
    (swap! tmp other)
    (write-int tmp) (write-int other) (newline))
  (drop (tick)) (drop (tick))
  (write-int (tick)) (write-int (tock)) (write-int count) (newline)
  (write-int (get-x)) (newline)
  (write-int it) (newline))
