;; Hygiene: what a macro introduces neither captures the user's code nor is captured by it.

(require m "fixtures/macro.sub" define-macro)
(begin-for-syntax (require-unqualified macros "../compiler/macros.sub"))

(define-macro (swap! stx)
  (let ([p (syntax->list stx)])
    #`(let ([tmp #,(cadr p)]) (set! #,(cadr p) #,(caddr p)) (set! #,(caddr p) tmp))))

(define-macro (define-counter stx)
  #`(begin
     (define count i32 0)
     (define (#,(cadr (syntax->list stx))) -> i32
       (set! count (+ count 1))
       count)))

(define-counter tick)
(define-counter tock)
(define count i32 1000)

(define x i32 100)
(define-macro (getter stx)
  (let ([p (syntax->list stx)])
    #`(define (#,(cadr p)) -> i32 (let ([#,(caddr p) 5]) x))))
(getter get-x x)

(define-macro (define-it stx)
  #`(define #,(datum->syntax stx 'it stx) i32 42))
(define-it)

(define (main)
  (let ([tmp 1] [other 2])
    (swap! tmp other)
    (printf "~a~a\n" tmp other))
  (tick) (tick)
  (printf "~a~a~a\n" (tick) (tock) count)
  (printf "~a\n" (get-x))
  (printf "~a\n" it))
