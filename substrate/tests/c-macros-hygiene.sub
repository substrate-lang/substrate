;; A C macro from another module calls that module's double, not this one's.
(require-unqualified base "../compiler/base/base.sub")
(require print "../compiler/print.sub" write-int newline)
(require lib "fixtures/c-macro-lib.sub" quad)

(define (double [x i32]) -> i32 (+ x 1000))

(define (main) (write-int (quad 5)) (newline) (write-int (double 5)) (newline))
