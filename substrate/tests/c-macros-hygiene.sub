;; A macro written in C in another module (fixtures/c-macro-lib.sub)
;; expands into calls of that module's double, not of this one's.
(require-unqualified c "../compiler/c/c.sub")
(require print "../lib/print.sub" write-int newline)
(require lib "fixtures/c-macro-lib.sub" quad)
(memory from c)
(table from c)

(define (double [x i32]) -> i32 (+ x 1000))

(define (main) (write-int (quad 5)) (newline) (write-int (double 5)) (newline))
