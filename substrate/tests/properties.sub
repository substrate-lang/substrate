;; Syntax properties: a macro attaches a value, and a later macro reads it.
(require print "../compiler/print.sub" write-int newline)
(begin-for-syntax (require k kernel))

(begin-for-syntax
  (func (weigh [stx i32]) -> i32
    (let ([e (k:cadr (k:syntax->list stx))])
      #`(report #,(k:syntax-property-set (k:syntax-property-set e 'weight (k:fixnum 1))
                                        'weight (k:fixnum 7))))))
(define-syntax weigh weigh)

(begin-for-syntax
  (func (report [stx i32]) -> i32
    (let ([w (k:syntax-property (k:cadr (k:syntax->list stx)) 'weight)])
      (k:datum->syntax stx (if (i32.eqz w) (k:fixnum -1) w) stx))))
(define-syntax report report)

(func (main)
  (write-int (weigh x)) (newline)
  (write-int (report x)) (newline))
