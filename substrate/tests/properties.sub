;; Syntax properties: a macro attaches a value, and a later macro reads it.
(begin-for-syntax (require-unqualified syntax "../compiler/syntax.sub"))

(begin-for-syntax
  (define (weigh [stx datum]) -> datum
    (let ([e (cadr (syntax->list stx))])
      #`(report #,(syntax-property-set (syntax-property-set e 'weight (fixnum 1)) 'weight (fixnum 7))))))
(define-syntax weigh weigh)

(begin-for-syntax
  (define (report [stx datum]) -> datum
    (let ([w (syntax-property (cadr (syntax->list stx)) 'weight)])
      (datum->syntax stx (if w w (fixnum -1)) stx))))
(define-syntax report report)

(func (main)
  (write-int (weigh x)) (newline)
  (write-int (report x)) (newline))
