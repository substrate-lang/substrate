;; Syntax properties (spec 2.3): a macro attaches a value to syntax, and a
;; macro that later receives that syntax reads it.
(require print "../lib/print.sub" write-int newline)
(begin-for-syntax (require s syntax))

;; (weigh e) => (report e'), where e' is e with property weight = 7. The
;; second set replaces the first.
(begin-for-syntax
  (func (weigh [stx eqref]) -> eqref
    (let ([e (s:cadr (s:syntax->list stx))])
      #`(report #,(s:syntax-property-set (s:syntax-property-set e 'weight (s:fixnum 1))
                                        'weight (s:fixnum 7))))))
(define-syntax weigh weigh)

;; (report e) => e's weight property, or -1 if it has none.
(begin-for-syntax
  (func (report [stx eqref]) -> eqref
    (let ([w (s:syntax-property (s:cadr (s:syntax->list stx)) 'weight)])
      (s:datum->syntax stx (if (ref.is_null w) (s:fixnum -1) w)))))
(define-syntax report report)

(func (main)
  (write-int (weigh x)) (newline)
  (write-int (report x)) (newline))
