;; Data values (spec 2): quote, quasiquote, and rt's list, string, symbol
;; and vector operations.

(func (main)
  (write '(1 -2 (3 . 4) "five\n" #\x #\space sym #t #f () #(v 1))) (newline)
  (let ([xs '(a b)] [n (fixnum 7)])
    (write `(list ,@xs ,n (nested ,(car xs)) end)) (newline)
    (write `#(1 ,n)) (newline)
    (write `(1 `(2 ,(3 ,n)))) (newline))
  (display "hello, world") (newline)
  (display '("display" #\c)) (newline)
  (write (eq? 'abc (string->symbol "abc"))) (newline)
  (write (length '(1 2 3))) (newline)
  (write (vector-ref '#(a b c) (fixnum 1))) (newline)
  (write (append '(1 2) '(3))) (newline)
  (write (reverse '(1 2 3))) (newline)
  (write (symbol-append 'foo- 'bar)) (newline)
  (write (assq 'b '((a . 1) (b . 2)))) (newline)
  (write (datum->syntax #f '(x (y)))) (newline)
  (write (syntax->datum (datum->syntax #f '(x (y))))) (newline)
  (write "λ unicode ✓") (newline)
  (write (string-length "λ")) (newline))
