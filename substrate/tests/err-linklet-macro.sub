;; What #%linklet returns must be fully expanded code (spec 6.5): here it
;; returns a use of the macro m.
(begin-for-syntax
  (require k kernel)
  (func (seven [stx eqref]) -> eqref #'7)
  (func (hook [stx eqref]) -> eqref #'((drop (m)))))
(define-syntax m seven)
(define-syntax #%linklet hook)
(func (main) (nop))
