;; The forms kernel code is written with, on data and on numbers.
(require print "../compiler/print.sub" newline)
(require k kernel)
(require-unqualified kf "../compiler/kernel-forms.sub")

(func (size [x i32]) -> i32
  (cond [(k:null? x) 'empty]
        [(i32.eqz (k:pair? x)) 'atom]
        [(k:null? (k:cdr x)) 'one]
        [else 'many]))

(func (kind [x i32]) -> i32
  (case x
    [(a b) 'letter]
    [(1 2 3) 'number]
    [("s" #\c) 'text]
    [(#f) 'false]
    [else 'other]))

(func (main)
  (k:write-datum `(,(size '()) ,(size 'x) ,(size '(1)) ,(size '(1 2)))) (newline)
  (k:write-datum `(,(kind 'b) ,(kind '2) ,(kind '"s") ,(kind '#\c) ,(kind '#f) ,(kind 'z))) (newline)
  (k:write-datum `(,(k:fixnum (and)) ,(and 'x) ,(and 'x 'y) ,(and '#f 'y) ,(or) ,(or '#f 'z) ,(or '#f '#f))) (newline)
  (let ([n 0])
    (when (i32.eq n 0) (set! n 5))
    (unless (i32.eq n 0) (set! n (i32.add n 1)))
    (k:write-datum (k:fixnum n)) (newline))
  (let ([l '(1 2 3 4)] [total 0])
    (for/each ([x l]) (set! total (i32.add total (k:fixnum-value x))))
    (k:write-datum `(,(k:fixnum total)
                     ,(for/list ([x l] [y '(a b c)]) `(,x ,y))
                     ,(for/list ([x l] #:when (i32.eq (i32.rem_u (k:fixnum-value x) 2) 0)) x)
                     ,(for/fold ([acc '()]) ([x l]) (k:cons x acc))
                     ,(for/and ([x l]) x)
                     ,(for/and ([x l]) (if (i32.eq (k:fixnum-value x) 3) 0 x))
                     ,(for/or ([x l]) (if (i32.eq (k:fixnum-value x) 3) 'three 0))
                     ,(for/or ([x '()]) x)))
    (newline)))
