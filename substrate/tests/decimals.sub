;; A decimal literal is the nearest f64, ties to even; each line is a literal's bits.
(require numbers "../compiler/numbers.sub" f64-bits)

(define (show [x f64]) (printf "~a\n" (cast u64 (f64-bits x))))

(define (main)
  (show 0.1)
  (show 1e23)
  (show 9007199254740993.0)
  (show 9007199254740995.0)
  (show 1.7976931348623157e308)
  (show 1.7976931348623159e308)
  (show 1e999999)
  (show 2.2250738585072014e-308)
  (show 2.2250738585072011e-308)
  (show 4.9e-324)
  (show 2.4703282292062327e-324)
  (show 2.4703282292062328e-324)
  (show 3.14159265358979323846264338327950288419716939937510)
  (show -0.0))
