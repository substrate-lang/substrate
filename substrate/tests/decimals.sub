;; A decimal literal is the f64 nearest its value, ties to even: infinity
;; above the largest f64, zero below half the smallest (spec 5.4). Each
;; line is a literal's bits.
(require print "../lib/print.sub" write-u64 newline)

(func (show [x f64]) (write-u64 (i64.reinterpret_f64 x)) (newline))

(func (main)
  (show 0.1)
  (show 1e23)                              ; beyond the fast path
  (show 9007199254740993.0)                ; a tie: 2^53
  (show 9007199254740995.0)                ; a tie: 2^53 + 4
  (show 1.7976931348623157e308)            ; the largest f64
  (show 1.7976931348623159e308)            ; rounds up past it: infinity
  (show 1e999999)                          ; infinity
  (show 2.2250738585072014e-308)           ; the smallest normal f64
  (show 2.2250738585072011e-308)           ; subnormal
  (show 4.9e-324)                          ; the smallest subnormal
  (show 2.4703282292062327e-324)           ; below half of it: zero
  (show 2.4703282292062328e-324)           ; above half of it
  (show 3.14159265358979323846264338327950288419716939937510)
  (show -0.0))
