;; Types and values are separate namespaces (spec 6.1). The fixture's
;; point is a type and a function; requiring it by name brings both, and so
;; does the qualified name.
(require print "../compiler/print.sub" write-int newline)
(require pt "fixtures/point.sub" point)

(func (main)
  (let ([p (ref point) (point 3 4)]
        [q (ref pt:point) (pt:point 5 6)])
    (write-int (pt:point-x p)) (newline)
    (write-int (struct.get point y q)) (newline)))
