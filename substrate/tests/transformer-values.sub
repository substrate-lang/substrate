;; Transformers are values (spec 2.1, 6.3). make-transformer pairs a code
;; function with an environment, so one function makes many macros, and a
;; transformer can be computed. A name is a macro when its value is a
;; transformer, and syntax-local-value gives a macro's transformer.

(require print "../lib/print.sub" write-int newline)
(begin-for-syntax
  (require k kernel)
  (type transformer-code (func (eqref eqref -> eqref)))

  ;; A use of the macro expands to the number in its environment.
  (func (constant [env eqref] [stx eqref]) -> eqref (type transformer-code)
    (k:datum->syntax stx env stx))

  (func (constant-macro [n eqref]) -> eqref (k:make-transformer (ref.func constant) n)))

(define-syntax forty-two (constant-macro '42))
(define-syntax seven (constant-macro '7))
(define-syntax not-a-macro '(1 2))

;; (macro? id) expands to 1 if id is a macro with a transformer for its
;; value, and to 0 otherwise.
(begin-for-syntax
  (func (macro? [stx eqref]) -> eqref
    (let ([id (k:cadr (k:syntax->list stx))])
      (k:datum->syntax stx
                       (k:fixnum (if (ref.eq (k:identifier-binding-kind id) 'macro)
                                     (i32.eqz (ref.is_null (k:syntax-local-value id)))
                                     0))
                       stx))))
(define-syntax macro? macro?)

(func (main)
  (write-int forty-two) (newline)
  (write-int (seven)) (newline)
  (write-int (macro? seven)) (newline)
  (write-int (macro? not-a-macro)) (newline))
