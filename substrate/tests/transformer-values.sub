;; Transformers are values: make-transformer pairs code with an environment.

(require print "../compiler/print.sub" write-int newline)
(begin-for-syntax
  (require k kernel)

  (func (constant [env i32] [stx i32]) -> i32 (k:datum->syntax stx env stx))

  (func (constant-macro [n i32]) -> i32 (k:make-transformer (func-index constant) n)))

(define-syntax forty-two (constant-macro '42))
(define-syntax seven (constant-macro '7))
(define-syntax not-a-macro '(1 2))

(begin-for-syntax
  (func (macro? [stx i32]) -> i32
    (let ([id (k:cadr (k:syntax->list stx))])
      (k:datum->syntax stx
                       (k:fixnum (if (i32.eq (k:identifier-binding-kind id) 'macro)
                                     (i32.ne (k:syntax-local-value id) 0)
                                     0))
                       stx))))
(define-syntax macro? macro?)

(func (main)
  (write-int forty-two) (newline)
  (write-int (seven)) (newline)
  (write-int (macro? seven)) (newline)
  (write-int (macro? not-a-macro)) (newline))
