;; A compiled file (spec 3.7): a program's closure written by sub build
;; -m is required as (compiled FILE), its entry's provides bound, and
;; nothing is compiled from source. geometry's macro show-square runs from
;; the compile-time linklet in that file.
(require print "../lib/print.sub" write-int newline)
(require geo (compiled "../build/tests/compiled/geometry.subc") square)
(func (main)
  (write-int (square 6)) (newline)
  (geo:show-square 5))
