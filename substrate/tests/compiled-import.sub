;; A compiled module (spec 3.7): the program built to a directory is
;; required as (compiled DIR), its entry's provides bound, and nothing is
;; compiled from its source. geometry's macro show-square runs from the
;; compile-time linklet in that directory.
(require print "../lib/print.sub" write-int newline)
(require geo (compiled "../build/tests/compiled/geometry") square)
(func (main)
  (write-int (square 6)) (newline)
  (geo:show-square 5))
