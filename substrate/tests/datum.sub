;; #%datum (spec 5.4): a literal is (#%datum literal), and #%datum means
;; what it is bound to where the literal was written. Here literals are
;; syntax-library values, so write-datum can print them. The literals in
;; lib/struct.sub's templates keep struct.sub's #%datum, the core one, so
;; point? still returns an i32.
(require print "../lib/print.sub" write-int newline)
(require wd "../lib/write-datum.sub" write-datum)
(require st "../lib/struct.sub" struct)
(require vd "fixtures/value-datum.sub" [#%datum datum])

(struct point [x i32] [y i32])

(func (main)
  (write-datum 42) (newline)
  (write-datum "text") (newline)
  (write-datum #\a) (newline)
  (write-int (point? "not a point")) (newline))
