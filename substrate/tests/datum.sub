;; #%datum (spec 5.4): a literal is (#%datum literal), and #%datum means
;; what it is bound to where the literal was written. Here literals are
;; syntax-library values, so Substrate's write can print them. The literals
;; in the templates of the struct library (examples/shapes/struct.sub)
;; keep its #%datum, the core one, so point? still returns an i32.
(require print "../lib/print.sub" write-int newline)
(require sub "../lib/substrate.sub" write)
(require st "../examples/shapes/struct.sub" struct)
(require vd "fixtures/value-datum.sub" [#%datum datum])

(struct point [x i32] [y i32])

(func (main)
  (write 42) (newline)
  (write "text") (newline)
  (write #\a) (newline)
  (write-int (point? "not a point")) (newline))
