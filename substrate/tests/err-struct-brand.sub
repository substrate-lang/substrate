;; celsius and fahrenheit have the same structure, so the same type (spec
;; 5.1), and a (ref celsius) parameter accepts a fahrenheit. The accessor
;; checks the brand and stops, naming itself and both structs
;; (examples/shapes/struct.sub).
(require st "../examples/shapes/struct.sub" struct)
(struct celsius [t i32])
(struct fahrenheit [t i32])
(func (main) (drop (celsius-t (make-fahrenheit 451))))
