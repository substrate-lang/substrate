;; Hash tables in Substrate (lib/substrate.sub): eq? tables keyed by
;; symbols, records and numbers, which carry or are their hashes, and
;; equal? tables keyed by strings, lists and vectors, hashed by contents.
;; Growing rehashes by the stored hashes.
(require-unqualified substrate "../lib/substrate.sub")

(define-record-type point (make-point x y) point? (x point-x) (y point-y))

(define (run)
  (let ([t (make-eq-hashtable)] [p (make-point 1 2)])
    (hashtable-set! t 'a 1)
    (hashtable-set! t p 'point)
    (do ([i 0 (+ i 1)]) ((= i 100)) (hashtable-set! t i (* i i)))
    (hashtable-update! t 'a (lambda (x) (+ x 1)) 0)
    (hashtable-update! t 'b (lambda (x) (+ x 1)) 0)
    (hashtable-delete! t 5)
    (write (list (hashtable-ref t 'a #f) (hashtable-ref t 'b #f) (hashtable-ref t p #f)
                 (hashtable-ref t 42 #f) (hashtable-ref t (make-point 1 2) 'absent)
                 (hashtable-contains? t 5) (hashtable-count t)))
    (newline))
  (let ([e (make-equal-hashtable)] [v (make-eqv-hashtable)])
    (hashtable-set! e "key" 1)
    (hashtable-set! e '(1 2) 2)
    (hashtable-set! e (vector 1 "x") 3)
    (write (list (hashtable-ref e (string-append "k" "ey") #f) (hashtable-ref e (list 1 2) #f)
                 (hashtable-ref e (vector 1 "x") #f) (hashtable->alist e)))
    (newline)
    (hashtable-set! v 9223372036854775807 'big)
    (hashtable-set! v #\λ 'lambda)
    (write (list (hashtable-ref v 9223372036854775807 #f) (hashtable-ref v (integer->char 955) #f)
                 (hashtable-keys v) (hashtable-values v)))
    (newline)
    (hashtable-clear! v)
    (write (hashtable-count v))
    (newline)))

(func (main) (run))
