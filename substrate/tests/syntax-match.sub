;; syntax-match (lib/substrate.sub): patterns take syntax apart, in a
;; program and in a macro.
(require-unqualified substrate "../lib/substrate.sub")
(begin-for-syntax (require-unqualified substrate "../lib/substrate.sub"))

;; Two ellipses in one list.
(define (signature s)
  (syntax-match s
    [(param ... '-> result ...) (list (map syntax-e param) (map syntax-e result))]))

;; Words compared by name, checks, and an element after an ellipsis.
(define (clause c)
  (syntax-match c
    [('catch tag ((? identifier? x) ...) body ...) (list 'catch (syntax-e tag) (map syntax-e x) (length body))]
    [('catch-ref tag (x ... e) body ...) (list 'catch-ref (map syntax-e x) (syntax-e e))]
    [('catch-all body ...) (list 'catch-all (length body))]
    [_ 'other]))

;; Nested ellipses, a keyword, a dotted tail, and a part bound and taken
;; apart.
(define (group s)
  (syntax-match s
    [(#:group (? syntax? whole ([x v ...] ...)) . rest)
     (list (length (syntax-e whole)) (map syntax-e x) (map (lambda (vs) (map syntax-e vs)) v) (length rest))]))

;; A list of syntax, not a syntax list; () and data.
(define (shape l)
  (syntax-match l
    [() 'empty]
    [(5 "five" #t) 'data]
    [(a) (list 'one (syntax-e a))]
    [(a . b) 'pair]))

;; A macro: #'else compared by binding, a _ head, and recursion.
(define-syntax (my-cond stx)
  (syntax-match stx
    [(_) #''none]
    [(_ (#'else e ...)) #`(begin #,@e)]
    [(_ (test e ...) clause ...) #`(if #,test (begin #,@e) (my-cond #,@clause))]))

;; The error when no clause matches, caught.
(define (message thunk)
  (with-handlers ([syntax-error? exn-message]) (thunk)))

(define (run)
  (display (signature #'(i32 eqref -> i64))) (newline)
  (display (signature #'(-> ))) (newline)
  (display (map clause (list #'(catch t (a b) x y) #'(catch-ref t (a b e) x) #'(catch-all 1 2 3)
                             #'(catch t (1) x) #'(other))))
  (newline)
  (display (group #'(#:group ([a 1 2] [b] [c 3]) z z))) (newline)
  (display (map shape (list '() (list #'5 #'"five" #'#t) (list #'x) (list #'x #'y)))) (newline)
  (display (list (my-cond [#f 1] [else 2]) (my-cond [#f 1]) (my-cond [(= 1 1) 3] [else 4]))) (newline)
  (display (message (lambda () (signature #'(i32 eqref))))) (newline)
  (display (message (lambda () (group #'(group x))))) (newline)
  (display (message (lambda () (syntax-match #'(tag 5) [('tag (? identifier? name) (type ...)) name]))))
  (newline))

(func (main) (run))
