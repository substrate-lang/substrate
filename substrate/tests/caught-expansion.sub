;; A macro may catch what an expansion it asked for throws, and go on: the expander is as it was.
(begin-for-syntax
  (require-unqualified macros "../compiler/macros.sub")
  (exception oops)
  (define (fails [s datum]) -> datum (throw oops) s)
  (define (attempt [s datum]) -> datum
    (syntax-match s
      [(_ e f) (try (local-expand e) [catch oops () f])])))
(define-syntax fails fails)
(define-syntax attempt attempt)

(attempt (fails) (define answer i32 42))
(define (main) (write-int answer) (newline))
