;; Declared supertypes as in wasm: subtyping, ref.test, ref.cast, and joins in if.
(require print "../compiler/print.sub" write-int newline)

(type shape (sub (struct (field sides i32))))
(type square (sub final shape (struct (field sides i32) (field side i32))))
(type rect (sub final shape (struct (field sides i32) (field w i32) (field h i32))))
(type tile (sub final shape (struct (field sides i32) (field side i32))))

(func (area [s (ref shape)]) -> i32
  (if (ref.test (ref square) s)
      (let ([q (ref.cast (ref square) s)]) (i32.mul (struct.get square side q) (struct.get square side q)))
      (let ([r (ref.cast (ref rect) s)]) (i32.mul (struct.get rect w r) (struct.get rect h r)))))

(func (pick [big? i32]) -> (ref shape)
  (if big? (struct.new square 4 10) (struct.new rect 4 2 3)))

(func (main)
  (write-int (area (struct.new square 4 5))) (newline)
  (write-int (area (pick 0))) (newline)
  (write-int (struct.get shape sides (pick 1))) (newline)
  (write-int (ref.test (ref square) (struct.new tile 4 1))) (newline))
