;; Each clause of a match can match: this one's variant an earlier clause
;; took (examples/typed/typed.sub).
(require-unqualified typed "../examples/typed/typed.sub")
(data (Option T) [None] [Some T])
(define (get [o : (Option Int)]) : Int (match o [(Some x) x] [None 0] [(Some y) y]))
(func (main) (drop (get (Some 1))))
