;; A recursion group (spec 5.2): types that refer to each other. A tree
;; holds a forest of children; a forest is a list of trees.
(require print "../compiler/print.sub" write-int newline)

(rec
  (type tree (struct (field value i32) (field kids (ref null forest))))
  (type forest (struct (field first (ref tree)) (field rest (ref null forest)))))

(func (leaf [v i32]) -> (ref tree) (struct.new tree v (ref.null forest)))

(func (sum-tree [t (ref tree)]) -> i32
  (i32.add (struct.get tree value t) (sum-forest (struct.get tree kids t))))

(func (sum-forest [f (ref null forest)]) -> i32
  (if (ref.is_null f)
      0
      (let ([g (ref.as_non_null f)])
        (i32.add (sum-tree (struct.get forest first g)) (sum-forest (struct.get forest rest g))))))

(func (main)
  (write-int (sum-tree (struct.new tree 1 (struct.new forest (leaf 2) (struct.new forest (leaf 3) (ref.null forest))))))
  (newline))
