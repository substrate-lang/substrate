;; Macros whose templates use each other. Required at two phases, this
;; module has bindings named `one` at the same phase from both requires:
;; the phase-1 function behind the macro, and the macro itself one phase
;; up. Separate module scopes per phase keep them apart (spec 6.1).
(require m "macro.sub" define-macro)
(begin-for-syntax (require s syntax))
(provide one two)
(define-macro (one stx) #'1)
(define-macro (two stx) #`(i32.add (one) (one)))
