;; Macros whose templates use each other, required at two phases. two is used in module-level code.
(require m "macro.sub" define-macro)
(begin-for-syntax (require-unqualified macros "../../compiler/macros.sub"))
(provide one two)
(define-macro (one stx) #'1)
(define-macro (two stx) #`(+ (one) (one)))
