;; A type whose fields are named as an interface's references are: %type, %info, %quote.
(provide make-tagged tagged-sum)

(type tagged (struct (field %type (ref null tagged)) (field %info i32) (field %quote i32)))

(func (make-tagged [a i32] [b i32]) -> (ref tagged) (struct.new tagged (ref.null tagged) a b))
(func (tagged-sum [t (ref tagged)]) -> i32 (i32.add (struct.get tagged %info t) (struct.get tagged %quote t)))
