;; Copied functions, and a pointer this module takes to one.
(provide add2 twice-add2 count add2-here)

(define counter i32 0)

(define (bump) (+= counter 1))
(define (count) -> i32 counter)

(define (add2 [a i32] [b i32]) #:copied -> i32
  (bump)
  (+ a b))

(define (twice-add2 [a i32]) #:copied -> i32 (add2 (add2 a a) a))

(define (add2-here) -> (fn (i32 i32) -> i32) add2)
