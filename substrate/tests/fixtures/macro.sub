;; define-macro, written with the kernel and the syntax module alone.

(provide define-macro)

(begin-for-syntax
  (require k kernel)
  (func (define-macro [stx i32]) -> i32
    (let* ([parts (k:syntax->list stx)]
           [head (k:syntax->list (k:cadr parts))])
      #`(begin
         (begin-for-syntax
           (func (#,(k:car head) [#,(k:cadr head) i32]) -> i32 #,@(k:cddr parts)))
         (define-syntax #,(k:car head) #,(k:car head))))))

(define-syntax define-macro define-macro)
