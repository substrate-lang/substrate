;; A test fixture: define-macro, written with the kernel alone:
;;
;;   (define-macro (name stx) body ...)
;;
;; defines a phase-1 function `name` from syntax to syntax and makes `name`
;; at this phase a macro that calls it. The two `name`s live at different
;; phases, so they do not collide. define-macro is itself defined this way:
;; a phase-1 function, then define-syntax.
;;
;; The body runs at phase 1 in the using module, so that module needs
;; (begin-for-syntax (require k kernel)) to use syntax functions there.

(provide define-macro)

(begin-for-syntax
  (require k kernel)
  (func (define-macro [stx eqref]) -> eqref
    (let* ([parts (k:syntax->list stx)]
           [head (k:syntax->list (k:cadr parts))])
      #`(begin
          (begin-for-syntax
            (func (#,(k:car head) [#,(k:cadr head) eqref]) -> eqref #,@(k:cddr parts)))
          (define-syntax #,(k:car head) #,(k:car head))))))

(define-syntax define-macro define-macro)
