;; define-macro, written with the kernel module alone.

(provide define-macro)

(begin-for-syntax
  (require-unqualified k "../../compiler/kernel.sub")
  (define (define-macro [stx datum]) -> datum
    (let* ([parts (syntax->list stx)] [head (syntax->list (cadr parts))])
      #`(begin
         (begin-for-syntax
           (define (#,(car head) [#,(cadr head) datum]) -> datum #,@(cddr parts)))
         (define-syntax #,(car head) #,(car head))))))

(define-syntax define-macro define-macro)
