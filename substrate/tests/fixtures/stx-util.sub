;; Helpers for transformers. Modules require this inside begin-for-syntax,
;; so it runs only while they compile; programs never load it.
(require k kernel)
(provide second third)
(func (second [stx eqref]) -> eqref (k:cadr (k:syntax->list stx)))
(func (third [stx eqref]) -> eqref (k:caddr (k:syntax->list stx)))
