;; (emit), whose literal names shift-n's helper, so it holds shift-n's scope.
(provide emit)
(begin-for-syntax
  (require k kernel)
  (require n "shift-n.sub" capture)
  (func (the-helper) -> i32 (capture))
  (func (emit [stx i32]) -> i32
    #`(begin-for-syntax
       (require print "../../compiler/print.sub")
       (print:write-int (#,(the-helper) 41))
       (print:newline))))
(define-syntax emit emit)
