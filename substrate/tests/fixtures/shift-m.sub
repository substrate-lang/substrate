;; (emit), whose literal names shift-n's helper, so it holds shift-n's scope.
(provide emit)
(begin-for-syntax
  (require-unqualified k "../../compiler/kernel.sub")
  (require n "shift-n.sub" capture)
  (define (the-helper) -> datum (capture))
  (define (emit [stx datum]) -> datum
    #`(begin-for-syntax
       (require print "../../compiler/substrate.sub")
       (print:write-int (#,(the-helper) 41))
       (print:newline))))
(define-syntax emit emit)
