;; For tests/order-a.sub and order-b.sub, which require this module and
;; its twin in either order: a module's bytes do not depend on what the
;; run compiled before it (spec 3.5). The literal's scopes are this
;; module's, and they are in the bytes.
(require-unqualified substrate "../../lib/substrate.sub")
(begin-for-syntax (require-unqualified substrate "../../lib/substrate.sub"))
(provide n-twice n-tag n-syntax)
(define-syntax (n-twice stx) (syntax-match stx [(_ e) #`(let ([t #,e]) (list t t 'n))]))
(struct n-tag (v))
(define n-syntax (quote-syntax (n-syntax has scopes)))
