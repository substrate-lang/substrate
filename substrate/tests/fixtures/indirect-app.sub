;; An application form for tests/app.sub: calling a variable calls the
;; function whose table index it holds, and calling a function calls it
;; directly. Modules use it by importing app as #%app.
(provide app)

(begin-for-syntax
  (require k kernel)
  ;; (#%app f arg ...)
  (func (app [stx eqref]) -> eqref
    (let* ([parts (k:cdr (k:syntax->list stx))]
           [f (k:car parts)]
           [args (k:cdr parts)])
      (if (i32.and (k:identifier? f) (ref.eq (k:identifier-binding-kind f) 'variable))
          #`(call-indirect (i32 -> i32) #,f #,@args)
          ;; This form has this module's scopes, so its #%app is the core one.
          #`(#,f #,@args)))))
(define-syntax app app)
