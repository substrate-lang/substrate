;; An #%app that calls a variable through the table and a function directly.
(provide app)

(begin-for-syntax
  (require-unqualified syntax "../../compiler/syntax.sub")
  (define (app [stx datum]) -> datum
    (let* ([parts (cdr (syntax->list stx))] [f (car parts)] [args (cdr parts)])
      (if (and (identifier? f) (== (identifier-binding-kind f) 'variable))
          #`(call-indirect (i32 -> i32) #,f #,@args)
          ;; This form has this module's scopes, so its #%app is the core one.
          #`(#,f #,@args)))))
(define-syntax app app)
