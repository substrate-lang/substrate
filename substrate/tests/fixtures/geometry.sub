;; A library module, as tests/fixtures/geometry.sub: functions, macros and
;; a static value for other modules to require.
(require print "../../compiler/print.sub")
(begin-for-syntax
  (require k kernel)
  (require util "stx-util.sub" second third))
(provide square show-square square-sum size-count)

(func (square [x i32]) -> i32 (i32.mul x x))

;; Not provided. Only this module's code, and its macros' expansions, can
;; reach it.
(func (print-labelled [label i32] [n i32])
  (print:write-int label) (print:write-byte 58) (print:write-int n) (print:newline))

;; (show-square e) => (print-labelled 1 (square e))
(begin-for-syntax
  (func (show-square [stx i32]) -> i32
    #`(print-labelled 1 (square #,(second stx)))))
(define-syntax show-square show-square)

;; (square-sum a b) => (i32.add (square a) (square b))
(begin-for-syntax
  (func (square-sum [stx i32]) -> i32
    #`(i32.add (square #,(second stx)) (square #,(third stx)))))
(define-syntax square-sum square-sum)

;; (size-count) expands to the length of a static list defined here.
(define-syntax sizes '(small medium large))
(begin-for-syntax
  (func (size-count [stx i32]) -> i32
    (k:datum->syntax stx (k:fixnum (k:length (k:syntax-local-value #'sizes))) stx)))
(define-syntax size-count size-count)
