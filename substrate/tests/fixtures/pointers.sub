;; A function, and the pointers this module takes to it and to the language's malloc, for another
;; module to compare with its own.
(provide triple triple-here malloc-here)

(define (triple [x i32]) -> i32 (* x 3))
(define (triple-here) -> (fn (i32) -> i32) triple)
(define (malloc-here) -> (fn (u32) -> (ptr void)) malloc)
