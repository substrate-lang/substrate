;; A #%linklet for tests/linklet-rewrite.sub, which takes it with
;; require-unqualified. It
;; adds a counter global, increments it before every function call, and
;; replaces the body of the module's (func (call-count) -> i32 ...) with a
;; read of the counter.
(provide #%linklet)

(begin-for-syntax
  (require k kernel)

  (func (named? [x eqref] [name eqref]) -> i32
    (if (k:identifier? x) (ref.eq (k:syntax-e x) name) 0))

  ;; x with (begin (set! n (+ n 1)) call) around every call in it.
  (func (rewrite [x eqref]) -> eqref
    (let ([l (k:syntax->list x)])
      (if (ref.is_null l) (return x))
      (if (k:null? l) (return x))
      (if (i32.or (named? (k:car l) 'quote) (named? (k:car l) 'quote-syntax)) (return x))
      (let ([new (k:syntax-rewrap x (rewrite-list l))])
        (if (named? (k:car l) '#%app)
            #`(begin (set! n (i32.add n 1)) #,new)
            new))))

  (func (rewrite-list [l eqref]) -> eqref
    (if (k:null? l) '() (k:cons (rewrite (k:car l)) (rewrite-list (k:cdr l)))))

  (func (rewrite-form [f eqref]) -> eqref
    (let ([l (k:syntax->list f)])
      (if (named? (k:car l) 'func)
          (let ([name (k:car (k:syntax->list (k:cadr l)))])
            (if (named? name 'call-count)
                (return #`(func (#,name) -> i32 n)))))
      (rewrite f)))

  (func (rewrite-forms [fs eqref]) -> eqref
    (if (k:null? fs) '() (k:cons (rewrite-form (k:car fs)) (rewrite-forms (k:cdr fs)))))

  ;; The hook: (#%linklet kind form ...) in, new forms out.
  (func (counter [stx eqref]) -> eqref
    (k:cons #'(global n (mut i32) 0) (rewrite-forms (k:cddr (k:syntax->list stx))))))
(define-syntax #%linklet counter)
