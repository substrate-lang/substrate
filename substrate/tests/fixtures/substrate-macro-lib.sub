;; A Substrate macro, (quad e), that expands into calls of this module's unprovided double.
(provide quad)

(define (double [x i32]) -> i32 (* x 2))

(begin-for-syntax
  (require-unqualified macros "../../compiler/macros.sub")
  (define (quad [env datum] [s datum]) -> datum
    (datum->syntax env `(double (double ,(cadr (syntax->list s)))) s)))

(define-syntax quad quad #'here)
