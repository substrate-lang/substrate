;; For tests/facts.sub: a definition, and a macro that lifts two facts
;; about a definition, a datum and syntax (spec 6.4, 6.5).
(require-unqualified substrate "../../lib/substrate.sub")
(begin-for-syntax (require-unqualified substrate "../../lib/substrate.sub"))
(provide thing2 lift-facts)
(define-syntax thing2 0)
(define-syntax (lift-facts stx)
  (syntax-match stx
    [(_ id)
     (syntax-local-lift-definition #`(#%fact #,id '(lifted)))
     (syntax-local-lift-definition #`(#%fact #,id #'(lifted syntax)))
     #'(begin)]))
