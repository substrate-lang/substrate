;; A library macro whose output is a begin, for err-spliced-location: the
;; function it splices returns an i32 but its body gives none.
(require-unqualified substrate "../../lib/substrate.sub")
(begin-for-syntax (require-unqualified substrate "../../lib/substrate.sub"))
(provide no-value)
(define-syntax (no-value stx)
  #'(begin (func (f) -> i32 (nop))))
