;; A language for tests/holes.sub (spec 6.4, 6.5). (answer) leaves a hole
;; in an expression, which #%linklet fills with a global it lifts: it
;; expands a use of the global at once, which it can because a lifted
;; definition is bound when it is lifted. (#%hole int), in a type, it
;; fills with i32.
(provide [#%linklet holes-linklet] answer)

(begin-for-syntax
  (require-unqualified substrate "../../lib/substrate.sub")

  (define (answer stx) #'(#%hole answer))

  (define lifted? #f)
  (define (the-answer)
    (unless lifted?
      (set! lifted? #t)
      (syntax-local-lift-definition #'(global the-answer i32 (i32.const 42))))
    (local-expand #'the-answer))

  ;; Syntax x with its holes filled.
  (define (fill x)
    (syntax-match x
      [('#%hole 'answer) (the-answer)]
      [('#%hole 'int) #'i32]
      [(part ...) (syntax-rewrap x (map fill part))]
      [_ x]))

  (define (holes-linklet stx)
    (syntax-match stx
      [(_ 'module form ...) (map fill form)]
      [(_ _ form ...) form])))

(define-syntax answer answer)
(define-syntax holes-linklet holes-linklet)
