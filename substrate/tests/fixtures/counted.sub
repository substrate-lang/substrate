;; A language whose #%module-begin defines forms, the number of forms it is given.

(provide #%module-begin)

(begin-for-syntax
  (require k kernel)
  (func (module-begin [stx i32]) -> i32
    (let ([forms (k:cdr (k:syntax->list stx))])
      #`(begin (global #,(k:datum->syntax stx 'forms stx) i32 #,(k:datum->syntax #'here (k:fixnum (k:length forms)) '#f))
               #,@forms))))

(define-syntax #%module-begin module-begin)
