;; A language whose #%module-begin defines forms, the number of forms it is given.

(provide #%module-begin)

(begin-for-syntax
  (require-unqualified k "../../compiler/syntax.sub")
  (define (module-begin [stx datum]) -> datum
    (let ([forms (cdr (syntax->list stx))])
      #`(begin (global #,(datum->syntax stx 'forms stx) i32 #,(datum->syntax #'here (fixnum (length forms)) 0))
               #,@forms))))

(define-syntax #%module-begin module-begin)
