;; A language whose #%module-begin defines forms, the number of forms it is given. The module has
;; Substrate's memory and table, as Substrate's code there needs.

(provide #%module-begin)

;; The require's path is relative to this file, where it is written.
(begin-for-syntax
  (require-unqualified macros "../../compiler/macros.sub")
  (define (module-begin [stx datum]) -> datum
    (let ([forms (cdr (syntax->list stx))])
      #`(begin #,(core-syntax #'here '(begin (require %substrate "../../compiler/substrate.sub")
                                             (memory from %substrate) (table from %substrate))
                              #'here)
               (define #,(datum->syntax stx 'forms stx) i32 #,(datum->syntax #'here (fixnum (length forms)) 0))
               #,@forms))))

(define-syntax #%module-begin module-begin)
