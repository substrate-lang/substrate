;; Inline functions for tests/inline.sub. Their bodies use this module's
;; global and functions, which a module that inlines them imports.
(provide add2 count clamp fresh-box yes-or-no)

(type box (struct (field v (mut i32))))
(global counter (mut i32) 0)

(func (bump [n i32]) (set! counter (i32.add counter n)))
(func (count) -> i32 counter)

(func (add2 [a i32] [b i32]) #:inline -> i32
  (bump 1)
  (let ([s (i32.add a b)]) s))

;; A body with a block and returns.
(func (clamp [x i32] [lo i32] [hi i32]) #:inline -> i32
  (if (i32.lt_s x lo) (return lo))
  (block done
    (br-if done (i32.le_s x hi))
    (return hi))
  x)

;; Its body is a (ref box); its declared result is an eqref.
(func (fresh-box [v i32]) #:inline -> eqref (struct.new box v))

(func (yes-or-no [x i32]) #:inline -> eqref (if x 'yes 'no))
