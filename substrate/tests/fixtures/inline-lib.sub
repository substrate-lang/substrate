;; Inline functions whose bodies use this module's global and functions.
(provide add2 count clamp yes-or-no)
(require k kernel)
(memory from k)

(global counter (mut i32) 0)

(func (bump [n i32]) (set! counter (i32.add counter n)))
(func (count) -> i32 counter)

(func (add2 [a i32] [b i32]) #:inline -> i32
  (bump 1)
  (let ([s (i32.add a b)]) s))

(func (clamp [x i32] [lo i32] [hi i32]) #:inline -> i32
  (if (i32.lt_s x lo) (return lo))
  (block done
    (br-if done (i32.le_s x hi))
    (return hi))
  x)

(func (yes-or-no [x i32]) #:inline -> i32 (if x 'yes 'no))
