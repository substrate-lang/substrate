;; A tiny language for tests/require-unqualified.sub, meant to be required
;; unqualified. It renames on provide: print's write-int as show, and
;; indirect-app's app as #%app.
(require pr "../../lib/print.sub" write-int newline)
(require ind "indirect-app.sub" app)
(provide [show write-int] newline [#%app app])
