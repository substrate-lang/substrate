;; For tests/facts.sub: a language whose #%linklet drops each fact
;; (#%fact x (drop ...)), returns a new one and lifts another, and
;; rebuilds each func, which redefines it (spec 6.5).
(require-unqualified substrate "../../lib/substrate.sub")
(begin-for-syntax (require-unqualified substrate "../../lib/substrate.sub") (require k kernel))
(provide [#%linklet hook] thing2)
(define-syntax thing2 0)
(begin-for-syntax
  (define (hook stx)
    (syntax-match stx
      [(_ 'module form ...)
       (k:syntax-local-lift-definition #'(#%fact thing2 (lifted)))
       (append (map (lambda (f) (syntax-match f [('func . _) (datum->syntax f (syntax-e f) f)] [_ f]))
                    (filter (lambda (f) (syntax-match f [('#%fact _ ('drop . _)) #f] [_ #t])) form))
               (list #'(#%fact thing2 (returned))))]
      [(_ _ form ...) form])))
(define-syntax hook hook)
