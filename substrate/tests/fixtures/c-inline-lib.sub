;; Inline functions in the C-like Lisp, for tests/base/inline.sub: each
;; call from another module that shares the memory is compiled as the
;; function's body (spec 5.2).
(require-unqualified base "../../compiler/base/base.sub")
(provide counter point bump! clamp sum-to dist2 greeting twice-clamped)
(memory from base)
(table from base)

(struct counter [n i32])
(struct point [x i32] [y i32])

;; Memory through a pointer.
(define (bump! [c (ptr counter)] [by i32]) #:inline (+= (-> c n) by))

;; An early return.
(define (clamp [x i32] [lo i32] [hi i32]) #:inline -> i32
  (when (< x lo) (return lo))
  (if (> x hi) hi x))

;; A loop.
(define (sum-to [n i32]) #:inline -> i32
  (let ([s i32 0])
    (for ([i i32 1]) (<= i n) (+= i 1) (+= s i))
    s))

;; A struct local, in the stack frame.
(define (dist2 [x i32] [y i32]) #:inline -> i32
  (let ([p point])
    (set! (-> (& p) x) x)
    (set! (-> (& p) y) y)
    (+ (* (-> (& p) x) (-> (& p) x)) (* (-> (& p) y) (-> (& p) y)))))

;; A string literal, the defining module's.
(define (greeting) #:inline -> (ptr u8) "hello")

;; An inline function that calls another.
(define (twice-clamped [x i32]) #:inline -> i32 (* 2 (clamp x 0 10)))
