;; A C macro, (quad e), that expands into calls of this module's unprovided double.
(require-unqualified base "../../compiler/base/base.sub")
(provide quad)

(define (double [x i32]) -> i32 (* x 2))

(begin-for-syntax
  (require-unqualified base "../../compiler/base/base.sub")
  (require-unqualified kd "../../compiler/kernel.sub")
  (require k kernel)
  (define (quad [env datum] [s datum]) -> datum
    (datum->syntax env `(double (double ,(cadr (syntax->list s)))) s)))

(define-syntax quad (k:make-transformer (func-index quad) #'here))
