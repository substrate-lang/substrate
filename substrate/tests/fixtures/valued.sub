;; A kernel function with a value, for tests/function-values.sub: its name,
;; used as an expression, is the global the-counter (spec 5.2).
(provide counter next)
(type cell (struct (field n (mut i32))))
(global the-counter (ref cell) (struct.new cell 0))
(func (counter) #:value the-counter -> i32 (struct.get cell n the-counter))
(func (next) (struct.set cell n the-counter (i32.add (struct.get cell n the-counter) 1)))
