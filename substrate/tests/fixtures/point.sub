;; A type and a function with the same name, point: types and values are
;; separate namespaces (spec 6.1), and provide exports both.
(provide point point-x)

(type point (struct (field x i32) (field y i32)))

(func (point [x i32] [y i32]) -> (ref point) (struct.new point x y))

(func (point-x [p (ref point)]) -> i32 (struct.get point x p))
