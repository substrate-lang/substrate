;; A type function for tests/type-function.sub, Zig-style: (tuple T n),
;; for a type name T and a number n below 10, is a struct type with fields
;; f0 ... of type T. The first use in a module lifts its declaration into
;; the module; later uses return the same type, since declared types are
;; compared by declaration (spec 5.1).
(provide tuple)

(begin-for-syntax
  (require s syntax)

  ;; ((key . name) ...): the tuple types declared in the module being
  ;; compiled. A key is a symbol like tuple-i32-three.
  (global declared (mut eqref) '())

  (func (lookup [key eqref] [l eqref]) -> eqref
    (if (s:null? l) (return '#f))
    (if (ref.eq (s:car (s:car l)) key) (return (s:cdr (s:car l))))
    (lookup key (s:cdr l)))

  (func (nth [l eqref] [i i32]) -> eqref
    (if (i32.eqz i) (s:car l) (nth (s:cdr l) (i32.sub i 1))))

  ;; (field f<i> T) ... for i from i to n - 1.
  (func (fields [t eqref] [i i32] [n i32]) -> eqref
    (if (i32.ge_s i n) (return '()))
    (s:cons #`(field #,(s:datum->syntax #'here (nth '(f0 f1 f2 f3 f4 f5 f6 f7 f8 f9) i)) #,t)
            (fields t (i32.add i 1) n)))

  ;; (tuple T n)
  (func (tuple [stx eqref]) -> eqref
    (let* ([parts (s:syntax->list stx)]
           [t (s:cadr parts)]
           [n (s:fixnum-value (s:syntax-e (s:caddr parts)))]
           [key (s:symbol-append (s:symbol-append 'tuple- (s:syntax-e t))
                                 (s:symbol-append '- (nth '(zero one two three four five six seven eight nine) n)))]
           [known (lookup key declared)])
      (if (i32.eqz (ref.is_null known)) (return known))
      (let* ([name (s:datum->syntax #'here key)]
             [lifted (s:lift-definition #`(type #,name (struct #,@(fields t 0 n))))])
        ;; Later uses return the name as declared, which has this use's
        ;; introduction scope. The kernel adds theirs, and it still refers
        ;; to the declaration.
        (set! declared (s:cons (s:cons key (s:cadr (s:syntax->list lifted))) declared))
        name))))
(define-syntax tuple tuple)
