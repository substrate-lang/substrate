;; A type function: (tuple T n) is a struct of n fields of type T, declared once a module.
(provide tuple)

(begin-for-syntax
  (require k kernel)

  (global declared (mut i32) '())

  (func (lookup [key i32] [l i32]) -> i32
    (if (k:null? l) (return 0))
    (if (i32.eq (k:car (k:car l)) key) (return (k:cdr (k:car l))))
    (lookup key (k:cdr l)))

  (func (nth [l i32] [i i32]) -> i32
    (if (i32.eqz i) (k:car l) (nth (k:cdr l) (i32.sub i 1))))

  (func (fields [t i32] [i i32] [n i32]) -> i32
    (if (i32.ge_s i n) (return '()))
    (k:cons #`(field #,(k:datum->syntax #'here (nth '(f0 f1 f2 f3 f4 f5 f6 f7 f8 f9) i) t) #,t)
            (fields t (i32.add i 1) n)))

  (func (tuple [stx i32]) -> i32
    (let* ([parts (k:syntax->list stx)]
           [t (k:cadr parts)]
           [n (k:fixnum-value (k:syntax-e (k:caddr parts)))]
           [key (k:symbol-append (k:symbol-append 'tuple- (k:syntax-e t))
                                 (k:symbol-append '- (nth '(zero one two three four five six seven eight nine) n)))]
           [known (lookup key declared)])
      ;; The name is kept as the module sees it, and a use puts it in its
      ;; output as the macro sees it.
      (if (i32.ne known 0) (return (k:syntax-local-introduce known)))
      (let ([name (k:datum->syntax #'here key stx)])
        (drop (k:syntax-local-lift-definition #`(type #,name (struct #,@(fields t 0 n)))))
        (set! declared (k:cons (k:cons key (k:syntax-local-introduce name)) declared))
        name))))
(define-syntax tuple tuple)
