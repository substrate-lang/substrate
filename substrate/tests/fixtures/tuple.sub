;; A type function for tests/type-function.sub, Zig-style: (tuple T n),
;; for a type name T and a number n below 10, is a struct type with fields
;; f0 ... of type T. The first use in a module lifts its declaration into
;; the module, and later uses return its name, so the module declares it
;; once. A declaration in another module is the same type, since types are
;; identified by structure (spec 5.1).
(provide tuple)

(begin-for-syntax
  (require k kernel)

  ;; ((key . name) ...): the tuple types declared in the module being
  ;; compiled. A key is a symbol like tuple-i32-three.
  (global declared (mut eqref) '())

  (func (lookup [key eqref] [l eqref]) -> eqref
    (if (k:null? l) (return '#f))
    (if (ref.eq (k:car (k:car l)) key) (return (k:cdr (k:car l))))
    (lookup key (k:cdr l)))

  (func (nth [l eqref] [i i32]) -> eqref
    (if (i32.eqz i) (k:car l) (nth (k:cdr l) (i32.sub i 1))))

  ;; (field f<i> T) ... for i from i to n - 1.
  (func (fields [t eqref] [i i32] [n i32]) -> eqref
    (if (i32.ge_s i n) (return '()))
    (k:cons #`(field #,(k:datum->syntax #'here (nth '(f0 f1 f2 f3 f4 f5 f6 f7 f8 f9) i) t) #,t)
            (fields t (i32.add i 1) n)))

  ;; (tuple T n)
  (func (tuple [stx eqref]) -> eqref
    (let* ([parts (k:syntax->list stx)]
           [t (k:cadr parts)]
           [n (k:fixnum-value (k:syntax-e (k:caddr parts)))]
           [key (k:symbol-append (k:symbol-append 'tuple- (k:syntax-e t))
                                 (k:symbol-append '- (nth '(zero one two three four five six seven eight nine) n)))]
           [known (lookup key declared)])
      (if (i32.eqz (ref.is_null known)) (return known))
      (let* ([name (k:datum->syntax #'here key stx)]
             [lifted (k:syntax-local-lift-definition #`(type #,name (struct #,@(fields t 0 n))))])
        ;; Later uses return the name as declared, which has this use's
        ;; introduction scope. The kernel adds theirs, and it still refers
        ;; to the declaration.
        (set! declared (k:cons (k:cons key (k:cadr (k:syntax->list lifted))) declared))
        name))))
(define-syntax tuple tuple)
