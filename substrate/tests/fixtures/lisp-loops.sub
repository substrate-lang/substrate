;; Fixture: macros written in the Lisp, exported to other modules. (while
;; test body ...) loops; (for x in list body ...) walks a list, checking
;; its in by binding.
(require-unqualified l "../../lib/lisp.sub")
(begin-for-syntax (require-unqualified l "../../lib/lisp.sub"))
(provide while for in)

(begin-for-syntax
  ;; A phase-1 Lisp function for the macros below. Phase-1 code is compiled
  ;; as it is reached, so it comes first.
  (define (cddddr* l) (cdr (cdr (cdr (cdr l))))))

(define-syntax (while stx)
  (let ([parts (syntax->list stx)])
    #`(let loop () (when #,(cadr parts) #,@(cddr parts) (loop)))))

;; in means nothing outside for; it is bound so for can compare it.
(define-syntax (in stx) (raise-syntax-error #f "in is used only in for" stx))

(define-syntax for
  (lambda (stx)
    (let ([parts (syntax->list stx)])
      (unless (and (>= (length parts) 4) (free-identifier=? (caddr parts) #'in))
        (raise-syntax-error #f "expected (for x in list body ...)" stx))
      #`(for-each (lambda (#,(cadr parts)) #,@(cddddr* parts)) #,(cadddr parts)))))
