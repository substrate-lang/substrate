;; A literal form for tests/datum.sub: literals are syntax-library values
;; instead of wasm numbers. Modules use it by importing datum as #%datum.
(provide datum)

(begin-for-syntax
  (require s syntax)
  ;; (#%datum literal) => 'literal
  (func (datum [stx eqref]) -> eqref
    #`(quote #,(s:cadr (s:syntax->list stx)))))
(define-syntax datum datum)
