;; A module pass for tests/err-module-pass.sub that adds ill-typed code.
(provide bad-pass)
(begin-for-syntax
  (require s syntax)
  (func (add-bad [stx eqref]) -> eqref
    (s:cons #'(global bad (mut i32) (quote x)) (s:syntax->list stx)))
  (func (bad-pass [stx eqref]) -> eqref #'(module-pass add-bad)))
(define-syntax bad-pass bad-pass)
