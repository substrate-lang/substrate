;; A #%linklet for tests/err-linklet-removed.sub: it removes the function
;; named helper.
(provide #%linklet)
(begin-for-syntax
  (require k kernel)
  ;; Remove every form defining a function named helper.
  (func (keep [fs eqref]) -> eqref
    (if (k:null? fs) (return '()))
    (let ([l (k:syntax->list (k:car fs))])
      (if (i32.and (ref.eq (k:syntax-e (k:car l)) 'func)
                   (k:pair? (k:syntax->list (k:cadr l))))
          (if (ref.eq (k:syntax-e (k:car (k:syntax->list (k:cadr l)))) 'helper)
              (return (keep (k:cdr fs)))))
      (k:cons (k:car fs) (keep (k:cdr fs)))))
  ;; (#%linklet kind form ...) in, its forms without helper out.
  (func (dropper [stx eqref]) -> eqref (keep (k:cddr (k:syntax->list stx)))))
(define-syntax #%linklet dropper)
