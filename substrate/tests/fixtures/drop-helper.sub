;; A #%linklet for tests/err-linklet-removed.sub: it removes the function
;; named helper.
(provide #%linklet)
(begin-for-syntax
  (require s syntax)
  ;; Remove every form defining a function named helper.
  (func (keep [fs eqref]) -> eqref
    (if (s:null? fs) (return '()))
    (let ([l (s:syntax->list (s:car fs))])
      (if (i32.and (ref.eq (s:syntax-e (s:car l)) 'func)
                   (s:pair? (s:syntax->list (s:cadr l))))
          (if (ref.eq (s:syntax-e (s:car (s:syntax->list (s:cadr l)))) 'helper)
              (return (keep (s:cdr fs)))))
      (s:cons (s:car fs) (keep (s:cdr fs)))))
  ;; (#%linklet kind form ...) in, its forms without helper out.
  (func (dropper [stx eqref]) -> eqref (keep (s:cddr (s:syntax->list stx)))))
(define-syntax #%linklet dropper)
