;; A macro makes an identifier from a local variable's, its properties
;; with it, around the name of a global: it means the global, since in
;; fully expanded code only a local variable's identifier has its binding
;; (spec 2.3).
(require-unqualified substrate "../lib/substrate.sub")
(begin-for-syntax (require-unqualified substrate "../lib/substrate.sub") (require k kernel))
(define g 5)
(define-syntax (m stx)
  (syntax-match (local-expand #'(let ([x 1]) x))
    [(_ (b) x) (k:syntax-rewrap x 'g)]))
(define (main) (write (m)) (newline))
