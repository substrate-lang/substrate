;; Globals: immutable unless (mut type); an initializer that is not constant runs at start.
(require print "../compiler/print.sub" write-int newline)

(global answer i32 (i32.add 40 2))
(global counter (mut i32) (square 3))

(func (square [x i32]) -> i32 (i32.mul x x))

(func (main)
  (write-int answer) (newline)
  (set! counter (i32.add counter 1))
  (write-int counter) (newline))
