;; A module required at two phases (spec 6.1): its macros work at both.
(require print "../lib/print.sub")
(require twice "modules/twice.sub")
(begin-for-syntax
  (require print "../lib/print.sub")
  (require twice "modules/twice.sub")
  (print:write-int (twice:two))
  (print:newline))
(func (main) (print:write-int (twice:two)) (print:newline))
