;; A module required at two phases: its macros work at both.
(require print "../compiler/substrate.sub")
(require twice "fixtures/twice.sub")
(begin-for-syntax
  (require print "../compiler/substrate.sub")
  (require twice "fixtures/twice.sub")
  (print:write-int (twice:two))
  (print:newline))
(func (main) (print:write-int (twice:two)) (print:newline))
