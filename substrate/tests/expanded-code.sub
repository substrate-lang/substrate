;; A module's code is built as the compiler's input, and as fully expanded
;; code, syntax, where a macro asks for it (spec 6.4): the two must mean
;; the same. Each function here is written once and made twice (twice):
;; as it is, and with its body expanded to syntax (local-expand) and that
;; expanded again. Each line is one function's result both ways.
(require print "../lib/print.sub" write-int newline)
(require k kernel)
(memory from print)
(table 4)

(begin-for-syntax
  (require-unqualified substrate "../lib/substrate.sub")
  (require k kernel)
  (define (via-syntax stx) (syntax-match stx [(_ e) (k:local-expand e)]))
  ;; (twice (f [x t] ...) -> r body ...): f, and f/syntax, whose body goes
  ;; through via-syntax.
  (define (twice stx)
    (syntax-match stx
      [(_ (f p ...) arrow r body ...)
       (let ([g (datum->syntax f (string->symbol (format "~a/syntax" (syntax-e f))) f)])
         #`(begin (func (#,f #,@p) #,arrow #,r #,@body)
                  (func (#,g #,@p) #,arrow #,r (via-syntax (begin #,@body)))))])))
(define-syntax via-syntax via-syntax)
(define-syntax twice twice)

(type point (struct (field px (mut i32)) (field py i32)))
(type ints (array (mut i32)))
(type unop (func (i32 -> i32)))
(tag boom (i32))
(global g (mut i32) 10)
(data msg 3000 "hello")

(func (dbl [x i32]) -> i32 (type unop) (i32.mul x 2))
(func (inc [x i32]) #:inline -> i32 (i32.add x 1))
(func (apply-to [f (ref (closure (i32 -> i32)))] [x i32]) -> i32 (f x))

(twice (arith [x i32]) -> i32 (i32.add (i32.mul x 3) 7))
(twice (locals [x i32]) -> i32
  (let* ([a x] [b (i32.add a 1)]) (set! a (i32.mul a b)) (i32.sub a b)))
;; A literal before the branch that gives its type.
(twice (branches [x i32]) -> i32
  (i32.wrap_i64 (i64.add (if x 5 (i64.extend_i32_s x)) (if (i32.eqz x) 6 7))))
(twice (loops [x i32]) -> i32
  (let ([i 0] [s 0])
    (block done
      (loop next
        (br-if done (i32.gt_s i x))
        (set! s (i32.add s i))
        (set! i (i32.add i 1))
        (br next)))
    s))
(twice (early [x i32]) -> i32 (if (i32.lt_s x 3) (return 100)) (i32.add x 1))
(twice (inlined [x i32]) -> i32 (inc (inc x)))
;; Known functions, a captured variable that is assigned, and a closure as
;; a value.
(twice (closures [x i32]) -> i32
  (let ([n x])
    (let ([f (lambda ([y i32]) -> i32 (i32.add y n))])
      (set! n (i32.add n 1))
      (f 10))))
(twice (counter [x i32]) -> i32
  (let ([count x])
    (let ([bump (lambda () -> i32 (set! count (i32.add count 1)) count)])
      (drop (bump))
      (bump))))
(twice (values [x i32]) -> i32 (apply-to (lambda ([y i32]) -> i32 (i32.mul y x)) 3))
(twice (exceptions [x i32]) -> i32
  (try ([catch boom (v) (i32.add v 1)])
    (if (i32.gt_s x 2) (throw boom x))
    0))
(twice (structs [x i32]) -> i32
  (let ([p (struct.new point x 5)])
    (struct.set point px p (i32.add (struct.get point px p) 1))
    (i32.add (struct.get point px p) (struct.get point py p))))
(twice (arrays [x i32]) -> i32
  (let ([a (array.new ints 0 4)])
    (array.set ints a 2 x)
    (i32.add (array.get ints a 2) (array.len a))))
(twice (refs [x i32]) -> i32
  (let ([v eqref (ref.i31 x)])
    (if (ref.test (ref i31) v) (i31.get_s (ref.cast (ref i31) v)) -1)))
(twice (memory-ops [x i32]) -> i32
  (i32.store 4096 x)
  (i32.store 4100 7)
  (i32.add (i32.load 4096) (i32.load 4096 4)))
(twice (tables [x i32]) -> i32 (call-indirect (i32 -> i32) (func-index dbl) x))
(twice (func-refs [x i32]) -> i32 (call-ref unop (ref.func dbl) x))
(twice (misc [x i32]) -> i32
  (nop)
  (drop x)
  (if (i32.lt_s x -100) (unreachable))
  (select x 9 (i32.eqz x)))
(twice (quoted [x i32]) -> i32
  (i32.add (i32.add (k:length '(a b c)) (k:length `(1 ,(k:fixnum x) 3 4)))
           (k:length (k:syntax->list (quote-syntax (s t))))))
(twice (data-refs [x i32]) -> i32 (i32.add (i32.load8_u (data-address msg)) (data-size msg)))
(twice (globals [x i32]) -> i32 (set! g x) (i32.add g 1))

(func (show [a i32] [b i32]) (write-int a) (print:write-byte 32) (write-int b) (newline))

(func (main)
  (show (arith 4) (arith/syntax 4))
  (show (locals 4) (locals/syntax 4))
  (show (branches 0) (branches/syntax 0))
  (show (branches 3) (branches/syntax 3))
  (show (loops 10) (loops/syntax 10))
  (show (early 1) (early/syntax 1))
  (show (early 5) (early/syntax 5))
  (show (inlined 4) (inlined/syntax 4))
  (show (closures 4) (closures/syntax 4))
  (show (counter 4) (counter/syntax 4))
  (show (values 4) (values/syntax 4))
  (show (exceptions 1) (exceptions/syntax 1))
  (show (exceptions 5) (exceptions/syntax 5))
  (show (structs 4) (structs/syntax 4))
  (show (arrays 4) (arrays/syntax 4))
  (show (refs 4) (refs/syntax 4))
  (show (memory-ops 4) (memory-ops/syntax 4))
  (show (tables 4) (tables/syntax 4))
  (show (func-refs 4) (func-refs/syntax 4))
  (show (misc 0) (misc/syntax 0))
  (show (misc 4) (misc/syntax 4))
  (show (quoted 4) (quoted/syntax 4))
  (show (data-refs 4) (data-refs/syntax 4))
  (show (globals 4) (globals/syntax 4)))
