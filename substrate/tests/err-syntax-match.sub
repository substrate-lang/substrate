;; A syntax-match that no clause matches is a syntax error blamed on its
;; subject: "expected" and the patterns, a _ at a pattern's head written as
;; the subject's head, as tests/err-syntax-match.sub.
(begin-for-syntax
  (require k kernel)
  (require sm "../compiler/c/syntax-match.sub" syntax-match _ ... ?)
  (func (swap! [stx i32]) -> i32
    (syntax-match stx
      [(_ (? k:identifier? a) (? k:identifier? b)) #`(let ([t #,a]) (set! #,a #,b) (set! #,b t))])))
(define-syntax swap! swap!)
(func (run) (let ([x 1]) (swap! x 2)))
(func (main) (run))
