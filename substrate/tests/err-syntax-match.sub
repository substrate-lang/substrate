;; A syntax-match no clause matches is an error, blamed on its subject, with the patterns.
(begin-for-syntax
  (require k kernel)
  (require sm "../compiler/syntax-match.sub" syntax-match _ ... ?)
  (func (swap! [stx i32]) -> i32
    (syntax-match stx
      [(_ (? k:identifier? a) (? k:identifier? b)) #`(let ([t #,a]) (set! #,a #,b) (set! #,b t))])))
(define-syntax swap! swap!)
(func (run) (let ([x 1]) (swap! x 2)))
(func (main) (run))
