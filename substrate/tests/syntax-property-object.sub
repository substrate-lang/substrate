;; A syntax property can hold any datum, which stays on the syntax a macro returns.
(require print "../compiler/print.sub" write-int newline)
(begin-for-syntax
  (require k kernel)
  (func (boxed [stx i32]) -> i32
    (k:syntax-property-set (k:cadr (k:syntax->list stx)) 'box '(42)))
  (func (unbox-of [stx i32]) -> i32
    (let ([e (k:local-expand (k:cadr (k:syntax->list stx)))])
      (k:datum->syntax stx (k:car (k:syntax-property (found e) 'box)) stx)))
  (func (found [e i32]) -> i32
    (if (i32.eqz (k:syntax-property e 'box)) (k:cadr (k:syntax->list e)) e)))
(define-syntax boxed boxed)
(define-syntax unbox-of unbox-of)

(func (main) (write-int (unbox-of (boxed 1))) (newline))
