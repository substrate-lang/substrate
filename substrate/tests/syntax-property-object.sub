;; A syntax property can hold a GC object, which stays with the syntax a
;; macro returns: here a struct a macro puts on its output, which another
;; macro reads back from the expansion.
(require print "../lib/print.sub" write-int newline)
(begin-for-syntax
  (require k kernel)
  (type box (struct (field v i32)))
  ;; (boxed e): e, with a box of 42 in its property box.
  (func (boxed [stx eqref]) -> eqref
    (k:syntax-property-set (k:cadr (k:syntax->list stx)) 'box (struct.new box 42)))
  ;; (unbox-of e): the number in the box on what e expands to.
  (func (unbox-of [stx eqref]) -> eqref
    (let ([e (k:local-expand (k:cadr (k:syntax->list stx)))])
      (k:datum->syntax stx (k:fixnum (struct.get box v (ref.cast (ref box) (k:syntax-property (found e) 'box)))) stx)))
  ;; The syntax in e that has a box property: e, or its second part.
  (func (found [e eqref]) -> eqref
    (if (ref.is_null (k:syntax-property e 'box)) (k:cadr (k:syntax->list e)) e)))
(define-syntax boxed boxed)
(define-syntax unbox-of unbox-of)

(func (main) (write-int (unbox-of (boxed 1))) (newline))
