;; free-identifier=? compares what identifiers mean in both namespaces, and
;; identifier-binding-kind reports a name bound only as a type (spec 2.3).
;; other-box-same? lifts a box type of its own, with a different field
;; type from this module's box.
(require print "../lib/print.sub" write-int newline)
(require wd "../lib/write-datum.sub" write-datum)
(begin-for-syntax (require s syntax))

(type box (struct (field v i32)))

;; (same-as-box? id) => 1 if id means what this module's box means.
(begin-for-syntax
  (func (same-as-box? [stx eqref]) -> eqref
    (s:datum->syntax stx (s:fixnum (s:free-identifier=? (s:cadr (s:syntax->list stx)) #'box)) stx))
  ;; (other-box-same?) compares a box this macro introduces, bound to its
  ;; own lifted type, with the module's box.
  (func (other-box-same? [stx eqref]) -> eqref
    (let ([lifted (s:syntax->list (s:syntax-local-lift-definition #'(type box (struct (field w i64)))))])
      (s:datum->syntax stx (s:fixnum (s:free-identifier=? (s:cadr lifted) #'box)) stx)))
  (func (kind-of [stx eqref]) -> eqref
    #`(quote #,(s:identifier-binding-kind (s:cadr (s:syntax->list stx))))))
(define-syntax same-as-box? same-as-box?)
(define-syntax other-box-same? other-box-same?)
(define-syntax kind-of kind-of)

(func (main)
  (write-int (same-as-box? box)) (newline)
  (write-int (other-box-same?)) (newline)
  (write-datum (kind-of box)) (newline)
  (write-datum (kind-of main)) (newline))
