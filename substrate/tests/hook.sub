;; The instantiate hook (spec 4), called from kernel code: a module is
;; built as bytes in this module's memory, instantiated by the host, and
;; called through this module's table. This is the path the self-hosted
;; compiler will use.

(include "../lib/print.sub")

(import host-instantiate "host" "instantiate" (i32 i32 i32 i32 -> i32))
(import host-export-index "host" "export_index" (i32 i32 i32 i32 -> i32))
(import host-error-message "host" "error_message" (i32 i32 -> i32))

(table 1)

;; (module (func (export "answer") (result i32) i32.const 42))
(data answer-module 1024
  "\x00;asm\x01;\x00;\x00;\x00;\x01;\x05;\x01;\x60;\x00;\x01;\x7f;\x03;\x02;\x01;\x00;"
  "\x07;\x0a;\x01;\x06;answer\x00;\x00;\x0a;\x06;\x01;\x04;\x00;\x41;\x2a;\x0b;")
(data dyn-name 1100 "dyn")
(data answer-field 1104 "answer")
(data bad-name 1112 "bad")
(data junk 1116 "\x00;asm\x01;\x00;\x00;\x00;\x01;")
(data error-label 1128 "error: ")

(func (main)
  (if (host-instantiate (data-address dyn-name) (data-size dyn-name)
                        (data-address answer-module) (data-size answer-module))
      (return))
  (let ([index (host-export-index (data-address dyn-name) (data-size dyn-name)
                                  (data-address answer-field) (data-size answer-field))])
    (write-int (call-indirect (-> i32) index))
    (newline))
  ;; A module that fails to validate is reported, not fatal.
  (if (host-instantiate (data-address bad-name) (data-size bad-name)
                        (data-address junk) (data-size junk))
      (let ([n (host-error-message 2048 64)])
        (write-bytes (data-address error-label) (data-size error-label))
        (write-bytes 2048 (select n 7 (i32.lt_s n 7)))
        (newline))))
