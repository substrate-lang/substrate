;; The instantiate hook (spec 4), called from kernel code: a module is
;; built as bytes in memory, instantiated by the host, and called through
;; the shared table. This is the path the self-hosted compiler will use.

(import host-instantiate "host" "instantiate" (i32 i32 i32 i32 -> i32))
(import host-export-index "host" "export_index" (i32 i32 i32 i32 -> i32))
(import host-error-message "host" "error_message" (i32 i32 -> i32))

;; (module (func (export "answer") (result i32) i32.const 42))
(global answer-module i32
  "\x00;asm\x01;\x00;\x00;\x00;\x01;\x05;\x01;\x60;\x00;\x01;\x7f;\x03;\x02;\x01;\x00;\x07;\x0a;\x01;\x06;answer\x00;\x00;\x0a;\x06;\x01;\x04;\x00;\x41;\x2a;\x0b;")

;; Raw pointer and length of a string's bytes.
(func (bytes [s i32]) -> i32 (i32.add s 4))

(func (main)
  (let ([name "dyn"] [field "answer"])
    (if (host-instantiate (bytes name) (heap-length name) (bytes answer-module) (heap-length answer-module))
        (begin (display "instantiate failed") (newline) (return)))
    (let ([index (host-export-index (bytes name) (heap-length name) (bytes field) (heap-length field))])
      (write-int (call-indirect (-> i32) index)) (newline)))
  ;; A module that fails to validate is reported, not fatal.
  (let ([name "bad"] [junk "\x00;asm\x01;\x00;\x00;\x00;\x01;"])
    (if (host-instantiate (bytes name) (heap-length name) (bytes junk) (heap-length junk))
        (let ([n (host-error-message 2048 64)])
          (display "error: ")
          (write-bytes 2048 (select n 7 (i32.lt_s n 7)))
          (newline)))))
