;; The instantiate hook from kernel code: modules built as bytes, instantiated and called.

(require print "../compiler/print.sub" write-int newline write-bytes)
(require k kernel)
(memory from k)

(import host-instantiate "host" "instantiate" (i32 i32 i32 i32 i32 i32 i32 -> i32))
(import host-export-index "host" "export_index" (i32 i32 i32 i32 -> i32))
(import host-error-message "host" "error_message" (i32 i32 -> i32))

(table 1)

;; Strings go to the host as their bytes and length; a map of 0 is none.
(func (instantiate [name i32] [bytes i32] [map i32]) -> i32
  (host-instantiate (k:string-bytes name) (k:string-length name) (k:string-bytes bytes) (k:string-length bytes)
                    (if map (k:string-bytes map) 0) (if map (k:string-length map) 0) 0))

(func (export-index [name i32] [field i32]) -> i32
  (host-export-index (k:string-bytes name) (k:string-length name) (k:string-bytes field) (k:string-length field)))

(func (write-string [s i32]) (write-bytes (k:string-bytes s) (k:string-length s)))

(func (joined [parts i32]) -> i32
  (if (k:null? (k:cdr parts)) (k:car parts) (k:string-append (k:car parts) (joined (k:cdr parts)))))

;; (module (func (export "answer") (result i32) i32.const 42))
(global answer-module (mut i32)
  (joined '("\x00;asm\x01;\x00;\x00;\x00;\x01;\x05;\x01;\x60;\x00;\x01;\x7f;\x03;\x02;\x01;\x00;"
            "\x07;\x0a;\x01;\x06;answer\x00;\x00;\x0a;\x06;\x01;\x04;\x00;\x41;\x2a;\x0b;")))

;; (module (import "dyn@0+0" "answer" (func (result i32)))
;;         (func (export "twice") (result i32) call 0 call 0 i32.add))
(global twice-module (mut i32)
  (joined '("\x00;asm\x01;\x00;\x00;\x00;"
            "\x01;\x05;\x01;\x60;\x00;\x01;\x7f;"
            "\x02;\x12;\x01;\x07;dyn@0+0\x06;answer\x00;\x00;"
            "\x03;\x02;\x01;\x00;"
            "\x07;\x09;\x01;\x05;twice\x00;\x01;"
            "\x0a;\x09;\x01;\x07;\x00;\x10;\x00;\x10;\x00;\x6a;\x0b;")))

;; (module (tag $t) (func $s (throw $t)) (start $s))
(global thrower-module (mut i32)
  (joined '("\x00;asm\x01;\x00;\x00;\x00;"
            "\x01;\x04;\x01;\x60;\x00;\x00;"
            "\x03;\x02;\x01;\x00;"
            "\x0d;\x03;\x01;\x00;\x00;"
            "\x08;\x01;\x00;"
            "\x0a;\x06;\x01;\x04;\x00;\x08;\x00;\x0b;")))

(func (main)
  (if (instantiate '"dyn" answer-module 0) (return))
  (write-int (call-indirect (-> i32) (export-index '"dyn" '"answer")))
  (newline)
  (if (instantiate '"dyn@0+1" answer-module 0) (return))
  (if (instantiate '"twice@0+1" twice-module '"dyn@0+0\x00;dyn@0+1\x00;") (return))
  (write-int (call-indirect (-> i32) (export-index '"twice@0+1" '"twice")))
  (newline)
  (if (instantiate '"ns/dyn@0+0" answer-module 0) (return))
  (if (instantiate '"ns/twice@0+0" twice-module '"dyn@0+0\x00;ns/dyn@0+0\x00;") (return))
  (write-int (call-indirect (-> i32) (export-index '"ns/twice@0+0" '"twice")))
  (newline)
  (try ([catch-all (write-string '"caught") (newline)])
    (drop (instantiate '"thrower" thrower-module 0)))
  (if (instantiate '"bad" '"\x00;asm\x01;\x00;\x00;\x00;\x01;" 0)
      (let* ([message (k:alloc-in (k:current-arena) 64)] [n (host-error-message message 64)])
        (write-string '"error: ")
        (write-bytes message (select n 7 (i32.lt_s n 7)))
        (newline))))
