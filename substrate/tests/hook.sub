;; The instantiate hook (spec 4), called from kernel code: a module is
;; built as bytes in this module's memory, instantiated by the host, and
;; called through this module's table. This is the path the self-hosted
;; compiler will use.

(require print "../lib/print.sub" write-int newline write-bytes)
(memory from print)

(import host-instantiate "host" "instantiate" (i32 i32 i32 i32 i32 -> i32))
(import host-export-index "host" "export_index" (i32 i32 i32 i32 -> i32))
(import host-error-message "host" "error_message" (i32 i32 -> i32))

(table 1)

;; (module (func (export "answer") (result i32) i32.const 42))
(data answer-module 1024
  "\x00;asm\x01;\x00;\x00;\x00;\x01;\x05;\x01;\x60;\x00;\x01;\x7f;\x03;\x02;\x01;\x00;"
  "\x07;\x0a;\x01;\x06;answer\x00;\x00;\x0a;\x06;\x01;\x04;\x00;\x41;\x2a;\x0b;")
(data dyn-name 1100 "dyn")
(data answer-field 1104 "answer")
(data bad-name 1112 "bad")
(data junk 1116 "\x00;asm\x01;\x00;\x00;\x00;\x01;")
(data error-label 1128 "error: ")

;; (module (import "dyn@0+0" "answer" (func (result i32)))
;;         (func (export "twice") (result i32) call 0 call 0 i32.add))
(data twice-module 1200
  "\x00;asm\x01;\x00;\x00;\x00;"
  "\x01;\x05;\x01;\x60;\x00;\x01;\x7f;"
  "\x02;\x12;\x01;\x07;dyn@0+0\x06;answer\x00;\x00;"
  "\x03;\x02;\x01;\x00;"
  "\x07;\x09;\x01;\x05;twice\x00;\x01;"
  "\x0a;\x09;\x01;\x07;\x00;\x10;\x00;\x10;\x00;\x6a;\x0b;")
(data shifted-name 1300 "dyn@0+1")
(data twice-name 1310 "twice@0+1")
(data twice-field 1320 "twice")
(data ns-dyn-name 1330 "ns/dyn@0+0")
(data ns-twice-name 1342 "ns/twice@0+0")

(func (main)
  (if (host-instantiate (data-address dyn-name) (data-size dyn-name)
                        (data-address answer-module) (data-size answer-module) 0)
      (return))
  (let ([index (host-export-index (data-address dyn-name) (data-size dyn-name)
                                  (data-address answer-field) (data-size answer-field))])
    (write-int (call-indirect (-> i32) index))
    (newline))
  ;; At a shift, part names in the module's imports are shifted (spec 3.2):
  ;; twice's import from dyn@0+0 is linked to dyn@0+1.
  (if (host-instantiate (data-address shifted-name) (data-size shifted-name)
                        (data-address answer-module) (data-size answer-module) 0)
      (return))
  (if (host-instantiate (data-address twice-name) (data-size twice-name)
                        (data-address twice-module) (data-size twice-module) 1)
      (return))
  (write-int (call-indirect (-> i32) (host-export-index (data-address twice-name) (data-size twice-name)
                                                         (data-address twice-field) (data-size twice-field))))
  (newline)
  ;; In a namespace, part names in the module's imports are looked up in
  ;; it (spec 3.2): ns/twice's import from dyn@0+0 is linked to ns/dyn@0+0,
  ;; and there is no dyn@0+0.
  (if (host-instantiate (data-address ns-dyn-name) (data-size ns-dyn-name)
                        (data-address answer-module) (data-size answer-module) 0)
      (return))
  (if (host-instantiate (data-address ns-twice-name) (data-size ns-twice-name)
                        (data-address twice-module) (data-size twice-module) 0)
      (return))
  (write-int (call-indirect (-> i32) (host-export-index (data-address ns-twice-name) (data-size ns-twice-name)
                                                         (data-address twice-field) (data-size twice-field))))
  (newline)
  ;; A module that fails to validate is reported, not fatal.
  (if (host-instantiate (data-address bad-name) (data-size bad-name)
                        (data-address junk) (data-size junk) 0)
      (let ([n (host-error-message 2048 64)])
        (write-bytes (data-address error-label) (data-size error-label))
        (write-bytes 2048 (select n 7 (i32.lt_s n 7)))
        (newline))))
