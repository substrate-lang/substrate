;; The kernel's GC primitives are plain wasm (spec 5.3): a program can
;; declare its own struct and array types and use them, with no library.
;; This is how a language could choose WasmGC for its own data.

(require "../lib/print.sub")

(type node (struct (field value i32) (field next (ref null node))))
(type counter (struct (field count (mut i32))))
(type bytes (array (mut i8)))

(func (push [v i32] [list (ref null node)]) -> (ref node)
  (struct.new node v list))

(func (sum [list (ref null node)]) -> i32
  (if (ref.is_null list)
      0
      (i32.add (struct.get node value list) (sum (struct.get node next list)))))

(func (main)
  (let ([list (push 1 (push 2 (push 3 (ref.null node))))]
        [c (struct.new counter 0)]
        [b (array.new bytes 7 4)])
    (write-int (sum list)) (newline)
    (struct.set counter count c 41)
    (struct.set counter count c (i32.add (struct.get counter count c) 1))
    (write-int (struct.get counter count c)) (newline)
    (array.set bytes b 3 250)
    (write-int (array.get_u bytes b 3)) (write-int (array.get_s bytes b 3)) (write-int (array.len b))
    (newline)))
