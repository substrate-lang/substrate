;; Several values, (values e ...), and let bindings of them.
(require print "../compiler/print.sub" write-int newline)
(memory from print)

(func (divmod [a i32] [b i32]) -> (i32 i32) (values (i32.div_u a b) (i32.rem_u a b)))

(func (swap [a i32] [b i32]) -> (i32 i32) (#%app pair b a))
(func (pair [a i32] [b i32]) -> (i32 i32) (values a b))

(func (sum3 [a i64] [b i32] [c f64]) -> i32
  (i32.add (i32.wrap_i64 a) (i32.add b (i32.trunc_f64_s c))))

(func (three) -> (i64 i32 f64) (values (i64.const 100) (i32.const 20) (f64.const 3.5)))

(func (twice [x i32]) #:inline -> (i32 i32) (values x x))

(func (main)
  (let ([(q r) (#%app divmod 47 5)])
    (write-int q) (newline)
    (write-int r) (newline))
  (let ([(a b) (i32 i32) (#%app swap 1 2)])
    (write-int (i32.add (i32.mul a 10) b)) (newline))
  (let* ([(x y z) (#%app three)] [s (#%app sum3 x y z)])
    (write-int s) (newline))
  (let ([(u v) (#%app twice 21)])
    (write-int (i32.add u v)) (newline)))
