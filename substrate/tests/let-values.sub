;; Several values, (values e ...), and let bindings of them.
(require wasm "../compiler/wasm.sub")

(wasm:func (divmod [a i32] [b i32]) -> (i32 i32) (values (wasm:i32.div_u a b) (wasm:i32.rem_u a b)))

(wasm:func (swap [a i32] [b i32]) -> (i32 i32) (#%app pair b a))
(wasm:func (pair [a i32] [b i32]) -> (i32 i32) (values a b))

(wasm:func (sum3 [a i64] [b i32] [c f64]) -> i32
  (wasm:i32.add (wasm:i32.wrap_i64 a) (wasm:i32.add b (wasm:i32.trunc_f64_s c))))

(wasm:func (three) -> (i64 i32 f64) (values (wasm:i64.const 100) (wasm:i32.const 20) (wasm:f64.const 3.5)))

(wasm:func (twice [x i32]) #:inline -> (i32 i32) (values x x))

(define (main)
  (let ([(q r) (#%app divmod 47 5)])
    (write-int q) (newline)
    (write-int r) (newline))
  (let ([(a b) (i32 i32) (#%app swap 1 2)])
    (write-int (wasm:i32.add (wasm:i32.mul a 10) b)) (newline))
  (let* ([(x y z) (#%app three)] [s (#%app sum3 x y z)])
    (write-int s) (newline))
  (let ([(u v) (#%app twice 21)])
    (write-int (wasm:i32.add u v)) (newline)))
