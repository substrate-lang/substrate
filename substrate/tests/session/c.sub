;; A session test in the C-like Lisp (compiler/base). An expression typed at the
;; top level is compiled as C code, and its value is printed according to
;; its type. The session uses the compiler's own memory, table and stack,
;; so it does not declare any.
(require-unqualified base "../../compiler/base/base.sub")
(+ 1 2)
(struct point [x i32] [y i32])
(define origin point)
(set! (-> origin x) 3)
(set! (-> origin y) 4)
(define (norm1 [p (ptr point)]) -> i32 (+ (-> p x) (-> p y)))
(norm1 (& origin))
(* 1.5 (sqrt 2.0))
(cast f32 0.5)
(cast u32 -1)
(cast i64 -5000000000)
(cast u64 -1)
"text"
(cast (ptr u8) 0)
origin
(let ([total 0]) (for ([i 1]) (<= i 10) (+= i 1) (+= total i)) total)
(print-string "no value\n")
(sizeof point)
(variant shape [circle [r i32]] [rect [w i32] [h i32]])
(define (area [s shape]) -> i32 (match s [(circle r) (* 3 r r)] [(rect w h) (* w h)]))
(area (rect 6 7))
(rect 6 7)
(nope 1)
(+ origin 1)
(< 1 2)
;; A generic function. The input that calls it creates the instance needed.
(define #:forall (T) (twice [x T]) -> T (+ x x))
(twice 21)
(twice 1.25)
;; A closure, passed to another function.
(define (apply-to [f (closure (i32) -> i32)] [x i32]) -> i32 (f x))
(let ([k 10]) (apply-to (lambda ([x i32]) -> i32 (* x k)) 4))
;; Redefine norm1 with a different type. Later inputs call the new one.
(define (norm1 [p (ptr point)]) -> f64 (sqrt (cast f64 (+ (* (-> p x) (-> p x)) (* (-> p y) (-> p y))))))
(norm1 (& origin))
;; A string is a global, made the first time an input uses it. An input
;; that fails takes its globals with it, so a later input that uses the
;; same string makes it again.
(begin (print-string "made\n") (nope))
(print-string "made\n")
