;; A recursion group's members are in order, as in wasm (spec 5.1): these
;; groups have the same members in different orders, so a1 and a2 are
;; different types.
(rec (type a1 (struct (field v i32) (field next (ref null b1))))
     (type b1 (struct (field w i64) (field next (ref null a1)))))
(rec (type b2 (struct (field w i64) (field next (ref null a2))))
     (type a2 (struct (field v i32) (field next (ref null b2)))))
(func (first-v [x (ref a2)]) -> i32 (struct.get a2 v x))
(func (main) (drop (first-v (struct.new a1 3 (ref.null b1)))))
