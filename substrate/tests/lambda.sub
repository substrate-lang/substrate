;; Lambdas in kernel code: closures, boxes for assigned captures, and known functions.
(require print "../compiler/print.sub" write-int newline)

(global double (ref (closure (i32 -> i32))) (lambda ([x i32]) -> i32 (i32.mul x 2)))

(func (adder [n i32]) -> (ref (closure (i32 -> i32)))
  (lambda ([x i32]) -> i32 (i32.add x n)))

(func (apply-twice [f (ref (closure (i32 -> i32)))] [x i32]) -> i32 (f (f x)))

(func (counter) -> (ref (closure (-> i32)))
  (let ([count 0])
    (lambda () -> i32 (set! count (i32.add count 1)) count)))

(func (shared) -> i32
  (let* ([x 1] [f (lambda () -> i32 x)])
    (set! x 2)
    (f)))

(func (sum-to [n i32]) -> i32
  (let ([total 0])
    (let ([loop '#f])
      (set! loop (lambda ([i i32]) (if (i32.le_s i n) (begin (set! total (i32.add total i)) (loop (i32.add i 1))))))
      (loop 1))
    total))

(func (count-down [n i32]) -> i32
  (let ([loop '#f])
    (set! loop (lambda ([i i32] [acc i32]) -> i32 (if (i32.eqz i) acc (loop (i32.sub i 1) (i32.add acc 1)))))
    (loop n 0)))

(func (parity [n i32]) -> i32
  (let ([even '#f] [odd '#f])
    (set! even (lambda ([i i32]) -> i32 (if (i32.eqz i) 1 (odd (i32.sub i 1)))))
    (set! odd (lambda ([i i32]) -> i32 (if (i32.eqz i) 0 (even (i32.sub i 1)))))
    (even n)))

(func (scaler [k i32]) -> (ref (closure (i32 -> i32)))
  (let ([helper (lambda ([x i32]) -> i32 (i32.mul x k))])
    (lambda ([y i32]) -> i32 (helper y))))

(func (choose [c i32]) -> i32
  (let ([f (if c (lambda ([x i32]) -> i32 x) (lambda ([x i32]) -> i32 (i32.sub 0 x)))])
    (f 7)))

(func (main)
  (write-int (double 21)) (newline)
  (write-int ((adder 3) 4)) (newline)
  (write-int (apply-twice (adder 10) 1)) (newline)
  (let ([c (counter)] [d (counter)])
    (drop (c)) (drop (c)) (drop (d))
    (write-int (c)) (newline)
    (write-int (d)) (newline))
  (write-int (shared)) (newline)
  (write-int (sum-to 100)) (newline)
  (write-int (count-down 1000000)) (newline)
  (write-int (parity 11)) (newline)
  (write-int ((scaler 6) 7)) (newline)
  (write-int (choose 1)) (newline)
  (write-int (choose 0)) (newline))
