;; The C example's syntax objects (examples/c/syntax.sub): data, scope
;; sets, syntax objects and their scope changes, properties, and arenas.
(require-unqualified c "../../examples/c/c.sub")
(require-unqualified stx "../../examples/c/syntax.sub")
(require print "../../lib/print.sub" write-int write-byte newline)
(memory from c)
(table from c)

(define (show [x i32]) (write-int x) (write-byte 32))
(define (line [d datum]) (write-datum d) (newline))
(define (scoped [d datum]) (write-scoped d) (newline))

(define (list2 [a datum] [b datum]) -> datum (cons a (cons b nil)))
(define (list3 [a datum] [b datum] [c datum]) -> datum (cons a (cons b (cons c nil))))
(define (sym [s (ptr u8)]) -> datum (symbol-named s))

;; The set of scopes a, then b, then c added to none, 0 for none.
(define (scopes [a u32] [b u32] [c u32]) -> (ptr scope-set)
  (let ([s no-scopes])
    (when (!= a 0) (set! s (scopes-change s a 0)))
    (when (!= b 0) (set! s (scopes-change s b 0)))
    (when (!= c 0) (set! s (scopes-change s c 0)))
    s))

(define (identifier [name (ptr u8)] [s (ptr scope-set)]) -> datum (make-syntax (sym name) s 0 nil))

(define (data)
  (let ([a (sym "a")] [kw (bytes->keyword "key" 3)])
    (line (cons a (cons (bytes->string "t\"w\no" 5) (cons (make-integer -9223372036854775807)
      (cons (make-flonum 1.5) (cons (integer->char 955) (cons kw (cons (boolean 1) (cons (boolean 0) (cons nil (cons a (make-integer 2))))))))))))
    (show (== a (bytes->symbol "abc" 1)))
    (show (== kw (bytes->keyword "keys" 3)))
    (show (== a (sym "b")))
    (show (length (list3 a a a)))
    (show (list? (cons a a)))
    (line (append (list3 a kw nil) (list3 (sym "b") (sym "c") nil)))
    (line (list3 (sym "quote") a nil))
    (line (list2 (sym "quote-syntax") a))
    (line (list3 (integer->char 32) (integer->char 7) (integer->char 1)))))

;; Sets are interned: the same scopes, however they came, are one set.
(define (sets)
  (let ([s31 (scopes 3 1 0)] [s13 (scopes 1 3 0)] [s1 (scopes 1 0 0)])
    (show (== s31 s13))
    (show (== (scopes-change s31 3 2) s1))
    (show (== (scopes-change s1 5 1) s1))
    (show (== (scopes-change s1 1 0) s1))
    (show (scopes-subset? s1 s31))
    (show (scopes-subset? s31 s1))
    (show (scopes-subset? no-scopes s1))
    (show (scopes-subset? (scopes 3 0 0) (scopes 5 3 1)))
    (show (scopes-subset? (scopes 4 0 0) (scopes 5 3 1)))
    (scoped (identifier "x" (scopes 2 9 5)))))

;; Changes to a syntax object reach every one in it, when something looks.
(define (changes)
  (begin-module-arena)
  (let* ([ctx (identifier "ctx" (scopes 3 1 0))]
         [s (datum->syntax ctx (cons (sym "a") (cons (list2 (sym "b") (sym "c")) (sym "d"))) 0)]
         [added (add-scope s 5)])
    (scoped s)
    (scoped added)
    (scoped (remove-scope added 3))
    ;; Two flips cancel, and nothing inside is made again.
    (let ([twice (flip-scope (flip-scope s 7) 7)])
      (show (== (syntax-scopes twice) (syntax-scopes s)))
      (show (== (syntax-e twice) (syntax-e s))))
    ;; A macro's use: its introduction scope, 9, flipped on its input and
    ;; its output, stays only on what it made, here the new head.
    (let* ([in (flip-scope s 9)]
           [out (datum->syntax ctx (cons (identifier "new" (syntax-scopes ctx)) (syntax-e in)) in)])
      (scoped (flip-scope out 9)))
    (line s)
    (line (syntax->datum added))
    (show (length (syntax->list (datum->syntax 0 (list3 (sym "p") (sym "q") (sym "r")) 0))))
    (show (== (syntax->list added) 0))
    (show (identifier? ctx))
    (show (identifier? s))
    (newline))
  (end-module-arena))

(define (properties)
  (let* ([x (identifier "x" no-scopes)] [type (sym "type")]
         [typed (syntax-property-set x type (sym "i32"))]
         [retyped (syntax-property-set typed type (sym "i64"))])
    (line (syntax-property typed type))
    (line (syntax-property retyped type))
    (line (syntax-property x type))
    (line (syntax-property (syntax-property-set retyped (sym "other") nil) type))
    (let ([at (make-syntax (sym "y") no-scopes (make-srcloc (sym "f.sub") 4 2 30 1) nil)])
      (show (-> (syntax-srcloc (datum->syntax 0 (sym "z") at)) line)))
    (newline)))

;; keep copies syntax out of a module arena, which is freed; another
;; module's cells then take its memory.
(define (arenas)
  (let ([kept datum 0] [x (sym "x")])
    (begin-module-arena)
    (let ([s (add-scope (datum->syntax (identifier "ctx" (scopes 2 0 0)) (list3 x (bytes->string "str" 3) (make-integer 7)) 0) 4)])
      (set! kept (keep (syntax-property-set s x (list2 x (make-flonum 2.5))))))
    (end-module-arena)
    (show (== (current-arena) (& run-arena)))
    (begin-module-arena)
    (for ([i 0]) (< i 10000) (+= i 1) (cons nil nil))
    (scoped kept)
    (line (syntax-property kept x))
    (end-module-arena)))

(define (flonums)
  (let ([xs (array f64 14)])
    (set! (@ xs 12) (/ 1.0 3.0)) (set! (@ xs 13) 5e-324)
    (set! (@ xs 0) 0.1) (set! (@ xs 1) 100.0) (set! (@ xs 2) 1e21) (set! (@ xs 3) 1.5e-7)
    (set! (@ xs 4) -0.0) (set! (@ xs 5) 123456.789) (set! (@ xs 6) 0.001) (set! (@ xs 7) 1e10)
    (set! (@ xs 8) 12345678901.0) (set! (@ xs 9) (/ 1.0 0.0)) (set! (@ xs 10) (/ 0.0 0.0)) (set! (@ xs 11) -2.5e-300)
    (for ([i 0]) (< i 14) (+= i 1)
      (write-datum (make-flonum (@ xs i)))
      (write-byte 32))
    (newline)))

(define (main)
  (data)
  (sets)
  (changes)
  (properties)
  (arenas)
  (flonums))
