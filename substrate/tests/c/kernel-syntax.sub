;; Kernel syntax objects as the C example's (examples/c/kernel-syntax.sub):
;; their data and locations, with no scopes.
(require-unqualified c "../../examples/c/c.sub")
(require-unqualified stx "../../examples/c/syntax.sub")
(require-unqualified ks "../../examples/c/kernel-syntax.sub")
(require print "../../lib/print.sub" write-int write-byte newline)
(memory from c)
(table from c)

(define (show [v value])
  (let* ([d (from-kernel v)] [at (syntax-srcloc (car (syntax-e d)))])
    (write-datum d)
    (newline)
    (write-scoped (car (cdr (syntax-e d))))
    (newline)
    (write-datum (-> at source))
    (write-byte 32)
    (write-int (-> at line))
    (write-byte 32)
    (write-int (-> at col))
    (newline)))

(func (main)
  (show (quote-syntax (a (b . c) "d\n" 12 -3 18446744073709551615 2.5 #\x #:k #t #f ()))))
