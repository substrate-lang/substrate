;; The C example's function pointers (examples/c/lang.sub): a function's
;; name is its pointer, its index in the table, which a call calls
;; through.
(require-unqualified c "../../compiler/c/c.sub")
(require print "../../lib/print.sub" write-int write-byte newline)
(memory from c)
(table from c)

(typedef unary (fn (i32) -> i32))
(struct shape [area (fn ((ptr shape)) -> i32)] [w i32] [h i32])
(struct pair [a i32] [b i32])

(define (show [x i32]) (write-int x) (write-byte 32))

(define (double [x i32]) -> i32 (* x 2))
(define (square [x i32]) -> i32 (* x x))
(define (negate [x i32]) -> i32 (- x))

;; A function that takes a function pointer, and one that returns one.
(define (apply-twice [f unary] [x i32]) -> i32 (f (f x)))
(define (pick [n i32]) -> unary (if (== n 0) double square))

;; Functions in a static array.
(define ops (array unary 3))

;; A struct whose field is a function, a method.
(define (rect-area [s (ptr shape)]) -> i32 (* (-> s w) (-> s h)))
(define (triangle-area [s (ptr shape)]) -> i32 (/ (* (-> s w) (-> s h)) 2))

(define (swap [p pair]) -> pair
  (let ([q pair]) (set! (-> q a) (-> p b)) (set! (-> q b) (-> p a)) q))

(define (main)
  (show (apply-twice double 5))
  (show (apply-twice (pick 1) 3))
  (show ((pick 0) 7))
  (set! (@ ops 0) double)
  (set! (@ ops 1) square)
  (set! (@ ops 2) (& negate))
  (let ([s 0]) (for ([i 0]) (< i 3) (+= i 1) (+= s ((@ ops i) 4))) (show s))
  (let ([r shape] [t shape])
    (set! (-> r area) rect-area) (set! (-> r w) 3) (set! (-> r h) 4)
    (set! (-> t area) triangle-area) (set! (-> t w) 3) (set! (-> t h) 4)
    (show ((-> r area) (& r)))
    (show ((-> t area) (& t))))
  ;; A null pointer, comparisons, and a call through a pointer that
  ;; returns a struct.
  (let ([f unary 0] [sw (fn (pair) -> pair) swap] [p pair])
    (show (if f 1 0))
    (set! f square)
    (show (== f square))
    (show (== f double))
    (set! (-> p a) 1)
    (set! (-> p b) 2)
    (show (-> (sw p) a)))
  ;; Pointers to another module's function, and to a kernel function,
  ;; whose name is not a value: (& f) is its pointer.
  (let ([alloc (fn (u32) -> (ptr void)) malloc] [out (fn (i32)) (& write-int)] [p (ptr i32) 0])
    (set! p (cast (ptr i32) (alloc 4)))
    (set! (@ p) 9)
    (out (@ p))
    (free p))
  (newline))
