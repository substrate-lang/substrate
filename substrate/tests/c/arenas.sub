;; The C example's arenas (examples/c/runtime.sub): nodes made with new
;; in an arena, which is freed all at once, and used again.
(require-unqualified c "../../compiler/c/c.sub")
(require print "../../lib/print.sub" write-int write-byte newline)
(memory from c)
(table from c)

(define (show [x i32]) (write-int x) (write-byte 32))

(struct node [value i32] [next (ptr node)])

(define (build [a (ptr arena)] [n i32]) -> (ptr node)
  (let ([list (ptr node) 0])
    (for ([i 1]) (<= i n) (+= i 1)
      (let ([cell (new a node)])
        (set! (-> cell value) i)
        (set! (-> cell next) list)
        (set! list cell)))
    list))

(define (sum [list (ptr node)]) -> i32
  (let ([s 0])
    (while (!= list 0)
      (+= s (-> list value))
      (set! list (-> list next)))
    s))

(define (main)
  (let ([a (make-arena)])
    (show (sum (build (& a) 10000)))
    (arena-free (& a))
    (show (sum (build (& a) 1000)))
    (let ([big (cast (ptr u8) (arena-alloc (& a) 200000))])
      (set! (@ big 199999) 7)
      (show (@ big 199999)))
    (arena-free (& a)))
  (newline))
