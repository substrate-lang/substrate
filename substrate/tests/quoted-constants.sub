;; Quoted fixnums, #f, '() and #t are constant expressions (spec 5.2), so
;; immutable globals can hold them. Other quoted data is built when the
;; module starts (spec 3.5), so its global must be mutable.
(require s syntax)
(require print "../lib/print.sub" newline)
(require sub "../lib/substrate.sub" write)

(global empty eqref '())
(global yes eqref '#t)
(global no eqref '#f)
(global five eqref '5)
(global built (mut eqref) '(1 2))

(func (main)
  (write (s:cons five (s:cons yes (s:cons no empty)))) (print:newline)
  (write built) (print:newline))
