;; tests/basics.sub
(data greeting 1024 "hello from a data segment\n")
(func (fact (n i64))
  ->
  i64
  (if (i64.le_s n (#%datum 1))
    (#%datum 1)
    (i64.mul n (#%app fact (i64.sub n (#%datum 1))))))
(func (count-down (n i32) (acc i32))
  ->
  i32
  (if (i32.eqz n)
    acc
    (#%app count-down (i32.sub n (#%datum 1)) (i32.add acc (#%datum 1)))))
(func (sum-to (n i32))
  ->
  i32
  (let ((i (#%datum 0)) (acc (#%datum 0)))
    (block done
      (loop next
        (br-if done (i32.gt_s i n))
        (set! acc (i32.add acc i))
        (set! i (i32.add i (#%datum 1)))
        (br next)))
    acc))
(func (first-multiple (k i32) (from i32))
  ->
  i32
  (block found
    (loop next
      (if (i32.eqz (i32.rem_u from k)) (br found from))
      (set! from (i32.add from (#%datum 1)))
      (br next))))
(global counter (mut i32) (#%datum 0))
(func (bump) (set! counter (i32.add counter (#%datum 1))))
(func (main)
  (#%app print:write-bytes (data-address greeting) (data-size greeting))
  (#%app print:write-int (i32.wrap_i64 (#%app fact (#%datum 12))))
  (#%app print:newline)
  (#%app print:write-int (#%app count-down (#%datum 1000000) (#%datum 0)))
  (#%app print:newline)
  (#%app print:write-int (#%app sum-to (#%datum 100)))
  (#%app print:newline)
  (#%app print:write-int (#%app first-multiple (#%datum 7) (#%datum 50)))
  (#%app print:newline)
  (#%app print:write-int (i32.trunc_f64_s (f64.mul (#%datum 2.5) (#%datum 4))))
  (#%app print:newline)
  (#%app bump)
  (#%app bump)
  (#%app bump)
  (#%app print:write-int counter)
  (#%app print:newline)
  (#%app print:write-int
    (let ((a (#%datum 3))) (let ((b (i32.mul a a))) (i32.add a b))))
  (#%app print:newline)
  (#%app print:write-int
    (select (#%datum 10) (#%datum 20) (i32.gt_s (#%datum 3) (#%datum 2))))
  (#%app print:newline)
  (#%app print:write-int (#%datum #t))
  (#%app print:write-int (#%datum #f))
  (#%app print:write-int (#%datum #\a))
  (#%app print:newline))
;; tests/hook.sub
(import host-instantiate "host" "instantiate" (i32 i32 i32 i32 i32 i32 -> i32))
(import host-export-index "host" "export_index" (i32 i32 i32 i32 -> i32))
(import host-error-message "host" "error_message" (i32 i32 -> i32))
(data answer-module
  1024
  "\x0;asm\x1;\x0;\x0;\x0;\x1;\x5;\x1;`\x0;\x1;\x7f;\x3;\x2;\x1;\x0;"
  "\x7;\n\x1;\x6;answer\x0;\x0;\n\x6;\x1;\x4;\x0;A*\xb;")
(data dyn-name 1100 "dyn")
(data answer-field 1104 "answer")
(data bad-name 1112 "bad")
(data junk 1116 "\x0;asm\x1;\x0;\x0;\x0;\x1;")
(data error-label 1128 "error: ")
(data twice-module
  1200
  "\x0;asm\x1;\x0;\x0;\x0;"
  "\x1;\x5;\x1;`\x0;\x1;\x7f;"
  "\x2;\x12;\x1;\x7;dyn@0+0\x6;answer\x0;\x0;"
  "\x3;\x2;\x1;\x0;"
  "\x7;\t\x1;\x5;twice\x0;\x1;"
  "\n\t\x1;\x7;\x0;\x10;\x0;\x10;\x0;j\xb;")
(data shifted-name 1300 "dyn@0+1")
(data twice-name 1310 "twice@0+1")
(data twice-field 1320 "twice")
(data ns-dyn-name 1330 "ns/dyn@0+0")
(data ns-twice-name 1342 "ns/twice@0+0")
(data to-shifted 1360 "dyn@0+0\x0;dyn@0+1\x0;")
(data to-ns 1380 "dyn@0+0\x0;ns/dyn@0+0\x0;")
(data thrower-module
  1400
  "\x0;asm\x1;\x0;\x0;\x0;"
  "\x1;\x4;\x1;`\x0;\x0;"
  "\x3;\x2;\x1;\x0;"
  "\r\x3;\x1;\x0;\x0;"
  "\x8;\x1;\x0;"
  "\n\x6;\x1;\x4;\x0;\x8;\x0;\xb;")
(data thrower-name 1440 "thrower")
(data caught 1450 "caught")
(func (main)
  (if (#%app host-instantiate
        (data-address dyn-name)
        (data-size dyn-name)
        (data-address answer-module)
        (data-size answer-module)
        (#%datum 0)
        (#%datum 0))
    (return))
  (let ((index (#%app host-export-index
                 (data-address dyn-name)
                 (data-size dyn-name)
                 (data-address answer-field)
                 (data-size answer-field))))
    (#%app write-int (call-indirect (-> i32) index))
    (#%app newline))
  (if (#%app host-instantiate
        (data-address shifted-name)
        (data-size shifted-name)
        (data-address answer-module)
        (data-size answer-module)
        (#%datum 0)
        (#%datum 0))
    (return))
  (if (#%app host-instantiate
        (data-address twice-name)
        (data-size twice-name)
        (data-address twice-module)
        (data-size twice-module)
        (data-address to-shifted)
        (data-size to-shifted))
    (return))
  (#%app write-int
    (call-indirect (-> i32)
      (#%app host-export-index
        (data-address twice-name)
        (data-size twice-name)
        (data-address twice-field)
        (data-size twice-field))))
  (#%app newline)
  (if (#%app host-instantiate
        (data-address ns-dyn-name)
        (data-size ns-dyn-name)
        (data-address answer-module)
        (data-size answer-module)
        (#%datum 0)
        (#%datum 0))
    (return))
  (if (#%app host-instantiate
        (data-address ns-twice-name)
        (data-size ns-twice-name)
        (data-address twice-module)
        (data-size twice-module)
        (data-address to-ns)
        (data-size to-ns))
    (return))
  (#%app write-int
    (call-indirect (-> i32)
      (#%app host-export-index
        (data-address ns-twice-name)
        (data-size ns-twice-name)
        (data-address twice-field)
        (data-size twice-field))))
  (#%app newline)
  (try ((catch-all (#%app write-bytes (data-address caught) (data-size caught))
          (#%app newline)))
    (drop (#%app host-instantiate
            (data-address thrower-name)
            (data-size thrower-name)
            (data-address thrower-module)
            (data-size thrower-module)
            (#%datum 0)
            (#%datum 0))))
  (if (#%app host-instantiate
        (data-address bad-name)
        (data-size bad-name)
        (data-address junk)
        (data-size junk)
        (#%datum 0)
        (#%datum 0))
    (let ((n (#%app host-error-message (#%datum 2048) (#%datum 64))))
      (#%app write-bytes (data-address error-label) (data-size error-label))
      (#%app write-bytes
        (#%datum 2048)
        (select n (#%datum 7) (i32.lt_s n (#%datum 7))))
      (#%app newline))))
;; tests/func-refs.sub
(func (mul (a i32) (b i32)) -> i32 (type binop) (i32.mul a b))
(func (fold (op (ref binop)) (acc i32) (i i32) (n i32))
  ->
  i32
  (if (i32.gt_s i n)
    acc
    (#%app fold op (call-ref binop op acc i) (i32.add i (#%datum 1)) n)))
(func (main)
  (#%app write-int
    (#%app fold (ref.func mul) (#%datum 1) (#%datum 1) (#%datum 5)))
  (#%app newline)
  (#%app write-int
    (#%app fold (ref.func add) (#%datum 0) (#%datum 1) (#%datum 100)))
  (#%app newline))
;; tests/globals.sub
(type unary (func (i32 -> i32)))
(global base i32 (#%datum 40))
(global answer i32 (i32.add (#%datum 40) (#%datum 2)))
(global identity (ref unary) (ref.func same))
(global counter (mut i32) (#%app square (#%datum 3)))
(func (square (x i32)) -> i32 (i32.mul x x))
(func (same (x i32)) -> i32 (type unary) x)
(func (main)
  (#%app write-int answer)
  (#%app newline)
  (#%app write-int (call-ref unary identity base))
  (#%app newline)
  (set! counter (i32.add counter (#%datum 1)))
  (#%app write-int counter)
  (#%app newline))
;; tests/decimals.sub
(func (show (x f64)) (#%app write-u64 (i64.reinterpret_f64 x)) (#%app newline))
(func (main)
  (#%app show (#%datum 0.1))
  (#%app show (#%datum 1e23))
  (#%app show (#%datum 9.007199254740992e15))
  (#%app show (#%datum 9.007199254740996e15))
  (#%app show (#%datum 1.7976931348623157e308))
  (#%app show (#%datum +inf.0))
  (#%app show (#%datum +inf.0))
  (#%app show (#%datum 2.2250738585072014e-308))
  (#%app show (#%datum 2.225073858507201e-308))
  (#%app show (#%datum 5e-324))
  (#%app show (#%datum 0.0))
  (#%app show (#%datum 5e-324))
  (#%app show (#%datum 3.141592653589793))
  (#%app show (#%datum -0.0)))
;; tests/namespaces.sub
(func (main)
  (let ((p (ref point) (ref.func point)) (q (ref pt:point) (ref.func pt:point)))
    (#%app write-int (#%app pt:point-x p (#%datum 3)))
    (#%app newline)
    (#%app write-int (call-ref point q (#%datum 6)))
    (#%app newline)))
;; tests/module-copies.sub
(func (main)
  (#%app write-int (#%app a:bump))
  (#%app newline)
  (#%app write-int (#%app b:bump))
  (#%app newline))
;; tests/interface-tags.sub
(func (main)
  (#%app write-int (#%app t:%quote (i32.add (#%app t:%type) t:%info)))
  (#%app newline))
;; tests/provide-all.sub
(func (main)
  (#%app write-int (call-ref r:binop (ref.func r:sub) (#%datum 5) (#%datum 3)))
  (#%app newline))
;; tests/call-indirect-type.sub
(func (unused) (drop (call-indirect (-> (ref null T)) (#%datum 0))))
(func (main))
;; compiler/print.sub
(import host-write "host" "write" (i32 i32 i32 -> i32))
(func (write-bytes (p i32) (n i32)) (drop (#%app host-write (#%datum 1) p n)))
(func (write-byte (b i32))
  (i32.store8 (#%datum 0) b)
  (#%app write-bytes (#%datum 0) (#%datum 1)))
(func (newline) (#%app write-byte (#%datum 10)))
(func (write-int (n i32))
  (let ((p (#%datum 64)) (u n) (neg (i32.lt_s n (#%datum 0))))
    (if neg (set! u (i32.sub (#%datum 0) n)))
    (block done
      (loop next
        (set! p (i32.sub p (#%datum 1)))
        (i32.store8 p (i32.add (#%datum 48) (i32.rem_u u (#%datum 10))))
        (set! u (i32.div_u u (#%datum 10)))
        (br-if done (i32.eqz u))
        (br next)))
    (if neg
      (begin (set! p (i32.sub p (#%datum 1))) (i32.store8 p (#%datum 45))))
    (#%app write-bytes p (i32.sub (#%datum 64) p))))
(func (write-u64 (n i64))
  (let ((p (#%datum 96)) (u n))
    (block done
      (loop next
        (set! p (i32.sub p (#%datum 1)))
        (i32.store8 p
          (i32.add (#%datum 48) (i32.wrap_i64 (i64.rem_u u (#%datum 10)))))
        (set! u (i64.div_u u (#%datum 10)))
        (br-if done (i64.eqz u))
        (br next)))
    (#%app write-bytes p (i32.sub (#%datum 96) p))))
(func (write-i64 (n i64))
  (if (i64.lt_s n (#%datum 0))
    (begin (#%app write-byte (#%datum 45))
      (#%app write-u64 (i64.sub (#%datum 0) n)))
    (#%app write-u64 n)))
