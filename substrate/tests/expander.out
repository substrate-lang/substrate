    (#%app write-int (#%app sum-to (i32.const 100)))
    (#%app newline)
    (#%app write-int (#%app first-multiple (i32.const 7) (i32.const 50)))
    (#%app newline)
    (#%app write-int (i32.trunc_f64_s (f64.mul (f64.const 2.5) (f64.const 4))))
