;; #%app (spec 5.3): a form that is not a macro use, core form or wasm
;; operator is an application, (#%app f arg ...), and #%app means what it
;; is bound to where the form was written. This module binds it to the
;; fixture's app, so calling the variable f calls through the table.
(require print "../lib/print.sub" write-int newline)
(require ind "fixtures/indirect-app.sub" [#%app app])

(table 2)

(func (double [x i32]) -> i32 (i32.mul x 2))
(func (square [x i32]) -> i32 (i32.mul x x))

(func (main)
  (let ([f (func-index double)] [g (func-index square)])
    (write-int (f 21)) (newline)
    (write-int (g 5)) (newline)
    (write-int (square 3)) (newline)))
