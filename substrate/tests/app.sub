;; An application uses the #%app bound where it is written: here the fixture's.
(require ind "fixtures/indirect-app.sub" [#%app app])
(require wasm "../compiler/wasm.sub")

(wasm:table 2)

(wasm:func (double [x i32]) -> i32 (wasm:i32.mul x 2))
(wasm:func (square [x i32]) -> i32 (wasm:i32.mul x x))

(define (main)
  (let ([f (wasm:func-index double)] [g (wasm:func-index square)])
    (write-int (f 21)) (newline)
    (write-int (g 5)) (newline)
    (write-int (square 3)) (newline)))
