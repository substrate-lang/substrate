;; A macro can lift only definitions.
(begin-for-syntax
  (require-unqualified macros "../compiler/macros.sub")
  (define (lift-require [stx datum]) -> datum
    (syntax-local-lift-definition #'(require p "../compiler/substrate.sub"))
    #'(begin)))
(define-syntax lift-require lift-require)

(define (main) (lift-require))
