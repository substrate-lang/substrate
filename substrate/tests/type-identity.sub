;; Declared types are identified as wasm identifies them (spec 5.1): by the
;; structure of their recursion group and their place in it, not by name.
;; So declarations with different names and field names, a type a macro
;; lifts, identical recursion groups, and a type a type function declares
;; in two modules are each one type, and a subtype of one declaration fits
;; another declaration of its supertype.
(require print "../lib/print.sub" write-int newline)
(require tu "fixtures/tuple.sub" tuple)
(require tr "fixtures/tuple-user.sub" make-triple)

(type point (struct (field x i32) (field y i32)))
(type size (struct (field width i32) (field height i32)))
(func (area [s (ref size)]) -> i32 (i32.mul (struct.get size width s) (struct.get size height s)))

(begin-for-syntax
  (require s syntax)
  (func (make-box [stx eqref]) -> eqref
    (drop (s:lift-definition #'(type box (struct (field v i32)))))
    #'(struct.new box 41)))
(define-syntax make-box make-box)
(type cell (struct (field v i32)))
(func (unbox [c (ref cell)]) -> i32 (struct.get cell v c))

(rec (type a1 (struct (field v i32) (field next (ref null b1))))
     (type b1 (struct (field w i64) (field next (ref null a1)))))
(rec (type a2 (struct (field v i32) (field next (ref null b2))))
     (type b2 (struct (field w i64) (field next (ref null a2)))))
(func (first-v [x (ref a2)]) -> i32 (struct.get a2 v x))

(type animal (sub (struct (field legs i32))))
(type creature (sub (struct (field legs i32))))
(type dog (sub final animal (struct (field legs i32) (field barks i32))))
(func (legs [c (ref creature)]) -> i32 (struct.get creature legs c))

(func (sum3 [t (ref (tuple i32 3))]) -> i32
  (i32.add (struct.get (tuple i32 3) f0 t)
           (i32.add (struct.get (tuple i32 3) f1 t) (struct.get (tuple i32 3) f2 t))))

(func (main)
  (write-int (area (struct.new point 6 7))) (newline)
  (write-int (unbox (make-box))) (newline)
  (write-int (first-v (struct.new a1 3 (ref.null b1)))) (newline)
  (write-int (legs (struct.new dog 4 1))) (newline)
  (write-int (sum3 (make-triple 1 2 3))) (newline))
