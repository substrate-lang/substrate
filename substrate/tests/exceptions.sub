;; Exceptions: tags, throw, throw-ref and try; another module's tag is the same tag.
(require print "../compiler/print.sub" write-int write-i64 newline)
(require t "fixtures/tags.sub" oops fail-with)
(memory from print)

(tag empty ())
(tag two (i32 i64))

(func (safe-div [a i32] [b i32]) -> i32
  (try ([catch oops (code) (i32.sub 0 code)])
    (if (i32.eqz b) (fail-with 7))
    (i32.div_s a b)))

(func (thrower) -> i32 (fail-with 5) 0)

(func (or-zero [a i32] [b i32]) #:inline -> i32
  (try ([catch oops (code) 0])
    (if (i32.eqz b) (throw oops 1))
    (i32.div_s a b)))

(begin-for-syntax
  (require k kernel)
  (tag found (i32)))
(begin-for-syntax
  (func (thrown-42 [stx i32]) -> i32
    (try ([catch found (v) v])
      (throw found #'42))))
(define-syntax thrown-42 thrown-42)

(func (catch-tail) -> i32
  (try ([catch oops (code) code])
    (thrower)))

(func (main)
  (write-int (safe-div 10 2))
  (write-int (safe-div 1 0))
  (newline)
  (try ([catch two (a b) (write-int a) (write-i64 b)])
    (throw two 3 4))
  (newline)
  (try ([catch oops (x) (write-int 1)]
        [catch-all (write-int 2)])
    (throw empty))
  (newline)
  (try ([catch oops (x) (write-int (i32.add x 100))])
    (try ([catch-ref oops (x e) (write-int x) (throw-ref e)])
      (fail-with 1)))
  (newline)
  (try ([catch oops (x) (write-int x)])
    (try ([catch-all-ref (e) (write-int 50) (throw-ref e)])
      (fail-with 2)))
  (newline)
  (write-int (catch-tail))
  (newline)
  (write-int (or-zero 6 3))
  (write-int (or-zero 1 0))
  (write-int (thrown-42))
  (newline)
  (block out
    (try ([catch oops (x) (br out)])
      (fail-with 1))
    (write-int 0))
  (write-int 9)
  (newline)
  (let ([big i64 5000000000] [c 0])
    (write-i64 (if c 0 big))
    (newline)))
