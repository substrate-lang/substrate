;; Exceptions (spec 5.2, 5.3): wasm's tags, throw, throw-ref and try, with
;; names. A tag from another module is the same tag, and exceptions need
;; no GC (see exceptions.imports).
(require print "../lib/print.sub" write-int write-i64 newline)
(require t "fixtures/tags.sub" oops fail-with)
(memory from print)
(freestanding)

(tag empty ())
(tag two (i32 i64))

;; A try's value is its body's, or that of the clause that ran.
(func (safe-div [a i32] [b i32]) -> i32
  (try ([catch oops (code) (i32.sub 0 code)])
    (if (i32.eqz b) (fail-with 7))
    (i32.div_s a b)))

(func (thrower) -> i32 (fail-with 5) 0)

;; An inline function's body, with its try, is copied into each call.
(func (or-zero [a i32] [b i32]) #:inline -> i32
  (try ([catch oops (code) 0])
    (if (i32.eqz b) (throw oops 1))
    (i32.div_s a b)))

;; At compile time: a macro whose value is thrown and caught, with a tag
;; from an earlier compile-time linklet.
(begin-for-syntax
  (require k kernel)
  (tag found (eqref)))
(begin-for-syntax
  (func (thrown-42 [stx eqref]) -> eqref
    (try ([catch found (v) v])
      (throw found (quote-syntax 42)))))
(define-syntax thrown-42 thrown-42)

;; The call in the try's body is not a tail call, which would leave the try.
(func (catch-tail) -> i32
  (try ([catch oops (code) code])
    (thrower)))

(func (main)
  (write-int (safe-div 10 2))
  (write-int (safe-div 1 0))
  (newline)
  ;; A tag's values, bound in order.
  (try ([catch two (a b) (write-int a) (write-i64 b)])
    (throw two 3 4))
  (newline)
  ;; The first clause that matches runs; catch-all matches any tag.
  (try ([catch oops (x) (write-int 1)]
        [catch-all (write-int 2)])
    (throw empty))
  (newline)
  ;; catch-ref also binds the exception, which throw-ref throws again.
  (try ([catch oops (x) (write-int (i32.add x 100))])
    (try ([catch-ref oops (x e) (write-int x) (throw-ref e)])
      (fail-with 1)))
  (newline)
  ;; catch-all-ref, to clean up and go on.
  (try ([catch oops (x) (write-int x)])
    (try ([catch-all-ref (e) (write-int 50) (throw-ref e)])
      (fail-with 2)))
  (newline)
  (write-int (catch-tail))
  (newline)
  (write-int (or-zero 6 3))
  (write-int (or-zero 1 0))
  (write-int (thrown-42))
  (newline)
  ;; A clause can branch to a label around the try.
  (block out
    (try ([catch oops (x) (br out)])
      (fail-with 1))
    (write-int 0))
  (write-int 9)
  (newline)
  ;; An exception kept in a local, thrown later.
  (let ([saved exnref (ref.null exn)])
    (try ([catch-all-ref (e) (set! saved e)])
      (fail-with 3))
    (try ([catch oops (x) (write-int x)])
      (throw-ref saved)))
  (newline)
  ;; A branch that is a literal alone takes the other branch's type.
  (let ([big i64 5000000000] [c 0])
    (write-i64 (if c 0 big))
    (newline)))
