;; Exceptions: throw, rethrow and try; another module's exception is the same exception.
(require t "fixtures/tags.sub" oops fail-with)

(exception empty)
(exception two i32 i64)

(func (safe-div [a i32] [b i32]) -> i32
  (try (if (i32.eqz b) (fail-with 7))
       (i32.div_s a b)
    [catch oops (code) (i32.sub 0 code)]))

(func (thrower) -> i32 (fail-with 5) 0)

(func (or-zero [a i32] [b i32]) #:inline -> i32
  (try (if (i32.eqz b) (throw oops 1))
       (i32.div_s a b)
    [catch oops (code) 0]))

(begin-for-syntax
  (require-unqualified syntax "../compiler/syntax.sub")
  (exception found datum))
(begin-for-syntax
  (define (thrown-42 [stx datum]) -> datum
    (try (throw found #'42) [catch found (v) v])))
(define-syntax thrown-42 thrown-42)

(func (catch-tail) -> i32
  (try (thrower) [catch oops (code) code]))

(func (main)
  (write-int (safe-div 10 2))
  (write-int (safe-div 1 0))
  (newline)
  (try (throw two 3 4) [catch two (a b) (write-int a) (write-i64 b)])
  (newline)
  (try (throw empty) [catch oops (x) (write-int 1)] [catch-all (write-int 2)])
  (newline)
  (try (try (fail-with 1) [catch oops (x) (write-int x) (rethrow)])
    [catch oops (x) (write-int (i32.add x 100))])
  (newline)
  (try (try (fail-with 2) [catch-all (write-int 50) (rethrow)])
    [catch oops (x) (write-int x)])
  (newline)
  (write-int (catch-tail))
  (newline)
  (write-int (or-zero 6 3))
  (write-int (or-zero 1 0))
  (write-int (thrown-42))
  (newline)
  (block out
    (try (fail-with 1) [catch oops (x) (br out)])
    (write-int 0))
  (write-int 9)
  (newline)
  (let ([big i64 5000000000] [c 0])
    (write-i64 (if c 0 big))
    (newline)))
