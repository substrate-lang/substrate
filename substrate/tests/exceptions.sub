;; Exceptions: throw, rethrow and try; another module's exception is the same exception.
(require t "fixtures/tags.sub" oops fail-with)
(require wasm "../compiler/wasm.sub")

(exception empty)
(exception two i32 i64)

(define (safe-div [a i32] [b i32]) -> i32
  (try (if (== b 0) (fail-with 7))
       (/ a b)
    [catch oops (code) (- 0 code)]))

(define (thrower) -> i32 (fail-with 5) 0)

(define (or-zero [a i32] [b i32]) #:inline -> i32
  (try (if (== b 0) (throw oops 1))
       (/ a b)
    [catch oops (code) 0]))

(begin-for-syntax
  (require-unqualified macros "../compiler/macros.sub")
  (exception found datum))
(begin-for-syntax
  (define (thrown-42 [stx datum]) -> datum
    (try (throw found #'42) [catch found (v) v])))
(define-syntax thrown-42 thrown-42)

(define (catch-tail) -> i32
  (try (thrower) [catch oops (code) code]))

(define (main)
  (printf "~a~a\n" (safe-div 10 2) (safe-div 1 0))
  (try (throw two 3 4) [catch two (a b) (printf "~a~a" a b)])
  (printf "\n")
  (try (throw empty) [catch oops (x) (printf "~a" 1)] [catch-all (printf "~a" 2)])
  (printf "\n")
  (try (try (fail-with 1) [catch oops (x) (printf "~a" x) (rethrow)])
    [catch oops (x) (printf "~a" (+ x 100))])
  (printf "\n")
  (try (try (fail-with 2) [catch-all (printf "~a" 50) (rethrow)])
    [catch oops (x) (printf "~a" x)])
  (printf "\n")
  (printf "~a\n" (catch-tail))
  (printf "~a~a~a\n" (or-zero 6 3) (or-zero 1 0) (thrown-42))
  (wasm:block out
    (try (fail-with 1) [catch oops (x) (wasm:br out)])
    (printf "~a" 0))
  (printf "~a\n" 9)
  (let ([big i64 5000000000] [c 0])
    (printf "~a\n" (if c 0 big))))
