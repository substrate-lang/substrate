;; The syntax module's fixnums: small integers are kept in the datum, larger ones in cells.
(require-unqualified macros "../compiler/macros.sub")

(define (show [n i32]) (printf "~a\n" n))

(define (main)
  (show (== (make-integer 5) (make-integer 5)))
  (show (== (fixnum 5) '5))
  (show (fixnum? (make-integer 1073741823)))
  (show (fixnum? (make-integer -1073741824)))
  (show (fixnum? (make-integer 1073741824)))
  (show (fixnum? (make-integer -1073741825)))
  (printf "~a\n" (integer-value (make-integer -7)))
  (printf "~a\n" (integer-value (make-integer 1073741824)))
  (printf "~a\n" (integer-value (make-unsigned-integer 18446744073709551615)))
  (show (integer-negative? (make-integer -1)))
  (show (integer-negative? (make-unsigned-integer 18446744073709551615)))
  (show (integer? (make-integer 3)))
  (show (pair? (make-integer 3)))
  (show (equal? (make-integer 12) '12))
  (show (== (datum-hash (make-integer 12)) (datum-hash '12)))
  (write-datum (cons (make-integer -3) (cons (make-integer 1073741824) nil))) (printf "\n"))
