;; Modules: qualified and unqualified names, macros that keep their bindings, phases.

(require print "../compiler/substrate.sub" write-int newline)
(require geo "fixtures/geometry.sub" [sq square])

(begin-for-syntax
  (require print "../compiler/substrate.sub")
  (require geo "fixtures/geometry.sub")
  (print:write-int (geo:square-sum 1 2))
  (print:newline))

(func (print-labelled [label i32] [n i32]) (write-int 999) (newline))

(func (main)
  (write-int (sq 7)) (newline)
  (geo:show-square 5)
  (write-int (geo:square-sum 3 4)) (newline)
  (write-int (geo:size-count)) (newline))
