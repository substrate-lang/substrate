;; Modules (spec 3). A require names the module; what it provides is bound
;; as name:thing, plus any names listed unqualified. Its macros keep
;; referring to its own bindings, even ones it does not provide and even
;; when this module defines the same names. A module required only inside
;; begin-for-syntax is not loaded at run time: see modules.links, which does
;; not list stx-util.

(require print "../lib/print.sub" write-int newline)
(require geo "fixtures/geometry.sub" [sq square])

;; The same module one phase up: its macro, used in compile-time code, runs
;; two phases up.
(begin-for-syntax
  (require print "../lib/print.sub")
  (require geo "fixtures/geometry.sub")
  (print:write-int (geo:square-sum 1 2))
  (print:newline))

;; Same name as geometry's private helper; show-square still uses geometry's.
(func (print-labelled [label i32] [n i32]) (write-int 999) (newline))

(func (main)
  (write-int (sq 7)) (newline)
  (geo:show-square 5)
  (write-int (geo:square-sum 3 4)) (newline)
  (write-int (geo:size-count)) (newline))
