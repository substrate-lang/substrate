;; Modules (spec 3). Requiring a module binds what it provides. Its macros
;; keep referring to its own bindings, even ones it does not provide and
;; even when this module defines the same names. A module required only
;; for-syntax is not loaded at run time: see modules.links, which does not
;; list stx-util. A module can be required at more than one phase.

(require "../lib/print.sub" "modules/geometry.sub"
         (for-syntax "../lib/print.sub" "modules/geometry.sub"))

;; The same module one phase up: its macro, used in compile-time code, runs
;; two phases up (geometry's phase 1 at shift 1).
(begin-for-syntax
  (write-int (square-sum 1 2))
  (newline))

;; Same name as geometry's private helper; show-square still uses geometry's.
(func (print-labelled [label i32] [n i32]) (write-int 999) (newline))

(func (main)
  (write-int (square 7)) (newline)
  (show-square 5)
  (write-int (square-sum 3 4)) (newline)
  (write-int (size-count)) (newline))
