;; match's else and _ are compared by binding, not by name
;; (lib/match.sub), so they can be imported under other names.
(require print "../lib/print.sub" write-int newline)
(require st "../lib/struct.sub" enum)
(require m "../lib/match.sub" match [otherwise else] [skip _])

(enum shape (circle [r i32]) (rect [w i32] [h i32]))

(func (width [s (ref shape)]) -> i32
  (match s [(rect w skip) w] [otherwise 0]))

(func (main)
  (write-int (width (make-rect 3 4))) (newline)
  (write-int (width (make-circle 1))) (newline))
