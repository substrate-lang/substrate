;; The new compiler's reader (next/compiler/reader.sub): what it reads,
;; the same data and source locations as the compiler's reader reads from
;; the compiler's and libraries' files, and its errors.
(require-unqualified c "../../examples/c/c.sub")
(require-unqualified stx "../../next/compiler/syntax.sub")
(require-unqualified rd "../../next/compiler/reader.sub")
(require-unqualified numbers "../../next/compiler/numbers.sub")
(require old "../../compiler/reader.sub")
(require k kernel)
(require print "../../lib/print.sub" write-int write-byte newline)
(memory from c)
(table from c)

;; The kernel's source locations, which the contract gives only lines and
;; columns of.
(import kernel-srcloc "kernel" "%syntax-srcloc" (eqref -> eqref))
(import kernel-pos "kernel" "%srcloc-pos" (eqref -> eqref))
(import kernel-span "kernel" "%srcloc-span" (eqref -> eqref))

(define (show [x i32]) (write-int x) (write-byte 32))
(define (line [d datum]) (write-datum d) (newline))

;; ---- the same as the compiler's reader ----

;; The files compared so far, and whether one differed. How many syntax
;; objects they hold changes as they do.
(define files i32 0)
(define differed i32 0)

;; Kernel string s's bytes, into a new string.
(define (string-of [s value]) -> datum
  (let ([b (make-buffer)] [d datum 0])
    (for ([i 0]) (< i (k:string-length s)) (+= i 1) (buffer-add-byte! (& b) (k:string-byte s i)))
    (set! d (bytes->string (-> b bytes) (-> b length)))
    (buffer-free! (& b))
    d))

(define (same-name? [name value] [d datum]) -> i32
  (string=? (string-of name) d))

;; Does kernel datum v read as d does, and each syntax object in it where
;; d's is?
(define (same? [v value] [d datum]) -> i32
  (when (== v 0) (return (== d 0)))
  (when (k:syntax? v)
    (return (and (syntax? d) (same-place? v (syntax-srcloc d)) (same? (k:syntax-e v) (syntax-e d)))))
  (when (k:pair? v) (return (and (pair? d) (same? (k:car v) (car d)) (same? (k:cdr v) (cdr d)))))
  (when (k:null? v) (return (null? d)))
  (when (k:boolean? v) (return (== d (boolean 1))))
  (when (k:symbol? v) (return (and (symbol? d) (same-name? (k:symbol->string v) (symbol->string d)))))
  (when (k:keyword? v) (return (and (keyword? d) (same-name? (k:keyword->string v) (keyword->string d)))))
  (when (k:string? v) (return (and (string? d) (same-name? v d))))
  (when (k:integer? v)
    (return (and (integer? d) (== (k:integer-value v) (integer-value d)) (== (k:integer-negative? v) (integer-negative? d)))))
  (when (k:flonum? v) (return (and (flonum? d) (== (f64-bits (k:flonum-value v)) (f64-bits (flonum-value d))))))
  (when (k:char? v) (return (and (char? d) (== (k:char->integer v) (char->integer d)))))
  0)

(define (same-place? [v value] [l (ptr srcloc)]) -> i32
  (let ([kl (kernel-srcloc v)])
    (or (and (== kl 0) (== l 0))
        (and (!= kl 0) (!= l 0)
             (same-name? (k:symbol->string (k:syntax-source v)) (symbol->string (-> l source)))
             (== (k:fixnum-value (k:syntax-line v)) (-> l line))
             (== (k:fixnum-value (k:syntax-column v)) (-> l col))
             (== (k:fixnum-value (kernel-pos kl)) (-> l pos))
             (== (k:fixnum-value (kernel-span kl)) (-> l span))))))

;; The file at path, a kernel string, read by both readers: the same, or
;; the first form that is not, written as the new reader reads it.
(define (compare [path value])
  (let* ([p (string-of path)] [ours (read-file p)] [theirs (old:read-file path)] [forms 0])
    (+= files 1)
    (while (k:pair? theirs)
      (unless (and (pair? ours) (same? (k:car theirs) (car ours)))
        (set! differed 1)
        (write-datum p)
        (print-string " differs at form ")
        (write-int forms)
        (newline)
        (return))
      (+= forms 1)
      (set! theirs (k:cdr theirs))
      (set! ours (cdr ours)))
    (unless (null? ours)
      (set! differed 1)
      (write-datum p)
      (print-string " has more forms")
      (newline))))

;; ---- what it reads ----

(define (read-text [text (ptr u8)]) -> datum (read-all text (strlen text) (symbol-named "t")))

;; text's data, then each's location: line, column, position and span.
(define (show-read [text (ptr u8)])
  (let ([forms (read-text text)])
    (line (syntax->datum forms))
    (while (pair? forms)
      (let ([l (syntax-srcloc (car forms))])
        (show (-> l line)) (show (-> l col)) (show (-> l pos)) (show (-> l span)))
      (set! forms (cdr forms)))
    (newline)))

;; The error text reads with, as the compiler writes it.
(define (show-error [text (ptr u8)])
  (try (begin (read-text text) (print-string "no error") (newline))
       [catch compile-error (message blamed loc)
        (let ([b (make-buffer)])
          (write-compile-error (& b) message blamed loc)
          (print-string "  ")
          (print:write-bytes (cast i32 (-> b bytes)) (-> b length))
          (buffer-free! (& b)))]))

(define (reads)
  (show-read "(a . b) [c d] () #t #true #f #false #:key #%app")
  (show-read "#\\a #\\space #\\x41 #\\x #\\λ #\\( \"t\\\\n\\\"\\x3bb;\" \"λ\"")
  (show-read "1 -2 +3 18446744073709551615 -9223372036854775808 #xff #b-101 #o17 #d99 #X1F")
  (show-read "1.5 -0.0 1e3 .5 1. +inf.0 -inf.0 0.1 1e400 1e-400 123456789012345678901234567890.0 2.2250738585072014e-308")
  (show-read "'a `b ,c ,@d #'e #`f #,g #,@h")
  (show-read "a ; comment\n #| block #| nested |# |# b #;(c d) e\n λλ f . .. 1/x -"))

(define (errors)
  (show-error "(a b")
  (show-error "(a b]")
  (show-error "  )")
  (show-error "(a . b c)")
  (show-error "(a\n  \"abc")
  (show-error "\"a\\qb\"")
  (show-error "\"\\x;\"")
  (show-error "\"\\x110000;\"")
  (show-error "\"\\x41")
  (show-error "#| a #| b |#")
  (show-error "#\\foo")
  (show-error "#(1 2)")
  (show-error "#q")
  (show-error "#")
  (show-error "'")
  (show-error "18446744073709551616")
  (show-error "-9223372036854775809")
  (show-error "#x10000000000000000")
  (show-error "1/2"))

(define (summary)
  (write-int files)
  (print-string (if differed " files compared, some differ" " files compared, all the same"))
  (newline))

(func (main)
  (reads)
  (errors)
  (compare '"../../compiler/reader.sub")
  (compare '"../../compiler/expander.sub")
  (compare '"../../compiler/compile.sub")
  (compare '"../../compiler/kernel.sub")
  (compare '"../../compiler/wasm.sub")
  (compare '"../../compiler/ops.sub")
  (compare '"../../lib/substrate-core.sub")
  (compare '"../../lib/substrate.sub")
  (compare '"../../examples/c/lang.sub")
  (compare '"../../examples/bend/core.sub")
  (compare '"../../examples/bend/bend.sub")
  (compare '"../decimals.sub")
  (compare '"../numbers.sub")
  (compare '"../substrate-flonums.sub")
  (compare '"../substrate-library.sub")
  (compare '"../keywords.sub")
  (compare '"../datum.sub")
  (summary))
