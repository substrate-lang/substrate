;; Keywords (spec 2.3, 5.4): #:name reads as a keyword, a kind of datum of
;; its own, interned by name. Quoted, one is a value; a macro gets one in
;; its input as syntax, and can return it.
(require k kernel)
(require sub "../lib/substrate.sub" write)
(require print "../lib/print.sub" newline write-int)

(begin-for-syntax
  (require k kernel)
  ;; (flag-of form #:flag) => '(#:flag 1), 1 as #:flag is a keyword.
  (func (flag-of [stx eqref]) -> eqref
    (let ([k (k:caddr (k:syntax->list stx))])
      #`(quote (#,k #,(k:datum->syntax k (k:fixnum (k:keyword? (k:syntax-e k))) k))))))
(define-syntax flag-of flag-of)

(func (main)
  (write-int (k:keyword? '#:mutable)) (print:newline)
  (write-int (k:symbol? '#:mutable)) (print:newline)
  (write-int (ref.eq '#:a (k:string->keyword (k:keyword->string '#:a)))) (print:newline)
  (write (flag-of x #:transparent)) (print:newline))
