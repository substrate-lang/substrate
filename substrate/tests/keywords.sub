;; Keywords (spec 2.3, 5.4): #:name reads as a keyword, a kind of datum of
;; its own, interned by name. Quoted, one is a value; a macro gets one in
;; its input as syntax, and can return it.
(require s syntax)
(require wd "../lib/write-datum.sub" write-datum)
(require print "../lib/print.sub" newline write-int)

(begin-for-syntax
  (require s syntax)
  ;; (flag-of form #:flag) => '(#:flag 1), 1 as #:flag is a keyword.
  (func (flag-of [stx eqref]) -> eqref
    (let ([k (s:caddr (s:syntax->list stx))])
      #`(quote (#,k #,(s:datum->syntax k (s:fixnum (s:keyword? (s:syntax-e k))) k))))))
(define-syntax flag-of flag-of)

(func (main)
  (write-int (s:keyword? '#:mutable)) (print:newline)
  (write-int (s:symbol? '#:mutable)) (print:newline)
  (write-int (ref.eq '#:a (s:string->keyword (s:keyword->string '#:a)))) (print:newline)
  (write-datum (flag-of x #:transparent)) (print:newline))
