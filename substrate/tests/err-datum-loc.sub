;; An error in code a macro builds points at the code the user wrote.
(begin-for-syntax
  (require-unqualified k "../compiler/syntax.sub")
  (define (use-missing [stx datum]) -> datum
    (datum->syntax stx 'no-such-thing stx)))
(define-syntax use-missing use-missing)

(func (main) (drop (use-missing)))
