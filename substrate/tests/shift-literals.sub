;; A syntax literal can hold another module's scope, here shift-n's, in a
;; literal built by shift-m's code. When shift-m's code runs at a shift,
;; every module scope in its literals is shifted with it (spec 6.1), so
;; (emit) works at phase 1 as at phase 0: each prints 42 while compiling.
(require m "fixtures/shift-m.sub" emit)
(emit)
(begin-for-syntax
  (require m "fixtures/shift-m.sub" emit)
  (emit))
(func (main))
