;; Two different types named binop: the error tells them apart.
(begin-for-syntax
  (require k kernel)
  (func (null-op [stx i32]) -> i32
    (drop (k:syntax-local-lift-definition #'(type binop (func (i64 i64 -> i64)))))
    #'(ref.null binop)))
(define-syntax null-op null-op)

(type binop (func (i32 i32 -> i32)))
(func (apply [f (ref null binop)]) -> i32 (call-ref binop f 1 2))

(func (main) (drop (apply (null-op))))
