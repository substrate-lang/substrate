;; Two different types named box: the error tells them apart.
(begin-for-syntax
  (require k kernel)
  (func (make-box [stx i32]) -> i32
    (drop (k:syntax-local-lift-definition #'(type box (struct (field v i64)))))
    #'(struct.new box 1)))
(define-syntax make-box make-box)

(type box (struct (field v i32)))
(func (unbox [b (ref box)]) -> i32 (struct.get box v b))

(func (main) (drop (unbox (make-box))))
