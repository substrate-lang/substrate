;; Two declarations with the same name are two types (spec 5.1), and the
;; error says so. make-box lifts its own box type, which the module's box
;; cannot name.
(begin-for-syntax
  (require s syntax)
  (func (make-box [stx eqref]) -> eqref
    (drop (s:lift-definition #'(type box (struct (field v i32)))))
    #'(struct.new box 1)))
(define-syntax make-box make-box)

(type box (struct (field v i32)))
(func (unbox [b (ref box)]) -> i32 (struct.get box v b))

(func (main) (drop (unbox (make-box))))
