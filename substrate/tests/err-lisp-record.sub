;; A record accessor takes only records of its own declaration, even one
;; with the same fields (lib/lisp.sub).
(require-unqualified l "../lib/lisp.sub")
(define-record-type point (make-point x y) point? (x point-x) (y point-y))
(define-record-type vec2 (make-vec2 x y) vec2? (x vec2-x) (y vec2-y))
(define (run) (point-x (make-vec2 1 2)))
(func (main) (run))
