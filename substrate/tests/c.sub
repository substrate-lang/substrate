;; The C example's language (examples/c/lang.sub): layouts, places,
;; conversions, control and pointers, a line of results for each.
(require-unqualified c "../examples/c/c.sub")
(require print "../lib/print.sub" write-int write-i64 write-u64 write-byte newline)
(memory from print)

(typedef size u32)
(struct inner [a u8] [b i64] [c u16])
(struct outer [tag i32] [in inner] [name (array u8 8)] [self (ptr outer)])

(define (show [x i32]) (write-int x) (write-byte 32))

;; C's sizes and offsets: a field at a multiple of its alignment, a struct
;; a multiple of its largest; & of a field of a null pointer is its
;; offset, which offsetof gives as a constant.
(define (layouts)
  (show (sizeof inner))
  (show (sizeof outer))
  (show (sizeof (array u16 5)))
  (let ([o (ptr outer) 0])
    (show (cast i32 (& (-> o in c))))
    (show (cast i32 (& (-> o self)))))
  (show (offsetof outer name))
  (newline))

;; A struct in a struct, an array in a struct, and a pointer back.
(define (places)
  (let ([o (cast (ptr outer) (calloc 1 (sizeof outer)))])
    (set! (-> o in b) -5)
    (set! (-> o in c) 65535)
    (set! (-> o self) o)
    (set! (@ (-> o name) 0) #\o)
    (set! (@ (-> o name) 1) #\k)
    (write-i64 (-> o self in b)) (write-byte 32)
    (show (-> o in c))
    (print-string (-> o name))
    (free o))
  (newline))

;; Narrower integers: loads extend by sign or zero, and a variable wraps.
(define (narrow)
  (let ([p (cast (ptr u8) (malloc 8))])
    (set! (@ p 0) 200)
    (show (@ p 0))
    (show (@ (cast (ptr i8) p) 0))
    (set! (@ (cast (ptr u16) p) 1) 40000)
    (show (@ (cast (ptr i16) p) 1))
    (show (@ (cast (ptr u16) p) 1))
    (let ([c i8 127]) (set! c (+ c 1)) (show c))
    (free p))
  (newline))

;; A decimal takes f32 from the f32 it meets; conversions truncate.
(define (floats)
  (let ([x f32 1.5] [y (/ 7 2.0)])
    (set! x (* x 0.5))
    (show (cast i32 (* x 100)))
    (show (cast i32 (* y 4)))
    (show (cast i32 -2.7))
    (show (cast i32 (cast f32 16777217)))
    (write-i64 (cast i64 (cast f64 (cast u32 -1)))))
  (newline))

(define (wide)
  (let ([a u64 -1] [b i64 -9])
    (write-u64 a) (write-byte 32)
    (show (> a 1))
    (write-i64 (/ b 2)) (write-byte 32)
    (write-u64 (>> a 60)) (write-byte 32)
    (write-u64 (cast u64 (cast u32 -1))) (write-byte 32)
    (write-i64 (<< (cast i64 1) 40)))
  (newline))

(define count i32 0)
(define (tick [v i32]) -> i32 (set! count (+ count 1)) v)

;; and and or stop at the first value that decides them.
(define (logic)
  (show (and (tick 1) (tick 0) (tick 1)))
  (show (or (tick 0) (tick 5)))
  (show count)
  (show (not 7))
  (unless (== count 3) (show 99))
  (let* ([a 2] [b (* a 3)]) (show b))
  (show (if (> count 3) 10 20))
  (newline))

;; The pair i < j whose squares sum to n, as i * 100 + j, or -1: a return
;; from two loops.
(define (two-squares [n i32]) -> i32
  (for ([i 1]) (< (* i i) n) (set! i (+ i 1))
    (for ([j (+ i 1)]) (<= (+ (* i i) (* j j)) n) (set! j (+ j 1))
      (when (== (+ (* i i) (* j j)) n) (return (+ (* i 100) j)))))
  -1)

(define (odd-sum [n i32]) -> i32
  (let ([s 0])
    (for ([i 0]) (< i n) (set! i (+ i 1))
      (when (== (% i 2) 0) (continue))
      (set! s (+ s i)))
    s))

;; Each calls the other, defined after it, in tail position.
(define (even [n size]) -> i32 (if (== n 0) 1 (odd (- n 1))))
(define (odd [n size]) -> i32 (if (== n 0) 0 (even (- n 1))))

;; Globals, given their values when the module starts.
(define limit i32 (two-squares 50))
(define limit-at (ptr i32) (& limit))

(define (control)
  (show (two-squares 25))
  (show (two-squares 50))
  (show (two-squares 3))
  (show (odd-sum 10))
  (show (even 100001))
  (show (@ limit-at))
  (newline))

;; Pointer arithmetic is scaled, and - on two pointers counts elements.
(define (pointers)
  (let* ([a (cast (ptr i32) (malloc (* 5 (sizeof i32))))] [end (+ a 5)] [k 0])
    (for ([p a]) (< p end) (set! p (+ p 1))
      (set! (@ p) (* k k))
      (set! k (+ k 1)))
    (show (- end a))
    (show (@ end -1))
    (let ([i -2]) (show (@ end i)))
    (show (- (cast i32 end) (cast i32 a)))
    (show (@ (+ 1 a) 1))
    (set! a (cast (ptr i32) (realloc a (* 100 (sizeof i32)))))
    (show (@ a 4))
    (free a))
  (newline))

(define (strings)
  (print-string "tab\there\n")
  (show (cast i32 (strlen "hello")))
  (show (@ "AB" 1))
  (show #\z)
  (newline))

(define (main)
  (layouts)
  (places)
  (narrow)
  (floats)
  (wide)
  (logic)
  (control)
  (pointers)
  (strings))
