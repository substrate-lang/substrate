;; A module pass (spec 6.6) rewrites the module's fully expanded code. The
;; fixture's pass counts calls: 3 for the first line of main, 1 for
;; newline, and 2 for (write-int (call-count)) before call-count reads it.
(require print "../lib/print.sub" write-int newline)
(require cc "fixtures/count-calls.sub" count-calls)

(count-calls)

(func (call-count) -> i32 0)
(func (square [x i32]) -> i32 (i32.mul x x))

(func (main)
  (write-int (square (square 2))) (newline)
  (write-int (call-count)) (newline))
