;; Inline functions (spec 5.2): a call is compiled as the body, in the
;; defining module and in others, at phase 0 and at phase 1, and does what
;; the call would.
(require print "../lib/print.sub" write-int newline)
(require lib "fixtures/inline-lib.sub")
(require s syntax)

(begin-for-syntax
  (require print "../lib/print.sub")
  (require lib "fixtures/inline-lib.sub")
  (print:write-int (lib:add2 20 22))
  (print:newline))

(func (twice [x i32]) #:inline -> i32 (i32.add x x))

(func (main)
  (write-int (twice (twice 3))) (newline)
  ;; Calls in the arguments are inlined too, each with its own locals.
  (write-int (lib:add2 (lib:add2 1 2) (lib:add2 3 4))) (newline)
  (write-int (lib:count)) (newline)
  (write-int (lib:clamp 5 0 3)) (write-int (lib:clamp -2 0 3)) (write-int (lib:clamp 2 0 3)) (newline)
  ;; b has the declared result type, eqref, so it can be set to null.
  (let ([b (lib:fresh-box 1)])
    (set! b (ref.null eq))
    (write-int (ref.is_null b)))
  (newline)
  (write-int (ref.eq (lib:yes-or-no 1) 'yes)) (write-int (ref.eq (lib:yes-or-no 0) 'no)) (newline))
