;; Inline functions: a call is compiled as the body, in any module, at phase 0 and 1.
(require print "../compiler/print.sub" write-int newline)
(require lib "fixtures/inline-lib.sub")
(require k kernel)
(memory from k)

(begin-for-syntax
  (require print "../compiler/print.sub")
  (require lib "fixtures/inline-lib.sub")
  (print:write-int (lib:add2 20 22))
  (print:newline))

(func (twice [x i32]) #:inline -> i32 (i32.add x x))

(func (main)
  (write-int (twice (twice 3))) (newline)
  (write-int (lib:add2 (lib:add2 1 2) (lib:add2 3 4))) (newline)
  (write-int (lib:count)) (newline)
  (write-int (lib:clamp 5 0 3)) (write-int (lib:clamp -2 0 3)) (write-int (lib:clamp 2 0 3)) (newline)
  (write-int (i32.eq (lib:yes-or-no 1) 'yes)) (write-int (i32.eq (lib:yes-or-no 0) 'no)) (newline))
