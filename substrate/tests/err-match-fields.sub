;; A pattern has one name per field (examples/shapes/match.sub).
(require st "../examples/shapes/struct.sub" struct enum)
(require m "../examples/shapes/match.sub" match)
(enum shape (circle [r i32]) (square [side i32]) (rect [w i32] [h i32]))

(func (area [s (ref shape)]) -> i32
  (match s [(circle r) r] [(square side) side] [(rect w) w]))
(func (main))
