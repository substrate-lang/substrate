;; Names (spec 6.7): a definition's name is the same whatever it is seen
;; under, a qualified import, another name or a phase shift; two
;; definitions of one symbol that hygiene keeps apart have two; a local
;; variable and the kernel module's functions have none; and a name leads
;; back to its definition.
(require-unqualified substrate "../lib/substrate.sub")
(begin-for-syntax (require-unqualified substrate "../lib/substrate.sub") (require k kernel))
(require a "fixtures/names-a.sub" [renamed thing])

;; The name of what id refers to, and the compile-time value the name leads
;; back to, on a line.
(define-syntax (show stx)
  (syntax-match stx
    [(_ id) (let ([n (k:identifier-name id)])
              #`(begin (write '(#,n #,(and n (syntax-local-value (k:name-identifier n))))) (newline)))]))

(define-syntax mine 'my-thing)

;; Each use defines secret, which its introduction scope keeps apart.
(define-syntax (secret stx)
  (syntax-match stx [(_ v) #`(begin (define-syntax secret '#,v) (show secret))]))

(define-syntax (show-local stx) #`(let ([x 1]) (show x)))

(require kf kernel)

;; At phase 1, facts-a's thing is the definition it is at phase 0.
(begin-for-syntax
  (require a1 "fixtures/names-a.sub")
  (begin-for-syntax (require-unqualified substrate "../lib/substrate.sub") (require k kernel))
  (define-syntax (name-of stx)
    (syntax-match stx [(_ id) (let ([n (k:identifier-name id)]) #`'(#,n #,(syntax-local-value (k:name-identifier n))))]))
  (define at-phase-1 (name-of a1:thing)))
(define-syntax (phase-1-name stx) #`'#,at-phase-1)

(show a:thing)
(show renamed)
(show mine)
(secret one)
(secret two)
(show-local)
(show kf:car)
(show cons)
(write (phase-1-name))
(newline)
(define (main) #f)
