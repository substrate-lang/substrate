;; Facts (spec 6.6): each module's after those of the modules it requires,
;; each module once, whatever name the definition is seen under; what a
;; module's #%linklet drops, returns and lifts; facts about a definition
;; it replaced; and facts at a phase shift.
(require-unqualified substrate "../lib/substrate.sub")
(begin-for-syntax (require-unqualified substrate "../lib/substrate.sub") (require k kernel))
(require a "fixtures/facts-a.sub")
(require b "fixtures/facts-b.sub")
(require c "fixtures/facts-c.sub")
(require hl "fixtures/facts-hook.sub" thing2)
(require d "fixtures/facts-d.sub")
(#%fact a:thing (from here))

;; Each fact about id's definition, written on a line.
(define-syntax (show stx)
  (syntax-match stx
    [(_ id) #`(begin #,@(map (lambda (f) #`(begin (write '#,(list (car f) (cadr f) (syntax->datum (caddr f)))) (newline)))
                             (k:syntax-local-facts id)))]))

;; At phase 1, facts-b's facts are about facts-a's thing required there.
(begin-for-syntax
  (require a1 "fixtures/facts-a.sub")
  (require b1 "fixtures/facts-b.sub")
  (begin-for-syntax (require-unqualified substrate "../lib/substrate.sub") (require k kernel))
  (define-syntax (count stx) #`'#,(length (k:syntax-local-facts #'a1:thing)))
  (define at-phase-1 (count)))
(define-syntax (phase-1-count stx) #`'#,at-phase-1)

(define (main)
  (show a:thing)
  (show thing2)
  (show d:f)
  (write (phase-1-count))
  (newline))
