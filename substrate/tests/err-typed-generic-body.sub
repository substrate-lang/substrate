;; A generic's body is checked in each of its instances, at their types
;; (examples/typed/typed.sub): bad<Bool> adds 1 to a Bool.
(require-unqualified typed "../examples/typed/typed.sub")
(define #:forall (T) (bad [x : T]) : T
  (+ x 1))
(define (f) : Int (if (bad #t) 1 0))
(func (main) (drop (f)))
