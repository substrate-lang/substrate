;; A linklet's quoted data is serialized into a data segment and rebuilt
;; when the linklet starts (spec 3.5): each kind of datum survives the trip,
;; and equal symbols are one reference.
(require s syntax)
(require print "../lib/print.sub" write-int newline)
(require wd "../lib/write-datum.sub" write-datum)

(func (show [x eqref]) (write-datum x) (print:newline))

(func (main)
  (show '(a "b" #\c -7 1073741824 -9223372036854775808 18446744073709551615 (#t #f ()) 2.5))
  (show (s:syntax->datum #'(lambda (x) (f x "s" 3))))
  (print:write-int (ref.eq 'same 'same)) (print:newline)
  (print:write-int (f64.eq (s:flonum-value '2.5) 2.5)) (print:newline))
