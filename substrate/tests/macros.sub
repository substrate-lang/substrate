;; Macros (spec 6.2): a transformer is a kernel function, compiled to wasm
;; in its own chunk and called through the shared table at compile time.

;; A transformer written longhand.
;; (swap! a b) => (let ([tmp a]) (set! a b) (set! b tmp))
(begin-for-syntax
  (func (swap!-transformer [stx i32]) -> i32
    (let* ([parts (syntax->list stx)]
           [a (cadr parts)]
           [b (caddr parts)])
      #`(let ([tmp #,a]) (set! #,a #,b) (set! #,b tmp)))))

(define-syntax swap! (make-procedure (func-index swap!-transformer)))

;; define-macro is itself a macro:
;;   (define-macro (name stx) body ...)
;; defines a phase-1 function `name` and binds the phase-0 macro `name` to
;; it. The two `name`s live at different phases, so they do not collide.
(begin-for-syntax
  (func (define-macro-transformer [stx i32]) -> i32
    (let* ([parts (syntax->list stx)]
           [head (syntax->list (cadr parts))]
           [name (car head)]
           [arg (cadr head)])
      #`(begin
          (begin-for-syntax
            (func (#,name [#,arg i32]) -> i32 #,@(cddr parts)))
          (define-syntax #,name (make-procedure (func-index #,name)))))))

(define-syntax define-macro (make-procedure (func-index define-macro-transformer)))

;; (while test body ...)
(define-macro (while stx)
  (let ([parts (syntax->list stx)])
    #`(block break
        (loop continue
          (br-if break (i32.eqz #,(cadr parts)))
          #,@(cddr parts)
          (br continue)))))

;; (unless test body ...)
(define-macro (unless stx)
  (let ([parts (syntax->list stx)])
    #`(if #,(cadr parts) (nop) (begin #,@(cddr parts)))))

;; cond, with a phase-1 helper that recurs over the clauses. `else` is
;; recognized with free-identifier=?.
(begin-for-syntax
  (func (cond-clauses [clauses i32]) -> i32
    (if (null? clauses) (return #'(nop)))
    (let* ([clause (syntax->list (car clauses))]
           [test (car clause)]
           [body (cdr clause)])
      (if (if (identifier? test) (free-identifier=? test #'else) #f)
          #`(begin #,@body)
          #`(if #,test (begin #,@body) #,(cond-clauses (cdr clauses)))))))

(define-macro (cond stx) (cond-clauses (cdr (syntax->list stx))))

;; Phase-1 code can run arbitrary computation while the module compiles.
(begin-for-syntax
  (display "compile time: ")
  (write (reverse '(3 2 1)))
  (newline))

(func (classify [n i32])
  (cond [(i32.lt_s n 0) (display "negative")]
        [(i32.eqz n) (display "zero")]
        [else (display "positive")])
  (newline))

(func (main)
  (let ([x 1] [y 2])
    (swap! x y)
    (write-int x) (write-int y) (newline))
  (let ([i 0])
    (while (i32.lt_s i 5)
      (write-int i)
      (set! i (i32.add i 1)))
    (newline))
  (unless (i32.eq 1 2) (display "unless works") (newline))
  (classify -5)
  (classify 0)
  (classify 12))
