;; Macros (spec 2): a transformer is a phase-1 function from syntax to
;; syntax. The expander calls it while compiling, and it runs as wasm.
;; Syntax objects are GC references (eqref); the program itself uses no GC
;; and imports only print (see macros.imports).

(require print "../lib/print.sub" write-int newline write-bytes)
(require m "fixtures/macro.sub" define-macro)
(memory from print)

;; Compile-time code has its own requires, one phase up.
(begin-for-syntax
  (require s syntax)
  (require print "../lib/print.sub")
  (require sub "../lib/substrate.sub"))

;; A transformer written longhand, then bound with define-syntax.
;; (swap! a b) => (let ([tmp a]) (set! a b) (set! b tmp))
(begin-for-syntax
  (func (swap! [stx eqref]) -> eqref
    (let* ([parts (s:syntax->list stx)]
           [a (s:cadr parts)]
           [b (s:caddr parts)])
      #`(let ([tmp #,a]) (set! #,a #,b) (set! #,b tmp)))))

(define-syntax swap! swap!)

;; (while test body ...), with define-macro from tests/fixtures/macro.sub.
(define-macro (while stx)
  (let ([parts (s:syntax->list stx)])
    #`(block break
        (loop continue
          (br-if break (i32.eqz #,(s:cadr parts)))
          #,@(s:cddr parts)
          (br continue)))))

;; (unless test body ...)
(define-macro (unless stx)
  (let ([parts (s:syntax->list stx)])
    #`(if #,(s:cadr parts) (nop) (begin #,@(s:cddr parts)))))

;; cond, with a phase-1 helper that recurs over the clauses. `else` is
;; recognized with free-identifier=?.
(begin-for-syntax
  (func (cond-clauses [clauses eqref]) -> eqref
    (if (s:null? clauses) (return #'(nop)))
    (let* ([clause (s:syntax->list (s:car clauses))]
           [test (s:car clause)]
           [body (s:cdr clause)])
      (if (if (s:identifier? test) (s:free-identifier=? test #'else) 0)
          #`(begin #,@body)
          #`(if #,test (begin #,@body) #,(cond-clauses (s:cdr clauses)))))))

(define-macro (cond stx) (cond-clauses (s:cdr (s:syntax->list stx))))

;; Phase-1 code can run any computation while the module compiles. It uses
;; its own instances of the printing modules, separate from phase 0.
(begin-for-syntax
  (memory from print)
  (data label 1024 "compile time: ")
  (print:write-bytes (data-address label) (data-size label))
  (sub:write (s:reverse '(3 2 1)))
  (print:newline))

(data negative 1024 "negative")
(data zero 1032 "zero")
(data positive 1040 "positive")

(func (classify [n i32])
  (cond [(i32.lt_s n 0) (write-bytes (data-address negative) (data-size negative))]
        [(i32.eqz n) (write-bytes (data-address zero) (data-size zero))]
        [else (write-bytes (data-address positive) (data-size positive))])
  (newline))

(func (main)
  (let ([x 1] [y 2])
    (swap! x y)
    (write-int x) (write-int y) (newline))
  (let ([i 0])
    (while (i32.lt_s i 5)
      (write-int i)
      (set! i (i32.add i 1)))
    (newline))
  (unless (i32.eq 1 2) (write-int 42) (newline))
  (classify -5)
  (classify 0)
  (classify 12))
