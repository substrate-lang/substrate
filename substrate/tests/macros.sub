;; Macros (spec 2): a transformer is a phase-1 function from syntax to
;; syntax. The expander calls it while compiling, and it runs as wasm.
;; Syntax objects are GC references (eqref); the program itself uses no GC
;; and imports only the host (see macros.links).

(include "../lib/print.sub")
(include "../lib/macro.sub")

;; A transformer written longhand, then bound with define-syntax.
;; (swap! a b) => (let ([tmp a]) (set! a b) (set! b tmp))
(begin-for-syntax
  (require syntax)
  (func (swap! [stx eqref]) -> eqref
    (let* ([parts (syntax->list stx)]
           [a (cadr parts)]
           [b (caddr parts)])
      #`(let ([tmp #,a]) (set! #,a #,b) (set! #,b tmp)))))

(define-syntax swap! swap!)

;; (while test body ...), with define-macro from lib/macro.sub.
(define-macro (while stx)
  (let ([parts (syntax->list stx)])
    #`(block break
        (loop continue
          (br-if break (i32.eqz #,(cadr parts)))
          #,@(cddr parts)
          (br continue)))))

;; (unless test body ...)
(define-macro (unless stx)
  (let ([parts (syntax->list stx)])
    #`(if #,(cadr parts) (nop) (begin #,@(cddr parts)))))

;; cond, with a phase-1 helper that recurs over the clauses. `else` is
;; recognized with free-identifier=?.
(begin-for-syntax
  (func (cond-clauses [clauses eqref]) -> eqref
    (if (null? clauses) (return #'(nop)))
    (let* ([clause (syntax->list (car clauses))]
           [test (car clause)]
           [body (cdr clause)])
      (if (if (identifier? test) (free-identifier=? test #'else) 0)
          #`(begin #,@body)
          #`(if #,test (begin #,@body) #,(cond-clauses (cdr clauses)))))))

(define-macro (cond stx) (cond-clauses (cdr (syntax->list stx))))

;; Phase-1 code can run any computation while the module compiles. This
;; block has its own memory and printing functions, separate from phase 0.
(begin-for-syntax
  (include "../lib/print.sub")
  (include "../lib/write-datum.sub")
  (data label 1024 "compile time: ")
  (write-bytes (data-address label) (data-size label))
  (write-datum (reverse '(3 2 1)))
  (newline))

(data negative 1024 "negative")
(data zero 1032 "zero")
(data positive 1040 "positive")

(func (classify [n i32])
  (cond [(i32.lt_s n 0) (write-bytes (data-address negative) (data-size negative))]
        [(i32.eqz n) (write-bytes (data-address zero) (data-size zero))]
        [else (write-bytes (data-address positive) (data-size positive))])
  (newline))

(func (main)
  (let ([x 1] [y 2])
    (swap! x y)
    (write-int x) (write-int y) (newline))
  (let ([i 0])
    (while (i32.lt_s i 5)
      (write-int i)
      (set! i (i32.add i 1)))
    (newline))
  (unless (i32.eq 1 2) (write-int 42) (newline))
  (classify -5)
  (classify 0)
  (classify 12))
