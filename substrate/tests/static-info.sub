;; define-static binds a compile-time value that is not a macro. Macros read
;; it with syntax-local-value. This is how a struct form and a match form
;; will talk to each other.

(require print "../lib/print.sub" write-int newline)
(begin-for-syntax (require s syntax))

(define-static point '(x y))
(define-static color '(red green blue alpha))

;; (field-count T) expands to the number of fields recorded for T.
(begin-for-syntax
  (func (field-count [stx eqref]) -> eqref
    (let* ([name (s:cadr (s:syntax->list stx))]
           [fields (s:syntax-local-value name)])
      (if (i32.eqz (s:pair? fields))
          (s:syntax-error name '"has no static field information"))
      (s:datum->syntax stx (s:fixnum (s:length fields))))))
(define-syntax field-count field-count)

;; (field-index T f) expands to f's position in T, or is a compile error.
(begin-for-syntax
  (func (field-index [stx eqref]) -> eqref
    (let* ([parts (s:syntax->list stx)]
           [fields (s:syntax-local-value (s:cadr parts))]
           [field (s:syntax-e (s:caddr parts))]
           [i 0])
      (block done
        (loop next
          (if (s:null? fields) (s:syntax-error (s:caddr parts) '"no such field"))
          (br-if done (ref.eq (s:car fields) field))
          (set! fields (s:cdr fields))
          (set! i (i32.add i 1))
          (br next)))
      (s:datum->syntax stx (s:fixnum i)))))
(define-syntax field-index field-index)

(func (main)
  (write-int (field-count point)) (newline)
  (write-int (field-count color)) (newline)
  (write-int (field-index color blue)) (newline))
