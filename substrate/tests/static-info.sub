;; A compile-time value that is not a procedure is static information
;; (spec 6.2). Macros read it with syntax-local-value. This is the protocol
;; a struct form and a match form will use to talk to each other.

(define-syntax point '(x y))
(define-syntax color '(red green blue alpha))

;; (field-count T) expands to the number of fields recorded for T.
(begin-for-syntax
  (func (field-count [stx i32]) -> i32
    (let* ([name (cadr (syntax->list stx))]
           [fields (syntax-local-value name)])
      (if (i32.eqz (pair? fields))
          (syntax-error name "has no static field information"))
      (datum->syntax stx (length fields)))))
(define-syntax field-count (make-procedure (func-index field-count)))

;; (field-index T f) expands to f's position in T, or is a compile error.
(begin-for-syntax
  (func (field-index [stx i32]) -> i32
    (let* ([parts (syntax->list stx)]
           [fields (syntax-local-value (cadr parts))]
           [field (syntax-e (caddr parts))]
           [i 0])
      (block done
        (loop next
          (if (null? fields) (syntax-error (caddr parts) "no such field"))
          (br-if done (eq? (car fields) field))
          (set! fields (cdr fields))
          (set! i (i32.add i 1))
          (br next)))
      (datum->syntax stx (fixnum i)))))
(define-syntax field-index (make-procedure (func-index field-index)))

(func (main)
  (write-int (field-count point)) (newline)
  (write-int (field-count color)) (newline)
  (write-int (field-index color blue)) (newline))
