;; Syntax data holds every number literal (spec 2.3, 5.4): integers of up
;; to 64 bits and floats. So a macro's input can hold them, and quote
;; makes values of them.
(require print "../lib/print.sub" write-int write-i64 newline)
(require sub "../lib/substrate.sub" write)
(require s syntax)

;; (id e) => e
(begin-for-syntax
  (require s syntax)
  (func (id [stx eqref]) -> eqref (s:cadr (s:syntax->list stx))))
(define-syntax id id)

(global big i64 (id 5000000000))
(global half f64 (id 1.5))
(global all-ones i64 (id #xFFFFFFFFFFFFFFFF))

(func (main)
  (write-i64 big) (newline)
  (write-int (f64.eq half 1.5)) (newline)
  (write-i64 all-ones) (newline)
  (write '(5000000000 -5000000000 #xFFFFFFFFFFFFFFFF 7)) (newline)
  (write-int (f64.eq (s:flonum-value '2.25) 2.25)) (newline)
  (write-i64 (s:integer-value '-9223372036854775808)) (newline)
  (write-int (s:integer-negative? '#xFFFFFFFFFFFFFFFF)) (newline))
