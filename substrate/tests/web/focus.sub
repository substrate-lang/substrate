;; A regression test for events that fire while the page is being
;; updated. tests/web/pages.mjs runs it in a browser.
;;
;; Clicking "turn" increases `turns`. The view gives the text field the
;; keyboard focus each time `turns` changes ([focus (-> m turns)]), and
;; the program also listens for the field's focus event. So this happens:
;;
;;   1. The program writes its page changes (patches) and calls the host
;;      to apply them.
;;   2. As part of applying them, the host gives the field the focus. The
;;      browser fires the focus event at once, and the host calls the
;;      program again, before the call of step 1 has returned.
;;   3. The program handles the event and writes a second set of changes.
;;
;; The first set of changes must be applied exactly once. If it were
;; applied twice, the "turned" mark below would appear twice on the page.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified ui "../../lib/web/ui.sub")
(require-unqualified web "../../lib/web/web.sub")
(memory from base)
(table from base)

(struct model [turns u32] [focused u32] [blurred u32])
(variant message [turn] [got-focus] [lost-focus])
(messages message)

(define (init [m (ptr model)]) (set! (-> m turns) 0))

(define (update [m (ptr model)] [e (ptr message)])
  (match e
    [turn (+= (-> m turns) 1)]
    [got-focus (+= (-> m focused) 1)]
    [lost-focus (+= (-> m blurred) 1)]))

(view (page [m (ptr model)])
  (button ([id "turn"] [on click turn]) "turn")
  (input ([id "field"] [focus (-> m turns)] [on focus got-focus] [on blur lost-focus]))
  (p ([id "counts"]) (int (-> m turns)) " " (int (-> m focused)) " " (int (-> m blurred)))
  (when (> (-> m turns) 0) (span ([class "mark"]) "turned")))

(app model message init update page)
