;; A game that traps while it is being set up: the page shows the report.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified trap "../../lib/web/game/trap.sub")
(require-unqualified input "../../lib/web/game/input.sub")
(require-unqualified game "../../lib/web/game/game.sub")
(memory from base)
(table from base)

(struct world [ready i32])

(define (start! [w (ptr world)])
  (trap-format "the level file ~s is missing" "assets/levels/1.txt")
  (set! (-> w ready) 1))

;; If either of these ran, it would trap with a different message, which
;; the test would see.
(define (step! [w (ptr world)] [in (ptr input)])
  (unless (-> w ready) (trap "step was called for a world that was not set up")))

(define (draw [w (ptr world)])
  (unless (-> w ready) (trap "draw was called for a world that was not set up")))

(game world [size 64 36] start! step! draw)
