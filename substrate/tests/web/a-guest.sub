;; A test program that is run as a guest. guests.sub (a web page) starts
;; it and sends it commands; tests/web/pages.mjs checks the results.
;; lib/web/guest.sub explains what a guest is.
;;
;; Each message is a command, as text. The guest carries it out and sends
;; back one reply, also text:
;;
;;   add N        adds N to a running total and replies "total T". The
;;                total shows that a guest keeps its state between
;;                messages.
;;   say TEXT     writes TEXT to standard output, replies "said"
;;   warn TEXT    writes TEXT to standard error, replies "warned"
;;   read PATH    tries to read a file and replies with its size or with
;;                the error
;;   write PATH   tries to write a file and replies "wrote" or the error
;;   trap         divides by zero, which traps (crashes). The on-trap
;;                function below then replies "trapped: ...".
;;   loop         loops forever and never replies
;;   grow N       allocates memory until it runs out, to test a memory
;;                limit of N mebibytes
;;   guest        tries to start a guest of its own, which is not allowed
;;   exit N       exits with status N
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified guest "../../lib/web/guest.sub")
(memory from base)
(table from base)

;; The standard host functions (spec section 4).
(import host-write "host" "write" (i32 i32 i32 -> i32))
(import host-read-file "host" "read_file" (i32 i32 i32 i32 -> i32))
(import host-write-file "host" "write_file" (i32 i32 i32 i32 -> i32))
(import host-error-message "host" "error_message" (i32 i32 -> i32))
(import host-arg-count "host" "arg_count" (-> i32))
(import host-arg "host" "arg" (i32 i32 i32 -> i32))
(import host-exit "host" "exit" (i32 ->))

;; The running total for the "add" command.
(define total i64 0)
;; A zero the compiler cannot see through, for the "trap" command.
(define zero i32 0)

;; Returns 1 if the C string s starts with prefix.
(define (starts? [s (ptr u8)] [prefix (ptr u8)]) -> i32
  (let ([n (strlen prefix)])
    (and (>= (strlen s) n) (== (memcmp s prefix n) 0))))

;; Parses the decimal number at the start of s.
(define (number [s (ptr u8)]) -> i64
  (let ([n i64 0] [i u32 0])
    (while (and (>= (@ s i) #\0) (<= (@ s i) #\9))
      (set! n (+ (* n 10) (- (@ s i) #\0)))
      (+= i 1))
    n))

;; Appends n, in decimal, to b.
(define (add-number! [b (ptr buffer)] [n i64])
  (when (>= n 10) (add-number! b (/ n 10)))
  (buffer-add-byte! b (cast i32 (+ #\0 (% n 10)))))

;; Appends the first line of the host's latest error message to b.
(define (add-error! [b (ptr buffer)])
  (let* ([p (cast (ptr u8) (malloc 1024))] [n (cast u32 (host-error-message (cast i32 p) 1024))] [i u32 0])
    (while (and (< i n) (!= (@ p i) 10)) (+= i 1))
    (buffer-add! b p i)
    (free p)))

;; Sends b's content as a reply, and frees b. Guest number 0 is the
;; program that started this guest.
(define (reply! [b (ptr buffer)])
  (guest-send 0 (-> b bytes) (-> b length))
  (buffer-free! b))

(define (reply-text! [s (ptr u8)]) (guest-send-text 0 s))

;; Writes b's content and a newline to fd (1 = standard output, 2 =
;; standard error) with a single write, and frees b. A single write
;; reaches the page as a single event, which keeps the test's log
;; predictable.
(define (write-line! [fd i32] [b (ptr buffer)])
  (buffer-add-byte! b 10)
  (host-write fd (cast i32 (-> b bytes)) (cast i32 (-> b length)))
  (buffer-free! b))

;; Called once when the guest starts: prints "a guest", followed by its
;; command-line arguments.
(define (main)
  (let ([b (make-buffer)] [p (array u8 64)])
    (buffer-add-string! (& b) "a guest")
    (for ([i i32 0]) (< i (host-arg-count)) (+= i 1)
      (let ([n (host-arg i (cast i32 p) 63)])
        (set! (@ p n) 0)
        (buffer-add-string! (& b) ", ")
        (buffer-add-string! (& b) p)))
    (write-line! 1 (& b))))

;; Called by the host for each message: carries out one command.
(define (on-message)
  (let ([m (guest-take-text)] [b (make-buffer)])
    (cond [(starts? m "add ")
           (+= total (number (+ m 4)))
           (buffer-add-string! (& b) "total ")
           (add-number! (& b) total)
           (reply! (& b))]
          [(starts? m "say ")
           (buffer-add-string! (& b) (+ m 4))
           (write-line! 1 (& b))
           (reply-text! "said")]
          [(starts? m "warn ")
           (buffer-add-string! (& b) (+ m 5))
           (write-line! 2 (& b))
           (reply-text! "warned")]
          [(starts? m "read ")
           ;; read_file with a capacity of 0 only returns the file's size.
           (let* ([path (+ m 5)] [n (host-read-file (cast i32 path) (cast i32 (strlen path)) 0 0)])
             (if (< n 0)
                 (begin (buffer-add-string! (& b) "cannot read ") (add-error! (& b)))
                 (begin (buffer-add-string! (& b) "read ") (add-number! (& b) n) (buffer-add-string! (& b) " bytes")))
             (reply! (& b)))]
          [(starts? m "write ")
           (let ([path (+ m 6)])
             (if (< (host-write-file (cast i32 path) (cast i32 (strlen path)) (cast i32 "written") 7) 0)
                 (begin (buffer-add-string! (& b) "cannot write ") (add-error! (& b)))
                 (buffer-add-string! (& b) "wrote"))
             (reply! (& b)))]
          [(starts? m "trap") (reply-text! (if (== (/ 1 zero) 0) "no trap" "no trap"))]
          [(starts? m "loop") (while 1 (+= total 0))]
          [(starts? m "grow ")
           ;; Allocate one mebibyte at a time until malloc fails. Stop at
           ;; twice the limit in any case, so the test ends even if the
           ;; limit is not enforced.
           (let ([most (* 2 (number (+ m 5)))] [n i64 0])
             (while (and (< n most) (!= (malloc 1048576) 0)) (+= n 1))
             (buffer-add-string! (& b) (if (< n most) "out of memory before " "allocated more than "))
             (add-number! (& b) (if (< n most) (number (+ m 5)) most))
             (buffer-add-string! (& b) " MiB")
             (reply! (& b)))]
          [(starts? m "guest")
           (let ([g (guest-start "program /guest")] [why (guest-error)])
             (buffer-add-string! (& b) (if (== g 0) "no guest: " "started a guest: "))
             (buffer-add-string! (& b) why)
             (free why)
             (reply! (& b)))]
          [(starts? m "exit ") (host-exit (cast i32 (number (+ m 5))))]
          [else (reply-text! "?")])
    (free m)))

;; The host calls on-trap after a trap in this program. reset-stack!
;; restores the C stack pointer, which the trap left where it was; then
;; the guest reports the trap and is ready for the next message.
(func (on-trap) (reset-stack!) (after-trap))

(define (after-trap)
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "trapped: ")
    (add-error! (& b))
    (reply! (& b))))
