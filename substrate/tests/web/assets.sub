;; A test page for assets. tests/web/pages.mjs runs it in a browser.
;;
;; A program's assets are the files in the directory `assets` next to its
;; source (here tests/web/assets). lib/web/site.sh copies them into
;; the site, and the page downloads them for the program before it
;; starts. This page checks each way of using them:
;;
;;   - as a file that the program reads (lib/web/files.sub): it shows the
;;     text of assets/note.txt, and what happens when a file is missing.
;;     It also reads a file that is in a folder and has a "#" and a space
;;     in its name, which would break a URL if the host did not escape
;;     them;
;;   - as an image drawn on a canvas: it loads assets/red.png, a 4 by 4
;;     red square, and draws it in the middle of a white canvas;
;;   - as a URL that the browser loads by itself: the same image, as the
;;     src of an <img> element.
;;
;; It also asks for an image that does not exist, which must not stop the
;; page from working, and it writes a file and reads it back. In a page,
;; a file that the program writes is only kept in memory.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified files "../../lib/web/files.sub")
(require-unqualified ui "../../lib/web/ui.sub")
(require-unqualified web "../../lib/web/web.sub")
(require-unqualified canvas "../../lib/web/canvas.sub")
(memory from base)
(table from base)

(struct model [note (ptr u8)] [nested (ptr u8)] [missing i32] [written (ptr u8)] [image u32] [frame u32])
(variant message [tick [time f64]])
(messages message)

(define (init [m (ptr model)])
  (set! (-> m note) (read-text-file "assets/note.txt"))
  (set! (-> m nested) (read-text-file "assets/levels/level #1.txt"))
  (set! (-> m missing) (== (read-text-file "assets/nothing.txt") 0))
  (write-file "made.txt" "written and read back" 21)
  (set! (-> m written) (read-text-file "made.txt"))
  (set! (-> m image) (load-image "assets/red.png"))
  (load-image "assets/nothing.png"))

;; The canvas is drawn again on every frame, for the first ten seconds.
;; (This page gets its image from a file that is already downloaded, so
;; one drawing would do. A page whose image is fetched by its URL is not
;; told when the image arrives, and has to draw again like this.)
(define (update [m (ptr model)] [e (ptr message)])
  (match e
    [(tick time) (when (< (-> m frame) 600) (+= (-> m frame) 1))]))

(define (paint [m (ptr model)])
  (fill-style "white")
  (fill-rect 0 0 16 16)
  (draw-sprite (-> m image) 4 4 0 6 6 0))

(define (or-none [s (ptr u8)]) -> (ptr u8) (if (!= s 0) s "(none)"))

(view (page [m (ptr model)])
  (p ([id "note"]) (text (or-none (-> m note))))
  (p ([id "nested"]) (text (or-none (-> m nested))))
  (p ([id "missing"]) (text (if (-> m missing) "no such file" "found")))
  (p ([id "written"]) (text (or-none (-> m written))))
  (img ([id "picture"] [src "assets/red.png"] [alt "a red square"]))
  (canvas ([id "board"] [width 16] [height 16]
           [on-window frame (tick (event time))]
           [draw (-> m frame) (paint m)])))

(app model message init update page)
