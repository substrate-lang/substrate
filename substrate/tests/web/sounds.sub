;; A game page that plays a sound file, once and as music, from the first key press.
(require-unqualified substrate "../../compiler/substrate/substrate.sub")
(require-unqualified draw "../../lib/web/game/draw.sub")
(require-unqualified input "../../lib/web/game/input.sub")
(require-unqualified sound "../../lib/web/game/sound.sub")
(require-unqualified game "../../lib/web/game/game.sub")

(struct world [beep u32] [steps u32])

(define (start! [w (ptr world)])
  (set! (-> w beep) (load-sound "assets/beep.wav"))
  (load-sound "assets/nothing.wav")
  (play-music (-> w beep) 0.3))

(define (step! [w (ptr world)] [in (ptr input)])
  (+= (-> w steps) 1)
  (when (pressed? in key-space) (play-sound (-> w beep) 0.5))
  (when (pressed? in #\m) (play-music (-> w beep) 0.3))
  (when (pressed? in #\s) (stop-music)))

(define (draw [w (ptr world)]) (fill-screen (if (> (-> w steps) 0) #x2e7d32ff #x444444ff)))

(game world [size 64 36] start! step! draw)
