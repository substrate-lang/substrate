;; A use of a generic needs the impls its bounds name at the use's types
;; (examples/typed/typed.sub).
(require-unqualified typed "../examples/typed/typed.sub")
(data (Option T) [None] [Some T])
(trait (Eq T) [eq : (-> T T Bool)])
(impl (Eq Int) [eq (a b) (= a b)])
(define #:forall ((T Eq)) (same [a : T] [b : T]) : Bool (eq a b))
(define (f) : Bool (same (Some 1) None))
(func (main) (drop (f)))
