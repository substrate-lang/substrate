;; Records in the dynamic Lisp (lib/lisp.sub), as R7RS's
;; define-record-type: point and vec2 have the same fields, so the same
;; wasm struct type, but different descriptors, so neither passes for the
;; other. A constructor may leave fields out; they start as #f.
(require-unqualified l "../lib/lisp.sub")

(define-record-type point (make-point x y) point? (x point-x set-point-x!) (y point-y))
(define-record-type vec2 (make-vec2 x y) vec2? (x vec2-x) (y vec2-y))
(define-record-type node (make-node value) node? (value node-value) (next node-next set-node-next!))

(define (run)
  (let ([p (make-point 1 2)] [v (make-vec2 1 2)] [n (make-node 'a)])
    (set-point-x! p 10)
    (write (list p (point? p) (point? v) (vec2? v) (point? 5) (point-x p) (point-y p)))
    (newline)
    (write (list (eq? p p) (eqv? p (make-point 10 2)) (equal? p (make-point 10 2))))
    (newline)
    (set-node-next! n (make-node 'b))
    (write (list (node-value n) (node-value (node-next n)) (node-next (node-next n))))
    (newline)))

(func (main) (run))
