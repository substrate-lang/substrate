;; [v0] Stage0 keeps syntax as Chez data, so a property can only hold
;; syntax-library data (spec appendix A).
(begin-for-syntax
  (require s syntax)
  (type box (struct (field v i32)))
  (func (boxed [stx eqref]) -> eqref
    (s:syntax-property-set (s:cadr (s:syntax->list stx)) 'box (struct.new box 1))))
(define-syntax boxed boxed)

(func (main) (drop (boxed 1)))
