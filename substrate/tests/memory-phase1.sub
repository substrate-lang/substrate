;; A memory defined at phase 1, which the module's compile-time linklets share.
(begin-for-syntax
  (memory 1)
  (import host-write "host" "write" (i32 i32 i32 -> i32))
  (data greeting 16 "hi\n")
  (func (greet) (drop (host-write 1 (data-address greeting) (data-size greeting)))))
(begin-for-syntax
  (i32.store8 17 111)
  (greet))
(func (main))
