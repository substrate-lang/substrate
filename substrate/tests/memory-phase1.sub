(begin-for-syntax
  (memory 1)
  (import host-write "host" "write" (i32 i32 i32 -> i32))
  (i32.store8 16 104)
  (i32.store8 18 10)
  (func (greet) (drop (host-write 1 16 3))))
(begin-for-syntax
  (i32.store8 17 111)
  (greet))
(func (main))
