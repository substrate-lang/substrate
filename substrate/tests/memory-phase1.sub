;; A memory can be defined at phase 1, as at phase 0 (spec 3.3): phases are
;; uniform. The two begin-for-syntax chunks share it: the second changes
;; "hi" to "ho" and calls the first's greet, which prints while compiling.
(begin-for-syntax
  (memory 1)
  (import host-write "host" "write" (i32 i32 i32 -> i32))
  (data greeting 16 "hi\n")
  (func (greet) (drop (host-write 1 (data-address greeting) (data-size greeting)))))
(begin-for-syntax
  (i32.store8 17 111)
  (greet))
(func (main))
