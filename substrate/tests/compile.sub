;; Builds kernel-only modules and prints each linklet's name and hash, or the error.
(require-unqualified base "../compiler/base/base.sub")
(require-unqualified stx "../compiler/kernel.sub")
(require-unqualified ex "../compiler/expander.sub")
(require-unqualified host "../compiler/host.sub")
(require print "../compiler/print.sub" newline)

(import host-arg "host" "arg" (i32 i32 i32 -> i32))

(define (print-datum [s datum]) (print:write-bytes (cast i32 (string-bytes s)) (string-length s)))

(define (show [name datum] [bytes datum])
  (print-datum name)
  (print-string " ")
  (print-datum (content-hash (cons bytes nil)))
  (newline))

(define (build [path datum])
  (print-string ";; ")
  (print-datum path)
  (newline)
  (try (for-each (lambda ([l datum]) (show (car l) (cdr l))) (program-linklets (compile-module-file path)))
       [catch compile-error (message blamed loc)
        (let ([b (make-buffer)])
          (write-compile-error (& b) message blamed loc)
          (print:write-bytes (cast i32 (-> b bytes)) (-> b length))
          (buffer-free! (& b)))]))

(define (file-string [path (ptr u8)]) -> datum
  (let* ([n u32 0] [p (read-file-bytes path (& n))] [s datum 0])
    (when (== p 0) (print-string "cannot read ") (print-string path) (newline) (return nil))
    (set! s (bytes->string p n))
    (free p)
    s))

(define (built [dir (ptr u8)])
  (let* ([b (make-buffer)] [names datum 0] [start u32 0] [bytes (ptr u8) 0] [n u32 0])
    (buffer-add-string! (& b) dir)
    (buffer-add-string! (& b) "/program")
    (buffer-add-byte! (& b) 0)
    (set! names (file-string (-> b bytes)))
    (set! bytes (string-bytes names))
    (set! n (string-length names))
    (for ([i u32 0]) (< i n) (+= i 1)
      (when (== (@ bytes i) 10)
        (let ([name (bytes->string (+ bytes start) (- i start))] [path (make-buffer)])
          (buffer-add-string! (& path) dir)
          (buffer-add-string! (& path) "/")
          (buffer-add! (& path) (string-bytes name) (string-length name))
          (buffer-add-string! (& path) ".wasm")
          (buffer-add-byte! (& path) 0)
          (show name (file-string (-> path bytes)))
          (buffer-free! (& path)))
        (set! start (+ i 1))))
    (buffer-free! (& b))))

(define (main)
  (let ([n (host-arg 0 0 0)])
    (if (>= n 0)
        (let ([dir (cast (ptr u8) (malloc (+ n 1)))])
          (host-arg 0 (cast i32 dir) n)
          (set! (@ dir n) 0)
          (built dir))
        (begin
          (set-repository-root! `"..")
          (for-each (lambda ([f datum]) (build f))
                    `("tests/basics.sub" "tests/hook.sub" "tests/globals.sub" "tests/decimals.sub"
                      "tests/module-copies.sub" "tests/interface-tags.sub" "tests/provide-all.sub"
                      "compiler/base/math.sub"
                      "tests/err-type.sub" "tests/err-immutable.sub" "tests/err-global-init.sub"
                      "tests/err-inline-table.sub"
                      "tests/err-no-memory.sub" "tests/err-try-clause.sub"
                      "tests/err-open-application.sub" "tests/err-start-trap.sub" "tests/err-uncaught.sub"))))))
