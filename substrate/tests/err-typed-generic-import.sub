;; An error in an instance of another module's generic is located in the
;; generic, and names the instance and where it was used
;; (examples/typed/typed.sub).
(require-unqualified typed "../examples/typed/typed.sub")
(require g "fixtures/typed-generic.sub" bad)
(define (f) : Int
  (bad #t))
(func (main) (drop (f)))
