;; An impl is written in the file that defines its trait or its type's
;; data type, so every module that can name both sees it
;; (examples/typed/typed.sub): Bool's impl of Eq belongs in Eq's file.
(require-unqualified typed "../examples/typed/typed.sub")
(require e "fixtures/typed-eq.sub" Eq)
(impl (Eq Bool) [eq (a b) a])
(func (main))
