;; A module is named by what it is (spec 3.2): two files with the same
;; source, requiring the same modules, are one module, with one counter.
(require print "../lib/print.sub" write-int newline)
(require a "fixtures/twin-a/counter.sub")
(require b "fixtures/twin-b/counter.sub")
(func (main)
  (write-int (a:bump)) (newline)
  (write-int (b:bump)) (newline))
