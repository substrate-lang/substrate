;; br-table: a branch to the label an index names, or to the default.
(require wasm "../compiler/wasm.sub")

(wasm:func (pick [i i32]) -> i32
  (wasm:block done
    (wasm:block other
      (wasm:block two
        (wasm:block one
          (wasm:block zero
            (wasm:br-table (zero one two) other i))
          (wasm:br done (wasm:i32.const 100)))
        (wasm:br done (wasm:i32.const 200)))
      (wasm:br done (wasm:i32.const 300)))
    (wasm:i32.const -1)))

(wasm:func (odds [n i32]) -> i32
  (let ([sum i32 0])
    (wasm:block out
      (wasm:loop again
        (wasm:br-if out (wasm:i32.eqz n))
        (set! n (wasm:i32.sub n (wasm:i32.const 1)))
        (wasm:block odd
          (wasm:br-table (again odd) out (wasm:i32.and n (wasm:i32.const 1))))
        (set! sum (wasm:i32.add sum n))
        (wasm:br again)))
    sum))

(wasm:func (sign [x i32]) #:inline -> i32
  (wasm:block done
    (wasm:block pos
      (wasm:block zero
        (wasm:br-table (zero) pos (wasm:i32.eqz (wasm:i32.eqz x))))
      (wasm:br done (wasm:i32.const 0)))
    (wasm:i32.const 1)))

(define (main)
  (write-int (#%app pick 0)) (newline)
  (write-int (#%app pick 1)) (newline)
  (write-int (#%app pick 2)) (newline)
  (write-int (#%app pick 3)) (newline)
  (write-int (#%app pick -1)) (newline)
  (write-int (#%app odds 6)) (newline)
  (write-int (#%app sign 0)) (newline)
  (write-int (#%app sign 5)) (newline))
