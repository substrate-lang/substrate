;; A branch by number, (br-table (label ...) default index), which the new
;; compiler adds to the kernel: to the label index says, counting from 0,
;; or to default if it is past them; each a loop, or a block that
;; produces nothing, as br-if's are. A switch is its blocks, each case's
;; code after its own, which gives its value by a br.
(require print "../compiler/print.sub" write-int newline)
(memory from print)

(func (pick [i i32]) -> i32
  (block done
    (block other
      (block two
        (block one
          (block zero
            (br-table (zero one two) other i))
          (br done (i32.const 100)))
        (br done (i32.const 200)))
      (br done (i32.const 300)))
    (i32.const -1)))

;; A loop as a label: the sum of the odd numbers below n, an even one
;; going on to the next.
(func (odds [n i32]) -> i32
  (let ([sum i32 0])
    (block out
      (loop again
        (br-if out (i32.eqz n))
        (set! n (i32.sub n (i32.const 1)))
        (block odd
          (br-table (again odd) out (i32.and n (i32.const 1))))
        (set! sum (i32.add sum n))
        (br again)))
    sum))

;; In a lambda, to its own labels.
(func (apply-pick [i i32]) -> i32
  (let ([f (lambda ([j i32]) -> i32
             (block done
               (block b
                 (block a
                   (br-table (a) b j))
                 (br done (i32.const 7)))
               (i32.const 8)))])
    (#%app f i)))

;; Inlined, as any inline function is.
(func (sign [x i32]) #:inline -> i32
  (block done
    (block pos
      (block zero
        (br-table (zero) pos (i32.eqz (i32.eqz x))))
      (br done (i32.const 0)))
    (i32.const 1)))

(func (main)
  (write-int (#%app pick 0)) (newline)
  (write-int (#%app pick 1)) (newline)
  (write-int (#%app pick 2)) (newline)
  (write-int (#%app pick 3)) (newline)
  (write-int (#%app pick -1)) (newline)
  (write-int (#%app odds 6)) (newline)
  (write-int (#%app apply-pick 0)) (newline)
  (write-int (#%app apply-pick 9)) (newline)
  (write-int (#%app sign 0)) (newline)
  (write-int (#%app sign 5)) (newline))
