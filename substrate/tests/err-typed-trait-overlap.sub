;; A type has at most one impl of a trait (examples/typed/typed.sub).
(require-unqualified typed "../examples/typed/typed.sub")
(data (List T) [Nil] [Cons T (List T)])
(trait (Eq T) [eq : (-> T T Bool)])
(impl #:forall (T) (Eq (List T)) [eq (a b) #t])
(impl (Eq (List Int)) [eq (a b) #f])
(define (f) : Bool (eq (Cons 1 Nil) Nil))
(func (main) (drop (f)))
