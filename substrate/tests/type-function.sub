;; A type function (spec 5.1): (tuple T n), from the fixture, computes a
;; struct type from a type and a number at compile time and declares it
;; once in this module by lifting (spec 6.4). sum3's parameter and main's
;; struct.new name the same type.
(require print "../compiler/print.sub" write-int newline)
(require tu "fixtures/tuple.sub" tuple)

(func (sum3 [t (ref (tuple i32 3))]) -> i32
  (i32.add (struct.get (tuple i32 3) f0 t)
           (i32.add (struct.get (tuple i32 3) f1 t) (struct.get (tuple i32 3) f2 t))))

(func (main)
  (write-int (sum3 (struct.new (tuple i32 3) 1 2 3))) (newline)
  (let ([p (ref (tuple i64 2)) (struct.new (tuple i64 2) 5 7)])
    (write-int (i32.wrap_i64 (struct.get (tuple i64 2) f1 p))) (newline)))
