;; A type function computes a function type at compile time and declares it once.
(require print "../compiler/print.sub" write-int newline)
(require na "fixtures/nary.sub" nary)

(func (add3 [a i32] [b i32] [c i32]) -> i32 (type (nary i32 3)) (i32.add a (i32.add b c)))
(func (max2 [a i64] [b i64]) -> i64 (type (nary i64 2)) (if (i64.gt_s a b) a b))

(func (main)
  (write-int (call-ref (nary i32 3) (ref.func add3) 1 2 3)) (newline)
  (let ([f (ref (nary i64 2)) (ref.func max2)])
    (write-int (i32.wrap_i64 (call-ref (nary i64 2) f (i64.const 5) (i64.const 7)))) (newline)))
