;; A module is named by its file (spec 3.2, 3.6): two files with the same
;; source, requiring the same modules, are two modules, each with its own
;; counter.
(require print "../compiler/print.sub" write-int newline)
(require a "fixtures/twin-a/counter.sub")
(require b "fixtures/twin-b/counter.sub")
(func (main)
  (write-int (a:bump)) (newline)
  (write-int (b:bump)) (newline))
