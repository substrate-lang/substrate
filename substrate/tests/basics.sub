;; Core forms: functions, locals, control flow, numeric types.
(require wasm "../compiler/wasm.sub")

(wasm:func (fact [n i64]) -> i64
  (if (wasm:i64.le_s n 1) 1 (wasm:i64.mul n (fact (wasm:i64.sub n 1)))))

(wasm:func (count-down [n i32] [acc i32]) -> i32
  (if (wasm:i32.eqz n) acc (count-down (wasm:i32.sub n 1) (wasm:i32.add acc 1))))

(wasm:func (sum-to [n i32]) -> i32
  (let ([i 0] [acc 0])
    (wasm:block done
      (wasm:loop next
        (wasm:br-if done (wasm:i32.gt_s i n))
        (set! acc (wasm:i32.add acc i))
        (set! i (wasm:i32.add i 1))
        (wasm:br next)))
    acc))

(wasm:func (first-multiple [k i32] [from i32]) -> i32
  (wasm:block found
    (wasm:loop next
      (if (wasm:i32.eqz (wasm:i32.rem_u from k)) (wasm:br found from))
      (set! from (wasm:i32.add from 1))
      (wasm:br next))))

(wasm:global counter (mut i32) 0)
(wasm:func (bump) (set! counter (wasm:i32.add counter 1)))

(define (main)
  (write-int (wasm:i32.wrap_i64 (fact 12))) (newline)
  (write-int (count-down 1000000 0)) (newline)
  (write-int (sum-to 100)) (newline)
  (write-int (first-multiple 7 50)) (newline)
  (write-int (wasm:i32.trunc_f64_s (wasm:f64.mul 2.5 4))) (newline)
  (bump) (bump) (bump)
  (write-int counter) (newline)
  (write-int (let* ([a 3] [b (wasm:i32.mul a a)]) (wasm:i32.add a b))) (newline)
  (write-int (wasm:select 10 20 (wasm:i32.gt_s 3 2))) (newline)
  (write-int #t) (write-int #f) (write-int #\a) (newline))
