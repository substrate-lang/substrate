;; Kernel basics: functions, locals, control flow, numeric types, data
;; segments. It uses nothing beyond the kernel, and says so: the compiler
;; checks the runtime-free declaration after expansion.

(runtime-free)
(require print "../lib/print.sub")
(memory from print)

(data greeting 1024 "hello from a data segment\n")

(func (fact [n i64]) -> i64
  (if (i64.le_s n 1) 1 (i64.mul n (fact (i64.sub n 1)))))

;; Tail-recursive: the self call is a return_call, so a million
;; iterations run in constant stack.
(func (count-down [n i32] [acc i32]) -> i32
  (if (i32.eqz n) acc (count-down (i32.sub n 1) (i32.add acc 1))))

(func (sum-to [n i32]) -> i32
  (let ([i 0] [acc 0])
    (block done
      (loop next
        (br-if done (i32.gt_s i n))
        (set! acc (i32.add acc i))
        (set! i (i32.add i 1))
        (br next)))
    acc))

;; A block can produce a value through br.
(func (first-multiple [k i32] [from i32]) -> i32
  (block found
    (loop next
      (if (i32.eqz (i32.rem_u from k)) (br found from))
      (set! from (i32.add from 1))
      (br next))))

(global counter i32 0)
(func (bump) (set! counter (i32.add counter 1)))

(func (main)
  (print:write-bytes (data-address greeting) (data-size greeting))
  (print:write-int (i32.wrap_i64 (fact 12))) (print:newline)
  (print:write-int (count-down 1000000 0)) (print:newline)
  (print:write-int (sum-to 100)) (print:newline)
  (print:write-int (first-multiple 7 50)) (print:newline)
  (print:write-int (i32.trunc_f64_s (f64.mul 2.5 4))) (print:newline)
  (bump) (bump) (bump)
  (print:write-int counter) (print:newline)
  (print:write-int (let* ([a 3] [b (i32.mul a a)]) (i32.add a b))) (print:newline)
  (print:write-int (select 10 20 (i32.gt_s 3 2))) (print:newline)
  ;; Unquoted literals are wasm numbers: #t is 1, #f is 0, #\a is 97.
  (print:write-int #t) (print:write-int #f) (print:write-int #\a) (print:newline))
