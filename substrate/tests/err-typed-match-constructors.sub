;; A match's constructors are of one data type (examples/typed/typed.sub).
(require-unqualified typed "../examples/typed/typed.sub")
(data (Option T) [None] [Some T])
(data (List T) [Nil] [Cons T (List T)])
(define (get [o : (Option Int)]) : Int (match o [(Some x) x] [Nil 0]))
(func (main) (drop (get (Some 1))))
