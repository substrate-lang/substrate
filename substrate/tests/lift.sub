;; syntax-local-lift-definition: each use lifts its own function, so the two do not collide.

(begin-for-syntax
  (require-unqualified macros "../compiler/macros.sub")
  (define (add-const [stx datum]) -> datum
    (let ([parts (syntax->list stx)])
      (syntax-local-lift-definition #`(func (plus [x i32]) -> i32 (i32.add x #,(cadr parts))))
      #`(plus #,(caddr parts)))))
(define-syntax add-const add-const)

(func (main)
  (write-int (add-const 1 41)) (newline)
  (write-int (add-const 100 5)) (newline))
