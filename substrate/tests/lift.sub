;; syntax-local-lift-definition (spec 2.3, 6.4): a macro adds a definition to the
;; module. (add-const n e) lifts a function that adds n, and calls it on
;; e. Each use lifts its own function: the lifted form gets the use's
;; introduction scope, so the two functions named plus do not collide.
(require print "../lib/print.sub" write-int newline)

(begin-for-syntax
  (require s syntax)
  (func (add-const [stx eqref]) -> eqref
    (let ([parts (s:syntax->list stx)])
      (drop (s:syntax-local-lift-definition #`(func (plus [x i32]) -> i32 (i32.add x #,(s:cadr parts)))))
      #`(plus #,(s:caddr parts)))))
(define-syntax add-const add-const)

(func (main)
  (write-int (add-const 1 41)) (newline)
  (write-int (add-const 100 5)) (newline))
