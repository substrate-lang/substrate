;; syntax-local-lift-definition: each use lifts its own function, so the two do not collide.
(require print "../compiler/print.sub" write-int newline)

(begin-for-syntax
  (require k kernel)
  (func (add-const [stx i32]) -> i32
    (let ([parts (k:syntax->list stx)])
      (drop (k:syntax-local-lift-definition #`(func (plus [x i32]) -> i32 (i32.add x #,(k:cadr parts)))))
      #`(plus #,(k:caddr parts)))))
(define-syntax add-const add-const)

(func (main)
  (write-int (add-const 1 41)) (newline)
  (write-int (add-const 100 5)) (newline))
