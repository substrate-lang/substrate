;; local-binding (spec 2.3): in fully expanded code, a local variable's
;; binder and its uses give the same fixnum, two variables give different
;; ones, and a global gives #f. (check) expands to 111 if all three hold.
(require print "../lib/print.sub" write-int newline)
(begin-for-syntax
  (require k kernel)
  (func (check [stx eqref]) -> eqref
    (let* ([e (k:syntax->list (k:local-expand #'(let ([x 1] [y 2]) (i32.add x (i32.add y g)))))]
           [bs (k:syntax->list (k:cadr e))]
           [x (k:local-binding (k:car (k:syntax->list (k:car bs))))]
           [y (k:local-binding (k:car (k:syntax->list (k:cadr bs))))]
           [body (k:syntax->list (k:caddr e))]
           [inner (k:syntax->list (k:caddr body))]
           [same (i32.and (i32.eqz (ref.is_null x)) (ref.eq x (k:local-binding (k:cadr body))))]
           [different (i32.and (i32.eqz (ref.is_null y)) (i32.eqz (ref.eq x y)))]
           [global (ref.is_null (k:local-binding (k:caddr inner)))])
      (k:datum->syntax stx (k:fixnum (i32.add (i32.mul 100 same) (i32.add (i32.mul 10 different) global))) stx))))
(define-syntax check check)

(global g i32 3)
(func (main) (write-int (check)) (newline))
