;; local-binding: a binder and its uses agree, two variables differ, a global is #f.
(begin-for-syntax
  (require-unqualified k "../compiler/syntax.sub")
  (define (check [stx datum]) -> datum
    (let* ([e (syntax->list (local-expand #'(let ([x 1] [y 2]) (i32.add x (i32.add y g)))))]
           [bs (syntax->list (cadr e))]
           [x (local-binding (car (syntax->list (car bs))))]
           [y (local-binding (car (syntax->list (cadr bs))))]
           [body (syntax->list (caddr e))]
           [inner (syntax->list (caddr body))]
           [same (and x (equal? x (local-binding (cadr body))))]
           [different (and y (not (equal? x y)))]
           [global (not (local-binding (caddr inner)))])
      (datum->syntax stx (fixnum (+ (* 100 same) (* 10 different) global)) stx))))
(define-syntax check check)

(global g i32 3)
(func (main) (write-int (check)) (newline))
