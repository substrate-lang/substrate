;; A data type's fields name it only as their whole type, at its type
;; parameters (examples/typed/typed.sub): Rose's structs and List's would
;; name each other from two recursion groups.
(require-unqualified typed "../examples/typed/typed.sub")
(data (List T) [Nil] [Cons T (List T)])
(data (Rose T) [Node T (List (Rose T))])
(func (main))
