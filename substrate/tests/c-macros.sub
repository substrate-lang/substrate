;; Macros whose transformers are C functions at phase 1, on the kernel module's syntax.
(require-unqualified base "../compiler/base/base.sub")
(require print "../compiler/print.sub" write-int newline)
(memory from base)
(table from base)

(begin-for-syntax
  (require-unqualified base "../compiler/base/base.sub")
  (require-unqualified kd "../compiler/kernel.sub")
  (require k kernel)

  (define (twice [env datum] [s datum]) -> datum
    (let ([x (cadr (syntax->list s))])
      (datum->syntax env `(+ ,x ,x) s)))

  (define (count-args [s datum]) -> datum
    (let ([n i32 0] [l (cddr (syntax->list s))])
      (while (pair? l) (+= n 1) (set! l (cdr l)))
      (when (== (syntax-e (cadr (syntax->list s))) (sym f)) (+= n 100))
      (datum->syntax s (make-integer n) s))))

(define-syntax twice (k:make-transformer (func-index twice) #'here))
(define-syntax count-args count-args)

(define (main)
  (write-int (twice 21)) (newline)
  (write-int (count-args g 1 2 3)) (newline)
  (write-int (count-args f 1 2)) (newline))
