;; Macros written in the C-like Lisp: their transformers are C functions at
;; phase 1, on the kernel module's syntax objects, in the memory that holds
;; them, with the C runtime's stack and allocator: the running compiler's
;; instances of the kernel module's group (expander.sub, kernel-group).
(require-unqualified c "../compiler/c/c.sub")
(require print "../lib/print.sub" write-int newline)
(memory from c)
(table from c)

(begin-for-syntax
  (require-unqualified c "../compiler/c/c.sub")
  (require-unqualified kd "../compiler/kernel.sub")
  (require k kernel)

  ;; (twice e): (+ e e), in the context the transformer was made with.
  (define (twice [env datum] [s datum]) -> datum
    (let ([x (cadr (syntax->list s))])
      (datum->syntax env `(+ ,x ,x) s)))

  ;; (count-args f a ...): how many a there are, counted in a C loop, plus
  ;; 100 if f is named f, a symbol constant.
  (define (count-args [s datum]) -> datum
    (let ([n i32 0] [l (cddr (syntax->list s))])
      (while (pair? l) (+= n 1) (set! l (cdr l)))
      (when (== (syntax-e (cadr (syntax->list s))) (sym f)) (+= n 100))
      (datum->syntax s (make-integer n) s))))

(define-syntax twice (k:make-transformer (func-index twice) #'here))
(define-syntax count-args count-args)

(define (main)
  (write-int (twice 21)) (newline)
  (write-int (count-args g 1 2 3)) (newline)
  (write-int (count-args f 1 2)) (newline))
