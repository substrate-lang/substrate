;; Typed function references: ref.func of a function with a declared type, and call-ref.
(require print "../compiler/print.sub" write-int newline)
(require ops "fixtures/binops.sub" binop add)

(func (mul [a i32] [b i32]) -> i32 (type binop) (i32.mul a b))

(func (fold [op (ref binop)] [acc i32] [i i32] [n i32]) -> i32
  (if (i32.gt_s i n) acc (fold op (call-ref binop op acc i) (i32.add i 1) n)))

(func (main)
  (write-int (fold (ref.func mul) 1 1 5)) (newline)
  (write-int (fold (ref.func add) 0 1 100)) (newline))
