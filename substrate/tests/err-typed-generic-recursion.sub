;; A generic whose instance needs one at larger types, polymorphic
;; recursion, cannot be monomorphized (examples/typed/typed.sub).
(require-unqualified typed "../examples/typed/typed.sub")
(define #:forall (T) (always [x : T]) : (-> Int T) (lambda ([n : Int]) x))
(define #:forall (T) (grow [x : T] [n : Int]) : Int (if (= n 0) 0 (grow (always x) (- n 1))))
(define (f) : Int (grow 1 3))
(func (main) (drop (f)))
