;; Stores: objects that come and go, and handles that tell when theirs is gone.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified format "../../lib/web/game/format.sub")
(require-unqualified store "../../lib/web/game/store.sub")
(memory from base)
(table from base)

(struct enemy [name u32] [health i32])

(struct missile [target (handle enemy)])

(define enemies (store enemy))
(define missiles (store missile))

(define (add-enemy! [name u32]) -> (ptr enemy)
  (let ([e (store-add! (& enemies))])
    (set! (-> e name) name)
    (set! (-> e health) 3)
    e))

(define (show-enemies)
  (print-format "~d enemies:" (store-count (& enemies)))
  (store-each ([e (& enemies)]) (print-format " ~c~d" (-> e name) (-> e health)))
  (print-format "\n"))

(define (show-target [m (ptr missile)])
  (let ([e (store-find (& enemies) (-> m target))])
    (if (== e 0)
        (print-format "the missile's target is gone\n")
        (print-format "the missile's target is ~c\n" (-> e name)))))

(define (main)
  (print-format "empty: ~d\n" (store-count (& enemies)))
  (let* ([a (add-enemy! #\a)] [b (add-enemy! #\b)] [c (add-enemy! #\c)]
         [m (store-add! (& missiles))]
         [b-handle (store-handle (& enemies) b)])
    (show-enemies)

    (show-target m)
    (set! (-> m target) b-handle)
    (show-target m)
    (-= (-> (store-get (& enemies) (-> m target)) health) 1)
    (show-enemies)

    (print-format "removed: ~d\n" (store-remove! (& enemies) b-handle))
    (print-format "removed again: ~d\n" (store-remove! (& enemies) b-handle))
    (show-target m)
    (show-enemies)

    (let ([d (add-enemy! #\d)])
      (print-format "d is where b was: ~s\n" (if (== d b) "yes" "no"))
      (show-target m)
      (set! (-> m target) (store-handle (& enemies) d))
      (show-target m))
    (show-enemies)

    (print-format "a and c: ~c ~c\n" (-> a name) (-> c name)))

  (store-each ([e h (& enemies)])
    (when (!= (-> e name) #\c) (store-remove! (& enemies) h)))
  (show-enemies)

  (for ([i u32 0]) (< i 100) (+= i 1) (add-enemy! (+ #\A (% i 26))))
  (print-format "after adding 100: ~d\n" (store-count (& enemies)))
  (let ([n u32 0])
    (store-each ([e h (& enemies)])
      (when (== (% n 2) 0) (store-remove! (& enemies) h))
      (+= n 1)))
  (print-format "after removing every second one: ~d\n" (store-count (& enemies)))
  (for ([i u32 0]) (< i 20) (+= i 1) (add-enemy! #\z))
  (print-format "after adding 20: ~d\n" (store-count (& enemies)))

  (let ([old (store-handle (& enemies) (add-enemy! #\o))])
    (store-clear! (& enemies))
    (print-format "after clearing: ~d\n" (store-count (& enemies)))
    (add-enemy! #\n)
    (show-enemies)
    (print-format "the old handle finds: ~s\n" (if (== (store-find (& enemies) old) 0) "nothing" "something")))

  (add-enemy! #\p)
  (add-enemy! #\q)
  (let ([i 0] [the-store 9])
    (store-each ([e (& enemies)])
      (+= i 1)
      (when (== (-> e name) #\p) (break)))
    (print-format "stopped after ~d (~d)\n" i the-store))
  (store-free! (& enemies))
  (print-format "after freeing: ~d\n" (store-count (& enemies))))
