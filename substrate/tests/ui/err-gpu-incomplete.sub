;; A command written while the last one is still waiting for its items
;; stops the program.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified gpu "../../lib/web/gpu.sub")
(memory from base)
(table from base)
(define (main)
  (let ([shader (gpu-shader! "")])
    (gpu-render-pipeline! shader "vertex" "fragment" gpu-triangles gpu-cull-none gpu-ccw gpu-blend-none 0 0 0  0 1 0)
    (gpu-buffer! 16 gpu-uniform)))
