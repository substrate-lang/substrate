;; A test of Shade (lib/shade/core.sub), the language for GPU programs:
;; a shader form (lib/web/scene/shader.sub) whose functions are written
;; in it, and the WGSL the compiler makes of them, printed. A library
;; (lib/shade/shade.sub) shares a function between forms. It needs no
;; browser; the browser tests compile what the real shaders make.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified gpu "../../lib/web/gpu.sub")
(require-unqualified shader "../../lib/web/scene/shader.sub")
(require-unqualified shade "../../lib/shade/shade.sub")
(memory from base)
(table from base)

(shade-library numbers
  (define (hash [p vec2]) -> f32
    (fract (* (sin (dot p (vec2 127.1 311.7))) 43758.5453)))
  (const tau f32 6.2831853))

(shader lit
  [uniform frame 0 0 (vertex fragment) [view-projection mat4] [sun vec3] [time f32] [sky vec4] [fog vec2]]
  [uniform-array origin 1 0 (vertex) [at vec3]]
  [sampler atlas-sampler 2 0 (fragment)]
  [texture atlas 2 1 (vertex fragment)]
  [comparison-sampler shadow-sampler 2 2 (fragment)]
  [depth-texture shadow-map 2 3 (fragment)]
  [storage particles 3 0 (compute) read-write [position vec3] [age f32]]
  [vertex-input vertex per-vertex [position vec3] [normal vec3] [texel vec2] [color unorm8x4]]
  [builtins vertex-index]
  [varyings [world vec3] [normal vec3] [uv vec2] [color vec4]]
  [outputs [color vec4] [normal vec4]]
  [use numbers]
  [struct lighting [direct f32] [rim f32]]
  [define (place [in vertex] [push f32]) -> vec3
    (+ in.position origin.at (* in.normal push))]
  [define (light-of [n vec3] [v vec3]) -> lighting
    (let ([facing (smoothstep -0.1 0.15 (dot n (normalize frame.sun)))]
          [rim (* (pow (- 1.0 (max (dot n v) 0.0)) 6.0) 0.25)])
      (lighting [direct (+ 0.15 (* 0.85 facing))] [rim rim]))]
  [define (sunlit [p vec3]) -> f32
    (if (or (< p.x 0.0) (> p.x 1.0)) 1.0 (texture-sample-compare-level shadow-map shadow-sampler p.xy (- p.z 0.0015)))]
  [define (noisy [p vec2]) -> f32
    (let ([sum 0.0] [amplitude 0.5] [q p])
      (for ([i 0]) (< i 4) (+= i 1)
        (+= sum (* (hash q) amplitude))
        (set! q (+ (* q 2.1) (vec2 13.0 7.0)))
        (set! amplitude (* amplitude 0.5)))
      sum)]
  [vertex (vertex [in vertex]) -> varyings
    (let ([world (place in 0.0)])
      (varyings [position (* frame.view-projection (vec4 world 1.0))]
                [world world]
                [normal in.normal]
                [uv (/ in.texel (vec2 (texture-dimensions atlas)))]
                [color in.color]))]
  [fragment (fragment [in varyings]) -> outputs
    (let* ([albedo (* (-> (texture-sample atlas atlas-sampler in.uv) rgb) in.color.rgb)]
           [n (normalize in.normal)]
           [l (light-of n (normalize (- frame.sky.xyz in.world)))]
           [lit (* albedo (+ l.direct l.rim))])
      (cond [(> frame.time tau) (outputs [color (vec4 lit 1.0)] [normal (vec4 (* n 0.5) 1.0)])]
            [else (outputs [color (vec4 (mix lit frame.sky.rgb frame.fog.x) 1.0)])]))]
  [compute 64 (step [id global-invocation-id])
    (let ([i id.x])
      (when (< i 1000)
        (+= (-> (@ particles i) age) frame.time)
        (set! (-> (@ particles i) position y) (noisy (-> (@ particles i) position xz)))))])

(define (main) (print-string lit-code))
