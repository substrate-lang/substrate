;; A test of lib/web/game/vector.sub: a row of items that grows, whose items
;; never move and whose indexes are checked. vector.out is the expected
;; output.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified format "../../lib/web/game/format.sub")
(require-unqualified vector "../../lib/web/game/vector.sub")
(memory from base)
(table from base)

(struct point [x i32] [y i32])

;; A vector that is a global variable starts out empty, with no setting
;; up.
(define points (vector point))
(define numbers (vector u32))

(define (main)
  (print-format "empty: ~d items\n" (vector-count (& points)))

  ;; A new item is all zero, and vector-add! returns a pointer to it.
  (let ([first (vector-add! (& points))])
    (print-format "a new item: ~d,~d\n" (-> first x) (-> first y))
    (set! (-> first x) 7)
    ;; Adding 99 more items takes four blocks of 32. The first item has
    ;; not moved: the pointer from before still reaches it.
    (for ([i 1]) (< i 100) (+= i 1)
      (let ([p (vector-add! (& points))])
        (set! (-> p x) i)
        (set! (-> p y) (* i i))))
    (print-format "~d items; the first is still at the same place: ~s\n"
                  (vector-count (& points)) (if (== first (vector-at (& points) 0)) "yes" "no"))
    ;; Without the check, an index that is good gives the same item.
    (print-format "unchecked, item 99 is the same item: ~s\n"
                  (if (== (vector-at-unchecked (& points) 99) (vector-at (& points) 99)) "yes" "no"))
    (print-format "item 0: ~d,~d  item 31: ~d,~d  item 32: ~d,~d  item 99: ~d,~d\n"
                  (-> first x) (-> first y)
                  (-> (vector-at (& points) 31) x) (-> (vector-at (& points) 31) y)
                  (-> (vector-at (& points) 32) x) (-> (vector-at (& points) 32) y)
                  (-> (vector-at (& points) 99) x) (-> (vector-at (& points) 99) y)))

  ;; Each item in turn, with and without its number.
  (let ([sum 0])
    (vector-each ([p (& points)]) (+= sum (-> p x)))
    (print-format "the sum of x: ~d\n" sum))
  (vector-each ([p i (& points)])
    (when (< i 97) (continue))
    (print-format "item ~d: ~d\n" i (-> p y)))

  ;; Values are copied in with vector-push!.
  (for ([i u32 0]) (< i 5) (+= i 1) (vector-push! (& numbers) (* 10 i)))
  (vector-each ([n (& numbers)]) (print-format "~d " (@ n)))
  (print-format "\n")

  ;; Removing from the end, and starting over.
  (vector-remove-last! (& numbers))
  (print-format "after removing the last: ~d items, the last is ~d\n"
                (vector-count (& numbers)) (@ (vector-at (& numbers) (- (vector-count (& numbers)) 1))))
  (vector-clear! (& numbers))
  (print-format "after clearing: ~d items\n" (vector-count (& numbers)))
  ;; An item added after clearing is zero again, not what was there.
  (print-format "a new item after clearing: ~d\n" (@ (vector-add! (& numbers))))
  (vector-free! (& numbers))
  (vector-push! (& numbers) 5)
  (print-format "after freeing, and one more: ~d items, the first is ~d\n"
                (vector-count (& numbers)) (@ (vector-at (& numbers) 0)))

  ;; The body of a vector-each may add items: the loop goes on to them.
  ;; The vector's own variable in the loop is kept apart from a variable
  ;; of the caller's with the same name.
  (let ([the-vector 3] [i 100])
    (vector-each ([n (& numbers)])
      (when (< (vector-count (& numbers)) (cast u32 the-vector)) (vector-push! (& numbers) (+ (@ n) 1)))
      (print-format "~d " (@ n)))
    (print-format "(~d ~d)\n" the-vector i)))
