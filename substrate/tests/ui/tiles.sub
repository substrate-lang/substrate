;; A test of tile maps (lib/web/game/tiles.sub) that needs no browser:
;; bodies that move through a small level and are stopped by its solid
;; tiles, the camera, and drawing only the tiles on the screen.
;;
;; The level, 8 tiles wide and 6 high, with tiles of 16 pixels:
;;
;;   ........      row 0
;;   ........
;;   ...#....      a block in the air, at column 3
;;   ........
;;   ......#.      a block standing on the floor, at column 6
;;   ########      the floor, row 5: its top is at y = 80
;;
;; The body is 10 wide and 14 high, so standing on the floor it is at
;; y = 66, and touching the block at column 6 from the left it is at
;; x = 86.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified ui "../../lib/web/ui.sub")
(require-unqualified tiles "../../lib/web/game/tiles.sub")
(require-unqualified draw "../../lib/web/game/draw.sub")
(require-unqualified trace "../../lib/web/trace.sub")
(require print "../../compiler/print.sub")
(memory from base)
(table from base)

(define level tilemap)
(define b body)
(define other body)
(define view camera)

;; Prints a number rounded to one decimal place.
(define (show [v f64])
  (when (< v 0.0)
    (print-string "-")
    (set! v (- 0.0 v)))
  (let ([tenths (cast u64 (+ (* v 10.0) 0.5))])
    (print:write-u64 (/ tenths 10))
    (when (!= (% tenths 10) 0)
      (print-string ".")
      (print:write-u64 (% tenths 10)))))

;; Prints the body's position, and what its last move ran into.
(define (report)
  (print-string "  at ")
  (show (-> b x))
  (print-string ", ")
  (show (-> b y))
  (when (-> b on-ground) (print-string ", on the ground"))
  (when (-> b hit-wall) (print-string ", hit a wall"))
  (when (-> b hit-ceiling) (print-string ", hit the ceiling"))
  (print-string "\n"))

;; Puts the body at (x, y) with the velocity (vx, vy).
(define (place [x f64] [y f64] [vx f64] [vy f64])
  (set! (-> b x) x)
  (set! (-> b y) y)
  (set! (-> b vx) vx)
  (set! (-> b vy) vy))

;; Moves the body n steps, with gravity added to its fall on each step.
(define (steps [n u32] [gravity f64])
  (for ([i u32 0]) (< i n) (+= i 1)
    (+= (-> b vy) gravity)
    (move-body! (& level) (& b))))

(define (main)
  (tilemap-init! (& level) 8 6 16)
  (tile-solid! (& level) 1)
  (for ([column i32 0]) (< column 8) (+= column 1) (tile-set! (& level) column 5 1))
  (tile-set! (& level) 3 2 1)
  (tile-set! (& level) 6 4 1)
  (set! (-> b width) 10.0)
  (set! (-> b height) 14.0)

  (print-string "falling onto the floor\n")
  (place 20.0 0.0 0.0 0.0)
  (steps 10 0.5)
  (report)
  (steps 20 0.5)
  (report)

  (print-string "walking right into the block\n")
  (set! (-> b vx) 2.0)
  (steps 20 0.5)
  (report)
  ;; Keep walking until a wall stops the body. The step that hits the wall
  ;; reports it, and sets the body's sideways speed to 0.
  (while (not (-> b hit-wall))
    (set! (-> b vx) 2.0)
    (steps 1 0.5))
  (report)
  (print-string "and away from it again\n")
  (set! (-> b vx) -2.0)
  (steps 1 0.5)
  (report)

  (print-string "walking left to the edge of the level, which is solid\n")
  (steps 60 0.5)
  (report)

  (print-string "jumping up under the block in the air\n")
  (place 50.0 66.0 0.0 -6.0)
  (steps 3 0.5)
  (report)
  (steps 1 0.5)
  (report)
  (steps 20 0.5)
  (report)

  ;; The level's right edge is solid all the way up. A body that falls
  ;; while pushing against it is stopped sideways and keeps falling.
  (print-string "falling while pushing against the right edge of the level\n")
  (place 114.0 20.0 2.0 2.0)
  (steps 1 0.0)
  (report)
  (set! (-> b vx) 2.0)
  (steps 1 0.0)
  (report)
  (set! (-> b vx) 2.0)
  (steps 1 0.0)
  (report)
  (steps 30 0.5)
  (report)

  (print-string "a move of 40 pixels in one step does not pass through the block\n")
  (place 60.0 66.0 40.0 0.0)
  (steps 1 0.0)
  (report)

  (print-string "jumping above the top of the level is allowed\n")
  (place 100.0 5.0 0.0 -8.0)
  (steps 2 0.0)
  (report)

  (print-string "with a hole in the floor, the body falls out of the level\n")
  (tile-set! (& level) 1 5 0)
  (place 19.0 66.0 0.0 0.0)
  (steps 30 0.5)
  (report)
  (tile-set! (& level) 1 5 1)

  (print-string "overlap\n")
  (set! (-> other width) 10.0)
  (set! (-> other height) 14.0)
  (place 20.0 66.0 0.0 0.0)
  (set! (-> other x) 30.0)
  (set! (-> other y) 66.0)
  (print-string (if (bodies-overlap? (& b) (& other)) "  touching edges overlap\n" "  touching edges do not overlap\n"))
  (set! (-> other x) 29.0)
  (print-string (if (bodies-overlap? (& b) (& other)) "  one pixel in: overlap\n" "  one pixel in: no overlap\n"))
  (set! (-> other y) 100.0)
  (print-string (if (bodies-overlap? (& b) (& other)) "  far below: overlap\n" "  far below: no overlap\n"))

  ;; The level is 128 by 96 pixels. On a screen of 64 by 48 the camera can
  ;; be anywhere from (0, 0) to (64, 48).
  (print-string "the camera follows a point, but stays inside the level\n")
  (camera-follow! (& view) 10.0 10.0 64.0 48.0 (& level))
  (print-string "  near the top left: ") (show (-> view x)) (print-string ", ") (show (-> view y)) (print-string "\n")
  (camera-follow! (& view) 64.0 48.0 64.0 48.0 (& level))
  (print-string "  in the middle: ") (show (-> view x)) (print-string ", ") (show (-> view y)) (print-string "\n")
  (camera-follow! (& view) 120.0 90.0 64.0 48.0 (& level))
  (print-string "  near the bottom right: ") (show (-> view x)) (print-string ", ") (show (-> view y)) (print-string "\n")
  (camera-follow! (& view) 64.0 48.0 400.0 300.0 (& level))
  (print-string "  on a screen larger than the level: ") (show (-> view x)) (print-string ", ") (show (-> view y)) (print-string "\n")

  ;; With the camera at (40, 40) and a screen of 64 by 48, the screen
  ;; shows x from 40 to 104 and y from 40 to 88: columns 2 to 6 and rows 2
  ;; to 5. The block in the air, at column 3 of row 2, is the only tile of
  ;; row 2.
  (print-string "drawing: only the tiles on the screen\n")
  (set! (-> view x) 40.0)
  (set! (-> view y) 40.0)
  (let ([sheet (load-sheet "tiles.png" 16.0 16.0)])
    (ui-canvas-begin 1)
    (draw-tilemap (& level) sheet (& view) 64.0 48.0)
    (ui-canvas-end))
  (trace-patches!))
