;; A test of lib/web/scene/sprites.sub, the GPU sprite renderer: the
;; commands it writes for two frames, printed (lib/web/trace.sub). It
;; needs no browser. gpu-sprites.out is the expected output.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified gpu "../../lib/web/gpu.sub")
(require-unqualified sprites "../../lib/web/scene/sprites.sub")
(require-unqualified trace "../../lib/web/trace.sub")
(require-unqualified format "../../lib/web/game/format.sub")
(memory from base)
(table from base)

(define batch sprites)

(define (main)
  (sprites-init! (& batch))
  (let ([tiles (sprites-sheet! (& batch) "assets/tiles.png")]
        [people (sprites-sheet! (& batch) "assets/people.png")])
    (print-string "setting up:\n")
    (trace-gpu!)

    ;; A frame: the sky, then tiles, then a person, then a see-through
    ;; rectangle on top. The sky joins the run of tiles, since it has no
    ;; sheet; the person starts a run of its own; the rectangle joins it.
    (sprites-begin! (& batch))
    (sprites-rect! (& batch) 0.0 0.0 320.0 180.0 #x8fd3ffff)
    (sprites-add! (& batch) tiles 3 16.0 16.0 0 0.0 164.0 16.0 16.0 #xffffffff)
    (sprites-add! (& batch) tiles 3 16.0 16.0 0 16.0 164.0 16.0 16.0 #xffffffff)
    (sprites-add! (& batch) people 1 16.0 24.0 1 100.0 140.0 16.0 24.0 #xffffffff)
    (sprites-rect! (& batch) 0.0 0.0 320.0 180.0 #x10141a80)
    (print-string "a frame on the surface:\n")
    (sprites-draw! (& batch) gpu-on-surface 1 gpu-format-surface 320 180 gpu-clear #x000000ff)
    (trace-gpu!)
    (print-format "runs ~d, instances ~d\n" (-> batch run-count) (-> batch count))

    ;; Instance 3, the person, mirrored: the numbers written for it.
    (let ([i (+ (-> batch items) (* 3 12))])
      (print-format "instance 3: ~.0f ~.0f ~.0f ~.0f cell ~.0f ~.0f ~.0f flip ~.0f colour ~.2f ~.2f ~.2f ~.2f\n"
                    (cast f64 (@ i 0)) (cast f64 (@ i 1)) (cast f64 (@ i 2)) (cast f64 (@ i 3))
                    (cast f64 (@ i 4)) (cast f64 (@ i 5)) (cast f64 (@ i 6)) (cast f64 (@ i 7))
                    (cast f64 (@ i 8)) (cast f64 (@ i 9)) (cast f64 (@ i 10)) (cast f64 (@ i 11))))

    ;; A frame with more sprites than the buffer holds, on a texture: the
    ;; buffer is replaced by a bigger one, and the pipeline for the
    ;; texture's format is made.
    (sprites-begin! (& batch))
    (for ([n u32 0]) (< n 300) (+= n 1)
      (sprites-add! (& batch) tiles n 16.0 16.0 0 (cast f64 n) 0.0 16.0 16.0 #xffffffff))
    (print-string "a frame of 300 on a texture:\n")
    (sprites-draw! (& batch) gpu-on-texture 7 gpu-rgba8 64 64 gpu-clear #x00000000)
    (trace-gpu!)

    ;; An empty frame on top of what the texture holds: the pipeline
    ;; exists now, and nothing is drawn.
    (sprites-begin! (& batch))
    (print-string "an empty frame:\n")
    (sprites-draw! (& batch) gpu-on-texture 7 gpu-rgba8 64 64 gpu-keep 0)
    (trace-gpu!)))
