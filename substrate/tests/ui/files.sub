;; Reading and writing files with compiler/host.sub, by paths relative to this directory.
(require-unqualified substrate "../../compiler/substrate/substrate.sub")
(require-unqualified host "../../compiler/host.sub")
(require print "../../compiler/print.sub")

(define (main)
  (let* ([size u32 0] [content (read-file-bytes "files.txt" (& size))])
    (print-string "size ")
    (print:write-u64 (cast u64 size))
    (print-string "\n")
    (print-string content)
    (print-string (if (== (strlen content) size) "the length is the size\n" "the length is not the size\n"))
    (free content))
  (let ([text (read-file-bytes "files.txt" 0)])
    (print-string (if (== (@ text 0) #\A) "read as text\n" "not read as text\n"))
    (free text))
  (let ([size u32 7])
    (print-string (if (== (read-file-bytes "no-such-file.txt" (& size)) 0) "a missing file is 0\n" "a missing file was read\n"))
    ;; The host says why; its words differ from host to host, so only
    ;; check that it said something.
    (let* ([why (array u8 256)] [n (host-error-message why 255)])
      (print-string (if (> n 0) "and the host says why\n" "and the host does not say why\n"))))
  (print-string (if (== (host-write-file "no-such-directory/file.txt" 26 "x" 1) -1)
                    "a write that fails is -1\n"
                    "a write that should fail did not\n")))
