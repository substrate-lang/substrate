;; Reading and writing files with lib/web/files.sub, by paths relative to this directory.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified files "../../lib/web/files.sub")
(require print "../../compiler/print.sub")
(memory from base)
(table from base)

(define (main)
  (let* ([size u32 0] [content (read-file "files.txt" (& size))])
    (print-string "size ")
    (print:write-u64 (cast u64 size))
    (print-string "\n")
    (print-string content)
    (print-string (if (== (strlen content) size) "the length is the size\n" "the length is not the size\n"))
    (free content))
  (let ([text (read-text-file "files.txt")])
    (print-string (if (== (@ text 0) #\A) "read as text\n" "not read as text\n"))
    (free text))
  (let ([size u32 7])
    (print-string (if (== (read-file "no-such-file.txt" (& size)) 0) "a missing file is 0\n" "a missing file was read\n"))
    ;; The host says why; its words differ from host to host, so only
    ;; check that it said something.
    (let ([why (file-error)])
      (print-string (if (> (strlen why) 0) "and the host says why\n" "and the host does not say why\n"))
      (free why)))
  (print-string (if (== (write-file "no-such-directory/file.txt" "x" 1) -1)
                    "a write that fails is -1\n"
                    "a write that should fail did not\n")))
