;; Space: things in a grid of cells, found by nearness, by touching, and by rays.
(require-unqualified format "../../lib/web/game/format.sub")
(require-unqualified vector "../../lib/web/game/vector.sub")
(require-unqualified store "../../lib/web/game/store.sub")
(require-unqualified space "../../lib/web/game/space.sub")

(const kind-tree u32 1)
(const kind-rock u32 2)
(const kind-hut u32 3)
(const kind-bridge u32 4)

(define (names [s (ptr space)] [found (ptr (vector (handle entry)))])
  (vector-each ([h found])
    (let ([e (space-entry s (@ h))])
      (print-format " ~s~d" (cond [(== (-> e kind) kind-tree) "tree"] [(== (-> e kind) kind-rock) "rock"]
                                  [(== (-> e kind) kind-hut) "hut"] [else "bridge"])
                    (-> e id))))
  (print-string "\n"))

(define (main)
  (let ([s space] [found (vector (handle entry))])
    (space-init! (& s) 64.0 64.0 8.0)
    (print-format "a space 64 by 64 in cells of 8: ~d by ~d cells\n" (-> s columns) (-> s rows))
    (for ([i u32 0]) (< i 5) (+= i 1)
      (space-add! (& s) (disc 0.8 6.0) kind-tree i (+ 10.0 (* 6.0 (cast f64 i))) 0.0 20.0))
    (space-add! (& s) (disc 1.5 1.2) kind-rock 1 30.0 0.0 30.0)
    (space-add! (& s) (box 3.0 2.0 0.0 4.0) kind-hut 1 50.0 0.0 50.0)
    (let ([bridge (space-add! (& s) (walkway 8.0 1.5 0.0 2.0 1) kind-bridge 1 20.0 3.0 44.0)])
      (print-format "~d entries\n" (space-count (& s)))
      (print-string "within 10 of (16, 20), any kind:")
      (space-gather! (& s) 16.0 20.0 10.0 (kinds-all) (& found))
      (names (& s) (& found))
      (vector-clear! (& found))
      (print-string "within 10 of (16, 20), rocks only (none):")
      (space-gather! (& s) 16.0 20.0 10.0 (kind-mask kind-rock) (& found))
      (names (& s) (& found))
      (vector-clear! (& found))
      (let ([e (space-entry (& s) (space-nearest (& s) 25.0 25.0 40.0 (kinds-all)))])
        (print-format "nearest to (25, 25): ~s at ~.0f ~.0f\n" (if (== (-> e kind) kind-tree) "a tree" "something else") (-> e x) (-> e z)))
      (print-string "a mover 0.5 across at (31.5, 29.5), 1.8 tall, touches:")
      (space-touching! (& s) 31.5 29.5 0.0 0.5 1.8 (kinds-all) (& found))
      (names (& s) (& found))
      (vector-clear! (& found))
      (print-string "the same mover 7 units up touches nothing of the rock, which is 1.2 tall:")
      (space-touching! (& s) 31.5 29.5 7.0 0.5 1.8 (kinds-all) (& found))
      (names (& s) (& found))
      (vector-clear! (& found))
      (print-string "beside the hut, at (54, 50), inside its corner's reach but outside the box turned 0:")
      (space-touching! (& s) 54.0 50.0 0.0 0.5 1.8 (kinds-all) (& found))
      (names (& s) (& found))
      (vector-clear! (& found))
      (print-string "on the bridge's deck:")
      (space-touching! (& s) 24.0 44.5 5.0 0.5 1.8 (kinds-all) (& found))
      (names (& s) (& found))
      (vector-clear! (& found))
      (let ([d 0.0])
        (let ([hit (space-ray (& s) 10.0 1.0 10.0 0.0 0.0 1.0 30.0 (kinds-all) (& d))])
          (print-format "a ray from (10, 1, 10) along +z hits ~s after ~.2f\n"
                        (if (!= (space-entry (& s) hit) 0) "the first tree" "nothing") d))
        (let ([hit (space-ray (& s) 10.0 8.0 10.0 0.0 0.0 1.0 30.0 (kinds-all) (& d))])
          (print-format "the same ray 8 up hits ~s (the trees are 6 tall)\n"
                        (if (!= (space-entry (& s) hit) 0) "something" "nothing")))
        (let ([hit (space-ray (& s) 40.0 2.0 50.0 1.0 0.0 0.0 20.0 (kind-mask kind-hut) (& d))])
          (print-format "a ray along +x at the hut hits it after ~.2f (its wall is at 47)\n" d)))
      (space-move! (& s) bridge 20.0 3.0 60.0)
      (print-string "the bridge moved to z 60; touching at (24, 44.5):")
      (space-touching! (& s) 24.0 44.5 5.0 0.5 1.8 (kinds-all) (& found))
      (names (& s) (& found))
      (vector-clear! (& found))
      (print-string "and at (24, 60.5):")
      (space-touching! (& s) 24.0 60.5 5.0 0.5 1.8 (kinds-all) (& found))
      (names (& s) (& found))
      (vector-clear! (& found))
      (space-remove! (& s) bridge)
      (print-format "removed: ~d entries, and the handle finds ~s\n" (space-count (& s))
                    (if (== (space-entry (& s) bridge) 0) "nothing" "something"))
      (space-free! (& s)))))
