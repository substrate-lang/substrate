;; A handle belongs to one type of store: a coin's handle with the enemies is an error.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified store "../../lib/web/game/store.sub")
(memory from base)
(table from base)

(struct coin [value u32])
(struct enemy [health i32])
(define coins (store coin))
(define enemies (store enemy))

(define (main)
  (let ([h (store-handle (& coins) (store-add! (& coins)))])
    (store-find (& enemies) h)))
