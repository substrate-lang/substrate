struct Frame { view_projection: mat4x4f, sun: vec3f, time: f32, sky: vec4f, fog: vec2f, }
@group(0) @binding(0) var<uniform> frame: Frame;
struct Origin { at: vec3f, }
@group(1) @binding(0) var<uniform> origin: Origin;
@group(2) @binding(0) var atlas_sampler: sampler;
@group(2) @binding(1) var atlas: texture_2d<f32>;
@group(2) @binding(2) var shadow_sampler: sampler_comparison;
@group(2) @binding(3) var shadow_map: texture_depth_2d;
struct Particles { position: vec3f, age: f32, }
@group(3) @binding(0) var<storage, read_write> particles: array<Particles>;
struct Vertex { @location(0) position: vec3f, @location(1) normal: vec3f, @location(2) texel: vec2f, @location(3) color: vec4f, @builtin(vertex_index) vertex_index: u32, }
struct Varyings { @builtin(position) position: vec4f, @location(0) world: vec3f, @location(1) normal: vec3f, @location(2) uv: vec2f, @location(3) color: vec4f, }
struct Outputs { @location(0) color: vec4f, @location(1) normal: vec4f, }
const tau: f32 = 6.2831853;
struct Lighting { direct: f32, rim: f32, }
fn hash(p: vec2f) -> f32 {
  return fract((sin(dot(p, vec2f(127.1, 311.7))) * 43758.5453));
}
fn place(in: Vertex, push: f32) -> vec3f {
  return ((in.position + origin.at) + (in.normal * push));
}
fn light_of(n: vec3f, v: vec3f) -> Lighting {
  let facing: f32 = smoothstep(-0.1, 0.15, dot(n, normalize(frame.sun)));
  let rim: f32 = (pow((1.0 - max(dot(n, v), 0.0)), 6.0) * 0.25);
  return Lighting((0.15 + (0.85 * facing)), rim);
}
fn sunlit(p: vec3f) -> f32 {
  if (((p.x < 0.0) || (p.x > 1.0))) {
    return 1.0;
  } else {
    return textureSampleCompareLevel(shadow_map, shadow_sampler, p.xy, (p.z - 0.0015));
  }
}
fn noisy(p: vec2f) -> f32 {
  var sum: f32 = 0.0;
  var amplitude: f32 = 0.5;
  var q: vec2f = p;
  for (var i: i32 = 0; (i < 4); i += 1) {
    sum += (hash(q) * amplitude);
    q = ((q * 2.1) + vec2f(13.0, 7.0));
    amplitude = (amplitude * 0.5);
  }
  return sum;
}
@vertex fn vertex(in: Vertex) -> Varyings {
  let world: vec3f = place(in, 0.0);
  return Varyings((frame.view_projection * vec4f(world, 1.0)), world, in.normal, (in.texel / vec2f(textureDimensions(atlas))), in.color);
}
@fragment fn fragment(in: Varyings) -> Outputs {
  let albedo: vec3f = (textureSample(atlas, atlas_sampler, in.uv).rgb * in.color.rgb);
  let n: vec3f = normalize(in.normal);
  let l: Lighting = light_of(n, normalize((frame.sky.xyz - in.world)));
  let lit: vec3f = (albedo * (l.direct + l.rim));
  if ((frame.time > tau)) {
    return Outputs(vec4f(lit, 1.0), vec4f((n * 0.5), 1.0));
  } else {
    return Outputs(vec4f(mix(lit, frame.sky.rgb, frame.fog.x), 1.0), vec4f());
  }
}
@compute @workgroup_size(64) fn step(@builtin(global_invocation_id) id: vec3u) {
  let i: u32 = id.x;
  if ((i < 1000)) {
    particles[i].age += frame.time;
    particles[i].position.y = noisy(particles[i].position.xz);
  }
}
