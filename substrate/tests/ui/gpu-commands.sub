;; The commands lib/web/gpu.sub writes for a small drawing and a compute pass, printed.
(require-unqualified gpu "../../lib/web/gpu.sub")
(require-unqualified trace "../../lib/web/trace.sub")

(define (main)
  (let* ([shader (gpu-shader! "@vertex fn vertex() {} @fragment fn fragment() {}")]
         [pipeline (gpu-render-pipeline! shader "vertex" "fragment" gpu-triangles gpu-cull-none gpu-ccw gpu-blend-premultiplied
                                         0 0 0  0 1 1)])
    (gpu-target! gpu-format-surface)
    (gpu-vertex-buffer-layout! 64 gpu-per-instance 3)
    (gpu-attribute! 0 0 gpu-f32x2)
    (gpu-attribute! 1 8 gpu-f32x4)
    (gpu-attribute! 2 24 gpu-unorm8x4)
    (let* ([surface (gpu-surface! 7)]
           [uniforms (gpu-buffer! 16 gpu-uniform)]
           [instances (gpu-buffer! 1024 gpu-vertex)]
           [sheet (gpu-texture-file! "assets/sprites.png")]
           [sampler (gpu-sampler! gpu-nearest gpu-clamp gpu-compare-none)]
           [screen (gpu-bind-group! 0 pipeline 0 1)])
      (gpu-bind-buffer! 0 uniforms 0 0)
      (let ([picture (gpu-bind-group! 0 pipeline 1 2)] [size (array f32 4)] [data (array u8 128)])
        (gpu-bind-sampler! 0 sampler)
        (gpu-bind-texture! 1 sheet)
        (gpu-write-buffer! uniforms 0 size 16)
        (gpu-write-buffer! instances 0 data 128)
        (gpu-render-pass! 1 0 0 0 0 0.0)
        (gpu-pass-target! gpu-on-surface surface 0 0 gpu-clear 0.5 0.75 1.0 1.0)
        (gpu-pipeline! pipeline)
        (gpu-bind-group-set! 0 screen 0)
        (gpu-bind-group-set! 1 picture 0)
        (gpu-vertex-buffer! 0 instances 0)
        (gpu-draw! 6 2 0 0)
        (gpu-end-pass!)
        (trace-gpu!)

        (let* ([layout (gpu-layout! 2)])
          (gpu-layout-entry! 0 gpu-in-compute gpu-storage-entry)
          (gpu-layout-entry! 1 gpu-in-compute gpu-dynamic-uniform-entry)
          (let* ([compute (gpu-compute-pipeline! shader "step" 1)])
            (gpu-layout-item! layout)
            (let* ([state (gpu-buffer! 4096 gpu-storage)]
                   [group (gpu-bind-group! layout 0 0 2)])
              (gpu-bind-buffer! 0 state 0 0)
              (gpu-bind-buffer! 1 uniforms 0 16)
              (gpu-compute-pass!)
              (gpu-pipeline! compute)
              (gpu-bind-group-set! 0 group 1)
              (gpu-offset! 256)
              (gpu-dispatch! 4 1 1)
              (gpu-end-pass!)
              (gpu-read-buffer! state 0 64)
              (let ([depth (gpu-texture! 320 180 1 1 gpu-depth24 0)])
                (gpu-render-pass! 0 depth 0 0 gpu-clear 1.0)
                (gpu-end-pass!)
                (gpu-read-texture! sheet 0 0 8 8 2 2)
                (gpu-destroy! gpu-kind-texture depth))
              (trace-gpu!))))))))
