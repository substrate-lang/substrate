;; A test of lib/web/game/terrain.sub: a small height map, its heights
;; and slopes between the samples, its mesh, its texture, and a walker.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified terrain "../../lib/web/game/terrain.sub")
(require-unqualified noise "../../lib/web/game/noise.sub")
(require-unqualified gpu "../../lib/web/gpu.sub")
(require-unqualified trace "../../lib/web/trace.sub")
(require-unqualified format "../../lib/web/game/format.sub")
(memory from base)
(table from base)

(define land terrain)

;; Grass below 3, rock above.
(define (paint [x f64] [z f64] [h f64] [slope f64]) -> u32 (if (< h 3.0) #x57ab5aff #x8a929cff))

(define (main)
  ;; A ramp: height = column, on a 4 by 3 grid 2 units apart.
  (terrain-init! (& land) 4 3 2.0)
  (for ([r i32 0]) (< r 3) (+= r 1)
    (for ([c i32 0]) (< c 4) (+= c 1)
      (terrain-set! (& land) c r (cast f64 c))))
  (print-format "heights: at (0, 0) ~.2f, at (2, 1) ~.2f (the first step), at (3, 3) ~.2f (between steps), at (6, 4) ~.2f, beyond the edge (20, 20) ~.2f\n"
                (terrain-height (& land) 0.0 0.0) (terrain-height (& land) 2.0 1.0) (terrain-height (& land) 3.0 3.0)
                (terrain-height (& land) 6.0 4.0) (terrain-height (& land) 20.0 20.0))
  (print-format "slopes: on the ramp ~.2f, past its end ~.2f\n" (terrain-slope (& land) 3.0 2.0) (terrain-slope (& land) 20.0 2.0))
  (let ([vertices buffer] [indices buffer])
    (terrain-mesh! (& land) (& vertices) (& indices) 8.0 8.0 paint)
    (print-format "the mesh: ~d vertices, ~d triangles\n" (/ (-> vertices length) 40) (/ (-> indices length) 12))
    ;; Vertex 5 is column 1 of row 1: at (2, 1, 2), its normal leaning
    ;; back against the ramp, grass: the colour's bytes as the GPU reads
    ;; them, r, g, b, then a, which is how much it sways: not at all.
    (let ([f (cast (ptr f32) (+ (-> vertices bytes) (* 5 40)))] [bytes (+ (-> vertices bytes) (* 5 40))])
      (print-format "  vertex 5: at ~.1f ~.1f ~.1f, normal ~.2f ~.2f ~.2f, texel ~.0f ~.0f, shade ~.0f, colour ~x ~x ~x ~x\n"
                    (cast f64 (@ f 0)) (cast f64 (@ f 1)) (cast f64 (@ f 2)) (cast f64 (@ f 3)) (cast f64 (@ f 4)) (cast f64 (@ f 5))
                    (cast f64 (@ f 6)) (cast f64 (@ f 7)) (cast f64 (@ f 8)) (@ bytes 36) (@ bytes 37) (@ bytes 38) (@ bytes 39)))
    (let ([i (cast (ptr u32) (-> indices bytes))])
      (print-format "  the first cell's triangles: ~d ~d ~d, ~d ~d ~d\n" (@ i 0) (@ i 1) (@ i 2) (@ i 3) (@ i 4) (@ i 5))))
  (print-string "the texture:\n")
  (terrain-texture! (& land))
  (trace-gpu!)
  ;; A walker dropped above the ramp lands on it, walks up it, and walks
  ;; off its far end onto the top.
  (let ([w walker])
    (set! (-> w x) 1.0) (set! (-> w z) 2.0) (set! (-> w y) 5.0)
    (for ([i u32 0]) (< i 8) (+= i 1)
      (-= (-> w vy) 0.3)
      (walker-move! (& land) (& w) 0.0 0.0))
    (print-format "landed: at ~.2f ~.2f ~.2f, on the ground ~d\n" (-> w x) (-> w y) (-> w z) (-> w on-ground))
    (for ([i u32 0]) (< i 10) (+= i 1)
      (-= (-> w vy) 0.3)
      (walker-move! (& land) (& w) 0.5 0.0))
    (print-format "walked up: at ~.2f ~.2f ~.2f, on the ground ~d\n" (-> w x) (-> w y) (-> w z) (-> w on-ground))
    ;; A jump: up, then down again.
    (set! (-> w vy) 1.0)
    (walker-move! (& land) (& w) 0.0 0.0)
    (print-format "jumping: at ~.2f ~.2f ~.2f, on the ground ~d\n" (-> w x) (-> w y) (-> w z) (-> w on-ground)))
  (print-format "noise: ~.3f ~.3f ~.3f, the same twice ~d, fbm ~.3f\n"
                (value-noise 1.5 2.5 1) (value-noise 1.5 2.5 2) (value-noise 100.25 7.75 1)
                (== (value-noise 3.3 4.4 7) (value-noise 3.3 4.4 7)) (fbm 10.5 20.5 4 3))
  (terrain-free! (& land)))
