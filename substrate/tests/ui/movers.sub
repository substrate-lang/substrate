;; Movers: walking on land, stopped by trees and boxes, kept on walkways, wading, steered.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified format "../../lib/web/game/format.sub")
(require-unqualified vector "../../lib/web/game/vector.sub")
(require-unqualified store "../../lib/web/game/store.sub")
(require-unqualified terrain "../../lib/web/game/terrain.sub")
(require-unqualified space "../../lib/web/game/space.sub")
(require-unqualified movers "../../lib/web/game/movers.sub")
(require-unqualified math "../../lib/web/scene/math.sub")

(define land terrain)
(define s space)

(define (where [what (ptr u8)] [m (ptr mover)])
  (print-format "  ~s: at ~.2f ~.2f ~.2f~s, heading ~.2f\n" what (-> m x) (-> m y) (-> m z)
                (if (-> m on-ground) ", standing" (if (> (-> m in-water) 0.0) ", in the water" ", in the air")) (-> m heading)))

(define (walk! [m (ptr mover)] [vx f64] [vz f64] [steps u32])
  (set! (-> m vx) vx)
  (set! (-> m vz) vz)
  (for ([i u32 0]) (< i steps) (+= i 1) (mover-step! m (& land) (& s) 2.0)))

(define (main)
  (terrain-init! (& land) 65 65 1.0)
  (for ([r i32 0]) (< r 65) (+= r 1)
    (for ([c i32 0]) (< c 65) (+= c 1)
      (let* ([x (cast f64 c)] [z (cast f64 r)]
             [dx (- x 40.0)] [dz (- z 40.0)]
             [pond (- 3.0 (* 3.0 (clamp (- 1.0 (/ (sqrt (+ (* dx dx) (* dz dz))) 6.0)) 0.0 1.0)))]
             [cliff (if (> z 56.0) (* (- z 56.0) 4.0) 0.0)])
        (terrain-set! (& land) c r (+ pond cliff)))))
  (space-init! (& s) 64.0 64.0 8.0)
  (space-add! (& s) (disc 1.0 6.0) 1 1 20.0 3.0 20.0)
  (space-add! (& s) (box 2.0 2.0 0.0 3.0) 2 1 20.0 3.0 32.0)
  (space-add! (& s) (walkway 6.0 1.5 0.0 2.0 1) 3 1 10.0 3.0 48.0)
  (let ([m mover])
    (mover-init! (& m) 20.0 3.0 10.0 0.4 1.8)
    (mover-enter! (& m) (& s) 0 1)
    (print-string "a mover 0.4 across, dropped from 8 up, falls and lands:\n")
    (set! (-> m y) 8.0)
    (walk! (& m) 0.0 0.0 20)
    (where "after 20 steps" (& m))
    (walk! (& m) 0.0 0.0 40)
    (where "after 60" (& m))
    (print-string "walking +z at 0.1 a step into a tree at (20, 20), 1 across:\n")
    (walk! (& m) 0.0 0.1 120)
    (where "after 120 steps" (& m))
    (print-format "  which is ~.2f from the tree's middle; its radius and the mover's add to 1.4\n" (mover-distance (& m) 20.0 20.0))
    (print-string "walking at it a little to the side slides round:\n")
    (set! (-> m x) 20.6)
    (set! (-> m z) 15.0)
    (walk! (& m) 0.0 0.1 100)
    (where "after 100 steps" (& m))
    (print-string "a jump:\n")
    (mover-jump! (& m) 0.15)
    (walk! (& m) 0.0 0.0 1)
    (where "the next step" (& m))
    (walk! (& m) 0.0 0.0 40)
    (where "after 40 more" (& m))
    (print-string "into the box at (20, 32), 4 by 4, from the south-west corner's side:\n")
    (set! (-> m x) 18.5)
    (set! (-> m z) 27.0)
    (walk! (& m) 0.0 0.1 60)
    (where "after 60 steps" (& m))
    (print-string "onto the walkway at (10, 48), 12 long, its deck 2 up, from its east end:\n")
    (set! (-> m x) 17.0)
    (set! (-> m z) 48.0)
    (set! (-> m y) 5.0)
    (walk! (& m) -0.1 0.0 30)
    (where "after 30 steps" (& m))
    (print-string "walking along it diagonally, the rails keep it on:\n")
    (walk! (& m) -0.1 0.05 40)
    (where "after 40 steps" (& m))
    (print-string "off the west end, which is at x 4, onto the land at 3:\n")
    (walk! (& m) -0.1 0.0 120)
    (where "after 120 steps" (& m))
    (print-string "into the pond at (40, 40), 3 deep, with the water at 2:\n")
    (set! (-> m x) 30.0)
    (set! (-> m z) 40.0)
    (set! (-> m y) 3.0)
    (walk! (& m) 0.1 0.0 100)
    (where "after 100 steps" (& m))
    (print-format "  in the water ~.2f deep: held up at the wading depth, 1\n" (-> m in-water))
    (print-string "up the cliff at z 56, a slope of 4:\n")
    (set! (-> m x) 30.0)
    (set! (-> m z) 50.0)
    (set! (-> m y) 3.0)
    (walk! (& m) 0.0 0.1 100)
    (where "after 100 steps" (& m))
    (print-string "steering: facing +z, told to turn towards (30, 10) by at most 0.1 a step:\n")
    (set! (-> m x) 20.0)
    (set! (-> m z) 10.0)
    (set! (-> m y) 3.0)
    (set! (-> m heading) 0.0)
    (set! (-> m speed) 0.1)
    (for ([i u32 0]) (< i 10) (+= i 1)
      (steer-toward! (& m) 30.0 10.0 0.1)
      (mover-aim! (& m))
      (mover-step! (& m) (& land) (& s) 2.0))
    (where "after 10 steps" (& m))
    (print-format "  the bearing of (30, 10) is ~.2f; the heading is on its way\n" (mover-bearing (& m) 30.0 10.0))
    (print-string "steering clear: facing the tree from (20, 15), the heading turns aside:\n")
    (set! (-> m x) 20.0)
    (set! (-> m z) 15.0)
    (set! (-> m heading) 0.0)
    (for ([i u32 0]) (< i 30) (+= i 1)
      (steer-clear! (& m) (& s) (kinds-all) 0.08)
      (mover-aim! (& m))
      (mover-step! (& m) (& land) (& s) 2.0))
    (where "after 30 steps" (& m))
    (print-format "  ~.2f from the tree: never touched it\n" (mover-distance (& m) 20.0 20.0))
    (print-string "arriving: the speed falls within 4 of the goal:\n")
    (set! (-> m x) 20.0)
    (set! (-> m z) 10.0)
    (set! (-> m heading) 0.0)
    (for ([i u32 0]) (< i 80) (+= i 1)
      (steer-toward! (& m) 20.0 18.0 0.2)
      (steer-arrive! (& m) 20.0 18.0 4.0 0.15)
      (mover-aim! (& m))
      (mover-step! (& m) (& land) (& s) 2.0))
    (where "after 80 steps" (& m))
    (print-format "  speed ~.3f\n" (-> m speed))
    (print-string "a swimmer in the pond, 3 deep at (40, 40), with the water at 2: told to go down, it stops its radius above the bed:\n")
    (set! (-> m swims) 1)
    (set! (-> m x) 40.0)
    (set! (-> m z) 40.0)
    (set! (-> m y) 1.0)
    (set! (-> m vy) -0.05)
    (walk! (& m) 0.0 0.0 40)
    (where "after 40 steps" (& m))
    (print-format "  ~.2f deep in the water\n" (-> m in-water))
    (set! (-> m vy) 0.05)
    (walk! (& m) 0.0 0.0 40)
    (where "told to go up, after 40" (& m))
    (set! (-> m swims) 0)
    (mover-leave! (& m) (& s))
    (print-format "left the space: ~d entries\n" (space-count (& s)))))
