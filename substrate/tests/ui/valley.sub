;; A test of the valley example (lib/web/examples/valley/world.sub) that
;; needs no browser: the land is made, its heights and what grows on
;; it are described, and the player walks, runs, jumps and looks around
;; by made-up key presses, is stopped by a tree, crosses the bridge and
;; wades into the river. The GPU commands the game writes are counted:
;; the meshes are large.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified format "../../lib/web/game/format.sub")
(require-unqualified input "../../lib/web/game/input.sub")
(require-unqualified terrain "../../lib/web/game/terrain.sub")
(require-unqualified math "../../lib/web/scene/math.sub")
(require-unqualified light "../../lib/web/scene/light.sub")
(require-unqualified gpu "../../lib/web/gpu.sub")
(require-unqualified world "../../lib/web/examples/valley/world.sub")
(memory from base)
(table from base)

(define game world)
(define keys input)

(define (step)
  (world-step! (& game) (& keys))
  (input-end-step! (& keys)))

(define (steps [n u32]) (for ([i u32 0]) (< i n) (+= i 1) (step)))

(define (where)
  (print-format "  the player is at ~.2f ~.2f ~.2f~s, looking ~.2f ~.2f\n"
                (-> game player x) (-> game player y) (-> game player z)
                (if (-> game player on-ground) ", on the ground" ", in the air")
                (-> game yaw) (-> game pitch)))

(define (gpu-commands-written [what (ptr u8)])
  (let ([b (gpu-commands)])
    (print-format "  ~s: ~d bytes of GPU commands\n" what (-> b length))
    (gpu-commands-done!)))

(define (main)
  (world-init! (& game))
  (print-string "the land:\n")
  (print-format "  ~d units across; the river bed at (150, 24) is ~.1f high, the valley floor at (128, 24) ~.1f, a hill at (60, 120) ~.1f, the mountains at (6, 200) ~.1f, the lake bed at (144, 128) ~.1f, the knoll at the stones ~.1f; the water is at ~.1f\n"
                world-size (land-height 150.0 24.0) (land-height 128.0 24.0) (land-height 60.0 120.0) (land-height 6.0 200.0)
                (land-height 144.0 128.0) (land-height stones-x stones-z) water-level)
  (print-format "  the same from the height map: ~.1f, ~.1f\n" (terrain-height (& (-> game land)) 150.0 24.0) (terrain-height (& (-> game land)) 60.0 120.0))
  (print-format "  the path passes (~.1f, 30): ~s; (100, 30) is ~s\n" (+ 128.0 (* 28.0 (sin (/ 30.0 45.0))) (* 10.0 (sin (+ (/ 30.0 17.0) 1.0))) 12.0)
                (if (on-path? (+ 128.0 (* 28.0 (sin (/ 30.0 45.0))) (* 10.0 (sin (+ (/ 30.0 17.0) 1.0))) 12.0) 30.0) "on it" "off it")
                (if (on-path? 100.0 30.0) "on it" "off it"))
  (print-format "  ~d trees, ~d tufts of grass around the player, ~d boulders, ~d birds over the lake; the hut is at ~.1f ~.1f\n"
                (tree-count (& game)) (grass-count (& game)) (rock-count (& game)) (bird-count (& game)) hut-x hut-z)
  (print-format "  the land's mesh: ~d vertices, ~d triangles\n" (/ (-> game ground vertices length) 44) (/ (-> game ground indices length) 12))
  (print-format "  the day: at the start it is ~.2f of the way through, ~s; the sun is at ~.2f ~.2f ~.2f, ~x; four minutes on, ~.2f, ~s\n"
                (time-of-day 0.0) (day-name (time-of-day 0.0)) (-> game light sun-x) (-> game light sun-y) (-> game light sun-z) (-> game light sun)
                (time-of-day 240.0) (day-name (time-of-day 240.0)))
  (where)
  (facing-checks)
  (gpu-commands-written "setting up")
  (world-draw (& game))
  (gpu-commands-written "the first frame")

  (print-string "walking up the valley for two seconds, then running for one:\n")
  (input-key-down! (& keys) #\w)
  (steps 120)
  (where)
  (input-key-down! (& keys) key-shift)
  (steps 60)
  (input-key-up! (& keys) key-shift)
  (input-key-up! (& keys) #\w)
  (where)
  (print-string "a jump:\n")
  (input-key-down! (& keys) key-space)
  (step)
  (input-key-up! (& keys) key-space)
  (where)
  (steps 40)
  (where)
  (print-string "turning with the mouse, and looking down with the key:\n")
  (input-mouse-lock! (& keys) 1)
  (input-mouse-move! (& keys) 200.0 0.0)
  (input-key-down! (& keys) key-down)
  (step)
  (input-key-up! (& keys) key-down)
  (where)

  (print-string "over the bridge: put on the path at its east end, looking west, and walking:\n")
  (world-look! (+ (- bridge-z bridge-z) (+ 128.0 (* 28.0 (sin (/ bridge-z 45.0))) (* 10.0 (sin (+ (/ bridge-z 17.0) 1.0))) 13.0)) bridge-z (/ pi -2.0) 0.0)
  (input-key-down! (& keys) #\w)
  (steps 60)
  (where)
  (print-format "  which is the deck's height, ~.1f\n" bridge-deck)
  (steps 120)
  (input-key-up! (& keys) #\w)
  (where)

  (print-string "into a tree: put in front of a fir, walking at it for a second:\n")
  (let ([p (-> game firs places)] [nearest 1000.0])
    (world-look! (- (cast f64 (-> p x)) 4.0) (cast f64 (-> p z)) (/ pi 2.0) 0.0)
    (input-key-down! (& keys) #\w)
    (for ([i u32 0]) (< i 60) (+= i 1)
      (step)
      (let* ([dx (- (-> game player x) (cast f64 (-> p x)))] [dz (- (-> game player z) (cast f64 (-> p z)))]
             [d (sqrt (+ (* dx dx) (* dz dz)))])
        (when (< d nearest) (set! nearest d))))
    (input-key-up! (& keys) #\w)
    (print-format "  the tree is at ~.2f ~.2f, its trunk ~.2f across; the player got no nearer its middle than ~.2f, and slid round it\n"
                  (cast f64 (-> p x)) (cast f64 (-> p z)) (* 1.8 (cast f64 (-> p scale))) nearest)
    (where))

  (print-string "into the hut: put west of it, walking east at it for two seconds:\n")
  (world-look! (- hut-x 6.0) hut-z (/ pi 2.0) 0.0)
  (input-key-down! (& keys) #\w)
  (steps 120)
  (input-key-up! (& keys) #\w)
  (where)
  (print-format "  which is outside its west wall, at ~.1f\n" (- hut-x 2.6))

  (print-string "wading into the river from its bank:\n")
  (world-look! (+ 128.0 (* 28.0 (sin (/ 100.0 45.0))) (* 10.0 (sin (+ (/ 100.0 17.0) 1.0))) 10.0) 100.0 (/ pi -2.0) 0.0)
  (input-key-down! (& keys) #\w)
  (steps 150)
  (input-key-up! (& keys) #\w)
  (where))

;; Every triangle of a mesh should face the way its vertices' normals
;; say: the cross product of its edges along their normals. A triangle
;; wound the other way is culled by the GPU, and the inside of the
;; thing shows instead. Cards (the leaves, the blades) are turned every
;; way on purpose, with the crown's normal, so they are left out.
(define (facing-check [what (ptr u8)] [vertices (ptr buffer)] [indices (ptr buffer)])
  (let ([wrong u32 0] [checked u32 0] [n (/ (-> indices length) 12)] [ix (cast (ptr u32) (-> indices bytes))])
    (for ([t u32 0]) (< t n) (+= t 1)
      (let* ([a (cast (ptr f32) (+ (-> vertices bytes) (* (@ ix (* t 3)) 44)))]
             [b (cast (ptr f32) (+ (-> vertices bytes) (* (@ ix (+ (* t 3) 1)) 44)))]
             [c (cast (ptr f32) (+ (-> vertices bytes) (* (@ ix (+ (* t 3) 2)) 44)))]
             [material (@ a 9)])
        (unless (or (== material 7.0) (== material 8.0))
          (let* ([ux (- (@ b 0) (@ a 0))] [uy (- (@ b 1) (@ a 1))] [uz (- (@ b 2) (@ a 2))]
                 [vx (- (@ c 0) (@ a 0))] [vy (- (@ c 1) (@ a 1))] [vz (- (@ c 2) (@ a 2))]
                 [nx (- (* uy vz) (* uz vy))] [ny (- (* uz vx) (* ux vz))] [nz (- (* ux vy) (* uy vx))]
                 [mx (+ (@ a 3) (@ b 3) (@ c 3))] [my (+ (@ a 4) (@ b 4) (@ c 4))] [mz (+ (@ a 5) (@ b 5) (@ c 5))]
                 [agree (+ (* nx mx) (* ny my) (* nz mz))])
            (+= checked 1)
            (when (< agree 0.0) (+= wrong 1))))))
    (print-format "  ~s: ~d triangles checked, ~d wound against their normals\n" what checked wrong)))

(define (facing-checks)
  (print-string "the meshes face outwards:\n")
  (facing-check "the land" (& (-> game ground vertices)) (& (-> game ground indices)))
  (facing-check "the bridge" (& (-> game bridge vertices)) (& (-> game bridge indices)))
  (facing-check "the jetty" (& (-> game jetty vertices)) (& (-> game jetty indices)))
  (facing-check "the hut" (& (-> game hut vertices)) (& (-> game hut indices)))
  (facing-check "a fir" (& (-> game firs vertices)) (& (-> game firs indices)))
  (facing-check "an oak" (& (-> game oaks vertices)) (& (-> game oaks indices)))
  (facing-check "a birch" (& (-> game birches vertices)) (& (-> game birches indices)))
  (facing-check "a boulder" (& (-> game rocks vertices)) (& (-> game rocks indices)))
  (facing-check "a standing stone" (& (-> game stones vertices)) (& (-> game stones indices))))
