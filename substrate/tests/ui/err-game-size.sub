;; A game's screen size must be two numbers, since it becomes the canvas's HTML size.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified input "../../lib/web/game/input.sub")
(require-unqualified game "../../lib/web/game/game.sub")
(memory from base)
(table from base)

(struct world [ticks u32])
(define wide i32 320)
(define (init [w (ptr world)]) 0)
(define (step [w (ptr world)] [in (ptr input)]) 0)
(define (draw [w (ptr world)]) 0)

(game world [size wide 180] init step draw)
