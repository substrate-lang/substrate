;; The game library's keyboard and mouse state, and its list of sounds to play.
(require-unqualified substrate "../../compiler/substrate/substrate.sub")
(require-unqualified input "../../lib/web/game/input.sub")
(require-unqualified sound "../../lib/web/game/sound.sub")
(require print "../../compiler/print.sub")

(define keys input)

(define (see [what (ptr u8)] [code u32])
  (print-string "  ")
  (print-string what)
  (print-string ":")
  (when (held? (& keys) code) (print-string " held"))
  (when (pressed? (& keys) code) (print-string " pressed"))
  (when (released? (& keys) code) (print-string " released"))
  (unless (or (held? (& keys) code) (pressed? (& keys) code) (released? (& keys) code)) (print-string " nothing"))
  (print-string "\n"))

(define (number [n u32]) (print:write-u64 (cast u64 n)))

(define (see-mouse [what (ptr u8)] [button u32])
  (print-string "  ")
  (print-string what)
  (print-string ":")
  (when (mouse-held? (& keys) button) (print-string " held"))
  (when (mouse-pressed? (& keys) button) (print-string " pressed"))
  (when (mouse-released? (& keys) button) (print-string " released"))
  (unless (or (mouse-held? (& keys) button) (mouse-pressed? (& keys) button) (mouse-released? (& keys) button)) (print-string " nothing"))
  (print-string "; moved ") (print:write-int (cast i32 (mouse-dx (& keys))))
  (print-string " ") (print:write-int (cast i32 (mouse-dy (& keys))))
  (print-string "\n"))

(define (main)
  (print-string "key codes\n")
  (print-string "  the arrows: ")
  (number (key-code "ArrowLeft")) (print-string " ")
  (number (key-code "ArrowRight")) (print-string " ")
  (number (key-code "ArrowUp")) (print-string " ")
  (number (key-code "ArrowDown")) (print-string "\n")
  (print-string "  space, Enter, Escape, Shift: ")
  (number (key-code " ")) (print-string " ")
  (number (key-code "Enter")) (print-string " ")
  (number (key-code "Escape")) (print-string " ")
  (number (key-code "Shift")) (print-string "\n")
  (print-string "  a and A are the same key: ")
  (number (key-code "a")) (print-string " ")
  (number (key-code "A")) (print-string "\n")
  (print-string "  keys without a code: ")
  (number (key-code "Control")) (print-string " ")
  (number (key-code "F5")) (print-string " ")
  (number (key-code "")) (print-string "\n")

  (print-string "a key goes down: pressed during the first step only, held until it comes up\n")
  (input-key-down! (& keys) key-right)
  (see "step 1" key-right)
  (input-end-step! (& keys))
  (see "step 2" key-right)
  (input-key-down! (& keys) key-right)
  (input-end-step! (& keys))
  (see "step 3, after an auto-repeat" key-right)
  (input-key-up! (& keys) key-right)
  (see "step 4, after it came up" key-right)
  (input-end-step! (& keys))
  (see "step 5" key-right)

  (print-string "a tap that is over before the step still counts as a press\n")
  (input-key-down! (& keys) key-space)
  (input-key-up! (& keys) key-space)
  (see "the step after the tap" key-space)
  (input-end-step! (& keys))
  (see "the step after that" key-space)

  (print-string "a key without a code is never recorded\n")
  (input-key-down! (& keys) (key-code "Control"))
  (see "key-none" key-none)

  (print-string "clearing forgets held keys\n")
  (input-key-down! (& keys) key-left)
  (input-key-down! (& keys) #\a)
  (input-clear! (& keys))
  (see "left" key-left)
  (see "a" #\a)

  (print-string "the mouse: buttons like keys, movement added up over a step\n")
  (input-mouse-down! (& keys) mouse-left)
  (input-mouse-move! (& keys) 12.0 -3.0)
  (input-mouse-move! (& keys) 8.0 -2.0)
  (see-mouse "step 1" mouse-left)
  (input-end-step! (& keys))
  (see-mouse "step 2" mouse-left)
  (input-mouse-up! (& keys) mouse-left)
  (input-mouse-down! (& keys) mouse-right)
  (see-mouse "step 3, left" mouse-left)
  (see-mouse "step 3, right" mouse-right)
  (input-end-step! (& keys))
  (print-string "  a button that is not a button: ") (number (cast u32 (mouse-held? (& keys) 7))) (print-string "\n")
  (print-string "  locked: ") (number (cast u32 (mouse-locked? (& keys))))
  (input-mouse-lock! (& keys) 1)
  (print-string ", then ") (number (cast u32 (mouse-locked? (& keys))))
  (input-clear! (& keys))
  (print-string ", and after clearing still ") (number (cast u32 (mouse-locked? (& keys)))) (print-string "\n")
  (see-mouse "after clearing, right" mouse-right)

  (print-string "sounds wait in a list until the game loop plays them\n")
  (play-tone square-wave 300.0 600.0 120.0 0.2)
  (play-tone sawtooth-wave 300.0 60.0 400.0 0.3)
  (print-string "  waiting: ") (number (tones-waiting)) (print-string "\n")
  (let ([t (tone-at 1)])
    (print-string "  the second: wave ") (number (-> t wave))
    (print-string ", from ") (number (cast u32 (-> t from)))
    (print-string " to ") (number (cast u32 (-> t to)))
    (print-string " hertz, ") (number (cast u32 (-> t ms)))
    (print-string " ms\n"))
  (tones-clear!)
  (print-string "  after clearing: ") (number (tones-waiting)) (print-string "\n")
  (for ([i u32 0]) (< i 40) (+= i 1) (play-tone sine-wave 440.0 440.0 50.0 0.1))
  (print-string "  of 40 tones in one frame, kept: ") (number (tones-waiting)) (print-string "\n"))
