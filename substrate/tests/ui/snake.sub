;; Snake without a browser: a scripted game with a fixed seed and made-up times.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified rules "../../lib/web/examples/snake/rules.sub")
(require print "../../compiler/print.sub")

(define game snake)

(define (number [n u32]) (print:write-u64 (cast u64 n)))

(define (status)
  (let ([state (-> game state)])
    (print-string (cond [(== state snake-waiting) "waiting"]
                        [(== state snake-playing) "playing"]
                        [(== state snake-paused) "paused"]
                        [(== state snake-over) "over"]
                        [else "won"])))
  (print-string ", score ")
  (number (-> game score))
  (print-string ", length ")
  (number (-> game length))
  (print-string ", head at ")
  (number (cast u32 (-> (snake-segment (& game) 0) x)))
  (print-string ",")
  (number (cast u32 (-> (snake-segment (& game) 0) y)))
  (print-string "\n"))

(define (board)
  (let ([head (snake-segment (& game) 0)])
    (for ([y i32 0]) (< y snake-rows) (+= y 1)
      (for ([x i32 0]) (< x snake-columns) (+= x 1)
        (print-string (cond [(and (== x (-> head x)) (== y (-> head y))) "O"]
                            [(snake-occupied? (& game) x y) "o"]
                            [(and (== x (-> game food x)) (== y (-> game food y))) "*"]
                            [else "."])))
      (print-string "\n"))))

(define (steps [n u32])
  (for ([i u32 0]) (< i n) (+= i 1) (snake-step! (& game))))

(define (frame [now f64])
  (print-string "frame at ")
  (number (cast u32 now))
  (print-string (if (snake-advance! (& game) now) " ms: a step, " " ms: no step, "))
  (status))

(define (eat!)
  (let ([target (-> game score)])
    (while (and (== (-> game score) target) (== (-> game state) snake-playing))
      (let* ([head (snake-segment (& game) 0)] [d (-> game direction)]
             [want (cond [(< (-> game food y) (-> head y)) snake-up]
                         [(> (-> game food y) (-> head y)) snake-down]
                         [(< (-> game food x) (-> head x)) snake-left]
                         [else snake-right])])
        (when (== want (% (+ d 2) 4)) (set! want (% (+ d 1) 4)))
        (snake-turn! (& game) want)
        (snake-step! (& game))))))

(define (main)
  (print-string "a new game\n")
  (snake-reset! (& game) 1)
  (status)
  (board)

  (print-string "steps do nothing until the first turn\n")
  (steps 3)
  (status)

  (print-string "right starts the game; three steps\n")
  (snake-turn! (& game) snake-right)
  (steps 3)
  (status)

  (print-string "a reversal is ignored\n")
  (snake-turn! (& game) snake-left)
  (steps 1)
  (status)

  (print-string "two turns before one step both count, in order; a third is dropped\n")
  (snake-turn! (& game) snake-up)
  (snake-turn! (& game) snake-left)
  (snake-turn! (& game) snake-down)
  (steps 1)
  (status)
  (steps 1)
  (status)
  (steps 1)
  (status)

  (print-string "eating the food: one point, one cell longer, new food\n")
  (eat!)
  (status)
  (board)

  (print-string "a snake of 4 can turn in a 2 by 2 circle: its tail moves out of the way\n")
  (let ([d (-> game direction)])
    (for ([i u32 1]) (<= i 8) (+= i 1)
      (snake-turn! (& game) (% (+ d i) 4))
      (steps 1)))
  (status)

  (print-string "two more\n")
  (eat!)
  (eat!)
  (status)

  (print-string "a snake of 6 cannot: it runs into itself\n")
  (let ([d (-> game direction)])
    (for ([i u32 1]) (<= i 4) (+= i 1)
      (snake-turn! (& game) (% (+ d i) 4))
      (steps 1)))
  (status)
  (board)

  (print-string "steps do nothing once the game is over\n")
  (steps 3)
  (status)

  (print-string "a new game, started to the left: the snake is reversed first\n")
  (snake-reset! (& game) 1)
  (snake-turn! (& game) snake-left)
  (steps 1)
  (status)

  (print-string "straight into the wall\n")
  (steps 7)
  (status)
  (steps 1)
  (status)

  (print-string "another seed puts the food elsewhere\n")
  (snake-reset! (& game) 2)
  (status)
  (board)

  (print-string "frames before the game starts do nothing\n")
  (snake-reset! (& game) 1)
  (frame 500.0)
  (print-string "the first frame after the start only records the time\n")
  (snake-turn! (& game) snake-right)
  (frame 1000.0)
  (print-string "a step is due 130 ms later, however many frames come in between\n")
  (frame 1016.0)
  (frame 1100.0)
  (frame 1129.0)
  (frame 1130.0)
  (print-string "a late frame takes every step that is due: 270 ms is two steps\n")
  (frame 1400.0)
  (print-string "but at most 5 steps: after a long gap the rest of the time is dropped\n")
  (frame 9000.0)
  (frame 9100.0)
  (print-string "a pause: no steps, turns are ignored, and the time paused does not count afterwards\n")
  (snake-toggle-pause! (& game))
  (frame 9500.0)
  (snake-turn! (& game) snake-up)
  (snake-toggle-pause! (& game))
  (frame 20000.0)
  (frame 20130.0)
  (print-string "into the wall\n")
  (frame 20260.0)
  (frame 20390.0))
