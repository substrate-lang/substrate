;; Timers: messages set to arrive after a number of steps.
(require-unqualified format "../../lib/web/game/format.sub")
(require-unqualified store "../../lib/web/game/store.sub")
(require-unqualified timers "../../lib/web/game/timers.sub")

(struct enemy [name u32])

(variant event
  [enemy-gone [who (handle enemy)]]
  [say [text (ptr u8)]]
  [again [times u32]])

(struct world [enemies (store enemy)] [timers (timers event)])
(define the-world world)

(define (happen! [w (ptr world)] [e (ptr event)])
  (match e
    [(enemy-gone who)
     (let ([it (store-find (& (-> w enemies)) who)])
       (if (== it 0)
           (print-format " enemy-gone(already gone)")
           (begin
             (print-format " enemy-gone(~c)" (-> it name))
             (store-remove! (& (-> w enemies)) who))))]
    [(say text) (print-format " say(~s)" text)]
    [(again times)
     (print-format " again(~d)" times)
     (when (> times 1) (after! (& (-> w timers)) 2 (again (- times 1))))]))

(define (step! [w (ptr world)] [n u32])
  (timers-step! (& (-> w timers)))
  (print-format "step ~d:" n)
  (let ([e event])
    (while (timer-due! (& (-> w timers)) (& e)) (happen! w (& e))))
  (print-format " (~d waiting)\n" (timers-waiting (& (-> w timers)))))

(define (main)
  (let* ([w (& the-world)] [a (store-add! (& (-> w enemies)))] [b (store-add! (& (-> w enemies)))])
    (set! (-> a name) #\a)
    (set! (-> b name) #\b)
    (print-format "no timers: ~d waiting\n" (timers-waiting (& (-> w timers))))
    (after! (& (-> w timers)) 3 (enemy-gone (store-handle (& (-> w enemies)) a)))
    (after! (& (-> w timers)) 1 (say "first"))
    (after! (& (-> w timers)) 3 (say "third"))
    (after! (& (-> w timers)) 0 (say "zero steps counts as one"))
    (after! (& (-> w timers)) 4 (again 3))
    (after! (& (-> w timers)) 5 (enemy-gone (store-handle (& (-> w enemies)) b)))
    (after! (& (-> w timers)) 6 (enemy-gone (store-handle (& (-> w enemies)) b)))
    (for ([n u32 1]) (<= n 9) (+= n 1) (step! w n))

    (for ([i u32 0]) (< i 20) (+= i 1) (after! (& (-> w timers)) (+ 1 (% i 2)) (again 1)))
    (step! w 10)
    (timers-clear! (& (-> w timers)))
    (step! w 11)
    (timers-free! (& (-> w timers)))
    (after! (& (-> w timers)) 1 (say "after freeing"))
    (step! w 12)))
