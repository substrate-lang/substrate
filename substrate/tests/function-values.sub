;; A function's value (spec 5.2): with #:value g, the function's name used
;; as an expression means the global g, in its own module and in others,
;; at any phase, while calls stay calls. identifier-function-signature
;; gives a function's signature (spec 2.3).
(require print "../lib/print.sub" write-int newline)
(require wd "../lib/write-datum.sub" write-datum)
(require v "fixtures/valued.sub")
(begin-for-syntax (require s syntax))

(type cell (struct (field n (mut i32))))
(global seven eqref (ref.i31 7))
(func (twice [x i32]) #:value seven -> i32 (i32.add x x))

(begin-for-syntax
  (func (signature-of [stx eqref]) -> eqref
    #`(quote #,(s:identifier-function-signature (s:cadr (s:syntax->list stx)))))
  (require print "../lib/print.sub")
  (require v "fixtures/valued.sub")
  (type cell (struct (field n (mut i32))))
  ;; At phase 1: the call and the value of a function required there.
  (v:next)
  (print:write-int (struct.get cell n (ref.cast (ref cell) v:counter)))
  (print:newline))
(define-syntax signature-of signature-of)

(func (main)
  (write-int (twice 4)) (newline)
  (write-int (i31.get_s (ref.cast (ref i31) twice))) (newline)
  (v:next) (v:next)
  (write-int (v:counter)) (write-int (struct.get cell n (ref.cast (ref cell) v:counter))) (newline)
  (write-int (ref.eq v:counter v:counter)) (newline)
  (write-datum (signature-of twice)) (newline)
  (write-datum (signature-of v:counter)) (newline)
  (write-datum (signature-of seven)) (newline))
