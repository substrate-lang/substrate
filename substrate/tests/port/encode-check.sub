;; Checks compiler/wasm.sub and compiler/serialize.sub on known bytes: the
;; module tests/hook.sub writes by hand, and a small datum.
(require-unqualified substrate "../../lib/substrate.sub")
(require w "../../compiler/wasm.sub" wmodule encode-module)
(require ser "../../compiler/serialize.sub" make-serializer serialize! serializer-bytes)
(require core "../../compiler/core.sub" make-type-info identify-group!)

(define (run)
  ;; (module (func (export "answer") (result i32) i32.const 42))
  (let ([m (wmodule '((func () (i32))) '() '((0 () ((i32.const 42)) "answer")) '() '() '()
                    '(("answer" func 0)) #f '() '() #f)])
    (display (equal? (encode-module m)
                     (bytes 0 97 115 109 1 0 0 0 1 5 1 96 0 1 127 3 2 1 0
                            7 10 1 6 97 110 115 119 101 114 0 0 10 6 1 4 0 65 42 11)))
    (newline))
  (let ([s (make-serializer)])
    (serialize! s '(a "b" #\c 5 -70000 18446744073709551615 #t))
    (display (bytes->list (serializer-bytes s)))
    (newline)))

(func (main) (run))
