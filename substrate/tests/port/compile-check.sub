;; Checks compiler/compile.sub on a module built by hand, the one stage0
;; compiles from (func (inc [x i32]) -> i32 (i32.add x 1)), writing its
;; bytes to the file named on the command line.
(require-unqualified substrate "../../lib/substrate.sub")
(require c "../../compiler/compile.sub" compile-module)
(require core "../../compiler/core.sub" func-info)

(define (run)
  (let* ([info (func-info 'inc '(i32) '(i32) #f #f #f)]
         [forms (list (list 'func info (list (cons 1 'i32))
                            '(at #f (seq (at #f (prim i32.add #f ((at #f (lref 1)) (at #f (int 1)))))))))]
         [result (compile-module forms "inc@0+0")])
    (display-to-file (car result) (vector-ref (current-command-line-arguments) 0))
    (write (cdr result))
    (newline)))

(func (main) (run))
