;; Writes what compiler/reader.sub reads from each file named on the command
;; line, as subc read writes what stage0 reads, so tests/port/check-reader.sh
;; can compare the two readers.
(require-unqualified substrate "../../lib/substrate.sub")
(require stx "../../compiler/stx.sub" stx? stx-e stx-srcloc srcloc-line srcloc-col srcloc-pos srcloc-span)
(require rd "../../compiler/reader.sub" read-file)
(require num "../../compiler/numbers.sub" flonum-bits)
(require s syntax)

(define (dump x)
  (cond [(stx? x)
         (let ([l (stx-srcloc x)])
           (printf "[~a:~a:~a:~a " (srcloc-line l) (srcloc-col l) (srcloc-pos l) (srcloc-span l))
           (dump (stx-e x))
           (display "]"))]
        [(pair? x)
         (display "(")
         (dump (car x))
         (let loop ([t (cdr x)])
           (cond [(pair? t) (display " ") (dump (car t)) (loop (cdr t))]
                 [(null? t) #f]
                 [else (display " . ") (dump t)]))
         (display ")")]
        [(null? x) (display "()")]
        [(symbol? x) (display "S") (display (symbol->string x))]
        [(keyword? x) (display "K") (display (keyword->string x))]
        [(string? x)
         (display "\"")
         (let loop ([cs (string->list x)] [first #t])
           (unless (null? cs)
             (unless first (display ","))
             (display (char->integer (car cs)))
             (loop (cdr cs) #f)))
         (display "\"")]
        [(char? x) (printf "C~a" (char->integer x))]
        [(integer? x) (display x)]
        [(boolean? x) (display (if x "#t" "#f"))]
        [else (printf "F~a" (flonum-bits x))]))

(define (run)
  (for-each (lambda (path) (for-each (lambda (d) (dump d) (newline)) (read-file path)))
            (vector->list (current-command-line-arguments))))

(func (main) (run))
