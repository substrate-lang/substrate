;; Strings are UTF-8, so bytes->string/utf-8 rejects bytes that are not,
;; unless it is given a character to put in their place
;; (lib/substrate/substrate.sub).
(require-unqualified substrate "../../lib/substrate/substrate.sub")
(define (run) (bytes->string/utf-8 (bytes 104 192 128)))
(func (main) (run))
