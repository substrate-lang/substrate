;; An eq? hash table's key must carry a hash: a pair does not, so it can
;; only be a key of an equal? table, which make-hash makes
;; (lib/languages/substrate/substrate.sub).
(require-unqualified substrate "../../lib/languages/substrate/substrate.sub")
(define (run) (hash-set! (make-hasheq) (list 1 2) 'x))
(func (main) (run))
