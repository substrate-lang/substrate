;; A Substrate struct for tests/substrate-match.sub. Its name is a form:
;; (pt x y) makes one, pt alone is the constructor, and match takes one
;; apart, in a module that requires this one at any phase.
(require-unqualified substrate "../../../lib/languages/substrate/substrate.sub")
(provide pt pt? pt-x pt-y)
(struct pt (x y))
