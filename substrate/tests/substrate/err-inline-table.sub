;; An inline Substrate function may not call through a function pointer, which uses the table.
(require-unqualified substrate "../../compiler/substrate/substrate.sub")

(define (apply1 [f (fn (i32) -> i32)] [x i32]) #:inline -> i32 (f x))
(define (double [x i32]) -> i32 (* x 2))
(define (main) (apply1 double 4))
