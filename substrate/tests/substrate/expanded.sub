;; A macro's expansion of Substrate's forms keeps them, with what is in them expanded, and the
;; expansion means what the forms did.
(begin-for-syntax
  (require-unqualified macros "../../compiler/macros.sub")
  (define (expanded [stx datum]) -> datum (local-expand (cadr (syntax->list stx))))
  (define (head-of [stx datum]) -> datum #`(quote #,(car (syntax->list (local-expand (cadr (syntax->list stx))))))))
(define-syntax expanded expanded)
(define-syntax head-of head-of)
(require-unqualified macros "../../compiler/macros.sub")

(variant shape [circle [r i32]] [rect [w i32] [h i32]])
(exception oops i32)
(struct point [x i32] [y i32])

(define (area [s shape]) -> i32 (expanded (match s [(circle r) (* 3 r r)] [(rect w h) (* w h)])))
(define (sum [n i32]) -> i32 (expanded (let ([t 0]) (for ([i 0]) (< i n) (+= i 1) (+= t i)) t)))
(define (caught) -> i32 (expanded (try (throw oops 5) [catch oops (v) (+ v 1)])))
(define (twice [x i32]) -> i32 (expanded (let ([f (lambda ([y i32]) -> i32 (* y 2))]) (f x))))
(define (moved) -> i32 (expanded (let ([p point]) (set! (-> p x) 3) (set! (-> p y) 4) (+ (-> p x) (-> p y)))))

(define (main)
  (write-int (area (rect 6 7))) (newline)
  (write-int (sum 10)) (newline)
  (write-int (caught)) (newline)
  (write-int (twice 21)) (newline)
  (write-int (moved)) (newline)
  (write-datum (head-of (cast u8 300))) (newline)
  (write-datum (head-of (when 1 2))) (newline))
