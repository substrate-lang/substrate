;; for/each, for/list and fmt, at run time and in macros.
(require-unqualified macros "../../compiler/macros.sub")
(begin-for-syntax
  (require-unqualified macros "../../compiler/macros.sub"))

(begin-for-syntax
  (define (count-syms [stx datum]) -> datum
    (let ([n i32 0])
      (for/each ([a (cdr (syntax->list stx))]) (when (symbol? (syntax-e a)) (+= n 1)))
      (datum->syntax stx (fixnum n) stx)))

  (define (squares [stx datum]) -> datum
    (datum->syntax stx (cons 'quote (cons (for/list ([a (cdr (syntax->list stx))])
                                            (let ([v (fixnum-value (syntax-e a))]) (fixnum (* v v))))
                                          nil))
                   stx)))
(define-syntax count-syms count-syms)
(define-syntax squares squares)

(begin-for-syntax (define (twice [stx datum]) -> datum (let ([x (cadr (syntax->list stx))]) (datum->syntax stx `(+ ,x ,x) stx))))
(define-syntax twice twice)

(define (main)
  (printf "~a\n" (count-syms a 1 b "s" c))
  (printf "~s\n" (squares 1 2 3 4))
  (printf "~a\n" (twice 21))
  (let ([l (cons (fixnum 1) (cons (fixnum 2) (cons (fixnum 3) (cons (fixnum 4) nil))))] [sum i32 0])
    (for/each ([x l])
      (when (== (fixnum-value x) 2) (continue))
      (when (== (fixnum-value x) 4) (break))
      (+= sum (fixnum-value x)))
    (printf "~a\n" sum)
    (printf "~s\n" (for/list ([x l]) (fixnum (* 10 (fixnum-value x)))))
    (printf "~s\n" (for/list ([x l] [y (cdr l)]) (fixnum (+ (fixnum-value x) (fixnum-value y)))))
    (printf "~s\n" (for/list ([x l] #:when (== (% (fixnum-value x) 2) 1)) x))
    (printf "~s\n" (fmt "~a and ~a, ~a" (fixnum 1) 'two (for/list ([x l]) x)))))
