;; An argument of the wrong shape shows the parameter's type, known parameters filled in.
(require-unqualified substrate "../../compiler/substrate/substrate.sub")

(struct #:forall (T) box [value T])
(struct #:forall (T U) pair [a T] [b U])
(define #:forall (T U) (join [a (ptr (box T))] [b (ptr (pair T U))]) -> i32 0)
(define (main)
  (let ([x (box i32)] [n 5])
    (join (& x) (& n))))
