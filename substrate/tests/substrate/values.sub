;; A function gives several values with a result type (values type ...).
(define (divmod [a u32] [b u32]) -> (values u32 u32) (values (/ a b) (% a b)))
(define (split [s (ptr u8)] [n i32]) -> (values (ptr u8) i32) (values (+ s n) n))
(struct pt [x i32] [y i32])
(define (ends [p (ptr pt)]) -> (values i32 i32)
  (let ([q pt])
    (set! (-> q x) (-> p x))
    (when (> (-> p y) 0) (return (values (-> q x) (-> p y))))
    (values 0 0)))
(define (main)
  (let ([(q r) (divmod 47 5)]) (write-int (cast i32 q)) (newline) (write-int (cast i32 r)) (newline))
  (let ([(s n) ((ptr u8) i32) (split "hello" 2)]) (print-string s) (newline) (write-int n) (newline))
  (let ([p pt])
    (set! (-> p x) 7)
    (set! (-> p y) 8)
    (let ([(a b) (ends (& p))]) (write-int (+ a b)) (newline))))
