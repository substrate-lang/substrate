(begin-for-syntax
  (require-unqualified macros "../../compiler/macros.sub")
  (define (twice [stx datum]) -> datum (syntax-match stx [(_ e) #`(* 2 #,e)])))
(define-syntax twice twice)

(struct point [x i32] [y i32])
(define (show [n i32]) (write-int n) (newline))
(define total i32 0)

(show (+ 1 2))
(show (twice 21))
(let ([p point])
  (set! (-> p x) 7)
  (set! (-> p y) 8)
  (set! total (* (-> p x) (-> p y))))
(show total)

(define (main) (show (- total 1)))
