;; wasm's own forms in Substrate code: they have wasm's types there, and Substrate's values and
;; variables keep their meanings around them.
(require wasm "../../compiler/wasm.sub")

(wasm:tag oops (i32))
(wasm:global counter (mut i32) 0)
(struct point [x i32] [y i32])
(define pt point)

;; wasm's throw and try, in their own syntax.
(define (checked-add [x i32] [limit i32]) -> i32
  (wasm:try ((catch oops (v) (- 0 v)) (catch-all -1))
    (when (> x limit) (wasm:throw oops x))
    (+ x 1)))

;; A branch carries a Substrate-typed value out of a block.
(define (first-point [k i32]) -> (ptr point)
  (wasm:block done
    (when (> k 0) (wasm:br done (& pt)))
    (cast (ptr point) 0)))

;; A wasm global is a Substrate variable.
(define (bump) (+= counter 1))

;; A wasm function's result is in wasm's terms: a pointer is an i32.
(wasm:func (point-address) -> i32 (& pt))

(define (main)
  (write-int (checked-add 41 100)) (newline)
  (write-int (checked-add 200 100)) (newline)
  (set! (-> pt x) 5)
  (write-int (-> (first-point 1) x)) (newline)
  (write-int (cast i32 (first-point 0))) (newline)
  (bump) (bump) (bump)
  (write-int counter) (newline)
  (write-int (- (point-address) (cast i32 (& pt)))) (newline))
