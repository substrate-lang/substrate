;; A call through a function's value with another number of arguments
;; than it takes stops with an error naming it, as a direct call does
;; (err-substrate-arity).
(require-unqualified substrate "../../lib/substrate/substrate.sub")
(define (k x) x)
(define (via f . args) (apply f args))
(define (main) (via k 1 2))
