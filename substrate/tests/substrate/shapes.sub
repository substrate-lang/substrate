;; A language's pass goes through any form by its shape.
(require wasm "../../compiler/wasm.sub")
(begin-for-syntax
  (require-unqualified macros "../../compiler/macros.sub")

  (define (bound [s datum] [names datum]) -> datum
    (let ([m (syntax-local-shape s)])
      (if (== m 0)
          names
          (for/fold ([ns names]) ([p (shape-pieces m)])
            (case (piece-role p)
              [('binder 'label) (cons (syntax-e (piece-syntax p)) ns)]
              [('expr) (bound (piece-syntax p) ns)]
              [else ns])))))

  (define (more [s datum]) -> datum
    (let* ([m (syntax-local-shape s)] [ps (if (== m 0) nil (shape-pieces m))])
      (cond [(== m 0) s]
            [(and (== (syntax-e (piece-syntax (car ps))) '#%datum) (integer? (syntax-e (piece-syntax (cadr ps)))))
             (let ([n (piece-syntax (cadr ps))])
               (shape-syntax m `(,(piece-syntax (car ps)) ,(datum->syntax n (make-integer (+ (integer-value (syntax-e n)) 1)) n))))]
            [else (shape-syntax m (for/list ([p ps]) (if (== (piece-role p) 'expr) (more (piece-syntax p)) (piece-syntax p))))])))

  (define (binds [stx datum]) -> datum
    #`(quote #,(datum->syntax stx (reverse (bound (local-expand (cadr (syntax->list stx))) nil)) stx)))
  (define (plus-one [stx datum]) -> datum (more (local-expand (cadr (syntax->list stx))))))
(define-syntax binds binds)
(define-syntax plus-one plus-one)
(require-unqualified macros "../../compiler/macros.sub")

(variant figure [circle [r i32]] [rect [w i32] [h i32]])
(exception oops i32)

(define (area [f figure]) -> i32 (plus-one (match f [(circle r) (* 3 r r)] [(rect w h) (* w h)])))
(define (sum [n i32]) -> i32 (plus-one (let ([t 0]) (for ([i 0]) (< i n) (+= i 1) (+= t i)) t)))
(define (caught) -> i32 (plus-one (try (throw oops 5) [catch oops (v) (+ v 1)])))
(define (twice [x i32]) -> i32 (plus-one (let ([f (lambda ([y i32]) -> i32 (* y 2))]) (f x))))
(define (added) -> i32 (plus-one (wasm:block done (wasm:br done (wasm:i32.add 1 2)))))

(define (main)
  (write-datum (binds (let ([a 1])
                        (for ([i 0]) (< i 2) (+= i 1) (match (circle a) [(circle r) r] [(rect w h) (* w h)]))
                        (let ([f (lambda ([y i32]) -> i32 y)]) (f a))
                        (try (throw oops a) [catch oops (v) v])
                        (wasm:block done (wasm:br done)))))
  (newline)
  (write-int (area (circle 2))) (newline)
  (write-int (area (rect 6 7))) (newline)
  (write-int (sum 10)) (newline)
  (write-int (caught)) (newline)
  (write-int (twice 21)) (newline)
  (write-int (added)) (newline))
