;; printf: text, ~n and ~~, and integers and strings by their types, printed in order.
(define (noisy [x i32]) -> i32 (printf "<~a>" x) x)

(define (main)
  (let ([b u8 200] [c i8 -5] [h u16 60000] [k i16 -300] [u u32 4000000000] [w u64 (cast u64 -1)] [v i64 -9000000000]
        [name (ptr u8) "world"])
    (printf "~a ~a ~a ~a ~a~n" b c h k u)
    (printf "~a ~a ~a ~a~n" w v 7 5000000000)
    (printf "hello ~a, ~~ and ~a~n" name "text")
    (printf "~a ~a~n" (noisy 1) (noisy 2))
    (printf "")
    (printf "done\n")))
