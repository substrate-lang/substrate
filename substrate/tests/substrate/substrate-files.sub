;; Files and the command line in Substrate (spec 4): the program's
;; arguments, writing a file with display-to-file (display writes a byte
;; string's bytes as they are), reading it back as bytes and as a string,
;; and exit.
(require-unqualified substrate "../../lib/languages/substrate/substrate.sub")

(define (run)
  (let* ([args (current-command-line-arguments)]
         [path (if (> (vector-length args) 0) (vector-ref args 0) "../../build/tests/substrate-files.txt")])
    (display (vector-length args)) (newline)
    (display-to-file (list "λ" 'sym 42) path)
    (write (file->string path)) (newline)
    (display-to-file (bytes 104 105 0 255) path)
    (write (file->bytes path)) (newline)
    (display "done") (newline)
    (exit 0)
    (display "not reached") (newline)))

(func (main) (run))
