;; A mistake in the program, such as car of a value that is not a pair,
;; stops it, though a handler would take any value: a handler sees only
;; what raise, error and the host's failures raise (lib/substrate/runtime.sub).
(require-unqualified substrate "../../lib/substrate/substrate.sub")
(define (main)
  (display (with-handlers ([(lambda (v) #t) (lambda (v) 'caught)]) (car 5))))
