;; Substrate's exceptions: thrown, caught by clause and through frames, whose stack a catch frees, and rethrown.

(define (show [x i32]) (printf "~a " x))

(exception negative i32)
(exception overflow i32 i32)

(define (root [x i32]) -> i32
  (when (< x 0) (throw negative x))
  (let ([r 0])
    (while (<= (* (+ r 1) (+ r 1)) x) (+= r 1))
    r))

(define (add-small [a i32] [b i32]) -> i32
  (when (> (+ a b) 100) (throw overflow a b))
  (+ a b))

(define (deep [n i32]) -> i32
  (let ([buf (array i32 64)])
    (set! (@ buf 0) n)
    (if (== n 0) (throw negative -1) (+ (deep (- n 1)) (@ buf 0)))))

(define (main)
  (show (try (root 50) [catch negative (v) (* v 10)]))
  (show (try (root -4) [catch negative (v) (* v 10)]))
  (show (try (add-small 70 50) [catch negative (v) 0] [catch overflow (a b) (- a b)]))
  (show (try (add-small 1 2) [catch-all -1]))
  (let ([s 0])
    (for ([i 0]) (< i 100000) (+= i 1)
      (+= s (try (deep 5) [catch negative (v) v])))
    (show s))
  (show (try (throw overflow 1 2) 5 [catch overflow (a b) (+ a b)]))
  (show (try (try (root -2) [catch-all (show 0) (rethrow)]) [catch negative (v) v]))
  (show (try (try (add-small 90 20) [catch overflow (a b) (rethrow)]) [catch overflow (a b) (+ a b)]))
  (printf "\n"))
