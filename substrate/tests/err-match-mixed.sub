;; The variants of one match belong to one enum (examples/shapes/match.sub).
(require st "../examples/shapes/struct.sub" struct enum)
(require m "../examples/shapes/match.sub" match else _)
(enum shape (circle [r i32]) (square [side i32]) (rect [w i32] [h i32]))
(struct point [x i32] [y i32])

(func (area [s (ref shape)]) -> i32
  (match s [(circle r) r] [(point x y) x] [else 0]))
(func (main))
