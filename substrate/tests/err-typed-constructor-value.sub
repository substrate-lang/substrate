;; A constructor with fields is applied, not passed as a function value
;; (examples/typed/typed.sub).
(require-unqualified typed "../examples/typed/typed.sub")
(data (Option T) [None] [Some T])
(define #:forall (A B) (ap [f : (-> A B)] [x : A]) : B (f x))
(define (f) : (Option Int) (ap Some 1))
(func (main) (drop (f)))
