;; match gives its subject the type of its variants' enum, so the kernel's
;; type checker rejects a value of another type (lib/match.sub).
(require st "../lib/struct.sub" struct enum)
(require m "../lib/match.sub" match)
(enum shape (circle [r i32]) (square [side i32]) (rect [w i32] [h i32]))
(struct point [x i32] [y i32])

(func (area [p (ref point)]) -> i32
  (match p [(circle r) r] [else 0]))
(func (main))
