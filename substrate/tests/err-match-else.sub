;; else is a binding of the match library (lib/match.sub), so a module
;; that uses it requires it.
(require st "../lib/struct.sub" enum)
(require m "../lib/match.sub" match)
(enum shape (circle [r i32]) (square [side i32]))
(func (area [s (ref shape)]) -> i32 (match s [(circle r) r] [else 0]))
(func (main))
