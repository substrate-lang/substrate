;; A module's #%linklet (spec 6.5) rewrites each unit of its code. This
;; one, bound in the module itself, applies to the module's phase-0 code,
;; to which it adds an expression that prints the unit's kind and number of
;; forms. Module-level expressions run before main.
(require print "../lib/print.sub" write-int newline)
(begin-for-syntax
  (require s syntax)
  (func (hook [stx eqref]) -> eqref
    (let* ([parts (s:cdr (s:syntax->list stx))] [forms (s:cdr parts)])
      (s:append forms
                (s:cons #`(begin (write-int #,(s:datum->syntax stx (s:fixnum (s:length forms)) stx)) (newline)
                                 (write-int #,(s:datum->syntax stx (s:fixnum (ref.eq (s:syntax-e (s:car parts)) 'module)) stx))
                                 (newline))
                        '())))))
(define-syntax #%linklet hook)

(func (twice [x i32]) -> i32 (i32.mul x 2))
(func (main) (write-int (twice 21)) (newline))
