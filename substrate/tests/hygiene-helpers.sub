;; A macro can build its output from templates in its helpers: the k the
;; helper's template refers to is the k the macro's template binds (spec
;; 6.2). Both are written with Substrate's define and define-syntax, macros
;; of another module, so neither gets a use-site scope.
(require-unqualified substrate "../lib/substrate.sub")
(begin-for-syntax
  (require-unqualified substrate "../lib/substrate.sub")
  (define (use-k) #'k))
(define-syntax (with-k stx) #`(let ([k 42]) #,(use-k)))
(define (main) (display (with-k)) (newline))
