;; Holes (spec 6.4): code a language leaves for its #%linklet to fill
;; (tests/fixtures/holes.sub), in expressions and in types, a function's
;; signature among them.
(require-unqualified h "fixtures/holes.sub")
(require print "../lib/print.sub" write-int newline)

(func (twice [x (#%hole int)]) -> (#%hole int) (i32.add x x))

(func (main)
  (let ([x (#%hole int) (answer)])
    (write-int x) (newline)
    (write-int (twice x)) (newline)))
