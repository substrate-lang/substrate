;; Macros whose templates use each other. Required at two phases, this
;; module has bindings named `one` at the same phase from both requires:
;; the phase-1 function behind the macro, and the macro itself shifted up.
;; Each shift's copy of the module scope keeps them apart (spec 6.1).
(require "../../lib/macro.sub" (for-syntax syntax))
(provide one two)
(define-macro (one stx) #'1)
(define-macro (two stx) #`(i32.add (one) (one)))
