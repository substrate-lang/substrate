;; Macros whose transformers are Substrate functions at phase 1, on the syntax module's syntax objects.

(begin-for-syntax
  (require-unqualified macros "../compiler/macros.sub")

  (define (twice [env datum] [s datum]) -> datum
    (let ([x (cadr (syntax->list s))])
      (datum->syntax env `(+ ,x ,x) s)))

  (define (count-args [s datum]) -> datum
    (let ([n i32 0] [l (cddr (syntax->list s))])
      (while (pair? l) (+= n 1) (set! l (cdr l)))
      (when (== (syntax-e (cadr (syntax->list s))) 'f) (+= n 100))
      (datum->syntax s (make-integer n) s))))

(define-syntax twice twice #'here)
(define-syntax count-args count-args)

(define (main)
  (printf "~a\n" (twice 21))
  (printf "~a\n" (count-args g 1 2 3))
  (printf "~a\n" (count-args f 1 2)))
