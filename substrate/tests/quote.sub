;; quote and quasiquote build kernel data (spec 5.4). This program
;; uses them at run time, so it links the library, like any other library
;; it uses (see quote.imports).

(require k kernel)
(require print "../lib/print.sub" write-int newline)
(require sub "../lib/substrate.sub" write)

(func (main)
  (write '(1 -2 (3 . 4) "five\n" #\x #\space sym #t #f ())) (newline)
  (let ([xs '(a b)] [n (k:fixnum 7)])
    (write `(list ,@xs ,n (nested ,(k:car xs)) end)) (newline)
    (write `(1 `(2 ,(3 ,n)))) (newline))
  (write-int (ref.eq 'abc (k:string->symbol (k:symbol->string 'abc)))) (newline)
  (write-int (k:length '(1 2 3))) (newline)
  (write (k:append '(1 2) '(3))) (newline)
  (write (k:reverse '(1 2 3))) (newline)
  (write (k:symbol-append 'foo- 'bar)) (newline)
  (write (k:datum->syntax '#f '(x (y)) '#f)) (newline)
  (write (k:syntax->datum (k:datum->syntax '#f '(x (y)) '#f))) (newline)
  (write '"λ unicode ✓") (newline)
  (write-int (k:string-length '"λ")) (newline))
