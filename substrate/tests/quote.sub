;; quote and quasiquote build syntax-library data (spec 5.4). This program
;; uses them at run time, so it requires the library and links it, like any
;; other library it uses (see quote.links).

(require syntax "../lib/print.sub" "../lib/write-datum.sub")

(func (main)
  (write-datum '(1 -2 (3 . 4) "five\n" #\x #\space sym #t #f ())) (newline)
  (let ([xs '(a b)] [n (fixnum 7)])
    (write-datum `(list ,@xs ,n (nested ,(car xs)) end)) (newline)
    (write-datum `(1 `(2 ,(3 ,n)))) (newline))
  (write-int (ref.eq 'abc (intern (symbol->string 'abc)))) (newline)
  (write-int (length '(1 2 3))) (newline)
  (write-datum (append '(1 2) '(3))) (newline)
  (write-datum (reverse '(1 2 3))) (newline)
  (write-datum (symbol-append 'foo- 'bar)) (newline)
  (write-datum (datum->syntax '#f '(x (y)))) (newline)
  (write-datum (syntax->datum (datum->syntax '#f '(x (y))))) (newline)
  (write-datum '"λ unicode ✓") (newline)
  (write-int (string-length '"λ")) (newline))
