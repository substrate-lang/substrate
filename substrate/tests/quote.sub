;; quote and quasiquote build syntax-library data (spec 5.4). This program
;; uses them at run time, so it links the library, like any other library
;; it uses (see quote.imports).

(require s syntax)
(require print "../lib/print.sub" write-int newline)
(require sub "../lib/substrate.sub" write)

(func (main)
  (write '(1 -2 (3 . 4) "five\n" #\x #\space sym #t #f ())) (newline)
  (let ([xs '(a b)] [n (s:fixnum 7)])
    (write `(list ,@xs ,n (nested ,(s:car xs)) end)) (newline)
    (write `(1 `(2 ,(3 ,n)))) (newline))
  (write-int (ref.eq 'abc (s:string->symbol (s:symbol->string 'abc)))) (newline)
  (write-int (s:length '(1 2 3))) (newline)
  (write (s:append '(1 2) '(3))) (newline)
  (write (s:reverse '(1 2 3))) (newline)
  (write (s:symbol-append 'foo- 'bar)) (newline)
  (write (s:datum->syntax '#f '(x (y)) '#f)) (newline)
  (write (s:syntax->datum (s:datum->syntax '#f '(x (y)) '#f))) (newline)
  (write '"λ unicode ✓") (newline)
  (write-int (s:string-length '"λ")) (newline))
