;; The syntax library's types form one recursion group (spec appendix A),
;; so a program's own types never pass its tests: a struct of two eqref
;; fields is not a pair, and a struct of two i32 fields is not a character.
(require print "../lib/print.sub" write-int newline)
(require s syntax)

(type node (struct (field value eqref) (field next eqref)))
(type point (struct (field x i32) (field y i32)))

(func (main)
  (write-int (s:pair? (struct.new node '1 '#f))) (newline)
  (write-int (s:char? (struct.new point 0 97))) (newline)
  (write-int (s:pair? '(1 2))) (newline))
