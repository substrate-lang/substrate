;; Reads wasm modules: the running compiler's, and a program's for the pruner.
(require-unqualified macros "macros.sub")
(require-unqualified fs host/fs)

(provide file-bytes running-module-names running-module-bytes wasm-module-exports wasm-module-imports
         wasm-module-memory-import wasm-module-custom wasm-module-import-fields read-from! position byte uleb skip
         skip-sleb name limits skip-immediate)

(define (file-bytes [path datum]) -> datum
  (let ([b (slice u8)] [d datum '#f])
    (when (== (fs-read-file (datum->string path) (& b) 0) 0)
      (set! d (bytes->datum b))
      (free (-> b items)))
    d))

(define (running-module-names) -> datum
  (let ([l (host-program-modules)] [names nil])
    (for ([i u32 0]) (< i (-> l length)) (+= i 1) (set! names (cons (string->datum (@ l i)) names)))
    (free (-> l items))
    (reverse names)))

(define (running-module-bytes [name datum]) -> datum
  (let ([b (host-module-bytes (datum->string name))] [d datum 0])
    (when (== (-> b length) 0) (return '#f))
    (set! d (bytes->datum b))
    (free (-> b items))
    d))

(define in (slice u8) 0)
(define at u32 0)

(define (read-from! [b (slice u8)] [from u32])
  (set! in b)
  (set! at from))

(define (position) -> u32 at)

(define (byte) -> u32
  (when (>= at (-> in length)) (raise-compile-error 0 "internal: a wasm module ends too soon"))
  (let ([b (@ (-> in items) at)]) (+= at 1) b))

(define (uleb) -> u32
  (let ([n u32 0] [shift u32 0] [b u32 128])
    (while (!= (bit-and b 128) 0)
      (set! b (byte))
      (set! n (bit-or n (<< (bit-and b 127) shift)))
      (+= shift 7))
    n))

(define (skip-sleb)
  (let ([b u32 128])
    (while (!= (bit-and b 128) 0) (set! b (byte)))))

(define (skip [n u32]) (+= at n))

(define (name) -> datum
  (let* ([n (uleb)] [s (string->datum (cast string (slice in at (+ at n))))])
    (skip n)
    s))

(define (valtype) -> datum
  (let ([b (byte)])
    (cond [(== b #x7F) 'i32]
          [(== b #x7E) 'i64]
          [(== b #x7D) 'f32]
          [(== b #x7C) 'f64]
          [else '#f])))

(define (valtypes) -> datum
  (let ([n (uleb)] [out nil])
    (for ([i u32 0]) (< i n) (+= i 1) (set! out (cons (valtype) out)))
    (reverse out)))

(define (limits)
  (let ([flag (byte)])
    (uleb)
    (when (== (bit-and flag 1) 1) (uleb))))

;; skip-immediate passes over an instruction's operand of kind k, as binary.sub's decodings name the kinds.
(define (skip-immediate [k datum])
  (cond [(or (== k 'u) (== k 'global) (== k 'type) (== k 'tag)) (uleb)]
        [(== k 's) (skip-sleb)]
        [(== k 'memarg)
         (when (!= (bit-and (uleb) 64) 0) (uleb))
         (uleb)]
        [(== k 'labels) (for ([i u32 (uleb)]) (> i 0) (-= i 1) (uleb))]
        [(== k 'f32) (skip 4)]
        [(== k 'f64) (skip 8)]
        [(or (== k 'heap) (== k 'valtype)) (byte)]
        [(== k 'blocktype) (when (>= (byte) 128) (skip-sleb))]
        [(== k 'catches)
         (for ([i u32 (uleb)]) (> i 0) (-= i 1)
           (when (< (byte) 2) (uleb))
           (uleb))]
        [else (raise-compile-error 0 "internal: a wasm module has an operand this compiler does not read")]))

(define (comptype [types datum]) -> datum
  (let ([b (byte)])
    (cond [(== b #x60) (let* ([ps (valtypes)] [rs (valtypes)]) (cons `(,ps ,rs) types))]
          [else (raise-compile-error 0 "internal: a running wasm module has a type this compiler does not read") types])))

(define (wasm-module-exports [b (slice u8)]) -> datum
  (let ([types nil] [imported-funcs nil] [funcs nil] [tags nil] [imported-tags nil] [out nil] [id u32 0] [size u32 0] [next u32 0]
        [slots #f])
    (read-from! b 8)
    (while (< at (-> in length))
      (set! id (byte))
      (set! size (uleb))
      (set! next (+ at size))
      (cond
        [(== id 1)
         (let ([count (uleb)])
           (for ([i u32 0]) (< i count) (+= i 1) (set! types (comptype types))))
         (set! types (reverse types))]
        [(== id 2)
         (let ([count (uleb)])
           (for ([i u32 0]) (< i count) (+= i 1)
             (name)
             (name)
             (let ([kind (byte)])
               (cond [(== kind 0) (set! imported-funcs (cons (make-integer (uleb)) imported-funcs))]
                     [(== kind 1) (valtype) (limits)]
                     [(== kind 2) (limits)]
                     [(== kind 3) (valtype) (byte)]
                     [else (byte) (set! imported-tags (cons (make-integer (uleb)) imported-tags))]))))]
        [(== id 3)
         (let ([count (uleb)])
           (for ([i u32 0]) (< i count) (+= i 1) (set! funcs (cons (make-integer (uleb)) funcs))))]
        [(== id 13)
         (let ([count (uleb)])
           (for ([i u32 0]) (< i count) (+= i 1) (byte) (set! tags (cons (make-integer (uleb)) tags))))]
        [(== id 7)
         (let ([count (uleb)] [all-funcs (append (reverse imported-funcs) (reverse funcs))]
               [all-tags (append (reverse imported-tags) (reverse tags))])
           (for ([i u32 0]) (< i count) (+= i 1)
             (let* ([export (name)] [kind (byte)] [index (uleb)])
               (when (and (== kind 3) (== (datum->string export) "%slots")) (set! slots #t))
               (when (or (== kind 0) (== kind 4))
                 (let ([t (list-ref types (cast u32 (integer-value (list-ref (if (== kind 0) all-funcs all-tags) index))))])
                   (when (and (!= t 0) (numeric? (car t)) (numeric? (cadr t)))
                     (set! out (cons (if (== kind 0)
                                         `(func ,export ,(car t) ,(cadr t) ,(make-integer (- (cast i64 index) (cast i64 (length imported-funcs)))))
                                         `(tag ,export ,(car t)))
                                     out))))))))])
      (set! at next))
    (for/list ([e (reverse out)])
      (if (and (== (car e) 'func) (not slots)) `(func ,(cadr e) ,(caddr e) ,(cadddr e) ,(make-integer -1)) e))))

(define (numeric? [types datum]) -> bool
  (while (pair? types)
    (when (== (car types) '#f) (return #f))
    (set! types (cdr types)))
  #t)

(define (wasm-module-custom [b (slice u8)] [wanted string]) -> datum
  (let ([id u32 0] [size u32 0] [next u32 0])
    (read-from! b 8)
    (while (< at (-> in length))
      (set! id (byte))
      (set! size (uleb))
      (set! next (+ at size))
      (when (and (== id 0) (== (datum->string (name)) wanted)) (return (bytes->datum (slice in at next))))
      (set! at next))
    '#f))

(define (wasm-module-memory-import [b (slice u8)]) -> datum (import-modules b #t))
(define (wasm-module-imports [b (slice u8)]) -> datum (import-modules b #f))

;; wasm-module-import-fields gives each import's (module . field).
(define (wasm-module-import-fields [b (slice u8)]) -> datum
  (let ([out nil] [id u32 0] [size u32 0] [next u32 0])
    (read-from! b 8)
    (while (< at (-> in length))
      (set! id (byte))
      (set! size (uleb))
      (set! next (+ at size))
      (when (== id 2)
        (for ([i u32 (uleb)]) (> i 0) (-= i 1)
          (let* ([module (name)] [field (name)] [kind (byte)])
            (cond [(== kind 0) (uleb)]
                  [(== kind 1) (byte) (limits)]
                  [(== kind 2) (limits)]
                  [(== kind 3) (byte) (byte)]
                  [else (byte) (uleb)])
            (set! out (cons (cons module field) out)))))
      (set! at next))
    out))

(define (import-modules [b (slice u8)] [memory bool]) -> datum
  (let ([out nil] [id u32 0] [size u32 0] [next u32 0] [module datum 0] [found datum '#f])
    (read-from! b 8)
    (while (< at (-> in length))
      (set! id (byte))
      (set! size (uleb))
      (set! next (+ at size))
      (when (== id 2)
        (let ([count (uleb)])
          (for ([i u32 0]) (< i count) (+= i 1)
            (set! module (name))
            (name)
            (let ([kind (byte)])
              (cond [(== kind 0) (uleb)]
                    [(== kind 1) (valtype) (limits)]
                    [(== kind 2) (limits) (set! found module)]
                    [(== kind 3) (valtype) (byte)]
                    [else (byte) (uleb)]))
            (unless (member module out) (set! out (cons module out))))))
      (set! at next))
    (if memory found (reverse out))))
