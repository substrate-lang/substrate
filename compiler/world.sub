;; The entry by which the compiler runs a macro in a package's own memory: a macro's error is caught here, in that
;; memory, and its message and syntax kept for the compiler to copy back. Its queries go to the compiler's requests from
;; worlds, which the compiler names compiler.
(require-unqualified syntax "syntax.sub")

(provide world-call world-failed? world-message world-blamed world-transformer?)

(define failed bool #f)
(define message datum 0)
(define blamed datum 0)

(define (world-call [t datum] [s datum]) -> datum
  (set! failed #f)
  (try (call-transformer t s)
       [catch compile-error (m b l)
        (set! failed #t)
        (set! message m)
        (set! blamed b)
        0]))

(define (world-failed?) -> bool failed)

(define (world-message) -> datum message)

(define (world-blamed) -> datum blamed)

(define (world-transformer? [d datum]) -> bool (transformer? d))

;; ---- queries ----

(import ask-local-value "compiler" "world-local-value" (i32 -> i32))
(import ask-free-identifier "compiler" "world-free-identifier=?" (i32 i32 -> i32))
(import ask-binding-kind "compiler" "world-binding-kind" (i32 -> i32))
(import ask-local-expand "compiler" "world-local-expand" (i32 -> i32))
(import ask-lift "compiler" "world-lift" (i32 -> i32))
(import ask-signature "compiler" "world-function-signature" (i32 -> i32))
(import ask-introduce "compiler" "world-introduce" (i32 -> i32))
(import ask-local-facts "compiler" "world-local-facts" (i32 -> i32))
(import ask-identifier-name "compiler" "world-identifier-name" (i32 -> i32))
(import ask-name-identifier "compiler" "world-name-identifier" (i32 -> i32))
(import ask-shape "compiler" "world-shape" (i32 -> i32))

(define (local-value-of [id datum]) -> datum (cast datum (ask-local-value (cast i32 id))))
(define (free-identifiers [a datum] [b datum]) -> datum (cast datum (ask-free-identifier (cast i32 a) (cast i32 b))))
(define (binding-kind-of [id datum]) -> datum (cast datum (ask-binding-kind (cast i32 id))))
(define (local-expansion [s datum]) -> datum (cast datum (ask-local-expand (cast i32 s))))
(define (lifted [form datum]) -> datum (cast datum (ask-lift (cast i32 form))))
(define (signature-of [id datum]) -> datum (cast datum (ask-signature (cast i32 id))))
(define (introduced [s datum]) -> datum (cast datum (ask-introduce (cast i32 s))))
(define (local-facts-of [id datum]) -> datum (cast datum (ask-local-facts (cast i32 id))))
(define (name-of [id datum]) -> datum (cast datum (ask-identifier-name (cast i32 id))))
(define (identifier-of [name datum]) -> datum (cast datum (ask-name-identifier (cast i32 name))))
(define (shape-of [s datum]) -> datum (cast datum (ask-shape (cast i32 s))))

(define installed i32
  (begin (set-queries! local-value-of free-identifiers binding-kind-of local-expansion lifted signature-of introduced
                       local-facts-of name-of identifier-of shape-of)
         1))
