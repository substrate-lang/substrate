;; The entry by which the compiler runs a macro in a root's own memory: a macro's error is caught here, in that
;; memory, and its message, syntax and place kept for the compiler to copy back. Its queries go to the compiler's requests
;; from worlds, which the compiler names compiler; an error the compiler raises for one is raised here as a copy, which
;; the macro may catch.
(require-unqualified syntax "syntax.sub")

(provide world-call world-failed? world-message world-blamed world-loc world-transformer? world-stand-in)

(define failed bool #f)
(define message datum 0)
(define blamed datum 0)
(define loc (ptr srcloc) 0)

(define (world-call [t datum] [s datum]) -> datum
  (try (let ([out (call-transformer t s)])
         (set! failed #f)
         out)
       [catch compile-error (m b l)
        (set! failed #t)
        (set! message m)
        (set! blamed b)
        (set! loc l)
        0]))

(define (world-failed?) -> bool failed)

(define (world-message) -> datum message)

(define (world-blamed) -> datum blamed)

(define (world-loc) -> (ptr srcloc) loc)

(define (world-transformer? [d datum]) -> bool (transformer? d))

;; ---- queries ----

(import ask-local-value "compiler" "world-local-value" (i32 -> i32))
(import ask-free-identifier "compiler" "world-free-identifier=?" (i32 i32 -> i32))
(import ask-binding-kind "compiler" "world-binding-kind" (i32 -> i32))
(import ask-local-expand "compiler" "world-local-expand" (i32 -> i32))
(import ask-lift "compiler" "world-lift" (i32 -> i32))
(import ask-signature "compiler" "world-function-signature" (i32 -> i32))
(import ask-introduce "compiler" "world-introduce" (i32 -> i32))
(import ask-local-facts "compiler" "world-local-facts" (i32 -> i32))
(import ask-identifier-name "compiler" "world-identifier-name" (i32 -> i32))
(import ask-name-identifier "compiler" "world-name-identifier" (i32 -> i32))
(import ask-shape "compiler" "world-shape" (i32 -> i32))
(import ask-stand-in "compiler" "world-stand-in-call" (i32 i32 -> i32))
(import refused "compiler" "world-refused" (-> i32))
(import refused-message "compiler" "world-refused-message" (-> i32))
(import refused-blamed "compiler" "world-refused-blamed" (-> i32))
(import refused-loc "compiler" "world-refused-loc" (-> i32))

;; answer gives the compiler's answer v, or raises the error the compiler raised for the request.
(define (answer [v i32]) -> datum
  (unless (== (refused) 0)
    (throw compile-error (cast datum (refused-message)) (cast datum (refused-blamed)) (cast (ptr srcloc) (refused-loc))))
  (cast datum v))

(define (local-value-of [id datum]) -> datum (answer (ask-local-value (cast i32 id))))
(define (free-identifiers [a datum] [b datum]) -> datum (answer (ask-free-identifier (cast i32 a) (cast i32 b))))
(define (binding-kind-of [id datum]) -> datum (answer (ask-binding-kind (cast i32 id))))
(define (local-expansion [s datum]) -> datum (answer (ask-local-expand (cast i32 s))))
(define (lifted [form datum]) -> datum (answer (ask-lift (cast i32 form))))
(define (signature-of [id datum]) -> datum (answer (ask-signature (cast i32 id))))
(define (introduced [s datum]) -> datum (answer (ask-introduce (cast i32 s))))
(define (local-facts-of [id datum]) -> datum (answer (ask-local-facts (cast i32 id))))
(define (name-of [id datum]) -> datum (answer (ask-identifier-name (cast i32 id))))
(define (identifier-of [name datum]) -> datum (answer (ask-name-identifier (cast i32 name))))
(define (shape-of [s datum]) -> datum (answer (ask-shape (cast i32 s))))

;; A macro this memory was given and does not keep: a transformer whose code asks the compiler to run the macro its
;; serial names.
(define (stood-in [serial datum] [s datum]) -> datum (answer (ask-stand-in (fixnum-value serial) (cast i32 s))))

(define (world-stand-in [serial i32]) -> datum (make-transformer (cast u32 stood-in) (fixnum serial)))

(define installed i32
  (begin (set-queries! local-value-of free-identifiers binding-kind-of local-expansion lifted signature-of introduced
                       local-facts-of name-of identifier-of shape-of)
         1))
