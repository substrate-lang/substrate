;; The entry by which the compiler runs a macro in a package's own memory: a macro's error is caught here, in that
;; memory, and its message and syntax kept for the compiler to copy back.
(require-unqualified syntax "syntax.sub")

(provide world-call world-failed? world-message world-blamed world-transformer?)

(define failed bool #f)
(define message datum 0)
(define blamed datum 0)

(define (world-call [t datum] [s datum]) -> datum
  (set! failed #f)
  (try (call-transformer t s)
       [catch compile-error (m b l)
        (set! failed #t)
        (set! message m)
        (set! blamed b)
        0]))

(define (world-failed?) -> bool failed)

(define (world-message) -> datum message)

(define (world-blamed) -> datum blamed)

(define (world-transformer? [d datum]) -> bool (transformer? d))
