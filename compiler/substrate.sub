;; Substrate in one module: the language, its runtime and its library.

(provide define struct union variant match exception throw try lambda inst typedef const let let* set!
         if return values import supply
         #%datum #%top-interaction #%module-begin
         when unless cond case while for break continue rethrow and or not cast sizeof offsetof array-of slice @ & ->
         + - * / % == != < <= > >= bit-and bit-or bit-xor bit-not << >>
         += -= *= /= %= <<= >>= bit-and= bit-or= bit-xor=
         heap-start sbrk reset-stack!
         host-write host-trap host-args host-exit host-instantiate host-export-index
         host-program-modules host-module-bytes handler event-head untagged-handler! trap-handler! printf
         buffer-add-entries! entry-strings
         sqrt fabs floor ceil trunc nearbyint copysign sqrtf fabsf floorf ceilf truncf nearbyintf copysignf
         malloc calloc realloc free try-malloc try-calloc try-realloc memcpy memset memcmp
         arena make-arena arena-alloc arena-start! arena-free new
         buffer make-buffer buffer-add! buffer-add-byte! buffer-add-string! buffer-add-utf-8! buffer-add-u32! buffer-add-f32!
         buffer-bytes buffer-string
         buffer-reserve buffer-free! buffer-trim! hash-bytes hash-table hash-ref hash-set! hash-clear! hash-free!
         string-copy
         f64-bits bits-f64 f32-bits digit-value digits? digits-integer read-decimal decimal-flonum shortest-digits
         write-digits write-flonum write-string)

;; ---- the forms ----

(define-syntax forms (quote-syntax (#%form forms)))
(forms #%module-begin #%top-interaction define struct union variant match exception
       throw try lambda inst substrate-struct-check typedef const let let* #%datum when unless cond case array-of slice
       while for cast sizeof offsetof -> & set! @ break continue rethrow new printf
       + - * / % == != < <= > >= and or not bit-and bit-or bit-xor bit-not << >>
       += -= *= /= %= <<= >>= bit-and= bit-or= bit-xor=)

;; ---- memory and the stack ----

(memory 1)

;; Table index 0 holds no function: it is the null function pointer.
(table 1)

(global heap-start i32 1024)

(global brk (mut i32) heap-start)

(func (sbrk [n i32]) -> i32
  (let* ([p brk] [end (i32.and (i32.add (i32.add brk n) 7) -8)] [size (i32.shl (memory.size) 16)]
         [need (i32.shr_u (i32.add (i32.sub end size) 65535) 16)])
    (if (i32.gt_u end size)
        (if (i32.lt_s (memory.grow (if (i32.gt_u (memory.size) need) (memory.size) need)) 0)
            (if (i32.lt_s (memory.grow need) 0) (return 0))))
    (set! brk end)
    p))

(global stack-base (mut i32) (sbrk 4194304))
(global sp (mut i32) (i32.add stack-base 4194304))

(func (reset-stack!) (set! sp (i32.add stack-base 4194304)))

;; ---- the host ----
;; Every program may call these host functions without a grant. A call that gives a string or bytes gives them in a
;; block from malloc for the caller to free; its pointer is 0 when there are none. A call that can fail stores the
;; reason at err as such a string, unless err is 0. Lists are slices of strings.

(import write "host" "write" (i32 i32 i32 -> i32))
(import trap "host" "trap" (i32 i32 ->))
(import arg "host" "arg" (i32 i32 -> i32))
(import exit "host" "exit" (i32 ->))
(import instantiate "host" "instantiate" (i32 i32 i32 i32 i32 i32 i32 i32 -> i32))
(import export_index "host" "export_index" (i32 i32 i32 i32 -> i32))
(import program_modules "host" "program_modules" (i32 -> i32))
(import module_bytes "host" "module_bytes" (i32 i32 i32 -> i32))

(define (host-write [fd i32] [b (slice u8)]) #:inline -> i32 (write fd (cast i32 (-> b items)) (cast i32 (-> b length))))
(define (host-trap [s string]) #:inline (trap (cast i32 (-> s bytes)) (cast i32 (-> s length))))
;; The program's arguments, as strings in one block from malloc, which (free (-> l items)) frees.
(define (host-args) -> (slice string)
  (let ([count u32 0] [total u32 0])
    (while #t
      (let* ([n u32 0] [p (arg (cast i32 count) (cast i32 (& n)))])
        (when (== p 0) (break))
        (free (cast (ptr u8) p))
        (+= count 1)
        (+= total n)))
    (let* ([items (cast (ptr string) (malloc (+ (* count 8) total)))] [bytes (cast (ptr u8) (+ items count))]
           [at u32 0])
      (for ([i u32 0]) (< i count) (+= i 1)
        (let* ([n u32 0] [p (cast (ptr u8) (arg (cast i32 i) (cast i32 (& n))))])
          (memcpy (+ bytes at) p n)
          (free p)
          (set! (@ items i) (cast string (slice (+ bytes at) n)))
          (+= at n)))
      (slice items count))))
(define (host-exit [code i32]) #:inline (exit code))
(define (host-instantiate [name string] [code (slice u8)] [imports (slice string)] [compile-time bool] [err (ptr string)])
  -> i32
  (let ([b (make-buffer)] [r 0])
    (buffer-add-entries! (& b) imports)
    (set! r (instantiate (cast i32 (-> name bytes)) (cast i32 (-> name length)) (cast i32 (-> code items))
                         (cast i32 (-> code length)) (cast i32 (-> b bytes)) (cast i32 (-> b length)) compile-time
                         (cast i32 err)))
    (buffer-free! (& b))
    r))
(define (host-export-index [instance string] [field string]) #:inline -> i32
  (export_index (cast i32 (-> instance bytes)) (cast i32 (-> instance length)) (cast i32 (-> field bytes))
                (cast i32 (-> field length))))
(define (host-program-modules) -> (slice string)
  (let* ([n u32 0] [p (program_modules (cast i32 (& n)))]) (entry-strings (cast (ptr u8) p) n)))
(define (host-module-bytes [name string]) -> (slice u8)
  (let* ([n u32 0] [p (module_bytes (cast i32 (-> name bytes)) (cast i32 (-> name length)) (cast i32 (& n)))])
    (slice (cast (ptr u8) p) n)))

;; ---- output ----

;; printf prints its pieces with these.

(define (print-bytes [p (ptr u8)] [n u32]) (drop (host-write 1 (slice p n))))

(define (print-byte [b i32])
  (let ([t (array u8 1)])
    (set! (@ t 0) b)
    (print-bytes t 1)))

(define (print-integer [n u64] [signed bool])
  (let ([t (array u8 24)] [k u32 0])
    (when (and signed (< (cast i64 n) 0))
      (set! (@ t 0) 45)
      (set! n (- 0 n))
      (set! k 1))
    (print-bytes t (+ k (digits-text n 10 (+ t k))))))

(define (print-float [x f64] [single bool])
  (let ([t (array u8 32)]) (print-bytes t (float-text x single t))))

(define (print-bool [b bool]) (print-bytes (if b "#t" "#f") 2))

(define (print-text [s string] [quoted bool])
  (if quoted
      (let ([b (make-buffer)])
        (write-string (& b) s)
        (print-bytes (-> b bytes) (-> b length))
        (buffer-free! (& b)))
      (print-bytes (-> s bytes) (-> s length))))

;; ---- strings and slices ----

(define (string-copy [s string]) -> string
  (let ([p (cast (ptr u8) (malloc (-> s length)))])
    (memcpy p (-> s bytes) (-> s length))
    (cast string (slice p (-> s length)))))

;; The checker's code calls these to compare strings by their bytes, and to trap on an index or a part out of range.

(define (string-same? [a string] [b string]) -> bool
  (and (== (-> a length) (-> b length)) (== (memcmp (-> a bytes) (-> b bytes) (-> a length)) 0)))

(define (string-order [a string] [b string]) -> i32
  (let* ([n (-> a length)] [m (-> b length)] [c (memcmp (-> a bytes) (-> b bytes) (if (< n m) n m))])
    (cond [(!= c 0) c] [(< n m) -1] [(> n m) 1] [else 0])))

(define (index-trap [i u32] [n u32])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "index ")
    (write-digits (& b) i 10)
    (buffer-add-string! (& b) " is out of range for length ")
    (write-digits (& b) n 10)
    (host-trap (buffer-string (& b)))))

(define (range-trap [from u32] [to u32] [n u32])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "from ")
    (write-digits (& b) from 10)
    (buffer-add-string! (& b) " to ")
    (write-digits (& b) to 10)
    (buffer-add-string! (& b) " is out of range for length ")
    (write-digits (& b) n 10)
    (host-trap (buffer-string (& b)))))

;; ---- math ----

;; C's math functions that a wasm instruction computes exactly as C does.

(func (sqrt [x f64]) #:inline -> f64 (f64.sqrt x))
(func (fabs [x f64]) #:inline -> f64 (f64.abs x))
(func (floor [x f64]) #:inline -> f64 (f64.floor x))
(func (ceil [x f64]) #:inline -> f64 (f64.ceil x))
(func (trunc [x f64]) #:inline -> f64 (f64.trunc x))
(func (nearbyint [x f64]) #:inline -> f64 (f64.nearest x))
(func (copysign [x f64] [y f64]) #:inline -> f64 (f64.copysign x y))

(func (sqrtf [x f32]) #:inline -> f32 (f32.sqrt x))
(func (fabsf [x f32]) #:inline -> f32 (f32.abs x))
(func (floorf [x f32]) #:inline -> f32 (f32.floor x))
(func (ceilf [x f32]) #:inline -> f32 (f32.ceil x))
(func (truncf [x f32]) #:inline -> f32 (f32.trunc x))
(func (nearbyintf [x f32]) #:inline -> f32 (f32.nearest x))
(func (copysignf [x f32] [y f32]) #:inline -> f32 (f32.copysign x y))

;; ---- the allocator, memory functions, arenas, buffers, hash tables ----

;; A block is a word of its size, a multiple of 16, with 1 set while it is used, 2 while the block before it is, and 4
;; while it is in a quick list, then what malloc gives, at a multiple of 16. A free block also holds the next and
;; previous blocks in its list, and its size again in its last word; no two free blocks are neighbours. Each region from
;; sbrk ends in a used block of size 0, the last region's at heap-end.
(struct heap-block [head u32] [next (ptr heap-block)] [prev (ptr heap-block)])

;; The free lists: one for each size under 1 KB, then four from each power of two to the next. free-map has the bit of
;; each list that holds a block.
(define free-lists (array (ptr heap-block) 152))
(define free-map (array u32 5))
(define heap-end (ptr heap-block) 0)
(define heap-limit u32 0)

;; The quick lists: a freed block of up to 4 KB waits in the list of its size, still used, for malloc to give it again;
;; before the heap grows, they are all freed.
(define quick-lists (array (ptr heap-block) 257))

(func (leading-zeros-32 [x i32]) #:inline -> i32 (i32.clz x))
(func (trailing-zeros-32 [x i32]) #:inline -> i32 (i32.ctz x))

(define (block-size-for [n u32]) #:inline -> u32 (bit-and (+ n 19) -16))
(define (block-size [b (ptr heap-block)]) #:inline -> u32 (bit-and (-> b head) -16))
(define (block-after [b (ptr heap-block)] [n u32]) #:inline -> (ptr heap-block)
  (cast (ptr heap-block) (+ (cast (ptr u8) b) n)))
(define (block-before [b (ptr heap-block)]) #:inline -> (ptr heap-block)
  (cast (ptr heap-block) (- (cast (ptr u8) b) (@ (cast (ptr u32) (- (cast (ptr u8) b) 4)) 0))))
(define (set-footer! [b (ptr heap-block)] [size u32]) #:inline
  (set! (@ (cast (ptr u32) (+ (cast (ptr u8) b) (- size 4))) 0) size))

(define (size-class [size u32]) #:inline -> u32
  (if (< size 1024)
      (>> size 4)
      (let ([top (- 31 (cast u32 (leading-zeros-32 (cast i32 size))))])
        (+ 64 (* (- top 10) 4) (bit-and (>> size (- top 2)) 3)))))

(define (list-block! [b (ptr heap-block)] [size u32])
  (let* ([c (size-class size)] [first (@ free-lists c)])
    (set! (-> b next) first)
    (set! (-> b prev) 0)
    (when (!= first 0) (set! (-> first prev) b))
    (set! (@ free-lists c) b)
    (bit-or= (@ free-map (>> c 5)) (<< (cast u32 1) (bit-and c 31)))))

(define (unlist-block! [b (ptr heap-block)])
  (let ([next (-> b next)] [prev (-> b prev)])
    (when (!= next 0) (set! (-> next prev) prev))
    (if (!= prev 0)
        (set! (-> prev next) next)
        (let ([c (size-class (block-size b))])
          (set! (@ free-lists c) next)
          (when (== next 0) (bit-and= (@ free-map (>> c 5)) (bit-not (<< (cast u32 1) (bit-and c 31)))))))))

;; next-class gives the first list from c that holds a block, or 160.
(define (next-class [c u32]) -> u32
  (let ([w (>> c 5)] [bits u32 0])
    (when (>= w 5) (return 160))
    (set! bits (bit-and (@ free-map w) (<< (cast u32 4294967295) (bit-and c 31))))
    (while (== bits 0)
      (+= w 1)
      (when (>= w 5) (return 160))
      (set! bits (@ free-map w)))
    (+ (<< w 5) (cast u32 (trailing-zeros-32 (cast i32 bits))))))

;; allocate is the body of malloc and try-malloc: a block of n bytes, or 0.
(define (allocate [n u32]) #:inline -> (ptr void)
  (when (>= n 2147483584) (return 0))
  (let* ([size (block-size-for n)] [b (ptr heap-block) 0])
    (when (<= size 4096)
      (set! b (@ quick-lists (>> size 4)))
      (when (!= b 0)
        (set! (@ quick-lists (>> size 4)) (-> b next))
        (bit-and= (-> b head) -5)
        (return (cast (ptr void) (+ (cast (ptr u8) b) 4)))))
    (set! b (fitting-block size))
    (when (and (== b 0) (free-quick-blocks!)) (set! b (fitting-block size)))
    (when (== b 0) (set! b (grow-heap size)))
    (when (== b 0) (return 0))
    (unlist-block! b)
    (take-block! b size)))

(define (allocated [p (ptr void)]) #:inline -> (ptr void)
  (when (== p 0) (host-trap "out of memory"))
  p)

;; malloc, calloc and realloc trap when memory runs out, where try-malloc, try-calloc and try-realloc give 0.
(define (malloc [n u32]) -> (ptr void) (allocated (allocate n)))
(define (try-malloc [n u32]) -> (ptr void) (allocate n))
(define (calloc [count u32] [size u32]) -> (ptr void) (allocated (try-calloc count size)))
(define (realloc [block (ptr void)] [n u32]) -> (ptr void) (allocated (try-realloc block n)))

;; fitting-block gives a block from the free lists of at least size bytes, or 0.
(define (fitting-block [size u32]) -> (ptr heap-block)
  (let* ([c (size-class size)] [b (@ free-lists c)] [k 0] [d u32 0])
    (when (>= c 64)
      (while (and (!= b 0) (< (block-size b) size) (< k 16))
        (set! b (-> b next))
        (+= k 1))
      (when (and (!= b 0) (< (block-size b) size)) (set! b 0)))
    (when (!= b 0) (return b))
    (set! d (next-class (+ c 1)))
    (if (< d 152) (@ free-lists d) 0)))

;; free-quick-blocks! frees the blocks in the quick lists, giving whether there were any.
(define (free-quick-blocks!) -> bool
  (let ([any #f] [b (ptr heap-block) 0])
    (for ([i u32 1]) (<= i 256) (+= i 1)
      (while (!= (@ quick-lists i) 0)
        (set! b (@ quick-lists i))
        (set! (@ quick-lists i) (-> b next))
        (bit-and= (-> b head) -5)
        (release-block! b)
        (set! any #t)))
    any))

;; take-block! uses size bytes of the free block b, out of its list, and frees the rest.
(define (take-block! [b (ptr heap-block)] [size u32]) -> (ptr void)
  (let ([rest (- (block-size b) size)])
    (if (>= rest 16)
        (let ([r (block-after b size)])
          (set! (-> r head) (bit-or rest 2))
          (set-footer! r rest)
          (list-block! r rest)
          (set! (-> b head) (bit-or size 3)))
        (begin
          (bit-or= (-> (block-after b (block-size b)) head) 2)
          (bit-or= (-> b head) 1)))
    (cast (ptr void) (+ (cast (ptr u8) b) 4))))

;; grow-heap adds a free block of at least size bytes from sbrk, which joins the last region when sbrk gives the memory
;; after it.
(define (grow-heap [size u32]) -> (ptr heap-block)
  (let* ([n (bit-and (+ (if (< size 8192) 8192 size) 47) -16)] [r (cast u32 (sbrk (cast i32 n)))] [b (ptr heap-block) 0]
         [s u32 0])
    (when (== r 0) (return 0))
    (if (and (!= heap-end 0) (== r heap-limit))
        (set! b heap-end)
        (begin
          (set! b (cast (ptr heap-block) (- (bit-and (+ r 19) -16) 4)))
          (set! (-> b head) 2)))
    (set! s (bit-and (- (+ r n) (+ (cast u32 b) 4)) -16))
    (set! (-> b head) (bit-or s (bit-and (-> b head) 2)))
    (set! heap-end (block-after b s))
    (set! (-> heap-end head) 1)
    (set! heap-limit (+ r n))
    (when (== (bit-and (-> b head) 2) 0)
      (set! b (block-before b))
      (unlist-block! b)
      (set! s (+ s (block-size b)))
      (set! (-> b head) (bit-or s 2)))
    (set-footer! b s)
    (list-block! b s)
    b))

(define (free [block (ptr void)])
  (when (!= block 0)
    (let* ([b (cast (ptr heap-block) (- (cast (ptr u8) block) 4))] [size (block-size b)])
      (when (!= (bit-and (-> b head) 5) 1) (host-trap "free of a block that is free"))
      (if (<= size 4096)
          (begin
            (bit-or= (-> b head) 4)
            (set! (-> b next) (@ quick-lists (>> size 4)))
            (set! (@ quick-lists (>> size 4)) b))
          (release-block! b)))))

;; release-block! puts the used block b in the free lists, joined with its free neighbours.
(define (release-block! [b (ptr heap-block)])
  (let* ([size (block-size b)] [next (block-after b size)])
    (when (== (bit-and (-> next head) 1) 0)
      (unlist-block! next)
      (+= size (block-size next)))
    (when (== (bit-and (-> b head) 2) 0)
      (set! b (block-before b))
      (unlist-block! b)
      (+= size (block-size b)))
    (set! (-> b head) (bit-or size 2))
    (set-footer! b size)
    (bit-and= (-> (block-after b size) head) -3)
    (list-block! b size)))

(define (try-calloc [count u32] [size u32]) -> (ptr void)
  (when (and (!= size 0) (> count (/ 4294967295 size))) (return 0))
  (let ([p (try-malloc (* count size))])
    (when (!= p 0) (memset p 0 (* count size)))
    p))

;; try-realloc keeps the block where it is when it shrinks, and when it grows into a free block after it or into new
;; memory at the end of the last region.
(define (try-realloc [block (ptr void)] [n u32]) -> (ptr void)
  (when (== block 0) (return (try-malloc n)))
  (when (>= n 2147483584) (return 0))
  (let* ([b (cast (ptr heap-block) (- (cast (ptr u8) block) 4))] [size (block-size b)] [want (block-size-for n)]
         [next (block-after b size)] [room (if (== (bit-and (-> next head) 1) 0) (+ size (block-size next)) size)]
         [p (ptr void) 0])
    (when (!= (bit-and (-> b head) 5) 1) (host-trap "realloc of a block that is free"))
    (when (and (> want room) (== (block-after b room) heap-end) (== (cast u32 (sbrk 0)) heap-limit))
      (grow-heap (- want room)))
    (when (and (> want size) (== (bit-and (-> next head) 1) 0) (>= (+ size (block-size next)) want))
      (unlist-block! next)
      (+= size (block-size next))
      (set! (-> b head) (bit-or size (bit-and (-> b head) 3)))
      (bit-or= (-> (block-after b size) head) 2))
    (when (<= want size)
      (when (>= (- size want) 16)
        (let ([rest (block-after b want)])
          (set! (-> b head) (bit-or want (bit-and (-> b head) 3)))
          (set! (-> rest head) (bit-or (- size want) 3))
          (release-block! rest)))
      (return block))
    (set! p (try-malloc n))
    (when (!= p 0)
      (memcpy p block (- size 4))
      (free block))
    p))

(define (memcpy [to (ptr void)] [from (ptr void)] [n u32]) -> (ptr void)
  (memory.copy to from n)
  to)

(define (memset [to (ptr void)] [byte i32] [n u32]) -> (ptr void)
  (memory.fill to byte n)
  to)

(define (memcmp [a (ptr void)] [b (ptr void)] [n u32]) -> i32
  (let ([x (cast (ptr u8) a)] [y (cast (ptr u8) b)])
    (for ([i u32 0]) (< i n) (+= i 1)
      (when (!= (@ x i) (@ y i)) (return (- (@ x i) (@ y i)))))
    0))

(struct chunk [previous (ptr chunk)] [size u32])

;; Chunks start at 1 KB, or the size arena-start! gives, and double up to 64 KB; an allocation over 8 KB has a chunk
;; of its own. After PostgreSQL's memory contexts.
(struct arena [last (ptr chunk)] [next (ptr u8)] [end (ptr u8)])

(define (make-arena) -> arena
  (let ([a arena])
    (set! (-> a last) 0)
    (set! (-> a next) 0)
    (set! (-> a end) 0)
    a))

(define (arena-alloc [a (ptr arena)] [n u32]) -> (ptr void)
  (let ([size (bit-and (+ n 7) -8)])
    (if (> size (- (-> a end) (-> a next)))
        (arena-grow a size)
        (let ([p (-> a next)])
          (+= (-> a next) size)
          p))))

;; arena-start! gives the arena a chunk of size bytes to allocate from next: before any allocation, its first.
(define (arena-start! [a (ptr arena)] [size u32])
  (let* ([c (cast (ptr chunk) (malloc (+ size (sizeof chunk))))] [p (cast (ptr u8) (+ c 1))])
    (set! (-> c previous) (-> a last))
    (set! (-> c size) size)
    (set! (-> a last) c)
    (set! (-> a next) p)
    (set! (-> a end) (+ p size))))

;; arena-grow gives n bytes from a new chunk: one of their own, kept behind the current chunk, or the next chunk.
(define (arena-grow [a (ptr arena)] [n u32]) -> (ptr void)
  (let ([last (-> a last)])
    (if (> n 8192)
        (let ([c (cast (ptr chunk) (malloc (+ n (sizeof chunk))))])
          (set! (-> c size) n)
          (if (== last 0)
              (begin
                (set! (-> c previous) 0)
                (set! (-> a last) c))
              (begin
                (set! (-> c previous) (-> last previous))
                (set! (-> last previous) c)))
          (cast (ptr void) (+ c 1)))
        (let* ([want (cond [(== last 0) 1024] [(< (-> last size) 32768) (* (-> last size) 2)] [else 65536])]
               [p (begin (arena-start! a (if (> n want) n want)) (-> a next))])
          (+= (-> a next) n)
          (cast (ptr void) p)))))

(define (arena-free [a (ptr arena)])
  (let ([c (-> a last)])
    (while (!= c 0)
      (let ([previous (-> c previous)])
        (free c)
        (set! c previous))))
  (set! (-> a last) 0)
  (set! (-> a next) 0)
  (set! (-> a end) 0))

(struct buffer [bytes (ptr u8)] [length u32] [room u32])

(define (make-buffer) -> buffer
  (let ([b buffer])
    (set! (-> b bytes) 0)
    (set! (-> b length) 0)
    (set! (-> b room) 0)
    b))

(define (buffer-reserve [b (ptr buffer)] [n u32])
  (let ([need (+ (-> b length) n)])
    (when (> need (-> b room))
      (set! (-> b room) (if (> need (* 2 (-> b room))) need (* 2 (-> b room))))
      (set! (-> b bytes) (cast (ptr u8) (realloc (-> b bytes) (-> b room)))))))

