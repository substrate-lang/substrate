;; Substrate in one module: the language, its runtime and its library.

(provide define struct union variant match exception throw try lambda inst typedef const let let* set!
         if return values import
         #%datum #%top-interaction #%module-begin
         when unless cond case while for break continue rethrow and or not cast sizeof offsetof array-of @ & ->
         + - * / % == != < <= > >= bit-and bit-or bit-xor bit-not << >>
         += -= *= /= %= <<= >>= bit-and= bit-or= bit-xor=
         heap-start sbrk reset-stack!
         host-write host-trap host-arg host-arg-text host-exit host-error-text host-instantiate host-export-index
         host-program-modules host-module-bytes printf
         sqrt fabs floor ceil trunc nearbyint copysign sqrtf fabsf floorf ceilf truncf nearbyintf copysignf
         malloc calloc realloc free memcpy memset memcmp strlen strcmp arena make-arena arena-alloc arena-free new
         buffer make-buffer buffer-add! buffer-add-byte! buffer-add-string! buffer-free!
         hash-table hash-ref hash-set! hash-clear! hash-free!
         f64-bits bits-f64 f32-bits digit-value digits? digits-integer read-decimal write-digits write-flonum write-string)

;; ---- the forms ----

(define-syntax forms (quote-syntax (#%form forms)))
(forms #%module-begin #%top-interaction define struct union variant match exception
       throw try lambda inst substrate-struct-check typedef const let let* #%datum when unless cond case array-of
       while for cast sizeof offsetof -> & set! @ break continue rethrow new printf
       + - * / % == != < <= > >= and or not bit-and bit-or bit-xor bit-not << >>
       += -= *= /= %= <<= >>= bit-and= bit-or= bit-xor=)

;; ---- memory and the stack ----

(memory 1)

;; Table index 0 holds no function: it is the null function pointer.
(table 1)

(global heap-start i32 1024)

(global brk (mut i32) heap-start)

(func (sbrk [n i32]) -> i32
  (let* ([p brk] [end (i32.and (i32.add (i32.add brk n) 7) -8)] [size (i32.shl (memory.size) 16)]
         [need (i32.shr_u (i32.add (i32.sub end size) 65535) 16)])
    (if (i32.gt_u end size)
        (if (i32.lt_s (memory.grow (if (i32.gt_u (memory.size) need) (memory.size) need)) 0)
            (if (i32.lt_s (memory.grow need) 0) (return 0))))
    (set! brk end)
    p))

(global stack-base (mut i32) (sbrk 4194304))
(global sp (mut i32) (i32.add stack-base 4194304))

(func (reset-stack!) (set! sp (i32.add stack-base 4194304)))

;; ---- the host ----
;; All programs have these host functions, with no grant: writing, trapping, the arguments and exit, the text of
;; the last error, and loading modules. A call that gives bytes returns them in a block from malloc, ended by a zero,
;; with their length at n unless n is 0; it returns 0 when there are none.

(import write "host" "write" (i32 i32 i32 -> i32))
(import trap "host" "trap" (i32 i32 ->))
(import arg "host" "arg" (i32 i32 -> i32))
(import exit "host" "exit" (i32 ->))
(import error_message "host" "error_message" (i32 -> i32))
(import instantiate "host" "instantiate" (i32 i32 i32 i32 i32 i32 i32 -> i32))
(import export_index "host" "export_index" (i32 i32 i32 i32 -> i32))
(import program_modules "host" "program_modules" (i32 -> i32))
(import module_bytes "host" "module_bytes" (i32 i32 i32 -> i32))

(define (host-write [fd i32] [p (ptr u8)] [n i32]) #:inline -> i32 (write fd (cast i32 p) n))
(define (host-trap [p (ptr u8)] [n i32]) #:inline (trap (cast i32 p) n))
(define (host-arg [i i32] [n (ptr u32)]) -> (ptr u8) (cast (ptr u8) (arg i (cast i32 n))))
(define (host-arg-text [i i32]) -> (ptr u8) (host-arg i 0))
(define (host-exit [code i32]) #:inline (exit code))
(define (host-error-text) -> (ptr u8) (cast (ptr u8) (error_message 0)))
(define (host-instantiate [np (ptr u8)] [nl i32] [bp (ptr u8)] [bl i32] [mp (ptr u8)] [ml i32] [compile-time i32])
  #:inline -> i32
  (instantiate (cast i32 np) nl (cast i32 bp) bl (cast i32 mp) ml compile-time))
(define (host-export-index [ip (ptr u8)] [il i32] [fp (ptr u8)] [fl i32]) #:inline -> i32
  (export_index (cast i32 ip) il (cast i32 fp) fl))
(define (host-program-modules [n (ptr u32)]) -> (ptr u8) (cast (ptr u8) (program_modules (cast i32 n))))
(define (host-module-bytes [np (ptr u8)] [nl i32] [n (ptr u32)]) -> (ptr u8)
  (cast (ptr u8) (module_bytes (cast i32 np) nl (cast i32 n))))

;; ---- output ----

;; printf prints its pieces with these.

(define (print-bytes [p (ptr u8)] [n u32]) (drop (host-write 1 p n)))

(define (print-byte [b i32])
  (let ([t (array u8 1)])
    (set! (@ t 0) b)
    (print-bytes t 1)))

(define (print-integer [n u64] [signed i32])
  (let ([t (array u8 24)] [k u32 0])
    (when (and signed (< (cast i64 n) 0))
      (set! (@ t 0) 45)
      (set! n (- 0 n))
      (set! k 1))
    (print-bytes t (+ k (digits-text n 10 (+ t k))))))

(define (print-float [x f64] [single i32])
  (let ([t (array u8 32)]) (print-bytes t (float-text x single t))))

(define (print-string [s (ptr u8)] [quoted i32])
  (cond [(== s 0) (print-bytes "0" 1)]
        [quoted (let ([b (make-buffer)])
                  (write-string (& b) s (strlen s))
                  (print-bytes (-> b bytes) (-> b length))
                  (buffer-free! (& b)))]
        [else (print-bytes s (strlen s))]))

;; ---- math ----

;; C's math functions that a wasm instruction computes exactly as C does.

(func (sqrt [x f64]) #:inline -> f64 (f64.sqrt x))
(func (fabs [x f64]) #:inline -> f64 (f64.abs x))
(func (floor [x f64]) #:inline -> f64 (f64.floor x))
(func (ceil [x f64]) #:inline -> f64 (f64.ceil x))
(func (trunc [x f64]) #:inline -> f64 (f64.trunc x))
(func (nearbyint [x f64]) #:inline -> f64 (f64.nearest x))
(func (copysign [x f64] [y f64]) #:inline -> f64 (f64.copysign x y))

(func (sqrtf [x f32]) #:inline -> f32 (f32.sqrt x))
(func (fabsf [x f32]) #:inline -> f32 (f32.abs x))
(func (floorf [x f32]) #:inline -> f32 (f32.floor x))
(func (ceilf [x f32]) #:inline -> f32 (f32.ceil x))
(func (truncf [x f32]) #:inline -> f32 (f32.trunc x))
(func (nearbyintf [x f32]) #:inline -> f32 (f32.nearest x))
(func (copysignf [x f32] [y f32]) #:inline -> f32 (f32.copysign x y))

;; ---- the allocator, memory functions, arenas, buffers, hash tables ----

(struct header [next (ptr header)] [size u32])

(define base header)
(define freep (ptr header) 0)

(define small u32 512)
(define smalls (array (ptr header) 513))

(define (malloc [n u32]) -> (ptr void)
  (let ([units (+ (/ (+ n (sizeof header) -1) (sizeof header)) 1)] [prev freep])
    (when (and (<= units small) (!= (@ smalls units) 0))
      (let ([b (@ smalls units)])
        (set! (@ smalls units) (-> b next))
        (return (+ b 1))))
    (when (== prev 0)
      (set! (-> base next) (& base))
      (set! freep (& base))
      (set! prev freep))
    (let ([p (-> prev next)])
      (while 1
        (when (>= (-> p size) units)
          (if (== (-> p size) units)
              (set! (-> prev next) (-> p next))
              (begin
                (-= (-> p size) units)
                (+= p (-> p size))
                (set! (-> p size) units)))
          (set! freep prev)
          (return (+ p 1)))
        (when (== p freep)
          (set! p (more-memory units))
          (when (== p 0) (return 0)))
        (set! prev p)
        (set! p (-> p next))))
    0))

(define (more-memory [units u32]) -> (ptr header)
  (let* ([n (if (< units 1024) 1024 units)] [p (cast (ptr header) (sbrk (* n (sizeof header))))])
    (if (== p 0)
        0
        (begin (set! (-> p size) n) (free-block p) freep))))

(define (free [block (ptr void)])
  (when (!= block 0)
    (let ([b (- (cast (ptr header) block) 1)])
      (if (<= (-> b size) small)
          (begin
            (set! (-> b next) (@ smalls (-> b size)))
            (set! (@ smalls (-> b size)) b))
          (free-block b)))))

(define (free-block [b (ptr header)])
  (let ([p freep])
    (while (not (and (> b p) (< b (-> p next))))
      (when (and (>= p (-> p next)) (or (> b p) (< b (-> p next))))
        (break))
      (set! p (-> p next)))
    (if (== (+ b (-> b size)) (-> p next))
        (begin
          (+= (-> b size) (-> p next size))
          (set! (-> b next) (-> p next next)))
        (set! (-> b next) (-> p next)))
    (if (== (+ p (-> p size)) b)
        (begin
          (+= (-> p size) (-> b size))
          (set! (-> p next) (-> b next)))
        (set! (-> p next) b))
    (set! freep p)))

(define (calloc [count u32] [size u32]) -> (ptr void)
  (let ([p (malloc (* count size))])
    (when (!= p 0) (memset p 0 (* count size)))
    p))

(define (realloc [block (ptr void)] [n u32]) -> (ptr void)
  (if (== block 0)
      (malloc n)
      (let ([old (* (- (-> (- (cast (ptr header) block) 1) size) 1) (sizeof header))] [p (malloc n)])
        (when (!= p 0)
          (memcpy p block (if (< n old) n old))
          (free block))
        p)))

(define (memcpy [to (ptr void)] [from (ptr void)] [n u32]) -> (ptr void)
  (memory.copy to from n)
  to)

(define (memset [to (ptr void)] [byte i32] [n u32]) -> (ptr void)
  (memory.fill to byte n)
  to)

(define (memcmp [a (ptr void)] [b (ptr void)] [n u32]) -> i32
  (let ([x (cast (ptr u8) a)] [y (cast (ptr u8) b)])
    (for ([i u32 0]) (< i n) (+= i 1)
      (when (!= (@ x i) (@ y i)) (return (- (@ x i) (@ y i)))))
    0))

(define (strlen [s (ptr u8)]) -> u32
  (let ([p s])
    (while (!= (@ p) 0) (+= p 1))
    (- p s)))

(define (strcmp [a (ptr u8)] [b (ptr u8)]) -> i32
  (let ([i u32 0])
    (while (and (== (@ a i) (@ b i)) (!= (@ a i) 0)) (+= i 1))
    (- (@ a i) (@ b i))))

(struct chunk [previous (ptr chunk)] [size u32])

(struct arena [last (ptr chunk)] [next (ptr u8)] [end (ptr u8)])

(define (make-arena) -> arena
  (let ([a arena])
    (set! (-> a last) 0)
    (set! (-> a next) 0)
    (set! (-> a end) 0)
    a))

(define (arena-alloc [a (ptr arena)] [n u32]) -> (ptr void)
  (let ([size (bit-and (+ n 7) -8)])
    (when (> size (- (-> a end) (-> a next)))
      (arena-grow a size))
    (let ([p (-> a next)])
      (+= (-> a next) size)
      p)))

(define (arena-grow [a (ptr arena)] [n u32])
  (let* ([size (if (> n 65536) n 65536)]
         [c (cast (ptr chunk) (malloc (+ size (sizeof chunk))))])
    (set! (-> c previous) (-> a last))
    (set! (-> c size) size)
    (set! (-> a last) c)
    (set! (-> a next) (cast (ptr u8) (+ c 1)))
    (set! (-> a end) (+ (-> a next) size))))

(define (arena-free [a (ptr arena)])
  (let ([c (-> a last)])
    (while (!= c 0)
      (let ([previous (-> c previous)])
        (free c)
        (set! c previous))))
  (set! (-> a last) 0)
  (set! (-> a next) 0)
  (set! (-> a end) 0))

(struct buffer [bytes (ptr u8)] [length u32] [room u32])

(define (make-buffer) -> buffer
  (let ([b buffer])
    (set! (-> b bytes) 0)
    (set! (-> b length) 0)
    (set! (-> b room) 0)
    b))

(define (buffer-reserve [b (ptr buffer)] [n u32])
  (let ([need (+ (-> b length) n)])
    (when (> need (-> b room))
      (set! (-> b room) (if (> need (* 2 (-> b room))) need (* 2 (-> b room))))
      (set! (-> b bytes) (cast (ptr u8) (realloc (-> b bytes) (-> b room)))))))

(define (buffer-add! [b (ptr buffer)] [p (ptr u8)] [n u32])
  (buffer-reserve b n)
  (memcpy (+ (-> b bytes) (-> b length)) p n)
  (+= (-> b length) n))

(define (buffer-add-byte! [b (ptr buffer)] [byte i32])
  (buffer-reserve b 1)
  (set! (@ (-> b bytes) (-> b length)) byte)
  (+= (-> b length) 1))

(define (buffer-add-string! [b (ptr buffer)] [s (ptr u8)]) (buffer-add! b s (strlen s)))

(define (buffer-free! [b (ptr buffer)])
  (free (-> b bytes))
  (set! (-> b bytes) 0)
  (set! (-> b length) 0)
  (set! (-> b room) 0))

(struct hash-table [keys (ptr u64)] [values (ptr u32)] [count u32] [capacity u32] [shift u32] [arena (ptr arena)])

(define (hash-ref [t (ptr hash-table)] [key u64]) #:inline -> u32
  (if (== (-> t capacity) 0)
      0
      (let* ([keys (-> t keys)] [mask (- (-> t capacity) 1)] [i (cast u32 (>> (* key 11400714819323198485) (-> t shift)))])
        (while (!= (@ keys i) 0)
          (when (== (@ keys i) key) (return (@ (-> t values) i)))
          (set! i (bit-and (+ i 1) mask)))
        0)))

(define (hash-set! [t (ptr hash-table)] [key u64] [value u32])
  (when (>= (* 2 (+ (-> t count) 1)) (-> t capacity)) (hash-grow t))
  (let* ([keys (-> t keys)] [mask (- (-> t capacity) 1)] [i (cast u32 (>> (* key 11400714819323198485) (-> t shift)))])
    (while (!= (@ keys i) 0)
      (when (== (@ keys i) key)
        (set! (@ (-> t values) i) value)
        (return))
      (set! i (bit-and (+ i 1) mask)))
    (set! (@ keys i) key)
    (set! (@ (-> t values) i) value)
    (+= (-> t count) 1)))

(define (hash-grow [t (ptr hash-table)])
  (let* ([keys (-> t keys)] [values (-> t values)] [n (-> t capacity)] [a (-> t arena)] [m (if (== n 0) 16 (* 2 n))])
    (set! (-> t capacity) m)
    (set! (-> t shift) (if (== n 0) 60 (- (-> t shift) 1)))
    (set! (-> t keys) (cast (ptr u64) (if (== a 0) (calloc m 8) (memset (arena-alloc a (* m 8)) 0 (* m 8)))))
    (set! (-> t values) (cast (ptr u32) (if (== a 0) (malloc (* m 4)) (arena-alloc a (* m 4)))))
    (set! (-> t count) 0)
    (for ([i u32 0]) (< i n) (+= i 1)
      (when (!= (@ keys i) 0) (hash-set! t (@ keys i) (@ values i))))
    (when (== a 0)
      (free keys)
      (free values))))

(define (hash-clear! [t (ptr hash-table)])
  (when (!= (-> t capacity) 0) (memset (-> t keys) 0 (* (-> t capacity) 8)))
  (set! (-> t count) 0))

(define (hash-free! [t (ptr hash-table)])
  (free (-> t keys))
  (free (-> t values))
  (set! (-> t keys) 0)
  (set! (-> t values) 0)
  (set! (-> t count) 0)
  (set! (-> t capacity) 0)
  (set! (-> t shift) 0))

;; ---- numbers ----

(func (f64-bits [x f64]) #:inline -> i64 (i64.reinterpret_f64 x))
(func (bits-f64 [b i64]) #:inline -> f64 (f64.reinterpret_i64 b))
(func (f32-bits [x f32]) #:inline -> i32 (i32.reinterpret_f32 x))
(func (leading-zeros [x i64]) #:inline -> i64 (i64.clz x))

(define (digits-text [n u64] [radix u64] [p (ptr u8)]) -> u32
  (let ([k u32 1])
    (for ([m (/ n radix)]) (!= m 0) (set! m (/ m radix)) (+= k 1))
    (for ([i k]) (> i 0) (-= i 1)
      (let ([d (cast i32 (% n radix))])
        (set! (@ p (- i 1)) (if (< d 10) (+ 48 d) (+ 87 d)))
        (set! n (/ n radix))))
    k))

(define (write-digits [b (ptr buffer)] [n u64] [radix u64])
  (let ([t (array u8 64)]) (buffer-add! b t (digits-text n radix t))))

(define (float-text [x f64] [single i32] [p (ptr u8)]) -> u32
  (cond [(!= x x) (memcpy p "+nan.0" 6) (return 6)]
        [(== x (/ 1.0 0.0)) (memcpy p "+inf.0" 6) (return 6)]
        [(== x (/ -1.0 0.0)) (memcpy p "-inf.0" 6) (return 6)])
  (let ([ds (array u8 24)] [n u32 0] [k 0] [j u32 (if (< (f64-bits x) 0) 1 0)] [y f64 0])
    (set! (@ p 0) 45)
    (when (== x 0)
      (memcpy (+ p j) "0.0" 3)
      (return (+ j 3)))
    (set! k (shortest-digits (fabs x) single ds))
    (set! n (strlen ds))
    (cond [(or (< k -2) (> k 10))
           (set! (@ p j) (@ ds 0))
           (+= j 1)
           (when (> n 1)
             (set! (@ p j) 46)
             (memcpy (+ p j 1) (+ ds 1) (- n 1))
             (+= j n))
           (set! (@ p j) 101)
           (+= j 1)
           (when (< k 1)
             (set! (@ p j) 45)
             (+= j 1))
           (+= j (digits-text (cast u64 (if (>= k 1) (- k 1) (- 1 k))) 10 (+ p j)))]
          [(<= k 0)
           (memcpy (+ p j) "0.00" (- 2 k))
           (memcpy (+ p j (- 2 k)) ds n)
           (+= j (+ (- 2 k) n))]
          [(< k n)
           (memcpy (+ p j) ds k)
           (set! (@ p (+ j k)) 46)
           (memcpy (+ p j k 1) (+ ds k) (- n k))
           (+= j (+ n 1))]
          [else
           (memcpy (+ p j) ds n)
           (memset (+ p j n) 48 (- k n))
           (memcpy (+ p j k) ".0" 2)
           (+= j (+ k 2))])
    (if (and single (or (not (read-decimal p j (& y))) (!= (cast f32 y) (cast f32 x))))
        (float-text x 0 p)
        j)))

(define (write-flonum [b (ptr buffer)] [x f64])
  (let ([t (array u8 32)]) (buffer-add! b t (float-text x 0 t))))

(define (write-string [b (ptr buffer)] [p (ptr u8)] [n u32])
  (buffer-add-byte! b 34)
  (for ([i u32 0]) (< i n) (+= i 1)
    (let ([c (@ p i)])
      (case c
        [(34 92) (buffer-add-byte! b 92) (buffer-add-byte! b c)]
        [(10) (buffer-add-string! b "\\n")]
        [(9) (buffer-add-string! b "\\t")]
        [(13) (buffer-add-string! b "\\r")]
        [else (if (or (< c 32) (== c 127))
                  (begin (buffer-add-string! b "\\x") (write-digits b c 16) (buffer-add-byte! b 59))
                  (buffer-add-byte! b c))])))
  (buffer-add-byte! b 34))

(define (shortest-digits [x f64] [single i32] [ds (ptr u8)]) -> i32
  (let* ([width u64 (if single 23 52)]
         [bits (if single (cast u64 (cast u32 (f32-bits (cast f32 x)))) (cast u64 (f64-bits x)))]
         [biased (cast i32 (>> bits width))]
         [one (<< (cast u64 1) width)]
         [f (if (== biased 0) bits (bit-or (bit-and bits (- one 1)) one))]
         [e (- (if (== biased 0) 1 biased) (if single 150 1075))]
         [u (and (== f one) (> biased 1))]
         [even (== (bit-and f 1) 0)]
         [a (if (>= e 0) e 0)]
         [r (array u64 36)] [s (array u64 36)] [m+ (array u64 36)] [m- (array u64 36)] [t (array u64 36)]
         [k (cast i32 (ceil (- (* (cast f64 (- (+ e (- 64 (cast i32 (leading-zeros f)))) 1)) 0.30102999566398114) 1e-10)))]
         [d 0] [low 0] [high 0] [n 0])
    (big-set! r f (+ a 1 u))
    (big-set! s 1 (+ (if (>= e 0) 0 (- e)) 1 u))
    (big-set! m+ 1 (+ a u))
    (big-set! m- 1 a)
    (if (>= k 0)
        (for ([i 0]) (< i k) (+= i 1) (big-mul-add! s 36 10 0))
        (for ([i 0]) (< i (- k)) (+= i 1)
          (big-mul-add! r 36 10 0)
          (big-mul-add! m+ 36 10 0)
          (big-mul-add! m- 36 10 0)))
    (big-sum! t r m+ 36)
    (when (> (big-compare t s 36) (- 0 even))
      (big-mul-add! s 36 10 0)
      (+= k 1))
    (while 1
      (big-mul-add! r 36 10 0)
      (big-mul-add! m+ 36 10 0)
      (big-mul-add! m- 36 10 0)
      (set! d 0)
      (while (>= (big-compare r s 36) 0)
        (big-sub! r s 36)
        (+= d 1))
      (set! low (< (big-compare r m- 36) even))
      (big-sum! t r m+ 36)
      (set! high (> (big-compare t s 36) (- 0 even)))
      (if (and low high)
          (begin
            (big-sum! t r r 36)
            (when (>= (big-compare t s 36) 0) (+= d 1)))
          (when high (+= d 1)))
      (set! (@ ds n) (+ 48 d))
      (+= n 1)
      (when (or low high) (break)))
    (set! (@ ds n) 0)
    k))

(define (digit-value [b i32] [radix i32]) -> i32
  (let ([d (cond [(and (>= b #\0) (<= b #\9)) (- b #\0)]
                 [(and (>= b #\a) (<= b #\z)) (+ (- b #\a) 10)]
                 [(and (>= b #\A) (<= b #\Z)) (+ (- b #\A) 10)]
                 [else 99])])
    (if (< d radix) d -1)))

(define (digits? [p (ptr u8)] [from u32] [end u32] [radix i32]) -> i32
  (when (>= from end) (return 0))
  (for ([i from]) (< i end) (+= i 1)
    (when (< (digit-value (@ p i) radix) 0) (return 0)))
  1)

(define (digits-integer [p (ptr u8)] [from u32] [end u32] [radix i32] [negative i32] [to (ptr u64)]) -> i32
  (let ([n u64 0] [r (cast u64 radix)] [d u64 0])
    (for ([i from]) (< i end) (+= i 1)
      (set! d (cast u64 (digit-value (@ p i) radix)))
      (when (> n (/ (- 18446744073709551615 d) r)) (return 0))
      (set! n (+ (* n r) d)))
    (when (and negative (> n 9223372036854775808)) (return 0))
    (set! (@ to) (if negative (- 0 n) n))
    1))

(define digit-values (ptr u8) 0)
(define digit-room u32 0)

(define (bytes-from? [s (ptr u8)] [n u32] [i u32] [t (ptr u8)]) -> i32
  (and (== (- n i) (strlen t)) (== (memcmp (+ s i) t (- n i)) 0)))

(define (read-decimal [s (ptr u8)] [n u32] [to (ptr f64)]) -> i32
  (let ([i u32 0] [b 0] [negative 0] [digits 0] [point 0] [fraction 0]
        [exponent 0] [exponent-negative 0] [has-exponent 0])
    (when (== n 0) (return 0))
    (when (> n digit-room)
      (set! digit-room (* 2 n))
      (set! digit-values (cast (ptr u8) (realloc digit-values digit-room))))
    (set! b (@ s 0))
    (when (or (== b #\-) (== b #\+))
      (set! negative (== b #\-))
      (set! i 1)
      (when (bytes-from? s n 1 "inf.0")
        (set! (@ to) (if negative (/ -1.0 0.0) (/ 1.0 0.0)))
        (return 1))
      (when (bytes-from? s n 1 "nan.0")
        (set! (@ to) (/ 0.0 0.0))
        (return 1)))
    (while (< i n)
      (set! b (@ s i))
      (if (and (== b #\.) (not point))
          (set! point 1)
          (begin
            (when (or (< b #\0) (> b #\9)) (break))
            (set! (@ digit-values digits) (- b #\0))
            (+= digits 1)
            (when point (+= fraction 1))))
      (+= i 1))
    (when (== digits 0) (return 0))
    (when (< i n)
      (set! b (@ s i))
      (when (and (!= b #\e) (!= b #\E)) (return 0))
      (set! has-exponent 1)
      (+= i 1)
      (when (< i n)
        (set! b (@ s i))
        (when (or (== b #\-) (== b #\+))
          (set! exponent-negative (== b #\-))
          (+= i 1)))
      (when (>= i n) (return 0))
      (while (< i n)
        (set! b (@ s i))
        (when (or (< b #\0) (> b #\9)) (return 0))
        (when (< exponent 100000) (set! exponent (+ (* exponent 10) (- b #\0))))
        (+= i 1))
      (when (> exponent 100000) (set! exponent 100000)))
    (unless (or point has-exponent) (return 0))
    (set! (@ to) (decimal-flonum digit-values digits (- (if exponent-negative (- exponent) exponent) fraction) negative))
    1))

(define (decimal-flonum [ds (ptr u8)] [nd i32] [k i32] [negative i32]) -> f64
  (let ([x f64 0])
    (while (and (> nd 0) (== (@ ds 0) 0))
      (+= ds 1)
      (-= nd 1))
    (set! x (cond [(== nd 0) 0.0]
                  [(> (+ nd k) 310) (bits-f64 9218868437227405312)]
                  [(< (+ nd k) -330) 0.0]
                  [(and (<= nd 15) (>= k -22) (<= k 22)) (small-decimal ds nd k)]
                  [else (bits-f64 (big-decimal ds nd k))]))
    (if negative (- x) x)))

(define (small-decimal [ds (ptr u8)] [nd i32] [k i32]) -> f64
  (let ([n u64 0] [p f64 1.0])
    (for ([i 0]) (< i nd) (+= i 1) (set! n (+ (* n 10) (@ ds i))))
    (for ([i 0]) (< i (if (>= k 0) k (- k))) (+= i 1) (set! p (* p 10)))
    (if (>= k 0) (* (cast f64 n) p) (/ (cast f64 n) p))))

(define (big-decimal [ds (ptr u8)] [nd i32] [k i32]) -> i64
  (let* ([ak (if (>= k 0) k (- k))]
         [len (cast u32 (+ (/ (+ (* (+ nd ak) 4) 1400) 32) 4))]
         [a (make-arena)] [n (big-new (& a) len)] [m (big-new (& a) len)] [r (big-new (& a) len)]
         [s 0] [q u64 0] [mant u64 0] [e2 0])
    (for ([i 0]) (< i nd) (+= i 1) (big-mul-add! n len 10 (@ ds i)))
    (set! (@ m 0) 1)
    (for ([i 0]) (< i ak) (+= i 1) (big-mul-add! (if (>= k 0) n m) len 10 0))
    (set! s (- 54 (- (big-bit-length n len) (big-bit-length m len))))
    (when (> s 1075) (set! s 1075))
    (while 1
      (set! q (big-quotient (& a) n m len s r))
      (if (>= q 18014398509481984)
          (-= s 1)
          (begin
            (when (or (>= q 9007199254740992) (== s 1075)) (break))
            (+= s 1))))
    (set! mant (>> q 1))
    (when (and (!= (bit-and q 1) 0) (or (not (big-zero? r len)) (!= (bit-and mant 1) 0)))
      (+= mant 1))
    (set! e2 (- 1 s))
    (when (== mant 9007199254740992)
      (set! mant 4503599627370496)
      (+= e2 1))
    (arena-free (& a))
    (cond [(< mant 4503599627370496) mant]
          [(> (+ e2 1075) 2046) 9218868437227405312]
          [else (bit-or (<< (cast u64 (+ e2 1075)) 52) (- mant 4503599627370496))])))

;; A number is 32-bit limbs, least significant first, each in a u64.
(define (big-new [a (ptr arena)] [len u32]) -> (ptr u64)
  (let ([x (cast (ptr u64) (arena-alloc a (* 8 len)))])
    (memset x 0 (* 8 len))
    x))

(define (big-set! [x (ptr u64)] [n u64] [b i32])
  (memset x 0 288)
  (set! (@ x (/ b 32)) (bit-and n 4294967295))
  (set! (@ x (+ (/ b 32) 1)) (>> n 32))
  (big-mul-add! x 36 (<< (cast u64 1) (cast u64 (% b 32))) 0))

(define (big-mul-add! [x (ptr u64)] [len u32] [k u64] [c u64])
  (for ([i u32 0]) (< i len) (+= i 1)
    (let ([v (+ (* (@ x i) k) c)])
      (set! (@ x i) (bit-and v 4294967295))
      (set! c (>> v 32)))))

(define (big-sum! [x (ptr u64)] [y (ptr u64)] [z (ptr u64)] [len u32])
  (let ([carry u64 0])
    (for ([i u32 0]) (< i len) (+= i 1)
      (let ([v (+ (@ y i) (@ z i) carry)])
        (set! (@ x i) (bit-and v 4294967295))
        (set! carry (>> v 32))))))

(define (big-bit-length [x (ptr u64)] [len u32]) -> i32
  (let ([i (cast i32 len)])
    (while (> i 0)
      (-= i 1)
      (when (!= (@ x i) 0)
        (return (+ (* i 32) (- 64 (cast i32 (leading-zeros (@ x i))))))))
    0))

(define (big-zero? [x (ptr u64)] [len u32]) -> i32 (== (big-bit-length x len) 0))

(define (big-shl [a (ptr arena)] [x (ptr u64)] [len u32] [b i32]) -> (ptr u64)
  (let ([r (big-new a len)] [w (/ b 32)] [t (cast u64 (% b 32))])
    (for ([i w]) (< i (cast i32 len)) (+= i 1)
      (let ([v (<< (@ x (- i w)) t)])
        (when (and (!= t 0) (> i w))
          (set! v (bit-or v (>> (@ x (- i w 1)) (- 32 t)))))
        (set! (@ r i) (bit-and v 4294967295))))
    r))

(define (big-shr1! [x (ptr u64)] [len u32])
  (for ([i u32 0]) (< i len) (+= i 1)
    (let ([v (>> (@ x i) 1)])
      (when (< (+ i 1) len) (set! v (bit-or v (<< (bit-and (@ x (+ i 1)) 1) 31))))
      (set! (@ x i) v))))

(define (big-compare [x (ptr u64)] [y (ptr u64)] [len u32]) -> i32
  (let ([i (cast i32 len)])
    (while (> i 0)
      (-= i 1)
      (when (< (@ x i) (@ y i)) (return -1))
      (when (> (@ x i) (@ y i)) (return 1)))
    0))

(define (big-sub! [x (ptr u64)] [y (ptr u64)] [len u32])
  (let ([borrow i64 0])
    (for ([i u32 0]) (< i len) (+= i 1)
      (let ([v (- (cast i64 (@ x i)) (cast i64 (@ y i)) borrow)])
        (set! borrow (< v 0))
        (set! (@ x i) (bit-and v 4294967295))))))

(define (big-quotient [a (ptr arena)] [n (ptr u64)] [m (ptr u64)] [len u32] [s i32] [r (ptr u64)]) -> u64
  (let ([x (big-shl a n len (if (>= s 0) s 0))]
        [t (big-shl a (if (>= s 0) m (big-shl a m len (- s))) len 55)]
        [q u64 0])
    (for ([i 0]) (<= i 55) (+= i 1)
      (set! q (<< q 1))
      (when (>= (big-compare x t len) 0)
        (big-sub! x t len)
        (set! q (bit-or q 1)))
      (big-shr1! t len))
    (memcpy r x (* 8 len))
    q))
