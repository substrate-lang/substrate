;; ---- events and traps ----
;; The host calls on-event for each event. An event with a tag goes to the handler in its event-head, and one without
;; goes to the handler given to untagged-handler!. After a trap, the host calls on-trap with the message, which goes
;; to the handler given to trap-handler!; on-trap returns 0 when no handler was given. A program's own on-event or
;; on-trap replaces these.

(typedef handler (fn (u32 u32 u32 (ptr void) i32)))

(struct event-head [handle handler])

(global untagged (mut i32) 0)

(define (untagged-handler! [f handler]) (set! untagged (cast i32 f)))

(define (on-event [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (cond [(!= tag 0) ((-> (cast (ptr event-head) tag) handle) source kind id tag value)]
        [(!= untagged 0) ((cast handler untagged) source kind id tag value)]))

(typedef recovery (fn (string)))

(global recover (mut i32) 0)

(define (trap-handler! [f recovery]) (set! recover (cast i32 f)))

(define (on-trap [why (ptr u8)]) -> i32
  (reset-stack!)
  (let ([recovered (!= recover 0)])
    (when recovered ((cast recovery recover) (string-at why)))
    (free why)
    recovered))

