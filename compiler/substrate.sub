    (memset limbs 0 352)
    (set! (@ x 41) 1)
    (for ([q -1]) (>= q -348) (-= q 1)
      (big-divide-small! x 10)
      (big-top! x (+ t (* 2 (+ q 348)))))
    t))

(define (big-decimal [digits (slice u8)] [k i32]) -> i64
  (let* ([nd (cast i32 (-> digits length))] [ak (if (>= k 0) k (- k))]
         [len (cast u32 (+ (/ (+ (* (+ nd ak) 4) 1400) 32) 4))]
         [a (make-arena)] [n (big-new (& a) len)] [m (big-new (& a) len)] [r (big-new (& a) len)]
         [s 0] [q u64 0] [mant u64 0] [e2 0])
    (for ([i u32 0]) (< i (-> digits length)) (+= i 1) (big-mul-add! n 10 (@ digits i)))
    (set! (@ m 0) 1)
    (for ([i 0]) (< i ak) (+= i 1) (big-mul-add! (if (>= k 0) n m) 10 0))
    (set! s (- 54 (- (big-bit-length n) (big-bit-length m))))
    (when (> s 1075) (set! s 1075))
    (while #t
      (set! q (big-quotient (& a) n m s r))
      (if (>= q 18014398509481984)
          (-= s 1)
          (begin
            (when (or (>= q 9007199254740992) (== s 1075)) (break))
            (+= s 1))))
    (set! mant (>> q 1))
    (when (and (!= (bit-and q 1) 0) (or (not (big-zero? r)) (!= (bit-and mant 1) 0)))
      (+= mant 1))
    (set! e2 (- 1 s))
    (when (== mant 9007199254740992)
      (set! mant 4503599627370496)
      (+= e2 1))
    (arena-free (& a))
    (cond [(< mant 4503599627370496) mant]
          [(> (+ e2 1075) 2046) 9218868437227405312]
          [else (bit-or (<< (cast u64 (+ e2 1075)) 52) (- mant 4503599627370496))])))

;; A number is 32-bit limbs, least significant first, each in a u64.
(define (big-new [a (ptr arena)] [len u32]) -> (slice u64)
  (let ([x (cast (ptr u64) (arena-alloc a (* 8 len)))])
    (memset x 0 (* 8 len))
    (slice x len)))

(define (big-mul-add! [x (slice u64)] [k u64] [c u64])
  (for ([i u32 0]) (< i (-> x length)) (+= i 1)
    (let ([v (+ (* (@ x i) k) c)])
      (set! (@ x i) (bit-and v 4294967295))
      (set! c (>> v 32)))))

(define (big-divide-small! [x (slice u64)] [d u64])
  (let ([r u64 0] [i (-> x length)])
    (while (> i 0)
      (-= i 1)
      (let ([v (bit-or (<< r 32) (@ x i))])
        (set! (@ x i) (/ v d))
        (set! r (% v d))))))

(define (big-limb [x (slice u64)] [i u32]) -> u64 (if (< i (-> x length)) (@ x i) 0))

(define (big-bits [x (slice u64)] [i i32]) -> u64
  (cond [(<= i -64) 0]
        [(< i 0) (<< (big-bits x 0) (cast u64 (- i)))]
        [else
         (let* ([w (cast u32 (/ i 32))] [s (cast u64 (% i 32))]
                [v (bit-or (>> (big-limb x w) s) (<< (big-limb x (+ w 1)) (- 32 s)))])
           (if (== s 0) v (bit-or v (<< (big-limb x (+ w 2)) (- 64 s)))))]))

(define (big-top! [x (slice u64)] [p (ptr u64)])
  (let ([n (big-bit-length x)])
    (set! (@ p 0) (big-bits x (- n 64)))
    (set! (@ p 1) (big-bits x (- n 128)))))

(define (big-bit-length [x (slice u64)]) -> i32
  (let ([i (cast i32 (-> x length))])
    (while (> i 0)
      (-= i 1)
      (when (!= (@ x i) 0)
        (return (+ (* i 32) (- 64 (cast i32 (leading-zeros (@ x i))))))))
    0))

(define (big-zero? [x (slice u64)]) -> bool (== (big-bit-length x) 0))

(define (big-shl [a (ptr arena)] [x (slice u64)] [b i32]) -> (slice u64)
  (let ([r (big-new a (-> x length))] [w (/ b 32)] [t (cast u64 (% b 32))])
    (for ([i w]) (< i (cast i32 (-> x length))) (+= i 1)
      (let ([v (<< (@ x (- i w)) t)])
        (when (and (!= t 0) (> i w))
          (set! v (bit-or v (>> (@ x (- i w 1)) (- 32 t)))))
        (set! (@ r i) (bit-and v 4294967295))))
    r))

(define (big-shr1! [x (slice u64)])
  (for ([i u32 0]) (< i (-> x length)) (+= i 1)
    (let ([v (>> (@ x i) 1)])
      (when (< (+ i 1) (-> x length)) (set! v (bit-or v (<< (bit-and (@ x (+ i 1)) 1) 31))))
      (set! (@ x i) v))))

(define (big-compare [x (slice u64)] [y (slice u64)]) -> i32
  (let ([i (cast i32 (-> x length))])
    (while (> i 0)
      (-= i 1)
      (when (< (@ x i) (@ y i)) (return -1))
      (when (> (@ x i) (@ y i)) (return 1)))
    0))

(define (big-sub! [x (slice u64)] [y (slice u64)])
  (let ([borrow i64 0])
    (for ([i u32 0]) (< i (-> x length)) (+= i 1)
      (let ([v (- (cast i64 (@ x i)) (cast i64 (@ y i)) borrow)])
        (set! borrow (< v 0))
        (set! (@ x i) (bit-and v 4294967295))))))

(define (big-quotient [a (ptr arena)] [n (slice u64)] [m (slice u64)] [s i32] [r (slice u64)]) -> u64
  (let ([x (big-shl a n (if (>= s 0) s 0))]
        [t (big-shl a (if (>= s 0) m (big-shl a m (- s))) 55)]
        [q u64 0])
    (for ([i 0]) (<= i 55) (+= i 1)
      (set! q (<< q 1))
      (when (>= (big-compare x t) 0)
        (big-sub! x t)
        (set! q (bit-or q 1)))
      (big-shr1! t))
    (memcpy (-> r items) (-> x items) (* 8 (-> x length)))
    q))

;; ---- events and traps ----
;; The host calls on-event for each event. An event with a tag goes to the handler in its event-head, and one without
;; goes to each handler given to untagged-handler!. After a trap, the host calls on-trap with the message, which goes
;; to each handler given to trap-handler!; on-trap returns 0 when none was given. Handlers are called in the order they
;; were given, and one given twice is kept once. A program's own on-event or on-trap replaces these.

(typedef handler (fn (u32 u32 u32 (ptr void) i32)))

(struct event-head [handle handler])

;; Handlers of one kind, up to 8, as function indices.
(struct handlers [count u32] [fs (array i32 8)])

(define untagged handlers)

(define (untagged-handler! [f handler]) (handler-add! (& untagged) (cast i32 f)))

(define (on-event [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (if (!= tag 0)
      ((-> (cast (ptr event-head) tag) handle) source kind id tag value)
      (for ([i u32 0]) (< i (-> untagged count)) (+= i 1)
        ((cast handler (@ (-> untagged fs) i)) source kind id tag value))))

(typedef recovery (fn (string)))

(define recoveries handlers)

(define (trap-handler! [f recovery]) (handler-add! (& recoveries) (cast i32 f)))

(define (on-trap [why (ptr u8)] [n u32]) -> bool
  (reset-stack!)
  (for ([i u32 0]) (< i (-> recoveries count)) (+= i 1)
    ((cast recovery (@ (-> recoveries fs) i)) (cast string (slice why n))))
  (free why)
  (> (-> recoveries count) 0))

(define (handler-add! [hs (ptr handlers)] [f i32])
  (for ([i u32 0]) (< i (-> hs count)) (+= i 1) (when (== (@ (-> hs fs) i) f) (return)))
  (when (== (-> hs count) 8) (host-trap "more than 8 handlers of one kind"))
  (set! (@ (-> hs fs) (-> hs count)) f)
  (+= (-> hs count) 1))

;; ---- entry lists ----
;; Lists cross to and from the host as entries, each ended by a zero.

(define (buffer-add-entries! [b (ptr buffer)] [l (slice string)])
  (for ([i u32 0]) (< i (-> l length)) (+= i 1)
    (buffer-add-string! b (@ l i))
    (buffer-add-byte! b 0)))

;; The n bytes of entries at p, which it frees, as strings in one block from malloc, which (free (-> l items)) frees.
(define (entry-strings [p (ptr u8)] [n u32]) -> (slice string)
  (when (== p 0) (return (slice (cast (ptr string) 0) 0)))
  (let ([count u32 0])
    (for ([i u32 0]) (< i n) (+= i 1) (when (== (@ p i) 0) (+= count 1)))
    (let* ([items (cast (ptr string) (malloc (+ (* count 8) n)))] [bytes (cast (ptr u8) (+ items count))] [start u32 0]
           [k u32 0])
      (memcpy bytes p n)
      (free p)
      (for ([i u32 0]) (< i n) (+= i 1)
        (when (== (@ bytes i) 0)
          (set! (@ items k) (cast string (slice (+ bytes start) (- i start))))
          (+= k 1)
          (set! start (+ i 1))))
      (slice items count))))
