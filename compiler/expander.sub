;; The expander: syntax to lowered code, with modules, the cache and sessions.
(require-unqualified macros "macros.sub")
(require-unqualified core "core.sub")
(require-unqualified ops "ops.sub")
(require-unqualified rd "reader.sub")
(require-unqualified fs host/fs)
(require-unqualified cmp "compile.sub")
(require-unqualified running "running.sub")
(require-unqualified ser "serialize.sub")
(require-unqualified leb "leb128.sub")
(require-unqualified checker "checker.sub")
(require-unqualified link "link.sub")

(provide set-repository-root! set-module-map! set-module-map-text! set-display-directory! set-module-check! install-core!
         compile-module-file
         expand-module-file
         content-hash wasm-module program-wasm-modules trap-report host-error write-error
         set-cache-directory!
         session-open! session-eval! session-eval-text! session-eval-file! session-error session-recover!)

(define core-forms datum
  '(func global import supply memory table tag define-syntax begin-for-syntax
           begin require require-unqualified language provide set! let let* if block loop br br-if br-table
           return
           call-indirect func-index select drop values unreachable nop
           throw throw-ref try
           i32.const i64.const f32.const f64.const
           quote quote-syntax
           #%app #%datum #%fact #%checked))

(define visible-core-forms datum
  '(define-syntax begin-for-syntax begin require require-unqualified language provide
           quote quote-syntax #%app #%datum #%fact))

(define wasm-forms datum
  '(memory table tag block loop br br-if br-table call-indirect func-index select drop unreachable nop
           throw throw-ref try i32.const i64.const f32.const f64.const))

;; ---- errors ----

(define (fail-at [where datum] [template string] [args datum]) -> datum
  (raise-compile-error (if (syntax? where) (syntax-srcloc where) 0) (format-message template args))
  0)

(define (no-match [x datum] [patterns string]) -> datum
  (let ([name (form-name x)] [message (format "expected ~a" (cons (string->datum patterns) nil))])
    (throw compile-error (if (== name 0) message (format "~a: ~a" `(,name ,message))) x 0)
    0))

(define (symbol-of [s datum]) -> datum (string->symbol (datum->string s)))

(define (concat [a datum] [b datum]) -> datum (format "~a~a" (cons a (cons b nil))))

(define (read-text [text datum] [source datum]) -> datum
  (read-all (datum->string text) source))

(define (form-name [x datum]) -> datum
  (cond [(identifier? x) (syntax-e x)]
        [(and (syntax? x) (pair? (syntax-e x)) (identifier? (car (syntax-e x)))) (syntax-e (car (syntax-e x)))]
        [else 0]))

(define (list1 [x datum]) -> datum (cons x nil))

;; ---- the run ----

;; The binding table is keyed by symbol and by the largest scope in the binding's scope set
;; (none-slot if the set is empty). A binding only applies to an identifier that has all of the
;; binding's scopes, so to resolve an identifier we only need to look under the identifier's own
;; scopes.
(struct binding [scopes (ptr scope-set)] [phase i32] [key datum] [meaning datum] [next (ptr binding)])

(const all-phases i32 -1)

(define bindings hash-table)
(const none-slot u32 4294967295)

(define unqualified-imports hash-table)
(define scope-counter u32 2)
(define registry hash-table)
(define units-by-hash hash-table)

(struct wasm-module [phase i32] [bytes datum] [imports datum] [scopes datum] [next (ptr wasm-module)])

(struct unit [self datum] [path datum] [name datum] [hash datum] [state datum] [requires datum] [provides datum]
        [entries (ptr module-entry)] [code datum] [scope u32] [infos datum] [facts datum]
        [wasm-modules (ptr wasm-module)] [scope-count u32] [memories datum])

(struct module-entry [symbol datum] [scopes (ptr scope-set)] [phase i32] [binding (ptr binding)] [next (ptr module-entry)])

(const unit-kind u32 20)

(define (new-unit [path datum] [name datum]) -> datum
  (let ([m (cast (ptr unit) (arena-alloc (& run-arena) (sizeof unit)))])
    (set! (-> m self) (make-record unit-kind m))
    (set! (-> m path) (keep path))
    (set! (-> m name) (keep name))
    (set! (-> m hash) 0)
    (set! (-> m state) 'compiling)
    (set! (-> m requires) nil)
    (set! (-> m provides) nil)
    (set! (-> m entries) 0)
    (set! (-> m code) 0)
    (set! (-> m scope) 0)
    (set! (-> m memories) nil)
    (set! (-> m infos) nil)
    (set! (-> m facts) nil)
    (set! (-> m wasm-modules) 0)
    (set! (-> m scope-count) 0)
    (-> m self)))

(define (unit-of [m datum]) -> (ptr unit) (cast (ptr unit) (record-pointer m)))

(struct comp [module datum] [use-site-scopes datum] [phase-forms datum] [memories datum]
        [tables datum] [provide-ids datum] [require-names datum]
        [ns datum] [instances (ptr hash-table)] [values (ptr hash-table)] [wasm-module-counter u32] [storage-wasm-modules datum]
        [checking (ptr void)] [language datum] [expansions (ptr hash-table)] [scopes (ptr hash-table)])

(define current (ptr comp) 0)

(define (the-module) -> (ptr unit) (unit-of (-> current module)))

(define namespace-counter u32 0)

(define (new-comp [m datum]) -> (ptr comp)
  (let ([c (cast (ptr comp) (arena-alloc (current-arena) (sizeof comp)))])
    (set! (-> c module) m)
    (set! (-> c use-site-scopes) nil)
    (set! (-> c phase-forms) nil)
    (set! (-> c memories) nil)
    (set! (-> c tables) nil)
    (set! (-> c provide-ids) nil)
    (set! (-> c require-names) nil)
    (+= namespace-counter 1)
    (set! (-> c ns) (format "c~a" (list1 (make-integer namespace-counter))))
    (set! (-> c instances) (make-table))
    (set! (-> c values) (make-table))
    (set! (-> c wasm-module-counter) 0)
    (set! (-> c storage-wasm-modules) nil)
    (set! (-> c checking) 0)
    (set! (-> c language) 0)
    (set! (-> c expansions) (make-table))
    (set! (-> c scopes) (make-table))
    c))

;; Scopes for local binding forms get odd numbers, and all other scopes get even numbers. This lets
;; quote-syntax strip local scopes from a literal by dropping the odd ones (see prune-local-scopes).
(define (new-scope!) -> u32
  (let ([sc (new-run-scope!)])
    (when (!= current 0) (own-scope! (-> current module) sc))
    sc))
(define (new-run-scope!) -> u32 (+= scope-counter 2) scope-counter)
(define (new-local-scope!) -> u32
  (+= scope-counter 2)
  (let ([sc (+ scope-counter 1)])
    (when (!= current 0) (own-scope! (-> current module) sc))
    sc))

(define (even-scope? [sc u32]) -> bool (== (% sc 2) 0))
(define (even-scopes [s (ptr scope-set)]) -> (ptr scope-set) (scopes-filter s even-scope?))
(define (prune-local-scopes [x datum]) -> datum (map-scopes x even-scopes))

(const core-scope u32 0)
(const wasm-scope u32 2)
(define visible-scopes (ptr scope-set) (scopes-change no-scopes core-scope 0))
(define wasm-scopes (ptr scope-set) (scopes-change no-scopes wasm-scope 0))
(define core-scopes (ptr scope-set) (scopes-change visible-scopes wasm-scope 0))

;; ---- the syntax module ----

(define repository-root datum 0)
(define (set-repository-root! [root datum])
  (set! repository-root (keep (absolute root)))
  (set! roots (keep (map (lambda ([l datum]) -> datum `(,l ,(file-in repository-root l) ())) '("host" "compiler" "std")))))

(define running-syntax datum 0)
(define syntax-instance datum 0)
(define running-names datum 0)

(define running-infos hash-table)

(define (syntax-instance? [name datum]) -> bool (equal? name syntax-instance))

(define running-copies datum nil)

(define (running-copy [path datum]) -> datum
  (let ([known (assoc path running-copies)] [g datum 0] [m datum 0])
    (when (!= known 0) (return (cdr known)))
    (set! g (group-module-at path))
    (when (== g 0) (fail-at 0 "~a requires itself while compiling, which only a module the running compiler shares can" (list1 path)))
    (set! m (running-unit g path))
    (hash-set! (& units-by-hash) (cast u64 (symbol-of path)) (cast u32 m))
    (set! running-copies (keep-cons (cons (keep path) m) running-copies))
    m))

(define (running-copy-of [name datum]) -> datum
  (let ([l running-copies])
    (while (pair? l)
      (when (equal? (-> (unit-of (cdr (car l))) name) name) (return (cdr (car l))))
      (set! l (cdr l)))
    0))

(define (running-instance? [name datum]) -> bool (or (syntax-instance? name) (!= (running-copy-of name) 0)))

(define (running-unit [name datum] [path datum]) -> datum
  (let* ([exports (wasm-module-exports (datum->bytes (running-bytes name)))] [provides nil] [m (new-unit path name)])
    (while (pair? exports)
      (let* ([e (car exports)] [named (symbol-of (cadr e))]
             [info (if (== (car e) 'func)
                       (func-info named (caddr e) (cadddr e) name (cadr e))
                       (tag-info named (caddr e) name (cadr e)))])
        (when (== (car e) 'func) (set-func-info-place! info (cast i32 (integer-value (list-ref e 4)))))
        (hash-set! (& running-infos) (cast u64 info) 1)
        (set! provides (cons (cons named `(,(if (== (car e) 'func) 'func 'tag) ,info)) provides)))
      (set! exports (cdr exports)))
    (set! (-> (unit-of m) provides) (keep (sort provides (lambda ([a datum] [b datum]) -> bool (symbol<? (car a) (car b))))))
    (set! (-> (unit-of m) hash) (keep path))
    (set! (-> (unit-of m) state) 'done)
    m))

(define running-group datum 0)

(define (group-of [name datum]) -> datum
  (let ([out nil] [todo (list1 name)] [n datum 0] [imports datum 0])
    (while (pair? todo)
      (set! n (car todo))
      (set! todo (cdr todo))
      (when (== (member n out) 0)
        (set! out (cons n out))
        (set! imports (wasm-module-imports (datum->bytes (running-bytes n))))
        (while (pair? imports)
          (when (running-wasm-module? (car imports)) (set! todo (cons (car imports) todo)))
          (set! imports (cdr imports)))))
    out))

(define (group-instance [name datum]) -> datum
  (let* ([b (datum->string name)] [n (-> b length)] [i u32 0] [dot u32 0] [l running-group] [m datum 0])
    (while (and (< i n) (!= (@ b i) #\@)) (+= i 1))
    (unless (and (< (+ i 2) n) (== (@ b (+ i 1)) #\0) (== (@ b (+ i 2)) #\+)) (return 0))
    (while (pair? l)
      (let ([g (datum->string (car l))])
        (when (and (== (-> g length) (+ i 4)) (== (slice g 0 (+ i 1)) (slice b 0 (+ i 1)))) (return (car l))))
      (set! l (cdr l)))
    (while (and (< dot i) (!= (@ b dot) #\.)) (+= dot 1))
    (when (>= dot i) (return 0))
    (set! m (cast datum (hash-ref (& units-by-hash) (cast u64 (string->symbol (slice b (+ dot 1) i))))))
    (if (== m 0) 0 (agreeing-instance name m))))

(define agreements hash-table)
(define group-paths datum 0)

(define (agreeing-instance [name datum] [m datum]) -> datum
  (let* ([key (cast u64 (symbol-of name))] [g (cast datum (hash-ref (& agreements) key))])
    (when (!= g 0) (return g))
    (set! g (group-module-at (-> (unit-of m) path)))
    (when (== g 0) (return 0))
    (let ([theirs (recorded-description (running-bytes g))])
      (for-each (lambda ([d datum])
                  (let ([t (assq (car d) theirs)])
                    (when (and (!= t 0) (not (equal? (cdr t) (cdr d))))
                      (fail-at 0 "code run while compiling would use the running compiler's ~a, whose ~a differs from this one's"
                               `(,(-> (unit-of m) path) ,(car d))))))
                (recorded-description (-> (wasm-module-of m 0) bytes))))
    (hash-set! (& agreements) key (cast u32 g))
    g))

(define (group-module-at [path datum]) -> datum
  (when (== group-paths 0)
    (set! group-paths (keep (map (lambda ([g datum]) -> datum (cons (recorded-path (running-bytes g)) g)) running-group))))
  (let ([e (assoc path group-paths)]) (if (!= e 0) (cdr e) 0)))

;; Keeps macros.sub in the compiler's program.
(define macro-tools (fn (datum datum) -> datum) syntax-match-expansion)

(define (install-core!)
  (for-each (lambda ([name datum])
              (bind-raw! name (if (memq name visible-core-forms) visible-scopes wasm-scopes) all-phases `(core ,name)))
            core-forms)
  (for-each (lambda ([name datum]) (bind-raw! name wasm-scopes all-phases `(prim ,name))) (prim-names))
  (set-queries! query-local-value query-free-identifier=? query-binding-kind query-local-expand query-lift
                query-function-signature query-introduce query-local-facts query-identifier-name query-name-identifier
                query-shape)
  (set-expander! query-meaning query-inline-call inline-copy query-expand-head query-scope-shape
                 query-apply-form prune-local-scopes query-facts-of query-datum-type query-syntax-function)
  (let* ([names (running-module-names)] [name (running-module-named names "syntax.")] [tools (running-module-named names "macros.")])
    (when (== name 0) (fail-at 0 "the running program has no syntax module" nil))
    (set! running-names (keep names))
    (set! compiler-hash (keep (content-hash running-names)))
    (set! syntax-instance (keep name))
    (set! running-group (keep (group-of (if (!= tools 0) tools name))))
    (set! running-syntax (running-unit name '"syntax"))
    (use-literals! #f)))

(define (syntax-function [name datum] [program bool]) -> datum
  (let* ([path (if program (recorded-path (running-bytes syntax-instance)) 0)]
         [m (if (!= path 0) (cast datum (hash-ref (& registry) (cast u64 (symbol-of path)))) 0)])
    (if (and (!= m 0) (== (-> (unit-of m) state) 'done)) (provided-function m name) (running-function name))))

(define (use-literals! [program bool])
  (set-literal-functions! (syntax-function 'literal-buffer program) (syntax-function 'deserialize program)))

(define (query-syntax-function [name datum] [phase i32]) -> datum
  (syntax-function name (and (== phase 0) (not (in-session?)))))

(define (provided-function [m datum] [name datum]) -> datum
  (let ([p (assq name (-> (unit-of m) provides))])
    (unless (and (!= p 0) (== (car (cdr p)) 'func)) (fail-at 0 "internal: ~a provides no function ~a" `(,(-> (unit-of m) path) ,name)))
    (cadr (cdr p))))

(define (running-module-named [names datum] [prefix string]) -> datum
  (let ([k (-> prefix length)])
    (while (pair? names)
      (let ([n (datum->string (car names))])
        (when (and (> (-> n length) k) (== (slice n 0 k) prefix)) (return (car names))))
      (set! names (cdr names)))
    0))

(define (running-bytes [name datum]) -> datum
  (let ([bytes (running-module-bytes name)])
    (when (== bytes 0) (fail-at 0 "cannot read the running compiler's wasm module ~a" (list1 name)))
    bytes))

(define (running-wasm-module? [name datum]) -> bool
  (!= (member name running-names) 0))

(define (running-function [name datum]) -> datum
  (let ([p (assq name (-> (unit-of running-syntax) provides))])
    (unless (and (!= p 0) (== (car (cdr p)) 'func)) (fail-at 0 "internal: the syntax module has no function ~a" (list1 name)))
    (cadr (cdr p))))

(define (running-storage [kind datum] [phase i32]) -> datum
  (if (and (== phase 0) (not (in-session?)))
      0
      `(,(imported-kind kind) ,syntax-instance)))

;; ---- bindings ----

(define (slot-key [symbol datum] [slot u32]) -> u64 (bit-or (<< (cast u64 symbol) 32) slot))

(define (binding-slot [scopes (ptr scope-set)]) -> u32
  (if (== (-> scopes count) 0) none-slot (@ (-> scopes ids) 0)))

(define (bindings-under [sym datum] [slot u32]) -> (ptr binding)
  (cast (ptr binding) (hash-ref (& bindings) (slot-key sym slot))))

(define (bind-raw! [sym datum] [scopes (ptr scope-set)] [phase i32] [meaning datum]) -> (ptr binding)
  (let ([b (cast (ptr binding) (arena-alloc (& run-arena) (sizeof binding)))] [k (slot-key sym (binding-slot scopes))])
    (set! (-> b scopes) scopes)
    (set! (-> b phase) phase)
    (set! (-> b key) (keep (fresh-key!)))
    (set! (-> b meaning) (keep meaning))
    (set! (-> b next) (cast (ptr binding) (hash-ref (& bindings) k)))
    (hash-set! (& bindings) k (cast u32 b))
    b))

(define (bind-module-level! [sym datum] [scopes (ptr scope-set)] [phase i32] [meaning datum]) -> (ptr binding)
  (let ([b (bind-raw! sym scopes phase meaning)])
    (when (!= current 0)
      (let ([e (cast (ptr module-entry) (arena-alloc (& run-arena) (sizeof module-entry)))] [m (the-module)])
        (set! (-> e symbol) sym)
        (set! (-> e scopes) scopes)
        (set! (-> e phase) phase)
        (set! (-> e binding) b)
        (set! (-> e next) (-> m entries))
        (set! (-> m entries) e)))
    b))

(define (bind! [id datum] [phase i32] [meaning datum]) -> (ptr binding)
  (bind-raw! (syntax-e id) (syntax-scopes id) phase meaning))

(define (check-unbound! [id datum] [phase i32] [meaning datum])
  (let ([b (bindings-under (syntax-e id) (binding-slot (syntax-scopes id)))])
    (while (!= b 0)
      (when (and (== (-> b phase) phase) (== (-> b scopes) (syntax-scopes id)) (not (equal? (-> b meaning) meaning)))
        (fail-at id "~a is already bound~a"
                 `(,(syntax-e id) ,(if (> phase 0) (format " at phase ~a" (list1 (make-integer phase))) '""))))
      (set! b (-> b next)))))

(define (bind-definition! [id0 datum] [phase i32] [meaning datum]) -> (ptr binding)
  (let ([id id0] [uses (-> current use-site-scopes)])
    (while (pair? uses)
      (set! id (remove-scope id (cast u32 (integer-value (car uses)))))
      (set! uses (cdr uses)))
    (set! id (session-binding-id id phase meaning))
    (shadow-import! id phase meaning)
    (check-unbound! id phase meaning)
    (bind-module-level! (syntax-e id) (syntax-scopes id) phase meaning)))

(define (shadow-import! [id datum] [phase i32] [meaning datum])
  (let* ([k (slot-key (syntax-e id) (binding-slot (syntax-scopes id)))]
         [b (cast (ptr binding) (hash-ref (& bindings) k))]
         [before (ptr binding) 0])
    (while (!= b 0)
      (when (and (== (-> b phase) phase) (== (-> b scopes) (syntax-scopes id))
                 (!= (hash-ref (& unqualified-imports) (cast u64 b)) 0))
        (when (== (hash-ref (& unqualified-imports) (cast u64 b)) 2)
          (fail-at id "~a is defined here, but a macro use before this definition used the ~a it imports"
                   `(,(syntax-e id) ,(syntax-e id))))
        (hash-set! (& unqualified-imports) (cast u64 b) 3)
        (if (== before 0) (hash-set! (& bindings) k (cast u32 (-> b next))) (set! (-> before next) (-> b next)))
        (remove-entry! b)
        (return))
      (set! before b)
      (set! b (-> b next)))))

(define (remove-entry! [b (ptr binding)])
  (let* ([m (the-module)] [e (-> m entries)] [before (ptr module-entry) 0])
    (while (!= e 0)
      (when (== (-> e binding) b)
        (if (== before 0) (set! (-> m entries) (-> e next)) (set! (-> before next) (-> e next)))
        (return))
      (set! before e)
      (set! e (-> e next)))))

(define (phase-matches? [b (ptr binding)] [phase i32]) -> bool
  (or (== (-> b phase) all-phases) (== (-> b phase) phase)))

(define (candidate? [b (ptr binding)] [phase i32] [scopes (ptr scope-set)]) -> bool
  (and (phase-matches? b phase) (scopes-subset? (-> b scopes) scopes)))

(define (resolve [id datum] [phase i32]) -> (ptr binding)
  (let* ([scopes (syntax-scopes id)] [sym (syntax-e id)] [best (ptr binding) 0] [count u32 0] [b (ptr binding) 0])
    (for ([i -1]) (< i (cast i32 (-> scopes count))) (+= i 1)
      (set! b (bindings-under sym (if (< i 0) none-slot (@ (-> scopes ids) i))))
      (while (!= b 0)
        (when (candidate? b phase scopes)
          (+= count 1)
          (when (or (== best 0) (> (-> b scopes count) (-> best scopes count))) (set! best b)))
        (set! b (-> b next))))
    (when (> count 1)
      (for ([i -1]) (< i (cast i32 (-> scopes count))) (+= i 1)
        (set! b (bindings-under sym (if (< i 0) none-slot (@ (-> scopes ids) i))))
        (while (!= b 0)
          (when (and (candidate? b phase scopes)
                     (or (not (scopes-subset? (-> b scopes) (-> best scopes)))
                         (and (!= b best) (== (-> b scopes) (-> best scopes)) (not (equal? (-> b meaning) (-> best meaning))))))
            (fail-at id "identifier ~a is ambiguous" (list1 sym)))
          (set! b (-> b next)))))
    best))

(define (meaning-of [id datum] [phase i32]) -> datum
  (let ([b (resolve id phase)]) (if (== b 0) 0 (-> b meaning))))

;; ---- phase shifting ----

(define (shift-key [d datum] [k u32]) -> u64 (bit-or (<< (cast u64 d) 32) k))

(define shifted-infos hash-table)

(define (shift-instance [inst datum] [k u32]) -> datum
  (let ([r (if (string? inst) (wasm-module-ref inst) 0)])
    (if (!= r 0)
        (wasm-module-name (car r) (cast i32 (integer-value (cadr r))) (+ (cast i32 (integer-value (caddr r))) (cast i32 k)))
        inst)))

(define (shift-info [info datum] [k u32]) -> datum
  (if (or (== k 0) (running-definition? info))
      info
      (let ([hit (cast datum (hash-ref (& shifted-infos) (shift-key info k)))] [new datum 0] [o datum 0])
        (if (!= hit 0)
            hit
            (begin
              (set! new (cond [(func-info? info)
                               (let ([f (func-info (func-info-name info) (func-info-params info) (func-info-results info)
                                                   (shift-instance (func-info-instance info) k) (func-info-export info))])
                                 (set-func-info-place! f (func-info-place info))
                                 f)]
                              [(global-info? info)
                               (global-info (global-info-name info) (global-info-type info) (global-info-mutable? info)
                                            (shift-instance (global-info-instance info) k) (global-info-export info))]
                              [(tag-info? info)
                               (tag-info (tag-info-name info) (tag-info-params info) (shift-instance (tag-info-instance info) k)
                                         (tag-info-export info))]
                              [else info]))
              (hash-set! (& shifted-infos) (shift-key info k) (cast u32 new))
              (set! o (cast datum (hash-ref (& shift-origins) (cast u64 info))))
              (hash-set! (& shift-origins) (cast u64 new)
                         (cast u32 (keep (if (!= o 0) (cons (car o) (make-integer (+ (integer-value (cdr o)) k))) (cons info (make-integer k))))))
              new)))))

(define shift-origins hash-table)

(define (shift-meaning [meaning datum] [k u32]) -> datum
  (if (and (!= meaning 0) (!= (memq (car meaning) '(func global compile-time-value tag)) 0))
      `(,(car meaning) ,(shift-info (cadr meaning) k))
      meaning))

(define (base-info [info datum]) -> datum
  (let ([o (cast datum (hash-ref (& shift-origins) (cast u64 info)))]) (if (!= o 0) (car o) info)))

(define (info-shift [info datum]) -> u32
  (let ([o (cast datum (hash-ref (& shift-origins) (cast u64 info)))]) (if (!= o 0) (cast u32 (integer-value (cdr o))) 0)))

(define shifted-scopes hash-table)

(define (module-scope-at [m datum] [s u32]) -> u32
  (if (== s 0)
      (-> (unit-of m) scope)
      (let ([sc (hash-ref (& shifted-scopes) (shift-key m s))])
        (when (== sc 0)
          (set! sc (new-run-scope!))
          (hash-set! (& shifted-scopes) (shift-key m s) sc)
          (hash-set! (& module-scope-origins) (scope-key sc) (cast u32 (keep (cons m (make-integer s))))))
        sc)))

(define module-scope-origins hash-table)
(define (scope-key [sc u32]) -> u64 (bit-or (<< (cast u64 1) 32) sc))
(define (scope-origin [sc u32]) -> datum (cast datum (hash-ref (& module-scope-origins) (scope-key sc))))

(define (shift-scopes [scopes (ptr scope-set)] [s u32]) -> (ptr scope-set)
  (let ([out scopes] [origin datum 0])
    (for ([i u32 0]) (< i (-> scopes count)) (+= i 1)
      (set! origin (scope-origin (@ (-> scopes ids) i)))
      (when (!= origin 0)
        (set! out (scopes-change (scopes-change out (@ (-> scopes ids) i) 1)
                                 (module-scope-at (car origin) (+ (cast u32 (integer-value (cdr origin))) s)) 0))))
    out))

(define installed hash-table)

(define (install-module-bindings! [m datum] [s u32])
  (when (== (hash-ref (& installed) (shift-key m s)) 0)
    (hash-set! (& installed) (shift-key m s) 1)
    (unless (== s 0)
      (let ([entries nil] [e (-> (unit-of m) entries)])
        (while (!= e 0)
          (set! entries (cons (cast datum e) entries))
          (set! e (-> e next)))
        (while (pair? entries)
          (let ([e (cast (ptr module-entry) (car entries))])
            (bind-raw! (-> e symbol) (shift-scopes (-> e scopes) s) (+ (-> e phase) (cast i32 s))
                       (shift-meaning (-> e binding meaning) s)))
          (set! entries (cdr entries)))))
    (let ([rs (-> (unit-of m) requires)])
      (while (pair? rs)
        (install-module-bindings! (car (car rs)) (+ s (cast u32 (integer-value (cdr (car rs))))))
        (set! rs (cdr rs))))))

;; ---- modules ----

(define (substring [s datum] [from u32] [to u32]) -> datum (string->datum (slice (datum->string s) from to)))

(define (absolute-path? [p datum]) -> bool (let ([s (datum->string p)]) (and (> (-> s length) 0) (== (@ s 0) #\/))))

;; absolute gives p from /, a relative p being from the current directory.
(define (absolute [p datum]) -> datum
  (let ([cwd string] [d datum 0])
    (if (absolute-path? p)
        (set! d (resolve-segments p))
        (begin
          (when (< (fs-cwd (& cwd) 0) 0) (fail-at 0 "internal: there is no current directory" nil))
          (set! d (resolve-segments (concat (string->datum cwd) (concat '"/" p))))
          (free (-> cwd bytes))))
    (if (== (-> (datum->string d) length) 0) '"/" d)))

(define (resolve-segments [p datum]) -> datum
  (let ([kept nil] [s (datum->string p)] [start u32 0] [out (make-buffer)] [d datum 0] [absolute (absolute-path? p)])
    (for ([i u32 0]) (<= i (-> s length)) (+= i 1)
      (when (or (== i (-> s length)) (== (@ s i) #\/))
        (let ([seg (slice s start i)])
          (cond [(or (== seg "") (== seg ".")) (begin)]
                [(== seg "..")
                 (cond [(and (pair? kept) (not (equal? (car kept) '".."))) (set! kept (cdr kept))]
                       [(not absolute) (set! kept (cons (string->datum seg) kept))])]
                [else (set! kept (cons (string->datum seg) kept))]))
        (set! start (+ i 1))))
    (set! kept (reverse kept))
    (while (pair? kept)
      (when (or absolute (> (-> out length) 0)) (buffer-add-byte! (& out) #\/))
      (buffer-add-string! (& out) (datum->string (car kept)))
      (set! kept (cdr kept)))
    (set! d (string->datum (buffer-string (& out))))
    (buffer-free! (& out))
    d))

(define (last-byte-index [s datum] [b i32]) -> i32
  (let* ([t (datum->string s)] [i (cast i32 (-> t length))])
    (while (> i 0)
      (-= i 1)
      (when (== (@ t (cast u32 i)) b) (return i)))
    -1))

(define (directory-of [path datum]) -> datum
  (let ([slash (last-byte-index path #\/)])
    (if (>= slash 0) (substring path 0 (+ slash 1)) '"")))

(define provisional-names hash-table)

(define (provisional-name [path datum]) -> datum
  (let ([stem (file-stem path)] [n i64 1] [name datum 0])
    (while #t
      (set! name (if (== n 1) stem (format "~a-~a" `(,stem ,(make-integer n)))))
      (when (== (hash-ref (& provisional-names) (cast u64 (symbol-of name))) 0)
        (hash-set! (& provisional-names) (cast u64 (symbol-of name)) 1)
        (return name))
      (+= n 1))))

(define (file-stem [path datum]) -> datum
  (let* ([slash (last-byte-index path #\/)]
         [base (if (>= slash 0) (substring path (+ slash 1) (-> (datum->string path) length)) path)]
         [dot (last-byte-index base #\.)]
         [stem (datum->string (if (>= dot 0) (substring base 0 dot) base))]
         [out (make-buffer)] [i u32 0] [s datum 0])
    (while (< i (-> stem length))
      (let ([b (@ stem i)])
        (cond [(or (and (>= b #\a) (<= b #\z)) (and (>= b #\A) (<= b #\Z)) (and (>= b #\0) (<= b #\9)) (== b #\-) (== b #\_))
               (buffer-add-byte! (& out) b)
               (+= i 1)]
              [else
               (buffer-add-byte! (& out) #\_)
               (+= i 1)
               (while (and (< i (-> stem length)) (== (bit-and (@ stem i) 192) 128)) (+= i 1))])))
    (set! s (string->datum (buffer-string (& out))))
    (buffer-free! (& out))
    s))

(define (content-hash [ss datum]) -> datum
  (let ([h u64 14695981039346656037] [digits (array u8 12)])
    (while (pair? ss)
      (let* ([s (datum->string (car ss))] [p (-> s bytes)])
        (for ([i u32 0]) (< i (-> s length)) (+= i 1)
          (set! h (* (bit-xor h (@ p i)) 1099511628211))))
      (set! h (* h 1099511628211))
      (set! ss (cdr ss)))
    (for ([k 0]) (< k 12) (+= k 1)
      (let ([d (cast i32 (bit-and (>> h (- 60 (* k 4))) 15))])
        (set! (@ digits k) (if (< d 10) (+ 48 d) (+ 87 d)))))
    (string->datum (cast string (slice digits)))))

(define (module-hash [path datum] [text datum] [requires datum]) -> datum
  (let ([parts `(,path ,text)])
    (while (pair? requires)
      (set! parts (append parts `(,(car (car requires)) ,(format "~a" (list1 (cadr (car requires)))))))
      (set! requires (cdr requires)))
    (content-hash parts)))

(define (source-text [id datum]) -> datum (file-text (host-file id)))

(define (file-text [file datum]) -> datum
  (let* ([why string] [b (slice u8)] [s datum 0])
    (when (< (fs-read-file (datum->string file) (& b) (& why)) 0)
      (fail-at 0 "cannot read the module ~a" (list1 (host-error why))))
    (set! s (string->datum (cast string b)))
    (free (-> b items))
    s))

;; ---- roots ----

;; A module lives in a root: host, compiler or std, the toolchain's, or one the module map gives; or, outside them, in
;; the directory of the first file. Its identity is label/path in its root, or ./path and ../path from that directory.
;; A root is (label directory uses), uses being ((name label) ...).
(define roots datum nil)
(define loose-directory datum 0)
(define display-directory datum 0)

(define (toolchain-root? [label datum]) -> bool
  (or (equal? label '"host") (equal? label '"compiler") (equal? label '"std")))

;; set-module-map! adds the roots of a module map: (root label "directory" (uses (name label) ...)), uses being optional.
(define (set-module-map! [forms datum])
  (for-each (lambda ([f datum]) (add-root! f)) forms)
  (for-each (lambda ([r datum])
              (for-each (lambda ([u datum])
                          (when (== (assoc (cadr u) roots) 0)
                            (fail-at 0 "the module map's root ~a uses ~a, which the map does not give" `(,(car r) ,(cadr u)))))
                        (caddr r)))
            roots))

(define (add-root! [f datum])
  (let ([label datum 0] [uses nil] [cs datum 0])
    (unless (and (pair? f) (equal? (car f) 'root) (pair? (cdr f)) (symbol? (cadr f)) (pair? (cddr f)) (string? (caddr f)))
      (fail-at 0 "expected (root label \"directory\" (uses (name label) ...)), not ~s" (list1 f)))
    (set! label (string->datum (symbol->string (cadr f))))
    (when (or (toolchain-root? label) (!= (assoc label roots) 0))
      (fail-at 0 "the module map gives ~a twice, or as host, compiler or std" (list1 label)))
    (set! cs (cdddr f))
    (while (pair? cs)
      (let ([c (car cs)])
        (unless (and (pair? c) (equal? (car c) 'uses)) (fail-at 0 "a root's clause is (uses (name label) ...), not ~s" (list1 c)))
        (for-each (lambda ([u datum])
                    (unless (and (pair? u) (symbol? (car u)) (pair? (cdr u)) (symbol? (cadr u)) (null? (cddr u)))
                      (fail-at 0 "a root's uses are (name label), not ~s" (list1 u)))
                    (set! uses (cons `(,(string->datum (symbol->string (car u))) ,(string->datum (symbol->string (cadr u)))) uses)))
                  (cdr c)))
      (set! cs (cdr cs)))
    (set! roots (keep (cons `(,label ,(absolute (caddr f)) ,uses) roots)))))

;; set-module-map-text! reads a module map from text.
(define (set-module-map-text! [text datum] [source datum])
  (set-module-map! (map (lambda ([f datum]) -> datum (syntax->datum f)) (read-text text (symbol-of source)))))

(define (set-display-directory! [dir datum]) (set! display-directory (keep (absolute dir))))

(define (root-of [label datum]) -> datum
  (let ([r (assoc label roots)])
    (when (== r 0) (fail-at 0 "internal: there is no root ~a" (list1 label)))
    r))

(define (loose-root) -> datum
  (when (== loose-directory 0) (set! loose-directory (keep (absolute '"."))))
  loose-directory)

(define (dotted? [path datum]) -> bool (let ([s (datum->string path)]) (and (> (-> s length) 0) (== (@ s 0) #\.))))

;; leaving? is whether a path with its . and .. parts resolved goes up, out of the directory it is from.
(define (leaving? [path datum]) -> bool
  (let ([s (datum->string path)]) (or (== s "..") (and (>= (-> s length) 3) (== (slice s 0 3) "../")))))

(define (identity [label datum] [path datum]) -> datum
  (cond [(!= label 0) (concat label (concat '"/" path))]
        [(leaving? path) path]
        [else (concat '"./" path)]))

(define (identity-label [id datum]) -> datum
  (let ([s (datum->string id)] [i u32 0])
    (when (dotted? id) (return 0))
    (while (and (< i (-> s length)) (!= (@ s i) #\/)) (+= i 1))
    (string->datum (slice s 0 i))))

(define (identity-path [id datum]) -> datum
  (let ([s (datum->string id)] [label (identity-label id)])
    (cond [(!= label 0) (string->datum (slice s (+ (-> (datum->string label) length) 1) (-> s length)))]
          [(and (>= (-> s length) 2) (== (slice s 0 2) "./")) (string->datum (slice s 2 (-> s length)))]
          [else id])))

;; host-file gives where the module with identity id is read from.
(define (host-file [id datum]) -> datum
  (let ([label (identity-label id)])
    (if (== label 0)
        (resolve-segments (concat (loose-root) (concat '"/" (identity-path id))))
        (file-in (cadr (root-of label)) (identity-path id)))))

;; inside? is whether file is under the directory dir, both from /.
(define (inside? [file datum] [dir datum]) -> bool
  (let ([f (datum->string file)] [d (datum->string dir)])
    (and (> (-> f length) (+ (-> d length) 1)) (== (slice f 0 (-> d length)) d) (== (@ f (-> d length)) #\/))))

;; toolchain-holding gives the toolchain's root that holds file, from /, or 0.
(define (toolchain-holding [file datum]) -> datum
  (let ([l roots] [found datum 0])
    (while (pair? l)
      (when (and (toolchain-root? (car (car l))) (inside? file (cadr (car l)))) (set! found (car l)))
      (set! l (cdr l)))
    found))

;; entry-identity gives the identity of a file a command names, in the root labeled root; with root 0, in the toolchain's
;; root that holds it, or else from the directory of the first such file.
(define (entry-identity [root datum] [source datum]) -> datum
  (let* ([file (absolute source)] [r (if (!= root 0) (root-of root) (toolchain-holding file))])
    (cond [(and (!= root 0) (not (inside? file (cadr r)))) (fail-at 0 "internal: ~a is not in the root ~a" `(,file ,root))]
          [(!= r 0) (identity (car r) (relative-path (cadr r) file))]
          [else
           (when (== loose-directory 0) (set! loose-directory (keep (resolve-segments (directory-of file)))))
           (identity 0 (relative-path loose-directory file))])))

(define (path-parts [p datum]) -> datum
  (let ([s (datum->string p)] [start u32 0] [out nil])
    (for ([i u32 0]) (<= i (-> s length)) (+= i 1)
      (when (or (== i (-> s length)) (== (@ s i) #\/))
        (when (> i start) (set! out (cons (string->datum (slice s start i)) out)))
        (set! start (+ i 1))))
    (reverse out)))

(define (joined-parts [parts datum]) -> datum
  (let ([b (make-buffer)] [d datum 0])
    (while (pair? parts)
      (buffer-add-string! (& b) (datum->string (car parts)))
      (when (pair? (cdr parts)) (buffer-add-byte! (& b) #\/))
      (set! parts (cdr parts)))
    (set! d (string->datum (buffer-string (& b))))
    (buffer-free! (& b))
    d))

;; relative-path gives the way from the directory dir to file, both from /.
(define (relative-path [dir datum] [file datum]) -> datum
  (let ([ds (path-parts dir)] [fs (path-parts file)] [up nil])
    (while (and (pair? ds) (pair? fs) (equal? (car ds) (car fs)))
      (set! ds (cdr ds))
      (set! fs (cdr fs)))
    (while (pair? ds)
      (set! up (cons '".." up))
      (set! ds (cdr ds)))
    (joined-parts (append up fs))))

;; path-identity gives the identity a require's path means from the module with identity from: a file of from's root,
;; which the path may not leave, as a path from / does, or, outside the roots, a file from the first file's directory.
(define (path-identity [spec datum] [from datum] [given datum]) -> datum
  (let ([label (identity-label from)] [path datum 0])
    (when (and (!= label 0) (absolute-path? given)) (fail-at spec "~s leaves ~a" `(,given ,label)))
    (when (absolute-path? given) (return (entry-identity 0 given)))
    (set! path (resolve-segments (concat (directory-of (identity-path from)) given)))
    (when (and (!= label 0) (leaving? path)) (fail-at spec "~s leaves ~a" `(,given ,label)))
    (identity label path)))

;; program-forms gives a module's forms without a first (package ...) form, a manifest, which is read by sub.
(define (program-forms [forms datum]) -> datum
  (let ([d (if (pair? forms) (syntax->datum (car forms)) 0)])
    (if (and (pair? d) (equal? (car d) 'package)) (cdr forms) forms)))

;; write-error writes a compile error as write-compile-error does, with its place from the display directory.
(define (write-error [b (ptr buffer)] [message datum] [blamed datum] [loc (ptr srcloc)])
  (let ([at (if (and (== loc 0) (syntax? blamed)) (syntax-srcloc blamed) loc)])
    (write-compile-error b message blamed
                         (if (== at 0)
                             0
                             (make-srcloc (symbol-of (displayed (string->datum (symbol->string (-> at source)))))
                                          (-> at line) (-> at col) (-> at pos) (-> at span))))))

;; displayed gives the place of identity source as a path from the display directory, or, with none, as the identity,
;; ./ left off.
(define (displayed [source datum]) -> datum
  (let ([label (identity-label source)])
    (cond [(and (!= label 0) (== (assoc label roots) 0)) source]
          [(!= display-directory 0) (relative-path display-directory (host-file source))]
          [(== label 0) (identity-path source)]
          [else source])))

(define (file-in [dir datum] [name datum]) -> datum
  (cond [(== (-> (datum->string dir) length) 0) name]
        [(equal? dir '"/") (concat dir name)]
        [else (concat dir (concat '"/" name))]))

(define (kind-of [path datum]) -> i32
  (let ([info fs-info])
    (if (< (fs-stat (datum->string path) (& info) 0) 0) 0 (-> info kind))))

(define (clean-name? [s string]) -> bool
  (let ([start u32 0])
    (for ([i u32 0]) (<= i (-> s length)) (+= i 1)
      (when (or (== i (-> s length)) (== (@ s i) #\/))
        (let ([part (slice s start i)])
          (when (or (== (-> part length) 0) (== part ".") (== part "..")) (return #f)))
        (set! start (+ i 1))))
    #t))

(define (last-part [d datum]) -> datum
  (let* ([s (datum->string d)] [i (-> s length)])
    (while (and (> i 0) (!= (@ s (- i 1)) #\/)) (-= i 1))
    (string->datum (slice s i (-> s length)))))

;; name-identity gives the module a name means from the module with identity from. Its first part is host, compiler
;; or std, a name from's root uses, or from's own root's label; name/rest is rest.sub there, or, when that is not a
;; file and rest is a directory, the module in it named as rest's last part; and name alone is label.sub.
(define (name-identity [id datum] [from datum]) -> datum
  (let* ([s (symbol->string (syntax-e id))] [n (-> s length)] [slash u32 0] [label datum 0] [rest datum 0] [file datum 0])
    (unless (clean-name? s) (fail-at id "~a is not a module name: its parts may not be empty, . or .." (list1 (syntax-e id))))
    (while (and (< slash n) (!= (@ s slash) #\/)) (+= slash 1))
    (set! label (named-root id (string->datum (slice s 0 slash)) (if (== from 0) 0 (identity-label from))))
    (when (== slash n) (return (identity label (concat label '".sub"))))
    (set! rest (string->datum (slice s (+ slash 1) n)))
    (set! file (concat rest '".sub"))
    (if (and (!= (kind-of (host-file (identity label file))) fs-file)
             (== (kind-of (host-file (identity label rest))) fs-directory))
        (identity label (file-in rest (concat (last-part rest) '".sub")))
        (identity label file))))

(define (named-root [id datum] [head datum] [from datum]) -> datum
  (let ([r (if (or (== from 0) (toolchain-root? from)) 0 (root-of from))] [u datum 0])
    (cond [(toolchain-root? head) head]
          [(== r 0) (fail-at id "this module has no name ~a: its names start with host, compiler or std" (list1 head))]
          [(begin (set! u (assoc head (caddr r))) (!= u 0)) (cadr u)]
          [(equal? head from) from]
          [else (fail-at id "~a does not use ~a" `(,from ,head))])))

;; compile-module-file compiles the program in the file source, in the root labeled root, or 0, as entry-identity says.
(define (compile-module-file [root datum] [source datum]) -> datum (module-at (entry-identity root source) 0))

;; The module check, which set-module-check! gives, sees each module a build reads before it reads it: its root's
;; label, or 0 outside the roots; its file; and how to name it. It gives 0, or why the module may not be read.
(typedef module-check (fn (datum datum datum) -> datum))

(define checker i32 0)

(define (set-module-check! [f module-check]) (set! checker (cast i32 f)))

;; check-module! refuses the module with identity id at where when the module check gives why.
(define (check-module! [id datum] [where datum])
  (when (!= checker 0)
    (let ([why ((cast module-check checker) (identity-label id) (host-file id)
                (if (syntax? where) (format "~s" (list1 (syntax-e where))) (displayed id)))])
      (unless (== why 0) (fail-at where "~a" (list1 why))))))

;; module-at gives the module with identity path, compiled or from the cache; one new to this build is checked first, a
;; refusal blamed on where.
(define (module-at [path datum] [where datum]) -> datum
  (let* ([key (cast u64 (symbol-of path))] [known (cast datum (hash-ref (& registry) key))] [cached datum 0])
    (when (== known 0) (check-module! path where))
    (cond [(and (!= known 0) (== (-> (unit-of known) state) 'done)) known]
          [(!= known 0) (fail-at 0 "cyclic require: ~a requires itself" (list1 path))]
          [(begin (set! cached (load-cached path)) (!= cached 0)) cached]
          [(wasm-file? path) (wasm-file-unit path key)]
          [else
           (let* ([text (source-text path)] [m (new-unit path (provisional-name path))] [saved current])
             (hash-set! (& registry) key (cast u32 m))
             (set! compiling (keep-cons (symbol-of path) compiling))
             (begin-module-arena)
             (set! current (new-comp m))
             (try (set! (-> (unit-of m) code)
                        (expand-module-body (program-forms (read-text text (symbol-of path))) #f))
                  (finish-module! text)
                  [catch-all
                   (hash-set! (& registry) key 0)
                   (set! current saved)
                   (abandon-module-arena)
                   (set! compiling (cdr compiling))
                   (rethrow)])
             (set! current saved)
             (end-module-arena)
             (set! compiling (cdr compiling))
             m)])))

(define compiling datum nil)

(define (wasm-file? [path datum]) -> bool
  (let ([s (datum->string path)])
    (and (> (-> s length) 5) (== (slice s (- (-> s length) 5) (-> s length)) ".wasm"))))

;; wasm-file-unit makes the side module at path a module: it requires the prelude, which it is linked against, and
;; provides its functions with their own types; it also defines the global supply:name of each function it imports by
;; name, which supply sets, and supplied!, which supply calls after.
(define (wasm-file-unit [path datum] [key u64]) -> datum
  (let* ([bytes (file-bytes (host-file path))] [prelude datum 0] [m datum 0] [u (ptr unit) 0] [instance datum 0]
         [linked datum 0] [provides nil] [infos nil] [info datum 0])
    (when (equal? bytes '#f) (fail-at 0 "cannot read the module ~a" (list1 path)))
    (set! prelude (module-at (language-path) 0))
    (set! m (new-unit path (provisional-name path)))
    (set! u (unit-of m))
    (hash-set! (& registry) key (cast u32 m))
    (set! (-> u requires) (keep (list1 (cons prelude (make-integer 0)))))
    (set! (-> u hash) (keep (module-hash path (string->datum (cast string (datum->bytes bytes)))
                                         (list1 `(,(-> (unit-of prelude) hash) ,(make-integer 0))))))
    (set! (-> u name) (keep (format "~a.~a" `(,(file-stem path) ,(-> u hash)))))
    (note-hash! m)
    (set! instance (wasm-module-name m 0 0))
    (set! linked (link-side-module path bytes (wasm-module-name prelude 0 0)))
    (add-wasm-module! m 0 `(,(car linked) ,(list1 (wasm-module-name prelude 0 0)) ()))
    (for-each (lambda ([e datum])
                (when (== (car e) 'func)
                  (set! info (func-info (symbol-of (cadr e)) (caddr e) (cadddr e) instance (cadr e)))
                  (set! infos (cons info infos))
                  (unless (equal? (cadr e) '"supplied!")
                    (set! provides (cons (cons (symbol-of (cadr e)) `(func ,info)) provides)))))
              (wasm-module-exports (datum->bytes (car linked))))
    (for-each (lambda ([h datum])
                (let ([export (format "supply:~a" (list1 h))])
                  (set! infos (cons (global-info (symbol-of export) 'i32 (boolean #t) instance export) infos))))
              (cadr linked))
    (set! (-> u infos) (keep infos))
    (set! (-> u provides) (keep (sort provides (lambda ([a datum] [b datum]) -> bool (symbol<? (car a) (car b))))))
    (set! (-> u state) 'done)
    (store-cached! m)
    m))

(define (expand-module-file [root datum] [source datum] [f (closure (datum))])
  (let* ([path (entry-identity root source)] [key (cast u64 (symbol-of path))] [text datum 0]
         [m (new-unit path (provisional-name path))] [saved current] [forms datum 0])
    (check-module! path 0)
    (set! text (source-text path))
    (hash-set! (& registry) key (cast u32 m))
    (begin-module-arena)
    (set! current (new-comp m))
    (try (set! forms (expand-module-body (program-forms (read-text text (symbol-of path))) #t))
         [catch-all
          (hash-set! (& registry) key 0)
          (set! current saved)
          (abandon-module-arena)
          (rethrow)])
    (while (pair? forms)
      (f (car forms))
      (set! forms (cdr forms)))
    (hash-set! (& registry) key 0)
    (set! current saved)
    (end-module-arena)))

(define (expand-module-body [forms datum] [syntax bool]) -> datum
  (let ([msc (new-scope!)] [saved to-syntax] [out datum 0])
    (set! (-> (the-module) scope) msc)
    (hash-set! (& module-scope-origins) (scope-key msc) (cast u32 (keep (cons (-> (the-module) self) (make-integer 0)))))
    (set! to-syntax syntax)
    (set! out (try (expand-body (language-body (map (lambda ([f datum]) -> datum (add-scope (add-scope f core-scope) msc)) forms)) 0)
                   [catch-all (set! to-syntax saved) (rethrow)]))
    (set! to-syntax saved)
    out))

(define (language-body [forms datum]) -> datum
  (if (and (pair? forms) (== (core-head (car forms) 0) 'language))
      (let ([id (datum->syntax (car forms) '#%module-begin (car forms))])
        (require! (car forms) 0 2)
        (when (== (transformer-of (meaning-of id 0)) 0)
          (fail-at (car forms) "~a is not a language: it binds no #%module-begin" (list1 (syntax-e (caddr (syntax->list (car forms)))))))
        (set! (-> current language) (list1 (make-integer 0)))
        (list1 (datum->syntax (car forms) (cons id (cdr forms)) (car forms))))
      (default-body forms)))

(define (default-body [forms datum]) -> datum
  (if (not (equal? (language-path) (-> (the-module) path)))
      (let ([id (make-syntax '%substrate:#%module-begin (module-base-scopes) 0 nil)])
        (set! (-> current language) nil)
        (use-language! 0)
        (if (!= (transformer-of (meaning-of id 0)) 0)
            (list1 (make-syntax (cons id forms) core-scopes (if (pair? forms) (syntax-srcloc (car forms)) 0) nil))
            forms))
      (map (lambda ([f datum]) -> datum (add-scope f wasm-scope)) forms)))

(define (compiler-file [name datum]) -> datum (identity '"compiler" name))

(define (language-path) -> datum (compiler-file '"substrate.sub"))

(define (module-base-scopes) -> (ptr scope-set) (scopes-change visible-scopes (-> (the-module) scope) 0))

(define (use-language! [phase i32])
  (let ([l (-> current language)])
    (when (and (!= l 0) (== (memq (make-integer phase) l) 0))
      (set! (-> current language) (cons (make-integer phase) l))
      (require! (make-syntax `(,(core-id 'language 0) ,(make-syntax '%substrate (module-base-scopes) 0 nil)
                               ,(make-syntax (language-path) no-scopes 0 nil))
                             core-scopes 0 nil)
                phase 2))))

(define (finish-module! [text datum])
  (let ([m (the-module)] [items (reverse (-> current provide-ids))] [provides nil])
    (add-phase-forms! 0 (-> m code))
    (while (pair? items)
      (let* ([item (car items)] [id (cdr item)] [v (meaning-of id 0)])
        (unless (and (!= v 0) (!= (memq (car v) '(func global compile-time-value data tag core prim)) 0))
          (fail-at id "cannot provide ~a: it is not a module-level binding or a core form" (list1 (syntax-e id))))
        (set! provides (cons (cons (syntax-e (car item)) v) provides)))
      (set! items (cdr items)))
    (set! (-> m provides) (keep (reverse provides)))
    (set! (-> m hash) (keep (module-hash (-> m path) text
                                         (map (lambda ([r datum]) -> datum `(,(-> (unit-of (car r)) hash) ,(cdr r)))
                                              (-> m requires)))))
    (set! (-> m name) (keep (format "~a.~a" `(,(file-stem (-> m path)) ,(-> m hash)))))
    (note-hash! (-> m self))
    (compile-wasm-modules!)))

;; ---- wasm modules ----

(define (storage-forms [phase i32]) -> datum
  (filter-out-false `(,(storage-form 'memory phase) ,(substrate-storage 'memory phase)
                      ,(storage-form 'table phase) ,(substrate-storage 'table phase))))

;; A module's own memory or table is index 1 beside Substrate's at 0: one it declares, or another module's, which
;; (memory 1 from module) takes.
(define (storage-form [kind datum] [phase i32]) -> datum
  (let ([own (declared-storage kind phase kind)] [second (declared-storage kind phase (second-kind kind))]
        [taken (declared-storage kind phase (imported-kind kind))])
    (cond [(!= own 0) own]
          [(!= second 0) `(,(imported-kind kind) ,(cadr second))]
          [(!= taken 0) taken]
          [else (running-storage kind phase)])))

(define (second-kind [kind datum]) -> datum (if (== kind 'memory) 'memory-1 'table-1))

(define (substrate-storage [kind datum] [phase i32]) -> datum
  (if (and (== (declared-storage kind phase kind) 0) (== (declared-storage kind phase (second-kind kind)) 0))
      0
      (let ([f (declared-storage kind phase (imported-kind kind))])
        (when (== f 0) (set! f (running-storage kind phase)))
        (if (== f 0) 0 `(,(if (== kind 'memory) 'substrate-memory 'substrate-table) ,(cadr f))))))

(define (declared-storage [kind datum] [phase i32] [head datum]) -> datum
  (let ([l (if (== kind 'memory) (-> current memories) (-> current tables))])
    (while (pair? l)
      (when (and (== (cast i32 (integer-value (car (car l)))) phase) (== (car (cdr (car l))) head)) (return (cdr (car l))))
      (set! l (cdr l)))
    0))

(define (imported-kind [kind datum]) -> datum (if (== kind 'memory) 'memory-import 'table-import))

(define (add-wasm-module! [m datum] [phase i32] [compiled datum])
  (let ([l (cast (ptr wasm-module) (arena-alloc (& run-arena) (sizeof wasm-module)))] [u (unit-of m)])
    (set! (-> l phase) phase)
    (set! (-> l bytes) (keep (car compiled)))
    (set! (-> l imports) (keep (cadr compiled)))
    (set! (-> l scopes) (keep (caddr compiled)))
    (set! (-> l next) (-> u wasm-modules))
    (set! (-> u wasm-modules) l)
    (when (== phase 0) (note-supplies! m (car compiled)))))

;; suppliers pairs each (module . supply:name) global a module imports, the slot of a function it supplies, with the
;; module.
(define suppliers datum nil)

(define (note-supplies! [m datum] [bytes datum])
  (let ([l (wasm-module-import-fields (datum->bytes bytes))])
    (while (pair? l)
      (when (supply-field? (cdr (car l))) (set! suppliers (keep-cons (keep (cons (car l) m)) suppliers)))
      (set! l (cdr l)))))

(define (supply-field? [f datum]) -> bool
  (let ([s (datum->string f)]) (and (> (-> s length) 7) (== (slice s 0 7) "supply:"))))

(define (wasm-module-of [m datum] [phase i32]) -> (ptr wasm-module)
  (let ([l (-> (unit-of m) wasm-modules)])
    (while (and (!= l 0) (!= (-> l phase) phase)) (set! l (-> l next)))
    l))

(define (compile-wasm-modules!)
  (let* ([m (the-module)] [forms datum 0]
         [phases (sort (let ([ps (map (lambda ([e datum]) -> datum (car e)) (-> current phase-forms))])
                         (if (!= (member (make-integer 0) ps) 0) ps (cons (make-integer 0) ps)))
                       (lambda ([a datum] [b datum]) -> bool (< (integer-value a) (integer-value b))))])
    (while (pair? phases)
      (let* ([p (cast i32 (integer-value (car phases)))] [e (assoc (car phases) (-> current phase-forms))])
        (set! forms (append (storage-forms p) (if (!= e 0) (reverse (cdr e)) nil)))
        (set-current-source! (symbol-of (-> m path)))
        (use-literals! (== p 0))
        (add-wasm-module! (-> m self) p (let ([c (compile-module forms (wasm-module-name (-> m self) p 0))])
                                          (if (== p 0) (recorded (-> m self) c) c)))
        (use-literals! #f)
        (set! (-> m memories) (keep-cons (cons (make-integer p) (storage-form 'memory p)) (-> m memories)))
        (note-definitions! (-> m self) forms))
      (set! phases (cdr phases)))
    (hash-set! (& installed) (shift-key (-> m self) 0) 1)
    (set! (-> m state) 'done)
    (set! (-> m code) 0)
    (store-cached! (-> m self))))

;; ---- what compiled code relies on ----

(define (recorded [m datum] [compiled datum]) -> datum
  (let ([record (data-bytes `(,(-> (unit-of m) path) ,(description m)))])
    (cons (with-custom-section (car compiled) "substrate" record) (cdr compiled))))

(define (description [m datum]) -> datum
  (let ([out nil])
    (for-each (lambda ([p datum])
                (let* ([meaning (cdr p)] [base (definition-of meaning)]
                       [d (if (and (!= base 0) (== (definition-module base) m)) (meaning-description meaning) 0)])
                  (when (!= d 0) (set! out (cons (cons (car p) (content-hash (list1 (format "~s" (list1 d))))) out)))))
              (-> (unit-of m) provides))
    (reverse out)))

(define (meaning-description [meaning datum]) -> datum
  (cond [(== (car meaning) 'compile-time-value)
         (let ([v (compile-time-value (cadr meaning))]) (if (transformer? v) 0 (plain v)))]
        [(== (car meaning) 'func)
         (let ([b (cast datum (hash-ref (& inlines) (cast u64 (base-info (cadr meaning)))))]) (if (== b 0) 0 (plain (numbered b))))]
        [else 0]))

(define (numbered [b datum]) -> datum
  (let* ([keys (new-table)] [labels (new-table)] [was (keys-from! 0)] [shift inline-shift]
         [params (map (lambda ([p datum]) -> datum (cons (copied-key (& keys) (car p)) (cdr p))) (car b))]
         [body (begin (set! inline-shift 0) (copy-inline (caddr b) (& keys) (& labels) 0))]
         [assigned (map (lambda ([p datum]) -> datum (copied-key (& keys) (car p))) (list-ref b 4))])
    (keys-from! was)
    (set! inline-shift shift)
    (hash-free! (& keys))
    (hash-free! (& labels))
    `(,params ,(cadr b) ,body ,(cadddr b) ,assigned ,(list-ref b 5) ,(list-ref b 6))))

(define (plain [x datum]) -> datum
  (cond [(syntax? x) (plain (syntax->datum x))]
        [(pair? x) (cons (plain (car x)) (plain (cdr x)))]
        [(func-info? x) `(func ,(func-info-export x))]
        [(global-info? x) `(global ,(global-info-export x))]
        [(!= (record-kind x) 0) 'record]
        [else x]))

(define (with-custom-section [bytes datum] [name string] [contents datum]) -> datum
  (let ([out (make-buffer)] [section (make-buffer)] [c (datum->bytes contents)] [b (datum->bytes bytes)] [s datum 0])
    (write-uleb (& section) (-> name length))
    (buffer-add-string! (& section) name)
    (buffer-add! (& section) c)
    (buffer-add! (& out) b)
    (buffer-add-byte! (& out) 0)
    (write-uleb (& out) (-> section length))
    (buffer-add! (& out) (buffer-bytes (& section)))
    (set! s (bytes->datum (buffer-bytes (& out))))
    (buffer-free! (& section))
    (buffer-free! (& out))
    s))

(define (record-of [bytes datum]) -> datum
  (let ([s (wasm-module-custom (datum->bytes bytes) "substrate")])
    (if (== s 0) 0 (data-of s))))

(define (recorded-path [bytes datum]) -> datum (let ([r (record-of bytes)]) (if (== r 0) 0 (car r))))
(define (recorded-description [bytes datum]) -> datum (let ([r (record-of bytes)]) (if (== r 0) nil (cadr r))))

(define (program-wasm-modules [m datum]) -> datum
  (let ([seen (make-table)] [out nil])
    (set! out (visit-wasm-modules m seen out))
    (reverse out)))

(define (visit-wasm-modules [m datum] [seen (ptr hash-table)] [out datum]) -> datum
  (let ([name (wasm-module-name m 0 0)] [l nil])
    (when (!= (datum-get seen name) 0) (return out))
    (datum-put! seen name (boolean #t))
    (let* ([p (wasm-module-of m 0)] [imports (-> p imports)])
      (while (pair? imports)
        (set! out (visit-import (car imports) seen out))
        (set! imports (cdr imports)))
      (set! out (cons (cons name (-> p bytes)) out))
      (set! l (suppliers-of m))
      (while (pair? l)
        (set! out (visit-wasm-modules (car l) seen out))
        (set! l (cdr l)))
      out)))

;; suppliers-of gives the modules that supply the functions the C module m calls by name, which start after it, in a
;; program and in code run while compiling, as a linker adds the object that defines a symbol another needs.
(define (suppliers-of [m datum]) -> datum
  (let ([l (if (wasm-file? (-> (unit-of m) path)) (-> (unit-of m) infos) nil)] [name (wasm-module-name m 0 0)] [found nil]
        [export datum 0] [out nil])
    (while (pair? l)
      (when (global-info? (car l))
        (set! export (global-info-export (car l)))
        (set! found (supplying name export))
        (cond [(null? found)
               (fail-at 0 "~a calls ~a by name, and no module supplies it" `(,(-> (unit-of m) path) ,(supplied-name export)))]
              [(pair? (cdr found))
               (fail-at 0 "~a calls ~a by name, and both ~a and ~a supply it"
                        `(,(-> (unit-of m) path) ,(supplied-name export) ,(-> (unit-of (car found)) path)
                          ,(-> (unit-of (cadr found)) path)))]
              [(== (memq (car found) out) 0) (set! out (cons (car found) out))]))
      (set! l (cdr l)))
    (reverse out)))

(define (supplying [name datum] [export datum]) -> datum
  (let ([l suppliers] [out nil])
    (while (pair? l)
      (when (and (equal? (car (car (car l))) name) (equal? (cdr (car (car l))) export) (== (memq (cdr (car l)) out) 0))
        (set! out (cons (cdr (car l)) out)))
      (set! l (cdr l)))
    out))

(define (supplied-name [export datum]) -> datum (substring export 7 (-> (datum->string export) length)))

(define (visit-import [imp datum] [seen (ptr hash-table)] [out datum]) -> datum
  (let ([l (wasm-module-ref imp)])
    (cond [(!= l 0)
           (unless (and (== (integer-value (cadr l)) 0) (== (integer-value (caddr l)) 0))
             (fail-at 0 "internal: a program imports from ~a" (list1 imp)))
           (visit-wasm-modules (car l) seen out)]
          [(running-wasm-module? imp) (visit-running imp seen out)]
          [else out])))

(define (visit-running [name datum] [seen (ptr hash-table)] [out datum]) -> datum
  (when (!= (datum-get seen name) 0) (return out))
  (datum-put! seen name (boolean #t))
  (let* ([bytes (running-bytes name)] [imports (wasm-module-imports (datum->bytes bytes))])
    (while (pair? imports)
      (set! out (visit-import (car imports) seen out))
      (set! imports (cdr imports)))
    (cons (cons name bytes) out)))

;; ---- the cache ----

(define cache-directory datum 0)
(define (set-cache-directory! [dir datum]) (set! cache-directory (keep dir)))

(const cache-format i64 5)

(define compiler-hash datum 0)

(define (cache-compiler) -> datum (if (== cache-directory 0) 0 compiler-hash))

(define (cache-file [name datum]) -> datum (concat cache-directory (concat '"/" name)))

(define (data-bytes [d datum]) -> datum
  (let ([s (make-serializer)])
    (serialize! s d)
    (serializer-bytes s)))

;; A cache file is its data and then the data's hash.
(define (read-data [path datum]) -> datum
  (let ([d (file-bytes path)])
    (if (and (!= d 0) (sealed? (datum->bytes d))) (data-of d) 0)))

(define (sealed? [s (slice u8)]) -> bool
  (let ([n (-> s length)])
    (and (>= n 8) (== (@ (cast (ptr u64) (+ (-> s items) (- n 8))) 0) (data-hash (slice (-> s items) (- n 8)))))))

(define (data-hash [s (slice u8)]) -> u64
  (let ([h u64 14695981039346656037] [p (-> s items)])
    (for ([i u32 0]) (< i (-> s length)) (+= i 1)
      (set! h (* (bit-xor h (@ p i)) 1099511628211)))
    h))

(define (write-data [path datum] [d datum]) -> bool
  (let* ([data (datum->bytes (data-bytes d))] [h (data-hash data)] [b (make-buffer)] [temp string] [ok #f])
    (buffer-add! (& b) data)
    (for ([i u64 0]) (< i 64) (+= i 8) (buffer-add-byte! (& b) (cast i32 (bit-and (>> h i) 255))))
    (when (>= (fs-make-temp-file (datum->string cache-directory) "" ".tmp" (& temp) 0) 0)
      (set! ok (and (>= (fs-write-file temp (buffer-bytes (& b)) 0) 0) (>= (fs-rename temp (datum->string path) 0) 0)))
      (unless ok (fs-remove temp #f 0))
      (free (-> temp bytes)))
    (buffer-free! (& b))
    ok))

(define (data-of [d datum]) -> datum
  (if (== d 0)
      0
      (let* ([s (datum->bytes d)] [p (-> s items)] [count u64 0] [shift u64 0] [i u32 0] [b u32 128])
        (when (== (-> s length) 0) (return 0))
        (while (and (!= (bit-and b 128) 0) (< i (-> s length)))
          (set! b (@ p i))
          (+= i 1)
          (set! count (bit-or count (<< (cast u64 (bit-and b 127)) shift)))
          (+= shift 7))
        (if (== count 0) 0 (@ (deserialize p (-> s length)) (cast u32 (- count 1)))))))

(define (section [d datum] [key datum]) -> datum (cdr (assq key d)))

(define (current-cache? [d datum]) -> bool
  (and (pair? d) (!= (assq 'format d) 0)
       (equal? (section d 'format) (make-integer cache-format))
       (equal? (section d 'compiler) compiler-hash)))

(define (load-cached [path datum]) -> datum
  (if (== (cache-compiler) 0)
      0
      (begin
        (begin-module-arena)
        (let ([m (try (load-cached-in path) [catch-all (abandon-module-arena) (rethrow)])])
          (end-module-arena)
          m))))

(define (load-cached-in [path datum]) -> datum
  (let* ([ds (read-data (cache-file (cache-name path)))]
         [d (if (pair? ds) (car ds) 0)]
         [key (cast u64 (symbol-of path))]
         [hash datum 0] [requires datum 0] [known datum 0] [m datum 0])
    (unless (current-cache? d) (return 0))
    (set! hash (section d 'hash))
    (set! requires (section d 'requires))
    (unless (and (string? hash)
                 (equal? (module-hash path (source-text path)
                                      (map (lambda ([r datum]) -> datum (cdr r)) requires))
                         hash))
      (return 0))
    (hash-set! (& registry) key (cast u32 (new-unit path path)))
    (while (pair? requires)
      (let* ([r (car requires)]
             [u (if (and (equal? (car r) path) (> (integer-value (caddr r)) 0)) (running-copy path) (module-at (car r) 0))])
        (unless (equal? (-> (unit-of u) hash) (cadr r))
          (hash-set! (& registry) key 0)
          (return 0)))
      (set! requires (cdr requires)))
    (set! known (cast datum (hash-ref (& units-by-hash) (cast u64 (symbol-of hash)))))
    (set! m (if (!= known 0) known (load-compiled-module d path)))
    (hash-set! (& registry) key (cast u32 m))
    m))

(define (store-cached! [m datum])
  (when (!= (cache-compiler) 0)
    (let ([u (unit-of m)])
      (write-data (cache-file (cache-name (-> u path))) (list1 (cache-form m))))))

(define (cache-name [path datum]) -> datum (concat (content-hash (list1 (host-file path))) '".subc"))

;; note-hash! keeps m under its hash, which no other module may have, as a program names its modules by them.
(define (note-hash! [m datum])
  (let* ([u (unit-of m)] [key (cast u64 (symbol-of (-> u hash)))] [known (cast datum (hash-ref (& units-by-hash) key))])
    (cond [(== known 0) (hash-set! (& units-by-hash) key (cast u32 m))]
          [(not (equal? (-> (unit-of known) path) (-> u path)))
           (fail-at 0 "~a and ~a have the same hash, ~a" `(,(-> (unit-of known) path) ,(-> u path) ,(-> u hash)))])))

(define (load-compiled-module [d datum] [path datum]) -> datum
  (let ([m (new-unit path (section d 'name))])
    (set! (-> (unit-of m) requires)
          (keep (map (lambda ([r datum]) -> datum
                       (cons (cast datum (hash-ref (& units-by-hash) (cast u64 (symbol-of (cadr r))))) (caddr r)))
                     (section d 'requires))))
    (load-module! m d)
    m))

;; ---- naming scopes and definitions ----

(define scope-owners hash-table)
(define scope-numbers hash-table)
(define module-scopes hash-table)

(define (own-scope! [m datum] [sc u32])
  (let ([u (unit-of m)])
    (hash-set! (& scope-owners) (scope-key sc) (cast u32 m))
    (hash-set! (& scope-numbers) (scope-key sc) (-> u scope-count))
    (hash-set! (& module-scopes) (shift-key m (-> u scope-count)) sc)
    (+= (-> u scope-count) 1)))

(define (unit-scope-at [m datum] [i u32]) -> u32
  (let ([sc (hash-ref (& module-scopes) (shift-key m i))])
    (when (== sc 0)
      (set! sc (new-run-scope!))
      (hash-set! (& scope-owners) (scope-key sc) (cast u32 m))
      (hash-set! (& scope-numbers) (scope-key sc) i)
      (hash-set! (& module-scopes) (shift-key m i) sc))
    sc))

(define (unit-with-hash [hash datum]) -> datum
  (let ([m (cast datum (hash-ref (& units-by-hash) (cast u64 (symbol-of hash))))])
    (when (== m 0) (fail-at 0 "the cache is inconsistent: no module ~a" (list1 hash)))
    m))

(define (info-kind [info datum]) -> datum
  (cond [(func-info? info) 'func] [(global-info? info) 'global] [else 'tag]))

(define (info-export [info datum]) -> datum
  (cond [(func-info? info) (func-info-export info)] [(global-info? info) (global-info-export info)] [else (tag-info-export info)]))

(define definition-indexes hash-table)

(define (definition-key [instance datum] [kind datum] [export datum]) -> u64
  (cast u64 (string->symbol (format-message "~a ~a ~a" `(,instance ,kind ,export)))))

(define (find-info [instance datum] [kind datum] [export datum]) -> datum
  (let ([m (instance-unit instance)] [index (ptr hash-table) 0])
    (when (== m 0) (return 0))
    (set! index (cast (ptr hash-table) (hash-ref (& definition-indexes) (cast u64 m))))
    (when (== index 0)
      (let ([saved (use-arena (& run-arena))] [infos (-> (unit-of m) infos)])
        (set! index (make-table))
        (while (pair? infos)
          (let ([info (car infos)])
            (hash-set! index (definition-key (info-instance info) (info-kind info) (info-export info)) (cast u32 info)))
          (set! infos (cdr infos)))
        (use-arena saved))
      (hash-set! (& definition-indexes) (cast u64 m) (cast u32 index)))
    (cast datum (hash-ref index (definition-key instance kind export)))))

(define (running-definition [kind datum] [export datum] [path datum]) -> datum
  (let* ([m (if (== path 0) running-syntax (running-copy path))] [p (assq (symbol-of export) (-> (unit-of m) provides))])
    (unless (and (!= p 0) (== (car (cdr p)) kind))
      (fail-at 0 "the cache is inconsistent: the running ~a has no ~a ~a" `(,(-> (unit-of m) path) ,kind ,export)))
    (cadr (cdr p))))

(define (running-ref [info datum]) -> datum
  (let ([m (running-copy-of (info-instance info))])
    (if (== m 0)
        `(running ,(info-kind info) ,(info-export info))
        `(running ,(info-kind info) ,(info-export info) ,(-> (unit-of m) path)))))

;; ---- writing to the cache ----

(define writing datum 0)
(define own-numbers (ptr hash-table) 0)
(define own-list datum 0)
(define own-count u32 0)

(define (cache-form [m datum]) -> datum
  (let ([u (unit-of m)] [infos datum 0])
    (set! writing m)
    (set! own-numbers (make-table))
    (set! own-list nil)
    (set! own-count 0)
    (for-each (lambda ([info datum]) (own-ref info)) (reverse (-> u infos)))
    (let* ([wasm-modules (wasm-module-forms m)]
           [provides (map (lambda ([p datum]) -> datum (cons (car p) (encode (cdr p)))) (-> u provides))]
           [entries (entry-forms m)]
           [own (reverse (-> u infos))]
           [inline-forms (filter-out-false
                     (map (lambda ([f datum]) -> datum
                            (let ([b (cast datum (hash-ref (& inlines) (cast u64 f)))])
                              (if (== b 0)
                                  0
                                  (encode `(,f ,(car b) ,(cadr b) ,(caddr b) ,(cadddr b)
                                            ,(map (lambda ([p datum]) -> datum (car p)) (list-ref b 4)) ,(list-ref b 5)
                                            ,(list-ref b 6))))))
                          own))]
           [macro-forms (filter-out-false
                    (map (lambda ([f datum]) -> datum
                           (if (== (cast datum (hash-ref (& macro-modules) (cast u64 f))) m) (encode (list1 f)) 0))
                         own))]
           [fact-forms (map (lambda ([f datum]) -> datum `(,(encode (car f)) ,(cadr f) ,(encode (caddr f))))
                       (reverse (-> u facts)))]
           [require-forms (map (lambda ([r datum]) -> datum
                            `(,(-> (unit-of (car r)) path) ,(-> (unit-of (car r)) hash) ,(cdr r)))
                          (-> u requires))])
      (set! infos (map (lambda ([info datum]) -> datum (encode (info->list info))) (reverse own-list)))
      (set! writing 0)
      `((format . ,(make-integer cache-format)) (compiler . ,compiler-hash) (hash . ,(-> u hash))
        (definitions . ,(make-integer (length (-> u infos)))) (requires . ,require-forms) (name . ,(-> u name))
        (infos . ,infos) (provides . ,provides) (entries . ,entries)
        (inlines . ,inline-forms) (macros . ,macro-forms) (facts . ,fact-forms) (wasm-modules . ,wasm-modules)
        (memories . ,(-> u memories))))))

(define (filter-out-false [l datum]) -> datum (filter (lambda ([x datum]) -> bool (!= x 0)) l))

(define (wasm-module-forms [m datum]) -> datum
  (let ([l (-> (unit-of m) wasm-modules)] [out nil])
    (while (!= l 0)
      (set! out (cons `(,(make-integer (-> l phase)) ,(-> l bytes) ,(-> l imports)
                        ,(map (lambda ([sc datum]) -> datum (scope-ref (cast u32 (integer-value sc)))) (-> l scopes)))
                      out))
      (set! l (-> l next)))
    (sort out (lambda ([a datum] [b datum]) -> bool (< (integer-value (car a)) (integer-value (car b)))))))

(define (entry-forms [m datum]) -> datum
  (let ([e (-> (unit-of m) entries)] [out nil])
    (while (!= e 0)
      (set! out (cons `(,(-> e symbol) ,(scope-refs (-> e scopes)) ,(make-integer (-> e phase)) ,(encode (-> e binding meaning)))
                      out))
      (set! e (-> e next)))
    out))

(define (tag-symbol? [x datum]) -> bool (or (object-tag? x) (== x '%quote)))
(define (object-tag? [x datum]) -> bool (or (== x '%info) (== x '%syntax)))

(define (encode [x datum]) -> datum
  (cond [(pair? x)
         (let ([head nil] [last datum 0] [l x] [p datum 0])
           (while (pair? l)
             (set! p (if (tag-symbol? (car l)) `(%quote ,(car l)) (list1 (encode (car l)))))
             (if (== last 0) (set! head p) (set-cdr! last p))
             (set! last (if (pair? (cdr p)) (cdr p) p))
             (set! l (cdr l)))
           (set-cdr! last (encode l))
           head)]
        [(syntax? x)
         `(%syntax ,(encode (syntax-e x)) ,(scope-refs (syntax-scopes x)) ,(srcloc-form (syntax-srcloc x))
                   ,(encode (syntax-props x)))]
        [(or (func-info? x) (global-info? x) (tag-info? x)) (cons '%info (info-ref x))]
        [else x]))

(define (srcloc-form [l (ptr srcloc)]) -> datum
  (if (== l 0)
      0
      `(,(-> l source) ,(make-integer (-> l line)) ,(make-integer (-> l col)) ,(make-integer (-> l pos))
        ,(make-integer (-> l span)))))

(define (info-ref [info datum]) -> datum
  (let ([origin (cast datum (hash-ref (& shift-origins) (cast u64 info)))] [instance (info-instance info)] [owner datum 0])
    (cond [(!= origin 0) `(shifted ,(encode (car origin)) ,(cdr origin))]
          [(running-definition? info) (running-ref info)]
          [else
           (set! owner (if (string? instance) (instance-unit instance) 0))
           (if (and (!= owner 0) (!= owner writing))
               `(foreign ,instance ,(info-kind info) ,(info-export info))
               (own-ref info))])))

(define (own-ref [info datum]) -> datum
  (let ([i (hash-ref own-numbers (cast u64 info))])
    (when (== i 0)
      (set! own-list (cons info own-list))
      (+= own-count 1)
      (set! i own-count)
      (hash-set! own-numbers (cast u64 info) i))
    `(own ,(make-integer (- i 1)))))

(define (info->list [info datum]) -> datum
  (cond [(func-info? info)
         `(func ,(func-info-name info) ,(func-info-params info) ,(func-info-results info) ,(func-info-instance info)
                ,(func-info-export info) ,(make-integer (func-info-place info)))]
        [(global-info? info)
         `(global ,(global-info-name info) ,(global-info-type info) ,(global-info-mutable? info) ,(global-info-instance info)
                  ,(global-info-export info))]
        [else `(tag ,(tag-info-name info) ,(tag-info-params info) ,(tag-info-instance info) ,(tag-info-export info))]))

(define (list->info [l datum]) -> datum
  (case (car l)
    [('func)
     (let ([f (func-info (list-ref l 1) (list-ref l 2) (list-ref l 3) (list-ref l 4) (list-ref l 5))])
       (set-func-info-place! f (cast i32 (integer-value (list-ref l 6))))
       f)]
    [('global) (global-info (list-ref l 1) (list-ref l 2) (list-ref l 3) (list-ref l 4) (list-ref l 5))]
    [else (tag-info (list-ref l 1) (list-ref l 2) (list-ref l 3) (list-ref l 4))]))

(define (scope-ref [sc u32]) -> datum
  (let ([origin (scope-origin sc)] [owner (cast datum (hash-ref (& scope-owners) (scope-key sc)))])
    (cond [(== sc core-scope) 'core]
          [(== sc wasm-scope) 'wasm]
          [(!= origin 0) `(m ,(-> (unit-of (car origin)) hash) ,(cdr origin))]
          [(!= owner 0) `(s ,(-> (unit-of owner) hash) ,(make-integer (hash-ref (& scope-numbers) (scope-key sc))))]
          [else (fail-at 0 "internal: scope ~a belongs to no module" (list1 (make-integer sc))) 0])))

(define (scope-refs [s (ptr scope-set)]) -> datum
  (let ([out nil])
    (for ([i u32 0]) (< i (-> s count)) (+= i 1) (set! out (cons (scope-ref (@ (-> s ids) i)) out)))
    (sort out (lambda ([a datum] [b datum]) -> bool (scope-ref<? a b)))))

(define (scope-ref<? [a datum] [b datum]) -> bool
  (let ([ra (scope-ref-rank a)] [rb (scope-ref-rank b)])
    (cond [(!= ra rb) (< ra rb)]
          [(>= ra 2) #f]
          [else
           (let ([c (string-compare (cadr a) (cadr b))])
             (or (< c 0) (and (== c 0) (< (integer-value (caddr a)) (integer-value (caddr b))))))])))

(define (scope-ref-rank [r datum]) -> i32
  (cond [(== r 'core) 2] [(== r 'wasm) 3] [(== (car r) 'm) 0] [else 1]))

(define (string-compare [a datum] [b datum]) -> i32
  (let ([s (datum->string a)] [t (datum->string b)]) (cond [(< s t) -1] [(> s t) 1] [else 0])))

;; ---- loading from the cache ----

(define loading datum 0)
(define loaded-infos (ptr datum) 0)

(define (zeroed-array [n u32]) -> (ptr datum)
  (let ([a (cast (ptr datum) (arena-alloc (current-arena) (* 4 (+ n 1))))])
    (for ([i u32 0]) (< i n) (+= i 1) (set! (@ a i) 0))
    a))

(define (load-module! [m datum] [d datum])
  (let* ([u (unit-of m)] [infos (section d 'infos)] [ni (length infos)]
         [definitions (cast u32 (integer-value (section d 'definitions)))])
    (set! (-> u name) (keep (section d 'name)))
    (set! (-> u hash) (keep (section d 'hash)))
    (hash-set! (& units-by-hash) (cast u64 (symbol-of (-> u hash))) (cast u32 m))
    (set! (-> u scope) (new-run-scope!))
    (hash-set! (& module-scope-origins) (scope-key (-> u scope)) (cast u32 (keep (cons m (make-integer 0)))))
    (set! loading m)
    (set! loaded-infos (zeroed-array ni))
    (for-each (lambda ([l datum])
                (let ([phase (cast i32 (integer-value (car l)))])
                  (add-wasm-module! m phase `(,(cadr l) ,(caddr l)
                                          ,(map (lambda ([r datum]) -> datum (make-integer (scope-at r))) (cadddr l))))
                  (wasm-module-name m phase 0)))
              (section d 'wasm-modules))
    (for ([i u32 0]) (< i ni) (+= i 1)
      (let ([info (list->info (decode (car infos)))])
        (set! (@ loaded-infos i) info)
        (when (< i definitions) (set! (-> u infos) (keep-cons info (-> u infos)))))
      (set! infos (cdr infos)))
    (for-each (lambda ([e datum])
                (let* ([scopes (scope-set-of (cadr e))] [phase (cast i32 (integer-value (caddr e)))]
                       [b (bind-raw! (car e) scopes phase (decode (cadddr e)))]
                       [me (cast (ptr module-entry) (arena-alloc (& run-arena) (sizeof module-entry)))])
                  (set! (-> me symbol) (car e))
                  (set! (-> me scopes) scopes)
                  (set! (-> me phase) phase)
                  (set! (-> me binding) b)
                  (set! (-> me next) (-> u entries))
                  (set! (-> u entries) me)))
              (section d 'entries))
    (set! (-> u provides) (keep (map (lambda ([p datum]) -> datum (cons (car p) (decode (cdr p)))) (section d 'provides))))
    (for-each (lambda ([v datum]) (load-inline! (decode v))) (section d 'inlines))
    (set! (-> u memories) (keep (section d 'memories)))
    (for-each (lambda ([g datum]) (hash-set! (& macro-modules) (cast u64 (decode (car g))) (cast u32 m)))
              (section d 'macros))
    (let ([facts (map (lambda ([f datum]) -> datum (decode f)) (section d 'facts))])
      (set! (-> u facts) (keep (reverse facts)))
      (for-each (lambda ([f datum]) (index-fact! m f)) (reverse (-> u facts))))
    (set! loading 0)
    (set! (-> u state) 'done)
    (install-module-bindings! m 0)))

(define (load-inline! [x datum])
  (let* ([saved (use-arena (& run-arena))] [params (keep (cadr x))]
         [assigned (filter (lambda ([p datum]) -> bool (!= (member (car p) (list-ref x 5)) 0)) params)]
         [b `(,params ,(keep (caddr x)) ,(keep (cadddr x)) ,(list-ref x 4) ,assigned ,(list-ref x 6) ,(list-ref x 7))])
    (use-arena saved)
    (hash-set! (& inlines) (cast u64 (car x)) (cast u32 b))))

(define (decode [x datum]) -> datum
  (if (not (pair? x))
      x
      (case (car x)
        [('%info) (info-at (cdr x))]
        [('%syntax)
         (make-syntax (decode (cadr x)) (scope-set-of (caddr x)) (srcloc-of (cadddr x)) (decode (list-ref x 4)))]
        [else
         (let ([head nil] [last datum 0] [l x] [p datum 0])
           (while (and (pair? l) (not (object-tag? (car l))))
             (if (== (car l) '%quote)
                 (begin (set! p (list1 (cadr l))) (set! l (cddr l)))
                 (begin (set! p (list1 (decode (car l)))) (set! l (cdr l))))
             (if (== last 0) (set! head p) (set-cdr! last p))
             (set! last p))
           (set-cdr! last (decode l))
           head)])))

(define (srcloc-of [d datum]) -> (ptr srcloc)
  (if (== d 0)
      0
      (make-srcloc (car d) (cast u32 (integer-value (cadr d))) (cast u32 (integer-value (caddr d)))
                   (cast u32 (integer-value (cadddr d))) (cast u32 (integer-value (list-ref d 4))))))

(define (info-at [r datum]) -> datum
  (case (car r)
    [('own) (@ loaded-infos (cast u32 (integer-value (cadr r))))]
    [('shifted) (shift-info (decode (cadr r)) (cast u32 (integer-value (caddr r))))]
    [('running) (running-definition (cadr r) (caddr r) (if (pair? (cdddr r)) (cadddr r) 0))]
    [else
     (let ([info (find-info (cadr r) (caddr r) (cadddr r))])
       (when (== info 0)
         (fail-at 0 "the cache is inconsistent: no ~a ~a in ~a" `(,(caddr r) ,(cadddr r) ,(cadr r))))
       info)]))

(define (scope-at [r datum]) -> u32
  (cond [(== r 'core) core-scope]
        [(== r 'wasm) wasm-scope]
        [(== (car r) 'm) (module-scope-at (unit-with-hash (cadr r)) (cast u32 (integer-value (caddr r))))]
        [else (unit-scope-at (unit-with-hash (cadr r)) (cast u32 (integer-value (caddr r))))]))

(define (scope-set-of [refs datum]) -> (ptr scope-set)
  (let ([s no-scopes])
    (while (pair? refs)
      (set! s (scopes-change s (scope-at (car refs)) 0))
      (set! refs (cdr refs)))
    s))

;; ---- module bodies ----

(define (core-head [s datum] [phase i32]) -> datum
  (if (and (syntax? s) (pair? (syntax-e s)) (identifier? (car (syntax-e s))))
      (let ([m (meaning-of (car (syntax-e s)) phase)])
        (if (and (!= m 0) (== (car m) 'core)) (cadr m) 0))
      0))

(define (head-expand [s datum] [phase i32]) -> datum
  (let* ([head (cond [(identifier? s) s]
                     [(and (syntax? s) (pair? (syntax-e s)) (identifier? (car (syntax-e s)))) (car (syntax-e s))]
                     [else 0])]
         [t (if (!= head 0) (transformer-of (meaning-of head phase)) 0)])
    (if (and (!= t 0) (not (and (form-value? t) (!= (shape-of t s phase) 0))))
        (head-expand (apply-macro head t s phase #t) phase)
        s)))

(struct body [phase i32] [syntax bool] [items datum] [pass2 bool] [lifted datum])

(define current-body (ptr body) 0)

(define (expand-body [forms datum] [phase i32]) -> datum
  (let ([b (cast (ptr body) (arena-alloc (current-arena) (sizeof body)))] [saved current-body] [out datum 0])
    (set! (-> b phase) phase)
    (set! (-> b syntax) to-syntax)
    (set! (-> b items) nil)
    (set! (-> b pass2) #f)
    (set! (-> b lifted) nil)
    (set! current-body b)
    (try (for-each (lambda ([f datum]) (declare-form! f b 0)) forms)
         (set! out (finish-body! b))
         [catch-all (set! current-body saved) (rethrow)])
    (set! current-body saved)
    out))

(define (finish-body! [b (ptr body)]) -> datum
  (set! (-> b pass2) #t)
  (let ([items (reverse (-> b items))] [out nil] [item-out datum 0] [lifted datum 0])
    (while (pair? items)
      (set! (-> b lifted) nil)
      (set! item-out (expand-item (car items) (-> b phase)))
      (set! lifted (reverse (-> b lifted)))
      (while (pair? lifted)
        (set! out (append (reverse (car lifted)) out))
        (set! lifted (cdr lifted)))
      (set! out (append (reverse item-out) out))
      (set! items (cdr items)))
    (reverse out)))

(define (item! [b (ptr body)] [x datum]) (set! (-> b items) (cons x (-> b items))))

(define (declare-form! [f0 datum] [b (ptr body)] [only datum])
  (let* ([phase (-> b phase)] [f (head-expand f0 phase)] [kind (core-head f phase)])
    (when (and (!= only 0)
               (!= (memq kind '(require require-unqualified language provide memory table define-syntax begin-for-syntax)) 0))
      (fail-at f "~a (~a ...), but only func, global, import, tag, data and #%fact forms and expressions are allowed there"
               `(,only ,kind)))
    (case kind
      [('begin)
       (let ([forms (cdr (form-list f "(begin form ...)"))])
         (for-each (lambda ([g datum]) (declare-form! (at-use f g) b only)) forms))]
      [('require) (require! f phase 0)]
      [('require-unqualified) (require! f phase 1)]
      [('language) (if (in-session?) (require! f phase 2) (fail-at f "the language must be the module's first form" nil))]
      [('provide) (provide! f phase)]
      [('func) (item! b (declare-func f phase))]
      [('global) (item! b (declare-global f phase))]
      [('import) (item! b (declare-import f phase))]
      [('supply) (item! b `(supply ,f))]
      [('memory 'table) (declare-storage! f kind phase)]
      [('tag) (item! b (declare-tag f phase))]
      [('define-syntax) (define-syntax! f phase)]
      [('begin-for-syntax) (begin-for-syntax! f phase)]
      [('#%fact) (item! b `(done ,(fact! f phase) ()))]
      [else
       (if (and (in-session?) (== phase 0) (== only 0) (not interacting))
           (interact! f0 f b)
           (item! b `(expr ,f)))])))

(define (lift! [form datum] [where datum] [phase i32])
  (let ([b current-body] [before datum 0] [new nil] [l datum 0] [saved to-syntax])
    (unless (and (!= b 0) (== (-> b phase) phase))
      (fail-at where "syntax-local-lift-definition: no module body is being expanded at phase ~a" (list1 (make-integer phase))))
    (set! before (-> b items))
    (declare-form! form b '"syntax-local-lift-definition was given")
    (when (-> b pass2)
      (set! l (-> b items))
      (while (!= l before)
        (set! new (cons (car l) new))
        (set! l (cdr l)))
      (set! (-> b items) before)
      (set! to-syntax (-> b syntax))
      (try (while (pair? new)
             (set! (-> b lifted) (cons (expand-item (car new) phase) (-> b lifted)))
             (set! new (cdr new)))
           [catch-all (set! to-syntax saved) (rethrow)])
      (set! to-syntax saved))))

(define (form-list [f datum] [patterns string]) -> datum
  (let ([l (syntax->list f)])
    (if (== l 0) (no-match f patterns) l)))

(define (expand-item [item datum] [phase i32]) -> datum
  (case (car item)
    [('func) (expand-func item phase)]
    [('global) (expand-global item phase)]
    [('plain 'done) (if to-syntax (list1 (cadr item)) (caddr item))]
    [('supply) (expand-supply (cadr item) phase)]
    [else
     (let* ([e (cadr item)]
            [r (if (or to-syntax (== (core-head e phase) '#%checked)) (expand-expr e phase) (core-expression e phase))])
       (if to-syntax (list1 r) (list1 `(expr ,r))))]))

;; ---- types ----

(define (parse-type [s datum]) -> datum
  (let ([d (syntax-e s)])
    (when (== (memq d '(i32 i64 f32 f64 exnref)) 0)
      (fail-at s "expected a type (i32, i64, f32, f64 or exnref), got ~s" (list1 (syntax->datum s))))
    d))

(define (named? [x datum] [name datum]) -> bool (and (identifier? x) (== (syntax-e x) name)))

;; ---- other module-level forms ----

(define (string-literal? [s datum]) -> bool (string? (syntax-e s)))
(define (count-literal? [s datum]) -> bool
  (let ([n (syntax-e s)]) (and (integer? n) (>= (integer-value n) 0) (< (integer-value n) 1073741824))))

(define (parse-results [body datum]) -> datum
  (cond [(and (pair? body) (named? (car body) '->) (pair? (cdr body)))
         (let ([l (syntax->list (cadr body))])
           (cons (if (!= l 0) (map (lambda ([x datum]) -> datum (parse-type x)) l) (list1 (parse-type (cadr body))))
                 (cddr body)))]
        [(and (pair? body) (named? (car body) '->)) (fail-at (car body) "expected a type after ->" nil)]
        [else (cons nil body)]))

(define (parse-signature [s datum]) -> datum
  (let ([l (syntax->list s)] [params nil])
    (when (or (== l 0) (not (ormap (lambda ([t datum]) -> bool (named? t '->)) l)))
      (fail-at s "expected a signature (type ... -> type ...)" nil))
    (while (not (named? (car l) '->))
      (set! params (cons (car l) params))
      (set! l (cdr l)))
    (cons (map (lambda ([t datum]) -> datum (parse-type t)) (reverse params))
          (map (lambda ([t datum]) -> datum (parse-type t)) (cdr l)))))

(define (declare-func [f datum] [phase i32]) -> datum
  (let* ([l (syntax->list f)] [head (if (and (!= l 0) (>= (length l) 2)) (syntax->list (cadr l)) 0)])
    (unless (and (!= head 0) (pair? head) (identifier? (car head))) (no-match f "(func (name param ...) . body)"))
    (let* ([name (car head)]
           [params (map (lambda ([p datum]) -> datum (param-of p)) (cdr head))]
           [types (map (lambda ([p datum]) -> datum (parse-type (cadr p))) params)]
           [rest (cddr l)]
           [inline (if (and (pair? rest) (!= (memq (syntax-e (car rest)) '(#:inline #:copied)) 0)) (car rest) 0)]
           [rest (if (!= inline 0) (cdr rest) rest)]
           [rb (parse-results rest)]
           [info (func-info (syntax-e name) types (car rb) 0 0)])
      (bind-definition! name phase `(func ,info))
      `(func ,name ,params ,(take rest (- (length rest) (length (cdr rb)))) ,(cdr rb) ,f ,inline ,info))))

(define (param-of [p datum]) -> datum
  (let ([l (syntax->list p)])
    (unless (and (!= l 0) (== (length l) 2) (identifier? (car l))) (no-match p "(name type)"))
    l))

(define in-inline-body bool #f)

(define (expand-func [p datum] [phase i32]) -> datum
  (let* ([name (list-ref p 1)] [params (list-ref p 2)] [arrow (list-ref p 3)] [body (list-ref p 4)]
         [f (list-ref p 5)] [inline (list-ref p 6)] [info (list-ref p 7)]
         [sc (new-local-scope!)]
         [xs (map (lambda ([pp datum]) -> datum (add-scope (car pp) sc)) params)]
         [scoped (map (lambda ([b datum]) -> datum (add-scope b sc)) body)]
         [checked (if (and (pair? scoped) (null? (cdr scoped)) (== (core-head (car scoped) phase) '#%checked)) (car scoped) 0)]
         [box (if (and (!= checked 0) (== (syntax-e (cadr (syntax->list checked))) 'code)) (boxed-code (caddr (syntax->list checked))) 0)]
         [keys (if (and (!= box 0) (not to-syntax)) (car box) (map (lambda ([x datum]) -> datum (bind-local! x phase)) xs))]
         [was in-inline-body]
         [r (begin
              (set! in-inline-body (!= inline 0))
              (try (cond [to-syntax (map (lambda ([b datum]) -> datum (expand-expr b phase)) scoped)]
                         [(!= box 0) (list1 (cdr box))]
                         [(!= checked 0) (list1 (expand-expr checked phase))]
                         [else (list1 (core-body f name xs scoped info phase))])
                   [catch-all (set! in-inline-body was) (rethrow)]))])
    (set! in-inline-body was)
    (if to-syntax
        (let ([ps nil] [x xs] [k keys] [pp params])
          (while (pair? x)
            (set! ps (cons (out-list (car x) `(,(with-local-binding (car x) (car k)) ,(cadr (car pp)))) ps))
            (set! x (cdr x)) (set! k (cdr k)) (set! pp (cdr pp)))
          (list1 (out f 'func
                      `(,(out-list (cadr (syntax->list f)) (cons name (reverse ps)))
                        ,@(if (!= inline 0) (list1 inline) nil) ,@arrow
                        ,@r))))
        (let ([ps nil] [k keys] [types (func-info-params info)] [code (seq-at f r)])
          (while (pair? k)
            (set! ps (cons (cons (car k) (car types)) ps))
            (set! k (cdr k)) (set! types (cdr types)))
          (set! ps (reverse ps))
          (when (!= inline 0) (note-inline! info ps code name (== (syntax-e inline) '#:copied)))
          (list1 `(func ,info ,ps ,code))))))

(define (declare-global [f datum] [phase i32]) -> datum
  (let ([l (syntax->list f)])
    (unless (and (!= l 0) (== (length l) 4) (identifier? (cadr l))) (no-match f "(global name type init)"))
    (let* ([name (cadr l)] [xt (caddr l)] [xl (syntax->list xt)]
           [info (if (and (!= xl 0) (== (length xl) 2) (named? (car xl) 'mut))
                     (global-info (syntax-e name) (parse-type (cadr xl)) (boolean #t) 0 0)
                     (global-info (syntax-e name) (parse-type xt) '#f 0 0))])
      (bind-definition! name phase `(global ,info))
      `(global ,f ,xt ,info))))

(define (expand-global [p datum] [phase i32]) -> datum
  (let* ([l (syntax->list (cadr p))] [init (cadddr l)]
         [r (if (or to-syntax (== (core-head init phase) '#%checked))
                (expand-expr init phase)
                (core-value (cadr l) (global-info-type (cadddr p)) init (cadr p) phase))])
    (if to-syntax
        (list1 (out (cadr p) 'global `(,(cadr l) ,(caddr p) ,r)))
        (list1 `(global ,(cadddr p) ,r)))))

(define (declare-import [f datum] [phase i32]) -> datum
  (let ([l (syntax->list f)])
    (unless (and (!= l 0) (== (length l) 5) (identifier? (cadr l)) (string-literal? (caddr l)) (string-literal? (cadddr l)))
      (no-match f "(import name module field signature)"))
    (let* ([name (cadr l)] [module (caddr l)] [field (cadddr l)] [sig (list-ref l 4)] [pr (parse-signature sig)])
      (bind-definition! name phase `(func ,(func-info (syntax-e name) (car pr) (cdr pr) (syntax-e module) (syntax-e field))))
      `(plain ,(out f 'import `(,name ,module ,field ,sig)) ()))))

;; (supply c-function f): c-function, which its C module calls by name, calls f, through the slot in the module's
;; global supply:name, set when this module starts; then the C module's supplied! runs its constructors if every slot
;; is set.
(define (expand-supply [f datum] [phase i32]) -> datum
  (let* ([l (syntax->list f)] [c datum 0] [g datum 0] [slot datum 0])
    (unless (and (!= l 0) (== (length l) 3) (identifier? (cadr l)) (identifier? (caddr l)))
      (no-match f "(supply c-function function)"))
    (set! c (meaning-of (cadr l) phase))
    (set! g (meaning-of (caddr l) phase))
    (unless (and (!= c 0) (== (car c) 'func)) (fail-at (cadr l) "~a is not a function" (list1 (syntax-e (cadr l)))))
    (unless (and (!= g 0) (== (car g) 'func)) (fail-at (caddr l) "~a is not a function" (list1 (syntax-e (caddr l)))))
    (set! slot (supply-slot (cadr c)))
    (when (== slot 0)
      (fail-at (cadr l) "~a is not a function its module calls by name" (list1 (syntax-e (cadr l)))))
    (let ([owner (identity-label (-> (unit-of (instance-unit (func-info-instance (cadr c)))) path))])
      (unless (equal? owner (identity-label (-> (the-module) path)))
        (fail-at (cadr l) "~a is supplied only in ~a" `(,(syntax-e (cadr l)) ,owner))))
    (unless (equal? (signature-of (cadr c)) (signature-of (cadr g)))
      (fail-at f "~a is ~s, but ~a is ~s"
               `(,(syntax-e (cadr l)) ,(signature-of (cadr c)) ,(syntax-e (caddr l)) ,(signature-of (cadr g)))))
    (if to-syntax
        (list1 f)
        (cons `(expr (gset ,slot (func-index ,(cadr g)))) (list1 `(expr (call ,(supplied-of (cadr c)) ())))))))

(define (signature-of [info datum]) -> datum (append (func-info-params info) (cons '-> (func-info-results info))))

;; supply-slot gives the global supply:name of the module providing the function info, when it calls it by name.
(define (supply-slot [info datum]) -> datum
  (let* ([instance (func-info-instance info)] [owner (if (string? instance) (instance-unit instance) 0)]
         [export (format "supply:~a" (list1 (func-info-export info)))]
         [l (if (== owner 0) nil (-> (unit-of owner) infos))])
    (while (pair? l)
      (when (and (global-info? (car l)) (equal? (global-info-export (car l)) export)) (return (car l)))
      (set! l (cdr l)))
    0))

;; supplied-of gives the function supplied! of the module providing the function info.
(define (supplied-of [info datum]) -> datum
  (let ([l (-> (unit-of (instance-unit (func-info-instance info))) infos)])
    (while (pair? l)
      (when (and (func-info? (car l)) (equal? (func-info-export (car l)) '"supplied!")) (return (car l)))
      (set! l (cdr l)))
    (fail-at 0 "internal: no supplied! in the module of ~a" (list1 (func-info-export info)))
    0))

(define (declare-tag [f datum] [phase i32]) -> datum
  (let ([l (syntax->list f)])
    (unless (and (!= l 0) (== (length l) 3) (identifier? (cadr l)) (syntax? (caddr l)) (!= (syntax->list (caddr l)) 0))
      (no-match f "(tag name (type ...))"))
    (let ([info (tag-info (syntax-e (cadr l)) (map (lambda ([t datum]) -> datum (parse-type t)) (syntax->list (caddr l))) 0 0)])
      (bind-definition! (cadr l) phase `(tag ,info))
      `(plain ,(out f 'tag `(,(cadr l) ,(caddr l))) ((tag ,info))))))

;; ---- require, provide, storage ----

;; all is 0 for require, 1 for require-unqualified and 2 for language.
(define (require! [f datum] [phase i32] [all i32])
  (let ([l (syntax->list f)])
    (if all
        (unless (and (!= l 0) (== (length l) 3) (identifier? (cadr l)) (module-source? (caddr l)))
          (no-match f (if (== all 2) "(language name source)" "(require-unqualified name source)")))
        (unless (and (!= l 0) (>= (length l) 3) (identifier? (cadr l)) (module-source? (caddr l)))
          (no-match f "(require name source item ...)")))
    (let* ([name (cadr l)] [source (caddr l)]
           [provided (require-module! f name source phase)])
      (when (and (== all 1) (not (in-session?)) (!= (assq '#%module-begin provided) 0))
        (fail-at f "~a is a language: a module is in it when its first form is (language ~a ~s)"
                 `(,(syntax-e source) ,(syntax-e name) ,(syntax-e source))))
      (for-each (lambda ([p datum]) (bind-import! (qualified name (car p)) phase (cdr p))) provided)
      (when all
        (for-each (lambda ([p datum])
                    (hash-set! (& unqualified-imports)
                               (cast u64 (bind-import! (datum->syntax name (car p) name) phase (cdr p)))
                               1))
                  provided))
      (let ([items (cdddr l)])
        (while (pair? items)
          (let* ([item (car items)] [il (syntax->list item)]
                 [names (cond [(identifier? item) (cons item item)]
                              [(and (!= il 0) (== (length il) 2) (identifier? (car il)) (identifier? (cadr il))) (cons (car il) (cadr il))]
                              [else (no-match item "name or (new-name name)")])]
                 [old (cdr names)]
                 [ps (filter (lambda ([p datum]) -> bool (== (car p) (syntax-e old))) provided)])
            (when (null? ps) (fail-at old "~a does not provide ~a" `(,(syntax-e source) ,(syntax-e old))))
            (for-each (lambda ([p datum]) (bind-import! (car names) phase (cdr p))) ps))
          (set! items (cdr items)))))))

(define (module-source? [s datum]) -> bool (or (string-literal? s) (identifier? s)))

(define (qualified [name datum] [sym datum]) -> datum
  (datum->syntax name (string->symbol (format-message "~a:~a" `(,(syntax-e name) ,sym))) name))

(define (bind-import! [id0 datum] [phase i32] [meaning datum]) -> (ptr binding)
  (let ([id (session-binding-id id0 phase meaning)])
    (check-unbound! id phase meaning)
    (bind-module-level! (syntax-e id) (syntax-scopes id) phase meaning)))

(define (symbol<? [a datum] [b datum]) -> bool (< (symbol->string a) (symbol->string b)))

;; module-path-of gives the identity of the module a require's source names: a name, or a path from the module it was
;; written in. Syntax with no place names an identity itself, as the language's own require does.
(define (module-path-of [f datum] [spec datum]) -> datum
  (let* ([loc (if (!= (syntax-srcloc spec) 0) (syntax-srcloc spec) (syntax-srcloc f))]
         [from (if (!= loc 0) (string->datum (symbol->string (-> loc source))) 0)]
         [given (syntax-e spec)])
    (cond [(identifier? spec) (name-identity spec from)]
          [(!= from 0) (path-identity spec from given)]
          [(absolute-path? given) (entry-identity 0 given)]
          [else (resolve-segments given)])))

(define (require-module! [f datum] [name datum] [spec datum] [phase i32]) -> datum
  (let ([path (module-path-of f spec)])
    (require-unit! name
                   (if (and (> phase 0) (not (in-session?)) (equal? path (-> (the-module) path)))
                       (running-copy path)
                       (module-at path spec))
                   phase)))

(define (require-unit! [name datum] [m datum] [phase i32]) -> datum
  (let* ([me (the-module)] [key (cons (syntax-e name) (make-integer phase))]
         [named (assoc key (-> current require-names))] [req (cons m (make-integer phase))])
    (when (and (!= named 0) (!= (cdr named) m))
      (fail-at name "~a already names another module at this phase" (list1 (syntax-e name))))
    (when (== named 0) (set! (-> current require-names) (cons (cons key m) (-> current require-names))))
    (when (== (member req (-> me requires)) 0)
      (set! (-> me requires) (keep (append (-> me requires) (list1 req))))
      (install-module-bindings! m (cast u32 phase)))
    (map (lambda ([p datum]) -> datum (cons (car p) (shift-meaning (cdr p) (cast u32 phase)))) (-> (unit-of m) provides))))

(define (required-module [name datum] [phase i32]) -> datum
  (let ([named (if (identifier? name) (assoc (cons (syntax-e name) (make-integer phase)) (-> current require-names)) 0)])
    (when (== named 0) (fail-at name "~s is not the name of a module required at this phase" (list1 (syntax->datum name))))
    (cdr named)))

(define (provide! [f datum] [phase i32])
  (unless (== phase 0) (fail-at f "provide belongs at phase 0" nil))
  (let ([l (syntax->list f)] [items nil])
    (when (== l 0) (no-match f "(provide item ...)"))
    (for-each (lambda ([item datum]) (set! items (append items (provide-items item)))) (cdr l))
    (for-each (lambda ([item datum])
                (let ([earlier (let ([ids (-> current provide-ids)] [found datum 0])
                                 (while (and (pair? ids) (== found 0))
                                   (when (== (syntax-e (car (car ids))) (syntax-e (car item))) (set! found (car ids)))
                                   (set! ids (cdr ids)))
                                 found)])
                  (when (and (!= earlier 0) (!= (syntax-e (cdr earlier)) (syntax-e (cdr item))))
                    (fail-at (car item) "~a is provided twice, for ~a and for ~a"
                             `(,(syntax-e (car item)) ,(syntax-e (cdr earlier)) ,(syntax-e (cdr item)))))
                  (set! (-> current provide-ids) (cons item (-> current provide-ids)))))
              items)))

(define (provide-items [item datum]) -> datum
  (let ([l (syntax->list item)])
    (cond [(identifier? item) (list1 (cons item item))]
          [(and (!= l 0) (== (length l) 2) (named? (car l) 'all-from-out)) (all-from-items (cadr l) nil)]
          [(and (!= l 0) (>= (length l) 2) (named? (car l) 'except-out)
                (let ([inner (syntax->list (cadr l))]) (and (!= inner 0) (== (length inner) 2) (named? (car inner) 'all-from-out)))
                (andmap (lambda ([x datum]) -> bool (identifier? x)) (cddr l)))
           (all-from-items (cadr (syntax->list (cadr l))) (cddr l))]
          [(and (!= l 0) (== (length l) 2) (identifier? (car l)) (identifier? (cadr l))) (list1 (cons (car l) (cadr l)))]
          [(and (!= l 0) (== (length l) 1) (named? (car l) 'all-wasm-forms))
           (map (lambda ([name datum]) -> datum (cons (datum->syntax item name item) (make-syntax name core-scopes 0 nil)))
                (append '(func global) (append wasm-forms (prim-names))))]
          [else (no-match item "name, (all-from-out module), (except-out (all-from-out module) name ...), (new-name name) or (all-wasm-forms)")])))

(define (all-from-items [name datum] [excluded datum]) -> datum
  (let* ([m (unit-of (required-module name 0))] [out (map (lambda ([x datum]) -> datum (syntax-e x)) excluded)]
         [syms nil] [ps (-> m provides)])
    (while (pair? ps)
      (when (== (memq (car (car ps)) syms) 0) (set! syms (cons (car (car ps)) syms)))
      (set! ps (cdr ps)))
    (for-each (lambda ([x datum])
                (when (== (memq (syntax-e x) syms) 0) (fail-at x "~a does not provide ~a" `(,(syntax-e name) ,(syntax-e x)))))
              excluded)
    (map (lambda ([sym datum]) -> datum (cons (datum->syntax name sym name) (qualified name sym)))
         (filter (lambda ([sym datum]) -> bool (== (memq sym out) 0)) (reverse syms)))))

(define (declare-storage! [f datum] [kind datum] [phase i32])
  (let* ([l (syntax->list f)] [memory (== kind 'memory)]
         [form (cond [(and (== (length l) 2) (count-literal? (cadr l))) `(,kind ,(syntax-e (cadr l)))]
                     [(and (== (length l) 3) (named? (cadr l) 'from))
                      `(,(imported-kind kind) ,(wasm-module-name (required-module (caddr l) phase) 0 phase))]
                     [(and (== (length l) 4) (equal? (syntax-e (cadr l)) (make-integer 1)) (named? (caddr l) 'from))
                      `(,(second-kind kind) ,(wasm-module-name (required-module (cadddr l) phase) 0 phase))]
                     [else (no-match f (if memory
                                           "(memory size), (memory from module) or (memory 1 from module)"
                                           "(table size), (table from module) or (table 1 from module)"))])])
    (when (or (!= (declared-storage kind phase (car form)) 0)
              (and (== (car form) kind) (!= (declared-storage kind phase (second-kind kind)) 0))
              (and (== (car form) (second-kind kind)) (!= (declared-storage kind phase kind) 0)))
      (fail-at f "a second ~a declaration at this phase" (list1 kind)))
    (if memory
        (set! (-> current memories) (cons (cons (make-integer phase) form) (-> current memories)))
        (set! (-> current tables) (cons (cons (make-integer phase) form) (-> current tables))))))

(define instance-refs hash-table)

(define (wasm-module-name [m datum] [q i32] [t i32]) -> datum
  (let* ([name (format "~a@~a+~a" `(,(-> (unit-of m) name) ,(make-integer q) ,(make-integer t)))]
         [key (cast u64 (symbol-of name))])
    (when (== (hash-ref (& instance-refs) key) 0)
      (hash-set! (& instance-refs) key (cast u32 (keep `(,m ,(make-integer q) ,(make-integer t))))))
    name))

(define (wasm-module-ref [name datum]) -> datum
  (let ([r (cast datum (hash-ref (& instance-refs) (cast u64 (symbol-of name))))])
    (if (and (!= r 0) (pair? (cddr r))) r 0)))

(define (instance-unit [name datum]) -> datum
  (let ([r (wasm-module-ref name)])
    (cond [(!= r 0) (car r)]
          [(syntax-instance? name) running-syntax]
          [else (running-copy-of name)])))

;; ---- compile-time evaluation ----

(define (next-wasm-module-name! [m datum] [q i32]) -> datum
  (let ([name (format "~a@~a#~a" `(,(-> (unit-of m) name) ,(make-integer q) ,(make-integer (-> current wasm-module-counter))))])
    (+= (-> current wasm-module-counter) 1)
    (hash-set! (& instance-refs) (cast u64 (symbol-of name)) (cast u32 (keep `(,m ,(make-integer q)))))
    name))

(define (ns-name [name datum]) -> datum (format "~a/~a" `(,(-> current ns) ,name)))

(define (namespaced? [name datum]) -> bool
  (and (== (group-instance name) 0) (!= (hash-ref (& instance-refs) (cast u64 (symbol-of name))) 0)))

(define (integer-at [l datum] [n u32]) -> i32 (cast i32 (integer-value (list-ref l n))))

(define (import-map [imports datum] [t u32]) -> datum
  (let ([out nil] [r datum 0] [g datum 0])
    (while (pair? imports)
      (set! g (group-instance (car imports)))
      (set! r (if (!= g 0) 0 (cast datum (hash-ref (& instance-refs) (cast u64 (symbol-of (car imports)))))))
      (cond [(!= g 0) (set! out (cons (cons (car imports) g) out))]
            [(== r 0) 0]
            [(pair? (cddr r))
             (set! out (cons (cons (car imports) (ns-name (wasm-module-name (car r) (integer-at r 1) (+ (integer-at r 2) (cast i32 t))))) out))]
            [else (set! out (cons (cons (car imports) (ns-name (car imports))) out))])
      (set! imports (cdr imports)))
    out))

(define (ensure-import! [imp datum] [shift u32])
  (let ([r (if (!= (group-instance imp) 0) 0 (wasm-module-ref imp))])
    (when (!= r 0) (ensure-wasm-module! (car r) (integer-at r 1) (+ (cast u32 (integer-at r 2)) shift)))))

(define (ensure-wasm-module! [m datum] [q i32] [t u32])
  (let* ([name (ns-name (wasm-module-name m q (cast i32 t)))] [key (cast u64 (symbol-of name))] [p (ptr wasm-module) 0]
         [l nil])
    (when (== (hash-ref (-> current instances) key) 0)
      (set! p (wasm-module-of m q))
      (when (== p 0) (fail-at 0 "internal: ~a has no phase ~a wasm module" `(,(-> (unit-of m) name) ,(make-integer q))))
      (set! l (suppliers-of m))
      (for-each (lambda ([imp datum]) (ensure-import! imp t)) (-> p imports))
      (instantiate! name (-> p bytes) (-> p imports) (-> p scopes) t 0 (>= (+ q (cast i32 t)) 1))
      (hash-set! (-> current instances) key 1)
      (while (pair? l)
        (ensure-wasm-module! (car l) 0 t)
        (set! l (cdr l))))))

(define (instantiate-bytes [name string] [code (slice u8)] [imports (slice string)] [compile-time bool] [err (ptr string)])
  -> bool
  (== (host-instantiate name code imports compile-time err) 0))

(define (instantiate! [name datum] [bytes datum] [imports datum] [scopes datum] [t u32] [where datum] [compile-time bool])
  (let* ([map (import-map imports t)] [n (* 2 (length map))] [pairs (cast (ptr string) (malloc (* n 8)))] [i u32 0] [ok #f]
         [why string])
    (while (pair? map)
      (set! (@ pairs i) (datum->string (car (car map))))
      (set! (@ pairs (+ i 1)) (datum->string (cdr (car map))))
      (+= i 2)
      (set! map (cdr map)))
    (set-scope-map! (slice (scope-map-of scopes t) (length scopes)))
    (try (set! ok (instantiate-bytes (datum->string name) (datum->bytes bytes) (slice pairs n) compile-time
                                     (& why)))
         [catch compile-error (message blamed loc)
          (set-scope-map! 0)
          (free pairs)
          (throw compile-error message blamed loc)])
    (set-scope-map! 0)
    (free pairs)
    (unless ok
      (if session-running
          (fail-at where "~a" (list1 (session-failure (host-error why))))
          (fail-at where "compile-time code failed: ~a" (list1 (host-error why)))))))

(define (scope-map-of [scopes datum] [t u32]) -> (ptr u32)
  (let ([p (cast (ptr u32) (arena-alloc (current-arena) (* 4 (+ (length scopes) 1))))] [i u32 0] [sc u32 0] [o datum 0])
    (while (pair? scopes)
      (set! sc (cast u32 (integer-value (car scopes))))
      (set! o (scope-origin sc))
      (set! (@ p i) (if (!= o 0) (module-scope-at (car o) (+ (cast u32 (integer-value (cdr o))) t)) sc))
      (+= i 1)
      (set! scopes (cdr scopes)))
    p))

(define (host-error [why string]) -> datum
  (let ([s (string->datum why)])
    (free (-> why bytes))
    s))

(define (instantiate-wasm-module! [name datum] [forms datum] [where datum])
  (set-current-source! (module-source))
  (let ([compiled (compile-module forms name)])
    (for-each (lambda ([imp datum]) (ensure-import! imp 0)) (cadr compiled))
    (instantiate! (ns-name name) (car compiled) (cadr compiled) (caddr compiled) 0 where #t)
    (hash-set! (-> current instances) (cast u64 (symbol-of (ns-name name))) 1)))

(define (run-compile-time-wasm-module! [forms datum] [phase i32] [where datum])
  (add-phase-forms! phase forms)
  (let ([name (next-wasm-module-name! (-> current module) phase)])
    (instantiate-wasm-module! name (append (wasm-module-storage-forms phase name) forms) where)))

(define (add-phase-forms! [phase i32] [forms datum])
  (unless (in-session?)
    (let ([e (assoc (make-integer phase) (-> current phase-forms))])
      (if (!= e 0)
          (set-cdr! e (append (reverse forms) (cdr e)))
          (set! (-> current phase-forms) (cons (cons (make-integer phase) (reverse forms)) (-> current phase-forms)))))))

(define (wasm-module-storage-forms [phase i32] [name datum]) -> datum
  (let ([out nil] [kinds '(memory table)] [form datum 0] [owner datum 0])
    (while (pair? kinds)
      (set! form (storage-form (car kinds) phase))
      (set! owner (assoc (cons (car kinds) (make-integer phase)) (-> current storage-wasm-modules)))
      (cond [(== form 0) 0]
            [(!= (car form) (car kinds)) (set! out (cons form out))]
            [(!= owner 0) (set! out (cons `(,(imported-kind (car kinds)) ,(cdr owner)) out))]
            [else
             (set! (-> current storage-wasm-modules) (cons (cons (cons (car kinds) (make-integer phase)) name) (-> current storage-wasm-modules)))
             (set! out (cons form out))])
      (set! kinds (cdr kinds)))
    (append (filter-out-false `(,(substrate-storage 'memory phase) ,(substrate-storage 'table phase))) (reverse out))))

(define (function-index [info datum]) -> i32
  (let* ([instance (func-info-instance info)] [export (func-info-export info)] [target datum 0] [i i32 -1])
    (ensure-import! instance 0)
    (set! target (let ([g (group-instance instance)]) (cond [(!= g 0) g] [(namespaced? instance) (ns-name instance)] [else instance])))
    (set! i (host-export-index (datum->string target) (datum->string export)))
    (when (< i 0) (fail-at 0 "internal: no function ~a in ~a" `(,export ,instance)))
    i))

(define (compile-time-value [getter datum]) -> datum
  (let ([cached (cast datum (hash-ref (-> current values) (cast u64 getter)))] [v datum 0])
    (if (!= cached 0)
        (car cached)
        (let ([f (cast (fn () -> datum) (function-index getter))])
          (set! v (f))
          (hash-set! (-> current values) (cast u64 getter) (cast u32 (cons v nil)))
          v))))

(define (transformer-of [m datum]) -> datum
  (if (and (!= m 0) (== (car m) 'compile-time-value))
      (let ([v (compile-time-value (cadr m))]) (if (or (transformer? v) (form-value? v)) v 0))
      0))

;; A form the compiler implements has the value (#%form kind [env]).
(define (form-value? [v datum]) -> bool
  (and (syntax? v) (pair? (syntax-e v)) (identifier? (car (syntax-e v))) (== (syntax-e (car (syntax-e v))) '#%form)))

(define (form-expansion [v datum] [s datum] [phase i32]) -> datum
  (let ([l (syntax->list v)])
    (substrate-expansion (syntax-e (cadr l)) (if (pair? (cddr l)) (caddr l) 0) s v (& (-> current checking)) phase)))

;; ---- shapes ----

;; 0 for a form that expands to others or is allowed only at module level.
(define (shape-of [v datum] [s datum] [phase i32]) -> datum
  (let ([saved api-phase] [out datum 0])
    (set! api-phase phase)
    (set! out (try (if (symbol? v)
                       (core-shape v s)
                       (substrate-shape (syntax-e (cadr (syntax->list v))) s v (& (-> current checking)) phase))
                   [catch-all (set! api-phase saved) (rethrow)]))
    (set! api-phase saved)
    out))

(define (scope-shape [m datum] [phase i32] [scopes datum]) -> datum
  (let ([ps (pieces-of m)])
    (while (pair? ps)
      (let ([p (car ps)])
        (cond [(== (piece-role p) 'group) (set! scopes (scope-shape p phase scopes))]
              [(!= (piece-region p) 0)
               (let ([known (assoc (cadr p) scopes)])
                 (when (== known 0)
                   (set! known (cons (cadr p) (make-integer (new-local-scope!))))
                   (set! scopes (cons known scopes)))
                 (let ([x (add-scope (piece-syntax p) (cast u32 (integer-value (cdr known))))])
                   (set-car! (cddr p) x)
                   (case (car p)
                     [('binder) (set-cdr! (cddr p) (cons (bind-local! x phase) nil))]
                     [('label) (set-cdr! (cddr p) (cons (fresh-label! x phase) nil))]
                     [else (begin)])))]
              [else (begin)]))
      (set! ps (cdr ps)))
    scopes))

(define (expanded-piece [p datum] [phase i32]) -> datum
  (case (piece-role p)
    [('expr) (expand-expr (piece-syntax p) phase)]
    [('binder) (with-local-binding (piece-syntax p) (cadddr p))]
    [('callee)
     (let* ([f (piece-syntax p)] [m (if (identifier? f) (meaning-of f phase) 0)])
       (if (and (!= m 0) (== (car m) 'func)) f (expand-expr f phase)))]
    [else (piece-syntax p)]))

(define (expand-shape [m datum] [phase i32]) -> datum
  (when (== (piece-role m) 'group) (scope-shape m phase nil))
  (shape-syntax m (for/list ([p (shape-pieces m)]) (expanded-piece p phase))))

(define (query-shape [s datum]) -> datum
  (let* ([e (if (syntax? s) (syntax-e s) 0)] [head (if (pair? e) (car e) 0)]
         [m (if (identifier? head) (meaning-of head api-phase) 0)] [t (transformer-of m)])
    (cond [(and (!= t 0) (form-value? t)) (shape-of t s api-phase)]
          [(and (!= m 0) (or (== (car m) 'core) (== (car m) 'prim))) (shape-of (cadr m) s api-phase)]
          [else 0])))

(define (query-scope-shape [m datum] [remember bool]) -> datum
  (let ([known (if remember (cast datum (hash-ref (-> current scopes) (cast u64 (cadr m)))) 0)])
    (if (!= known 0)
        known
        (begin
          (scope-shape m api-phase nil)
          (when remember (hash-set! (-> current scopes) (cast u64 (cadr m)) (cast u32 m)))
          m))))

;; ---- checked code ----

(define (substrate-context [phase i32]) -> datum
  (let* ([id (make-syntax '%substrate:#%module-begin (module-base-scopes) 0 nil)]
         [t (transformer-of (meaning-of id phase))])
    (cond [(and (!= t 0) (form-value? t)) t]
          [(equal? (language-path) (-> (the-module) path))
           (make-syntax 'here (scopes-change (module-base-scopes) wasm-scope 0) 0 nil)]
          [else (substrate-form-value)])))

(define substrate-form-value-cache datum 0)
(define (substrate-form-value) -> datum
  (when (== substrate-form-value-cache 0)
    (let* ([m (cast datum (hash-ref (& registry) (cast u64 (symbol-of (language-path)))))]
           [p (if (and (!= m 0) (== (-> (unit-of m) state) 'done)) (assq '#%module-begin (-> (unit-of m) provides)) 0)]
           [t (if (!= p 0) (transformer-of (cdr p)) 0)])
      (when (and (!= t 0) (form-value? t)) (set! substrate-form-value-cache (keep t)))))
  substrate-form-value-cache)

(define (checked-code [kind datum] [s datum] [phase i32]) -> datum
  (let ([saved-phase api-phase] [saved-where api-where] [saved-intro api-intro] [intro (new-scope!)] [result datum 0])
    (set! api-phase phase)
    (set! api-where s)
    (set! api-intro intro)
    (try (set! result (substrate-code kind (flip-scope s intro) (substrate-context phase) (& (-> current checking)) phase))
         [catch compile-error (message blamed loc)
          (set! api-phase saved-phase)
          (set! api-where saved-where)
          (set! api-intro saved-intro)
          (throw compile-error message blamed
                 (if (and (== loc 0) (not (and (syntax? blamed) (!= (syntax-srcloc blamed) 0)))) (syntax-srcloc s) loc))]
         [catch-all
          (set! api-phase saved-phase)
          (set! api-where saved-where)
          (set! api-intro saved-intro)
          (rethrow)])
    (set! api-phase saved-phase)
    (set! api-where saved-where)
    (set! api-intro saved-intro)
    result))

(define (core-body [f datum] [name datum] [xs datum] [body datum] [info datum] [phase i32]) -> datum
  (let* ([rs (func-info-results info)]
         [result (cond [(null? rs) 'void] [(null? (cdr rs)) (car rs)] [else (cons 'values rs)])])
    (expand-expr (core-syntax f `(#%checked body ,name (,@xs) #:wasm (quote (,result ,@(func-info-params info))) ,@body) f) phase)))

(define (core-expression [s datum] [phase i32]) -> datum
  (expand-expr (core-syntax s `(#%checked body ,s () #:wasm (quote (void)) ,s) s) phase))

(define (core-value [x datum] [type datum] [init datum] [where datum] [phase i32]) -> datum
  (expand-expr (core-syntax where `(#%checked value ,x (quote ,type) ,init) where) phase))

;; (define-syntax id rhs), or (define-syntax id function env).
(define (define-syntax! [f datum] [phase i32])
  (let ([l (syntax->list f)])
    (unless (and (!= l 0) (>= (length l) 3) (identifier? (cadr l)) (or (== (length l) 3) (and (== (length l) 4) (identifier? (caddr l)))))
      (no-match f "(define-syntax id rhs) or (define-syntax id function env)"))
    (unless (and (identifier? (caddr l)) (== (length l) 3)) (use-language! (+ phase 1)))
    (let* ([id (cadr l)] [rhs (caddr l)] [env (if (== (length l) 4) (cadddr l) 0)] [arity u32 (if (!= env 0) 2 1)]
           [m (if (identifier? rhs) (meaning-of rhs (+ phase 1)) 0)]
           [name (string->symbol (format-message "__value.~a" (list1 (syntax-e id))))]
           [function (if (or (!= env 0) (and (!= m 0) (== (car m) 'func))) (syntax-function-of rhs phase arity) 0)]
           [env-code datum 0] [init datum 0] [global datum 0] [getter datum 0] [forms datum 0] [saved to-syntax])
      (if (!= function 0)
          (begin
            (when (!= env 0)
              (set! to-syntax #f)
              (set! env-code (try (core-value id 'i32 env env (+ phase 1)) [catch-all (set! to-syntax saved) (rethrow)]))
              (set! to-syntax saved))
            (set! init (if (!= env 0)
                           `(call ,(running-function 'make-transformer) ((func-index ,function) ,env-code))
                           `(call ,(running-function 'make-function-transformer) ((func-index ,function))))))
          (begin
            (set! to-syntax #f)
            (set! init (try (core-value id 'i32 rhs rhs (+ phase 1)) [catch-all (set! to-syntax saved) (rethrow)]))
            (set! to-syntax saved)))
      (set! global (global-info name 'i32 (boolean #t) 0 0))
      (set! getter (func-info name nil '(i32) 0 0))
      (set! forms `((global ,global ,init) (func ,getter () (gref ,global))))
      (cond [(and (!= function 0) (callable? function arity) (or (== env 0) (plain? env-code)))
             (add-phase-forms! (+ phase 1) forms)
             (made-value! getter (if (!= env 0)
                                     (make-transformer (cast u32 (function-index function)) (plain-value env-code env))
                                     (make-function-transformer (cast u32 (function-index function)))))]
            [(and (== function 0) (plain? init))
             (add-phase-forms! (+ phase 1) forms)
             (made-value! getter (plain-value init rhs))]
            [else (run-compile-time-wasm-module! forms (+ phase 1) f)])
      (hash-set! (& macro-modules) (cast u64 getter) (cast u32 (-> current module)))
      (bind-definition! id phase `(compile-time-value ,getter)))))

(define macro-modules hash-table)

;; ---- values the expander makes ----

(define (made-value! [getter datum] [v datum])
  (hash-set! (-> current values) (cast u64 getter) (cast u32 (cons v nil))))

(define (plain? [e datum]) -> bool
  (cond [(or (== (car e) 'at) (== (car e) 'as)) (plain? (caddr e))]
        [(== (car e) 'quote) #t]
        [(== (car e) 'call)
         (and (callable? (cadr e) (length (caddr e))) (andmap (lambda ([a datum]) -> bool (plain? a)) (caddr e)))]
        [else #f]))

(define (callable? [info datum] [n u32]) -> bool
  (let ([ps (func-info-params info)])
    (unless (and (!= (func-info-instance info) 0) (<= n 6) (== (length ps) n) (equal? (func-info-results info) '(i32)))
      (return #f))
    (while (pair? ps)
      (unless (== (car ps) 'i32) (return #f))
      (set! ps (cdr ps)))
    #t))

(define (plain-value [e datum] [where datum]) -> datum
  (cond [(or (== (car e) 'at) (== (car e) 'as)) (plain-value (caddr e) where)]
        [(== (car e) 'quote) (cadr e)]
        [else
         (let ([args (map (lambda ([a datum]) -> datum (plain-value a where)) (caddr e))] [saved api-where] [v datum 0])
           (set! api-where where)
           (set! v (try (call-function (function-index (cadr e)) args) [catch-all (set! api-where saved) (rethrow)]))
           (set! api-where saved)
           v)]))

(define (call-function [index i32] [args datum]) -> datum
  (let ([n (length args)] [a datum 0] [b datum 0] [c datum 0] [d datum 0] [e datum 0] [g datum 0])
    (when (> n 0) (set! a (list-ref args 0)))
    (when (> n 1) (set! b (list-ref args 1)))
    (when (> n 2) (set! c (list-ref args 2)))
    (when (> n 3) (set! d (list-ref args 3)))
    (when (> n 4) (set! e (list-ref args 4)))
    (when (> n 5) (set! g (list-ref args 5)))
    (case n
      [(0) (let ([f (cast (fn () -> datum) index)]) (f))]
      [(1) (let ([f (cast (fn (datum) -> datum) index)]) (f a))]
      [(2) (let ([f (cast (fn (datum datum) -> datum) index)]) (f a b))]
      [(3) (let ([f (cast (fn (datum datum datum) -> datum) index)]) (f a b c))]
      [(4) (let ([f (cast (fn (datum datum datum datum) -> datum) index)]) (f a b c d))]
      [(5) (let ([f (cast (fn (datum datum datum datum datum) -> datum) index)]) (f a b c d e))]
      [else (let ([f (cast (fn (datum datum datum datum datum datum) -> datum) index)]) (f a b c d e g))])))

(define (syntax-function-of [id datum] [phase i32] [arity u32]) -> datum
  (let ([m (meaning-of id (+ phase 1))] [info datum 0])
    (unless (and (!= m 0) (== (car m) 'func))
      (fail-at id "~a is not a function at phase ~a" `(,(syntax-e id) ,(make-integer (+ phase 1)))))
    (set! info (cadr m))
    (unless (and (equal? (func-info-params info) (if (== arity 2) '(i32 i32) '(i32))) (equal? (func-info-results info) '(i32)))
      (fail-at id (if (== arity 2)
                      "a transformer with an environment takes two i32s (the environment and the syntax) and returns one i32"
                      "a transformer takes one i32 (syntax) and returns one i32")
               nil))
    (when (== (func-info-instance info) 0)
      (fail-at id "~a must be defined by an earlier begin-for-syntax" (list1 (syntax-e id))))
    info))

(define (begin-for-syntax! [f datum] [phase i32])
  (let ([forms (cdr (form-list f "(begin-for-syntax form ...)"))] [saved to-syntax] [code datum 0])
    (use-language! (+ phase 1))
    (set! to-syntax #f)
    (set! code (try (expand-body forms (+ phase 1)) [catch-all (set! to-syntax saved) (rethrow)]))
    (set! to-syntax saved)
    (run-compile-time-wasm-module! code (+ phase 1) f)))

(define (trap-report [why string]) -> datum
  (let ([msg (string->datum why)] [loc (if (syntax? api-where) (syntax-srcloc api-where) 0)])
    (cond [(!= loc 0)
           (format "~a:~a:~a: error: ~a\n"
                   `(,(displayed (string->datum (symbol->string (-> loc source)))) ,(make-integer (-> loc line))
                     ,(make-integer (+ (-> loc col) 1)) ,msg))]
          [(!= current 0) (format "~a: error: ~a\n" `(,(displayed (-> (the-module) path)) ,msg))]
          [else (format "error: ~a\n" (list1 msg))])))

;; ---- facts ----

(define (fact! [f datum] [phase i32]) -> datum
  (let ([l (syntax->list f)])
    (unless (and (!= l 0) (== (length l) 3) (identifier? (cadr l)))
      (fail-at f "expected (#%fact id 'datum) or (#%fact id #'syntax)" nil))
    (let* ([id (cadr l)] [written (caddr l)]
           [key (fact-key id phase)]
           [kind (fact-quote written)]
           [d (cadr (syntax->list written))]
           [value (if (== kind 'quote) (syntax->datum d) (prune-local-scopes d))]
           [fact `(,key ,(make-integer phase) ,value)]
           [m (the-module)])
      (set! (-> m facts) (keep-cons fact (-> m facts)))
      (index-fact! (-> m self) fact)
      (core-headed f '#%fact))))

(define facts-by-key hash-table)

(define (index-fact! [m datum] [f datum])
  (let ([k (cast u64 (car f))])
    (hash-set! (& facts-by-key) k (cast u32 (keep-cons (cons m (cdr f)) (cast datum (hash-ref (& facts-by-key) k)))))))

(define (keep-cons [x datum] [l datum]) -> datum
  (let* ([k (keep x)] [saved (use-arena (& run-arena))] [p (cons k l)])
    (use-arena saved)
    p))

(define (fact-quote [written datum]) -> datum
  (let* ([l (syntax->list written)]
         [kind (if (and (!= l 0) (== (length l) 2) (identifier? (car l))) (syntax-e (car l)) 0)])
    (unless (!= (memq kind '(quote quote-syntax)) 0)
      (fail-at written "a fact is a datum or syntax: expected (#%fact id 'datum) or (#%fact id #'syntax)" nil))
    kind))

(define (definition-of [m datum]) -> datum
  (let ([info (if (and (!= m 0) (!= (memq (car m) '(func global tag compile-time-value)) 0)) (base-info (cadr m)) 0)])
    (if (and (!= info 0) (not (running-definition? info))) info 0)))

(define (running-definition? [info datum]) -> bool (!= (hash-ref (& running-infos) (cast u64 info)) 0))

(define (fact-key [id datum] [phase i32]) -> datum
  (let* ([m (meaning-of id phase)] [base (definition-of m)])
    (when (== m 0) (fail-at id "~a is unbound: a fact is about a definition made before it" (list1 (syntax-e id))))
    (when (== base 0) (fail-at id "a fact is about a module's definition, and ~a is not one" (list1 (syntax-e id))))
    base))

(define (note-definitions! [m datum] [forms datum])
  (let ([u (unit-of m)])
    (for-each (lambda ([f datum])
                (case (car f)
                  [('func 'global 'tag) (set! (-> u infos) (keep-cons (cadr f) (-> u infos)))]))
              forms)))

;; ---- sessions ----

(define session (ptr comp) 0)
(define session-mark (ptr void) 0)
(define session-set (ptr scope-set) 0)
(define session-scope u32 0)
(define session-scope-kept bool #f)
(define session-first-key i64 0)
(define session-source datum 0)
(define session-message datum 0)
(define session-running bool #f)
(define interacting bool #f)

(define (in-session?) -> bool (and (!= session 0) (== current session)))

(define (module-source) -> datum (if (in-session?) session-source (symbol-of (-> (the-module) path))))

(define (session-open! [name datum])
  (let ([m (new-unit (identity 0 name) (provisional-name name))])
    (begin-module-arena)
    (set! session-mark (module-arena-mark))
    (set! current (new-comp m))
    (set! session current)
    (let ([msc (new-scope!)])
      (set! (-> (the-module) scope) msc)
      (hash-set! (& module-scope-origins) (scope-key msc) (cast u32 (keep (cons (-> (the-module) self) (make-integer 0)))))
      (set! session-set (scopes-change visible-scopes msc 0)))
    (set! to-syntax #f)
    (set! (-> current language) nil)
    (use-language! 0)))

(define (session-binding-id [id datum] [phase i32] [meaning datum]) -> datum
  (if (and (in-session?) (!= session-scope 0) (!= (scopes-change (syntax-scopes id) session-scope 1) (syntax-scopes id)))
      (let ([base (remove-scope id session-scope)])
        (if (bound-earlier? base phase meaning)
            (begin (set! session-scope-kept #t) id)
            base))
      id))

(define (bound-earlier? [id datum] [phase i32] [meaning datum]) -> bool
  (let ([b (bindings-under (syntax-e id) (binding-slot (syntax-scopes id)))] [found #f])
    (while (!= b 0)
      (when (and (== (-> b phase) phase) (== (-> b scopes) (syntax-scopes id)) (not (equal? (-> b meaning) meaning)))
        (when (> (integer-value (-> b key)) session-first-key) (return #f))
        (set! found #t))
      (set! b (-> b next)))
    found))

(define (session-unbind! [entries (ptr module-entry)])
  (let ([e (-> (the-module) entries)])
    (while (and (!= e 0) (!= e entries))
      (let* ([b (-> e binding)] [k (slot-key (-> e symbol) (binding-slot (-> b scopes)))]
             [c (cast (ptr binding) (hash-ref (& bindings) k))] [before (ptr binding) 0])
        (while (and (!= c 0) (!= c b))
          (set! before c)
          (set! c (-> c next)))
        (when (!= c 0)
          (if (== before 0) (hash-set! (& bindings) k (cast u32 (-> b next))) (set! (-> before next) (-> b next)))))
      (set! e (-> e next)))
    (set! (-> (the-module) entries) entries)))

(define (session-eval! [forms datum]) -> bool
  (let* ([sc (new-scope!)] [scopes (scopes-change session-set sc 0)] [entries (-> (the-module) entries)] [ok #f]
         [was comp (@ session)])
    (set! session-scope sc)
    (set! session-scope-kept #f)
    (set! session-first-key (integer-value (fresh-key!)))
    (set! session-source (if (and (pair? forms) (!= (syntax-srcloc (car forms)) 0))
                             (-> (syntax-srcloc (car forms)) source)
                             (symbol-of (-> (the-module) path))))
    (try
      (run-session-wasm-module! (expand-body (map (lambda ([f datum]) -> datum (add-scopes f scopes)) forms) 0))
      (set! ok #t)
      [catch compile-error (message blamed loc) (session-fail! message blamed loc)]
      [catch-all (session-fail! '"an exception escaped the input's code" 0 0)])
    (if ok
        (when session-scope-kept (set! session-set scopes))
        (let ([n (-> session wasm-module-counter)])
          (session-unbind! entries)
          (set! (@ session) was)
          (set! (-> session wasm-module-counter) n)))
    (set! session-scope 0)
    ok))

(define (session-eval-text! [text datum] [source datum]) -> bool
  (let ([forms datum 0] [ok #f])
    (try
      (set! forms (read-text text (symbol-of (identity 0 source))))
      (set! ok #t)
      [catch compile-error (message blamed loc) (session-fail! message blamed loc)])
    (and ok (session-eval! forms))))

(define (session-eval-file! [root datum] [source datum] [report (closure (datum))])
  (let ([path (entry-identity root source)] [forms datum 0])
    (check-module! path 0)
    (set! forms (program-forms (read-text (source-text path) (symbol-of path))))
    (while (pair? forms)
      (unless (session-eval! (list1 (car forms))) (report (session-error)))
      (set! forms (cdr forms)))))

(define (session-error) -> datum session-message)

(define (run-session-wasm-module! [forms datum])
  (let ([name (next-wasm-module-name! (-> current module) 0)])
    (set-current-source! (module-source))
    (let ([compiled (compile-module (append (wasm-module-storage-forms 0 name) forms) name)])
      (for-each (lambda ([imp datum]) (ensure-import! imp 0)) (cadr compiled))
      (set! session-running #t)
      (instantiate! (ns-name name) (car compiled) (cadr compiled) (caddr compiled) 0 0 #f)
      (set! session-running #f)
      (hash-set! (-> current instances) (cast u64 (symbol-of (ns-name name))) 1))))

(define (session-fail! [message datum] [blamed datum] [loc (ptr srcloc)])
  (let ([b (make-buffer)])
    (if (and (== loc 0) (not (and (syntax? blamed) (!= (syntax-srcloc blamed) 0))))
        (begin
          (buffer-add-string! (& b) "error: ")
          (write-to (& b) message 1)
          (buffer-add-byte! (& b) 10))
        (write-error (& b) message blamed loc))
    (session-recover!)
    (set! session-message (string->datum (buffer-string (& b))))
    (buffer-free! (& b))))

(define (session-recover!)
  (end-module-arenas-to! session-mark)
  (while (pair? compiling)
    (hash-set! (& registry) (cast u64 (car compiling)) 0)
    (set! compiling (cdr compiling)))
  (set! current session)
  (set! current-body 0)
  (set! to-syntax #f)
  (set! api-phase 0)
  (set! api-where 0)
  (set! api-intro 0)
  (set! session-running #f)
  (set! interacting #f)
  (set-scope-map! 0)
  (checker-recover!))

(define (session-failure [said datum]) -> datum
  (let* ([s (datum->string said)] [p (-> s bytes)] [n (-> s length)] [from u32 0] [to n]
         [at (find-text s "instantiate-bytes")])
    (when (and (>= n 6) (== (slice s 0 6) "trap: ")) (set! from 6))
    (when (>= at 0)
      (set! to (cast u32 at))
      (while (and (> to from) (!= (@ p (- to 1)) 10)) (-= to 1)))
    (while (and (> to from) (== (@ p (- to 1)) 10)) (-= to 1))
    (string->datum (slice s from to))))

(define (find-text [s string] [part string]) -> i32
  (let ([n (-> s length)] [m (-> part length)])
    (for ([i u32 0]) (<= (+ i m) n) (+= i 1)
      (when (== (slice s i (+ i m)) part) (return (cast i32 i))))
    -1))

(define (interact! [f0 datum] [f datum] [b (ptr body)])
  (let* ([id (implicit-id f0 '#%top-interaction)] [t (transformer-of (meaning-of id 0))])
    (if (== t 0)
        (item! b `(expr ,f))
        (begin
          (set! interacting #t)
          (declare-form! (apply-macro id t (syntax-rewrap f0 `(,id ,f)) 0 #t) b 0)
          (set! interacting #f)))))

;; ---- macros ----

(define api-phase i32 0)
(define api-where datum 0)
(define api-intro u32 0)

(define (apply-macro [head datum] [t datum] [s0 datum] [phase i32] [use-site bool]) -> datum
  (note-macro-use! head phase)
  (let* ([intro (new-scope!)] [s (flip-scope s0 intro)])
    (when (and use-site (defined-here? head phase))
      (let ([use (new-scope!)])
        (set! (-> current use-site-scopes) (cons (make-integer use) (-> current use-site-scopes)))
        (set! s (add-scope s use))))
    (at-use s0 (flip-scope (call-syntax-function (format "macro ~a" (list1 (syntax-e head))) t s phase intro) intro))))

(define (defined-here? [head datum] [phase i32]) -> bool
  (let ([m (meaning-of head phase)])
    (and (!= m 0) (== (car m) 'compile-time-value)
         (== (cast datum (hash-ref (& macro-modules) (cast u64 (cadr m)))) (-> current module)))))

(define (at-use [use datum] [out datum]) -> datum
  (let ([u (if (syntax? use) (syntax-srcloc use) 0)] [o (if (syntax? out) (syntax-srcloc out) 0)])
    (if (and (!= u 0) (syntax? out) (not (and (!= o 0) (== (-> o source) (-> u source)))))
        (make-syntax (syntax-e out) (syntax-scopes out) u (syntax-props out))
        out)))

(define (call-syntax-function [who datum] [t datum] [s datum] [phase i32] [intro u32]) -> datum
  (let ([saved-phase api-phase] [saved-where api-where] [saved-intro api-intro] [result datum 0])
    (set! api-phase phase)
    (set! api-where s)
    (set! api-intro intro)
    (try (set! result (if (form-value? t) (form-expansion t s phase) (call-transformer t s)))
         [catch compile-error (message blamed loc)
          (set! api-phase saved-phase)
          (set! api-where saved-where)
          (set! api-intro saved-intro)
          (throw compile-error message blamed
                 (if (and (== loc 0) (not (and (syntax? blamed) (!= (syntax-srcloc blamed) 0)))) (syntax-srcloc s) loc))]
         [catch-all
          (set! api-phase saved-phase)
          (set! api-where saved-where)
          (set! api-intro saved-intro)
          (rethrow)])
    (set! api-phase saved-phase)
    (set! api-where saved-where)
    (set! api-intro saved-intro)
    (unless (syntax? result) (fail-at s "~a returned a non-syntax value: ~s" `(,who ,(syntax->datum result))))
    result))

(define (note-macro-use! [id datum] [phase i32])
  (let ([b (resolve id phase)])
    (when (and (!= b 0) (== (hash-ref (& unqualified-imports) (cast u64 b)) 1))
      (hash-set! (& unqualified-imports) (cast u64 b) 2))))

;; ---- the queries ----

(define (query-local-value [id datum]) -> datum
  (let ([m (if (identifier? id) (meaning-of id api-phase) 0)])
    (if (and (!= m 0) (== (car m) 'compile-time-value)) (compile-time-value (cadr m)) 0)))

(define (query-free-identifier=? [x datum] [y datum]) -> datum
  (unless (and (identifier? x) (identifier? y)) (fail-at api-where "free-identifier=?: expected identifiers" nil))
  (let ([vx (meaning-of x api-phase)] [vy (meaning-of y api-phase)])
    (boolean (if (or (!= vx 0) (!= vy 0)) (equal? vx vy) (== (syntax-e x) (syntax-e y))))))

(define (query-binding-kind [id datum]) -> datum
  (unless (identifier? id) (fail-at api-where "identifier-binding-kind: expected an identifier" nil))
  (let ([m (meaning-of id api-phase)])
    (case (if (== m 0) 0 (car m))
      [('func) 'function]
      [('local 'global) 'variable]
      [('compile-time-value) (if (!= (transformer-of m) 0) 'macro 'compile-time-value)]
      [('tag) 'tag]
      [('label) 'label]
      [('core 'prim) 'core]
      [else 0])))

(define (query-function-signature [id datum]) -> datum
  (unless (identifier? id) (fail-at api-where "identifier-function-signature: expected an identifier" nil))
  (let ([m (meaning-of id api-phase)])
    (if (and (!= m 0) (== (car m) 'func))
        (append (func-info-params (cadr m)) (cons '-> (func-info-results (cadr m))))
        0)))

(define (query-meaning [id datum]) -> datum
  (unless (identifier? id) (fail-at api-where "internal: not an identifier" nil))
  (meaning-of id api-phase))

(define (query-inline-call [info datum] [args datum]) -> datum (inline-call info args api-phase))

(define (query-expand-head [s datum] [remember bool]) -> datum (expand-head s api-phase remember))

(define (expand-head [s datum] [phase i32] [remember bool]) -> datum
  (let ([e (syntax-e s)])
    (cond
      [(symbol? e)
       (let ([m (meaning-of s phase)])
         (case (if (== m 0) 0 (car m))
           [('local) `(local ,(cadr m))]
           [('global) `(global ,(cadr m))]
           [('compile-time-value)
            (let ([t (transformer-of m)])
              (when (== t 0) (fail-at s "~a is bound to a compile-time value: read it with syntax-local-value" (list1 e)))
              (head-transformer s t s phase remember))]
           [('func) `(func ,(cadr m))]
           [('tag) (fail-at s "~a is a tag: throw it with (throw ~a arg ...)" `(,e ,e))]
           [('core 'prim) (fail-at s "bad use of ~a" (list1 e))]
           [('label) (fail-at s "~a is a label" (list1 e))]
           [else (unbound s e phase)]))]
      [(pair? e)
       (let* ([head (car e)] [m (if (identifier? head) (meaning-of head phase) 0)] [t (transformer-of m)])
         (cond [(!= t 0) (head-transformer head t s phase remember)]
               [(and (!= m 0) (== (car m) 'core)) `(core ,(cadr m) ,s)]
               [(and (!= m 0) (== (car m) 'prim)) `(prim ,(cadr m) ,s)]
               [else
                (when (and (identifier? head) (== (syntax-e head) '#%app))
                  (if (!= m 0)
                      (fail-at s "#%app is bound here, but not to a macro or the core form" nil)
                      (unbound head '#%app phase)))
                (expand-head (syntax-rewrap s (cons (implicit-id s '#%app) e)) phase remember)]))]
      [(null? e) (fail-at s "empty form ()" nil)]
      [(literal? e)
       (let* ([id (implicit-id s '#%datum)] [m (meaning-of id phase)] [t (transformer-of m)] [form (syntax-rewrap s `(,id ,s))])
         (cond [(!= t 0) (head-transformer id t form phase remember)]
               [(and (!= m 0) (== (car m) 'core)) `(core #%datum ,form)]
               [else (fail-at s "the literal ~s needs #%datum, which is ~a here"
                              `(,(syntax->datum s) ,(if (!= m 0) '"not a macro or the core form" '"unbound")))]))]
      [(keyword? e) (fail-at s "~s: keyword misused as an expression" (list1 e))]
      [else (fail-at s "~s is not an expression" (list1 (syntax->datum s)))])))

(define (head-transformer [head datum] [t datum] [s datum] [phase i32] [remember bool]) -> datum
  (if (form-value? t)
      (let ([l (syntax->list t)]) `(form ,(syntax-e (cadr l)) ,(if (pair? (cddr l)) (caddr l) 0) ,s ,t))
      `(macro ,(if remember (remembered-expansion head t s phase) (apply-macro head t s phase #f)))))

(define (query-apply-form [t datum] [s datum] [remember bool]) -> datum
  (if remember
      (remembered-expansion (if (pair? (syntax-e s)) (car (syntax-e s)) s) t s api-phase)
      (apply-form t s api-phase)))

(define (apply-form [t datum] [s datum] [phase i32]) -> datum
  (apply-macro (if (pair? (syntax-e s)) (car (syntax-e s)) s) t s phase #f))

(define (remembered-expansion [head datum] [t datum] [s datum] [phase i32]) -> datum
  (let ([known (cast datum (hash-ref (-> current expansions) (cast u64 s)))])
    (if (!= known 0)
        known
        (let ([x (apply-macro head t s phase #f)])
          (hash-set! (-> current expansions) (cast u64 s) (cast u32 x))
          x))))

(define (query-local-expand [s datum]) -> datum
  (unless (syntax? s) (fail-at api-where "local-expand: expected syntax" nil))
  (let ([saved-output to-syntax] [out datum 0])
    (set! to-syntax #t)
    (set! out (try (flip-scope (expand-expr (flip-scope s api-intro) api-phase) api-intro)
                   [catch-all (set! to-syntax saved-output) (rethrow)]))
    (set! to-syntax saved-output)
    out))

(define (query-lift [form datum]) -> datum
  (unless (syntax? form) (fail-at api-where "syntax-local-lift-definition: expected syntax" nil))
  (lift! (flip-scope form api-intro) api-where api-phase)
  form)

(define (query-introduce [s datum]) -> datum
  (unless (syntax? s) (fail-at api-where "syntax-local-introduce: expected syntax" nil))
  (flip-scope s api-intro))

(define dependencies-of datum 0)
(define dependencies-requires datum 0)
(define dependencies-list datum 0)
(define dependency-places (ptr hash-table) 0)

(define (dependencies) -> datum
  (let ([m (-> current module)])
    (unless (and (== m dependencies-of) (== (-> (unit-of m) requires) dependencies-requires))
      (set! dependencies-of m)
      (set! dependencies-requires (-> (unit-of m) requires))
      (set! dependencies-list (keep (reverse (visit-dependencies m 0 (make-table) nil))))
      (let ([saved (use-arena (& run-arena))] [l dependencies-list] [i u32 1])
        (set! dependency-places (make-table))
        (while (pair? l)
          (hash-set! dependency-places (shift-key (car (car l)) (cast u32 (integer-value (cdr (car l))))) i)
          (+= i 1)
          (set! l (cdr l)))
        (use-arena saved)))
    dependencies-list))

(define (visit-dependencies [m datum] [shift u32] [seen (ptr hash-table)] [out datum]) -> datum
  (when (!= (hash-ref seen (shift-key m shift)) 0) (return out))
  (hash-set! seen (shift-key m shift) 1)
  (let ([rs (-> (unit-of m) requires)])
    (while (pair? rs)
      (set! out (visit-dependencies (car (car rs)) (+ shift (cast u32 (integer-value (cdr (car rs))))) seen out))
      (set! rs (cdr rs))))
  (cons (cons m (make-integer shift)) out))

(define (query-local-facts [id datum]) -> datum
  (unless (identifier? id) (fail-at api-where "syntax-local-facts: expected an identifier" nil))
  (facts-at (fact-key id api-phase)))

(define (query-facts-of [m datum]) -> datum
  (let ([base (definition-of m)]) (if (== base 0) nil (facts-at base))))

(define (facts-at [base datum]) -> datum
  (let ([facts (reverse (cast datum (hash-ref (& facts-by-key) (cast u64 base))))] [found nil])
    (when (pair? facts) (dependencies))
    (while (pair? facts)
      (let* ([f (car facts)] [shift (- api-phase (cast i32 (integer-value (cadr f))))]
             [place (if (>= shift 0) (hash-ref dependency-places (shift-key (car f) (cast u32 shift))) 0)])
        (when (!= place 0)
          (set! found (by-place (cons (make-integer place)
                                      `(,(symbol-of (-> (unit-of (car f)) path)) ,(cadr f) ,(shift-fact (caddr f) (cast u32 shift))))
                                found))))
      (set! facts (cdr facts)))
    (map (lambda ([p datum]) -> datum (cdr p)) found)))

(define (by-place [x datum] [l datum]) -> datum
  (if (and (pair? l) (<= (integer-value (car (car l))) (integer-value (car x))))
      (cons (car l) (by-place x (cdr l)))
      (cons x l)))

(define fact-shift u32 0)
(define (shift-by-fact-shift [s (ptr scope-set)]) -> (ptr scope-set) (shift-scopes s fact-shift))
(define (shift-fact [v datum] [k u32]) -> datum
  (if (== k 0)
      v
      (begin (set! fact-shift k) (map-scopes v shift-by-fact-shift))))

;; ---- names ----

(define (definition-module [base datum]) -> datum
  (let ([m (cast datum (hash-ref (& macro-modules) (cast u64 base)))] [i datum 0])
    (when (!= m 0) (return m))
    (set! i (info-instance base))
    (set! m (if (string? i) (instance-unit i) 0))
    (if (!= m 0) m (-> current module))))

(define (info-instance [info datum]) -> datum
  (cond [(func-info? info) (func-info-instance info)]
        [(global-info? info) (global-info-instance info)]
        [(tag-info? info) (tag-info-instance info)]
        [else 0]))

(struct names [upto (ptr module-entry)] [by-base (ptr hash-table)] [by-name (ptr hash-table)] [counts (ptr hash-table)])
(define name-tables hash-table)

(define (module-names [m datum]) -> (ptr names)
  (let ([head (-> (unit-of m) entries)] [known (cast (ptr names) (hash-ref (& name-tables) (cast u64 m)))])
    (when (and (!= known 0) (== (-> known upto) head)) (return known))
    (let ([saved (use-arena (& run-arena))] [n known] [new nil] [e head])
      (when (!= n 0)
        (while (and (!= e 0) (!= e (-> n upto)))
          (set! new (cons (cast datum e) new))
          (set! e (-> e next)))
        (when (!= e (-> n upto)) (set! n 0)))
      (when (== n 0)
        (set! n (cast (ptr names) (arena-alloc (& run-arena) (sizeof names))))
        (set! (-> n by-base) (make-table))
        (set! (-> n by-name) (make-table))
        (set! (-> n counts) (make-table))
        (set! new nil)
        (set! e head)
        (while (!= e 0)
          (set! new (cons (cast datum e) new))
          (set! e (-> e next))))
      (name-entries! m n new)
      (set! (-> n upto) head)
      (hash-set! (& name-tables) (cast u64 m) (cast u32 n))
      (use-arena saved)
      n)))

(define (name-entries! [m datum] [n (ptr names)] [entries datum])
  (while (pair? entries)
    (let* ([e (cast (ptr module-entry) (car entries))] [base (definition-of (-> e binding meaning))])
      (when (and (!= base 0) (== (hash-ref (-> n by-base) (cast u64 base)) 0) (== (definition-module base) m))
        (let* ([key (cons (-> e symbol) (make-integer (-> e phase)))] [c (datum-get (-> n counts) key)]
               [k (if (== c 0) 0 (integer-value c))]
               [name (string->symbol (format-message "~a:~a~a~a"
                                                     `(,(-> (unit-of m) path) ,(-> e symbol)
                                                       ,(if (== (-> e phase) 0) '"" (format "@~a" (list1 (make-integer (-> e phase)))))
                                                       ,(if (== k 0) '"" (format "#~a" (list1 (make-integer k)))))))])
          (datum-put! (-> n counts) key (make-integer (+ k 1)))
          (hash-set! (-> n by-base) (cast u64 base) (cast u32 name))
          (hash-set! (-> n by-name) (cast u64 name) (cast u32 e)))))
    (set! entries (cdr entries))))

(define (query-identifier-name [id datum]) -> datum
  (unless (identifier? id) (fail-at api-where "identifier-name: expected an identifier" nil))
  (let ([base (definition-of (meaning-of id api-phase))])
    (if (== base 0)
        0
        (cast datum (hash-ref (-> (module-names (definition-module base)) by-base) (cast u64 base))))))

(define (query-name-identifier [name datum]) -> datum
  (unless (symbol? name) (fail-at api-where "name-identifier: expected a name, a symbol" nil))
  (let ([deps (dependencies)])
    (while (pair? deps)
      (let* ([m (car (car deps))] [shift (cast u32 (integer-value (cdr (car deps))))]
             [e (cast (ptr module-entry) (hash-ref (-> (module-names m) by-name) (cast u64 name)))])
        (when (and (!= e 0) (== (+ (-> e phase) (cast i32 shift)) api-phase))
          (return (make-syntax (-> e symbol) (shift-scopes (-> e scopes) shift) 0 nil))))
      (set! deps (cdr deps)))
    (fail-at api-where "name-identifier: ~a names no definition of this module, or of one it requires, at this phase" (list1 name))))

(define (query-datum-type) -> datum
  `(ptr (struct ,(string->symbol (format-message "~a:cell" (list1 (compiler-file '"syntax.sub")))) cell)))

;; ---- fully expanded code ----

(define (loc-of [where datum]) -> (ptr srcloc) (if (syntax? where) (syntax-srcloc where) 0))

(define (core-id [name datum] [where datum]) -> datum (make-syntax name core-scopes (loc-of where) nil))

(define (out-list [where datum] [items datum]) -> datum (make-syntax items core-scopes (loc-of where) nil))

(define (out [where datum] [name datum] [parts datum]) -> datum (out-list where (cons (core-id name where) parts)))

(define (core-headed [f datum] [name datum]) -> datum
  (out-list f (cons (core-id name (car (syntax-e f))) (cdr (syntax-e f)))))

;; ---- expressions ----

(define to-syntax bool #f)

(define (at [s datum] [e datum]) -> datum `(at ,s ,e))

(define (seq-at [s datum] [es datum]) -> datum (at s (cons 'seq es)))

(define (unbound [s datum] [sym datum] [phase i32]) -> datum
  (when (or (!= (memq sym wasm-forms) 0) (!= (memq sym '(func global)) 0) (!= (memq sym (prim-names)) 0))
    (fail-at s "~a is a wasm form: require the compiler's wasm.sub, as wasm, and write wasm:~a" `(,sym ,sym)))
  (fail-at s "unbound identifier ~a~a" `(,sym ,(if (> phase 0) (format " at phase ~a" (list1 (make-integer phase))) '""))))

(define (expand-expr [s datum] [phase i32]) -> datum
  (let ([h (expand-head s phase #f)])
    (case (car h)
      [('local) (with-local-binding s (cadr h))]
      [('global 'func) (with-local-binding s 0)]
      [('macro) (expand-expr (cadr h) phase)]
      [('form)
       (let ([m (shape-of (list-ref h 4) (cadddr h) phase)])
         (if (!= m 0) (expand-shape m phase) (expand-expr (apply-form (list-ref h 4) (cadddr h) phase) phase)))]
      [else (expand-core (cadr h) (caddr h) phase)])))

(define (literal? [e datum]) -> bool (or (integer? e) (flonum? e) (char? e) (boolean? e) (string? e)))

(define (implicit-id [s datum] [name datum]) -> datum (datum->syntax s name s))

(define (expand-core [name datum] [s datum] [phase i32]) -> datum
  (case name
    [('#%checked)
     (let ([l (syntax->list s)])
       (unless (and (!= l 0) (>= (length l) 2)) (no-match s "(#%checked kind ...)"))
       (let ([kind (syntax-e (cadr l))])
         (cond [to-syntax (out s name (if (== kind 'code) (list1 (cadr l)) (cdr l)))]
               [(== kind 'code) (cdr (boxed-code (caddr l)))]
               [else (checked-code kind s phase)])))]
    [('let*) (expand-expr (let*-expansion s) phase)]
    [else
     (let ([m (shape-of name s phase)])
       (when (== m 0) (fail-at s "~a is only allowed at module level" (list1 name)))
       (core-headed (if (== name 'quote-syntax)
                        (syntax-rewrap s `(,(car (syntax-e s)) ,(prune-local-scopes (cadr (syntax->list s)))))
                        (expand-shape m phase))
                    name))]))

(define (bind-local! [id datum] [phase i32]) -> datum
  (let ([b (bindings-under (syntax-e id) (binding-slot (syntax-scopes id)))])
    (while (!= b 0)
      (when (and (== (-> b phase) phase) (== (-> b scopes) (syntax-scopes id))
                 (pair? (-> b meaning)) (== (car (-> b meaning)) 'local))
        (fail-at id "~a is bound twice" (list1 (syntax-e id))))
      (set! b (-> b next))))
  (let ([b (bind! id phase 0)])
    (set! (-> b meaning) (keep `(local ,(-> b key))))
    (-> b key)))

(define (with-local-binding [id datum] [key datum]) -> datum
  (if (or (!= key 0) (!= (syntax-property id '%local-binding) 0))
      (syntax-property-set id '%local-binding key)
      id))

(define (fresh-label! [id datum] [phase i32]) -> datum
  (let* ([b (bind! id phase 0)] [key (-> b key)])
    (set! (-> b meaning) (keep `(label ,key)))
    key))

;; ---- inline functions ----

(define inlines hash-table)

(define inline-memory bool #f)
(define inline-copied bool #f)

(define (record-inline! [info datum] [params datum] [body datum] [id datum] [copied bool])
  (set! inline-memory #f)
  (set! inline-copied copied)
  (let ([returns (check-inline body id)])
    (hash-set! (& inlines) (cast u64 info)
               (cast u32 (keep `(,params ,(func-info-results info) ,(without-locations body) ,(boolean returns)
                                 ,(filter (lambda ([p datum]) -> bool (assigns? body (car p))) params)
                                 ,(boolean inline-memory) ,(boolean copied)))))))

(define (inline-fail [id datum] [what string]) -> bool
  (fail-at id "~a is ~a, so it may not ~a" `(,(syntax-e id) ,(if inline-copied '"copied" '"inline") ,(string->datum what)))
  #f)

(define (check-inline [e datum] [id datum]) -> bool
  (let ([check (lambda ([x datum]) -> bool (check-inline x id))]
        [each (lambda ([l datum]) -> bool (check-each l id))])
    (case (car e)
      [('at 'as 'lset 'gset) (check (caddr e))]
      [('int 'float 'const 'lref 'gref 'unreachable 'nop 'quote) #f]
      [('let)
       (let ([r (check-each (map (lambda ([b datum]) -> datum (caddr b)) (cadr e)) id)]) (or (check (caddr e)) r))]
      [('seq) (each (cdr e))]
      [('if) (let* ([a (check (cadr e))] [b (check (caddr e))] [c (if (!= (cadddr e) '#f) (check (cadddr e)) #f)]) (or a b c))]
      [('block 'loop 'br-if) (check (caddr e))]
      [('br-table) (check (cadddr e))]
      [('br) (if (!= (caddr e) '#f) (check (caddr e)) #f)]
      [('return) (when (!= (cadr e) '#f) (check (cadr e))) #t]
      [('call)
       (let ([i (info-instance (base-info (cadr e)))]) (when (and (string? i) (== (instance-unit i) 0)) (set! inline-memory #t)))
       (each (caddr e))]
      [('prim)
       (unless (== (-> (lookup-prim (cadr e)) kind) 'plain) (set! inline-memory #t))
       (each (cadddr e))]
      [('call-indirect 'func-index) (inline-fail id "use a table")]
      [('select 'drop 'values) (each (cdr e))]
      [('throw) (each (caddr e))]
      [('throw-ref) (check (cadr e))]
      [('try)
       (let ([r (check-each (map (lambda ([c datum]) -> datum (cadddr c)) (cadr e)) id)]) (or (check (caddr e)) r))]
      [else (fail-at id "internal: lowered form ~a" (list1 (car e))) #f])))

(define (check-each [l datum] [id datum]) -> bool
  (let ([returns #f])
    (while (pair? l)
      (when (check-inline (car l) id) (set! returns #t))
      (set! l (cdr l)))
    returns))

(define (assigns? [e datum] [key datum]) -> bool
  (cond [(not (pair? e)) #f]
        [(== (car e) 'quote) #f]
        [(and (== (car e) 'lset) (equal? (cadr e) key)) #t]
        [else (ormap (lambda ([x datum]) -> bool (assigns? x key)) (cdr e))]))

(define (unlocated [e datum]) -> datum (if (== (car e) 'at) (unlocated (caddr e)) e))

(define (without-locations [e datum]) -> datum
  (cond [(not (pair? e)) e]
        [(== (car e) 'at) (without-locations (caddr e))]
        [(== (car e) 'quote) e]
        [else (let ([head nil] [last datum 0] [l e])
                (while (pair? l)
                  (let ([p (list1 (without-locations (car l)))])
                    (if (== last 0) (set! head p) (set-cdr! last p))
                    (set! last p))
                  (set! l (cdr l)))
                (unless (== last 0) (set-cdr! last l))
                head)]))

(define (inline-call [info datum] [args datum] [phase i32]) -> datum
  (let ([b (cast datum (hash-ref (& inlines) (cast u64 (base-info info))))])
    (cond [(or (== b 0) (!= (length args) (length (car b)))
               (and (!= (list-ref b 5) '#f) (not (same-memory? info phase))))
           0]
          [(and (!= (list-ref b 6) '#f) (not in-inline-body))
           (if (and (== (info-instance (base-info info)) 0) (== (info-shift info) 0)) 0 'copy)]
          [else (inlined b info args)])))

(define (inlined [b datum] [info datum] [args datum]) -> datum
  (let* ([keys (new-table)] [labels (new-table)]
         [ret (if (!= (cadddr b) '#f) (fresh-key!) 0)]
         [bindings (inline-bindings (car b) args (list-ref b 4) (& keys))]
         [body (begin (set! inline-shift (info-shift info)) (copy-inline (caddr b) (& keys) (& labels) ret))]
         [e `(let ,bindings ,body)])
    (hash-free! (& keys))
    (hash-free! (& labels))
    `(as ,(cadr b) ,(if (!= ret 0) `(block ,ret ,e) e))))

(define (inline-copy [info datum]) -> datum
  (let ([keys (map (lambda ([t datum]) -> datum (fresh-key!)) (func-info-params info))])
    (cons keys (inlined (cast datum (hash-ref (& inlines) (cast u64 (base-info info)))) info
                        (map (lambda ([k datum]) -> datum `(lref ,k)) keys)))))

(define (new-table) -> hash-table
  (let ([t hash-table])
    (memset (& t) 0 (sizeof hash-table))
    t))

(define (same-memory? [info datum] [phase i32]) -> bool
  (let* ([i (info-instance (base-info info))]
         [def (cond [(== i 0) (use-memory-owner (- phase (cast i32 (info-shift info))))]
                    [(string? i) (memory-owner (shifted-instance i (cast i32 (info-shift info))))]
                    [else 0])]
         [use (use-memory-owner phase)])
    (and (!= def 0) (!= use 0) (equal? def use))))

(define (use-memory-owner [phase i32]) -> datum
  (let ([form (storage-form 'memory phase)])
    (cond [(== form 0) 0]
          [(== (car form) 'memory) (wasm-module-name (-> current module) phase 0)]
          [else (memory-owner (cadr form))])))

(define (memory-owner [name datum]) -> datum
  (cond [(== name 0) 0]
        [(!= (group-instance name) 0) (group-memory-owner (group-instance name))]
        [else
         (let ([r (wasm-module-ref name)])
           (if (== r 0)
               0
               (let* ([m (car r)] [q (cast i32 (integer-value (cadr r)))] [t (cast i32 (integer-value (caddr r)))]
                      [form (module-memory m q)])
                 (cond [(== form 0) 0]
                       [(== (car form) 'memory) name]
                       [else (memory-owner (shifted-instance (cadr form) t))]))))]))

(define memory-owners datum nil)

(define (group-memory-owner [name datum]) -> datum
  (let ([p (assoc name memory-owners)])
    (if (!= p 0)
        (cdr p)
        (let* ([from (wasm-module-memory-import (datum->bytes (running-bytes name)))]
               [owner (if (== from 0) name (group-memory-owner from))])
          (set! memory-owners (keep-cons (cons name owner) memory-owners))
          (cdr (car memory-owners))))))

(define (shifted-instance [name datum] [t i32]) -> datum
  (if (or (== t 0) (running-instance? name))
      name
      (let ([r (wasm-module-ref name)])
        (if (== r 0) 0 (wasm-module-name (car r) (cast i32 (integer-value (cadr r))) (+ (cast i32 (integer-value (caddr r))) t))))))

(define (module-memory [m datum] [q i32]) -> datum
  (if (== m (-> current module))
      (storage-form 'memory q)
      (let ([p (assoc (make-integer q) (-> (unit-of m) memories))])
        (if (== p 0) 0 (cdr p)))))

(define (inline-bindings [params datum] [args datum] [assigned datum] [keys (ptr hash-table)]) -> datum
  (if (null? params)
      nil
      (let* ([p (car params)] [a (unlocated (car args))])
        (if (and (== (car a) 'lref) (== (assoc (car p) assigned) 0)
                 (not (ormap (lambda ([later datum]) -> bool (assigns? later (cadr a))) (cdr args))))
            (begin
              (hash-set! keys (cast u64 (integer-value (car p))) (cast u32 `(as (,(cdr p)) ,a)))
              (inline-bindings (cdr params) (cdr args) assigned keys))
            (let ([k (fresh-key!)])
              (hash-set! keys (cast u64 (integer-value (car p))) (cast u32 k))
              (cons `(,k ,(cdr p) ,(car args)) (inline-bindings (cdr params) (cdr args) assigned keys)))))))

(define (copied-key [table (ptr hash-table)] [key datum]) -> datum
  (let ([known (cast datum (hash-ref table (cast u64 (integer-value key))))])
    (if (!= known 0)
        known
        (let ([n (fresh-key!)])
          (hash-set! table (cast u64 (integer-value key)) (cast u32 n))
          n))))

(define (copied-keys [ks datum] [table (ptr hash-table)]) -> datum
  (map (lambda ([k datum]) -> datum (copied-key table k)) ks))

(define inline-shift u32 0)

(define (copy-inline [e datum] [keys (ptr hash-table)] [labels (ptr hash-table)] [ret datum]) -> datum
  (let ([copy (lambda ([x datum]) -> datum (copy-inline x keys labels ret))]
        [copies (lambda ([l datum]) -> datum (copy-each l keys labels ret))]
        [copy? (lambda ([x datum]) -> datum (if (== x '#f) '#f (copy-inline x keys labels ret)))])
    (case (car e)
      [('as) `(as ,(cadr e) ,(copy (caddr e)))]
      [('int 'float 'const 'quote 'unreachable 'nop) e]
      [('lref) (let ([m (copied-key keys (cadr e))]) (if (pair? m) m `(lref ,m)))]
      [('lset) `(lset ,(copied-key keys (cadr e)) ,(copy (caddr e)))]
      [('gref) `(gref ,(shift-info (cadr e) inline-shift))]
      [('gset) `(gset ,(shift-info (cadr e) inline-shift) ,(copy (caddr e)))]
      [('let)
       `(let ,(map (lambda ([b datum]) -> datum
                     (cons (if (pair? (car b)) (copied-keys (car b) keys) (copied-key keys (car b)))
                           (cons (cadr b) (cons (copy-inline (caddr b) keys labels ret) (cdddr b)))))
                   (cadr e))
             ,(copy (caddr e)))]
      [('seq 'select 'drop 'values) (cons (car e) (copies (cdr e)))]
      [('if) `(if ,(copy (cadr e)) ,(copy (caddr e)) ,(copy? (cadddr e)))]
      [('block 'loop) `(,(car e) ,(copied-key labels (cadr e)) ,(copy (caddr e)))]
      [('br) `(br ,(copied-key labels (cadr e)) ,(copy? (caddr e)))]
      [('br-if) `(br-if ,(copied-key labels (cadr e)) ,(copy (caddr e)))]
      [('br-table)
       `(br-table ,(map (lambda ([k datum]) -> datum (copied-key labels k)) (cadr e)) ,(copied-key labels (caddr e)) ,(copy (cadddr e)))]
      [('return) `(br ,ret ,(copy? (cadr e)))]
      [('call) `(call ,(shift-info (cadr e) inline-shift) ,(copies (caddr e)))]
      [('prim) `(prim ,(cadr e) ,(caddr e) ,(copies (cadddr e)) ,@(cdr (cdddr e)))]
      [('throw) `(throw ,(shift-info (cadr e) inline-shift) ,(copies (caddr e)))]
      [('throw-ref) `(throw-ref ,(copy (cadr e)))]
      [('try)
       `(try ,(map (lambda ([c datum]) -> datum
                     `(,(car c) ,(if (!= (cadr c) '#f) (shift-info (cadr c) inline-shift) '#f) ,(copied-keys (caddr c) keys)
                       ,(copy-inline (cadddr c) keys labels ret)))
                   (cadr e))
             ,(copy (caddr e)))]
      [else (fail-at 0 "internal: lowered form ~a" (list1 (car e)))])))

(define (copy-each [l datum] [keys (ptr hash-table)] [labels (ptr hash-table)] [ret datum]) -> datum
  (map (lambda ([x datum]) -> datum (copy-inline x keys labels ret)) l))

(define (note-inline! [info datum] [params datum] [code datum] [name datum] [copied bool])
  (record-inline! info params code name copied))
