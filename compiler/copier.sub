;; The copier: compiler code with the compiler's memory as memory 0 and a root's own memory as memory 1, which copies
;; data between the compiler's runtime and the root's, building each copy with that side's own functions. The compiler
;; makes one for each root whose compile-time code runs in a memory of its own.
(require wasm compiler/wasm)
(require-unqualified syntax "syntax.sub")
(require place "world-memory.sub")

(provide copy-in copy-back loc-in loc-back words-in words-free)

(wasm:memory 1 from place)

;; The root's compiler/syntax.sub and prelude, which the compiler names world and world-prelude.
(import w-kind "world" "datum-kind" (i32 -> i32))
(import w-nil "world" "nil-datum" (-> i32))
(import w-boolean "world" "boolean" (i32 -> i32))
(import w-cons "world" "cons" (i32 i32 -> i32))
(import w-set-cdr "world" "set-cdr!" (i32 i32 ->))
(import w-car "world" "car" (i32 -> i32))
(import w-cdr "world" "cdr" (i32 -> i32))
(import w-symbol "world" "string->symbol" (i64 -> i32))
(import w-symbol-text "world" "symbol->string" (i32 -> i64))
(import w-keyword "world" "string->keyword" (i64 -> i32))
(import w-keyword-text "world" "keyword->string" (i32 -> i64))
(import w-string "world" "string->datum" (i64 -> i32))
(import w-string-text "world" "datum->string" (i32 -> i64))
(import w-bytes "world" "bytes->datum" (i64 -> i32))
(import w-bytes-data "world" "datum->bytes" (i32 -> i64))
(import w-integer "world" "make-integer" (i64 -> i32))
(import w-integer-value "world" "integer-value" (i32 -> i64))
(import w-flonum "world" "make-flonum" (f64 -> i32))
(import w-flonum-value "world" "flonum-value" (i32 -> f64))
(import w-char "world" "integer->char" (i32 -> i32))
(import w-char-code "world" "char->integer" (i32 -> i32))
(import w-syntax "world" "make-syntax" (i32 i32 i32 i32 -> i32))
(import w-syntax-e "world" "syntax-e" (i32 -> i32))
(import w-syntax-scopes "world" "syntax-scopes" (i32 -> i32))
(import w-syntax-srcloc "world" "syntax-srcloc" (i32 -> i32))
(import w-syntax-props "world" "syntax-props" (i32 -> i32))
(import w-srcloc "world" "make-srcloc" (i32 i32 i32 i32 i32 -> i32))
(import w-srcloc-part "world" "srcloc-part" (i32 i32 -> i32))
(import w-scratch "world" "scratch-for" (i32 -> i32))
(import w-intern-scopes "world" "intern-scopes" (i64 -> i32))
(import w-scope-count "world" "scope-count" (i32 -> i32))
(import w-scope-id "world" "scope-id" (i32 i32 -> i32))
(import w-malloc "world-prelude" "malloc" (i32 -> i32))
(import w-free "world-prelude" "free" (i32 ->))

;; What one copy has made, so that what its data shares stays shared: keys on one side, copies on the other.
(define seen hash-table)

(define (fresh-seen!)
  (when (> (-> seen capacity) 0) (hash-free! (& seen)))
  (memset (& seen) 0 (sizeof hash-table)))

(define (view [at i32] [n u32]) -> i64 (bit-or (cast i64 (cast u32 at)) (<< (cast i64 n) 32)))

(define (view-at [v i64]) -> i32 (cast i32 (bit-and v 4294967295)))

(define (view-length [v i64]) -> u32 (cast u32 (>> v 32)))

;; ---- into the root's memory ----

;; Room in the root's memory for each text copied in.
(define room i32 0)
(define room-size u32 0)

(define (text-in [s (slice u8)]) -> i64
  (when (< room-size (+ (-> s length) 1))
    (unless (== room 0) (w-free room))
    (set! room-size (+ (* 2 (-> s length)) 64))
    (set! room (w-malloc (cast i32 room-size))))
  (wasm:memory.copy-in room (cast i32 (-> s items)) (cast i32 (-> s length)))
  (view room (-> s length)))

;; copy-in gives d copied into the root's memory.
(define (copy-in [d datum]) -> i32
  (fresh-seen!)
  (into d))

(define (into [d datum]) -> i32
  (let ([known i32 0] [out i32 0])
    (cond [(fixnum? d) (return (cast i32 d))]
          [(== d '#f) (return 0)]
          [(null? d) (return (w-nil))]
          [(boolean? d) (return (w-boolean 1))]
          [(symbol? d) (return (w-symbol (text-in (cast (slice u8) (symbol->string d)))))]
          [(keyword? d) (return (w-keyword (text-in (cast (slice u8) (keyword->string d)))))])
    (set! known (cast i32 (hash-ref (& seen) (cast u64 d))))
    (when (!= known 0) (return known))
    (set! out (cond [(pair? d) (into-list d)]
                    [(syntax? d)
                     (w-syntax (into (syntax-e d)) (scopes-in (syntax-scopes d)) (srcloc-in (syntax-srcloc d))
                               (into (syntax-props d)))]
                    [(string? d) (w-string (text-in (cast (slice u8) (datum->string d))))]
                    [(bytes? d) (w-bytes (text-in (datum->bytes d)))]
                    [(integer? d) (w-integer (integer-value d))]
                    [(flonum? d) (w-flonum (flonum-value d))]
                    [(char? d) (w-char (cast i32 (char->integer d)))]
                    [else (raise-compile-error 0 "this data cannot be copied into the memory the macro runs in") 0]))
    (hash-set! (& seen) (cast u64 d) (cast u32 out))
    out))

(define (into-list [l datum]) -> i32
  (let ([head i32 0] [last i32 0] [cell i32 0])
    (while (pair? l)
      (set! cell (w-cons (into (car l)) (w-nil)))
      (if (== head 0) (set! head cell) (w-set-cdr last cell))
      (set! last cell)
      (set! l (cdr l)))
    (unless (null? l) (w-set-cdr last (into l)))
    head))

(define (scopes-in [s (ptr scope-set)]) -> i32
  (let ([at (w-scratch (cast i32 (-> s count)))])
    (wasm:memory.copy-in at (cast i32 (-> s ids)) (cast i32 (* 4 (-> s count))))
    (w-intern-scopes (view at (-> s count)))))

(define (srcloc-in [l (ptr srcloc)]) -> i32
  (if (== l 0)
      0
      (w-srcloc (into (-> l source)) (cast i32 (-> l line)) (cast i32 (-> l col)) (cast i32 (-> l pos)) (cast i32 (-> l span)))))

;; loc-in gives the place l copied into the root's memory.
(define (loc-in [l (ptr srcloc)]) -> i32
  (fresh-seen!)
  (srcloc-in l))

;; words-in gives a copy of n words at p in the root's memory, which words-free frees.
(define (words-in [p (ptr u32)] [n u32]) -> i32
  (let ([at (w-malloc (cast i32 (+ (* 4 n) 4)))])
    (wasm:memory.copy-in at (cast i32 p) (cast i32 (* 4 n)))
    at))

(define (words-free [at i32]) (w-free at))

;; ---- back into the compiler's memory ----

;; Room in the compiler's memory for each text copied back.
(define back-room (ptr u8) 0)
(define back-room-size u32 0)

(define (text-back [v i64]) -> (slice u8)
  (let ([n (view-length v)])
    (when (< back-room-size (+ n 1))
      (unless (== back-room 0) (free back-room))
      (set! back-room-size (+ (* 2 n) 64))
      (set! back-room (cast (ptr u8) (malloc back-room-size))))
    (wasm:memory.copy-out (cast i32 back-room) (view-at v) (cast i32 n))
    (slice back-room n)))

;; How many more objects one copy back may make, so that what the root's code gives cannot make it run without end.
(define budget u32 0)

;; copy-back gives the datum w in the root's memory copied into the compiler's.
(define (copy-back [w i32]) -> datum
  (fresh-seen!)
  (set! budget 50000000)
  (back w))

(define (back [w i32]) -> datum
  (let ([kind (cast u32 (w-kind w))] [known datum 0] [out datum 0])
    (when (== budget 0) (raise-compile-error 0 "a macro in a memory of its own gave more than the compiler copies back"))
    (-= budget 1)
    (case kind
      [(0) (return (cast datum w))]
      [(1) (return '#f)]
      [(2) (return nil)]
      [(3) (return (boolean #t))]
      [(5) (return (string->symbol (cast string (text-back (w-symbol-text w)))))]
      [(6) (return (string->keyword (cast string (text-back (w-keyword-text w)))))])
    (set! known (cast datum (hash-ref (& seen) (cast u64 w))))
    (when (!= known 0) (return known))
    (set! out (case kind
                [(4) (back-list w)]
                [(11) (make-syntax (back (w-syntax-e w)) (scopes-back (w-syntax-scopes w)) (srcloc-back (w-syntax-srcloc w))
                                   (back (w-syntax-props w)))]
                [(7) (string->datum (cast string (text-back (w-string-text w))))]
                [(14) (bytes->datum (text-back (w-bytes-data w)))]
                [(8) (make-integer (w-integer-value w))]
                [(9) (make-flonum (w-flonum-value w))]
                [(10) (integer->char (cast u32 (w-char-code w)))]
                [else (raise-compile-error 0 "a macro in a memory of its own gave data that cannot be copied back to the compiler") 0]))
    (hash-set! (& seen) (cast u64 w) (cast u32 out))
    out))

(define (back-list [w i32]) -> datum
  (let ([head datum 0] [last datum 0] [cell datum 0] [l w])
    (while (== (w-kind l) 4)
      (when (== budget 0) (raise-compile-error 0 "a macro in a memory of its own gave more than the compiler copies back"))
      (-= budget 1)
      (set! cell (cons (back (w-car l)) nil))
      (if (== head 0) (set! head cell) (set-cdr! last cell))
      (set! last cell)
      (set! l (w-cdr l)))
    (unless (== (w-kind l) 2) (set-cdr! last (back l)))
    head))

(define (scopes-back [w i32]) -> (ptr scope-set)
  (let ([s no-scopes] [n (cast u32 (w-scope-count w))])
    (for ([i u32 0]) (< i n) (+= i 1) (set! s (scopes-change s (cast u32 (w-scope-id w (cast i32 i))) 0)))
    s))

(define (srcloc-back [w i32]) -> (ptr srcloc)
  (if (== w 0)
      0
      (make-srcloc (back (w-srcloc-part w 0)) (cast u32 (w-srcloc-part w 1)) (cast u32 (w-srcloc-part w 2))
                   (cast u32 (w-srcloc-part w 3)) (cast u32 (w-srcloc-part w 4)))))

;; loc-back gives the place w in the root's memory copied into the compiler's.
(define (loc-back [w i32]) -> (ptr srcloc)
  (fresh-seen!)
  (set! budget 50000000)
  (srcloc-back w))
