;; Leaves out of a program's wasm modules the functions it can never call, imported or its own, and renumbers the
;; rest.
(require-unqualified macros "macros.sub")
(require-unqualified leb "leb128.sub")
(require-unqualified binary "binary.sub")
(require-unqualified running "running.sub")

(provide pruned stripped)

(struct wasm [name datum] [p (ptr u8)] [size u32] [sections datum] [imports datum] [spans datum] [funcs datum]
        [nimports u32] [exports datum] [by-name (ptr hash-table)] [start i32] [count u32] [starts (ptr u32)]
        [ends (ptr u32)] [live (ptr u8)] [kept (ptr hash-table)] [indexes (ptr u32)])

;; ---- reading ----

(define (unreadable) (raise-compile-error 0 '"internal: a program's wasm module cannot be read"))

(define (new-wasm [name datum] [bytes datum]) -> (ptr wasm)
  (let ([w (cast (ptr wasm) (arena-alloc (current-arena) (sizeof wasm)))] [id u32 0] [head u32 0] [next u32 0])
    (set! (-> w name) name)
    (set! (-> w p) (string-bytes bytes))
    (set! (-> w size) (string-length bytes))
    (set! (-> w sections) nil)
    (set! (-> w imports) nil)
    (set! (-> w spans) nil)
    (set! (-> w funcs) nil)
    (set! (-> w nimports) 0)
    (set! (-> w exports) nil)
    (set! (-> w by-name) (make-table))
    (set! (-> w start) -1)
    (set! (-> w count) 0)
    (set! (-> w kept) (make-table))
    (set! (-> w indexes) 0)
    (read-from! (-> w p) 8 (-> w size))
    (while (< (position) (-> w size))
      (set! head (position))
      (set! id (byte))
      (set! next (uleb))
      (+= next (position))
      (set! (-> w sections)
            (cons `(,(make-integer id) ,(make-integer head) ,(make-integer (position)) ,(make-integer next)) (-> w sections)))
      (when (== id 2) (read-imports! w))
      (read-from! (-> w p) next (-> w size)))
    (set! (-> w sections) (reverse (-> w sections)))
    (set! (-> w spans) (reverse (-> w spans)))
    (set! (-> w funcs) (reverse (-> w funcs)))
    w))

(define (read-rest! [w (ptr wasm)])
  (let ([ss (-> w sections)] [id i64 0])
    (while (pair? ss)
      (set! id (integer-value (car (car ss))))
      (read-from! (-> w p) (cast u32 (integer-value (caddr (car ss)))) (cast u32 (integer-value (cadddr (car ss)))))
      (cond [(== id 7) (read-exports! w)]
            [(== id 8) (set! (-> w start) (cast i32 (uleb)))]
            [(== id 9) (read-elems!)]
            [(== id 10) (read-bodies! w)])
      (set! ss (cdr ss)))
    (set! (-> w live) (cast (ptr u8) (arena-alloc (current-arena) (+ (-> w nimports) (-> w count) 1))))
    (memset (-> w live) 0 (+ (-> w nimports) (-> w count) 1))))

;; Each import's span is its kind and its bytes' start and end.
(define (read-imports! [w (ptr wasm)])
  (let ([module datum 0] [field datum 0] [kind u32 0] [start u32 0])
    (for ([i u32 (uleb)]) (> i 0) (-= i 1)
      (set! start (position))
      (set! module (name))
      (set! field (name))
      (set! kind (byte))
      (set! (-> w imports) (cons (cons module field) (-> w imports)))
      (cond [(== kind 0)
             (uleb)
             (set! (-> w funcs) (cons (cons module field) (-> w funcs)))
             (+= (-> w nimports) 1)]
            [(== kind 1) (byte) (limits)]
            [(== kind 2) (limits)]
            [(== kind 3) (byte) (byte)]
            [else (byte) (uleb)])
      (set! (-> w spans) (cons `(,(make-integer kind) ,(make-integer start) ,(make-integer (position))) (-> w spans))))))

(define (read-exports! [w (ptr wasm)])
  (let ([export datum 0] [kind u32 0] [index u32 0])
    (for ([i u32 (uleb)]) (> i 0) (-= i 1)
      (set! export (name))
      (set! kind (byte))
      (set! index (uleb))
      (when (== kind 0) (datum-put! (-> w by-name) export (make-integer index)))
      (set! (-> w exports) (cons `(,export ,(make-integer kind) ,(make-integer index)) (-> w exports))))
    (set! (-> w exports) (reverse (-> w exports)))))

(define (read-elems!)
  (for ([i u32 (uleb)]) (> i 0) (-= i 1)
    (unless (and (== (uleb) 3) (== (byte) 0)) (unreadable))
    (for ([j u32 (uleb)]) (> j 0) (-= j 1) (uleb))))

(define (read-bodies! [w (ptr wasm)])
  (let ([n (uleb)] [size u32 0])
    (set! (-> w count) n)
    (set! (-> w starts) (cast (ptr u32) (arena-alloc (current-arena) (* 4 (+ n 1)))))
    (set! (-> w ends) (cast (ptr u32) (arena-alloc (current-arena) (* 4 (+ n 1)))))
    (for ([k u32 0]) (< k n) (+= k 1)
      (set! size (uleb))
      (set! (@ (-> w starts) k) (position))
      (skip size)
      (set! (@ (-> w ends) k) (position)))))

;; ---- what a body calls ----

(define (calls-in [p (ptr u8)] [start u32] [end u32]) -> datum
  (let ([out nil] [b u32 0] [d datum 0] [ks datum 0])
    (read-from! p start end)
    (for ([i u32 (uleb)]) (> i 0) (-= i 1)
      (uleb)
      (byte))
    (while (< (position) end)
      (set! b (byte))
      (unless (or (== b #x05) (== b #x0B))
        (set! d (decoding-of b (if (or (== b #xFC) (== b #x1C)) (uleb) 0)))
        (when (== d 0) (unreadable))
        (set! ks (cdr d))
        (while (pair? ks)
          (if (== (car ks) 'func)
              (set! out (cons (make-integer (uleb)) out))
              (skip-immediate (car ks)))
          (set! ks (cdr ks)))))
    (unless (== (position) end) (unreadable))
    out))

(define (skip-immediate [k datum])
  (cond [(or (== k 'u) (== k 'global) (== k 'type) (== k 'tag)) (uleb)]
        [(== k 's) (skip-sleb)]
        [(== k 'memarg)
         (when (!= (bit-and (uleb) 64) 0) (uleb))
         (uleb)]
        [(== k 'labels) (for ([i u32 (uleb)]) (> i 0) (-= i 1) (uleb))]
        [(== k 'f32) (skip 4)]
        [(== k 'f64) (skip 8)]
        [(or (== k 'heap) (== k 'valtype)) (byte)]
        [(== k 'blocktype) (when (>= (byte) 128) (skip-sleb))]
        [(== k 'catches)
         (for ([i u32 (uleb)]) (> i 0) (-= i 1)
           (when (< (byte) 2) (uleb))
           (uleb))]
        [else (unreadable)]))

;; ---- what the program can call ----

(define work datum nil)

(define (live? [w (ptr wasm)] [i u32]) -> i32
  (and (< i (+ (-> w nimports) (-> w count))) (!= (@ (-> w live) i) 0)))

(define (mark! [w (ptr wasm)] [i u32])
  (when (and (< i (+ (-> w nimports) (-> w count))) (== (@ (-> w live) i) 0))
    (set! (@ (-> w live) i) 1)
    (set! work (cons (cons (cast datum w) (make-integer i)) work))))

(define (wasm-named [ws datum] [name datum]) -> (ptr wasm)
  (while (pair? ws)
    (when (string=? (-> (cast (ptr wasm) (car ws)) name) name) (return (cast (ptr wasm) (car ws))))
    (set! ws (cdr ws)))
  0)

(define (exported [w (ptr wasm)] [name datum]) -> i64
  (let ([j (datum-get (-> w by-name) name)]) (if (== j 0) -1 (integer-value j))))

(define (loads-code? [f datum]) -> i32
  (and (string=? (car f) '"host") (or (string=? (cdr f) '"instantiate") (string=? (cdr f) '"export_index"))))

(define (reach! [ws datum] [entry (ptr wasm)]) -> i32
  (while (pair? work)
    (let* ([item (car work)] [w (cast (ptr wasm) (car item))] [i (cast u32 (integer-value (cdr item)))])
      (set! work (cdr work))
      (if (< i (-> w nimports))
          (let* ([f (list-ref (-> w funcs) i)] [owner (wasm-named ws (car f))])
            (when (loads-code? f) (return 1))
            (unless (== owner 0)
              (let ([j (exported owner (cdr f))]) (when (>= j 0) (mark! owner (cast u32 j))))))
          (let ([k (- i (-> w nimports))])
            (unless (== w entry)
              (for-each (lambda ([t datum]) (mark! w (cast u32 (integer-value t))))
                        (calls-in (-> w p) (@ (-> w starts) k) (@ (-> w ends) k))))))))
  0)

(define (pruned [modules datum]) -> datum
  (let ([ws (map (lambda ([m datum]) -> datum (cast datum (new-wasm (car m) (cdr m)))) modules)] [entry (ptr wasm) 0])
    (for-each (lambda ([x datum]) (read-rest! (cast (ptr wasm) x))) ws)
    (set! entry (cast (ptr wasm) (last ws)))
    (set! work nil)
    (let ([l ws] [w (ptr wasm) 0] [is datum 0] [owner (ptr wasm) 0])
      (while (pair? l)
        (set! w (cast (ptr wasm) (car l)))
        (when (>= (-> w start) 0) (mark! w (cast u32 (-> w start))))
        (set! is (-> w imports))
        (while (pair? is)
          (set! owner (wasm-named ws (car (car is))))
          (unless (== owner 0) (datum-put! (-> owner kept) (cdr (car is)) (boolean 1)))
          (set! is (cdr is)))
        (set! l (cdr l))))
    (for ([i u32 0]) (< i (+ (-> entry nimports) (-> entry count))) (+= i 1) (mark! entry i))
    (when (reach! ws entry) (return modules))
    (map (lambda ([x datum]) -> datum
           (let ([w (cast (ptr wasm) x)])
             (cons (-> w name) (if (== w entry) (without w '("substrate")) (rewritten w)))))
         ws)))

;; ---- the new indices ----

(define (renumber! [w (ptr wasm)])
  (let ([total (+ (-> w nimports) (-> w count))] [next u32 0])
    (set! (-> w indexes) (cast (ptr u32) (arena-alloc (current-arena) (* 4 (+ total 1)))))
    (for ([i u32 0]) (< i total) (+= i 1)
      (set! (@ (-> w indexes) i) next)
      (when (!= (@ (-> w live) i) 0) (+= next 1)))))

(define (renumbered [w (ptr wasm)] [i u32]) -> u32
  (unless (live? w i) (raise-compile-error 0 '"internal: a pruned function is still used"))
  (@ (-> w indexes) i))

(define (write-uleb-padded [q (ptr buffer)] [n u32] [length u32])
  (for ([i u32 0]) (< i length) (+= i 1)
    (let ([b (bit-and n 127)])
      (set! n (>> n 7))
      (buffer-add-byte! q (cast i32 (if (< (+ i 1) length) (bit-or b 128) b)))))
  (unless (== n 0) (raise-compile-error 0 '"internal: a renumbered function index does not fit")))

;; ---- writing ----

(define (write-name [q (ptr buffer)] [s datum])
  (write-uleb q (string-length s))
  (buffer-add! q (string-bytes s) (string-length s)))

(define (section-out [out (ptr buffer)] [id i32] [q (ptr buffer)])
  (buffer-add-byte! out id)
  (write-uleb out (-> q length))
  (buffer-add! out (-> q bytes) (-> q length))
  (buffer-free! q))

(define (custom-name [w (ptr wasm)] [start u32]) -> datum
  (read-from! (-> w p) start (-> w size))
  (name))

(define (rewritten [w (ptr wasm)]) -> datum
  (let ([out (make-buffer)] [ss (-> w sections)] [news (ptr u32) 0] [s datum 0])
    (renumber! w)
    (set! news (cast (ptr u32) (arena-alloc (current-arena) (* 4 (+ (-> w count) 1)))))
    (buffer-add! (& out) (-> w p) 8)
    (while (pair? ss)
      (let* ([sec (car ss)] [id (integer-value (car sec))] [head (cast u32 (integer-value (cadr sec)))]
             [start (cast u32 (integer-value (caddr sec)))] [end (cast u32 (integer-value (cadddr sec)))]
             [custom (if (== id 0) (custom-name w start) '"")])
        (cond [(== id 2) (imports! (& out) w)]
              [(== id 3) (functions! (& out) w start end)]
              [(== id 7) (exports! (& out) w)]
              [(== id 8) (start! (& out) w)]
              [(== id 9) (elements! (& out) w start end)]
              [(== id 10) (code! (& out) w news)]
              [(string=? custom '"substrate") (begin)]
              [(string=? custom '"name") (names! (& out) w start end)]
              [(string=? custom '"source-locations") (locations! (& out) w start end news)]
              [else (buffer-add! (& out) (+ (-> w p) head) (- end head))]))
      (set! ss (cdr ss)))
    (set! s (bytes->string (-> out bytes) (-> out length)))
    (buffer-free! (& out))
    s))

(define (without [w (ptr wasm)] [names datum]) -> datum
  (let ([out (make-buffer)] [ss (-> w sections)] [s datum 0])
    (buffer-add! (& out) (-> w p) 8)
    (while (pair? ss)
      (let* ([sec (car ss)] [head (cast u32 (integer-value (cadr sec)))] [end (cast u32 (integer-value (cadddr sec)))]
             [custom (if (== (integer-value (car sec)) 0) (custom-name w (cast u32 (integer-value (caddr sec)))) '"")])
        (when (== (member custom names) 0) (buffer-add! (& out) (+ (-> w p) head) (- end head))))
      (set! ss (cdr ss)))
    (set! s (bytes->string (-> out bytes) (-> out length)))
    (buffer-free! (& out))
    s))

(define (stripped [modules datum]) -> datum
  (map (lambda ([m datum]) -> datum (cons (car m) (without (new-wasm (car m) (cdr m)) '("name" "source-locations")))) modules))

(define (imports! [out (ptr buffer)] [w (ptr wasm)])
  (let ([q (make-buffer)] [ss (-> w spans)] [f u32 0] [kept nil] [from u32 0] [to u32 0])
    (while (pair? ss)
      (let ([kind (integer-value (car (car ss)))])
        (when (or (!= kind 0) (!= (@ (-> w live) f) 0)) (set! kept (cons (car ss) kept)))
        (when (== kind 0) (+= f 1)))
      (set! ss (cdr ss)))
    (set! kept (reverse kept))
    (write-uleb (& q) (length kept))
    (while (pair? kept)
      (set! from (cast u32 (integer-value (cadr (car kept)))))
      (set! to (cast u32 (integer-value (caddr (car kept)))))
      (buffer-add! (& q) (+ (-> w p) from) (- to from))
      (set! kept (cdr kept)))
    (section-out out 2 (& q))))

(define (functions! [out (ptr buffer)] [w (ptr wasm)] [start u32] [end u32])
  (let ([q (make-buffer)] [types nil] [t u32 0])
    (read-from! (-> w p) start end)
    (let ([n (uleb)])
      (unless (== n (-> w count)) (unreadable))
      (for ([k u32 0]) (< k n) (+= k 1)
        (set! t (uleb))
        (when (live? w (+ (-> w nimports) k)) (set! types (cons (make-integer t) types)))))
    (set! types (reverse types))
    (write-uleb (& q) (length types))
    (while (pair? types)
      (write-uleb (& q) (cast u64 (integer-value (car types))))
      (set! types (cdr types)))
    (section-out out 3 (& q))))

(define (exports! [out (ptr buffer)] [w (ptr wasm)])
  (let ([q (make-buffer)] [kept nil] [es (-> w exports)] [kind i64 0] [index u32 0])
    (while (pair? es)
      (set! kind (integer-value (cadr (car es))))
      (set! index (cast u32 (integer-value (caddr (car es)))))
      (when (or (== kind 1) (== kind 2)
                (and (!= (datum-get (-> w kept) (car (car es))) 0) (or (!= kind 0) (live? w index))))
        (set! kept (cons (car es) kept)))
      (set! es (cdr es)))
    (set! kept (reverse kept))
    (write-uleb (& q) (length kept))
    (while (pair? kept)
      (set! kind (integer-value (cadr (car kept))))
      (set! index (cast u32 (integer-value (caddr (car kept)))))
      (write-name (& q) (car (car kept)))
      (buffer-add-byte! (& q) (cast i32 kind))
      (write-uleb (& q) (if (== kind 0) (renumbered w index) index))
      (set! kept (cdr kept)))
    (section-out out 7 (& q))))

(define (start! [out (ptr buffer)] [w (ptr wasm)])
  (let ([q (make-buffer)])
    (write-uleb (& q) (renumbered w (cast u32 (-> w start))))
    (section-out out 8 (& q))))

(define (elements! [out (ptr buffer)] [w (ptr wasm)] [start u32] [end u32])
  (let ([q (make-buffer)] [kept nil] [i u32 0])
    (read-from! (-> w p) start end)
    (let ([n (uleb)])
      (write-uleb (& q) n)
      (for ([s u32 0]) (< s n) (+= s 1)
        (unless (and (== (uleb) 3) (== (byte) 0)) (unreadable))
        (set! kept nil)
        (for ([j u32 (uleb)]) (> j 0) (-= j 1)
          (set! i (uleb))
          (when (live? w i) (set! kept (cons (make-integer (renumbered w i)) kept))))
        (set! kept (reverse kept))
        (buffer-add-byte! (& q) 3)
        (buffer-add-byte! (& q) 0)
        (write-uleb (& q) (length kept))
        (while (pair? kept)
          (write-uleb (& q) (cast u64 (integer-value (car kept))))
          (set! kept (cdr kept)))))
    (section-out out 9 (& q))))

;; A body copied, with each function index written anew in as many bytes as before.
(define (body! [q (ptr buffer)] [w (ptr wasm)] [start u32] [end u32])
  (let ([from start] [b u32 0] [d datum 0] [ks datum 0] [here u32 0] [old u32 0])
    (read-from! (-> w p) start end)
    (for ([i u32 (uleb)]) (> i 0) (-= i 1)
      (uleb)
      (byte))
    (while (< (position) end)
      (set! b (byte))
      (unless (or (== b #x05) (== b #x0B))
        (set! d (decoding-of b (if (or (== b #xFC) (== b #x1C)) (uleb) 0)))
        (when (== d 0) (unreadable))
        (set! ks (cdr d))
        (while (pair? ks)
          (if (== (car ks) 'func)
              (begin
                (set! here (position))
                (set! old (uleb))
                (buffer-add! q (+ (-> w p) from) (- here from))
                (write-uleb-padded q (renumbered w old) (- (position) here))
                (set! from (position)))
              (skip-immediate (car ks)))
          (set! ks (cdr ks)))))
    (unless (== (position) end) (unreadable))
    (buffer-add! q (+ (-> w p) from) (- end from))))

(define (code! [out (ptr buffer)] [w (ptr wasm)] [news (ptr u32)])
  (let ([q (make-buffer)] [n (-> w count)] [size u32 0] [base u32 0] [kept u32 0] [before u32 0])
    (for ([k u32 0]) (< k n) (+= k 1) (when (live? w (+ (-> w nimports) k)) (+= kept 1)))
    (write-uleb (& q) kept)
    (for ([k u32 0]) (< k n) (+= k 1)
      (when (live? w (+ (-> w nimports) k))
        (set! size (- (@ (-> w ends) k) (@ (-> w starts) k)))
        (write-uleb (& q) size)
        (set! (@ news k) (-> q length))
        (set! before (-> q length))
        (body! (& q) w (@ (-> w starts) k) (@ (-> w ends) k))
        (unless (== (- (-> q length) before) size) (unreadable))))
    (set! base (+ (-> out length) 1 (uleb-length (-> q length))))
    (for ([k u32 0]) (< k n) (+= k 1) (+= (@ news k) base))
    (section-out out 10 (& q))))

(define (names! [out (ptr buffer)] [w (ptr wasm)] [start u32] [end u32])
  (let ([q (make-buffer)] [sub (make-buffer)] [id u32 0] [size u32 0] [next u32 0] [i u32 0] [s datum 0] [kept nil])
    (read-from! (-> w p) start end)
    (write-name (& q) (name))
    (while (< (position) end)
      (set! id (byte))
      (set! size (uleb))
      (set! next (+ (position) size))
      (if (== id 1)
          (begin
            (for ([n u32 (uleb)]) (> n 0) (-= n 1)
              (set! i (uleb))
              (set! s (name))
              (when (live? w i) (set! kept (cons (cons (make-integer i) s) kept))))
            (set! kept (reverse kept))
            (write-uleb (& sub) (length kept))
            (while (pair? kept)
              (write-uleb (& sub) (renumbered w (cast u32 (integer-value (car (car kept))))))
              (write-name (& sub) (cdr (car kept)))
              (set! kept (cdr kept)))
            (section-out (& q) 1 (& sub)))
          (begin
            (buffer-add-byte! (& q) (cast i32 id))
            (write-uleb (& q) size)
            (buffer-add! (& q) (+ (-> w p) (position)) size)))
      (read-from! (-> w p) next end))
    (section-out out 0 (& q))))

(define (locations! [out (ptr buffer)] [w (ptr wasm)] [start u32] [end u32] [news (ptr u32)])
  (let ([q (make-buffer)] [files u32 0] [at u32 0] [k u32 0] [entries nil] [prev u32 0] [o u32 0])
    (read-from! (-> w p) start end)
    (write-name (& q) (name))
    (set! files (position))
    (for ([i u32 (uleb)]) (> i 0) (-= i 1) (name))
    (buffer-add! (& q) (+ (-> w p) files) (- (position) files))
    (for ([i u32 (uleb)]) (> i 0) (-= i 1)
      (+= at (uleb))
      (let* ([file (uleb)] [line (uleb)] [col (uleb)])
        (while (and (< k (-> w count)) (>= at (@ (-> w ends) k))) (+= k 1))
        (when (and (< k (-> w count)) (>= at (@ (-> w starts) k)) (!= (@ (-> w live) (+ (-> w nimports) k)) 0))
          (set! entries (cons `(,(make-integer (+ (@ news k) (- at (@ (-> w starts) k)))) ,(make-integer file)
                                ,(make-integer line) ,(make-integer col))
                              entries)))))
    (set! entries (reverse entries))
    (write-uleb (& q) (length entries))
    (while (pair? entries)
      (set! o (cast u32 (integer-value (car (car entries)))))
      (write-uleb (& q) (- o prev))
      (set! prev o)
      (write-uleb (& q) (cast u64 (integer-value (cadr (car entries)))))
      (write-uleb (& q) (cast u64 (integer-value (caddr (car entries)))))
      (write-uleb (& q) (cast u64 (integer-value (cadddr (car entries)))))
      (set! entries (cdr entries)))
    (section-out out 0 (& q))))
