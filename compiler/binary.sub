;; The binary wasm encoder and assembler.
(require-unqualified macros "macros.sub")
(require-unqualified ops "ops.sub")
(require-unqualified leb "leb128.sub")

(provide wmodule encode-module asm new-asm asm-size instr! asm-location! link-body
         linked linked-bytes code-location decoding-of
         cell cell? cell-value set-cell-value!)

(struct wmodule [types datum] [imports datum] [funcs datum] [tables datum] [memories datum] [tags datum]
        [globals datum] [exports datum] [start datum] [slots datum] [datas datum] [names datum])

(const cell-kind u32 30)
(const linked-kind u32 31)

;; ---- byte output ----

(define (name! [p (ptr buffer)] [s string])
  (write-uleb p (-> s length))
  (buffer-add-string! p s))

(define (vec! [p (ptr buffer)] [items datum] [item! (fn ((ptr buffer) datum))])
  (write-uleb p (length items))
  (while (pair? items)
    (item! p (car items))
    (set! items (cdr items))))

(define (section! [p (ptr buffer)] [id i32] [q (ptr buffer)])
  (buffer-add-byte! p id)
  (write-uleb p (-> q length))
  (buffer-add! p (buffer-bytes q))
  (buffer-free! q))

(define (le-bytes! [p (ptr buffer)] [x u64] [n u32])
  (for ([i u32 0]) (< i n) (+= i 1) (buffer-add-byte! p (cast i32 (bit-and (>> x (* 8 i)) 255)))))

(define (uleb! [p (ptr buffer)] [n datum]) (write-uleb p (cast u64 (integer-value n))))

;; ---- types ----

(define (heap! [p (ptr buffer)] [h datum])
  (buffer-add-byte! p (case h [('func) #x70] [('exn) #x69] [else (encode-fail "unknown heap type ~s" h) 0])))

(define (valtype! [p (ptr buffer)] [t datum])
  (buffer-add-byte! p (case t
                        [('i32) #x7F] [('i64) #x7E] [('f32) #x7D] [('f64) #x7C]
                        [('funcref) #x70] [('exnref) #x69]
                        [else (encode-fail "unknown value type ~s" t) 0])))

(define (encode-fail [template string] [x datum])
  (raise-compile-error 0 (format-message "internal: encode: ~a" (cons (format template (cons x nil)) nil))))

(define (limits! [p (ptr buffer)] [lim datum])
  (let ([min (car lim)] [max (cadr lim)])
    (if (!= max 0)
        (begin (buffer-add-byte! p 1) (uleb! p min) (uleb! p max))
        (begin (buffer-add-byte! p 0) (uleb! p min)))))

(define (blocktype! [p (ptr buffer)] [bt datum])
  (cond [(null? bt) (buffer-add-byte! p #x40)]
        [(and (pair? bt) (== (car bt) 'type)) (write-sleb p (integer-value (cadr bt)))]
        [else (valtype! p bt)]))

;; ---- assembly ----
(struct reloc [offset u32] [kind datum] [key datum] [next (ptr reloc)])

(struct code-location [offset u32] [loc (ptr srcloc)] [next (ptr code-location)])

(struct asm [out buffer] [relocs (ptr reloc)] [locations (ptr code-location)] [pending (ptr srcloc)]
        [current (ptr srcloc)] [start (ptr srcloc)] [started bool] [else-pending bool])

(define (new-asm) -> (ptr asm)
  (let ([a (cast (ptr asm) (arena-alloc (current-arena) (sizeof asm)))])
    (set! (-> a out) (make-buffer))
    (set! (-> a relocs) 0)
    (set! (-> a locations) 0)
    (set! (-> a pending) 0)
    (set! (-> a current) 0)
    (set! (-> a start) 0)
    (set! (-> a started) #f)
    (set! (-> a else-pending) #f)
    a))

(define (asm-size [a (ptr asm)]) -> u32 (-> a out length))

(struct cell-record [self datum] [value datum])

(define (cell [v datum]) -> datum
  (let ([c (cast (ptr cell-record) (arena-alloc (current-arena) (sizeof cell-record)))])
    (set! (-> c self) (make-record-in (current-arena) cell-kind c))
    (set! (-> c value) v)
    (-> c self)))

(define (cell? [d datum]) -> bool (record? d cell-kind))
(define (cell-value [c datum]) -> datum (-> (cast (ptr cell-record) (record-pointer c)) value))
(define (set-cell-value! [c datum] [v datum]) (set! (-> (cast (ptr cell-record) (record-pointer c)) value) v))

(define (reloc! [a (ptr asm)] [kind datum] [key datum])
  (let ([r (cast (ptr reloc) (arena-alloc (current-arena) (sizeof reloc)))])
    (set! (-> r offset) (asm-size a))
    (set! (-> r kind) kind)
    (set! (-> r key) key)
    (set! (-> r next) (-> a relocs))
    (set! (-> a relocs) r)))

;; ---- source locations ----

(define code-locations (ptr code-location) 0)

(define (new-location [offset u32] [loc (ptr srcloc)] [next (ptr code-location)]) -> (ptr code-location)
  (let ([l (cast (ptr code-location) (arena-alloc (current-arena) (sizeof code-location)))])
    (set! (-> l offset) offset)
    (set! (-> l loc) loc)
    (set! (-> l next) next)
    l))

(define (same-location? [a (ptr srcloc)] [b (ptr srcloc)]) -> bool
  (or (== a b)
      (and (!= a 0) (!= b 0) (== (-> a source) (-> b source)) (== (-> a line) (-> b line)) (== (-> a col) (-> b col)))))

(define (asm-location! [a (ptr asm)] [loc (ptr srcloc)])
  (when (and (not (-> a started)) (== (asm-size a) 0))
    (set! (-> a start) loc)
    (set! (-> a started) #t)
    (set! (-> a current) loc))
  (set! (-> a pending) loc))

(define (note-location! [a (ptr asm)])
  (unless (same-location? (-> a pending) (-> a current))
    (set! (-> a locations) (new-location (asm-size a) (-> a pending) (-> a locations)))
    (set! (-> a current) (-> a pending))))

(define (source-locations! [p (ptr buffer)] [entries (ptr code-location)])
  (let ([files nil] [e entries] [n u32 0] [at u32 0])
    (while (!= e 0)
      (let ([l (-> e loc)])
        (when (and (!= l 0) (== (memq (-> l source) files) 0)) (set! files (cons (-> l source) files))))
      (+= n 1)
      (set! e (-> e next)))
    (set! files (reverse files))
    (name! p "source-locations")
    (write-uleb p (length files))
    (for-each (lambda ([f datum]) (name! p (symbol->string f))) files)
    (write-uleb p n)
    (set! e entries)
    (while (!= e 0)
      (let ([l (-> e loc)])
        (write-uleb p (- (-> e offset) at))
        (write-uleb p (if (!= l 0) (- (length files) (length (memq (-> l source) files))) 0))
        (write-uleb p (if (!= l 0) (-> l line) 0))
        (write-uleb p (if (!= l 0) (-> l col) 0))
        (set! at (-> e offset))
        (set! e (-> e next))))))

;; ---- instructions ----

(define encodings hash-table)
(define decodings hash-table)

(define (encoding! [op datum] [bytes datum] [kinds datum] [traps i32])
  (hash-set! (& encodings) (cast u64 op) (cast u32 `(,bytes ,kinds ,(boolean traps))))
  (hash-set! (& decodings) (opcode-key (cast u32 (integer-value (car bytes))) (if (pair? (cdr bytes)) (cast u32 (integer-value (cadr bytes))) 0))
             (cast u32 (cons op kinds))))

(define (opcode-key [b u32] [sub u32]) -> u64 (+ (* (cast u64 b) 65536) (cast u64 sub) 1))

(define (decoding-of [b u32] [sub u32]) -> datum (cast datum (hash-ref (& decodings) (opcode-key b sub))))

(define (defs! [traps i32] [specs datum])
  (while (pair? specs)
    (let ([s (car specs)])
      (encoding! (car s) (if (pair? (cadr s)) (cadr s) (cons (cadr s) nil)) (cddr s) traps))
    (set! specs (cdr specs))))

(define (define-encodings!)
  (defs! 0 '((nop #x01) (block #x02 blocktype) (loop #x03 blocktype) (if #x04 blocktype)
             (throw #x08 tag) (throw_ref #x0A) (br #x0C u) (br_if #x0D u) (br_table #x0E labels u) (return #x0F)
             (drop #x1A) (select #x1B) (select-typed (#x1C 1) valtype)
             (local.get #x20 u) (local.set #x21 u) (local.tee #x22 u) (global.get #x23 global) (global.set #x24 global)
             (i32.const #x41 s) (i64.const #x42 s) (f32.const #x43 f32) (f64.const #x44 f64)
             (ref.null #xD0 heap) (ref.func #xD2 func) (table.init (#xFC 12) u u) (elem.drop (#xFC 13) u)
             (table.grow (#xFC 15) u) (table.size (#xFC 16) u) (data.drop (#xFC 9) u)))
  (defs! 1 '((unreachable #x00) (try_table #x1F blocktype catches) (memory.init (#xFC 8) u u)
             (table.set #x26 u)
             (call #x10 func) (call_indirect #x11 type u) (return_call #x12 func) (return_call_indirect #x13 type u)))
  (for-each (lambda ([name datum])
              (let ([p (lookup-prim name)])
                (encoding! name (-> p code)
                           (case (-> p kind) [('mem) '(memarg)] [('memory) (if (== name 'memory.copy) '(u u) '(u))] [else nil])
                           (-> p traps))))
            (prim-names)))

(define defined i32 (begin (define-encodings!) 1))

(define (encoding-of [op datum]) -> datum
  (let ([e (cast datum (hash-ref (& encodings) (cast u64 op)))])
    (when (== e 0) (encode-fail "unknown instruction ~s" op))
    e))

(define (add-bytes! [p (ptr buffer)] [bytes datum])
  (while (pair? bytes)
    (buffer-add-byte! p (cast i32 (integer-value (car bytes))))
    (set! bytes (cdr bytes))))

(define (immediates! [p (ptr buffer)] [a (ptr asm)] [kinds datum] [args datum])
  (while (pair? kinds)
    (let ([kind (car kinds)] [arg (car args)])
      (cond [(== kind 'u) (uleb! p arg)]
            [(== kind 's) (write-sleb p (integer-value arg))]
            ;; (alignment offset memory)
            [(== kind 'memarg)
             (let ([memory (cast u64 (integer-value (caddr arg)))])
               (write-uleb p (+ (cast u64 (integer-value (car arg))) (if (== memory 0) 0 64)))
               (when (!= memory 0) (write-uleb p memory))
               (uleb! p (cadr arg)))]
            [(== kind 'labels)
             (write-uleb p (length arg))
             (while (pair? arg)
               (uleb! p (car arg))
               (set! arg (cdr arg)))]
            [(== kind 'f32) (le-bytes! p (cast u64 (cast u32 (f32-bits (cast f32 (flonum-value arg))))) 4)]
            [(== kind 'f64) (le-bytes! p (cast u64 (f64-bits (flonum-value arg))) 8)]
            [(== kind 'heap) (heap! p arg)]
            [(== kind 'valtype) (valtype! p arg)]
            [(== kind 'catches)
             (write-uleb p (length arg))
             (while (pair? arg)
               (catch! a (car arg))
               (set! arg (cdr arg)))]
            [else (reloc! a kind arg)]))
    (set! kinds (cdr kinds))
    (set! args (cdr args))))

(define (const! [p (ptr buffer)] [i datum])
  (let ([e (encoding-of (car i))])
    (add-bytes! p (car e))
    (immediates! p 0 (cadr e) (cdr i))))

(define (instr! [a (ptr asm)] [i datum])
  (let ([op (car i)] [p (& (-> a out))])
    (cond [(== op 'else) (set! (-> a else-pending) #t)]
          [(== op 'end) (set! (-> a else-pending) #f) (buffer-add-byte! p #x0B)]
          [else
           (when (-> a else-pending)
             (set! (-> a else-pending) #f)
             (buffer-add-byte! p #x05))
           (let ([e (encoding-of op)])
             (when (!= (caddr e) 0) (note-location! a))
             (add-bytes! p (car e))
             (immediates! p a (cadr e) (cdr i)))])))

(define (catch! [a (ptr asm)] [c datum])
  (let ([p (& (-> a out))] [kind (car c)])
    (cond [(== kind 'catch) (buffer-add-byte! p 0) (reloc! a 'tag (cadr c)) (uleb! p (caddr c))]
          [(== kind 'catch_ref) (buffer-add-byte! p 1) (reloc! a 'tag (cadr c)) (uleb! p (caddr c))]
          [(== kind 'catch_all) (buffer-add-byte! p 2) (uleb! p (cadr c))]
          [else (buffer-add-byte! p 3) (uleb! p (cadr c))])))

;; ---- linking ----

(struct linked [self datum] [bytes datum] [start (ptr srcloc)] [locations (ptr code-location)])

(define (linked-of [d datum]) -> (ptr linked) (cast (ptr linked) (record-pointer d)))
(define (linked-bytes [d datum]) -> datum (-> (linked-of d) bytes))

(define (reverse-relocs [r (ptr reloc)]) -> (ptr reloc)
  (let ([out (ptr reloc) 0] [next (ptr reloc) 0])
    (while (!= r 0)
      (set! next (-> r next))
      (set! (-> r next) out)
      (set! out r)
      (set! r next))
    out))

(define (reverse-locations [l (ptr code-location)]) -> (ptr code-location)
  (let ([out (ptr code-location) 0] [next (ptr code-location) 0])
    (while (!= l 0)
      (set! next (-> l next))
      (set! (-> l next) out)
      (set! out l)
      (set! l next))
    out))

(define (link-body [a (ptr asm)] [b (ptr asm)] [resolve (closure (datum datum) -> datum)]) -> datum
  (let ([q (make-buffer)] [notes (ptr code-location) 0]
        [l (cast (ptr linked) (arena-alloc (current-arena) (sizeof linked)))])
    (set! notes (link-segment! (& q) a resolve notes))
    (when (!= b 0)
      (when (-> b started) (set! notes (new-location (-> q length) (-> b start) notes)))
      (set! notes (link-segment! (& q) b resolve notes)))
    (set! (-> l self) (make-record-in (current-arena) linked-kind l))
    (set! (-> l bytes) (bytes->datum (buffer-bytes (& q))))
    (set! (-> l start) (-> a start))
    (set! (-> l locations) (reverse-locations notes))
    (buffer-free! (& q))
    (-> l self)))

(define (link-segment! [q (ptr buffer)] [a (ptr asm)] [resolve (closure (datum datum) -> datum)] [notes (ptr code-location)])
  -> (ptr code-location)
  (let ([raw (-> a out bytes)] [n (asm-size a)] [pos u32 0]
        [relocs (reverse-relocs (-> a relocs))] [locs (reverse-locations (-> a locations))] [next u32 0])
    (set! (-> a relocs) 0)
    (set! (-> a locations) 0)
    (while 1
      (set! next (cond [(and (!= relocs 0) (!= locs 0)) (if (< (-> relocs offset) (-> locs offset)) (-> relocs offset) (-> locs offset))]
                       [(!= relocs 0) (-> relocs offset)]
                       [(!= locs 0) (-> locs offset)]
                       [else n]))
      (when (< pos next) (buffer-add! q (slice (+ raw pos) (- next pos))))
      (set! pos next)
      (cond [(and (!= relocs 0) (== (-> relocs offset) next))
             (deferred! q relocs resolve)
             (set! relocs (-> relocs next))]
            [(and (!= locs 0) (== (-> locs offset) next))
             (set! notes (new-location (-> q length) (-> locs loc) notes))
             (set! locs (-> locs next))]
            [else
             (buffer-free! (& (-> a out)))
             (return notes)]))))

(define (deferred! [q (ptr buffer)] [r (ptr reloc)] [resolve (closure (datum datum) -> datum)])
  (let* ([kind (-> r kind)] [v (resolve kind (-> r key))])
    (cond [(!= (memq kind '(func global type tag)) 0) (uleb! q v)]
          [(== kind 'blocktype) (blocktype! q v)]
          [(== kind 'const) (const! q v)])))

;; ---- module ----

(define (type-entry! [p (ptr buffer)] [t datum])
  (let ([kind (car t)])
    (cond [(== kind 'func) (buffer-add-byte! p #x60) (vec! p (cadr t) valtype!) (vec! p (caddr t) valtype!)]
          [else (encode-fail "unknown type ~s" t)])))

(define (import! [p (ptr buffer)] [imp datum])
  (name! p (datum->string (car imp)))
  (name! p (datum->string (cadr imp)))
  (let ([kind (caddr imp)] [desc (cadddr imp)])
    (cond [(== kind 'func) (buffer-add-byte! p 0) (uleb! p desc)]
          [(== kind 'table) (buffer-add-byte! p 1) (buffer-add-byte! p #x70) (limits! p desc)]
          [(== kind 'memory) (buffer-add-byte! p 2) (limits! p desc)]
          [(== kind 'global) (buffer-add-byte! p 3) (valtype! p (car desc)) (buffer-add-byte! p (if (!= (cadr desc) 0) 1 0))]
          [else (buffer-add-byte! p 4) (buffer-add-byte! p 0) (uleb! p desc)])))

(define (global! [p (ptr buffer)] [g datum])
  (valtype! p (car g))
  (buffer-add-byte! p (if (!= (cadr g) 0) 1 0))
  (buffer-add! p (datum->bytes (caddr g)))
  (buffer-add-byte! p #x0B))

(define (export! [p (ptr buffer)] [e datum])
  (name! p (datum->string (car e)))
  (buffer-add-byte! p (case (cadr e)
                        [('func) 0] [('table) 1] [('memory) 2] [('global) 3] [else 4]))
  (uleb! p (caddr e)))

(define (func-type! [p (ptr buffer)] [f datum]) (uleb! p (car f)))
(define (table! [p (ptr buffer)] [t datum]) (buffer-add-byte! p #x70) (limits! p t))
(define (tag! [p (ptr buffer)] [t datum]) (buffer-add-byte! p 0) (uleb! p t))

(define (local-group! [p (ptr buffer)] [g datum]) (uleb! p (cdr g)) (valtype! p (car g)))

(define (code! [p (ptr buffer)] [f datum])
  (let* ([l (linked-of (caddr f))] [q (make-buffer)] [shift u32 0] [base u32 0])
    (vec! (& q) (group-locals (cadr f)) local-group!)
    (set! shift (-> q length))
    (buffer-add! (& q) (datum->bytes (-> l bytes)))
    (buffer-add-byte! (& q) #x0B)
    (write-uleb p (-> q length))
    (set! base (-> p length))
    (set! code-locations (new-location base (-> l start) code-locations))
    (let ([e (-> l locations)])
      (while (!= e 0)
        (set! code-locations (new-location (+ base shift (-> e offset)) (-> e loc) code-locations))
        (set! e (-> e next))))
    (buffer-add! p (buffer-bytes (& q)))
    (buffer-free! (& q))))

(define (data! [p (ptr buffer)] [d datum])
  (let ([b (datum->bytes d)])
    (buffer-add-byte! p 1)
    (write-uleb p (-> b length))
    (buffer-add! p b)))

(define (function-name! [p (ptr buffer)] [n datum]) (uleb! p (car n)) (name! p (datum->string (cdr n))))

(define (encode-module [m (ptr wmodule)] [p (ptr buffer)])
  (let ([q (make-buffer)])
    (buffer-add! p (slice (array-of u8 #x00 #x61 #x73 #x6D #x01 #x00 #x00 #x00)))
    (unless (null? (-> m types)) (set! q (make-buffer)) (vec! (& q) (-> m types) type-entry!) (section! p 1 (& q)))
    (unless (null? (-> m imports)) (set! q (make-buffer)) (vec! (& q) (-> m imports) import!) (section! p 2 (& q)))
    (unless (null? (-> m funcs)) (set! q (make-buffer)) (vec! (& q) (-> m funcs) func-type!) (section! p 3 (& q)))
    (unless (null? (-> m tables)) (set! q (make-buffer)) (vec! (& q) (-> m tables) table!) (section! p 4 (& q)))
    (unless (null? (-> m memories)) (set! q (make-buffer)) (vec! (& q) (-> m memories) limits!) (section! p 5 (& q)))
    (unless (null? (-> m tags)) (set! q (make-buffer)) (vec! (& q) (-> m tags) tag!) (section! p 13 (& q)))
    (unless (null? (-> m globals)) (set! q (make-buffer)) (vec! (& q) (-> m globals) global!) (section! p 6 (& q)))
    (unless (null? (-> m exports)) (set! q (make-buffer)) (vec! (& q) (-> m exports) export!) (section! p 7 (& q)))
    (when (!= (-> m start) 0) (set! q (make-buffer)) (uleb! (& q) (-> m start)) (section! p 8 (& q)))
    (unless (null? (-> m slots))
      (set! q (make-buffer))
      (write-uleb (& q) 1)
      (buffer-add-byte! (& q) 3)
      (buffer-add-byte! (& q) #x00)
      (vec! (& q) (-> m slots) uleb!)
      (section! p 9 (& q)))
    ;; The data count.
    (unless (null? (-> m datas)) (set! q (make-buffer)) (write-uleb (& q) (length (-> m datas))) (section! p 12 (& q)))
    ;; The code section.
    (set! code-locations 0)
    (set! q (make-buffer))
    (vec! (& q) (-> m funcs) code!)
    (let ([start (+ (-> p length) 1 (uleb-length (-> q length)))] [l (ptr code-location) 0])
      (if (null? (-> m funcs))
          (buffer-free! (& q))
          (section! p 10 (& q)))
      (set! code-locations (reverse-locations code-locations))
      (set! l code-locations)
      (while (!= l 0)
        (+= (-> l offset) start)
        (set! l (-> l next))))
    (unless (null? (-> m datas)) (set! q (make-buffer)) (vec! (& q) (-> m datas) data!) (section! p 11 (& q)))
    (let ([names (-> m names)])
      (when (!= names 0)
        (let ([sub (make-buffer)])
          (set! q (make-buffer))
          (name! (& q) "name")
          (name! (& sub) (datum->string (car names)))
          (section! (& q) 0 (& sub))
          (set! sub (make-buffer))
          (vec! (& sub) (cdr names) function-name!)
          (section! (& q) 1 (& sub))
          (section! p 0 (& q)))))
    (when (!= code-locations 0)
      (set! q (make-buffer))
      (source-locations! (& q) code-locations)
      (section! p 0 (& q)))))

(define (group-locals [types datum]) -> datum
  (let ([acc nil])
    (while (pair? types)
      (if (and (pair? acc) (equal? (car (car acc)) (car types)))
          (set! acc (cons (cons (car (car acc)) (make-integer (+ (integer-value (cdr (car acc))) 1))) (cdr acc)))
          (set! acc (cons (cons (car types) (make-integer 1)) acc)))
      (set! types (cdr types)))
    (reverse acc)))
