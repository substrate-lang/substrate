;; The server that run.mjs puts Caddy and nginx in front of, believing one proxy: /address answers the client's address
;; and scheme, /events sends two events half a second apart, /ws echoes WebSocket messages and pings after a second of
;; silence, and /slow answers after 1.5 s. SIGTERM shuts it down. It prints its URL once it listens.
(require-unqualified events "../../host/events.sub")
(require-unqualified timer "../../host/modules/timer.sub")
(require-unqualified http "../../lib/http/http.sub")
(require-unqualified server "../../lib/http/server.sub")
(require-unqualified sse "../../lib/http/sse.sub")
(require-unqualified ws "../../lib/http/websocket.sub")

(struct later [head event-head] [request (ptr http-request)] [stream (ptr sse-stream)])

(define server http-server)

(define (address! [r (ptr http-request)])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) (http-request-address r))
    (buffer-add-string! (& b) (if (http-request-https? r) " https" " http"))
    (http-answer-text! r 200 (buffer-string (& b)))
    (buffer-free! (& b))))

(define (then [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([l (cast (ptr later) tag)])
    (if (== (-> l stream) 0)
        (http-answer-text! (-> l request) 200 "slow")
        (begin
          (sse-send! (-> l stream) "" "" "two")
          (sse-close! (-> l stream))))
    (free l)))

(define (later! [r (ptr http-request)] [s (ptr sse-stream)] [ms f64])
  (let ([l (cast (ptr later) (calloc 1 (sizeof later)))])
    (set! (-> l head handle) then)
    (set! (-> l request) r)
    (set! (-> l stream) s)
    (timer-after ms (cast (ptr void) l))))

(define (echo [w (ptr ws-connection)] [message (slice u8)] [kind i32]) (ws-send! w message kind))

(define (handle [r (ptr http-request)])
  (let ([path (-> r target)])
    (cond [(== path "/address") (address! r)]
          [(== path "/events")
           (let ([s (cast (ptr sse-stream) (calloc 1 (sizeof sse-stream)))])
             (when (sse-accept! s r)
               (sse-send! s "" "" "one")
               (later! r s 500.0)))]
          [(== path "/ws")
           (let ([w (cast (ptr ws-connection) (calloc 1 (sizeof ws-connection)))])
             (when (ws-accept! w r "")
               (set! (-> w ping) 1000.0)
               (set! (-> w on-message) echo)))]
          [(== path "/slow") (later! r 0 1500.0)]
          [else (http-answer-text! r 404 "not found")])))

(define (listening [s (ptr http-server)])
  (let ([line (make-buffer)])
    (buffer-add-string! (& line) "http://127.0.0.1:")
    (http-add-decimal! (& line) (cast i64 (-> s port)))
    (buffer-add-string! (& line) "/\n")
    (host-write 1 (buffer-bytes (& line)))
    (buffer-free! (& line))))

(define (main)
  (set! (-> server proxies) 1)
  (set! (-> server compress) 6)
  (set! (-> server listening) listening)
  (http-stop-on-signals! (& server) 5000.0 0)
  (http-serve! (& server) 0 handle))
