;; Tests of host/worker.sub: the arguments it gives workers, and waiting for a worker's events.
(require-unqualified std/test/test)
(require-unqualified host/events)
(require-unqualified host/modules/clock)
(require-unqualified host/worker)

(define (shows-args) (printf "~a ~a~n" (-> (host-args) length) (@ (host-args) 1)))

(test args #:output "2 b"
  (let ([o worker-options] [why string])
    (worker-options-init! (& o))
    (set! (-> o args) (slice (array-of string "a" "b")))
    (set! (-> o ends) #t)
    (expect (!= (worker-start shows-args (slice (cast (ptr u8) 0) 0) (& o) 0 (& why)) 0))))

;; ---- waiting ----

(struct waited [kind i32] [value i32] [text string])

(define (wait-for [w u32] [ms u32]) -> waited
  (let ([value i32 0] [bytes (slice u8)] [kind i32 0])
    (set! kind (worker-wait w ms (& value) (& bytes)))
    (waited #:kind kind #:value value #:text (cast string bytes))))

(define (next-kind [w u32] [ms u32]) -> i32 (let ([r (wait-for w ms)]) (-> r kind)))

(define (next-text [w u32] [ms u32]) -> string (let ([r (wait-for w ms)]) (-> r text)))

(define (echo-heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (and (== kind worker-message) (== id 0))
    (let ([b (events-take)])
      (worker-send 0 b)
      (free (-> b items)))))

(define (echoes) (event-handler! worker-source echo-heard))

(define (none) -> (slice u8) (slice (cast (ptr u8) 0) 0))

(test wait-replies
  (let* ([why string] [w (worker-start echoes (none) 0 0 (& why))])
    (expect (!= w 0))
    (expect-equal (next-kind w 10000) (cast i32 worker-done))
    (worker-send-text w "one")
    (let ([r (wait-for w 10000)])
      (expect-equal (-> r kind) (cast i32 worker-message))
      (expect-equal (-> r text) "one"))
    (expect-equal (next-kind w 10000) (cast i32 worker-done))
    (worker-send-text w "two")
    (expect-equal (next-text w 10000) "two")
    (worker-stop w)))

(define (idle) (begin))

(test wait-times-out
  (let* ([why string] [w (worker-start idle (none) 0 0 (& why))] [start f64 0.0])
    (expect-equal (next-kind w 10000) (cast i32 worker-done))
    (set! start (clock-monotonic))
    (expect-equal (next-kind w 100) 0)
    (expect (>= (- (clock-monotonic) start) 95.0))
    (worker-stop w)))

(define (prints-and-ends)
  (printf "hello~n")
  (host-exit 3 "bye"))

;; Starts f on a worker that ends as a program does, and waits for its end, collecting what it prints in printed.
(define (ending [f (fn ())] [printed (ptr buffer)]) -> waited
  (let ([o worker-options] [why string] [w u32 0] [r waited])
    (worker-options-init! (& o))
    (set! (-> o output) #t)
    (set! (-> o ends) #t)
    (set! w (worker-start f (none) (& o) 0 (& why)))
    (set! r (wait-for w 10000))
    (while (or (== (-> r kind) (cast i32 worker-stdout)) (== (-> r kind) (cast i32 worker-done)))
      (buffer-add-string! printed (-> r text))
      (set! r (wait-for w 10000)))
    (expect-equal (next-kind w 10) -1)
    r))

(test wait-ended
  (let* ([printed (make-buffer)] [r (ending prints-and-ends (& printed))])
    (expect-equal (buffer-string (& printed)) "hello\n")
    (expect-equal (-> r kind) (cast i32 worker-ended))
    (expect-equal (-> r value) 3)
    (expect-equal (-> r text) "bye")))

(define (prints) (printf "done~n"))

(test wait-ended-by-itself
  (let* ([printed (make-buffer)] [r (ending prints (& printed))])
    (expect-equal (buffer-string (& printed)) "done\n")
    (expect-equal (-> r kind) (cast i32 worker-ended))
    (expect-equal (-> r value) 0)))

(test wait-not-running (expect-equal (next-kind 12345 10) -1))

(define (says-hi) (worker-send 0 (cast (slice u8) "hi")))

(define listener event-head)

(define (overheard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (== kind worker-message) (throw test-failed "the worker's tag got an event that worker-wait took")))

(test wait-takes
  (let ([o worker-options] [why string] [w u32 0])
    (worker-options-init! (& o))
    (set! (-> o ends) #t)
    (set! (-> listener handle) overheard)
    (set! w (worker-start says-hi (none) (& o) (cast (ptr void) (& listener)) (& why)))
    (expect-equal (next-text w 10000) "hi")))
