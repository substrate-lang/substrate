;; Tests on workers of their own (std/test/test.sub), and workers' arguments.
(require-unqualified tests std/test/test)
(require-unqualified worker host/worker)

(test options #:worker
  (expect (> (-> (test-option "--scratch") length) 0))
  (expect (> (-> (scratch-directory) length) 0)))

(define (shows-args) (printf "~a ~a~n" (-> (host-args) length) (@ (host-args) 1)))

(test args #:worker #:output "2 b"
  (let ([o worker-options] [why string])
    (worker-options-init! (& o))
    (set! (-> o args) (slice (array-of string "a" "b")))
    (set! (-> o ends) #t)
    (expect (!= (worker-start shows-args (slice (cast (ptr u8) 0) 0) (& o) 0 (& why)) 0))))
