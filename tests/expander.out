(func (sbrk (n i32))
  ->
  i32
  (let ((p brk))
    (let ((end (i32.and (i32.add (i32.add brk n) (#%datum 7)) (#%datum -8))))
      (let ((size (i32.shl (memory.size) (#%datum 16))))
        (let ((need (i32.shr_u (i32.add (i32.sub end size) (#%datum 65535))
                      (#%datum 16))))
          (let ()
            (if (i32.gt_u end size)
              (if (i32.lt_s (memory.grow (if (i32.gt_u (memory.size) need)
                                           (memory.size)
                                           need))
                    (#%datum 0))
                (if (i32.lt_s (memory.grow need) (#%datum 0))
                  (return (#%datum 0)))))
            (set! brk end)
            p))))))
