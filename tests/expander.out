;; tests/basics.sub
(func (fact (n i64))
  ->
  i64
  (if (i64.le_s n (#%datum 1))
    (#%datum 1)
    (i64.mul n (#%app fact (i64.sub n (#%datum 1))))))
(func (count-down (n i32) (acc i32))
  ->
  i32
  (if (i32.eqz n)
    acc
    (#%app count-down (i32.sub n (#%datum 1)) (i32.add acc (#%datum 1)))))
(func (sum-to (n i32))
  ->
  i32
  (let ((i (#%datum 0)) (acc (#%datum 0)))
    (block done
      (loop next
        (br-if done (i32.gt_s i n))
        (set! acc (i32.add acc i))
        (set! i (i32.add i (#%datum 1)))
        (br next)))
    acc))
(func (first-multiple (k i32) (from i32))
  ->
  i32
  (block found
    (loop next
      (if (i32.eqz (i32.rem_u from k)) (br found from))
      (set! from (i32.add from (#%datum 1)))
      (br next))))
(global counter (mut i32) (#%datum 0))
(func (bump) (set! counter (i32.add counter (#%datum 1))))
(func (main)
  (#%checked body
    main
    ()
    #f
    '(void)
    (printf "~a\n" (wasm:i32.wrap_i64 (fact 12)))
    (printf "~a\n" (count-down 1000000 0))
    (printf "~a\n" (sum-to 100))
    (printf "~a\n" (first-multiple 7 50))
    (printf "~a\n" (wasm:i32.trunc_f64_s (wasm:f64.mul 2.5 4)))
    (bump)
    (bump)
    (bump)
    (printf "~a\n" counter)
    (printf "~a\n" (let* ((a 3) (b (wasm:i32.mul a a))) (wasm:i32.add a b)))
    (printf "~a\n" (wasm:select 10 20 (wasm:i32.gt_s 3 2)))
    (printf "~a~a~a\n" #t #f #\a)))
(#%fact main '(substrate-function () void))
