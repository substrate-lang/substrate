;; Two files with the same source are two modules, each with its own state.
(require-unqualified tests std/test/test)
(require a "fixtures/twin-a/counter.sub")
(require b "fixtures/twin-b/counter.sub")
(define (main)
  (printf "~a\n" (a:bump))
  (printf "~a\n" (b:bump)))

(test module-copies (expect-output "1\n1" (main)))
