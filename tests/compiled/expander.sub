;; Prints the fully expanded code of modules, or their errors.
(require-unqualified compiler/macros)
(require-unqualified compiler/expander)
(require-unqualified compiler/roots)
(require-unqualified compiler/main)
(provide main)

(define (expand [path datum])
  (printf ";; ~a\n" path)
  (try (expand-module-file 0 path (lambda ([f datum]) (print-expanded f)))
       [catch compile-error (message blamed loc)
        (let ([b (make-buffer)])
          (write-compile-error (& b) message blamed loc)
          (host-write 1 (buffer-bytes (& b)))
          (buffer-free! (& b)))]))

(define (main)
  (set-toolchain-directory! `"../substrate")
  (install-core!)
  (for-each (lambda ([f datum]) (expand f))
            `("compiled/basics.sub" "compiled/globals.sub" "compiled/decimals.sub"
              "compiled/module-copies.sub" "compiled/cache-tags.sub" "compiled/provide-all.sub"
              "../substrate/compiler/substrate.sub"
              "fail/err-unbound.sub" "fail/err-duplicate.sub" "fail/err-type.sub"
              "fail/err-cycle.sub" "fail/err-provide-twice.sub" "fail/err-number-range.sub"
              "fail/err-immutable.sub" "compiled/err-uncaught.sub" "fail/err-try-clause.sub"
              "fail/err-global-init.sub" "fail/err-fact-before.sub")))
