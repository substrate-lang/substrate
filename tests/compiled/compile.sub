;; Builds modules and prints each wasm module's name and hash, or the error.
(require-unqualified macros compiler/macros)
(require-unqualified ex compiler/expander)
(require-unqualified rt compiler/roots)
(require-unqualified fs host/fs)

(define (show [name datum] [bytes (slice u8)]) (printf "~a ~a\n" name (content-hash (cons (string->datum (cast string bytes)) nil))))

(define (build [path datum])
  (printf ";; ~a\n" path)
  (try (for-each (lambda ([l datum]) (show (car l) (datum->bytes (cdr l)))) (program-wasm-modules (compile-module-file 0 path)))
       [catch compile-error (message blamed loc)
        (let ([b (make-buffer)])
          (write-compile-error (& b) message blamed loc)
          (host-write 1 (buffer-bytes (& b)))
          (buffer-free! (& b)))]))

(define (file-bytes [path string]) -> (slice u8)
  (let ([f (slice u8)])
    (when (< (fs-read-file path (& f) 0) 0) (printf "cannot read ~a\n" path))
    f))

(define (built [dir string])
  (let* ([b (make-buffer)] [names (slice u8)] [start u32 0])
    (buffer-add-string! (& b) dir)
    (buffer-add-string! (& b) "/program")
    (set! names (file-bytes (buffer-string (& b))))
    (for ([i u32 0]) (< i (-> names length)) (+= i 1)
      (when (== (@ names i) 10)
        (let ([name (cast string (slice names start i))] [path (make-buffer)] [module (slice u8)])
          (buffer-add-string! (& path) dir)
          (buffer-add-string! (& path) "/")
          (buffer-add-string! (& path) name)
          (buffer-add-string! (& path) ".wasm")
          (set! module (file-bytes (buffer-string (& path))))
          (show (string->datum name) module)
          (free (-> module items))
          (buffer-free! (& path)))
        (set! start (+ i 1))))
    (free (-> names items))
    (buffer-free! (& b))))

(define (main)
  (let ([args (host-args)])
    (if (> (-> args length) 0)
        (built (@ args 0))
        (begin
          (set-toolchain-directory! `"../../substrate")
          (install-core!)
          (for-each (lambda ([f datum]) (build f))
                    `("basics.sub" "globals.sub" "decimals.sub"
                      "module-copies.sub" "cache-tags.sub" "provide-all.sub"
                      "../../substrate/compiler/substrate.sub"
                      "../fail/err-type.sub" "../fail/err-immutable.sub" "../fail/err-global-init.sub"
                      "../fail/err-inline-table.sub"
                      "../fail/err-try-clause.sub"
                      "../fail/err-open-application.sub" "../programs/err-start-trap.sub" "err-uncaught.sub"))))))
