;; Builds modules and prints each wasm module's name and hash, or the error.
(require-unqualified compiler/macros)
(require-unqualified compiler/expander)
(require-unqualified compiler/roots)
(provide main)

(define (show [name datum] [bytes (slice u8)]) (printf "~a ~a\n" name (content-hash (cons (string->datum (cast string bytes)) nil))))

(define (build [path datum])
  (printf ";; ~a\n" path)
  (try (for-each (lambda ([l datum]) (show (car l) (datum->bytes (cdr l)))) (program-wasm-modules (compile-module-file 0 path)))
       [catch compile-error (message blamed loc)
        (let ([b (make-buffer)])
          (write-compile-error (& b) message blamed loc)
          (host-write 1 (buffer-bytes (& b)))
          (buffer-free! (& b)))]))

(define (main)
  (set-toolchain-directory! `"../substrate")
  (install-core!)
  (for-each (lambda ([f datum]) (build f))
            `("compiled/basics.sub" "compiled/globals.sub" "compiled/decimals.sub"
              "compiled/module-copies.sub" "compiled/cache-tags.sub" "compiled/provide-all.sub"
              "../substrate/compiler/substrate.sub"
              "fail/err-type.sub" "fail/err-immutable.sub" "fail/err-global-init.sub"
              "fail/err-inline-table.sub"
              "fail/err-try-clause.sub"
              "fail/err-open-application.sub" "programs/err-start-trap.sub" "compiled/err-uncaught.sub")))
