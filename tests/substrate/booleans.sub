;; bool: its size and layout, what becomes 0 or 1, bool in arithmetic and in memory, and printing.

(struct flags [on bool] [count u8] [off bool])

(define (positive? [x i32]) -> bool (> x 0))
(define (as-bool [x i32]) -> bool x)
(define (as-number [b bool]) -> i32 b)

(define marks (array bool 4) (array-of bool #t #f #f #t))

(define (main)
  (printf "~a ~a ~a\n" (sizeof bool) (sizeof flags) (offsetof flags off))
  (printf "~a ~a ~a ~a\n" #t #f (< 1 2) (positive? -3))
  (let ([none (ptr u8) 0] [some (ptr u8) "x"])
    (printf "~a ~a ~a ~a ~a\n" (as-bool 5) (as-bool 0) (cast bool 2.5) (cast bool none) (cast bool some)))
  (let ([n i32 (+ (== 1 1) (== 2 2) (== 1 2))] [x u8 #t] [y i64 (< 1 2)] [z f64 #t])
    (printf "~a ~a ~a ~a ~a\n" n x y z (as-number (> 2 1))))
  (printf "~a ~a ~a ~a ~a\n" (and 1 2) (or 0 0) (not 5) (and) (or))
  (let ([f flags])
    (set! (-> f on) 7)
    (set! (-> f count) 9)
    (set! (-> f off) (> 1 2))
    (printf "~a ~a ~a ~a ~a\n" (-> f on) (-> f count) (-> f off) (@ marks 3) (sizeof (array bool 3))))
  (let ([i 0] [p (ptr u8) 0])
    (while #t (+= i 1) (when (== i 3) (break)))
    (printf "~a ~a ~a ~s\n" i (if (< i 5) #t #f) (== p 0) (== i 3))))
