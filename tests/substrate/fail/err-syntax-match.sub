;; A syntax-match no clause matches, in a Substrate macro, is an error blamed on its subject.
(begin-for-syntax
  (require-unqualified macros compiler/macros)
  (define (swap! [stx datum]) -> datum
    (syntax-match stx
      [(_ (? identifier? a) (? identifier? b)) #`(let ([t #,a]) (set! #,a #,b) (set! #,b t))])))
(define-syntax swap! swap!)
(define (run) (let ([x 1]) (swap! x 2)))
(define (main) (run))
