;; Inline Substrate functions called from another module, compiled as their bodies.
(require-unqualified std/test/test)
(require lib "../fixtures/substrate-inline-lib.sub" counter bump! clamp sum-to dist2 greeting twice-clamped)

(define (show [x i32]) (printf "~a\n" x))

(define (main)
  (let ([c counter])
    (set! (-> (& c) n) 40)
    (bump! (& c) 2)
    (show (-> (& c) n)))
  (show (clamp -5 0 10))
  (show (clamp 50 0 10))
  (show (clamp 7 0 10))
  (show (sum-to 10))
  (show (dist2 3 4))
  (show (-> (greeting) length))
  (show (twice-clamped 99)))

(test inline (expect-output-file "inline.out" (main)))
