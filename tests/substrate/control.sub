;; cond, case, array-of, endless loops, returns without a value, match of a null pointer.

(require-unqualified std/test/test)
(define (show [x i32]) (printf "~a " x))

(define (sign [x i32]) -> i32
  (cond [(< x 0) -1]
        [(== x 0) 0]
        [else 1]))

(define (note [x i32])
  (cond [(> x 100) (show 100)]
        [(> x 10) (show 10)]))

(define (kind [c i32]) -> i32
  (case c
    [(#\a #\e #\i #\o #\u) 1]
    [(#\space #\tab #\newline) 2]
    [else 0]))

(define counter i32 0)
(define (next) -> i32 (+= counter 1) counter)

(define (first-square-above [n i32]) -> i32
  (let ([i 0])
    (while #t
      (when (> (* i i) n) (return (* i i)))
      (+= i 1))))

(define (count-to [n i32]) -> i32
  (let ([i 0])
    (while #t
      (when (== i n) (break))
      (+= i 1))
    i))

(define (twice [x i32]) (show (* 2 x)))

(define (early [x i32])
  (when (> x 0) (return (twice x)))
  (show -1))

(struct point [x i32] [y i32])

(define primes (array i32 5) (array-of i32 2 3 5 7 11))

(define (arrays)
  (let ([names (array-of string "zero " "one " "two ")] [ps (array-of point (point-at 1 2) (point-at 3 4))])
    (printf "~a" (@ names 2))
    (show (+ (-> (@ ps 1) x) (-> (@ ps 0) y)))
    (show (@ primes 4))))

(define (point-at [x i32] [y i32]) -> point
  (let ([p point])
    (set! (-> p x) x)
    (set! (-> p y) y)
    p))

(variant shape [circle [r i32]] [square [side i32]])

(define (area [s (ptr shape)]) -> i32
  (match s
    [0 0]
    [(circle r) (* 3 r r)]
    [(square side) (* side side)]))

(define (named [s (ptr shape)]) -> i32
  (match s
    [(circle r) 1]
    [_ 0]))

(define (main)
  (show (sign -5)) (show (sign 0)) (show (sign 7))
  (note 50) (note 500) (note 5)
  (show (kind #\e)) (show (kind #\space)) (show (kind #\z))
  (show (case (next) [(1) 10] [(2) 20] [else 30]))
  (show counter)
  (printf "\n")
  (show (first-square-above 50)) (show (count-to 7))
  (early 4) (early -4)
  (printf "\n")
  (arrays)
  (printf "\n")
  (let ([c shape (circle 2)])
    (show (area (& c)))
    (show (area 0))
    (show (named (& c)))
    (show (named 0)))
  (printf "\n"))

(test control (expect-output-file "control.out" (main)))
