(require-unqualified std/test/test)
(struct point [x i32] [y i32])
(struct rect [min point] [max point])
(struct named [name string] [at point])
(variant shape [circle [r f64]] [poly [w i32] [h i32]] [dot])
(union bits [f f32] [u u32])

(define (origin) -> point (point #:y 0 #:x 0))
(define (sum [p point]) -> i32 (+ (-> p x) (-> p y)))
(define corner point (point #:x 3 #:y 4))

(test fields
  (let ([p (point #:y 2 #:x 1)])
    (expect-equal (-> p x) 1)
    (expect-equal (-> p y) 2)))

(test nested
  (let ([r (rect #:min (point #:x 0 #:y 0) #:max (point #:x 5 #:y 6))])
    (expect-equal (-> r max y) 6)))

(test argument-result-global
  (expect-equal (sum (point #:x 10 #:y 20)) 30)
  (expect-equal (-> (origin) y) 0)
  (expect-equal (-> corner y) 4))

(test swapped
  (let ([p (point #:x 1 #:y 2)])
    (set! p (point #:x (-> p y) #:y (-> p x)))
    (expect-equal (-> p x) 2)
    (expect-equal (-> p y) 1)))

(test printed
  (let ([n (named #:name "here" #:at (point #:x 9 #:y -8))])
    (expect-output "(named #:name here #:at (point #:x 9 #:y -8)) (named #:name \"here\" #:at (point #:x 9 #:y -8))"
      (printf "~a ~s" n n))))

(test printed-variants
  (let ([v bits])
    (expect-output "(circle 2.5) (poly 3 4) (dot) #<bits>" (printf "~a ~a ~a ~a" (circle 2.5) (poly 3 4) (dot) v))))
