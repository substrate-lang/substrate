(require-unqualified tests std/test/test)
(require wasm compiler/wasm)

(wasm:tag oops (i32))
(wasm:global counter (mut i32) 0)
(struct point [x i32] [y i32])
(define pt point)

(define (checked-add [x i32] [limit i32]) -> i32
  (wasm:try ((catch oops (v) (- 0 v)) (catch-all -1))
    (when (> x limit) (wasm:throw oops x))
    (+ x 1)))

(define (first-point [k i32]) -> (ptr point)
  (wasm:block done
    (when (> k 0) (wasm:br done (& pt)))
    (cast (ptr point) 0)))

(define (bump) (+= counter 1))

(wasm:func (point-address) -> i32 (& pt))

(define (main)
  (printf "~a\n" (checked-add 41 100))
  (printf "~a\n" (checked-add 200 100))
  (set! (-> pt x) 5)
  (printf "~a\n" (-> (first-point 1) x))
  (printf "~a\n" (cast i32 (first-point 0)))
  (bump) (bump) (bump)
  (printf "~a\n" counter)
  (printf "~a\n" (- (point-address) (cast i32 (& pt)))))

(test core-forms (expect-output-file "core-forms.out" (main)))
