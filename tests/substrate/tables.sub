;; Global arrays of number literals, read and changed, and in a program's modules only when something kept reads them.
(require-unqualified tables "../fixtures/tables.sub")

(define (holds? [p (ptr u8)] [n u32] [mark u64]) -> i32
  (let ([m (array u64 1)])
    (set! (@ m 0) mark)
    (for ([i u32 0]) (<= (+ i 8) n) (+= i 1)
      (when (== (memcmp (+ p i) m 8) 0) (return 1)))
    0))

(define (in-program? [mark u64]) -> i32
  (let ([names (host-program-modules)])
    (for ([i u32 0]) (< i (-> names length)) (+= i 1)
      (let ([bytes (host-module-bytes (@ names i))])
        (when (holds? (-> bytes items) (-> bytes length) mark) (return 1))))
    0))

(define (main)
  (printf "~a ~a ~a ~a\n" (@ bytes8 0) (@ bytes8 1) (@ bytes8 2) (@ bytes8 3))
  (printf "~a ~a ~a\n" (@ signed 0) (@ signed 1) (@ signed 2))
  (printf "~a ~a ~a ~a\n" (@ words 0) (@ words 1) (@ words 2) first-word)
  (printf "~a ~a\n" (@ longs 0) (@ longs 1))
  (printf "~a ~a ~a\n" (@ singles 0) (@ singles 1) (@ singles 2))
  (printf "~a ~a ~a\n" (@ doubles 0) (@ doubles 1) (@ doubles 2))
  (set! (@ bytes8 0) 7)
  (printf "~a ~a\n" (@ bytes8 0) (kept-mark 1))
  (printf "kept: ~a, dropped: ~a\n" (in-program? #x8877665544332211) (in-program? #xFEDCBA9876543210)))
