;; Numbers written with the fewest digits that read back, halfway cases taking the even digit; long and extreme numbers;
;; and random doubles and floats written and read back.

(define seed u64 88172645463325252)

(define (random) -> u64
  (set! seed (bit-xor seed (<< seed 13)))
  (set! seed (bit-xor seed (>> seed 7)))
  (set! seed (bit-xor seed (<< seed 17)))
  seed)

(define (again [x f64] [single i32]) -> f64
  (let ([b (make-buffer)] [ds (array u8 24)] [k 0] [y f64 0])
    (set! k (shortest-digits x single ds))
    (buffer-add-string! (& b) "0.")
    (buffer-add-string! (& b) (string-at ds))
    (buffer-add-byte! (& b) #\e)
    (when (< k 0) (buffer-add-byte! (& b) #\-))
    (write-digits (& b) (cast u64 (if (< k 0) (- k) k)) 10)
    (unless (read-decimal (-> b bytes) (-> b length) (& y)) (set! y 0.0))
    (buffer-free! (& b))
    y))

(define (main)
  (let ([failed 0] [t (array u32 1)] [x f64 0] [f f32 0] [ds (array u8 4)])
    (printf "~a ~a ~a ~a\n" 1125899906842624.25 1125899906842624.75 (cast f32 3414313.25) (cast f32 5000.90625))
    (printf "~a ~a ~a ~a\n" -65.613616999999977 1e23 123456789012345678901234567890.0 0.000001234)
    (printf "~a ~a ~a ~a\n" 5e-324 2.2250738585072014e-308 1.7976931348623157e308 (cast f32 1e-45))
    (set! (@ ds 0) 1)
    (set! (@ ds 1) 2)
    (set! (@ ds 2) 5)
    (printf "~a ~a\n" (decimal-flonum ds 3 -2 0) (decimal-flonum ds 3 -400 1))
    (for ([i 0]) (< i 100000) (+= i 1)
      (set! x (bits-f64 (cast i64 (bit-and (random) 9223372036854775807))))
      (when (and (== x x) (!= x (/ 1.0 0.0)) (!= x 0.0) (!= (f64-bits (again x 0)) (f64-bits x))) (+= failed 1))
      (set! (@ t 0) (cast u32 (bit-and (random) 2147483647)))
      (set! f (@ (cast (ptr f32) t) 0))
      (when (and (== f f) (!= f (/ 1.0 0.0)) (!= f 0.0) (!= (f32-bits (cast f32 (again (cast f64 f) 1))) (f32-bits f)))
        (+= failed 1)))
    (printf "~a of 100000 doubles and 100000 floats read back differently\n" failed)))
