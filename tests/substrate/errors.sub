(require-unqualified build std/test/build)

(test err-closure (expect-compile-error "fail/err-closure.sub" "err-closure.sub:3:28: error: a closure cannot be a result"))
(test err-copied-table (expect-compile-error "fail/err-copied-table.sub" "apply1 is copied, so it may not use a table"))
(test err-decimal-pointer (expect-compile-error "fail/err-decimal-pointer.sub" "err-decimal-pointer.sub:7:22: error: expected (ptr point), got f64"))
(test err-false-pointer (expect-compile-error "fail/err-false-pointer.sub" "err-false-pointer.sub:4:21: error: expected (ptr u8), got bool"))
(test err-fn-type (expect-compile-error "fail/err-fn-type.sub" "err-fn-type.sub:4:43: error: expected (fn (i32) -> i32), got (fn (u64) -> u64)"))
(test err-generic (expect-compile-error "fail/err-generic.sub" "err-generic.sub:4:25: error: zero's type T is not known from its arguments"))
(test err-generic-argument (expect-compile-error "fail/err-generic-argument.sub" "err-generic-argument.sub:7:18: error: expected (ptr (box i32)), got (ptr (box f64))"))
(test err-generic-partly (expect-compile-error "fail/err-generic-partly.sub" "err-generic-partly.sub:8:17: error: expected (ptr (pair i32 U)), got (ptr i32)"))
(test err-if-branch (expect-compile-error "fail/err-if-branch.sub" "err-if-branch.sub:3:45: error: expected string, got 0"))
(test err-inline-table (expect-compile-error "fail/err-inline-table.sub" "apply1 is inline, so it may not use a table"))
(test err-literal-arithmetic (expect-compile-error "fail/err-literal-arithmetic.sub" "err-literal-arithmetic.sub:3:31: error: + takes numbers, not string and i32"))
(test err-literal-compare (expect-compile-error "fail/err-literal-compare.sub" "err-literal-compare.sub:3:53: error: == compares a string literal with a string, not with (ptr u8)"))
(test err-match (expect-compile-error "fail/err-match.sub" "err-match.sub:5:33: error: this match does not cover rect"))
(test err-match-arm (expect-compile-error "fail/err-match-arm.sub" "err-match-arm.sub:5:72: error: expected string, got 0"))
(test err-match-null (expect-compile-error "fail/err-match-null.sub" "err-match-null.sub:7:6: error: this match takes a variant, not a pointer to one, which is never 0"))
(test err-printf-directive (expect-compile-error "fail/err-printf-directive.sub" "expected ~a, ~s, ~n or ~~ in the template"))
(test err-printf-values (expect-compile-error "fail/err-printf-values.sub" "the template has more ~a and ~s than there are values"))
(test err-rethrow (expect-compile-error "fail/err-rethrow.sub" "err-rethrow.sub:2:16: error: not in a try's handler"))
(test err-slice-compare (expect-compile-error "fail/err-slice-compare.sub" "err-slice-compare.sub:3:69: error: == compares numbers, pointers or strings, not (slice i32) and (slice i32)"))
(test err-slice-count (expect-compile-error "fail/err-slice-count.sub" "err-slice-count.sub:4:42: error: from 0 to 100 is out of range for length 64"))
(test err-slice-part (expect-compile-error "fail/err-slice-part.sub" "err-slice-part.sub:3:56: error: a string's or a slice's parts are not set: make another with slice"))
(test err-string-set (expect-compile-error "fail/err-string-set.sub" "err-string-set.sub:3:40: error: a string's bytes are not changed: cast it to (slice u8)"))
(test err-syntax-match (expect-compile-error "fail/err-syntax-match.sub" "err-syntax-match.sub:8:28: error: swap!: expected (swap! a b)"))
(test err-syntax-match-pattern (expect-compile-error "fail/err-syntax-match-pattern.sub" "err-syntax-match-pattern.sub:3:55: error: syntax-match: this pattern variable appears twice in its pattern"))
(test err-type (expect-compile-error "fail/err-type.sub" "err-type.sub:3:38: error: expected i32, got (ptr i32)"))
(test err-values-result (expect-compile-error "fail/err-values-result.sub" "err-values-result.sub:2:35: error: expected (values i32 i32), got 1"))
(test err-zero-string (expect-compile-error "fail/err-zero-string.sub" "err-zero-string.sub:3:26: error: expected string, got 0"))
