;; Traps in Substrate code, each reported with its message and where the code that traps is.
(require gr "../fixtures/generic-ratio.sub")

;; A trap in an instance of this file's generic function is reported in this file.
(struct #:forall (T) box [value T])
(define #:forall (T) (ratio [b (ptr (box T))] [d i32]) -> i32 (/ 100 d))
(define b (box i32))

(test err-generic-trap-here #:traps "traps.sub:6:63" (ratio (& b) 0))

;; A trap in an instance of another module's generic is located at its definition there.
(define other (gr:box i32))

(test err-generic-trap #:traps "fixtures/generic-ratio.sub:4:1" (gr:ratio (& other) 0))

;; A count past an array's length traps.
(define a (array u8 64))
(define (first [n u32]) -> (slice u8) (slice a n))

(test err-slice-array #:traps "from 0 to 100 is out of range for length 64" (printf "~a" (-> (first 100) length)))

;; An index past a slice's end traps.
(define (item [s (slice i32)] [i u32]) -> i32 (@ s i))

(test err-slice-index #:traps "index 5 is out of range for length 3" (printf "~a" (item (slice (array-of i32 1 2 3)) 5)))

;; Part of a string that ends past its end traps.
(define (part [s string] [from u32] [to u32]) -> string (slice s from to))

(test err-slice-range #:traps "from 2 to 5 is out of range for length 3" (printf "~a" (part "abc" 2 5)))

;; A trap in Substrate code is reported where the code that traps is.
(define (one-more [a i32] [b i32]) -> i32 (+ 1 (/ a b)))

(test err-trap #:traps "traps.sub:33:48" (printf "~a" (one-more 10 0)))
