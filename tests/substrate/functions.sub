;; Function pointers: a function's name is its index in the table, called through, the same in
;; every module.
(require-unqualified pointers "../fixtures/pointers.sub")

(typedef unary (fn (i32) -> i32))
(struct shape [area (fn ((ptr shape)) -> i32)] [w i32] [h i32])
(struct pair [a i32] [b i32])

(define (show [x i32]) (printf "~a " x))

(define (double [x i32]) -> i32 (* x 2))
(define (square [x i32]) -> i32 (* x x))
(define (negate [x i32]) -> i32 (- x))

(define (apply-twice [f unary] [x i32]) -> i32 (f (f x)))
(define (pick [n i32]) -> unary (if (== n 0) double square))

(define ops (array unary 3))

(define (rect-area [s (ptr shape)]) -> i32 (* (-> s w) (-> s h)))
(define (triangle-area [s (ptr shape)]) -> i32 (/ (* (-> s w) (-> s h)) 2))

(define (swap [p pair]) -> pair
  (let ([q pair]) (set! (-> q a) (-> p b)) (set! (-> q b) (-> p a)) q))

(define (main)
  (show (apply-twice double 5))
  (show (apply-twice (pick 1) 3))
  (show ((pick 0) 7))
  (set! (@ ops 0) double)
  (set! (@ ops 1) square)
  (set! (@ ops 2) (& negate))
  (let ([s 0]) (for ([i 0]) (< i 3) (+= i 1) (+= s ((@ ops i) 4))) (show s))
  (let ([r shape] [t shape])
    (set! (-> r area) rect-area) (set! (-> r w) 3) (set! (-> r h) 4)
    (set! (-> t area) triangle-area) (set! (-> t w) 3) (set! (-> t h) 4)
    (show ((-> r area) (& r)))
    (show ((-> t area) (& t))))
  (let ([f unary 0] [sw (fn (pair) -> pair) swap] [p pair])
    (show (if f 1 0))
    (set! f square)
    (show (== f square))
    (show (== f double))
    (set! (-> p a) 1)
    (set! (-> p b) 2)
    (show (-> (sw p) a)))
  (show (== (triple-here) triple))
  (show (== (malloc-here) malloc))
  (let ([alloc (fn (u32) -> (ptr void)) malloc] [release (fn ((ptr void))) (& free)] [p (ptr i32) 0])
    (set! p (cast (ptr i32) (alloc 4)))
    (set! (@ p) 9)
    (printf "~a" (@ p))
    (release p))
  (printf "\n"))
