;; new and copy: zeroed objects and slices, objects made from values, and copies of strings and slices, from an arena
;; or from the heap.

(require-unqualified std/test/test)

(struct point [x i32] [y i32])
(struct row [cells (array u8 100)] [last i32])
(variant shape [dot] [circle [r f64]])

;; Dirties the memory that the arena's next chunk reuses.
(define (dirty! [a (ptr arena)])
  (memset (arena-alloc a 512) 255 512)
  (arena-free a))

(test new-zeroes
  (let ([a arena])
    (dirty! (& a))
    (let ([p (new (& a) point)] [r (new (& a) row)])
      (expect-equal (-> p x) 0)
      (expect-equal (-> p y) 0)
      (expect-equal (@ (-> r cells) 99) 0)
      (expect-equal (-> r last) 0))
    (arena-free (& a))))

(test new-count
  (let ([a arena])
    (dirty! (& a))
    (let ([xs (new (& a) i32 5)])
      (expect-equal (-> xs length) 5)
      (expect-equal (@ xs 4) 0))
    (arena-free (& a))))

(test new-heap
  (let ([p (new 0 point)] [xs (new 0 u64 3)])
    (expect-equal (-> p y) 0)
    (expect-equal (@ xs 2) 0)
    (free p)
    (free (-> xs items))))

(define (made [x i32]) -> point (point #:x x #:y (* x 2)))

(test new-values
  (let ([a arena] [pt (point #:x 5 #:y 6)])
    (dirty! (& a))
    (let ([p (new (& a) (point #:x 1 #:y 2))] [q (new (& a) (made 3))] [c (new (& a) pt)] [s (new (& a) (circle 2.5))]
          [n (new 0 7)] [t (new 0 "text")])
      (set! (-> pt x) 0)
      (expect-equal (-> p y) 2)
      (expect-equal (-> q y) 6)
      (expect-equal (-> c x) 5)
      (expect-equal (match (@ s) [(circle r) r] [_ 0.0]) 2.5)
      (expect-equal (@ n) 7)
      (expect-equal (@ t) "text")
      (free n)
      (free t))
    (arena-free (& a))))

(test copies
  (let ([a arena] [items (array-of u16 1 2 3)])
    (let ([s (copy (& a) "hello")] [xs (copy 0 (slice items))])
      (set! (@ items 0) 9)
      (expect-equal s "hello")
      (expect-equal (-> xs length) 3)
      (expect-equal (@ xs 0) 1)
      (free (-> xs items)))
    (arena-free (& a))))

(define (count) -> u32 1000000000)

(test err-new-count #:traps "out of memory" (new 0 point (count)))
