;; Enums: their numbers, comparisons, matches, storage, printing and casts.

(require-unqualified std/test/test)

(enum color red green blue)
(enum kind missing [file 1] directory [link 7] other)
(enum code [ok 0] [bad -2] [worse -5])

(struct entry [k kind] [n u32])

(define (name-of [c color]) -> string (match c [red "r"] [green "g"] [blue "b"]))

(define (rank [k kind]) -> i32 (match k [file 1] [directory 2] [_ 0]))

(test numbers
  (expect-equal (cast i32 file) 1)
  (expect-equal (cast i32 directory) 2)
  (expect-equal (cast i32 other) 8)
  (expect-equal (cast i32 worse) -5)
  (expect-equal (cast kind 7) link))

(test comparisons
  (expect (== green green))
  (expect (!= green blue))
  (expect (< red green))
  (expect (>= blue green))
  (expect (> link directory))
  (expect (< worse bad)))

(test matches
  (expect-equal (name-of green) "g")
  (expect-equal (rank directory) 2)
  (expect-equal (rank link) 0))

(test storage
  (let ([e entry] [cs (array color 3)] [z color] [k other] [p (ptr kind) 0])
    (set! (-> e k) link)
    (set! (@ cs 1) blue)
    (set! p (& k))
    (expect-equal z red)
    (expect-equal (-> e k) link)
    (expect-equal (@ cs 1) blue)
    (expect-equal (match p [other 1] [_ 0]) 1)
    (expect-equal (sizeof kind) 4)))

(test printing #:output "green link bad\n" (printf "~a ~a ~a\n" green link (cast code -2)))

(define (no-case) -> color (cast color 9))

(test err-enum-match #:traps "unreachable" (name-of (no-case)))
