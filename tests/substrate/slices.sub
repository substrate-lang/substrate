;; (slice T): made from an array, from a pointer and a count, and from part of another slice; its items, read and set
;; past a check of the index; its parts; and slices as parameters, results, values, fields, globals and captures.

(require-unqualified std/test/test)
(struct holder [tag u8] [s (slice i32)])

(define (sum [s (slice i32)]) -> i32
  (let ([t 0])
    (for ([i u32 0]) (< i (-> s length)) (+= i 1) (+= t (@ s i)))
    t))

(define (rest [s (slice i32)]) -> (slice i32) (slice s 1))

(define (halves [s (slice i32)]) -> (values (slice i32) (slice i32))
  (let ([m (/ (-> s length) 2)]) (values (slice s 0 m) (slice s m))))

(define numbers (array i32 5) (array-of i32 1 2 3 4 5))
(define whole (slice i32) 0)

(define (main)
  (let* ([a (array i32 4)] [s (slice a)])
    (for ([i u32 0]) (< i 4) (+= i 1) (set! (@ s i) (* (cast i32 i) 10)))
    (+= (@ s 0) 5)
    (printf "~a ~a ~a ~a\n" (sum s) (-> s length) (@ a 3) (@ a 0)))
  (let ([p (cast (ptr i32) (malloc 12))])
    (set! (@ p 0) 7)
    (set! (@ p 1) 8)
    (set! (@ p 2) 9)
    (let ([s (slice p 3)])
      (printf "~a ~a ~a ~a\n" (sum s) (sum (rest s)) (sum (slice s 1 2)) (== (-> s items) p)))
    (free p))
  (set! whole (slice numbers))
  (let ([(l r) (halves whole)] [w (ptr (slice i32)) (& whole)])
    (printf "~a ~a ~a ~a ~a\n" (sum whole) (-> whole length) (sum l) (sum r) (-> w length)))
  (let ([h holder])
    (set! (-> h s) (slice (array-of i32 4 5 6)))
    (printf "~a ~a ~a ~a ~a\n" (sizeof (slice u8)) (sizeof holder) (offsetof holder s) (sum (-> h s)) (-> h s length)))
  (let* ([e (slice i32) 0] [bs (slice (array-of u8 1 2 255))] [at (lambda ([i u32]) -> u8 (@ bs i))])
    (printf "~a ~a ~a ~a ~a\n" (-> e length) (sum e) (at 2) (-> bs length) (slice whole 1 3))))

(test slices (expect-output-file "slices.out" (main)))
