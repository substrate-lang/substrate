;; string: literals as strings and as C strings, comparing by bytes, its parts, part of a string, casts to and from
;; (slice u8), strings in memory, printing, and 0 as none.

(struct named [id i32] [name string])

(define (size [s string]) -> u32 (-> s length))
(define (first-byte [s string]) -> u8 (@ s 0))
(define (pick [b bool]) -> string (if b "yes" "no"))
(define (maybe [b bool]) -> string (if b "yes" 0))

(define greeting string "hey")

(define (main)
  (let ([s string "hello"] [c (ptr u8) "hello"])
    (printf "~a ~a ~a ~a ~a\n" s (size s) (strlen c) (size "hi") (== (@ (-> s bytes)) #\h)))
  (printf "~a ~a ~a ~a ~a\n" (== "a" "a") (== (pick #t) "yes") (!= "a" "b") (< "abc" "abd") (< "ab" "abc"))
  (printf "~a ~a ~a ~a\n" (< "b" "abc") (>= "abc" "abc") (== "" "") (== greeting "hey"))
  (let* ([s string "hello world"] [w (slice s 6)] [h (slice s 0 5)])
    (printf "~a|~a|~a ~a ~a\n" h w (-> w length) (first-byte w) (== h "hello")))
  (let* ([b (slice (array-of u8 104 105))] [t (cast string b)])
    (set! (@ b 0) 72)
    (printf "~a ~a ~a\n" t (-> (cast (slice u8) "xyz") length) (cast (slice u8) t)))
  (let ([n named])
    (set! (-> n name) "abc")
    (printf "~a ~s ~a ~a ~a\n" (-> n name) (-> n name) (sizeof named) (offsetof named name) (-> n name length)))
  (let ([e string])
    (printf "~s ~a ~a ~s ~a\n" "tab\there" (-> "abc" length) (-> e length) e (== e "")))
  (printf "~a ~a ~a\n" (maybe #t) (== (-> (maybe #t) bytes) 0) (== (-> (maybe #f) bytes) 0)))
