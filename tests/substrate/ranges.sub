;; Integer literals at the ends of each type's range, casts that wrap, and an instruction that takes a literal's bits.
(require-unqualified std/test/test)
(require wasm compiler/wasm)

(test ends
  (let ([a u8 255] [b i8 -128] [c i8 127] [d u16 65535] [e i16 -32768] [f u32 4294967295] [g i32 -2147483648]
        [h i64 -9223372036854775808] [k u64 18446744073709551615])
    (expect-output "255 -128 127 65535 -32768 4294967295 -2147483648 -9223372036854775808 18446744073709551615"
      (printf "~a ~a ~a ~a ~a ~a ~a ~a ~a" a b c d e f g h k))))

(test casts
  (expect-output "44 -56 4294967295 -1 705032704 3589934592"
    (printf "~a ~a ~a ~a ~a ~a" (cast u8 300) (cast i8 200) (cast u32 -1) (cast i32 4294967295) (cast i32 5000000000)
            (cast u32 -5000000000))))

(test instruction
  (let ([w i32 -300])
    (expect-equal (wasm:i32.lt_u w 4294967040) 1)))
