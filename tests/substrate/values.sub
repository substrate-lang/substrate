;; A function gives several values with a result type (values type ...).
(require-unqualified tests std/test/test)
(define (divmod [a u32] [b u32]) -> (values u32 u32) (values (/ a b) (% a b)))
(define (split [s string] [n u32]) -> (values string u32) (values (slice s n) n))
(struct pt [x i32] [y i32])
(define (ends [p (ptr pt)]) -> (values i32 i32)
  (let ([q pt])
    (set! (-> q x) (-> p x))
    (when (> (-> p y) 0) (return (values (-> q x) (-> p y))))
    (values 0 0)))
(define (main)
  (let ([(q r) (divmod 47 5)]) (printf "~a\n~a\n" q r))
  (let ([(s n) (string u32) (split "hello" 2)]) (printf "~a\n~a\n" s n))
  (let ([p pt])
    (set! (-> p x) 7)
    (set! (-> p y) 8)
    (let ([(a b) (ends (& p))]) (printf "~a\n" (+ a b)))))

(test values (expect-output-file "values.out" (main)))
