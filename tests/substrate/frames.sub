;; Variables in a call's frame: arrays, structs, taken addresses, struct values, unions.

(require-unqualified tests std/test/test)
(struct point [x i32] [y i32])
(struct rect [min point] [max point])
(union bits [f f32] [u u32] [b (array u8 4)])

(define (show [x i32]) (printf "~a " x))

(define (divmod [a i32] [b i32] [rem (ptr i32)]) -> i32
  (set! (@ rem) (% a b))
  (/ a b))

(define (plus-ten [n i32]) -> i32
  (let ([p (& n)]) (+= (@ p) 10) n))

(define (addresses)
  (let* ([rem 0] [q (divmod 17 5 (& rem))])
    (show q)
    (show rem))
  (show (plus-ten 5))
  (printf "\n"))

(define (depth [n i32]) -> i32
  (let ([a (array i32 4)])
    (set! (@ a 0) n)
    (if (== n 0) 0 (+ (depth (- n 1)) (@ a 0)))))

(define (arrays)
  (show (depth 10))
  (printf "\n"))

(define (updates)
  (let ([a 10] [b 0] [p (cast (ptr i32) (malloc 8))])
    (+= a 5) (show a)
    (*= a 2) (show a)
    (<<= a 2) (show a)
    (bit-xor= a 8) (show a)
    (set! b (set! a 7))
    (show (+ a b))
    (set! (@ p 1) 0)
    (show (+= (@ p 1) 3))
    (show (@ p 1))
    (let ([q p]) (+= q 1) (show (@ q)))
    (let ([n 5] [k 0]) (while (> (set! n (- n 1)) 0) (+= k 1)) (show k))
    (let ([z i64]) (show (cast i32 z)))
    (free p))
  (printf "\n"))

(define (make-point [x i32] [y i32]) -> point
  (let ([p point]) (set! (-> p x) x) (set! (-> p y) y) p))

(define (add [a point] [b point]) -> point
  (make-point (+ (-> a x) (-> b x)) (+ (-> a y) (-> b y))))

(define (clear-x [p point]) -> i32 (set! (-> p x) 0) (-> p y))

(define (larger [a point] [b point]) -> point (if (> (-> a x) (-> b x)) a b))

(define (moved [dx i32]) -> point
  (let ([p point])
    (set! (-> p x) (+ (-> origin x) dx))
    (set! (-> p y) (-> origin x))
    p))

(define (area [r rect]) -> i32
  (* (- (-> r max x) (-> r min x)) (- (-> r max y) (-> r min y))))

(define origin point)
(define corner point (make-point 3 4))

(define (structs)
  (let ([a (make-point 1 2)] [r rect])
    (set! (-> r max) (add a corner))
    (set! (-> r min) a)
    (show (area r))
    (show (clear-x a))
    (show (-> a x))
    (show (-> (add a a) y))
    (let ([b point (if (> (-> a x) 0) corner origin)]) (show (-> b x)))
    (set! origin (-> r max))
    (show (+ (-> origin x) (-> origin y)))
    (show (sizeof rect))
    (show (-> (larger a corner) x))
    (set! origin (moved 5))
    (show (-> origin x))
    (show (-> origin y))
    (let ([c a]) (set! (-> c x) 50) (show (+ (-> a x) (-> c x)))))
  (printf "\n"))

(define (unions)
  (let ([v bits])
    (set! (-> v f) 1.0)
    (printf "~a " (cast i32 (-> v u)))
    (show (@ (-> v b) 3))
    (show (sizeof bits)))
  (printf "\n"))

(define (find [n i32]) -> i32
  (let ([a (array i32 16)])
    (for ([i 0]) (< i 16) (+= i 1)
      (set! (@ a i) (* i n))
      (when (> (@ a i) 20) (return i)))
    -1))

(define (returns)
  (let ([s 0])
    (for ([k 0]) (< k 100000) (+= k 1) (+= s (find 3)))
    (show s))
  (show (find 0))
  (printf "\n"))

(define (scribble) -> i32
  (let ([a (array i32 16)])
    (for ([i 0]) (< i 16) (+= i 1) (set! (@ a i) -1))
    (@ a 15)))

(define (unset)
  (let ([p point] [r rect] [a (array i32 4)] [v bits])
    (show (+ (-> p x) (-> p y)))
    (show (-> r max y))
    (show (@ a 3))
    (show (cast i32 (-> v u)))))

(define (zeroes)
  (scribble)
  (unset)
  (for ([i 0]) (< i 2) (+= i 1)
    (let ([p point]) (show (-> p x)) (set! (-> p x) 5)))
  (printf "\n"))

(define (main)
  (addresses)
  (arrays)
  (updates)
  (structs)
  (unions)
  (returns)
  (zeroes))

(test frames (expect-output-file "frames.out" (main)))
