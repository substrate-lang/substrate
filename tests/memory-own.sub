(require wasm "../compiler/wasm.sub")
(wasm:memory 1)
(define (main)
  (let ([a (array i32 1)] [p (ptr i32) (cast (ptr i32) (malloc 4))])
    (wasm:i32.store 0 42)
    (wasm:memory.fill 8 65 2)
    (wasm:memory.copy 16 8 2)
    (set! (@ a 0) 7)
    (set! (@ p 0) 9)
    (printf "~a ~a ~a ~a~n" (wasm:i32.load 0) (wasm:i32.load8_u 17) (wasm:memory.grow 1) (wasm:memory.size))
    (printf "~a ~a ~s~n" (@ a 0) (@ p 0) '(quoted data))
    (host-write 1 (cast (slice u8) "text\n"))))
