;; A module takes another's memory as its memory 1, beside Substrate's at 0: its own instructions use it, and
;; memory.copy-in and memory.copy-out copy from memory 0 into it and back.
(require wasm compiler/wasm)
(require owner "fixtures/memory-owner.sub")
(wasm:memory 1 from owner)
(define (main)
  (let ([text "hello"] [back (ptr u8) (cast (ptr u8) (malloc 5))])
    (wasm:memory.copy-in 100 (cast i32 (-> text bytes)) 5)
    (wasm:i32.store8 104 33)
    (wasm:memory.copy-out (cast i32 back) 100 5)
    (printf "~a ~a ~a~n" (owner:peek 100) (owner:peek 104) (cast string (slice back 5)))))
