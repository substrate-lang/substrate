;; A timer, a request, connections and a listener, each closed before it answers, so that only a later timer fires.
;; When the servers' URLs are given, the real modules answer instead of the fakes.
(require-unqualified host/events)
(require-unqualified host/modules/timer)
(require-unqualified host/modules/fetch)
(require-unqualified host/modules/websocket)
(require-unqualified host/node/net)
(require-unqualified host/stream)
(provide run)

(define closed event-head)
(define done event-head)

(define (unexpected [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (printf "unexpected ~a ~a ~a\n" source kind id))

(define (finished [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32]) (printf "silence\n"))

(define servers (slice string))

(define (url [i u32] [path string] [fallback string]) -> string
  (if (<= (-> servers length) i)
      fallback
      (let ([b (make-buffer)])
        (buffer-add-string! (& b) (@ servers i))
        (buffer-add-string! (& b) path)
        (buffer-string (& b)))))

(define (port-of [u string]) -> u32
  (let ([i (-> u length)] [port u32 0] [scale u32 1])
    (while (and (> i 0) (>= (@ u (- i 1)) #\0) (<= (@ u (- i 1)) #\9))
      (-= i 1)
      (+= port (* scale (- (@ u i) #\0)))
      (*= scale 10))
    port))

(define (run [given (slice string)])
  (let ([id u32 0])
    (set! servers given)
    (set! (-> closed handle) unexpected)
    (set! (-> done handle) finished)
    (timer-cancel (timer-after 1.0 (& closed)))
    (stream-close (fetch-get (url 0 "/hello.txt" "/hello.txt") (& closed)))
    (websocket-connect (url 1 "/echo" "ws://fake/echo") 0 (& closed) (& id) 0)
    (websocket-close id 1000)
    (when (> (-> servers length) 1)
      (net-listen 0 "" #f 0 (& closed) (& id) 0)
      (net-close id)
      (net-connect (port-of (url 0 "" "")) "127.0.0.1" #f (& closed) (& id) 0)
      (stream-close id))
    (timer-after 50.0 (& done))))

(define (main) (run (host-args)))
