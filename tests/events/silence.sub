;; A timer, a request, connections and a listener, each closed before it answers, so that only a later timer fires.
;; With arguments, the real modules answer.
(require-unqualified events host/events)
(require-unqualified timer host/modules/timer)
(require-unqualified fetch host/modules/fetch)
(require-unqualified websocket host/modules/websocket)
(require-unqualified net host/node/net)
(require-unqualified stream host/stream)

(define closed event-head)
(define done event-head)

(define (unexpected [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (printf "unexpected ~a ~a ~a\n" source kind id))

(define (finished [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32]) (printf "silence\n"))

(define (url [i u32] [path string] [fallback string]) -> string
  (let ([args (host-args)])
    (if (<= (-> args length) i)
        fallback
        (let ([b (make-buffer)])
          (buffer-add-string! (& b) (@ args i))
          (buffer-add-string! (& b) path)
          (buffer-string (& b))))))

(define (port-of [u string]) -> u32
  (let ([i (-> u length)] [port u32 0] [scale u32 1])
    (while (and (> i 0) (>= (@ u (- i 1)) #\0) (<= (@ u (- i 1)) #\9))
      (-= i 1)
      (+= port (* scale (- (@ u i) #\0)))
      (*= scale 10))
    port))

(define (main)
  (set! (-> closed handle) unexpected)
  (set! (-> done handle) finished)
  (timer-cancel (timer-after 1.0 (& closed)))
  (stream-close (fetch-get (url 0 "/hello.txt" "/hello.txt") (& closed)))
  (websocket-close (websocket-connect (url 1 "/echo" "ws://fake/echo") 0 (& closed) 0) 1000)
  (when (> (-> (host-args) length) 1)
    (net-close (net-listen 0 "" #f 0 (& closed) 0))
    (stream-close (net-connect (port-of (url 0 "" "")) "127.0.0.1" #f (& closed) 0)))
  (timer-after 50.0 (& done)))
