;; Closing straight away: a timer cancelled, and a request, a connection, a listener and a connection
;; closed before they answer. Then one timer fires, alone. With arguments, the real modules answer.
(require-unqualified events "../../host/events.sub")
(require-unqualified timer "../../host/modules/timer.sub")
(require-unqualified fetch "../../host/modules/fetch.sub")
(require-unqualified websocket "../../host/modules/websocket.sub")
(require-unqualified net "../../host/node/net.sub")
(require-unqualified stream "../../host/stream.sub")

(define closed event-head)
(define done event-head)

(define (unexpected [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (printf "unexpected ~a ~a ~a\n" source kind id))

(define (finished [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32]) (printf "silence\n"))

(define (url [i i32] [path (ptr u8)] [fallback (ptr u8)]) -> (ptr u8)
  (let* ([n u32 0] [base (host-arg i (& n))])
    (if (== base 0)
        fallback
        (let ([p (cast (ptr u8) (realloc base (+ n (strlen path) 1)))])
          (memcpy (+ p n) path (+ (strlen path) 1))
          p))))

(define (port-of [u (ptr u8)]) -> u32
  (let ([i (strlen u)] [port u32 0] [scale u32 1])
    (while (and (> i 0) (>= (@ u (- i 1)) #\0) (<= (@ u (- i 1)) #\9))
      (-= i 1)
      (+= port (* scale (- (@ u i) #\0)))
      (*= scale 10))
    port))

(define (main)
  (set! (-> closed handle) unexpected)
  (set! (-> done handle) finished)
  (timer-cancel (timer-after 1.0 (& closed)))
  (stream-close (fetch-get (url 0 "/hello.txt" "/hello.txt") (& closed)))
  (websocket-close (websocket-connect (url 1 "/echo" "ws://fake/echo") (& closed) 0) 1000)
  (when (!= (url 1 "" 0) 0)
    (net-close (net-listen 0 "" 0 (& closed) 0))
    (stream-close (net-connect (port-of (url 0 "" "")) "127.0.0.1" 0 (& closed) 0)))
  (timer-after 50.0 (& done)))
