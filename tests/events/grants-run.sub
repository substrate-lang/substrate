;; Programs granted by a list: one on it runs, one on it but denied and one not on it do not, one named by a path from
;; the child's directory runs, one looked for along another PATH does not, a variable the dynamic loader reads is
;; refused, and a program on the list cannot be written.
(require-unqualified events "../../host/events.sub")
(require-unqualified process "../../host/node/process.sub")
(require-unqualified fs "../../host/fs.sub")

(define child event-head)
(define first i32 1)

(define (in-build [name (ptr u8)]) -> (ptr u8)
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) (host-arg-text 0))
    (buffer-add-byte! (& b) 47)
    (buffer-add-string! (& b) name)
    (buffer-add-byte! (& b) 0)
    (-> b bytes)))

(define (spawn [label (ptr u8)] [program (ptr u8)] [dir (ptr u8)] [variable (ptr u8)])
  (let ([why (ptr u8) 0] [o process-options] [e (make-buffer)])
    (process-options-init! (& o))
    (set! (-> o stdin) process-ignore)
    (set! (-> o stdout) process-ignore)
    (set! (-> o stderr) process-ignore)
    (set! (-> o dir) dir)
    (when (!= (strlen variable) 0)
      (buffer-add-entry! (& e) variable)
      (set! (-> o env) (-> e bytes))
      (set! (-> o env-length) (-> e length)))
    (when (== (process-spawn program "" 0 (& o) (& child) (& why)) 0) (printf "~a: ~a\n" label why))))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (== kind process-exit)
    (if (== first 1)
        (begin
          (printf "true: exit ~a\n" value)
          (set! first 0)
          (spawn "./tool" "./tool" "grants" ""))
        (printf "./tool: exit ~a\n" value))))

(define (write [name (ptr u8)])
  (let* ([why (ptr u8) 0] [path (in-build name)])
    (printf "write ~a: ~a\n" name
            (if (>= (fs-write-file path "x" 1 (& why)) 0) "granted" (+ why (strlen path) 2)))))

(define (main)
  (set! (-> child handle) heard)
  (spawn "false" "false" "" "")
  (spawn "env" "env" "" "")
  (spawn "true with PATH=grants" "true" "" "PATH=grants")
  (spawn "true with LD_PRELOAD" "true" "" "LD_PRELOAD=none.so")
  (let ([dir (in-build "grants-run")]) (fs-make-dir dir (cast i32 (strlen dir)) 0))
  (write "grants-run/tool")
  (write "grants-run/notes")
  (spawn "true" "true" "" ""))
