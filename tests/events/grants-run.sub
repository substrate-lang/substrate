;; Programs granted by a list: one on it runs, one on it but denied and one not on it do not, one named by a path from
;; the child's directory runs, one looked for along another PATH does not, a dynamic loader's variable set for the
;; child or in the environment is refused, and a program on the list cannot be written.
(require-unqualified host/events)
(require-unqualified host/node/process)
(require-unqualified host/node/env)
(require-unqualified host/fs)
(provide main)

(define child event-head)
(define first i32 1)

(define root string "")

(define (in-build [name string]) -> string
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) root)
    (buffer-add-byte! (& b) 47)
    (buffer-add-string! (& b) name)
    (buffer-string (& b))))

(define (spawn [label string] [program string] [dir string] [variable string])
  (let ([why string] [o process-options] [env (array string 1)])
    (process-options-init! (& o))
    (set! (-> o stdin) process-ignore)
    (set! (-> o stdout) process-ignore)
    (set! (-> o stderr) process-ignore)
    (set! (-> o dir) dir)
    (when (!= (-> variable length) 0)
      (set! (@ env 0) variable)
      (set! (-> o env) (slice env)))
    (when (== (process-spawn program 0 (& o) (& child) (& why)) 0) (printf "~a: ~a\n" label why))))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (== kind process-exit)
    (if (== first 1)
        (begin
          (printf "true: exit ~a\n" value)
          (set! first 0)
          (spawn "./tool" "./tool" "events/grants" ""))
        (printf "./tool: exit ~a\n" value))))

(define (write [name string])
  (let* ([why error] [path (in-build name)])
    (printf "write ~a: ~a\n" name
            (if (fs-write-file path (cast (slice u8) "x") (& why))
                "granted"
                (slice (error-text (& why)) (+ (-> path length) 2))))))

(define (main [dir string])
  (set! root dir)
  (set! (-> child handle) heard)
  (spawn "false" "false" "" "")
  (spawn "env" "env" "" "")
  (spawn "true with PATH=grants" "true" "" "PATH=grants")
  (spawn "true with LD_PRELOAD" "true" "" "LD_PRELOAD=none.so")
  (env-set "LD_PRELOAD" "none.so" 0)
  (spawn "true after env-set LD_PRELOAD" "true" "" "")
  (env-delete "LD_PRELOAD" 0)
  (fs-make-dir (in-build "grants-run") 0)
  (write "grants-run/tool")
  (write "grants-run/notes")
  (spawn "true" "true" "" ""))
