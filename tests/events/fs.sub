;; The file system module, in a directory under this program's own: stat, list, rename, remove, and files as streams.
(require-unqualified events "../../lib/events.sub")
(require-unqualified fs "../../lib/fs.sub")
(require-unqualified stream "../../lib/stream.sub")
(require-unqualified host "../../compiler/host.sub")

(define work (array u8 1024))
(define reading stream-reader)
(define written event-head)

(define (path [name (ptr u8)]) -> (ptr u8)
  (let* ([n (strlen work)] [p (cast (ptr u8) (malloc (+ n (strlen name) 2)))])
    (memcpy p work n)
    (set! (@ p n) #\/)
    (memcpy (+ p n 1) name (+ (strlen name) 1))
    p))

(define (show-stat [name (ptr u8)]) (printf "stat ~a: ~a\n" name (cast i32 (fs-stat (path name)))))

(define (read-done [r (ptr stream-reader)])
  (printf "read ~a bytes: " (-> r bytes length))
  (host-write 1 (-> r bytes bytes) (cast i32 (-> r bytes length)))
  (printf "\n")
  (let ([out (fs-open (path "copy.txt") fs-write-mode (cast (ptr void) (& written)))])
    (stream-write out (-> r bytes bytes) (-> r bytes length))
    (stream-finish out)))

(define (wrote [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (== kind stream-finished)
    (show-stat "copy.txt")
    (printf "remove: ~a\n" (fs-remove (path "copy.txt")))
    (printf "remove: ~a\n" (fs-remove (path "moved.txt")))
    (show-stat "copy.txt")))

(define (main)
  (let ([n (host-arg 0 work 1000)])
    (set! (@ work n) 0)
    (memcpy (+ work n) "/work" 6))
  (show-stat "note.txt")
  (host-make-dir work (strlen work))
  (host-write-file (path "note.txt") (strlen (path "note.txt")) "a note" 6)
  (show-stat "note.txt")
  (show-stat "")
  (printf "rename: ~a\n" (fs-rename (path "note.txt") (path "moved.txt")))
  (printf "list: ~a" (fs-list work))
  (set! (-> written handle) wrote)
  (let ([in (fs-open (path "moved.txt") fs-read-mode 0)])
    (stream-read-all! (& reading) in read-done)))

(define (on-event [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (events-dispatch source kind id tag value))
