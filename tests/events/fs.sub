;; The fs module's calls, in a directory under the program's own, including a directory read as a file.
(require-unqualified events "../../host/events.sub")
(require-unqualified fs "../../host/fs.sub")
(require-unqualified stream "../../host/stream.sub")

(define work string "")
(define reading stream-reader)
(define written event-head)
(define directory event-head)
(define scratch (array u8 16))

(define (path [name string]) -> string
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) work)
    (buffer-add-byte! (& b) #\/)
    (buffer-add-string! (& b) name)
    (buffer-string (& b))))

(define (show-stat [name string])
  (let ([info fs-info])
    (cond [(< (fs-stat (path name) (& info) 0) 0) (printf "stat ~a: failed\n" name)]
          [(== (-> info kind) fs-directory) (printf "stat ~a: a directory\n" name)]
          [else (printf "stat ~a: a file of ~a bytes\n" name (-> info size))])))

(define (read-done [r (ptr stream-reader)])
  (printf "read ~a bytes: " (-> r bytes length))
  (host-write 1 (buffer-bytes (& (-> r bytes))))
  (printf "\n")
  (let ([out (fs-open (path "copy.txt") fs-write-mode (cast (ptr void) (& written)) 0)])
    (stream-write out (buffer-bytes (& (-> r bytes))))
    (stream-finish out)))

(define (wrote [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (== kind stream-finished)
    (show-stat "copy.txt")
    (printf "remove: ~a\n" (fs-remove (path "copy.txt") #f 0))
    (printf "remove: ~a\n" (fs-remove (path "moved.txt") #f 0))
    (show-stat "copy.txt")
    (stream-read! (fs-open work fs-read-mode (& directory) 0) (slice scratch))))

(define (read-directory [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (== kind stream-failed)
    (printf "a directory read as a file: ~a\n" (if (== value error-other) "other" "not other"))
    (stream-close id)))

(define (main)
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) (host-arg 0))
    (buffer-add-string! (& b) "/work")
    (set! work (buffer-string (& b))))
  (show-stat "note.txt")
  (fs-make-dir work 0)
  (fs-write-file (path "note.txt") (cast (slice u8) "a note") 0)
  (show-stat "note.txt")
  (show-stat "")
  (printf "rename: ~a\n" (fs-rename (path "note.txt") (path "moved.txt") 0))
  (let ([listed (fs-list work 0)])
    (printf "list:")
    (for ([i u32 0]) (< i (-> listed length)) (+= i 1) (printf " ~a" (@ listed i)))
    (printf "\n")
    (free (-> listed items)))
  (set! (-> written handle) wrote)
  (set! (-> directory handle) read-directory)
  (let ([in (fs-open (path "moved.txt") fs-read-mode 0 0)])
    (stream-read-all! (& reading) in read-done)))
