;; A TLS listener with the granted certificate, and a connection to it that trusts that certificate.
(require-unqualified events "../../host/events.sub")
(require-unqualified net "../../host/node/net.sub")
(require-unqualified stream "../../host/stream.sub")
(require-unqualified host "../../host/host.sub")

(struct side [head event-head] [name (ptr u8)] [listener u32])

(define server side)
(define client side)
(define reply stream-reader)

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([s (cast (ptr side) tag)])
    (cond
      [(== source net-source)
       (cond [(== kind net-listening)
              (printf "listening\n")
              (net-connect "127.0.0.1" (cast u32 value) "tls" (& client))]
             [(== kind net-accept)
              (stream-write-text (cast u32 value) "secure hello\n")
              (stream-finish (cast u32 value))]
             [(== kind net-connected) (stream-read-all! (& reply) id client-done)]
             [(== kind net-failed)
              (let ([why (events-take-text)])
                (printf "~a: failed ~a: ~a\n" (-> s name) value why)
                (free why))])]
      [(== kind stream-failed)
       (let ([why (events-take-text)])
         (printf "~a: stream failed ~a: ~a\n" (-> s name) value why)
         (free why))])))

(define (client-done [r (ptr stream-reader)])
  (printf "client: ")
  (host-write 1 (-> r bytes bytes) (cast i32 (-> r bytes length)))
  (stream-close (-> r id))
  (net-close (-> server listener)))

(define (main)
  (set! (-> server head handle) heard)
  (set! (-> server name) "server")
  (set! (-> client head handle) heard)
  (set! (-> client name) "client")
  (set! (-> server listener) (net-listen 0 "tls" (& server))))

(define (on-event [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (events-dispatch source kind id tag value))
