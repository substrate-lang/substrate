;; A TLS listener with the granted certificate, and a connection to it that trusts that certificate.
(require-unqualified events host/events)
(require-unqualified net host/node/net)
(require-unqualified stream host/stream)
(provide main)

(struct side [head event-head] [name string] [listener u32])

(define server side)
(define client side)
(define reply stream-reader)

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([s (cast (ptr side) tag)])
    (cond
      [(== source net-source)
       (cond [(== kind net-listening)
              (printf "listening\n")
              (net-connect (cast u32 value) "127.0.0.1" #t (& client) 0)]
             [(== kind net-accept)
              (stream-write-text (cast u32 value) "secure hello\n")
              (stream-finish (cast u32 value))]
             [(== kind net-connected) (stream-read-all! (& reply) id client-done)]
             [(== kind net-failed)
              (let ([why (events-take-text)])
                (printf "~a: failed ~a: ~a\n" (-> s name) value why)
                (free (-> why bytes)))])]
      [(== kind stream-failed)
       (let ([why (events-take-text)])
         (printf "~a: stream failed ~a: ~a\n" (-> s name) value why)
         (free (-> why bytes)))])))

(define (client-done [r (ptr stream-reader)])
  (printf "client: ")
  (host-write 1 (buffer-bytes (& (-> r bytes))))
  (stream-close (-> r id))
  (net-close (-> server listener)))

(define (main)
  (set! (-> server head handle) heard)
  (set! (-> server name) "server")
  (set! (-> client head handle) heard)
  (set! (-> client name) "client")
  (set! (-> server listener) (net-listen 0 "" #t 0 (& server) 0)))
