;; Calling a function that its host module lacks traps every time, not only the first time.
(require-unqualified events host/events)
(require-unqualified timer host/modules/timer)
(provide main)

(import nope "timer" "nope" (->))

(define (fired [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (printf "calling, ~a\n" id)
  (nope))

(define (trapped [why string])
  (let ([n u32 0])
    (while (and (< n (-> why length)) (!= (@ why n) 10)) (+= n 1))
    (printf "~a\n" (slice why 0 n))))

(define (main)
  (event-handler! timer-source fired)
  (trap-handler! trapped)
  (timer-after 1.0 0)
  (timer-after 2.0 0))
