(require-unqualified build std/test/build)

(test clock (expect-run "clock.sub" #:output-file "clock.out"))
(test env (expect-run "env.sub" #:grants ((env "PATH" "SUBSTRATE_NO_SUCH_VARIABLE" "SUBSTRATE_SET") (all run)) #:output-file "env.out"))
(test env-none (expect-run "env-none.sub" #:output-file "env-none.out"))
(test err-net-grant (expect-run "err-net-grant.sub" #:grants ((deny-net "fe80:::1")) #:fails "substrate: fe80:::1 is not a host or host:port"))
(test err-read-written (expect-run "err-read-written.sub" #:grants ((write "$SCRATCH")) #:args ("$SCRATCH") #:fails "stream.read: stream 1 cannot be read"))
(test err-trap (expect-run "err-trap.sub" #:grants ((fake timer)) #:fails "error: trap: divide by zero"))
(test err-websocket-close (expect-run "err-websocket-close.sub" #:grants ((all net)) #:fails "websocket.close: the code must be 1000 or 3000 to 4999, not 1001"))
(test err-write-read (expect-run "err-write-read.sub" #:grants ((read ".")) #:fails "stream.write: stream 1 cannot be written"))
(test fetch (expect-run "fetch.sub" #:grants ((all net) (fetch "files")) #:output-file "fetch.out"))
(test fetch-errors (expect-run "fetch-errors.sub" #:grants ((all net)) #:output-file "fetch-errors.out"))
(test fs (expect-run "fs.sub" #:grants ((read "$SCRATCH") (write "$SCRATCH")) #:args ("$SCRATCH") #:output-file "fs.out"))
(test fs-calls (expect-run "fs-calls.sub" #:grants ((all read write)) #:args ("$SCRATCH") #:output-file "fs-calls.out"))
(test fs-open-file (expect-run "fs-open-file.sub" #:grants ((all read write)) #:args ("$SCRATCH") #:output-file "fs-open-file.out"))
(test fs-unix #:unix (expect-run "fs-unix.sub" #:grants ((all read write)) #:args ("$SCRATCH") #:output-file "fs-unix.out"))
(test grants (expect-run "grants.sub" #:grants ((read "grants" "$SCRATCH/grants-out/a") (deny-read "grants/secret") (write "$SCRATCH/grants-out" "grants/nowhere") (deny-write "$SCRATCH/grants-out/kept") (env "PATH") (net "127.0.0.1") (deny-net "127.0.0.1:9")) #:args ("$SCRATCH") #:output-file "grants.out"))
(test grants-redirect (expect-run "grants-redirect.sub" #:grants ((net "127.0.0.1") (deny-net "10.0.0.0/8")) #:output-file "grants-redirect.out"))
(test grants-resolved (expect-run "grants-resolved.sub" #:grants ((all net) (deny-net "127.0.0.0/8:8" "10.0.0.0/8" "[fd00::]/8" "127.0.0.1:9" "[::1]:9")) #:output-file "grants-resolved.out"))
(test grants-run #:unix (expect-run "grants-run.sub" #:grants ((run "true" "false" "grants/tool" "$SCRATCH/grants-run/tool" "no-such-program") (deny-run "false") (write "$SCRATCH/grants-run") (env "LD_PRELOAD")) #:args ("$SCRATCH") #:output-file "grants-run.out"))
(test grants-proc #:linux (expect-run "grants-proc.sub" #:grants ((all read) (deny-read "grants/secret")) #:output-file "grants-proc.out"))
(test grants-proc-env #:linux (expect-run "grants-proc.sub" #:grants ((all read env) (deny-read "grants/secret")) #:output-file "grants-proc-env.out"))
(test grants-special #:unix (expect-run "grants-special.sub" #:grants ((all read) (deny-read "grants/secret")) #:output-file "grants-special.out"))
(test grants-windows #:windows (expect-run "grants-windows.sub" #:grants ((all read)) #:output-file "grants-windows.out"))
(test http (expect-run "http.sub" #:grants ((net "127.0.0.1") (read "files")) #:output-file "http.out"))
(test missing-host-function
  (expect-run "missing-host-function.sub" #:grants ((fake timer))
              #:output "calling, 1\ntrap: timer.nope is not a host function\ncalling, 2\ntrap: timer.nope is not a host function"))
(test net (expect-run "net.sub" #:grants ((net "127.0.0.1")) #:output-file "net.out"))
(test net-errors (expect-run "net-errors.sub" #:grants ((net "127.0.0.1")) #:output-file "net-errors.out"))
(test process (expect-run "process.sub" #:grants ((all run) (env "PATH" "SUBSTRATE_INHERITED")) #:output-file "process.out"))
(test race (expect-run "race.sub" #:grants ((all net) (fake timer clock) (fetch "files")) #:output-file "race.out"))
(test signal #:unix (expect-run "signal.sub" #:grants ((run "kill")) #:output-file "signal.out"))
(test silence (expect-run "silence.sub" #:grants ((all net) (fake timer websocket) (fetch "files")) #:output-file "silence.out"))
(test stdin (expect-run "stdin.sub" #:stdin-file "stdin.in" #:output-file "stdin.out"))
(test timers (expect-run "timers.sub" #:grants ((fake timer clock)) #:output-file "timers.out"))
(test tls (expect-run "tls.sub" #:grants ((net "127.0.0.1") (tls "../../std/tests/http/tls/cert.pem" "../../std/tests/http/tls/key.pem")) #:output-file "tls.out"))
(test trap (expect-run "trap.sub" #:grants ((fake timer)) #:output-file "trap.out"))
(test trap-handlers (expect-run "trap-handlers.sub" #:grants ((fake timer)) #:output-file "trap-handlers.out"))
(test untagged-handlers (expect-run "untagged-handlers.sub" #:grants ((fake timer)) #:output-file "untagged-handlers.out"))
(test watch #:linux (expect-run "watch.sub" #:grants ((read "$SCRATCH/watched") (write "$SCRATCH/watched")) #:args ("$SCRATCH") #:output-file "watch.out"))
(test websocket (expect-run "websocket.sub" #:grants ((all net) (fake websocket)) #:output-file "websocket.out"))
(test worker (expect-run "worker.sub" #:output-file "worker.out"))
(test worker-grants (expect-run "worker-grants.sub" #:grants ((read "grants")) #:output-file "worker-grants.out"))
(test worker-modules (expect-run "worker-modules.sub" #:grants ((all net) (fetch "files")) #:output-file "worker-modules.out"))
