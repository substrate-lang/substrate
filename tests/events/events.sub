(require-unqualified tests std/test/test)
(require clock "clock.sub")
(require env "env.sub")
(require env-workers "env-workers.sub")
(require err-read-written "err-read-written.sub")
(require err-trap "err-trap.sub")
(require err-websocket-close "err-websocket-close.sub")
(require err-write-read "err-write-read.sub")
(require fetch "fetch.sub")
(require fetch-errors "fetch-errors.sub")
(require fs "fs.sub")
(require fs-calls "fs-calls.sub")
(require fs-open-file "fs-open-file.sub")
(require fs-unix "fs-unix.sub")
(require grants "grants.sub")
(require grants-proc "grants-proc.sub")
(require grants-redirect "grants-redirect.sub")
(require grants-resolved "grants-resolved.sub")
(require grants-run "grants-run.sub")
(require grants-special "grants-special.sub")
(require grants-windows "grants-windows.sub")
(require http "http.sub")
(require missing-host-function "missing-host-function.sub")
(require net "net.sub")
(require net-errors "net-errors.sub")
(require process "process.sub")
(require race "race.sub")
(require silence "silence.sub")
(require timers "timers.sub")
(require tls "tls.sub")
(require trap-handlers "trap-handlers.sub")
(require untagged-handlers "untagged-handlers.sub")
(require watch "watch.sub")
(require websocket "websocket.sub")
(require workers "worker.sub")
(require worker-grants "worker-grants.sub")

(define (no-servers) -> (slice string) (slice (cast (ptr string) 0) 0))

(test clock #:output-file "clock.out" (clock:main))

(test env #:grants ((env "PATH" "SUBSTRATE_NO_SUCH_VARIABLE" "SUBSTRATE_SET") (all run)) #:output-file "env.out"
  (env:main))

(test env-workers #:grants ((env "SUBSTRATE_SET")) #:output "the worker sees the parent's\nthe parent sees unset"
  (env-workers:main))

(test err-read-written #:traps "stream.read: stream 1 cannot be read"
  (err-read-written:main (scratch-directory)))

(test err-trap #:grants ((fake timer)) #:traps "divide by zero" (err-trap:main))

(test err-websocket-close #:grants ((all net))
  #:traps "websocket.close: the code must be 1000 or 3000 to 4999, not 1001"
  (err-websocket-close:main))

(test err-write-read #:traps "stream.write: stream 1 cannot be written"
  (err-write-read:main))

(test fetch #:grants ((all net) (fetch "events/files")) #:output-file "fetch.out" (fetch:run (no-servers)))

(test fetch-errors #:grants ((all net)) #:output-file "fetch-errors.out" (fetch-errors:main))

(test fs #:output-file "fs.out" (fs:main (scratch-directory)))

(test fs-calls #:grants ((all read write)) #:output-file "fs-calls.out" (fs-calls:main (scratch-directory)))

(test fs-open-file #:grants ((all read write)) #:output-file "fs-open-file.out" (fs-open-file:main (scratch-directory)))

(test fs-unix #:unix #:grants ((all read write)) #:output-file "fs-unix.out" (fs-unix:main (scratch-directory)))

(test grants
  #:grants ((deny-read "events/grants/secret" "$SCRATCH/grants-out/b") (write "events/grants/nowhere")
            (deny-write "$SCRATCH/grants-out/kept") (env "PATH") (net "127.0.0.1") (deny-net "127.0.0.1:9"))
  #:output-file "grants.out"
  (grants:main (scratch-directory)))

(test grants-redirect #:grants ((net "127.0.0.1") (deny-net "10.0.0.0/8")) #:output-file "grants-redirect.out"
  (grants-redirect:main))

(test grants-resolved #:grants ((all net) (deny-net "127.0.0.0/8:8" "10.0.0.0/8" "[fd00::]/8" "127.0.0.1:9" "[::1]:9"))
  #:output-file "grants-resolved.out"
  (grants-resolved:main))

(test grants-run #:unix
  #:grants ((run "true" "false" "events/grants/tool" "$SCRATCH/grants-run/tool" "no-such-program") (deny-run "false")
            (env "LD_PRELOAD"))
  #:output-file "grants-run.out"
  (grants-run:main (scratch-directory)))

(test grants-proc #:linux #:grants ((all read) (deny-read "events/grants/secret")) #:output-file "grants-proc.out"
  (grants-proc:main))

(test grants-proc-env #:linux #:grants ((all read env) (deny-read "events/grants/secret"))
  #:output-file "grants-proc-env.out"
  (grants-proc:main))

(test grants-special #:unix #:grants ((all read) (deny-read "events/grants/secret")) #:output-file "grants-special.out"
  (grants-special:main))

(test grants-windows #:windows #:grants ((all read)) #:output-file "grants-windows.out" (grants-windows:main))

(test http #:grants ((net "127.0.0.1")) #:output-file "http.out" (http:main))

(test missing-host-function #:grants ((fake timer))
  #:output "calling, 1\ntrap: timer.nope is not a host function\ncalling, 2\ntrap: timer.nope is not a host function"
  (missing-host-function:main))

(test net #:grants ((net "127.0.0.1")) #:output-file "net.out" (net:main))

(test net-errors #:grants ((net "127.0.0.1")) #:output-file "net-errors.out" (net-errors:main))

(test process #:grants ((all run) (env "PATH" "SUBSTRATE_INHERITED")) #:output-file "process.out" (process:main))

(test race #:grants ((all net) (fake timer clock) (fetch "events/files")) #:output-file "race.out" (race:main))

(test silence #:grants ((all net) (fake timer websocket) (fetch "events/files")) #:output-file "silence.out"
  (silence:run (no-servers)))

(test timers #:grants ((fake timer clock)) #:output-file "timers.out" (timers:main))

(test tls #:grants ((net "127.0.0.1") (tls "../std/tests/http/tls/cert.pem" "../std/tests/http/tls/key.pem"))
  #:output-file "tls.out" (tls:main))

(test trap-handlers #:grants ((fake timer)) #:output-file "trap-handlers.out" (trap-handlers:main))

(test untagged-handlers #:grants ((fake timer)) #:output-file "untagged-handlers.out" (untagged-handlers:main))

(test watch #:linux #:output-file "watch.out" (watch:main (scratch-directory)))

(test websocket #:grants ((all net) (fake websocket)) #:output-file "websocket.out" (websocket:run (no-servers)))

(test worker #:output-file "worker.out" (workers:main))

(test worker-grants #:output-file "worker-grants.out" (worker-grants:main))
