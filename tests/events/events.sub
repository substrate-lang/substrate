;; The programs here, each built and run in a process of its own.
(require-unqualified build std/test/build)

(test clock (expect-run "clock.sub" #:output-file "clock.out"))
(test env (expect-run "env.sub" #:grants ("-E=PATH,SUBSTRATE_NO_SUCH_VARIABLE,SUBSTRATE_SET" "--allow-run") #:output-file "env.out"))
(test env-none (expect-run "env-none.sub" #:output-file "env-none.out"))
(test err-net-grant (expect-run "err-net-grant.sub" #:grants ("--deny-net=fe80:::1") #:fails "subhost: fe80:::1 is not a host or host:port"))
(test err-read-written (expect-run "err-read-written.sub" #:grants ("-W=$SCRATCH") #:args ("$SCRATCH") #:fails "stream.read: stream 1 cannot be read"))
(test err-trap (expect-run "err-trap.sub" #:grants ("--fake=timer") #:fails "error: trap: divide by zero"))
(test err-websocket-close (expect-run "err-websocket-close.sub" #:grants ("-N") #:fails "websocket.close: the code must be 1000 or 3000 to 4999, not 1001"))
(test err-write-read (expect-run "err-write-read.sub" #:grants ("-R=.") #:fails "stream.write: stream 1 cannot be written"))
(test fetch (expect-run "fetch.sub" #:grants ("-N" "--fake=fetch:files") #:output-file "fetch.out"))
(test fetch-errors (expect-run "fetch-errors.sub" #:grants ("-N") #:output-file "fetch-errors.out"))
(test fs (expect-run "fs.sub" #:grants ("-R=$SCRATCH" "-W=$SCRATCH") #:args ("$SCRATCH") #:output-file "fs.out"))
(test fs-calls (expect-run "fs-calls.sub" #:grants ("-R" "-W") #:args ("$SCRATCH") #:output-file "fs-calls.out"))
(test fs-open-file (expect-run "fs-open-file.sub" #:grants ("-R" "-W") #:args ("$SCRATCH") #:output-file "fs-open-file.out"))
(test grants (expect-run "grants.sub" #:grants ("-R=grants,$SCRATCH/grants-out/a" "--deny-read=grants/secret" "-W=$SCRATCH/grants-out,grants/nowhere" "--deny-write=$SCRATCH/grants-out/kept" "-E=PATH" "-N=127.0.0.1" "--deny-net=127.0.0.1:9") #:args ("$SCRATCH") #:output-file "grants.out"))
(test grants-redirect (expect-run "grants-redirect.sub" #:grants ("-N=127.0.0.1" "--deny-net=10.0.0.0/8") #:output-file "grants-redirect.out"))
(test grants-resolved (expect-run "grants-resolved.sub" #:grants ("-N" "--deny-net=127.0.0.0/8:8,10.0.0.0/8,[fd00::]/8,127.0.0.1:9,[::1]:9") #:output-file "grants-resolved.out"))
(test grants-run (expect-run "grants-run.sub" #:grants ("--allow-run=true,false,grants/tool,$SCRATCH/grants-run/tool,no-such-program" "--deny-run=false" "-W=$SCRATCH/grants-run" "-E=LD_PRELOAD") #:args ("$SCRATCH") #:output-file "grants-run.out"))
(test grants-special (expect-run "grants-special.sub" #:grants ("-R" "--deny-read=grants/secret") #:output-file "grants-special.out"))
(test http (expect-run "http.sub" #:grants ("-N=127.0.0.1" "-R=files") #:output-file "http.out"))
(test net (expect-run "net.sub" #:grants ("-N=127.0.0.1") #:output-file "net.out"))
(test net-errors (expect-run "net-errors.sub" #:grants ("-N=127.0.0.1") #:output-file "net-errors.out"))
(test process (expect-run "process.sub" #:grants ("--allow-run" "-E=PATH") #:output-file "process.out"))
(test race (expect-run "race.sub" #:grants ("-N" "--fake=timer,fetch:files,clock") #:output-file "race.out"))
(test signal (expect-run "signal.sub" #:grants ("--allow-run=kill") #:output-file "signal.out"))
(test silence (expect-run "silence.sub" #:grants ("-N" "--fake=timer,fetch:files,websocket") #:output-file "silence.out"))
(test stdin (expect-run "stdin.sub" #:stdin-file "stdin.in" #:output-file "stdin.out"))
(test timers (expect-run "timers.sub" #:grants ("--fake=timer,clock") #:output-file "timers.out"))
(test tls (expect-run "tls.sub" #:grants ("-N=127.0.0.1" "--tls-cert=../../std/tests/http/tls/cert.pem" "--tls-key=../../std/tests/http/tls/key.pem") #:output-file "tls.out"))
(test trap (expect-run "trap.sub" #:grants ("--fake=timer") #:output-file "trap.out"))
(test trap-handlers (expect-run "trap-handlers.sub" #:grants ("--fake=timer") #:output-file "trap-handlers.out"))
(test untagged-handlers (expect-run "untagged-handlers.sub" #:grants ("--fake=timer") #:output-file "untagged-handlers.out"))
(test watch (expect-run "watch.sub" #:grants ("-R=$SCRATCH/watched" "-W=$SCRATCH/watched") #:args ("$SCRATCH") #:output-file "watch.out"))
(test websocket (expect-run "websocket.sub" #:grants ("-N" "--fake=websocket") #:output-file "websocket.out"))
(test worker (expect-run "worker.sub" #:output-file "worker.out"))
(test worker-grants (expect-run "worker-grants.sub" #:grants ("-R=grants") #:output-file "worker-grants.out"))
(test worker-modules (expect-run "worker-modules.sub" #:grants ("-N" "--fake=fetch:files") #:output-file "worker-modules.out"))
