;; A listener and a connection to it: the client sends a line, the server answers and finishes, both see the end.
(require-unqualified events host/events)
(require-unqualified net host/node/net)
(require-unqualified stream host/stream)

(struct side [head event-head] [name string] [listener u32] [buf (array u8 64)])

(define server side)
(define client side)
(define reply stream-reader)

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([s (cast (ptr side) tag)])
    (cond
      [(== source net-source)
       (cond [(== kind net-listening)
              (printf "listening\n")
              (net-connect (cast u32 value) "127.0.0.1" #f (& client) 0)]
             [(== kind net-accept)
              (stream-tag! (cast u32 value) (& server))
              (stream-read! (cast u32 value) (slice (-> server buf)))]
             [(== kind net-connected)
              (stream-write-text id "hello\n")
              (stream-read-all! (& reply) id client-done)]
             [(== kind net-failed)
              (let ([why (events-take-text)])
                (printf "~a: failed ~a: ~a\n" (-> s name) value why)
                (free (-> why bytes)))])]
      [(and (== kind stream-read) (> value 0))
       (stream-write-text id "echo: ")
       (stream-write id (slice (-> s buf) (cast u32 value)))
       (stream-finish id)
       (stream-read! id (slice (-> s buf)))]
      [(== kind stream-read)
       (printf "~a: end\n" (-> s name))
       (stream-close id)
       (net-close (-> server listener))]
      [(== kind stream-failed)
       (let ([why (events-take-text)])
         (printf "~a: stream failed ~a: ~a\n" (-> s name) value why)
         (free (-> why bytes)))])))

(define (client-done [r (ptr stream-reader)])
  (printf "client: ")
  (host-write 1 (buffer-bytes (& (-> r bytes))))
  (stream-close (-> r id)))

(define (main)
  (set! (-> server head handle) heard)
  (set! (-> server name) "server")
  (set! (-> client head handle) heard)
  (set! (-> client name) "client")
  (set! (-> server listener) (net-listen 0 "" #f 0 (& server) 0))
  (printf "listener ~a\n" (-> server listener)))
