;; A request: its head, then its body read 8 bytes at a time until a read returns 0; a request for a missing
;; file, its body read whole by a reader. With an argument, that is the server's URL; without, the fake answers.
(require-unqualified events "../../host/events.sub")
(require-unqualified fetch "../../host/modules/fetch.sub")
(require-unqualified stream "../../host/stream.sub")

(struct request [head event-head] [name (ptr u8)])

(define hello request)
(define missing request)
(define whole stream-reader)
(define buf (array u8 8))

(define (url [path (ptr u8)]) -> (ptr u8)
  (let* ([n u32 0] [base (host-arg 0 (& n))])
    (if (== base 0)
        path
        (let ([p (cast (ptr u8) (realloc base (+ n (strlen path) 1)))])
          (memcpy (+ p n) path (+ (strlen path) 1))
          p))))

(define (content-length [headers (ptr u8)] [n u32]) -> (ptr u8)
  (let ([at u32 0] [b (make-buffer)])
    (while (< at n)
      (let ([name (+ headers at)])
        (+= at (+ (strlen name) 1))
        (when (< at n)
          (let ([value (+ headers at)])
            (+= at (+ (strlen value) 1))
            (when (== (strcmp name "content-length") 0)
              (buffer-add-string! (& b) "content-length: ")
              (buffer-add-string! (& b) value)
              (buffer-add-byte! (& b) 0)
              (return (-> b bytes)))))))
    ""))

(define (answered [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([r (cast (ptr request) tag)])
    (cond
      [(== kind fetch-head)
       (let* ([n (events-take 0 0)] [headers (events-take-text)])
         (printf "~a: head ~a ~a\n~a\n" (-> r name) id value (content-length headers n))
         (free headers))
       (if (== r (& hello))
           (stream-read! id buf 8)
           (stream-read-all! (& whole) id read-whole))]
      [(== kind fetch-failed)
       (let ([why (events-take-text)])
         (printf "~a: failed ~a: ~a\n" (-> r name) value why)
         (free why))])))

(define (read-piece [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([r (cast (ptr request) tag)])
    (cond
      [(== kind stream-read)
       (printf "~a: read ~a" (-> r name) value)
       (when (> value 0)
         (printf ": ")
         (host-write 1 buf value))
       (printf "\n")
       (if (> value 0)
           (stream-read! id buf 8)
           (printf "started ~a\n" (fetch-get (url "/missing") (& missing))))]
      [(== kind stream-failed)
       (let ([why (events-take-text)])
         (printf "~a: read failed ~a: ~a\n" (-> r name) value why)
         (free why))])))

(define (read-whole [r (ptr stream-reader)])
  (printf "missing: ~a bytes" (-> r bytes length))
  (when (> (-> r bytes length) 0)
    (printf ": ")
    (host-write 1 (-> r bytes bytes) (cast i32 (-> r bytes length))))
  (printf "\n"))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (if (== source fetch-source)
      (answered source kind id tag value)
      (read-piece source kind id tag value)))

(define (main)
  (set! (-> hello head handle) heard)
  (set! (-> hello name) "hello")
  (set! (-> missing head handle) heard)
  (set! (-> missing name) "missing")
  (printf "started ~a\n" (fetch-get (url "/hello.txt") (& hello))))

(define (on-event [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (events-dispatch source kind id tag value))
