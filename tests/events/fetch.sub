;; Two requests: one reads its body 8 bytes at a time and the other reads it whole. When the servers' URLs are given,
;; the first one is the server to ask; otherwise the fake fetch answers.
(require-unqualified events host/events)
(require-unqualified fetch host/modules/fetch)
(require-unqualified stream host/stream)
(provide run)

(struct request [head event-head] [name string])

(define hello request)
(define missing request)
(define whole stream-reader)
(define buf (array u8 8))

(define servers (slice string))

(define (url [path string]) -> string
  (if (== (-> servers length) 0)
      path
      (let ([b (make-buffer)])
        (buffer-add-string! (& b) (@ servers 0))
        (buffer-add-string! (& b) path)
        (buffer-string (& b)))))

(define (content-length [headers (slice string)]) -> string
  (for ([i u32 0]) (< (+ i 1) (-> headers length)) (+= i 2)
    (when (== (@ headers i) "content-length")
      (let ([b (make-buffer)])
        (buffer-add-string! (& b) "content-length: ")
        (buffer-add-string! (& b) (@ headers (+ i 1)))
        (return (buffer-string (& b))))))
  "")

(define (answered [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([r (cast (ptr request) tag)])
    (cond
      [(== kind fetch-head)
       (let ([headers (events-take-strings)])
         (printf "~a: head ~a ~a\n~a\n" (-> r name) id value (content-length headers))
         (free (-> headers items)))
       (if (== r (& hello))
           (stream-read! id (slice buf))
           (stream-read-all! (& whole) id read-whole))]
      [(== kind fetch-failed)
       (let ([why (events-take-text)])
         (printf "~a: failed ~a: ~a\n" (-> r name) value why)
         (free (-> why bytes)))])))

(define (read-piece [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([r (cast (ptr request) tag)])
    (cond
      [(== kind stream-read)
       (printf "~a: read ~a" (-> r name) value)
       (when (> value 0)
         (printf ": ")
         (host-write 1 (slice buf (cast u32 value))))
       (printf "\n")
       (if (> value 0)
           (stream-read! id (slice buf))
           (printf "started ~a\n" (fetch-get (url "/missing") (& missing))))]
      [(== kind stream-failed)
       (let ([why (events-take-text)])
         (printf "~a: read failed ~a: ~a\n" (-> r name) value why)
         (free (-> why bytes)))])))

(define (read-whole [r (ptr stream-reader)])
  (printf "missing: ~a bytes" (-> r bytes length))
  (when (> (-> r bytes length) 0)
    (printf ": ")
    (host-write 1 (buffer-bytes (& (-> r bytes)))))
  (printf "\n"))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (if (== source fetch-source)
      (answered source kind id tag value)
      (read-piece source kind id tag value)))

(define (run [given (slice string)])
  (set! servers given)
  (set! (-> hello head handle) heard)
  (set! (-> hello name) "hello")
  (set! (-> missing head handle) heard)
  (set! (-> missing name) "missing")
  (printf "started ~a\n" (fetch-get (url "/hello.txt") (& hello))))

(define (main) (run (host-args)))
