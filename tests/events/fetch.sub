;; A request: its head, then reads of 8 bytes until one returns 0; a request for a missing file.
(require-unqualified events "../../lib/events.sub")
(require-unqualified fetch "../../lib/fetch.sub")
(require-unqualified host "../../compiler/host.sub")

(define buf (array u8 8))

(define (answered [source u32] [kind u32] [id u32] [value i32] [size u32] [context (ptr void)])
  (cond
    [(== kind fetch-head)
     (let ([headers (events-take-text)])
       (printf "head ~a ~a\n~a" id value headers)
       (free headers))
     (fetch-read! id buf 8)]
    [(== kind fetch-read)
     (printf "read ~a" value)
     (when (> value 0)
       (printf ": ")
       (host-write 1 buf value))
     (printf "\n")
     (cond [(> value 0) (fetch-read! id buf 8)]
           [(== id 1) (printf "started ~a\n" (fetch-get "/missing"))])]
    [(== kind fetch-failed)
     (let ([why (events-take-text)])
       (printf "failed ~a: ~a\n" id why)
       (free why))]))

(define (main)
  (event-handler! fetch-source 0 answered 0)
  (printf "started ~a\n" (fetch-get "/hello.txt")))

(define (on-event [source u32] [kind u32] [id u32] [value i32] [size u32])
  (events-dispatch source kind id value size))
