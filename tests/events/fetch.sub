;; A request: its head, then reads of 8 bytes until one returns 0; a request for a missing file. With an
;; argument, that is the server's URL; without, the fake answers.
(require-unqualified events "../../lib/events.sub")
(require-unqualified fetch "../../lib/fetch.sub")
(require-unqualified host "../../compiler/host.sub")

(struct request [head event-head] [name (ptr u8)])

(define hello request)
(define missing request)
(define buf (array u8 8))

(define (url [path (ptr u8)]) -> (ptr u8)
  (let ([n (host-arg 0 0 0)])
    (if (< n 0)
        path
        (let ([p (cast (ptr u8) (malloc (+ n (strlen path) 1)))])
          (host-arg 0 p n)
          (memcpy (+ p n) path (+ (strlen path) 1))
          p))))

(define (content-length [headers (ptr u8)]) -> (ptr u8)
  (let ([line headers])
    (while (!= (@ line) 0)
      (when (== (memcmp line "content-length:" 15) 0)
        (let ([end line])
          (while (and (!= (@ end) 0) (!= (@ end) 10)) (+= end 1))
          (set! (@ end) 0)
          (return line)))
      (while (and (!= (@ line) 0) (!= (@ line) 10)) (+= line 1))
      (when (== (@ line) 10) (+= line 1)))
    ""))

(define (answered [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([r (cast (ptr request) tag)])
    (cond
      [(== kind fetch-head)
       (let ([headers (events-take-text)])
         (printf "~a: head ~a ~a\n~a\n" (-> r name) id value (content-length headers))
         (free headers))
       (fetch-read! id buf 8)]
      [(== kind fetch-read)
       (printf "~a: read ~a" (-> r name) value)
       (when (> value 0)
         (printf ": ")
         (host-write 1 buf value))
       (printf "\n")
       (cond [(> value 0) (fetch-read! id buf 8)]
             [(== r (& hello)) (printf "started ~a\n" (fetch-get (url "/missing") (& missing)))])]
      [(== kind fetch-failed)
       (let ([why (events-take-text)])
         (printf "~a: failed ~a: ~a\n" (-> r name) value why)
         (free why))])))

(define (main)
  (set! (-> hello head handle) answered)
  (set! (-> hello name) "hello")
  (set! (-> missing head handle) answered)
  (set! (-> missing name) "missing")
  (printf "started ~a\n" (fetch-get (url "/hello.txt") (& hello))))

(define (on-event [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (events-dispatch source kind id tag value))
