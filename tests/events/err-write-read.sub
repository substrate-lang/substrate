;; Writing a file opened for reading traps.
(require-unqualified host/fs)
(require-unqualified host/stream)
(provide main)

(define (main)
  (let ([h u32 0] [s u32 0])
    (fs-open-file "events/err-write-read.sub" fs-read-flag (& h) 0)
    (fs-read-stream h 0 0 (& s) 0)
    (stream-write-text s "x")))
