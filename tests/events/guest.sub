;; A guest on a worker thread: this program runs itself as the guest, with the argument child.
(require-unqualified events "../../lib/events.sub")
(require-unqualified guest "../../lib/web/guest.sub")
(require-unqualified host "../../compiler/host.sub")

(define total i64 0)

(define (child?) -> i32 (>= (host-arg 0 0 0) 0))

(define (number [s (ptr u8)]) -> i64
  (let ([n i64 0] [i u32 0])
    (while (and (>= (@ s i) #\0) (<= (@ s i) #\9))
      (set! n (+ (* n 10) (- (@ s i) #\0)))
      (+= i 1))
    n))

(define (from-parent [source u32] [kind u32] [id u32] [value i32] [size u32] [context (ptr void)])
  (when (== kind guest-message)
    (let ([m (events-take-text)] [reply (array u8 32)])
      (cond [(== (memcmp m "add " 4) 0)
             (+= total (number (+ m 4)))
             (set! (@ reply (format-number reply total)) 0)
             (guest-send-text 0 reply)]
            [(== (memcmp m "exit" 4) 0) (host-exit 3)])
      (free m))))

(define (format-number [p (ptr u8)] [n i64]) -> u32
  (let ([i u32 0])
    (when (>= n 10) (set! i (format-number p (/ n 10))))
    (set! (@ p i) (cast u8 (+ #\0 (% n 10))))
    (+ i 1)))

(define (from-child [source u32] [kind u32] [g u32] [value i32] [size u32] [context (ptr void)])
  (let ([data (events-take-text)])
    (printf "~a ~a" g (cond [(== kind guest-message) "message"]
                           [(== kind guest-stdout) "stdout"]
                           [(== kind guest-stderr) "stderr"]
                           [(== kind guest-done) "done"]
                           [else "ended"]))
    (when (!= (@ data) 0) (printf ": ~a" data))
    (when (or (== (@ data) 0) (!= (@ data (- (strlen data) 1)) 10)) (printf "\n"))
    (when (== kind guest-message) (guest-send-text g (if (== (memcmp data "5" 2) 0) "add 37" "exit")))
    (free data)))

(define (main)
  (if (child?)
      (begin
        (event-handler! guest-source 0 from-parent 0)
        (printf "child started\n"))
      (begin
        (event-handler! guest-source 0 from-child 0)
        (let ([g (guest-start "program ../../build/tests/events/guest\narg child\ntime 5000")])
          (printf "started ~a\n" g)
          (when (== g 0)
            (let ([why (guest-error)])
              (printf "~a\n" why)
              (free why)))
          (guest-send-text g "add 5")))))

(define (on-event [source u32] [kind u32] [id u32] [value i32] [size u32])
  (events-dispatch source kind id value size))
