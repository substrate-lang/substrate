;; What only Unix file systems keep: modes, one changed and those of a temporary directory and file, and the failure of
;; a path through a file.
(require-unqualified fs host/fs)
(provide main)

(define root string "")

(define (in-build [name string]) -> string
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) root)
    (buffer-add-string! (& b) "/fs-unix/")
    (buffer-add-string! (& b) name)
    (buffer-string (& b))))

(define (permissions [path string]) -> u32
  (let ([info fs-info])
    (fs-stat path (& info) 0)
    (bit-and (-> info mode) 511)))

(define (main [dir string])
  (set! root dir)
  (let ([dir (in-build "")] [why string] [t string] [info fs-info] [through (in-build "a.txt/inside")])
    (fs-make-dir dir 0)
    (fs-write-file (in-build "a.txt") (cast (slice u8) "hello") 0)
    (fs-chmod (in-build "a.txt") 384 0)
    (printf "a.txt's permissions, changed to 384: ~a\n" (permissions (in-build "a.txt")))
    (fs-make-temp-dir dir "t-" ".d" (& t) 0)
    (printf "a temporary directory's permissions: ~a\n" (permissions t))
    (fs-make-temp-file dir "t-" ".f" (& t) 0)
    (printf "a temporary file's permissions: ~a\n" (permissions t))
    (printf "stat through a file: ~a\n"
            (if (< (fs-stat through (& info) (& why)) 0) (slice why (+ (-> through length) 2)) "found"))
    (fs-remove dir #t 0)))
