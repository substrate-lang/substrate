;; Signals: one that cannot be listened for, a name that is not a signal, the program's own pid, and SIGUSR2 sent to
;; that pid by a child program, heard once.
(require-unqualified host/events)
(require-unqualified host/node/process)
(require-unqualified host/node/signal)
(require-unqualified host/modules/timer)

(define heard event-head)
(define child event-head)
(define late event-head)
(define listener u32 0)
(define waiting u32 0)

(define (received [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (printf "received SIGUSR2\n")
  (signal-stop listener)
  (timer-cancel waiting))

(define (exited [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32]) (return))

(define (too-late [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (printf "no signal came\n")
  (signal-stop listener))

(define (refused [name string])
  (let ([why error] [id u32 0])
    (printf "listen ~a: ~a\n" name (if (signal-listen name 0 (& id) (& why)) "listening" (error-text (& why))))))

(define (main)
  (refused "SIGKILL")
  (refused "SIGNOPE")
  (printf "the pid is above 1: ~a\n" (if (> (process-pid) 1) "yes" "no"))
  (set! (-> heard handle) received)
  (set! (-> child handle) exited)
  (set! (-> late handle) too-late)
  (let ([id u32 0])
    (signal-listen "SIGUSR2" (& heard) (& id) 0)
    (set! listener id))
  (set! waiting (timer-after 5000.0 (& late)))
  (let ([pid (make-buffer)] [id u32 0])
    (write-digits (& pid) (cast u64 (process-pid)) 10)
    (process-spawn "kill" (slice (array-of string "-USR2" (buffer-string (& pid)))) 0 (& child) (& id) 0)))
