;; After a trap, each handler given to trap-handler! runs, in the order given and once however often it was given, and
;; the next event is still delivered.
(require-unqualified events host/events)
(require-unqualified timer host/modules/timer)
(provide main)

(define zero i32 0)

(define (fired [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (printf "handling ~a\n" id)
  (when (== id 1) (printf "~a\n" (/ 1 zero))))

(define (first [why string]) (printf "first\n"))

(define (second [why string]) (printf "second\n"))

(define (main)
  (event-handler! timer-source fired)
  (trap-handler! first)
  (trap-handler! second)
  (trap-handler! first)
  (timer-after 1.0 0)
  (timer-after 2.0 0)
  (printf "main done\n"))
