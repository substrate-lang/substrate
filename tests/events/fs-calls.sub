;; The file calls after Deno's, under all of -R and -W: stat and lstat of a file, a directory and a link; a link's
;; target and real path; a copy, and a copy onto the same file; a changed mode; a temporary directory and file, and a
;; temporary name that cannot be one; removing a full directory without and with recursive set; and the current
;; directory.
(require-unqualified host/fs)
(require-unqualified compiler/path)
(require-unqualified std/string)
(provide main)

(define root string "")

(define (in-build [name string]) -> string
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) root)
    (buffer-add-string! (& b) "/fs-calls/")
    (buffer-add-string! (& b) name)
    (buffer-string (& b))))

;; The reason a call on path failed, without the path before it.
(define (reason [path string] [why (ptr error)]) -> string (slice (error-text why) (+ (-> path length) 2)))

(define (kind-name [kind fs-kind]) -> string
  (cond [(== kind fs-file) "a file"]
        [(== kind fs-directory) "a directory"]
        [(== kind fs-link) "a link"]
        [else "other"]))

(define (show [label string] [name string] [follow bool])
  (let* ([path (in-build name)] [info fs-info] [why error]
         [ok (if follow (fs-stat path (& info) (& why)) (fs-lstat path (& info) (& why)))])
    (cond [(not ok) (printf "~a ~a: ~a\n" label name (reason path (& why)))]
          [(== (-> info kind) fs-directory) (printf "~a ~a: a directory\n" label name)]
          [else (printf "~a ~a: ~a of ~a bytes\n" label name (kind-name (-> info kind)) (-> info size))])))

(define (done [label string] [ok bool] [path string] [why (ptr error)])
  (printf "~a: ~a\n" label (if ok "done" (reason path why))))

;; Whether path's last part is prefix, 16 hexadecimal digits and suffix.
(define (temp-name? [path string] [prefix string] [suffix string]) -> bool
  (let ([k (-> path length)])
    (while (and (> k 0) (!= (@ path (- k 1)) #\/)) (-= k 1))
    (let* ([name (slice path k)] [p (-> prefix length)])
      (unless (and (== (-> name length) (+ p 16 (-> suffix length))) (== (slice name 0 p) prefix) (string-suffix? name suffix))
        (return #f))
      (for ([i p]) (< i (+ p 16)) (+= i 1)
        (unless (or (and (>= (@ name i) #\0) (<= (@ name i) #\9)) (and (>= (@ name i) #\a) (<= (@ name i) #\f)))
          (return #f)))
      #t)))

(define (main [dir string])
  (set! root dir)
  (let ([dir (in-build "")] [why error] [info fs-info])
    (fs-make-dir dir 0)
    (fs-write-file (in-build "a.txt") (cast (slice u8) "hello") 0)
    (show "stat" "a.txt" #t)
    (fs-stat (in-build "a.txt") (& info) 0)
    (printf "a.txt modified since 2020: ~a\n" (if (> (-> info modified) 1577836800000.0) "yes" "no"))
    (show "stat" "" #t)
    (done "symlink link to a.txt" (fs-symlink "a.txt" (in-build "link") (& why)) (in-build "link") (& why))
    (show "stat" "link" #t)
    (show "lstat" "link" #f)
    (let ([s string])
      (fs-read-link (in-build "link") (& s) 0)
      (printf "read link: ~a\n" s)
      (fs-real-path (in-build "link") (& s) 0)
      (printf "real path of link ends in fs-calls/a.txt: ~a\n" (if (string-suffix? (path-normal (path-windows?) s) "/fs-calls/a.txt") "yes" "no")))
    (done "copy a.txt to b.txt" (fs-copy (in-build "a.txt") (in-build "b.txt") (& why)) (in-build "a.txt") (& why))
    (show "stat" "b.txt" #t)
    (done "copy a.txt to link" (fs-copy (in-build "a.txt") (in-build "link") (& why)) (in-build "a.txt") (& why))
    (done "chmod b.txt to 384" (fs-chmod (in-build "b.txt") 384 (& why)) (in-build "b.txt") (& why))
    (let* ([t string] [made (fs-make-temp-dir dir "t-" ".d" (& t) (& why))])
      (printf "temporary directory named t-, 16 digits and .d: ~a\n"
              (if (and made (temp-name? t "t-" ".d")) "yes" "no"))
      (fs-stat t (& info) 0)
      (printf "it is ~a\n" (kind-name (-> info kind)))
      (done "remove it" (fs-remove t #f (& why)) t (& why)))
    (let* ([t string] [made (fs-make-temp-file dir "t-" ".f" (& t) (& why))])
      (printf "temporary file named t-, 16 digits and .f: ~a\n"
              (if (and made (temp-name? t "t-" ".f")) "yes" "no"))
      (fs-stat t (& info) 0)
      (printf "it is ~a of ~a bytes\n" (kind-name (-> info kind)) (-> info size)))
    (let ([t string])
      (printf "a temporary name with a slash: ~a\n"
              (if (fs-make-temp-file dir "a/b" "" (& t) (& why)) "made" (reason dir (& why)))))
    (done "remove fs-calls" (fs-remove dir #f (& why)) dir (& why))
    (done "remove fs-calls, with recursive" (fs-remove dir #t (& why)) dir (& why))
    (show "stat" "" #t)
    (let ([cwd string])
      (fs-cwd (& cwd) 0)
      (printf "the current directory ends in tests: ~a\n" (if (string-suffix? (path-normal (path-windows?) cwd) "/tests") "yes" "no")))))
