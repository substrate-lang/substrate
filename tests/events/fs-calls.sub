;; The file calls after Deno's, under all of -R and -W: stat and lstat of a file, a directory and a link; a link's
;; target and real path; a copy, and a copy onto the same file; a changed mode; a temporary directory and file, and a
;; temporary name that cannot be one; removing a full directory without and with recursive set; and the current
;; directory.
(require-unqualified fs "../../host/fs.sub")

(define (in-build [name (ptr u8)]) -> (ptr u8)
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) (host-arg-text 0))
    (buffer-add-string! (& b) "/fs-calls/")
    (buffer-add-string! (& b) name)
    (buffer-add-byte! (& b) 0)
    (-> b bytes)))

;; The reason a call on path failed, without the path before it.
(define (reason [path (ptr u8)] [why (ptr u8)]) -> (ptr u8) (+ why (strlen path) 2))

(define (ends-with? [s (ptr u8)] [end (ptr u8)]) -> i32
  (let ([n (strlen s)] [m (strlen end)])
    (and (>= n m) (== (memcmp (+ s (- n m)) end m) 0))))

(define (kind-name [kind i32]) -> (ptr u8)
  (cond [(== kind fs-file) "a file"]
        [(== kind fs-directory) "a directory"]
        [(== kind fs-link) "a link"]
        [else "other"]))

(define (show [label (ptr u8)] [name (ptr u8)] [follow i32])
  (let* ([path (in-build name)] [info fs-info] [why (ptr u8) 0]
         [r (if follow (fs-stat path (& info) (& why)) (fs-lstat path (& info) (& why)))])
    (cond [(< r 0) (printf "~a ~a: ~a\n" label name (reason path why))]
          [(== (-> info kind) fs-directory) (printf "~a ~a: a directory\n" label name)]
          [else (printf "~a ~a: ~a of ~a bytes\n" label name (kind-name (-> info kind)) (-> info size))])))

(define (done [label (ptr u8)] [r i32] [path (ptr u8)] [why (ptr u8)])
  (printf "~a: ~a\n" label (if (>= r 0) "done" (reason path why))))

(define (permissions [path (ptr u8)]) -> u32
  (let ([info fs-info])
    (fs-stat path (& info) 0)
    (bit-and (-> info mode) 511)))

;; Whether path's last part is prefix, 16 hexadecimal digits and suffix.
(define (temp-name? [path (ptr u8)] [prefix (ptr u8)] [suffix (ptr u8)]) -> i32
  (let ([k (strlen path)])
    (while (and (> k 0) (!= (@ path (- k 1)) 47)) (-= k 1))
    (let* ([name (+ path k)] [p (strlen prefix)] [i p])
      (unless (and (== (strlen name) (+ p 16 (strlen suffix))) (== (memcmp name prefix p) 0) (ends-with? name suffix))
        (return 0))
      (while (< i (+ p 16))
        (unless (or (and (>= (@ name i) 48) (<= (@ name i) 57)) (and (>= (@ name i) 97) (<= (@ name i) 102)))
          (return 0))
        (+= i 1))
      1)))

(define (main)
  (let ([dir (in-build "")] [why (ptr u8) 0] [info fs-info])
    (fs-make-dir dir (cast i32 (strlen dir)) 0)
    (fs-write-file (in-build "a.txt") "hello" 5 0)
    (show "stat" "a.txt" 1)
    (fs-stat (in-build "a.txt") (& info) 0)
    (printf "a.txt modified since 2020: ~a\n" (if (> (-> info modified) 1577836800000.0) "yes" "no"))
    (show "stat" "" 1)
    (done "symlink link to a.txt" (fs-symlink "a.txt" (in-build "link") (& why)) (in-build "link") why)
    (show "stat" "link" 1)
    (show "lstat" "link" 0)
    (printf "read link: ~a\n" (fs-read-link (in-build "link") 0))
    (printf "real path of link ends in fs-calls/a.txt: ~a\n"
            (if (ends-with? (fs-real-path (in-build "link") 0) "/fs-calls/a.txt") "yes" "no"))
    (done "copy a.txt to b.txt" (fs-copy (in-build "a.txt") (in-build "b.txt") (& why)) (in-build "a.txt") why)
    (show "stat" "b.txt" 1)
    (done "copy a.txt to link" (fs-copy (in-build "a.txt") (in-build "link") (& why)) (in-build "a.txt") why)
    (done "chmod b.txt to 384" (fs-chmod (in-build "b.txt") 384 (& why)) (in-build "b.txt") why)
    (printf "b.txt's permissions: ~a\n" (permissions (in-build "b.txt")))
    (let ([t (fs-make-temp-dir dir "t-" ".d" (& why))])
      (printf "temporary directory named t-, 16 digits and .d: ~a\n"
              (if (and (!= t 0) (temp-name? t "t-" ".d")) "yes" "no"))
      (fs-stat t (& info) 0)
      (printf "it is ~a, with permissions ~a\n" (kind-name (-> info kind)) (permissions t))
      (done "remove it" (fs-remove t 0 (& why)) t why))
    (let ([t (fs-make-temp-file dir "t-" ".f" (& why))])
      (printf "temporary file named t-, 16 digits and .f: ~a\n"
              (if (and (!= t 0) (temp-name? t "t-" ".f")) "yes" "no"))
      (fs-stat t (& info) 0)
      (printf "it is ~a of ~a bytes, with permissions ~a\n" (kind-name (-> info kind)) (-> info size) (permissions t)))
    (printf "a temporary name with a slash: ~a\n"
            (if (== (fs-make-temp-file dir "a/b" "" (& why)) 0) (reason dir why) "made"))
    (done "remove fs-calls" (fs-remove dir 0 (& why)) dir why)
    (done "remove fs-calls, with recursive" (fs-remove dir 1 (& why)) dir why)
    (show "stat" "" 1)
    (printf "the current directory ends in tests/events: ~a\n"
            (if (ends-with? (fs-cwd 0) "/tests/events") "yes" "no"))))
