;; A request raced against a timeout: the request finishes first, and the timer is cancelled.
(require-unqualified events "../../host/events.sub")
(require-unqualified fetch "../../host/modules/fetch.sub")
(require-unqualified stream "../../host/stream.sub")
(require-unqualified timer "../../host/modules/timer.sub")
(require-unqualified clock "../../host/modules/clock.sub")

(struct race [head event-head] [timer u32] [bytes u32])

(define r race)
(define buf (array u8 64))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([x (cast (ptr race) tag)])
    (cond
      [(== source timer-source) (printf "timed out at ~a after ~a bytes\n" (cast i32 (clock-monotonic)) (-> x bytes))]
      [(== source fetch-source) (when (== kind fetch-head) (stream-read! id (slice buf)))]
      [(and (== kind stream-read) (> value 0))
       (+= (-> x bytes) (cast u32 value))
       (stream-read! id (slice buf))]
      [(== kind stream-read)
       (timer-cancel (-> x timer))
       (printf "fetched ~a bytes at ~a\n" (-> x bytes) (cast i32 (clock-monotonic)))])))

(define (main)
  (set! (-> r head handle) heard)
  (set! (-> r timer) (timer-after 1000.0 (& r)))
  (fetch-get "/hello.txt" (& r)))
