;; A trap while handling an event ends a program that has no trap handler.
(require-unqualified events "../../host/events.sub")
(require-unqualified timer "../../host/modules/timer.sub")

(define zero i32 0)

(define (fired [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (printf "handling ~a\n" id)
  (printf "~a\n" (/ 1 zero)))

(define (main)
  (event-handler! timer-source fired)
  (timer-after 1.0 0)
  (timer-after 2.0 0))
