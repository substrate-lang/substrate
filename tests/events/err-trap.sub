;; A trap while handling an event, with no on-trap: the program ends.
(require-unqualified events "../../lib/events.sub")
(require-unqualified timer "../../lib/timer.sub")

(define zero i32 0)

(define (fired [source u32] [kind u32] [id u32] [value i32] [size u32] [context (ptr void)])
  (printf "handling ~a\n" id)
  (printf "~a\n" (/ 1 zero)))

(define (main)
  (event-handler! timer-source 0 fired 0)
  (timer-after 1.0)
  (timer-after 2.0))

(define (on-event [source u32] [kind u32] [id u32] [value i32] [size u32])
  (events-dispatch source kind id value size))
