;; Files open by handle, under all of -R and -W: reads, writes, sizes, syncs, appends and truncation, two handles on one
;; file, and the calls that fail.
(require-unqualified fs host/fs)
(provide main)

(define root string "")

(define (in-build [name string]) -> string
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) root)
    (buffer-add-string! (& b) "/fs-open-file/")
    (buffer-add-string! (& b) name)
    (buffer-string (& b))))

;; The reason a call on path failed, without the path before it.
(define (reason [path string] [why string]) -> string (slice why (+ (-> path length) 2)))

(define (show [label string] [h u32])
  (let* ([b (array u8 24)] [n (fs-read-at h (slice b) 0 0)] [out (make-buffer)])
    (for ([i 0]) (< i n) (+= i 1) (buffer-add-byte! (& out) (if (== (@ b i) 0) 46 (@ b i))))
    (printf "~a: ~a bytes, ~s, size ~a\n" label n (buffer-string (& out)) (fs-size h 0))))

(define (done [label string] [r i32] [path string] [why string])
  (printf "~a: ~a\n" label (if (>= r 0) "done" (reason path why))))

(define (main [dir string])
  (set! root dir)
  (let* ([path (in-build "data")] [why string] [h u32 0] [g u32 0] [one (array u8 1)])
    (fs-make-dir (in-build "") 0)
    (set! h (fs-open-file path (bit-or fs-read-flag fs-write-flag fs-create-flag) (& why)))
    (printf "open to write, creating: ~a\n" (if (!= h 0) "a handle" (reason path why)))
    (fs-write-at h (cast (slice u8) "hello") 0 0)
    (fs-write-at h (cast (slice u8) "world") 10 0)
    (show "after writes at 0 and 10" h)
    (fs-write-at h (cast (slice u8) "J") 0 0)
    (show "after a write at 0" h)
    (fs-set-size h 7 0)
    (show "size set to 7" h)
    (fs-set-size h 12 0)
    (show "size set to 12" h)
    (done "sync" (fs-sync h (& why)) path why)
    (set! g (fs-open-file path 0 (& why)))
    (fs-write-at h (cast (slice u8) "!") 5 0)
    (show "a second handle, after the first wrote at 5" g)
    (done "write through it" (fs-write-at g (cast (slice u8) "x") 0 (& why)) path why)
    (done "close it" (fs-close-file g (& why)) path why)
    (done "close the first" (fs-close-file h (& why)) path why)
    (printf "read after closing: ~a\n" (if (< (fs-read-at h (slice one) 0 (& why)) 0) why "read"))
    (set! h (fs-open-file path (bit-or fs-write-flag fs-append-flag) (& why)))
    (fs-write-at h (cast (slice u8) "+") 0 0)
    (done "read through a handle opened to append" (fs-read-at h (slice one) 0 (& why)) path why)
    (fs-close-file h 0)
    (set! g (fs-open-file path 0 0))
    (show "after a write at 0 through it" g)
    (fs-close-file g 0)
    (fs-close-file (fs-open-file path (bit-or fs-write-flag fs-truncate-flag) 0) 0)
    (set! g (fs-open-file path 0 0))
    (show "after opening to truncate" g)
    (fs-close-file g 0)
    (printf "open missing: ~a\n"
            (if (== (fs-open-file (in-build "missing") 0 (& why)) 0) (reason (in-build "missing") why) "a handle"))
    (printf "create new, which exists: ~a\n"
            (if (== (fs-open-file path (bit-or fs-write-flag fs-create-new-flag) (& why)) 0) (reason path why) "a handle"))
    (fs-remove (in-build "") #t 0)))
