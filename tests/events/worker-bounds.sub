;; A program without files runs a worker, but cannot give it a folder.
(require-unqualified events "../../host/events.sub")
(require-unqualified worker "../../host/worker.sub")

(define (hello)
  (printf "hello\n")
  (host-exit 0))

(define (from-child [source u32] [kind u32] [w u32] [tag (ptr void)] [value i32])
  (let ([data (events-take-text)])
    (printf "~a ~a" w (cond [(== kind worker-stdout) "stdout"] [(== kind worker-done) "done"] [else "ended"]))
    (when (!= (@ data) 0) (printf ": ~a" data))
    (when (or (== (@ data) 0) (!= (@ data (- (strlen data) 1)) 10)) (printf "\n"))
    (free data)))

(define (main)
  (event-handler! worker-source from-child)
  (let ([w (worker-new 0)])
    (printf "read: ~a" (worker-read! w "."))
    (let ([why (worker-error)])
      (printf " ~a\n" why)
      (free why))
    (printf "run: ~a\n" (worker-run! w "hello" "" 0))))

(define (on-event [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (events-dispatch source kind id tag value))
