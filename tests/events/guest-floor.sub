;; Guests granted floor modules: this program, given its own directory, runs itself as the guest. With the
;; timer, a message arrives when it fires; without, the guest cannot start. With the parent's fake fetch, the
;; guest fetches from it. One looping in a timer handler is stopped by its time limit. One printing from a
;; timer handler is heard at once. One granted a directory cannot read through a link out of it.
(require-unqualified events "../../host/events.sub")
(require-unqualified guest "../../host/guest.sub")
(require-unqualified timer "../../host/modules/timer.sub")
(require-unqualified fetch "../../host/modules/fetch.sub")
(require-unqualified stream "../../host/stream.sub")
(require-unqualified fs "../../host/fs.sub")

(define cases (array (ptr u8) 6))
(define fired event-head)
(define answer event-head)
(define body stream-reader)
(define step i32 0)

(define (argument [i i32]) -> (ptr u8)
  (let ([n (host-arg i 0 0)])
    (if (< n 0)
        0
        (let ([p (cast (ptr u8) (malloc (+ n 1)))])
          (host-arg i p n)
          (set! (@ p n) 0)
          p))))

(define (same? [a (ptr u8)] [b (ptr u8)]) -> i32
  (let ([i u32 0])
    (while (and (== (@ a i) (@ b i)) (!= (@ a i) 0)) (+= i 1))
    (== (@ a i) (@ b i))))

;; ---- the guest ----

(define (after-timer [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (guest-send-text 0 "fired")
  (host-exit 0))

(define (forever [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (while 1 (begin)))

(define (tick [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (printf "tick\n")
  (timer-after 10000.0 (& fired)))

(define (body-read [r (ptr stream-reader)])
  (guest-send 0 (-> r bytes bytes) (-> r bytes length))
  (host-exit 0))

(define (fetched [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (== kind fetch-head) (stream-read-all! (& body) id body-read)))

(define (through-link [bounds (ptr u8)])
  (let ([path (make-buffer)] [n u32 0])
    (buffer-add-string! (& path) bounds)
    (buffer-add-string! (& path) "/inside/link/../secret.txt")
    (buffer-add-byte! (& path) 0)
    (guest-send-text 0 (if (== (fs-read-file (-> path bytes) (& n)) 0) "refused" "read through the link"))
    (host-exit 0)))

(define (child [case (ptr u8)] [bounds (ptr u8)])
  (cond [(same? case "timer")
         (set! (-> fired handle) after-timer)
         (timer-after 10.0 (& fired))]
        [(same? case "fetch")
         (set! (-> answer handle) fetched)
         (fetch-get "http://fake/hello.txt" (& answer))]
        [(same? case "loop")
         (set! (-> fired handle) forever)
         (timer-after 1.0 (& fired))]
        [(same? case "tick")
         (set! (-> fired handle) tick)
         (timer-after 1.0 (& fired))]
        [(same? case "link") (through-link bounds)]))

;; ---- the parent ----

(define (spec [case (ptr u8)]) -> (ptr u8)
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "program ")
    (buffer-add-string! (& b) (argument 0))
    (buffer-add-string! (& b) "\narg child\narg ")
    (buffer-add-string! (& b) case)
    (buffer-add-string! (& b) "\narg ")
    (buffer-add-string! (& b) (argument 1))
    (buffer-add-string! (& b) (if (same? case "loop") "\ntime 1000" "\ntime 5000"))
    (buffer-add-string! (& b) "\nmodule fetch")
    (unless (same? case "none") (buffer-add-string! (& b) "\nmodule timer"))
    (when (same? case "link")
      (buffer-add-string! (& b) "\nread ")
      (buffer-add-string! (& b) (argument 1))
      (buffer-add-string! (& b) "/inside"))
    (buffer-add-byte! (& b) 0)
    (-> b bytes)))

(define (start!)
  (when (< step 6)
    (let ([g (guest-start (spec (@ cases step)) 0)])
      (+= step 1)
      (printf "started ~a\n" g)
      (when (== g 0)
        (let ([why (guest-error)])
          (printf "~a\n" why)
          (free why))))))

(define (from-child [source u32] [kind u32] [g u32] [tag (ptr void)] [value i32])
  (let* ([data (events-take-text)] [said data] [i u32 0])
    (while (and (!= (@ data i) 0) (!= (memcmp (+ data i) "no import" 9) 0)) (+= i 1))
    (when (!= (@ data i) 0) (set! said (+ data i)))
    (printf "~a ~a" g (cond [(== kind guest-message) "message"]
                           [(== kind guest-stdout) "stdout"]
                           [(== kind guest-stderr) "stderr"]
                           [(== kind guest-done) "done"]
                           [else "ended"]))
    (when (!= (@ said) 0) (printf ": ~a" said))
    (when (or (== (@ said) 0) (!= (@ said (- (strlen said) 1)) 10)) (printf "\n"))
    (free data)
    (when (== kind guest-ended) (start!))
    (when (and (== kind guest-stdout) (same? (@ cases (- step 1)) "tick"))
      (guest-stop g)
      (start!))))

(define (main)
  (set! (@ cases 0) "timer")
  (set! (@ cases 1) "none")
  (set! (@ cases 2) "fetch")
  (set! (@ cases 3) "loop")
  (set! (@ cases 4) "tick")
  (set! (@ cases 5) "link")
  (if (and (!= (argument 0) 0) (same? (argument 0) "child"))
      (child (argument 1) (argument 2))
      (begin
        (event-handler! guest-source from-child)
        (start!))))

(define (on-event [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (events-dispatch source kind id tag value))
