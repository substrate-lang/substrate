;; A guest granted a floor module: this program, given its own directory, runs itself as the guest, with the
;; argument child and the timer; then once more without the timer, which it needs.
(require-unqualified events "../../host/events.sub")
(require-unqualified guest "../../host/guest.sub")
(require-unqualified timer "../../host/modules/timer.sub")

(define fired event-head)

(define (child?) -> i32
  (let* ([p (array u8 8)] [n (host-arg 0 p 7)])
    (and (== n 5) (== (memcmp p "child" 5) 0))))

(define (after-timer [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (guest-send-text 0 "fired")
  (host-exit 0))

(define (from-child [source u32] [kind u32] [g u32] [tag (ptr void)] [value i32])
  (let* ([data (events-take-text)] [said data] [i u32 0])
    (while (and (!= (@ data i) 0) (!= (memcmp (+ data i) "no import" 9) 0)) (+= i 1))
    (when (!= (@ data i) 0) (set! said (+ data i)))
    (printf "~a ~a" g (cond [(== kind guest-message) "message"]
                           [(== kind guest-stdout) "stdout"]
                           [(== kind guest-stderr) "stderr"]
                           [(== kind guest-done) "done"]
                           [else "ended"]))
    (when (!= (@ said) 0) (printf ": ~a" said))
    (when (or (== (@ said) 0) (!= (@ said (- (strlen said) 1)) 10)) (printf "\n"))
    (when (and (== kind guest-ended) (== g 1)) (start! 0))
    (free data)))

(define (spec [with-timer i32]) -> (ptr u8)
  (let* ([n (host-arg 0 0 0)] [dir (cast (ptr u8) (malloc (+ n 1)))] [b (make-buffer)])
    (host-arg 0 dir n)
    (buffer-add-string! (& b) "program ")
    (buffer-add! (& b) dir (cast u32 n))
    (buffer-add-string! (& b) "\narg child\ntime 5000")
    (when with-timer (buffer-add-string! (& b) "\nmodule timer"))
    (buffer-add-byte! (& b) 0)
    (free dir)
    (-> b bytes)))

(define (start! [with-timer i32])
  (let ([g (guest-start (spec with-timer) 0)])
    (printf "started ~a\n" g)
    (when (== g 0)
      (let ([why (guest-error)])
        (printf "~a\n" why)
        (free why)))))

(define (main)
  (if (child?)
      (begin
        (set! (-> fired handle) after-timer)
        (timer-after 10.0 (& fired)))
      (begin
        (event-handler! guest-source from-child)
        (start! 1))))

(define (on-event [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (events-dispatch source kind id tag value))
