;; Timers fire after main returns, one at a time, in the order they are due, each to its tag's handler.
(require-unqualified host/events)
(require-unqualified host/modules/timer)
(require-unqualified host/modules/clock)
(provide main)

(struct ticker [head event-head] [label string])

(define a ticker)
(define b ticker)
(define c ticker)
(define late ticker)

(define (tick [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([t (cast (ptr ticker) tag)])
    (printf "~a fired at ~a\n" (-> t label) (cast i32 (clock-monotonic)))
    (when (== t (& b)) (timer-after 5.0 (& late)))))

(define (untagged [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (printf "untagged ~a fired at ~a\n" id (cast i32 (clock-monotonic))))

(define (ticker! [t (ptr ticker)] [label string])
  (set! (-> t head handle) tick)
  (set! (-> t label) label))

(define (main)
  (event-handler! timer-source untagged)
  (ticker! (& a) "a")
  (ticker! (& b) "b")
  (ticker! (& c) "c")
  (ticker! (& late) "late")
  (timer-after 30.0 (& a))
  (timer-after 10.0 (& b))
  (timer-cancel (timer-after 20.0 (& c)))
  (timer-after 40.0 0)
  (printf "main done\n"))
