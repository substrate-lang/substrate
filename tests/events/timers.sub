;; Timers fire after main returns, one at a time, in the order they are due.
(require-unqualified events "../../lib/events.sub")
(require-unqualified timer "../../lib/timer.sub")
(require-unqualified clock "../../lib/clock.sub")

(define fired-count u32 0)

(define (fired [source u32] [kind u32] [id u32] [value i32] [size u32] [context (ptr void)])
  (+= fired-count 1)
  (printf "fired ~a at ~a\n" id (cast i32 (clock-monotonic)))
  (when (== fired-count 1) (printf "set ~a\n" (timer-after 5.0))))

(define (main)
  (event-handler! timer-source 0 fired 0)
  (let ([a (timer-after 30.0)] [b (timer-after 10.0)] [c (timer-after 20.0)])
    (timer-cancel c)
    (printf "set ~a ~a ~a\n" a b c)
    (printf "main done\n")))

(define (on-event [source u32] [kind u32] [id u32] [value i32] [size u32])
  (events-dispatch source kind id value size))
