;; Child programs: one that copies its input to its output, one whose output is ignored, and two that tell whether
;; they have the parent's environment, one of them with it cleared.
(require-unqualified events "../../host/events.sub")
(require-unqualified process "../../host/node/process.sub")
(require-unqualified stream "../../host/stream.sub")
(require-unqualified env "../../host/node/env.sub")

(struct child [head event-head] [id u32] [buf (array u8 64)])

(define cat child)
(define quiet child)
(define added child)
(define cleared child)

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([c (cast (ptr child) tag)])
    (cond
      [(== source process-source)
       (if (== kind process-exit)
           (begin
             (printf "exit ~a\n" value)
             (cond [(== c (& cat)) (start-quiet!)]
                   [(== c (& quiet)) (start-env! (& added) #f)]
                   [(== c (& added)) (start-env! (& cleared) #t)]))
           (let ([why (events-take-text)])
             (printf "failed ~a: ~a\n" value why)
             (free (-> why bytes))))]
      [(and (== kind stream-read) (> value 0))
       (printf "stdout: ")
       (host-write 1 (slice (-> c buf) (cast u32 value)))
       (stream-read! id (slice (-> c buf)))]
      [(== kind stream-read) (printf "stdout end\n")])))

(define (start-quiet!)
  (set! (-> quiet head handle) heard)
  (let ([o process-options])
    (process-options-init! (& o))
    (set! (-> o stdin) process-ignore)
    (set! (-> o stdout) process-ignore)
    (set! (-> quiet id)
          (process-spawn "node" (slice (array-of string "-e" "process.stdout.write('x'.repeat(200000))")) (& o) (& quiet) 0)))
  (printf "started ~a\n" (-> quiet id)))

(define (start-env! [c (ptr child)] [clear bool])
  (set! (-> c head handle) heard)
  (let ([path (make-buffer)] [p string] [o process-options])
    (env-get "PATH" (& p) 0)
    (buffer-add-string! (& path) "PATH=")
    (buffer-add-string! (& path) p)
    (process-options-init! (& o))
    (set! (-> o clear) clear)
    (set! (-> o env) (slice (array-of string "ADDED=yes" (buffer-string (& path)))))
    (set! (-> c id)
          (process-spawn "node" (slice (array-of string "-e" "console.log(process.env.ADDED, Object.keys(process.env).length > 2)"))
                         (& o) c 0))
    (stream-read! (process-stdout (-> c id)) (slice (-> c buf)))
    (free (-> p bytes))
    (buffer-free! (& path))))

(define (main)
  (set! (-> cat head handle) heard)
  (set! (-> cat id) (process-spawn "node" (slice (array-of string "-e" "process.stdin.pipe(process.stdout)")) 0 (& cat) 0))
  (printf "started ~a\n" (-> cat id))
  (stream-write-text (process-stdin (-> cat id)) "ping\n")
  (stream-finish (process-stdin (-> cat id)))
  (stream-read! (process-stdout (-> cat id)) (slice (-> cat buf))))
