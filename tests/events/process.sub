;; A child program that copies its input to its output: a line in, the line out, then the exit. Then one
;; whose output is ignored, which exits though nothing reads it.
(require-unqualified events "../../host/events.sub")
(require-unqualified process "../../host/node/process.sub")
(require-unqualified stream "../../host/stream.sub")

(struct child [head event-head] [id u32] [buf (array u8 64)])

(define cat child)
(define quiet child)

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([c (cast (ptr child) tag)])
    (cond
      [(== source process-source)
       (if (== kind process-exit)
           (begin
             (printf "exit ~a\n" value)
             (when (== c (& cat)) (start-quiet!)))
           (let ([why (events-take-text)])
             (printf "failed ~a: ~a\n" value why)
             (free why)))]
      [(and (== kind stream-read) (> value 0))
       (printf "stdout: ")
       (host-write 1 (-> c buf) value)
       (stream-read! id (-> c buf) 64)]
      [(== kind stream-read) (printf "stdout end\n")])))

(define (two [a (ptr u8)] [b (ptr u8)]) -> buffer
  (let ([x (make-buffer)])
    (buffer-add-string! (& x) a)
    (buffer-add-byte! (& x) 0)
    (buffer-add-string! (& x) b)
    (buffer-add-byte! (& x) 0)
    x))

(define (start-quiet!)
  (set! (-> quiet head handle) heard)
  (let ([a (two "-e" "process.stdout.write('x'.repeat(200000))")] [o process-options])
    (process-options-init! (& o))
    (set! (-> o stdin) process-ignore)
    (set! (-> o stdout) process-ignore)
    (set! (-> quiet id) (process-spawn "node" (-> a bytes) (-> a length) (& o) (& quiet)))
    (buffer-free! (& a)))
  (printf "started ~a\n" (-> quiet id)))

(define (main)
  (set! (-> cat head handle) heard)
  (let ([a (two "-e" "process.stdin.pipe(process.stdout)")])
    (set! (-> cat id) (process-spawn "node" (-> a bytes) (-> a length) 0 (& cat)))
    (buffer-free! (& a)))
  (printf "started ~a\n" (-> cat id))
  (stream-write-text (process-stdin (-> cat id)) "ping\n")
  (stream-finish (process-stdin (-> cat id)))
  (stream-read! (process-stdout (-> cat id)) (-> cat buf) 64))
