;; A static server on this directory's files, and requests to it: a file, a missing one, a path with a zero byte in
;; it, a directory named without its slash, followed to its index, and a POST, refused with the methods allowed.
(require-unqualified events "../../host/events.sub")
(require-unqualified fetch "../../host/modules/fetch.sub")
(require-unqualified stream "../../host/stream.sub")
(require-unqualified http "../../lib/http/http.sub")
(require-unqualified server "../../lib/http/server.sub")
(require-unqualified static "../../lib/http/static.sub")

(define server http-server)
(define request event-head)
(define reading stream-reader)
(define url buffer)
(define asked i32 0)

(define (handle [r (ptr http-request)]) (http-static! r "files"))

(define (ask! [method (ptr u8)] [path (ptr u8)])
  (set! (-> url length) 0)
  (buffer-add-string! (& url) "http://127.0.0.1:")
  (http-add-decimal! (& url) (cast i64 (-> server port)))
  (buffer-add-string! (& url) path)
  (buffer-add-byte! (& url) 0)
  (+= asked 1)
  (fetch-start method (-> url bytes) "" 0 "" 0 (& request)))

(define (body-read [r (ptr stream-reader)])
  (when (or (== asked 1) (== asked 4))
    (printf " ")
    (host-write 1 (-> r bytes bytes) (cast i32 (-> r bytes length))))
  (printf "\n")
  (stream-close (-> r id))
  (cond [(== asked 1) (ask! "GET" "/missing.txt")]
        [(== asked 2) (ask! "GET" "/hello.txt%00.png")]
        [(== asked 3) (ask! "GET" "/dir")]
        [(== asked 4) (ask! "POST" "/hello.txt")]
        [else (http-server-close! (& server))]))

(define (allowed [headers (ptr u8)] [n u32]) -> (ptr u8)
  (let ([name headers] [end (+ headers n)])
    (while (< name end)
      (let ([value (entry-after name)])
        (when (and (< value end) (== (strcmp name "allow") 0)) (return value))
        (set! name (entry-after value))))
    ""))

(define (answered [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (== kind fetch-head)
    (printf "~a" value)
    (when (== value 405)
      (let* ([n u32 0] [headers (events-take (& n))])
        (printf " ~a" (allowed headers n))
        (free headers)))
    (stream-read-all! (& reading) id body-read)))

(define (listening [s (ptr http-server)])
  (printf "listening\n")
  (ask! "GET" "/hello.txt"))

(define (main)
  (set! url (make-buffer))
  (set! (-> request handle) answered)
  (set! (-> server listening) listening)
  (http-serve! (& server) 0 handle))
