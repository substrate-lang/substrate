;; A static server on this directory's files, and requests that it answers, redirects and refuses.
(require-unqualified host/events)
(require-unqualified host/modules/fetch)
(require-unqualified host/stream)
(require-unqualified std/http)
(require-unqualified std/http/server)
(require-unqualified std/http/static)
(provide main)

(define server http-server)
(define request event-head)
(define reading stream-reader)
(define url buffer)
(define asked i32 0)

(define files http-files)

(define (handle [r (ptr http-request)]) (http-static! r (& files)))

(define (ask! [method string] [path string])
  (set! (-> url length) 0)
  (buffer-add-string! (& url) "http://127.0.0.1:")
  (http-add-decimal! (& url) (cast i64 (-> server port)))
  (buffer-add-string! (& url) path)
  (+= asked 1)
  (fetch-start method (buffer-string (& url)) 0 0 (& request)))

(define (body-read [r (ptr stream-reader)])
  (when (or (== asked 1) (== asked 4))
    (printf " ")
    (host-write 1 (buffer-bytes (& (-> r bytes)))))
  (printf "\n")
  (stream-close (-> r id))
  (cond [(== asked 1) (ask! "GET" "/missing.txt")]
        [(== asked 2) (ask! "GET" "/hello.txt%00.png")]
        [(== asked 3) (ask! "GET" "/dir")]
        [(== asked 4) (ask! "POST" "/hello.txt")]
        [else (http-server-close! (& server))]))

(define (allowed [headers (slice string)]) -> string
  (for ([i u32 0]) (< (+ i 1) (-> headers length)) (+= i 2)
    (when (== (@ headers i) "allow") (return (@ headers (+ i 1)))))
  "")

(define (answered [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (== kind fetch-head)
    (printf "~a" value)
    (when (== value 405)
      (let ([headers (events-take-strings)])
        (printf " ~a" (allowed headers))
        (free (-> headers items))))
    (stream-read-all! (& reading) id body-read)))

(define (listening [s (ptr http-server)])
  (printf "listening\n")
  (ask! "GET" "/hello.txt"))

(define (main)
  (set! (-> files root) "events/files")
  (set! url (make-buffer))
  (set! (-> request handle) answered)
  (set! (-> server listening) listening)
  (http-serve! (& server) 0 handle))
