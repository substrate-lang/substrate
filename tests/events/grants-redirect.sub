;; Requests whose redirects the host follows and checks: a POST sent on to a granted host, which arrives as a GET,
;; and a request sent on to a host that is not granted, which fails.
(require-unqualified host/events)
(require-unqualified host/modules/fetch)
(require-unqualified host/stream)
(require-unqualified std/http)
(require-unqualified std/http/server)
(provide main)

(define server http-server)
(define request event-head)
(define reading stream-reader)
(define url buffer)
(define asked i32 0)

(define (moved! [r (ptr http-request)] [to string])
  (http-respond! r 302)
  (http-header! r "location" to)
  (http-finish! r))

(define (handle [r (ptr http-request)])
  (cond [(== (-> r target) "/near") (moved! r "/here")]
        [(== (-> r target) "/away") (moved! r "http://localhost:1/here")]
        [else
         (http-respond! r 200)
         (http-send-text! r (-> r method))]))

(define (ask! [method string] [path string])
  (set! (-> url length) 0)
  (buffer-add-string! (& url) "http://127.0.0.1:")
  (http-add-decimal! (& url) (cast i64 (-> server port)))
  (buffer-add-string! (& url) path)
  (+= asked 1)
  (fetch-start method (buffer-string (& url)) 0 0 (& request)))

(define (body-read [r (ptr stream-reader)])
  (printf " ")
  (host-write 1 (buffer-bytes (& (-> r bytes))))
  (printf "\n")
  (stream-close (-> r id))
  (ask! "GET" "/away"))

(define (answered [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (cond [(== kind fetch-head)
         (printf "near: ~a" value)
         (stream-read-all! (& reading) id body-read)]
        [(== kind fetch-failed)
         (printf "away: ~a ~a\n" (if (== value error-not-granted) "not granted," "failed,") (events-take-text))
         (http-server-close! (& server))]))

(define (listening [s (ptr http-server)]) (ask! "POST" "/near"))

(define (main)
  (set! url (make-buffer))
  (set! (-> request handle) answered)
  (set! (-> server listening) listening)
  (http-serve! (& server) 0 handle))
