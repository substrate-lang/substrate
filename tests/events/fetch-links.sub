;; A fake fetch from a directory: it serves a file there and a link to that file, and answers 404 for a link to a file
;; outside the directory.
(require-unqualified events host/events)
(require-unqualified fs host/fs)
(require-unqualified stream host/stream)
(require-unqualified fetch host/modules/fetch)
(provide main)

(define root string "")
(define head event-head)
(define asked u32 0)

(define (in-scratch [name string]) -> string
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) root)
    (buffer-add-string! (& b) "/")
    (buffer-add-string! (& b) name)
    (buffer-string (& b))))

(define (path-of [i u32]) -> string
  (cond [(== i 0) "/inside.txt"] [(== i 1) "/in.txt"] [else "/out.txt"]))

(define (answered [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (stream-close id)
  (printf "~a: ~a\n" (path-of asked) value)
  (+= asked 1)
  (when (< asked 3) (fetch-get (path-of asked) (& head))))

(define (main [dir string])
  (set! root dir)
  (fs-make-dir (in-scratch "served") 0)
  (fs-write-file (in-scratch "served/inside.txt") (cast (slice u8) "inside") 0)
  (fs-write-file (in-scratch "outside.txt") (cast (slice u8) "outside") 0)
  (fs-symlink "inside.txt" (in-scratch "served/in.txt") 0)
  (fs-symlink "../outside.txt" (in-scratch "served/out.txt") 0)
  (set! (-> head handle) answered)
  (fetch-get (path-of 0) (& head)))
