;; A trap while handling an event: on-trap is called, and the next event is still delivered.
(require-unqualified events "../../host/events.sub")
(require-unqualified timer "../../host/modules/timer.sub")

(define zero i32 0)

(define (fired [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (printf "handling ~a\n" id)
  (when (== id 1) (printf "~a\n" (/ 1 zero))))

(define (main)
  (event-handler! timer-source fired)
  (timer-after 1.0 0)
  (timer-after 2.0 0)
  (printf "main done\n"))

(define (on-event [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (events-dispatch source kind id tag value))

(define (on-trap) (reset-stack!) (printf "recovered\n"))
