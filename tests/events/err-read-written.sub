;; Reading a file opened for writing traps.
(require-unqualified fs host/fs)
(require-unqualified stream host/stream)

(define buf (array u8 16))

(define (main)
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) (@ (host-args) 0))
    (buffer-add-string! (& b) "/written")
    (stream-read! (fs-open (buffer-string (& b)) fs-write-mode 0 0) (slice buf))))
