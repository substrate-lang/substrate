;; Reading a file opened for writing traps.
(require-unqualified host/fs)
(require-unqualified host/stream)
(provide main)

(define buf (array u8 16))

(define (main [dir string])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) dir)
    (buffer-add-string! (& b) "/written")
    (stream-read! (fs-write-stream (fs-open-file (buffer-string (& b)) (bit-or fs-write-flag fs-create-flag fs-truncate-flag) 0)
                                   0 0 0)
                  (slice buf))))
