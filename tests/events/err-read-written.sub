;; Reading a file opened for writing traps.
(require-unqualified fs "../../host/fs.sub")
(require-unqualified stream "../../host/stream.sub")

(define buf (array u8 16))

(define (main)
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) (host-arg-text 0))
    (buffer-add-string! (& b) "/written")
    (buffer-add-byte! (& b) 0)
    (stream-read! (fs-open (-> b bytes) fs-write-mode 0 0) buf 16)))
