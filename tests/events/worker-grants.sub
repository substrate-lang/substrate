;; Workers given fewer grants than their parent: one that may read only part of what its parent may, and two that
;; ask for more than the parent has, which do not start.
(require-unqualified events host/events)
(require-unqualified fs host/fs)
(require-unqualified worker host/worker)
(require-unqualified gr host/grants)

(define (read [path string])
  (let* ([why string] [f (slice u8)])
    (printf "worker read ~a: ~a\n" path
            (if (== (fs-read-file path (& f) (& why)) 0) "granted" (slice why (+ (-> path length) 2))))))

(define (child)
  (read "grants/secret/hidden.txt")
  (read "grants/visible.txt")
  (host-exit 0))

(define (heard [source u32] [kind u32] [w u32] [tag (ptr void)] [value i32])
  (let ([data (events-take-text)])
    (when (and (== kind worker-done) (> (-> data length) 0)) (printf "worker trapped: ~a\n" data))
    (free (-> data bytes))))

(define (start [flag string])
  (let ([o worker-options] [g (make-grants)] [why string])
    (worker-options-init! (& o))
    (grants-parse! (& g) (slice (array-of string flag)) (& why))
    (set! (-> o grants) g)
    (when (== (worker-start child 0 (& o) 0 (& why)) 0) (printf "~a: ~a\n" flag why))))

(define (main)
  (event-handler! worker-source heard)
  (start "-R=grants/secret")
  (start "-R")
  (start "-N"))
