;; Workers given fewer grants than their parent: one that may read only part of what its parent may, and two that
;; ask for more than the parent has, which do not start.
(require-unqualified host/events)
(require-unqualified host/fs)
(require-unqualified host/worker)
(require-unqualified host/grants)
(provide main)

(define (read [path string])
  (let* ([why error] [f (slice u8)])
    (printf "worker read ~a: ~a\n" path
            (if (fs-read-file path (& f) (& why)) "granted" (slice (error-text (& why)) (+ (-> path length) 2))))))

(define (child)
  (read "events/grants/secret/hidden.txt")
  (read "events/grants/visible.txt")
  (host-exit 0 ""))

(define (heard [source u32] [kind u32] [w u32] [tag (ptr void)] [value i32])
  (let ([data (events-take-text)])
    (when (and (== kind worker-done) (> (-> data length) 0)) (printf "worker trapped: ~a\n" data))
    (free (-> data bytes))))

(define (start [k grant-kind] [item string])
  (let ([o worker-options] [g (make-grants)] [why string])
    (worker-options-init! (& o))
    (if (== (-> item length) 0) (grants-allow-all! (& g) k) (grants-allow! (& g) k item))
    (set! (-> o grants) g)
    (when (== (worker-start child 0 (& o) 0 (& why)) 0) (printf "~a\n" why))))

(define (main)
  (event-handler! worker-source heard)
  (start grant-read "events/grants/secret")
  (start grant-read "")
  (start grant-net ""))
