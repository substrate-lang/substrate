;; A program without files cannot start a guest: it has none to give.
(require-unqualified events "../../host/events.sub")
(require-unqualified guest "../../host/guest.sub")
(require-unqualified host "../../host/host.sub")

(define (main)
  (let* ([n (host-arg 0 0 0)] [spec (cast (ptr u8) (malloc (+ n 9)))])
    (memcpy spec "program " 8)
    (host-arg 0 (+ spec 8) n)
    (set! (@ spec (+ n 8)) 0)
    (let ([g (guest-start spec 0)])
      (printf "started ~a\n" g)
      (when (== g 0)
        (let ([why (guest-error)])
          (printf "~a\n" why)
          (free why))))))

(define (on-event [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (events-dispatch source kind id tag value))
