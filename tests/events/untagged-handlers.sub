;; Each handler given to untagged-handler! gets each event without a tag, in the order given and once however often it
;; was given.
(require-unqualified timer host/modules/timer)

(define (one [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32]) (printf "one got ~a\n" id))

(define (two [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32]) (printf "two got ~a\n" id))

(define (main)
  (untagged-handler! one)
  (untagged-handler! two)
  (untagged-handler! one)
  (timer-after 1.0 0)
  (printf "main done\n"))
