;; Workers granted floor modules, each a function of this program. With the timer, a message arrives when it
;; fires; without, the worker cannot start. With the parent's fake fetch, a worker fetches from it. One looping
;; in a timer handler is stopped by its time limit. One printing from a timer handler is heard at once. One
;; given a folder cannot read through a link out of it.
(require-unqualified events "../../host/events.sub")
(require-unqualified worker "../../host/worker.sub")
(require-unqualified timer "../../host/modules/timer.sub")
(require-unqualified fetch "../../host/modules/fetch.sub")
(require-unqualified stream "../../host/stream.sub")
(require-unqualified fs "../../host/fs.sub")

(define cases (array (ptr u8) 6))
(define fired event-head)
(define answer event-head)
(define body stream-reader)
(define step i32 0)

(define (argument [i i32]) -> (ptr u8)
  (let* ([n (host-arg i 0 0)] [p (cast (ptr u8) (malloc (+ n 1)))])
    (host-arg i p n)
    (set! (@ p n) 0)
    p))

;; ---- the workers ----

(define (after-timer [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (worker-send-text 0 "fired")
  (host-exit 0))

(define (forever [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (while 1 (begin)))

(define (tick [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (printf "tick\n")
  (timer-after 10000.0 (& fired)))

(define (body-read [r (ptr stream-reader)])
  (worker-send 0 (-> r bytes bytes) (-> r bytes length))
  (host-exit 0))

(define (fetched [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (== kind fetch-head) (stream-read-all! (& body) id body-read)))

(define (child-timer)
  (set! (-> fired handle) after-timer)
  (timer-after 10.0 (& fired)))

(define (child-fetch)
  (set! (-> answer handle) fetched)
  (fetch-get "http://fake/hello.txt" (& answer)))

(define (child-loop)
  (set! (-> fired handle) forever)
  (timer-after 1.0 (& fired)))

(define (child-tick)
  (set! (-> fired handle) tick)
  (timer-after 1.0 (& fired)))

(define (child-link)
  (let ([path (make-buffer)] [n u32 0])
    (buffer-add-string! (& path) (argument 0))
    (buffer-add-string! (& path) "/inside/link/../secret.txt")
    (buffer-add-byte! (& path) 0)
    (worker-send-text 0 (if (== (fs-read-file (-> path bytes) (& n)) 0) "refused" "read through the link"))
    (host-exit 0)))

;; ---- the parent ----

(define (start!)
  (when (< step 6)
    (let* ([case step] [w (worker-new 0)] [bounds (argument 0)] [inside (make-buffer)])
      (+= step 1)
      (worker-grant! w "fetch")
      (unless (== case 1) (worker-grant! w "timer"))
      (when (== case 3) (worker-limit! w 1000 0))
      (when (== case 5)
        (buffer-add-string! (& inside) bounds)
        (buffer-add-string! (& inside) "/inside")
        (buffer-add-byte! (& inside) 0)
        (worker-read! w (-> inside bytes)))
      (printf "started ~a\n" w)
      (when (< (worker-run! w (@ cases case) bounds (strlen bounds)) 0)
        (let ([why (worker-error)])
          (printf "~a\n" why)
          (free why))))))

(define (from-child [source u32] [kind u32] [w u32] [tag (ptr void)] [value i32])
  (let* ([data (events-take-text)] [said data] [i u32 0])
    (while (and (!= (@ data i) 0) (!= (memcmp (+ data i) "no import" 9) 0)) (+= i 1))
    (when (!= (@ data i) 0) (set! said (+ data i)))
    (printf "~a ~a" w (cond [(== kind worker-message) "message"]
                           [(== kind worker-stdout) "stdout"]
                           [(== kind worker-stderr) "stderr"]
                           [(== kind worker-done) "done"]
                           [else "ended"]))
    (when (!= (@ said) 0) (printf ": ~a" said))
    (when (or (== (@ said) 0) (!= (@ said (- (strlen said) 1)) 10)) (printf "\n"))
    (free data)
    (when (== kind worker-ended) (start!))
    (when (and (== kind worker-stdout) (== step 5))
      (worker-stop w)
      (start!))))

(define (main)
  (set! (@ cases 0) "child-timer")
  (set! (@ cases 1) "child-timer")
  (set! (@ cases 2) "child-fetch")
  (set! (@ cases 3) "child-loop")
  (set! (@ cases 4) "child-tick")
  (set! (@ cases 5) "child-link")
  (event-handler! worker-source from-child)
  (start!))

(define (on-event [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (events-dispatch source kind id tag value))
