;; Watching a directory: a file made, changed and removed in it, a directory made under it and a file in that, changes
;; under an ignored directory left out, nothing after the watch stops, and a watch on a path that may not be read.
(require-unqualified events "../../host/events.sub")
(require-unqualified fs "../../host/fs.sub")
(require-unqualified timer "../../host/modules/timer.sub")
(require-unqualified watch "../../host/node/watch.sub")

(define heard event-head)
(define step event-head)
(define steps i32 0)
(define watching u32 0)
(define last (ptr u8) "")

(define (in-build [name (ptr u8)]) -> (ptr u8)
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) (host-arg-text 0))
    (buffer-add-string! (& b) "/watched/")
    (buffer-add-string! (& b) name)
    (buffer-add-byte! (& b) 0)
    (-> b bytes)))

(define (entries-of [path (ptr u8)] [n (ptr u32)]) -> (ptr u8)
  (let ([b (make-buffer)])
    (buffer-add-entry! (& b) path)
    (set! (@ n) (-> b length))
    (-> b bytes)))

;; Each change, by its path under watched/, unless it is the same as the one before.
(define (changed [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (== kind watch-changed)
    (let ([path (events-take-text)] [line (make-buffer)])
      (buffer-add-string! (& line)
                          (cond [(== value watch-create) "create "] [(== value watch-modify) "modify "] [else "remove "]))
      (buffer-add-string! (& line) (+ path (strlen (in-build ""))))
      (buffer-add-byte! (& line) 0)
      (unless (== (strcmp (-> line bytes) last) 0)
        (printf "~a\n" (-> line bytes))
        (set! last (-> line bytes))))))

(define (write! [name (ptr u8)]) (fs-write-file (in-build name) "x" 1 0))

(define (next [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (+= steps 1)
  (cond [(== steps 1) (write! "a.txt")]
        [(== steps 2) (write! "a.txt")]
        [(== steps 3) (let ([d (in-build "sub")]) (fs-make-dir d (cast i32 (strlen d)) 0))]
        [(== steps 4) (write! "sub/b.txt")]
        [(== steps 5) (write! "skip/c.txt")]
        [(== steps 6) (fs-remove (in-build "a.txt") 0 0)]
        [(== steps 7) (watch-stop watching) (write! "d.txt")]
        [else (printf "stopped\n") (return)])
  (timer-after 100.0 (& step)))

(define (main)
  (let* ([dir (in-build "")] [skip (in-build "skip")] [why (ptr u8) 0] [n u32 0] [m u32 0] [o watch-options])
    (fs-make-dir skip (cast i32 (strlen skip)) 0)
    (watch-options-init! (& o))
    (set! (-> o ignore) (entries-of skip (& m)))
    (set! (-> o ignore-length) m)
    (set! (-> heard handle) changed)
    (set! (-> step handle) next)
    (set! watching (watch-start (entries-of dir (& n)) n (& o) (& heard) (& why)))
    (let ([here (entries-of "." (& n))] [refused (ptr u8) 0])
      (printf "watch .: ~a\n" (if (== (watch-start here n 0 0 (& refused)) 0) refused "started")))
    (timer-after 100.0 (& step))))
