;; Watching a directory: a file made, changed and removed in it, a directory made under it and a file in that, changes
;; under an ignored directory left out, nothing after the watch stops, and a watch on a path that may not be read.
(require-unqualified host/events)
(require-unqualified host/fs)
(require-unqualified host/modules/timer)
(require-unqualified host/node/watch)
(provide main)

(define heard event-head)
(define step event-head)
(define steps i32 0)
(define watching u32 0)
(define last string "")

(define root string "")

(define (in-build [name string]) -> string
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) root)
    (buffer-add-string! (& b) "/watched/")
    (buffer-add-string! (& b) name)
    (buffer-string (& b))))

;; Each change, by its path under watched/, unless it is the same as the one before.
(define (changed [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (== kind watch-changed)
    (let ([paths (events-take-strings)] [line (make-buffer)])
      (buffer-add-string! (& line) (cond [(== value watch-create) "create "]
                                         [(== value watch-modify) "modify "]
                                         [else "remove "]))
      (buffer-add-string! (& line) (slice (@ paths 0) (-> (in-build "") length)))
      (unless (== (buffer-string (& line)) last)
        (printf "~a\n" (buffer-string (& line)))
        (set! last (buffer-string (& line))))
      (free (-> paths items)))))

(define (write! [name string]) (fs-write-file (in-build name) (cast (slice u8) "x") 0))

(define (next [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (+= steps 1)
  (cond [(== steps 1) (write! "a.txt")]
        [(== steps 2) (write! "a.txt")]
        [(== steps 3) (fs-make-dir (in-build "sub") 0)]
        [(== steps 4) (write! "sub/b.txt")]
        [(== steps 5) (write! "skip/c.txt")]
        [(== steps 6) (fs-remove (in-build "a.txt") #f 0)]
        [(== steps 7) (watch-stop watching) (write! "d.txt")]
        [else (printf "stopped\n") (return)])
  (timer-after 100.0 (& step)))

(define (main [dir string])
  (set! root dir)
  (let* ([o watch-options] [paths (array string 1)] [ignored (array string 1)] [here (array string 1)] [id u32 0]
         [other u32 0] [refused error])
    (set! (@ paths 0) (in-build ""))
    (set! (@ ignored 0) (in-build "skip"))
    (set! (@ here 0) "..")
    (fs-make-dir (@ ignored 0) 0)
    (watch-options-init! (& o))
    (set! (-> o ignore) (slice ignored))
    (set! (-> heard handle) changed)
    (set! (-> step handle) next)
    (watch-start (slice paths) (& o) (& heard) (& id) 0)
    (set! watching id)
    (printf "watch ..: ~a\n"
            (if (watch-start (slice here) 0 0 (& other) (& refused)) "started" (error-text (& refused))))
    (timer-after 100.0 (& step))))
