;; Calls checked against the grants: files read inside the granted directory, in a denied part of it, through a
;; link out of it and outside it; files written inside and outside the granted one, and through a link to a missing
;; file; renames to outside it and of a file that may not be read; a link, which needs all of -R and -W, and removing
;; a directory with a denied path inside; variables; a child program; a listener; connections, to hosts written as the
;; grants are and otherwise; a request over HTTP, which needs a grant, and one for a data URL, which does not.
(require-unqualified events "../../host/events.sub")
(require-unqualified fs "../../host/fs.sub")
(require-unqualified env "../../host/node/env.sub")
(require-unqualified process "../../host/node/process.sub")
(require-unqualified net "../../host/node/net.sub")
(require-unqualified fetch "../../host/modules/fetch.sub")
(require-unqualified stream "../../host/stream.sub")

(define request event-head)
(define data-request event-head)

(define (in-build [name string]) -> string
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) (@ (host-args) 0))
    (buffer-add-byte! (& b) 47)
    (buffer-add-string! (& b) name)
    (buffer-string (& b))))

;; The reason a call on path failed, without the path before it.
(define (reason [path string] [why string]) -> string (slice why (+ (-> path length) 2)))

(define (read [path string])
  (let* ([why string] [f (slice u8)])
    (printf "read ~a: ~a\n" path (if (== (fs-read-file path (& f) (& why)) 0) "granted" (reason path why)))))

(define (write [name string])
  (let* ([why string] [path (in-build name)])
    (printf "write ~a: ~a\n" name (if (>= (fs-write-file path (cast (slice u8) "x") (& why)) 0) "granted" (reason path why)))))

(define (variable [name string])
  (let ([why string] [value string])
    (printf "env ~a: ~a\n" name (if (env-get name (& value) (& why)) "granted" why))))

(define (connect [host string] [port u32])
  (let ([why string])
    (printf "connect ~a: ~a\n" host (if (!= (net-connect port host #f 0 (& why)) 0) "granted" why))))

(define (answered [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (== kind fetch-failed)
    (printf "fetch: ~a ~a\n" (if (== value error-not-granted) "not granted," "failed,") (events-take-text))
    (fetch-get "data:,x" (& data-request))))

(define (data-answered [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (cond [(== kind fetch-head)
         (printf "fetch data: ~a\n" value)
         (stream-close id)]
        [(== kind fetch-failed) (printf "fetch data: ~a\n" (events-take-text))]))

(define (main)
  (read "grants/visible.txt")
  (read "grants/missing.txt")
  (read "grants/secret/hidden.txt")
  (read "grants/outside")
  (read "fs.sub")
  (fs-make-dir (in-build "grants-out") 0)
  (write "grants-out/a")
  (write "grants-out/b")
  (write "grants-elsewhere")
  (let ([why string])
    (printf "write grants/nowhere: ~a\n"
            (if (>= (fs-write-file "grants/nowhere" (cast (slice u8) "x") (& why)) 0) "granted" (reason "grants/nowhere" why))))
  (let* ([why string] [moved (fs-rename (in-build "grants-out/a") (in-build "grants-moved") (& why))])
    (printf "rename out: ~a\n" (if (>= moved 0) "granted" (reason (in-build "grants-out/a") why))))
  (let* ([why string] [moved (fs-rename (in-build "grants-out/b") (in-build "grants-out/c") (& why))])
    (printf "rename unread: ~a\n" (if (>= moved 0) "granted" (reason (in-build "grants-out/b") why))))
  (let* ([why string] [link (in-build "grants-out/link")])
    (printf "symlink: ~a\n" (if (>= (fs-symlink "b" link (& why)) 0) "granted" (reason link why))))
  (let* ([why string] [out (in-build "grants-out")])
    (printf "remove all of grants-out: ~a\n" (if (>= (fs-remove out #t (& why)) 0) "granted" (reason out why))))
  (variable "PATH")
  (variable "HOME")
  (let ([why string])
    (printf "spawn: ~a\n" (if (!= (process-spawn "true" 0 0 0 (& why)) 0) "granted" why)))
  (let* ([why string] [listener (net-listen 0 "" #f 0 0 (& why))])
    (printf "listen: ~a\n" (if (!= listener 0) "granted" why))
    (net-close listener))
  (connect "localhost" 80)
  (connect "2130706433" 9)
  (connect "127.1" 2)
  (set! (-> request handle) answered)
  (set! (-> data-request handle) data-answered)
  (fetch-get "http://localhost:1/" (& request)))
