;; Calls checked against the grants: files read inside the granted directory, in a denied part of it, through a
;; link out of it and outside it; files written inside and outside the granted one, and through a link to a missing
;; file; files opened to read, to write or create, which needs -W, and to read and write, which needs both; renames to
;; outside it and of a file that may
;; not be read; a link, which needs all of -R and -W, and removing
;; a directory with a denied path inside; variables; a child program; a listener; connections, to hosts written as the
;; grants are and otherwise; a request over HTTP, which needs a grant, and one for a data URL, which does not.
(require-unqualified host/events)
(require-unqualified host/fs)
(require-unqualified host/node/env)
(require-unqualified host/node/process)
(require-unqualified host/node/net)
(require-unqualified host/modules/fetch)
(require-unqualified host/stream)
(provide main)

(define request event-head)
(define data-request event-head)

(define root string "")

(define (in-build [name string]) -> string
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) root)
    (buffer-add-byte! (& b) 47)
    (buffer-add-string! (& b) name)
    (buffer-string (& b))))

;; The reason a call on path failed, without the path before it.
(define (reason [path string] [why (ptr error)]) -> string (slice (error-text why) (+ (-> path length) 2)))

(define (read [path string])
  (let* ([why error] [f (slice u8)])
    (printf "read ~a: ~a\n" path (if (fs-read-file path (& f) (& why)) "granted" (reason path (& why))))))

(define (write [name string])
  (let* ([why error] [path (in-build name)])
    (printf "write ~a: ~a\n" name
            (if (fs-write-file path (cast (slice u8) "x") (& why)) "granted" (reason path (& why))))))

(define (write-at [path string])
  (let ([why error])
    (printf "write ~a: ~a\n" path
            (if (fs-write-file path (cast (slice u8) "x") (& why)) "granted" (reason path (& why))))))

(define (open-file [label string] [path string] [flags u32])
  (let* ([why error] [h u32 0])
    (printf "open ~a: ~a\n" label (if (fs-open-file path flags (& h) (& why)) "granted" (reason path (& why))))
    (when (!= h 0) (fs-close-file h 0))))

(define (variable [name string])
  (let ([why error] [value string])
    (printf "env ~a: ~a\n" name (if (env-get name (& value) (& why)) "granted" (error-text (& why))))))

(define (connect [host string] [port u32])
  (let ([why error] [id u32 0])
    (printf "connect ~a: ~a\n" host (if (net-connect port host #f 0 (& id) (& why)) "granted" (error-text (& why))))))

(define (answered [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (== kind fetch-failed)
    (printf "fetch: ~a ~a\n" (if (== value error-not-granted) "not granted," "failed,") (events-take-text))
    (fetch-get "data:,x" (& data-request))))

(define (data-answered [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (cond [(== kind fetch-head)
         (printf "fetch data: ~a\n" value)
         (stream-close id)]
        [(== kind fetch-failed) (printf "fetch data: ~a\n" (events-take-text))]))

(define (main [dir string])
  (set! root dir)
  (read "events/grants/visible.txt")
  (read "events/grants/missing.txt")
  (read "events/grants/secret/hidden.txt")
  (read "events/grants/outside")
  (read "../README.md")
  (fs-make-dir (in-build "grants-out") 0)
  (write "grants-out/a")
  (write "grants-out/b")
  (write-at "events/grants-elsewhere")
  (write-at "events/grants/nowhere")
  (open-file "events/grants/visible.txt" "events/grants/visible.txt" 0)
  (open-file "events/grants/visible.txt to write" "events/grants/visible.txt" fs-write-flag)
  (open-file "events/grants/visible.txt to create" "events/grants/visible.txt" fs-create-flag)
  (open-file "grants-out/a to write" (in-build "grants-out/a") fs-write-flag)
  (open-file "grants-out/b to write" (in-build "grants-out/b") fs-write-flag)
  (open-file "grants-out/b to read and write" (in-build "grants-out/b") (bit-or fs-read-flag fs-write-flag))
  (let* ([why error] [moved (fs-rename (in-build "grants-out/a") "events/grants-moved" (& why))])
    (printf "rename out: ~a\n" (if moved "granted" (reason (in-build "grants-out/a") (& why)))))
  (let* ([why error] [moved (fs-rename (in-build "grants-out/b") (in-build "grants-out/c") (& why))])
    (printf "rename unread: ~a\n" (if moved "granted" (reason (in-build "grants-out/b") (& why)))))
  (let* ([why error] [link (in-build "grants-out/link")])
    (printf "symlink: ~a\n" (if (fs-symlink "b" link (& why)) "granted" (reason link (& why)))))
  (let* ([why error] [out (in-build "grants-out")])
    (printf "remove all of grants-out: ~a\n" (if (fs-remove out #t (& why)) "granted" (reason out (& why)))))
  (variable "PATH")
  (variable "HOME")
  (let ([why error] [id u32 0])
    (printf "spawn: ~a\n" (if (process-spawn "true" 0 0 0 (& id) (& why)) "granted" (error-text (& why)))))
  (let ([why error] [listener u32 0])
    (printf "listen: ~a\n" (if (net-listen 0 "" #f 0 0 (& listener) (& why)) "granted" (error-text (& why))))
    (net-close listener))
  (connect "localhost" 80)
  (connect "2130706433" 9)
  (connect "127.1" 2)
  (set! (-> request handle) answered)
  (set! (-> data-request handle) data-answered)
  (fetch-get "http://localhost:1/" (& request)))
