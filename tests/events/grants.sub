;; Calls checked against the grants: files read inside the granted directory, in a denied part of it, through a
;; link out of it and outside it; files written inside and outside the granted one; renames to outside it and of a
;; file that may not be read; variables; a child program; a listener; connections, to hosts written as the grants are
;; and otherwise; and a request.
(require-unqualified events "../../host/events.sub")
(require-unqualified fs "../../host/fs.sub")
(require-unqualified env "../../host/node/env.sub")
(require-unqualified process "../../host/node/process.sub")
(require-unqualified net "../../host/node/net.sub")
(require-unqualified fetch "../../host/modules/fetch.sub")

(define request event-head)

(define (in-build [name (ptr u8)]) -> (ptr u8)
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) (host-arg-text 0))
    (buffer-add-byte! (& b) 47)
    (buffer-add-string! (& b) name)
    (buffer-add-byte! (& b) 0)
    (-> b bytes)))

;; The reason a call on path failed, without the path before it.
(define (reason [path (ptr u8)] [why (ptr u8)]) -> (ptr u8) (+ why (strlen path) 2))

(define (read [path (ptr u8)])
  (let* ([why (ptr u8) 0] [n u32 0] [p (fs-read-file path (& n) (& why))])
    (printf "read ~a: ~a\n" path (if (!= p 0) "granted" (reason path why)))))

(define (write [name (ptr u8)])
  (let* ([why (ptr u8) 0] [path (in-build name)])
    (printf "write ~a: ~a\n" name (if (>= (fs-write-file path "x" 1 (& why)) 0) "granted" (reason path why)))))

(define (variable [name (ptr u8)])
  (let ([why (ptr u8) 0])
    (printf "env ~a: ~a\n" name (if (!= (env-text name (& why)) 0) "granted" why))))

(define (connect [host (ptr u8)] [port u32])
  (let ([why (ptr u8) 0])
    (printf "connect ~a: ~a\n" host (if (!= (net-connect port host 0 0 (& why)) 0) "granted" why))))

(define (answered [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (== kind fetch-failed)
    (printf "fetch: ~a ~a\n" (if (== value error-not-granted) "not granted," "failed,") (events-take-text))))

(define (main)
  (read "grants/visible.txt")
  (read "grants/missing.txt")
  (read "grants/secret/hidden.txt")
  (read "grants/outside")
  (read "fs.sub")
  (let ([dir (in-build "grants-out")]) (fs-make-dir dir (cast i32 (strlen dir)) 0))
  (write "grants-out/a")
  (write "grants-out/b")
  (write "grants-elsewhere")
  (let* ([why (ptr u8) 0] [moved (fs-rename (in-build "grants-out/a") (in-build "grants-moved") (& why))])
    (printf "rename out: ~a\n" (if (>= moved 0) "granted" (reason (in-build "grants-out/a") why))))
  (let* ([why (ptr u8) 0] [moved (fs-rename (in-build "grants-out/b") (in-build "grants-out/c") (& why))])
    (printf "rename unread: ~a\n" (if (>= moved 0) "granted" (reason (in-build "grants-out/b") why))))
  (variable "PATH")
  (variable "HOME")
  (let ([why (ptr u8) 0])
    (printf "spawn: ~a\n" (if (!= (process-spawn "true" "" 0 0 0 (& why)) 0) "granted" why)))
  (let* ([why (ptr u8) 0] [listener (net-listen 0 "" 0 0 0 (& why))])
    (printf "listen: ~a\n" (if (!= listener 0) "granted" why))
    (net-close listener))
  (connect "localhost" 80)
  (connect "2130706433" 9)
  (connect "127.1" 2)
  (set! (-> request handle) answered)
  (fetch-get "http://localhost:1/" (& request)))
