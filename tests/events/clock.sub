;; The clock and random modules, real ones.
(require-unqualified clock "../../host/modules/clock.sub")
(require-unqualified random "../../host/modules/random.sub")

(define (main)
  (let ([t0 (clock-monotonic)] [t1 (clock-monotonic)] [bytes (array u8 64)] [sum u32 0])
    (printf "~a\n" (if (> (clock-now) 1600000000000.0) "now is after 2020" "now is wrong"))
    (printf "~a\n" (if (>= t1 t0) "monotonic" "went back"))
    (random-fill bytes 64)
    (for ([i u32 0]) (< i 64) (+= i 1) (+= sum (@ bytes i)))
    (printf "~a\n" (if (> sum 0) "random bytes" "no random bytes"))))
