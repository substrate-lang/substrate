;; Deno's rules for Linux's /proc under -R without -A: a process's status and environ, the real path of its environ, a
;; denied file reached through /proc and a link into /proc are refused, and /proc/pressure is not.
(require-unqualified host/fs)
(provide main)

(define (outcome [path string] [result i32] [why string]) -> string
  (if (== result 0) "granted" (slice why (+ (-> path length) 2))))

(define (read [path string])
  (let ([why string] [b (slice u8)])
    (printf "read ~a: ~a\n" path (outcome path (fs-read-file path (& b) (& why)) why))))

(define (real [path string])
  (let ([why string] [real string])
    (printf "real path ~a: ~a\n" path (outcome path (fs-real-path path (& real) (& why)) why))))

(define (main)
  (read "/proc/self/status")
  (read "/proc/self/environ")
  (real "/proc/self/environ")
  (read "/proc/self/cwd/events/grants/secret/hidden.txt")
  (read "events/grants/status")
  (read "/proc/pressure/cpu"))
