;; Deno's rules for Windows under -R without -A: a device path and a UNC path are refused, and \\.\nul is not.
(require-unqualified fs host/fs)

(define (read [path string])
  (let* ([why string] [b (slice u8)] [r (fs-read-file path (& b) (& why))])
    (printf "read ~a: ~a\n" path (if (== r 0) "granted" (slice why (+ (-> path length) 2))))))

(define (main)
  (read "//./nul")
  (read "//./PhysicalDrive0")
  (read "//localhost/c$/Windows/win.ini")
  (read "grants/visible.txt"))
