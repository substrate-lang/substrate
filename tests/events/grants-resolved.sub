;; A deny list of subnets: connections to addresses in them fail, a connection, a request and a WebSocket to
;; localhost, which resolves into one on its denied port, fail, and a connection to localhost on another port is made.
(require-unqualified events "../../host/events.sub")
(require-unqualified net "../../host/node/net.sub")
(require-unqualified fetch "../../host/modules/fetch.sub")
(require-unqualified websocket "../../host/modules/websocket.sub")
(require-unqualified stream "../../host/stream.sub")

(define step event-head)
(define listener u32 0)

(define (refused [host (ptr u8)] [port u32])
  (let ([why (ptr u8) 0])
    (printf "connect ~a: ~a\n" host (if (!= (net-connect port host 0 0 (& why)) 0) "granted" why))))

(define (failed [what (ptr u8)] [code i32])
  (printf "~a: ~a ~a\n" what (if (== code error-not-granted) "not granted," "failed,") (events-take-text)))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (cond [(and (== source net-source) (== kind net-failed))
         (failed "connect localhost:8" value)
         (fetch-get "http://localhost:8/" (& step))]
        [(and (== source fetch-source) (== kind fetch-failed))
         (failed "fetch localhost:8" value)
         (websocket-connect "ws://localhost:8/" (& step) 0)]
        [(and (== source websocket-source) (== kind websocket-failed))
         (failed "websocket localhost:8" value)
         (set! listener (net-listen 0 "" 0 0 (& step) 0))]
        [(and (== source net-source) (== kind net-listening))
         (net-connect (cast u32 value) "localhost" 0 (& step) 0)]
        [(and (== source net-source) (== kind net-connected))
         (printf "connect localhost: connected\n")
         (stream-close id)]
        [(and (== source net-source) (== kind net-accept))
         (stream-close (cast u32 value))
         (net-close listener)]))

(define (main)
  (set! (-> step handle) heard)
  (refused "127.0.0.2" 8)
  (refused "10.1.2.3" 80)
  (refused "fd12::1" 80)
  (net-connect 8 "localhost" 0 (& step) 0))
