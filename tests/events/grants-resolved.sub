;; A deny list of subnets: connections to addresses in them fail, with a zone or without; a connection, a request and a
;; WebSocket to localhost, which resolves into one on its denied port, fail, as does a listener on a port where
;; localhost's addresses are denied; and a connection to localhost on another port is made.
(require-unqualified host/events)
(require-unqualified host/node/net)
(require-unqualified host/modules/fetch)
(require-unqualified host/modules/websocket)
(require-unqualified host/stream)
(provide main)

(define step event-head)
(define refusal event-head)
(define listener u32 0)

(define (refused [host string] [port u32])
  (let ([why string])
    (printf "connect ~a: ~a\n" host (if (!= (net-connect port host #f 0 (& why)) 0) "granted" why))))

(define (failed [what string] [code i32])
  (printf "~a: ~a ~a\n" what (if (== code error-not-granted) "not granted," "failed,") (events-take-text)))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (cond [(and (== source net-source) (== kind net-failed))
         (failed "connect localhost:8" value)
         (fetch-get "http://localhost:8/" (& step))]
        [(and (== source fetch-source) (== kind fetch-failed))
         (failed "fetch localhost:8" value)
         (websocket-connect "ws://localhost:8/" 0 (& step) 0)]
        [(and (== source websocket-source) (== kind websocket-failed))
         (failed "websocket localhost:8" value)
         (net-listen 9 "localhost" #f 0 (& refusal) 0)]
        [(and (== source net-source) (== kind net-listening))
         (net-connect (cast u32 value) "localhost" #f (& step) 0)]
        [(and (== source net-source) (== kind net-connected))
         (printf "connect localhost: connected\n")
         (stream-close id)]
        [(and (== source net-source) (== kind net-accept))
         (stream-close (cast u32 value))
         (net-close listener)]))

(define (listen-refused [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (== kind net-failed)
    (printf "listen localhost:9: ~a\n" (if (== value error-not-granted) "not granted" "failed"))
    (set! listener (net-listen 0 "" #f 0 (& step) 0))))

(define (main)
  (set! (-> step handle) heard)
  (set! (-> refusal handle) listen-refused)
  (refused "127.0.0.2" 8)
  (refused "10.1.2.3" 80)
  (refused "fd12::1" 80)
  (refused "fd12::1%lo" 80)
  (net-connect 8 "localhost" #f (& step) 0))
