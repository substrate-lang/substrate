;; The failure codes for a request to a URL that is not one, and for one to a port where nothing listens.
(require-unqualified host/events)
(require-unqualified host/modules/fetch)
(provide main)

(struct request [head event-head] [name string])

(define bad request)
(define closed request)

(define (named [code i32]) -> string
  (cond [(== code error-invalid) "invalid"]
        [(== code error-refused) "refused"]
        [else "something else"]))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([r (cast (ptr request) tag)])
    (when (== kind fetch-failed)
      (printf "~a: ~a\n" (-> r name) (named value))
      (when (== r (& bad)) (fetch-get "http://127.0.0.1:2/" (& closed))))))

(define (main)
  (set! (-> bad head handle) heard)
  (set! (-> bad name) "not a URL")
  (set! (-> closed head handle) heard)
  (set! (-> closed name) "nothing listening")
  (fetch-get "not a url" (& bad)))
