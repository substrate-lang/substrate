;; The server for the event tests run against the real modules. It serves a directory's files, echoes WebSocket
;; messages at any path, and prints its URL once it listens.
(require-unqualified host/events)
(require-unqualified std/http)
(require-unqualified std/http/server)
(require-unqualified std/http/static)
(require-unqualified std/http/websocket)

(define server http-server)
(define files http-files)

(define (echoed [w (ptr ws-connection)] [b (slice u8)] [kind i32]) (ws-send! w b kind))

(define (echo-closed [w (ptr ws-connection)] [code i32]) (free w))

(define (handle [r (ptr http-request)])
  (if (ws-upgrade? r)
      (let ([w (cast (ptr ws-connection) (calloc 1 (sizeof ws-connection)))])
        (set! (-> w on-message) echoed)
        (set! (-> w on-closed) echo-closed)
        (unless (ws-accept! w r "") (free w)))
      (http-static! r (& files))))

(define (listening [s (ptr http-server)])
  (let ([line (make-buffer)])
    (buffer-add-string! (& line) "http://127.0.0.1:")
    (http-add-decimal! (& line) (cast i64 (-> s port)))
    (buffer-add-string! (& line) "\n")
    (host-write 1 (buffer-bytes (& line)))
    (buffer-free! (& line))))

(define (main)
  (let ([dir (@ (host-args) 0)])
    (set! (-> files root) dir)
    (set! (-> server listening) listening)
    (http-serve! (& server) 0 handle)))
