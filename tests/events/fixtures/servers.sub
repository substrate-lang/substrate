;; The server for the event tests against the real modules: a directory's files, and WebSocket messages echoed
;; at any path. The URL is printed once it listens.
(require-unqualified events "../../../host/events.sub")
(require-unqualified http "../../../lib/http/http.sub")
(require-unqualified server "../../../lib/http/server.sub")
(require-unqualified static "../../../lib/http/static.sub")
(require-unqualified ws "../../../lib/http/websocket.sub")

(define server http-server)
(define root (ptr u8) 0)

(define (echoed [w (ptr ws-connection)] [p (ptr u8)] [n u32] [kind i32]) (ws-send! w p n kind))

(define (echo-closed [w (ptr ws-connection)] [code i32]) (free w))

(define (handle [r (ptr http-request)])
  (if (ws-upgrade? r)
      (let ([w (cast (ptr ws-connection) (calloc 1 (sizeof ws-connection)))])
        (set! (-> w on-message) echoed)
        (set! (-> w on-closed) echo-closed)
        (ws-accept! w r))
      (http-static! r root)))

(define (listening [s (ptr http-server)])
  (let ([line (make-buffer)])
    (buffer-add-string! (& line) "http://127.0.0.1:")
    (http-add-decimal! (& line) (cast i64 (-> s port)))
    (buffer-add-string! (& line) "\n")
    (host-write 1 (-> line bytes) (cast i32 (-> line length)))
    (buffer-free! (& line))))

(define (main)
  (let ([dir (host-arg-text 0)])
    (set! root dir)
    (set! (-> server listening) listening)
    (http-serve! (& server) 0 handle)))
