;; The environment: a variable that is set, and one that is not; one the program sets, which a child it runs inherits
;; and the list of granted variables shows, and then deletes; and changes refused, to a variable not granted and to a
;; name a variable cannot have.
(require-unqualified events "../../host/events.sub")
(require-unqualified env "../../host/node/env.sub")
(require-unqualified process "../../host/node/process.sub")
(require-unqualified stream "../../host/stream.sub")

(define child event-head)
(define buf (array u8 64))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (and (== kind stream-read) (> value 0))
    (printf "child: ")
    (host-write 1 (slice buf (cast u32 value)))
    (stream-read! id (slice buf))))

(define (changed [what string] [result i32] [why string])
  (printf "~a: ~a\n" what (if (== result 0) "done" why)))

(define (listed-names)
  (let ([listed (slice string)])
    (env-list (& listed) 0)
    (printf "listed:")
    (for ([i u32 0]) (< i (-> listed length)) (+= i 1)
      (let ([e (@ listed i)] [k u32 0])
        (while (!= (@ e k) 61) (+= k 1))
        (printf " ~a" (slice e 0 k))))
    (printf "\n")))

(define (main)
  (let ([value string])
    (printf "~a\n" (if (env-get "PATH" (& value) 0) "PATH is set" "PATH is unset"))
    (printf "~a\n" (if (env-get "SUBSTRATE_NO_SUCH_VARIABLE" (& value) 0) "the other is set" "the other is unset")))
  (let ([why string] [value string])
    (changed "set SUBSTRATE_SET" (env-set "SUBSTRATE_SET" "yes" (& why)) why)
    (env-get "SUBSTRATE_SET" (& value) 0)
    (printf "SUBSTRATE_SET is ~a\n" value)
    (listed-names)
    (set! (-> child handle) heard)
    (stream-read! (process-stdout (process-spawn "node" (slice (array-of string "-e" "console.log(process.env.SUBSTRATE_SET)"))
                                                 0 (& child) 0))
                  (slice buf))
    (changed "delete SUBSTRATE_SET" (env-delete "SUBSTRATE_SET" (& why)) why)
    (printf "SUBSTRATE_SET is ~a\n" (if (env-get "SUBSTRATE_SET" (& value) 0) "set" "unset"))
    (changed "set HOME" (env-set "HOME" "/" (& why)) why)
    (changed "set A=B" (env-set "A=B" "x" (& why)) why)))
