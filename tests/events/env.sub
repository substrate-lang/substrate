;; The environment: a variable that is set, and one that is not; one the program sets, which a child it runs inherits,
;; and then deletes; and changes refused, to a variable not granted and to a name a variable cannot have.
(require-unqualified events "../../host/events.sub")
(require-unqualified env "../../host/node/env.sub")
(require-unqualified process "../../host/node/process.sub")
(require-unqualified stream "../../host/stream.sub")

(define child event-head)
(define buf (array u8 64))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (and (== kind stream-read) (> value 0))
    (printf "child: ")
    (host-write 1 buf value)
    (stream-read! id buf 64)))

(define (changed [what (ptr u8)] [result i32] [why (ptr u8)])
  (printf "~a: ~a\n" what (if (== result 0) "done" why)))

(define (main)
  (let ([path (env-text "PATH" 0)] [missing (env-text "SUBSTRATE_NO_SUCH_VARIABLE" 0)])
    (printf "~a\n" (if (!= path 0) "PATH is set" "PATH is unset"))
    (printf "~a\n" (if (== missing 0) "the other is unset" "the other is set")))
  (let ([why (ptr u8) 0] [a (make-buffer)])
    (changed "set SUBSTRATE_SET" (env-set "SUBSTRATE_SET" "yes" (& why)) why)
    (printf "SUBSTRATE_SET is ~a\n" (env-text "SUBSTRATE_SET" 0))
    (set! (-> child handle) heard)
    (buffer-add-entry! (& a) "-e")
    (buffer-add-entry! (& a) "console.log(process.env.SUBSTRATE_SET)")
    (stream-read! (process-stdout (process-spawn "node" (-> a bytes) (-> a length) 0 (& child) 0)) buf 64)
    (changed "delete SUBSTRATE_SET" (env-delete "SUBSTRATE_SET" (& why)) why)
    (printf "SUBSTRATE_SET is ~a\n" (if (== (env-text "SUBSTRATE_SET" 0) 0) "unset" "set"))
    (changed "set HOME" (env-set "HOME" "/" (& why)) why)
    (changed "set A=B" (env-set "A=B" "x" (& why)) why)))
