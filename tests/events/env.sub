;; The environment: a variable that is set, and one that is not.
(require-unqualified env "../../lib/env.sub")

(define (main)
  (let ([path (env-text "PATH")] [missing (env-text "SUBSTRATE_NO_SUCH_VARIABLE")])
    (printf "~a\n" (if (!= path 0) "PATH is set" "PATH is unset"))
    (printf "~a\n" (if (== missing 0) "the other is unset" "the other is set"))))
