;; A worker: this program's function child runs on a thread, answering messages until told to exit.
(require-unqualified events "../../host/events.sub")
(require-unqualified worker "../../host/worker.sub")

(define total i64 0)

(define (number [s (ptr u8)]) -> i64
  (let ([n i64 0] [i u32 0])
    (while (and (>= (@ s i) #\0) (<= (@ s i) #\9))
      (set! n (+ (* n 10) (- (@ s i) #\0)))
      (+= i 1))
    n))

(define (format-number [p (ptr u8)] [n i64]) -> u32
  (let ([i u32 0])
    (when (>= n 10) (set! i (format-number p (/ n 10))))
    (set! (@ p i) (cast u8 (+ #\0 (% n 10))))
    (+ i 1)))

(define (from-parent [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (== kind worker-message)
    (let ([m (events-take-text)] [reply (array u8 32)])
      (cond [(== (memcmp m "add " 4) 0)
             (+= total (number (+ m 4)))
             (set! (@ reply (format-number reply total)) 0)
             (worker-send-text 0 reply)]
            [(== (memcmp m "exit" 4) 0) (host-exit 3)])
      (free m))))

(define (child)
  (event-handler! worker-source from-parent)
  (printf "child started\n"))

(define (from-child [source u32] [kind u32] [w u32] [tag (ptr void)] [value i32])
  (let ([data (events-take-text)])
    (printf "~a ~a" w (cond [(== kind worker-message) "message"]
                           [(== kind worker-stdout) "stdout"]
                           [(== kind worker-stderr) "stderr"]
                           [(== kind worker-done) "done"]
                           [else "ended"]))
    (cond [(and (== kind worker-ended) (>= value 0)) (printf ": exit ~a" value)]
          [(!= (@ data) 0) (printf ": ~a" data)])
    (when (or (== (@ data) 0) (!= (@ data (- (strlen data) 1)) 10)) (printf "\n"))
    (when (== kind worker-message) (worker-send-text w (if (== (memcmp data "5" 2) 0) "add 37" "exit")))
    (free data)))

(define (main)
  (event-handler! worker-source from-child)
  (let* ([why (ptr u8) 0] [w (worker-start "child" "" 0 0 0 (& why))])
    (printf "started ~a\n" w)
    (when (== w 0)
      (printf "~a\n" why)
      (free why))
    (worker-send-text w "add 5")))
