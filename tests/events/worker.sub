;; A worker running this program's function child, which answers messages until it is told to exit.
(require-unqualified events host/events)
(require-unqualified worker host/worker)

(define total i64 0)

(define (number [s string]) -> i64
  (let ([n i64 0])
    (for ([i u32 0]) (and (< i (-> s length)) (>= (@ s i) #\0) (<= (@ s i) #\9)) (+= i 1)
      (set! n (+ (* n 10) (- (@ s i) #\0))))
    n))

(define (format-number [p (ptr u8)] [n i64]) -> u32
  (let ([i u32 0])
    (when (>= n 10) (set! i (format-number p (/ n 10))))
    (set! (@ p i) (cast u8 (+ #\0 (% n 10))))
    (+ i 1)))

(define (from-parent [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (== kind worker-message)
    (let ([m (events-take-text)] [reply (array u8 32)])
      (cond [(== (memcmp (-> m bytes) "add " 4) 0)
             (+= total (number (slice m 4)))
             (worker-send 0 (slice reply (format-number reply total)))]
            [(== (memcmp (-> m bytes) "exit" 4) 0) (host-exit 3)])
      (free (-> m bytes)))))

(define (child)
  (event-handler! worker-source from-parent)
  (printf "child started\n"))

(define (from-child [source u32] [kind u32] [w u32] [tag (ptr void)] [value i32])
  (let ([data (events-take-text)])
    (printf "~a ~a" w (cond [(== kind worker-message) "message"]
                           [(== kind worker-stdout) "stdout"]
                           [(== kind worker-stderr) "stderr"]
                           [(== kind worker-done) "done"]
                           [else "ended"]))
    (cond [(and (== kind worker-ended) (>= value 0)) (printf ": exit ~a" value)]
          [(> (-> data length) 0) (printf ": ~a" data)])
    (when (or (== (-> data length) 0) (!= (@ data (- (-> data length) 1)) 10)) (printf "\n"))
    (when (== kind worker-message) (worker-send-text w (if (== data "5") "add 37" "exit")))
    (free (-> data bytes))))

(define (main)
  (event-handler! worker-source from-child)
  (let* ([why string] [w (worker-start child 0 0 0 (& why))])
    (printf "started ~a\n" w)
    (when (== w 0)
      (printf "~a\n" why)
      (free (-> why bytes)))
    (worker-send-text w "add 5")))
