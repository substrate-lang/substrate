;; A worker's environment is a copy of its parent's when it starts, so later changes on either side stay on that side.
(require-unqualified host/events)
(require-unqualified host/node/env)
(require-unqualified host/worker)
(provide main)

(define started event-head)

(define (value-of [name string]) -> string (let ([v string]) (if (env-get name (& v) 0) v "unset")))

(define (child)
  (printf "the worker sees ~a\n" (value-of "SUBSTRATE_SET"))
  (env-set "SUBSTRATE_SET" "the worker's" 0))

(define (done [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (== kind worker-done)
    (printf "the parent sees ~a\n" (value-of "SUBSTRATE_SET"))
    (worker-stop id)))

(define (main)
  (let ([id u32 0])
    (env-set "SUBSTRATE_SET" "the parent's" 0)
    (set! (-> started handle) done)
    (worker-start child (slice (cast (ptr u8) 0) 0) 0 (cast (ptr void) (& started)) (& id) 0)
    (env-delete "SUBSTRATE_SET" 0)))
