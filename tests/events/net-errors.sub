;; The failure codes for a listener on a port another holds, and for a connection to a port no one listens on.
(require-unqualified host/events)
(require-unqualified host/node/net)
(provide main)

(struct side [head event-head] [name string])

(define first side)
(define second side)
(define client side)
(define listener u32 0)

(define (named [code i32]) -> string
  (cond [(== code error-in-use) "in use"]
        [(== code error-refused) "refused"]
        [else "something else"]))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([s (cast (ptr side) tag)])
    (cond [(== kind net-listening) (net-listen (cast u32 value) "" #f 0 (& second) 0)]
          [(== kind net-failed)
           (printf "~a: ~a\n" (-> s name) (named value))
           (if (== s (& second))
               (net-connect 1 "127.0.0.1" #f (& client) 0)
               (net-close listener))])))

(define (main)
  (set! (-> first head handle) heard)
  (set! (-> second head handle) heard)
  (set! (-> second name) "second listener")
  (set! (-> client head handle) heard)
  (set! (-> client name) "connection")
  (set! listener (net-listen 0 "" #f 0 (& first) 0)))
