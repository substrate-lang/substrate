;; Deno's rules for /dev, /proc and /sys under -R without -A: a process's status and environ, the real path of its
;; environ, a denied file reached through /proc, a link into /proc and /dev/stdin are refused; /dev/null, a stat of
;; /dev/tty, /proc/pressure and other files are not.
(require-unqualified fs "../../host/fs.sub")

(define (outcome [path string] [why string]) -> string
  (if (== (-> why bytes) 0) "granted" (slice why (+ (-> path length) 2))))

(define (read [path string])
  (let ([why string])
    (fs-read-file path (& why))
    (printf "read ~a: ~a\n" path (outcome path why))))

(define (stat [path string])
  (let ([why string] [info fs-info])
    (fs-stat path (& info) (& why))
    (printf "stat ~a: ~a\n" path (outcome path why))))

(define (real [path string])
  (let ([why string])
    (fs-real-path path (& why))
    (printf "real path ~a: ~a\n" path (outcome path why))))

(define (main)
  (read "/proc/self/status")
  (read "/proc/self/environ")
  (real "/proc/self/environ")
  (read "/proc/self/cwd/grants/secret/hidden.txt")
  (read "grants/status")
  (read "/dev/stdin")
  (read "/dev/null")
  (stat "/dev/tty")
  (read "/proc/pressure/cpu")
  (read "grants/visible.txt")
  (read "grants/secret/hidden.txt"))
