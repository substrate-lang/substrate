;; Deno's rules for /dev under -R without -A: /dev/stdin is refused; /dev/null, a stat of /dev/tty and other files are
;; not. grants-proc.sub has the rules for Linux's /proc, and grants-windows.sub those for Windows.
(require-unqualified fs host/fs)
(provide main)

(define (outcome [path string] [result i32] [why string]) -> string
  (if (== result 0) "granted" (slice why (+ (-> path length) 2))))

(define (read [path string])
  (let ([why string] [b (slice u8)])
    (printf "read ~a: ~a\n" path (outcome path (fs-read-file path (& b) (& why)) why))))

(define (stat [path string])
  (let ([why string] [info fs-info])
    (printf "stat ~a: ~a\n" path (outcome path (fs-stat path (& info) (& why)) why))))

(define (main)
  (read "/dev/stdin")
  (read "/dev/null")
  (stat "/dev/tty")
  (read "events/grants/visible.txt")
  (read "events/grants/secret/hidden.txt"))
