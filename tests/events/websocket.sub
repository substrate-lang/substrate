;; A WebSocket connection opened, echoed and closed, after which nothing arrives. A second argument gives the echo
;; server's URL; without one, the fake answers.
(require-unqualified events "../../host/events.sub")
(require-unqualified websocket "../../host/modules/websocket.sub")

(struct link [head event-head] [messages u32])

(define echo link)

(define (url) -> string
  (let ([base (host-arg 1)])
    (if (== (-> base bytes) 0)
        "ws://fake/echo"
        (let ([b (make-buffer)])
          (buffer-add-string! (& b) base)
          (buffer-add-string! (& b) "/echo")
          (buffer-string (& b))))))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([l (cast (ptr link) tag)])
    (cond
      [(== kind websocket-open)
       (printf "open ~a\n" id)
       (websocket-send-text id "hello")]
      [(== kind websocket-message)
       (let ([m (events-take-text)])
         (+= (-> l messages) 1)
         (printf "message ~a ~a: ~a\n" id (if (== value websocket-text) "text" "binary") m)
         (free (-> m bytes)))
       (websocket-send-text id "goodbye")
       (websocket-close id 1000)]
      [(== kind websocket-closed) (printf "closed ~a ~a\n" id value)]
      [(== kind websocket-failed)
       (let ([m (events-take-text)])
         (printf "failed ~a ~a: ~a\n" id value m)
         (free (-> m bytes)))])))

(define (main)
  (set! (-> echo head handle) heard)
  (printf "connecting ~a\n" (websocket-connect (url) 0 (& echo) 0)))
