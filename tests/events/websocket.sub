;; A connection: open, a message sent and heard back, then closed.
(require-unqualified events "../../lib/events.sub")
(require-unqualified websocket "../../lib/websocket.sub")

(define (heard [source u32] [kind u32] [id u32] [value i32] [size u32] [context (ptr void)])
  (cond
    [(== kind websocket-open)
     (printf "open ~a\n" id)
     (websocket-send-text id "hello")]
    [(== kind websocket-message)
     (let ([m (events-take-text)])
       (printf "message ~a: ~a\n" id m)
       (free m))
     (websocket-close id 1000)]
    [(== kind websocket-closed) (printf "closed ~a ~a\n" id value)]
    [(== kind websocket-failed)
     (let ([m (events-take-text)])
       (printf "failed ~a: ~a\n" id m)
       (free m))]))

(define (main)
  (event-handler! websocket-source 0 heard 0)
  (printf "connecting ~a\n" (websocket-connect "ws://fake/echo")))

(define (on-event [source u32] [kind u32] [id u32] [value i32] [size u32])
  (events-dispatch source kind id value size))
