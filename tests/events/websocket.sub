;; A connection: open, a message sent and heard back, then closed, after which nothing more arrives.
;; With a second argument, that is the echo server's URL; without, the fake answers.
(require-unqualified events "../../lib/events.sub")
(require-unqualified websocket "../../lib/websocket.sub")
(require-unqualified host "../../compiler/host.sub")

(struct link [head event-head] [messages u32])

(define echo link)

(define (url) -> (ptr u8)
  (let ([n (host-arg 1 0 0)])
    (if (< n 0)
        "ws://fake/echo"
        (let ([p (cast (ptr u8) (malloc (+ n 6)))])
          (host-arg 1 p n)
          (memcpy (+ p n) "/echo" 6)
          p))))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([l (cast (ptr link) tag)])
    (cond
      [(== kind websocket-open)
       (printf "open ~a\n" id)
       (websocket-send-text id "hello")]
      [(== kind websocket-message)
       (let ([m (events-take-text)])
         (+= (-> l messages) 1)
         (printf "message ~a: ~a\n" id m)
         (free m))
       (websocket-send-text id "goodbye")
       (websocket-close id 1000)]
      [(== kind websocket-closed) (printf "closed ~a ~a\n" id value)]
      [(== kind websocket-failed)
       (let ([m (events-take-text)])
         (printf "failed ~a ~a: ~a\n" id value m)
         (free m))])))

(define (main)
  (set! (-> echo head handle) heard)
  (printf "connecting ~a\n" (websocket-connect (url) (& echo))))

(define (on-event [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (events-dispatch source kind id tag value))
