;; Builds modules and prints each wasm module's name and hash, or the error.
(require-unqualified macros "../compiler/macros.sub")
(require-unqualified ex "../compiler/expander.sub")
(require-unqualified fs "../host/fs.sub")

(define (show [name datum] [bytes datum]) (printf "~a ~a\n" name (content-hash (cons bytes nil))))

(define (build [path datum])
  (printf ";; ~a\n" path)
  (try (for-each (lambda ([l datum]) (show (car l) (cdr l))) (program-wasm-modules (compile-module-file path)))
       [catch compile-error (message blamed loc)
        (let ([b (make-buffer)])
          (write-compile-error (& b) message blamed loc)
          (host-write 1 (buffer-bytes (& b)))
          (buffer-free! (& b)))]))

(define (file-string [path string]) -> datum
  (let ([f (slice u8)] [s datum 0])
    (when (< (fs-read-file path (& f) 0) 0) (printf "cannot read ~a\n" path) (return nil))
    (set! s (string->datum (cast string f)))
    (free (-> f items))
    s))

(define (built [dir string])
  (let* ([b (make-buffer)] [names datum 0] [start u32 0] [bytes (ptr u8) 0] [n u32 0])
    (buffer-add-string! (& b) dir)
    (buffer-add-string! (& b) "/program")
    (set! names (file-string (buffer-string (& b))))
    (set! bytes (string-bytes names))
    (set! n (string-length names))
    (for ([i u32 0]) (< i n) (+= i 1)
      (when (== (@ bytes i) 10)
        (let ([name (bytes->string (+ bytes start) (- i start))] [path (make-buffer)])
          (buffer-add-string! (& path) dir)
          (buffer-add-string! (& path) "/")
          (buffer-add! (& path) (string-bytes name) (string-length name))
          (buffer-add-string! (& path) ".wasm")
          (show name (file-string (buffer-string (& path))))
          (buffer-free! (& path)))
        (set! start (+ i 1))))
    (buffer-free! (& b))))

(define (main)
  (let ([args (host-args)])
    (if (> (-> args length) 0)
        (built (@ args 0))
        (begin
          (set-repository-root! `"..")
          (install-core!)
          (for-each (lambda ([f datum]) (build f))
                    `("tests/basics.sub" "tests/globals.sub" "tests/decimals.sub"
                      "tests/module-copies.sub" "tests/cache-tags.sub" "tests/provide-all.sub"
                      "compiler/substrate.sub"
                      "tests/err-type.sub" "tests/err-immutable.sub" "tests/err-global-init.sub"
                      "tests/err-inline-table.sub"
                      "tests/err-try-clause.sub"
                      "tests/err-open-application.sub" "tests/err-start-trap.sub" "tests/err-uncaught.sub"))))))
