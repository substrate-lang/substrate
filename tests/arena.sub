;; Arenas: chunks from 1 KB doubling up to 64 KB, shown as runs of allocations that lie one after another; a first chunk
;; of a chosen size; an allocation over 8 KB in a chunk of its own, the current chunk still in use; and buffers given
;; back when empty and large.

(define (runs [a (ptr arena)] [count u32])
  (let ([previous (ptr u8) 0] [run u32 0])
    (for ([i u32 0]) (< i count) (+= i 1)
      (let ([p (cast (ptr u8) (arena-alloc a 8))])
        (if (or (== previous 0) (== p (+ previous 8)))
            (+= run 1)
            (begin
              (printf "~a " run)
              (set! run 1)))
        (set! previous p)))
    (printf "~a\n" run)))

(define (main)
  (let ([a (make-arena)] [b (make-arena)] [c (make-arena)] [buf (make-buffer)])
    (printf "runs from 1 KB: ")
    (runs (& a) 24548)
    (arena-free (& a))
    (printf "runs from 4 KB: ")
    (arena-start! (& b) 4096)
    (runs (& b) 1600)
    (arena-free (& b))
    (let* ([p (cast (ptr u8) (arena-alloc (& c) 8))] [big (cast (ptr u8) (arena-alloc (& c) 10000))]
           [q (cast (ptr u8) (arena-alloc (& c) 8))])
      (memset big 7 10000)
      (printf "after 10000 bytes, the chunk goes on: ~a, and they hold: ~a\n" (== q (+ p 8)) (== (@ big 9999) 7)))
    (arena-free (& c))
    (for ([i u32 0]) (< i 10000) (+= i 1) (buffer-add-byte! (& buf) 120))
    (buffer-trim! (& buf) 4096)
    (printf "a full buffer is kept: ~a\n" (> (-> buf room) 0))
    (set! (-> buf length) 0)
    (buffer-trim! (& buf) 4096)
    (printf "an empty one past 4 KB is given back: ~a\n" (== (-> buf room) 0))
    (buffer-add-string! (& buf) "small")
    (set! (-> buf length) 0)
    (buffer-trim! (& buf) 4096)
    (printf "a small empty one is kept: ~a\n" (> (-> buf room) 0))
    (buffer-free! (& buf))))
