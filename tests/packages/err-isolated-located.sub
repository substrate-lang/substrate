(package err-isolated-located
  (version "0.1.0")
  (dependencies (isolated (path "isolated"))))
;; An error a package's macro raises in its own memory with only a place is reported with that place, also when it
;; reaches the compiler through a request another of the package's macros makes.
(require-unqualified isolated isolated)

(define (main) (printf "~a\n" (expanded (located))))
