(package err-supply-outside
  (version "0.1.0")
  (dependencies (cside (path "cside"))))
;; A function a C module calls by name is supplied only in its package, even by a module that gives its functions.
(require raw cside/raw)

(define (thrice [x i32]) -> i32 (* x 3))

(supply raw:twice thrice)

(define (main) (printf "~a\n" (raw:by_name 1)))
