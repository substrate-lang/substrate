(package err-supply-outside
  (version "0.1.0")
  (dependencies (cside (path "cside"))))
;; A function a C module calls by name is supplied only in the C module's package.
(require cside cside)

(define (thrice [x i32]) -> i32 (* x 3))

(supply cside:twice thrice)

(define (main) (printf "~a\n" (cside:by_name 1)))
