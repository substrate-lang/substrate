;; The package library: manifests read and refused, a program's own manifest, the package that holds a file, a
;; package's hash, and module maps: a pinned dependency, a wrong pin, two packages with one name, and the packages a
;; program trusts.
(require-unqualified manifest std/package/manifest)
(require-unqualified hash std/package/hash)
(require-unqualified map std/package/map)
(require-unqualified fs host/fs)

(define a arena)
(define cwd string)

;; local gives text with the current directory as ".".
(define (local [text string]) -> string
  (let ([b (make-buffer)] [i u32 0] [n (-> cwd length)])
    (while (< i (-> text length))
      (if (and (<= (+ i n) (-> text length)) (== (slice text i (+ i n)) cwd))
          (begin (buffer-add-byte! (& b) #\.) (+= i n))
          (begin (buffer-add-byte! (& b) (cast i32 (@ text i))) (+= i 1))))
    (buffer-string (& b))))

(define (read-manifest [file string])
  (let ([m manifest] [err (make-buffer)])
    (if (manifest-read (& a) file (& m) (& err))
        (printf "~a: ~a ~a, major ~a, ~a dependencies\n" file (-> m name) (-> m version) (-> m major)
                (-> m dependencies length))
        (printf "~a\n" (buffer-string (& err))))
    (buffer-free! (& err))))

(define (program-manifest [file string])
  (let* ([m manifest] [err (make-buffer)] [found (manifest-of-program (& a) file (& m) (& err))])
    (printf "~a: ~a\n" file (cond [(== found 1) (-> m name)] [(== found 0) "no manifest"] [else (buffer-string (& err))]))
    (buffer-free! (& err))))

(define (holder [file string])
  (let* ([m manifest] [dir (make-buffer)] [err (make-buffer)] [full (joined-path cwd file)]
         [found (manifest-find (& a) full (& m) (& dir) (& err))])
    (printf "~a is in ~a, at ~a\n" file (-> m name) (local (buffer-string (& dir))))
    (buffer-free! (& dir))
    (buffer-free! (& err))))

(define (package-map-of [dir string])
  (let* ([m manifest] [out (make-buffer)] [roots (make-buffer)] [err (make-buffer)] [full (joined-path cwd dir)]
         [file (joined-path full "package.sub")])
    (if (and (manifest-read (& a) file (& m) (& err)) (package-map (& a) full "" (& m) (& out) (& roots) (& err)))
        (printf "~a" (local (buffer-string (& out))))
        (printf "~a\n" (local (buffer-string (& err)))))
    (buffer-free! (& out))
    (buffer-free! (& roots))
    (buffer-free! (& err))))

(define (main)
  (let ([h (make-buffer)] [err (make-buffer)])
    (set! a (make-arena))
    (fs-cwd (& cwd) 0)
    (read-manifest "tools/package.sub")
    (read-manifest "manifests/bad-name.sub")
    (read-manifest "manifests/no-version.sub")
    (read-manifest "manifests/bad-version.sub")
    (read-manifest "manifests/unknown-clause.sub")
    (read-manifest "manifests/bad-dependency.sub")
    (read-manifest "manifests/bad-trusted.sub")
    (read-manifest "manifests/twice.sub")
    (read-manifest "manifests/two-forms.sub")
    (read-manifest "manifests/unclosed.sub")
    (read-manifest "manifests/missing.sub")
    (program-manifest "names.sub")
    (program-manifest "err-name.sub")
    (holder "tools/tools.sub")
    (holder "maps/lib/lib.sub")
    (package-hash "maps/lib" (& h) (& err))
    (printf "maps/lib's hash: ~a\n" (buffer-string (& h)))
    (package-map-of "maps/app")
    (package-map-of "maps/wrong-pin")
    (package-map-of "maps/dup")
    (package-map-of "maps/trusting")))
