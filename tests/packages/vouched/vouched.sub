;; Macros of a package a program trusts: whether an identifier has a compile-time value where they run, one that sets the
;; first element of an identifier's compile-time value to 1, giving what it was, one that gives that element, one that
;; runs the macro an identifier names on a form, and one that triples an expression.
(provide macro-value? bump! peek run-macro thrice)

(begin-for-syntax
  (require-unqualified macros compiler/macros)
  (define (macro-value? [stx datum]) -> datum
    (datum->syntax stx (fixnum (if (!= (syntax-local-value (cadr (syntax->list stx))) 0) 1 0)) stx))
  (define (bump! [stx datum]) -> datum
    (let* ([v (syntax-local-value (cadr (syntax->list stx)))] [was (car v)])
      (set-car! v (fixnum 1))
      (datum->syntax stx was stx)))
  (define (peek [stx datum]) -> datum
    (datum->syntax stx (car (syntax-local-value (cadr (syntax->list stx)))) stx))
  (define (run-macro [stx datum]) -> datum
    (let ([l (syntax->list stx)]) (call-transformer (syntax-local-value (cadr l)) (caddr l))))
  (define (thrice [stx datum]) -> datum
    (let ([e (cadr (syntax->list stx))]) #`(+ #,e #,e #,e))))

(define-syntax macro-value? macro-value?)
(define-syntax bump! bump!)
(define-syntax peek peek)
(define-syntax run-macro run-macro)
(define-syntax thrice thrice)
