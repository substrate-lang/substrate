;; A macro of a package whose compile-time code runs in a memory of its own, which makes a transformer with the code of
;; the stand-in it is given for a macro the compiler keeps, the word after a transformer's kind, and a serial the
;; compiler did not give, and runs it on a form.
(provide forged)

(begin-for-syntax
  (require-unqualified macros compiler/macros)
  (require wasm compiler/wasm)
  (define (forged [stx datum]) -> datum
    (let* ([l (syntax->list stx)] [code (wasm:i32.load (+ (cast i32 (syntax-local-value (cadr l))) 4))])
      (call-transformer (make-transformer (cast u32 code) (fixnum 999999)) (caddr l)))))

(define-syntax forged forged)
