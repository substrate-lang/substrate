(package err-isolated-forged
  (version "0.1.0")
  (dependencies (forger (path "forger"))))
;; A package's macro in its own memory runs only the macros the compiler gave it: one it makes up is refused.
(require forger forger)
(require json std/encoding/json)

(define (main) (printf "~a\n" (forger:forged json:json (json 1))))
