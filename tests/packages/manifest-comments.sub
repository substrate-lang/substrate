#| A manifest after a comment. |#
(package manifest-comments
  #;(version "0.0.1")
  (version "0.1.\x30;")
  (dependencies (tools (path "tools"))))
;; A program's manifest read past comments, as Substrate's reader skips them, with a string escape: the program uses
;; the package it names.
(require text tools/text)

(define (main) (printf "~a\n" (text:twice 21)))
