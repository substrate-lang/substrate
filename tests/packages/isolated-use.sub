(package isolated-use
  (version "0.1.0")
  (dependencies (isolated (path "isolated"))))
;; A package's macros run in a memory of its own: they expand as they would in the compiler's, keep their own count
;; while compiling, and ask the compiler for a compile-time value, about identifiers, and for an expansion.
(require-unqualified isolated isolated)

(define (main)
  (printf "~a ~a ~a\n" (twice 21) (counted) (counted))
  (printf "~a ~a ~a ~a\n" (count-of fields) (same? + +) (same? + -) (expanded (twice 5))))
