(package isolated-use
  (version "0.1.0")
  (dependencies (isolated (path "isolated"))))
;; A package's macros run in a memory of its own: they expand as they would in the compiler's, and keep their own count
;; while compiling.
(require-unqualified isolated isolated)

(define (main) (printf "~a ~a ~a\n" (twice 21) (counted) (counted)))
