(package names
  (version "0.1.0"))
;; Names and paths in requires, under this program's own manifest: the toolchain's packages by name, with a library of
;; std named by its directory and a module of compiler required by name and by path, which is one module; and packages
;; by path, one of which uses the other.
(require-unqualified tools "tools/tools.sub")
(require text "tools/text.sub")
(require app "app/app.sub")
(require h std/http)
(require url std/http/url)
(require fs host/fs)
(require leb compiler/leb128)
(require same-leb "../../compiler/leb128.sub")

(define (main)
  (printf "tools ~a, doubled ~a\n" (tools-version) (doubled 21))
  (text:bump!)
  (printf "bumps here ~a, through app ~a\n" (text:bumps) (app:app-bumps))
  (printf "http ~a, url ~a, fs ~a, leb ~a\n" (h:http-same? "Host" "host") (url:url-path "/a/b?c") fs:fs-directory
          (leb:uleb-length 300))
  (printf "leb by name and by path, one module: ~a\n" (== (cast i32 leb:uleb-length) (cast i32 same-leb:uleb-length)))
  (printf "app ~a\n" (app:app-twice 5)))
