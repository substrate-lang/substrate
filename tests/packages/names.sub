(package names
  (requires (tools (path "tools"))))
;; Names in requires, through this program's own manifest: a dependency's main module and another of its modules, the
;; standard library's modules, and one module required by name and by path; and a package with its own manifest.
(require-unqualified tools tools)
(require text tools/text)
(require same "tools/text.sub")
(require app "app/app.sub")
(require h http)
(require url http/url)
(require fs host/fs)

(define (main)
  (printf "tools ~a, doubled ~a\n" (tools-version) (doubled 21))
  (text:bump!)
  (same:bump!)
  (printf "bumps by name ~a, by path ~a\n" (text:bumps) (same:bumps))
  (printf "http ~a, url ~a, fs ~a\n" (h:http-same? "Host" "host") (url:url-path "/a/b?c") fs:fs-directory)
  (printf "app ~a\n" (app:app-twice 5)))
