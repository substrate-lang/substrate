;; Macros of a package whose compile-time code runs in a memory of its own: one that rewrites its form, one that keeps a
;; count while compiling, ones that refuse their form, with its syntax or only its place, and ones that ask the
;; compiler: for a compile-time value, whether two identifiers mean the same, for a form expanded, which uses the first,
;; whether an identifier has a compile-time value where it runs, and for a form expanded, catching the error raised for
;; it.
(provide twice counted refused located fields count-of same? expanded macro-value? caught)

(begin-for-syntax
  (require-unqualified macros compiler/macros)
  (define count i32 0)
  (define (twice [stx datum]) -> datum
    (let ([e (cadr (syntax->list stx))]) #`(+ #,e #,e)))
  (define (counted [stx datum]) -> datum
    (+= count 1)
    (datum->syntax stx (fixnum count) stx))
  (define (refused [stx datum]) -> datum
    (raise-syntax-error 'refused "this form is refused" stx))
  (define (located [stx datum]) -> datum
    (raise-compile-error (syntax-srcloc stx) "this form is refused here")
    0)
  (define (count-of [stx datum]) -> datum
    (datum->syntax stx (fixnum (length (syntax-local-value (cadr (syntax->list stx))))) stx))
  (define (same? [stx datum]) -> datum
    (let ([l (syntax->list stx)]) (datum->syntax stx (fixnum (if (free-identifier=? (cadr l) (caddr l)) 1 0)) stx)))
  (define (expanded [stx datum]) -> datum (local-expand (cadr (syntax->list stx))))
  (define (macro-value? [stx datum]) -> datum
    (datum->syntax stx (fixnum (if (!= (syntax-local-value (cadr (syntax->list stx))) 0) 1 0)) stx))
  (define (caught [stx datum]) -> datum
    (try (local-expand (cadr (syntax->list stx)))
         [catch compile-error (m b l) (datum->syntax stx m stx)])))

(define-syntax twice twice)
(define-syntax counted counted)
(define-syntax refused refused)
(define-syntax located located)
(define-syntax fields '(x y z))
(define-syntax count-of count-of)
(define-syntax same? same?)
(define-syntax expanded expanded)
(define-syntax macro-value? macro-value?)
(define-syntax caught caught)
