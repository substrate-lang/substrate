(package trusted-use
  (version "0.1.0")
  (dependencies (vouched (path "vouched") (trusted)) (isolated (path "isolated"))))
;; A package the program trusts runs its compile-time code in the compiler's memory, where a macro that changes a
;; compile-time value changes the compiler's; one it does not trust runs in a memory of its own, where the same macro
;; changes a copy. Each sees the other's macros, and std's, as macros, and runs them.
(require json std/encoding/json)
(require vouched vouched)
(require isolated isolated)

(define-syntax cell '(0))

(define (main)
  (printf "~a ~a ~a ~a\n" (isolated:bump! cell) (isolated:peek cell) (vouched:bump! cell) (vouched:peek cell))
  (printf "~a ~a ~a ~a\n" (isolated:macro-value? json:json) (vouched:macro-value? isolated:twice)
          (isolated:run-macro vouched:thrice (vouched:thrice 4)) (vouched:run-macro isolated:twice (isolated:twice 4))))
