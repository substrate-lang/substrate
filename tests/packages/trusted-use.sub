(package trusted-use
  (version "0.1.0")
  (dependencies (vouched (path "vouched") (trusted)) (isolated (path "isolated"))))
;; A package the program trusts runs its compile-time code in the compiler's memory, where a macro asking for the value
;; of a macro std keeps gets it; a package it does not trust runs in a memory of its own, where the same macro gets #f.
(require json std/encoding/json)
(require vouched vouched)
(require isolated isolated)

(define (main) (printf "~a ~a\n" (vouched:macro-value? json:json) (isolated:macro-value? json:json)))
