(package wasm
  (requires (cside (path "cside"))))
;; A package's wasm module, a C side module: its data and relocations, the address of its data and of a function, the
;; program's malloc, a callback into Substrate, its stack, and its zeroed data.
(require-unqualified cside cside)

(define (plus-ten [x i32]) -> i32 (+ x 10))

(define (main)
  (printf "add ~a\n" (c-add 1 2))
  (printf "counter ~a\n" (@ (cast (ptr i32) (c-counter-address)) 0))
  (let ([f (cast (fn (i32 i32) -> i32) (c-pick))]) (printf "picked ~a\n" (f 2 3)))
  (let ([p (c-copy)])
    (printf "copy ~a\n" (c-string p))
    (free (cast (ptr void) p)))
  (printf "message ~a ~a\n" (c-string (c-message 0)) (c-string (c-message 1)))
  (printf "callback ~a\n" (c-call-back (cast i32 plus-ten) 5))
  (printf "stack ~a\n" (c-stack-sum 2))
  (printf "zeros ~a\n" (c-zero-sum)))
