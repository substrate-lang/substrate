(package wasm
  (version "0.1.0")
  (dependencies (cside (path "cside"))))
;; A package with a C module, used by name through its binding's typed functions.
(require cside cside)

(define (main)
  (printf "add ~a\n" (cside:add 1 2))
  (printf "message ~a ~a\n" (cside:message 0) (cside:message 1))
  (printf "by name ~a\n" (cside:by-name 3)))
