;; The C functions of cside.wasm.
(provide c-add c-pick c-counter-address c-copy c-message c-call-back c-stack-sum c-zero-sum c-string)

(import c-add "cside" "add" (i32 i32 -> i32))
(import c-pick "cside" "pick" (-> i32))
(import c-counter-address "cside" "counter_address" (-> i32))
(import c-copy "cside" "copy" (-> i32))
(import c-message "cside" "message" (i32 -> i32))
(import c-call-back "cside" "call_back" (i32 i32 -> i32))
(import c-stack-sum "cside" "stack_sum" (i32 -> i32))
(import c-zero-sum "cside" "zero_sum" (-> i32))

(define (c-string [p i32]) -> string
  (let ([s (cast (ptr u8) p)] [n u32 0])
    (while (!= (@ s n) 0) (+= n 1))
    (cast string (slice s n))))
