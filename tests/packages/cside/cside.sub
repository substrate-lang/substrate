;; The cside package's binding, which programs require: typed functions over cside.c's, twice, which cside.c calls by
;; name, and c-string, for the text C gives.
(require cside "cside.wasm")

(provide add message by-name c-string)

(define (twice [x i32]) -> i32 (* x 2))

(supply cside:twice twice)

(define (c-string [p i32]) -> string
  (let ([s (cast (ptr u8) p)] [n u32 0])
    (while (!= (@ s n) 0) (+= n 1))
    (cast string (slice s n))))

(define (add [a i32] [b i32]) -> i32 (cside:add a b))

(define (message [i i32]) -> string (c-string (cside:message i)))

(define (by-name [x i32]) -> i32 (cside:by_name x))
