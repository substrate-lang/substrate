;; The cside package's Substrate side, which programs require: the C module's functions; twice, which cside.c calls by
;; name; and c-string, for the text C gives.
(require cside "cside.wasm")

(provide c-string (all-from-out cside))

(define (twice [x i32]) -> i32 (* x 2))

(supply cside:twice twice)

(define (c-string [p i32]) -> string
  (let ([s (cast (ptr u8) p)] [n u32 0])
    (while (!= (@ s n) 0) (+= n 1))
    (cast string (slice s n))))
