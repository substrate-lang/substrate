;; Code run while compiling calls a C module that calls a function by name, which a module that only supplies it
;; gives: the supplier starts with the C module there too, and the C module's constructor, which calls it, runs once it
;; is supplied.
(begin-for-syntax
  (require-unqualified macros compiler/macros)
  (require cside "../cside.wasm")
  (require side "../cside.sub")
  (define (by-name-while-compiling [stx datum]) -> datum (datum->syntax stx (fixnum (cside:by_name 4)) stx))
  (define (constructed-while-compiling [stx datum]) -> datum (datum->syntax stx (fixnum (cside:constructed_value)) stx)))
(define-syntax by-name-while-compiling by-name-while-compiling)
(define-syntax constructed-while-compiling constructed-while-compiling)

(define (main) (printf "by name ~a, constructed ~a\n" (by-name-while-compiling) (constructed-while-compiling)))
