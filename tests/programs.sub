(require err-double-free "programs/err-double-free.sub")
(require err-out-of-memory "programs/err-out-of-memory.sub")
(require err-query-at-run-time "programs/err-query-at-run-time.sub")
(require module-begin "programs/module-begin.sub")

(test err-double-free #:grants () #:traps "free of a block that is free" (err-double-free:main))
(test err-out-of-memory #:grants () #:traps "out of memory" (err-out-of-memory:main))
(test err-query-at-run-time #:grants () #:traps "an expander query was used outside the expander"
  (err-query-at-run-time:main))
(test module-begin #:grants () #:output-file "programs/module-begin.out" (module-begin:main))
