(require-unqualified build std/test/build)

(test err-double-free (expect-run "programs/err-double-free.sub" #:fails "free of a block that is free"))
(test err-out-of-memory (expect-run "programs/err-out-of-memory.sub" #:fails "out of memory"))
(test err-query-at-run-time (expect-run "programs/err-query-at-run-time.sub" #:fails "an expander query was used outside the expander"))
(test err-start-trap (expect-run "programs/err-start-trap.sub" #:fails "err-start-trap.sub:2:26"))
(test malloc (expect-run "programs/malloc.sub" #:output-file "programs/malloc.out"))
(test memory-own (expect-run "programs/memory-own.sub" #:output-file "programs/memory-own.out"))
(test module-begin (expect-run "programs/module-begin.sub" #:output-file "programs/module-begin.out"))
