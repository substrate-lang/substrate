;; Macros whose code comes from a compile-time library's templates (../fixtures/templates.sub).
(begin-for-syntax
  (require-unqualified compiler/macros)
  (require-unqualified "../fixtures/templates.sub")
  (define (argument [s datum]) -> datum (cadr (syntax->list s)))
  (define (plus-one-form [s datum]) -> datum (plus-one (argument s)))
  (define (twice-form [s datum]) -> datum (twice-of (argument s)))
  (define (quadrupled-form [s datum]) -> datum (quadrupled (argument s))))

(define-syntax plus-one! plus-one-form)
(define-syntax twice! twice-form)
(define-syntax quadrupled! quadrupled-form)

(define (main) (printf "~a ~a ~a\n" (plus-one! 41) (twice! 41) (quadrupled! 5)))
