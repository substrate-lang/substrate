;; A name in a template that its library does not require for template is unbound where the code lands.
(begin-for-syntax
  (require-unqualified compiler/macros)
  (require-unqualified "../fixtures/templates.sub")
  (define (tripled-form [s datum]) -> datum (tripled-of (cadr (syntax->list s)))))

(define-syntax tripled! tripled-form)

(define (main) (printf "~a\n" (tripled! 2)))
