;; Programs with code that runs while they compile: what each build prints, then what the program prints when it runs.
(require-unqualified build std/test/build)

(test copied
  (expect-build "copied.sub" #:output "12")
  (expect-run "copied.sub" #:output "42 10 15 6 1 2 "))

(test inline
  (expect-build "inline.sub" #:output "42")
  (expect-run "inline.sub" #:output "12\n10\n3\n302\n11"))

(test memory-phase1 (expect-build "memory-phase1.sub" #:output "ho"))

(test modules
  (expect-build "modules.sub" #:output "5")
  (expect-run "modules.sub" #:output "49\n1:25\n25\n3"))

(test phases
  (expect-build "phases.sub" #:output "2")
  (expect-run "phases.sub" #:output "2"))

(test shift-literals (expect-build "shift-literals.sub" #:output "42\n42"))

(test err-compile-time-trap
  (expect-build "err-compile-time-trap.sub" #:fails "err-compile-time-trap.sub:4:18: error: trap: expected a pair"))

(test err-macro-trap (expect-build "err-macro-trap.sub" #:fails "err-macro-trap.sub:6:16: error: trap: expected a pair"))
