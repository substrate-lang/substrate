;; Deflating and inflating back: each level on random bytes with copies from distances of many codes, text, nothing,
;; one byte, zeros and bytes that do not compress; text fed
;; in pieces of several sizes, with syncs between them; streams in turn on one deflater; events deflated alone into
;; one stream; and the gzip format around them.
(require-unqualified inflate "../../lib/compress/inflate.sub")
(require-unqualified deflate "../../lib/compress/deflate.sub")
(require-unqualified gzip "../../lib/compress/gzip.sub")

(define d deflater)

(define (lines! [b (ptr buffer)] [n u32])
  (for ([i u32 0]) (< i n) (+= i 1)
    (buffer-add-string! b "item ")
    (write-digits b (cast u64 (% (* i i) 997)) 10)
    (buffer-add-string! b " group ")
    (write-digits b (cast u64 (% i 17)) 10)
    (buffer-add-byte! b 10)))

(define seed u32 12345)

(define (random) -> u32
  (set! seed (+ (* seed 1103515245) 12345))
  (>> seed 8))

;; skewed! adds random bytes, then pieces of a random byte and eight copied from before, from distances whose codes
;; come with Fibonacci weights.
(define (skewed! [b (ptr buffer)] [pieces u32])
  (let ([weights (array u32 22)] [total u32 0] [base (array u32 22)])
    (set! (@ weights 21) 1)
    (set! (@ weights 20) 1)
    (for ([k u32 20]) (> k 0) (-= k 1) (set! (@ weights (- k 1)) (+ (@ weights k) (@ weights (+ k 1)))))
    (for ([k u32 0]) (< k 22) (+= k 1) (+= total (@ weights k)))
    (set! (@ base 0) 1)
    (for ([k u32 1]) (< k 22) (+= k 1)
      (set! (@ base k) (+ (@ base (- k 1)) (<< 1 (if (< k 5) 0 (- (>> (- k 1) 1) 1))))))
    (for ([i u32 0]) (< i 32768) (+= i 1) (buffer-add-byte! b (cast i32 (bit-and (random) 255))))
    (for ([p u32 0]) (< p pieces) (+= p 1)
      (buffer-add-byte! b (cast i32 (bit-and (random) 255)))
      (let ([r (% (random) total)] [k u32 0])
        (while (>= r (@ weights k))
          (-= r (@ weights k))
          (+= k 1))
        (for ([i u32 0]) (< i 8) (+= i 1)
          (buffer-add-byte! b (cast i32 (@ (-> b bytes) (- (-> b length) (@ base k))))))))))

(define (noise! [b (ptr buffer)] [n u32])
  (let ([x u32 12345])
    (for ([i u32 0]) (< i n) (+= i 1)
      (set! x (+ (* x 1103515245) 12345))
      (buffer-add-byte! b (cast i32 (>> x 23))))))

;; back tells whether the compressed bytes inflate to the input.
(define (back [packed (ptr buffer)] [input (slice u8)]) -> string
  (let ([out (make-buffer)] [used u32 0])
    (let ([result (inflate! (& out) (buffer-bytes packed) (+ (-> input length) 1) (& used))])
      (let ([same (and (== result 0) (== used (-> packed length)) (== (buffer-string (& out)) (cast string input)))])
        (buffer-free! (& out))
        (if same "back" (inflate-message result))))))

(define (whole [name string] [input (slice u8)])
  (printf "~a, ~a bytes:" name (-> input length))
  (for ([level i32 1]) (<= level 9) (+= level 1)
    (let ([packed (make-buffer)])
      (deflater-init! (& d) level)
      (deflate! (& d) (& packed) input deflate-finish)
      (printf " ~a ~a" (-> packed length) (back (& packed) input))
      (deflater-free! (& d))
      (buffer-free! (& packed))))
  (printf "\n"))

;; pieces feeds the input n bytes at a time, with a sync after each when sync is set.
(define (pieces [input (slice u8)] [n u32] [sync bool] [level i32])
  (let ([packed (make-buffer)] [at u32 0])
    (deflater-init! (& d) level)
    (while (< at (-> input length))
      (let ([end (if (> (+ at n) (-> input length)) (-> input length) (+ at n))])
        (deflate! (& d) (& packed) (slice input at end) (if sync deflate-sync deflate-none))
        (set! at end)))
    (deflate! (& d) (& packed) (cast (slice u8) "") deflate-finish)
    (printf "level ~a in pieces of ~a~a: ~a ~a\n" level n (if sync ", synced" "") (-> packed length)
            (back (& packed) input))
    (deflater-free! (& d))
    (buffer-free! (& packed))))

(define (main)
  (let ([text (make-buffer)] [zeros (make-buffer)] [noise (make-buffer)] [skewed (make-buffer)])
    (lines! (& text) 2000)
    (for ([i u32 0]) (< i 100000) (+= i 1) (buffer-add-byte! (& zeros) 0))
    (noise! (& noise) 70000)
    (skewed! (& skewed) 30000)
    (whole "copies" (buffer-bytes (& skewed)))
    (whole "text" (buffer-bytes (& text)))
    (whole "nothing" (cast (slice u8) ""))
    (whole "one byte" (cast (slice u8) "a"))
    (whole "zeros" (buffer-bytes (& zeros)))
    (whole "noise" (buffer-bytes (& noise)))
    (pieces (buffer-bytes (& text)) 1 #f 6)
    (pieces (buffer-bytes (& text)) 1000 #f 1)
    (pieces (buffer-bytes (& text)) 1000 #f 6)
    (pieces (buffer-bytes (& text)) 1000 #t 6)
    (pieces (buffer-bytes (& text)) 40000 #t 9)
    (let ([packed (make-buffer)] [all (make-buffer)])
      (deflater-init! (& d) 6)
      (for ([k u32 0]) (< k 3) (+= k 1)
        (set! (-> packed length) 0)
        (deflater-reset! (& d))
        (deflate! (& d) (& packed) (buffer-bytes (& text)) deflate-finish)
        (printf "stream ~a on one deflater: ~a ~a\n" k (-> packed length) (back (& packed) (buffer-bytes (& text)))))
      (set! (-> packed length) 0)
      (for ([k u32 0]) (< k 200) (+= k 1)
        (let ([event (make-buffer)])
          (buffer-add-string! (& event) "data: {\"item\": ")
          (write-digits (& event) (cast u64 (* k k)) 10)
          (buffer-add-string! (& event) ", \"group\": \"blue\"}\n\n")
          (buffer-add! (& all) (buffer-bytes (& event)))
          (deflate-alone! (& d) (& packed) (buffer-bytes (& event)))
          (buffer-free! (& event))))
      (buffer-add-byte! (& packed) 3)
      (buffer-add-byte! (& packed) 0)
      (printf "200 events alone, ~a bytes: ~a ~a\n" (-> all length) (-> packed length)
              (back (& packed) (buffer-bytes (& all))))
      (set! (-> packed length) 0)
      (gzip! (& d) (& packed) (buffer-bytes (& text)) "")
      (let ([out (make-buffer)])
        (printf "gzip: ~a ~a\n" (-> packed length)
                (gzip-message (gunzip! (& out) (buffer-bytes (& packed)) 1000000)))
        (buffer-free! (& out)))
      (deflater-free! (& d)))))
