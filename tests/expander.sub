;; Prints the fully expanded code of modules, or their errors.
(require-unqualified macros compiler/macros)
(require-unqualified ex compiler/expander)
(require-unqualified main compiler/main)

(define (expand [path datum])
  (printf ";; ~a\n" path)
  (try (expand-module-file 0 path (lambda ([f datum]) (print-expanded f)))
       [catch compile-error (message blamed loc)
        (let ([b (make-buffer)])
          (write-compile-error (& b) message blamed loc)
          (host-write 1 (buffer-bytes (& b)))
          (buffer-free! (& b)))]))

(define (main)
  (set-repository-root! `"..")
  (install-core!)
  (for-each (lambda ([f datum]) (expand f))
            `("basics.sub" "globals.sub" "decimals.sub"
              "module-copies.sub" "cache-tags.sub" "provide-all.sub"
              "../compiler/substrate.sub"
              "err-unbound.sub" "err-duplicate.sub" "err-type.sub"
              "err-cycle.sub" "err-provide-twice.sub" "err-number-range.sub"
              "err-immutable.sub" "err-uncaught.sub" "err-try-clause.sub"
              "err-global-init.sub" "err-fact-before.sub")))
