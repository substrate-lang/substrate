;; A macro may catch a failed expansion and go on.
(require-unqualified tests std/test/test)
(begin-for-syntax
  (require-unqualified macros compiler/macros)
  (exception oops)
  (define (fails [s datum]) -> datum (throw oops) s)
  (define (attempt [s datum]) -> datum
    (syntax-match s
      [(_ e f) (try (local-expand e) [catch oops () f])])))
(define-syntax fails fails)
(define-syntax attempt attempt)

(attempt (fails) (define answer i32 42))
(define (main) (printf "~a\n" answer))

(test caught-expansion (expect-output "42" (main)))
