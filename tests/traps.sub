;; Traps at run time, each with its message.
(require-unqualified macros compiler/macros)

;; The syntax module's functions check their arguments and trap with a message.
(test err-trap #:traps "expected a pair" (car '()))

;; An exception that escapes its test is reported.
(exception oops)

(test err-uncaught #:traps "uncaught exception" (throw oops))
