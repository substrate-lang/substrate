(require-unqualified tests std/test/test)
(require wasm compiler/wasm)

(wasm:func (pick [i i32]) -> i32
  (wasm:block done
    (wasm:block other
      (wasm:block two
        (wasm:block one
          (wasm:block zero
            (wasm:br-table (zero one two) other i))
          (wasm:br done (wasm:i32.const 100)))
        (wasm:br done (wasm:i32.const 200)))
      (wasm:br done (wasm:i32.const 300)))
    (wasm:i32.const -1)))

(wasm:func (odds [n i32]) -> i32
  (let ([sum i32 0])
    (wasm:block out
      (wasm:loop again
        (wasm:br-if out (wasm:i32.eqz n))
        (set! n (wasm:i32.sub n (wasm:i32.const 1)))
        (wasm:block odd
          (wasm:br-table (again odd) out (wasm:i32.and n (wasm:i32.const 1))))
        (set! sum (wasm:i32.add sum n))
        (wasm:br again)))
    sum))

(wasm:func (sign [x i32]) #:inline -> i32
  (wasm:block done
    (wasm:block pos
      (wasm:block zero
        (wasm:br-table (zero) pos (wasm:i32.eqz (wasm:i32.eqz x))))
      (wasm:br done (wasm:i32.const 0)))
    (wasm:i32.const 1)))

(define (main)
  (printf "~a\n" (#%app pick 0))
  (printf "~a\n" (#%app pick 1))
  (printf "~a\n" (#%app pick 2))
  (printf "~a\n" (#%app pick 3))
  (printf "~a\n" (#%app pick -1))
  (printf "~a\n" (#%app odds 6))
  (printf "~a\n" (#%app sign 0))
  (printf "~a\n" (#%app sign 5)))

(test br-table (expect-output-file "br-table.out" (main)))
