;; An error in a macro's template names each macro use it came from.
(require-unqualified compiler/macros)
(begin-for-syntax (require-unqualified compiler/macros))

(define-macro (add-text stx)
  (syntax-match stx
    [(_ a) #`(+ #,a "x")]))

(define-macro (twice stx)
  (syntax-match stx
    [(_ a) #`(* 2 (add-text #,a))]))

(define (main) (printf "~a\n" (twice 1)))
