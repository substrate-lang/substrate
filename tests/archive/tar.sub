;; The tar reader on archives tests/run.sh makes with GNU tar, in its ustar, GNU and pax formats and with a pax global
;; header: a path longer than a header's hundred bytes, an empty file and a link, which is another kind; then data that
;; is not tar, and an archive cut short.
(require-unqualified fs host/fs)
(require-unqualified tar std/archive/tar)

(define (base-of [p string]) -> string
  (let ([i (-> p length)])
    (while (and (> i 0) (!= (@ p (- i 1)) #\/)) (-= i 1))
    (slice p i)))

(define (show [file string])
  (let ([bytes (slice u8)] [why string] [a (make-arena)] [r tar-reader] [e tar-entry] [err (make-buffer)] [got i32 1])
    (printf "~a:\n" (base-of file))
    (when (< (fs-read-file file (& bytes) (& why)) 0)
      (printf "  ~a\n" why)
      (return))
    (tar-reader-init! (& r) bytes)
    (while (== got 1)
      (set! got (tar-next! (& a) (& r) (& e) (& err)))
      (when (== got 1)
        (cond [(and (== (-> e kind) tar-file) (> (-> e bytes length) 0))
               (printf "  file ~a, ~a bytes: ~a\n" (-> e path) (-> e bytes length)
                       (cast string (slice (-> e bytes) 0 (- (-> e bytes length) 1))))]
              [(== (-> e kind) tar-file) (printf "  file ~a, ~a bytes\n" (-> e path) (-> e bytes length))]
              [(== (-> e kind) tar-directory) (printf "  directory ~a\n" (-> e path))]
              [else (printf "  other ~a\n" (-> e path))])))
    (when (< got 0) (printf "  ~a\n" (buffer-string (& err))))
    (arena-free (& a))
    (buffer-free! (& err))
    (free (-> bytes items))))

(define (main)
  (let ([args (host-args)])
    (for ([i u32 0]) (< i (-> args length)) (+= i 1) (show (@ args i)))))
