;; A session as sub eval runs one.
(require-unqualified macros compiler/macros)
(require-unqualified ex compiler/expander)
(require-unqualified rt compiler/roots)

(define (reported [e datum])
  (let ([s (datum->string e)] [start u32 0])
    (for ([i u32 0]) (<= i (-> s length)) (+= i 1)
      (when (or (== i (-> s length)) (== (@ s i) 10))
        (unless (and (>= (- i start) 4) (== (slice s start (+ start 4)) "    "))
          (host-write 2 (slice (cast (slice u8) s) start (if (< i (-> s length)) (+ i 1) i))))
        (set! start (+ i 1))))))

(define (main)
  (let ([args (host-args)])
    (set-toolchain-directory! (string->datum (@ args 0)))
    (install-core!)
    (set-module-map-text! (file-text (string->datum (@ args 1))) (string->datum (@ args 1)))
    (set-cache-directory! (string->datum (@ args 2)))
    (set-display-directory! '".")
    (session-open! '"session")
    (session-eval-file! 0 (string->datum (@ args 3)) (lambda ([e datum]) (reported e)))))
