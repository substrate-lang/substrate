(require-unqualified tests std/test/test)
(require session "eval.sub")

(define (evaluated [file string])
  (session:main (test-option "--toolchain") (test-option "--map") (test-option "--cache") file))

(test after-errors #:output-file "after-errors.out" (evaluated "session/after-errors.sub"))

(test bend #:output-file "bend.out" (evaluated "session/bend.sub"))

(test clock #:output-file "clock.out" (evaluated "session/clock.sub"))

(test funcs #:output-file "funcs.out" (evaluated "session/funcs.sub"))

(test scheme #:output-file "scheme.out" (evaluated "session/scheme.sub"))

(test substrate #:output-file "substrate.out" (evaluated "session/substrate.sub"))

(test switch #:output-file "switch.out" (evaluated "session/switch.sub"))
