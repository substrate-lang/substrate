(package supplied
  (version "0.1.0")
  (dependencies (cside (path "../packages/cside"))))
;; A package's C module that calls a function by name, which the package supplies, in a session: the supplier starts
;; with the C module, whose constructor, which calls that function, runs once it is supplied.
(require cside cside)
(printf "by name ~a, constructed ~a\n" (cside:by-name 4) (cside:constructed))
