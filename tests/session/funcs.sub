;; A session of functions and globals: definitions, redefinitions, failed inputs, and macros.
(define (show [n i32]) (printf "~a\n" n))
(define (sq [x i32]) -> i32 (* x x))
(show (sq 7))
(define (cube [x i32]) -> i32 (* x (sq x)))
(show (cube 3))
(define (sq [x i32]) -> i32 (+ x x))
(begin (show (sq 7)) (show (cube 3)))
(show (nope 1))
(begin (define (lost [x i32]) -> i32 x) (define (bad) -> i32 (nope 2)))
(show (lost 1))
(show (sq 100))
(begin (define (twice) -> i32 1) (define (twice) -> i32 2))
(define counter i32 10)
(define (bump) -> i32 (set! counter (+ counter 1)) counter)
(begin (show (bump)) (show (bump)))
(begin-for-syntax
  (require-unqualified macros compiler/macros)
  (printf "~a\n" 111)
  (define (double-form [s datum]) -> datum
    (let ([x (cadr (syntax->list s))]) (datum->syntax s `(+ ,x ,x) s))))
(define-syntax double double-form)
(show (double 21))
