;; A session with generics, vectors and methods: each defined in one input, used in later ones, and defined again.
(require-unqualified std/meta/generic)
(require-unqualified std/meta/method)
(require-unqualified std/vector)
(require-unqualified std/sort)
(define-generic (pair A B) (struct [first A] [second B]))
(define-generic ((largest T) [xs (slice T)]) -> T
  (let ([best (@ xs 0)]) (for ([i u32 1]) (< i (-> xs length)) (+= i 1) (when (> (@ xs i) best) (set! best (@ xs i)))) best))
(largest (slice (array-of u32 3 9 4)))
((largest f64) (slice (array-of f64 0.5 2.5)))
(define v (vector (pair string u32)))
(vector-push! (& v) ((pair string u32) #:first "a" #:second 2))
(vector-push! (& v) ((pair string u32) #:first "b" #:second 1))
(sort! (vector-items (& v)) (x y) (< (-> x second) (-> y second)))
(-> (vector-at (& v) 0) first)
(largest v)
(define-methods area)
(struct square [side u32])
(define-method (area [s (ptr square)]) -> u32 (* (-> s side) (-> s side)))
(define sq square (square #:side 3))
(area (& sq))
(define-generic (tile T) (struct [value T] [width u32]))
(define-method ((area T) [t (ptr (tile T))]) -> u32 (* (-> t width) (-> t width)))
(define tl (tile string))
(set! (-> tl width) 5)
(area (& tl))
(define-generic ((largest T) [xs (slice T)]) -> T (@ xs 0))
(largest (slice (array-of u32 3 9 4)))
(define-method (area [s (ptr square)]) -> u32 (+ (-> s side) (-> s side)))
(area (& sq))
(define-generic (pair A B) (struct [left A] [right B]))
(sizeof (pair u8 u32))
