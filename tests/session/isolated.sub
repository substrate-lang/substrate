(package session-isolated
  (version "0.1.0")
  (dependencies (isolated (path "../packages/isolated"))))
;; In a session, a package's macros run in a memory of their own, and after an error one of them raises, the session
;; goes on as before it. The session's own compile-time code runs in the compiler's memory, so it cannot run the
;; package's.
(require-unqualified isolated isolated)
(twice 21)
(caught (refused))
(expanded (located))
(twice (count-of fields))
