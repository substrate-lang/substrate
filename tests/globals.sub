;; Globals: immutable unless (mut type); an initializer that is not constant runs at start.
(require-unqualified tests std/test/test)
(require wasm compiler/wasm)

(wasm:global answer i32 (wasm:i32.add 40 2))
(wasm:global counter (mut i32) (square 3))

(wasm:func (square [x i32]) -> i32 (wasm:i32.mul x x))

(define (main)
  (printf "~a\n" answer)
  (set! counter (wasm:i32.add counter 1))
  (printf "~a\n" counter))

(test globals (expect-output "42\n10" (main)))
