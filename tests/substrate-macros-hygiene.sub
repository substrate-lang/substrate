;; A Substrate macro from another module calls that module's double, not this one's.
(require-unqualified std/test/test)
(require lib "fixtures/substrate-macro-lib.sub" quad)

(define (double [x i32]) -> i32 (+ x 1000))

(define (main) (printf "~a\n~a\n" (quad 5) (double 5)))

(test substrate-macros-hygiene (expect-output "20\n1005" (main)))
