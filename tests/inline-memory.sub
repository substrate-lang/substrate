;; An inline function that uses memory is inlined where the caller shares that memory.
(require-unqualified tests std/test/test)
(require lib "fixtures/inline-memory-lib.sub" peek poke)
(define (main)
  (lib:poke 2048 41)
  (printf "~a\n" (lib:peek 2048))
  (lib:poke 2048 (+ (lib:peek 2048) 1))
  (printf "~a\n" (lib:peek 2048)))

(test inline-memory (expect-output-file "inline-memory.out" (main)))
