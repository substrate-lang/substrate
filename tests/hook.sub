;; The instantiate hook: modules built as bytes, instantiated and called.

(require-unqualified std/test/test)
(require-unqualified compiler/macros)
(require wasm compiler/wasm)

(wasm:table 1)

(define (instantiate [name datum] [bytes datum] [imports (slice string)] [err (ptr error)]) -> bool
  (host-instantiate (datum->string name) (cast (slice u8) (datum->string bytes)) imports #f err))

(define (export-index [name datum] [field datum]) -> i32
  (host-export-index (datum->string name) (datum->string field)))

(define (joined [parts datum]) -> datum
  (if (null? (cdr parts)) (car parts) (fmt "~a~a" (car parts) (joined (cdr parts)))))

;; (module (func (export "answer") (result i32) i32.const 42))
(define answer-module datum
  (joined '("\x00;asm\x01;\x00;\x00;\x00;\x01;\x05;\x01;\x60;\x00;\x01;\x7f;\x03;\x02;\x01;\x00;"
            "\x07;\x0a;\x01;\x06;answer\x00;\x00;\x0a;\x06;\x01;\x04;\x00;\x41;\x2a;\x0b;")))

;; (module (import "dyn@0+0" "answer" (func (result i32)))
;;         (func (export "twice") (result i32) call 0 call 0 i32.add))
(define twice-module datum
  (joined '("\x00;asm\x01;\x00;\x00;\x00;"
            "\x01;\x05;\x01;\x60;\x00;\x01;\x7f;"
            "\x02;\x12;\x01;\x07;dyn@0+0\x06;answer\x00;\x00;"
            "\x03;\x02;\x01;\x00;"
            "\x07;\x09;\x01;\x05;twice\x00;\x01;"
            "\x0a;\x09;\x01;\x07;\x00;\x10;\x00;\x10;\x00;\x6a;\x0b;")))

;; (module (tag $t) (func $s (throw $t)) (start $s))
(define thrower-module datum
  (joined '("\x00;asm\x01;\x00;\x00;\x00;"
            "\x01;\x04;\x01;\x60;\x00;\x00;"
            "\x03;\x02;\x01;\x00;"
            "\x0d;\x03;\x01;\x00;\x00;"
            "\x08;\x01;\x00;"
            "\x0a;\x06;\x01;\x04;\x00;\x08;\x00;\x0b;")))

(define (main)
  (unless (instantiate '"dyn" answer-module 0 0) (return))
  (printf "~a\n" (wasm:call-indirect (-> i32) (export-index '"dyn" '"answer")))
  (unless (instantiate '"dyn@0+1" answer-module 0 0) (return))
  (unless (instantiate '"twice@0+1" twice-module (slice (array-of string "dyn@0+0" "dyn@0+1")) 0) (return))
  (printf "~a\n" (wasm:call-indirect (-> i32) (export-index '"twice@0+1" '"twice")))
  (unless (instantiate '"ns/dyn@0+0" answer-module 0 0) (return))
  (unless (instantiate '"ns/twice@0+0" twice-module (slice (array-of string "dyn@0+0" "ns/dyn@0+0")) 0) (return))
  (printf "~a\n" (wasm:call-indirect (-> i32) (export-index '"ns/twice@0+0" '"twice")))
  (try (begin (instantiate '"thrower" thrower-module 0 0) (begin))
    [catch-all (printf "caught\n")])
  (let ([message error])
    (unless (instantiate '"bad" '"\x00;asm\x01;\x00;\x00;\x00;\x01;" 0 (& message))
      (let ([text (error-text (& message))])
        (printf "error: ~a\n" (slice text 0 (if (< (-> text length) 7) (-> text length) 7))))
      (error-free! (& message)))))

(test hook (expect-output-file "hook.out" (main)))
