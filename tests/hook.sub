;; The instantiate hook: modules built as bytes, instantiated and called.

(require-unqualified macros "../compiler/macros.sub")
(require wasm "../compiler/wasm.sub")

(wasm:table 1)

(define (instantiate [name datum] [bytes datum] [map datum]) -> i32
  (host-instantiate (string-bytes name) (string-length name) (string-bytes bytes) (string-length bytes)
                    (if map (string-bytes map) 0) (if map (string-length map) 0) 0))

(define (export-index [name datum] [field datum]) -> i32
  (host-export-index (string-bytes name) (string-length name) (string-bytes field) (string-length field)))

(define (joined [parts datum]) -> datum
  (if (null? (cdr parts)) (car parts) (string-append (car parts) (joined (cdr parts)))))

;; (module (func (export "answer") (result i32) i32.const 42))
(define answer-module datum
  (joined '("\x00;asm\x01;\x00;\x00;\x00;\x01;\x05;\x01;\x60;\x00;\x01;\x7f;\x03;\x02;\x01;\x00;"
            "\x07;\x0a;\x01;\x06;answer\x00;\x00;\x0a;\x06;\x01;\x04;\x00;\x41;\x2a;\x0b;")))

;; (module (import "dyn@0+0" "answer" (func (result i32)))
;;         (func (export "twice") (result i32) call 0 call 0 i32.add))
(define twice-module datum
  (joined '("\x00;asm\x01;\x00;\x00;\x00;"
            "\x01;\x05;\x01;\x60;\x00;\x01;\x7f;"
            "\x02;\x12;\x01;\x07;dyn@0+0\x06;answer\x00;\x00;"
            "\x03;\x02;\x01;\x00;"
            "\x07;\x09;\x01;\x05;twice\x00;\x01;"
            "\x0a;\x09;\x01;\x07;\x00;\x10;\x00;\x10;\x00;\x6a;\x0b;")))

;; (module (tag $t) (func $s (throw $t)) (start $s))
(define thrower-module datum
  (joined '("\x00;asm\x01;\x00;\x00;\x00;"
            "\x01;\x04;\x01;\x60;\x00;\x00;"
            "\x03;\x02;\x01;\x00;"
            "\x0d;\x03;\x01;\x00;\x00;"
            "\x08;\x01;\x00;"
            "\x0a;\x06;\x01;\x04;\x00;\x08;\x00;\x0b;")))

(define (main)
  (if (instantiate '"dyn" answer-module 0) (return))
  (printf "~a\n" (wasm:call-indirect (-> i32) (export-index '"dyn" '"answer")))
  (if (instantiate '"dyn@0+1" answer-module 0) (return))
  (if (instantiate '"twice@0+1" twice-module '"dyn@0+0\x00;dyn@0+1\x00;") (return))
  (printf "~a\n" (wasm:call-indirect (-> i32) (export-index '"twice@0+1" '"twice")))
  (if (instantiate '"ns/dyn@0+0" answer-module 0) (return))
  (if (instantiate '"ns/twice@0+0" twice-module '"dyn@0+0\x00;ns/dyn@0+0\x00;") (return))
  (printf "~a\n" (wasm:call-indirect (-> i32) (export-index '"ns/twice@0+0" '"twice")))
  (try (wasm:drop (instantiate '"thrower" thrower-module 0))
    [catch-all (printf "caught\n")])
  (if (instantiate '"bad" '"\x00;asm\x01;\x00;\x00;\x00;\x01;" 0)
      (let* ([message (arena-alloc (current-arena) 64)] [n (host-error-message message 64)])
        (printf "error: ")
        (host-write 1 message (wasm:select n 7 (wasm:i32.lt_s n 7)))
        (printf "\n"))))
