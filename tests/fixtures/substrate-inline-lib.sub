;; Inline Substrate functions.
(provide counter point bump! clamp sum-to dist2 greeting twice-clamped)

(struct counter [n i32])
(struct point [x i32] [y i32])

(define (bump! [c (ptr counter)] [by i32]) #:inline (+= (-> c n) by))

(define (clamp [x i32] [lo i32] [hi i32]) #:inline -> i32
  (when (< x lo) (return lo))
  (if (> x hi) hi x))

(define (sum-to [n i32]) #:inline -> i32
  (let ([s i32 0])
    (for ([i i32 1]) (<= i n) (+= i 1) (+= s i))
    s))

(define (dist2 [x i32] [y i32]) #:inline -> i32
  (let ([p point])
    (set! (-> (& p) x) x)
    (set! (-> (& p) y) y)
    (+ (* (-> (& p) x) (-> (& p) x)) (* (-> (& p) y) (-> (& p) y)))))

(define (greeting) #:inline -> string "hello")

(define (twice-clamped [x i32]) #:inline -> i32 (* 2 (clamp x 0 10)))
