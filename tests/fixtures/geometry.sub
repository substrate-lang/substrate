;; A library module: functions, macros and a static value for other modules to require.
(begin-for-syntax
  (require-unqualified macros compiler/macros)
  (require util "stx-util.sub" second third))
(provide square show-square square-sum size-count)

(define (square [x i32]) -> i32 (* x x))

(define (print-labelled [label i32] [n i32])
  (printf "~a:~a\n" label n))

(begin-for-syntax
  (define (show-square [stx datum]) -> datum
    #`(print-labelled 1 (square #,(second stx)))))
(define-syntax show-square show-square)

(begin-for-syntax
  (define (square-sum [stx datum]) -> datum
    #`(+ (square #,(second stx)) (square #,(third stx)))))
(define-syntax square-sum square-sum)

(define-syntax sizes '(small medium large))
(begin-for-syntax
  (define (size-count [stx datum]) -> datum
    (datum->syntax stx (fixnum (length (syntax-local-value #'sizes))) stx)))
(define-syntax size-count size-count)
