;; A language whose #%module-begin passes the forms on, with no memory.

(provide #%module-begin)

(begin-for-syntax
  (require-unqualified macros "../../compiler/macros.sub")
  (define (module-begin [stx datum]) -> datum #`(begin #,@(cdr (syntax->list stx)))))

(define-syntax #%module-begin module-begin)
