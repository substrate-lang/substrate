(provide add2 count clamp yes-or-no)
(require-unqualified macros "../../compiler/macros.sub")
(require wasm "../../compiler/wasm.sub")

(wasm:global counter (mut i32) 0)

(wasm:func (bump [n i32]) (set! counter (wasm:i32.add counter n)))
(wasm:func (count) -> i32 counter)

(wasm:func (add2 [a i32] [b i32]) #:inline -> i32
  (bump 1)
  (let ([s (wasm:i32.add a b)]) s))

(wasm:func (clamp [x i32] [lo i32] [hi i32]) #:inline -> i32
  (if (wasm:i32.lt_s x lo) (return lo))
  (wasm:block done
    (wasm:br-if done (wasm:i32.le_s x hi))
    (return hi))
  x)

(wasm:func (yes-or-no [x i32]) #:inline -> i32 (if x 'yes 'no))
