;; Global arrays of number literals, for tests/substrate/tables.sub.
(provide bytes8 signed words longs singles doubles first-word kept-mark dropped-mark)

(define bytes8 (array u8 4) (array-of u8 1 255 -1 300))
(define signed (array i16 3) (array-of i16 -2 32767 40000))
(define words (array u32 3) (array-of u32 4294967295 -1 #\A))
(define longs (array i64 2) (array-of i64 -9223372036854775808 9223372036854775807))
(define singles (array f32 3) (array-of f32 0.1 16777217 -0.0))
(define doubles (array f64 3) (array-of f64 0.1 9007199254740993 #t))
(define first-word u32 (@ words 0))
(define kept-marks (array u64 2) (array-of u64 #x1122334455667788 #x8877665544332211))
(define dropped-marks (array u64 2) (array-of u64 #x0123456789ABCDEF #xFEDCBA9876543210))

(define (kept-mark [i i32]) -> u64 (@ kept-marks i))
(define (dropped-mark [i i32]) -> u64 (@ dropped-marks i))
