;; A compile-time library whose templates make code with the language's forms and with doubling.sub, which it requires
;; for template.
(require-unqualified compiler/macros)
(require-unqualified twice (for-template "doubling.sub"))

(provide plus-one twice-of quadrupled tripled-of)

(define (plus-one [x datum]) -> datum #`(let ([y i64 #,x]) (+ y 1)))
(define (twice-of [x datum]) -> datum #`(doubled #,x))
(define (quadrupled [x datum]) -> datum #`(twice:doubled (doubled #,x)))
(define (tripled-of [x datum]) -> datum #`(tripled #,x))
