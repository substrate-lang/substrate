;; The syntax module's syntax objects: data, scope sets and changes, properties, arenas.
(require-unqualified std/test/test)
(require-unqualified compiler/macros)

(define (show [x i32]) (printf "~a " x))
(define (line [d datum]) (printf "~s\n" d))
(define (scoped [d datum]) (write-scoped d) (printf "\n"))

(define (list2 [a datum] [b datum]) -> datum (cons a (cons b nil)))
(define (list3 [a datum] [b datum] [c datum]) -> datum (cons a (cons b (cons c nil))))
(define (named [s string]) -> datum (string->symbol s))

(define (scopes [a u32] [b u32] [c u32]) -> (ptr scope-set)
  (let ([s no-scopes])
    (when (!= a 0) (set! s (scopes-change s a 0)))
    (when (!= b 0) (set! s (scopes-change s b 0)))
    (when (!= c 0) (set! s (scopes-change s c 0)))
    s))

(define (identifier [name string] [s (ptr scope-set)]) -> datum (make-syntax (named name) s 0 nil))

(define (data)
  (let ([a (named "a")] [kw (string->keyword "key")])
    (line (cons a (cons (string->datum "t\"w\no") (cons (make-integer -9223372036854775807)
      (cons (make-flonum 1.5) (cons (integer->char 955) (cons kw (cons (boolean #t) (cons (boolean #f) (cons nil (cons a (make-integer 2))))))))))))
    (show (== a (string->symbol (slice "abc" 0 1))))
    (show (== kw (string->keyword (slice "keys" 0 3))))
    (show (== a (named "b")))
    (show (length (list3 a a a)))
    (show (list? (cons a a)))
    (line (append (list3 a kw nil) (list3 (named "b") (named "c") nil)))
    (line (list3 (named "quote") a nil))
    (line (list2 (named "quote-syntax") a))
    (line (list3 (integer->char 32) (integer->char 7) (integer->char 1)))))

(define (sets)
  (let ([s31 (scopes 3 1 0)] [s13 (scopes 1 3 0)] [s1 (scopes 1 0 0)])
    (show (== s31 s13))
    (show (== (scopes-change s31 3 2) s1))
    (show (== (scopes-change s1 5 1) s1))
    (show (== (scopes-change s1 1 0) s1))
    (show (scopes-subset? s1 s31))
    (show (scopes-subset? s31 s1))
    (show (scopes-subset? no-scopes s1))
    (show (scopes-subset? (scopes 3 0 0) (scopes 5 3 1)))
    (show (scopes-subset? (scopes 4 0 0) (scopes 5 3 1)))
    (scoped (identifier "x" (scopes 2 9 5)))))

(define (changes)
  (begin-module-arena)
  (let* ([ctx (identifier "ctx" (scopes 3 1 0))]
         [s (datum->syntax ctx (cons (named "a") (cons (list2 (named "b") (named "c")) (named "d"))) 0)]
         [added (add-scope s 5)])
    (scoped s)
    (scoped added)
    (scoped (remove-scope added 3))
    (let ([twice (flip-scope (flip-scope s 7) 7)])
      (show (== (syntax-scopes twice) (syntax-scopes s)))
      (show (== (syntax-e twice) (syntax-e s))))
    (let* ([in (flip-scope s 9)]
           [out (datum->syntax ctx (cons (identifier "new" (syntax-scopes ctx)) (syntax-e in)) in)])
      (scoped (flip-scope out 9)))
    (line s)
    (line (syntax->datum added))
    (show (length (syntax->list (datum->syntax 0 (list3 (named "p") (named "q") (named "r")) 0))))
    (show (== (syntax->list added) 0))
    (show (identifier? ctx))
    (show (identifier? s))
    (printf "\n"))
  (end-module-arena))

(define (properties)
  (let* ([x (identifier "x" no-scopes)] [type (named "type")]
         [typed (syntax-property-set x type (named "i32"))]
         [retyped (syntax-property-set typed type (named "i64"))])
    (line (syntax-property typed type))
    (line (syntax-property retyped type))
    (line (syntax-property x type))
    (line (syntax-property (syntax-property-set retyped (named "other") nil) type))
    (let ([at (make-syntax (named "y") no-scopes (make-srcloc (named "f.sub") 4 2 30 1) nil)])
      (show (-> (syntax-srcloc (datum->syntax 0 (named "z") at)) line)))
    (printf "\n")))

(define (arenas)
  (let ([kept datum 0] [x (named "x")])
    (begin-module-arena)
    (let ([s (add-scope (datum->syntax (identifier "ctx" (scopes 2 0 0)) (list3 x (string->datum "str") (make-integer 7)) 0) 4)])
      (set! kept (keep (syntax-property-set s x (list2 x (make-flonum 2.5))))))
    (end-module-arena)
    (show (== (current-arena) (& run-arena)))
    (begin-module-arena)
    (for ([i 0]) (< i 10000) (+= i 1) (cons nil nil))
    (scoped kept)
    (line (syntax-property kept x))
    (end-module-arena)))

(define (flonums)
  (let ([xs (array f64 14)])
    (set! (@ xs 12) (/ 1.0 3.0)) (set! (@ xs 13) 5e-324)
    (set! (@ xs 0) 0.1) (set! (@ xs 1) 100.0) (set! (@ xs 2) 1e21) (set! (@ xs 3) 1.5e-7)
    (set! (@ xs 4) -0.0) (set! (@ xs 5) 123456.789) (set! (@ xs 6) 0.001) (set! (@ xs 7) 1e10)
    (set! (@ xs 8) 12345678901.0) (set! (@ xs 9) (/ 1.0 0.0)) (set! (@ xs 10) (/ 0.0 0.0)) (set! (@ xs 11) -2.5e-300)
    (for ([i 0]) (< i 14) (+= i 1)
      (printf "~s " (make-flonum (@ xs i))))
    (printf "\n")))

(define (templates)
  (let ([x (make-integer 7)] [xs (cons 'a (cons 'b nil))])
    (show (== 'lambda (named "lambda")))
    (line `(let ([x ,x]) ,@xs . done))
    (line `(1 "two" #\3 #:four 5.5 #t #f () (nested ,x) ,@xs))
    (line `,x)
    (line `(,@xs))
    (show (== `(a (b c)) `(a (b c))))
    (show (== (cadr `(,x (b c))) (cadr `(,x (b c)))))
    (printf "\n")))

(define (main)
  (templates)
  (data)
  (sets)
  (changes)
  (properties)
  (arenas)
  (flonums))

(test syntax (expect-output-file "syntax.out" (main)))
