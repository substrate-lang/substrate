;; Routes that overlap with neither more specific are refused.
(require-unqualified http "../../lib/http/http.sub")
(require-unqualified server "../../lib/http/server.sub")
(require-unqualified route "../../lib/http/route.sub")

(define (f [r (ptr http-request)] [x string]) (http-finish! r))
(define (g [r (ptr http-request)] [y string]) (http-finish! r))

(routes app
  [GET ("a" [x string]) f]
  [GET ([y string] "b") g])

(define (main) (begin))
