;; Requests with malformed chunked bodies, one answered before its body and one at its end.
(require-unqualified events "../../host/events.sub")
(require-unqualified stream "../../host/stream.sub")
(require-unqualified net "../../host/node/net.sub")
(require-unqualified http "../../lib/http/http.sub")
(require-unqualified server "../../lib/http/server.sub")

(struct side [head event-head] [name string] [target string] [in (array u8 256)] [got buffer])

(define server http-server)
(define a side)
(define b side)

(define (body-ended [r (ptr http-request)])
  (http-respond! r (if (-> r failed) 400 200))
  (http-send-text! r (if (-> r failed) "failed" "late")))

(define (handle [r (ptr http-request)])
  (if (== (-> r target) "/early")
      (begin
        (http-respond! r 200)
        (http-send-text! r "early"))
      (set! (-> r on-end) body-ended)))

(define (send-request! [s (ptr side)] [id u32])
  (let ([b (make-buffer)])
    (http-write-request! (& b) "POST" (-> s target))
    (http-write-header! (& b) "host" "127.0.0.1")
    (http-write-header! (& b) "transfer-encoding" "chunked")
    (http-write-end! (& b))
    (buffer-add-string! (& b) "zz\r\n")
    (stream-write id (buffer-bytes (& b)))
    (buffer-free! (& b))))

(define (show! [s (ptr side)])
  (let* ([text (buffer-string (& (-> s got)))] [n (-> text length)] [i u32 0])
    (while (and (< i n) (!= (@ text i) 13)) (+= i 1))
    (printf "~a: ~a" (-> s name) (slice text 0 i))
    (+= i 1)
    (while (and (< (+ i 2) n) (not (and (== (@ text i) 10) (== (@ text (+ i 1)) 13) (== (@ text (+ i 2)) 10)))) (+= i 1))
    (when (<= (+ i 3) n) (printf " ~a" (slice text (+ i 3))))
    (printf "\n")))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([s (cast (ptr side) tag)])
    (cond [(== kind net-connected)
           (printf "~a: connected\n" (-> s name))
           (send-request! s id)
           (stream-read! id (slice (-> s in)))]
          [(== kind net-failed)
           (let ([why (events-take-text)])
             (printf "~a: failed ~a: ~a\n" (-> s name) value why)
             (free (-> why bytes)))]
          [(and (== kind stream-read) (> value 0))
           (buffer-add! (& (-> s got)) (slice (-> s in) (cast u32 value)))
           (stream-read! id (slice (-> s in)))]
          [(== kind stream-read)
           (show! s)
           (printf "~a: end\n" (-> s name))
           (stream-close id)
           (if (== s (& a))
               (net-connect (-> server port) "127.0.0.1" 0 (& b) 0)
               (http-server-close! (& server)))]
          [(== kind stream-failed)
           (let ([why (events-take-text)])
             (printf "~a: stream failed ~a: ~a\n" (-> s name) value why)
             (free (-> why bytes)))])))

(define (listening [s (ptr http-server)])
  (printf "listening\n")
  (net-connect (-> s port) "127.0.0.1" 0 (& a) 0))

(define (main)
  (set! (-> a head handle) heard)
  (set! (-> a name) "a")
  (set! (-> a target) "/early")
  (set! (-> a got) (make-buffer))
  (set! (-> b head handle) heard)
  (set! (-> b name) "b")
  (set! (-> b target) "/late")
  (set! (-> b got) (make-buffer))
  (set! (-> server listening) listening)
  (http-serve! (& server) 0 handle))
