;; A server that allows one connection and 200 ms of waiting. It cuts off a head sent a byte at a time, counts a
;; WebSocket as its connection, and pings and then closes a silent WebSocket.
(require-unqualified events "../../host/events.sub")
(require-unqualified stream "../../host/stream.sub")
(require-unqualified net "../../host/node/net.sub")
(require-unqualified timer "../../host/modules/timer.sub")
(require-unqualified http "../../lib/http/http.sub")
(require-unqualified server "../../lib/http/server.sub")
(require-unqualified ws "../../lib/http/websocket.sub")

(struct side [head event-head] [name (ptr u8)] [stream u32] [in (array u8 256)] [sent u32] [timer u32])

(define server http-server)
(define socket ws-connection)
(define slow side)
(define sock side)
(define other side)
(define head (ptr u8) "GET / HTTP/1.1\r\nx-padding: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
(define upgrade (ptr u8)
  "GET / HTTP/1.1\r\nhost: 127.0.0.1\r\nupgrade: websocket\r\nconnection: upgrade\r\nsec-websocket-key: dGhlIHNhbXBsZSBub25jZQ==\r\nsec-websocket-version: 13\r\n\r\n")

(define (closed [w (ptr ws-connection)] [code i32])
  (printf "server: websocket closed ~a\n" code)
  (http-server-close! (& server)))

(define (handle [r (ptr http-request)])
  (cond [(not (ws-upgrade? r))
         (http-respond! r 426)
         (http-send-text! r "upgrade required")]
        [(ws-accept! (& socket) r 0) (set! (-> socket on-closed) closed)]))

(define (connect! [s (ptr side)]) (net-connect (-> server port) "127.0.0.1" 0 s 0))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([s (cast (ptr side) tag)])
    (cond [(== source timer-source)
           (stream-write (-> s stream) (slice (+ head (-> s sent)) 1))
           (+= (-> s sent) 1)
           (when (< (-> s sent) (strlen head)) (set! (-> s timer) (timer-after 50.0 s)))]
          [(== kind net-connected)
           (set! (-> s stream) id)
           (stream-read! id (slice (-> s in)))
           (cond [(== s (& slow)) (set! (-> s timer) (timer-after 50.0 s))]
                 [(== s (& sock)) (stream-write-text id (string-at upgrade))]
                 [else (stream-write-text id "GET / HTTP/1.1\r\nhost: 127.0.0.1\r\n\r\n")])]
          [(and (== kind stream-read) (> value 0))
           (cond [(!= s (& sock)) (printf "~a: answered\n" (-> s name))]
                 [(== (@ (-> s in) 0) 137) (printf "sock: pinged\n")]
                 [(== (-> s sent) 0)
                  (set! (-> s sent) 1)
                  (printf "sock: upgraded\n")
                  (connect! (& other))])
           (stream-read! id (slice (-> s in)))]
          [(== kind stream-read)
           (if (== s (& slow))
               (begin
                 (timer-cancel (-> s timer))
                 (printf "slow: closed ~a\n" (if (< (-> s sent) (strlen head)) "while sending its head" "after its head"))
                 (connect! (& sock)))
               (printf "~a: closed\n" (-> s name)))
           (stream-close id)])))

(define (side! [s (ptr side)] [name (ptr u8)])
  (set! (-> s head handle) heard)
  (set! (-> s name) name))

(define (listening [s (ptr http-server)]) (connect! (& slow)))

(define (main)
  (side! (& slow) "slow")
  (side! (& sock) "sock")
  (side! (& other) "other")
  (set! (-> server idle) 200.0)
  (set! (-> server most) 1)
  (set! (-> server listening) listening)
  (http-serve! (& server) 0 handle))
