;; Files through the test client: validators, 304s and 412s, ranges and If-Range, HEAD, paths, dot files, a directory's
;; index and redirect, Cache-Control per file, a handler's own validators, and ranges of a large file.
(require-unqualified events host/events)
(require-unqualified fs host/fs)
(require-unqualified http std/http)
(require-unqualified server std/http/server)
(require-unqualified test std/http/test)
(require-unqualified conditional std/http/conditional)
(require-unqualified static std/http/static)

(define server http-server)
(define t http-test)
(define files http-files)
(define large http-files)
(define etag buffer)
(define modified buffer)
(define line buffer)
(define printed buffer)
(define size u32 300000)

(define (cache [path string]) -> string (if (== path "digits.txt") "public, max-age=31536000, immutable" ""))

(define (starts? [s string] [prefix string]) -> bool
  (and (>= (-> s length) (-> prefix length)) (== (slice s 0 (-> prefix length)) prefix)))

(define (handle [r (ptr http-request)])
  (let ([target (-> r target)])
    (cond [(starts? target "/send/") (http-send-file! r (& files) (slice target 6))]
          [(starts? target "/large/") (http-send-file! r (& large) (slice target 7))]
          [(== target "/note")
           (http-add-header! r "cache-control" "no-cache")
           (unless (http-conditional! r "\"v1\"" 784111777000.0)
             (http-respond! r 200)
             (http-header! r "content-type" "text/plain; charset=utf-8")
             (http-send-text! r "note"))]
          [else (http-static! r (& files))])))

(define (sent [method string] [target string] [headers string]) -> i32
  (let ([list (array string 8)] [n u32 0] [start u32 0])
    (for ([i u32 0]) (<= i (-> headers length)) (+= i 1)
      (when (or (== i (-> headers length)) (== (@ headers i) 10))
        (let ([part (slice headers start i)] [k u32 0])
          (unless (== (-> part length) 0)
            (while (!= (@ part k) 58) (+= k 1))
            (set! (@ list n) (slice part 0 k))
            (set! (@ list (+ n 1)) (http-trimmed (slice part (+ k 1))))
            (+= n 2)))
        (set! start (+ i 1))))
    (http-test! (& t) (& server) method target (slice list n) (cast (slice u8) ""))
    (http-test-status (& t))))

(define (at? [s string] [i u32] [part string]) -> bool
  (and (> (-> part length) 0) (<= (+ i (-> part length)) (-> s length)) (== (slice s i (+ i (-> part length))) part)))

;; masked writes the ETag and date of /digits.txt, which change with the file, as ETAG and DATE.
(define (masked [headers string]) -> string
  (let ([b (& printed)] [i u32 0] [e (buffer-string (& etag))] [d (buffer-string (& modified))])
    (set! (-> b length) 0)
    (while (< i (-> headers length))
      (cond [(at? headers i e)
             (buffer-add-string! b "ETAG")
             (+= i (-> e length))]
            [(at? headers i d)
             (buffer-add-string! b "DATE")
             (+= i (-> d length))]
            [else
             (buffer-add-byte! b (@ headers i))
             (+= i 1)]))
    (buffer-string b)))

(define (header [name string] [shown bool])
  (let ([value (http-test-header (& t) name)])
    (unless (== (-> value length) 0)
      (if shown (printf " [~a: ~a]" name value) (printf " [~a]" name)))))

(define (ask [method string] [target string] [headers string])
  (let ([status (sent method target headers)] [body (cast string (http-test-body (& t)))])
    (printf "~a ~a ~s: ~a" method target (masked headers) status)
    (header "content-type" #t)
    (header "content-length" #t)
    (header "content-range" #t)
    (header "accept-ranges" #t)
    (header "cache-control" #t)
    (header "etag" (starts? target "/note"))
    (header "last-modified" (starts? target "/note"))
    (header "location" #t)
    (header "allow" #t)
    (if (<= (-> body length) 32) (printf " ~s\n" body) (printf " ~a bytes\n" (-> body length)))))

(define (with [name string] [value (ptr buffer)]) -> string
  (set! (-> line length) 0)
  (buffer-add-string! (& line) name)
  (buffer-add-string! (& line) ": ")
  (buffer-add! (& line) (buffer-bytes value))
  (buffer-string (& line)))

(define (with-weak [name string] [value (ptr buffer)]) -> string
  (set! (-> line length) 0)
  (buffer-add-string! (& line) name)
  (buffer-add-string! (& line) ": W/")
  (buffer-add! (& line) (buffer-bytes value))
  (buffer-string (& line)))

(define (validators)
  (ask "GET" "/digits.txt" "")
  (buffer-add-string! (& etag) (http-test-header (& t) "etag"))
  (buffer-add-string! (& modified) (http-test-header (& t) "last-modified"))
  (ask "GET" "/digits.txt" (with "if-none-match" (& etag)))
  (ask "GET" "/digits.txt" (with-weak "if-none-match" (& etag)))
  (ask "GET" "/digits.txt" "if-none-match: \"other\", \"else\"")
  (ask "GET" "/digits.txt" "if-none-match: *")
  (ask "GET" "/digits.txt" (with "if-modified-since" (& modified)))
  (ask "GET" "/digits.txt" "if-modified-since: Sun, 06 Nov 1994 08:49:37 GMT")
  (ask "GET" "/digits.txt" "if-modified-since: yesterday")
  (ask "GET" "/digits.txt" "if-match: \"other\"")
  (ask "GET" "/digits.txt" (with "if-match" (& etag)))
  (ask "GET" "/digits.txt" (with-weak "if-match" (& etag)))
  (ask "GET" "/digits.txt" "if-match: *")
  (ask "GET" "/digits.txt" "if-unmodified-since: Sun, 06 Nov 1994 08:49:37 GMT")
  (ask "GET" "/digits.txt" (with "if-unmodified-since" (& modified))))

(define (ranges)
  (ask "GET" "/digits.txt" "range: bytes=0-4")
  (ask "GET" "/digits.txt" "range: bytes=-3")
  (ask "GET" "/digits.txt" "range: bytes=15-")
  (ask "GET" "/digits.txt" "range: bytes=10-99")
  (ask "GET" "/digits.txt" "range: bytes=0-1, 2-3")
  (ask "GET" "/digits.txt" "range: bytes=4-5,0-4")
  (ask "GET" "/digits.txt" "range: bytes=0-1,5-6")
  (ask "GET" "/digits.txt" "range: bytes=30-40")
  (ask "GET" "/digits.txt" "range: bytes=30-40,-0")
  (ask "GET" "/digits.txt" "range: bytes=5-2")
  (ask "GET" "/digits.txt" "range: bytes=abc")
  (ask "GET" "/digits.txt" "range: lines=1-2")
  (ask "HEAD" "/digits.txt" "range: bytes=0-4")
  (ask "GET" "/digits.txt" (with "if-range" (& etag)))
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "range: bytes=0-4\n")
    (buffer-add-string! (& b) (with "if-range" (& etag)))
    (ask "GET" "/digits.txt" (buffer-string (& b)))
    (set! (-> b length) 0)
    (buffer-add-string! (& b) "range: bytes=0-4\n")
    (buffer-add-string! (& b) (with "if-range" (& modified)))
    (ask "GET" "/digits.txt" (buffer-string (& b)))
    (set! (-> b length) 0)
    (buffer-add-string! (& b) "range: bytes=0-4\n")
    (buffer-add-string! (& b) (with-weak "if-range" (& etag)))
    (ask "GET" "/digits.txt" (buffer-string (& b)))
    (buffer-free! (& b)))
  (ask "GET" "/digits.txt" "range: bytes=0-4\nif-range: \"other\""))

(define (paths)
  (ask "HEAD" "/digits.txt" "")
  (ask "POST" "/digits.txt" "")
  (ask "GET" "/page.html" "")
  (ask "GET" "/dir" "")
  (ask "GET" "/dir?a=1" "")
  (ask "GET" "/dir/" "")
  (ask "GET" "/missing.txt" "")
  (ask "GET" "/.secret" "")
  (ask "GET" "/dir/../.secret" "")
  (ask "GET" "/%2esecret" "")
  (ask "GET" "/.well-known/security.txt" "")
  (ask "GET" "/a%2fb" "")
  (ask "GET" "/send/digits.txt" "range: bytes=-2")
  (ask "GET" "/send/dir/index.html" "")
  (ask "GET" "/send/dir/../digits.txt" "")
  (ask "GET" "/send/./digits.txt" "")
  (ask "GET" "/send//etc/passwd" "")
  (ask "GET" "/send/.secret" "")
  (ask "GET" "/send/.well-known/security.txt" "")
  (ask "GET" "/send/dir" "")
  (ask "GET" "/send/" ""))

(define (own)
  (ask "GET" "/note" "")
  (ask "GET" "/note" "if-none-match: \"v1\"")
  (ask "GET" "/note" "if-modified-since: Sun, 06 Nov 1994 08:49:37 GMT")
  (ask "PUT" "/note" "if-none-match: \"v1\"")
  (ask "PUT" "/note" "if-match: \"v2\"")
  (ask "PUT" "/note" "if-match: \"v1\""))

(define (byte-at [i u32]) -> u8 (cast u8 (% (* i 7) 251)))

(define (checked [t (ptr http-test)] [start u32])
  (let ([body (http-test-body t)] [same #t])
    (for ([i u32 0]) (< i (-> body length)) (+= i 1)
      (unless (== (@ body i) (byte-at (+ start i))) (set! same #f)))
    (printf "large: ~a ~a ~a bytes, as written: ~a\n" (http-test-status t) (http-test-header t "content-range")
            (-> body length) same)))

(define (after-whole [t (ptr http-test)])
  (checked t 0)
  (http-test-free! t)
  (fs-remove (-> large root) #t 0))

(define (after-open [t (ptr http-test)])
  (checked t 100000)
  (http-test-later! t (& server) "GET" "/large/large.bin" (slice (array-of string "accept" "*/*")) (cast (slice u8) "")
                    after-whole))

(define (after-suffix [t (ptr http-test)])
  (checked t 299990)
  (http-test-later! t (& server) "GET" "/large/large.bin" (slice (array-of string "range" "bytes=100000-"))
                    (cast (slice u8) "") after-open))

(define (main)
  (set! (-> files root) "files")
  (set! (-> files cache) cache)
  (set! (-> server handle) handle)
  (validators)
  (ranges)
  (paths)
  (own)
  (let ([dir string] [path (make-buffer)] [bytes (make-buffer)])
    (fs-make-temp-dir "" "files" "" (& dir) 0)
    (set! (-> large root) dir)
    (buffer-add-string! (& path) dir)
    (buffer-add-string! (& path) "/large.bin")
    (for ([i u32 0]) (< i size) (+= i 1) (buffer-add-byte! (& bytes) (byte-at i)))
    (fs-write-file (buffer-string (& path)) (buffer-bytes (& bytes)) 0)
    (buffer-free! (& bytes))
    (buffer-free! (& path))
    (http-test-later! (& t) (& server) "GET" "/large/large.bin" (slice (array-of string "range" "bytes=-10"))
                      (cast (slice u8) "") after-suffix)))
