;; Targets' paths and queries, percent-decoding, segments and their cleaning, escaping, and the urlencoded format.
(require-unqualified url "../../lib/http/url.sub")

(define a arena)

(define (unescaped [s string] [plus bool]) (printf "~s -> ~s\n" s (url-unescape (& a) s plus)))

(define (segments [path string])
  (let* ([s (slice string)] [b (make-buffer)] [k (url-segments (& a) path (& s))])
    (printf "~s ->" path)
    (for ([i u32 0]) (< i (-> s length)) (+= i 1) (printf " ~s" (@ s i)))
    (printf " (~a)" k)
    (when (> k 0)
      (url-add-clean! (& b) s)
      (printf " clean ~s" (buffer-string (& b))))
    (printf "\n")
    (buffer-free! (& b))))

(define (escaped [s string])
  (let ([b (make-buffer)] [c (make-buffer)])
    (url-add-segment! (& b) s)
    (url-add-form-value! (& c) s)
    (printf "~s -> segment ~s, form ~s\n" s (buffer-string (& b)) (buffer-string (& c)))
    (buffer-free! (& b))
    (buffer-free! (& c))))

(define (pairs [s string])
  (let ([ps (url-form-parse (& a) s)])
    (printf "~s ->" s)
    (for ([i u32 0]) (< i (-> ps length)) (+= i 1)
      (printf " ~s=~s" (-> (+ (-> ps items) i) name) (-> (+ (-> ps items) i) value)))
    (printf "\n")))

(define (main)
  (printf "~s ~s\n" (url-path "/a/b?x=1?y") (url-query "/a/b?x=1?y"))
  (printf "~s ~s\n" (url-path "/a") (url-query "/a"))
  (unescaped "a%20b%2fc" #f)
  (unescaped "a+b" #t)
  (unescaped "a+b" #f)
  (unescaped "100%25 %zz %4 %" #f)
  (unescaped "%e2%82%ac" #f)
  (segments "/")
  (segments "/a")
  (segments "/a/")
  (segments "/a%2Fb/c%20d")
  (segments "/a//b")
  (segments "/a/./b/../c/")
  (segments "/a/%2e%2E/b")
  (segments "/..")
  (segments "/a/.")
  (segments "a/b")
  (segments "")
  (escaped "a b/c?d#e")
  (escaped "~user-1.x_y*")
  (escaped "é&=+")
  (pairs "a=1&b=2&&c&d=&=e&a=3")
  (pairs "q=hello+world%21&x=%E2%82%AC")
  (pairs "")
  (let ([ps (url-form-parse (& a) "a=1&b=2&a=3")] [v string])
    (printf "a: ~a ~s, c: ~a\n" (url-form-value ps "a" (& v)) v (url-form-value ps "c" (& v))))
  (arena-free (& a)))
