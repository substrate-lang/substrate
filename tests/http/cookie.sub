;; Cookies through the test client: set with each attribute, read from a header with quoted, spaced and malformed
;; pairs, and refused when a browser would refuse them.
(require-unqualified events host/events)
(require-unqualified http std/http)
(require-unqualified server std/http/server)
(require-unqualified test std/http/test)
(require-unqualified cookie std/http/cookie)

(define server http-server)
(define t http-test)
(define none (slice string) 0)

(define (bake! [r (ptr http-request)] [name string] [value string] [path string] [domain string] [max-age i64]
              [secure bool] [same-site i32])
  (let ([c http-cookie])
    (set! (-> c name) name)
    (set! (-> c value) value)
    (set! (-> c path) path)
    (set! (-> c domain) domain)
    (set! (-> c max-age) max-age)
    (set! (-> c secure) secure)
    (set! (-> c http-only) (== name "id"))
    (set! (-> c same-site) same-site)
    (http-set-cookie! r (& c))))

(define (handle [r (ptr http-request)])
  (let ([path (-> r target)])
    (http-respond! r 200)
    (cond [(== path "/set")
           (bake! r "id" "abc123" "/" "" 3600 #t http-same-site-lax)
           (bake! r "theme" "dark" "" "example.com" 0 #f http-same-site-strict)
           (bake! r "gone" "" "/" "" -1 #f 0)
           (bake! r "__Host-x" "1" "/" "" 0 #t http-same-site-none)
           (http-finish! r)]
          [(== path "/read")
           (let ([b (make-buffer)])
             (for ([i u32 0]) (< i 6) (+= i 1)
               (let ([name (@ (array-of string "a" "b" "c" "d" "e" "missing") i)])
                 (when (> i 0) (buffer-add-byte! (& b) 32))
                 (buffer-add-string! (& b) name)
                 (buffer-add-byte! (& b) 61)
                 (buffer-add-string! (& b) (http-request-cookie r name))))
             (http-send-text! r (buffer-string (& b))))]
          [(== path "/space") (bake! r "a" "b c" "/" "" 0 #f 0)]
          [(== path "/host") (bake! r "__Host-a" "b" "/x" "" 0 #t 0)]
          [(== path "/none") (bake! r "a" "b" "/" "" 0 #f http-same-site-none)]
          [(== path "/secure") (bake! r "__secure-a" "b" "/" "" 0 #f 0)]
          [(== path "/long")
           (let ([b (make-buffer)])
             (for ([i u32 0]) (< i 4095) (+= i 1) (buffer-add-byte! (& b) 97))
             (bake! r "a" (buffer-string (& b)) "/" "" 0 #f 0)
             (printf "4096 bytes set\n")
             (buffer-add-byte! (& b) 97)
             (bake! r "a" (buffer-string (& b)) "/" "" 0 #f 0))])))

(define (trapped [r (ptr http-request)] [why string])
  (let ([i u32 0])
    (while (and (< i (-> why length)) (!= (@ why i) 10)) (+= i 1))
    (printf "trapped: ~a: ~a\n" (-> r target) (slice why 0 i))))

(define (cookies [t (ptr http-test)])
  (let ([h (& (-> t answer))])
    (for ([i u32 0]) (< i (-> h count)) (+= i 1)
      (when (== (@ (-> h names) i) "set-cookie") (printf "set-cookie: ~a\n" (@ (-> h values) i))))))

(define (refused [t (ptr http-test)]) (printf "~a\n" (http-test-status t)))

(define (after-space [t (ptr http-test)]) (http-test-later! t (& server) "GET" "/host" none 0 after-host))

(define (after-host [t (ptr http-test)]) (http-test-later! t (& server) "GET" "/none" none 0 after-none))

(define (after-none [t (ptr http-test)]) (http-test-later! t (& server) "GET" "/secure" none 0 after-secure))

(define (after-secure [t (ptr http-test)]) (http-test-later! t (& server) "GET" "/long" none 0 refused))

(define (main)
  (set! (-> server handle) handle)
  (set! (-> server on-trap) trapped)
  (http-test! (& t) (& server) "GET" "/set" none 0)
  (cookies (& t))
  (http-test! (& t) (& server) "GET" "/read"
              (slice (array-of string "cookie" "a=1; b=\"two\";c=3 ;  d = 4 ; bad name=x; e=\"; f; =g")) 0)
  (printf "read: ~a\n" (cast string (http-test-body (& t))))
  (http-test-later! (& t) (& server) "GET" "/space" none 0 after-space))
