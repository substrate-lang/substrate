;; A route that reads JSON into a type needs the type's json definitions first.
(require-unqualified http "../../lib/http/http.sub")
(require-unqualified server "../../lib/http/server.sub")
(require-unqualified json "../../lib/encoding/json.sub")
(require-unqualified route "../../lib/http/route.sub")

(struct point [x i32] [y i32])

(define (f [r (ptr http-request)] [p (ptr point)]) (http-finish! r))

(routes app
  [POST ("points") f (json point)])

(define (main) (begin))
