;; The HTTP parser fed messages in pieces: requests with and without bodies, chunked, pipelined, responses, a
;; malformed head, a length too long, a head too large, chunking named in capitals, two lengths, a length beside
;; chunking, a chunk size too long, a space before a colon, a coding that is not chunked, a chunk extension, junk
;; after a chunk's size and after its data, a bare LF after a chunk's size, after its data and after a trailer, a
;; bare CR in a chunk extension, other codings around chunked, in one header or two, a control byte in a name and
;; in a value, a control byte in a target, a version not HTTP/1, a method not a token, a later HTTP/1, a response
;; whose last coding is not chunked, and a 204 with a length, which has no body; and heads written.
(require-unqualified http "../../lib/http/http.sub")

(define parser http-parser)

(define (show-head [p (ptr http-parser)])
  (let ([h (& (-> p head))])
    (if (== (-> h method) 0)
        (printf "response ~a ~a ~a\n" (-> h version) (-> h status) (-> h reason))
        (printf "request ~a ~a ~a\n" (-> h method) (-> h target) (-> h version)))
    (for ([i u32 0]) (< i (-> h count)) (+= i 1)
      (printf "  ~a: ~a\n" (@ (-> h names) i) (@ (-> h values) i)))))

(define (show-body [p (ptr http-parser)] [bytes (ptr u8)] [n u32])
  (printf "body: ")
  (host-write 1 bytes (cast i32 n))
  (printf "\n"))

(define (show-end [p (ptr http-parser)]) (printf "end\n"))

(define (feed [s (ptr u8)])
  (let ([r (http-feed! (& parser) s (strlen s))])
    (when (< r 0) (printf "malformed\n"))))

(define (show-text [b (ptr buffer)])
  (for ([i u32 0]) (< i (-> b length)) (+= i 1)
    (let ([c (@ (-> b bytes) i)])
      (if (== c 13) (printf "\\r") (host-write 1 (+ (-> b bytes) i) 1)))))

(define (quiet [p (ptr http-parser)] [bytes (ptr u8)] [n u32]) (begin))

(define (add-bytes! [b (ptr buffer)] [c i32] [n u32]) (for ([i u32 0]) (< i n) (+= i 1) (buffer-add-byte! b c)))

;; A chunked request: times chunks of size bytes, each with an extension of n bytes, then trailers of 1000 bytes.
(define (padded [target (ptr u8)] [hex (ptr u8)] [size u32] [n u32] [times u32] [trailers u32])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "POST ")
    (buffer-add-string! (& b) target)
    (buffer-add-string! (& b) " HTTP/1.1\r\ntransfer-encoding: chunked\r\n\r\n")
    (for ([k u32 0]) (< k times) (+= k 1)
      (buffer-add-string! (& b) hex)
      (buffer-add-byte! (& b) 59)
      (add-bytes! (& b) 97 n)
      (buffer-add-string! (& b) "\r\n")
      (add-bytes! (& b) 120 size)
      (buffer-add-string! (& b) "\r\n"))
    (buffer-add-string! (& b) "0\r\n")
    (for ([k u32 0]) (< k trailers) (+= k 1)
      (buffer-add-string! (& b) "x: ")
      (add-bytes! (& b) 97 1000)
      (buffer-add-string! (& b) "\r\n"))
    (buffer-add-string! (& b) "\r\n")
    (buffer-add-byte! (& b) 0)
    (http-parser-init! (& parser) 0 show-head quiet show-end)
    (feed (-> b bytes))
    (buffer-free! (& b))))

(define (main)
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (feed "GET /index.html HTTP/1.1\r\nHost: example.com\r\nAccept:  */*  \r")
  (feed "\n\r\nPOST /up HTTP/1.1\r\ncontent-length: 5\r\n\r\nhel")
  (feed "lo")
  (feed "POST /chunks HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n6\r\n worl")
  (feed "d\r\n0\r\nx-trailer: yes\r\n\r\nGET /a HTTP/1.1\n\nGET /b HTTP/1.1\n\n")
  (feed "HTTP/1.1 404 Not Found\r\ncontent-length: 9\r\n\r\nnot foundHTTP/1.1 200 OK\r\n\r\nuntil the ")
  (feed "close")
  (http-parser-closed! (& parser))
  (feed "GARBAGE\r\n\r\n")
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (feed "GET / HTTP/1.1\r\ncontent-length: x\r\n\r\n")
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (feed "GET / HTTP/1.1\r\ncontent-length: 9999999999999999999\r\n\r\n")
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (let ([big (make-buffer)])
    (buffer-add-string! (& big) "GET / HTTP/1.1\r\nx: ")
    (for ([i u32 0]) (< i 17000) (+= i 1) (buffer-add-byte! (& big) 97))
    (buffer-add-byte! (& big) 0)
    (feed (-> big bytes))
    (buffer-free! (& big)))
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (feed "POST /c HTTP/1.1\r\nTransfer-Encoding: Chunked\r\n\r\n2\r\nhi\r\n0\r\n\r\n")
  (feed "POST /d HTTP/1.1\r\ncontent-length: 2\r\ncontent-length: 2\r\n\r\nhi")
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (feed "POST /e HTTP/1.1\r\ncontent-length: 2\r\ntransfer-encoding: chunked\r\n\r\n2\r\nhi\r\n0\r\n\r\n")
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (feed "POST /f HTTP/1.1\r\ntransfer-encoding: chunked\r\n\r\n10000000000000000\r\nhi\r\n0\r\n\r\n")
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (feed "POST /g HTTP/1.1\r\nTransfer-Encoding : chunked\r\n\r\n")
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (feed "POST /h HTTP/1.1\r\ntransfer-encoding: xchunked\r\n\r\n")
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (feed "POST /i HTTP/1.1\r\ntransfer-encoding: chunked\r\n\r\n2;ext=1\r\nhi\r\n0\r\n\r\n")
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (feed "POST /j HTTP/1.1\r\ntransfer-encoding: chunked\r\n\r\n2 junk\r\nhi\r\n0\r\n\r\n")
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (feed "POST /k HTTP/1.1\r\ntransfer-encoding: chunked\r\n\r\n2\r\nhiJUNK\r\n0\r\n\r\n")
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (feed "POST /q HTTP/1.1\r\ntransfer-encoding: chunked\r\n\r\n2\nhi\r\n0\r\n\r\n")
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (feed "POST /r HTTP/1.1\r\ntransfer-encoding: chunked\r\n\r\n2\r\nhi\n0\r\n\r\n")
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (feed "POST /s HTTP/1.1\r\ntransfer-encoding: chunked\r\n\r\n0\r\nx: y\n\r\n")
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (feed "POST /t HTTP/1.1\r\ntransfer-encoding: chunked\r\n\r\n2;a\rb\r\nhi\r\n0\r\n\r\n")
  (padded "/u" "1" 1 1000 20 0)
  (padded "/v" "1f4" 500 1000 40 0)
  (padded "/w" "1" 1 0 0 20)
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (feed "POST /l HTTP/1.1\r\ntransfer-encoding: chunked, gzip\r\n\r\n")
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (feed "POST /m HTTP/1.1\r\ntransfer-encoding: chunked\r\ntransfer-encoding: gzip\r\n\r\n")
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (feed "POST /n HTTP/1.1\r\ntransfer-encoding: gzip, chunked\r\n\r\n")
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (feed "POST /o HTTP/1.1\r\ncontent-length\x0b;: 2\r\n\r\nhi")
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (feed "POST /p HTTP/1.1\r\nx-a: b\rc\r\n\r\n")
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (feed "GET /a\x01;b HTTP/1.1\r\n\r\n")
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (feed "GET / BOGUS/9\r\n\r\n")
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (feed "G(T / HTTP/1.1\r\n\r\n")
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (feed "GET / HTTP/1.2\r\n\r\n")
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (feed "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked, gzip\r\n\r\nraw")
  (http-parser-closed! (& parser))
  (http-parser-init! (& parser) 0 show-head show-body show-end)
  (feed "HTTP/1.1 204 No Content\r\ncontent-length: 5\r\n\r\nHTTP/1.1 200 OK\r\ncontent-length: 2\r\n\r\nhi")
  (let ([b (make-buffer)])
    (http-write-status! (& b) 404)
    (http-write-header! (& b) "content-type" "text/plain")
    (http-write-number! (& b) "content-length" 9)
    (http-write-end! (& b))
    (http-write-request! (& b) "GET" "/x")
    (http-write-end! (& b))
    (http-write-chunk! (& b) "hello" 5)
    (http-write-chunk! (& b) "" 0)
    (http-write-last-chunk! (& b))
    (show-text (& b))
    (buffer-free! (& b)))
  (printf "~a, ~a, ~a ~a\n" (http-reason 200) (http-reason 503) (http-reason 999) (http-decimal "12a")))
