;; Checks through the test client: cross-origin protection, security headers, CORS alone and before cross-origin
;; protection, allowed hosts, rate limits by address and by IPv6 /56, addresses through proxies, and CORS * with
;; credentials refused.
(require-unqualified events "../../host/events.sub")
(require-unqualified timer "../../host/modules/timer.sub")
(require-unqualified http "../../lib/http/http.sub")
(require-unqualified server "../../lib/http/server.sub")
(require-unqualified test "../../lib/http/test.sub")
(require-unqualified checks "../../lib/http/checks.sub")

(define server http-server)
(define t http-test)
(define cross http-cross-origin)
(define security http-security)
(define cors http-cors)
(define limit http-limit)
(define hosts http-hosts)
(define allowed (array string 2))
(define list (array http-check 2))
(define names (array string 1))
(define any (array string 1))
(define waited event-head)

(define (handle [r (ptr http-request)]) (http-answer-text! r 200 (http-request-address r)))

(define (use! [run (fn ((ptr http-request) (ptr void)) -> bool)] [settings (ptr void)])
  (set! (-> (& (@ list 0)) run) run)
  (set! (-> (& (@ list 0)) settings) settings)
  (set! (-> server checks) (slice list 1)))

(define (header [name string])
  (let ([value (http-test-header (& t) name)])
    (unless (== (-> value length) 0) (printf "  ~a: ~a\n" name value))))

(define (sent [method string] [headers string]) -> i32
  (let ([list (array string 8)] [n u32 0] [start u32 0])
    (for ([i u32 0]) (<= i (-> headers length)) (+= i 1)
      (when (or (== i (-> headers length)) (== (@ headers i) 10))
        (let ([line (slice headers start i)] [k u32 0])
          (unless (== (-> line length) 0)
            (while (!= (@ line k) 58) (+= k 1))
            (set! (@ list n) (slice line 0 k))
            (set! (@ list (+ n 1)) (http-trimmed (slice line (+ k 1))))
            (+= n 2)))
        (set! start (+ i 1))))
    (http-test! (& t) (& server) method "/" (slice list n) 0)
    (http-test-status (& t))))

(define (cross-origin [method string] [headers string])
  (printf "~a ~s: ~a\n" method headers (sent method headers)))

(define (secured [headers string])
  (printf "security ~s: ~a\n" headers (sent "GET" headers))
  (let ([h (& (-> t answer))])
    (for ([i u32 0]) (< i (-> h count)) (+= i 1)
      (unless (or (== (@ (-> h names) i) "date") (== (@ (-> h names) i) "content-length")
                  (== (@ (-> h names) i) "content-type"))
        (printf "  ~a: ~a\n" (@ (-> h names) i) (@ (-> h values) i))))))

(define (cors-check [method string] [headers string])
  (printf "cors ~a ~s: ~a\n" method headers (sent method headers))
  (header "vary")
  (header "access-control-allow-origin")
  (header "access-control-allow-credentials")
  (header "access-control-allow-methods")
  (header "access-control-allow-headers")
  (header "access-control-expose-headers")
  (header "access-control-max-age"))

(define (host-check [host string])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "host: ")
    (buffer-add-string! (& b) host)
    (printf "host ~s: ~a\n" host (sent "GET" (buffer-string (& b))))
    (buffer-free! (& b))))

(define (limited [address string])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "x-forwarded-for: ")
    (buffer-add-string! (& b) address)
    (printf "limit ~a: ~a" address (sent "GET" (buffer-string (& b))))
    (unless (== (-> (http-test-header (& t) "retry-after") length) 0)
      (printf ", retry after ~a" (http-test-header (& t) "retry-after")))
    (printf "\n")
    (buffer-free! (& b))))

;; crowd: 100 more clients, past the table's first 64 buckets, then 2.2.2.2, whose bucket the growth kept.
(define (crowd)
  (let ([ok u32 0] [b (make-buffer)])
    (for ([i u32 0]) (< i 100) (+= i 1)
      (set! (-> b length) 0)
      (buffer-add-string! (& b) "x-forwarded-for: 10.0.0.")
      (write-digits (& b) (cast u64 i) 10)
      (when (== (sent "GET" (buffer-string (& b))) 200) (+= ok 1)))
    (printf "100 more clients: ~a answered\n" ok)
    (buffer-free! (& b))
    (limited "2.2.2.2")))

(define (address [proxies u32] [headers string])
  (set! (-> server proxies) proxies)
  (sent "GET" headers)
  (printf "address with ~a proxies, ~s: ~s\n" proxies headers (cast string (http-test-body (& t)))))

(define (trapped [r (ptr http-request)] [why string])
  (let ([i u32 0])
    (while (and (< i (-> why length)) (!= (@ why i) 10)) (+= i 1))
    (printf "trapped: ~a\n" (slice why 0 i))))

(define (refused [t (ptr http-test)])
  (printf "~a\n" (http-test-status t))
  (http-test-free! t))

(define (later [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (limited "1.1.1.1")
  (set! (-> server checks) (slice list 0))
  (address 0 "")
  (address 1 "x-forwarded-for: a, b")
  (address 2 "x-forwarded-for: a, b")
  (address 5 "x-forwarded-for: a, b")
  (address 1 "x-forwarded-for: a\nx-forwarded-for: b, c")
  (address 1 "x-forwarded-for: 198.51.100.7:4567")
  (address 1 "x-forwarded-for: [2001:db8::1]:4567")
  (address 1 "x-forwarded-for: 2001:db8::1")
  (set! (-> cors credentials) #t)
  (use! http-cors-check (& cors))
  (http-test-later! (& t) (& server) "GET" "/" (slice (array-of string "origin" "https://app.example")) 0 refused))

(define (main)
  (set! (@ names 0) "https://trusted.example")
  (set! (-> cross trusted) (slice names))
  (set! (-> server handle) handle)
  (set! (-> server on-trap) trapped)
  (use! http-cross-origin-check (& cross))
  (cross-origin "POST" "sec-fetch-site: cross-site")
  (cross-origin "POST" "sec-fetch-site: same-origin")
  (cross-origin "POST" "sec-fetch-site: none")
  (cross-origin "POST" "sec-fetch-site: same-site\norigin: https://trusted.example")
  (cross-origin "POST" "origin: http://test")
  (cross-origin "POST" "origin: http://evil.example")
  (cross-origin "POST" "")
  (cross-origin "GET" "sec-fetch-site: cross-site")
  (cross-origin "DELETE" "sec-fetch-site: same-site")
  (use! http-security-check (& security))
  (secured "")
  (set! (-> server proxies) 1)
  (set! (-> security policy) "default-src 'self'")
  (secured "x-forwarded-proto: https")
  (set! (-> server proxies) 0)
  (set! (@ names 0) "https://app.example")
  (set! (-> cors origins) (slice names))
  (set! (-> cors credentials) #t)
  (set! (-> cors expose) "etag")
  (set! (-> cors max-age) 600)
  (use! http-cors-check (& cors))
  (cors-check "OPTIONS"
              "origin: https://app.example\naccess-control-request-method: PUT\naccess-control-request-headers: x-key")
  (cors-check "OPTIONS" "origin: https://other.example\naccess-control-request-method: PUT")
  (cors-check "GET" "origin: https://app.example")
  (cors-check "GET" "")
  (set! (-> (& (@ list 1)) run) http-cross-origin-check)
  (set! (-> (& (@ list 1)) settings) (cast (ptr void) (& cross)))
  (set! (-> server checks) (slice list 2))
  (cors-check "PUT" "origin: https://app.example\nsec-fetch-site: cross-site")
  (cors-check "PUT" "origin: https://other.example\nsec-fetch-site: cross-site")
  (set! (@ any 0) "*")
  (set! (-> cors origins) (slice any))
  (set! (-> cors credentials) #f)
  (use! http-cors-check (& cors))
  (cors-check "GET" "origin: https://other.example")
  (cors-check "GET" "")
  (set! (@ allowed 0) ".localhost")
  (set! (@ allowed 1) "example.com")
  (set! (-> hosts names) (slice allowed))
  (set! (-> hosts addresses) #t)
  (use! http-hosts-check (& hosts))
  (host-check "localhost:8000")
  (host-check "app.localhost")
  (host-check "LOCALHOST.")
  (host-check "127.0.0.1:8000")
  (host-check "[::1]:8000")
  (host-check "example.com:")
  (host-check "www.example.com")
  (host-check "evil.example")
  (host-check "evillocalhost")
  (host-check "127.0.0.1.nip.io")
  (host-check "::1")
  (host-check "example.com:80x")
  (http-test-raw! (& t) (& server) (cast (slice u8) "GET / HTTP/1.0\r\n\r\n") #f)
  (printf "no host: ~a\n" (http-test-status (& t)))
  (set! (-> hosts addresses) #f)
  (host-check "127.0.0.1")
  (set! (@ allowed 0) "*")
  (host-check "anything.example")
  (set! (-> limit rate) 1.0)
  (set! (-> limit burst) 2)
  (set! (-> server proxies) 1)
  (use! http-limit-check (& limit))
  (limited "1.1.1.1")
  (limited "1.1.1.1")
  (limited "1.1.1.1")
  (limited "2.2.2.2")
  (limited "::ffff:2.2.2.2")
  (limited "::ffff:202:202")
  (limited "2001:db8:1:2::1")
  (limited "2001:db8:1:ff::9")
  (limited "2001:DB8:1:2:0:0:0:1")
  (limited "2001:db8:1:100::1")
  (limited "3.3.3.3:1001")
  (limited "3.3.3.3:1002")
  (limited "3.3.3.3:1003")
  (crowd)
  (set! (-> waited handle) later)
  (timer-after 1000.0 (& waited)))
