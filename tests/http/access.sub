;; The access log at the fake clock's time: answers, a 404, a later answer, an address behind a proxy, and a trap,
;; logged as an error, its reason up to its first line break, then answered 500.
(require-unqualified events host/events)
(require-unqualified timer host/modules/timer)
(require-unqualified http std/http)
(require-unqualified server std/http/server)
(require-unqualified test std/http/test)
(require-unqualified log std/log)

(struct later [head event-head] [request (ptr http-request)])

(define server http-server)
(define t http-test)
(define out logger)
(define delay later)
(define none (slice string) 0)
(define zero i32 0)

(define (shown [l (ptr logger)] [line (slice u8)])
  (let ([i u32 0] [n (-> line length)])
    (while (and (< (+ i 1) n) (not (and (== (@ line i) 92) (== (@ line (+ i 1)) 110)))) (+= i 1))
    (if (< (+ i 1) n)
        (printf "~a...\n" (cast string (slice line 0 i)))
        (printf "~a" (cast string line)))))

(define (answer-later [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (http-answer-text! (-> delay request) 200 "later"))

(define (handle [r (ptr http-request)])
  (let ([path (-> r target)])
    (cond [(== path "/later")
           (set! (-> delay request) r)
           (timer-after 25.0 (& delay))]
          [(== path "/trap") (http-answer-text! r 200 (if (== (/ 1 zero) 0) "zero" "one"))]
          [(== path "/") (http-answer-text! r 200 "ok")]
          [else (http-answer-text! r 404 "not found")])))

(define (trapped [t (ptr http-test)]) (http-test-free! t))

(define (after-later [t (ptr http-test)])
  (set! (-> server proxies) 1)
  (http-test! t (& server) "GET" "/" (slice (array-of string "x-forwarded-for" "203.0.113.9")) 0)
  (set! (-> server proxies) 0)
  (http-test-later! t (& server) "GET" "/trap" none 0 trapped))

(define (main)
  (set! (-> delay head handle) answer-later)
  (set! (-> out write) shown)
  (set! (-> server log) (& out))
  (set! (-> server on-done) http-log-access)
  (set! (-> server handle) handle)
  (http-test! (& t) (& server) "GET" "/" none 0)
  (http-test! (& t) (& server) "POST" "/missing" none (cast (slice u8) "abc"))
  (http-test-later! (& t) (& server) "GET" "/later" none 0 after-later))
