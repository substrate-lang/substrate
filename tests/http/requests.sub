;; Requests through the test client: HEAD, a trap answered 500, body limits, a malformed body, a redirect, arenas over
;; many requests, a later answer, and a connection that ends first.
(require-unqualified events host/events)
(require-unqualified timer host/modules/timer)
(require-unqualified http std/http)
(require-unqualified server std/http/server)
(require-unqualified test std/http/test)

(struct delay [head event-head] [request (ptr http-request)])

(define server http-server)
(define t http-test)
(define zero i32 0)
(define late delay)
(define none (slice string) 0)

(define (took [r (ptr http-request)] [body (slice u8)])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "took ")
    (write-digits (& b) (-> body length) 10)
    (http-answer-text! r 200 (buffer-string (& b)))
    (buffer-free! (& b))))

(define (gone [r (ptr http-request)])
  (printf "gone: ~a ~a\n" (-> r method) (-> r target))
  (http-answer-text! r 200 "late"))

(define (later [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (http-answer-text! (-> (cast (ptr delay) tag) request) 200 "later"))

(define (handle [r (ptr http-request)])
  (let ([path (-> r target)])
    (cond [(== path "/hello") (http-answer-text! r 200 "hello")]
          [(== path "/trap") (http-answer-text! r 200 (if (== (/ 1 zero) 0) "no" "no"))]
          [(== path "/body") (http-read-body! r 16 took)]
          [(== path "/away") (http-redirect! r 303 "/hello")]
          [(== path "/arena")
           (for ([i u32 0]) (< i 100) (+= i 1) (arena-alloc (& (-> r arena)) 1000))
           (http-answer-text! r 200 "used")]
          [(== path "/later")
           (set! (-> late request) r)
           (timer-after 1.0 (& late))]
          [(== path "/wait") (set! (-> r on-gone) gone)]
          [else (http-answer-text! r 404 "not found")])))

(define (trapped [r (ptr http-request)] [why string])
  (let ([i u32 0])
    (while (and (< i (-> why length)) (!= (@ why i) 10)) (+= i 1))
    (printf "trapped: ~a ~a: ~a\n" (-> r method) (-> r target) (slice why 0 i))))

(define (shown [what string])
  (printf "~a: ~a ~s" what (http-test-status (& t)) (cast string (http-test-body (& t))))
  (let ([length (http-test-header (& t) "content-length")] [location (http-test-header (& t) "location")])
    (when (== (-> (http-test-body (& t)) length) 0) (printf " length ~a" length))
    (unless (== (-> location length) 0) (printf " location ~a" location)))
  (printf "\n"))

(define (sent [method string] [target string] [body string])
  (unless (http-test! (& t) (& server) method target none (cast (slice u8) body)) (printf "no answer yet: "))
  (shown target))

(define (chunked [body string])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "POST /body HTTP/1.1\r\nhost: x\r\ntransfer-encoding: chunked\r\n\r\n")
    (buffer-add-string! (& b) body)
    (http-test-raw! (& t) (& server) (buffer-bytes (& b)) #f)
    (shown "chunked")
    (buffer-free! (& b))))

(define (ignored [tag (ptr void)] [b (slice u8)]) (begin))
(define (ended [tag (ptr void)]) (printf "ended\n"))

(define (answered [t (ptr http-test)])
  (shown "/trap")
  (sent "GET" "/hello" "")
  (http-test-later! t (& server) "GET" "/later" none 0 came))

(define (came [t (ptr http-test)])
  (shown "/later")
  (http-test-free! t)
  (let ([c (http-connect! (& server) ignored ended 0)])
    (http-connection-feed! c (cast (slice u8) "GET /wait HTTP/1.1\r\nhost: x\r\n\r\n"))
    (http-connection-close! c)
    (printf "/wait: closed\n")))

(define (main)
  (let ([heap i32 0])
    (set! (-> late head handle) later)
    (set! (-> server handle) handle)
    (set! (-> server on-trap) trapped)
    (sent "GET" "/hello" "")
    (sent "HEAD" "/hello" "")
    (sent "POST" "/body" "0123456789")
    (sent "POST" "/body" "0123456789abcdefg")
    (chunked "8\r\n01234567\r\n8\r\n01234567\r\n8\r\n01234567\r\n0\r\n\r\n")
    (chunked "zz\r\n")
    (sent "GET" "/away" "")
    (for ([i u32 0]) (< i 200) (+= i 1)
      (http-test! (& t) (& server) "GET" "/arena" none 0)
      (when (== i 9) (set! heap (sbrk 0))))
    (printf "the heap grew after ten rounds: ~a\n" (!= (sbrk 0) heap))
    (http-test-later! (& t) (& server) "GET" "/trap" none 0 answered)))
