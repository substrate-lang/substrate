;; Requests through the test client: HEAD, a trap answered with 500, bodies read under a limit, a malformed body, a
;; redirect, the heap after many requests that use their arenas, and a request whose connection ends before its answer.
(require-unqualified events "../../host/events.sub")
(require-unqualified http "../../lib/http/http.sub")
(require-unqualified server "../../lib/http/server.sub")
(require-unqualified test "../../lib/http/test.sub")

(define server http-server)
(define t http-test)
(define step u32 0)
(define zero i32 0)
(define rounds u32 0)
(define heap i32 0)
(define none (slice string) 0)

(define (took [r (ptr http-request)] [body (slice u8)])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "took ")
    (write-digits (& b) (-> body length) 10)
    (http-answer-text! r 200 (buffer-string (& b)))
    (buffer-free! (& b))))

(define (late [r (ptr http-request)])
  (printf "gone: ~a ~a\n" (-> r method) (-> r target))
  (http-answer-text! r 200 "late"))

(define (handle [r (ptr http-request)])
  (let ([path (-> r target)])
    (cond [(== path "/hello") (http-answer-text! r 200 "hello")]
          [(== path "/trap") (http-answer-text! r 200 (if (== (/ 1 zero) 0) "no" "no"))]
          [(== path "/body") (http-read-body! r 16 took)]
          [(== path "/away") (http-redirect! r 303 "/hello")]
          [(== path "/arena")
           (for ([i u32 0]) (< i 100) (+= i 1) (arena-alloc (& (-> r arena)) 1000))
           (http-answer-text! r 200 "used")]
          [(== path "/wait") (set! (-> r on-gone) late)]
          [else (http-answer-text! r 404 "not found")])))

(define (trapped [r (ptr http-request)] [why string])
  (let ([i u32 0])
    (while (and (< i (-> why length)) (!= (@ why i) 10)) (+= i 1))
    (printf "trapped: ~a ~a: ~a\n" (-> r method) (-> r target) (slice why 0 i))))

(define (shown [t (ptr http-test)])
  (printf "~a: ~a ~a\n" step (http-test-status t) (cast string (http-test-body t)))
  (http-test-free! t)
  (next!))

(define (shown-header [t (ptr http-test)])
  (printf "~a: ~a length ~a location ~a\n" step (http-test-status t) (http-test-header t "content-length")
          (http-test-header t "location"))
  (http-test-free! t)
  (next!))

(define (used [t (ptr http-test)])
  (http-test-free! t)
  (+= rounds 1)
  (when (== rounds 10) (set! heap (sbrk 0)))
  (if (< rounds 200)
      (http-test! t (& server) "GET" "/arena" none 0 used)
      (begin
        (printf "~a: the heap grew after ten rounds: ~a\n" step (!= (sbrk 0) heap))
        (next!))))

(define (chunked! [body string] [done (fn ((ptr http-test)))])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "POST /body HTTP/1.1\r\nhost: x\r\ntransfer-encoding: chunked\r\n\r\n")
    (buffer-add-string! (& b) body)
    (http-test-raw! (& t) (& server) (buffer-bytes (& b)) #f done)
    (buffer-free! (& b))))

(define (ignored [tag (ptr void)] [b (slice u8)]) (begin))
(define (ended [tag (ptr void)]) (printf "ended\n"))

(define (next!)
  (+= step 1)
  (case step
    [(1) (http-test! (& t) (& server) "GET" "/hello" none 0 shown)]
    [(2) (http-test! (& t) (& server) "HEAD" "/hello" none 0 shown-header)]
    [(3) (http-test! (& t) (& server) "GET" "/trap" none 0 shown)]
    [(4) (http-test! (& t) (& server) "GET" "/hello" none 0 shown)]
    [(5) (http-test! (& t) (& server) "POST" "/body" none (cast (slice u8) "0123456789") shown)]
    [(6) (http-test! (& t) (& server) "POST" "/body" none (cast (slice u8) "0123456789abcdefg") shown)]
    [(7) (chunked! "8\r\n01234567\r\n8\r\n01234567\r\n8\r\n01234567\r\n0\r\n\r\n" shown)]
    [(8) (chunked! "zz\r\n" shown)]
    [(9) (http-test! (& t) (& server) "GET" "/away" none 0 shown-header)]
    [(10) (http-test! (& t) (& server) "GET" "/arena" none 0 used)]
    [(11)
     (let ([c (http-connect! (& server) ignored ended 0)])
       (http-connection-feed! c (cast (slice u8) "GET /wait HTTP/1.1\r\nhost: x\r\n\r\n"))
       (http-connection-close! c)
       (printf "11: closed\n"))]
    [else (begin)]))

(define (main)
  (set! (-> server handle) handle)
  (set! (-> server on-trap) trapped)
  (next!))
