GET "sec-fetch-site: cross-site": 200
DELETE "sec-fetch-site: same-site": 403
security "": 200
  cross-origin-opener-policy: same-origin
  cross-origin-resource-policy: same-origin
  origin-agent-cluster: ?1
  referrer-policy: no-referrer
  x-content-type-options: nosniff
  x-dns-prefetch-control: off
  x-download-options: noopen
  x-frame-options: SAMEORIGIN
  x-permitted-cross-domain-policies: none
  x-xss-protection: 0
security "x-forwarded-proto: https": 200
  cross-origin-opener-policy: same-origin
  cross-origin-resource-policy: same-origin
  origin-agent-cluster: ?1
  referrer-policy: no-referrer
  strict-transport-security: max-age=31536000; includeSubDomains
  x-content-type-options: nosniff
  x-dns-prefetch-control: off
  x-download-options: noopen
  x-frame-options: SAMEORIGIN
  x-permitted-cross-domain-policies: none
  x-xss-protection: 0
  content-security-policy: default-src 'self'
cors OPTIONS "origin: https://app.example\naccess-control-request-method: PUT\naccess-control-request-headers: x-key": 204
  vary: Origin, Access-Control-Request-Headers
  access-control-allow-origin: https://app.example
  access-control-allow-credentials: true
  access-control-allow-methods: GET,HEAD,PUT,PATCH,POST,DELETE
  access-control-allow-headers: x-key
  access-control-max-age: 600
cors OPTIONS "origin: https://other.example\naccess-control-request-method: PUT": 204
  vary: Origin, Access-Control-Request-Headers
cors GET "origin: https://app.example": 200
  vary: Origin
  access-control-allow-origin: https://app.example
  access-control-allow-credentials: true
  access-control-expose-headers: etag
cors GET "": 200
  vary: Origin
cors PUT "origin: https://app.example\nsec-fetch-site: cross-site": 200
  vary: Origin
  access-control-allow-origin: https://app.example
  access-control-allow-credentials: true
  access-control-expose-headers: etag
cors PUT "origin: https://other.example\nsec-fetch-site: cross-site": 403
  vary: Origin
cors GET "origin: https://other.example": 200
  access-control-allow-origin: *
  access-control-expose-headers: etag
cors GET "": 200
  access-control-allow-origin: *
  access-control-expose-headers: etag
limit 1.1.1.1: 200
limit 1.1.1.1: 200
limit 1.1.1.1: 429, retry after 1
limit 2.2.2.2: 200
limit ::ffff:2.2.2.2: 200
limit ::ffff:202:202: 429, retry after 1
limit 2001:db8:1:2::1: 200
limit 2001:db8:1:ff::9: 200
limit 2001:DB8:1:2:0:0:0:1: 429, retry after 1
limit 2001:db8:1:100::1: 200
limit 1.1.1.1: 200
