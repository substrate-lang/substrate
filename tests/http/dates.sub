;; HTTP dates: the three forms read and written back, two-digit years on both sides of 69, leap days, and dates refused.
(require-unqualified http std/http)

(define (read-date [s string])
  (let ([ms f64 0.0] [b (make-buffer)])
    (if (http-date s (& ms))
        (begin
          (http-add-date! (& b) ms)
          (printf "~s: ~a ~a\n" s (cast i64 ms) (buffer-string (& b))))
        (printf "~s: refused\n" s))
    (buffer-free! (& b))))

(define (main)
  (read-date "Sun, 06 Nov 1994 08:49:37 GMT")
  (read-date "Sunday, 06-Nov-94 08:49:37 GMT")
  (read-date "Sun Nov  6 08:49:37 1994")
  (read-date "Sun Nov 16 08:49:37 1994")
  (read-date "Thu, 01 Jan 1970 00:00:00 GMT")
  (read-date "Monday, 01-Jan-68 00:00:00 GMT")
  (read-date "Wednesday, 01-Jan-69 00:00:00 GMT")
  (read-date "Tue, 29 Feb 2000 12:00:00 GMT")
  (read-date "Thu, 29 Feb 2001 12:00:00 GMT")
  (read-date "Sun, 31 Apr 1994 08:49:37 GMT")
  (read-date "Sun, 06 Nov 1994 08:49:37 UTC")
  (read-date "Sun, 6 Nov 1994 08:49:37 GMT")
  (read-date "Sun, 06 Nov 1994 24:00:00 GMT")
  (read-date "Sun, 06 Nov 1994 08:60:00 GMT")
  (read-date "Xyz, 06 Nov 1994 08:49:37 GMT")
  (read-date "Sun, 06 nov 1994 08:49:37 GMT")
  (read-date "Sunny, 06-Nov-94 08:49:37 GMT")
  (read-date "Sun Nov 6 08:49:37 1994")
  (read-date ""))
