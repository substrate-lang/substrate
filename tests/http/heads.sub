;; A server sent requests, each connection's at once: two behind a slow answer, answered in order; one with no
;; Host, one with two, and a response, refused; an HTTP/1.0 request with no Host, answered and dated; one expecting
;; 100-continue, whose body is sent after the 100; one with 100 headers, answered, and 101, refused; one answered
;; with a stream of unknown length, which closes the connection to end it; a directory named without its slash,
;; redirected; a HEAD request and one answered 204, whose answers have no body, each followed by another request;
;; a slow answer to a client that ended its side after the request; and targets in absolute form, whose host is the
;; Host, and one with user information, refused.
(require-unqualified events "../../host/events.sub")
(require-unqualified stream "../../host/stream.sub")
(require-unqualified fs "../../host/fs.sub")
(require-unqualified net "../../host/node/net.sub")
(require-unqualified timer "../../host/modules/timer.sub")
(require-unqualified http "../../lib/http/http.sub")
(require-unqualified server "../../lib/http/server.sub")
(require-unqualified static "../../lib/http/static.sub")

(struct side [head event-head] [name (ptr u8)] [request (ptr u8)] [after (ptr u8)] [show (ptr u8)] [stream u32]
  [bodiless i32] [finish i32] [parser http-parser] [body buffer] [in (array u8 1024)])

(struct delay [head event-head] [request (ptr http-request)])

(define server http-server)
(define late delay)
(define echoed buffer)
(define sides (array side 15))
(define at u32 0)

(define (answer! [r (ptr http-request)] [text (ptr u8)])
  (http-respond! r 200)
  (http-send-text! r text))

(define (later [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (answer! (-> (cast (ptr delay) tag) request) "slow"))

(define (echo-body [r (ptr http-request)] [bytes (ptr u8)] [n u32]) (buffer-add! (& echoed) bytes n))

(define (echo-end [r (ptr http-request)])
  (buffer-add-byte! (& echoed) 0)
  (answer! r (-> echoed bytes)))

(define (handle [r (ptr http-request)])
  (cond [(== (strcmp (-> r target) "/slow") 0)
         (set! (-> late request) r)
         (timer-after 20.0 (& late))]
        [(== (strcmp (-> r target) "/echo") 0)
         (set! (-> r on-body) echo-body)
         (set! (-> r on-end) echo-end)]
        [(== (strcmp (-> r target) "/stream") 0)
         (http-respond! r 200)
         (http-send-stream! r (fs-open "../events/files/hello.txt" fs-read-mode 0 0) -1)]
        [(== (strcmp (-> r target) "/empty") 0)
         (http-respond! r 204)
         (http-send-text! r "dropped")]
        [(== (strcmp (-> r target) "/host") 0) (answer! r (http-request-header r "host"))]
        [(== (memcmp (-> r target) "/files/" 7) 0) (http-static! r "../events")]
        [else (answer! r (-> r target))]))

(define (side-head [p (ptr http-parser)])
  (let ([s (cast (ptr side) (-> p user))])
    (set! (-> s body length) 0)
    (printf "~a: ~a" (-> s name) (-> p head status))
    (when (-> s bodiless)
      (set! (-> s bodiless) 0)
      (http-parser-no-body! p))
    (when (and (== (-> p head status) 100) (!= (-> s after) 0)) (stream-write-text (-> s stream) (-> s after)))))

(define (side-body [p (ptr http-parser)] [bytes (ptr u8)] [n u32])
  (buffer-add! (& (-> (cast (ptr side) (-> p user)) body)) bytes n))

(define (side-end [p (ptr http-parser)])
  (let ([s (cast (ptr side) (-> p user))])
    (if (== (-> s body length) 0)
        (printf "\n")
        (begin
          (buffer-add-byte! (& (-> s body)) 0)
          (printf " ~a\n" (-> s body bytes))))
    (when (!= (-> s show) 0) (printf "~a: ~a\n" (-> s name) (http-header (& (-> p head)) (-> s show))))))

(define (start! [s (ptr side)])
  (http-parser-init! (& (-> s parser)) (cast (ptr void) s) side-head side-body side-end)
  (set! (-> s body) (make-buffer))
  (net-connect (-> server port) "127.0.0.1" 0 s 0))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([s (cast (ptr side) tag)])
    (cond [(== kind net-connected)
           (set! (-> s stream) id)
           (stream-write-text id (-> s request))
           (when (-> s finish) (stream-finish id))
           (stream-read! id (-> s in) 1024)]
          [(and (== kind stream-read) (> value 0))
           (when (< (http-feed! (& (-> s parser)) (-> s in) (cast u32 value)) 0) (printf "~a: malformed\n" (-> s name)))
           (stream-read! id (-> s in) 1024)]
          [(or (== kind stream-read) (== kind stream-failed))
           (http-parser-closed! (& (-> s parser)))
           (printf "~a: closed\n" (-> s name))
           (stream-close id)
           (+= at 1)
           (if (< at 15) (start! (& (@ sides at))) (http-server-close! (& server)))])))

(define (side! [i u32] [name (ptr u8)] [request (ptr u8)] [after (ptr u8)] [show (ptr u8)])
  (let ([s (& (@ sides i))])
    (set! (-> s head handle) heard)
    (set! (-> s name) name)
    (set! (-> s request) request)
    (set! (-> s after) after)
    (set! (-> s show) show)
    (set! (-> s bodiless) (== (memcmp request "HEAD" 4) 0))))

(define (listening [s (ptr http-server)]) (start! (& (@ sides 0))))

(define (then-last [request (ptr u8)]) -> (ptr u8)
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) request)
    (buffer-add-string! (& b) "GET /fast HTTP/1.1\r\nhost: x\r\nconnection: close\r\n\r\n")
    (buffer-add-byte! (& b) 0)
    (-> b bytes)))

(define (with-headers [n u32]) -> (ptr u8)
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "GET /many HTTP/1.1\r\nhost: x\r\nconnection: close\r\n")
    (for ([i u32 2]) (< i n) (+= i 1) (buffer-add-string! (& b) "x-h: v\r\n"))
    (buffer-add-string! (& b) "\r\n")
    (buffer-add-byte! (& b) 0)
    (-> b bytes)))

(define (main)
  (side! 0 "pipelined" (then-last "GET /slow HTTP/1.1\r\nhost: x\r\n\r\n") 0 0)
  (side! 1 "no host" "GET / HTTP/1.1\r\n\r\n" 0 0)
  (side! 2 "two hosts" "GET / HTTP/1.1\r\nhost: a\r\nhost: b\r\n\r\n" 0 0)
  (side! 3 "response" "HTTP/1.1 200 OK\r\n\r\n" 0 0)
  (side! 4 "old" "GET /old HTTP/1.0\r\n\r\n" 0 "date")
  (side! 5 "continue" "POST /echo HTTP/1.1\r\nhost: x\r\nexpect: 100-continue\r\ncontent-length: 5\r\nconnection: close\r\n\r\n"
         "hello" 0)
  (side! 6 "100 headers" (with-headers 100) 0 0)
  (side! 7 "101 headers" (with-headers 101) 0 0)
  (side! 8 "unknown length" "GET /stream HTTP/1.1\r\nhost: x\r\n\r\n" 0 0)
  (side! 9 "directory" "GET /files/dir?x=1 HTTP/1.1\r\nhost: x\r\nconnection: close\r\n\r\n" 0 "location")
  (side! 10 "head" (then-last "HEAD /files/missing HTTP/1.1\r\nhost: x\r\n\r\n") 0 "content-length")
  (side! 11 "no content" (then-last "GET /empty HTTP/1.1\r\nhost: x\r\n\r\n") 0 0)
  (side! 12 "half-closed" "GET /slow HTTP/1.1\r\nhost: x\r\n\r\n" 0 0)
  (set! (-> (& (@ sides 12)) finish) 1)
  (side! 13 "absolute"
         (then-last "GET http://a.b/host HTTP/1.1\r\nhost: c\r\n\r\nGET http://a.b HTTP/1.1\r\nhost: a.b\r\n\r\n") 0 0)
  (side! 14 "user" "GET http://u@a.b/ HTTP/1.1\r\nhost: a.b\r\n\r\n" 0 0)
  (set! echoed (make-buffer))
  (set! (-> late head handle) later)
  (set! (-> server listening) listening)
  (http-serve! (& server) 0 handle))
