;; Two routes that match the same requests are refused.
(require-unqualified http "../../lib/http/http.sub")
(require-unqualified server "../../lib/http/server.sub")
(require-unqualified route "../../lib/http/route.sub")

(define (f [r (ptr http-request)] [x u16]) (http-finish! r))
(define (g [r (ptr http-request)] [y u16]) (http-finish! r))

(routes app
  [GET ("a" [x u16]) f]
  [GET ("a" [y u16]) g])

(define (main) (begin))
