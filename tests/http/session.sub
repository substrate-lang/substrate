;; Sessions and tokens through the test client: a typed session kept across requests in its cookie, one tampered with,
;; one signed with an older key, one past its age, one cleared, Secure behind a proxy over https; then a new token, its
;; hash, and the bearer token of requests; then sessions made here, one signed with the key, which is read, and one
;; signed with an empty key, which is not, and writing with an empty key, which traps.
(require-unqualified events "../../host/events.sub")
(require-unqualified timer "../../host/modules/timer.sub")
(require-unqualified clock "../../host/modules/clock.sub")
(require-unqualified http "../../lib/http/http.sub")
(require-unqualified server "../../lib/http/server.sub")
(require-unqualified test "../../lib/http/test.sub")
(require-unqualified hmac "../../lib/crypto/hmac.sub")
(require-unqualified base64 "../../lib/encoding/base64.sub")
(require-unqualified json "../../lib/encoding/json.sub")
(require-unqualified session "../../lib/http/session.sub")
(require-unqualified token "../../lib/http/token.sub")

(struct visitor [name string] [visits u32])
(json visitor)
(session visitor)

(define server http-server)
(define t http-test)
(define sessions http-sessions)
(define older http-sessions)
(define blank http-sessions)
(define keys (array string 2))
(define empty (array string 1))
(define cookie buffer)
(define waited event-head)
(define none (slice string) 0)

(define (handle [r (ptr http-request)])
  (let ([path (-> r target)] [v visitor] [b (make-buffer)])
    (http-respond! r 200)
    (cond [(== path "/clear")
           (http-session-clear! (& sessions) r)
           (http-finish! r)]
          [(== path "/bearer") (http-send-text! r (http-request-bearer r))]
          [(or (== path "/read") (== path "/blank"))
           (http-send-text! r (if (visitor.session-read (if (== path "/read") (& sessions) (& blank)) r (& v))
                                  (-> v name)
                                  "refused"))]
          [(== path "/blank-write")
           (set! (-> v name) "blank")
           (set! (-> v visits) 1)
           (visitor.session-write! (& blank) r (& v))]
          [else
           (unless (visitor.session-read (& sessions) r (& v))
             (set! (-> v name) (if (== path "/older") "older" "new"))
             (set! (-> v visits) 0))
           (+= (-> v visits) 1)
           (visitor.session-write! (if (== path "/older") (& older) (& sessions)) r (& v))
           (buffer-add-string! (& b) (-> v name))
           (buffer-add-byte! (& b) 32)
           (write-digits (& b) (-> v visits) 10)
           (http-send-text! r (buffer-string (& b)))])
    (buffer-free! (& b))))

(define (set-cookie) -> string
  (let ([h (& (-> t answer))])
    (for ([i u32 0]) (< i (-> h count)) (+= i 1)
      (when (== (@ (-> h names) i) "set-cookie") (return (@ (-> h values) i))))
    ""))

;; visit! asks for the target with the cookie kept, and keeps the one the answer sets.
(define (visit! [target string] [what string])
  (if (== (-> cookie length) 0)
      (http-test! (& t) (& server) "GET" target none 0)
      (http-test! (& t) (& server) "GET" target (slice (array-of string "cookie" (buffer-string (& cookie)))) 0))
  (printf "~a: ~a\n" what (cast string (http-test-body (& t))))
  (let* ([c (set-cookie)] [i u32 0])
    (while (and (< i (-> c length)) (!= (@ c i) 59)) (+= i 1))
    (set! (-> cookie length) 0)
    (buffer-add-string! (& cookie) (slice c 0 i))))

(define (later [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (visit! "/visit" "eleven seconds later")
  (http-test! (& t) (& server) "GET" "/clear" none 0)
  (printf "cleared: ~a\n" (set-cookie))
  (set! (-> server proxies) 1)
  (http-test! (& t) (& server) "GET" "/visit" (slice (array-of string "x-forwarded-proto" "https")) 0)
  (let* ([c (set-cookie)] [i u32 0])
    (while (and (< i (-> c length)) (!= (@ c i) 59)) (+= i 1))
    (printf "over https:~a\n" (slice c (+ i 1))))
  (tokens))

(define (tokens)
  (let ([b (make-buffer)] [hash (array u8 32)] [other (make-buffer)])
    (http-token-new! (& b) "sub_")
    (http-token-new! (& other) "sub_")
    (http-token-hash! (buffer-string (& b)) (slice hash))
    (printf "token: ~a, ~a characters, another differs: ~a\n" (slice (buffer-string (& b)) 0 4) (-> b length)
            (!= (buffer-string (& b)) (buffer-string (& other))))
    (for ([i u32 0]) (< i 4) (+= i 1)
      (let ([given (@ (array-of string "Bearer abc" "bearer  xyz " "Basic eDp5" "Bearer") i)])
        (http-test! (& t) (& server) "GET" "/bearer" (slice (array-of string "authorization" given)) 0)
        (printf "bearer of ~s: ~s\n" given (cast string (http-test-body (& t))))))
    (forged "/read" "the newer key" "signed here with the key")
    (forged "/blank" "" "signed here with an empty key")
    (http-test-later! (& t) (& server) "GET" "/blank-write" none 0 refused)))

;; forged asks for the target with a session signed here with the secret, and shows what the server read.
(define (forged [target string] [secret string] [what string])
  (let ([b (make-buffer)] [key (array u8 32)] [mac (array u8 32)] [at (array u8 8)]
        [now (cast u64 (/ (clock-now) 1000.0))])
    (for ([i u32 0]) (< i 8) (+= i 1) (set! (@ at i) (cast u8 (>> now (* 8 (- 7 i))))))
    (buffer-add-string! (& b) "session=")
    (base64url-encode! (& b) (cast (slice u8) "{\"name\":\"forged\",\"visits\":5}"))
    (buffer-add-byte! (& b) 46)
    (base64url-encode! (& b) (slice at))
    (hkdf! (cast (slice u8) secret) 0 (cast (slice u8) "substrate session") (slice key))
    (hmac-of (slice key) (slice (+ (-> b bytes) 8) (- (-> b length) 8)) (slice mac))
    (buffer-add-byte! (& b) 46)
    (base64url-encode! (& b) (slice mac))
    (http-test! (& t) (& server) "GET" target (slice (array-of string "cookie" (buffer-string (& b)))) 0)
    (printf "~a: ~a\n" what (cast string (http-test-body (& t))))
    (buffer-free! (& b))))

(define (trapped [r (ptr http-request)] [why string])
  (let ([i u32 0])
    (while (and (< i (-> why length)) (!= (@ why i) 10)) (+= i 1))
    (printf "trapped: ~a\n" (slice why 0 i))))

(define (refused [t (ptr http-test)])
  (printf "~a\n" (http-test-status t))
  (http-test-free! t))

(define (main)
  (set! (@ keys 0) "the newer key")
  (set! (@ keys 1) "the older key")
  (set! (-> sessions keys) (slice keys))
  (set! (-> sessions max-age) 10)
  (set! (-> older keys) (slice (+ keys 1) 1))
  (set! (@ empty 0) "")
  (set! (-> blank keys) (slice empty))
  (set! (-> server handle) handle)
  (set! (-> server on-trap) trapped)
  (set! cookie (make-buffer))
  (visit! "/visit" "first")
  (visit! "/visit" "again")
  (let* ([kept (make-buffer)] [p (+ (-> cookie bytes) (- (-> cookie length) 2))])
    (buffer-add! (& kept) (buffer-bytes (& cookie)))
    (set! (@ p) (if (== (@ p) 65) 66 65))
    (visit! "/visit" "tampered")
    (set! (-> cookie length) 0)
    (buffer-add! (& cookie) (buffer-bytes (& kept))))
  (visit! "/visit" "untampered")
  (set! (-> cookie length) 0)
  (visit! "/older" "signed with the older key")
  (visit! "/visit" "then read")
  (set! (-> waited handle) later)
  (timer-after 11000.0 (& waited)))
