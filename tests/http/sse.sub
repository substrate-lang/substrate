;; Event streams through the test client: events with types, ids and lines, a retry, HEAD, a client that leaves,
;; heartbeats, and an id with a line break, which traps.
(require-unqualified events host/events)
(require-unqualified timer host/modules/timer)
(require-unqualified http std/http)
(require-unqualified server std/http/server)
(require-unqualified test std/http/test)
(require-unqualified sse std/http/sse)

(struct delay [head event-head] [stream (ptr sse-stream)])

(define server http-server)
(define t http-test)
(define none (slice string) 0)
(define all sse-stream)
(define listening sse-stream)
(define quiet sse-stream)
(define bad sse-stream)
(define later delay)

(define (closed [s (ptr sse-stream)])
  (printf "closed: ~a\n" (cond [(== s (& listening)) "/listen"] [(== s (& bad)) "/bad"] [else "?"])))

(define (hushed [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (sse-close! (-> (cast (ptr delay) tag) stream)))

(define (accepted [s (ptr sse-stream)] [r (ptr http-request)]) -> bool
  (set! (-> s on-closed) closed)
  (sse-accept! s r))

(define (handle [r (ptr http-request)])
  (let ([path (-> r target)])
    (cond [(== path "/events")
           (when (accepted (& all) r)
             (sse-retry! (& all) 1000)
             (sse-send! (& all) "" "" "hello")
             (sse-send! (& all) "greeting" "1" "line one\nline two")
             (sse-send! (& all) "" "2" "")
             (sse-send! (& all) "" "" "a\r\nb\rc\n")
             (sse-close! (& all)))]
          [(== path "/listen")
           (accepted (& listening) r)
           (sse-send! (& listening) "" "" "x")]
          [(== path "/quiet")
           (set! (-> quiet beat) 1.0)
           (accepted (& quiet) r)
           (sse-send! (& quiet) "" "" "x")
           (set! (-> later stream) (& quiet))
           (timer-after 30.0 (& later))]
          [(== path "/bad")
           (accepted (& bad) r)
           (sse-send! (& bad) "" "1\n2" "x")]
          [else (http-answer-text! r 404 "not found")])))

(define (trapped [r (ptr http-request)] [why string])
  (let ([i u32 0])
    (while (and (< i (-> why length)) (!= (@ why i) 10)) (+= i 1))
    (printf "trapped: ~a ~a: ~a\n" (-> r method) (-> r target) (slice why 0 i))))

(define (header [name string])
  (let ([value (http-test-header (& t) name)])
    (unless (== (-> value length) 0) (printf "  ~a: ~a\n" name value))))

(define (shown [what string])
  (printf "~a: ~a\n" what (http-test-status (& t)))
  (header "content-type")
  (header "cache-control")
  (header "transfer-encoding")
  (printf "  ~s\n" (cast string (http-test-body (& t)))))

(define (sent [method string] [target string])
  (unless (http-test! (& t) (& server) method target none 0) (printf "no answer yet: "))
  (shown target))

(define (heartbeats [b (slice u8)]) -> u32
  (let ([n u32 0])
    (for ([i u32 1]) (< i (-> b length)) (+= i 1)
      (when (and (== (@ b (- i 1)) 58) (== (@ b i) 10)) (+= n 1)))
    n))

(define (came-quiet [t (ptr http-test)])
  (printf "/quiet: ~a, heartbeats: ~a\n" (http-test-status t) (> (heartbeats (http-test-body t)) 1))
  (http-test-later! t (& server) "GET" "/bad" none 0 came-bad))

(define (came-bad [t (ptr http-test)])
  (shown "/bad")
  (http-test-free! t))

(define (main)
  (set! (-> later head handle) hushed)
  (set! (-> server handle) handle)
  (set! (-> server on-trap) trapped)
  (sent "GET" "/events")
  (sent "HEAD" "/events")
  (sent "GET" "/listen")
  (http-test-free! (& t))
  (http-test-later! (& t) (& server) "GET" "/quiet" none 0 came-quiet))
