;; The event stream parser on a stream with a byte order mark, comments, each kind of line end, fields without a colon
;; or a space, an event without data, an id with NUL, retries good and bad, an unknown field, and an event cut off at
;; the end: whole, split at every byte, and a byte at a time; then a next stream, which keeps the last id.
(require-unqualified http "../../lib/http/http.sub")
(require-unqualified client "../../lib/http/sse-client.sub")

(define p sse-parser)
(define seen buffer)
(define shown bool #t)

(define (text) -> string
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "\xFEFF;: a comment\r\ndata: first\r\n\r\n")
    (buffer-add-string! (& b) "event: named\ndata:no space\ndata:  two spaces\ndata\nid: 7\n\n")
    (buffer-add-string! (& b) "id: 8\n\nid: 9\0\nretry: 12a\nretry: 2500\nunknown: x\n")
    (buffer-add-string! (& b) "data: after\r\rdata: lost")
    (buffer-string (& b))))

(define (heard [p (ptr sse-parser)] [e (ptr sse-event)])
  (when shown (printf "~a ~s ~s\n" (-> e type) (-> e id) (-> e data)))
  (buffer-add-string! (& seen) (-> e type))
  (buffer-add-byte! (& seen) 0)
  (buffer-add-string! (& seen) (-> e id))
  (buffer-add-byte! (& seen) 0)
  (buffer-add-string! (& seen) (-> e data))
  (buffer-add-byte! (& seen) 0))

(define (parsed [pieces (slice (slice u8))]) -> string
  (set! (-> seen length) 0)
  (sse-parser-init! (& p) 0 heard)
  (for ([i u32 0]) (< i (-> pieces length)) (+= i 1) (sse-parse! (& p) (@ pieces i)))
  (sse-parser-end! (& p))
  (let ([b (make-buffer)])
    (buffer-add! (& b) (buffer-bytes (& seen)))
    (buffer-string (& b))))

(define (main)
  (let* ([bytes (cast (slice u8) (text))] [n (-> bytes length)] [whole (parsed (slice (array-of (slice u8) bytes)))]
         [differ u32 0] [ones (cast (ptr (slice u8)) (malloc (* n (sizeof (slice u8)))))])
    (printf "id ~s, retry ~a\n" (buffer-string (& (-> p id))) (-> p retry))
    (sse-parse! (& p) (cast (slice u8) "data: next\n\n"))
    (sse-parser-free! (& p))
    (set! shown #f)
    (for ([k u32 0]) (<= k n) (+= k 1)
      (unless (== (parsed (slice (array-of (slice u8) (slice bytes 0 k) (slice bytes k)))) whole) (+= differ 1))
      (sse-parser-free! (& p)))
    (for ([i u32 0]) (< i n) (+= i 1) (set! (@ ones i) (slice bytes i (+ i 1))))
    (unless (== (parsed (slice ones n)) whole) (+= differ 1))
    (printf "splits that differ: ~a\n" differ)))
