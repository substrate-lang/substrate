;; The form form: a query read into a struct of each kind of field, the values it refuses, and a multipart body's text
;; and files read into another.
(require-unqualified url "../../lib/http/url.sub")
(require-unqualified multipart "../../lib/http/multipart.sub")
(require-unqualified form "../../lib/http/form.sub")

(struct search [q string] [page u32] [limit (ptr u16)] [exact bool] [tags (slice string)] [score f64] [offset i8]
  [ratio f32])
(struct upload [title string] [file http-upload] [extra (ptr http-upload)] [more (slice http-upload)]
  [notes (ptr string)])

(form search upload)

(define a arena)
(define no-parts (slice multipart-part) 0)

(define (searched [query string])
  (let ([s search] [err form-error])
    (if (search.form-read (& a) (url-form-parse (& a) query) no-parts (& s) (& err))
        (begin
          (printf "q ~s page ~a limit ~a exact ~a score ~a offset ~a ratio ~a tags"
                  (-> s q) (-> s page) (if (== (-> s limit) 0) 0 (@ (-> s limit))) (-> s exact) (-> s score)
                  (-> s offset) (-> s ratio))
          (for ([i u32 0]) (< i (-> s tags length)) (+= i 1) (printf " ~s" (@ (-> s tags) i)))
          (printf "\n"))
        (printf "~s: ~a: ~a\n" query (-> err field) (-> err message)))))

(define (part [b (ptr buffer)] [head string] [body string])
  (buffer-add-string! b "--B\r\n")
  (buffer-add-string! b head)
  (buffer-add-string! b "\r\n\r\n")
  (buffer-add-string! b body)
  (buffer-add-string! b "\r\n"))

(define (uploaded [b (ptr buffer)])
  (let ([parts (slice multipart-part)] [why string] [u upload] [err form-error])
    (buffer-add-string! b "--B--\r\n")
    (unless (multipart-parse (& a) (buffer-bytes b) "B" (& parts) (& why)) (printf "refused: ~a\n" why))
    (if (upload.form-read (& a) (url-form-parse (& a) "notes=from+the+query") parts (& u) (& err))
        (begin
          (printf "title ~s file ~s ~s ~s extra ~a notes ~s more"
                  (-> u title) (-> u file filename) (-> u file type) (cast string (-> u file bytes))
                  (if (== (-> u extra) 0) "none" (-> u extra filename)) (@ (-> u notes)))
          (for ([i u32 0]) (< i (-> u more length)) (+= i 1) (printf " ~s" (-> (+ (-> u more items) i) filename)))
          (printf "\n"))
        (printf "~a: ~a\n" (-> err field) (-> err message)))
    (set! (-> b length) 0)))

(define (main)
  (let ([b (make-buffer)])
    (searched "q=hello+world&page=2&tags=a&tags=b%20c&score=1.5&offset=-3&exact=on&ratio=2&limit=70")
    (searched "q=&page=0&score=-2&offset=127&exact=False&ratio=0.25")
    (searched "page=1&score=1&offset=0&ratio=1")
    (searched "q=x&page=abc&score=1&offset=0&ratio=1")
    (searched "q=x&page=4294967296&score=1&offset=0&ratio=1")
    (searched "q=x&page=1&limit=70000&score=1&offset=0&ratio=1")
    (searched "q=x&page=1&score=1&offset=-129&ratio=1")
    (searched "q=x&page=1&score=1e3&offset=1&ratio=x")
    (searched "q=x&page=1&score=1&offset=1&ratio=1&exact=maybe")
    (part (& b) "Content-Disposition: form-data; name=\"title\"" "A title")
    (part (& b) "Content-Disposition: form-data; name=\"file\"; filename=\"a.txt\"\r\nContent-Type: text/plain" "aaa")
    (part (& b) "Content-Disposition: form-data; name=\"more\"; filename=\"b.png\"" "bb")
    (part (& b) "Content-Disposition: form-data; name=\"more\"; filename=\"c.png\"" "cc")
    (uploaded (& b))
    (part (& b) "Content-Disposition: form-data; name=\"title\"" "No file")
    (part (& b) "Content-Disposition: form-data; name=\"file\"" "not a file")
    (uploaded (& b))
    (buffer-free! (& b))
    (arena-free (& a))))
