;; A client that sends 32 requests at once for a 1 MiB answer and reads nothing for a while: the server stops
;; answering until the client reads, then every answer comes.
(require-unqualified events "../../host/events.sub")
(require-unqualified stream "../../host/stream.sub")
(require-unqualified net "../../host/node/net.sub")
(require-unqualified timer "../../host/modules/timer.sub")
(require-unqualified http "../../lib/http/http.sub")
(require-unqualified server "../../lib/http/server.sub")

(const sent u32 32)
(const size u32 1048576)

(define server http-server)
(define client event-head)
(define parser http-parser)
(define big (ptr u8) 0)
(define in (array u8 65536))
(define stream u32 0)
(define handled u32 0)
(define answers u32 0)
(define bytes i64 0)

(define (handle [r (ptr http-request)])
  (+= handled 1)
  (http-respond! r 200)
  (http-send! r big size))

(define (no-head [p (ptr http-parser)]) (begin))
(define (body [p (ptr http-parser)] [b (ptr u8)] [n u32]) (+= bytes (cast i64 n)))
(define (answer [p (ptr http-parser)]) (+= answers 1))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (cond [(== source timer-source)
         (printf "answered while nothing was read: ~a\n" (if (< handled sent) "some" "all"))
         (stream-read! stream in 65536)]
        [(== kind net-connected)
         (set! stream id)
         (let ([b (make-buffer)])
           (for ([i u32 0]) (< i sent) (+= i 1) (buffer-add-string! (& b) "GET / HTTP/1.1\r\nhost: x\r\n\r\n"))
           (stream-write id (-> b bytes) (-> b length))
           (buffer-free! (& b)))
         (timer-after 500.0 (& client))]
        [(and (== kind stream-read) (> value 0))
         (http-feed! (& parser) in (cast u32 value))
         (if (< answers sent)
             (stream-read! id in 65536)
             (begin
               (printf "read: ~a answers, ~a bytes\n" answers bytes)
               (stream-close id)
               (http-server-close! (& server))))]))

(define (listening [s (ptr http-server)]) (net-connect (-> s port) "127.0.0.1" 0 (& client) 0))

(define (main)
  (set! big (cast (ptr u8) (calloc 1 size)))
  (set! (-> client handle) heard)
  (http-parser-init! (& parser) 0 no-head body answer)
  (set! (-> server listening) listening)
  (http-serve! (& server) 0 handle))
