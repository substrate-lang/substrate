;; malloc, calloc and realloc and their try- forms: blocks placed, used again, joined and resized, and blocks of random
;; sizes.

(define slots (array (ptr u8) 1000))
(define sizes (array u32 1000))
(define seed u32 12345)

(define (random [n u32]) -> u32
  (set! seed (+ (* seed 1103515245) 12345))
  (% (>> seed 8) n))

(define (fill! [i u32]) (memset (@ slots i) (cast i32 (+ i 1)) (@ sizes i)))

(define (holds? [i u32] [n u32]) -> bool
  (let ([p (@ slots i)] [v (bit-and (+ i 1) 255)])
    (for ([k u32 0]) (< k n) (+= k 1)
      (when (!= (@ p k) v) (return #f)))
    #t))

(define (heap) -> u32 (cast u32 (sbrk 0)))

(define start u32 0)

(define (main)
  (set! start (heap))
  (let ([aligned #t])
    (for ([i u32 0]) (< i 200) (+= i 1)
      (set! (@ slots i) (cast (ptr u8) (malloc i)))
      (when (!= (% (cast u32 (@ slots i)) 16) 0) (set! aligned #f)))
    (for ([i u32 0]) (< i 200) (+= i 1) (free (@ slots i)) (set! (@ slots i) 0))
    (printf "at multiples of 16: ~a\n" aligned))
  (let* ([p (malloc 100)] [q (begin (free p) (malloc 100))])
    (printf "a freed block is used again: ~a\n" (== p q))
    (free q))
  (let* ([a (malloc 5000)] [b (malloc 5000)] [c (malloc 5000)] [last (malloc 5000)])
    (free a)
    (free c)
    (free b)
    (let ([p (malloc 15000)])
      (printf "free neighbours join: ~a\n" (== p a))
      (free p))
    (free last))
  (let* ([p (malloc 4000)] [q (realloc p 100)])
    (printf "realloc in place when it shrinks: ~a\n" (== p q))
    (free q))
  (let* ([p (malloc 5000)] [after (malloc 5000)] [last (malloc 5000)] [q (begin (free after) (realloc p 9000))])
    (printf "realloc in place into the free block after it: ~a\n" (== p q))
    (free q)
    (free last))
  (let* ([p (malloc 1000000)] [q (realloc p 3000000)])
    (printf "realloc in place at the heap's end: ~a\n" (== p q))
    (free q))
  (let* ([p (cast (ptr u8) (malloc 1000))] [q (begin (memset p 255 1000) (free p) (cast (ptr u8) (calloc 100 10)))]
         [zeros #t])
    (for ([k u32 0]) (< k 1000) (+= k 1) (when (!= (@ q k) 0) (set! zeros #f)))
    (printf "calloc's bytes are zeros: ~a, in the freed block: ~a\n" zeros (== p q))
    (free q))
  (printf "try-calloc refuses more than 4 GB: ~a\n" (== (try-calloc 65536 65537) 0))
  (printf "try-malloc refuses 4 GB: ~a\n" (== (try-malloc 4294967295) 0))
  (let* ([p (cast (ptr u8) (malloc 100))] [q (begin (memset p 7 100) (try-realloc p 4294967295))])
    (printf "try-realloc refuses 4 GB and keeps the block: ~a\n" (and (== q 0) (== (@ p 99) 7)))
    (free p))
  (let ([kept #t] [end u32 0])
    (for ([round u32 0]) (< round 50000) (+= round 1)
      (let* ([i (random 1000)] [n (if (== (random 20) 0) (random 100000) (random 2000))])
        (cond [(== (@ slots i) 0)
               (set! (@ slots i) (cast (ptr u8) (malloc n)))
               (set! (@ sizes i) n)
               (fill! i)]
              [(== (random 2) 0)
               (unless (holds? i (@ sizes i)) (set! kept #f))
               (free (@ slots i))
               (set! (@ slots i) 0)]
              [else
               (set! (@ slots i) (cast (ptr u8) (realloc (@ slots i) n)))
               (unless (holds? i (if (< n (@ sizes i)) n (@ sizes i))) (set! kept #f))
               (set! (@ sizes i) n)
               (fill! i)])))
    (for ([i u32 0]) (< i 1000) (+= i 1)
      (when (!= (@ slots i) 0)
        (unless (holds? i (@ sizes i)) (set! kept #f))
        (free (@ slots i))
        (set! (@ slots i) 0)))
    (printf "random blocks keep their bytes: ~a\n" kept)
    (set! end (heap))
    (let ([p (malloc (- (- end start) 65536))])
      (printf "freed, they join into one: ~a\n" (and (!= p 0) (== (heap) end)))
      (free p)))
  (let ([before u32 0])
    (for ([round u32 0]) (< round 100) (+= round 1)
      (when (== round 1) (set! before (heap)))
      (for ([i u32 0]) (< i 100) (+= i 1) (set! (@ slots i) (cast (ptr u8) (malloc (+ 3000 (* round 16))))))
      (for ([i u32 0]) (< i 100) (+= i 1) (free (@ slots i)) (set! (@ slots i) 0)))
    (printf "blocks of new sizes, taken and freed in turn, keep the heap's size: ~a\n" (== (heap) before))))

