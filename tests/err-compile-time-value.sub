;; raise-syntax-error from a macro, blamed on the offending identifier.
(begin-for-syntax (require-unqualified macros "../compiler/macros.sub"))
(define-syntax point '(x y))
(begin-for-syntax
  (define (field-index [stx datum]) -> datum
    (let* ([parts (syntax->list stx)] [fields (syntax-local-value (cadr parts))] [field (syntax-e (caddr parts))] [i 0])
      (while (not (and (pair? fields) (== (car fields) field)))
        (when (null? fields) (raise-syntax-error 0 "no such field" (caddr parts)))
        (set! fields (cdr fields))
        (+= i 1))
      (datum->syntax stx (fixnum i) stx))))
(define-syntax field-index field-index)

(define (main) (field-index point z))
