;; Log entries as text and JSON at the fake clock's time: each kind of value, quoting and escaping, bytes that are not
;; UTF-8, entries below the level, and a message alone.
(require-unqualified log "../../lib/log/log.sub")

(define text logger)
(define json logger)

(define (entry [l (ptr logger)] [level i32])
  (let ([e log-entry])
    (when (log-begin! (& e) l level "a request")
      (log-string! (& e) "method" "GET")
      (log-string! (& e) "agent" "curl/8.0 (x)")
      (log-string! (& e) "target" "/a\nb=\"c\"")
      (log-string! (& e) "empty" "")
      (log-string! (& e) "name" (cast string (slice (array-of u8 99 97 102 195 169 255) 6)))
      (log-int! (& e) "status" 200)
      (log-int! (& e) "offset" -5)
      (log-float! (& e) "ms" 1.25)
      (log-float! (& e) "none" (/ 0.0 0.0))
      (log-bool! (& e) "cached" #t)
      (log-string! (& e) "odd key" "x"))
    (log-end! (& e))))

(define (main)
  (set! (-> text fd) 1)
  (set! (-> json fd) 1)
  (set! (-> json json) #t)
  (entry (& text) log-info)
  (entry (& json) log-warn)
  (entry (& text) log-debug)
  (set! (-> text level) log-debug)
  (entry (& text) log-debug)
  (set! (-> json level) log-error)
  (entry (& json) log-warn)
  (log! (& json) log-error "stopped"))
