(test err-cycle (expect-compile-error "fail/err-cycle.sub" "error: cyclic require"))
(test err-datum-loc (expect-compile-error "fail/err-datum-loc.sub" "err-datum-loc.sub:8:16: error: unbound identifier no-such-thing"))
