(test err-number-range (expect-compile-error "fail/err-number-range.sub" "err-number-range.sub:2:15: error: read: the integer 18446744073709551616 does not fit in 64 bits"))
(test err-open-application (expect-compile-error "fail/err-open-application.sub" "err-open-application.sub:2:30: error: expected a function, got i32"))
(test err-phase (expect-compile-error "fail/err-phase.sub" "err-phase.sub:3:17: error: unbound identifier helper"))
