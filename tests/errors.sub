(test err-throw-not-tag (expect-compile-error "fail/err-throw-not-tag.sub" "err-throw-not-tag.sub:2:23: error: main is not an exception"))
(test err-transformer (expect-compile-error "fail/err-transformer.sub" "err-transformer.sub:3:18: error: a transformer takes one i32 (syntax) and returns one i32"))
(test err-try-clause (expect-compile-error "fail/err-try-clause.sub" "err-try-clause.sub:2:16: error: expected (try body ... [catch E (x ...) h ...] ... [catch-all h ...])"))
(test err-try-order (expect-compile-error "fail/err-try-order.sub" "err-try-order.sub:4:23: error: wasm:try: expected (try (clause ...) body ...)"))
(test err-type (expect-compile-error "fail/err-type.sub" "error: expected i64, got i32"))
(test err-unbound (expect-compile-error "fail/err-unbound.sub" "err-unbound.sub:1:16: error: unbound identifier nope"))
