;; The host's paths by POSIX's rules and by Windows's: roots, absolute paths, normal paths, paths resolved from a
;; directory, parents and bases, paths under a directory, the same path, relative paths, and native paths.
(require-unqualified std/test/test)
(require-unqualified compiler/path)

(test posix-roots
  (expect-equal (path-root #f "/a/b") "/")
  (expect-equal (path-root #f "a/b") "")
  (expect (path-absolute? #f "/a"))
  (expect (not (path-absolute? #f "a")))
  (expect (not (path-absolute? #f "C:/a"))))

(test windows-roots
  (expect-equal (path-root #t "C:\\a") "C:/")
  (expect-equal (path-root #t "c:/a") "c:/")
  (expect-equal (path-root #t "C:a") "C:")
  (expect-equal (path-root #t "\\\\server\\share\\x") "//server/share")
  (expect-equal (path-root #t "//server/share") "//server/share")
  (expect-equal (path-root #t "\\\\?\\C:\\x") "//?/C:")
  (expect-equal (path-root #t "\\x") "/")
  (expect (path-absolute? #t "C:\\a"))
  (expect (path-absolute? #t "\\\\server\\share"))
  (expect (path-absolute? #t "/a"))
  (expect (not (path-absolute? #t "C:a")))
  (expect (not (path-absolute? #t "a\\b"))))

(test normal
  (expect-equal (path-normal #f "/a/./b/../c//d/") "/a/c/d")
  (expect-equal (path-normal #f "/../a") "/a")
  (expect-equal (path-normal #f "a/../../b") "../b")
  (expect-equal (path-normal #f "a/..") "")
  (expect-equal (path-normal #f "/") "/")
  (expect-equal (path-normal #f "a\\b") "a\\b")
  (expect-equal (path-normal #t "C:\\a\\.\\b\\..\\c") "C:/a/c")
  (expect-equal (path-normal #t "C:\\..\\a") "C:/a")
  (expect-equal (path-normal #t "c:/A/b/") "c:/A/b")
  (expect-equal (path-normal #t "C:a\\..\\..\\b") "C:../b")
  (expect-equal (path-normal #t "\\\\server\\share\\x\\..\\y") "//server/share/y")
  (expect-equal (path-normal #t "\\\\server\\share\\..") "//server/share")
  (expect-equal (path-normal #t "\\\\?\\C:\\long\\x") "//?/C:/long/x")
  (expect-equal (path-normal #t "a\\b/c") "a/b/c"))

(test resolved
  (expect-equal (path-resolved #f "/home/me" "a/../b") "/home/me/b")
  (expect-equal (path-resolved #f "/home/me" "/etc/x") "/etc/x")
  (expect-equal (path-resolved #t "C:\\Users\\me" "src\\main.sub") "C:/Users/me/src/main.sub")
  (expect-equal (path-resolved #t "C:\\Users\\me" "D:\\x") "D:/x")
  (expect-equal (path-resolved #t "C:\\Users\\me" "\\x") "C:/x")
  (expect-equal (path-resolved #t "\\\\server\\share\\me" "\\x") "//server/share/x")
  (expect-equal (path-resolved #t "C:\\Users\\me" "C:x") "C:/Users/me/x")
  (expect-equal (path-resolved #t "C:\\Users\\me" "d:x") "d:/x"))

(test parent-and-base
  (expect-equal (path-parent #f "/a/b") "/a")
  (expect-equal (path-parent #f "/a") "/")
  (expect-equal (path-parent #f "/") "/")
  (expect-equal (path-parent #t "C:/a/b") "C:/a")
  (expect-equal (path-parent #t "C:\\a") "C:/")
  (expect-equal (path-parent #t "C:/") "C:/")
  (expect-equal (path-parent #t "//server/share/x") "//server/share")
  (expect-equal (path-parent #t "//server/share") "//server/share")
  (expect-equal (path-base #f "/a/b.sub") "b.sub")
  (expect-equal (path-base #t "C:\\a\\b.sub") "b.sub")
  (expect-equal (path-base #t "C:/") ""))

(test within-and-same
  (expect (path-within? #f "/a/b" "/a"))
  (expect (path-within? #f "/a" "/"))
  (expect (not (path-within? #f "/ab" "/a")))
  (expect (not (path-within? #f "/A/b" "/a")))
  (expect (path-within? #t "C:/a/b" "c:/A"))
  (expect (path-within? #t "C:/a" "C:/"))
  (expect (path-within? #t "C:\\a\\b" "C:/a"))
  (expect (not (path-within? #t "C:/ab" "C:/a")))
  (expect (path-same? #t "C:/Users/Me" "c:\\users\\me"))
  (expect (not (path-same? #f "/a/B" "/a/b"))))

(test relative
  (expect-equal (path-relative #f "/a/b" "/a/b/c/d.sub") "c/d.sub")
  (expect-equal (path-relative #f "/a/b" "/a/x/y") "../x/y")
  (expect-equal (path-relative #f "/a/b/c" "/a/x") "../../x")
  (expect-equal (path-relative #f "/a" "/a") "")
  (expect-equal (path-relative #t "C:/Users/me" "c:/users/me/src/a.sub") "src/a.sub")
  (expect-equal (path-relative #t "C:/a" "D:/b") "D:/b")
  (expect-equal (path-relative #t "//srv/share/a" "//srv/share/b/c") "../b/c"))

(test native
  (expect-equal (path-native #t "C:/a/b c") "C:\\a\\b c")
  (expect-equal (path-native #t "//srv/share/x") "\\\\srv\\share\\x")
  (expect-equal (path-native #f "/a/b") "/a/b"))
