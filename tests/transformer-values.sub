;; Transformers are values: make-transformer pairs code with an environment.

(require-unqualified std/test/test)
(begin-for-syntax
  (require-unqualified compiler/macros)

  (define (constant [env datum] [stx datum]) -> datum (datum->syntax stx env stx))

  (define (constant-macro [n datum]) -> datum (make-transformer (cast u32 constant) n)))

(define-syntax forty-two (constant-macro '42))
(define-syntax seven (constant-macro '7))
(define-syntax not-a-macro '(1 2))

(begin-for-syntax
  (define (macro? [stx datum]) -> datum
    (let ([id (cadr (syntax->list stx))])
      (datum->syntax stx
                     (fixnum (if (== (identifier-binding-kind id) 'macro) (!= (syntax-local-value id) 0) 0))
                     stx))))
(define-syntax macro? macro?)

(define (main)
  (printf "~a\n" forty-two)
  (printf "~a\n" (seven))
  (printf "~a\n" (macro? seven))
  (printf "~a\n" (macro? not-a-macro)))

(test transformer-values (expect-output-file "transformer-values.out" (main)))
