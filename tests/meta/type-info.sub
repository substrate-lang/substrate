;; type-info: structs, unions and variants as data at compile time, typedefs followed, and 0 for anything else.
(struct point [x i32] [y f64] [name string] [tags (slice u8)] [near (ptr point)] [grid (array u16 3)] [z size])
(union number [i i64] [f f64])
(variant shape [none] [circle [r f64]] [poly [points (slice point)] [closed bool]])
(typedef size u32)
(typedef spot point)
(struct tree [value i64] [kids (slice tree)])
(struct #:forall (T) pair [a T] [b T])
(struct odd [p (pair i32)] [f (fn (i32) -> i32)] [s spot])
(define (f [x i32]) -> i32 x)

(begin-for-syntax
  (require-unqualified macros compiler/macros)
  (require-unqualified meta std/meta/type-info)
  (define (show-form [s datum]) -> datum
    (syntax-match s
      [(_ t) (datum->syntax s `(printf "~a\n" ,(format "~s" (cons (syntax->datum (datum->syntax s (type-info t) s)) nil))) s)])))

(define-syntax show show-form)

(define (main)
  (show point)
  (show number)
  (show shape)
  (show spot)
  (show tree)
  (show pair)
  (show odd)
  (show size)
  (show f)
  (show i32))
