(require wasm compiler/wasm)
(require lib "fixtures/apply.sub" apply-to)
(require ptr "fixtures/pointers.sub" triple triple-here)
(wasm:table 1)
(define (twice [x i32]) -> i32 (* 2 x))
(define (main)
  (let ([f (fn (i32) -> i32) (ptr:triple-here)])
    (printf "~a ~a ~a ~a~n"
            (lib:apply-to twice 21)
            (f 7)
            (wasm:call-indirect (i32 -> i32) (wasm:func-index twice) 5)
            (wasm:call-indirect (i32 -> i32) (wasm:func-index ptr:triple) 3))))
