;; define-syntax of a value that is not a transformer, read with syntax-local-value.

(begin-for-syntax (require-unqualified macros compiler/macros))

(define-syntax point '(x y))
(define-syntax color '(red green blue alpha))

(begin-for-syntax
  (define (field-count [stx datum]) -> datum
    (let* ([name (cadr (syntax->list stx))] [fields (syntax-local-value name)])
      (unless (pair? fields) (raise-syntax-error 0 "has no field information" name))
      (datum->syntax stx (fixnum (length fields)) stx))))
(define-syntax field-count field-count)

(begin-for-syntax
  (define (field-index [stx datum]) -> datum
    (let* ([parts (syntax->list stx)] [fields (syntax-local-value (cadr parts))] [field (syntax-e (caddr parts))] [i 0])
      (while (not (and (pair? fields) (== (car fields) field)))
        (when (null? fields) (raise-syntax-error 0 "no such field" (caddr parts)))
        (set! fields (cdr fields))
        (+= i 1))
      (datum->syntax stx (fixnum i) stx))))
(define-syntax field-index field-index)

(define (main)
  (printf "~a\n" (field-count point))
  (printf "~a\n" (field-count color))
  (printf "~a\n" (field-index color blue)))
