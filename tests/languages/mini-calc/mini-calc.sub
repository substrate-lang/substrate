;; mini-calc, a language for tests: Substrate, and def, which defines an i32 or a function of i32s.
(language substrate compiler/substrate)

(provide (all-from-out substrate) def)

(begin-for-syntax
  (require-unqualified compiler/macros)

  (define (def-form [s datum]) -> datum
    (syntax-match s
      [(_ ((? identifier? name) (? identifier? param) ...) body)
       #`(define (#,name #,@(map (lambda ([p datum]) -> datum #`[#,p i32]) param)) -> i32 #,body)]
      [(_ (? identifier? name) value) #`(define #,name i32 #,value)])))

(define-syntax def def-form)

;; doc-forms tells sub doc which of mini-calc's forms define what (std/doc/doc.sub).
(define-syntax doc-forms
  (quote-syntax
   ((function (def (NAME PARAM ...) _))
    (value (def NAME _))
    (requires (require PREFIX MODULE _ ...))
    (requires (require-unqualified PREFIX MODULE))
    (requires (require-unqualified MODULE))
    (exports (provide EXPORT ...)))))
