;; The valley without a browser: the land, meshes facing out, walking, the deer, the fish.
(require-unqualified format "../../lib/web/game/format.sub")
(require-unqualified input "../../lib/web/game/input.sub")
(require-unqualified vector "../../lib/web/game/vector.sub")
(require-unqualified store "../../lib/web/game/store.sub")
(require-unqualified terrain "../../lib/web/game/terrain.sub")
(require-unqualified space "../../lib/web/game/space.sub")
(require-unqualified movers "../../lib/web/game/movers.sub")
(require-unqualified props "../../lib/web/game/props.sub")
(require-unqualified math "../../lib/web/scene/math.sub")
(require-unqualified light "../../lib/web/scene/light.sub")
(require-unqualified models "../../lib/web/scene/models.sub")
(require-unqualified gpu "../../lib/web/gpu.sub")
(require-unqualified world "../../lib/web/examples/valley/world.sub")

(define game world)
(define keys input)

(define (step)
  (world-step! (& game) (& keys))
  (input-end-step! (& keys)))

(define (steps [n u32]) (for ([i u32 0]) (< i n) (+= i 1) (step)))

(define (where)
  (print-format "  the player is at ~.2f ~.2f ~.2f~s, looking ~.2f ~.2f\n"
                (-> game player x) (-> game player y) (-> game player z)
                (if (-> game player on-ground) ", standing" ", in the air")
                (-> game yaw) (-> game pitch)))

(define (gpu-commands-written [what string])
  (let ([b (gpu-commands)])
    (print-format "  ~s: ~d bytes of GPU commands\n" what (-> b length))
    (gpu-commands-done!)))

(define (river [z f64]) -> f64 (+ 128.0 (* 28.0 (sin (/ z 45.0))) (* 10.0 (sin (+ (/ z 17.0) 1.0)))))

;; Cards are left out: materials 7, 8 and 13, the leaves, the blades and the face.
(define (facing-check [what string] [vertices (ptr buffer)] [indices (ptr buffer)])
  (let ([wrong u32 0] [checked u32 0] [n (/ (-> indices length) 12)] [ix (cast (ptr u32) (-> indices bytes))])
    (for ([t u32 0]) (< t n) (+= t 1)
      (let* ([a (cast (ptr f32) (+ (-> vertices bytes) (* (@ ix (* t 3)) 44)))]
             [b (cast (ptr f32) (+ (-> vertices bytes) (* (@ ix (+ (* t 3) 1)) 44)))]
             [c (cast (ptr f32) (+ (-> vertices bytes) (* (@ ix (+ (* t 3) 2)) 44)))]
             [material (@ a 9)])
        (unless (or (== material 7.0) (== material 8.0) (== material 13.0))
          (let* ([ux (- (@ b 0) (@ a 0))] [uy (- (@ b 1) (@ a 1))] [uz (- (@ b 2) (@ a 2))]
                 [vx (- (@ c 0) (@ a 0))] [vy (- (@ c 1) (@ a 1))] [vz (- (@ c 2) (@ a 2))]
                 [nx (- (* uy vz) (* uz vy))] [ny (- (* uz vx) (* ux vz))] [nz (- (* ux vy) (* uy vx))]
                 [mx (+ (@ a 3) (@ b 3) (@ c 3))] [my (+ (@ a 4) (@ b 4) (@ c 4))] [mz (+ (@ a 5) (@ b 5) (@ c 5))]
                 [agree (+ (* nx mx) (* ny my) (* nz mz))])
            (+= checked 1)
            (when (< agree 0.0) (+= wrong 1))))))
    (print-format "  ~s: ~d triangles checked, ~d wound against their normals\n" what checked wrong)))

(define (facing-checks)
  (printf "the meshes face outwards:\n")
  (facing-check "the land" (& (-> game ground vertices)) (& (-> game ground indices)))
  (facing-check "the bridge" (& (-> game bridge vertices)) (& (-> game bridge indices)))
  (facing-check "the jetty" (& (-> game jetty vertices)) (& (-> game jetty indices)))
  (facing-check "the hut" (& (-> game hut vertices)) (& (-> game hut indices)))
  (facing-check "a fir" (& (-> game fir vertices)) (& (-> game fir indices)))
  (facing-check "an oak" (& (-> game oak vertices)) (& (-> game oak indices)))
  (facing-check "a birch" (& (-> game birch vertices)) (& (-> game birch indices)))
  (facing-check "a boulder" (& (-> game rock vertices)) (& (-> game rock indices)))
  (facing-check "a standing stone" (& (-> game stone vertices)) (& (-> game stone indices)))
  (facing-check "a deer's body" (& (-> game deer-body-piece vertices)) (& (-> game deer-body-piece indices)))
  (facing-check "a deer's neck" (& (-> game deer-neck-piece vertices)) (& (-> game deer-neck-piece indices)))
  (facing-check "a deer's head" (& (-> game deer-head-piece vertices)) (& (-> game deer-head-piece indices)))
  (facing-check "a deer's leg" (& (-> game deer-upper-leg-piece vertices)) (& (-> game deer-upper-leg-piece indices)))
  (facing-check "the character's head" (& (-> game hero-head-piece vertices)) (& (-> game hero-head-piece indices)))
  (facing-check "the character's torso" (& (-> game hero-torso-piece vertices)) (& (-> game hero-torso-piece indices)))
  (facing-check "the character's shin" (& (-> game hero-shin-piece vertices)) (& (-> game hero-shin-piece indices)))
  (facing-check "a bird's body" (& (-> game bird-body-piece vertices)) (& (-> game bird-body-piece indices))))

(define (shoal-report)
  (let ([sum-depth 0.0] [sum-home 0.0] [sum-player 0.0] [n 0.0])
    (store-each ([f (& (-> game fish))])
      (+= sum-depth (-> f body in-water))
      (+= sum-home (mover-distance (& (-> f body)) shoal-x shoal-z))
      (+= sum-player (mover-distance (& (-> f body)) (-> game player x) (-> game player z)))
      (+= n 1.0))
    (print-format "  the shoal: ~.0f fish, ~.2f below the surface, ~.1f from home and ~.1f from the player on average\n"
                  n (/ sum-depth n) (/ sum-home n) (/ sum-player n))))

(define (camera-report)
  (print-format "  the camera is at ~.2f ~.2f ~.2f, the character at ~.2f ~.2f ~.2f facing ~.2f\n"
                (-> game camera-x) (-> game camera-y) (-> game camera-z)
                (-> game player x) (-> game player y) (-> game player z) (-> game facing)))

(define (herd-report)
  (let ([grazing 0] [wandering 0] [alert 0] [fleeing 0] [sum 0.0] [n 0.0])
    (store-each ([d (& (-> game deer))])
      (cond [(== (-> d mind) deer-grazing) (+= grazing 1)] [(== (-> d mind) deer-wandering) (+= wandering 1)]
            [(== (-> d mind) deer-alert) (+= alert 1)] [else (+= fleeing 1)])
      (+= sum (mover-distance (& (-> d body)) (-> game player x) (-> game player z)))
      (+= n 1.0))
    (print-format "  the herd: ~d grazing, ~d wandering, ~d alert, ~d fleeing; ~.1f from the player on average\n"
                  grazing wandering alert fleeing (/ sum n))))

(define (main)
  (world-init! (& game))
  (printf "the land:\n")
  (print-format "  ~d units across; the river bed at (150, 24) is ~.1f high, the valley floor at (128, 24) ~.1f, a hill at (60, 120) ~.1f, the mountains at (6, 200) ~.1f, the lake bed at (144, 128) ~.1f, the knoll at the stones ~.1f; the water is at ~.1f\n"
                world-size (land-height 150.0 24.0) (land-height 128.0 24.0) (land-height 60.0 120.0) (land-height 6.0 200.0)
                (land-height 144.0 128.0) (land-height stones-x stones-z) water-level)
  (print-format "  the same from the height map: ~.1f, ~.1f\n" (terrain-height (& (-> game land)) 150.0 24.0) (terrain-height (& (-> game land)) 60.0 120.0))
  (print-format "  the path passes (~.1f, 30): ~s; (100, 30) is ~s\n" (+ (river 30.0) 12.0)
                (if (on-path? (+ (river 30.0) 12.0) 30.0) "on it" "off it") (if (on-path? 100.0 30.0) "on it" "off it"))
  (print-format "  ~d props, most of them the meadow around the player; ~d things in the space; ~d deer; the hut is at ~.1f ~.1f\n"
                (props-count (& (-> game things))) (space-count (& (-> game space))) (store-count (& (-> game deer))) hut-x hut-z)
  (print-format "  the land's mesh: ~d vertices, ~d triangles\n" (/ (-> game ground vertices length) 44) (/ (-> game ground indices length) 12))
  (print-format "  the day: at the start it is ~.2f of the way through, ~s; the sun is at ~.2f ~.2f ~.2f, ~x; four minutes on, ~.2f, ~s\n"
                (time-of-day 0.0) (day-name (time-of-day 0.0)) (-> game light sun-x) (-> game light sun-y) (-> game light sun-z) (-> game light sun)
                (time-of-day 240.0) (day-name (time-of-day 240.0)))
  (where)
  (facing-checks)
  (gpu-commands-written "setting up")
  (world-draw (& game))
  (gpu-commands-written "the first frame")

  (printf "the view: behind the character, 4.5 back along the way the player looks (+z), 1.5 up:\n")
  (camera-report)
  (printf "walking sideways, with D, for half a second: the character turns to face the way it goes, -x:\n")
  (input-key-down! (& keys) #\d)
  (steps 30)
  (input-key-up! (& keys) #\d)
  (camera-report)
  (printf "walking forward for a second: the legs stride and the knees bend, the arms swing against them:\n")
  (input-key-down! (& keys) #\w)
  (steps 60)
  (let ([f (& (-> game hero))])
    (print-format "  the left thigh ~.2f, its shin ~.2f; the right thigh ~.2f, its shin ~.2f; the left arm ~.2f, its forearm ~.2f; the body ~.3f above its feet\n"
                  (-> (figure-joint f hero-leg-l) pitch) (-> (figure-joint f hero-shin-l) pitch)
                  (-> (figure-joint f hero-leg-r) pitch) (-> (figure-joint f hero-shin-r) pitch)
                  (-> (figure-joint f hero-arm-l) pitch) (-> (figure-joint f hero-forearm-l) pitch)
                  (- (-> f y) (-> game player y))))
  (input-key-up! (& keys) #\w)
  (steps 30)
  (let ([f (& (-> game hero))])
    (print-format "  standing: the left thigh ~.2f, the right ~.2f\n" (-> (figure-joint f hero-leg-l) pitch) (-> (figure-joint f hero-leg-r) pitch)))
  (printf "V: through the character's eyes, 1.7 up:\n")
  (input-key-down! (& keys) #\v)
  (step)
  (input-key-up! (& keys) #\v)
  (camera-report)
  (input-key-down! (& keys) #\v)
  (step)
  (input-key-up! (& keys) #\v)
  (world-look! (+ (river 34.0) 12.0) 34.0 0.0 0.0)
  (printf "walking up the valley for two seconds, then running for one:\n")
  (input-key-down! (& keys) #\w)
  (steps 120)
  (where)
  (input-key-down! (& keys) key-shift)
  (steps 60)
  (input-key-up! (& keys) key-shift)
  (input-key-up! (& keys) #\w)
  (where)
  (printf "a jump:\n")
  (input-key-down! (& keys) key-space)
  (step)
  (input-key-up! (& keys) key-space)
  (where)
  (steps 40)
  (where)
  (printf "turning with the mouse, and looking down with the key:\n")
  (input-mouse-lock! (& keys) 1)
  (input-mouse-move! (& keys) 200.0 0.0)
  (input-key-down! (& keys) key-down)
  (step)
  (input-key-up! (& keys) key-down)
  (where)

  (printf "over the bridge: put on the path at its east end, looking west, and walking:\n")
  (world-look! (+ (river bridge-z) 13.0) bridge-z (/ pi -2.0) 0.0)
  (input-key-down! (& keys) #\w)
  (steps 60)
  (where)
  (print-format "  which is the deck's height, ~.1f\n" bridge-deck)
  (steps 120)
  (input-key-up! (& keys) #\w)
  (where)

  (printf "into a tree: put in front of the nearest tree to (40, 200), walking at it for a second:\n")
  (let* ([e (space-entry (& (-> game space)) (space-nearest (& (-> game space)) 40.0 200.0 30.0 (kind-mask kind-tree)))]
         [tx (-> e x)] [tz (-> e z)] [nearest 1000.0])
    (world-look! (- tx 4.0) tz (/ pi 2.0) 0.0)
    (input-key-down! (& keys) #\w)
    (for ([i u32 0]) (< i 60) (+= i 1)
      (step)
      (let ([d (mover-distance (& (-> game player)) tx tz)])
        (when (< d nearest) (set! nearest d))))
    (input-key-up! (& keys) #\w)
    (print-format "  the tree is at ~.2f ~.2f; the player got no nearer its middle than ~.2f, and slid round it\n" tx tz nearest)
    (where))

  (printf "into the hut: put west of it, walking east at it for two seconds:\n")
  (world-look! (- hut-x 6.0) hut-z (/ pi 2.0) 0.0)
  (input-key-down! (& keys) #\w)
  (steps 120)
  (input-key-up! (& keys) #\w)
  (where)
  (print-format "  which is outside its west wall, at ~.1f\n" (- hut-x 2.6))

  (printf "wading into the river from its bank:\n")
  (world-look! (+ (river 100.0) 10.0) 100.0 (/ pi -2.0) 0.0)
  (input-key-down! (& keys) #\w)
  (steps 150)
  (input-key-up! (& keys) #\w)
  (where)

  (printf "the herd, with the player far away, after ten seconds:\n")
  (world-look! 160.0 40.0 0.0 0.0)
  (steps 600)
  (herd-report)
  (printf "the player put 15 from the herd's home, facing it: the deer notice:\n")
  (world-look! (- herd-x 15.0) herd-z (/ pi 2.0) 0.0)
  (steps 120)
  (herd-report)
  (printf "and running at them for three seconds:\n")
  (input-key-down! (& keys) key-shift)
  (input-key-down! (& keys) #\w)
  (steps 180)
  (input-key-up! (& keys) #\w)
  (input-key-up! (& keys) key-shift)
  (herd-report)
  (printf "ten seconds later, with the player standing still:\n")
  (steps 600)
  (herd-report)
  (printf "the models: the deer and the character written out with define-model:\n")
  (print-format "  a deer has ~d parts, its tail is part ~d; the character has ~d, its face is part ~d, hanging from its head, part ~d\n"
                deer-part-count deer-tail hero-part-count hero-face hero-head)
  (printf "the shoal, with the player on the jetty, after ten seconds:\n")
  (world-look! (+ shoal-x 12.0) shoal-z (/ pi -2.0) 0.0)
  (steps 600)
  (shoal-report)
  (printf "wading in towards them for three seconds:\n")
  (input-key-down! (& keys) #\w)
  (steps 180)
  (input-key-up! (& keys) #\w)
  (where)
  (shoal-report)
  (printf "and standing in the water for ten seconds more: they keep their distance:\n")
  (steps 600)
  (shoal-report)
  (world-draw (& game))
  (gpu-commands-written "a frame"))
