;; store-handle of an address that is not an object in the store stops the program.
(require-unqualified store "../../lib/web/game/store.sub")

(struct enemy [health i32] [armour i32])
(define enemies (store enemy))
(define elsewhere (array enemy 4))

(define (main)
  (store-add! (& enemies))
  (printf "before\n")
  (store-handle (& enemies) (+ elsewhere 2))
  (printf "not reached\n"))
