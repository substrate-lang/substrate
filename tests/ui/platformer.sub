;; The platformer without a browser, played by a bot that runs right and jumps.
(require-unqualified format std/web/game/format)
(require-unqualified store std/web/game/store)
(require-unqualified tiles std/web/game/tiles)
(require-unqualified input std/web/game/input)
(require-unqualified sound std/web/game/sound)
(require-unqualified world std/web/examples/platformer/world)

(define game world)
(define keys input)

(define (start!) (world-start! (& game) "../../std/web/examples/platformer/assets/levels/"))

(define (status)
  (print-format "  level ~d, step ~d: player at ~d, ~d ~s, coins ~d/~d, deaths ~d~s\n"
                (-> game level) (-> game steps)
                (cast i32 (-> game player x)) (cast i32 (-> game player y))
                (if (-> game player on-ground) "on the ground" "in the air")
                (-> game collected) (-> game coin-count) (-> game deaths)
                (cond [(== (-> game state) world-won) ", won"]
                      [(== (-> game state) world-cleared) ", at the flag"]
                      [(== (-> game state) world-dying) ", dying"]
                      [else ""])))

(define (describe-level)
  (print-format "level ~d: ~d by ~d tiles, ~d coins, ~d enemies\n"
                (-> game level) (-> game map columns) (-> game map rows)
                (-> game coin-count) (store-count (& (-> game enemies)))))

(define (step)
  (world-step! (& game) (& keys))
  (input-end-step! (& keys)))

(define (cell [p f64]) -> i32 (cast i32 (floor (/ p 16.0))))

(define (obstacle-ahead?) -> bool
  (let* ([p (& (-> game player))] [map (& (-> game map))]
         [front (+ (-> p x) (-> p width))] [feet (+ (-> p y) (-> p height))])
    (unless (-> p on-ground) (return #f))
    (when (solid-at? map (cell (+ front 6.0)) (cell (- feet 4.0))) (return #t))
    (unless (solid-at? map (cell (+ front 4.0)) (cell (+ feet 2.0))) (return #t))
    (when (== (tile-at map (cell (+ front 12.0)) (cell (- feet 4.0))) tile-spikes) (return #t))
    (store-each ([e (& (-> game enemies))])
      (let ([gap (- (-> e body x) front)])
        (when (and (not (-> e flat)) (> gap -4.0) (< gap 26.0) (< (fabs (- (-> e body y) (-> p y))) 20.0))
          (return #t))))
    #f))

(define (bot!)
  (input-key-down! (& keys) key-right)
  (cond [(and (-> game player on-ground) (held? (& keys) key-space)) (input-key-up! (& keys) key-space)]
        [(obstacle-ahead?) (input-key-down! (& keys) key-space)]))

(define (main)
  (start!)
  (describe-level)

  (print-format "with no keys pressed, the player falls onto the ground and stays there\n")
  (for ([i u32 0]) (< i 30) (+= i 1) (step))
  (status)

  (print-format "holding right: the player speeds up to 2 pixels a step\n")
  (input-key-down! (& keys) key-right)
  (for ([i u32 0]) (< i 30) (+= i 1) (step))
  (status)
  (input-key-up! (& keys) key-right)

  (print-format "a jump makes a sound\n")
  (tones-clear!)
  (input-key-down! (& keys) key-space)
  (step)
  (input-key-up! (& keys) key-space)
  (print-format "  tones waiting: ~d\n" (tones-waiting))
  (status)

  (print-format "walking into a hole\n")
  (start!)
  (input-clear! (& keys))
  (input-key-down! (& keys) key-right)
  (let ([n u32 0])
    (while (and (== (-> game state) world-playing) (< n 600))
      (step)
      (+= n 1)))
  (status)
  (for ([i u32 0]) (< i 44) (+= i 1) (step))
  (status)
  (step)
  (status)

  (print-format "the bot plays the game\n")
  (start!)
  (input-clear! (& keys))
  (let ([n u32 0] [state (-> game state)] [level (-> game level)])
    (while (and (!= (-> game state) world-won) (< n 6000))
      (bot!)
      (step)
      (+= n 1)
      (cond [(!= (-> game level) level)
             (set! level (-> game level))
             (describe-level)]
            [(!= (-> game state) state) (status)]
            [(== (% n 240) 0) (status)])
      (set! state (-> game state)))
    (print-format "~s, after ~d steps\n"
                  (if (== (-> game state) world-won) "the bot finished the last level" "the bot did not finish") n))

  (print-format "Enter starts the first level again\n")
  (input-clear! (& keys))
  (input-key-down! (& keys) key-enter)
  (step)
  (status))
