;; Reading and writing files with host/fs.sub, by paths relative to this directory.
(require-unqualified fs "../../host/fs.sub")

(define (main)
  (let* ([size u32 0] [content (fs-read-file "files.txt" (& size) 0)])
    (printf "size ~a\n" size)
    (printf "~a" content)
    (printf "~a" (if (== (strlen content) size) "the length is the size\n" "the length is not the size\n"))
    (free content))
  (let ([text (fs-read-file "files.txt" 0 0)])
    (printf "~a" (if (== (@ text 0) #\A) "read as text\n" "not read as text\n"))
    (free text))
  (let ([size u32 7] [why (ptr u8) 0])
    (printf "~a" (if (== (fs-read-file "no-such-file.txt" (& size) (& why)) 0)
                     "a missing file is 0\n"
                     "a missing file was read\n"))
    (printf "~a" (if (and (!= why 0) (> (strlen why) 0)) "and the host says why\n" "and the host does not say why\n"))
    (free why))
  (printf "~a" (if (== (fs-write "no-such-directory/file.txt" 26 "x" 1 0) -1)
                   "a write that fails is -1\n"
                   "a write that should fail did not\n")))
