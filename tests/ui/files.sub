;; Reading and writing files with host/fs.sub, by paths relative to this directory.
(require-unqualified fs "../../host/fs.sub")

(define (main)
  (let ([content (fs-read-file "files.txt" 0)])
    (printf "size ~a\n" (-> content length))
    (printf "~a" (cast string content))
    (printf "~a" (if (== (strlen (-> content items)) (-> content length)) "the length is the size\n" "the length is not the size\n"))
    (free (-> content items)))
  (let ([text (cast string (fs-read-file "files.txt" 0))])
    (printf "~a" (if (== (@ text 0) #\A) "read as text\n" "not read as text\n"))
    (free (-> text bytes)))
  (let ([why string])
    (printf "~a" (if (== (-> (fs-read-file "no-such-file.txt" (& why)) items) 0)
                     "a missing file is 0\n"
                     "a missing file was read\n"))
    (printf "~a" (if (> (-> why length) 0) "and the host says why\n" "and the host does not say why\n"))
    (free (-> why bytes)))
  (printf "~a" (if (== (fs-write-file "no-such-directory/file.txt" (cast (slice u8) "x") 0) -1)
                   "a write that fails is -1\n"
                   "a write that should fail did not\n")))
