;; Reading and writing files with compiler/host.sub, by paths relative to this directory.
(require-unqualified host "../../compiler/host.sub")

(define (main)
  (let* ([size u32 0] [content (read-file-bytes "files.txt" (& size))])
    (printf "size ~a\n" size)
    (printf "~a" content)
    (printf "~a" (if (== (strlen content) size) "the length is the size\n" "the length is not the size\n"))
    (free content))
  (let ([text (read-file-bytes "files.txt" 0)])
    (printf "~a" (if (== (@ text 0) #\A) "read as text\n" "not read as text\n"))
    (free text))
  (let ([size u32 7])
    (printf "~a" (if (== (read-file-bytes "no-such-file.txt" (& size)) 0) "a missing file is 0\n" "a missing file was read\n"))
    (let* ([why (array u8 256)] [n (host-error-message why 255)])
      (printf "~a" (if (> n 0) "and the host says why\n" "and the host does not say why\n"))))
  (printf "~a" (if (== (host-write-file "no-such-directory/file.txt" 26 "x" 1) -1)
                   "a write that fails is -1\n"
                   "a write that should fail did not\n")))
