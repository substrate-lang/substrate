;; Text made from a pattern and arguments: directives, widths, decimals, arrays, buffers.
(require-unqualified format web/game/format)

(define (main)
  (print-format "integers: ~d ~d ~d|\n" 42 -7 0)
  (let ([small i8 -5] [byte u8 200] [wide u32 4000000000] [long i64 -9000000000000000000])
    (print-format "of each size: ~d ~d ~d ~d|\n" small byte wide long))
  (let ([most u64 18446744073709551615] [least i64 -9223372036854775808])
    (print-format "the largest and the smallest: ~u ~d|\n" most least))
  (print-format "hexadecimal: ~x ~x ~x|\n" 255 0 3735928559)
  (print-format "strings: ~s and ~s|\n" "one" "two")
  (let ([none string])
    (print-format "no string: [~s]|\n" none))
  (print-format "characters: ~c~c~c ~c ~c|\n" #\a #\b #\c 233 8364)
  (print-format "a tilde: ~~|\n")
  (print-format "nothing to replace|\n")
  (print-format "")

  (print-format "widths: [~5d] [~-5d] [~05d] [~05d] [~2d]|\n" 42 42 42 -42 12345)
  (print-format "widths: [~6s] [~-6s] [~4x] [~04x]|\n" "ab" "ab" 255 255)

  (print-format "decimals: ~f ~f ~f ~f ~f|\n" 0.5 12.0 -3.14159265 0.0 100.25)
  (print-format "exactly: ~.2f ~.2f ~.0f ~.3f ~.1f|\n" 3.14159 2.5 2.5 0.9996 -0.04)
  (print-format "rounding: ~.2f ~.2f ~f ~f|\n" 0.005 1.995 0.1234567 0.0000004)
  (print-format "padded: [~8.2f] [~-8.2f] [~08.2f] [~08.2f]|\n" 3.14159 3.14159 3.14159 -3.14159)
  (let ([x f32 1.5])
    (print-format "a 32-bit number: ~f|\n" x))
  (print-format "an integer given to ~~f: ~f|\n" 3)
  (print-format "large: ~f ~f ~.2f|\n" 123456789012.5 1500000000000000000000000000000.0 99999999999999999999.0)
  (let ([zero 0.0])
    (print-format "not numbers: ~f ~f ~f|\n" (/ zero zero) (/ 1.0 zero) (/ -1.0 zero)))

  (let ([line (array u8 16)] [s string])
    (memset line #\# 16)
    (set! s (format-into (slice line) "coins ~d/~d" 3 12))
    (print-format "length ~d: ~s|\n" (-> s length) s)
    (set! s (format-into (slice line) "a long piece of text"))
    (print-format "length ~d: ~s|\n" (-> s length) s)
    (memset line #\# 16)
    (set! s (format-into (slice line 6) "~d" 123456789))
    (print-format "length ~d: ~s| then ~c|\n" (-> s length) s (@ line 6))
    (set! s (format-into (slice line 4) "caf~c!" 233))
    (print-format "length ~d: ~s|\n" (-> s length) s)
    (set! s (format-into (slice line 1) "text"))
    (print-format "length ~d: ~s|\n" (-> s length) s)
    (set! s (format-into (slice line 0) "text"))
    (print-format "length ~d: ~s|\n" (-> s length) s))

  (let ([b (make-buffer)])
    (buffer-add-format! (& b) "~d + ~d" 2 2)
    (print-format "added ~d more: " (buffer-add-format! (& b) " = ~d" 4))
    (print-format "~s|\n" (buffer-string (& b)))
    (buffer-free! (& b)))
  (let ([s (format-string "~s has ~d items" "the list" 3)])
    (print-format "a new string: ~s (~d bytes)|\n" s (-> s length))
    (free (-> s bytes)))

  (let ([w 7])
    (print-format "the caller's w: ~d|\n" w)))
