;; quote-syntax prunes local binding scopes.

(begin-for-syntax
  (require-unqualified macros compiler/macros)
  (define (use-x) -> datum #'(+ x 1))
  (define (with-x [stx datum]) -> datum
    (let ([body (use-x)])
      #`(let ([x 41]) #,body))))
(define-syntax with-x with-x)

(define (main) (printf "~a\n" (with-x)))
