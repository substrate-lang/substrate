;; A syntax property can hold any datum, which stays on the syntax a macro returns.
(require-unqualified tests std/test/test)
(begin-for-syntax
  (require-unqualified macros compiler/macros)
  (define (boxed [stx datum]) -> datum
    (syntax-property-set (cadr (syntax->list stx)) 'box '(42)))
  (define (unbox-of [stx datum]) -> datum
    (let ([e (local-expand (cadr (syntax->list stx)))])
      (datum->syntax stx (car (syntax-property (found e) 'box)) stx)))
  (define (found [e datum]) -> datum
    (if (syntax-property e 'box) e (cadr (syntax->list e)))))
(define-syntax boxed boxed)
(define-syntax unbox-of unbox-of)

(define (main) (printf "~a\n" (unbox-of (boxed 1))))

(test syntax-property-object (expect-output-file "syntax-property-object.out" (main)))
