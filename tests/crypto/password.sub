;; Passwords hashed and checked in the worker: a new hash and its form, the right and a wrong password against it, a
;; hash Node's crypto made, strings that cannot be read, jobs queued at once, and the default iterations.
(require-unqualified events "../../host/events.sub")
(require-unqualified password "../../lib/crypto/password.sub")

(define jobs (array password-job 8))
(define names (array string 8))
(define made string "")

(define (field [s string] [k u32]) -> string
  (let ([n u32 0] [start u32 0])
    (for ([i u32 0]) (<= i (-> s length)) (+= i 1)
      (when (or (== i (-> s length)) (== (@ s i) 36))
        (when (== n k) (return (slice s start i)))
        (+= n 1)
        (set! start (+ i 1))))
    ""))

(define (checked [j (ptr password-job)])
  (printf "~a: ~a\n" (@ names (cast u32 (-> j user))) (-> j ok)))

(define (verify! [i u32] [name string] [password string] [stored string] [done (fn ((ptr password-job)))])
  (let ([j (& (@ jobs i))])
    (set! (@ names i) name)
    (set! (-> j user) (cast (ptr void) i))
    (password-verify! j password stored done)))

(define (hashed [j (ptr password-job)])
  (let ([s (buffer-string (& (-> j result)))] [copy (make-buffer)])
    (printf "hashed: $~a$~a$, then a salt of ~a characters and a hash of ~a\n" (field s 1) (field s 2)
            (-> (field s 3) length) (-> (field s 4) length))
    (buffer-add-string! (& copy) s)
    (set! made (buffer-string (& copy)))
    (verify! 1 "the right password" "correct horse battery staple" made checked)
    (verify! 2 "a wrong password" "correct horse battery stapler" made checked)
    (verify! 3 "Node's hash" "correct horse battery staple"
             "$pbkdf2-sha256$i=1000$MDEyMzQ1Njc4OWFiY2RlZg$yqSq2SygY1sB4EcH9f2FG0JTMES+wqLsOT5YmiRBplI" checked)
    (verify! 4 "another scheme" "x" "$argon2id$v=19$m=65536,t=3,p=4$c2FsdA$aGFzaA" checked)
    (verify! 5 "a short hash" "x" "$pbkdf2-sha256$i=1000$MDEyMzQ1Njc4OWFiY2RlZg$yqSq2Syg" checked)
    (verify! 6 "no iterations" "x" "$pbkdf2-sha256$i=$MDEyMzQ1Njc4OWFiY2RlZg$yqSq2SygY1sB4EcH9f2FG0JTMES+wqLsOT5YmiRBplI"
             checked)
    (let ([d (& (@ jobs 7))])
      (password-hash! d "default" defaulted))))

(define (defaulted [j (ptr password-job)])
  (let ([s (buffer-string (& (-> j result)))])
    (printf "by default: ~a\n" (field s 2))))

(define (main)
  (let ([j (& (@ jobs 0))])
    (set! (-> j iterations) 1000)
    (password-hash! j "correct horse battery staple" hashed)))
