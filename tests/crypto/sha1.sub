;; SHA-1 over the standard vectors, at once and in pieces.
(require-unqualified sha1 "../../lib/crypto/sha1.sub")

(define (show [digest (ptr u8)])
  (let ([pair (array u8 2)])
    (for ([i u32 0]) (< i 20) (+= i 1)
      (set! (@ pair 0) (@ "0123456789abcdef" (>> (@ digest i) 4)))
      (set! (@ pair 1) (@ "0123456789abcdef" (bit-and (@ digest i) 15)))
      (host-write 1 (slice pair))))
  (printf "\n"))

(define (digest-of [s (ptr u8)])
  (let ([out (array u8 20)])
    (sha1-of s (strlen s) out)
    (show out)))

(define (main)
  (digest-of "")
  (digest-of "abc")
  (digest-of "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
  (digest-of "The quick brown fox jumps over the lazy dog")
  (let ([s sha1] [out (array u8 20)] [a (array u8 1000)])
    (memset a 97 1000)
    (sha1-init! (& s))
    (for ([i u32 0]) (< i 1000) (+= i 1) (sha1-add! (& s) a 1000))
    (sha1-end! (& s) out)
    (show out)
    (sha1-init! (& s))
    (sha1-add! (& s) "The quick brown fox " 20)
    (sha1-add! (& s) "j" 1)
    (sha1-add! (& s) "umps over the lazy dog" 22)
    (sha1-end! (& s) out)
    (show out)
    (sha1-init! (& s))
    (for ([i u32 0]) (< i 1000) (+= i 1)
      (let ([k (% i 97)])
        (sha1-add! (& s) a k)
        (sha1-add! (& s) (+ a k) (- 1000 k))))
    (sha1-end! (& s) out)
    (show out)))
