;; SHA-256 over the standard vectors, at once and in pieces.
(require-unqualified sha256 "../../lib/crypto/sha256.sub")

(define (show [digest (ptr u8)])
  (let ([pair (array u8 2)])
    (for ([i u32 0]) (< i 32) (+= i 1)
      (set! (@ pair 0) (@ "0123456789abcdef" (>> (@ digest i) 4)))
      (set! (@ pair 1) (@ "0123456789abcdef" (bit-and (@ digest i) 15)))
      (host-write 1 (slice pair))))
  (printf "\n"))

(define (digest-of [s string])
  (let ([out (array u8 32)])
    (sha256-of (cast (slice u8) s) (slice out))
    (show out)))

(define (main)
  (digest-of "")
  (digest-of "abc")
  (digest-of "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
  (digest-of
   "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu")
  (digest-of "The quick brown fox jumps over the lazy dog")
  (let ([s sha256] [out (array u8 32)] [a (array u8 1000)])
    (memset a 97 1000)
    (sha256-init! (& s))
    (for ([i u32 0]) (< i 1000) (+= i 1) (sha256-add! (& s) (slice a)))
    (sha256-end! (& s) (slice out))
    (show out)
    (sha256-init! (& s))
    (sha256-add! (& s) (cast (slice u8) "The quick brown fox "))
    (sha256-add! (& s) (cast (slice u8) "j"))
    (sha256-add! (& s) (cast (slice u8) "umps over the lazy dog"))
    (sha256-end! (& s) (slice out))
    (show out)
    (sha256-init! (& s))
    (for ([i u32 0]) (< i 1000) (+= i 1)
      (let ([k (% i 97)])
        (sha256-add! (& s) (slice a k))
        (sha256-add! (& s) (slice (slice a) k))))
    (sha256-end! (& s) (slice out))
    (show out)))
