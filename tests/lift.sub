;; syntax-local-lift-definition: each use lifts its own function.

(begin-for-syntax
  (require-unqualified macros compiler/macros)
  (define (add-const [stx datum]) -> datum
    (let ([parts (syntax->list stx)])
      (syntax-local-lift-definition #`(define (plus [x i32]) -> i32 (+ x #,(cadr parts))))
      #`(plus #,(caddr parts)))))
(define-syntax add-const add-const)

(define (main)
  (printf "~a\n" (add-const 1 41))
  (printf "~a\n" (add-const 100 5)))
