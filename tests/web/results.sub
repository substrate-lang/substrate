;; A page that calls methods for their results: a number, text, a node or none, with a node as an argument.
(require-unqualified std/web/dom)
(require-unqualified "plain.sub")

(define html string
  "<div id=\"outer\" data-n><p id=\"inner\" data-x=\"seven\" data-n>inner</p></div><input id=\"field\" data-n><div id=\"sized\"></div><p id=\"shown\"><!--t--></p>")

(define (number [x f64]) -> i32 (cast i32 x))

(define (main)
  (let* ([page (dom-add! (dom-template html) 0 0)] [outer (+ page 1)] [inner (+ page 2)] [field (+ page 3)]
         [found u32 0] [none u32 0] [box u32 0])
    (dom-stylesheet! "#sized { width: 123px; height: 10px; }")
    (dom-call! field "focus")
    (dom-flush!)
    (set! found (dom-call-node dom-document "querySelector" (dom-values (dom-text "#outer p"))))
    (set! none (dom-call-node dom-document "querySelector" (dom-values (dom-text "#nowhere"))))
    (set! box (dom-call-node (dom-element "sized") "getBoundingClientRect" (dom-values)))
    (show! (+ page 4) "focused ~a, data ~a, found ~a, none ~a, contains ~a ~a, width ~a"
           (number (dom-call-number field "matches" (dom-values (dom-text ":focus"))))
           (dom-call-text inner "getAttribute" (dom-values (dom-text "data-x")))
           (dom-read-text found "id") (number (dom-read-number none "nodeType"))
           (number (dom-call-number outer "contains" (dom-values (dom-node inner))))
           (number (dom-call-number inner "contains" (dom-values (dom-node outer))))
           (number (dom-read-number box "width")))
    (dom-forget-node! found)
    (dom-forget-node! none)
    (dom-forget-node! box)
    (dom-flush!)))
