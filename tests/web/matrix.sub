;; A page that reads the matrix from an SVG element to the screen, which getScreenCTM gives.
(require-unqualified std/web/dom)
(require-unqualified "plain.sub")

(define html string
  "<svg id=\"drawing\" width=\"200\" height=\"100\" viewBox=\"0 0 100 50\"><rect id=\"spot\" width=\"10\" height=\"10\"></rect></svg><p><!--t--></p>")

(define (main)
  (let* ([page (dom-add! (dom-template html) 0 0)] [m u32 0])
    (dom-flush!)
    (set! m (dom-call-node (dom-element "spot") "getScreenCTM" (dom-values)))
    (show! (+ page 1) "scale ~a ~a" (cast i32 (dom-read-number m "a")) (cast i32 (dom-read-number m "d")))
    (dom-forget-node! m)
    (dom-flush!)))
