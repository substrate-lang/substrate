;; A page that asks its server for /api again as soon as each answer ends, and says when the first has come.
(require-unqualified web)
(require-unqualified host/modules/fetch)
(require-unqualified host/stream)

(struct model [head event-head] [answers u32] [bytes (array u8 64)])
(variant message [changed])
(messages message)

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([m (cast (ptr model) tag)] [e message changed])
    (cond [(and (== source fetch-source) (== kind fetch-head)) (stream-read! id (slice (-> m bytes)))]
          [(and (== source stream-source) (== kind stream-read) (> value 0)) (stream-read! id (slice (-> m bytes)))]
          [(and (== source stream-source) (== kind stream-read))
           (stream-close id)
           (+= (-> m answers) 1)
           (fetch-get "api" tag)
           (send! (& e))])))

(define (init [m (ptr model)])
  (set! (-> m head handle) heard)
  (fetch-get "api" (cast (ptr void) m)))

(define (update [m (ptr model)] [e (ptr message)]) (match e [changed (begin)]))

(view (page [m (ptr model)])
  (p ([id "state"]) (when (> (-> m answers) 0) "answered")))

(app model message init update page)
