;; A page that asks its server for /api again as soon as each answer ends, and says when the first has come.
(require-unqualified std/web/dom)
(require-unqualified host/modules/fetch)
(require-unqualified host/stream)
(require-unqualified "plain.sub")

(define head event-head)
(define answers u32 0)
(define bytes (array u8 64))
(define state u32 0)

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (cond [(and (== source fetch-source) (== kind fetch-head)) (stream-read! id (slice bytes))]
        [(and (== source stream-source) (== kind stream-read) (> value 0)) (stream-read! id (slice bytes))]
        [(and (== source stream-source) (== kind stream-read))
         (stream-close id)
         (+= answers 1)
         (fetch-get "api" (cast (ptr void) (& head)))
         (show! state "answered")
         (dom-flush!)]))

(define (main)
  (set! state (+ (dom-add! (dom-template "<p id=\"state\"><!--t--></p>") 0 0) 1))
  (set! (-> head handle) heard)
  (fetch-get "api" (cast (ptr void) (& head)))
  (dom-flush!))
