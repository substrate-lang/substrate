;; A game that draws many bouncing sprites, to measure a renderer.
(require-unqualified web/game/draw)
(require-unqualified web/game/input)
(require-unqualified web/game/format)

(provide world world-init! world-step! world-draw)

(struct sprite [x f64] [y f64] [dx f64] [dy f64] [cell u32])
(struct world [count u32] [sprites (ptr sprite)] [sheet u32] [label-bytes (array u8 32)] [label string])

(define screen-width f64 640.0)
(define screen-height f64 360.0)

(define seed u32 2463534242)
(define (random) -> u32
  (set! seed (bit-xor seed (<< seed 13)))
  (set! seed (bit-xor seed (>> seed 17)))
  (set! seed (bit-xor seed (<< seed 5)))
  seed)

(define (argument-number [otherwise u32]) -> u32
  (let ([args (host-args)] [n otherwise])
    (when (and (> (-> args length) 0) (> (-> (@ args 0) length) 0))
      (let ([text (@ args 0)])
        (set! n 0)
        (for ([i u32 0]) (< i (-> text length)) (+= i 1)
          (set! n (+ (* n 10) (- (cast u32 (@ text i)) 48))))))
    (free (-> args items))
    n))

(define (world-init! [w (ptr world)])
  (set! (-> w sheet) (load-sheet "assets/sprites.png" 16.0 16.0))
  (set! (-> w count) (argument-number 1000))
  (set! (-> w label) (format-into (slice (-> w label-bytes)) "~d sprites" (-> w count)))
  (set! (-> w sprites) (cast (ptr sprite) (calloc (-> w count) (sizeof sprite))))
  (for ([i u32 0]) (< i (-> w count)) (+= i 1)
    (let ([s (+ (-> w sprites) i)])
      (set! (-> s x) (cast f64 (% (random) 624)))
      (set! (-> s y) (cast f64 (% (random) 344)))
      (set! (-> s dx) (- (cast f64 (% (random) 5)) 2.0))
      (set! (-> s dy) (- (cast f64 (% (random) 5)) 2.0))
      (set! (-> s cell) (+ 8 (% (random) 6)))))
  ;; Sprite 0 stands still on the grass tile, a known pixel for the tests.
  (when (> (-> w count) 0)
    (let ([s (-> w sprites)])
      (set! (-> s x) 8.0)
      (set! (-> s y) 8.0)
      (set! (-> s dx) 0.0)
      (set! (-> s dy) 0.0)
      (set! (-> s cell) 0))))

(define (world-step! [w (ptr world)] [in (ptr input)])
  (for ([i u32 0]) (< i (-> w count)) (+= i 1)
    (let ([s (+ (-> w sprites) i)])
      (+= (-> s x) (-> s dx))
      (+= (-> s y) (-> s dy))
      (when (or (< (-> s x) 0.0) (> (-> s x) (- screen-width 16.0))) (set! (-> s dx) (- 0.0 (-> s dx))))
      (when (or (< (-> s y) 0.0) (> (-> s y) (- screen-height 16.0))) (set! (-> s dy) (- 0.0 (-> s dy)))))))

(define (world-draw [w (ptr world)])
  (fill-screen #x8fd3ffff)
  (for ([i u32 0]) (< i (-> w count)) (+= i 1)
    (let ([s (+ (-> w sprites) i)])
      (draw-sprite (-> w sheet) (-> s cell) (floor (-> s x)) (floor (-> s y)) (< (-> s dx) 0.0))))
  (text-color #x10141aff)
  (draw-text (-> w label) 24.0 8.0))
