;; A page with a link and a form that go to other pages, which shows the URL it was opened at.
(require-unqualified web web)
(require-unqualified location host/web/location)

(struct model [at string])
(variant message [changed])
(messages message)

(define (init [m (ptr model)]) (set! (-> m at) (location-get)))

(define (update [m (ptr model)] [e (ptr message)]) (match e [changed (begin)]))

(view (page [m (ptr model)])
  (p ([id "at"]) (text (-> m at)))
  (a ([href "?page=2"]) "next")
  (form
    (label "Search " (input ([name "q"] [type "text"])))
    (button "go")))

(app model message init update page)
