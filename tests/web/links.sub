;; A page with a link and a form that go to other pages, which shows the URL it was opened at.
(require-unqualified std/web/dom)
(require-unqualified host/web/location)
(require-unqualified "plain.sub")

(define html string
  "<p id=\"at\"><!--t--></p><a href=\"?page=2\">next</a><form><label>Search <input name=\"q\" type=\"text\"></label><button>go</button></form>")

(define (main)
  (show! (+ (dom-add! (dom-template html) 0 0) 1) "~a" (location-get))
  (dom-flush!))
