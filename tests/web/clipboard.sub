;; A page that writes text to the clipboard on a click, then reads it back.
(require-unqualified web web)
(require-unqualified clipboard host/web/clipboard)
(require-unqualified format web/game/format)

(struct model [head event-head] [shown buffer])
(variant message [copy] [changed])
(messages message)

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([m (cast (ptr model) tag)] [e message changed] [text (events-take-text)])
    (cond [(== kind clipboard-written) (clipboard-read tag 0)]
          [(== kind clipboard-text)
           (set! (-> m shown length) 0)
           (buffer-add-format! (& (-> m shown)) "read: ~s" text)]
          [else
           (set! (-> m shown length) 0)
           (buffer-add-format! (& (-> m shown)) "failed ~d: ~s" value text)])
    (free (-> text bytes))
    (send! (& e))))

(define (init [m (ptr model)])
  (set! (-> m head handle) heard)
  (set! (-> m shown) (make-buffer))
  (buffer-add-string! (& (-> m shown)) "waiting"))

(define (update [m (ptr model)] [e (ptr message)])
  (match e
    [copy (clipboard-write "copied text" (cast (ptr void) m) 0)]
    [changed (begin)]))

(view (page [m (ptr model)])
  (button ([id "copy"] [on click copy]) "copy")
  (p ([id "shown"]) (text (buffer-string (& (-> m shown))))))

(app model message init update page)
