;; A page that writes text to the clipboard on a click, then reads it back.
(require-unqualified std/web/dom)
(require-unqualified host/events)
(require-unqualified host/web/clipboard)
(require-unqualified "plain.sub")

(define head event-head)
(define click event-head)
(define shown u32 0)

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([text (events-take-text)] [made u32 0])
    (cond [(== kind clipboard-written) (clipboard-read (cast (ptr void) (& head)) (& made) 0)]
          [(== kind clipboard-text) (show! shown "read: ~a" text)]
          [else (show! shown "failed ~a: ~a" value text)])
    (free (-> text bytes))
    (dom-flush!)))

(define (copied [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([made u32 0]) (clipboard-write "copied text" (cast (ptr void) (& head)) (& made) 0)))

(define (main)
  (let ([page (dom-add! (dom-template "<button id=\"copy\" data-n>copy</button><p id=\"shown\"><!--t--></p>") 0 0)])
    (set! shown (+ page 2))
    (set! (-> head handle) heard)
    (set! (-> click handle) copied)
    (dom-listen! (+ page 1) "click" (& click))
    (show! shown "waiting")
    (dom-flush!)))
