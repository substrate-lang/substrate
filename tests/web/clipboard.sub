;; A page using the clipboard module: text written on a click, then read back.
(require-unqualified web "../../lib/web/web.sub")
(require-unqualified clipboard "../../host/web/clipboard.sub")
(require-unqualified format "../../lib/web/game/format.sub")

(struct model [head event-head] [shown (array u8 128)])
(variant message [copy] [changed])
(messages message)

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([m (cast (ptr model) tag)] [e message changed] [text (events-take-text)])
    (cond [(== kind clipboard-written) (clipboard-read tag)]
          [(== kind clipboard-text) (format-into (-> m shown) 128 "read: ~s" text)]
          [else (format-into (-> m shown) 128 "failed ~d: ~s" value text)])
    (free text)
    (send! (& e))))

(define (init [m (ptr model)])
  (set! (-> m head handle) heard)
  (format-into (-> m shown) 128 "waiting"))

(define (update [m (ptr model)] [e (ptr message)])
  (match e
    [copy (clipboard-write "copied text" (cast (ptr void) m))]
    [changed (begin)]))

(view (page [m (ptr model)])
  (button ([id "copy"] [on click copy]) "copy")
  (p ([id "shown"]) (text (-> m shown))))

(app model message init update page)
