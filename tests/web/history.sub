;; A page that pushes and replaces entries with states, then goes back and forth through them, logging each step.
(require-unqualified std/web/dom)
(require-unqualified host/events)
(require-unqualified host/web/history)
(require-unqualified host/web/location)
(require-unqualified "plain.sub")

(define log buffer)
(define shown u32 0)
(define last u32 0)
(define heard event-head)
(define pops u32 0)

(define (logged! [what string] [url string])
  (let ([s (history-state)] [line (make-buffer)])
    (buffer-add-string! (& line) what)
    (buffer-add-byte! (& line) #\space)
    (buffer-add-string! (& line) url)
    (buffer-add-string! (& line) " [")
    (buffer-add! (& line) s)
    (buffer-add-byte! (& line) #\])
    (free (-> s items))
    (buffer-add-string! (& log) (buffer-string (& line)))
    (buffer-add-byte! (& log) #\newline)
    (show! shown "~a" (buffer-string (& log)))
    (show! last "~a" (buffer-string (& line)))
    (buffer-free! (& line))
    (dom-flush!)))

(define (here! [what string])
  (let ([url (location-href)])
    (logged! what url)
    (free (-> url bytes))))

(define (popped [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([url (events-take-text)])
    (logged! "popped" url)
    (free (-> url bytes))
    (+= pops 1)
    (case pops
      [(1) (history-forward)]
      [(2) (history-go -1)]
      [else (begin)])))

(define (main)
  (let ([page (dom-add! (dom-template "<pre id=\"log\"><!--t--></pre><p id=\"last\"><!--t--></p>") 0 0)])
    (set! log (make-buffer))
    (set! shown (+ page 1))
    (set! last (+ page 2))
    (here! "start")
    (history-push-state (cast (slice u8) "pushed") "?page=2" 0)
    (here! "push")
    (history-replace-state (cast (slice u8) "replaced") "" 0)
    (here! "replace")
    (unless (history-push-state (cast (slice u8) "") "https://example.com/" 0) (here! "refused"))
    (here! (history-scroll-restoration))
    (history-set-scroll-restoration "manual")
    (here! (history-scroll-restoration))
    (set! (-> heard handle) popped)
    (history-listen (& heard))
    (history-back)))
