;; A page that sets, gets, lists and removes keys in the browser's storage.
(require-unqualified web web)
(require-unqualified storage host/web/storage)
(require-unqualified format web/game/format)

(struct model [head event-head] [step i32] [log buffer])
(variant message [changed])
(messages message)

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([m (cast (ptr model) tag)] [e message changed])
    (if (== kind storage-keys)
        (let ([keys (events-take-strings)])
          (buffer-add-format! (& (-> m log)) "~d ~d" kind value)
          (for ([i u32 0]) (< i (-> keys length)) (+= i 1) (buffer-add-format! (& (-> m log)) " ~s" (@ keys i)))
          (buffer-add-byte! (& (-> m log)) 10)
          (free (-> keys items)))
        (let ([text (events-take-text)])
          (buffer-add-format! (& (-> m log)) "~d ~d ~s\n" kind value text)
          (free (-> text bytes))))
    (+= (-> m step) 1)
    (cond [(== (-> m step) 1) (storage-get "greeting" tag)]
          [(== (-> m step) 2) (storage-get "nothing" tag)]
          [(== (-> m step) 3) (storage-list "gr" tag)]
          [(== (-> m step) 4) (storage-remove "greeting" tag)]
          [(== (-> m step) 5) (storage-get "greeting" tag)])
    (send! (& e))))

(define (init [m (ptr model)])
  (set! (-> m head handle) heard)
  (set! (-> m log) (make-buffer))
  (storage-set-text "greeting" "hello" (cast (ptr void) m)))

(define (update [m (ptr model)] [e (ptr message)]) (match e [changed (begin)]))

(view (page [m (ptr model)])
  (p ([id "step"]) (int (-> m step)))
  (pre ([id "log"]) (text (buffer-string (& (-> m log))))))

(app model message init update page)
