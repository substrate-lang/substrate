;; A page that sets, gets, lists and removes keys in the browser's storage.
(require-unqualified web "../../lib/web/web.sub")
(require-unqualified storage "../../host/web/storage.sub")
(require-unqualified format "../../lib/web/game/format.sub")

(struct model [head event-head] [step i32] [log (array u8 512)] [length u32])
(variant message [changed])
(messages message)

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([m (cast (ptr model) tag)] [e message changed] [text (events-take-text)])
    (+= (-> m length) (format-into (+ (-> m log) (-> m length)) (- 512 (-> m length)) "~d ~d ~s\n" kind value (-> text bytes)))
    (free (-> text bytes))
    (+= (-> m step) 1)
    (cond [(== (-> m step) 1) (storage-get "greeting" tag)]
          [(== (-> m step) 2) (storage-get "nothing" tag)]
          [(== (-> m step) 3) (storage-list "gr" tag)]
          [(== (-> m step) 4) (storage-remove "greeting" tag)]
          [(== (-> m step) 5) (storage-get "greeting" tag)])
    (send! (& e))))

(define (init [m (ptr model)])
  (set! (-> m head handle) heard)
  (storage-set-text "greeting" "hello" (cast (ptr void) m)))

(define (update [m (ptr model)] [e (ptr message)]) (match e [changed (begin)]))

(view (page [m (ptr model)])
  (p ([id "step"]) (int (-> m step)))
  (pre ([id "log"]) (text (-> m log))))

(app model message init update page)
