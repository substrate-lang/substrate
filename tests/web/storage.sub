;; A page that sets, gets, lists and removes keys in the browser's storage.
(require-unqualified std/web/dom)
(require-unqualified host/events)
(require-unqualified host/web/storage)
(require-unqualified "plain.sub")

(define head event-head)
(define step i32 0)
(define log buffer)
(define page u32 0)

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([before (output-to! (& log))])
    (if (== kind storage-keys)
        (let ([keys (events-take-strings)])
          (printf "~a ~a" kind value)
          (for ([i u32 0]) (< i (-> keys length)) (+= i 1) (printf " ~a" (@ keys i)))
          (printf "\n")
          (free (-> keys items)))
        (let ([text (events-take-text)])
          (printf "~a ~a ~a\n" kind value text)
          (free (-> text bytes))))
    (output-to! before))
  (+= step 1)
  (let ([t (cast (ptr void) (& head))])
    (cond [(== step 1) (storage-get "greeting" t)]
          [(== step 2) (storage-get "nothing" t)]
          [(== step 3) (storage-list "gr" t)]
          [(== step 4) (storage-remove "greeting" t)]
          [(== step 5) (storage-get "greeting" t)]))
  (shown!))

(define (shown!)
  (show! (+ page 1) "~a" step)
  (show! (+ page 2) "~a" (buffer-string (& log)))
  (dom-flush!))

(define (main)
  (set! page (dom-add! (dom-template "<p id=\"step\"><!--t--></p><pre id=\"log\"><!--t--></pre>") 0 0))
  (set! (-> head handle) heard)
  (set! log (make-buffer))
  (storage-set-text "greeting" "hello" (cast (ptr void) (& head)))
  (shown!))
