;; A page that counts what a user does to it: right-clicks, clicks and double-clicks, the mouse entering and leaving,
;; the wheel turning, the option chosen and the window resized. Half a second after it starts, it says it is ready.
(require-unqualified std/web/dom)
(require-unqualified host/modules/timer)
(require-unqualified "plain.sub")

(define html string
  "<div id=\"menu\" data-n>menu</div><button id=\"twice\" data-n>twice</button><p id=\"hover\" data-n>hover</p><div id=\"wheel\" data-n>wheel</div><select id=\"pick\" data-n><option value=\"a\">Apple</option><option value=\"b\">Banana</option></select><p id=\"counts\"><!--t--></p><p id=\"late\"><!--t--></p>")

(struct counter [head event-head] [count u32])

(define menus counter)
(define clicks counter)
(define doubles counter)
(define entered counter)
(define left counter)
(define turns counter)
(define resized counter)
(define choice u32 0)
(define ready bool #f)
(define page u32 0)
(define picking event-head)
(define waiting event-head)

(define (shown!)
  (show! (+ page 6) "~a ~a ~a ~a ~a ~a ~a ~a" (-> menus count) (-> clicks count) (-> doubles count) (-> entered count)
         (-> left count) (-> turns count) choice (-> resized count))
  (show! (+ page 7) "~a" (if ready "ready" ""))
  (dom-flush!))

(define (counted [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (+= (-> (cast (ptr counter) tag) count) 1)
  (shown!))

(define (picked [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (set! choice (if (== (dom-event-text "target.value") "b") 2 1))
  (shown!))

(define (waited [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (set! ready #t)
  (shown!))

(define (counting [c (ptr counter)]) -> (ptr void)
  (set! (-> c head handle) counted)
  (cast (ptr void) c))

(define (main)
  (set! page (dom-add! (dom-template html) 0 0))
  (dom-listen! (+ page 1) "contextmenu" (counting (& menus)))
  (dom-listen-window! (+ page 1) "resize" (counting (& resized)))
  (dom-listen! (+ page 2) "click" (counting (& clicks)))
  (dom-listen! (+ page 2) "dblclick" (counting (& doubles)))
  (dom-listen! (+ page 3) "mouseenter" (counting (& entered)))
  (dom-listen! (+ page 3) "mouseleave" (counting (& left)))
  (dom-listen! (+ page 4) "wheel" (counting (& turns)))
  (set! (-> picking handle) picked)
  (dom-listen! (+ page 5) "change" (& picking))
  (set! (-> waiting handle) waited)
  (timer-after 500.0 (cast (ptr void) (& waiting)))
  (shown!))
