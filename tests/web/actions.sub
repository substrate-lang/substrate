;; A page that counts what a user does to it: right-clicks, clicks and double-clicks, the mouse entering and leaving,
;; the wheel turning, the option chosen and the window resized. Half a second after it starts, it says it is ready.
(require-unqualified web)
(require-unqualified host/modules/timer)

(struct model [head event-head] [menus u32] [clicks u32] [doubles u32] [entered u32] [left u32] [turns u32] [choice u32]
  [resized u32] [ready bool])
(variant message [menu] [clicked] [doubled] [enter] [leave] [turn] [picked [value string]] [resize] [changed])
(messages message)

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([m (cast (ptr model) tag)] [e message changed])
    (when (== source timer-source) (set! (-> m ready) #t))
    (send! (& e))))

(define (init [m (ptr model)])
  (set! (-> m head handle) heard)
  (timer-after 500.0 (cast (ptr void) m)))

(define (update [m (ptr model)] [e (ptr message)])
  (match e
    [menu (+= (-> m menus) 1)]
    [clicked (+= (-> m clicks) 1)]
    [doubled (+= (-> m doubles) 1)]
    [enter (+= (-> m entered) 1)]
    [leave (+= (-> m left) 1)]
    [turn (+= (-> m turns) 1)]
    [(picked value) (set! (-> m choice) (if (== value "b") 2 1))]
    [resize (+= (-> m resized) 1)]
    [changed (begin)]))

(view (page [m (ptr model)])
  (div ([id "menu"] [on contextmenu menu] [on-window resize resize]) "menu")
  (button ([id "twice"] [on click clicked] [on dblclick doubled]) "twice")
  (p ([id "hover"] [on mouseenter enter] [on mouseleave leave]) "hover")
  (div ([id "wheel"] [on wheel turn]) "wheel")
  (select ([id "pick"] [on change (picked (event value))])
    (option ([value "a"]) "Apple")
    (option ([value "b"]) "Banana"))
  (p ([id "counts"]) (int (-> m menus)) " " (int (-> m clicks)) " " (int (-> m doubles)) " " (int (-> m entered)) " "
     (int (-> m left)) " " (int (-> m turns)) " " (int (-> m choice)) " " (int (-> m resized)))
  (p ([id "late"]) (when (-> m ready) "ready")))

(app model message init update page)
