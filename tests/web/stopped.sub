;; A game that traps on its twentieth step: the page stops and shows the report.
(require-unqualified vector std/web/game/vector)
(require-unqualified draw std/web/game/draw)
(require-unqualified input std/web/game/input)
(require-unqualified game std/web/game)

(struct world [steps u32] [numbers (vector u32)])

(define (start! [w (ptr world)]) (vector-push! (& (-> w numbers)) 1))

(define (step! [w (ptr world)] [in (ptr input)])
  (+= (-> w steps) 1)
  (when (== (-> w steps) 20) (vector-at (& (-> w numbers)) 5)))

(define (draw [w (ptr world)]) (fill-screen #x2e7d32ff))

(game world [size 64 36] start! step! draw)
