;; A page whose button divides by zero, which ends the program with a trap.
(require-unqualified web)

(struct model [n i32])
(variant message [crash])
(messages message)

(define (init [m (ptr model)]) (set! (-> m n) 0))

(define (update [m (ptr model)] [e (ptr message)]) (match e [crash (set! (-> m n) (/ 1 (-> m n)))]))

(view (page [m (ptr model)])
  (button ([on click crash]) "crash"))

(app model message init update page)
