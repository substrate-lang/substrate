;; A page whose button divides by zero, which ends the program with a trap.
(require-unqualified std/web/dom)

(define n i32 0)
(define click event-head)

(define (crashed [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32]) (set! n (/ 1 n)))

(define (main)
  (let ([page (dom-add! (dom-template "<button data-n>crash</button>") 0 0)])
    (set! (-> click handle) crashed)
    (dom-listen! (+ page 1) "click" (& click))
    (dom-flush!)))
