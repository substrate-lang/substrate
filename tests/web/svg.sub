;; A page that adds pieces to an svg element, where they become SVG elements, and to its foreignObject, where they
;; become HTML. Its button puts HTML in the svg element, which ends the program with a trap.
(require-unqualified std/web/dom)
(require-unqualified "plain.sub")

(define html string
  "<svg data-n width=\"100\" height=\"60\"><foreignObject data-n y=\"40\" width=\"100\" height=\"20\"></foreignObject></svg><p id=\"kinds\"><!--t--></p><button data-n>misplace</button>")

(define page u32 0)
(define click event-head)

(define (misplaced [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (dom-add! (dom-template "<div>misplaced</div>") (+ page 1) 0)
  (dom-flush!))

(define (main)
  (set! page (dom-add! (dom-template html) 0 0))
  (let ([dot (dom-add! (dom-template "<circle id=\"dot\" cx=\"10\" cy=\"10\" r=\"10\"></circle>") (+ page 1) 0)]
        [label (dom-add! (dom-template "<text id=\"label\" x=\"30\" y=\"20\"><!--t--></text>") (+ page 1) 0)]
        [inside (dom-add! (dom-template "<p id=\"inside\">inside</p>") (+ page 2) 0)])
    (show! (+ label 1) "drawn")
    (dom-flush!)
    (show! (+ page 3) "~a ~a ~a" (dom-read-text dot "namespaceURI") (dom-read-text label "namespaceURI")
           (dom-read-text inside "namespaceURI")))
  (set! (-> click handle) misplaced)
  (dom-listen! (+ page 4) "click" (& click))
  (dom-flush!))
