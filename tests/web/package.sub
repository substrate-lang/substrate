                 (net "127.0.0.1") (run "../../substrate/host/subhost.mjs")))
  (sites (sounds "sounds.sub" (html "../../packages/web/examples/platformer/index.html"))
         (sprites "sprites.sub" (html "sprites.html"))
         (sprites-canvas "sprites-canvas.sub" (html "sprites.html"))
