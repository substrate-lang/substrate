;; A page that reads its URL, pushes another, and hears the first again after going back.
(require-unqualified std/web/dom)
(require-unqualified host/events)
(require-unqualified host/web/location)
(require-unqualified "plain.sub")

(define back u32 0)
(define heard event-head)

(define (moved [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([text (events-take-text)])
    (show! back "~a" text)
    (free (-> text bytes))
    (dom-flush!)))

(define (main)
  (let ([page (dom-add! (dom-template "<p id=\"first\"><!--t--></p><p id=\"pushed\"><!--t--></p><p id=\"back\"><!--t--></p>")
                        0 0)])
    (set! back (+ page 3))
    (show! (+ page 1) "~a" (location-get))
    (location-push "?page=2" 0)
    (show! (+ page 2) "~a" (location-get))
    (set! (-> heard handle) moved)
    (location-listen (& heard))
    (location-back)
    (dom-flush!)))
