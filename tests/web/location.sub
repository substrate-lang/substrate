;; A page that shows the URL it was opened at, with buttons that assign, replace or reload the URL, go to a fragment,
;; and mark the page.
(require-unqualified std/web/dom)
(require-unqualified host/events)
(require-unqualified host/web/location)
(require-unqualified "plain.sub")

(struct button [head event-head] [act u32])

(define buttons (array button 5))
(define marked u32 0)

(define (pressed [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (case (-> (cast (ptr button) tag) act)
    [(0) (location-assign "?assigned" 0)]
    [(1) (location-replace "?replaced" 0)]
    [(2) (location-reload)]
    [(3) (location-assign "#part" 0)]
    [else
     (show! marked "marked")
     (dom-flush!)]))

(define (main)
  (let ([page (dom-add! (dom-template "<p id=\"at\"><!--t--></p><p id=\"mark\"><!--t--></p><button data-n>assign</button><button data-n>replace</button><button data-n>reload</button><button data-n>fragment</button><button data-n>mark</button>")
                        0 0)]
        [url (location-href)])
    (set! marked (+ page 2))
    (show! (+ page 1) "~a" url)
    (show! marked "fresh")
    (free (-> url bytes))
    (for ([k u32 0]) (< k 5) (+= k 1)
      (let ([b (& (@ buttons k))])
        (set! (-> b head handle) pressed)
        (set! (-> b act) k)
        (dom-listen! (+ page 3 k) "click" (cast (ptr void) b))))
    (dom-flush!)))
