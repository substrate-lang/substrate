;; A page using the location module: the URL, one pushed, and the first again as an event after going back.
(require-unqualified web "../../lib/web/web.sub")
(require-unqualified location "../../host/web/location.sub")

(struct model [first (ptr u8)] [pushed (ptr u8)] [back (ptr u8)])
(variant message [changed])
(messages message)

(define the-model (ptr model) 0)

(define (moved [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([e message changed])
    (set! (-> the-model back) (events-take-text))
    (send! (& e))))

(define (init [m (ptr model)])
  (set! the-model m)
  (set! (-> m first) (location-get))
  (location-push "?page=2" 0)
  (set! (-> m pushed) (location-get))
  (set! (-> m back) "")
  (event-handler! location-source moved)
  (location-back))

(define (update [m (ptr model)] [e (ptr message)]) (match e [changed (begin)]))

(view (page [m (ptr model)])
  (p ([id "first"]) (text (-> m first)))
  (p ([id "pushed"]) (text (-> m pushed)))
  (p ([id "back"]) (text (-> m back))))

(app model message init update page)
