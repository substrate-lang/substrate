;; A page that calls a method the browser refuses, which traps.
(require-unqualified std/web/dom)

(define (main)
  (let ([page (dom-add! (dom-template "<input type=\"checkbox\" data-n>") 0 0)])
    (dom-call-with! (+ page 1) "setSelectionRange" (slice (array-of dom-value (dom-number 0.0) (dom-number 1.0))))
    (dom-flush!)))
