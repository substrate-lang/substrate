;; A page with three buttons named save, two of which its stylesheet hides (hidden.html), and a count of the clicks on
;; the one it shows.
(require-unqualified std/web/dom)
(require-unqualified "plain.sub")

(define html string
  "<button class=\"gone\">save</button><button class=\"unseen\">save</button><button data-n>save</button><p id=\"saves\"><!--t--></p>")

(define saves u32 0)
(define shown u32 0)
(define click event-head)

(define (saved [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (+= saves 1)
  (show! shown "~a" saves)
  (dom-flush!))

(define (main)
  (let ([page (dom-add! (dom-template html) 0 0)])
    (set! shown (+ page 2))
    (set! (-> click handle) saved)
    (dom-listen! (+ page 1) "click" (& click))
    (show! shown "~a" saves)
    (dom-flush!)))
