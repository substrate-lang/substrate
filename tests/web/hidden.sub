;; A page with three buttons named save, two of which its stylesheet hides (hidden.html), and a count of the clicks on
;; the one it shows.
(require-unqualified web web)

(struct model [saves u32])
(variant message [saved])
(messages message)

(define (init [m (ptr model)]) (set! (-> m saves) 0))

(define (update [m (ptr model)] [e (ptr message)]) (match e [saved (+= (-> m saves) 1)]))

(view (page [m (ptr model)])
  (button ([class "gone"]) "save")
  (button ([class "unseen"]) "save")
  (button ([on click saved]) "save")
  (p ([id "saves"]) (int (-> m saves))))

(app model message init update page)
