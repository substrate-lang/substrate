;; An event that fires while the page is being updated: the first patches apply once.
(require-unqualified web std/web)

(struct model [turns u32] [focused u32] [blurred u32])
(variant message [turn] [got-focus] [lost-focus])
(messages message)

(define (init [m (ptr model)]) (set! (-> m turns) 0))

(define (update [m (ptr model)] [e (ptr message)])
  (match e
    [turn (+= (-> m turns) 1)]
    [got-focus (+= (-> m focused) 1)]
    [lost-focus (+= (-> m blurred) 1)]))

(view (page [m (ptr model)])
  (button ([id "turn"] [on click turn]) "turn")
  (input ([id "field"] [focus (-> m turns)] [on focus got-focus] [on blur lost-focus]))
  (p ([id "counts"]) (int (-> m turns)) " " (int (-> m focused)) " " (int (-> m blurred)))
  (when (> (-> m turns) 0) (span ([class "mark"]) "turned")))

(app model message init update page)
