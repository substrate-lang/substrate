;; An event that fires while the page is being updated: the first patches apply once.
(require-unqualified std/web/dom)
(require-unqualified "plain.sub")

(define html string "<button id=\"turn\" data-n>turn</button><input id=\"field\" data-n><p id=\"counts\"><!--t--></p>")

(define turns u32 0)
(define focused u32 0)
(define blurred u32 0)
(define page u32 0)
(define turn event-head)
(define focus event-head)
(define blur event-head)

(define (counted!)
  (show! (+ page 3) "~a ~a ~a" turns focused blurred)
  (dom-flush!))

(define (turned [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (+= turns 1)
  (dom-call! (+ page 2) "focus")
  (when (== turns 1) (dom-add! (dom-template "<span class=\"mark\">turned</span>") 0 0))
  (counted!))

(define (got-focus [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (+= focused 1)
  (counted!))

(define (lost-focus [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (+= blurred 1)
  (counted!))

(define (main)
  (set! page (dom-add! (dom-template html) 0 0))
  (set! (-> turn handle) turned)
  (set! (-> focus handle) got-focus)
  (set! (-> blur handle) lost-focus)
  (dom-listen! (+ page 1) "click" (& turn))
  (dom-listen! (+ page 2) "focus" (& focus))
  (dom-listen! (+ page 2) "blur" (& blur))
  (counted!))
