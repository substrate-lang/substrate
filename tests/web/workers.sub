;; A page that starts workers and logs their events. worker-main carries out the page's text commands, and own
;; prints and then calls dom, which a worker cannot have.
(require-unqualified std/web/dom)
(require-unqualified host/events)
(require-unqualified host/worker)
(require-unqualified host/fs)
(require-unqualified "plain.sub")

;; ---- the workers ----

(define total i64 0)
(define zero i32 0)

(define (starts? [s string] [prefix string]) -> bool
  (and (>= (-> s length) (-> prefix length)) (== (slice s 0 (-> prefix length)) prefix)))

(define (number [s string]) -> i64
  (let ([n i64 0] [i u32 0])
    (while (and (< i (-> s length)) (>= (@ s i) #\0) (<= (@ s i) #\9))
      (set! n (+ (* n 10) (- (@ s i) #\0)))
      (+= i 1))
    n))

(define (add-number! [b (ptr buffer)] [n i64])
  (when (>= n 10) (add-number! b (/ n 10)))
  (buffer-add-byte! b (cast i32 (+ #\0 (% n 10)))))

(define (add-error! [b (ptr buffer)] [why string])
  (let ([i u32 0])
    (while (and (< i (-> why length)) (!= (@ why i) 10)) (+= i 1))
    (buffer-add-string! b (slice why 0 i))))

(define (reply! [b (ptr buffer)])
  (worker-send 0 (buffer-bytes b))
  (buffer-free! b))

(define (reply-text! [s string]) (worker-send-text 0 s))

(define (write-line! [fd i32] [b (ptr buffer)])
  (buffer-add-byte! b 10)
  (host-write fd (buffer-bytes b))
  (buffer-free! b))

(define (worker-main)
  (event-handler! worker-source on-message)
  (trap-handler! worker-trapped)
  (let ([b (make-buffer)] [args (host-args)])
    (buffer-add-string! (& b) "a worker")
    (when (and (> (-> args length) 0) (> (-> (@ args 0) length) 0))
      (buffer-add-string! (& b) ", ")
      (buffer-add-string! (& b) (@ args 0)))
    (free (-> args items))
    (write-line! 1 (& b))))

(define (on-message [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (== kind worker-message)
    (let ([m (events-take-text)] [b (make-buffer)])
      (cond [(starts? m "add ")
             (+= total (number (slice m 4)))
             (buffer-add-string! (& b) "total ")
             (add-number! (& b) total)
             (reply! (& b))]
            [(starts? m "say ")
             (buffer-add-string! (& b) (slice m 4))
             (write-line! 1 (& b))
             (reply-text! "said")]
            [(starts? m "warn ")
             (buffer-add-string! (& b) (slice m 5))
             (write-line! 2 (& b))
             (reply-text! "warned")]
            [(starts? m "read ")
             (let* ([why error] [bytes (slice u8)])
               (if (fs-read-file (slice m 5) (& bytes) (& why))
                   (begin (buffer-add-string! (& b) "read ") (add-number! (& b) (-> bytes length)) (buffer-add-string! (& b) " bytes"))
                   (begin (buffer-add-string! (& b) "cannot read ") (add-error! (& b) (error-text (& why)))))
               (free (-> bytes items))
               (error-free! (& why))
               (reply! (& b)))]
            [(starts? m "write ")
             (let ([why error])
               (if (fs-write-file (slice m 6) (cast (slice u8) "written") (& why))
                   (buffer-add-string! (& b) "wrote")
                   (begin (buffer-add-string! (& b) "cannot write ") (add-error! (& b) (error-text (& why)))))
               (error-free! (& why))
               (reply! (& b)))]
            [(starts? m "trap") (reply-text! (if (== (/ 1 zero) 0) "no trap" "no trap"))]
            [(starts? m "loop") (while #t (+= total 0))]
            [(starts? m "grow ")
             (let ([most (* 2 (number (slice m 5)))] [n i64 0])
               (while (and (< n most) (!= (try-malloc 1048576) 0)) (+= n 1))
               (buffer-add-string! (& b) (if (< n most) "out of memory before " "allocated more than "))
               (add-number! (& b) (if (< n most) (number (slice m 5)) most))
               (buffer-add-string! (& b) " MiB")
               (reply! (& b)))]
            [(starts? m "worker")
             (let ([why error] [w u32 0])
               (if (worker-start worker-main (cast (slice u8) "") 0 0 (& w) (& why))
                   (buffer-add-string! (& b) "started a worker")
                   (begin
                     (buffer-add-string! (& b) "no worker: ")
                     (buffer-add-string! (& b) (error-text (& why)))
                     (error-free! (& why))))
               (reply! (& b)))]
            [(starts? m "exit ") (host-exit (cast i32 (number (slice m 5))) "")]
            [else (reply-text! "?")])
      (free (-> m bytes)))))

(define (worker-trapped [why string])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "trapped: ")
    (add-error! (& b) why)
    (reply! (& b))))

(define (own)
  (printf "own: started\n")
  (let ([n (dom-images-loading)])
    (printf "images loading: ~a\n" n)))

;; ---- the page ----

(define log buffer)
(define first-w u32 0)
(define second-w u32 0)
(define third-w u32 0)
(define own-w u32 0)
(define step u32 0)
(define ticks u32 0)
(define page u32 0)
(define ticking event-head)
(define stopping event-head)

(define (log! [s string]) (buffer-add-string! (& log) s))

(define (log-number! [n i32])
  (when (< n 0) (log! "-") (set! n (- 0 n)))
  (when (>= n 10) (log-number! (/ n 10)))
  (let ([digit (array u8 1)])
    (set! (@ digit 0) (cast u8 (+ #\0 (% n 10))))
    (log! (cast string (slice digit)))))

(define (command [step u32]) -> string
  (case step
    [(0) "add 5"]
    [(1) "add 37"]
    [(2) "say hello"]
    [(3) "warn careful"]
    [(4) "read /assets/note.txt"]
    [(5) "write /out/made.txt"]
    [(6) "read /out/made.txt"]
    [(7) "trap"]
    [(8) "add 1"]
    [(9) "worker"]
    [(10) "grow 32"]
    [(11) "add 1"]
    [(12) "exit 3"]
    [else ""]))

(define (send-next!)
  (let ([c (command step)])
    (when (> (-> c length) 0)
      (+= step 1)
      (worker-send-text first-w c))))

(define (start! [function (fn ())] [argument string] [time u32] [memory u32]) -> u32
  (let ([o worker-options] [why error] [w u32 0])
    (worker-options-init! (& o))
    (set! (-> o time) time)
    (set! (-> o memory) memory)
    (set! (-> o output) #t)
    (unless (worker-start function (cast (slice u8) argument) (& o) 0 (& w) (& why))
      (log! "no worker: ")
      (log! (error-text (& why)))
      (log! "\n")
      (error-free! (& why)))
    w))

(define (shown!)
  (show! (+ page 2) "~a" ticks)
  (show! (+ page 4) "~a" (buffer-string (& log)))
  (dom-flush!))

(define (log-event! [w u32] [kind u32] [value i32])
  (let ([data (events-take-text)])
    (log-number! (cast i32 w))
    (log! (cond [(== kind worker-message) " message"]
                [(== kind worker-stdout) " stdout"]
                [(== kind worker-stderr) " stderr"]
                [(== kind worker-done) " done"]
                [else " ended"]))
    (cond [(and (== kind worker-ended) (>= value 0))
           (log! ": exit ")
           (log-number! value)]
          [(> (-> data length) 0)
           (log! ": ")
           (log! data)])
    (let ([n (-> data length)])
      (when (or (== n 0) (!= (@ data (- n 1)) 10)) (log! "\n")))
    (free (-> data bytes))))

(define (worker-heard [source u32] [kind u32] [w u32] [tag (ptr void)] [value i32])
  (log-event! w kind value)
  (cond
    [(and (== w first-w) (== kind worker-message)) (send-next!)]
    [(and (== w first-w) (== kind worker-ended))
     (log! "send to worker 1 returned ")
     (log-number! (worker-send-text w "add 1"))
     (log! "\n")
     (set! second-w (start! worker-main "" 300 0))
     (worker-send-text second-w "loop")]
    [(and (== w second-w) (== kind worker-ended))
     (set! third-w (start! worker-main "" 0 0))
     (worker-send-text third-w "add 2")]
    [(and (== w third-w) (== kind worker-message))
     (worker-send-text third-w "loop")
     (log! "worker 3 is now looping\n")]
    [(and (== w own-w) (== kind worker-ended)) (log! "finished\n")])
  (shown!))

(define (ticked [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (+= ticks 1)
  (shown!))

(define (stopped [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (worker-stop third-w)
  (log! "stopped worker 3; send to it returned ")
  (log-number! (worker-send-text third-w "add 1"))
  (log! "\n")
  (set! own-w (start! own "" 0 0))
  (shown!))

(define (main)
  (set! page (dom-add! (dom-template "<button id=\"tick\" data-n>tick</button><span id=\"ticks\"><!--t--></span><button id=\"stop\" data-n>stop</button><pre id=\"log\"><!--t--></pre>")
                       0 0))
  (event-handler! worker-source worker-heard)
  (set! log (make-buffer))
  (set! (-> ticking handle) ticked)
  (set! (-> stopping handle) stopped)
  (dom-listen! (+ page 1) "click" (& ticking))
  (dom-listen! (+ page 3) "click" (& stopping))
  (set! first-w (start! worker-main "one" 5000 33554432))
  (send-next!)
  (shown!))
