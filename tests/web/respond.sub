;; A page that fetches a file the site does not have and a file from another origin, which its test answers.
(require-unqualified web)
(require-unqualified host/modules/fetch)
(require-unqualified host/stream)

(struct reply [head event-head] [status i32] [text (array u8 64)] [length u32])
(struct model [near reply] [far reply])
(variant message [changed])
(messages message)

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([r (cast (ptr reply) tag)] [e message changed])
    (cond [(and (== source fetch-source) (== kind fetch-head))
           (set! (-> r status) value)
           (stream-read! id (slice (-> r text)))]
          [(== source fetch-source) (set! (-> r status) -1)]
          [(and (== kind stream-read) (> value 0)) (set! (-> r length) (cast u32 value))])
    (send! (& e))))

(define (init [m (ptr model)])
  (set! (-> m near head handle) heard)
  (set! (-> m far head handle) heard)
  (fetch-get "data/answer.txt" (cast (ptr void) (& (-> m near))))
  (fetch-get "https://example.com/answer.txt" (cast (ptr void) (& (-> m far)))))

(define (update [m (ptr model)] [e (ptr message)]) (match e [changed (begin)]))

(view (page [m (ptr model)])
  (p ([id "near"]) (int (-> m near status)) (text " ") (text (cast string (slice (-> m near text) (-> m near length)))))
  (p ([id "far"]) (int (-> m far status)) (text " ") (text (cast string (slice (-> m far text) (-> m far length))))))

(app model message init update page)
