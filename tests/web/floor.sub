;; A page that uses the timer and fetch modules, which the default page grants.
(require-unqualified std/web/dom)
(require-unqualified host/modules/timer)
(require-unqualified host/modules/fetch)
(require-unqualified host/stream)
(require-unqualified "plain.sub")

(define head event-head)
(define fired i32 0)
(define status i32 0)
(define body (array u8 64))
(define got u32 0)
(define page u32 0)

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (cond [(== source timer-source) (+= fired 1)]
        [(== source fetch-source)
         (when (== kind fetch-head)
           (set! status value)
           (stream-read! id (slice body)))]
        [(and (== kind stream-read) (> value 0)) (set! got (cast u32 value))])
  (shown!)
  (dom-flush!))

(define (shown!)
  (show! (+ page 1) "~a" fired)
  (show! (+ page 2) "~a" status)
  (show! (+ page 3) "~a" (cast string (slice body got))))

(define (main)
  (set! page (dom-add! (dom-template "<p id=\"fired\"><!--t--></p><p id=\"status\"><!--t--></p><p id=\"text\"><!--t--></p>")
                       0 0))
  (set! (-> head handle) heard)
  (timer-after 10.0 (cast (ptr void) (& head)))
  (fetch-get "assets/note.txt" (cast (ptr void) (& head)))
  (shown!)
  (dom-flush!))
