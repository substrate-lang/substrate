;; A page using the timer and fetch modules, which the default page grants.
(require-unqualified web "../../lib/web/web.sub")
(require-unqualified timer "../../lib/timer.sub")
(require-unqualified fetch "../../lib/fetch.sub")
(require-unqualified stream "../../lib/stream.sub")

(struct model [head event-head] [fired i32] [status i32] [text (array u8 64)])
(variant message [changed])
(messages message)

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([m (cast (ptr model) tag)] [e message changed])
    (cond [(== source timer-source) (+= (-> m fired) 1)]
          [(== source fetch-source)
           (when (== kind fetch-head)
             (set! (-> m status) value)
             (stream-read! id (-> m text) 63))]
          [(== kind stream-read) (set! (@ (-> m text) (cast u32 value)) 0)])
    (send! (& e))))

(define (init [m (ptr model)])
  (set! (-> m head handle) heard)
  (timer-after 10.0 (cast (ptr void) m))
  (fetch-get "assets/note.txt" (cast (ptr void) m)))

(define (update [m (ptr model)] [e (ptr message)]) (match e [changed (begin)]))

(view (page [m (ptr model)])
  (p ([id "fired"]) (int (-> m fired)))
  (p ([id "status"]) (int (-> m status)))
  (p ([id "text"]) (text (-> m text))))

(app model message init update page)
