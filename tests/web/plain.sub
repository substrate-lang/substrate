;; For the test pages: show! sets a text node to what printf would print, and show-attr! an attribute.
(require-unqualified std/web/dom)
(provide show! show-attr!)

(begin-for-syntax
  (require-unqualified compiler/macros)

  (define (printed [s datum] [set datum] [format datum] [args datum]) -> datum
    #`(let* ([b (make-buffer)] [before (output-to! (& b))])
        (printf #,format #,@args)
        (output-to! before)
        (#,@set (buffer-string (& b)))
        (buffer-free! (& b))))

  (define (show-form [s datum]) -> datum
    (syntax-match s [(_ node format arg ...) (printed s #`(dom-set-text! #,node) format arg)]))

  (define (show-attr-form [s datum]) -> datum
    (syntax-match s [(_ node name format arg ...) (printed s #`(dom-set-attr! #,node #,name) format arg)])))

(define-syntax show! show-form)
(define-syntax show-attr! show-attr-form)
