;; The run's Chromium, driven through std/browser/devtools.sub.
(require-unqualified tests std/test/test)
(require-unqualified env host/node/env)
(require-unqualified json std/encoding/json)
(require-unqualified devtools std/browser/devtools)

(define connection devtools)

(define (unheard [d (ptr devtools)] [method string] [p (ptr json-value)] [session string]) (begin))

(define (starts? [s string] [start string]) -> bool
  (and (>= (-> s length) (-> start length)) (== (slice s 0 (-> start length)) start)))

(test version
  (let ([address string] [why string] [a (make-arena)] [r (ptr json-value) 0] [product string])
    (env-get "SUBSTRATE_DEVTOOLS" (& address) 0)
    (when (== (-> address length) 0) (throw test-skipped "need Chromium"))
    (unless (devtools-connect (& connection) address unheard 0 (& why)) (throw test-failed why))
    (unless (devtools-call (& connection) (& a) "Browser.getVersion" "" "" (& r) (& why)) (throw test-failed why))
    (json-as-string (json-get r "product") (& product))
    (expect (or (starts? product "Chrome/") (starts? product "HeadlessChrome/")))
    (expect (not (devtools-call (& connection) (& a) "No.such" "" "" (& r) (& why))))
    (expect-equal (slice why 0 9) "No.such: ")
    (devtools-close (& connection))))
