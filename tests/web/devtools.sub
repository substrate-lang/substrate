;; The run's Chromium, driven through std/browser/devtools.sub.
(require-unqualified std/test/test)
(require-unqualified host/node/env)
(require-unqualified std/encoding/json)
(require-unqualified std/browser/devtools)
(require-unqualified std/string)

(define connection devtools)

(define (unheard [d (ptr devtools)] [method string] [p (ptr json-value)] [session string]) (begin))

(test version
  (let ([address string] [why error] [a (make-arena)] [r (ptr json-value) 0] [product string])
    (env-get "SUBSTRATE_DEVTOOLS" (& address) 0)
    (when (== (-> address length) 0) (throw test-skipped "need Chromium"))
    (unless (devtools-connect (& connection) address unheard 0 (& why)) (throw test-failed (error-text (& why))))
    (unless (devtools-call (& connection) (& a) "Browser.getVersion" "" "" (& r) (& why))
      (throw test-failed (error-text (& why))))
    (json-as-string (json-get r "product") (& product))
    (expect (or (string-prefix? product "Chrome/") (string-prefix? product "HeadlessChrome/")))
    (expect (not (devtools-call (& connection) (& a) "No.such" "" "" (& r) (& why))))
    (expect-equal (slice (error-text (& why)) 0 9) "No.such: ")
    (devtools-close (& connection))))
