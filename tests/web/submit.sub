;; A form whose controls are named action and method. Each submission shows the query that the form submits with its
;; submitter, the form's action and method, and the submitter's formaction when it has one.
(require-unqualified std/web/dom)
(require-unqualified "plain.sub")

(define html string
  "<form id=\"form\" action=\"/find?old=1#top\" data-n><input name=\"action\" value=\"hidden\"><input id=\"method\" name=\"method\" value=\"x\"><textarea name=\"note\">a\nb</textarea><input type=\"checkbox\" name=\"tick\" checked><input type=\"checkbox\" name=\"untick\"><input name=\"off\" value=\"no\" disabled><select name=\"pick\" multiple><option selected>one</option><option>two</option><option selected>three</option></select><button name=\"go\" value=\"1\">Go</button><button name=\"alt\" value=\"2 &amp; 3\" formaction=\"/other\">Alt</button></form><p id=\"shown\"><!--t--></p>")

(define page u32 0)
(define submitting event-head)

(define (submitted [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([action (dom-read-text dom-event "currentTarget.action")] [method (dom-read-text dom-event "currentTarget.method")]
        [formaction (if (== (dom-call-number dom-event "submitter.hasAttribute" (dom-values (dom-text "formaction"))) 0.0)
                        "none"
                        (dom-read-text dom-event "submitter.formAction"))])
    (dom-call-now! dom-event "preventDefault" (dom-values))
    (show! (+ page 2) "~a|~a|~a|~a" (dom-form-data dom-event "currentTarget") action method formaction)
    (dom-flush!)))

(define (main)
  (set! page (dom-add! (dom-template html) 0 0))
  (set! (-> submitting handle) submitted)
  (dom-listen! (+ page 1) "submit" (& submitting))
  (dom-flush!))
