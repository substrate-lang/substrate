;; The server for the events page (tests/web/events.sub), on two ports so that the page sees two origins. It serves
;; files, an event stream at /events that resumes from the last id and then answers 204, and the routes the page's
;; cross-origin checks use. It prints the first origin's address once both ports listen.
(require-unqualified host/events)
(require-unqualified std/http)
(require-unqualified std/http/server)
(require-unqualified std/http/static)
(require-unqualified std/http/checks)
(require-unqualified std/http/sse)
(provide main)

(define server http-server)
(define other http-server)
(define files http-files)
(define cross http-cross-origin)
(define cors http-cors)
(define origins (array string 1))
(define list (array http-check 1))
(define refused u32 0)
(define here string "")
(define there string "")

(define (events! [r (ptr http-request)])
  (let ([last (http-request-header r "last-event-id")] [s (cast (ptr sse-stream) (calloc 1 (sizeof sse-stream)))])
    (set! (-> s compress) #t)
    (cond [(== last "3")
           (http-respond! r 204)
           (http-finish! r)]
          [(sse-accept! s r)
           (if (== last "2")
               (sse-send! s "" "3" "resumed after 2")
               (begin
                 (sse-retry! s 50)
                 (sse-send! s "" "1" "first")
                 (sse-send! s "named" "2" "a\nb")))
           (sse-close! s)])
    (free s)))

(define (handle [r (ptr http-request)])
  (let ([path (-> r target)])
    (cond [(== path "/events") (events! r)]
          [(== path "/guarded")
           (if (http-cross-origin-check r (& cross)) (+= refused 1) (http-answer-text! r 200 "posted"))]
          [(== path "/refused")
           (let ([b (make-buffer)])
             (write-digits (& b) refused 10)
             (http-answer-text! r 200 (buffer-string (& b)))
             (buffer-free! (& b)))]
          [(== path "/api") (http-answer-text! r 200 (if (== (-> r method) "PUT") "put" "not a put"))]
          [(== path "/other") (http-answer-text! r 200 there)]
          [else (http-static! r (& files))])))

(define (address [port u32] [slash bool]) -> string
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "http://127.0.0.1:")
    (http-add-decimal! (& b) (cast i64 port))
    (when slash (buffer-add-byte! (& b) #\/))
    (buffer-string (& b))))

;; Starts the second origin once the first listens, with CORS that lets in pages from the first.
(define (listening [s (ptr http-server)])
  (set! here (address (-> s port) #t))
  (set! (@ origins 0) (address (-> s port) #f))
  (set! (-> cors origins) (slice origins))
  (set! (-> cors credentials) #t)
  (set! (-> (& (@ list 0)) run) http-cors-check)
  (set! (-> (& (@ list 0)) settings) (cast (ptr void) (& cors)))
  (set! (-> other checks) (slice list))
  (set! (-> other compress) 6)
  (set! (-> other listening) other-listening)
  (http-serve! (& other) 0 handle 0))

(define (other-listening [s (ptr http-server)])
  (let ([line (make-buffer)])
    (set! there (address (-> s port) #t))
    (buffer-add-string! (& line) here)
    (buffer-add-byte! (& line) 10)
    (host-write 1 (buffer-bytes (& line)))
    (buffer-free! (& line))))

(define (main)
  (set! (-> files root) (@ (host-args) 0))
  (set! (-> server compress) 6)
  (set! (-> server listening) listening)
  (http-serve! (& server) 0 handle 0))
