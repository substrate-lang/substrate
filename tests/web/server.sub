;; The server for the events page (tests/web/events.sub), run twice by the page tests for two origins: a directory's
;; files; at /events an event stream that resumes from the last id it is given, until the client has every event, when
;; it answers 204; at /guarded a POST that cross-origin protection refuses from another origin, counted at /refused;
;; and at /api a PUT that CORS allows from the origin given after the directory, with credentials. It compresses its
;; answers, the event stream too, and prints its URL once it listens.
(require-unqualified events "../../host/events.sub")
(require-unqualified http "../../lib/http/http.sub")
(require-unqualified server "../../lib/http/server.sub")
(require-unqualified static "../../lib/http/static.sub")
(require-unqualified checks "../../lib/http/checks.sub")
(require-unqualified sse "../../lib/http/sse.sub")

(define server http-server)
(define files http-files)
(define cross http-cross-origin)
(define cors http-cors)
(define origins (array string 1))
(define list (array http-check 1))
(define refused u32 0)

(define (events! [r (ptr http-request)])
  (let ([last (http-request-header r "last-event-id")] [s (cast (ptr sse-stream) (calloc 1 (sizeof sse-stream)))])
    (set! (-> s compress) #t)
    (cond [(== last "3")
           (http-respond! r 204)
           (http-finish! r)]
          [(sse-accept! s r)
           (if (== last "2")
               (sse-send! s "" "3" "resumed after 2")
               (begin
                 (sse-retry! s 50)
                 (sse-send! s "" "1" "first")
                 (sse-send! s "named" "2" "a\nb")))
           (sse-close! s)])
    (free s)))

(define (handle [r (ptr http-request)])
  (let ([path (-> r target)])
    (cond [(== path "/events") (events! r)]
          [(== path "/guarded")
           (if (http-cross-origin-check r (& cross)) (+= refused 1) (http-answer-text! r 200 "posted"))]
          [(== path "/refused")
           (let ([b (make-buffer)])
             (write-digits (& b) refused 10)
             (http-answer-text! r 200 (buffer-string (& b)))
             (buffer-free! (& b)))]
          [(== path "/api") (http-answer-text! r 200 (if (== (-> r method) "PUT") "put" "not a put"))]
          [else (http-static! r (& files))])))

(define (listening [s (ptr http-server)])
  (let ([line (make-buffer)])
    (buffer-add-string! (& line) "http://127.0.0.1:")
    (http-add-decimal! (& line) (cast i64 (-> s port)))
    (buffer-add-string! (& line) "/\n")
    (host-write 1 (buffer-bytes (& line)))
    (buffer-free! (& line))))

(define (main)
  (let ([args (host-args)])
    (set! (-> files root) (@ args 0))
    (when (> (-> args length) 1)
      (set! (@ origins 0) (@ args 1))
      (set! (-> cors origins) (slice origins))
      (set! (-> cors credentials) #t)
      (set! (-> (& (@ list 0)) run) http-cors-check)
      (set! (-> (& (@ list 0)) settings) (cast (ptr void) (& cors)))
      (set! (-> server checks) (slice list)))
    (set! (-> server compress) 6)
    (set! (-> server listening) listening)
    (http-serve! (& server) 0 handle)))
