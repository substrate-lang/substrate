;; A page that reads the files picked on one click, and saves bytes as a file on another.
(require-unqualified std/web/dom)
(require-unqualified host/events)
(require-unqualified host/web/files)
(require-unqualified host/stream)
(require-unqualified "plain.sub")

(struct picked-file [reader stream-reader] [stream u32] [name string])

(define head event-head)
(define picking event-head)
(define saving event-head)
(define files (array picked-file 2))
(define count i32 0)
(define reading i32 0)
(define picked i32 0)
(define shown buffer)
(define page u32 0)

(define (shown!)
  (show! (+ page 3) "~a" picked)
  (show! (+ page 4) "~a" (buffer-string (& shown)))
  (dom-flush!))

(define (read-next!)
  (when (< reading count)
    (let ([f (& (@ files reading))])
      (stream-read-all! (& (-> f reader)) (-> f stream) read-done))))

(define (read-done [r (ptr stream-reader)])
  (let ([f (cast (ptr picked-file) r)] [before (output-to! (& shown))])
    (printf "~a ~a ~a\n" (-> f name) (-> r bytes length) (buffer-string (& (-> r bytes))))
    (output-to! before)
    (+= reading 1)
    (read-next!)
    (shown!)))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (cond [(== kind files-file)
         (let ([f (& (@ files count))])
           (set! (-> f name) (events-take-text))
           (set! (-> f stream) (cast u32 value))
           (+= count 1))]
        [(== kind files-picked)
         (set! picked value)
         (read-next!)]
        [else
         (let ([before (output-to! (& shown))])
           (printf "failed ~a\n" value)
           (output-to! before))])
  (shown!))

(define (pick [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (files-pick #t "" (cast (ptr void) (& head)) 0))

(define (save [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (files-save "saved.txt" (cast (slice u8) "saved bytes")))

(define (main)
  (set! page (dom-add! (dom-template "<button id=\"pick\" data-n>pick</button><button id=\"save\" data-n>save</button><p id=\"picked\"><!--t--></p><pre id=\"shown\"><!--t--></pre>")
                       0 0))
  (set! shown (make-buffer))
  (set! (-> head handle) heard)
  (set! (-> picking handle) pick)
  (set! (-> saving handle) save)
  (dom-listen! (+ page 1) "click" (& picking))
  (dom-listen! (+ page 2) "click" (& saving))
  (shown!))
