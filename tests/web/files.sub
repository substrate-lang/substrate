;; A page that reads the files picked on one click, and saves bytes as a file on another.
(require-unqualified web)
(require-unqualified host/web/files)
(require-unqualified host/stream)
(require-unqualified web/game/format)

(struct picked-file [reader stream-reader] [stream u32] [name string])
(struct model [head event-head] [files (array picked-file 2)] [count i32] [reading i32] [picked i32] [shown buffer])
(variant message [pick] [save] [changed])
(messages message)

(define the-model (ptr model) 0)

(define (read-next! [m (ptr model)])
  (when (< (-> m reading) (-> m count))
    (let ([f (& (@ (-> m files) (-> m reading)))])
      (stream-read-all! (& (-> f reader)) (-> f stream) read-done))))

(define (read-done [r (ptr stream-reader)])
  (let ([f (cast (ptr picked-file) r)] [m the-model] [e message changed])
    (buffer-add-format! (& (-> m shown)) "~s ~d ~s\n" (-> f name) (cast i32 (-> r bytes length)) (buffer-string (& (-> r bytes))))
    (+= (-> m reading) 1)
    (read-next! m)
    (send! (& e))))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([m (cast (ptr model) tag)] [e message changed])
    (cond [(== kind files-file)
           (let ([f (& (@ (-> m files) (-> m count)))])
             (set! (-> f name) (events-take-text))
             (set! (-> f stream) (cast u32 value))
             (+= (-> m count) 1))]
          [(== kind files-picked)
           (set! (-> m picked) value)
           (read-next! m)]
          [else (buffer-add-format! (& (-> m shown)) "failed ~d\n" value)])
    (send! (& e))))

(define (init [m (ptr model)])
  (set! the-model m)
  (set! (-> m head handle) heard)
  (set! (-> m shown) (make-buffer)))

(define (update [m (ptr model)] [e (ptr message)])
  (match e
    [pick (files-pick #t "" (cast (ptr void) m) 0)]
    [save (files-save "saved.txt" (cast (slice u8) "saved bytes"))]
    [changed (begin)]))

(view (page [m (ptr model)])
  (button ([id "pick"] [on click pick]) "pick")
  (button ([id "save"] [on click save]) "save")
  (p ([id "picked"]) (int (-> m picked)))
  (pre ([id "shown"]) (text (buffer-string (& (-> m shown))))))

(app model message init update page)
