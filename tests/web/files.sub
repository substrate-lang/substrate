;; A page using the files module: files picked on a click, each read whole in turn; and bytes saved on another.
(require-unqualified web "../../lib/web/web.sub")
(require-unqualified files "../../host/web/files.sub")
(require-unqualified stream "../../host/stream.sub")
(require-unqualified format "../../lib/web/game/format.sub")

(struct picked-file [reader stream-reader] [stream u32] [name (array u8 64)])
(struct model [head event-head] [files (array picked-file 2)] [count i32] [reading i32] [picked i32]
  [shown (array u8 256)] [length u32])
(variant message [pick] [save] [changed])
(messages message)

(define the-model (ptr model) 0)

(define (read-next! [m (ptr model)])
  (when (< (-> m reading) (-> m count))
    (let ([f (& (@ (-> m files) (-> m reading)))])
      (stream-read-all! (& (-> f reader)) (-> f stream) read-done))))

(define (read-done [r (ptr stream-reader)])
  (let ([f (cast (ptr picked-file) r)] [m the-model] [e message changed] [n (-> r bytes length)])
    (buffer-add-byte! (& (-> r bytes)) 0)
    (+= (-> m length) (format-into (+ (-> m shown) (-> m length)) (- 256 (-> m length)) "~s ~d ~s\n"
                                   (-> f name) (cast i32 n) (-> r bytes bytes)))
    (+= (-> m reading) 1)
    (read-next! m)
    (send! (& e))))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([m (cast (ptr model) tag)] [e message changed])
    (cond [(== kind files-file)
           (let* ([f (& (@ (-> m files) (-> m count)))] [n (events-take (-> f name) 63)])
             (set! (@ (-> f name) (if (> n 63) 63 n)) 0)
             (set! (-> f stream) (cast u32 value))
             (+= (-> m count) 1))]
          [(== kind files-picked)
           (set! (-> m picked) value)
           (read-next! m)]
          [else (+= (-> m length) (format-into (+ (-> m shown) (-> m length)) (- 256 (-> m length)) "failed ~d\n" value))])
    (send! (& e))))

(define (init [m (ptr model)])
  (set! the-model m)
  (set! (-> m head handle) heard))

(define (update [m (ptr model)] [e (ptr message)])
  (match e
    [pick (files-pick 1 "" (cast (ptr void) m))]
    [save (files-save "saved.txt" "saved bytes" 11)]
    [changed (begin)]))

(view (page [m (ptr model)])
  (button ([id "pick"] [on click pick]) "pick")
  (button ([id "save"] [on click save]) "save")
  (p ([id "picked"]) (int (-> m picked)))
  (pre ([id "shown"]) (text (-> m shown))))

(app model message init update page)
