;; A worker that carries out text commands from workers.sub and replies to each.
(require-unqualified worker "../../host/worker.sub")
(require-unqualified events "../../host/events.sub")
(require-unqualified fs "../../host/fs.sub")

(define total i64 0)
(define zero i32 0)

(define (starts? [s (ptr u8)] [prefix (ptr u8)]) -> i32
  (let ([n (strlen prefix)])
    (and (>= (strlen s) n) (== (memcmp s prefix n) 0))))

(define (number [s (ptr u8)]) -> i64
  (let ([n i64 0] [i u32 0])
    (while (and (>= (@ s i) #\0) (<= (@ s i) #\9))
      (set! n (+ (* n 10) (- (@ s i) #\0)))
      (+= i 1))
    n))

(define (add-number! [b (ptr buffer)] [n i64])
  (when (>= n 10) (add-number! b (/ n 10)))
  (buffer-add-byte! b (cast i32 (+ #\0 (% n 10)))))

(define (add-error! [b (ptr buffer)])
  (let* ([p (cast (ptr u8) (malloc 1024))] [n (cast u32 (host-error-message p 1024))] [i u32 0])
    (while (and (< i n) (!= (@ p i) 10)) (+= i 1))
    (buffer-add! b p i)
    (free p)))

(define (reply! [b (ptr buffer)])
  (worker-send 0 (-> b bytes) (-> b length))
  (buffer-free! b))

(define (reply-text! [s (ptr u8)]) (worker-send-text 0 s))

(define (write-line! [fd i32] [b (ptr buffer)])
  (buffer-add-byte! b 10)
  (host-write fd (-> b bytes) (cast i32 (-> b length)))
  (buffer-free! b))

(define (main)
  (let ([b (make-buffer)] [p (array u8 64)])
    (buffer-add-string! (& b) "a worker")
    (let ([n (host-arg 0 p 63)])
      (when (> n 0)
        (set! (@ p n) 0)
        (buffer-add-string! (& b) ", ")
        (buffer-add-string! (& b) p)))
    (write-line! 1 (& b))))

(define (on-event [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (and (== source worker-source) (== kind worker-message)) (on-message)))

(define (on-message)
  (let ([m (events-take-text)] [b (make-buffer)])
    (cond [(starts? m "add ")
           (+= total (number (+ m 4)))
           (buffer-add-string! (& b) "total ")
           (add-number! (& b) total)
           (reply! (& b))]
          [(starts? m "say ")
           (buffer-add-string! (& b) (+ m 4))
           (write-line! 1 (& b))
           (reply-text! "said")]
          [(starts? m "warn ")
           (buffer-add-string! (& b) (+ m 5))
           (write-line! 2 (& b))
           (reply-text! "warned")]
          [(starts? m "read ")
           (let* ([path (+ m 5)] [n (fs-read path (strlen path) 0 0)])
             (if (< n 0)
                 (begin (buffer-add-string! (& b) "cannot read ") (add-error! (& b)))
                 (begin (buffer-add-string! (& b) "read ") (add-number! (& b) n) (buffer-add-string! (& b) " bytes")))
             (reply! (& b)))]
          [(starts? m "write ")
           (let ([path (+ m 6)])
             (if (< (fs-write path (strlen path) "written" 7) 0)
                 (begin (buffer-add-string! (& b) "cannot write ") (add-error! (& b)))
                 (buffer-add-string! (& b) "wrote"))
             (reply! (& b)))]
          [(starts? m "trap") (reply-text! (if (== (/ 1 zero) 0) "no trap" "no trap"))]
          [(starts? m "loop") (while 1 (+= total 0))]
          [(starts? m "grow ")
           (let ([most (* 2 (number (+ m 5)))] [n i64 0])
             (while (and (< n most) (!= (malloc 1048576) 0)) (+= n 1))
             (buffer-add-string! (& b) (if (< n most) "out of memory before " "allocated more than "))
             (add-number! (& b) (if (< n most) (number (+ m 5)) most))
             (buffer-add-string! (& b) " MiB")
             (reply! (& b)))]
          [(starts? m "worker")
           (let ([w (worker-start "main" "" 0 0)] [why (worker-error)])
             (buffer-add-string! (& b) (if (== w 0) "no worker: " "started a worker: "))
             (buffer-add-string! (& b) why)
             (free why)
             (reply! (& b)))]
          [(starts? m "exit ") (host-exit (cast i32 (number (+ m 5))))]
          [else (reply-text! "?")])
    (free m)))

(define (on-trap) (reset-stack!) (after-trap))

(define (after-trap)
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "trapped: ")
    (add-error! (& b))
    (reply! (& b))))
