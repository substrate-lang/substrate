;; A page with form fields. It shows what their events carry, and sets attributes from what is typed and ticked.
(require-unqualified std/web/dom)
(require-unqualified "plain.sub")

(define html string
  "<input id=\"field\" type=\"text\" maxlength=\"12\" autofocus data-n><input id=\"box\" type=\"checkbox\" data-n><button id=\"send\" disabled data-n>send</button><my-part id=\"part\" data-n>own</my-part><textarea id=\"area\" rows=\"2\" data-n></textarea><p id=\"shown\"><!--t--></p><table><tr><td id=\"cell\" colspan=\"1\" data-n>cell</td></tr></table>")

(define typed string "")
(define key string "")
(define shift bool #f)
(define control bool #f)
(define sent u32 0)
(define own u32 0)
(define page u32 0)
(define typing event-head)
(define pressing event-head)
(define ticking event-head)
(define sending event-head)
(define owning event-head)

(define (shown!)
  (show! (+ page 6) "~a|~a~a~a|~a|~a" typed key (if shift "+shift" "") (if control "+control" "") sent own)
  (dom-flush!))

(define (typed-in [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (free (-> typed bytes))
  (set! typed (string-copy (dom-read-text dom-event "target.value")))
  (show-attr! (+ page 7) "colspan" "~a" (+ (-> typed length) 1))
  (shown!))

(define (pressed [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (free (-> key bytes))
  (set! key (string-copy (dom-read-text dom-event "key")))
  (set! shift (!= (dom-read-number dom-event "shiftKey") 0.0))
  (set! control (!= (dom-read-number dom-event "ctrlKey") 0.0))
  (shown!))

(define (ticked [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (if (!= (dom-read-number dom-event "target.checked") 0.0)
      (begin
        (dom-set-attr! (+ page 2) "checked" "")
        (dom-remove-attr! (+ page 3) "disabled"))
      (begin
        (dom-remove-attr! (+ page 2) "checked")
        (dom-set-attr! (+ page 3) "disabled" "")))
  (shown!))

(define (sent-it [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (+= sent 1)
  (shown!))

(define (owned [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (+= own 1)
  (shown!))

(define (main)
  (set! page (dom-add! (dom-template html) 0 0))
  (set! typed (string-copy ""))
  (set! key (string-copy ""))
  (set! (-> typing handle) typed-in)
  (set! (-> pressing handle) pressed)
  (set! (-> ticking handle) ticked)
  (set! (-> sending handle) sent-it)
  (set! (-> owning handle) owned)
  (dom-listen! (+ page 1) "input" (& typing))
  (dom-listen! (+ page 1) "keydown" (& pressing))
  (dom-listen! (+ page 2) "change" (& ticking))
  (dom-listen! (+ page 3) "click" (& sending))
  (dom-listen! (+ page 4) "my-event" (& owning))
  (dom-set-attr! (+ page 5) "value" "kept")
  (shown!))
