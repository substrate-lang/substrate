;; A page with form fields: event data in messages, and typed attributes.
(require-unqualified web std/web)

(struct model [typed string] [key string] [shift bool] [control bool] [on bool] [sent u32] [own u32])
(variant message [typed [text string]] [pressed [key string] [shift bool] [control bool]] [boxed [on bool]] [send] [own])
(messages message)

(define (copy-text [s string]) -> string
  (let ([p (cast (ptr u8) (malloc (+ (-> s length) 1)))])
    (memcpy p (-> s bytes) (-> s length))
    (cast string (slice p (-> s length)))))

(define (init [m (ptr model)])
  (set! (-> m typed) (copy-text ""))
  (set! (-> m key) (copy-text "")))

(define (update [m (ptr model)] [e (ptr message)])
  (match e
    [(typed text)
     (free (-> m typed bytes))
     (set! (-> m typed) (copy-text text))]
    [(pressed key shift control)
     (free (-> m key bytes))
     (set! (-> m key) (copy-text key))
     (set! (-> m shift) shift)
     (set! (-> m control) control)]
    [(boxed on) (set! (-> m on) on)]
    [send (+= (-> m sent) 1)]
    [own (+= (-> m own) 1)]))

(view (page [m (ptr model)])
  (input ([id "field"] [type "text"] [maxlength 12] [autofocus]
          [on input (typed (event value))]
          [on keydown (pressed (event key) (event shift) (event control))]))
  (input ([id "box"] [type "checkbox"] [checked (-> m on)] [on change (boxed (event checked))]))
  (button ([id "send"] [disabled (not (-> m on))] [on click send]) "send")
  (my-part ([id "part"] [on "my-event" own]) "own")
  (textarea ([id "area"] [value "kept"] [rows 2]))
  (p ([id "shown"])
    (text (-> m typed)) "|" (text (-> m key)) (if (-> m shift) "+shift" "") (if (-> m control) "+control" "")
    "|" (int (-> m sent)) "|" (int (-> m own)))
  (table (tr (td ([id "cell"] [colspan (+ (-> m typed length) 1)]) "cell"))))

(app model message init update page)
