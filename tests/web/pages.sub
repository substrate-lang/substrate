(define (joined [a string] [b string]) -> string
  (let ([out (make-buffer)])
    (buffer-add-string! (& out) a)
    (buffer-add-string! (& out) b)
    (buffer-string (& out))))

(define (without-backtraces [text string]) -> string
  (let ([out (make-buffer)] [start u32 0])
    (for ([i u32 0]) (<= i (-> text length)) (+= i 1)
      (when (or (== i (-> text length)) (== (@ text i) 10))
        (let ([line (slice text start i)])
          (unless (and (>= (-> line length) 4) (== (slice line 0 4) "    "))
            (buffer-add-string! (& out) line)
            (when (< i (-> text length)) (buffer-add-byte! (& out) 10))))
        (set! start (+ i 1))))
    (buffer-string (& out))))

(test workers
  (with-page (p "workers.sub")
    (expect-count p (by-text-containing "2 stdout: a worker 2 done") 1)
    (expect-equal (without-backtraces (page-text p (by-css "#log"))) first-worker)
    (page-advance! p 300)
    (expect-count p (by-text-containing "worker 3 is now looping 3 done") 1)
    (expect-equal (without-backtraces (page-text p (by-css "#log"))) (joined first-worker looping))
    (page-click! p (by-role "button" "tick"))
    (page-click! p (by-role "button" "tick"))
    (expect-text p (by-css "#ticks") "2")
    (page-click! p (by-role "button" "stop"))
    (expect-count p (by-text-containing "finished") 1)
    (expect-equal (without-backtraces (page-text p (by-css "#log"))) (joined (joined first-worker looping) stopped))))

(test canvas
  (with-page (p "canvas.sub")
    (expect-text p (by-css "#shown") "0,0 clicks 0 frames 0 keys 0")
    (expect-equal (page-drawing p (by-css "#board")) "fill-style \"white\"\nfill-rect 0 0 200 100")
    (page-click! p (by-css "#board"))
    (expect-text p (by-css "#shown") "100,50 clicks 1 frames 0 keys 0")
    (expect-equal (page-drawing p (by-css "#board"))
                  "fill-style \"white\"\nfill-rect 0 0 200 100\nfill-style \"red\"\nfill-rect 95 45 10 10")
    (page-click-at! p (by-css "#board") 20 30)
    (expect-text p (by-css "#shown") "20,30 clicks 2 frames 0 keys 0")
    (page-press! p "a")
    (expect-text p (by-css "#shown") "20,30 clicks 2 frames 0 keys 0")
    (page-click! p (by-role "button" "toggle"))
    (page-advance! p 100)
    (page-press! p "a")
    (page-press! p "ArrowUp")
    (expect-text p (by-css "#shown") "20,30 clicks 2 frames 6 keys 2")
    (page-click! p (by-role "button" "toggle"))
    (page-advance! p 150)
    (page-press! p "a")
    (expect-text p (by-css "#shown") "20,30 clicks 2 frames 6 keys 2")
    (page-click! p (by-role "button" "toggle"))
    (page-advance! p 50)
    (page-press! p "a")
    (expect-text p (by-css "#shown") "20,30 clicks 2 frames 9 keys 3")))
