;; The pages of the web host's tests, used as a user would use them, in the simulated browser.
(require-unqualified page std/test/page)

(test fields
  (with-page (p "fields.sub")
    (expect-text p (by-css "#shown") "||0|0")
    (expect-html p (by-css "#field") "<input id=\"field\" type=\"text\" maxlength=\"12\" autofocus=\"\">")
    (expect-attribute p (by-role "button" "send") "disabled" "")
    (expect-attribute p (by-css "#cell") "colspan" "1")
    (expect-value p (by-css "#area") "kept")
    (page-click! p (by-role "button" "send"))
    (expect-text p (by-css "#shown") "||0|0")
    (page-type! p (by-css "#field") "abc")
    (expect-text p (by-css "#shown") "abc|c|0|0")
    (expect-attribute p (by-css "#cell") "colspan" "4")
    (page-press! p "Shift+Enter")
    (expect-text p (by-css "#shown") "abc|Enter+shift|0|0")
    (page-press! p "Control+ArrowUp")
    (expect-text p (by-css "#shown") "abc|ArrowUp+control|0|0")
    (page-press! p "ArrowDown")
    (expect-text p (by-css "#shown") "abc|ArrowDown|0|0")
    (page-click! p (by-css "#box"))
    (expect-no-attribute p (by-role "button" "send") "disabled")
    (expect-checked p (by-css "#box") #t)
    (page-click! p (by-role "button" "send"))
    (expect-text p (by-css "#shown") "abc|ArrowDown|1|0")
    (page-click! p (by-css "#box"))
    (expect-attribute p (by-role "button" "send") "disabled" "")
    (expect-checked p (by-css "#box") #f)
    (page-fire! p (by-css "#part") "my-event")
    (expect-text p (by-css "#shown") "abc|ArrowDown|1|1")))

(test fields-typing
  (with-page (p "fields.sub")
    (expect-count p (by-css "#field:focus") 1)
    (page-type! p (by-css "#field") "abcdefghijklmnop")
    (expect-value p (by-css "#field") "abcdefghijkl")
    (page-press! p "Backspace")
    (expect-value p (by-css "#field") "abcdefghijk")
    (expect-text p (by-css "#shown") "abcdefghijk|Backspace|0|0")
    (page-type! p (by-css "#area") "\nmore")
    (expect-value p (by-css "#area") "kept\nmore")))

(test focus
  (with-page (p "focus.sub")
    (expect-text p (by-css "#counts") "0 0 0")
    (page-click! p (by-role "button" "turn"))
    (expect-text p (by-css "#counts") "1 1 0")
    (expect-count p (by-css "#field:focus") 1)
    (expect-count p (by-css "span.mark") 1)
    (page-click! p (by-role "button" "turn"))
    (expect-text p (by-css "#counts") "2 2 1")
    (expect-count p (by-css "span.mark") 1)))

(test storage
  (with-page (p "storage.sub")
    (expect-text p (by-css "#step") "6")
    (expect-text p (by-css "#log") "2 0 \n1 1 hello\n1 0 \n3 1 greeting\n2 0 \n1 0 \n")))

(test location
  (with-page (p "location.sub")
    (expect-text p (by-css "#first") "http://localhost/index.html")
    (expect-text p (by-css "#pushed") "http://localhost/index.html?page=2")
    (expect-text p (by-css "#back") "http://localhost/index.html")
    (expect-equal (page-url p) "http://localhost/index.html")
    (page-go! p "?from=go")
    (expect-text p (by-css "#first") "http://localhost/index.html?from=go")))

(test location-url
  (with-page (p "location.sub" #:url "?from=test")
    (expect-text p (by-css "#first") "http://localhost/index.html?from=test")))

(test floor
  (with-page (p "floor.sub")
    (expect-text p (by-css "#text") "An asset, read as a file.")
    (expect-text p (by-css "#status") "200")
    (expect-text p (by-css "#fired") "0")
    (page-advance! p 10)
    (expect-text p (by-css "#fired") "1")
    (expect-equal (page-console p) "")))

(test assets
  (with-page (p "assets.sub")
    (expect-text p (by-css "#note") "An asset, read as a file.")
    (expect-text p (by-css "#nested") "An asset in a folder.")
    (expect-text p (by-css "#missing") "no such file")
    (expect-text p (by-css "#written") "written and read back")
    (expect-text p (by-css "#opened") "hello.....wo, asset, r, refused")
    (page-advance! p 100)
    (expect-equal (page-drawing p (by-css "#board"))
                  "fill-style \"white\"\nfill-rect 0 0 16 16\ndraw-image \"/assets/red.png\" 0 0 4 4 6 6 4 4")
    (expect-equal (page-console p) "dom: cannot load the image assets/nothing.png")))

(test clipboard
  (with-page (p "clipboard.sub")
    (page-click! p (by-role "button" "copy"))
    (expect-text p (by-css "#shown") "read: copied text")
    (expect-equal (page-clipboard-get p) "copied text")))

(test files
  (with-page (p "files.sub")
    (page-choose-files! p "assets/note.txt" "assets/levels/level #1.txt")
    (page-click! p (by-role "button" "pick"))
    (expect-text p (by-css "#picked") "2")
    (expect-text p (by-css "#shown") "note.txt 25 An asset, read as a file.\nlevel #1.txt 21 An asset in a folder.\n")
    (page-click! p (by-role "button" "pick"))
    (expect-text p (by-css "#shown") "note.txt 25 An asset, read as a file.\nlevel #1.txt 21 An asset in a folder.\nfailed 6\n")
    (page-click! p (by-role "button" "save"))
    (expect-equal (page-downloaded p "saved.txt") "saved bytes")))

(test canvas
  (with-page (p "canvas.sub")
    (expect-text p (by-css "#shown") "0,0 clicks 0 frames 0 keys 0")
    (expect-equal (page-drawing p (by-css "#board")) "fill-style \"white\"\nfill-rect 0 0 200 100")
    (page-click! p (by-css "#board"))
    (expect-text p (by-css "#shown") "100,50 clicks 1 frames 0 keys 0")
    (expect-equal (page-drawing p (by-css "#board"))
                  "fill-style \"white\"\nfill-rect 0 0 200 100\nfill-style \"red\"\nfill-rect 95 45 10 10")
    (page-click-at! p (by-css "#board") 20 30)
    (expect-text p (by-css "#shown") "20,30 clicks 2 frames 0 keys 0")
    (page-press! p "a")
    (expect-text p (by-css "#shown") "20,30 clicks 2 frames 0 keys 0")
    (page-click! p (by-role "button" "toggle"))
    (page-advance! p 100)
    (page-press! p "a")
    (page-press! p "ArrowUp")
    (expect-text p (by-css "#shown") "20,30 clicks 2 frames 6 keys 2")
    (page-click! p (by-role "button" "toggle"))
    (page-advance! p 150)
    (page-press! p "a")
    (expect-text p (by-css "#shown") "20,30 clicks 2 frames 6 keys 2")
    (page-click! p (by-role "button" "toggle"))
    (page-advance! p 50)
    (page-press! p "a")
    (expect-text p (by-css "#shown") "20,30 clicks 2 frames 9 keys 3")))
