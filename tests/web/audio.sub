;; A page that plays a sound with the host module audio: looping until it is stopped, and once. A sound the site does
;; not have fails to load.
(require-unqualified std/web/dom)
(require-unqualified host/web/audio)

(define voice i32 0)
(define playing event-head)
(define stopping event-head)
(define once event-head)

(define (played [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32]) (set! voice (audio-play 1 0.3 1.0 1)))

(define (stopped [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32]) (audio-stop voice))

(define (played-once [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32]) (audio-play 1 0.5 1.0 0))

(define (loaded! [id i32] [path string]) (audio-load id (cast i32 (-> path bytes)) (cast i32 (-> path length))))

(define (main)
  (let ([page (dom-add! (dom-template "<button data-n>play</button><button data-n>stop</button><button data-n>once</button>")
                        0 0)])
    (loaded! 1 "assets/beep.wav")
    (loaded! 2 "assets/nothing.wav")
    (set! (-> playing handle) played)
    (set! (-> stopping handle) stopped)
    (set! (-> once handle) played-once)
    (dom-listen! (+ page 1) "click" (& playing))
    (dom-listen! (+ page 2) "click" (& stopping))
    (dom-listen! (+ page 3) "click" (& once))
    (dom-flush!)))
