;; A page that plays a sound through the host module audio. One button starts it looping, one stops it, and one plays
;; it once. The page also asks for a sound the site does not have, which fails to load.
(require-unqualified std/web/dom)
(require-unqualified host/web/audio)
(require-unqualified "plain.sub")

(define beep u32 0)
(define voice i32 0)
(define page u32 0)
(define playing event-head)
(define stopping event-head)
(define once event-head)
(define loads event-head)

(define (played [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (set! voice (audio-play (cast i32 beep) 0.3 1.0 1)))

(define (stopped [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32]) (audio-stop voice))

(define (played-once [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32]) (audio-play (cast i32 beep) 0.5 1.0 0))

(define (loaded [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (show! (+ page (if (== id beep) 4 5)) "~a" (if (== kind audio-loaded) "loaded" "failed"))
  (dom-flush!))

(define (main)
  (set! page (dom-add! (dom-template "<button data-n>play</button><button data-n>stop</button><button data-n>once</button><p id=\"beep\"><!--t--></p><p id=\"nothing\"><!--t--></p>")
                       0 0))
  (set! (-> loads handle) loaded)
  (set! beep (audio-load "assets/beep.wav" (& loads)))
  (audio-load "assets/nothing.wav" (& loads))
  (set! (-> playing handle) played)
  (set! (-> stopping handle) stopped)
  (set! (-> once handle) played-once)
  (dom-listen! (+ page 1) "click" (& playing))
  (dom-listen! (+ page 2) "click" (& stopping))
  (dom-listen! (+ page 3) "click" (& once))
  (dom-flush!))
