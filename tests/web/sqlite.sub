(package sqlite-page
  (version "0.1.0")
  (dependencies (sqlite (path "../../packages/sqlite"))))
;; A page with SQLite: a database in the page's files, written, closed, and read again.
(require-unqualified web std/web)
(require-unqualified sqlite sqlite)

(struct model [version string] [rows string] [error string])
(variant message [none])
(messages message)

(define (init [m (ptr model)])
  (let ([why string] [db (sqlite-open "notes.db" 0)] [b (make-buffer)] [st (ptr sqlite-statement) 0])
    (set! (-> m version) (sqlite-version))
    (set! (-> m error) "")
    (when (< (sqlite-exec db "create table notes (s text); insert into notes values ('one'), ('two'), ('three')" (& why)) 0)
      (set! (-> m error) why))
    (sqlite-close db)
    (set! db (sqlite-open "notes.db" 0))
    (set! st (sqlite-prepare db "select count(*), group_concat(s, ' ') from notes" (& why)))
    (when (== st 0) (set! (-> m error) why))
    (when (== (sqlite-step st 0) sqlite-row)
      (write-digits (& b) (cast u64 (sqlite-column-i64 st 0)) 10)
      (buffer-add-byte! (& b) 32)
      (buffer-add-string! (& b) (sqlite-column-text st 1)))
    (sqlite-finalize st)
    (sqlite-close db)
    (set! (-> m rows) (buffer-string (& b)))))

(define (update [m (ptr model)] [e (ptr message)]) (match e [none (begin)]))

(view (page [m (ptr model)])
  (p ([id "version"]) (text (-> m version)))
  (p ([id "rows"]) (text (-> m rows)))
  (p ([id "error"]) (text (-> m error))))

(app model message init update page)
