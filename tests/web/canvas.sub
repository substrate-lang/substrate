;; A page for canvas drawing, window listeners and animation frames.
(require-unqualified std/web/dom)
(require-unqualified std/web/canvas)
(require-unqualified "plain.sub")

(define html string
  "<canvas id=\"board\" width=\"200\" height=\"100\" data-n></canvas><button id=\"toggle\" data-n>toggle</button><p id=\"shown\" data-n><!--t--></p>")

(define x i32 0)
(define y i32 0)
(define clicks u32 0)
(define frames u32 0)
(define keys u32 0)
(define page u32 0)
(define label u32 0)
(define label-template u32 0)
(define pointing event-head)
(define toggling event-head)
(define ticking event-head)
(define pressing event-head)

(define (shown!)
  (show! (+ page 4) "~a,~a clicks ~a frames ~a keys ~a" x y clicks frames keys)
  (dom-flush!))

(define (paint!)
  (canvas-begin! (+ page 1))
  (canvas-fill-style! "white")
  (canvas-fill-rect! 0 0 200 100)
  (when (> clicks 0)
    (canvas-fill-style! "red")
    (canvas-fill-rect! (- x 5) (- y 5) 10 10))
  (canvas-end!))

(define (pointed [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (set! x (cast i32 (dom-event-number dom-x)))
  (set! y (cast i32 (dom-event-number dom-y)))
  (+= clicks 1)
  (paint!)
  (shown!))

(define (toggled [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (if (== label 0)
      (begin
        (set! label (dom-add! label-template 0 (+ page 3)))
        (dom-listen-window! (+ label 1) "frame" (& ticking))
        (dom-listen-window! (+ label 1) "keydown" (& pressing)))
      (begin
        (dom-remove! label label-template)
        (set! label 0)))
  (shown!))

(define (ticked [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (> (dom-event-number dom-time) 0.0) (+= frames 1))
  (shown!))

(define (pressed [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (+= keys 1)
  (shown!))

(define (main)
  (set! page (dom-add! (dom-template html) 0 0))
  (set! label-template (dom-template "<span id=\"label\" data-n>animating</span>"))
  (set! (-> pointing handle) pointed)
  (set! (-> toggling handle) toggled)
  (set! (-> ticking handle) ticked)
  (set! (-> pressing handle) pressed)
  (dom-listen! (+ page 1) "click" (& pointing))
  (dom-listen! (+ page 2) "click" (& toggling))
  (paint!)
  (shown!))
