;; A page for canvas drawing, window listeners and animation frames.
(require-unqualified web)
(require-unqualified web/canvas)

(struct model [x i32] [y i32] [clicks u32] [frames u32] [keys u32] [animating bool])
(variant message [pointed [x i32] [y i32]] [tick [time f64]] [pressed] [toggle])
(messages message)

(define (init [m (ptr model)]) 0)

(define (update [m (ptr model)] [e (ptr message)])
  (match e
    [(pointed x y)
     (set! (-> m x) x)
     (set! (-> m y) y)
     (+= (-> m clicks) 1)]
    [(tick time) (when (> time 0.0) (+= (-> m frames) 1))]
    [pressed (+= (-> m keys) 1)]
    [toggle (set! (-> m animating) (not (-> m animating)))]))

(define (paint [m (ptr model)])
  (fill-style "white")
  (fill-rect 0 0 200 100)
  (when (> (-> m clicks) 0)
    (fill-style "red")
    (fill-rect (- (-> m x) 5) (- (-> m y) 5) 10 10)))

(view (page [m (ptr model)])
  (canvas ([id "board"] [width 200] [height 100]
           [draw (-> m clicks) (paint m)]
           [on click (pointed (event x) (event y))]))
  (button ([id "toggle"] [on click toggle]) "toggle")
  (when (-> m animating)
    (span ([id "label"]
           [on-window frame (tick (event time))]
           [on-window keydown pressed])
      "animating"))
  (p ([id "shown"])
    (int (-> m x)) "," (int (-> m y)) " clicks " (int (-> m clicks))
    " frames " (int (-> m frames)) " keys " (int (-> m keys))))

(app model message init update page)
