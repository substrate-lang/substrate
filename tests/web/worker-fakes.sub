;; A page that starts a worker with a fake clock and timer. The worker's timer of 5 s fires at once, and the worker tells
;; the page the time on its clocks then.
(require-unqualified web web)
(require-unqualified worker host/worker)
(require-unqualified grants host/grants)
(require-unqualified clock host/modules/clock)
(require-unqualified timer host/modules/timer)

(struct model [log buffer])
(variant message [worker-event [kind u32]])
(messages message)

;; ---- the worker ----

(define head event-head)

(define (fired [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([b (make-buffer)])
    (write-digits (& b) (cast u64 (clock-monotonic)) 10)
    (buffer-add-byte! (& b) 32)
    (write-digits (& b) (cast u64 (clock-now)) 10)
    (worker-send 0 (buffer-bytes (& b)))
    (buffer-free! (& b))))

(define (ticking)
  (set! (-> head handle) fired)
  (timer-after 5000.0 (cast (ptr void) (& head))))

;; ---- the page ----

(define (init [m (ptr model)])
  (let ([o worker-options] [why string])
    (event-handler! worker-source worker-heard)
    (set! (-> m log) (make-buffer))
    (worker-options-init! (& o))
    (grants-fake! (& (-> o grants)) "clock")
    (grants-fake! (& (-> o grants)) "timer")
    (when (== (worker-start ticking (cast (slice u8) "") (& o) 0 (& why)) 0)
      (buffer-add-string! (& (-> m log)) why))))

(define (update [m (ptr model)] [e (ptr message)])
  (match e
    [(worker-event kind)
     (when (== kind worker-message)
       (let ([data (events-take-text)])
         (buffer-add-string! (& (-> m log)) data)
         (free (-> data bytes))))]))

(define (worker-heard [source u32] [kind u32] [w u32] [tag (ptr void)] [value i32])
  (let ([e message (worker-event kind)])
    (send! (& e))))

(view (page [m (ptr model)])
  (p ([id "fired"]) (text (buffer-string (& (-> m log))))))

(app model message init update page)
