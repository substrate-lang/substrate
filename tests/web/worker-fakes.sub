;; A page starts a worker with a fake clock, timer, fetch and websocket. The worker sets a 5-second timer, which fires
;; at once. It then sends the page the time on both clocks, the status and text of one of the page's files, the status
;; of a missing file, and the echo of a message.
(require-unqualified web)
(require-unqualified host/worker)
(require-unqualified host/grants)
(require-unqualified host/stream)
(require-unqualified host/modules/clock)
(require-unqualified host/modules/timer)
(require-unqualified host/modules/fetch)
(require-unqualified host/modules/websocket)

(struct model [log buffer])
(variant message [worker-event [kind u32]])
(messages message)

;; ---- the worker ----

(define head event-head)
(define said buffer)
(define body stream-reader)

(define (number! [n u64])
  (write-digits (& said) n 10)
  (buffer-add-byte! (& said) 32))

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (cond [(== source timer-source)
         (number! (cast u64 (clock-monotonic)))
         (number! (cast u64 (clock-now)))
         (fetch-get "/assets/note.txt" (& head))]
        [(== source fetch-source)
         (number! (cast u64 value))
         (when (== value 200) (stream-read-all! (& body) id fetched))
         (when (== value 404) (websocket-connect "ws://fake/echo" 0 (& head) 0))]
        [(== kind websocket-open) (websocket-send-text id "echo")]
        [(== kind websocket-message)
         (let ([m (events-take-text)])
           (buffer-add-string! (& said) m)
           (free (-> m bytes))
           (worker-send 0 (buffer-bytes (& said))))]))

(define (fetched [r (ptr stream-reader)])
  (buffer-add-string! (& said) (buffer-string (& (-> r bytes))))
  (buffer-add-byte! (& said) 32)
  (fetch-get "/assets/missing.txt" (& head)))

(define (ticking)
  (set! said (make-buffer))
  (set! (-> head handle) heard)
  (timer-after 5000.0 (cast (ptr void) (& head))))

;; ---- the page ----

(define (init [m (ptr model)])
  (let ([o worker-options] [why string])
    (event-handler! worker-source worker-heard)
    (set! (-> m log) (make-buffer))
    (worker-options-init! (& o))
    (grants-fake! (& (-> o grants)) "clock")
    (grants-fake! (& (-> o grants)) "timer")
    (grants-fake! (& (-> o grants)) "fetch")
    (grants-fake! (& (-> o grants)) "websocket")
    (when (== (worker-start ticking (cast (slice u8) "") (& o) 0 (& why)) 0)
      (buffer-add-string! (& (-> m log)) why))))

(define (update [m (ptr model)] [e (ptr message)])
  (match e
    [(worker-event kind)
     (when (== kind worker-message)
       (let ([data (events-take-text)])
         (buffer-add-string! (& (-> m log)) data)
         (free (-> data bytes))))]))

(define (worker-heard [source u32] [kind u32] [w u32] [tag (ptr void)] [value i32])
  (let ([e message (worker-event kind)])
    (send! (& e))))

(view (page [m (ptr model)])
  (p ([id "said"]) (text (buffer-string (& (-> m log))))))

(app model message init update page)
