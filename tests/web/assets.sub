;; A page using its assets: as files, as an image drawn on a canvas, and by URL.
(require-unqualified web "../../lib/web/web.sub")
(require-unqualified fs "../../host/fs.sub")
(require-unqualified canvas "../../lib/web/canvas.sub")

(struct model [note string] [nested string] [missing bool] [written string] [image u32] [frame u32])
(variant message [tick [time f64]])
(messages message)

(define (init [m (ptr model)])
  (set! (-> m note) (cast string (fs-read-file "assets/note.txt" 0)))
  (set! (-> m nested) (cast string (fs-read-file "assets/levels/level #1.txt" 0)))
  (set! (-> m missing) (== (-> (fs-read-file "assets/nothing.txt" 0) items) 0))
  (fs-write-file "made.txt" (cast (slice u8) "written and read back") 0)
  (set! (-> m written) (cast string (fs-read-file "made.txt" 0)))
  (set! (-> m image) (load-image "assets/red.png"))
  (load-image "assets/nothing.png"))

(define (update [m (ptr model)] [e (ptr message)])
  (match e
    [(tick time) (when (< (-> m frame) 600) (+= (-> m frame) 1))]))

(define (paint [m (ptr model)])
  (fill-style "white")
  (fill-rect 0 0 16 16)
  (draw-sprite (-> m image) 4 4 0 6 6 #f))

(define (or-none [s string]) -> string (if (!= (-> s bytes) 0) s "(none)"))

(view (page [m (ptr model)])
  (p ([id "note"]) (text (or-none (-> m note))))
  (p ([id "nested"]) (text (or-none (-> m nested))))
  (p ([id "missing"]) (text (if (-> m missing) "no such file" "found")))
  (p ([id "written"]) (text (or-none (-> m written))))
  (img ([id "picture"] [src "assets/red.png"] [alt "a red square"]))
  (canvas ([id "board"] [width 16] [height 16]
           [on-window frame (tick (event time))]
           [draw (-> m frame) (paint m)])))

(app model message init update page)
