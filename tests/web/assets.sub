;; A page using its assets: as files, also open by handle, as an image drawn on a canvas, and by URL.
(require-unqualified web)
(require-unqualified host/fs)
(require-unqualified std/web/canvas)

(struct model [note string] [nested string] [missing bool] [written string] [opened string] [image u32] [frame u32])
(variant message [tick [time f64]])
(messages message)

(define (file-text [path string]) -> string
  (let ([b (slice u8)])
    (if (< (fs-read-file path (& b) 0) 0) "(none)" (cast string b))))

(define (opened-text) -> string
  (let ([b (array u8 16)] [out (make-buffer)]
        [h (fs-open-file "opened.dat" (bit-or fs-read-flag fs-write-flag fs-create-flag) 0)]
        [g (fs-open-file "assets/note.txt" 0 0)])
    (fs-write-at h (cast (slice u8) "hello") 0 0)
    (fs-write-at h (cast (slice u8) "world") 10 0)
    (fs-set-size h 12 0)
    (let ([n (fs-read-at h (slice b) 0 0)])
      (for ([i 0]) (< i n) (+= i 1) (buffer-add-byte! (& out) (if (== (@ b i) 0) 46 (@ b i)))))
    (buffer-add-string! (& out) ", ")
    (buffer-add! (& out) (slice (slice b) 0 (cast u32 (fs-read-at g (slice (slice b) 0 8) 3 0))))
    (buffer-add-string! (& out) (if (< (fs-write-at g (cast (slice u8) "x") 0 0) 0) ", refused" ", written"))
    (fs-close-file g 0)
    (fs-close-file h 0)
    (buffer-string (& out))))

(define (init [m (ptr model)])
  (set! (-> m note) (file-text "assets/note.txt"))
  (set! (-> m nested) (file-text "assets/levels/level #1.txt"))
  (let ([b (slice u8)]) (set! (-> m missing) (< (fs-read-file "assets/nothing.txt" (& b) 0) 0)))
  (fs-write-file "made.txt" (cast (slice u8) "written and read back") 0)
  (set! (-> m written) (file-text "made.txt"))
  (set! (-> m opened) (opened-text))
  (set! (-> m image) (canvas-load-image! "assets/red.png"))
  (canvas-load-image! "assets/nothing.png"))

(define (update [m (ptr model)] [e (ptr message)])
  (match e
    [(tick time) (when (< (-> m frame) 600) (+= (-> m frame) 1))]))

(define (paint [m (ptr model)])
  (canvas-fill-style! "white")
  (canvas-fill-rect! 0 0 16 16)
  (canvas-draw-sprite! (-> m image) 4 4 0 6 6 #f))

(view (page [m (ptr model)])
  (p ([id "note"]) (text (-> m note)))
  (p ([id "nested"]) (text (-> m nested)))
  (p ([id "missing"]) (text (if (-> m missing) "no such file" "found")))
  (p ([id "written"]) (text (-> m written)))
  (p ([id "opened"]) (text (-> m opened)))
  (img ([id "picture"] [src "assets/red.png"] [alt "a red square"]))
  (canvas ([id "board"] [width 16] [height 16]
           [on-window frame (tick (event time))]
           [draw (-> m frame) (paint m)])))

(app model message init update page)
