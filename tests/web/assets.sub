;; A page using its assets: as files, also open by handle, as an image drawn on a canvas, and by URL.
(require-unqualified std/web/dom)
(require-unqualified host/fs)
(require-unqualified std/web/canvas)
(require-unqualified "plain.sub")

(define html string
  "<p id=\"note\"><!--t--></p><p id=\"nested\"><!--t--></p><p id=\"missing\"><!--t--></p><p id=\"written\"><!--t--></p><p id=\"opened\"><!--t--></p><img id=\"picture\" src=\"assets/red.png\" alt=\"a red square\"><canvas id=\"board\" width=\"16\" height=\"16\" data-n></canvas>")

(define image u32 0)
(define frame u32 0)
(define page u32 0)
(define ticking event-head)

(define (file-text [path string]) -> string
  (let ([b (slice u8)])
    (if (fs-read-file path (& b) 0) (cast string b) "(none)")))

(define (opened-text) -> string
  (let ([b (array u8 16)] [out (make-buffer)] [h u32 0] [g u32 0] [n u32 0])
    (fs-open-file "opened.dat" (bit-or fs-read-flag fs-write-flag fs-create-flag) (& h) 0)
    (fs-open-file "assets/note.txt" 0 (& g) 0)
    (fs-write-at h (cast (slice u8) "hello") 0 0)
    (fs-write-at h (cast (slice u8) "world") 10 0)
    (fs-set-size h 12 0)
    (fs-read-at h (slice b) 0 (& n) 0)
    (for ([i u32 0]) (< i n) (+= i 1) (buffer-add-byte! (& out) (if (== (@ b i) 0) 46 (@ b i))))
    (buffer-add-string! (& out) ", ")
    (fs-read-at g (slice (slice b) 0 8) 3 (& n) 0)
    (buffer-add! (& out) (slice (slice b) 0 n))
    (buffer-add-string! (& out) (if (fs-write-at g (cast (slice u8) "x") 0 0) ", written" ", refused"))
    (fs-close-file g 0)
    (fs-close-file h 0)
    (buffer-string (& out))))

(define (paint!)
  (canvas-begin! (+ page 6))
  (canvas-fill-style! "white")
  (canvas-fill-rect! 0 0 16 16)
  (canvas-draw-sprite! image 4 4 0 6 6 #f)
  (canvas-end!))

(define (ticked [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (< frame 600)
    (+= frame 1)
    (paint!))
  (dom-flush!))

(define (main)
  (set! page (dom-add! (dom-template html) 0 0))
  (show! (+ page 1) "~a" (file-text "assets/note.txt"))
  (show! (+ page 2) "~a" (file-text "assets/levels/level #1.txt"))
  (let ([b (slice u8)])
    (show! (+ page 3) "~a" (if (fs-read-file "assets/nothing.txt" (& b) 0) "found" "no such file")))
  (fs-write-file "made.txt" (cast (slice u8) "written and read back") 0)
  (show! (+ page 4) "~a" (file-text "made.txt"))
  (show! (+ page 5) "~a" (opened-text))
  (set! image (canvas-load-image! "assets/red.png"))
  (canvas-load-image! "assets/nothing.png")
  (set! (-> ticking handle) ticked)
  (dom-listen-window! (+ page 6) "frame" (& ticking))
  (paint!)
  (dom-flush!))
