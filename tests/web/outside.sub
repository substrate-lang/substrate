;; A page that asks for a file outside its site's directory, with / and with \ encoded in the path.
(require-unqualified std/web/dom)
(require-unqualified host/modules/fetch)
(require-unqualified host/stream)
(require-unqualified "plain.sub")

(struct reply [head event-head] [status i32] [text (array u8 64)] [length u32] [node u32])

(define slash reply)
(define backslash reply)

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([r (cast (ptr reply) tag)])
    (cond [(and (== source fetch-source) (== kind fetch-head))
           (set! (-> r status) value)
           (stream-read! id (slice (-> r text)))]
          [(== source fetch-source) (set! (-> r status) -1)]
          [(and (== kind stream-read) (> value 0)) (set! (-> r length) (cast u32 value))])
    (shown! r)
    (dom-flush!)))

(define (shown! [r (ptr reply)]) (show! (-> r node) "~a ~a" (-> r status) (cast string (slice (-> r text) (-> r length)))))

(define (asked! [r (ptr reply)] [url string] [node u32])
  (set! (-> r head handle) heard)
  (set! (-> r node) node)
  (shown! r)
  (fetch-get url (cast (ptr void) r)))

(define (main)
  (let ([page (dom-add! (dom-template "<p id=\"slash\"><!--t--></p><p id=\"backslash\"><!--t--></p>") 0 0)])
    (asked! (& slash) "..%2F..%2Foutside.txt" (+ page 1))
    (asked! (& backslash) "..%5C..%5Coutside.txt" (+ page 2))
    (dom-flush!)))
