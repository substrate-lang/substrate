;; A page that asks for a file outside its site's directory, with / and with \ encoded in the path.
(require-unqualified web web)
(require-unqualified fetch host/modules/fetch)
(require-unqualified stream host/stream)

(struct reply [head event-head] [status i32] [text (array u8 64)] [length u32])
(struct model [slash reply] [backslash reply])
(variant message [changed])
(messages message)

(define (heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([r (cast (ptr reply) tag)] [e message changed])
    (cond [(and (== source fetch-source) (== kind fetch-head))
           (set! (-> r status) value)
           (stream-read! id (slice (-> r text)))]
          [(== source fetch-source) (set! (-> r status) -1)]
          [(and (== kind stream-read) (> value 0)) (set! (-> r length) (cast u32 value))])
    (send! (& e))))

(define (init [m (ptr model)])
  (set! (-> m slash head handle) heard)
  (set! (-> m backslash head handle) heard)
  (fetch-get "..%2F..%2Foutside.txt" (cast (ptr void) (& (-> m slash))))
  (fetch-get "..%5C..%5Coutside.txt" (cast (ptr void) (& (-> m backslash)))))

(define (update [m (ptr model)] [e (ptr message)]) (match e [changed (begin)]))

(view (page [m (ptr model)])
  (p ([id "slash"]) (int (-> m slash status)) (text " ") (text (cast string (slice (-> m slash text) (-> m slash length)))))
  (p ([id "backslash"]) (int (-> m backslash status)) (text " ")
     (text (cast string (slice (-> m backslash text) (-> m backslash length))))))

(app model message init update page)
