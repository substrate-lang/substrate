(define first-worker string "1 stdout: a worker, one
1 done
1 message: total 5
1 done
1 message: total 42
1 done
1 stdout: hello
1 message: said
1 done
1 stderr: careful
1 message: warned
1 done
1 message: read 25 bytes
1 done
1 message: cannot write /out/made.txt: Read-only file system
1 done
1 message: cannot read /out/made.txt: No such file or directory
1 done
1 message: trapped: trap: divide by zero
1 done: trap: divide by zero
1 message: total 43
1 done
1 message: no worker: worker.start: a worker cannot start workers
1 done
1 message: out of memory before 32 MiB
1 done
1 message: total 44
1 done
1 ended: exit 3
send to worker 1 returned -1
2 stdout: a worker
2 done
")

(define looping string "2 ended: time limit exceeded (300 ms)
3 stdout: a worker
3 done
3 message: total 2
worker 3 is now looping
3 done
")

(define stopped string "stopped worker 3; send to it returned -1
4 stdout: own: started
4 ended: trap: dom.images_loading is not available in a worker
finished
")

(define (joined [a string] [b string]) -> string
  (let ([out (make-buffer)])
    (buffer-add-string! (& out) a)
    (buffer-add-string! (& out) b)
    (buffer-string (& out))))

(define (contains? [s string] [part string]) -> bool
  (for ([i u32 0]) (<= (+ i (-> part length)) (-> s length)) (+= i 1)
    (when (== (slice s i (+ i (-> part length))) part) (return #t)))
  #f)

(define (without-backtraces [text string]) -> string
  (let ([out (make-buffer)] [start u32 0])
    (for ([i u32 0]) (<= i (-> text length)) (+= i 1)
      (when (or (== i (-> text length)) (== (@ text i) 10))
        (let ([line (slice text start i)])
          (unless (and (>= (-> line length) 4) (== (slice line 0 4) "    "))
            (buffer-add-string! (& out) line)
            (when (< i (-> text length)) (buffer-add-byte! (& out) 10))))
        (set! start (+ i 1))))
    (buffer-string (& out))))

(test worker-fakes
  (with-browser (b "worker-fakes.sub")
    (expect-text b (by-css "#said") "5000 1700000005000 200 An asset, read as a file. 404 echo")))

(test workers
  (with-browser (b "workers.sub")
    (expect-count b (by-text-containing "2 stdout: a worker 2 done") 1)
    (expect-equal (without-backtraces (browser-text b (by-css "#log"))) first-worker)
    (browser-advance! b 300)
    (expect-count b (by-text-containing "worker 3 is now looping 3 done") 1)
    (expect-equal (without-backtraces (browser-text b (by-css "#log"))) (joined first-worker looping))
    (browser-click! b (by-role "button" "tick"))
    (browser-click! b (by-role "button" "tick"))
    (expect-text b (by-css "#ticks") "2")
    (browser-click! b (by-role "button" "stop"))
    (expect-count b (by-text-containing "finished") 1)
    (expect-equal (without-backtraces (browser-text b (by-css "#log"))) (joined (joined first-worker looping) stopped))))

