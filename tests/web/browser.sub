(define (joined [a string] [b string]) -> string
  (let ([out (make-buffer)])
    (buffer-add-string! (& out) a)
    (buffer-add-string! (& out) b)
    (buffer-string (& out))))

(define (without-backtraces [text string]) -> string
  (let ([out (make-buffer)] [start u32 0])
    (for ([i u32 0]) (<= i (-> text length)) (+= i 1)
      (when (or (== i (-> text length)) (== (@ text i) 10))
        (let ([line (slice text start i)])
          (unless (and (>= (-> line length) 4) (== (slice line 0 4) "    "))
            (buffer-add-string! (& out) line)
            (when (< i (-> text length)) (buffer-add-byte! (& out) 10))))
        (set! start (+ i 1))))
    (buffer-string (& out))))

(test workers
  (with-browser (b "workers.sub")
    (expect-count b (by-text-containing "2 stdout: a worker 2 done") 1)
    (expect-equal (without-backtraces (browser-text b (by-css "#log"))) first-worker)
    (browser-advance! b 300)
    (expect-count b (by-text-containing "worker 3 is now looping 3 done") 1)
    (expect-equal (without-backtraces (browser-text b (by-css "#log"))) (joined first-worker looping))
    (browser-click! b (by-role "button" "tick"))
    (browser-click! b (by-role "button" "tick"))
    (expect-text b (by-css "#ticks") "2")
    (browser-click! b (by-role "button" "stop"))
    (expect-count b (by-text-containing "finished") 1)
    (expect-equal (without-backtraces (browser-text b (by-css "#log"))) (joined (joined first-worker looping) stopped))))

(test canvas
  (with-browser (b "canvas.sub")
    (expect-text b (by-css "#shown") "0,0 clicks 0 frames 0 keys 0")
    (expect-equal (browser-drawing b (by-css "#board")) "fill-style \"white\"\nfill-rect 0 0 200 100")
    (browser-click! b (by-css "#board"))
    (expect-text b (by-css "#shown") "100,50 clicks 1 frames 0 keys 0")
    (expect-equal (browser-drawing b (by-css "#board"))
                  "fill-style \"white\"\nfill-rect 0 0 200 100\nfill-style \"red\"\nfill-rect 95 45 10 10")
    (browser-click-at! b (by-css "#board") 20 30)
    (expect-text b (by-css "#shown") "20,30 clicks 2 frames 0 keys 0")
    (browser-press! b "a")
    (expect-text b (by-css "#shown") "20,30 clicks 2 frames 0 keys 0")
    (browser-click! b (by-role "button" "toggle"))
    (browser-advance! b 100)
    (browser-press! b "a")
    (browser-press! b "ArrowUp")
    (expect-text b (by-css "#shown") "20,30 clicks 2 frames 6 keys 2")
    (browser-click! b (by-role "button" "toggle"))
    (browser-advance! b 150)
    (browser-press! b "a")
    (expect-text b (by-css "#shown") "20,30 clicks 2 frames 6 keys 2")
    (browser-click! b (by-role "button" "toggle"))
    (browser-advance! b 50)
    (browser-press! b "a")
    (expect-text b (by-css "#shown") "20,30 clicks 2 frames 9 keys 3")))

(test sounds
  (with-browser (b "sounds")
    (browser-advance! b 100)
    (expect-equal (browser-sounds b) "")
    (expect-equal (browser-console b) "audio: cannot load the sound assets/nothing.wav: the server answered 404")
    (browser-press! b "x")
    (browser-advance! b 100)
    (expect-equal (browser-sounds b) "start \"/assets/beep.wav\" volume 0.3 looping")
    (browser-press! b "s")
    (browser-advance! b 100)
    (browser-press! b " ")
    (browser-advance! b 1000)
    (browser-press! b "m")
    (browser-advance! b 100)
    (browser-press! b "s")
    (browser-advance! b 100)
    (expect-equal (browser-sounds b) "start \"/assets/beep.wav\" volume 0.3 looping
stop \"/assets/beep.wav\"
start \"/assets/beep.wav\" volume 0.5
end \"/assets/beep.wav\"
start \"/assets/beep.wav\" volume 0.3 looping
stop \"/assets/beep.wav\"")))

