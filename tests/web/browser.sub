(test fields
  (with-browser (b "fields.sub")
    (expect-text b (by-css "#shown") "||0|0")
    (expect-html b (by-css "#field") "<input id=\"field\" type=\"text\" maxlength=\"12\" autofocus=\"\">")
    (expect-attribute b (by-role "button" "send") "disabled" "")
    (expect-attribute b (by-css "#cell") "colspan" "1")
    (expect-value b (by-css "#area") "kept")
    (browser-click! b (by-role "button" "send"))
    (expect-text b (by-css "#shown") "||0|0")
    (browser-type! b (by-css "#field") "abc")
    (expect-text b (by-css "#shown") "abc|c|0|0")
    (expect-attribute b (by-css "#cell") "colspan" "4")
    (browser-press! b "Shift+Enter")
    (expect-text b (by-css "#shown") "abc|Enter+shift|0|0")
    (browser-press! b "Control+ArrowUp")
    (expect-text b (by-css "#shown") "abc|ArrowUp+control|0|0")
    (browser-press! b "ArrowDown")
    (expect-text b (by-css "#shown") "abc|ArrowDown|0|0")
    (browser-click! b (by-css "#box"))
    (expect-no-attribute b (by-role "button" "send") "disabled")
    (expect-checked b (by-css "#box") #t)
    (browser-click! b (by-role "button" "send"))
    (expect-text b (by-css "#shown") "abc|ArrowDown|1|0")
    (browser-click! b (by-css "#box"))
    (expect-attribute b (by-role "button" "send") "disabled" "")
    (expect-checked b (by-css "#box") #f)
    (browser-fire! b (by-css "#part") "my-event")
    (expect-text b (by-css "#shown") "abc|ArrowDown|1|1")))

