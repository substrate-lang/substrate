    (expect-equal (browser-console b) "")))

(define (quitting) (host-exit 3 ""))

(define (trapping) (let ([zero i32 0]) (printf "~a~n" (/ 1 zero))))

(test server-ends #:grants ((net "127.0.0.1"))
  (let ([quit string] [trapped string])
    (try (with-browser (b "polling.sub" #:server quitting) (expect-text b (by-css "#state") "answered"))
      [catch test-failed (message) (set! quit message)])
    (try (with-browser (b "polling.sub" #:server trapping) (expect-text b (by-css "#state") "answered"))
      [catch test-failed (message) (set! trapped message)])
    (expect (contains? quit "the server ended before printing its address: exit 3"))
    (expect (contains? trapped "the server ended before printing its address: trap: divide by zero"))))
