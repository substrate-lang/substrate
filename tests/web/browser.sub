(define first-stream string "open | message 1 first | named 2 a
b | closed ended")

;; Follows the events page's stream to its end. The client reconnects 50 ms after each close, on the page's clock.
(define (streamed [b browser])
  (expect-text b (by-css "#log") first-stream)
  (browser-advance! b 100)
  (expect-text b (by-css "#log") (joined first-stream " | open | message 3 resumed after 2 | closed ended"))
  (browser-advance! b 100)
  (expect-text b (by-css "#log") (joined first-stream " | open | message 3 resumed after 2 | closed ended | closed refused 204")))

(test events
  (with-browser (b "events.sub" #:server "server.sub")
    (streamed b)
    (expect-equal (browser-console b) "")))

(test events-cross-origin #:chromium
  (with-browser (b "events.sub" #:server "server.sub")
    (streamed b)
    (expect-text b (by-css "#checks") "posted 200 posted | refused 1 | put 200 put")
    (expect-equal (browser-console b) "")))
