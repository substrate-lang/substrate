;; A page that reads its server's event stream (tests/web/server.sub) with the event stream client, which reconnects
;; with the last id until the server answers 204. It then makes requests whose answers depend on the browser's
;; cross-origin rules.
(require-unqualified std/web/dom)
(require-unqualified std/http)
(require-unqualified std/http/sse-client)
(require-unqualified host/events)
(require-unqualified host/modules/fetch)
(require-unqualified host/stream)
(require-unqualified "plain.sub")
(require-unqualified std/string)

(define stream sse-client)
(define log buffer)
(define checks buffer)
(define page u32 0)

(define (shown!)
  (show! (+ page 1) "~a" (buffer-string (& log)))
  (show! (+ page 2) "~a" (buffer-string (& checks)))
  (dom-flush!))

(define (said! [parts (slice string)])
  (when (> (-> log length) 0) (buffer-add-string! (& log) " | "))
  (for ([i u32 0]) (< i (-> parts length)) (+= i 1) (buffer-add-string! (& log) (@ parts i)))
  (shown!))

(define (opened [c (ptr sse-client)]) (said! (slice (array-of string "open"))))

(define (heard [c (ptr sse-client)] [e (ptr sse-event)])
  (said! (slice (array-of string (-> e type) " " (-> e id) " " (-> e data)))))

(define (closed [c (ptr sse-client)] [why sse-end])
  (said! (slice (array-of string "closed " (cond [(== why sse-ended) "ended"] [(== why sse-lost) "lost"]
                                                 [(== (-> c status) 204) "refused 204"] [else "refused"]))))
  (when (== (-> c status) 204)
    (set! (-> ask head handle) ask-heard)
    (set! (-> ask body) (make-buffer))
    (asked! "POST" "/guarded" (no-headers) "x")))

(struct asking [head event-head] [id u32] [step u32] [status i32] [body buffer] [other string] [chunk (array u8 4096)])

(define ask asking)

(define (no-headers) -> (slice string) (slice (cast (ptr string) 0) 0))

(define (asked! [method string] [url string] [headers (slice string)] [body string])
  (set! (-> ask status) 0)
  (set! (-> ask body length) 0)
  (set! (-> ask id) (fetch-start method url headers (cast (slice u8) body) (cast (ptr void) (& ask)))))

(define (noted! [parts (slice string)])
  (when (> (-> checks length) 0) (buffer-add-string! (& checks) " | "))
  (for ([i u32 0]) (< i (-> parts length)) (+= i 1) (buffer-add-string! (& checks) (@ parts i)))
  (shown!))

(define (status-text) -> string
  (let ([b (make-buffer)])
    (write-digits (& b) (cast u64 (-> ask status)) 10)
    (buffer-string (& b))))

;; answered! sends the next request after each answer: a POST to this origin, then a request for the other origin's
;; address, a POST to it, a request for its count of refused POSTs, and a PUT.
(define (answered!)
  (let ([text (buffer-string (& (-> ask body)))] [step (-> ask step)])
    (+= (-> ask step) 1)
    (cond [(== step 0)
           (noted! (slice (array-of string "posted " (status-text) " " text)))
           (asked! "GET" "/other" (no-headers) "")]
          [(== step 1)
           (set! (-> ask other) (string-copy text))
           (asked! "POST" (string-append 0 (-> ask other) "guarded") (no-headers) "x")]
          [(== step 2) (asked! "GET" (string-append 0 (-> ask other) "refused") (no-headers) "")]
          [(== step 3)
           (noted! (slice (array-of string "refused " text)))
           (asked! "PUT" (string-append 0 (-> ask other) "api") (slice (array-of string "x-key" "1")) "")]
          [(== step 4) (noted! (slice (array-of string "put " (status-text) " " text)))])))

(define (ask-heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (cond [(!= id (-> ask id)) (begin)]
        [(== source fetch-source)
         (if (== kind fetch-head)
             (let ([headers (events-take-strings)])
               (free (-> headers items))
               (set! (-> ask status) value)
               (stream-read! id (slice (-> ask chunk))))
             (answered!))]
        [(and (== kind stream-read) (> value 0))
         (buffer-add! (& (-> ask body)) (slice (-> ask chunk) (cast u32 value)))
         (stream-read! id (slice (-> ask chunk)))]
        [(or (== kind stream-read) (== kind stream-failed))
         (stream-close id)
         (answered!)]))

(define (main)
  (set! page (dom-add! (dom-template "<p id=\"log\"><!--t--></p><p id=\"checks\"><!--t--></p>") 0 0))
  (set! log (make-buffer))
  (set! checks (make-buffer))
  (set! (-> stream reconnect) #t)
  (set! (-> stream on-open) opened)
  (set! (-> stream on-event) heard)
  (set! (-> stream on-closed) closed)
  (sse-client-open! (& stream) "GET" "/events" (slice (cast (ptr string) 0) 0) 0)
  (shown!))
