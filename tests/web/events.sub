;; A page that reads its server's event stream with the event stream client, which reconnects with the last id until
;; the server answers 204 (tests/web/server.sub), then makes requests whose answers depend on the browser: a POST to its
;; own origin, and to the server's other origin a POST, the count of POSTs refused there, and a PUT with a header CORS
;; must let through.
(require-unqualified web web)
(require-unqualified http std/http)
(require-unqualified client std/http/sse-client)
(require-unqualified events host/events)
(require-unqualified fetch host/modules/fetch)
(require-unqualified stream host/stream)

(struct model [stream sse-client] [log buffer] [checks buffer])
(variant message [changed])
(messages message)

(define (said! [c (ptr sse-client)] [parts (slice string)])
  (let ([m (cast (ptr model) (-> c user))] [e message changed])
    (when (> (-> m log length) 0) (buffer-add-string! (& (-> m log)) " | "))
    (for ([i u32 0]) (< i (-> parts length)) (+= i 1) (buffer-add-string! (& (-> m log)) (@ parts i)))
    (send! (& e))))

(define (opened [c (ptr sse-client)]) (said! c (slice (array-of string "open"))))

(define (heard [c (ptr sse-client)] [e (ptr sse-event)])
  (said! c (slice (array-of string (-> e type) " " (-> e id) " " (-> e data)))))

(define (closed [c (ptr sse-client)] [why i32])
  (said! c (slice (array-of string "closed " (cond [(== why sse-ended) "ended"] [(== why sse-lost) "lost"]
                                                   [(== (-> c status) 204) "refused 204"] [else "refused"]))))
  (when (== (-> c status) 204)
    (set! (-> ask m) (cast (ptr model) (-> c user)))
    (set! (-> ask head handle) ask-heard)
    (set! (-> ask body) (make-buffer))
    (asked! "POST" "/guarded" (no-headers) "x")))

;; ---- the requests after the stream ----

(struct asking [head event-head] [m (ptr model)] [id u32] [step u32] [status i32] [body buffer] [other string]
  [chunk (array u8 4096)])

(define ask asking)

(define (no-headers) -> (slice string) (slice (cast (ptr string) 0) 0))

(define (asked! [method string] [url string] [headers (slice string)] [body string])
  (set! (-> ask status) 0)
  (set! (-> ask body length) 0)
  (set! (-> ask id) (fetch-start method url headers (cast (slice u8) body) (cast (ptr void) (& ask)))))

(define (noted! [parts (slice string)])
  (let ([m (-> ask m)] [e message changed])
    (when (> (-> m checks length) 0) (buffer-add-string! (& (-> m checks)) " | "))
    (for ([i u32 0]) (< i (-> parts length)) (+= i 1) (buffer-add-string! (& (-> m checks)) (@ parts i)))
    (send! (& e))))

(define (status-text) -> string
  (let ([b (make-buffer)])
    (write-digits (& b) (cast u64 (-> ask status)) 10)
    (buffer-string (& b))))

(define (joined [a string] [b string]) -> string
  (let ([out (make-buffer)])
    (buffer-add-string! (& out) a)
    (buffer-add-string! (& out) b)
    (buffer-string (& out))))

;; answered! carries on after each answer: the POST to this origin, the other origin's address, the POST to it, its count
;; of refused POSTs, and the PUT.
(define (answered!)
  (let ([text (buffer-string (& (-> ask body)))] [step (-> ask step)])
    (+= (-> ask step) 1)
    (cond [(== step 0)
           (noted! (slice (array-of string "posted " (status-text) " " text)))
           (asked! "GET" "/other" (no-headers) "")]
          [(== step 1)
           (set! (-> ask other) (string-copy text))
           (asked! "POST" (joined (-> ask other) "guarded") (no-headers) "x")]
          [(== step 2) (asked! "GET" (joined (-> ask other) "refused") (no-headers) "")]
          [(== step 3)
           (noted! (slice (array-of string "refused " text)))
           (asked! "PUT" (joined (-> ask other) "api") (slice (array-of string "x-key" "1")) "")]
          [(== step 4) (noted! (slice (array-of string "put " (status-text) " " text)))])))

(define (ask-heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (cond [(!= id (-> ask id)) (begin)]
        [(== source fetch-source)
         (if (== kind fetch-head)
             (let ([headers (events-take-strings)])
               (free (-> headers items))
               (set! (-> ask status) value)
               (stream-read! id (slice (-> ask chunk))))
             (answered!))]
        [(and (== kind stream-read) (> value 0))
         (buffer-add! (& (-> ask body)) (slice (-> ask chunk) (cast u32 value)))
         (stream-read! id (slice (-> ask chunk)))]
        [(or (== kind stream-read) (== kind stream-failed))
         (stream-close id)
         (answered!)]))

(define (init [m (ptr model)])
  (set! (-> m log) (make-buffer))
  (set! (-> m checks) (make-buffer))
  (set! (-> m stream user) (cast (ptr void) m))
  (set! (-> m stream reconnect) #t)
  (set! (-> m stream on-open) opened)
  (set! (-> m stream on-event) heard)
  (set! (-> m stream on-closed) closed)
  (sse-client-open! (& (-> m stream)) "GET" "/events" (slice (cast (ptr string) 0) 0) 0))

(define (update [m (ptr model)] [e (ptr message)]) (match e [changed (begin)]))

(view (page [m (ptr model)])
  (p ([id "log"]) (text (buffer-string (& (-> m log)))))
  (p ([id "checks"]) (text (buffer-string (& (-> m checks))))))

(app model message init update page)
