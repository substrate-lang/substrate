;; A page using the host module gpu directly: a texture, a compute shader, a shader error, and a write past the end of a
;; buffer, whose error goes to the batch.
(require-unqualified std/web/dom)
(require-unqualified host/events)
(require-unqualified std/web/gpu)
(require-unqualified "plain.sub")

(define html string
  "<p id=\"pixels\"><!--t--></p><p id=\"numbers\"><!--t--></p><pre id=\"errors\"><!--t--></pre><p id=\"batch\"><!--t--></p><canvas id=\"screen\" width=\"64\" height=\"64\" data-n></canvas>")

(define errors buffer)
(define pipeline u32 0)
(define screen u32 0)
(define instances u32 0)
(define drawn bool #f)
(define page u32 0)
(define ticking event-head)
(define heard event-head)

(define shader-code string
  "struct Screen { size: vec2f }\n@group(0) @binding(0) var<uniform> screen: Screen;\nstruct In { @location(0) rect: vec4f, @location(1) color: vec4f, @builtin(vertex_index) vertex: u32 }\nstruct Out { @builtin(position) position: vec4f, @location(0) color: vec4f }\n@vertex fn vertex(in: In) -> Out {\n  var corners = array<vec2f, 6>(vec2f(0, 0), vec2f(1, 0), vec2f(0, 1), vec2f(1, 0), vec2f(1, 1), vec2f(0, 1));\n  let c = corners[in.vertex];\n  let p = in.rect.xy + c * in.rect.zw;\n  var out: Out;\n  out.position = vec4f(p.x / screen.size.x * 2.0 - 1.0, 1.0 - p.y / screen.size.y * 2.0, 0.0, 1.0);\n  out.color = in.color;\n  return out;\n}\n@fragment fn fragment(in: Out) -> @location(0) vec4f { return in.color; }\n")

(define compute-code string
  "@group(0) @binding(0) var<storage, read_write> data: array<u32>;\n@compute @workgroup_size(8) fn double(@builtin(global_invocation_id) id: vec3u) { data[id.x] = data[id.x] * 2u; }\n")

(define (rectangles! [width f64] [height f64] [target-format u32]) -> u32
  (let* ([shader (gpu-shader! shader-code)]
         [pipeline (gpu-render-pipeline! shader "vertex" "fragment" gpu-triangles gpu-cull-none gpu-ccw gpu-blend-none 0 0 #f
                                         0 1 1)])
    (gpu-target! target-format)
    (gpu-vertex-buffer-layout! 32 gpu-per-instance 2)
    (gpu-attribute! 0 0 gpu-f32x4)
    (gpu-attribute! 1 16 gpu-f32x4)
    (let ([data (array-of f32 2.0 2.0 4.0 4.0 1.0 0.0 0.0 1.0  10.0 10.0 4.0 4.0 0.0 1.0 0.0 1.0)]
          [size (array-of f32 (cast f32 width) (cast f32 height) 0.0 0.0)])
      (gpu-write-buffer! instances 0 (gpu-frame-copy data 64) 64)
      (gpu-write-buffer! screen 0 (gpu-frame-copy size 16) 16))
    pipeline))

(define (draw-rectangles! [pipeline u32] [kind u32] [target u32])
  (let ([group (gpu-bind-group! 0 pipeline 0 1)])
    (gpu-bind-buffer! 0 screen 0 0)
    (gpu-render-pass! 1 0 0 0 0 0.0)
    (gpu-pass-target! kind target 0 0 gpu-clear 0.0 0.0 0.0 0.0)
    (gpu-pipeline! pipeline)
    (gpu-bind-group-set! 0 group 0)
    (gpu-vertex-buffer! 0 instances 0)
    (gpu-draw! 6 2 0 0)
    (gpu-end-pass!)))

(define (pixel [bytes (slice u8)] [x u32] [y u32] [k u32]) -> u32 (cast u32 (@ bytes (+ k (* 4 (+ (* y 16) x))))))

(define (gpu-event [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (cond
    [(== kind gpu-pixels)
     (let ([b (events-take)])
       (show! (+ page 1) "3,3: ~a,~a,~a,~a  11,11: ~a,~a,~a,~a  0,0: ~a,~a,~a,~a"
              (pixel b 3 3 0) (pixel b 3 3 1) (pixel b 3 3 2) (pixel b 3 3 3)
              (pixel b 11 11 0) (pixel b 11 11 1) (pixel b 11 11 2) (pixel b 11 11 3)
              (pixel b 0 0 0) (pixel b 0 0 1) (pixel b 0 0 2) (pixel b 0 0 3))
       (free (-> b items)))]
    [(== kind gpu-bytes)
     (let ([numbers (cast (ptr u32) (-> (events-take) items))])
       (show! (+ page 2) "~a,~a,~a,~a,~a,~a,~a,~a"
              (@ numbers 0) (@ numbers 1) (@ numbers 2) (@ numbers 3) (@ numbers 4) (@ numbers 5) (@ numbers 6) (@ numbers 7))
       (free numbers))]
    [(and (== kind gpu-error) (== id 0)) (show! (+ page 4) "the batch failed")]
    [(== kind gpu-error)
     (let ([text (events-take-text)] [before (output-to! (& errors))])
       (printf "[~a] ~a\n" id text)
       (output-to! before)
       (show! (+ page 3) "~a" (buffer-string (& errors)))
       (free (-> text bytes)))])
  (dom-flush!))

(define (ticked [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (unless drawn
    (set! drawn #t)
    (draw-rectangles! pipeline gpu-on-surface (gpu-surface! (+ page 5)))
    (gpu-send!)))

(define (main)
  (set! page (dom-add! (dom-template html) 0 0))
  (set! errors (make-buffer))
  (set! (-> heard handle) gpu-event)
  (gpu-begin! (& heard))
  (set! instances (gpu-buffer! 64 gpu-vertex))
  (set! screen (gpu-buffer! 16 gpu-uniform))
  (let ([texture (gpu-texture! 16 16 1 1 gpu-rgba8 (+ gpu-sampled gpu-target))]
        [pipeline (rectangles! 16.0 16.0 gpu-rgba8)])
    (draw-rectangles! pipeline gpu-on-texture texture)
    (gpu-read-texture! texture 0 0 0 0 16 16))
  (let* ([shader (gpu-shader! compute-code)]
         [pipeline (gpu-compute-pipeline! shader "double" 0)]
         [data (gpu-buffer! 32 gpu-storage)]
         [numbers (array-of u32 1 2 3 4 5 6 7 8)]
         [group (gpu-bind-group! 0 pipeline 0 1)])
    (gpu-bind-buffer! 0 data 0 0)
    (gpu-write-buffer! data 0 (gpu-frame-copy numbers 32) 32)
    (gpu-compute-pass!)
    (gpu-pipeline! pipeline)
    (gpu-bind-group-set! 0 group 0)
    (gpu-dispatch! 1 1 1)
    (gpu-end-pass!)
    (gpu-read-buffer! data 0 32))
  (gpu-shader! "fn broken( {")
  (gpu-write-buffer! screen 64 (gpu-frame-copy (array-of u32 1) 4) 4)
  (gpu-send!)
  (gpu-begin! (& heard))
  (set! pipeline (rectangles! 64.0 64.0 gpu-format-surface))
  (show! (+ page 1) "waiting")
  (show! (+ page 2) "waiting")
  (set! (-> ticking handle) ticked)
  (dom-listen-window! (+ page 5) "frame" (& ticking))
  (dom-flush!))
