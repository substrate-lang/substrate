;; A page using the host module gpu directly: a texture, a compute shader, a shader error.
(require-unqualified web)
(require-unqualified web/game/format)
(require-unqualified web/gpu)

(struct model [pixels buffer] [numbers buffer] [errors buffer]
  [pipeline u32] [screen u32] [instances u32] [surface u32] [drawn bool] [frame u32]
  [canvas u32])
(variant message [tick [time f64]] [refresh])
(messages message)

(define the-model (ptr model) 0)

(define shader-code string
  "struct Screen { size: vec2f }\n@group(0) @binding(0) var<uniform> screen: Screen;\nstruct In { @location(0) rect: vec4f, @location(1) color: vec4f, @builtin(vertex_index) vertex: u32 }\nstruct Out { @builtin(position) position: vec4f, @location(0) color: vec4f }\n@vertex fn vertex(in: In) -> Out {\n  var corners = array<vec2f, 6>(vec2f(0, 0), vec2f(1, 0), vec2f(0, 1), vec2f(1, 0), vec2f(1, 1), vec2f(0, 1));\n  let c = corners[in.vertex];\n  let p = in.rect.xy + c * in.rect.zw;\n  var out: Out;\n  out.position = vec4f(p.x / screen.size.x * 2.0 - 1.0, 1.0 - p.y / screen.size.y * 2.0, 0.0, 1.0);\n  out.color = in.color;\n  return out;\n}\n@fragment fn fragment(in: Out) -> @location(0) vec4f { return in.color; }\n")

(define compute-code string
  "@group(0) @binding(0) var<storage, read_write> data: array<u32>;\n@compute @workgroup_size(8) fn double(@builtin(global_invocation_id) id: vec3u) { data[id.x] = data[id.x] * 2u; }\n")

(define (flush-gpu!)
  (let ([b (gpu-commands)])
    (when (> (-> b length) 0) (gpu-apply (cast i32 (-> b bytes)) (cast i32 (-> b length))))
    (gpu-commands-done!)))

(define (rectangles! [m (ptr model)] [width f64] [height f64] [target-format u32]) -> u32
  (let* ([shader (gpu-shader! shader-code)]
         [pipeline (gpu-render-pipeline! shader "vertex" "fragment" gpu-triangles gpu-cull-none gpu-ccw gpu-blend-none 0 0 #f
                                         0 1 1)])
    (gpu-target! target-format)
    (gpu-vertex-buffer-layout! 32 gpu-per-instance 2)
    (gpu-attribute! 0 0 gpu-f32x4)
    (gpu-attribute! 1 16 gpu-f32x4)
    (let ([data (array-of f32 2.0 2.0 4.0 4.0 1.0 0.0 0.0 1.0  10.0 10.0 4.0 4.0 0.0 1.0 0.0 1.0)]
          [size (array-of f32 (cast f32 width) (cast f32 height) 0.0 0.0)])
      (gpu-write-buffer! (-> m instances) 0 (gpu-frame-copy data 64) 64)
      (gpu-write-buffer! (-> m screen) 0 (gpu-frame-copy size 16) 16))
    pipeline))

(define (draw-rectangles! [m (ptr model)] [pipeline u32] [kind u32] [target u32])
  (let ([group (gpu-bind-group! 0 pipeline 0 1)])
    (gpu-bind-buffer! 0 (-> m screen) 0 0)
    (gpu-render-pass! 1 0 0 0 0 0.0)
    (gpu-pass-target! kind target 0 0 gpu-clear 0.0 0.0 0.0 0.0)
    (gpu-pipeline! pipeline)
    (gpu-bind-group-set! 0 group 0)
    (gpu-vertex-buffer! 0 (-> m instances) 0)
    (gpu-draw! 6 2 0 0)
    (gpu-end-pass!)))

(define (init [m (ptr model)])
  (set! the-model m)
  (set! (-> m pixels) (make-buffer))
  (set! (-> m numbers) (make-buffer))
  (set! (-> m errors) (make-buffer))
  (event-handler! gpu-source gpu-event)
  (set! (-> m instances) (gpu-buffer! 64 gpu-vertex))
  (set! (-> m screen) (gpu-buffer! 16 gpu-uniform))
  (let ([texture (gpu-texture! 16 16 1 1 gpu-rgba8 (+ gpu-sampled gpu-target))]
        [pipeline (rectangles! m 16.0 16.0 gpu-rgba8)])
    (draw-rectangles! m pipeline gpu-on-texture texture)
    (gpu-read-texture! texture 0 0 0 0 16 16))
  (let* ([shader (gpu-shader! compute-code)]
         [pipeline (gpu-compute-pipeline! shader "double" 0)]
         [data (gpu-buffer! 32 gpu-storage)]
         [numbers (array-of u32 1 2 3 4 5 6 7 8)]
         [group (gpu-bind-group! 0 pipeline 0 1)])
    (gpu-bind-buffer! 0 data 0 0)
    (gpu-write-buffer! data 0 (gpu-frame-copy numbers 32) 32)
    (gpu-compute-pass!)
    (gpu-pipeline! pipeline)
    (gpu-bind-group-set! 0 group 0)
    (gpu-dispatch! 1 1 1)
    (gpu-end-pass!)
    (gpu-read-buffer! data 0 32))
  (gpu-shader! "fn broken( {")
  (flush-gpu!)
  (set! (-> m pipeline) (rectangles! m 64.0 64.0 gpu-format-surface))
  (buffer-add-string! (& (-> m pixels)) "waiting")
  (buffer-add-string! (& (-> m numbers)) "waiting"))

(define (gpu-event [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([m the-model])
    (cond
      [(== kind gpu-pixels)
       (let ([bytes (events-take)])
         (set! (-> m pixels length) 0)
         (buffer-add-format! (& (-> m pixels)) "3,3: ~d,~d,~d,~d  11,11: ~d,~d,~d,~d  0,0: ~d,~d,~d,~d"
                      (@ bytes (* 4 (+ (* 3 16) 3))) (@ bytes (+ 1 (* 4 (+ (* 3 16) 3)))) (@ bytes (+ 2 (* 4 (+ (* 3 16) 3)))) (@ bytes (+ 3 (* 4 (+ (* 3 16) 3))))
                      (@ bytes (* 4 (+ (* 11 16) 11))) (@ bytes (+ 1 (* 4 (+ (* 11 16) 11)))) (@ bytes (+ 2 (* 4 (+ (* 11 16) 11)))) (@ bytes (+ 3 (* 4 (+ (* 11 16) 11))))
                      (@ bytes 0) (@ bytes 1) (@ bytes 2) (@ bytes 3))
         (free (-> bytes items)))]
      [(== kind gpu-bytes)
       (let ([numbers (cast (ptr u32) (-> (events-take) items))])
         (set! (-> m numbers length) 0)
         (buffer-add-format! (& (-> m numbers)) "~d,~d,~d,~d,~d,~d,~d,~d"
                      (@ numbers 0) (@ numbers 1) (@ numbers 2) (@ numbers 3) (@ numbers 4) (@ numbers 5) (@ numbers 6) (@ numbers 7))
         (free numbers))]
      [(== kind gpu-error)
       (let ([text (events-take-text)])
         (buffer-add-format! (& (-> m errors)) "[~d] ~s\n" id text)
         (free (-> text bytes)))])
    (let ([r refresh]) (send! (& r)))))

(define (update [m (ptr model)] [e (ptr message)])
  (match e
    [(tick time)
     (unless (-> m drawn)
       (set! (-> m drawn) #t)
       (set! (-> m surface) (gpu-surface! (-> m canvas)))
       (draw-rectangles! m (-> m pipeline) gpu-on-surface (-> m surface))
       (flush-gpu!))
     (+= (-> m frame) 1)]
    [refresh (begin)]))

(view (page [m (ptr model)])
  (p ([id "pixels"]) (text (buffer-string (& (-> m pixels)))))
  (p ([id "numbers"]) (text (buffer-string (& (-> m numbers)))))
  (pre ([id "errors"]) (text (buffer-string (& (-> m errors)))))
  (canvas ([id "screen"] [width 64] [height 64] [node (-> m canvas)] [on-window frame (tick (event time))])))

(app model message init update page)
