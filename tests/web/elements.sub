;; A page that finds elements of its HTML by id (elements.html), adds a stylesheet, stops a click from reaching the
;; element around its target, hears when an element below the first screen comes into view, and reads, sets and calls
;; the page's properties and methods by name.
(require-unqualified std/web/dom)
(require-unqualified "plain.sub")

(define html string
  "<p id=\"missing\"><!--t--></p><div id=\"styled\" data-n></div><div id=\"outer\" data-n style=\"padding: 20px\"><button id=\"inner\" data-n>inner</button></div><p id=\"clicks\"><!--t--></p><p id=\"seen\"><!--t--></p><input id=\"field\" value=\"abcdef\" data-n><p id=\"read\"><!--t--></p><p id=\"written\" data-n></p><div id=\"wheel\" data-n style=\"height: 40px\">wheel</div><p id=\"wheeled\"><!--t--></p><div id=\"scroller\" data-n style=\"height: 30px; overflow: auto\"><div style=\"height: 300px\">tall</div></div><p id=\"scrolled\"><!--t--></p>")

(define page u32 0)
(define inner u32 0)
(define outer u32 0)
(define inner-click event-head)
(define outer-click event-head)
(define seen event-head)
(define wheeling event-head)

(define (show-clicks!) (show! (+ page 5) "inner ~a outer ~a" inner outer))

(define (inner-clicked [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (dom-event-call "stopPropagation")
  (+= inner 1)
  (show-clicks!)
  (dom-flush!))

(define (outer-clicked [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (+= outer 1)
  (show-clicks!)
  (dom-flush!))

(define (far-seen [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (show! (+ page 6) "~a" (if (!= (dom-event-number "isIntersecting") 0.0) "visible" "hidden"))
  (dom-flush!))

(define (wheeled [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (show! (+ page 11) "wheel ~a ~a" (cast i32 (dom-event-number "deltaY"))
         (if (dom-event-is (+ page 10) "target") "on its element" "elsewhere"))
  (show! (+ page 8) "width ~a, ~a, ~a, selection ~a to ~a, title ~a"
         (cast i32 (dom-read-number (+ page 2) "offsetWidth"))
         (if (dom-is (+ page 7) dom-document "activeElement") "focused" "not focused")
         (if (dom-is (+ page 3) (+ page 4) "parentNode") "inner in outer" "inner elsewhere")
         (cast i32 (dom-read-number (+ page 7) "selectionStart"))
         (cast i32 (dom-read-number (+ page 7) "selectionEnd"))
         (dom-read-text dom-document "title"))
  (let ([past (- (dom-read-number (+ page 12) "scrollHeight")
                 (+ (dom-read-number (+ page 12) "scrollTop") (dom-read-number (+ page 12) "clientHeight")))])
    (show! (+ page 13) "~a" (if (< past 1.0) "scrolled to the end" "not scrolled to the end")))
  (dom-flush!))

(define (main)
  (set! page (dom-add! (dom-template html) 0 0))
  (show! (+ page 1) "missing ~a" (dom-element "nowhere"))
  (dom-add! (dom-template "<p id=\"found\">found</p>") (dom-element "side") 0)
  (dom-stylesheet! "#styled { width: 123px; height: 10px; }")
  (set! (-> inner-click handle) inner-clicked)
  (set! (-> outer-click handle) outer-clicked)
  (dom-listen! (+ page 3) "click" (& outer-click))
  (dom-listen! (+ page 4) "click" (& inner-click))
  (show-clicks!)
  (set! (-> seen handle) far-seen)
  (dom-listen! (dom-element "far") "visibility" (& seen))
  (dom-write-text! (+ page 9) "textContent" "written as a property")
  (dom-write-text! dom-document "title" "elements")
  (dom-call! (+ page 7) "focus")
  (dom-call-with! (+ page 7) "setSelectionRange" (slice (array-of dom-value (dom-number 1.0) (dom-number 3.0))))
  (dom-write-number! (+ page 12) "scrollTop" 1000000000.0)
  (set! (-> wheeling handle) wheeled)
  (dom-listen! (+ page 10) "wheel" (& wheeling))
  (dom-flush!))
