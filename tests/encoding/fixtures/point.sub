;; A type with its wire and JSON definitions, which other modules' forms use.
(require-unqualified wire std/encoding/wire)
(require-unqualified json std/encoding/json)

(provide point point.wire-write! point.wire-read-from! point.wire-read point.json-write! point.json-read-from!
         point.json-read)

(struct point [x i32] [y i32])

(wire point)
(json point)
