;; Base64 over the RFC 4648 vectors, every byte value, and malformed text.
(require-unqualified base64 "../../lib/encoding/base64.sub")

(define (both [s string])
  (let ([e (make-buffer)] [d (make-buffer)])
    (base64-encode! (& e) (cast (slice u8) s))
    (printf "~s -> ~a -> ~a ~s\n" s (buffer-string (& e)) (base64-decode! (& d) (buffer-string (& e))) (buffer-string (& d)))
    (buffer-free! (& e))
    (buffer-free! (& d))))

(define (malformed [s string])
  (let ([d (make-buffer)])
    (printf "\"~a\": ~a\n" s (base64-decode! (& d) s))
    (buffer-free! (& d))))

(define (main)
  (both "")
  (both "f")
  (both "fo")
  (both "foo")
  (both "foob")
  (both "fooba")
  (both "foobar")
  (let ([all (array u8 256)] [e (make-buffer)] [d (make-buffer)])
    (for ([i u32 0]) (< i 256) (+= i 1) (set! (@ all i) i))
    (base64-encode! (& e) (slice all))
    (printf "all: ~a ~a ~a\n" (-> e length) (base64-decode! (& d) (buffer-string (& e))) (-> d length))
    (printf "same: ~a\n" (== (memcmp (-> d bytes) all 256) 0)))
  (malformed "Zg=")
  (malformed "Z")
  (malformed "Zm9=v")
  (malformed "Zm9v=")
  (malformed "Zm9v*")
  (malformed "Zm9vYg==Zg=="))
