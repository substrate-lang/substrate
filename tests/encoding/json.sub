;; JSON: text parsed and written back, compact and indented; errors with their line and column; values read, built and
;; changed; a tree copied to another arena and compared; and the token reader, with a value skipped.
(require-unqualified json "../../lib/encoding/json.sub")

(define (write [v (ptr json-value)] [indent (ptr u8)])
  (let ([b (make-buffer)])
    (json-write! (& b) v indent)
    (buffer-add-byte! (& b) 0)
    (printf "~a\n" (-> b bytes))
    (buffer-free! (& b))))

(define (parse-bytes [a (ptr arena)] [text (ptr u8)] [n u32]) -> (ptr json-value)
  (let* ([err json-error] [v (json-parse a text n (& err))])
    (when (== v 0) (printf "~a:~a: ~a\n" (-> err line) (-> err column) (-> err message)))
    v))

(define (parse [a (ptr arena)] [text (ptr u8)]) -> (ptr json-value) (parse-bytes a text (strlen text)))

(define sample (ptr u8)
  "{\"a\": [1, 2.50, -0, 1E5, 12345678901234567890, -1.5e-7], \"b\": {\"c\": null, \"d\": true, \"e\": false},
    \"s\": \"q\\\"b\\\\s\\/n\\n\\u0041\\u00e9\\ud83d\\ude00\\u0000\", \"empty\": [], \"none\": {}}")

(define errors (array (ptr u8) 19)
  (array-of (ptr u8) "" "   " "[1,]" "{\"a\":1,}" "[1 2]" "{\"a\" 1}" "{1:2}" "[01]" "[1.]" "[-]" "[\"a\nb\"]"
            "[\"\\x\"]" "[\"\\ud800\"]" "[\"\\u12\"]" "[tru]" "[1] x" "[[" "{\"a\":" "[1,\n 2,\n x]"))

(define (errors!)
  (let ([a (make-arena)] [b (make-buffer)])
    (for ([i 0]) (< i 19) (+= i 1) (parse (& a) (@ errors i)))
    (parse (& a) "\"abc")
    (buffer-add! (& b) "[\"" 2)
    (buffer-add-byte! (& b) 255)
    (buffer-add! (& b) "\"]" 2)
    (parse-bytes (& a) (-> b bytes) (-> b length))
    (set! (-> b length) 0)
    (for ([i 0]) (< i 1001) (+= i 1) (buffer-add-byte! (& b) #\[))
    (parse-bytes (& a) (-> b bytes) (-> b length))
    (buffer-free! (& b))
    (arena-free (& a))))

(define (reads!)
  (let* ([a (make-arena)] [i i64 0] [x f64 0] [t 0] [n u32 0]
         [doc (parse (& a) "{\"id\": 9007199254740993, \"f\": 1.5, \"s\": \"a\\u0000b\", \"t\": true, \"dup\": 1,
                            \"dup\": 2, \"list\": [10, 20, 30]}")])
    (printf "id ~a ~a\n" (json-as-i64 (json-get doc "id") (& i)) i)
    (printf "f ~a ~a, as i64 ~a\n" (json-as-f64 (json-get doc "f") (& x)) x (json-as-i64 (json-get doc "f") (& i)))
    (printf "s ~a ~a\n" (!= (json-as-string (json-get doc "s") (& n)) 0) n)
    (printf "t ~a ~a\n" (json-as-bool (json-get doc "t") (& t)) t)
    (write (json-get doc "dup") 0)
    (printf "list ~a: " (json-count (json-get doc "list")))
    (write (json-at (json-get doc "list") 1) 0)
    (printf "missing ~a ~a ~a\n" (json-get doc "nothing") (json-at (json-get doc "list") 3) (json-get (json-get doc "f") "x"))
    (arena-free (& a))))

(define (builds!)
  (let ([a (make-arena)] [o (json-object 0 0 0)] [ns (json-array 0 0 0)] [text (array-of u8 #\a 1 #\b 31 255)])
    (json-add! (& a) (& o) "name" (json-string "Ada" 3))
    (json-push! (& a) (& ns) (json-number 1e21 0 0))
    (json-push! (& a) (& ns) (json-number -1e-7 0 0))
    (json-push! (& a) (& ns) (json-number 0.1 0 0))
    (json-push! (& a) (& ns) (json-number -0.0 0 0))
    (json-push! (& a) (& ns) (json-number 123456789012345680000.0 0 0))
    (json-push! (& a) (& ns) (json-number (/ 0.0 0.0) 0 0))
    (json-push! (& a) (& ns) (json-number 5e-324 0 0))
    (json-push! (& a) (& ns) (json-number 0.000001 0 0))
    (json-add! (& a) (& o) "numbers" ns)
    (json-add! (& a) (& o) "bytes" (json-string text 5))
    (write (& o) 0)
    (json-replace! (& a) (& o) "name" (json-string "Grace" 5))
    (json-remove-at! (json-get (& o) "numbers") 0)
    (json-insert! (& a) (json-get (& o) "numbers") 0 (json-boolean 1))
    (json-replace-at! (& a) (json-get (& o) "numbers") 1 (json-null))
    (printf "~a ~a ~a\n" (json-remove! (& o) "bytes") (json-remove! (& o) "bytes") (json-insert! (& a) (& o) 0 (json-null)))
    (write (& o) "\t")
    (arena-free (& a))))

(define (copies!)
  (let* ([a (make-arena)] [b (make-arena)] [doc (parse (& a) sample)] [copy (json-copy (& b) doc)])
    (arena-free (& a))
    (write copy 0)
    (printf "equal ~a\n" (json-equal? copy (parse (& b) sample)))
    (json-replace! (& b) (json-get copy "b") "d" (json-boolean 0))
    (printf "equal ~a\n" (json-equal? copy (parse (& b) sample)))
    (arena-free (& b))))

(define token-names (array (ptr u8) 12)
  (array-of (ptr u8) "error" "end" "[" "]" "{" "}" "key" "string" "number" "true" "false" "null"))

(define (tokens!)
  (let ([r json-reader] [t u32 0] [text (ptr u8) "{\"a\": [1, \"x\", {\"b\": null}], \"c\": [true], \"d\": -2.5e3}"])
    (json-reader-start! (& r) text (strlen text))
    (while 1
      (set! t (json-next! (& r)))
      (printf "~a" (@ token-names t))
      (cond [(or (== t json-token-key) (== t json-token-string))
             (printf " ~a" (bytes->text (-> r bytes) (-> r length)))]
            [(== t json-token-number) (printf " ~a" (-> r number))])
      (printf "\n")
      (when (or (== t json-token-end) (== t json-token-error)) (break))
      (when (and (== t json-token-key) (== (memcmp (-> r bytes) "c" 1) 0)) (printf "skipped ~a\n" (json-skip! (& r)))))
    (json-reader-free! (& r))))

(define (bytes->text [p (ptr u8)] [n u32]) -> (ptr u8)
  (let ([q (cast (ptr u8) (malloc (+ n 1)))])
    (memcpy q p n)
    (set! (@ q n) 0)
    q))

(define (main)
  (let ([a (make-arena)])
    (write (parse (& a) sample) 0)
    (write (parse (& a) sample) "  ")
    (write (parse (& a) "\xFEFF; [1]") 0)
    (arena-free (& a)))
  (errors!)
  (reads!)
  (builds!)
  (copies!)
  (tokens!))
