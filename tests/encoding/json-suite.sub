;; JSONTestSuite's parsing files: each y_ file parses and writes back to an equal value, each n_ file is refused, shown
;; with its error, and each i_ file's result is shown.
(require-unqualified json "../../lib/encoding/json.sub")
(require-unqualified fs "../../host/fs.sub")
(require-unqualified env "../../host/node/env.sub")

(define (path-of [dir string] [name string]) -> string
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) dir)
    (buffer-add-byte! (& b) #\/)
    (buffer-add-string! (& b) name)
    (buffer-string (& b))))

(define (sort! [names (slice string)])
  (for ([i u32 1]) (< i (-> names length)) (+= i 1)
    (let ([s (@ names i)] [j i])
      (while (and (> j 0) (> (@ names (- j 1)) s))
        (set! (@ names j) (@ names (- j 1)))
        (-= j 1))
      (set! (@ names j) s))))

(define (written-back? [a (ptr arena)] [v (ptr json-value)]) -> bool
  (let ([b (make-buffer)] [again (ptr json-value) 0])
    (json-write! (& b) v "")
    (set! again (json-parse a (buffer-string (& b)) 0))
    (buffer-free! (& b))
    (and (!= again 0) (json-equal? v again))))

(define (main)
  (let* ([err string] [root (env-get "JSON_TEST_SUITE" (& err))] [dir (path-of root "test_parsing")]
         [names (fs-list dir (& err))] [ys 0] [ys-ok 0] [ns 0] [ns-ok 0])
    (when (== (-> names items) 0)
      (printf "~a\n" err)
      (return))
    (sort! names)
    (for ([i u32 0]) (< i (-> names length)) (+= i 1)
      (let* ([name (@ names i)] [path (path-of dir name)] [text (fs-read-file path (& err))] [a (make-arena)]
             [problem json-error] [v (json-parse (& a) (cast string text) (& problem))])
        (case (@ name 0)
          [(#\y)
           (+= ys 1)
           (if (and (!= v 0) (written-back? (& a) v))
               (+= ys-ok 1)
               (printf "~a: not parsed and written back\n" name))]
          [(#\n)
           (+= ns 1)
           (if (== v 0)
               (begin
                 (+= ns-ok 1)
                 (printf "~a: ~a:~a: ~a\n" name (-> problem line) (-> problem column) (-> problem message)))
               (printf "~a: accepted\n" name))]
          [else
           (if (== v 0)
               (printf "~a: refused, ~a:~a: ~a\n" name (-> problem line) (-> problem column) (-> problem message))
               (printf "~a: accepted\n" name))])
        (arena-free (& a))
        (free (-> text items))
        (free (-> path bytes))))
    (printf "~a of ~a y_ files parsed and written back, ~a of ~a n_ files refused\n" ys-ok ys ns-ok ns)))
