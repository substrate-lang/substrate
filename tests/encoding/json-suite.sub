;; JSONTestSuite's parsing files: each y_ file parses and writes back to an equal value, each n_ file is refused, shown
;; with its error, and each i_ file's result is shown.
(require-unqualified json "../../lib/encoding/json.sub")
(require-unqualified fs "../../host/fs.sub")
(require-unqualified env "../../host/node/env.sub")

(define (path-of [dir (ptr u8)] [name (ptr u8)]) -> (ptr u8)
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) dir)
    (buffer-add-byte! (& b) #\/)
    (buffer-add-string! (& b) name)
    (buffer-add-byte! (& b) 0)
    (-> b bytes)))

(define (sort! [names (ptr (ptr u8))] [n u32])
  (for ([i u32 1]) (< i n) (+= i 1)
    (let ([s (@ names i)] [j i])
      (while (and (> j 0) (> (strcmp (@ names (- j 1)) s) 0))
        (set! (@ names j) (@ names (- j 1)))
        (-= j 1))
      (set! (@ names j) s))))

(define (written-back? [a (ptr arena)] [v (ptr json-value)]) -> i32
  (let ([b (make-buffer)] [again (ptr json-value) 0])
    (json-write! (& b) v 0)
    (set! again (json-parse a (-> b bytes) (-> b length) 0))
    (buffer-free! (& b))
    (and (!= again 0) (json-equal? v again))))

(define (main)
  (let* ([err (ptr u8) 0] [root (env-text "JSON_TEST_SUITE" (& err))] [dir (path-of root "test_parsing")] [n u32 0]
         [list (fs-list dir (& n) (& err))] [names (ptr (ptr u8)) 0] [count u32 0] [e list] [ys 0] [ys-ok 0] [ns 0]
         [ns-ok 0])
    (when (== list 0)
      (printf "~a\n" err)
      (return))
    (while (< e (+ list n))
      (+= count 1)
      (set! e (entry-after e)))
    (set! names (cast (ptr (ptr u8)) (malloc (* count 4))))
    (set! e list)
    (for ([i u32 0]) (< i count) (+= i 1)
      (set! (@ names i) e)
      (set! e (entry-after e)))
    (sort! names count)
    (for ([i u32 0]) (< i count) (+= i 1)
      (let* ([name (@ names i)] [m u32 0] [text (fs-read-file (path-of dir name) (& m) (& err))] [a (make-arena)]
             [problem json-error] [v (json-parse (& a) text m (& problem))])
        (case (@ name 0)
          [(#\y)
           (+= ys 1)
           (if (and (!= v 0) (written-back? (& a) v))
               (+= ys-ok 1)
               (printf "~a: not parsed and written back\n" name))]
          [(#\n)
           (+= ns 1)
           (if (== v 0)
               (begin
                 (+= ns-ok 1)
                 (printf "~a: ~a:~a: ~a\n" name (-> problem line) (-> problem column) (-> problem message)))
               (printf "~a: accepted\n" name))]
          [else
           (if (== v 0)
               (printf "~a: refused, ~a:~a: ~a\n" name (-> problem line) (-> problem column) (-> problem message))
               (printf "~a: accepted\n" name))])
        (arena-free (& a))
        (free text)))
    (printf "~a of ~a y_ files parsed and written back, ~a of ~a n_ files refused\n" ys-ok ys ns-ok ns)))
