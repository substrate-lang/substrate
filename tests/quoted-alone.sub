;; Quoted data has the syntax module's type even where the module cannot name it.
(require-unqualified tests std/test/test)
(define (pair-of [d (ptr void)]) -> i32 (!= d 0))
(define (main) (printf "~a\n" (pair-of (cast (ptr void) '(1 2)))))

(test quoted-alone (expect-output-file "quoted-alone.out" (main)))
