;; Inline functions: a call is compiled as the body, in any module, at phase 0 and 1.
(require lib "fixtures/inline-lib.sub")
(require-unqualified macros compiler/macros)
(require wasm compiler/wasm)

(begin-for-syntax
  (require lib "fixtures/inline-lib.sub")
  (printf "~a\n" (lib:add2 20 22)))

(wasm:func (twice [x i32]) #:inline -> i32 (wasm:i32.add x x))

(define (main)
  (printf "~a\n" (twice (twice 3)))
  (printf "~a\n" (lib:add2 (lib:add2 1 2) (lib:add2 3 4)))
  (printf "~a\n" (lib:count))
  (printf "~a~a~a\n" (lib:clamp 5 0 3) (lib:clamp -2 0 3) (lib:clamp 2 0 3))
  (printf "~a~a\n" (wasm:i32.eq (lib:yes-or-no 1) 'yes) (wasm:i32.eq (lib:yes-or-no 0) 'no)))
