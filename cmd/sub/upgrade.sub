;; substrate upgrade: the newest substrate from the npm registry, unpacked into the toolchains of SUBSTRATE_HOME.
(require-unqualified fs host/fs)
(require-unqualified json std/encoding/json)
(require-unqualified sha512 std/crypto/sha512)
(require-unqualified base64 std/encoding/base64)
(require-unqualified manifest std/package/manifest)
(require-unqualified paths std/package/path)
(require-unqualified common cmd/sub/common)
(require-unqualified build cmd/sub/build)
(require-unqualified fetching cmd/sub/fetch)

(provide upgrade-command!)

(define toolchains string)
(define version string)
(define integrity string)

(define (upgrade-command! [args (slice string)])
  (let ([d string] [r string])
    (unless (== (-> args length) 0) (usage))
    (set! toolchains (cond [(set-in? "SUBSTRATE_HOME" (& d)) (joined-path (absolute d) "toolchains")]
                           [(set-in? "HOME" (& d)) (joined-path (absolute d) ".substrate/toolchains")]
                           [else (failed! "neither SUBSTRATE_HOME nor HOME is set") ""]))
    (fetch-url! (joined (if (set-in? "SUBSTRATE_REGISTRY" (& r)) r "https://registry.npmjs.org") "/substrate-lang") listed)))

(define (listed)
  (let* ([err json-error] [doc (json-parse (& a) (cast string (fetched-bytes)) (& err))] [dist (ptr json-value) 0])
    (when (== doc 0) (fetch-failed! (joined "it is not JSON: " (-> err message))))
    (set! version (text-at (entry doc "dist-tags") "latest"))
    (when (== (-> version length) 0) (fetch-failed! "it names no latest version"))
    (unless (version-before? (substrate-version) version)
      (say 1 (joined (joined "substrate " (substrate-version)) " is the newest\n"))
      (host-exit 0))
    (when (== (kind-of (joined-path toolchains version)) fs-directory) (installed!))
    (set! dist (entry (entry (entry doc "versions") version) "dist"))
    (set! integrity (text-at dist "integrity"))
    (fetch-url! (text-at dist "tarball") checked)))

(define (checked)
  (unless (== (sha512-text (fetched-bytes)) integrity) (fetch-failed! "its hash is not the one the registry gives"))
  (unpack-into! toolchains unpacked))

(define (unpacked)
  (let ([why string])
    (when (< (fs-rename (unpacked-dir) (joined-path toolchains version) (& why)) 0)
      (fs-remove (unpacked-dir) #t 0)
      (failed! why))
    (installed!)))

(define (installed!)
  (say 1 (joined (joined (joined (joined "substrate " version) " is installed in ") (local (joined-path toolchains version)))
                 "\n"))
  (host-exit 0))

(define (entry [v (ptr json-value)] [key string]) -> (ptr json-value) (if (== v 0) 0 (json-get v key)))

(define (text-at [v (ptr json-value)] [key string]) -> string
  (let ([s string] [w (entry v key)]) (if (and (!= w 0) (json-as-string w (& s))) s "")))

(define (sha512-text [bytes (slice u8)]) -> string
  (let ([digest (array u8 64)] [b (make-buffer)])
    (sha512-of bytes (slice digest))
    (buffer-add-string! (& b) "sha512-")
    (base64-encode! (& b) (slice digest))
    (buffer-string (& b))))
