;; sub test: a package's tests built into one program and run.
(require-unqualified compiler/macros)
(require-unqualified compiler/roots)
(require-unqualified host/fs)
(require-unqualified host/events)
(require-unqualified host/node/process)
(require-unqualified host/grants)
(require-unqualified host/node/env)
(require-unqualified host/stream)
(require-unqualified std/package/manifest)
(require-unqualified std/package/path)
(require-unqualified cmd/sub/common)
(require-unqualified cmd/sub/build)
(require browser std/browser/chromium)

(provide test-directory test-command!)

;; ---- arguments ----

(define program-args buffer)
(define grant-args buffer)
(define dirs buffer)
(define passed-args buffer)
(define running bool #t)
(define jobs u32 2)
(define timeout-ms f64 60000.0)

;; The Chromium that browser tests run in, found once for a run, or no-chromium when there is none.
(define chromium string "")
(define no-chromium bool #f)

(define (options! [args (slice string)])
  (set! program-args (make-buffer))
  (set! grant-args (make-buffer))
  (set! dirs (make-buffer))
  (set! passed-args (make-buffer))
  (set! chromium "")
  (set! no-chromium #f)
  (let ([i u32 0] [n u64 0])
    (while (< i (-> args length))
      (let ([x (@ args i)])
        (unless (or (== x "-j") (and (> i 0) (== (@ args (- i 1)) "-j")) (package-arg? x) (browser-arg? x))
          (push! (& passed-args) x))
        (cond [(or (== x "-v") (== x "--ignored") (== x "--nocapture") (== x "--no-webgpu"))
               (push! (& program-args) x)]
              [(== x "--no-run") (set! running #f)]
              [(and (== x "--chromium") (< (+ i 1) (-> args length)))
               (+= i 1)
               (set! chromium (given-file (@ args i) "--chromium"))]
              [(== x "--no-chromium") (set! no-chromium #t)]
              [(and (== x "-j") (< (+ i 1) (-> args length)))
               (+= i 1)
               (unless (and (digits-integer (@ args i) 10 #f (& n)) (> n 0) (< n 1000)) (usage))
               (set! jobs (cast u32 n))]
              [(and (== x "-t") (< (+ i 1) (-> args length)))
               (+= i 1)
               (unless (and (digits-integer (@ args i) 10 #f (& n)) (> n 0) (< n 1000)) (usage))
               (push! (& passed-args) (@ args i))
               (push! (& program-args) x)
               (push! (& program-args) (@ args i))]
              [(and (== x "--timeout") (< (+ i 1) (-> args length)))
               (+= i 1)
               (push! (& passed-args) (@ args i))
               (set! timeout-ms (duration-ms (@ args i)))]
              [(or (== x "--fake") (starts? x "--fake="))
               (failed! "test: a test asks for fakes in its #:grants, not on the command line")]
              [(grants-flag? x) (push! (& grant-args) x)]
              [(package-arg? x) (push! (& dirs) (package-dir x))]
              [(starts? x "-") (usage)]
              [else (push! (& program-args) x)]))
      (+= i 1))))

(define (package-arg? [x string]) -> bool (or (starts? x ".") (absolute-path? x)))

(define (browser-arg? [x string]) -> bool (or (== x "--chromium") (== x "--no-chromium")))

(define (package-dir [x string]) -> string
  (let ([dir (absolute x)])
    (unless (== (kind-of (joined-path dir "package.sub")) fs-file) (failed! (joined x " is not a package's directory")))
    dir))

(define (duration-ms [text string]) -> f64
  (let ([n u64 0] [last (if (> (-> text length) 0) (@ text (- (-> text length) 1)) 0)])
    (cond [(== text "0") 0.0]
          [(and (or (== last #\s) (== last #\m) (== last #\h)) (> (-> text length) 1)
                (digits-integer (slice text 0 (- (-> text length) 1)) 10 #f (& n)))
           (* (cast f64 n) (cond [(== last #\s) 1000.0] [(== last #\m) 60000.0] [else 3600000.0]))]
          [else
           (usage)
           0.0])))

;; browsers! finds the Chromium for the run, unless the flags already say which or that there is none.
(define (browsers!)
  (unless (or no-chromium (> (-> chromium length) 0))
    (set! chromium (found-chromium))
    (when (== (-> chromium length) 0)
      (set! no-chromium #t)
      (say 1 "no Chromium was found, so the tests that open a browser are skipped: install Chromium or Chrome, or set SUBSTRATE_CHROMIUM to its file\n"))))

;; Whether the package in dir says (browser) in its tests clause.
(define (browsing? [dir string]) -> bool
  (let ([m manifest] [err (make-buffer)])
    (and (manifest-read (& a) (joined-path dir "package.sub") (& m) (& err)) (-> m test-browser))))

;; The Chromium that SUBSTRATE_CHROMIUM names, or else the first on PATH or in the usual places, or "" for none.
(define (found-chromium) -> string
  (let ([given string] [search string] [separator (if (system? "windows") ";" ":")] [places (usual-places)]
        [names (slice (array-of string "chromium" "chromium-browser" "google-chrome" "google-chrome-stable"))])
    (when (set-in? "SUBSTRATE_CHROMIUM" (& given)) (return (given-file given "SUBSTRATE_CHROMIUM")))
    (env-get "PATH" (& search) 0)
    (for ([k u32 0]) (< k (-> names length)) (+= k 1)
      (let ([start u32 0] [name (if (system? "windows") (joined (@ names k) ".exe") (@ names k))])
        (for ([i u32 0]) (<= i (-> search length)) (+= i 1)
          (when (or (== i (-> search length)) (== (@ search i) (@ separator 0)))
            (let ([file (joined-path (slice search start i) name)])
              (when (and (> i start) (== (kind-of file) fs-file)) (return file)))
            (set! start (+ i 1))))))
    (for ([k u32 0]) (< k (-> places length)) (+= k 1) (when (== (kind-of (@ places k)) fs-file) (return (@ places k))))
    ""))

;; Where Chrome and Chromium are installed on macOS and Windows, which do not put them on PATH.
(define (usual-places) -> (slice string)
  (let ([out (make-buffer)] [base string]
        [apps (slice (array-of string "Google Chrome.app/Contents/MacOS/Google Chrome" "Chromium.app/Contents/MacOS/Chromium"))]
        [bases (slice (array-of string "ProgramFiles" "ProgramFiles(x86)" "LOCALAPPDATA"))])
    (cond [(system? "macos")
           (for ([k u32 0]) (< k (-> apps length)) (+= k 1)
             (push! (& out) (joined-path "/Applications" (@ apps k)))
             (when (set-in? "HOME" (& base)) (push! (& out) (joined-path base (joined-path "Applications" (@ apps k))))))]
          [(system? "windows")
           (for ([k u32 0]) (< k (-> bases length)) (+= k 1)
             (when (set-in? (@ bases k) (& base))
               (push! (& out) (joined-path base "Google/Chrome/Application/chrome.exe"))
               (push! (& out) (joined-path base "Chromium/Application/chrome.exe"))))])
    (strings (& out))))

(define (given-file [file string] [what string]) -> string
  (let ([full (absolute file)])
    (unless (== (kind-of full) fs-file) (failed! (joined (joined (joined (joined "test: " what) " is ") file) ", which is not a file")))
    full))

(define (push! [b (ptr buffer)] [s string]) (buffer-add! b (slice (cast (ptr u8) (& s)) (sizeof string))))

(define (strings [b (ptr buffer)]) -> (slice string) (slice (cast (ptr string) (-> b bytes)) (/ (-> b length) (sizeof string))))

(define (test-directory [args (slice string)]) -> string
  (options! args)
  (let ([named (strings (& dirs))] [holder string])
    (cond [(== (-> named length) 1) (@ named 0)]
          [(> (-> named length) 1) ""]
          [else
           (set! holder (package-holding (& a) cwd))
           (when (== (-> holder length) 0) (failed! "the current directory is in no package"))
           holder])))

(define (test-command! [args (slice string)])
  (options! args)
  (if (> (-> (strings (& dirs)) length) 1) (test-several!) (test-one!)))

;; ---- several packages ----

(struct child [head event-head] [dir string] [out stream-reader] [err stream-reader] [code i32] [left u32])

(define children (ptr child) 0)
(define started u32 0)
(define ended u32 0)
(define failures u32 0)

(define (test-several!)
  (let ([n (-> (strings (& dirs)) length)] [browsing #f])
    (for ([i u32 0]) (< i n) (+= i 1) (when (browsing? (@ (strings (& dirs)) i)) (set! browsing #t)))
    (when (and running browsing) (browsers!))
    (set! children (-> (new 0 child n) items))
    (while (and (< started n) (< started jobs)) (start-child!))))

(define (start-child!)
  (let* ([c (& (@ children started))] [argv (make-buffer)] [o process-options] [why string] [id u32 0])
    (set! (-> c dir) (@ (strings (& dirs)) started))
    (+= started 1)
    (push! (& argv) root)
    (push! (& argv) "test")
    (push! (& argv) (-> c dir))
    (when (> (-> given-cache length) 0)
      (push! (& argv) "-c")
      (push! (& argv) given-cache))
    (when (> (-> given-packages length) 0)
      (push! (& argv) "-P")
      (push! (& argv) given-packages))
    (for-each-string (& passed-args) (& argv))
    (when no-chromium (push! (& argv) "--no-chromium"))
    (when (> (-> chromium length) 0)
      (push! (& argv) "--chromium")
      (push! (& argv) chromium))
    (process-options-init! (& o))
    (set! (-> o stdin) process-ignore)
    (set! (-> c head handle) child-ended)
    (set! (-> c left) 3)
    (set! id (process-spawn (joined-path (substrate-dir) "host/subhost.mjs")
                            (grants-arguments (every-grant) (joined-path root "build/sub") (strings (& argv))) (& o)
                            (& (-> c head)) (& why)))
    (when (== id 0) (failed! why))
    (stream-read-all! (& (-> c out)) (process-stdout id) read-out)
    (stream-read-all! (& (-> c err)) (process-stderr id) read-err)))

(define (child-ended [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (== source process-source)
    (let ([c (cast (ptr child) tag)])
      (set! (-> c code) (if (== kind process-exit) value 1))
      (child-done! c))))

(define (read-out [r (ptr stream-reader)]) (child-done! (cast (ptr child) (- (cast u32 r) (offsetof child out)))))

(define (read-err [r (ptr stream-reader)]) (child-done! (cast (ptr child) (- (cast u32 r) (offsetof child err)))))

(define (child-done! [c (ptr child)])
  (-= (-> c left) 1)
  (when (== (-> c left) 0)
    (host-write 2 (buffer-bytes (& (-> c err bytes))))
    (host-write 1 (buffer-bytes (& (-> c out bytes))))
    (unless (== (-> c code) 0) (+= failures 1))
    (+= ended 1)
    (let ([n (-> (strings (& dirs)) length)])
      (cond [(< started n) (start-child!)]
            [(== ended n) (host-exit (if (> failures 0) 1 0) "")]))))

;; ---- one package ----

(define tested-dir string)
(define program-out string)

(define (test-one!)
  (let* ([dir program-dir] [out (joined-path dir "build/test")] [main (joined-path out "main.sub")])
    (prepare-tests!)
    (made! out)
    (main! main dir)
    (cache!)
    (set! tested-dir dir)
    (set! program-out (joined-path out "program"))
    (compile! "build" main program-out (slice (cast (ptr string) 0) 0) (compiler-grants main program-out) built)))

(define (built [code i32])
  (cond [(!= code 0) (host-exit code "")]
        [(not running) (host-exit 0 "")]
        [else (run-program!)]))

(struct test-run [head event-head])

(define test-process test-run)

;; The Chromium that a package's browser tests share, started in the run's scratch directory and given as long to start
;; as a test is given to run.
(define launched browser:chromium)
(define launching bool #f)

(define (run-program!)
  (let ([why string] [args string])
    (when (-> program-manifest test-browser) (browsers!))
    (when (< (fs-make-temp-dir "" "sub-test-" "" (& scratch) (& why)) 0) (failed! why))
    (when (< (fs-real-path scratch (& scratch) (& why)) 0) (failed! why))
    (set! scratch (normal-path (& a) scratch))
    (if (and (-> program-manifest test-browser) (not no-chromium))
        (begin
          (env-get "SUBSTRATE_CHROMIUM_ARGS" (& args) 0)
          (unless (browser:chromium-start (& launched) chromium (joined-path scratch "chromium") (words args) timeout-ms
                                          chromium-started (& why))
            (fs-remove scratch #t 0)
            (failed! why))
          (set! launching #t))
        (tests-started! ""))))

(define (chromium-started [c (ptr browser:chromium)])
  (when (> (-> c why length) 0)
    (fs-remove scratch #t 0)
    (failed! (joined "test: " (-> c why))))
  (tests-started! (-> c address)))

;; needs holds the grants that every test gets besides its own #:grants.
(define (tests-started! [address string])
  (let* ([browsing (-> program-manifest test-browser)] [needs (make-grants)] [g (make-grants)] [argv (make-buffer)]
         [env (make-buffer)] [dirs (root-directories)] [map-file (joined-path tested-dir "build/test/test.map")]
         [o process-options] [why string])
    (map-written! map-file)
    (grants-allow! (& needs) grant-read (substrate-dir))
    (while (pair? dirs)
      (grants-allow! (& needs) grant-read (datum->string (car dirs)))
      (set! dirs (cdr dirs)))
    (grants-allow! (& needs) grant-read cache-dir)
    (grants-allow! (& needs) grant-write (joined-path tested-dir "build/test"))
    (grants-allow! (& needs) grant-write cache-dir)
    (grants-allow! (& needs) grant-env "SUBSTRATE_TOOLCHAIN")
    (grants-allow! (& needs) grant-env "SUBSTRATE_CACHE")
    (grants-allow! (& needs) grant-env "SUBSTRATE_MODULE_MAP")
    (grants-allow! (& needs) grant-env "SUBSTRATE_SCRATCH")
    (push! (& env) (joined "SUBSTRATE_TOOLCHAIN=" (substrate-dir)))
    (push! (& env) (joined "SUBSTRATE_CACHE=" cache-dir))
    (push! (& env) (joined "SUBSTRATE_MODULE_MAP=" map-file))
    (push! (& env) (joined "SUBSTRATE_SCRATCH=" scratch))
    (when browsing
      (grants-allow! (& needs) grant-env "SUBSTRATE_DEVTOOLS")
      (push! (& env) (joined "SUBSTRATE_DEVTOOLS=" address))
      (when (> (-> address length) 0) (grants-allow! (& needs) grant-net (host-of-address address))))
    (grants-join! (& g) (& needs))
    (grants-allow! (& g) grant-read scratch)
    (grants-allow! (& g) grant-write scratch)
    (let ([given (make-grants)])
      (unless (grants-parse! (& given) (strings (& grant-args)) (& why)) (failed! why))
      (located-grants! (& given))
      (grants-join! (& g) (& given)))
    (push! (& argv) "--name")
    (push! (& argv) program-package)
    (push! (& argv) "--timeout-ms")
    (push! (& argv) (let ([b (make-buffer)]) (write-digits (& b) (cast u64 timeout-ms) 10) (buffer-string (& b))))
    (let ([l (slice (cast (ptr grant) (-> needs list bytes)) (/ (-> needs list length) (sizeof grant)))])
      (for ([i u32 0]) (< i (-> l length)) (+= i 1)
        (push! (& argv) "--grant")
        (push! (& argv) (-> (& (@ l i)) kind))
        (push! (& argv) (-> (& (@ l i)) item))))
    (for-each-string (& program-args) (& argv))
    (process-options-init! (& o))
    (set! (-> o dir) tested-dir)
    (set! (-> o env) (strings (& env)))
    (set! (-> o stdin) process-inherit)
    (set! (-> o stdout) process-inherit)
    (set! (-> o stderr) process-inherit)
    (set! (-> test-process head handle) ran)
    (when (== (process-spawn (joined-path (substrate-dir) "host/subhost.mjs")
                             (grants-arguments (& g) program-out (strings (& argv))) (& o) (& test-process) (& why))
              0)
      (failed! why))))

;; Grant paths on the command line are relative to this directory, but the test program runs in the package's directory.
(define (located-grants! [g (ptr grants)])
  (let ([l (slice (cast (ptr grant) (-> g list bytes)) (/ (-> g list length) (sizeof grant)))])
    (for ([i u32 0]) (< i (-> l length)) (+= i 1)
      (let* ([e (& (@ l i))] [k (-> e kind)])
        (when (or (== k "read") (== k "write") (== k "deny-read") (== k "deny-write") (== k "fetch") (== k "tls-cert")
                  (== k "tls-key") (and (or (== k "run") (== k "deny-run")) (contains-slash? (-> e item))))
          (set! (-> e item) (absolute (-> e item))))))))

(define (contains-slash? [s string]) -> bool
  (for ([i u32 0]) (< i (-> s length)) (+= i 1) (when (or (== (@ s i) #\/) (== (@ s i) #\\)) (return #t)))
  #f)

(define (for-each-string [from (ptr buffer)] [to (ptr buffer)])
  (let ([l (strings from)]) (for ([i u32 0]) (< i (-> l length)) (+= i 1) (push! to (@ l i)))))

;; The host and port of a DevTools address such as ws://127.0.0.1:9222/devtools/browser/id.
(define (host-of-address [address string]) -> string
  (let ([start (if (starts? address "ws://") 5 0)] [end u32 0])
    (set! end start)
    (while (and (< end (-> address length)) (!= (@ address end) #\/)) (+= end 1))
    (slice address start end)))

(define (words [s string]) -> (slice string)
  (let ([out (make-buffer)] [start u32 0])
    (for ([i u32 0]) (<= i (-> s length)) (+= i 1)
      (when (or (== i (-> s length)) (== (@ s i) #\space))
        (when (> i start) (push! (& out) (slice s start i)))
        (set! start (+ i 1))))
    (strings (& out))))

(define scratch string)
(define exit-code i32 0)
(define failure string "")

(define (ran [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (== source process-source)
    (if (== kind process-exit) (set! exit-code value) (set! failure (kept (& a) (events-take-text))))
    (if launching (browser:chromium-stop (& launched) finished) (finished (& launched)))))

(define (finished [c (ptr browser:chromium)])
  (fs-remove scratch #t 0)
  (when (> (-> failure length) 0) (failed! failure))
  (host-exit exit-code ""))

;; ---- the program ----

(define (main! [main string] [dir string])
  (let ([text (make-buffer)] [modules (append (package-modules dir) (test-modules dir))] [k u32 0] [seen datum nil]
        [why string])
    (buffer-add-string! (& text) ";; The test program for the package ")
    (buffer-add-string! (& text) program-package)
    (buffer-add-string! (& text) ", which substrate test writes.\n(require-unqualified std/test/test)\n")
    (while (pair? modules)
      (unless (!= (member (car modules) seen) 0)
        (set! seen (cons (car modules) seen))
        (buffer-add-string! (& text) "(require t")
        (write-digits (& text) k 10)
        (buffer-add-byte! (& text) 32)
        (write-string (& text) (joined "../../" (datum->string (car modules))))
        (buffer-add-string! (& text) ")\n")
        (+= k 1))
      (set! modules (cdr modules)))
    (buffer-add-string! (& text) "(define (main) (run-tests")
    (for ([i u32 0]) (< i k) (+= i 1)
      (buffer-add-string! (& text) " t")
      (write-digits (& text) i 10))
    (buffer-add-string! (& text) "))\n")
    (when (< (fs-write-file main (buffer-bytes (& text)) (& why)) 0) (failed! why))))

(define (package-modules [dir string]) -> datum (sorted (modules-in dir "" (test-directories))))

(define (modules-in [dir string] [sub string] [skipped datum]) -> datum
  (let ([names (slice string)] [out nil] [m manifest] [err (make-buffer)])
    (when (or (!= (member (string->datum sub) skipped) 0)
              (< (fs-list (if (== (-> sub length) 0) dir (joined-path dir sub)) (& names) 0) 0))
      (return nil))
    (for ([i u32 0]) (< i (-> names length)) (+= i 1)
      (let* ([name (@ names i)] [path (if (== (-> sub length) 0) name (joined-path sub name))] [full (joined-path dir path)]
             [kind (kind-of full)])
        (cond [(and (== kind fs-directory) (!= name "build") (not (starts? name "."))
                    (!= (kind-of (joined-path full "package.sub")) fs-file))
               (set! out (append (modules-in dir path skipped) out))]
              [(and (== kind fs-file) (ends? name ".sub") (!= name "package.sub"))
               (let ([own (manifest-of-program (& a) full (& m) (& err))])
                 (when (< own 0) (failed! (local (buffer-string (& err)))))
                 (when (== own 0) (set! out (cons (string->datum path) out))))])))
    out))

(define (test-directories) -> datum
  (let ([patterns (-> program-manifest tests)] [out nil])
    (for ([i u32 0]) (< i (-> patterns length)) (+= i 1)
      (let* ([p (@ patterns i)] [cut (last-slash p)])
        (set! out (cons (string->datum (if (< cut 0) "" (slice p 0 (cast u32 cut)))) out))))
    out))

(define (test-modules [dir string]) -> datum
  (let ([patterns (-> program-manifest tests)] [out nil])
    (for ([i u32 0]) (< i (-> patterns length)) (+= i 1)
      (let* ([p (@ patterns i)] [cut (last-slash p)] [sub (if (< cut 0) "" (slice p 0 (cast u32 cut)))]
             [name (slice p (cast u32 (+ cut 1)))] [names (slice string)] [found nil])
        (when (>= (fs-list (if (== (-> sub length) 0) dir (joined-path dir sub)) (& names) 0) 0)
          (for ([j u32 0]) (< j (-> names length)) (+= j 1)
            (let ([f (if (== (-> sub length) 0) (@ names j) (joined-path sub (@ names j)))])
              (when (and (matches? (@ names j) name) (!= (@ names j) "package.sub") (== (kind-of (joined-path dir f)) fs-file))
                (set! found (cons (string->datum f) found))))))
        (set! out (append out (sorted found)))))
    out))

(define (last-slash [s string]) -> i32
  (let ([at i32 -1]) (for ([i u32 0]) (< i (-> s length)) (+= i 1) (when (== (@ s i) #\/) (set! at (cast i32 i)))) at))

(define (sorted [l datum]) -> datum (sort l (lambda ([x datum] [y datum]) -> bool (< (datum->string x) (datum->string y)))))
