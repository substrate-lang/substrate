;; The site and pack commands. A site is a directory that a static server can serve. It holds index.html, the web host,
;; the program, the assets listed in assets.list, and files.pack with the files the site declares.
(require-unqualified macros compiler/macros)
(require-unqualified fs host/fs)
(require-unqualified manifests std/package/manifest)
(require-unqualified pack "pack.sub")
(require-unqualified paths std/package/path)
(require-unqualified common cmd/sub/common)
(require-unqualified build cmd/sub/build)

(provide pack! site! site-program)

(define (pack! [args (slice string)])
  (let ([to (option args "-o")] [from (option args "-C")] [paths (without (without args "-o" #t) "-C" #t)]
        [err (make-buffer)])
    (when (or (== (-> to length) 0) (== (-> paths length) 0)) (usage))
    (unless (pack-files (if (== (-> from length) 0) "." from) paths to (& err)) (failed! (buffer-string (& err))))))

(define (copied! [from string] [to string])
  (let ([why string]) (when (< (fs-copy from to (& why)) 0) (failed! why))))

(define (names-in [dir string]) -> (slice string)
  (let ([names (slice string)] [why string])
    (when (< (fs-list dir (& names) (& why)) 0) (failed! why))
    names))

(define (copy-tree! [from string] [to string] [base string] [files (ptr buffer)])
  (let ([names (names-in from)])
    (made! to)
    (for ([i u32 0]) (< i (-> names length)) (+= i 1)
      (let* ([name (@ names i)] [f (joined-path from name)] [t (joined-path to name)] [b (joined-path base name)])
        (if (== (kind-of f) fs-directory)
            (copy-tree! f t b files)
            (begin
              (copied! f t)
              (buffer-add! files (slice (cast (ptr u8) (& b)) (sizeof string)))))))))

(define (copy-modules! [from string] [to string])
  (let ([names (names-in from)])
    (for ([i u32 0]) (< i (-> names length)) (+= i 1)
      (let ([name (@ names i)])
        (when (and (ends? name ".mjs") (== (kind-of (joined-path from name)) fs-file))
          (copied! (joined-path from name) (joined-path to name)))))))

(define (written! [path string] [b (slice u8)])
  (let ([why string]) (when (< (fs-write-file path b (& why)) 0) (failed! why))))

(struct plan [name string] [program string] [html string] [files (slice site-files)] [base string])

;; Reports whether spec is a site's name rather than the path of a program's source or directory. A path holds a
;; separator or ends in .sub.
(define (named? [spec string]) -> bool
  (for ([i u32 0]) (< i (-> spec length)) (+= i 1) (when (or (== (@ spec i) #\/) (== (@ spec i) #\\)) (return #f)))
  (not (ends? spec ".sub")))

;; declared finds the site called name in the package that holds the current directory.
(define (declared [name string]) -> plan
  (let ([dir (package-holding (& a) cwd)] [m manifest] [err (make-buffer)] [p plan])
    (when (== (-> dir length) 0) (failed! (joined (joined "site: " name) " is not a program, and the current directory is in no package")))
    (unless (manifest-read (& a) (joined-path dir "package.sub") (& m) (& err)) (failed! (local (buffer-string (& err)))))
    (for ([i u32 0]) (< i (-> m sites length)) (+= i 1)
      (let ([s (& (@ (-> m sites) i))])
        (when (== (-> s name) name)
          (return (plan #:name name #:program (resolved-path dir (-> s program))
                        #:html (if (== (-> s html length) 0) "" (resolved-path dir (-> s html))) #:files (-> s files)
                        #:base dir)))))
    (failed! (joined (joined (joined "site: the package " (-> m name)) " has no site ") name))
    p))

;; site-program gives the source file of the program that spec's site runs, or "" when that program is already built.
(define (site-program [spec string]) -> string
  (let ([program (if (named? spec) (-> (declared spec) program) (absolute spec))])
    (if (== (kind-of program) fs-directory) "" program)))

(define (star? [s string]) -> bool
  (for ([i u32 0]) (< i (-> s length)) (+= i 1) (when (== (@ s i) #\*) (return #t)))
  #f)

(define (kept! [into (ptr buffer)] [path string])
  (let ([ps (cast (ptr string) (-> into bytes))] [n (/ (-> into length) (sizeof string))])
    (for ([i u32 0]) (< i n) (+= i 1) (when (== (@ ps i) path) (return)))
    (buffer-add! into (slice (cast (ptr u8) (& path)) (sizeof string)))))

;; matched! adds to into the paths under base that match parts from k on, where rel is the path matched so far.
(define (matched! [base string] [rel string] [parts (slice string)] [k u32] [into (ptr buffer)])
  (let ([here (if (== (-> rel length) 0) base (joined-path base rel))])
    (cond [(== k (-> parts length)) (when (!= (kind-of here) 0) (kept! into rel))]
          [(== (@ parts k) "**")
           (matched! base rel parts (+ k 1) into)
           (when (== (kind-of here) fs-directory)
             (let ([names (names-in here)])
               (for ([i u32 0]) (< i (-> names length)) (+= i 1)
                 (when (== (kind-of (joined-path here (@ names i))) fs-directory)
                   (matched! base (child rel (@ names i)) parts k into)))))]
          [(star? (@ parts k))
           (when (== (kind-of here) fs-directory)
             (let ([names (names-in here)])
               (for ([i u32 0]) (< i (-> names length)) (+= i 1)
                 (when (matches? (@ names i) (@ parts k)) (matched! base (child rel (@ names i)) parts (+ k 1) into)))))]
          [else (matched! base (child rel (@ parts k)) parts (+ k 1) into)])))

(define (child [rel string] [name string]) -> string (if (== (-> rel length) 0) name (joined-path rel name)))

(define (parts-of [pattern string]) -> (slice string)
  (let ([out (make-buffer)] [start u32 0])
    (for ([i u32 0]) (<= i (-> pattern length)) (+= i 1)
      (when (or (== i (-> pattern length)) (== (@ pattern i) #\/))
        (when (> i start)
          (let ([part (slice pattern start i)]) (buffer-add! (& out) (slice (cast (ptr u8) (& part)) (sizeof string)))))
        (set! start (+ i 1))))
    (slice (cast (ptr string) (-> out bytes)) (/ (-> out length) (sizeof string)))))

(define (packed! [p (ptr plan)] [g (ptr site-files)] [files (ptr buffer)])
  (let ([base (if (== (-> g from length) 0) (-> p base) (resolved-path (-> p base) (-> g from)))] [found (make-buffer)]
        [err (make-buffer)])
    (for ([i u32 0]) (< i (-> g patterns length)) (+= i 1)
      (let ([before (-> found length)])
        (matched! base "" (parts-of (@ (-> g patterns) i)) 0 (& found))
        (when (== (-> found length) before)
          (failed! (joined (joined (joined "site: nothing in " base) " matches ") (@ (-> g patterns) i))))))
    (unless (pack-add! files base (slice (cast (ptr string) (-> found bytes)) (/ (-> found length) (sizeof string)))
                       (-> g dir) (& err))
      (failed! (buffer-string (& err))))))

(define (site! [args (slice string)])
  (let* ([plain (without (without args "-o" #t) "--html" #t)] [given-html (option args "--html")]
         [p plan] [list (make-buffer)] [files (make-buffer)] [packed (make-buffer)] [err (make-buffer)] [why string])
    (unless (== (-> plain length) 1) (usage))
    (if (named? (@ plain 0))
        (set! p (declared (@ plain 0)))
        (set! p (plan #:name (stem-of (@ plain 0)) #:program (absolute (@ plain 0)) #:html ""
                      #:files (slice (cast (ptr site-files) 0) 0) #:base cwd)))
    (when (> (-> given-html length) 0) (set! (-> p html) (absolute given-html)))
    (let* ([given-out (option args "-o")]
           [out (if (> (-> given-out length) 0) (absolute given-out)
                    (joined-path (-> p base) (joined "build/sites/" (-> p name))))])
      (when (and (!= (kind-of out) 0)
                 (or (!= (kind-of out) fs-directory)
                     (and (> (-> (names-in out) length) 0) (!= (kind-of (joined-path out ".site")) fs-file))))
        (failed! (joined (joined "site: " out) " is not a site, so it is not replaced")))
      (when (and (!= (kind-of out) 0) (< (fs-remove out #t (& why)) 0)) (failed! why))
      (made! (joined-path out "host/modules"))
      (made! (joined-path out "host/web"))
      (written! (joined-path out ".site") (cast (slice u8) (joined (-> p program) "\n")))
      (let ([assets (joined-path (parent-of (-> p program)) "assets")] [found (make-buffer)])
        (when (== (kind-of assets) fs-directory)
          (copy-tree! assets (joined-path out "assets") "assets" (& found))
          (let ([ps (cast (ptr string) (-> found bytes))] [n (/ (-> found length) (sizeof string))])
            (for ([i u32 1]) (< i n) (+= i 1)
              (let ([s (@ ps i)] [j i])
                (while (and (> j 0) (< s (@ ps (- j 1))))
                  (set! (@ ps j) (@ ps (- j 1)))
                  (-= j 1))
                (set! (@ ps j) s)))
            (for ([i u32 0]) (< i n) (+= i 1)
              (buffer-add-string! (& list) (@ ps i))
              (buffer-add-byte! (& list) 10)))))
      (written! (joined-path out "assets.list") (buffer-bytes (& list)))
      (for ([i u32 0]) (< i (-> p files length)) (+= i 1) (packed! (& p) (& (@ (-> p files) i)) (& packed)))
      (unless (pack-write! (& packed) (joined-path out "files.pack") (& err)) (failed! (buffer-string (& err))))
      (copy-modules! (joined-path (substrate-dir) "host") (joined-path out "host"))
      (copy-modules! (joined-path (substrate-dir) "host/modules") (joined-path out "host/modules"))
      (copy-modules! (joined-path (substrate-dir) "host/web") (joined-path out "host/web"))
      (copied! (if (== (-> p html length) 0) (joined-path (substrate-dir) "host/web/index.html") (-> p html))
               (joined-path out "index.html"))
      (if (== (kind-of (-> p program)) fs-directory)
          (copy-tree! (-> p program) (joined-path out "program") "" (& files))
          (let ([dir (begin (prepare! (-> p program)) (joined-path out "program"))])
            (cache!)
            (compile! "build" (-> p program) dir (slice (cast (ptr string) 0) 0) (grants (-> p program) dir) built))))))

(define (built [code i32]) (host-exit code))
