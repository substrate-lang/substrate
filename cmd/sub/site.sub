;; The site and pack commands. std/package/site.sub and std/package/pack.sub write sites and packs; substrate site
;; also builds the site's program, as substrate build does.
(require-unqualified macros compiler/macros)
(require-unqualified fs host/fs)
(require-unqualified manifests std/package/manifest)
(require-unqualified pack std/package/pack)
(require-unqualified sites std/package/site)
(require-unqualified paths std/package/path)
(require-unqualified common cmd/sub/common)
(require-unqualified build cmd/sub/build)

(provide pack! site! site-program)

(define (pack! [args (slice string)])
  (let ([to (option args "-o")] [from (option args "-C")] [paths (without (without args "-o" #t) "-C" #t)]
        [err (make-buffer)])
    (when (or (== (-> to length) 0) (== (-> paths length) 0)) (usage))
    (unless (pack-files (if (== (-> from length) 0) "." from) paths to (& err)) (failed! (buffer-string (& err))))))

(define (plan-of [spec string]) -> site-plan
  (if (site-named? spec)
      (let ([dir (package-holding (& a) cwd)] [p site-plan] [err (make-buffer)])
        (when (== (-> dir length) 0) (failed! (joined (joined "site: " spec) " is not a program, and the current directory is in no package")))
        (unless (site-declared (& a) dir spec (& p) (& err)) (failed! (local (buffer-string (& err)))))
        p)
      (site-plan #:name (stem-of spec) #:program (absolute spec) #:html "" #:files (slice (cast (ptr site-files) 0) 0)
                 #:base cwd)))

;; site-program gives the source file of the program that spec's site runs, or "" when that program is already built.
(define (site-program [spec string]) -> string
  (let ([program (-> (plan-of spec) program)])
    (if (== (kind-of program) fs-directory) "" program)))

(define (site! [args (slice string)])
  (let* ([plain (without (without args "-o" #t) "--html" #t)] [given-html (option args "--html")] [p site-plan]
         [err (make-buffer)])
    (unless (== (-> plain length) 1) (usage))
    (set! p (plan-of (@ plain 0)))
    (when (> (-> given-html length) 0) (set! (-> p html) (absolute given-html)))
    (let* ([given-out (option args "-o")]
           [out (if (> (-> given-out length) 0) (absolute given-out)
                    (joined-path (-> p base) (joined "build/sites/" (-> p name))))])
      (unless (site-write! (& p) out (substrate-dir) (& err)) (failed! (buffer-string (& err))))
      (unless (== (kind-of (-> p program)) fs-directory)
        (let ([dir (begin (prepare! (-> p program)) (joined-path out "program"))])
          (cache!)
          (compile! "build" (-> p program) dir (slice (cast (ptr string) 0) 0) (compiler-grants (-> p program) dir)
                    built))))))

(define (built [code i32]) (host-exit code ""))
