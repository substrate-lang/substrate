;; The site and pack commands. std/package/site.sub and std/package/pack.sub write sites and packs; substrate site
;; also builds the site's program, as substrate build does.
(require-unqualified compiler/macros)
(require-unqualified host/fs)
(require-unqualified std/package/manifest)
(require-unqualified std/package/pack)
(require-unqualified std/package/site)
(require-unqualified std/package/path)
(require-unqualified cmd/sub/common)
(require-unqualified cmd/sub/build)
(require-unqualified std/string)

(provide pack! site! site-program)

(define (pack! [args (slice string)])
  (let ([to (option args "-o")] [from (option args "-C")] [paths (without (without args "-o" #t) "-C" #t)]
        [err (make-buffer)])
    (when (or (== (-> to length) 0) (== (-> paths length) 0)) (usage))
    (unless (pack-files (if (== (-> from length) 0) "." from) paths to (& err)) (failed! (buffer-string (& err))))))

(define (plan-of [spec string]) -> site-plan
  (if (site-named? spec)
      (let ([dir (package-holding (& a) cwd)] [p site-plan] [err (make-buffer)])
        (when (== (-> dir length) 0) (failed! (string-append 0 "site: " spec " is not a program, and the current directory is in no package")))
        (unless (site-declared (& a) dir spec (& p) (& err)) (failed! (local (buffer-string (& err)))))
        p)
      (site-plan #:name (stem-of spec) #:program (absolute spec) #:html "" #:files (slice (cast (ptr site-files) 0) 0)
                 #:base cwd #:url-base "" #:mounts (slice (cast (ptr site-mount) 0) 0))))

;; site-program gives the source file of the program that spec's site runs, or "" when that program is already built.
(define (site-program [spec string]) -> string
  (let ([program (-> (plan-of spec) program)])
    (if (== (kind-of program) fs-directory) "" program)))

(define (site! [args (slice string)])
  (let* ([plain (without (without (without args "-o" #t) "--html" #t) "--release" #f)]
         [given-html (option args "--html")] [release (flag? args "--release")] [p site-plan] [err (make-buffer)])
    (unless (== (-> plain length) 1) (usage))
    (set! p (plan-of (@ plain 0)))
    (when (> (-> given-html length) 0) (set! (-> p html) (absolute given-html)))
    (let* ([given-out (option args "-o")]
           [out (if (> (-> given-out length) 0) (absolute given-out)
                    (joined-path (-> p base) (string-append 0 "build/sites/" (-> p name))))]
           [built-already (== (kind-of (-> p program)) fs-directory)])
      (unless built-already (prepare! (-> p program)))
      (unless (site-write! (& p) out (substrate-dir) (& err)) (failed! (buffer-string (& err))))
      (set! releasing release)
      (let ([kept (new (& a) site-plan)])
        (set! (@ kept) p)
        (set! parts (site-parts (& a) kept out)))
      (built 0))))

(define parts (slice site-part))
(define next u32 0)
(define releasing bool #f)

(define (built [code i32])
  (unless (== code 0) (host-exit code ""))
  (while (and (< next (-> parts length)) (== (kind-of (-> (@ parts next) plan program)) fs-directory)) (+= next 1))
  (if (< next (-> parts length))
      (let* ([part (& (@ parts next))] [dir (joined-path (-> part out) "program")] [program (-> part plan program)])
        (+= next 1)
        (cache!)
        (compile! "build" program dir (if releasing (slice (array-of string "-s" "-t" "web")) (slice (array-of string "-t" "web")))
                  (compiler-grants program dir) built))
      (begin
        (when releasing
          (let ([err (make-buffer)] [i (-> parts length)])
            (while (> i 0)
              (-= i 1)
              (unless (site-release! (-> (@ parts i) out) (& err)) (failed! (buffer-string (& err)))))))
        (host-exit 0 ""))))
