;; What sub's modules share: the toolchain's directory, the current directory, an arena, and small helpers.
(require-unqualified fs host/fs)
(require-unqualified paths std/package/path)

(provide root cwd a say usage failed! absolute local joined stem-of option without flag? kind-of made!)

(define root string)
(define cwd string)
(define a arena)

(define (say [fd i32] [s string]) (host-write fd (cast (slice u8) s)))

(define (usage)
  (say 2 "usage: sub build FILE [-o DIR] [-s] | run [GRANT ...] FILE|DIR [ARG ...] | eval FILE | expand FILE\n")
  (say 2 "         | site OUT FILE [-p PAGE] [-f NAME PATH ...] | serve [-l ADDRESS] [-t CERT KEY] [-z LEVEL] [DIR]\n")
  (say 2 "         | pack -o OUT [-C DIR] PATH ... | hash [DIR] | map FILE | fetch URL|FILE\n")
  (say 2 "         | doc NAME [ITEM] | doc -o DIR [--html] PACKAGE ...\n")
  (say 2 "       -c DIR and -P DIR place the cache and the packages, else SUBSTRATE_CACHE and SUBSTRATE_PACKAGES do,\n")
  (say 2 "       else build/ in the program's package or directory\n")
  (host-exit 64))

(define (failed! [message string])
  (say 2 "sub: ")
  (say 2 message)
  (say 2 "\n")
  (host-exit 1))

(define (absolute [p string]) -> string (normal-path (& a) (if (starts? p "/") p (joined-path cwd p))))

(define (local [text string]) -> string
  (let ([b (make-buffer)] [prefix (joined cwd "/")] [i u32 0])
    (while (< i (-> text length))
      (if (and (<= (+ i (-> prefix length)) (-> text length)) (== (slice text i (+ i (-> prefix length))) prefix))
          (+= i (-> prefix length))
          (begin
            (buffer-add-byte! (& b) (cast i32 (@ text i)))
            (+= i 1))))
    (buffer-string (& b))))

(define (joined [a string] [b string]) -> string
  (let ([out (make-buffer)])
    (buffer-add-string! (& out) a)
    (buffer-add-string! (& out) b)
    (buffer-string (& out))))

(define (stem-of [p string]) -> string (let ([b (base-of p)]) (if (ends? b ".sub") (slice b 0 (- (-> b length) 4)) b)))

(define (option [args (slice string)] [flag string]) -> string
  (for ([i u32 0]) (< (+ i 1) (-> args length)) (+= i 1) (when (== (@ args i) flag) (return (@ args (+ i 1)))))
  "")

(define (without [args (slice string)] [flag string] [valued bool]) -> (slice string)
  (let ([out (cast (ptr string) (arena-alloc (& a) (* (-> args length) (sizeof string))))] [n u32 0] [i u32 0])
    (while (< i (-> args length))
      (if (== (@ args i) flag)
          (+= i (if valued 2 1))
          (begin
            (set! (@ out n) (@ args i))
            (+= n 1)
            (+= i 1))))
    (slice out n)))

(define (flag? [args (slice string)] [flag string]) -> bool
  (for ([i u32 0]) (< i (-> args length)) (+= i 1) (when (== (@ args i) flag) (return #t)))
  #f)

(define (kind-of [path string]) -> i32
  (let ([info fs-info]) (if (< (fs-stat path (& info) 0) 0) 0 (-> info kind))))

(define (made! [path string])
  (let ([why string]) (when (< (fs-make-dir path (& why)) 0) (failed! why))))
