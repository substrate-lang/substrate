;; What sub's modules share: the directories of the repository, the toolchain and std, the current directory, an arena,
;; and small helpers.
(require-unqualified host/fs)
(require-unqualified std/package/path)
(require-unqualified std/string)

(provide root substrate-dir substrate-version std-dir cwd a say usage failed! absolute system? local stem-of
         option without flag? kind-of made!)

(define root string)
(define cwd string)
(define a arena)

(define (substrate-dir) -> string (joined-path root "substrate"))

(define (substrate-version) -> string
  (let ([text (slice u8)] [why error] [v string])
    (unless (fs-read-file (joined-path (substrate-dir) "VERSION") (& text) (& why)) (failed! (error-text (& why))))
    (set! v (cast string text))
    (while (and (> (-> v length) 0) (== (@ v (- (-> v length) 1)) #\newline)) (set! v (slice v 0 (- (-> v length) 1))))
    v))

(define (std-dir) -> string (joined-path root "std"))

(define (say [fd i32] [s string]) (host-write fd (cast (slice u8) s)))

(define (usage)
  (say 2 "usage: substrate build FILE [-o DIR] [-s] [--host web|node] | run [GRANT ...] FILE|DIR [ARG ...] | eval FILE | expand FILE\n")
  (say 2 "               | compile FILE [-o DIR] [-m MAP] [-s] | map FILE\n")
  (say 2 "               | site NAME|FILE [-o DIR] [--html FILE] [--release]\n")
  (say 2 "               | serve [-l ADDRESS] [-t CERT KEY] [-z LEVEL] [DIR]\n")
  (say 2 "               | pack -o OUT [-C DIR] PATH ... | hash [DIR] | fetch URL|FILE\n")
  (say 2 "               | doc [NAME [ITEM]] | doc -o DIR [--html] PACKAGE ... | version | upgrade\n")
  (say 2 "               | test [-v] [--ignored] [--nocapture] [--no-run] [-j N] [-t N] [--timeout D]\n")
  (say 2 "                      [--chromium FILE | --no-chromium] [--no-webgpu] [GRANT ...] [./DIR ...] [PATTERN ...]\n")
  (say 2 "       GRANT: -A, -R[=PATH,...], -W[=PATH,...], -N[=HOST[:PORT],...], -E[=NAME,...],\n")
  (say 2 "              --allow-run[=PROGRAM,...], --deny-read=PATH,..., --deny-write=PATH,...,\n")
  (say 2 "              --deny-net=HOST[:PORT],..., --deny-env=NAME,..., --deny-run=PROGRAM,...,\n")
  (say 2 "              --fake=NAME,... (clock, timer, websocket, fetch:DIR), --tls-cert=FILE --tls-key=FILE;\n")
  (say 2 "              a HOST is NAME, *.NAME, ADDRESS or ADDRESS/BITS, and \",,\" is a comma in an item\n")
  (say 2 "       -c DIR and -P DIR place the cache and the packages, else SUBSTRATE_CACHE and SUBSTRATE_PACKAGES do,\n")
  (say 2 "       else the cache is substrate/VERSION in XDG_CACHE_HOME or ~/.cache, ~/Library/Caches on macOS or LOCALAPPDATA on\n")
  (say 2 "       Windows, and the packages build/packages in the program's package or directory\n")
  (host-exit 64 ""))

(define (failed! [message string]) (host-exit 1 (string-append 0 "substrate: " message)))

(define (absolute [p string]) -> string (kept (& a) (resolved-path cwd p)))

(define system string "")

(define (system? [name string]) -> bool
  (when (== (-> system length) 0) (set! system (host-os)))
  (== system name))

(define (local [text string]) -> string (string-replace 0 text (joined-path cwd "") ""))

(define (stem-of [p string]) -> string
  (let ([b (base-of p)]) (if (string-suffix? b ".sub") (slice b 0 (- (-> b length) 4)) b)))

(define (option [args (slice string)] [flag string]) -> string
  (for ([i u32 0]) (< (+ i 1) (-> args length)) (+= i 1) (when (== (@ args i) flag) (return (@ args (+ i 1)))))
  "")

(define (without [args (slice string)] [flag string] [valued bool]) -> (slice string)
  (let ([out (new (& a) string (-> args length))] [n u32 0] [i u32 0])
    (while (< i (-> args length))
      (if (== (@ args i) flag)
          (+= i (if valued 2 1))
          (begin
            (set! (@ out n) (@ args i))
            (+= n 1)
            (+= i 1))))
    (slice out 0 n)))

(define (flag? [args (slice string)] [flag string]) -> bool
  (for ([i u32 0]) (< i (-> args length)) (+= i 1) (when (== (@ args i) flag) (return #t)))
  #f)

(define (kind-of [path string]) -> fs-kind
  (let ([info fs-info]) (fs-stat path (& info) 0) (-> info kind)))

(define (made! [path string])
  (let ([why error]) (unless (fs-make-dir path (& why)) (failed! (error-text (& why))))))
