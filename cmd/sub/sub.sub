;; substrate, the command for programs. bin/substrate runs it with every grant, with the repository's directory as its
;; first argument.
(require-unqualified compiler/macros)
(require-unqualified compiler/roots)
(require-unqualified host/fs)
(require-unqualified host/node/process)
(require-unqualified host/grants)
(require-unqualified std/package/hash)
(require-unqualified std/package/path)
(require-unqualified cmd/sub/common)
(require-unqualified cmd/sub/build)
(require-unqualified cmd/sub/fetch)
(require-unqualified cmd/sub/declared)
(require-unqualified cmd/sub/doc)
(require-unqualified cmd/sub/test)
(require-unqualified cmd/sub/upgrade)
(require-unqualified std/package/manifest)
(require-unqualified std/package/pack)
(require-unqualified std/string)

;; ---- running ----

(define then-dir string)
(define then-args (slice string))
(define then-grants grants)

(define (become!)
  (let ([why error])
    (process-exec (joined-path (substrate-dir) "host/subhost.mjs") (grants-arguments (& then-grants) then-dir then-args)
                  (& why))
    (failed! (error-text (& why)))))

;; Once the compiler has built it, runs the program in then-dir.
(define (ran [code i32]) (if (== code 0) (become!) (host-exit code "")))

(define (exited [code i32]) (host-exit code ""))

(define (no-args) -> (slice string) (slice (cast (ptr string) 0) 0))

;; run! runs a program the package declares, a file outside packages or a single-file package, or a built program.
(define (run! [args (slice string)])
  (let ([i u32 0] [why error] [p (ptr declared-program) 0])
    (while (and (< i (-> args length)) (string-prefix? (@ args i) "-")) (+= i 1))
    (when (>= i (-> args length)) (usage))
    (unless (grants-parse! (& then-grants) (slice args 0 i) (& why)) (failed! (error-text (& why))))
    (set! then-args (slice args (+ i 1) (-> args length)))
    (when (declared-name? (@ args i)) (set! p (program-called (& program-manifest) (@ args i))))
    (cond [(string-suffix? (@ args i) ".sub")
           (let ([full (absolute (@ args i))])
             (unpackaged! full "run")
             (when (and (== program-found 1) (> (-> program-manifest sites length) 0))
               (failed! (string-append 0 (@ args i) " declares a site, which runs in a browser: substrate serve "
                                       (@ args i) " serves it")))
             (cache!)
             (set! then-dir (target! full ""))
             (compile! "build" full then-dir (slice (array-of string "-t" "node")) (compiler-grants full then-dir) ran))]
          [(!= p 0)
           (set! then-dir (program-out program-dir (-> p name)))
           (build-declared! program-dir (& program-manifest) (-> p name) "" #f ran)]
          [(and (declared-name? (@ args i)) (!= (site-called (& program-manifest) (@ args i)) 0))
           (failed! (string-append 0 (@ args i) " is a site, which runs in a browser: substrate serve " (@ args i)
                                   " serves it"))]
          [else
           (set! then-dir (@ args i))
           (become!)])))

;; unpackaged! refuses a file inside a package's directory, naming what the package declares for it.
(define (unpackaged! [full string] [command string])
  (when (== program-found 2)
    (let* ([name (declared-file (& program-manifest) program-dir full)]
           [site (!= (site-called (& program-manifest) name) 0)]
           [how (cond [(== command "build") "build "] [site "serve "] [else "run "])]
           [does (cond [(== command "build") " builds it"] [site " serves it"] [else " runs it"])])
      (failed! (if (> (-> name length) 0)
                   (string-append 0 (local full) " is " name " in the package " program-package ": substrate " how name
                                  does)
                   (string-append 0 (local full) " is in the package " program-package
                                  ", so it needs to be declared in the package's package.sub"))))))

;; ---- serving ----

(define serve-args (slice string))
(define serve-at u32 0)
(define serve-address string)
(define serve-dir string)
(define own-site manifest)
(define own-sites (array declared-site 1))

;; served-at gives the place in args of what to serve, after the flags, and puts the address that -l gives in address.
(define (served-at [args (slice string)] [address (ptr string)]) -> u32
  (let ([k u32 0] [n (-> args length)])
    (while (< k n)
      (let ([x (@ args k)])
        (cond [(== x "-l") (+= k 1) (when (< k n) (set! (@ address) (@ args k)))]
              [(== x "-t") (+= k 2)]
              [(== x "-z") (+= k 1)]
              [else (break)]))
      (+= k 1))
    (if (> k n) n k)))

;; serve! serves a site the package declares or a file, each built first, or a directory as it is.
(define (serve! [args (slice string)])
  (set! serve-args args)
  (set! serve-address "127.0.0.1")
  (set! serve-at (served-at args (& serve-address)))
  (when (== (-> serve-address length) 0) (usage))
  (let ([given (if (< serve-at (-> args length)) (@ args serve-at) "")])
    (cond [(string-suffix? given ".sub") (file-served! (absolute given))]
          [(and (declared-name? given) (!= (site-called (& program-manifest) given) 0))
           (set! serve-dir (site-out program-dir given))
           (build-declared! program-dir (& program-manifest) given "" #f site-served)]
          [(and (declared-name? given) (!= (program-called (& program-manifest) given) 0))
           (failed! (string-append 0 given " is a program, which runs in Node: substrate run " given " runs it"))]
          [else (served! (if (== (-> given length) 0) "." given))])))

;; A file is served as the site it declares for itself, or else as a site of its own, built into build/sites beside it.
(define (file-served! [full string])
  (unpackaged! full "serve")
  (let* ([dir (parent-of full)] [name (if (== program-found 1) (declared-file (& program-manifest) dir full) "")])
    (if (and (> (-> name length) 0) (!= (site-called (& program-manifest) name) 0))
        (begin
          (set! serve-dir (site-out dir name))
          (build-declared! dir (& program-manifest) name "" #f site-served))
        (let ([stem (stem-of full)])
          (set! (@ own-sites 0)
                (declared-site #:name stem #:program (base-of full) #:html "" #:files (slice (cast (ptr site-files) 0) 0)
                               #:url-base "" #:mounts (slice (cast (ptr declared-mount) 0) 0) #:line 0 #:column 0))
          (set! (-> own-site name) stem)
          (set! (-> own-site sites) (slice own-sites))
          (set! serve-dir (site-out dir stem))
          (build-declared! dir (& own-site) stem "" #f site-served)))))

(define (site-served [code i32]) (if (== code 0) (served! serve-dir) (host-exit code "")))

;; served! runs sub serve (cmd/serve.sub) on dir, with the flags and the port that serve was given.
(define (served! [dir string])
  (let* ([args serve-args] [n (-> args length)] [given (new (& a) string (+ n 1))] [m u32 0])
    (for ([i u32 0]) (< i serve-at) (+= i 1)
      (set! (@ given m) (@ args i))
      (+= m 1))
    (set! (@ given m) dir)
    (+= m 1)
    (for ([i u32 (+ serve-at 1)]) (< i n) (+= i 1)
      (set! (@ given m) (@ args i))
      (+= m 1))
    (grants-allow! (& then-grants) grant-read dir)
    (grants-allow! (& then-grants) grant-net (unbracketed serve-address))
    (let ([t (option args "-t")] [key-at u32 0])
      (when (> (-> t length) 0)
        (for ([i u32 0]) (< i n) (+= i 1) (when (== (@ args i) "-t") (set! key-at (+ i 2))))
        (when (>= key-at n) (usage))
        (grants-tls! (& then-grants) t (@ args key-at))))
    (cache!)
    (let* ([full (joined-path root "cmd/serve.sub")] [out (target! full (joined-path root "build/serve"))])
      (set! then-dir out)
      (set! then-args (slice given 0 m))
      (compile! "build" full out (slice (array-of string "-t" "node")) (compiler-grants full out) ran))))

(define (unbracketed [s string]) -> string
  (let ([from (if (string-prefix? s "[") 1 0)] [to (if (string-suffix? s "]") (- (-> s length) 1) (-> s length))])
    (slice s from to)))

;; ---- packages ----

(define (pack! [args (slice string)])
  (let ([to (option args "-o")] [from (option args "-C")] [paths (without (without args "-o" #t) "-C" #t)]
        [err (make-buffer)])
    (when (or (== (-> to length) 0) (== (-> paths length) 0)) (usage))
    (unless (pack-files (if (== (-> from length) 0) "." from) paths to (& err)) (failed! (buffer-string (& err))))))

(define (print-hash! [args (slice string)])
  (let* ([given (if (== (-> args length) 1) (@ args 0) ".")] [dir (absolute given)] [h (make-buffer)] [err (make-buffer)])
    (when (> (-> args length) 1) (usage))
    (unless (== (kind-of (joined-path dir "package.sub")) fs-file)
      (failed! (string-append 0 given " has no package.sub")))
    (unless (package-hash dir (& h) (& err)) (failed! (local (buffer-string (& err)))))
    (buffer-add-byte! (& h) #\newline)
    (host-write 1 (buffer-bytes (& h)))))

(define (print-version! [args (slice string)])
  (let ([h (make-buffer)] [err (make-buffer)])
    (unless (== (-> args length) 0) (usage))
    (unless (directory-hash (substrate-dir) "VERSION" (& h) (& err)) (failed! (local (buffer-string (& err)))))
    (say 1 (string-append 0 "substrate " (substrate-version) " " (buffer-string (& h)) "\n"))))

(define (print-map! [args (slice string)])
  (let ([text (make-buffer)])
    (unless (== (-> args length) 1) (usage))
    (find-package! (absolute (@ args 0)))
    (module-map! (& text) #f)
    (host-write 1 (buffer-bytes (& text)))))

(define (compile-command! [args (slice string)])
  (let* ([valued (without (without args "-o" #t) "-m" #t)] [plain (without valued "-s" #f)])
    (unless (== (-> plain length) 1) (usage))
    (bare-compile! (absolute (@ plain 0)) (option args "-o") (option args "-m") (location given-cache "SUBSTRATE_CACHE" (user-cache ""))
                   (flag? valued "-s") exited)))

(define (build-plain [args (slice string)]) -> (slice string) (without (without args "-o" #t) "-s" #f))

;; build-command! builds what the package declares, or one of its programs or sites, or else a file outside packages or
;; a single-file package.
(define (build-command! [args (slice string)])
  (let* ([plain (build-plain args)] [given (option args "-o")] [out (if (> (-> given length) 0) (absolute given) "")]
         [strip (flag? (without args "-o" #t) "-s")])
    (cond [(or (== (-> plain length) 0) (and (== (-> plain length) 1) (declared-name? (@ plain 0))))
           (build-declared! program-dir (& program-manifest) (if (== (-> plain length) 0) "" (@ plain 0)) out strip
                            exited)]
          [(== (-> plain length) 1)
           (unpackaged! (absolute (@ plain 0)) "build")
           (cache!)
           (if (and (== program-found 1) (> (-> program-manifest sites length) 0))
               (build-declared! program-dir (& program-manifest) "" out strip exited)
               (build! (@ plain 0) given strip exited))]
          [else (usage)])))

;; ---- the commands ----

(define next-command string)
(define next-args (slice string))

(define (carry-on!)
  (try (dispatch! next-command next-args)
       [catch compile-error (message blamed loc) (compile-failed! message blamed loc)]))

(define (program-of [command string] [rest (slice string)]) -> string
  (let ([given (target-given command rest)])
    (cond [(== command "build") (if (and (> (-> given length) 0) (not (declared-name? given))) (absolute given) "")]
          [(or (== command "eval") (== command "expand") (== command "map"))
           (let ([plain (without (without rest "-o" #t) "-s" #f)])
             (if (== (-> plain length) 1) (absolute (@ plain 0)) ""))]
          [(== command "run") (if (string-suffix? given ".sub") (absolute given) "")]
          [(== command "serve") (if (string-suffix? given ".sub") (absolute given) (joined-path root "cmd/serve.sub"))]
          [else ""])))

;; named-package gives the directory of the package that a command works in by name: build without a file, or run or
;; serve with a name. It is "" for any other command.
(define (named-package [command string] [rest (slice string)]) -> string
  (let ([dir ""])
    (cond [(== command "build")
           (let ([plain (build-plain rest)])
             (when (or (== (-> plain length) 0) (and (== (-> plain length) 1) (declared-name? (@ plain 0))))
               (set! dir (package-holding (& a) cwd))
               (when (== (-> dir length) 0)
                 (failed! "the current directory is in no package, so nothing is declared to build"))))]
          [(or (== command "run") (== command "serve"))
           (when (declared-name? (target-given command rest)) (set! dir (package-holding (& a) cwd)))])
    dir))

;; target-given gives the name, file or directory that build, run or serve is given, or "".
(define (target-given [command string] [rest (slice string)]) -> string
  (let* ([address "127.0.0.1"] [plain (build-plain rest)]
         [i (if (== command "serve") (served-at rest (& address)) (first-plain rest))])
    (cond [(== command "build") (if (== (-> plain length) 1) (@ plain 0) "")]
          [(< i (-> rest length)) (@ rest i)]
          [else ""])))

(define (first-plain [rest (slice string)]) -> u32
  (let ([i u32 0])
    (while (and (< i (-> rest length)) (string-prefix? (@ rest i) "-")) (+= i 1))
    i))

(define (run [args (slice string)])
  (when (< (-> args length) 2) (usage))
  (set! a (make-arena))
  (fs-cwd (& cwd) 0)
  (set! cwd (normal-path (& a) cwd))
  (set! root (absolute (@ args 0)))
  (set-toolchain-directory! (string->datum (substrate-dir)))
  (set-display-directory! (string->datum cwd))
  (set! next-command (@ args 1))
  (set! next-args (located (slice args 2 (-> args length)) (== next-command "run")))
  (let ([file (program-of next-command next-args)] [dir (named-package next-command next-args)])
    (cond [(== next-command "fetch") (fetch-command! next-args)]
          [(== next-command "doc") (doc-fetch-then! next-args carry-on!)]
          [(== next-command "test")
           (let ([dir (test-directory next-args)])
             (if (== (-> dir length) 0)
                 (carry-on!)
                 (begin
                   (locations! (package-in! dir))
                   (fetch-package-then! dir (& program-manifest) carry-on!))))]
          [(> (-> dir length) 0)
           (locations! (package-in! dir))
           (let ([name (target-given next-command next-args)])
             (if (or (== next-command "build")
                     (and (== next-command "run") (!= (program-called (& program-manifest) name) 0))
                     (and (== next-command "serve") (!= (site-called (& program-manifest) name) 0)))
                 (fetch-package-then! dir (& program-manifest) carry-on!)
                 (carry-on!)))]
          [(== (-> file length) 0) (carry-on!)]
          [else
           (locations! (find-package! file))
           (fetch-then! carry-on!)])))

(define (dispatch! [command string] [rest (slice string)])
  (cond [(== command "build") (build-command! rest)]
        [(== command "run") (run! rest)]
        [(and (or (== command "eval") (== command "expand")) (== (-> rest length) 1))
         (let ([file (absolute (@ rest 0))])
           (prepare! file)
           (cache!)
           (compile! command file "" (no-args) (if (== command "eval") (every-grant) (compiler-grants file ""))
                     exited))]
        [(== command "serve") (serve! rest)]
        [(== command "test") (test-command! rest)]
        [(== command "pack") (pack! rest)]
        [(== command "hash") (print-hash! rest)]
        [(== command "map") (print-map! rest)]
        [(== command "compile") (compile-command! rest)]
        [(== command "upgrade") (upgrade-command! rest)]
        [(== command "version") (print-version! rest)]
        [(== command "doc") (doc-command! rest)]
        [else (usage)]))

(define (compile-failed! [message datum] [blamed datum] [loc (ptr srcloc)])
  (let ([b (make-buffer)])
    (write-error (& b) message blamed loc)
    (host-exit 1 (buffer-string (& b)))))

(define (main)
  (try (run (host-args))
       [catch compile-error (message blamed loc) (compile-failed! message blamed loc)]))

;; The host calls on-trap with a trap's message.
(define (on-trap [why (ptr u8)] [n u32]) -> bool
  (failed! (cast string (slice why n)))
  #t)
