;; sub doc: the documentation of packages and roots of the toolchain (compiler, host), written as text or HTML
;; (std/doc), or one module, directory or item of one, printed by the name the compiler finds it by. A package's modules
;; are its files, the modules it exports public and the rest private; every module of a root of the toolchain is public.
;; Like build, it first fetches what the packages it reads depend on.
(require-unqualified macros compiler/macros)
(require-unqualified ex compiler/expander)
(require-unqualified rd compiler/reader)
(require-unqualified fs host/fs)
(require-unqualified manifest std/package/manifest)
(require-unqualified map std/package/map)
(require-unqualified paths std/package/path)
(require-unqualified doc std/doc)
(require-unqualified root std/doc/root)
(require-unqualified text std/doc/text)
(require-unqualified html std/doc/html)
(require-unqualified common cmd/sub/common)
(require-unqualified build cmd/sub/build)
(require-unqualified fetching cmd/sub/fetch)

(provide doc-command! doc-fetch-then!)

(struct target [label string] [dir string] [modules datum] [public datum])

(define (doc-command! [args (slice string)])
  (let ([out (option args "-o")] [rest (without (without args "-o" #t) "--html" #f)] [roots nil] [files datum 0])
    (cond [(> (-> out length) 0)
           (when (== (-> rest length) 0) (usage))
           (for ([i u32 0]) (< i (-> rest length)) (+= i 1)
             (let ([t (target-of (@ rest i))])
               (set! roots (cons (root-doc (string->datum (-> t label)) (-> t modules) (-> t public)) roots))))
           (set! files (if (flag? args "--html") (html-files (reverse roots)) (text-files (reverse roots))))
           (while (pair? files)
             (file! (absolute out) (datum->string (car (car files))) (cdr (car files)))
             (set! files (cdr files)))]
          [(== (-> rest length) 1) (printed! (@ rest 0) "")]
          [(== (-> rest length) 2) (printed! (@ rest 0) (@ rest 1))]
          [else (usage)])))

(define (target-of [given string]) -> target
  (if (toolchain-root? (string->datum given))
      (toolchain-target given)
      (let ([roots (mapped! (absolute given))]) (package-target (& (@ roots 0))))))

;; ---- targets ----

(define (toolchain-target [label string]) -> target
  (let ([t target])
    (set! (-> t label) label)
    (set! (-> t dir) (joined-path root label))
    (set! (-> t modules) (modules-under (-> t dir) ""))
    (set! (-> t public) (-> t modules))
    t))

;; modules-under gives every module of a root of the toolchain: each .sub file under its directory.
(define (modules-under [dir string] [rel string]) -> datum
  (let ([here (if (== (-> rel length) 0) dir (joined-path dir rel))] [names (slice string)] [why string] [out nil])
    (when (< (fs-list here (& names) (& why)) 0) (failed! why))
    (for ([i u32 0]) (< i (-> names length)) (+= i 1)
      (let* ([n (@ names i)] [r (if (== (-> rel length) 0) n (joined-path rel n))] [kind (kind-of (joined-path here n))])
        (cond [(and (== kind fs-file) (ends? n ".sub")) (set! out (cons (string->datum r) out))]
              [(== kind fs-directory) (set! out (append (modules-under dir r) out))])))
    (sorted out)))

;; mapped! gives the roots of the module map of the package at dir, the package first, and gives the compiler the map.
(define (mapped! [dir string]) -> (slice package-root)
  (let ([m manifest] [err (make-buffer)] [text (make-buffer)] [roots (make-buffer)])
    (unless (manifest-read (& a) (joined-path dir "package.sub") (& m) (& err)) (failed! (local (buffer-string (& err)))))
    (locations! dir)
    (unless (package-map (& a) dir "" (& m) (joined-path root "std") store-dir (& text) (& roots) (& err))
      (failed! (local (buffer-string (& err)))))
    (set-module-map-text! (string->datum (buffer-string (& text))) '"the module map")
    (slice (cast (ptr package-root) (-> roots bytes)) (/ (-> roots length) (sizeof package-root)))))

(define (package-target [r (ptr package-root)]) -> target
  (let ([t target])
    (set! (-> t label) (-> r name))
    (set! (-> t dir) (-> r dir))
    (set! (-> t modules) (sorted (modules-in (-> r dir) (-> r files))))
    (set! (-> t public) (modules-in (-> r dir) (-> r exports)))
    t))

(define (modules-in [dir string] [files (slice string)]) -> datum
  (let ([out nil])
    (for ([i u32 0]) (< i (-> files length)) (+= i 1)
      (let ([f (@ files i)])
        (when (and (ends? f ".sub") (within? f dir) (== (kind-of f) fs-file))
          (set! out (cons (string->datum (slice f (+ (-> dir length) 1))) out)))))
    out))

(define (sorted [l datum]) -> datum (sort l (lambda ([x datum] [y datum]) -> bool (< (datum->string x) (datum->string y)))))

(define (file! [out string] [path string] [content datum])
  (let ([full (joined-path out path)] [why string])
    (made! (parent-of full))
    (when (< (fs-write-file full (cast (slice u8) (datum->string content)) (& why)) 0) (failed! why))))

;; ---- fetching ----

(define unfetched datum nil)
(define after (fn ()))

(define (doc-fetch-then! [args (slice string)] [next (fn ())])
  (let ([rest (without (without args "-o" #t) "--html" #f)] [project (package-holding (& a) cwd)])
    (set! after next)
    (set! unfetched nil)
    (if (> (-> (option args "-o") length) 0)
        (for ([i u32 0]) (< i (-> rest length)) (+= i 1)
          (unless (toolchain-root? (string->datum (@ rest i))) (set! unfetched (cons (string->datum (absolute (@ rest i))) unfetched))))
        (when (> (-> project length) 0) (set! unfetched (cons (string->datum project) nil))))
    (fetched!)))

(define (fetched!)
  (if (null? unfetched)
      (after)
      (let ([dir (datum->string (car unfetched))] [m manifest] [err (make-buffer)])
        (set! unfetched (cdr unfetched))
        (unless (manifest-read (& a) (joined-path dir "package.sub") (& m) (& err)) (failed! (local (buffer-string (& err)))))
        (locations! dir)
        (fetch-package-then! dir (& m) fetched!))))

;; ---- printing ----

;; printed! prints the module or directory a name means as the compiler finds it, in the package holding the current
;; directory, with its module map, or outside packages; or one item of the module.
(define (printed! [name string] [item string])
  (let* ([project (package-holding (& a) cwd)] [held (> (-> project length) 0)]
         [roots (mapped! (if held project (joined-path root "std")))]
         [id (identity-named name (if held (string->datum (joined (-> (@ roots 0) name) "/package.sub")) 0))]
         [label string] [rest string] [path string] [t target])
    (when (== id 0) (failed! (joined name " is not a module or a directory")))
    (set! label (head-of (datum->string id)))
    (set! path (slice (datum->string id) (+ (-> label length) 1)))
    (set! rest (if (== (head-of name) name) "" (slice name (+ (-> (head-of name) length) 1))))
    (set! t (if (toolchain-root? (string->datum label)) (toolchain-target label) (package-target (package-in roots label))))
    (cond [(and (> (-> rest length) 0) (== path (joined rest ".sub")) (== (kind-of (joined-path (-> t dir) path)) fs-file))
           (unless (!= (member (string->datum path) (-> t modules)) 0)
             (failed! (joined (joined (joined name " is not one of the files of ") label) ", its exports and what their source requires")))
           (let ([d (module-doc id)])
             (if (== (-> item length) 0)
                 (say 1 (datum->string (module-text d (owner-of (string->datum label) (-> t public) (string->datum path)))))
                 (let ([i (filter (lambda ([x datum]) -> bool (equal? (item-name x) (string->datum item))) (doc-items d))])
                   (when (null? i) (failed! (joined (joined name " has no ") item)))
                   (say 1 (datum->string (item-text (car i)))))))]
          [(or (== (-> rest length) 0) (== (kind-of (joined-path (-> t dir) rest)) fs-directory))
           (let ([i (directory-index (string->datum label) rest (-> t modules) (-> t public))])
             (say 1 (datum->string (index-text (car i) (cadr i) (caddr i) (cadddr i)))))]
          [else (failed! (joined name " is not a module or a directory"))])))

(define (identity-named [name string] [from datum]) -> datum
  (let ([id datum 0])
    (try (let ([forms (read-all name (string->symbol "the command line"))])
           (when (and (pair? forms) (null? (cdr forms)) (identifier? (car forms))) (set! id (module-identity (car forms) from))))
         [catch compile-error (message blamed loc) (set! id 0)])
    id))

(define (head-of [s string]) -> string
  (let ([i u32 0])
    (while (and (< i (-> s length)) (!= (@ s i) #\/)) (+= i 1))
    (slice s 0 i)))

(define (package-in [roots (slice package-root)] [label string]) -> (ptr package-root)
  (for ([i u32 0]) (< i (-> roots length)) (+= i 1) (when (== (-> (@ roots i) name) label) (return (& (@ roots i)))))
  (failed! (joined "internal: there is no package " label))
  0)
