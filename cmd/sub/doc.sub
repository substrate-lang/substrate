;; sub doc: the documentation of a package, or of a package of the toolchain (std, compiler, host, cmd), from its
;; modules' source: as text, each module as a header file would read and each directory as a list of its modules, or
;; as HTML. A module's language describes its forms (std/doc/doc.sub).
(require-unqualified macros compiler/macros)
(require-unqualified ex compiler/expander)
(require-unqualified rd compiler/reader)
(require-unqualified fs host/fs)
(require-unqualified manifest std/package/manifest)
(require-unqualified paths std/package/path)
(require-unqualified doc std/doc)
(require-unqualified text std/doc/text)
(require-unqualified html std/doc/html)
(require-unqualified common cmd/sub/common)

(provide doc-command!)

(struct target [label string] [dir string])

(define (doc-command! [args (slice string)])
  (let ([out (option args "-o")] [rest (without (without args "-o" #t) "--html" #f)])
    (cond [(> (-> out length) 0)
           (when (== (-> rest length) 0) (usage))
           (let ([sets nil])
             (for ([i u32 0]) (< i (-> rest length)) (+= i 1)
               (let ([t (target-of (@ rest i))]) (set! sets (cons (gathered (& t)) sets))))
             (if (flag? args "--html") (site! (absolute out) (reverse sets)) (texts! (absolute out) (reverse sets))))]
          [(== (-> rest length) 1) (printed! (@ rest 0) "")]
          [(== (-> rest length) 2) (printed! (@ rest 0) (@ rest 1))]
          [else (usage)])))

(define (target-of [given string]) -> target
  (let ([t target] [m manifest] [err (make-buffer)])
    (if (toolchain? given)
        (begin
          (set! (-> t label) given)
          (set! (-> t dir) (joined-path root given)))
        (let ([dir (absolute given)])
          (unless (manifest-read (& a) (joined-path dir "package.sub") (& m) (& err)) (failed! (local (buffer-string (& err)))))
          (set! (-> t label) (-> m name))
          (set! (-> t dir) dir)))
    t))

(define (toolchain? [s string]) -> bool (or (== s "std") (== s "compiler") (== s "host") (== s "cmd")))

;; ---- modules ----

(define (modules-of [t (ptr target)] [rel string]) -> datum
  (let ([here (if (== (-> rel length) 0) (-> t dir) (joined-path (-> t dir) rel))] [names (slice string)] [why string]
        [out nil])
    (when (< (fs-list here (& names) (& why)) 0) (failed! why))
    (for ([i u32 0]) (< i (-> names length)) (+= i 1)
      (let* ([n (@ names i)] [r (if (== (-> rel length) 0) n (joined-path rel n))] [full (joined-path here n)]
             [kind (kind-of full)])
        (cond [(starts? n ".") (begin)]
              [(and (== kind fs-file) (ends? n ".sub") (!= n "package.sub")) (set! out (cons (string->datum r) out))]
              [(and (== kind fs-directory) (!= n "build") (!= (kind-of (joined-path full "package.sub")) fs-file))
               (set! out (append (modules-of t r) out))])))
    (sort out (lambda ([x datum] [y datum]) -> bool (< (datum->string x) (datum->string y))))))

(define (module-name [t (ptr target)] [rel string]) -> datum
  (string->datum (joined (joined (-> t label) "/") (if (ends? rel ".sub") (slice rel 0 (- (-> rel length) 4)) rel))))

(define (source-text [file string]) -> string
  (let ([b (slice u8)] [why string])
    (when (< (fs-read-file file (& b) (& why)) 0) (failed! why))
    (cast string b)))

(define (forms-of [file string] [text string]) -> datum (read-all text (string->symbol (local file))))

(define (documented [t (ptr target)] [rel string] [full bool]) -> datum
  (let* ([file (joined-path (-> t dir) rel)] [text (source-text file)] [forms (if full (forms-of file text) nil)]
         [d (module-doc (module-name t rel) text forms (if full (description file forms t) 0))])
    `(,(doc-name d) ,(doc-header d) ,(named t file (doc-language d))
      ,(map (lambda ([r datum]) -> datum (named t file r)) (doc-requires d)) ,(doc-reexports d) ,(doc-items d))))

;; named gives a module written by path, as a require or a language form writes it, by its name.
(define (named [t (ptr target)] [file string] [written datum]) -> datum
  (let ([w (datum->string written)] [full string])
    (unless (and (> (-> w length) 2) (starts? w "\"") (ends? w "\"")) (return written))
    (set! full (normal-path (& a) (joined-path (parent-of file) (slice w 1 (- (-> w length) 1)))))
    (unless (within? full (-> t dir)) (return written))
    (module-name t (slice full (+ (-> t dir length) 1)))))

;; ---- languages ----

(define descriptions datum nil)

(define (description [file string] [forms datum] [t (ptr target)]) -> datum
  (let ([source (language-of forms)])
    (if (== source 0)
        (described (joined-path root "compiler/substrate.sub") t)
        (let ([l (language-file file source t)]) (if (== (-> l length) 0) 0 (described l t))))))

(define (described [file string] [t (ptr target)]) -> datum
  (let ([known (assoc (string->datum file) descriptions)] [forms datum 0] [d datum 0] [source datum 0])
    (unless (== known 0) (return (cdr known)))
    (unless (== (kind-of file) fs-file) (return 0))
    (set! forms (forms-of file (source-text file)))
    (set! d (doc-forms-of forms))
    (set! source (language-of forms))
    (when (and (== d 0) (!= source 0))
      (let ([l (language-file file source t)]) (unless (== (-> l length) 0) (set! d (described l t)))))
    (set! descriptions (cons (cons (string->datum file) d) descriptions))
    d))

(define (language-file [file string] [source datum] [t (ptr target)]) -> string
  (cond [(string? source) (normal-path (& a) (joined-path (parent-of file) (datum->string source)))]
        [(symbol? source)
         (let* ([n (symbol->string source)] [slash u32 0] [base string])
           (while (and (< slash (-> n length)) (!= (@ n slash) #\/)) (+= slash 1))
           (set! base (cond [(toolchain? (slice n 0 slash)) (joined-path root (slice n 0 slash))]
                            [(== (slice n 0 slash) (-> t label)) (-> t dir)]
                            [else ""]))
           (cond [(== (-> base length) 0) ""]
                 [(== slash (-> n length)) (joined-path base (joined n ".sub"))]
                 [else (joined-path base (datum->string (named-file (string->datum base)
                                                                   (string->datum (slice n (+ slash 1))))))]))]
        [else ""]))

;; ---- writing ----

;; gathered gives a package's label, its modules' documentation, and its directories' indexes.
(define (gathered [t (ptr target)]) -> datum
  (let* ([rels (modules-of t "")] [docs (map (lambda ([r datum]) -> datum (cons r (documented t (datum->string r) #t))) rels)])
    `(,(string->datum (-> t label)) ,docs ,(map (lambda ([dir datum]) -> datum (index-of t (datum->string dir) docs))
                                                (directories rels)))))

(define (texts! [out string] [sets datum])
  (file! out "index.txt"
         (index-text '"documentation" '""
                     (map (lambda ([set datum]) -> datum (cons (string->datum (joined (datum->string (car set)) "/")) '"")) sets)))
  (while (pair? sets)
    (let ([es (cadr (car sets))] [is (caddr (car sets))])
      (while (pair? es)
        (file! out (joined (datum->string (doc-name (cdr (car es)))) ".txt") (module-text (cdr (car es))))
        (set! es (cdr es)))
      (while (pair? is)
        (let ([i (car is)]) (file! out (joined-path (datum->string (car i)) "index.txt") (index-text (car i) (cadr i) (caddr i))))
        (set! is (cdr is))))
    (set! sets (cdr sets))))

(define (site! [out string] [sets datum])
  (let ([docs nil] [names nil] [labels nil] [ss sets] [ds datum 0])
    (while (pair? ss)
      (set! labels (cons (car (car ss)) labels))
      (set! docs (append docs (map (lambda ([e datum]) -> datum (cdr e)) (cadr (car ss)))))
      (set! ss (cdr ss)))
    (set! names (map (lambda ([d datum]) -> datum (doc-name d)) docs))
    (set! ds docs)
    (while (pair? ds)
      (file! out (joined (datum->string (doc-name (car ds))) ".html") (module-page (car ds) names (types-for (car ds) docs names)))
      (set! ds (cdr ds)))
    (set! ss sets)
    (while (pair? ss)
      (let ([is (caddr (car ss))])
        (while (pair? is)
          (file! out (joined-path (datum->string (car (car is))) "index.html") (index-page (car is)))
          (set! is (cdr is))))
      (set! ss (cdr ss)))
    (file! out "index.html" (top-page (reverse labels)))
    (file! out "style.css" (string->datum page-style))))

;; types-for gives each type a signature in a module may name, its own and those of the modules it requires, with the
;; module that defines it.
(define (types-for [d datum] [docs datum] [names datum]) -> datum
  (let ([out nil] [ms (cons (doc-name d) (map (lambda ([r datum]) -> datum (main-name r names)) (doc-requires d)))])
    (while (pair? ms)
      (let ([ds docs])
        (while (pair? ds)
          (when (equal? (doc-name (car ds)) (car ms))
            (let ([is (doc-items (car ds))])
              (while (pair? is)
                (when (equal? (item-kind (car is)) '"type") (set! out (cons (cons (item-name (car is)) (car ms)) out)))
                (set! is (cdr is)))))
          (set! ds (cdr ds))))
      (set! ms (cdr ms)))
    (reverse out)))

(define (main-name [name datum] [names datum]) -> datum
  (let ([alias (string->datum (joined-path (datum->string name) (base-of (datum->string name))))])
    (if (and (== (member name names) 0) (!= (member alias names) 0)) alias name)))

(define (directories [rels datum]) -> datum
  (let ([out (cons '"" nil)])
    (for-each (lambda ([r datum])
                (let ([d (datum->string r)] [i u32 0])
                  (while (< i (-> d length))
                    (when (== (@ d i) #\/)
                      (let ([dir (string->datum (slice d 0 i))]) (when (== (member dir out) 0) (set! out (cons dir out)))))
                    (+= i 1))))
              rels)
    (sort out (lambda ([x datum] [y datum]) -> bool (< (datum->string x) (datum->string y))))))

;; index-of gives a directory's name, the header of its main module, and its entries: each module in it, then each
;; directory in it, with the first sentence of a header (a directory's from its main module).
(define (index-of [t (ptr target)] [dir string] [docs datum]) -> datum
  (let ([name (if (== (-> dir length) 0) (string->datum (-> t label)) (string->datum (joined-path (-> t label) dir)))]
        [modules nil] [subdirs nil])
    (for-each (lambda ([e datum])
                (let* ([r (datum->string (car e))] [sub (child-of dir r)])
                  (when (== (parent-in r) dir)
                    (set! modules (cons (cons (doc-name (cdr e)) (first-sentence (doc-header (cdr e)))) modules)))
                  (when (and (> (-> sub length) 0) (== (member (string->datum sub) subdirs) 0))
                    (set! subdirs (cons (string->datum sub) subdirs)))))
              docs)
    `(,name ,(header-in (main-of dir) docs)
      ,(append (reverse modules)
               (map (lambda ([s datum]) -> datum
                      (cons (string->datum (joined (joined-path (-> t label) (datum->string s)) "/"))
                            (first-sentence (header-in (main-of (datum->string s)) docs))))
                    (reverse subdirs))))))

(define (main-of [dir string]) -> string (if (== (-> dir length) 0) "" (joined-path dir (joined (base-of dir) ".sub"))))

(define (header-in [rel string] [docs datum]) -> datum
  (let ([e (assoc (string->datum rel) docs)]) (if (== e 0) '"" (doc-header (cdr e)))))

(define (child-of [dir string] [rel string]) -> string
  (let* ([prefix (if (== (-> dir length) 0) "" (joined dir "/"))] [i (-> prefix length)])
    (unless (and (> (-> rel length) i) (== (slice rel 0 i) prefix)) (return ""))
    (while (and (< i (-> rel length)) (!= (@ rel i) #\/)) (+= i 1))
    (if (== i (-> rel length)) "" (slice rel 0 i))))

(define (parent-in [rel string]) -> string
  (let ([i (-> rel length)])
    (while (and (> i 0) (!= (@ rel (- i 1)) #\/)) (-= i 1))
    (if (== i 0) "" (slice rel 0 (- i 1)))))

(define (file! [out string] [path string] [content datum])
  (let ([full (joined-path out path)] [why string])
    (made! (parent-of full))
    (when (< (fs-write-file full (cast (slice u8) (datum->string content)) (& why)) 0) (failed! why))))

;; ---- printing ----

(define (printed! [name string] [item string])
  (let* ([slash u32 0] [t target] [rel string] [file string])
    (while (and (< slash (-> name length)) (!= (@ name slash) #\/)) (+= slash 1))
    (unless (toolchain? (slice name 0 slash)) (failed! (joined name " is not in host, compiler, std or cmd")))
    (set! t (target-of (slice name 0 slash)))
    (set! rel (if (== slash (-> name length)) "" (slice name (+ slash 1))))
    (set! file (joined-path (-> t dir) (joined rel ".sub")))
    (cond [(and (> (-> rel length) 0) (== (kind-of file) fs-file))
           (let ([d (documented (& t) (joined rel ".sub") #t)])
             (if (== (-> item length) 0)
                 (say 1 (datum->string (module-text d)))
                 (let ([i (filter (lambda ([x datum]) -> bool (equal? (item-name x) (string->datum item))) (doc-items d))])
                   (when (null? i) (failed! (joined (joined name " has no ") item)))
                   (say 1 (datum->string (item-text (car i)))))))]
          [(or (== (-> rel length) 0) (== (kind-of (joined-path (-> t dir) rel)) fs-directory))
           (let* ([rels (filter (lambda ([r datum]) -> bool (or (== (-> rel length) 0) (starts? (datum->string r) (joined rel "/"))))
                                (modules-of (& t) ""))]
                  [docs (map (lambda ([r datum]) -> datum (cons r (documented (& t) (datum->string r) #f))) rels)]
                  [i (index-of (& t) rel docs)])
             (say 1 (datum->string (index-text (car i) (cadr i) (caddr i)))))]
          [else (failed! (joined name " is not a module or a directory"))])))
