;; Building what a package declares: each program into build/programs/NAME and each site into build/sites/NAME, with
;; the sites it mounts inside it. Sites build for the browser and programs for Node. With --release, each site is made a
;; release (std/package/site.sub). A single-file package declares its sites in its first form.
(require-unqualified compiler/macros)
(require-unqualified host/fs)
(require-unqualified std/package/manifest)
(require-unqualified std/package/site)
(require-unqualified std/package/path)
(require-unqualified cmd/sub/common)
(require-unqualified cmd/sub/build)
(require-unqualified std/string)

(provide named? program-called site-called declared-file program-out build-declared! build-program!)

;; Whether s names something a package declares, rather than a file or a directory.
(define (named? [s string]) -> bool
  (for ([i u32 0]) (< i (-> s length)) (+= i 1) (when (or (== (@ s i) #\/) (== (@ s i) #\\)) (return #f)))
  (and (> (-> s length) 0) (not (string-suffix? s ".sub"))))

(define (program-called [m (ptr manifest)] [name string]) -> (ptr declared-program)
  (for ([i u32 0]) (< i (-> m programs length)) (+= i 1)
    (when (== (-> (@ (-> m programs) i) name) name) (return (& (@ (-> m programs) i)))))
  0)

(define (site-called [m (ptr manifest)] [name string]) -> (ptr declared-site)
  (for ([i u32 0]) (< i (-> m sites length)) (+= i 1)
    (when (== (-> (@ (-> m sites) i) name) name) (return (& (@ (-> m sites) i)))))
  0)

;; declared-file gives the name of the program or site in dir's manifest m whose program is file, or "".
(define (declared-file [m (ptr manifest)] [dir string] [file string]) -> string
  (for ([i u32 0]) (< i (-> m programs length)) (+= i 1)
    (let ([p (& (@ (-> m programs) i))]) (when (== (resolved-path dir (-> p program)) file) (return (-> p name)))))
  (for ([i u32 0]) (< i (-> m sites length)) (+= i 1)
    (let ([s (& (@ (-> m sites) i))]) (when (== (resolved-path dir (-> s program)) file) (return (-> s name)))))
  "")

(define (program-out [dir string] [name string]) -> string
  (joined-path dir (string-append 0 "build/programs/" name)))

(define (site-out [dir string] [name string]) -> string (joined-path dir (string-append 0 "build/sites/" name)))

(define (mounted? [m (ptr manifest)] [name string]) -> bool
  (for ([i u32 0]) (< i (-> m sites length)) (+= i 1)
    (let ([s (& (@ (-> m sites) i))])
      (for ([k u32 0]) (< k (-> s mounts length)) (+= k 1)
        (when (== (-> (@ (-> s mounts) k) site) name) (return #t)))))
  #f)

;; ---- what to build ----

(struct target [name string] [site bool] [file string] [out string])

(define declared manifest)
(define declared-dir string)
(define targets buffer)

(define (targeted! [name string] [site bool] [file string] [out string])
  (let ([t (target #:name name #:site site #:file file #:out out)])
    (buffer-add! (& targets) (slice (cast (ptr u8) (& t)) (sizeof target)))))

(define (all-targets) -> (slice target)
  (slice (cast (ptr target) (-> targets bytes)) (/ (-> targets length) (sizeof target))))

;; build-declared! builds what the manifest m of the package in dir declares, or only the program or site called name,
;; and exits. Building several reports each one, and fails if any failed.
(define (build-declared! [dir string] [m (ptr manifest)] [name string] [release bool])
  (set! declared (@ m))
  (set! declared-dir dir)
  (set! targets (make-buffer))
  (set! releasing release)
  (if (> (-> name length) 0)
      (let ([p (program-called m name)] [s (site-called m name)])
        (cond [(!= p 0) (targeted! name #f (resolved-path dir (-> p program)) (program-out dir name))]
              [(!= s 0) (targeted! name #t (resolved-path dir (-> s program)) (site-out dir name))]
              [else (failed! (string-append 0 "the package " (-> m name) " declares no program or site called " name))]))
      (begin
        (for ([i u32 0]) (< i (-> m sites length)) (+= i 1)
          (let ([s (& (@ (-> m sites) i))])
            (unless (mounted? m (-> s name))
              (targeted! (-> s name) #t (resolved-path dir (-> s program)) (site-out dir (-> s name))))))
        (for ([i u32 0]) (< i (-> m programs length)) (+= i 1)
          (let ([p (& (@ (-> m programs) i))])
            (targeted! (-> p name) #f (resolved-path dir (-> p program)) (program-out dir (-> p name)))))
        (when (== (-> targets length) 0)
          (failed! (string-append 0 "the package " (-> m name) " declares no programs or sites to build")))))
  (set! several (> (-> (all-targets) length) 1))
  (set! finished all-built)
  (set! target-at 0)
  (set! failures 0)
  (next-target!))

;; build-program! builds the program p of the package in dir for run, then calls next with the exit code.
(define (build-program! [dir string] [p (ptr declared-program)] [next (fn (i32))])
  (set! declared-dir dir)
  (set! targets (make-buffer))
  (set! releasing #f)
  (targeted! (-> p name) #f (resolved-path dir (-> p program)) (program-out dir (-> p name)))
  (set! several #f)
  (set! finished next)
  (set! target-at 0)
  (set! failures 0)
  (next-target!))

;; ---- building ----

(define target-at u32 0)
(define failures u32 0)
(define several bool #f)
(define releasing bool #f)
(define finished (fn (i32)))

(define (next-target!)
  (let ([ts (all-targets)])
    (if (< target-at (-> ts length))
        (let ([t (& (@ ts target-at))])
          (if (-> t site) (site-started! t) (program-started! t)))
        (finished (if (> failures 0) 1 0)))))

(define (target-done! [ok bool])
  (let ([t (& (@ (all-targets) target-at))])
    (unless ok (+= failures 1))
    (when several (say 1 (if ok (string-append 0 "built " (-> t name) "\n") (string-append 0 (-> t name) " failed\n"))))
    (+= target-at 1)
    (next-target!)))

(define (all-built [code i32])
  (when (and several (> failures 0))
    (let ([b (make-buffer)])
      (write-digits (& b) (cast u64 failures) 10)
      (buffer-add-string! (& b) " of ")
      (write-digits (& b) (cast u64 (-> (all-targets) length)) 10)
      (buffer-add-string! (& b) " failed to build")
      (failed! (buffer-string (& b)))))
  (host-exit code ""))

(define (program-started! [t (ptr target)])
  (prepare! (-> t file))
  (cache!)
  (compile! "build" (-> t file) (-> t out) (slice (array-of string "-t" "node")) (compiler-grants (-> t file) (-> t out))
            program-built))

(define (program-built [code i32]) (target-done! (== code 0)))

;; A site's parts: the site and the sites it mounts, each built in turn.
(define parts (slice site-part))
(define next-part u32 0)

(define (site-started! [t (ptr target)])
  (let ([p (new (& a) site-plan)] [err (make-buffer)])
    (site-planned! (& a) declared-dir (& declared) (-> t name) p)
    (unless (== (kind-of (-> p program)) fs-directory) (prepare! (-> p program)))
    (if (site-write! p (-> t out) (substrate-dir) (& err))
        (begin
          (set! parts (site-parts (& a) p (-> t out)))
          (set! next-part 0)
          (part-built 0))
        (begin
          (say 2 (string-append 0 "substrate: " (buffer-string (& err)) "\n"))
          (target-done! #f)))))

(define (part-built [code i32])
  (unless (== code 0)
    (target-done! #f)
    (return))
  (while (and (< next-part (-> parts length)) (== (kind-of (-> (@ parts next-part) plan program)) fs-directory))
    (+= next-part 1))
  (if (< next-part (-> parts length))
      (let* ([part (& (@ parts next-part))] [dir (joined-path (-> part out) "program")] [program (-> part plan program)])
        (+= next-part 1)
        (cache!)
        (compile! "build" program dir (if releasing (slice (array-of string "-s" "-t" "web")) (slice (array-of string "-t" "web")))
                  (compiler-grants program dir) part-built))
      (let ([err (make-buffer)] [i (-> parts length)] [ok #t])
        (while (and releasing ok (> i 0))
          (-= i 1)
          (unless (site-release! (-> (@ parts i) out) (& err))
            (say 2 (string-append 0 "substrate: " (buffer-string (& err)) "\n"))
            (set! ok #f)))
        (target-done! ok))))
