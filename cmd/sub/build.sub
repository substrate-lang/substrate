;; Building a program: finding its package, making its module map, placing the cache and the store, and running the
;; compiler with the map and the build's grants.
(require-unqualified compiler/macros)
(require-unqualified compiler/roots)
(require-unqualified host/fs)
(require-unqualified host/node/env)
(require-unqualified host/events)
(require-unqualified host/node/process)
(require-unqualified host/grants)
(require-unqualified std/package/manifest)
(require-unqualified std/package/map)
(require-unqualified std/package/path)
(require-unqualified cmd/sub/common)

(provide prepare! package-in! prepare-tests! map-written! program-found program-manifest program-dir program-package
         find-package! module-map! supported! cache-dir store-dir located location user-cache locations! cache! target!
         build! compile! bare-compile! compiler-grants every-grant given-cache given-packages set-in?)

(define (prepare! [file string]) -> string
  (let ([project (find-package! file)])
    (set! map-text (make-buffer))
    (module-map! (& map-text) #f)
    (set-module-map-text! (string->datum (buffer-string (& map-text))) '"the module map")
    (joined-path project "build")))

(define (package-in! [dir string]) -> string
  (let ([err (make-buffer)])
    (unless (manifest-read (& a) (joined-path dir "package.sub") (& program-manifest) (& err))
      (failed! (local (buffer-string (& err)))))
    (set! program-found 2)
    (set! program-dir dir)
    (set! program-file "")
    (set! program-package (-> program-manifest name))
    dir))

(define (prepare-tests!)
  (set! map-text (make-buffer))
  (module-map! (& map-text) #t)
  (set-module-map-text! (string->datum (buffer-string (& map-text))) '"the module map"))

(define (map-written! [path string])
  (let ([why string]) (when (< (fs-write-file path (buffer-bytes (& map-text)) (& why)) 0) (failed! why))))

(define map-text buffer)

(define program-found i32 0)
(define program-manifest manifest)
(define program-dir string)
(define program-file string)
(define program-package string)

(define (find-package! [file string]) -> string
  (unless (== file found-for)
    (set! found-for file)
    (set! found-project (package-of! file)))
  found-project)

(define found-for string)
(define found-project string)

(define (package-of! [file string]) -> string
  (let ([dir (make-buffer)] [err (make-buffer)])
    (set! program-found 0)
    (set! program-package "")
    (when (toolchain-file? file) (return root))
    (set! program-found (manifest-find (& a) file (& program-manifest) (& dir) (& err)))
    (when (< program-found 0) (failed! (local (buffer-string (& err)))))
    (when (== program-found 0) (return (parent-of file)))
    (set! program-dir (if (== program-found 1) (parent-of file) (buffer-string (& dir))))
    (set! program-file (if (== program-found 1) (base-of file) ""))
    (set! program-package (-> program-manifest name))
    program-dir))

(define packages (slice package-root))

(define (module-map! [text (ptr buffer)] [testing bool])
  (let ([err (make-buffer)] [roots (make-buffer)] [std (std-dir)] [m manifest])
    (unless (if (> program-found 0)
                (package-map (& a) program-dir program-file (& program-manifest) std store-dir testing text (& roots) (& err))
                (and (manifest-read (& a) (joined-path std "package.sub") (& m) (& err))
                     (package-map (& a) std "" (& m) std store-dir #f text (& roots) (& err))))
      (failed! (local (buffer-string (& err)))))
    (set! packages (slice (cast (ptr package-root) (-> roots bytes)) (/ (-> roots length) (sizeof package-root))))
    (supported! packages)))

(define (supported! [roots (slice package-root)])
  (let ([v (substrate-version)])
    (for ([i u32 0]) (< i (-> roots length)) (+= i 1)
      (let ([r (& (@ roots i))])
        (when (version-before? v (-> r substrate))
          (failed! (datum->string (format "the package ~a needs substrate ~a or newer, and this is ~a"
                                          `(,(string->datum (-> r name)) ,(string->datum (-> r substrate))
                                            ,(string->datum v))))))))))

(define (toolchain-file? [file string]) -> bool (!= (toolchain-holding (string->datum file)) 0))

;; ---- the cache and the store ----

(define given-cache string)
(define given-packages string)

(define cache-dir string)
(define store-dir string)

(define (located [args (slice string)] [leading bool]) -> (slice string)
  (let ([out (cast (ptr string) (arena-alloc (& a) (* (-> args length) (sizeof string))))] [n u32 0] [i u32 0]
        [flags #t])
    (while (< i (-> args length))
      (let ([x (@ args i)])
        (if (and flags (or (== x "-c") (== x "-P")) (< (+ i 1) (-> args length)))
            (begin
              (if (== x "-c") (set! given-cache (@ args (+ i 1))) (set! given-packages (@ args (+ i 1))))
              (+= i 2))
            (begin
              (when (and leading (not (starts? x "-"))) (set! flags #f))
              (set! (@ out n) x)
              (+= n 1)
              (+= i 1)))))
    (slice out n)))

(define (locations! [project string])
  (set! cache-dir (location given-cache "SUBSTRATE_CACHE" (user-cache (joined-path project "build/cache"))))
  (set! store-dir (location given-packages "SUBSTRATE_PACKAGES" (joined-path project "build/packages"))))

(define (user-cache [fallback string]) -> string
  (let ([dir string])
    (cond [(system? "windows") (if (set-in? "LOCALAPPDATA" (& dir)) (cache-in dir "substrate") fallback)]
          [(system? "macos") (if (set-in? "HOME" (& dir)) (cache-in dir "Library/Caches/substrate") fallback)]
          [(set-in? "XDG_CACHE_HOME" (& dir)) (cache-in dir "substrate")]
          [(set-in? "HOME" (& dir)) (cache-in dir ".cache/substrate")]
          [else fallback])))

(define (cache-in [dir string] [name string]) -> string (joined-path (joined-path (absolute dir) name) (substrate-version)))

(define (set-in? [variable string] [into (ptr string)]) -> bool (and (env-get variable into 0) (> (-> into length) 0)))

(define (location [given string] [variable string] [fallback string]) -> string
  (let ([from-env string])
    (cond [(> (-> given length) 0) (absolute given)]
          [(and (env-get variable (& from-env) 0) (> (-> from-env length) 0)) (absolute from-env)]
          [else fallback])))

(define (cache!) (made! cache-dir))

(define (target! [full string] [out string]) -> string
  (let ([base (prepare! full)]) (if (> (-> out length) 0) (absolute out) (joined-path base (stem-of full)))))

(define (build! [file string] [out string] [strip bool] [next (fn (i32))])
  (let* ([full (absolute file)] [dir (target! full out)])
    (compile! "build" full dir (if strip (slice (array-of string "-s")) (slice (cast (ptr string) 0) 0))
              (compiler-grants full dir) next)))

;; ---- the compiler ----

(struct compiling [head event-head])

(define compiler-run compiling)
(define compiled-then (fn (i32)))
(define map-file string)

;; compile! runs the compiler's command on the file full, with the module map prepare! made and the given grants. When
;; the compiler exits, it calls next with the exit code.
(define (compile! [command string] [full string] [out string] [args (slice string)] [given (ptr grants)]
                  [next (fn (i32))])
  (let ([argv (make-buffer)] [why string])
    (when (< (fs-make-temp-file cache-dir "map-" ".map" (& map-file) (& why)) 0) (failed! why))
    (when (< (fs-write-file map-file (buffer-bytes (& map-text)) (& why)) 0) (failed! why))
    (argument! (& argv) (substrate-dir))
    (argument! (& argv) "-c")
    (argument! (& argv) cache-dir)
    (argument! (& argv) "-d")
    (argument! (& argv) cwd)
    (argument! (& argv) "-m")
    (argument! (& argv) map-file)
    (argument! (& argv) command)
    (argument! (& argv) full)
    (when (> (-> out length) 0)
      (argument! (& argv) "-o")
      (argument! (& argv) out))
    (for ([i u32 0]) (< i (-> args length)) (+= i 1) (argument! (& argv) (@ args i)))
    (compiler! given (& argv) next)))

(define (bare-compile! [full string] [out string] [map string] [cache string] [strip bool] [next (fn (i32))])
  (let ([argv (make-buffer)] [g (make-grants)]
        [dir (if (> (-> out length) 0) (absolute out) (joined-path (parent-of full) (stem-of full)))])
    (set! map-file "")
    (grants-allow-all! (& g) grant-read)
    (grants-allow! (& g) grant-write dir)
    (when (> (-> cache length) 0) (grants-allow! (& g) grant-write cache))
    (argument! (& argv) (substrate-dir))
    (when (> (-> cache length) 0)
      (argument! (& argv) "-c")
      (argument! (& argv) cache))
    (argument! (& argv) "-d")
    (argument! (& argv) cwd)
    (when (> (-> map length) 0)
      (argument! (& argv) "-m")
      (argument! (& argv) (absolute map)))
    (argument! (& argv) "build")
    (argument! (& argv) full)
    (argument! (& argv) "-o")
    (argument! (& argv) dir)
    (when strip (argument! (& argv) "-s"))
    (compiler! (& g) (& argv) next)))

(define (compiler! [g (ptr grants)] [argv (ptr buffer)] [next (fn (i32))])
  (let ([o process-options] [why string] [id u32 0]
        [args (slice (cast (ptr string) (-> argv bytes)) (/ (-> argv length) (sizeof string)))])
    (process-options-init! (& o))
    (set! (-> o stdin) process-inherit)
    (set! (-> o stdout) process-inherit)
    (set! (-> o stderr) process-inherit)
    (set! (-> compiler-run head handle) compiled)
    (set! compiled-then next)
    (set! id (process-spawn (joined-path (substrate-dir) "host/subhost.mjs")
                            (grants-arguments g (joined-path root "build/compiler") args) (& o) (& compiler-run)
                            (& why)))
    (when (== id 0) (failed! why))))

(define (argument! [b (ptr buffer)] [s string]) (buffer-add! b (slice (cast (ptr u8) (& s)) (sizeof string))))

(define (compiled [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (== source process-source)
    (when (> (-> map-file length) 0) (fs-remove map-file #f 0))
    (if (== kind process-exit) (compiled-then value) (failed! (events-take-text)))))

;; ---- grants ----

;; The compiler reads the roots, the cache and out, or any file for a program outside packages, and writes the cache
;; and out.
(define (compiler-grants [full string] [out string]) -> (ptr grants)
  (let ([g (kept-grants)] [dirs (root-directories)])
    (if (or (> (-> program-package length) 0) (toolchain-file? full))
        (begin
          (while (pair? dirs)
            (grants-allow! g grant-read (datum->string (car dirs)))
            (set! dirs (cdr dirs)))
          (grants-allow! g grant-read cache-dir)
          (when (> (-> out length) 0) (grants-allow! g grant-read out)))
        (grants-allow-all! g grant-read))
    (grants-allow! g grant-write cache-dir)
    (when (> (-> out length) 0) (grants-allow! g grant-write out))
    g))

(define (every-grant) -> (ptr grants)
  (let ([g (kept-grants)])
    (grants-all! g)
    g))

(define (kept-grants) -> (ptr grants)
  (let ([g (cast (ptr grants) (arena-alloc (& a) (sizeof grants)))])
    (set! (-> g list) (make-buffer))
    g))
