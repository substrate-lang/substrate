;; Building a program: its package and module map, the cache and the store, and the grants it narrows to.
(require-unqualified macros compiler/macros)
(require-unqualified ex compiler/expander)
(require-unqualified rt compiler/roots)
(require-unqualified main compiler/main)
(require-unqualified fs host/fs)
(require-unqualified env host/node/env)
(require-unqualified process host/node/process)
(require-unqualified manifest std/package/manifest)
(require-unqualified map std/package/map)
(require-unqualified paths std/package/path)
(require-unqualified common cmd/sub/common)

(provide prepare! program-found program-manifest program-dir program-package program-root find-package! module-map!
         supported! cache-dir store-dir located locations! cache! target! build! narrow! granted!)

(define (prepare! [file string]) -> string
  (let* ([text (make-buffer)] [project (find-package! file)])
    (module-map! (& text))
    (when (> (-> text length) 0) (set-module-map-text! (string->datum (buffer-string (& text))) '"the module map"))
    (joined-path project "build")))

(define program-found i32 0)
(define program-manifest manifest)
(define program-dir string)
(define program-file string)
(define program-package string)

(define (program-root) -> datum (if (> (-> program-package length) 0) (string->datum program-package) 0))

(define (find-package! [file string]) -> string
  (unless (== file found-for)
    (set! found-for file)
    (set! found-project (package-of! file)))
  found-project)

(define found-for string)
(define found-project string)

(define (package-of! [file string]) -> string
  (let ([dir (make-buffer)] [err (make-buffer)])
    (set! program-found 0)
    (set! program-package "")
    (when (toolchain-file? file) (return root))
    (set! program-found (manifest-find (& a) file (& program-manifest) (& dir) (& err)))
    (when (< program-found 0) (failed! (local (buffer-string (& err)))))
    (when (== program-found 0) (return (parent-of file)))
    (set! program-dir (if (== program-found 1) (parent-of file) (buffer-string (& dir))))
    (set! program-file (if (== program-found 1) (base-of file) ""))
    (set! program-package (-> program-manifest name))
    program-dir))

(define packages (slice package-root))

(define (module-map! [text (ptr buffer)])
  (let ([err (make-buffer)] [roots (make-buffer)] [std (std-dir)] [m manifest])
    (unless (if (> program-found 0)
                (package-map (& a) program-dir program-file (& program-manifest) std store-dir text (& roots) (& err))
                (and (manifest-read (& a) (joined-path std "package.sub") (& m) (& err))
                     (package-map (& a) std "" (& m) std store-dir text (& roots) (& err))))
      (failed! (local (buffer-string (& err)))))
    (set! packages (slice (cast (ptr package-root) (-> roots bytes)) (/ (-> roots length) (sizeof package-root))))
    (supported! packages)))

;; supported! refuses a package that needs a newer substrate than this one.
(define (supported! [roots (slice package-root)])
  (let ([v (substrate-version)])
    (for ([i u32 0]) (< i (-> roots length)) (+= i 1)
      (let ([r (& (@ roots i))])
        (when (version-before? v (-> r substrate))
          (failed! (datum->string (format "the package ~a needs substrate ~a or newer, and this is ~a"
                                          `(,(string->datum (-> r name)) ,(string->datum (-> r substrate))
                                            ,(string->datum v))))))))))

(define (toolchain-file? [file string]) -> bool (!= (toolchain-holding (string->datum file)) 0))

;; ---- the cache and the store ----

(define given-cache string)
(define given-packages string)

(define cache-dir string)
(define store-dir string)

(define (located [args (slice string)] [leading bool]) -> (slice string)
  (let ([out (cast (ptr string) (arena-alloc (& a) (* (-> args length) (sizeof string))))] [n u32 0] [i u32 0]
        [flags #t])
    (while (< i (-> args length))
      (let ([x (@ args i)])
        (if (and flags (or (== x "-c") (== x "-P")) (< (+ i 1) (-> args length)))
            (begin
              (if (== x "-c") (set! given-cache (@ args (+ i 1))) (set! given-packages (@ args (+ i 1))))
              (+= i 2))
            (begin
              (when (and leading (not (starts? x "-"))) (set! flags #f))
              (set! (@ out n) x)
              (+= n 1)
              (+= i 1)))))
    (slice out n)))

(define (locations! [project string])
  (set! cache-dir (location given-cache "SUBSTRATE_CACHE" (joined-path project "build/cache")))
  (set! store-dir (location given-packages "SUBSTRATE_PACKAGES" (joined-path project "build/packages"))))

(define (location [given string] [variable string] [fallback string]) -> string
  (let ([from-env string])
    (cond [(> (-> given length) 0) (absolute given)]
          [(and (env-get variable (& from-env) 0) (> (-> from-env length) 0)) (absolute from-env)]
          [else fallback])))

(define (cache!)
  (make-dir (string->datum cache-dir))
  (set-cache-directory! (string->datum cache-dir)))

(define (target! [full string] [out string]) -> string
  (let ([base (prepare! full)]) (if (> (-> out length) 0) (absolute out) (joined-path base (stem-of full)))))

(define (build! [file string] [out string] [strip bool]) -> string
  (let* ([full (absolute file)] [dir (target! full out)])
    (narrow! full dir)
    (write-program! (program-root) (string->datum full) (string->datum dir) strip)
    dir))

;; ---- grants ----

(define (narrow! [full string] [out string])
  (let ([r (make-buffer)] [w (make-buffer)] [why string] [dirs (root-directories)]
        [flags (cast (ptr string) (arena-alloc (& a) (* 2 (sizeof string))))])
    (buffer-add-string! (& r) "-R")
    (when (or (> (-> program-package length) 0) (toolchain-file? full))
      (buffer-add-byte! (& r) #\=)
      (while (pair? dirs)
        (granted! (& r) (datum->string (car dirs)))
        (set! dirs (cdr dirs)))
      (granted! (& r) cache-dir)
      (when (> (-> out length) 0) (granted! (& r) out)))
    (buffer-add-string! (& w) "-W=")
    (granted! (& w) cache-dir)
    (when (> (-> out length) 0) (granted! (& w) out))
    (set! (@ flags 0) (buffer-string (& r)))
    (set! (@ flags 1) (buffer-string (& w)))
    (when (< (process-restrict (slice flags 2) (& why)) 0) (failed! why))))

;; Lists in grant flags write a comma as ",," (substrate/host/grants.mjs).
(define (granted! [b (ptr buffer)] [path string])
  (when (> (-> b length) 3) (buffer-add-byte! b #\,))
  (for ([i u32 0]) (< i (-> path length)) (+= i 1)
    (when (== (@ path i) #\,) (buffer-add-byte! b #\,))
    (buffer-add-byte! b (cast i32 (@ path i)))))
