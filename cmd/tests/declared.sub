;; Tests of building and running what a package declares: its programs and sites, a single-file package's site, and
;; what the commands refuse.
(require-unqualified host/fs)
(require-unqualified std/test/test)
(require-unqualified std/package/path)
(require-unqualified std/package/site)
(require-unqualified "support/sub.sub")
(require-unqualified std/string)

(define manifest string "(package shop
  (version \"1.0.0\")
  (sites (shop \"app/shop.sub\" (html \"app/index.html\")
               (files \"/data\" (from \"content\") \"*.txt\" \"notes/**/*.md\"))
         (lost \"app/shop.sub\" (files \"/data\" \"content/*.png\"))))
")

(define (shop!) -> string
  (let ([d (scratch-directory)])
    (written! (joined-path d "package.sub") manifest)
    (written! (joined-path d "app/shop.sub") "(define (main) (printf \"open~n\"))\n")
    (written! (joined-path d "app/index.html") "<!doctype html>\n<div id=\"root\"></div>\n")
    (written! (joined-path d "app/assets/logo.txt") "logo\n")
    (written! (joined-path d "content/one.txt") "1\n")
    (written! (joined-path d "content/two.txt") "2\n")
    (written! (joined-path d "content/notes/a/b.md") "b\n")
    (written! (joined-path d "content/skipped.dat") "\n")
    d))

(define (listing [dir string]) -> string
  (let ([all (files-in dir)] [b (make-buffer)])
    (for ([i u32 0]) (< i (-> all length)) (+= i 1)
      (unless (or (string-prefix? (@ all i) "host/") (string-prefix? (@ all i) "program/"))
        (when (> (-> b length) 0) (buffer-add-byte! (& b) #\space))
        (buffer-add-string! (& b) (@ all i))))
    (buffer-string (& b))))

;; The paths in a pack. Each file in a pack is its path's length, its path, its size and its bytes.
(define (packed [path string]) -> string
  (let ([s (text-in path)] [b (make-buffer)] [at u32 0])
    (while (< at (-> s length))
      (let ([n (u32-at s at)])
        (when (> (-> b length) 0) (buffer-add-byte! (& b) #\space))
        (buffer-add-string! (& b) (slice s (+ at 4) (+ at 4 n)))
        (+= at (+ 4 n))
        (+= at (+ 4 (u32-at s at)))))
    (buffer-string (& b))))

(define (u32-at [s string] [at u32]) -> u32
  (bit-or (bit-or (cast u32 (@ s at)) (<< (cast u32 (@ s (+ at 1))) 8))
          (bit-or (<< (cast u32 (@ s (+ at 2))) 16) (<< (cast u32 (@ s (+ at 3))) 24))))

(test site-named #:grants ((toolchain))
  (let* ([d (shop!)] [out (joined-path d "build/sites/shop")])
    (expect-ran (sub d "build" "shop"))
    (expect-equal (listing out) ".site assets/logo.txt assets.list files.pack index.html")
    (expect-equal (text-in (joined-path out "assets.list")) "assets/logo.txt\n")
    (expect-equal (packed (joined-path out "files.pack")) "/data/notes/a/b.md /data/one.txt /data/two.txt")
    (expect-equal (text-in (joined-path out "index.html")) "<!doctype html>\n<div id=\"root\"></div>\n")
    (expect (exists? (joined-path out "host/web/start.mjs")))
    (expect (exists? (joined-path out "program/program")))))

(define single string "(package hello (version \"1.0.0\") (sites (hello \"hello.sub\")))\n(define (main) (printf \"hello~n\"))\n")

(test site-single-file #:grants ((toolchain))
  (let* ([d (scratch-directory)] [out (joined-path d "build/sites/hello")])
    (written! (joined-path d "hello.sub") single)
    (expect-ran (sub d "build" "hello.sub"))
    (expect-equal (listing out) ".site assets.list files.pack index.html")
    (expect-equal (text-in (joined-path out "assets.list")) "")
    (expect-equal (text-in (joined-path out "files.pack")) "")
    (expect (string-contains? (text-in (joined-path out "index.html")) "host/web/start.mjs"))
    (expect-equal (site-base out) "")))

(test site-refusals #:grants ((toolchain))
  (let ([d (shop!)])
    (written! (joined-path d "build/sites/shop/notes.txt") "mine\n")
    (expect-ran (sub d "build" "shop") #:fails "shop is not a site, so it is not replaced")
    (expect-equal (text-in (joined-path d "build/sites/shop/notes.txt")) "mine\n")
    (removed! (joined-path d "build/sites/shop"))
    (expect-ran (sub d "build" "nope") #:fails "the package shop declares no program or site called nope")
    (expect-ran (sub d "build" "lost") #:fails "matches content/*.png")
    (expect-ran (sub d "build" "shop" "--release") #:fails "has no script that loads host/web/start.mjs")
    (expect-ran (sub d "build" "shop" "-o" "kept") #:fails "usage:")))

(define named string "(package app
  (version \"1.0.0\")
  (dependencies (lib (path \"../lib\")))
  (sites (app \"app.sub\" (files \"/lib\" (from lib) \"data/*.txt\") (files \"/std\" (from std) \"encoding/utf8.sub\")
              (files \"/compiler\" (from compiler) \"path.sub\"))
         (lost \"app.sub\" (files \"/x\" (from nope) \"*.sub\"))))
")

(test site-roots #:grants ((toolchain))
  (let* ([d (scratch-directory)] [app (joined-path d "app")])
    (written! (joined-path d "lib/package.sub") "(package lib (version \"1.0.0\"))\n")
    (written! (joined-path d "lib/lib.sub") "(provide answer)\n(define answer i32 42)\n")
    (written! (joined-path d "lib/data/words.txt") "words\n")
    (written! (joined-path app "package.sub") named)
    (written! (joined-path app "app.sub") "(define (main) (printf \"app~n\"))\n")
    (expect-ran (sub app "build" "app"))
    (expect-equal (packed (joined-path app "build/sites/app/files.pack"))
                  "/compiler/path.sub /lib/data/words.txt /std/encoding/utf8.sub")
    (expect-ran (sub app "build" "lost") #:fails "site: (from nope) names nothing that the site's program can require")))

(define (hash-name? [s string]) -> bool
  (unless (== (-> s length) 16) (return #f))
  (for ([i u32 0]) (< i 16) (+= i 1)
    (unless (or (and (>= (@ s i) #\0) (<= (@ s i) #\9)) (and (>= (@ s i) #\a) (<= (@ s i) #\f))) (return #f)))
  #t)

(define (release-in [out string]) -> string
  (let ([names (slice string)] [found ""])
    (fs-list out (& names) 0)
    (for ([i u32 0]) (< i (-> names length)) (+= i 1) (when (hash-name? (@ names i)) (set! found (@ names i))))
    found))

(test site-release #:grants ((toolchain))
  (let* ([d (scratch-directory)] [out (joined-path d "build/sites/hello")] [first ""])
    (written! (joined-path d "hello.sub") single)
    (written! (joined-path d "assets/logo.txt") "logo\n")
    (expect-ran (sub d "build" "hello.sub" "--release"))
    (let* ([name (release-in out)] [code (joined-path out name)] [html (text-in (joined-path out "index.html"))])
      (expect-equal (-> name length) 16)
      (expect (exists? (joined-path code "host/web/start.mjs")))
      (expect (exists? (joined-path code "host/web/start.mjs.gz")))
      (expect (exists? (joined-path code "program/program")))
      (expect (exists? (joined-path code "files.pack")))
      (expect (not (exists? (joined-path out "host"))))
      (expect (not (exists? (joined-path out "assets.list"))))
      (expect (exists? (joined-path out "assets/logo.txt")))
      (let* ([listed (text-in (joined-path code "assets.list"))] [tab (string-index listed #\tab)]
             [copy (slice listed (+ tab 1) (- (-> listed length) 1))])
        (expect-equal (slice listed 0 tab) "assets/logo.txt")
        (expect (hash-name? (slice copy 7 23)))
        (expect-equal (text-in (joined-path out copy)) "logo\n"))
      (expect (string-contains? html (string-append 0 "<script type=\"module\" src=\"" name "/host/web/start.mjs\"")))
      (expect (not (string-contains? html "modulepreload")))
      (expect (string-contains? html (string-append 0 "<link rel=\"preload\" href=\""
                                                      name "/program/program\" as=\"fetch\" crossorigin>"))))
    (set! first (release-in out))
    (expect-ran (sub d "build" "hello.sub" "--release"))
    (expect-equal (release-in out) first)))

(define desk string "(package desk
  (version \"1.0.0\")
  (sites (desk \"desk.sub\" (html \"index.html\") (base \"/\") (mount \"/notes/\" notes))
         (notes \"notes.sub\")))
")

(define page string "<!doctype html>\n<div id=\"root\"></div>\n<script type=\"module\" src=\"host/web/start.mjs\"></script>\n")

(test site-mounts #:grants ((toolchain))
  (let* ([d (scratch-directory)] [out (joined-path d "build/sites/desk")] [notes (joined-path out "notes")])
    (written! (joined-path d "package.sub") desk)
    (written! (joined-path d "desk.sub") "(define (main) (printf \"desk~n\"))\n")
    (written! (joined-path d "notes.sub") "(define (main) (printf \"notes~n\"))\n")
    (written! (joined-path d "index.html") page)
    (expect-ran (sub d "build" "desk"))
    (expect-equal (text-in (joined-path out "index.html")) (string-append 0 "<!doctype html>\n<base href=\"/\">\n" (slice page 16)))
    (expect (exists? (joined-path out "program/program")))
    (expect (exists? (joined-path notes "program/program")))
    (expect (string-contains? (text-in (joined-path notes "index.html")) "<!doctype html>\n<base href=\"/notes/\">\n"))
    (expect-equal (site-base out) "/")
    (expect-equal (site-base notes) "/notes/")
    (expect-ran (sub d "build" "desk" "--release"))
    (expect (hash-name? (release-in out)))
    (expect (hash-name? (release-in notes)))
    (expect (not (exists? (joined-path notes "host"))))
    (expect (string-contains? (text-in (joined-path notes "index.html")) "<base href=\"/notes/\">"))))

(define (refused [d string] [sites string] [message string])
  (written! (joined-path d "package.sub") (string-append 0 "(package refused (version \"1.0.0\") (sites " sites "))\n"))
  (written! (joined-path d "one.sub") "(define (main) 0)\n")
  (expect-ran (sub d "build" "one") #:fails message))

(test site-mount-refusals #:grants ((toolchain))
  (let ([d (scratch-directory)])
    (refused d "(one \"one.sub\" (base \"x\"))" "a site's base is (base \"/path/\")")
    (refused d "(one \"one.sub\" (mount \"/x\" two)) (two \"one.sub\")" "a site mounts another site the package declares")
    (refused d "(one \"one.sub\" (mount \"/\" two)) (two \"one.sub\")" "at a path other than /")
    (refused d "(one \"one.sub\" (mount \"/x/\" nope))" "this site mounts nope, which the package does not declare")
    (refused d "(one \"one.sub\" (mount \"/a/\" two)) (two \"one.sub\" (mount \"/b/\" one))"
             "this site mounts itself, through the sites it mounts")
    (refused d "(one \"one.sub\" (mount \"/host/\" two)) (two \"one.sub\")"
             "a site cannot mount a site where the build puts its own files")
    (refused d "(one \"one.sub\" (mount \"/x/\" two) (mount \"/x/\" two)) (two \"one.sub\")"
             "this site mounts two sites at the same path")
    (written! (joined-path d "based.html") "<!doctype html>\n<base href=\"/\">\n")
    (refused d "(one \"one.sub\" (html \"based.html\") (base \"/\"))" "the page has a base element, and the site gives a base too")))

(define tools string "(package tools
  (version \"1.0.0\")
  (programs (hello \"hello.sub\") (broken \"broken.sub\"))
  (sites (desk \"desk.sub\" (mount \"/notes/\" notes)) (notes \"notes.sub\")))
")

(define (tools!) -> string
  (let ([d (scratch-directory)])
    (written! (joined-path d "package.sub") tools)
    (written! (joined-path d "hello.sub") "(define (main) (printf \"hello ~a~n\" (@ (host-args) 0)))\n")
    (written! (joined-path d "broken.sub") "(define (main) (nope))\n")
    (written! (joined-path d "desk.sub") "(define (main) (printf \"desk~n\"))\n")
    (written! (joined-path d "notes.sub") "(define (main) (printf \"notes~n\"))\n")
    (written! (joined-path d "loose.sub") "(define (main) (printf \"loose~n\"))\n")
    (written! (joined-path d "inner/readme.txt") "\n")
    d))

(test build-everything #:grants ((toolchain))
  (let* ([d (tools!)] [r (sub d "build")])
    (expect-equal (-> r code) 1)
    (expect (string-contains? (-> r output) "built desk\n"))
    (expect (string-contains? (-> r output) "built hello\n"))
    (expect (string-contains? (-> r output) "broken failed\n"))
    (expect (string-contains? (-> r output) "1 of 3 failed to build"))
    (expect (not (string-contains? (-> r output) "built notes")))
    (expect (exists? (joined-path d "build/programs/hello/program")))
    (expect (exists? (joined-path d "build/sites/desk/notes/program/program")))
    (expect (not (exists? (joined-path d "build/sites/notes"))))))

(test run-named #:grants ((toolchain))
  (let ([d (tools!)])
    (expect-ran (sub d "run" "hello" "there") #:output "hello there")
    (expect (exists? (joined-path d "build/programs/hello/program")))
    (expect-ran (sub (joined-path d "inner") "run" "hello" "inside") #:output "hello inside")
    (expect-ran (sub d "run" "build/programs/hello" "built") #:output "hello built")
    (expect-ran (sub d "run" "desk") #:fails "desk is a site, which runs in a browser: substrate build desk builds it")))

(test files-in-packages #:grants ((toolchain))
  (let ([d (tools!)])
    (expect-ran (sub d "run" "hello.sub") #:fails "hello.sub is hello in the package tools: substrate run hello runs it")
    (expect-ran (sub d "build" "hello.sub") #:fails "hello.sub is hello in the package tools: substrate build hello builds it")
    (expect-ran (sub d "run" "desk.sub") #:fails "desk.sub is desk in the package tools: substrate build desk builds it")
    (expect-ran (sub d "run" "loose.sub")
                #:fails "loose.sub is in the package tools, so it needs to be declared in the package's package.sub")))

(test single-file-refusals #:grants ((toolchain))
  (let ([d (scratch-directory)])
    (written! (joined-path d "hello.sub") single)
    (expect-ran (sub d "run" "hello.sub")
                #:fails "hello.sub declares a site, which runs in a browser: substrate build hello.sub builds it")
    (written! (joined-path d "two.sub") "(package two (version \"1.0.0\") (programs (two \"two.sub\")))\n(define (main) 0)\n")
    (expect-ran (sub d "run" "two.sub") #:fails "a program's first form declares no programs, since it is one")))

(test build-host #:grants ((toolchain))
  (let* ([d (scratch-directory)] [loose (joined-path d "loose")] [hosts (joined-path d "hosts")]
         [page "(require-unqualified host/web/location)\n(define (main) (printf \"start~n\") (printf \"~a~n\" (location-href)))\n"]
         [tool "(require-unqualified host/node/env)\n(define (main) (let ([v string]) (env-get \"HOME\" (& v) 0)))\n"])
    (written! (joined-path loose "page.sub") page)
    (expect-ran (sub loose "build" "page.sub"))
    (expect-ran (host loose "build/page") #:fails "start\nerror: trap: location.href is not available on Node")
    (expect-ran (sub loose "run" "page.sub")
                #:fails "this program runs on Node, but it can call location.href, which only the browser provides: location-href")
    (written! (joined-path hosts "package.sub")
              "(package hosts (version \"1.0.0\") (programs (page \"page.sub\")) (sites (tool \"tool.sub\")))\n")
    (written! (joined-path hosts "page.sub") page)
    (written! (joined-path hosts "tool.sub") tool)
    (expect-ran (sub hosts "build" "page")
                #:fails "this program runs on Node, but it can call location.href, which only the browser provides: location-href")
    (expect-ran (sub hosts "build" "tool")
                #:fails "this program runs in the browser, but it can call env.get, which only Node provides: env-get")))
