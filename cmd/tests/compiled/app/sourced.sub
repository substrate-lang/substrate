;; Opens a session with the module map in its first argument and the toolchain in its second. It then evaluates each
;; later argument in the session, stopping at the first one that fails. The session loads greeting from this program's
;; compiled modules and the other modules from their sources.
(require-unqualified compiler/macros)
(require-unqualified compiler/expander)
(require-unqualified compiler/roots)
(runtime-require greeting)

(define (main)
  (let ([args (host-args)])
    (try (begin
           (set-toolchain-directory! (string->datum (@ args 1)))
           (set-module-map-text! (file-text (string->datum (@ args 0))) (string->datum (@ args 0)))
           (session-open! `"session"))
         [catch compile-error (message blamed loc) (host-exit 1 (datum->string message))])
    (for ([i u32 2]) (< i (-> args length)) (+= i 1)
      (unless (session-eval-text! (string->datum (@ args i)) `"input")
        (host-exit 1 (datum->string (session-error)))))))
