;; Bumps the counter three times, then evaluates each argument in a session, which loads the modules this program
;; names for its sessions. It ends at the first argument that fails.
(require-unqualified compiler/macros)
(require-unqualified compiler/expander)
(require-unqualified "counter.sub")
(runtime-require std/encoding/base64 greeting "counter.sub")

(define (main)
  (bump!)
  (bump!)
  (bump!)
  (install-core!)
  (try (use-compiled-modules!)
       [catch compile-error (message blamed loc) (host-exit 1 (datum->string message))])
  (session-open! `"session")
  (let ([args (host-args)])
    (for ([i u32 0]) (< i (-> args length)) (+= i 1)
      (unless (session-eval-text! (string->datum (@ args i)) `"input")
        (host-exit 1 (datum->string (session-error)))))))
