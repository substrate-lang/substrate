(require-unqualified host/fs)
(require-unqualified std/test/test)
(require-unqualified std/package/path)
(require-unqualified std/crypto/sha512)
(require-unqualified std/encoding/base64)
(require-unqualified "support/sub.sub")

(define (registry! [d string] [version string] [integrity string]) -> string
  (let* ([served (joined-path d "served")] [tarball (joined (joined "substrate-lang-" version) ".tgz")]
         [listed (joined-path served "substrate-lang")])
    (written! (joined-path d "pack/package/substrate/VERSION") (joined version "\n"))
    (written! (joined-path d "pack/package/build/sub/program") "")
    (written! listed "")
    (expect-ran (program served "tar" "-czf" tarball "-C" (joined-path d "pack") "package"))
    (let ([b (make-buffer)])
      (buffer-add-string! (& b) "{\"dist-tags\":{\"latest\":\"")
      (buffer-add-string! (& b) version)
      (buffer-add-string! (& b) "\"},\"versions\":{\"")
      (buffer-add-string! (& b) version)
      (buffer-add-string! (& b) "\":{\"dist\":{\"tarball\":\"http://fake/")
      (buffer-add-string! (& b) tarball)
      (buffer-add-string! (& b) "\",\"integrity\":\"")
      (buffer-add-string! (& b) (if (> (-> integrity length) 0) integrity (sha512-text (joined-path served tarball))))
      (buffer-add-string! (& b) "\"}}}}")
      (written! listed (buffer-string (& b))))
    served))

(define (sha512-text [path string]) -> string
  (let ([bytes (slice u8)] [digest (array u8 64)] [b (make-buffer)])
    (fs-read-file path (& bytes) 0)
    (sha512-of bytes (slice digest))
    (buffer-add-string! (& b) "sha512-")
    (base64-encode! (& b) (slice digest))
    (buffer-string (& b))))

(define (upgraded [d string] [served string]) -> ran
  (sub d #:grants ((fetch served)) #:env ("SUBSTRATE_REGISTRY=http://fake" (joined "SUBSTRATE_HOME=" (joined-path d "home")))
       "upgrade"))

(test upgrade #:grants ((run "tar" "../substrate/host/subhost.mjs"))
  (let* ([d (scratch-directory)] [served (registry! d "9.9.9" "")])
    (expect-ran (upgraded d served) #:output "substrate 9.9.9 is installed in home/toolchains/9.9.9")
    (expect-equal (text-in (joined-path d "home/toolchains/9.9.9/substrate/VERSION")) "9.9.9\n")
    (expect-ran (upgraded d served) #:output "substrate 9.9.9 is installed in home/toolchains/9.9.9")))

(test upgrade-newest #:grants ((run "tar" "../substrate/host/subhost.mjs"))
  (let* ([d (scratch-directory)] [served (registry! d "0.0.1" "")])
    (expect-ran (upgraded d served)
                #:output (joined (joined "substrate " (trimmed (text-in (joined-path (root) "substrate/VERSION")))) " is the newest"))
    (expect (not (exists? (joined-path d "home/toolchains"))))))

(test err-upgrade-hash #:grants ((run "tar" "../substrate/host/subhost.mjs"))
  (let* ([d (scratch-directory)] [served (registry! d "9.9.9" "sha512-AAAA")])
    (expect-ran (upgraded d served) #:fails "fetching http://fake/substrate-lang-9.9.9.tgz: its hash is not the one the registry gives")
    (expect (not (exists? (joined-path d "home/toolchains/9.9.9"))))))
