;; Tests for built programs whose sessions load compiled modules from the build output, with no source files available.
(require-unqualified std/test/test)
(require-unqualified std/package/path)
(require-unqualified host/node/env)
(require-unqualified "support/sub.sub")
(require-unqualified std/string)

;; built builds tests/compiled/app and returns a folder that contains only the built program, in out.
(define (built) -> string
  (let* ([d (scratch-directory)] [from (joined-path d "from")] [to (joined-path d "to")])
    (copied! "tests/compiled" from)
    (expect-ran (sub (joined-path from "app") "build" "app" "-o" (joined-path from "out")))
    (copied! (joined-path from "out") (joined-path to "out"))
    to))

(test compiled #:grants ((toolchain))
  (expect-ran (host (built) "out" "(require-unqualified std/encoding/base64)"
                    "(let ([b (make-buffer)]) (base64-encode! (& b) (cast (slice u8) \"hi\")) (printf \"~a~n\" (buffer-string (& b))))")
              #:output "aGk="))

(test compiled-names #:grants ((toolchain))
  (expect-ran (host (built) "out" "(require-unqualified greeting)" "(greet)") #:output "hello from greeting"))

(test compiled-shared #:grants ((toolchain))
  (expect-ran (host (built) "out" "(require-unqualified app/counter)" "(printf \"~a~n\" (bumps))") #:output "3"))

(test compiled-not-named #:grants ((toolchain))
  (expect-ran (host (built) "out" "(require-unqualified std/crypto/sha1)")
              #:fails "std/crypto/sha1.sub is not available to this program's sessions; list it in runtime-require"))

(test compiled-files #:grants ((toolchain))
  (let* ([out (joined-path (built) "out")] [listed (text-in (joined-path out "compiled"))] [start u32 0])
    (expect (string-contains? listed " greeting/greeting.sub\n"))
    (expect (string-contains? listed " compiler/substrate.sub\n"))
    (expect (exists? (joined-path out "compiled.map")))
    (for ([i u32 0]) (< i (-> listed length)) (+= i 1)
      (when (== (@ listed i) #\newline)
        (let ([space start])
          (while (!= (@ listed space) #\space) (+= space 1))
          (expect (exists? (joined-path out (string-append 0 (slice listed start space) ".subc")))))
        (set! start (+ i 1))))))

(test compiled-damaged #:grants ((toolchain))
  (let* ([to (built)] [out (joined-path to "out")] [w (words (text-in (joined-path out "compiled")))] [hash ""])
    (for ([i u32 1]) (< i (-> w length)) (+= i 2)
      (when (== (@ w i) "greeting/greeting.sub") (set! hash (@ w (- i 1)))))
    (truncated! (joined-path out (string-append 0 hash ".subc")) 100)
    (expect-ran (host to "out" "(require-unqualified greeting)")
                #:fails "the program's compiled greeting/greeting.sub is missing or damaged")))

(test compiled-none #:grants ((toolchain))
  (let ([d (scratch-directory)])
    (written! (joined-path d "plain.sub") "(define (main) (printf \"plain~n\"))\n")
    (written! (joined-path d "out/compiled") "0000 left/from-an-earlier-build.sub\n")
    (expect-ran (sub d "build" "plain.sub" "-o" (joined-path d "out")))
    (expect-equal (text-in (joined-path d "out/compiled")) "")))

(test compiled-then-source #:grants ((toolchain))
  (let* ([d (scratch-directory)] [from (joined-path d "from")] [map (joined-path d "session.map")]
         [toolchain (let ([t string]) (env-get "SUBSTRATE_TOOLCHAIN" (& t) 0) t)] [std (joined-path (root) "std")]
         [text (make-buffer)])
    (copied! "tests/compiled" from)
    (expect-ran (sub (joined-path from "app") "build" "sourced" "-o" (joined-path d "out")))
    (edited! (joined-path from "greeting/greeting.sub") "hello from greeting" "hello from the edited source")
    (buffer-add-string! (& text) "(uses (std std) (greeting greeting))\n(root std \"")
    (buffer-add-string! (& text) std)
    (buffer-add-string! (& text) "\")\n(root greeting \"")
    (buffer-add-string! (& text) (joined-path from "greeting"))
    (buffer-add-string! (& text) "\")\n")
    (written! map (buffer-string (& text)))
    (expect-ran (host d #:grants ((read d std toolchain)) "out" map toolchain "(require-unqualified greeting)" "(greet)"
                      "(require-unqualified greeting/other)" "(other)" "(require-unqualified std/crypto/sha1)")
                #:output "hello from greeting\nother\n")))
