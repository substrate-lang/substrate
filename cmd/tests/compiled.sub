;; Built programs whose sessions load the compiled modules their builds wrote, with no sources at hand.
(require-unqualified std/test/test)
(require-unqualified std/package/path)
(require-unqualified "support/sub.sub")

;; built builds tests/compiled/app, and gives a folder that holds only the program, as out.
(define (built) -> string
  (let* ([d (scratch-directory)] [from (joined-path d "from")] [to (joined-path d "to")])
    (copied! "tests/compiled" from)
    (expect-ran (sub (joined-path from "app") "build" "app.sub" "-o" (joined-path from "out")))
    (copied! (joined-path from "out") (joined-path to "out"))
    to))

(test compiled #:grants ((run "../substrate/host/subhost.mjs"))
  (expect-ran (host (built) "out" "(require-unqualified std/encoding/base64)"
                    "(let ([b (make-buffer)]) (base64-encode! (& b) (cast (slice u8) \"hi\")) (printf \"~a~n\" (buffer-string (& b))))")
              #:output "aGk="))

(test compiled-names #:grants ((run "../substrate/host/subhost.mjs"))
  (expect-ran (host (built) "out" "(require-unqualified greeting)" "(greet)") #:output "hello from greeting"))

(test compiled-shared #:grants ((run "../substrate/host/subhost.mjs"))
  (expect-ran (host (built) "out" "(require-unqualified app/counter)" "(printf \"~a~n\" (bumps))") #:output "3"))

(test compiled-not-named #:grants ((run "../substrate/host/subhost.mjs"))
  (expect-ran (host (built) "out" "(require-unqualified std/crypto/sha1)")
              #:fails "std/crypto/sha1.sub is not one of the modules the program compiled for its sessions"))

(test compiled-none #:grants ((run "../substrate/host/subhost.mjs"))
  (let ([d (scratch-directory)])
    (written! (joined-path d "plain.sub") "(define (main) (printf \"plain~n\"))\n")
    (written! (joined-path d "out/modules") "left from an earlier build")
    (expect-ran (sub d "build" "plain.sub" "-o" (joined-path d "out")))
    (expect (not (exists? (joined-path d "out/modules"))))))
