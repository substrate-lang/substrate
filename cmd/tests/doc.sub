(require-unqualified tests std/test/test)
(require-unqualified paths std/package/path)
(require-unqualified support "support/sub.sub")

(test text
  (let ([d (scratch-directory)] [expected (files-in "tests/doc/expected")])
    (expect-ran (sub "." "doc" "-o" d "tests/doc/sample"))
    (expect-equal (listed (files-in d)) (listed expected))
    (for ([i u32 0]) (< i (-> expected length)) (+= i 1)
      (let ([got (text-in (joined-path d (@ expected i)))] [want (text-in (joined-path "tests/doc/expected" (@ expected i)))])
        (compare-output! got want (@ expected i))
        (expect-equal got want)))))

(test html
  (let ([d (scratch-directory)])
    (expect-ran (sub "." "doc" "--html" "-o" d "tests/doc/sample"))
    (expect (contains? (text-in (joined-path d "sample/sample.html")) "<a href=\"#point\">point</a>"))
    (expect (contains? (text-in (joined-path d "sample/sample.html")) "<a href=\"shapes.html#shape\">shape</a>"))
    (expect (contains? (text-in (joined-path d "sample/shapes.html")) "<dt>private to</dt>"))))

(test by-name
  (let ([d (scratch-directory)])
    (expect-ran (sub (root) "doc" "-o" d "substrate" "std" "cmd" "packages/web" "packages/scheme" "packages/bend"
                     "packages/nodes" "packages/sqlite"))
    (expect (exists? (joined-path d "index.txt")))
    (expect (exists? (joined-path d "compiler/roots.txt")))
    (expect-equal (printed (sub (root) "doc" "std/http/cookie")) (trimmed (text-in (joined-path d "std/http/cookie.txt"))))
    (expect-equal (first-line (printed (sub "tests/packages/app" "doc" "tools/text"))) ";; tools/text")
    (expect-equal (first-line (printed (sub "tests/doc/sample" "doc" "sample/unused"))) ";; sample/unused")))

(test current-package
  (let ([d (scratch-directory)])
    (copied! "tests/packages/app" (joined-path d "app"))
    (copied! "tests/packages/tools" (joined-path d "tools"))
    (expect-ran (sub (joined-path d "app") "doc") #:output "build/doc/index.html")
    (expect (contains? (text-in (joined-path d "app/build/doc/index.html"))
                       "<a href=\"tools/index.html\">tools</a></td></tr><tr><td><a href=\"std/index.html\">std</a>"))
    (expect (contains? (text-in (joined-path d "app/build/doc/app/app.html"))
                       "<a href=\"../tools/text.html\"><code>tools/text</code></a>"))
    (let ([r (sub d "doc")])
      (expect (!= (-> r code) 0))
      (expect-equal (trimmed (-> r output)) "substrate: there is no package.sub in the current directory or above it"))))
