;; Tests that run at once with b.sub's, for cmd/tests/sub-test.sub. waits ends once b.sub's first test has run, and the
;; tests after it check that a test's environment is its own.
(require-unqualified tests std/test/test)
(require-unqualified fs host/fs)
(require-unqualified env host/node/env)
(require-unqualified timer host/modules/timer)

(struct poller [head event-head] [scratch string] [left u32])

(define poll poller)

(define (marker) -> string
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) (-> poll scratch))
    (buffer-add-string! (& b) "/../../b/first/ran")
    (buffer-string (& b))))

(define (polled [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([bytes (slice u8)])
    (cond [(>= (fs-read-file (marker) (& bytes) 0) 0) (expect-equal (scratch-directory) (-> poll scratch))]
          [(== (-> poll left) 0) (expect #f)]
          [else
           (-= (-> poll left) 1)
           (timer-after 10.0 (cast (ptr void) (& poll)))])))

(test waits #:grants ((read "$SCRATCH/../../b"))
  (set! (-> poll head handle) polled)
  (set! (-> poll scratch) (scratch-directory))
  (set! (-> poll left) 500)
  (timer-after 10.0 (cast (ptr void) (& poll))))

(test sets #:grants ((env "SUBSTRATE_LEAK")) (expect-equal (env-set "SUBSTRATE_LEAK" "yes" 0) 0))

(test unset #:grants ((env "SUBSTRATE_LEAK")) (let ([v string]) (expect (not (env-get "SUBSTRATE_LEAK" (& v) 0)))))
