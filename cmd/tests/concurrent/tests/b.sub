;; Tests that run at once with a.sub's, for cmd/tests/sub-test.sub.
(require-unqualified tests std/test/test)
(require-unqualified fs host/fs)

(test first
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) (scratch-directory))
    (buffer-add-string! (& b) "/ran")
    (expect (>= (fs-write-file (buffer-string (& b)) (cast (slice u8) "yes") 0) 0))))

(test second (expect #t))
