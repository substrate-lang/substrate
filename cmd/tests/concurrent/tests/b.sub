;; Tests for cmd/tests/sub-test.sub that run alongside those in a.sub.
(require-unqualified std/test/test)
(require-unqualified host/fs)

(test first
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) (scratch-directory))
    (buffer-add-string! (& b) "/ran")
    (expect (fs-write-file (buffer-string (& b)) (cast (slice u8) "yes") 0))))

(test second (expect #t))
