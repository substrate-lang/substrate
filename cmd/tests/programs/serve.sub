;; sub serve as a process: its URL, its page gzipped and then 304, another Host refused, the log, and SIGINT ending it;
;; then on ::1 with -z 0, the page as it is, and SIGTERM ending it. Given signals, it shows the exit codes, which on
;; Windows are a signal's.
(require-unqualified events host/events)
(require-unqualified stream host/stream)
(require-unqualified net host/node/net)
(require-unqualified process host/node/process)
(require-unqualified fs host/fs)
(require-unqualified http std/http)
(require-unqualified gzip std/compress/gzip)

(struct child [head event-head] [id u32] [out u32] [err u32] [obuf (array u8 4096)] [ebuf (array u8 4096)]
  [url buffer] [log buffer] [port u32] [asked u32] [exited bool] [code i32] [logged bool])
(struct side [head event-head] [in (array u8 4096)] [got buffer])

(define c child)
(define s side)
(define dir string)
(define page buffer)
(define etag buffer)
(define second bool #f)
(define signals bool #f)
(define none (array string 1))

(define (page! [b (ptr buffer)])
  (buffer-add-string! b "<!doctype html>\n<title>serve</title>\n")
  (for ([i u32 0]) (< i 100) (+= i 1)
    (buffer-add-string! b "<p>line ")
    (write-digits b (cast u64 i) 10)
    (buffer-add-string! b "</p>\n")))

(define (header-of [answer string] [name string]) -> string
  (let ([i u32 0] [n (-> answer length)])
    (while (< i n)
      (let ([start i] [k u32 0])
        (while (and (< i n) (!= (@ answer i) 10)) (+= i 1))
        (let ([line (slice answer start (if (and (> i start) (== (@ answer (- i 1)) 13)) (- i 1) i))])
          (when (== (-> line length) 0) (return ""))
          (while (and (< k (-> line length)) (!= (@ line k) 58)) (+= k 1))
          (when (and (< k (-> line length)) (http-same? (slice line 0 k) name))
            (return (http-trimmed (slice line (+ k 1))))))
        (+= i 1)))
    ""))

(define (body-of [answer string]) -> (slice u8)
  (let ([i u32 0])
    (while (and (< (+ i 4) (-> answer length)) (!= (slice answer i (+ i 4)) "\r\n\r\n")) (+= i 1))
    (cast (slice u8) (slice answer (+ i 4)))))

(define (the-page? [answer string]) -> bool
  (let ([body (body-of answer)] [out (make-buffer)] [same #f])
    (if (== (header-of answer "content-encoding") "gzip")
        (set! same (and (== (gunzip! (& out) body 1000000) 0) (== (buffer-string (& out)) (buffer-string (& page)))))
        (set! same (== (cast string body) (buffer-string (& page)))))
    (buffer-free! (& out))
    same))

(define (start! [flags (slice string)])
  (let ([args (array string 11)] [n u32 4] [o process-options])
    (set! (@ args 0) "-A")
    (set! (@ args 1) "../../build/sub")
    (set! (@ args 2) "../..")
    (set! (@ args 3) "serve")
    (for ([i u32 0]) (< i (-> flags length)) (+= i 1)
      (set! (@ args n) (@ flags i))
      (+= n 1))
    (set! (@ args n) dir)
    (set! (@ args (+ n 1)) "0")
    (set! (-> c url length) 0)
    (set! (-> c log length) 0)
    (set! (-> c port) 0)
    (set! (-> c asked) 0)
    (set! (-> c exited) #f)
    (set! (-> c logged) #f)
    (process-options-init! (& o))
    (set! (-> o stdin) process-ignore)
    (set! (-> c id) (process-spawn "../../substrate/host/subhost.mjs" (slice args (+ n 2)) (& o) (& c) 0))
    (set! (-> c out) (process-stdout (-> c id)))
    (set! (-> c err) (process-stderr (-> c id)))
    (stream-read! (-> c out) (slice (-> c obuf)))
    (stream-read! (-> c err) (slice (-> c ebuf)))))

(define (ask!)
  (set! (-> s got length) 0)
  (net-connect (-> c port) (if second "::1" "127.0.0.1") #f (& s) 0))

(define (listening!)
  (let* ([url (buffer-string (& (-> c url)))] [end (- (-> url length) 2)] [start end])
    (while (and (> start 0) (!= (@ url (- start 1)) 58)) (-= start 1))
    (set! (-> c port) (cast u32 (http-decimal (slice url start end))))
    (printf "url: ~aPORT/\n" (slice url 0 start))
    (ask!)))

(define (field [line string] [name string]) -> string
  (let ([n (-> name length)] [i u32 0])
    (while (< (+ i n 1) (-> line length))
      (when (and (or (== i 0) (== (@ line (- i 1)) 32)) (== (slice line i (+ i n)) name) (== (@ line (+ i n)) 61))
        (let ([end (+ i n 1)])
          (while (and (< end (-> line length)) (!= (@ line end) 32)) (+= end 1))
          (return (slice line (+ i n 1) end))))
      (+= i 1))
    ""))

;; ended! shows the exit code and the log once both have come, then starts the second run or ends.
(define (ended!)
  (when (and (-> c exited) (-> c logged))
    (if signals (printf "exit ~a\n" (-> c code)) (printf "ended\n"))
    (let ([log (buffer-string (& (-> c log)))] [start u32 0])
      (for ([i u32 0]) (< i (-> log length)) (+= i 1)
        (when (== (@ log i) 10)
          (let ([line (slice log start i)])
            (if (== (field line "msg") "request")
                (printf "log: ~a ~a ~a\n" (field line "method") (field line "target") (field line "status"))
                (printf "stderr: ~a\n" line)))
          (set! start (+ i 1)))))
    (if second
        (fs-remove dir #t 0)
        (begin
          (set! second #t)
          (start! (slice (array-of string "-l" "::1" "-z" "0")))))))

(define (answered!)
  (let* ([answer (buffer-string (& (-> s got)))] [tag (header-of answer "etag")] [asked (-> c asked)])
    (printf "~a: ~a, encoding ~s, vary ~s, etag ~a"
            (cond [(== asked 0) "the page"] [(== asked 1) "again"] [else "another host"])
            (if (>= (-> answer length) 12) (slice answer 9 12) "none") (header-of answer "content-encoding")
            (header-of answer "vary")
            (cond [(== (-> tag length) 0) "none"] [(== (slice tag 0 2) "W/") "weak"] [else "strong"]))
    (when (== asked 0)
      (printf ", the page: ~a" (the-page? answer))
      (set! (-> etag length) 0)
      (buffer-add-string! (& etag) tag))
    (printf "\n")
    (+= (-> c asked) 1)
    (if (< (-> c asked) (if second 1 3))
        (ask!)
        (process-kill (-> c id) (if second 15 2)))))

(define (child-heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (cond [(== source process-source)
         (if (== kind process-exit)
             (begin
               (set! (-> c exited) #t)
               (set! (-> c code) value)
               (ended!))
             (printf "not started: ~a\n" (events-take-text)))]
        [(and (== kind stream-read) (> value 0) (== id (-> c out)))
         (buffer-add! (& (-> c url)) (slice (-> c obuf) (cast u32 value)))
         (when (and (== (-> c port) 0) (== (@ (buffer-bytes (& (-> c url))) (- (-> c url length) 1)) 10))
           (listening!))
         (stream-read! id (slice (-> c obuf)))]
        [(and (== kind stream-read) (> value 0) (== id (-> c err)))
         (buffer-add! (& (-> c log)) (slice (-> c ebuf) (cast u32 value)))
         (stream-read! id (slice (-> c ebuf)))]
        [(and (== kind stream-read) (== id (-> c err)))
         (set! (-> c logged) #t)
         (ended!)]))

(define (side-heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (cond [(and (== source net-source) (== kind net-connected))
         (let ([b (make-buffer)])
           (http-write-request! (& b) "GET" "/")
           (http-write-header! (& b) "host" (if (== (-> c asked) 2) "evil.example" "localhost"))
           (http-write-header! (& b) "accept-encoding" "gzip")
           (when (== (-> c asked) 1) (http-write-header! (& b) "if-none-match" (buffer-string (& etag))))
           (http-write-header! (& b) "connection" "close")
           (http-write-end! (& b))
           (stream-write id (buffer-bytes (& b)))
           (buffer-free! (& b)))
         (stream-read! id (slice (-> s in)))]
        [(== source net-source)
         (printf "not connected: ~a\n" (events-take-text))
         (process-kill (-> c id) 15)]
        [(and (== kind stream-read) (> value 0))
         (buffer-add! (& (-> s got)) (slice (-> s in) (cast u32 value)))
         (stream-read! id (slice (-> s in)))]
        [(or (== kind stream-read) (== kind stream-failed))
         (stream-close id)
         (answered!)]))

(define (main)
  (set! signals (and (> (-> (host-args) length) 0) (== (@ (host-args) 0) "signals")))
  (set! (-> c head handle) child-heard)
  (set! (-> s head handle) side-heard)
  (page! (& page))
  (fs-make-temp-dir "" "serve" "" (& dir) 0)
  (let ([path (make-buffer)])
    (buffer-add-string! (& path) dir)
    (buffer-add-string! (& path) "/index.html")
    (fs-write-file (buffer-string (& path)) (buffer-bytes (& page)) 0)
    (buffer-free! (& path)))
  (start! (slice none 0)))
