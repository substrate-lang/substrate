;; substrate run, build, eval and compile.
(require-unqualified tests std/test/test)
(require-unqualified paths std/package/path)
(require-unqualified support "support/sub.sub")

(test run #:grants ((run "../substrate/host/subhost.mjs"))
  (let ([d (scratch-directory)])
    (written! (joined-path d "count.sub")
              (joined "(define (depth [n i32]) -> i32 (if (== n 0) 0 (+ 1 (depth (- n 1)))))\n"
                      "(define (main) (printf \"~a ~a~n\" (-> (host-args) length) (depth 25000)) (host-exit 4 \"\"))\n"))
    (let ([r (sub d "run" "count.sub" "a" "b" "c")])
      (expect-equal (-> r code) 4)
      (expect-equal (trimmed (-> r output)) "3 25000"))
    (expect (exists? (joined-path d "build/count/program")))))

(test run-outside #:grants ((run "../substrate/host/subhost.mjs"))
  (let ([d (scratch-directory)])
    (written! (joined-path d "app/program") "../x\n")
    (expect-ran (sub d "run" "app") #:fails "substrate: app/program lists ../x, which is not in app")))

(test host-inherit #:grants ((run "../substrate/host/subhost.mjs"))
  (expect-ran (program "." (joined-path (root) "substrate/host/subhost.mjs") "--grant" "inherit" "read" "app")
              #:fails "substrate: inherit is only for workers"))

(test run-missing-program #:grants ((run "../substrate/host/subhost.mjs"))
  (let ([d (scratch-directory)])
    (written! (joined-path d "ran.sub") "(define (main) (printf \"ran~n\"))\n")
    (expect-ran (sub d "run" "--allow-run=no-such-program" "ran.sub")
                #:output "substrate: --allow-run: no-such-program is not found, so it is not granted\nran")))

(test build-in-package #:grants ((run "../substrate/host/subhost.mjs"))
  (let ([d (scratch-directory)])
    (copied! "tests/packages/app" (joined-path d "app"))
    (copied! "tests/packages/tools" (joined-path d "tools"))
    (expect-ran (sub d "build" "app/app.sub"))
    (expect (exists? (joined-path d "app/build/app/program")))))

(test compile-time #:grants ((run "../substrate/host/subhost.mjs"))
  (let ([d (scratch-directory)])
    (written! (joined-path d "prints.sub") "(begin-for-syntax (printf \"~a~n\" 2))\n(define (main) (printf \"~a~n\" 3))\n")
    (expect-ran (sub d "build" "prints.sub" "-c" (joined-path d "cache")) #:output "2")
    (written! (joined-path d "traps.sub")
              (joined "(begin-for-syntax\n  (require-unqualified macros compiler/macros)\n  (define (broken [stx datum]) -> datum (cdr '())))\n"
                      "(define-syntax broken broken)\n(define (main) (broken))\n"))
    (expect-ran (sub d "build" "traps.sub" "-c" (joined-path d "cache")) #:fails "traps.sub:5:16: error: trap: expected a pair")))

(test eval #:grants ((run "../substrate/host/subhost.mjs"))
  (expect-ran (sub "tests/run" "eval" "supplied.sub") #:output "by name 9, constructed 42"))

(test compile #:grants ((run "../substrate/host/subhost.mjs"))
  (let ([d (scratch-directory)])
    (written! (joined-path d "hello.sub") "(define (main) (printf \"~a~n\" 42))\n")
    (expect-ran (sub d "compile" "hello.sub"))
    (expect-ran (host d "hello") #:output "42")))

(test compile-with-map #:grants ((run "../substrate/host/subhost.mjs"))
  (let ([d (scratch-directory)])
    (written! (joined-path d "encoded.sub")
              (joined "(require-unqualified b64 std/encoding/base64)\n"
                      "(define (main) (let ([b (make-buffer)]) (base64-encode! (& b) (cast (slice u8) \"hi\")) (printf \"~a~n\" (buffer-string (& b)))))\n"))
    (written! (joined-path d "encoded.map") (printed (sub d "map" "encoded.sub")))
    (expect-ran (sub d "compile" "encoded.sub" "-m" "encoded.map" "-o" "out"))
    (expect-ran (host d "out") #:output "aGk=")
    (expect-ran (sub d "compile" "encoded.sub" "-o" "out") #:fails "this module has no name std")))
