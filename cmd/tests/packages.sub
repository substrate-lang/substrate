;; Programs outside every package, in scratch directories.

(test name-outside-packages
  (let ([d (scratch-directory)])
    (written! (joined-path d "a.sub") "(require x nosuch/thing)\n")
    (expect-ran (sub d "build" "a.sub" "-c" (test-option "--cache")) #:fails "this module has no name nosuch")))

(test path-into-toolchain
  (let ([d (scratch-directory)])
    (written! (joined-path d "a.sub")
              (joined (joined "(require leb \"" (relative-path d (joined-path (root) "substrate/compiler/leb128.sub")))
                      "\")\n(define (main) (printf \"~a\\n\" (leb:uleb-length 300)))\n"))
    (expect-ran (sub d "build" "a.sub" "-c" (test-option "--cache")) #:fails "is in compiler, which is required by name")))

;; relative-path gives the path of the file at path, from /, relative to the directory dir, from /.
(define (relative-path [dir string] [path string]) -> string
  (let ([b (make-buffer)])
    (for ([i u32 0]) (< i (-> dir length)) (+= i 1) (when (== (@ dir i) #\/) (buffer-add-string! (& b) "../")))
    (buffer-add-string! (& b) (slice path 1))
    (buffer-string (& b))))

;; Code outside packages may require a package's file by path when its module map does not give that package.
(test path-into-package
  (let ([d (scratch-directory)])
    (copied! "tests/packages/cside" (joined-path d "cside"))
    (written! (joined-path d "a.sub") "(require side \"cside/cside.sub\")\n(define (main) (printf \"~a\\n\" (side:add 2 3)))\n")
    (expect-ran (sub d "run" "-c" (test-option "--cache") "a.sub") #:output "12")))

;; A package built from two directories gives the same program.
(test two-directories
  (let ([d (scratch-directory)] [cache (test-option "--cache")])
    (names-copied! (joined-path d "one"))
    (names-copied! (joined-path d "two"))
    (expect-ran (sub d "build" "one/names.sub" "-o" (joined-path d "one-built") "-c" cache))
    (expect-ran (sub d "build" "two/names.sub" "-o" (joined-path d "two-built") "-c" cache))
    (expect (same-program? (joined-path d "one-built") (joined-path d "two-built")))))

(define (names-copied! [to string])
  (copied! "tests/packages/names.sub" (joined-path to "names.sub"))
  (copied! "tests/packages/tools" (joined-path to "tools"))
  (copied! "tests/packages/app" (joined-path to "app")))

;; pull.sub has a macro, pull, that requires hidden.sub.
(define pull-source string
  "(begin-for-syntax\n  (require-unqualified macros compiler/macros)\n  (define (pull [stx datum]) -> datum #'(require h \"hidden.sub\")))\n(define-syntax pull pull)\n(provide pull)\n")

(define hidden-source string "(provide h)\n(define (h) -> i32 1)\n")

;; A package's modules and tests may require any file in its directory, even through a macro.
(test package-files
  (let ([d (scratch-directory)] [cache (test-option "--cache")])
    (written! (joined-path d "q/package.sub") "(package q (version \"0.1.0\"))\n")
    (written! (joined-path d "q/pull.sub") pull-source)
    (written! (joined-path d "q/hidden.sub") hidden-source)
    (written! (joined-path d "q/q.sub") "(require p \"pull.sub\")\n(p:pull)\n(provide v)\n(define (v) -> i32 2)\n")
    (written! (joined-path d "q/tests/private.sub") "(require h \"../hidden.sub\")\n(define (main) (printf \"~a~n\" (h:h)))\n")
    (written! (joined-path d "q/tests/public.sub") "(require q \"../q.sub\")\n(define (main) (printf \"~a~n\" (q:v)))\n")
    (expect-ran (built-run d "q/tests/private.sub" (joined-path d "private") cache) #:output "1")
    (expect-ran (built-run d "q/tests/public.sub" (joined-path d "public") cache) #:output "2")))

;; A require through a link in a package is refused, and the package's hash leaves links out.
(test links
  (let ([d (scratch-directory)] [cache (test-option "--cache")])
    (written! (joined-path d "p/package.sub") "(package p (version \"0.1.0\"))\n")
    (written! (joined-path d "elsewhere/z.sub") "(provide z)\n(define (z) -> i32 1)\n")
    (linked! "../elsewhere" (joined-path d "p/lib"))
    (linked! "../elsewhere/z.sub" (joined-path d "p/z.sub"))
    (written! (joined-path d "p/p.sub") "(provide v)\n(define (v) -> i32 2)\n")
    (written! (joined-path d "p/tests/t.sub") "(require z \"../lib/z.sub\")\n(define (main) (printf \"~a~n\" (z:z)))\n")
    (expect-ran (sub d "build" "p/tests/t.sub" "-o" (joined-path d "t") "-c" cache)
                #:fails "\"../lib/z.sub\" goes through a link in the package p")
    (written! (joined-path d "p/p.sub") "(require z \"z.sub\")\n(provide v)\n(define (v) -> i32 (z:z))\n")
    (expect-ran (sub d "build" "p/p.sub" "-o" (joined-path d "p-built") "-c" cache)
                #:fails "\"z.sub\" goes through a link in the package p")
    (copied! (joined-path d "p/package.sub") (joined-path d "q/package.sub"))
    (copied! (joined-path d "p/p.sub") (joined-path d "q/p.sub"))
    (copied! (joined-path d "p/tests/t.sub") (joined-path d "q/tests/t.sub"))
    (expect (starts? (printed (sub d "hash" "p")) "sha256:"))
    (expect-equal (printed (sub d "hash" "q")) (printed (sub d "hash" "p")))))

;; Another package requires only a package's exports: not a module an export loads, nor one no longer exported when the
;; requiring module comes from the cache, nor one a macro of the package requires into the other package's module.
(test exports
  (let ([d (scratch-directory)] [cache (test-option "--cache")])
    (written! (joined-path d "r/package.sub") "(package r (version \"0.1.0\") (exports a b))\n")
    (written! (joined-path d "r/a.sub") "(require b \"b.sub\")\n(provide a)\n(define (a) -> i32 (+ 1 (b:b)))\n")
    (written! (joined-path d "r/b.sub") "(provide b)\n(define (b) -> i32 1)\n")
    (written! (joined-path d "c/package.sub") "(package c (version \"0.1.0\") (dependencies (r (path \"../r\"))))\n")
    (written! (joined-path d "c/both.sub")
              "(require a r/a)\n(require b r/b)\n(define (main) (printf \"~a~n\" (+ (a:a) (b:b))))\n")
    (expect-ran (built-run d "c/both.sub" (joined-path d "both") cache) #:output "3")
    (written! (joined-path d "r/package.sub") "(package r (version \"0.1.0\") (exports a))\n")
    (expect-ran (built-run d "c/both.sub" (joined-path d "both") cache) #:fails "r/b is not one of the modules r exports")
    (written! (joined-path d "l/package.sub") "(package l (version \"0.1.0\") (exports pull))\n")
    (written! (joined-path d "l/pull.sub") pull-source)
    (written! (joined-path d "l/hidden.sub") hidden-source)
    (written! (joined-path d "u/package.sub") "(package u (version \"0.1.0\") (dependencies (l (path \"../l\"))))\n")
    (written! (joined-path d "u/use.sub") "(require p l/pull)\n(p:pull)\n(define (main) (printf \"~a~n\" 1))\n")
    (expect-ran (built-run d "u/use.sub" (joined-path d "use") cache)
                #:fails "\"hidden.sub\" is not one of the modules l exports")
    (written! (joined-path d "l/package.sub") "(package l (version \"0.1.0\") (exports pull hidden))\n")
    (expect-ran (built-run d "u/use.sub" (joined-path d "use") cache) #:output "1")))

;; A C module that does not export __wasm_call_ctors, which runs its constructors, is refused.
(test unexported-constructors
  (let ([d (scratch-directory)])
    (written! (joined-path d "c.c") "int one(void) { return 1; }\n")
    (expect-ran (program d "wasm32-unknown-wasi-clang" "-O2" "-fPIC" "-fvisibility=default" "-nostdlib" "-shared"
                         "-Wl,--experimental-pic" "-Wl,--no-entry" "-o" "c.wasm" "c.c"))
    (written! (joined-path d "main.sub") "(require c \"c.wasm\")\n(define (main) (printf \"~a~n\" (c:one)))\n")
    (expect-ran (sub d "build" "main.sub" "-c" (test-option "--cache")) #:fails "c.wasm does not export __wasm_call_ctors")))

;; sub hash prints the hash a dependency pins, and sub map the module map a program is built with.
(test hash-and-map
  (let ([mapped (printed (sub "tests/packages" "map" "names.sub"))])
    (expect-equal (printed (sub "tests/packages" "hash" "maps/lib")) (hash-in (text-in "tests/packages/package-library.out")))
    (expect (contains? (after mapped "(root names \"") "(uses (tools tools) (app app)) (file \"names.sub\"))"))))

;; after gives the text after the first part in s, or "".
(define (after [s string] [part string]) -> string
  (for ([i u32 0]) (<= (+ i (-> part length)) (-> s length)) (+= i 1)
    (when (== (slice s i (+ i (-> part length))) part) (return (slice s (+ i (-> part length))))))
  "")

;; A package that needs a newer substrate is refused. sub version prints this substrate's version and the hash of
;; substrate/.
(test newer-substrate
  (let ([d (scratch-directory)] [version (words (printed (sub (root) "version")))])
    (expect-equal (-> version length) 3)
    (expect-equal (@ version 0) "substrate")
    (expect-equal (hash-in (@ version 2)) (@ version 2))
    (written! (joined-path d "package.sub") "(package newer (version \"1.0.0\") (substrate \"99.0.0\"))\n")
    (written! (joined-path d "newer.sub") "(define (main) (printf \"newer~n\"))\n")
    (let ([r (sub d "build" "newer.sub" "-c" (test-option "--cache"))])
      (expect (!= (-> r code) 0))
      (expect-equal (trimmed (-> r output))
                    (joined "sub: the package newer needs substrate 99.0.0 or newer, and this is " (@ version 1))))))
