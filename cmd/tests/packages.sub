(test path-into-toolchain #:grants ((toolchain))
  (let ([d (scratch-directory)] [leb (joined-path (root) "substrate/compiler/leb128.sub")])
    (written! (joined-path d "a.sub")
              (joined (joined "(require leb \"" (relative-path d leb)) "\")\n(define (main) (printf \"~a\\n\" (leb:uleb-length 300)))\n"))
    (expect-ran (sub d "build" "a.sub") #:fails "is in compiler, which is required by name")
    (written! (joined-path d "b.sub") (joined (joined "(require leb \"" leb) "\")\n(define (main) (printf \"~a\\n\" (leb:uleb-length 300)))\n"))
    (expect-ran (sub d "build" "b.sub") #:fails "is in compiler, which is required by name")))

;; Code outside packages may require a package's file by path when its module map does not give that package.
(test path-into-package #:grants ((toolchain))
  (let ([d (scratch-directory)])
