(test hash-and-map #:grants ((toolchain))
  (let ([mapped (printed (sub "tests/packages" "map" "names.sub"))])
    (expect-equal (printed (sub "tests/packages" "hash" "maps/lib")) (hash-in (text-in "tests/packages/package-library.out")))
    (expect (contains? (after mapped "(root names \"") "(uses (tools tools) (app app)) (file \"names.sub\"))"))))

(define (after [s string] [part string]) -> string
  (for ([i u32 0]) (<= (+ i (-> part length)) (-> s length)) (+= i 1)
    (when (== (slice s i (+ i (-> part length))) part) (return (slice s (+ i (-> part length))))))
  "")

(test newer-substrate #:grants ((toolchain))
  (let ([d (scratch-directory)] [version (words (printed (sub (root) "version")))])
    (expect-equal (-> version length) 3)
    (expect-equal (@ version 0) "substrate")
    (expect-equal (@ version 1) (trimmed (text-in (joined-path (root) "substrate/VERSION"))))
    (expect-equal (hash-in (@ version 2)) (@ version 2))
    (written! (joined-path d "package.sub") "(package newer (version \"1.0.0\") (substrate \"99.0.0\"))\n")
    (written! (joined-path d "newer.sub") "(define (main) (printf \"newer~n\"))\n")
    (let ([r (sub d "build" "newer.sub")])
      (expect (!= (-> r code) 0))
      (expect-equal (trimmed (-> r output))
                    (joined "substrate: the package newer needs substrate 99.0.0 or newer, and this is " (@ version 1))))))
