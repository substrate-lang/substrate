;; The README's examples, run as it runs them.
(require-unqualified std/test/test)
(require-unqualified std/package/path)
(require-unqualified "support/sub.sub")

(define (examples [dir string]) -> string (joined-path (root) (joined-path "examples" dir)))

(test hello #:grants ((toolchain))
  (expect-ran (sub (examples "hello") "run" "hello.sub") #:output "Hello, world!"))

(test grants #:grants ((toolchain))
  (let ([hello "(define (main) (printf \"Hello, world!\\n\"))"])
    (expect-ran (sub (examples "hello") "run" "cat.sub" "hello.sub")
                #:fails "hello.sub: reading is not granted (--allow-read)")
    (expect-ran (sub (examples "hello") "run" "-R=hello.sub" "cat.sub" "hello.sub") #:output hello)
    (expect-ran (sub (examples "hello") "run" "-A" "cat.sub" "hello.sub") #:output hello)))

(test core #:grants ((toolchain))
  (expect-ran (sub (examples "") "run" "core.sub")
              #:fails (joined "point: 3, 4\nareas: 9, 42\nbool: #t, f32: 0.5, f64: 0.3333333333333333, u8 255 + 1: 0\n"
                              (joined "Substrate has 9 bytes and starts with Sub\nlargest: 9, 1.5\nabove 4: 2, above 8: 1\n"
                                      "error: trap: index 3 is out of range for length 3\n"))))

(test json #:grants ((toolchain))
  (expect-ran (sub (examples "") "run" "json.sub")
              #:output "substrate 0.9.4 has 2 tags\n{\"name\":\"substrate\",\"version\":\"1.0.0\",\"tags\":[\"lisp\",\"wasm\"]}"))

(test swap #:grants ((toolchain))
  (expect-ran (sub (examples "") "run" "swap.sub") #:output "2 1"))

(test memory #:grants ((toolchain))
  (expect-ran (sub (examples "") "run" "memory.sub") #:output "malloc: 7\narena: 1000 999 998\nbuffer: grows as needed"))
