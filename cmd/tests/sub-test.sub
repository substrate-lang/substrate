(require-unqualified std/test/test)
(require-unqualified std/package/path)
(require-unqualified "support/sub.sub")

(test all #:grants ((toolchain))
  (expect-ran (sub "tests" "test" "./failing")
              #:fails "failing: 2 passed, 5 failed, 3 ignored"))

(test inline #:grants ((toolchain))
  (expect-ran (sub "tests" "test" "-v" "./failing" "inline" "expects")
              #:fails "ok failing/failing.sub:5 inline\nFAIL failing/tests/failing.sub:5 expects"))

(test expect #:grants ((toolchain))
  (expect-ran (sub "tests" "test" "./failing" "expects")
              #:fails "FAIL failing/tests/failing.sub:5 expects\n  failing/tests/failing.sub:5: (expect (> (f:half 4) 3))\nfailing: 0 passed, 1 failed"))

(test expect-equal #:grants ((toolchain))
  (expect-ran (sub "tests" "test" "./failing" "equals")
              #:fails "FAIL failing/tests/failing.sub:7 equals\n  failing/tests/failing.sub:7: (expect-equal (f:half 9) 5)\n    got      4\n    expected 5"))

(test snapshot #:grants ((toolchain))
  (expect-ran (sub "tests" "test" "./failing" "snapshot")
              #:fails "  --- expected\n  +++ got\n    one\n  - two\n    three"))

(test trap-then-next #:grants ((toolchain))
  (expect-ran (sub "tests" "test" "./failing" "trap")
              #:fails "FAIL failing/tests/failing.sub:11 traps\n  trap: divide by zero\n      at %test-traps failing/tests/failing.sub:11:"))

(test after-trap #:grants ((toolchain))
  (expect-ran (sub "tests" "test" "./failing" "trap")
              #:fails "failing: 1 passed, 1 failed"))

(test output #:grants ((toolchain))
  (expect-ran (sub "tests" "test" "./failing" "prints")
              #:fails "  failing/tests/failing.sub:15: (expect #f)\n  output:\n    printed before failing"))

(test timeout #:grants ((toolchain))
  (expect-ran (sub "tests" "test" "--timeout" "1s" "--ignored" "./failing" "hangs" "after-hang")
              #:fails "FAIL failing/tests/failing.sub:19 hangs\n  the test was still running after 1 s\nfailing: 1 passed, 1 failed"))

(test at-once #:grants ((toolchain))
  (let ([r (sub "tests" "test" "-v" "-E=SUBSTRATE_LEAK" "./concurrent")])
    (expect-equal (-> r code) 0)
    (expect (contains? (-> r output) (joined "ok concurrent/tests/a.sub:26 waits\nok concurrent/tests/a.sub:32 sets\n"
                                             "ok concurrent/tests/a.sub:34 unset\nok concurrent/tests/b.sub:5 first\n")))))

(test not-a-package #:grants ((toolchain))
  (expect-ran (sub "tests" "test" "./nowhere")
              #:fails "substrate: ./nowhere is not a package's directory"))

(test fakes #:grants ((toolchain))
  (expect-ran (sub "tests" "test" "--fake=timer" "./failing")
              #:fails "substrate: test: a test asks for fakes in its #:grants, not on the command line"))

(test workers #:grants ((toolchain))
  (let ([r (sub "tests" "test" "-R=failing" "-v" "./workers" "counts" "fresh" "waits" "declared")])
    (expect-equal (-> r code) 0)
    (expect (contains? (-> r output) (joined "ok workers/tests/workers.sub:9 counts\nok workers/tests/workers.sub:13 fresh\n"
                                             "ok workers/tests/workers.sub:28 waits\nok workers/tests/workers.sub:34 declared\n")))))

(test worker-failures #:grants ((toolchain))
  (let ([r (sub "tests" "test" "-R=failing" "./workers")])
    (expect-equal (-> r code) 1)
    (expect (contains? (-> r output) (joined "FAIL workers/tests/workers.sub:30 fails-later\n"
                                             "  workers/tests/workers.sub:21: (expect-equal count 2)\n    got      0\n")))
    (expect (contains? (-> r output)
                       "FAIL workers/tests/workers.sub:32 fails-now\n  workers/tests/workers.sub:32: (expect-equal count 2)\n"))
    (expect (contains? (-> r output)
                       "FAIL workers/tests/workers.sub:39 beyond\n  #:grants asks for all net, which substrate test was not given\n"))
    (expect (contains? (-> r output) "workers: 4 passed, 3 failed"))))

(test modules #:grants ((toolchain))
  (let ([r (sub "tests" "test" "-v" "./inline")])
    (expect-equal (-> r code) 0)
    (expect (contains? (-> r output) "ok inline/a.sub:4 same\nok inline/b.sub:4 same\nok inline/d.sub:3 apart\ninline: 3 passed"))))

(test one-file-packages #:grants ((toolchain))
  (let ([d (scratch-directory)] [cache (shared-cache)])
    (written! (joined-path d "p/package.sub") "(package p (version \"0.1.0\"))\n")
    (written! (joined-path d "p/a.sub") "(test a (expect #t))\n")
    (written! (joined-path d "p/own.sub")
              "(package own (version \"0.1.0\") (dependencies (q (path \"../q\"))))\n(require-unqualified q)\n")
    (written! (joined-path d "q/package.sub") "(package q (version \"0.1.0\"))\n")
    (written! (joined-path d "q/q.sub") "(provide one)\n(define (one) -> i32 1)\n")
    (let ([r (sub d "test" "-c" cache "./p")])
      (expect-equal (-> r code) 0)
      (expect (contains? (-> r output) "p: 1 passed")))
    (written! (joined-path d "p/broken.sub") "(package broken (version 1))\n")
    (expect-ran (sub d "test" "-c" cache "./p") #:fails "p/broken.sub:1:17: a version is a string")))

(test browsers #:grants ((toolchain))
  (let ([d (scratch-directory)] [cache (shared-cache)]
        [opens "(require-unqualified std/test/browser)\n(test opens (with-browser (b \"page\") (expect-text b (by-css \"p\") \"\")))\n"])
    (written! (joined-path d "declared/package.sub") "(package declared (version \"0.1.0\") (tests (browser)))\n")
    (written! (joined-path d "declared/tests/opens.sub") opens)
    (written! (joined-path d "undeclared/package.sub") "(package undeclared (version \"0.1.0\"))\n")
    (written! (joined-path d "undeclared/tests/opens.sub") opens)
    (let ([r (sub d "test" "-c" cache "--no-chromium" "./declared")])
      (expect-equal (-> r code) 0)
      (expect (contains? (-> r output) "declared: 0 passed, 1 need Chromium")))
    (let ([r (sub d "test" "-c" cache "./undeclared")])
      (expect-equal (-> r code) 1)
      (expect (contains? (-> r output) "a test that opens a browser needs (browser) in the tests clause of its package's package.sub")))
    (let ([r (sub d "test" "-c" cache "--chromium" "nowhere/chromium" "./declared")])
      (expect (!= (-> r code) 0))
      (expect (contains? (-> r output) "test: --chromium is nowhere/chromium, which is not a file")))))
