(require-unqualified build std/test/build)
(require-unqualified tests std/test/test)
(require-unqualified paths std/package/path)
(require-unqualified support "support/sub.sub")

(test all
  (expect-run "../sub/sub.sub" #:grants ("-A")
              #:args ((parent-of (test-option "--toolchain")) "test" "-c" (test-option "--cache") "./failing")
              #:fails "failing: 2 passed, 5 failed, 2 ignored"))

(test inline
  (expect-run "../sub/sub.sub" #:grants ("-A")
              #:args ((parent-of (test-option "--toolchain")) "test" "-c" (test-option "--cache") "-v" "./failing" "inline" "expects")
              #:fails "ok failing/failing.sub:5 inline\nFAIL failing/tests/failing.sub:5 expects"))

(test expect
  (expect-run "../sub/sub.sub" #:grants ("-A")
              #:args ((parent-of (test-option "--toolchain")) "test" "-c" (test-option "--cache") "./failing" "expects")
              #:fails "FAIL failing/tests/failing.sub:5 expects\n  failing/tests/failing.sub:5: (expect (> (f:half 4) 3))\nfailing: 0 passed, 1 failed"))

(test expect-equal
  (expect-run "../sub/sub.sub" #:grants ("-A")
              #:args ((parent-of (test-option "--toolchain")) "test" "-c" (test-option "--cache") "./failing" "equals")
              #:fails "FAIL failing/tests/failing.sub:7 equals\n  failing/tests/failing.sub:7: (expect-equal (f:half 9) 5)\n    got      4\n    expected 5"))

(test snapshot
  (expect-run "../sub/sub.sub" #:grants ("-A")
              #:args ((parent-of (test-option "--toolchain")) "test" "-c" (test-option "--cache") "./failing" "snapshot")
              #:fails "  --- expected\n  +++ got\n    one\n  - two\n    three"))

(test trap-then-next
  (expect-run "../sub/sub.sub" #:grants ("-A")
              #:args ((parent-of (test-option "--toolchain")) "test" "-c" (test-option "--cache") "./failing" "trap")
              #:fails "FAIL failing/tests/failing.sub:11 traps\n  trap: divide by zero\n      at %test-traps failing/tests/failing.sub:11:"))

(test after-trap
  (expect-run "../sub/sub.sub" #:grants ("-A")
              #:args ((parent-of (test-option "--toolchain")) "test" "-c" (test-option "--cache") "./failing" "trap")
              #:fails "failing: 1 passed, 1 failed"))

(test output
  (expect-run "../sub/sub.sub" #:grants ("-A")
              #:args ((parent-of (test-option "--toolchain")) "test" "-c" (test-option "--cache") "./failing" "prints")
              #:fails "  failing/tests/failing.sub:15: (expect #f)\n  output:\n    printed before failing"))

(test timeout
  (expect-run "../sub/sub.sub" #:grants ("-A")
              #:args ((parent-of (test-option "--toolchain")) "test" "-c" (test-option "--cache") "--timeout" "1s" "--ignored"
                      "./failing" "hangs")
              #:fails "FAIL failing/tests/failing.sub:19 hangs\n  the test was still running after 1s\nfailing: stopped after 1s"))

(test not-a-package
  (expect-run "../sub/sub.sub" #:grants ("-A")
              #:args ((parent-of (test-option "--toolchain")) "test" "-c" (test-option "--cache") "./nowhere")
              #:fails "substrate: ./nowhere is not a package's directory"))

(test modules
  (let ([r (sub "tests" "test" "-c" (test-option "--cache") "-v" "./inline")])
    (expect-equal (-> r code) 0)
    (expect (contains? (-> r output) "ok inline/a.sub:4 same\nok inline/b.sub:4 same\nok inline/d.sub:3 apart\ninline: 3 passed"))))

(test one-file-packages
  (let ([d (scratch-directory)] [cache (test-option "--cache")])
    (written! (joined-path d "p/package.sub") "(package p (version \"0.1.0\"))\n")
    (written! (joined-path d "p/a.sub") "(test a (expect #t))\n")
    (written! (joined-path d "p/own.sub")
              "(package own (version \"0.1.0\") (dependencies (q (path \"../q\"))))\n(require-unqualified q q)\n")
    (written! (joined-path d "q/package.sub") "(package q (version \"0.1.0\"))\n")
    (written! (joined-path d "q/q.sub") "(provide one)\n(define (one) -> i32 1)\n")
    (let ([r (sub d "test" "-c" cache "./p")])
      (expect-equal (-> r code) 0)
      (expect (contains? (-> r output) "p: 1 passed")))
    (written! (joined-path d "p/broken.sub") "(package broken (version 1))\n")
    (expect-ran (sub d "test" "-c" cache "./p") #:fails "p/broken.sub:1:17: a version is a string")))
