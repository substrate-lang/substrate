;; sub test on the package in failing/, whose tests fail on purpose: its reports and its exit status.
(require-unqualified build std/test/build)
(require-unqualified tests std/test/test)
(require-unqualified paths std/package/path)

(test all
  (expect-run "../sub/sub.sub" #:grants ("-A")
              #:args ((parent-of (test-option "--toolchain")) "test" "-c" (test-option "--cache") "failing")
              #:fails "failing: 2 passed, 5 failed, 1 ignored"))

(test inline
  (expect-run "../sub/sub.sub" #:grants ("-A")
              #:args ((parent-of (test-option "--toolchain")) "test" "-c" (test-option "--cache") "-v" "failing" "inline" "expects")
              #:fails "ok failing/failing.sub:6 inline\nFAIL failing/tests/failing.sub:5 expects"))

(test expect
  (expect-run "../sub/sub.sub" #:grants ("-A")
              #:args ((parent-of (test-option "--toolchain")) "test" "-c" (test-option "--cache") "failing" "expects")
              #:fails "FAIL failing/tests/failing.sub:5 expects\n  line 5: (expect (> (f:half 4) 3))\nfailing: 0 passed, 1 failed"))

(test expect-equal
  (expect-run "../sub/sub.sub" #:grants ("-A")
              #:args ((parent-of (test-option "--toolchain")) "test" "-c" (test-option "--cache") "failing" "equals")
              #:fails "FAIL failing/tests/failing.sub:7 equals\n  line 7: (expect-equal (f:half 9) 5)\n    got      4\n    expected 5"))

(test snapshot
  (expect-run "../sub/sub.sub" #:grants ("-A")
              #:args ((parent-of (test-option "--toolchain")) "test" "-c" (test-option "--cache") "failing" "snapshot")
              #:fails "  --- expected\n  +++ got\n    one\n  - two\n    three"))

(test trap-then-next
  (expect-run "../sub/sub.sub" #:grants ("-A")
              #:args ((parent-of (test-option "--toolchain")) "test" "-c" (test-option "--cache") "failing" "trap")
              #:fails "FAIL failing/tests/failing.sub:11 traps\n  trap: divide by zero\n      at %test-traps failing/tests/failing.sub:11:"))

(test after-trap
  (expect-run "../sub/sub.sub" #:grants ("-A")
              #:args ((parent-of (test-option "--toolchain")) "test" "-c" (test-option "--cache") "failing" "trap")
              #:fails "failing: 1 passed, 1 failed"))

(test output
  (expect-run "../sub/sub.sub" #:grants ("-A")
              #:args ((parent-of (test-option "--toolchain")) "test" "-c" (test-option "--cache") "failing" "prints")
              #:fails "  line 15: (expect #f)\n  output:\n    printed before failing"))
