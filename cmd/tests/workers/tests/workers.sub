;; Tests for cmd/tests/sub-test.sub, some failing on purpose.
(require-unqualified std/test/test)
(require-unqualified host/fs)
(require-unqualified host/modules/timer)
(require-unqualified host/modules/clock)

(define count u32 0)

(test counts
  (+= count 1)
  (expect-equal count 1))

(test fresh (expect-equal count 0))

(struct ticker [head event-head] [fails bool])

(define tick ticker)

(define (ticked [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (printf "ticked at ~a~n" (cast i32 (clock-monotonic)))
  (when (-> (cast (ptr ticker) tag) fails) (expect-equal count 2)))

(define (ticks [fails bool])
  (set! (-> tick head handle) ticked)
  (set! (-> tick fails) fails)
  (timer-after 5.0 (cast (ptr void) (& tick))))

(test waits #:grants ((fake timer clock)) #:output "ticked at 5" (ticks #f))

(test fails-later #:grants ((fake timer clock)) (ticks #t))

(test fails-now (expect-equal count 2))

(test declared #:grants ((read "../failing"))
  (let ([bytes (slice u8)] [why string])
    (expect-equal (fs-read-file "../failing/package.sub" (& bytes) (& why)) 0)
    (expect-equal (fs-read-file "../inline/package.sub" (& bytes) (& why)) -1)))

(test beyond #:grants ((all net)) (expect #t))
