;; sub hash: the files a package's hash covers, in a directory and in a git repository.
(require-unqualified tests std/test/test)
(require-unqualified paths std/package/path)
(require-unqualified support "support/sub.sub")

;; A package's hash covers every file in its directory except those in build/.
(test directory
  (let ([d (scratch-directory)] [before string] [tested string])
    (copied! "tests/packages/walked" (joined-path d "walked"))
    (set! before (printed (sub d "hash" "walked")))
    (expect (starts? before "sha256:"))
    (written! (joined-path d "walked/tests/use.sub") "(require w walked)\n(define (main) (printf \"~a~n\" (w:w)))\n")
    (set! tested (printed (sub d "hash" "walked")))
    (expect (!= tested before))
    (expect-ran (sub (joined-path d "walked") "run" "-c" (test-option "--cache") "tests/use.sub") #:output "3")
    (expect-equal (printed (sub d "hash" "walked")) tested)
    (written! (joined-path d "walked/README") "notes\n")
    (expect (!= (printed (sub d "hash" "walked")) tested))))

;; In a git repository, a package's hash covers only the files git tracks. The test uses index versions 2 to 4, SHA-1
;; and SHA-256 repositories, and a worktree.
(test git
  (let ([d (scratch-directory)] [committed string] [intended string])
    (committed! (joined-path d "one") "--object-format=sha1")
    (committed! (joined-path d "two") "--object-format=sha256")
    (set! committed (printed (sub d "hash" "one/p")))
    (expect (starts? committed "sha256:"))
    (written! (joined-path d "one/p/README") "notes\n")
    (expect-equal (printed (sub d "hash" "one/p")) committed)
    (expect-ran (git (joined-path d "one") "add" "-N" "p/README"))
    (set! intended (printed (sub d "hash" "one/p")))
    (expect (!= intended committed))
    (expect-ran (git (joined-path d "one") "update-index" "--index-version" "4"))
    (expect-equal (printed (sub d "hash" "one/p")) intended)
    (expect-ran (git (joined-path d "one") "worktree" "add" "--detach" (joined-path d "tree")))
    (expect-equal (printed (sub d "hash" "tree/p")) committed)
    (expect-equal (printed (sub d "hash" "two/p")) committed)
    (copied! (joined-path d "one/p") (joined-path d "copy"))
    (expect-equal (printed (sub d "hash" "copy")) intended)))

;; committed! makes a git repository in repo with the package p in it, which holds a package of its own and a build
;; directory, and commits p.
(define (committed! [repo string] [format string])
  (written! (joined-path repo "p/package.sub") "(package p (version \"0.1.0\"))\n")
  (written! (joined-path repo "p/inner/package.sub") "(package inner (version \"0.1.0\"))\n")
  (written! (joined-path repo "p/p.sub") "(provide v)\n(define (v) -> i32 2)\n")
  (written! (joined-path repo "p/build/out") "built\n")
  (expect-ran (git repo "init" format))
  (expect-ran (git repo "add" "p"))
  (expect-ran (git repo "commit" "-m" "p")))

(begin-for-syntax
  (require-unqualified macros compiler/macros)

  ;; (git dir arg ...) runs git with args in dir, as a user named t.
  (define (git-form [s datum]) -> datum
    (syntax-match s
      [(_ dir arg ...)
       #`(program #,dir "git" "-c" "user.name=t" "-c" "user.email=t@t" "-c" "init.defaultBranch=main" #,@arg)])))

(define-syntax git git-form)
