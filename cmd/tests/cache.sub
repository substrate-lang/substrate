(require-unqualified host/fs)
(require-unqualified std/test/test)
(require-unqualified std/package/path)
(require-unqualified "support/sub.sub")

(test stale-entry #:grants ((run "../substrate/host/subhost.mjs"))
  (let* ([d (scratch-directory)] [cache (shared-cache)] [out (joined-path d "a-built")])
    (written! (joined-path d "b.sub") "(provide x)\n(define (x) -> i32 1)\n")
    (written! (joined-path d "a.sub") "(require b \"b.sub\" x)\n(define (main) (printf \"~a~n\" (x)))\n")
    (expect-ran (built-run d "a.sub" out cache) #:output "1")
    (removed! (joined-path d "b.sub"))
    (written! (joined-path d "a.sub") "(define (main) (printf \"~a~n\" 2))\n")
    (expect-ran (built-run d "a.sub" out cache) #:output "2")))

(test cut-entries #:grants ((run "../substrate/host/subhost.mjs"))
  (let* ([d (scratch-directory)] [cache (joined-path d "cache")] [out (joined-path d "c-built")] [names (slice string)])
    (written! (joined-path d "c.sub") "(define (main) (printf \"~a~n\" 3))\n")
    (expect-ran (built-run d "c.sub" out cache) #:output "3")
    (fs-list cache (& names) 0)
    (for ([i u32 0]) (< i (-> names length)) (+= i 1)
      (when (ends? (@ names i) ".subc") (truncated! (joined-path cache (@ names i)) 100)))
    (expect-ran (built-run d "c.sub" out cache) #:output "3")))

(test edit #:grants ((run "../substrate/host/subhost.mjs"))
  (let* ([d (scratch-directory)] [cache (joined-path d "cache")] [out (joined-path d "built")] [before u32 0]
         [marker (joined-path d "marker")])
    (written! (joined-path d "b.sub") "(provide b)\n(define (b) -> i32 1)\n")
    (written! (joined-path d "a.sub") "(require b \"b.sub\")\n(provide a)\n(define (a) -> i32 (b:b))\n")
    (written! (joined-path d "c.sub") "(provide c)\n(define (c) -> i32 3)\n")
    (written! (joined-path d "main.sub")
              "(require a \"a.sub\")\n(require c \"c.sub\")\n(define (main) (printf \"~a~n\" (+ (a:a) (c:c))))\n")
    (expect-ran (built-run d "main.sub" out cache) #:output "4")
    (set! before (entries cache ".subc"))
    (written! marker "")
    (written! (joined-path d "b.sub") "(provide b)\n(define (b) -> i32 2)\n")
    (expect-ran (built-run d "main.sub" out cache) #:output "5")
    (expect-equal (entries-since cache ".subc" (modified-at marker)) 3)
    (expect-equal (entries cache ".subc") before)))

(test included-file #:grants ((run "../substrate/host/subhost.mjs"))
  (let* ([d (scratch-directory)] [cache (joined-path d "cache")] [out (joined-path d "built")])
    (written! (joined-path d "text.txt") "1")
    (written! (joined-path d "a.sub") "(provide a)\n(define (a) -> string (include-text \"text.txt\"))\n")
    (written! (joined-path d "main.sub") "(require a \"a.sub\")\n(define (main) (printf \"~a~n\" (a:a)))\n")
    (expect-ran (built-run d "main.sub" out cache) #:output "1")
    (written! (joined-path d "text.txt") "2")
    (expect-ran (built-run d "main.sub" out cache) #:output "2")))

(test repointed-name #:grants ((run "../substrate/host/subhost.mjs"))
  (let* ([d (scratch-directory)] [cache (joined-path d "cache")] [out (joined-path d "built")] [app (joined-path d "app")])
    (written! (joined-path d "first/package.sub") "(package first (version \"1.0.0\") (exports stats))\n")
    (written! (joined-path d "first/stats.sub") "(provide answer)\n(define (answer) -> i32 1)\n")
    (written! (joined-path d "second/package.sub") "(package second (version \"1.0.0\") (exports stats))\n")
    (written! (joined-path d "second/stats.sub") "(provide answer)\n(define (answer) -> i32 2)\n")
    (written! (joined-path app "main.sub") "(require s dep/stats)\n(define (main) (printf \"~a~n\" (s:answer)))\n")
    (written! (joined-path app "package.sub")
              "(package app (version \"1.0.0\") (dependencies (dep (path \"../first\")) (kept (path \"../first\"))))\n")
    (expect-ran (built-run app "main.sub" out cache) #:output "1")
    (written! (joined-path app "package.sub")
              "(package app (version \"1.0.0\") (dependencies (dep (path \"../second\")) (kept (path \"../first\"))))\n")
    (expect-ran (built-run app "main.sub" out cache) #:output "2")
    (written! (joined-path app "package.sub") "(package app (version \"1.0.0\") (dependencies (dep (path \"../first\"))))\n")
    (expect-ran (built-run app "main.sub" out cache) #:output "1")))

(test require-order #:grants ((run "../substrate/host/subhost.mjs"))
  (let* ([d (scratch-directory)] [dir (joined-path (root) "packages/scheme/tests")] [cache (shared-cache)])
    (expect-ran (sub dir "build" "order-a.sub" "-o" (joined-path d "a") "-c" cache))
    (expect-ran (sub dir "build" "order-b.sub" "-o" (joined-path d "b") "-c" cache))
    (expect-equal (compared-modules (joined-path d "a") (joined-path d "b")) 2)))

(define (compared-modules [a string] [b string]) -> u32
  (let ([names (slice string)] [n u32 0])
    (fs-list a (& names) 0)
    (for ([i u32 0]) (< i (-> names length)) (+= i 1)
      (let ([name (@ names i)])
        (when (and (or (starts? name "order-m.") (starts? name "order-n.")) (ends? name ".wasm"))
          (+= n 1)
          (unless (== (text-in (joined-path a name)) (text-in (joined-path b name)))
            (throw test-failed (joined name " differs from order-a's"))))))
    n))

(define (changed-run [dir string]) -> ran
  (let* ([out (joined-path dir "out")]
         [b (host dir #:grants ((all read write)) (joined-path (root) "build/compiler") (joined-path dir "substrate")
                  "build" "tests/forms.sub" "-o" out "-d" dir)])
    (when (!= (-> b code) 0) (return b))
    (let ([r (host dir out)])
      (set! (-> r output) (joined (-> b output) (-> r output)))
      r)))

(test changed-sources #:grants ((read "../tests/substrate/programs") (run "../substrate/host/subhost.mjs"))
  (let* ([d (scratch-directory)] [compiler (joined-path d "substrate/compiler")])
    (copied! (joined-path (root) "substrate/compiler") compiler)
    (copied! (joined-path (root) "substrate/host/fs.sub") (joined-path d "substrate/host/fs.sub"))
    (copied! "../tests/substrate/programs/forms.sub" (joined-path d "tests/forms.sub"))
    (written! (joined-path compiler "substrate.sub") (joined (text-in (joined-path compiler "substrate.sub")) ";; changed\n"))
    (edited! (joined-path compiler "syntax.sub") "(provide datum srcloc scope-set\n" "(provide datum srcloc scope-set added\n")
    (edited! (joined-path compiler "syntax.sub") "(struct srcloc [" "(struct added [a i32])\n(struct srcloc [")
    (expect-ran (changed-run d) #:output (text-in "../tests/substrate/programs/forms.out"))
    (edited! (joined-path compiler "syntax.sub") "(struct srcloc [" "(struct srcloc [unused i32] [")
    (expect-ran (changed-run d) #:fails "whose srcloc differs")))
