;; Tests of the site command: a package's site, a program's site, and what the command refuses.
(require-unqualified host/fs)
(require-unqualified std/test/test)
(require-unqualified std/package/path)
(require-unqualified "support/sub.sub")

(define manifest string "(package shop
  (version \"1.0.0\")
  (sites (shop \"app/shop.sub\" (html \"app/index.html\")
               (files \"/data\" (from \"content\") \"*.txt\" \"notes/**/*.md\"))
         (lost \"app/shop.sub\" (files \"/data\" \"content/*.png\"))))
")

(define (shop!) -> string
  (let ([d (scratch-directory)])
    (written! (joined-path d "package.sub") manifest)
    (written! (joined-path d "app/shop.sub") "(define (main) (printf \"open~n\"))\n")
    (written! (joined-path d "app/index.html") "<!doctype html>\n<div id=\"root\"></div>\n")
    (written! (joined-path d "app/assets/logo.txt") "logo\n")
    (written! (joined-path d "content/one.txt") "1\n")
    (written! (joined-path d "content/two.txt") "2\n")
    (written! (joined-path d "content/notes/a/b.md") "b\n")
    (written! (joined-path d "content/skipped.dat") "\n")
    d))

(define (listing [dir string]) -> string
  (let ([all (files-in dir)] [b (make-buffer)])
    (for ([i u32 0]) (< i (-> all length)) (+= i 1)
      (unless (or (starts? (@ all i) "host/") (starts? (@ all i) "program/"))
        (when (> (-> b length) 0) (buffer-add-byte! (& b) 32))
        (buffer-add-string! (& b) (@ all i))))
    (buffer-string (& b))))

;; The paths in a pack. Each file in a pack is its path's length, its path, its size and its bytes.
(define (packed [path string]) -> string
  (let ([s (text-in path)] [b (make-buffer)] [at u32 0])
    (while (< at (-> s length))
      (let ([n (u32-at s at)])
        (when (> (-> b length) 0) (buffer-add-byte! (& b) 32))
        (buffer-add-string! (& b) (slice s (+ at 4) (+ at 4 n)))
        (+= at (+ 4 n))
        (+= at (+ 4 (u32-at s at)))))
    (buffer-string (& b))))

(define (u32-at [s string] [at u32]) -> u32
  (bit-or (bit-or (cast u32 (@ s at)) (<< (cast u32 (@ s (+ at 1))) 8))
          (bit-or (<< (cast u32 (@ s (+ at 2))) 16) (<< (cast u32 (@ s (+ at 3))) 24))))

(test site-named #:grants ((toolchain))
  (let* ([d (shop!)] [out (joined-path d "build/sites/shop")])
    (expect-ran (sub d "site" "shop"))
    (expect-equal (listing out) ".site assets/logo.txt assets.list files.pack index.html")
    (expect-equal (text-in (joined-path out "assets.list")) "assets/logo.txt\n")
    (expect-equal (packed (joined-path out "files.pack")) "/data/notes/a/b.md /data/one.txt /data/two.txt")
    (expect-equal (text-in (joined-path out "index.html")) "<!doctype html>\n<div id=\"root\"></div>\n")
    (expect (exists? (joined-path out "host/web/start.mjs")))
    (expect (exists? (joined-path out "program/program")))))

(test site-file #:grants ((toolchain))
  (let* ([d (scratch-directory)] [out (joined-path d "site")])
    (written! (joined-path d "hello.sub") "(define (main) (printf \"hello~n\"))\n")
    (expect-ran (sub d "site" "hello.sub" "-o" "site"))
    (expect-equal (listing out) ".site assets.list files.pack index.html")
    (expect-equal (text-in (joined-path out "assets.list")) "")
    (expect-equal (text-in (joined-path out "files.pack")) "")
    (expect (contains? (text-in (joined-path out "index.html")) "host/web/start.mjs"))))

(test site-refusals #:grants ((toolchain))
  (let ([d (shop!)])
    (expect-ran (sub d "site" "nope") #:fails "site: the package shop has no site nope")
    (expect-ran (sub d "site" "lost") #:fails "matches content/*.png")
    (expect-ran (sub d "site" "shop" "--release") #:fails "has no script that loads host/web/start.mjs")
    (written! (joined-path d "kept/notes.txt") "mine\n")
    (expect-ran (sub d "site" "shop" "-o" "kept") #:fails "kept is not a site, so it is not replaced")
    (expect-equal (text-in (joined-path d "kept/notes.txt")) "mine\n")))

(define (hash-name? [s string]) -> bool
  (unless (== (-> s length) 16) (return #f))
  (for ([i u32 0]) (< i 16) (+= i 1)
    (unless (or (and (>= (@ s i) #\0) (<= (@ s i) #\9)) (and (>= (@ s i) #\a) (<= (@ s i) #\f))) (return #f)))
  #t)

;; The directory a release keeps its program in: its one entry named by 16 hex digits.
(define (release-in [out string]) -> string
  (let ([names (slice string)] [found ""])
    (fs-list out (& names) 0)
    (for ([i u32 0]) (< i (-> names length)) (+= i 1) (when (hash-name? (@ names i)) (set! found (@ names i))))
    found))

(test site-release #:grants ((toolchain))
  (let* ([d (scratch-directory)] [out (joined-path d "site")])
    (written! (joined-path d "hello.sub") "(define (main) (printf \"hello~n\"))\n")
    (written! (joined-path d "assets/logo.txt") "logo\n")
    (expect-ran (sub d "site" "hello.sub" "-o" "site" "--release"))
    (let* ([name (release-in out)] [code (joined-path out name)] [html (text-in (joined-path out "index.html"))])
      (expect-equal (-> name length) 16)
      (expect (exists? (joined-path code "host/web/start.mjs")))
      (expect (exists? (joined-path code "host/web/start.mjs.gz")))
      (expect (exists? (joined-path code "program/program")))
      (expect (exists? (joined-path code "files.pack")))
      (expect (not (exists? (joined-path out "host"))))
      (expect (exists? (joined-path out "assets/logo.txt")))
      (expect (contains? html (joined "<script type=\"module\" src=\"" (joined name "/host/web/start.mjs\""))))
      (expect (contains? html (joined "<link rel=\"modulepreload\" href=\""
                                      (joined name "/host/web/subhost-web.mjs\">"))))
      (expect (contains? html (joined "<link rel=\"preload\" href=\""
                                      (joined name "/program/program\" as=\"fetch\" crossorigin>")))))
    (expect-ran (sub d "site" "hello.sub" "-o" "again" "--release"))
    (expect-equal (release-in (joined-path d "again")) (release-in out))))
