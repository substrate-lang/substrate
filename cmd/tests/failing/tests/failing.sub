;; Tests that fail on purpose, which cmd/tests/sub-test.sub runs with sub test.
(require-unqualified tests std/test/test)
(require f "../failing.sub")

(test expects (expect (> (f:half 4) 3)))

(test equals (expect-equal (f:half 9) 5))

(test snapshot (expect-output-file "snapshot.out" (printf "one~nthree~n")))

(test traps (let ([zero i32 0]) (printf "~a~n" (/ 1 zero))))

(test after-trap (expect-equal (f:half 8) 4))

(test prints (printf "printed before failing~n") (expect #f))

(test ignored #:ignore (expect #f))
