;; The sample package's main module: points, and the sizes of shapes.sub's shapes.
(require-unqualified shapes "shapes.sub")
(require-unqualified fs host/fs)

(provide point origin distance [size area] shape-count (all-from-out shapes) twice)

;; ---- points ----

;; A point on the plane.
(struct point [x f64] [y f64])

(define origin point)

;; distance gives how far apart two points are.
(define (distance [a (ptr point)] [b (ptr point)]) -> f64
  (sqrt (+ (squared (- (-> b x) (-> a x))) (squared (- (-> b y) (-> a y))))))

(define (squared [x f64]) -> f64 (* x x))

;; ---- sizes ----

(const shape-count i32 3)

;; area is a shape's width times its height.
(define (area [s (ptr shape)]) -> f64 (* (-> s width) (-> s height)))

(begin-for-syntax
  (require-unqualified macros compiler/macros)

  ;; doubled is twice's transformer.
  (define (doubled [stx datum]) -> datum #`(* 2 #,(cadr (syntax->list stx)))))

;; twice doubles what it is given.
(define-syntax twice doubled)
