;; Url dependencies: the packages in fetch/archives, made into archives by GNU tar and answered by the host's fake fetch.
;; Each test fetches into a store of its own.
(require-unqualified fs host/fs)
(require-unqualified tests std/test/test)
(require-unqualified paths std/package/path)
(require-unqualified support "support/sub.sub")

(define served string "")

;; fake-fetch gives the host's flag for its fake fetch, which answers from the archives. It makes them once: one for each
;; package in fetch/archives, one that is not an archive, and one with a file named outside it.
(define (fake-fetch) -> string
  (when (== (-> served length) 0)
    (let ([d (scratch-directory)] [names (slice string)])
      (fs-list "tests/fetch/archives" (& names) 0)
      (for ([i u32 0]) (< i (-> names length)) (+= i 1)
        (expect-ran (program "tests/fetch/archives" "tar" "--sort=name" "--format=pax" "-czf"
                             (joined-path d (joined (@ names i) ".tar.gz")) (@ names i))))
      (written! (joined-path d "junk.tar.gz") "this is not an archive\n")
      (expect-ran (program "tests/fetch/archives" "tar" "-P" "--sort=name" "--format=pax" "--transform"
                           "s,^json/json.sub,json/../../escaped.sub," "-czf" (joined-path d "hostile.tar.gz") "json"))
      (set! served d)))
  (joined "--fake=fetch:" served))

;; fetch-run builds the program fetch/name.sub, fetching into store, and runs it when it builds. It gives the build's exit
;; code and output when the build fails, and else the program's exit code and the output of both.
(define (fetch-run [name string] [store string]) -> ran
  (let* ([out (joined-path store "../program")]
         [b (sub "tests/fetch" #:host ((fake-fetch)) "build" (joined name ".sub") "-o" out "-P" store "-c" (test-option "--cache"))])
    (when (!= (-> b code) 0) (return b))
    (let ([r (host "tests/fetch" out)])
      (set! (-> r output) (joined (-> b output) (-> r output)))
      r)))

;; expect-fetched checks fetch-run of name as fetch/name.out or fetch/name.err says, and gives the store.
(define (expect-fetched [name string]) -> string
  (let* ([store (joined-path (scratch-directory) "build/store")] [r (fetch-run name store)])
    (ran-check-files! (& r) (joined-path "tests/fetch" name))
    store))

;; entry-with gives the entry in store that holds a file named name.
(define (entry-with [store string] [name string]) -> string
  (let ([files (files-in store)])
    (for ([i u32 0]) (< i (-> files length)) (+= i 1)
      (when (== (base-of (@ files i)) name) (return (joined-path store (parent-of (@ files i))))))
    ""))

;; A store entry holds the files its hash covers, and a package's archive and its git checkout have the same hash. A
;; package already in the store is not fetched again.
(test app
  (let ([store (expect-fetched "app")])
    (expect-equal (listed (files-in (entry-with store "json.sub"))) "README json.sub package.sub unused.sub ")
    (expect (contains? (text-in "tests/fetch/app.sub") (printed (sub "tests/fetch" "hash" "archives/json"))))
    (expect-ran (fetch-run "app" store) #:output "42")))

(test chain (expect-fetched "chain"))

(test nested
  (let ([store (expect-fetched "nested")])
    (expect-equal (listed (files-in (entry-with store "nest.sub"))) "inner/inner.sub inner/package.sub nest.sub package.sub ")))

;; Unpacking writes no file outside the store.
(test err-hostile
  (let ([store (expect-fetched "err-hostile")])
    (expect (not (exists? (joined-path store "../escaped.sub"))))
    (expect (not (exists? (joined-path store "../../escaped.sub"))))))

(test err-junk (expect-fetched "err-junk"))
(test err-leaves (expect-fetched "err-leaves"))
(test err-missing (expect-fetched "err-missing"))
(test err-pin (expect-fetched "err-pin"))
(test err-two (expect-fetched "err-two"))

;; sub fetch URL prints the dependency that pins a package, then fetches the packages it needs.
(test fetch-url
  (let ([store (joined-path (scratch-directory) "store")] [expected (text-in "tests/fetch/fetch-url.out")])
    (expect-ran (sub "tests/fetch" #:host ((fake-fetch)) "fetch" "http://fake/outer.tar.gz" "-P" store "-c" (test-option "--cache"))
                #:output expected)
    (expect (exists? (joined-path store (slice (hash-in expected) 7))))))

;; sub doc fetches what a package it documents depends on, as build does.
(test doc
  (let ([d (scratch-directory)])
    (expect-ran (sub "tests/fetch" #:host ((fake-fetch)) "doc" "-o" (joined-path d "doc") "archives/outer" "-P"
                     (joined-path d "store") "-c" (test-option "--cache"))
                #:output "sub: fetching http://fake/json.tar.gz")
    (expect (contains? (text-in (joined-path d "doc/outer/outer.txt")) "\n;; requires json/json\n"))))
