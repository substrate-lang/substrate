;; Tests of whole programs, for what only a whole program shows: exit codes, command-line arguments, stdin, signals,
;; the program's heap and memory, code that runs while modules start or compile, and the host's own reports.
(require-unqualified std/test/test)
(require-unqualified std/package/path)
(require-unqualified "support/sub.sub")

;; ---- std ----

(test http-shutdown-signal #:grants ((toolchain) (read "../tests/programs")) #:unix
  (expect-ran (sub "../tests/programs" "run" "-N=127.0.0.1" "--allow-run=kill" "shutdown-signal")
              #:output-file "../tests/programs/shutdown-signal.out"))

;; ---- substrate-tests ----

(test err-start-trap #:grants ((toolchain))
  (expect-ran (sub "../tests/programs" "run" "err-start-trap")
              #:fails "err-start-trap.sub:2:26"))

(test malloc #:grants ((toolchain) (read "../tests/programs"))
  (expect-ran (sub "../tests/programs" "run" "malloc")
              #:output-file "../tests/programs/malloc.out"))

(test memory-own #:grants ((toolchain) (read "../tests/programs"))
  (expect-ran (sub "../tests/programs" "run" "memory-own")
