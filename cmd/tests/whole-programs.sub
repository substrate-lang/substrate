(test err-net-grant #:grants ((toolchain))
  (expect-ran (sub "../tests/events" "run" "--deny-net=fe80:::1" "err-net-grant")
              #:fails "fe80:::1 is not a host or host:port"))

(test env-none #:grants ((toolchain) (read "../tests/events"))
  (expect-ran (sub "../tests/events" "run" "env-none") #:output-file "../tests/events/env-none.out"))

(test signal #:grants ((toolchain) (read "../tests/events")) #:unix
  (expect-ran (sub "../tests/events" "run" "--allow-run=kill" "signal")
