;; Programs built and run whole, for what only a whole program shows: exit codes, command-line arguments, stdin,
;; signals, its heap and memory, code that runs as modules start or compile, and the host's own reports.
(require-unqualified tests std/test/test)
(require-unqualified paths std/package/path)
(require-unqualified support "support/sub.sub")

;; ---- std ----

(test http-shutdown-signal #:grants ((run "../substrate/host/subhost.mjs")) #:unix
  (expect-ran (sub "../std/tests/http/programs" "run" "-c" (test-option "--cache") "-N=127.0.0.1" "--allow-run=kill"
                   "shutdown-signal.sub")
              #:output-file "../std/tests/http/programs/shutdown-signal.out"))

;; ---- scheme ----

(define (scheme-programs) -> string "../packages/scheme/tests/programs")

(test scheme-exit #:grants ((run "../substrate/host/subhost.mjs"))
  (expect-ran (sub (scheme-programs) "run" "-c" (test-option "--cache") "err-scheme-exit.sub") #:fails "leaving"))

(test scheme-files #:grants ((run "../substrate/host/subhost.mjs") (read "../packages/scheme/tests/programs"))
  (let ([d (scratch-directory)])
    (expect-ran (sub (scheme-programs) "run" "-c" (test-option "--cache") (joined "-R=" d) (joined "-W=" d)
                     "scheme-files.sub" (joined-path d "scheme-files.txt") "second")
                #:output-file (joined-path (scheme-programs) "scheme-files.out"))))

