;; Tests of whole programs, for what only a whole program shows: exit codes, command-line arguments, stdin, signals,
;; the program's heap and memory, code that runs while modules start or compile, and the host's own reports.
(require-unqualified std/test/test)
(require-unqualified std/package/path)
(require-unqualified "support/sub.sub")

;; ---- std ----

(test http-shutdown-signal #:grants ((toolchain)) #:unix
  (expect-ran (sub "../std/tests/http/programs" "run" "-N=127.0.0.1" "--allow-run=kill"
                   "shutdown-signal.sub")
              #:output-file "../std/tests/http/programs/shutdown-signal.out"))

;; ---- substrate-tests ----

(test err-start-trap #:grants ((toolchain))
  (expect-ran (sub "../tests/programs" "run" "err-start-trap.sub")
              #:fails "err-start-trap.sub:2:26"))

(test malloc #:grants ((toolchain) (read "../tests/programs"))
  (expect-ran (sub "../tests/programs" "run" "malloc.sub")
