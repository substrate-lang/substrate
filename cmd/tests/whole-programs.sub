(test worker-modules #:grants ((toolchain) (read "../tests/events"))
  (expect-ran (sub "../tests/events" "run" "-N" "--fake=fetch:files" "worker-modules")
              #:output-file "../tests/events/worker-modules.out"))

(define (compile-time) -> string "../tests/compile-time")

(test copied #:grants ((toolchain))
  (let ([d (scratch-directory)])
    (expect-ran (sub (compile-time) "build" "copied" "-c" d) #:output "12")
    (expect-ran (sub (compile-time) "run" "-c" d "copied") #:output "42 10 15 6 1 2 ")))

(test inline #:grants ((toolchain))
  (let ([d (scratch-directory)])
    (expect-ran (sub (compile-time) "build" "inline" "-c" d) #:output "42")
    (expect-ran (sub (compile-time) "run" "-c" d "inline") #:output "12\n10\n3\n302\n11")))

(test memory-phase1 #:grants ((toolchain))
  (expect-ran (sub (compile-time) "build" "memory-phase1" "-c" (scratch-directory)) #:output "ho"))

(test modules #:grants ((toolchain))
  (let ([d (scratch-directory)])
    (expect-ran (sub (compile-time) "build" "modules" "-c" d) #:output "5")
    (expect-ran (sub (compile-time) "run" "-c" d "modules") #:output "49\n1:25\n25\n3")))

(test phases #:grants ((toolchain))
  (let ([d (scratch-directory)])
    (expect-ran (sub (compile-time) "build" "phases" "-c" d) #:output "2")
    (expect-ran (sub (compile-time) "run" "-c" d "phases") #:output "2")))

(test shift-literals #:grants ((toolchain))
  (expect-ran (sub (compile-time) "build" "shift-literals" "-c" (scratch-directory)) #:output "42\n42"))

(test templates #:grants ((toolchain))
  (let ([d (scratch-directory)])
    (expect-ran (sub (compile-time) "build" "templates" "-c" d))
    (expect-ran (sub (compile-time) "run" "-c" d "templates") #:output "42 82 20")))

(test err-template-unbound #:grants ((toolchain))
  (expect-ran (sub (compile-time) "build" "err-template-unbound" "-c" (scratch-directory))
              #:fails "templates.sub:11:44: error: unbound identifier tripled; a template's names need a require of (for-template source) in the template's module"))

(test err-compile-time-trap #:grants ((toolchain))
  (expect-ran (sub (compile-time) "build" "err-compile-time-trap" "-c" (scratch-directory))
              #:fails "err-compile-time-trap.sub:4:18: error: trap: expected a pair"))

(test err-macro-trap #:grants ((toolchain))
  (expect-ran (sub (compile-time) "build" "err-macro-trap" "-c" (scratch-directory))
              #:fails "err-macro-trap.sub:6:16: error: trap: expected a pair"))
