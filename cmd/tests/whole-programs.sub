(define (compile-time) -> string "../tests/compile-time")

(test copied #:grants ((run "../substrate/host/subhost.mjs"))
  (let ([d (scratch-directory)])
    (expect-ran (sub (compile-time) "build" "copied.sub" "-c" d) #:output "12")
    (expect-ran (sub (compile-time) "run" "-c" d "copied.sub") #:output "42 10 15 6 1 2 ")))

(test inline #:grants ((run "../substrate/host/subhost.mjs"))
  (let ([d (scratch-directory)])
    (expect-ran (sub (compile-time) "build" "inline.sub" "-c" d) #:output "42")
    (expect-ran (sub (compile-time) "run" "-c" d "inline.sub") #:output "12\n10\n3\n302\n11")))

(test memory-phase1 #:grants ((run "../substrate/host/subhost.mjs"))
  (expect-ran (sub (compile-time) "build" "memory-phase1.sub" "-c" (scratch-directory)) #:output "ho"))

(test modules #:grants ((run "../substrate/host/subhost.mjs"))
  (let ([d (scratch-directory)])
    (expect-ran (sub (compile-time) "build" "modules.sub" "-c" d) #:output "5")
    (expect-ran (sub (compile-time) "run" "-c" d "modules.sub") #:output "49\n1:25\n25\n3")))

(test phases #:grants ((run "../substrate/host/subhost.mjs"))
  (let ([d (scratch-directory)])
    (expect-ran (sub (compile-time) "build" "phases.sub" "-c" d) #:output "2")
    (expect-ran (sub (compile-time) "run" "-c" d "phases.sub") #:output "2")))

(test shift-literals #:grants ((run "../substrate/host/subhost.mjs"))
  (expect-ran (sub (compile-time) "build" "shift-literals.sub" "-c" (scratch-directory)) #:output "42\n42"))

(test err-compile-time-trap #:grants ((run "../substrate/host/subhost.mjs"))
  (expect-ran (sub (compile-time) "build" "err-compile-time-trap.sub" "-c" (scratch-directory))
              #:fails "err-compile-time-trap.sub:4:18: error: trap: expected a pair"))

(test err-macro-trap #:grants ((run "../substrate/host/subhost.mjs"))
