(package with-sites
  (version "1.0.0")
  (sites (app "app.sub" (base "/") (mount "/tool/" tool))
         (tool "tool/main.sub" (html "tool/index.html")
               (files "/src" (from "..") "lib/*.sub" "docs/**/*.md") (files "/data" "data.txt")
               (files "/deps" (from dep) "*.sub"))))
