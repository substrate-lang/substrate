;; A C side module required as a module: its data and relocations, calls both ways, a function it calls by name, its
;; constructor, its stack, and null when memory runs out.
(require cside "../cside.wasm")
(require-unqualified "../cside.sub")

(define (plus-ten [x i32]) -> i32 (+ x 10))

(define (main)
  (printf "add ~a\n" (cside:add 1 2))
  (printf "counter ~a\n" (@ (cast (ptr i32) (cside:counter_address)) 0))
  (let ([f (cast (fn (i32 i32) -> i32) (cside:pick))]) (printf "picked ~a\n" (f 2 3)))
  (let ([p (cside:copy)])
    (printf "copy ~a\n" (c-string p))
    (free (cast (ptr void) p)))
  (printf "message ~a ~a\n" (c-string (cside:message 0)) (c-string (cside:message 1)))
  (printf "callback ~a\n" (cside:call_back (cast i32 plus-ten) 5))
  (printf "by name ~a\n" (cside:by_name 3))
  (printf "constructed ~a\n" (cside:constructed_value))
  (printf "stack ~a\n" (cside:stack_sum 2))
  (printf "zeros ~a\n" (cside:zero_sum))
  (printf "null when too big ~a\n" (cside:null_when_too_big)))
