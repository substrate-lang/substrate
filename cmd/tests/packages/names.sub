(package names
  (version "0.1.0")
  (dependencies (tools (path "tools")) (app (path "app"))))
;; Requires by name, under this program's own manifest. It names modules of the toolchain and of std, a library of std
;; by its directory's name, and two packages it depends on, one of which uses the other. A module reached by name here
;; and by path inside its package is one module.
(require-unqualified tools)
(require text tools/text)
(require app app)
(require h std/http)
(require url std/http/url)
(require fs host/fs)
(require leb compiler/leb128)

(define (main)
  (printf "tools ~a, doubled ~a\n" (tools-version) (doubled 21))
  (text:bump!)
  (printf "bumps here ~a, through app ~a, through tools' own path ~a\n" (text:bumps) (app:app-bumps) (tools-bumps))
  (printf "http ~a, url ~a, fs ~a, leb ~a\n" (h:http-same? "Host" "host") (url:url-path "/a/b?c") fs:fs-directory
          (leb:uleb-length 300))
  (printf "app ~a\n" (app:app-twice 5)))
