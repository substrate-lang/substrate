;; Tests of the package library: manifests and their sites, packages' files and hashes, and module maps.
(require-unqualified std/package/manifest)
(require-unqualified std/package/files)
(require-unqualified std/package/hash)
(require-unqualified std/package/map)
(require-unqualified std/package/path)
(require-unqualified host/fs)

(define a arena)
(define cwd string)

(define (local [text string]) -> string
  (let ([b (make-buffer)] [i u32 0] [n (-> cwd length)])
    (while (< i (-> text length))
      (if (and (<= (+ i n) (-> text length)) (== (slice text i (+ i n)) cwd))
          (begin (buffer-add-byte! (& b) #\.) (+= i n))
          (begin (buffer-add-byte! (& b) (cast i32 (@ text i))) (+= i 1))))
    (buffer-string (& b))))

(define (read-manifest [file string])
  (let ([m manifest] [err (make-buffer)])
    (if (manifest-read (& a) file (& m) (& err))
        (printf "~a: ~a ~a, major ~a, ~a dependencies\n" file (-> m name) (-> m version) (-> m major)
                (-> m dependencies length))
        (printf "~a\n" (buffer-string (& err))))
    (buffer-free! (& err))))

(define (read-tests [file string])
  (let ([m manifest] [err (make-buffer)])
    (if (manifest-read (& a) file (& m) (& err))
        (begin
          (printf "~a: tests" file)
          (for ([i u32 0]) (< i (-> m tests length)) (+= i 1) (printf " ~a" (@ (-> m tests) i)))
          (when (-> m test-browser) (printf ", browser"))
          (printf "\n"))
        (printf "~a\n" (buffer-string (& err))))
    (buffer-free! (& err))))

(define (read-sites [file string])
  (let ([m manifest] [err (make-buffer)])
    (if (manifest-read (& a) file (& m) (& err))
        (for ([i u32 0]) (< i (-> m sites length)) (+= i 1)
          (let ([s (& (@ (-> m sites) i))])
            (printf "~a: site ~a, ~a" file (-> s name) (-> s program))
            (when (> (-> s html length) 0) (printf ", html ~a" (-> s html)))
            (for ([k u32 0]) (< k (-> s files length)) (+= k 1)
              (let ([g (& (@ (-> s files) k))])
                (printf ", files ~a" (-> g dir))
                (when (> (-> g from length) 0) (printf " from ~a" (-> g from)))
                (when (> (-> g root length) 0) (printf " from root ~a" (-> g root)))
                (for ([j u32 0]) (< j (-> g patterns length)) (+= j 1) (printf " ~a" (@ (-> g patterns) j)))))
            (printf "\n")))
        (printf "~a\n" (buffer-string (& err))))
    (buffer-free! (& err))))

(define (program-manifest [file string])
  (let* ([m manifest] [err (make-buffer)] [found #f] [ok (manifest-of-program (& a) file (& m) (& found) (& err))])
    (printf "~a: ~a\n" file (cond [(not ok) (buffer-string (& err))] [found (-> m name)] [else "no manifest"]))
    (buffer-free! (& err))))

(define (compatible [a string] [b string]) (printf "~a for ~s: ~a\n" a b (version-compatible? a b)))

(define (holder [file string])
  (let ([m manifest] [dir (make-buffer)] [err (make-buffer)] [full (joined-path cwd file)] [found i32 0])
    (manifest-find (& a) full (& m) (& dir) (& found) (& err))
    (printf "~a is in ~a, at ~a\n" file (-> m name) (local (buffer-string (& dir))))
    (buffer-free! (& dir))
    (buffer-free! (& err))))

(define (package-map-of [dir string])
  (let* ([m manifest] [out (make-buffer)] [roots (make-buffer)] [err (make-buffer)] [full (joined-path cwd dir)]
         [file (joined-path full "package.sub")])
    (if (and (manifest-read (& a) file (& m) (& err)) (package-map (& a) full "" (& m) "" "" #f (& out) (& roots) (& err)))
        (printf "~a" (local (buffer-string (& out))))
        (printf "~a\n" (local (buffer-string (& err)))))
    (buffer-free! (& out))
    (buffer-free! (& roots))
    (buffer-free! (& err))))

(define (files-of [dir string])
  (let ([m manifest] [fs (make-buffer)] [es (make-buffer)] [err (make-buffer)] [file (joined-path dir "package.sub")])
    (if (and (manifest-read (& a) file (& m) (& err)) (package-exports (& a) dir (& m) (& es) (& err))
             (package-files (& a) dir (& fs) (& err)))
        (printf "~a's files: ~a; its exports: ~a\n" dir (in-order (& fs)) (in-order (& es)))
        (printf "~a\n" (buffer-string (& err))))
    (free (-> file bytes))
    (buffer-free! (& fs))
    (buffer-free! (& es))
    (buffer-free! (& err))))

(define (in-order [b (ptr buffer)]) -> string
  (let ([ps (cast (ptr string) (-> b bytes))] [n (/ (-> b length) (sizeof string))] [out (make-buffer)])
    (for ([i u32 1]) (< i n) (+= i 1)
      (let ([s (@ ps i)] [j i])
        (while (and (> j 0) (< s (@ ps (- j 1))))
          (set! (@ ps j) (@ ps (- j 1)))
          (-= j 1))
        (set! (@ ps j) s)))
    (for ([i u32 0]) (< i n) (+= i 1)
      (when (> i 0) (buffer-add-string! (& out) " "))
      (buffer-add-string! (& out) (@ ps i)))
    (buffer-string (& out))))

(define (hash-of [dir string])
  (let ([h (make-buffer)] [err (make-buffer)])
    (printf "~a's hash: ~a\n" dir (if (package-hash dir (& h) (& err)) (buffer-string (& h)) (local (buffer-string (& err)))))
    (buffer-free! (& h))
    (buffer-free! (& err))))

(define (main)
  (let ([h (make-buffer)] [err (make-buffer)])
    (set! a (make-arena))
    (fs-cwd (& cwd) 0)
    (set! cwd (normal-path (& a) cwd))
    (read-manifest "tools/package.sub")
    (read-manifest "manifests/bad-name.sub")
    (read-manifest "manifests/no-version.sub")
    (read-manifest "manifests/bad-version.sub")
    (read-manifest "manifests/bad-substrate.sub")
    (read-manifest "manifests/unknown-clause.sub")
    (read-manifest "manifests/bad-dependency.sub")
    (read-manifest "manifests/twice.sub")
    (read-manifest "manifests/two-forms.sub")
    (read-manifest "manifests/unclosed.sub")
    (read-manifest "manifests/missing.sub")
    (read-manifest "manifests/bad-export.sub")
    (read-manifest "manifests/export-twice.sub")
    (read-tests "manifests/tests.sub")
    (read-tests "manifests/bad-test.sub")
    (read-tests "manifests/browser-twice.sub")
    (read-sites "manifests/sites.sub")
    (read-sites "manifests/bad-site.sub")
    (read-sites "manifests/site-twice.sub")
    (read-sites "manifests/bad-site-files.sub")
    (program-manifest "names.sub")
    (program-manifest "err-name.sub")
    (holder "tools/tools.sub")
    (holder "maps/lib/lib.sub")
    (files-of "tools")
    (files-of "cside")
    (files-of "walked")
    (files-of "maps/no-export")
    (files-of "maps/unreadable")
    (files-of "maps/absent")
    (package-hash "maps/lib" (& h) (& err))
    (printf "maps/lib's hash: ~a\n" (buffer-string (& h)))
    (hash-of "maps/twin-a")
    (hash-of "maps/twin-b")
    (hash-of "maps/cycle-a")
    (hash-of "maps/absent")
    (package-map-of "maps/app")
    (package-map-of "maps/wrong-pin")
    (package-map-of "maps/dup")
    (package-map-of "maps/both-twins")
    (package-map-of "maps/two-copies")
    (package-map-of "maps/cycle-a")
    (compatible "0.10.2" "0.10.0")
    (compatible "0.10.0" "0.10.2")
    (compatible "0.11.0" "0.10.0")
    (compatible "0.9.9" "0.10.0")
    (compatible "1.4.0" "1.2.0")
    (compatible "2.0.0" "1.2.0")
    (compatible "1.0.0" "0.10.0")
    (compatible "0.10.0" "")))
