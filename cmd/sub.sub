;; sub, the command for programs. bin/sub builds it and runs it with every grant, the toolchain's directory first in its
;; arguments. A program in a package is built with the module map of its package and the packages its dependencies
;; reach, fetched into the store first when they come from urls, and every program with checked, which keeps the
;; modules of each package to its files; run and serve become the program they run, with the grants given.
(require-unqualified macros compiler/macros)
(require-unqualified ex compiler/expander)
(require-unqualified main compiler/main)
(require-unqualified fs host/fs)
(require-unqualified env host/node/env)
(require-unqualified process host/node/process)
(require-unqualified events host/events)
(require-unqualified stream host/stream)
(require-unqualified worker host/worker)
(require-unqualified fetch host/modules/fetch)
(require-unqualified manifest std/package/manifest)
(require-unqualified map std/package/map)
(require-unqualified hash std/package/hash)
(require-unqualified pack std/web/pack)
(require-unqualified tar std/archive/tar)
(require-unqualified gzip std/compress/gzip)

(define root string)
(define cwd string)
(define a arena)

(define (say [fd i32] [s string]) (host-write fd (cast (slice u8) s)))

(define (usage)
  (say 2 "usage: sub build FILE [-o DIR] [-s] | run [GRANT ...] FILE|DIR [ARG ...] | eval FILE | expand FILE\n")
  (say 2 "         | site OUT FILE [-p PAGE] [-f NAME PATH ...] | serve [-l ADDRESS] [-t CERT KEY] [-z LEVEL] [DIR]\n")
  (say 2 "         | pack -o OUT [-C DIR] PATH ... | hash [DIR] | map FILE | fetch URL|FILE\n")
  (say 2 "       -c DIR and -P DIR place the cache and the packages, else SUBSTRATE_CACHE and SUBSTRATE_PACKAGES do,\n")
  (say 2 "       else build/ in the program's package or directory\n")
  (host-exit 64))

(define (failed! [message string])
  (say 2 "sub: ")
  (say 2 message)
  (say 2 "\n")
  (host-exit 1))

(define (starts? [s string] [prefix string]) -> bool
  (and (>= (-> s length) (-> prefix length)) (== (slice s 0 (-> prefix length)) prefix)))

(define (ends? [s string] [suffix string]) -> bool
  (and (>= (-> s length) (-> suffix length)) (== (slice s (- (-> s length) (-> suffix length))) suffix)))

(define (absolute [p string]) -> string (normal-path (& a) (if (starts? p "/") p (joined-path cwd p))))

;; local gives text with the paths in it that are in the current directory written from there.
(define (local [text string]) -> string
  (let ([b (make-buffer)] [prefix (joined cwd "/")] [i u32 0])
    (while (< i (-> text length))
      (if (and (<= (+ i (-> prefix length)) (-> text length)) (== (slice text i (+ i (-> prefix length))) prefix))
          (+= i (-> prefix length))
          (begin
            (buffer-add-byte! (& b) (cast i32 (@ text i)))
            (+= i 1))))
    (buffer-string (& b))))

(define (parent-of [p string]) -> string
  (let ([i (-> p length)])
    (while (and (> i 1) (!= (@ p (- i 1)) #\/)) (-= i 1))
    (if (<= i 1) "/" (slice p 0 (- i 1)))))

(define (base-of [p string]) -> string
  (let ([i (-> p length)])
    (while (and (> i 0) (!= (@ p (- i 1)) #\/)) (-= i 1))
    (slice p i)))

(define (stem-of [p string]) -> string (let ([b (base-of p)]) (if (ends? b ".sub") (slice b 0 (- (-> b length) 4)) b)))

;; option gives the value after flag in args, or "", and without gives args without flag, and its value when valued is
;; set.
(define (option [args (slice string)] [flag string]) -> string
  (for ([i u32 0]) (< (+ i 1) (-> args length)) (+= i 1) (when (== (@ args i) flag) (return (@ args (+ i 1)))))
  "")

(define (without [args (slice string)] [flag string] [valued bool]) -> (slice string)
  (let ([out (cast (ptr string) (arena-alloc (& a) (* (-> args length) (sizeof string))))] [n u32 0] [i u32 0])
    (while (< i (-> args length))
      (if (== (@ args i) flag)
          (+= i (if valued 2 1))
          (begin
            (set! (@ out n) (@ args i))
            (+= n 1)
            (+= i 1))))
    (slice out n)))

;; ---- building ----

;; prepare! gives the compiler the module map for the program in file, from /, and checked, and gives where its
;; programs are built when no -o says: build/ in its project.
(define (prepare! [file string]) -> string
  (let* ([text (make-buffer)] [project (find-package! file)])
    (module-map! (& text))
    (when (> (-> text length) 0) (set-module-map-text! (string->datum (buffer-string (& text))) '"the module map"))
    (set-module-check! checked)
    (joined-path project "build")))

;; The program's package: how manifest-find found it, 0 outside packages, its manifest, its directory, its file when it
;; is a package of one file, and its name, which labels the root of the program's file, or "" outside packages.
(define program-found i32 0)
(define program-manifest manifest)
(define program-dir string)
(define program-file string)
(define program-package string)

(define (program-root) -> datum (if (> (-> program-package length) 0) (string->datum program-package) 0))

;; find-package! finds the package of the program in file, from /, and gives the program's project, the directory whose
;; build/ its builds go to: its package's, the toolchain's for the toolchain's programs, or its own outside packages.
(define (find-package! [file string]) -> string
  (unless (== file found-for)
    (set! found-for file)
    (set! found-project (package-of! file)))
  found-project)

;; The file find-package! last found the package of, and the project it gave.
(define found-for string)
(define found-project string)

(define (package-of! [file string]) -> string
  (let ([dir (make-buffer)] [err (make-buffer)])
    (set! program-found 0)
    (set! program-package "")
    (when (toolchain-file? file) (return root))
    (set! program-found (manifest-find (& a) file (& program-manifest) (& dir) (& err)))
    (when (< program-found 0) (failed! (local (buffer-string (& err)))))
    (when (== program-found 0) (return (parent-of file)))
    (set! program-dir (if (== program-found 1) (parent-of file) (buffer-string (& dir))))
    (set! program-file (if (== program-found 1) (base-of file) ""))
    (set! program-package (-> program-manifest name))
    program-dir))

;; module-map! adds the module map for the program find-package! found to text, and keeps its packages for checked.
(define (module-map! [text (ptr buffer)])
  (let ([err (make-buffer)] [roots (make-buffer)])
    (when (> program-found 0)
      (unless (package-map (& a) program-dir program-file (& program-manifest) store-dir text (& roots) (& err))
        (failed! (local (buffer-string (& err)))))
      (set! packages (slice (cast (ptr package-root) (-> roots bytes)) (/ (-> roots length) (sizeof package-root)))))))

;; toolchain-file? is whether file is in one of the toolchain's packages, which the compiler knows.
(define (toolchain-file? [file string]) -> bool (!= (toolchain-holding (string->datum file)) 0))

(define (flag? [args (slice string)] [flag string]) -> bool
  (for ([i u32 0]) (< i (-> args length)) (+= i 1) (when (== (@ args i) flag) (return #t)))
  #f)

;; ---- the cache and the store ----

;; The directories -c and -P give, or "".
(define given-cache string)
(define given-packages string)

;; The cache and the package store, which locations! sets.
(define cache-dir string)
(define store-dir string)

;; located gives args without -c DIR and -P DIR, keeping their directories; for run, only those before the program.
(define (located [args (slice string)] [leading bool]) -> (slice string)
  (let ([out (cast (ptr string) (arena-alloc (& a) (* (-> args length) (sizeof string))))] [n u32 0] [i u32 0]
        [flags #t])
    (while (< i (-> args length))
      (let ([x (@ args i)])
        (if (and flags (or (== x "-c") (== x "-P")) (< (+ i 1) (-> args length)))
            (begin
              (if (== x "-c") (set! given-cache (@ args (+ i 1))) (set! given-packages (@ args (+ i 1))))
              (+= i 2))
            (begin
              (when (and leading (not (starts? x "-"))) (set! flags #f))
              (set! (@ out n) x)
              (+= n 1)
              (+= i 1)))))
    (slice out n)))

;; locations! sets the cache and the store: the directories -c and -P give, else SUBSTRATE_CACHE and SUBSTRATE_PACKAGES,
;; else build/cache and build/packages in the project.
(define (locations! [project string])
  (set! cache-dir (location given-cache "SUBSTRATE_CACHE" (joined-path project "build/cache")))
  (set! store-dir (location given-packages "SUBSTRATE_PACKAGES" (joined-path project "build/packages"))))

(define (location [given string] [variable string] [fallback string]) -> string
  (let ([from-env string])
    (cond [(> (-> given length) 0) (absolute given)]
          [(and (env-get variable (& from-env) 0) (> (-> from-env length) 0)) (absolute from-env)]
          [else fallback])))

;; cache! makes the cache and gives it to the compiler.
(define (cache!)
  (make-dir (string->datum cache-dir))
  (set-cache-directory! (string->datum cache-dir)))

;; target! gives the compiler the module map for the program in full, and gives where it is built: out, or build/ as
;; prepare! says.
(define (target! [full string] [out string]) -> string
  (let ([base (prepare! full)]) (if (> (-> out length) 0) (absolute out) (joined-path base (stem-of full)))))

;; build! builds the program in file into out, or, when out is "", into build/ as prepare! says, and gives where.
(define (build! [file string] [out string] [strip bool]) -> string
  (let* ([full (absolute file)] [dir (target! full out)])
    (narrow! full dir)
    (write-program! (program-root) (string->datum full) (string->datum dir) strip)
    dir))

;; ---- grants ----

;; narrow! keeps this process to writing the cache and out, and to reading them and the program's roots, or any file
;; when the program is in none of the roots.
(define (narrow! [full string] [out string])
  (let ([r (make-buffer)] [w (make-buffer)] [why string] [dirs (root-directories)]
        [flags (cast (ptr string) (arena-alloc (& a) (* 2 (sizeof string))))])
    (buffer-add-string! (& r) "-R")
    (when (or (> (-> program-package length) 0) (toolchain-file? full))
      (buffer-add-byte! (& r) #\=)
      (while (pair? dirs)
        (granted! (& r) (datum->string (car dirs)))
        (set! dirs (cdr dirs)))
      (granted! (& r) cache-dir)
      (when (> (-> out length) 0) (granted! (& r) out)))
    (buffer-add-string! (& w) "-W=")
    (granted! (& w) cache-dir)
    (when (> (-> out length) 0) (granted! (& w) out))
    (set! (@ flags 0) (buffer-string (& r)))
    (set! (@ flags 1) (buffer-string (& w)))
    (when (< (process-restrict (slice flags 2) (& why)) 0) (failed! why))))

;; granted! adds path to a grant flag's list in b, after a comma, with ",," for a comma in it.
(define (granted! [b (ptr buffer)] [path string])
  (when (> (-> b length) 3) (buffer-add-byte! b #\,))
  (for ([i u32 0]) (< i (-> path length)) (+= i 1)
    (when (== (@ path i) #\,) (buffer-add-byte! b #\,))
    (buffer-add-byte! b (cast i32 (@ path i)))))

;; ---- checking modules ----

;; The packages of the module map, whose files checked keeps their modules to.
(define packages (slice package-root))

;; checked gives why the compiler may not read a module, or 0: a package's module is one of the files the package's hash
;; covers, and a module outside packages is in none. label is the module's package, or 0 outside packages; subject
;; names the module.
(define (checked [label datum] [file datum] [subject datum]) -> datum
  (let ([f (datum->string file)] [p (ptr package-root) 0])
    (when (== label 0) (return (outside (datum->string subject) f)))
    (for ([i u32 0]) (< i (-> packages length)) (+= i 1)
      (when (== (-> (@ packages i) name) (datum->string label)) (set! p (& (@ packages i)))))
    (cond [(== p 0) 0]
          [(> (-> p file length) 0)
           (let* ([one (joined-path (-> p dir) (-> p file))] [same (== f one)])
             (free (-> one bytes))
             (if same 0 (said (datum->string subject) " is not part of " (-> p name) ", a package of one file")))]
          [else (inside (datum->string subject) f p)])))

(define (inside [subject string] [f string] [p (ptr package-root)]) -> datum
  (let ([holder (package-holding (& a) (parent-of f))])
    (cond [(!= holder (-> p dir)) (elsewhere subject holder)]
          [(package-file? (-> p dir) (slice f (+ (-> p dir length) 1))) 0]
          [else (said subject " is not one of the files of " (-> p name) ", which leave out dot-files, build/ and links")])))

(define (outside [subject string] [f string]) -> datum
  (let ([holder (package-holding (& a) (parent-of f))]) (if (== (-> holder length) 0) 0 (elsewhere subject holder))))

;; elsewhere says that the module subject is in the package at dir, named by its manifest or else, as the toolchain's
;; are, by its directory.
(define (elsewhere [subject string] [dir string]) -> datum
  (let ([m manifest] [err (make-buffer)] [file (joined-path dir "package.sub")] [name (base-of dir)])
    (when (manifest-read (& a) file (& m) (& err)) (set! name (-> m name)))
    (free (-> file bytes))
    (buffer-free! (& err))
    (said subject " is in the package " name ", which is required by name")))

;; said gives the text of w, x, y and z.
(define (said [w string] [x string] [y string] [z string]) -> datum
  (let ([out (make-buffer)] [s datum 0])
    (buffer-add-string! (& out) w)
    (buffer-add-string! (& out) x)
    (buffer-add-string! (& out) y)
    (buffer-add-string! (& out) z)
    (set! s (string->datum (buffer-string (& out))))
    (buffer-free! (& out))
    s))

(define (build-command! [args (slice string)])
  (let ([plain (without (without args "-o" #t) "-s" #f)])
    (unless (== (-> plain length) 1) (usage))
    (cache!)
    (build! (@ plain 0) (option args "-o") (flag? (without args "-o" #t) "-s"))))

;; ---- running ----

;; become! makes this process the host running a program, given its arguments: the grants, the program and its own.
(define (become! [args (slice string)])
  (let ([why string])
    (process-exec (joined-path root "host/subhost.mjs") args (& why))
    (failed! why)))

;; later! has the host become a program, as become! does, once this process ends.
(define (later! [args (slice string)])
  (let ([why string])
    (when (< (process-exec-at-end (joined-path root "host/subhost.mjs") args (& why)) 0) (failed! why))))

;; run! builds a program from its file when given one, then becomes it with the grants given before it.
(define (run! [args (slice string)])
  (let ([i u32 0] [copy (cast (ptr string) (arena-alloc (& a) (* (-> args length) (sizeof string))))])
    (while (and (< i (-> args length)) (starts? (@ args i) "-")) (+= i 1))
    (when (>= i (-> args length)) (usage))
    (for ([k u32 0]) (< k (-> args length)) (+= k 1) (set! (@ copy k) (@ args k)))
    (if (ends? (@ args i) ".sub")
        (let ([full (absolute (@ args i))] [dir string])
          (cache!)
          (set! dir (target! full ""))
          (set! (@ copy i) dir)
          (later! (slice copy (-> args length)))
          (narrow! full dir)
          (write-program! (program-root) (string->datum full) (string->datum dir) #f))
        (become! (slice copy (-> args length))))))

;; serve! builds cmd/serve.sub and becomes it, granted reading its directory and listening at its address.
(define (serve! [args (slice string)])
  (let* ([address "127.0.0.1"] [dir "."] [k u32 0] [n (-> args length)] [granted (make-buffer)] [listen (make-buffer)]
         [argv (cast (ptr string) (arena-alloc (& a) (* (+ (* n 2) 5) (sizeof string))))] [m u32 0])
    (while (< k n)
      (let ([x (@ args k)])
        (cond [(== x "-l") (+= k 1) (when (< k n) (set! address (@ args k)))]
              [(== x "-t") (+= k 2)]
              [(== x "-z") (+= k 1)]
              [else (break)]))
      (+= k 1))
    (when (< k n) (set! dir (@ args k)))
    (buffer-add-string! (& granted) "-R=")
    (for ([i u32 0]) (< i (-> dir length)) (+= i 1)
      (when (== (@ dir i) #\,) (buffer-add-byte! (& granted) #\,))
      (buffer-add-byte! (& granted) (cast i32 (@ dir i))))
    (buffer-add-string! (& listen) "-N=")
    (if (and (> (-> address length) 0) (has-colon? address))
        (begin
          (buffer-add-byte! (& listen) #\[)
          (buffer-add-string! (& listen) (unbracketed address))
          (buffer-add-byte! (& listen) #\]))
        (buffer-add-string! (& listen) address))
    (set! (@ argv m) (buffer-string (& granted)))
    (set! (@ argv (+ m 1)) (buffer-string (& listen)))
    (+= m 2)
    (let ([t (option args "-t")] [key-at u32 0])
      (when (> (-> t length) 0)
        (for ([i u32 0]) (< i n) (+= i 1) (when (== (@ args i) "-t") (set! key-at (+ i 2))))
        (set! (@ argv m) (joined "--tls-cert=" t))
        (set! (@ argv (+ m 1)) (joined "--tls-key=" (if (< key-at n) (@ args key-at) "")))
        (+= m 2)))
    (cache!)
    (let* ([full (joined-path root "cmd/serve.sub")] [out (target! full (joined-path root "build/serve"))])
      (set! (@ argv m) out)
      (+= m 1)
      (for ([i u32 0]) (< i n) (+= i 1)
        (set! (@ argv m) (@ args i))
        (+= m 1))
      (later! (slice argv m))
      (narrow! full out)
      (write-program! (program-root) (string->datum full) (string->datum out) #f))))

(define (joined [a string] [b string]) -> string
  (let ([out (make-buffer)])
    (buffer-add-string! (& out) a)
    (buffer-add-string! (& out) b)
    (buffer-string (& out))))

(define (has-colon? [s string]) -> bool
  (for ([i u32 0]) (< i (-> s length)) (+= i 1) (when (== (@ s i) #\:) (return #t)))
  #f)

(define (unbracketed [s string]) -> string
  (let ([from (if (starts? s "[") 1 0)] [to (if (ends? s "]") (- (-> s length) 1) (-> s length))]) (slice s from to)))

;; ---- packages ----

;; print-hash! prints the hash of the package in a directory, the current one by default, as a dependency pins it.
(define (print-hash! [args (slice string)])
  (let* ([given (if (== (-> args length) 1) (@ args 0) ".")] [dir (absolute given)] [h (make-buffer)] [err (make-buffer)])
    (when (> (-> args length) 1) (usage))
    (unless (== (kind-of (joined-path dir "package.sub")) fs-file) (failed! (joined given " has no package.sub")))
    (unless (package-hash dir (& h) (& err)) (failed! (local (buffer-string (& err)))))
    (buffer-add-byte! (& h) 10)
    (host-write 1 (buffer-bytes (& h)))))

;; print-map! prints the module map sub gives the compiler for the program in a file.
(define (print-map! [args (slice string)])
  (let ([text (make-buffer)])
    (unless (== (-> args length) 1) (usage))
    (find-package! (absolute (@ args 0)))
    (module-map! (& text))
    (host-write 1 (buffer-bytes (& text)))))

;; ---- packing and sites ----

(define (pack! [args (slice string)])
  (let ([to (option args "-o")] [from (option args "-C")] [paths (without (without args "-o" #t) "-C" #t)]
        [err (make-buffer)])
    (when (or (== (-> to length) 0) (== (-> paths length) 0)) (usage))
    (unless (pack-files (if (== (-> from length) 0) "." from) paths to (& err)) (failed! (buffer-string (& err))))))

(define (kind-of [path string]) -> i32
  (let ([info fs-info]) (if (< (fs-stat path (& info) 0) 0) 0 (-> info kind))))

(define (made! [path string])
  (let ([why string]) (when (< (fs-make-dir path (& why)) 0) (failed! why))))

(define (copied! [from string] [to string])
  (let ([why string]) (when (< (fs-copy from to (& why)) 0) (failed! why))))

(define (names-in [dir string]) -> (slice string)
  (let ([names (slice string)] [why string])
    (when (< (fs-list dir (& names) (& why)) 0) (failed! why))
    names))

;; copy-tree! copies the directory from into to, following links, and adds each file's path, from base, to files.
(define (copy-tree! [from string] [to string] [base string] [files (ptr buffer)])
  (let ([names (names-in from)])
    (made! to)
    (for ([i u32 0]) (< i (-> names length)) (+= i 1)
      (let* ([name (@ names i)] [f (joined-path from name)] [t (joined-path to name)] [b (joined-path base name)])
        (if (== (kind-of f) fs-directory)
            (copy-tree! f t b files)
            (begin
              (copied! f t)
              (buffer-add! files (slice (cast (ptr u8) (& b)) (sizeof string)))))))))

(define (copy-modules! [from string] [to string])
  (let ([names (names-in from)])
    (for ([i u32 0]) (< i (-> names length)) (+= i 1)
      (let ([name (@ names i)])
        (when (and (ends? name ".mjs") (== (kind-of (joined-path from name)) fs-file))
          (copied! (joined-path from name) (joined-path to name)))))))

(define (written! [path string] [b (slice u8)])
  (let ([why string]) (when (< (fs-write-file path b (& why)) 0) (failed! why))))

;; site! builds a web site into out from a program's file, or from a directory build wrote: the program, the host's
;; page modules, the page, the files -f packs from the toolchain's directory, and the assets next to the file. It
;; replaces out only when out holds a .site file.
(define (site! [args (slice string)])
  (when (< (-> args length) 2) (usage))
  (let ([out (@ args 0)] [file (@ args 1)] [page (joined-path root "host/web/page.html")] [k u32 2]
        [files (make-buffer)] [list (make-buffer)] [err (make-buffer)] [why string])
    (when (and (!= (kind-of out) 0)
               (or (!= (kind-of out) fs-directory)
                   (and (> (-> (names-in out) length) 0) (!= (kind-of (joined-path out ".site")) fs-file))))
      (failed! (joined (joined "site: " out) " is not a site, so it is not replaced")))
    (when (and (!= (kind-of out) 0) (< (fs-remove out #t (& why)) 0)) (failed! why))
    (made! (joined-path out "host/modules"))
    (made! (joined-path out "host/web"))
    (written! (joined-path out ".site") (cast (slice u8) (joined file "\n")))
    (while (< k (-> args length))
      (let ([x (@ args k)])
        (cond [(and (== x "-p") (< (+ k 1) (-> args length)))
               (set! page (@ args (+ k 1)))
               (+= k 2)]
              [(and (== x "-f") (< (+ k 2) (-> args length)))
               (let ([name (@ args (+ k 1))] [start (+ k 2)])
                 (set! k start)
                 (while (and (< k (-> args length)) (not (starts? (@ args k) "-"))) (+= k 1))
                 (unless (pack-files root (slice args start k) (joined-path out (joined name ".pack")) (& err))
                   (failed! (buffer-string (& err)))))]
              [else (usage)])))
    (let ([assets (joined-path (parent-of (absolute file)) "assets")] [found (make-buffer)])
      (when (== (kind-of assets) fs-directory)
        (copy-tree! assets (joined-path out "assets") "assets" (& found))
        (let ([ps (cast (ptr string) (-> found bytes))] [n (/ (-> found length) (sizeof string))])
          (for ([i u32 1]) (< i n) (+= i 1)
            (let ([s (@ ps i)] [j i])
              (while (and (> j 0) (< s (@ ps (- j 1))))
                (set! (@ ps j) (@ ps (- j 1)))
                (-= j 1))
              (set! (@ ps j) s)))
          (for ([i u32 0]) (< i n) (+= i 1)
            (buffer-add-string! (& list) (@ ps i))
            (buffer-add-byte! (& list) 10))))
      (written! (joined-path out "assets.list") (buffer-bytes (& list))))
    (copy-modules! (joined-path root "host") (joined-path out "host"))
    (copy-modules! (joined-path root "host/modules") (joined-path out "host/modules"))
    (copy-modules! (joined-path root "host/web") (joined-path out "host/web"))
    (copied! page (joined-path out "index.html"))
    (if (== (kind-of file) fs-directory)
        (copy-tree! file (joined-path out "program") "" (& files))
        (let* ([full (absolute file)] [dir (target! full (joined-path out "program"))])
          (cache!)
          (narrow! full dir)
          (write-program! (program-root) (string->datum full) (string->datum dir) #f)))))

;; ---- fetching ----

;; The command to carry on with once the store holds every package, and its arguments.
(define next-command string)
(define next-args (slice string))

;; carry-on! runs the command.
(define (carry-on!)
  (try (dispatch! next-command next-args)
       [catch compile-error (message blamed loc) (compile-failed! message blamed loc)]))

;; A url dependency the store lacks.
(struct wanted [name string] [url string] [pin string])

;; Where the walk for packages the store lacks starts, when start is set: the program's package, or the package sub
;; fetch fetched by its url.
(define start bool)
(define start-dir string)
(define start-manifest manifest)

(define (start-at-program!)
  (set! start (> program-found 0))
  (set! start-dir program-dir)
  (set! start-manifest program-manifest))

;; fetch-more! fetches the first package the store lacks that the walk reaches, or, when it lacks none, carries on with
;; the command.
(define (fetch-more!)
  (let ([wants (make-buffer)] [seen (make-buffer)])
    (when start (want! start-dir (& start-manifest) (& wants) (& seen)))
    (cond [(> (-> wants length) 0) (fetch! (cast (ptr wanted) (-> wants bytes)))]
          [(!= next-command "fetch") (carry-on!)])))

;; want! adds to wants each url dependency the store lacks that the package at dir, with manifest m, reaches, looking in
;; each package once.
(define (want! [dir string] [m (ptr manifest)] [wants (ptr buffer)] [seen (ptr buffer)])
  (let ([deps (-> m dependencies)] [ss (cast (ptr string) (-> seen bytes))])
    (for ([i u32 0]) (< i (/ (-> seen length) (sizeof string))) (+= i 1) (when (== (@ ss i) dir) (return)))
    (buffer-add! seen (slice (cast (ptr u8) (& dir)) (sizeof string)))
    (for ([i u32 0]) (< i (-> deps length)) (+= i 1)
      (let* ([d (& (@ deps i))] [url (> (-> d url length) 0)] [dm manifest] [err (make-buffer)]
             [next (if url (store-entry (& a) store-dir (-> d hash)) (dependency-dir dir (-> d path)))])
        (if (and url (!= (kind-of next) fs-directory))
            (let ([w wanted])
              (set! (-> w name) (-> d name))
              (set! (-> w url) (-> d url))
              (set! (-> w pin) (-> d hash))
              (buffer-add! wants (slice (cast (ptr u8) (& w)) (sizeof wanted))))
            (when (manifest-read (& a) (joined-path next "package.sub") (& dm) (& err)) (want! next (& dm) wants seen)))
        (buffer-free! (& err))))))

(define (dependency-dir [dir string] [path string]) -> string
  (normal-path (& a) (if (starts? path "/") path (joined-path dir path))))

;; The package being fetched, its response, the directory it is unpacked into, and what the worker unpacking it said
;; went wrong.
(define fetching wanted)
(define answer event-head)
(struct body-reader [head event-head] [bytes buffer] [chunk (array u8 65536)])
(define body body-reader)
(define unpacker event-head)
(define staging string)
(define unpack-error string)
(const most-fetched u32 67108864)

;; fetch! fetches the package w wants; the worker unpack unpacks it, and install! makes it the store's.
(define (fetch! [w (ptr wanted)])
  (set! fetching (@ w))
  (say 2 (joined (joined "sub: fetching " (-> w url)) "\n"))
  (set! (-> answer handle) answered)
  (fetch-get (-> w url) (& answer)))

(define (answered [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (cond [(and (== kind fetch-head) (!= value 200))
         (stream-close id)
         (fetch-failed! (joined "the server answered " (number-text value)))]
        [(== kind fetch-head)
         (set! (-> body head handle) body-heard)
         (set! (-> body bytes) (make-buffer))
         (stream-tag! id (cast (ptr void) (& body)))
         (stream-read! id (slice (-> body chunk)))]
        [(== kind fetch-failed) (fetch-failed! (events-take-text))]))

(define (body-heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (cond [(and (== kind stream-read) (> value 0))
         (buffer-add! (& (-> body bytes)) (slice (-> body chunk) (cast u32 value)))
         (when (> (-> body bytes length) most-fetched)
           (stream-close id)
           (fetch-failed! "it is larger than 64 MB"))
         (stream-read! id (slice (-> body chunk)))]
        [(== kind stream-read) (unpack!)]
        [(== kind stream-failed) (fetch-failed! (events-take-text))]))

;; unpack! has a worker, which may read and write only the staging directory, unpack the archive there.
(define (unpack!)
  (let ([why string] [arg (make-buffer)] [o worker-options] [w u32 0]
        [grants (cast (ptr string) (arena-alloc (& a) (* 2 (sizeof string))))])
    (made! store-dir)
    (when (< (fs-make-temp-dir store-dir ".staging-" "" (& staging) (& why)) 0) (fetch-failed! why))
    (buffer-add-string! (& arg) staging)
    (buffer-add-byte! (& arg) 0)
    (buffer-add! (& arg) (buffer-bytes (& (-> body bytes))))
    (buffer-free! (& (-> body bytes)))
    (set! (@ grants 0) (grant-flag "-R=" staging))
    (set! (@ grants 1) (grant-flag "-W=" staging))
    (worker-options-init! (& o))
    (set! (-> o time) 60000)
    (set! (-> o memory) 1073741824)
    (set! (-> o grants) (slice grants 2))
    (set! (-> unpacker handle) unpacked)
    (set! unpack-error "")
    (set! w (worker-start unpack (buffer-bytes (& arg)) (& o) (& unpacker) (& why)))
    (buffer-free! (& arg))
    (when (== w 0) (fetch-failed! why))))

(define (unpacked [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (cond [(== kind worker-message) (set! unpack-error (events-take-text))]
        [(and (== kind worker-ended) (== value 0)) (install!)]
        [(== kind worker-ended)
         (let ([why (events-take-text)]) (install-failed! (if (> (-> unpack-error length) 0) unpack-error why)))]))

;; install! makes the package unpacked into staging the store's entry for its hash, when its dependencies are urls or
;; inside it, and its hash is the one its dependency pins, then fetches more. For sub fetch URL, which pins none, it
;; prints the dependency that would, and the walk starts at the package.
(define (install!)
  (let ([m manifest] [err (make-buffer)] [h (make-buffer)] [entry string] [why string] [hash string]
        [file (joined-path staging "package.sub")])
    (unless (== (kind-of file) fs-file) (install-failed! "it has no package.sub at its top"))
    (unless (manifest-read (& a) file (& m) (& err)) (install-failed! (buffer-string (& err))))
    (let ([deps (-> m dependencies)])
      (for ([i u32 0]) (< i (-> deps length)) (+= i 1)
        (let ([d (& (@ deps i))])
          (when (and (== (-> d url length) 0) (not (starts? (dependency-dir staging (-> d path)) (joined staging "/"))))
            (install-failed! (joined (joined "it depends on " (-> d path)) ", outside it"))))))
    (unless (package-hash staging (& h) (& err)) (install-failed! (buffer-string (& err))))
    (set! hash (buffer-string (& h)))
    (when (and (> (-> fetching pin length) 0) (!= hash (-> fetching pin)))
      (install-failed! (joined (joined (joined "it has the hash " hash) ", not the one its dependency pins, ")
                               (-> fetching pin))))
    (set! entry (store-entry (& a) store-dir hash))
    (when (< (fs-rename staging entry (& why)) 0)
      (fs-remove staging #t 0)
      (unless (== (kind-of entry) fs-directory) (fetch-failed! why)))
    (when (== (-> fetching pin length) 0)
      (say 1 (joined (joined (joined (joined (joined (joined "(" (-> m name)) " (url \"") (-> fetching url)) "\") (hash \"")
                             hash) "\"))\n"))
      (set! start #t)
      (set! start-dir entry)
      (set! start-manifest m))
    (fetch-more!)))

;; install-failed! removes staging and says why the package is not installed, with its files named from its url.
(define (install-failed! [why string])
  (fs-remove staging #t 0)
  (fetch-failed! (replaced why staging (-> fetching url))))

(define (fetch-failed! [why string])
  (failed! (joined (joined (joined "fetching " (-> fetching url)) ": ") why)))

;; replaced gives text with from replaced by to.
(define (replaced [text string] [from string] [to string]) -> string
  (let ([b (make-buffer)] [i u32 0] [n (-> from length)])
    (while (< i (-> text length))
      (if (and (> n 0) (<= (+ i n) (-> text length)) (== (slice text i (+ i n)) from))
          (begin
            (buffer-add-string! (& b) to)
            (+= i n))
          (begin
            (buffer-add-byte! (& b) (cast i32 (@ text i)))
            (+= i 1))))
    (buffer-string (& b))))

(define (grant-flag [flag string] [path string]) -> string
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) flag)
    (granted! (& b) path)
    (buffer-string (& b))))

(define (number-text [n i32]) -> string
  (let ([b (make-buffer)])
    (write-digits (& b) (cast u64 n) 10)
    (buffer-string (& b))))

;; fetch-command! fetches a package by its url into the store of the current directory's project, printing the
;; dependency that pins it, or the packages a program needs that the store lacks.
(define (fetch-command! [rest (slice string)])
  (unless (== (-> rest length) 1) (usage))
  (if (or (starts? (@ rest 0) "http://") (starts? (@ rest 0) "https://"))
      (let ([holder (package-holding (& a) cwd)] [w wanted])
        (locations! (if (> (-> holder length) 0) holder cwd))
        (set! start #f)
        (set! (-> w name) "")
        (set! (-> w url) (@ rest 0))
        (set! (-> w pin) "")
        (fetch! (& w)))
      (begin
        (locations! (find-package! (absolute (@ rest 0))))
        (start-at-program!)
        (fetch-more!))))

;; ---- unpacking ----

(const most-unpacked u32 268435456)

;; unpack runs in a worker. Its argument is a directory, a zero byte and an archive, tar or gzipped tar, whose files
;; and directories it writes into the directory, leaving out the one directory everything is in, when there is one.
(define (unpack)
  (let* ([arg (cast (slice u8) (@ (host-args) 0))] [z u32 0] [dir string] [data (slice u8)] [tarred (make-buffer)]
         [ua (make-arena)] [r tar-reader] [e tar-entry] [err (make-buffer)] [got i32 1] [top ""] [one #t] [why string])
    (while (and (< z (-> arg length)) (!= (@ arg z) 0)) (+= z 1))
    (when (>= z (-> arg length)) (unpack-failed! "it is empty"))
    (set! dir (cast string (slice arg 0 z)))
    (set! data (slice arg (+ z 1)))
    (when (and (>= (-> data length) 2) (== (@ data 0) 31) (== (@ data 1) 139))
      (let ([code (gunzip! (& tarred) data most-unpacked)])
        (cond [(== code -13) (unpack-failed! "it unpacks to more than 256 MB")]
              [(< code 0) (unpack-failed! (joined "it is not gzip data: " (gzip-message code)))]))
      (set! data (buffer-bytes (& tarred))))
    (tar-reader-init! (& r) data)
    (while (== got 1)
      (set! got (tar-next! (& ua) (& r) (& e) (& err)))
      (when (and (== got 1) (!= (-> e kind) tar-other))
        (let ([p (cleaned (-> e path))])
          (when (> (-> p length) 0)
            (when (== (-> top length) 0) (set! top (first-part p)))
            (unless (or (and (== p top) (== (-> e kind) tar-directory)) (starts? p (joined top "/"))) (set! one #f))))))
    (when (< got 0) (unpack-failed! (joined "it is not a tar archive: " (buffer-string (& err)))))
    (tar-reader-init! (& r) data)
    (set! got 1)
    (while (== got 1)
      (set! got (tar-next! (& ua) (& r) (& e) (& err)))
      (when (and (== got 1) (!= (-> e kind) tar-other))
        (let ([p (cleaned (-> e path))])
          (when (and one (> (-> top length) 0)) (set! p (if (== p top) "" (slice p (+ (-> top length) 1)))))
          (when (> (-> p length) 0)
            (let ([full (joined-path dir p)])
              (if (== (-> e kind) tar-directory)
                  (when (< (fs-make-dir full (& why)) 0) (unpack-failed! (joined (joined p ": ") why)))
                  (when (or (< (fs-make-dir (parent-of full) (& why)) 0) (< (fs-write-file full (-> e bytes) (& why)) 0))
                    (unpack-failed! (joined (joined p ": ") why)))))))))
    (host-exit 0)))

(define (unpack-failed! [why string])
  (worker-send-text 0 why)
  (host-exit 1))

;; cleaned gives an archive's path without ./ before it or / after it.
(define (cleaned [p string]) -> string
  (let ([s p])
    (while (starts? s "./") (set! s (slice s 2)))
    (while (ends? s "/") (set! s (slice s 0 (- (-> s length) 1))))
    (if (== s ".") "" s)))

(define (first-part [p string]) -> string
  (let ([i u32 0])
    (while (and (< i (-> p length)) (!= (@ p i) #\/)) (+= i 1))
    (slice p 0 i)))

;; ---- the commands ----

;; program-of gives the file, from /, of the program command builds, or "" when it builds none.
(define (program-of [command string] [rest (slice string)]) -> string
  (cond [(or (== command "build") (== command "eval") (== command "expand") (== command "map"))
         (let ([plain (without (without rest "-o" #t) "-s" #f)])
           (if (== (-> plain length) 1) (absolute (@ plain 0)) ""))]
        [(== command "run")
         (let ([i u32 0])
           (while (and (< i (-> rest length)) (starts? (@ rest i) "-")) (+= i 1))
           (if (and (< i (-> rest length)) (ends? (@ rest i) ".sub")) (absolute (@ rest i)) ""))]
        [(and (== command "site") (>= (-> rest length) 2) (!= (kind-of (@ rest 1)) fs-directory)) (absolute (@ rest 1))]
        [(== command "serve") (joined-path root "cmd/serve.sub")]
        [else ""]))

;; run starts a command, fetching first the packages its program needs that the store lacks.
(define (run [args (slice string)])
  (when (< (-> args length) 2) (usage))
  (set! root (@ args 0))
  (set! a (make-arena))
  (fs-cwd (& cwd) 0)
  (set-repository-root! (string->datum root))
  (install-core!)
  (set-display-directory! (string->datum cwd))
  (set! next-command (@ args 1))
  (set! next-args (located (slice args 2 (-> args length)) (== next-command "run")))
  (let ([file (program-of next-command next-args)])
    (cond [(== next-command "fetch") (fetch-command! next-args)]
          [(== (-> file length) 0) (carry-on!)]
          [else
           (locations! (find-package! file))
           (start-at-program!)
           (fetch-more!)])))

(define (dispatch! [command string] [rest (slice string)])
  (cond [(== command "build") (build-command! rest)]
        [(== command "run") (run! rest)]
        [(and (or (== command "eval") (== command "expand")) (== (-> rest length) 1))
         (let ([file (absolute (@ rest 0))])
           (prepare! file)
           (cache!)
           (if (== command "eval")
               (begin
                 (session-open! '"session")
                 (session-eval-file! (program-root) (string->datum file)
                                     (lambda ([e datum]) (host-write 2 (cast (slice u8) (datum->string e))))))
               (begin
                 (narrow! file "")
                 (expand-module-file (program-root) (string->datum file) (lambda ([f datum]) (print-expanded f))))))]
        [(== command "site") (site! rest)]
        [(== command "serve") (serve! rest)]
        [(== command "pack") (pack! rest)]
        [(== command "hash") (print-hash! rest)]
        [(== command "map") (print-map! rest)]
        [else (usage)]))

(define (compile-failed! [message datum] [blamed datum] [loc (ptr srcloc)])
  (let ([b (make-buffer)])
    (write-error (& b) message blamed loc)
    (host-write 2 (buffer-bytes (& b)))
    (host-exit 1)))

(define (main)
  (try (run (host-args))
       [catch compile-error (message blamed loc) (compile-failed! message blamed loc)]))

;; The host calls on-trap with a trap's message.
(define (on-trap [why (ptr u8)] [n u32]) -> bool
  (host-write 2 (cast (slice u8) (datum->string (trap-report (cast string (slice why n))))))
  (free why)
  (host-exit 1)
  #t)
