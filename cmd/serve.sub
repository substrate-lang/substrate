;; sub serve [-l ADDRESS] [-t CERT KEY] [-z LEVEL] DIR [PORT] serves DIR's files on ADDRESS (127.0.0.1) and PORT (8000),
;; over TLS when given a certificate, gzipped at LEVEL (6; 0 for none). It refuses a Host that is not an address or
;; localhost, logs requests to stderr and prints its URL once it listens. Ctrl-C finishes the requests in progress, then
;; exits; a second exits at once.
(require-unqualified host/events)
(require-unqualified std/http)
(require-unqualified std/http/server)
(require-unqualified std/http/static)
(require-unqualified std/http/checks)

(define server http-server)
(define files http-files)
(define hosts http-hosts)
(define local (array string 1) (array-of string ".localhost"))
(define list (array http-check 1))
(define scheme string "http://")

(define (say [fd i32] [s string]) (host-write fd (cast (slice u8) s)))

(define (failed! [problem string])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "serve: ")
    (buffer-add-string! (& b) problem)
    (host-exit 1 (buffer-string (& b)))))

(define (handle [r (ptr http-request)]) (http-static! r (& files)))

(define (colon? [s string]) -> bool
  (for ([i u32 0]) (< i (-> s length)) (+= i 1) (when (== (@ s i) 58) (return #t)))
  #f)

(define (unbracketed [s string]) -> string
  (let ([n (-> s length)])
    (if (and (>= n 2) (== (@ s 0) 91) (== (@ s (- n 1)) 93)) (slice s 1 (- n 1)) s)))

;; The URL names the address listened on, or a loopback one when that is every address.
(define (listening [s (ptr http-server)])
  (if (== (-> s port) 0)
      (failed! (-> s problem))
      (let ([line (make-buffer)] [host (-> s host)])
        (buffer-add-string! (& line) scheme)
        (cond [(or (== host "") (== host "0.0.0.0")) (buffer-add-string! (& line) "127.0.0.1")]
              [(== host "::") (buffer-add-string! (& line) "[::1]")]
              [(colon? host)
               (buffer-add-byte! (& line) 91)
               (buffer-add-string! (& line) host)
               (buffer-add-byte! (& line) 93)]
              [else (buffer-add-string! (& line) host)])
        (buffer-add-byte! (& line) 58)
        (http-add-decimal! (& line) (cast i64 (-> s port)))
        (buffer-add-string! (& line) "/\n")
        (host-write 1 (buffer-bytes (& line)))
        (buffer-free! (& line)))))

(define (main)
  (let* ([args (host-args)] [n (-> args length)] [at u32 0] [number i64 8000] [level i64 6] [ok #t])
    (while (and ok (< at n) (> (-> (@ args at) length) 0) (== (@ (@ args at) 0) 45))
      (let ([flag (@ args at)] [rest (- n at)])
        (cond [(and (== flag "-l") (>= rest 2))
               (set! (-> server host) (unbracketed (@ args (+ at 1))))
               (+= at 2)]
              [(and (== flag "-t") (>= rest 3))
               (set! scheme "https://")
               (set! (-> server secure) #t)
               (+= at 3)]
              [(and (== flag "-z") (>= rest 2))
               (set! level (http-decimal (@ args (+ at 1))))
               (+= at 2)]
              [else (set! ok #f)])))
    (when (> n (+ at 1)) (set! number (http-decimal (@ args (+ at 1)))))
    (when (or (not ok) (<= n at) (> n (+ at 2)) (< number 0) (> number 65535) (< level 0) (> level 9))
      (say 2 "usage: substrate serve [-l ADDRESS] [-t CERT KEY] [-z LEVEL] DIR [PORT]\n")
      (host-exit 64 ""))
    (set! (-> files root) (@ args at))
    (set! (-> hosts names) (slice local))
    (set! (-> hosts addresses) #t)
    (set! (-> (& (@ list 0)) run) http-hosts-check)
    (set! (-> (& (@ list 0)) settings) (cast (ptr void) (& hosts)))
    (set! (-> server checks) (slice list))
    (set! (-> server most) 1024)
    (set! (-> server compress) (cast i32 level))
    (set! (-> server on-done) http-log-access)
    (set! (-> server listening) listening)
    (http-stop-on-signals! (& server) 5000.0 0)
    (let ([why error])
      (unless (http-serve! (& server) (cast u32 number) handle (& why)) (failed! (error-text (& why)))))))
