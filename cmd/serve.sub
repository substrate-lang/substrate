;; sub serve [-t CERT KEY] DIR [PORT] serves DIR's files on 127.0.0.1, over TLS when given a certificate. It refuses
;; a request whose Host is not an address or localhost, and prints the URL once it listens.
(require-unqualified events "../host/events.sub")
(require-unqualified http "../lib/http/http.sub")
(require-unqualified server "../lib/http/server.sub")
(require-unqualified static "../lib/http/static.sub")

(define server http-server)
(define files http-files)
(define scheme string "http://")

(define (say [fd i32] [s string]) (host-write fd (cast (slice u8) s)))

(define (local? [host string]) -> bool
  (let ([n u32 0] [address #t])
    (when (or (== host "") (== (@ host 0) 91)) (return #t))
    (while (and (< n (-> host length)) (!= (@ host n) 58))
      (unless (or (== (@ host n) 46) (and (>= (@ host n) 48) (<= (@ host n) 57))) (set! address #f))
      (+= n 1))
    (let ([name (slice host 0 n)])
      (or (and address (> n 0)) (== name "localhost") (and (> n 10) (== (slice name (- n 10)) ".localhost"))))))

(define (handle [r (ptr http-request)])
  (if (local? (http-request-header r "host"))
      (http-static! r (& files))
      (http-answer-text! r 403 "this host is not allowed")))

(define (listening [s (ptr http-server)])
  (if (== (-> s port) 0)
      (begin
        (say 2 "serve: ")
        (say 2 (-> s problem))
        (say 2 "\n")
        (host-exit 1))
      (let ([line (make-buffer)])
        (buffer-add-string! (& line) scheme)
        (buffer-add-string! (& line) "127.0.0.1:")
        (http-add-decimal! (& line) (cast i64 (-> s port)))
        (buffer-add-string! (& line) "/\n")
        (host-write 1 (buffer-bytes (& line)))
        (buffer-free! (& line)))))

(define (main)
  (let* ([args (host-args)] [n (-> args length)] [tls (and (>= n 3) (== (@ args 0) "-t"))] [at u32 (if tls 3 0)]
         [number i64 8000])
    (when (> n (+ at 1)) (set! number (http-decimal (@ args (+ at 1)))))
    (when (or (<= n at) (> n (+ at 2)) (< number 0) (> number 65535))
      (say 2 "usage: sub serve [-t CERT KEY] DIR [PORT]\n")
      (host-exit 64))
    (set! (-> files root) (@ args at))
    (set! (-> server most) 1024)
    (when tls
      (set! scheme "https://")
      (set! (-> server secure) #t))
    (set! (-> server listening) listening)
    (when (== (http-serve! (& server) (cast u32 number) handle) 0)
      (say 2 "serve: ")
      (say 2 (-> server problem))
      (say 2 "\n")
      (host-exit 1))))
