;; Shade: a function whose result is an if without an else.
(require-unqualified gpu web/gpu)
(require-unqualified shader web/scene/shader)
(shader broken
  [uniform frame 0 0 (vertex) [size vec2]]
  [varyings [uv vec2]]
  [define (f [p vec2]) -> f32 (if (> p.x 0.0) 1.0)])
(define (main) (printf "~a" broken-code))
