;; An index out of range stops the program, naming the index and the size.
(require-unqualified vector web/game/vector)

(define numbers (vector u32))

(define (main)
  (for ([i u32 0]) (< i 3) (+= i 1) (vector-push! (& numbers) i))
  (printf "before\n")
  (vector-at (& numbers) 3)
  (printf "not reached\n"))

(test err-vector-range #:traps "vector-at: there is no item 3: the vector holds 3" (main))
