;; Text grids: a level written as text, one character a cell.
(require-unqualified std/test/test)
(require-unqualified web/game/format)
(require-unqualified web/game/tiles)

(define grid text-grid)

(define (show [text string])
  (text-grid-read! (& grid) text)
  (print-format "~d columns, ~d rows\n" (-> grid columns) (-> grid rows))
  (for ([row i32 0]) (< row (-> grid rows)) (+= row 1)
    (print-format "  [")
    (for ([column i32 0]) (< column (-> grid columns)) (+= column 1)
      (let ([c (grid-char (& grid) column row)])
        (print-format "~c" (if (== c 0) 32 c))))
    (print-format "]\n")))

(define (main)
  (print-format "a level:\n")
  (show "..o..\n.===.\nP...F\n#####\n")
  (print-format "outside the grid: ~d ~d ~d ~d\n"
                (grid-char (& grid) -1 0) (grid-char (& grid) 0 -1) (grid-char (& grid) 5 0) (grid-char (& grid) 0 4))

  (print-format "uneven lines, and no line end after the last:\n")
  (show "ab\n\nabcd\nabc")
  (print-format "empty lines at the end:\n")
  (show "ab\ncd\n\n\n")

  (print-format "Windows line ends:\n")
  (show "ab\r\ncd\r\n")

  (print-format "no text:\n")
  (show "")
  (text-grid-free! (& grid))
  (print-format "after freeing: ~d columns, ~d rows\n" (-> grid columns) (-> grid rows)))

(test text-grid (expect-output-file "text-grid.out" (main)))
