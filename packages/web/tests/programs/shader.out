the WGSL:
struct Frame { view_projection: mat4x4f, sun: vec3f, time: f32, sky: vec4f, cascades: array<mat4x4f, 2>, fog: vec2f, }
@group(0) @binding(0) var<uniform> frame: Frame;
@group(0) @binding(1) var atlas_sampler: sampler;
@group(0) @binding(2) var atlas: texture_2d<f32>;
@group(0) @binding(3) var shadow_sampler: sampler_comparison;
@group(0) @binding(4) var shadow_map: texture_depth_2d;
struct Origin { at: vec3f, }
@group(1) @binding(0) var<uniform> origin: Origin;
struct Particles { position: vec3f, age: f32, velocity: vec3f, }
@group(2) @binding(0) var<storage, read_write> particles: array<Particles>;
struct Vertex { @location(0) position: vec3f, @location(1) normal: vec3f, @location(2) texel: vec2f, @location(3) offset: vec3f, @location(4) tint: vec4f, @builtin(vertex_index) vertex_index: u32, @builtin(instance_index) instance_index: u32, }
struct Varyings { @builtin(position) position: vec4f, @location(0) uv: vec2f, @location(1) light: f32, }
@vertex fn vertex(in: Vertex) -> Varyings { var out: Varyings; out.position = frame.view_projection * vec4f(in.position + origin.at + in.offset, 1.0); out.uv = in.texel; out.light = max(dot(in.normal, frame.sun), 0.0); return out; }
@fragment fn fragment(in: Varyings) -> @location(0) vec4f { return textureSample(atlas, atlas_sampler, in.uv) * in.light; }
@compute @workgroup_size(64) fn step(@builtin(global_invocation_id) id: vec3u) { particles[id.x].age += frame.time; }
the frame struct: 240 bytes; view-projection at 0, sun at 64, time at 76, sky at 80, cascades at 96, fog at 224
the origin struct: 16 bytes, 256 apart in the buffer
a particle: 32 bytes, 32 apart; position at 0, age at 12, velocity at 16
a vertex: 32 bytes, texel at 24; an instance: 16 bytes, tint at 12
setting up:
shader 1 1432 bytes
layout 1
  binding 0 visibility 3 kind 1
  binding 1 visibility 2 kind 7
  binding 2 visibility 3 kind 9
  binding 3 visibility 2 kind 8
  binding 4 visibility 2 kind 10
layout 2
  binding 0 visibility 1 kind 4
layout 3
  binding 0 visibility 4 kind 2
--
a render pipeline, with depth and culling, on an rgba16f target:
render-pipeline 1 1 vertex "vertex" fragment "fragment" topology 1 cull 1 front 0 blend 0 depth 8 1 1
  layouts 1 2 3
  targets 5
  buffer stride 32 per vertex [0 at 0 format 3] [1 at 12 format 3] [2 at 24 format 2]
  buffer stride 16 per instance [3 at 0 format 3] [4 at 12 format 9]
--
a depth-only pipeline using the first two groups only, and a compute pipeline:
render-pipeline 2 1 vertex "vertex" fragment "" topology 1 cull 1 front 0 blend 0 depth 8 1 1
  layouts 1 2
  targets
  buffer stride 32 per vertex [0 at 0 format 3] [1 at 12 format 3] [2 at 24 format 2]
  buffer stride 16 per instance [3 at 0 format 3] [4 at 12 format 9]
compute-pipeline 3 1 entry "step"
  layouts 1 2 3
--
the bind groups, with made-up resource numbers:
bind-group 1 layout 1 pipeline 0 group 0
  binding 0 buffer 1 offset 0 size 0
  binding 1 sampler 2
  binding 2 texture 3
  binding 3 sampler 4
  binding 4 texture 5
bind-group 2 layout 2 pipeline 0 group 1
  binding 0 buffer 6 offset 0 size 16
bind-group 3 layout 3 pipeline 0 group 2
  binding 0 buffer 7 offset 0 size 0
--
write-buffer 1 offset 0 bytes 240
--
sun 0.3 0.8 0.5, time 1.5, sky alpha 1.0
