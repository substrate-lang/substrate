;; A command written while the last one is still waiting for its items stops the program.
(require-unqualified web/gpu)
(provide main)
(define (main)
  (let ([shader (gpu-shader! "")])
    (gpu-render-pipeline! shader "vertex" "fragment" gpu-triangles gpu-cull-none gpu-ccw gpu-blend-none 0 0 #f  0 1 0)
    (gpu-buffer! 16 gpu-uniform)))

