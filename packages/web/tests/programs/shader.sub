;; The shader form: its WGSL, structs with WGSL's layout, and its pipelines' commands.
(require-unqualified web/gpu)
(require-unqualified web/scene/shader)
(require-unqualified web/trace)
(require-unqualified web/game/format)
(provide main)

(shader lit
  [uniform frame 0 0 (vertex fragment)
    [view-projection mat4] [sun vec3] [time f32] [sky vec4] [cascades (array mat4 2)] [fog vec2]]
  [sampler atlas-sampler 0 1 (fragment)]
  [texture atlas 0 2 (vertex fragment)]
  [comparison-sampler shadow-sampler 0 3 (fragment)]
  [depth-texture shadow-map 0 4 (fragment)]
  [uniform-array origin 1 0 (vertex) [at vec3]]
  [storage particles 2 0 (compute) read-write [position vec3] [age f32] [velocity vec3]]
  [vertex-input vertex per-vertex [position vec3] [normal vec3] [texel vec2]]
  [vertex-input instance per-instance [offset vec3] [tint unorm8x4]]
  [builtins vertex-index instance-index]
  [varyings [uv vec2] [light f32]]
  [code "@vertex fn vertex(in: Vertex) -> Varyings { var out: Varyings; out.position = frame.view_projection * vec4f(in.position + origin.at + in.offset, 1.0); out.uv = in.texel; out.light = max(dot(in.normal, frame.sun), 0.0); return out; }"]
  [code "@fragment fn fragment(in: Varyings) -> @location(0) vec4f { return textureSample(atlas, atlas_sampler, in.uv) * in.light; }"]
  [code "@compute @workgroup_size(64) fn step(@builtin(global_invocation_id) id: vec3u) { particles[id.x].age += frame.time; }"])

(define (main)
  (printf "the WGSL:\n")
  (printf "~a" lit-code)
  (print-format "the frame struct: ~d bytes; view-projection at ~d, sun at ~d, time at ~d, sky at ~d, cascades at ~d, fog at ~d\n"
                (sizeof lit-frame) (offsetof lit-frame view-projection) (offsetof lit-frame sun) (offsetof lit-frame time)
                (offsetof lit-frame sky) (offsetof lit-frame cascades) (offsetof lit-frame fog))
  (print-format "the origin struct: ~d bytes, ~d apart in the buffer\n" (sizeof lit-origin) lit-origin-stride)
  (print-format "a particle: ~d bytes, ~d apart; position at ~d, age at ~d, velocity at ~d\n"
                (sizeof lit-particles) lit-particles-stride (offsetof lit-particles position) (offsetof lit-particles age) (offsetof lit-particles velocity))
  (print-format "a vertex: ~d bytes, texel at ~d; an instance: ~d bytes, tint at ~d\n"
                (sizeof lit-vertex) (offsetof lit-vertex texel) (sizeof lit-instance) (offsetof lit-instance tint))

  (let ([s lit-shader] [settings render-settings])
    (printf "setting up:\n")
    (lit-init! (& s))
    (trace-gpu!)
    (printf "a render pipeline, with depth and culling, on an rgba16f target:\n")
    (render-settings-init! (& settings))
    (set! (-> settings cull) gpu-cull-back)
    (set! (-> settings depth-format) gpu-depth24)
    (set! (-> settings depth-compare) gpu-less)
    (set! (-> settings depth-write) #t)
    (set! (@ (-> settings targets) 0) gpu-rgba16f)
    (lit-render-pipeline! (& s) "vertex" "fragment" (& settings))
    (trace-gpu!)
    (printf "a depth-only pipeline using the first two groups only, and a compute pipeline:\n")
    (set! (-> settings target-count) 0)
    (set! (-> settings groups) 2)
    (lit-render-pipeline! (& s) "vertex" "" (& settings))
    (lit-compute-pipeline! (& s) "step")
    (trace-gpu!)
    (printf "the bind groups, with made-up resource numbers:\n")
    (lit-bind-group-0! (& s) 1 2 3 4 5)
    (lit-bind-group-1! (& s) 6)
    (lit-bind-group-2! (& s) 7)
    (trace-gpu!)
    (let ([frame lit-frame])
      (memset (& frame) 0 (sizeof lit-frame))
      (vec3! (-> frame sun) 0.3 0.8 0.5)
      (set! (-> frame time) 1.5)
      (vec4! (-> frame sky) 0.5 0.7 1.0 1.0)
      (gpu-write-copy! 1 0 (& frame) (sizeof lit-frame))
      (trace-gpu!)
      (print-format "sun ~.1f ~.1f ~.1f, time ~.1f, sky alpha ~.1f\n"
                    (cast f64 (@ (-> frame sun) 0)) (cast f64 (@ (-> frame sun) 1)) (cast f64 (@ (-> frame sun) 2))
                    (cast f64 (-> frame time)) (cast f64 (@ (-> frame sky) 3))))))

