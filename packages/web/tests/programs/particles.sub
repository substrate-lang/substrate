;; Particles without a GPU: the shaders compile, and a frame's commands are written.
(require-unqualified web/game/format)
(require-unqualified web/gpu)
(require-unqualified web/trace)
(require-unqualified web/scene/math)
(require-unqualified web/scene/camera)
(require-unqualified web/scene/light)
(require-unqualified web/scene/particles)
(provide main)

(define (main)
  (let ([p particles] [c camera] [l light])
    (particles-init! (& p))
    (print-format "set up: ~d bytes of commands\n" (-> (gpu-commands) length))
    (trace-gpu!)
    (particles-emit! (& p) 0 10.0 5.0 10.0 particles-smoke 1.0)
    (particles-emit! (& p) 1 20.0 1.0 20.0 particles-fireflies 0.5)
    (particles-emit! (& p) 15 30.0 2.0 30.0 particles-splash 0.0)
    (print-format "emitters: 0 is smoke at ~.0f ~.0f ~.0f at strength ~.1f; 1 fireflies at ~.1f; 15 off\n"
                  (cast f64 (@ (-> p world emitters) 0)) (cast f64 (@ (-> p world emitters) 1)) (cast f64 (@ (-> p world emitters) 2))
                  (cast f64 (@ (-> p world strengths) 0)) (cast f64 (@ (-> p world strengths) 4)))
    (memset (& c) 0 (sizeof camera))
    (camera-perspective! (& c) (radians 70.0) (/ 16.0 9.0) 0.1 100.0)
    (light-init! (& l))
    (set! (-> l time) 2.5)
    (printf "a frame's step, and its draw inside a render pass:\n")
    (particles-step! (& p) (& c) (& l))
    (gpu-render-pass! 0 0 0 0 gpu-clear 1.0)
    (particles-pass! (& p))
    (gpu-end-pass!)
    (trace-gpu!)))

