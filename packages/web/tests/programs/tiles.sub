;; Tile maps: bodies stopped by solid tiles, the camera, and drawing what is on screen.
(require-unqualified web/ui)
(require-unqualified web/game/tiles)
(require-unqualified web/game/draw)
(require-unqualified web/trace)
(provide main)

(define level tilemap)
(define b body)
(define other body)
(define view camera)

(define (show [v f64])
  (when (< v 0.0)
    (printf "-")
    (set! v (- 0.0 v)))
  (let ([tenths (cast u64 (+ (* v 10.0) 0.5))])
    (printf "~a" (/ tenths 10))
    (when (!= (% tenths 10) 0)
      (printf ".~a" (% tenths 10)))))

(define (report)
  (printf "  at ")
  (show (-> b x))
  (printf ", ")
  (show (-> b y))
  (when (-> b on-ground) (printf ", on the ground"))
  (when (-> b hit-wall) (printf ", hit a wall"))
  (when (-> b hit-ceiling) (printf ", hit the ceiling"))
  (printf "\n"))

(define (place [x f64] [y f64] [vx f64] [vy f64])
  (set! (-> b x) x)
  (set! (-> b y) y)
  (set! (-> b vx) vx)
  (set! (-> b vy) vy))

(define (steps [n u32] [gravity f64])
  (for ([i u32 0]) (< i n) (+= i 1)
    (+= (-> b vy) gravity)
    (move-body! (& level) (& b))))

(define (main)
  (tilemap-init! (& level) 8 6 16)
  (tile-solid! (& level) 1)
  (for ([column i32 0]) (< column 8) (+= column 1) (tile-set! (& level) column 5 1))
  (tile-set! (& level) 3 2 1)
  (tile-set! (& level) 6 4 1)
  (set! (-> b width) 10.0)
  (set! (-> b height) 14.0)

  (printf "falling onto the floor\n")
  (place 20.0 0.0 0.0 0.0)
  (steps 10 0.5)
  (report)
  (steps 20 0.5)
  (report)

  (printf "walking right into the block\n")
  (set! (-> b vx) 2.0)
  (steps 20 0.5)
  (report)
  (while (not (-> b hit-wall))
    (set! (-> b vx) 2.0)
    (steps 1 0.5))
  (report)
  (printf "and away from it again\n")
  (set! (-> b vx) -2.0)
  (steps 1 0.5)
  (report)

  (printf "walking left to the edge of the level, which is solid\n")
  (steps 60 0.5)
  (report)

  (printf "jumping up under the block in the air\n")
  (place 50.0 66.0 0.0 -6.0)
  (steps 3 0.5)
  (report)
  (steps 1 0.5)
  (report)
  (steps 20 0.5)
  (report)

  (printf "falling while pushing against the right edge of the level\n")
  (place 114.0 20.0 2.0 2.0)
  (steps 1 0.0)
  (report)
  (set! (-> b vx) 2.0)
  (steps 1 0.0)
  (report)
  (set! (-> b vx) 2.0)
  (steps 1 0.0)
  (report)
  (steps 30 0.5)
  (report)

  (printf "a move of 40 pixels in one step does not pass through the block\n")
  (place 60.0 66.0 40.0 0.0)
  (steps 1 0.0)
  (report)

  (printf "jumping above the top of the level is allowed\n")
  (place 100.0 5.0 0.0 -8.0)
  (steps 2 0.0)
  (report)

  (printf "with a hole in the floor, the body falls out of the level\n")
  (tile-set! (& level) 1 5 0)
  (place 19.0 66.0 0.0 0.0)
  (steps 30 0.5)
  (report)
  (tile-set! (& level) 1 5 1)

  (printf "overlap\n")
  (set! (-> other width) 10.0)
  (set! (-> other height) 14.0)
  (place 20.0 66.0 0.0 0.0)
  (set! (-> other x) 30.0)
  (set! (-> other y) 66.0)
  (printf "~a" (if (bodies-overlap? (& b) (& other)) "  touching edges overlap\n" "  touching edges do not overlap\n"))
  (set! (-> other x) 29.0)
  (printf "~a" (if (bodies-overlap? (& b) (& other)) "  one pixel in: overlap\n" "  one pixel in: no overlap\n"))
  (set! (-> other y) 100.0)
  (printf "~a" (if (bodies-overlap? (& b) (& other)) "  far below: overlap\n" "  far below: no overlap\n"))

  (printf "the camera follows a point, but stays inside the level\n")
  (camera-follow! (& view) 10.0 10.0 64.0 48.0 (& level))
  (printf "  near the top left: ") (show (-> view x)) (printf ", ") (show (-> view y)) (printf "\n")
  (camera-follow! (& view) 64.0 48.0 64.0 48.0 (& level))
  (printf "  in the middle: ") (show (-> view x)) (printf ", ") (show (-> view y)) (printf "\n")
  (camera-follow! (& view) 120.0 90.0 64.0 48.0 (& level))
  (printf "  near the bottom right: ") (show (-> view x)) (printf ", ") (show (-> view y)) (printf "\n")
  (camera-follow! (& view) 64.0 48.0 400.0 300.0 (& level))
  (printf "  on a screen larger than the level: ") (show (-> view x)) (printf ", ") (show (-> view y)) (printf "\n")

  (printf "drawing: only the tiles on the screen\n")
  (set! (-> view x) 40.0)
  (set! (-> view y) 40.0)
  (let ([sheet (load-sheet "tiles.png" 16.0 16.0)])
    (ui-canvas-begin 1)
    (draw-tilemap (& level) sheet (& view) 64.0 48.0)
    (ui-canvas-end))
  (trace-patches!))

