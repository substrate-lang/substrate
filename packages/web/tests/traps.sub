(require-unqualified web/game/store)
(require-unqualified web/game/vector)

;; store-handle of an address that is not an object in the store stops the program.
(struct enemy [health i32] [armour i32])
(define enemies (store enemy))
(define elsewhere (array enemy 4))

(test err-store-address #:traps "store-handle: this is not the address of an object in the store"
  (store-add! (& enemies))
  (printf "before\n")
  (store-handle (& enemies) (+ elsewhere 2))
  (printf "not reached\n"))

;; store-get of a removed object stops the program with a message.
(struct monster [health i32])
(define monsters (store monster))

(test err-store-gone #:traps "store-get: the object that this handle refers to has been removed"
  (let ([h (store-handle (& monsters) (store-add! (& monsters)))])
    (set! (-> (store-get (& monsters) h) health) 3)
    (store-remove! (& monsters) h)
    (printf "before\n")
    (set! (-> (store-get (& monsters) h) health) 2)
    (printf "not reached\n")))

;; An index out of range stops the program, naming the index and the size.
(define numbers (vector u32))

(test err-vector-range #:traps "vector-at: there is no item 3: the vector holds 3"
  (for ([i u32 0]) (< i 3) (+= i 1) (vector-push! (& numbers) i))
  (printf "before\n")
  (vector-at (& numbers) 3)
  (printf "not reached\n"))
