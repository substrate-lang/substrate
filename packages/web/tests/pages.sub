;; The examples' pages, used as a user would use them, in the simulated browser.
(require-unqualified page std/test/page)

(test snake
  (with-page (p "../examples/snake/snake.sub")
    (page-advance! p 100)
    (expect-text p (by-css "#status") "Press an arrow key to start.")
    (expect-text p (by-css "#score") "0")
    (expect-drawn p (by-css "#board") "fill-style \"#b4f1a7\"\nfill-rect 201 201 18 18")
    (page-press! p "ArrowRight")
    (expect-text p (by-css "#status") "Arrow keys or W A S D to turn. Space to pause.")
    (page-advance! p 1000)
    (expect (not (page-drawn? p (by-css "#board") "fill-style \"#b4f1a7\"\nfill-rect 201 201 18 18")))
    (page-press! p " ")
    (expect-text p (by-css "#status") "Paused. Press Space to continue.")
    (page-press! p " ")
    (expect-text p (by-css "#status") "Arrow keys or W A S D to turn. Space to pause.")
    (page-advance! p 20000)
    (expect-text p (by-css "#status") "Game over. Press Enter to play again.")
    (page-press! p "ArrowLeft")
    (expect-text p (by-css "#status") "Game over. Press Enter to play again.")
    (page-press! p "Enter")
    (expect-text p (by-css "#status") "Press an arrow key to start.")
    (page-click! p (by-role "button" "New game"))
    (expect-text p (by-css "#status") "Press an arrow key to start.")
    (page-press! p "a")
    (expect-text p (by-css "#status") "Arrow keys or W A S D to turn. Space to pause.")))

(test snake-best-score
  (with-page (p "../examples/snake/snake.sub")
    (page-storage-set! p "best" "42")
    (page-reload! p)
    (expect-text p (by-css "#best") "42")))

(test counter
  (with-page (p "../examples/counter.sub")
    (expect-text p (by-css ".count") "0")
    (page-click! p (by-role "button" "+"))
    (page-click! p (by-role "button" "+"))
    (expect-text p (by-css ".count") "2")
    (expect-html p (by-css ".counter")
                 "<div class=\"counter\"><button>-</button><span class=\"count\">2</span><button>+</button><button>reset</button><!--a--></div>")
    (page-click! p (by-role "button" "-"))
    (page-click! p (by-role "button" "-"))
    (page-click! p (by-role "button" "-"))
    (expect-attribute p (by-text "-1") "class" "negative")
    (page-click! p (by-role "button" "reset"))
    (expect-text p (by-css ".count") "0")
    (expect-missing p (by-role "button" "reset"))))

(test rows
  (with-page (p "../examples/rows.sub")
    (page-click! p (by-role "button" "create 1,000 rows"))
    (expect-count p (by-css "tbody tr") 1000)
    (expect-text p (by-css "tbody tr:last-child td.id") "1000")
    (page-click! p (by-role "button" "swap rows"))
    (expect-text p (by-css "tbody tr:nth-child(2) td.id") "999")
    (expect-text p (by-css "tbody tr:nth-child(999) td.id") "2")
    (page-click! p (within (nth (by-css "tbody tr") 500) (by-text "remove")))
    (expect-count p (by-css "tbody tr") 999)
    (page-click! p (within (nth (by-css "tbody tr") 3) (by-css "td:nth-child(2) a")))
    (expect-text p (by-css "tr.selected td.id") "3")
    (page-click! p (by-role "button" "update every 10th row"))
    (expect-count p (by-text-containing "!!!") 100)
    (page-click! p (by-role "button" "append 1,000 rows"))
    (expect-count p (by-css "tbody tr") 1999)
    (expect-text p (by-css "tbody tr:last-child td.id") "2000")
    (page-click! p (by-role "button" "clear"))
    (expect-missing p (by-css "tbody tr"))))

(test platformer
  (with-page (p "../examples/platformer/platformer.sub")
    (page-advance! p 500)
    (expect-drawn p (nth (by-css "canvas") 2) "fill-text \"level 1   coins 0/18\" 6 5")
    (page-key-down! p "ArrowRight")
    (page-advance! p 500)
    (page-key-up! p "ArrowRight")
    (page-press! p " ")
    (page-advance! p 300)
    (expect-equal (page-sounds p) "tone square 320 640 110 ms")
    (expect-missing p (by-css ".game-stopped"))
    (expect-equal (page-console p) "")))

(test blocks
  (with-page (p "../examples/blocks/blocks.sub")
    (page-advance! p 500)
    (expect-drawn p (nth (by-css "canvas") 2) "fill-text \"at 32.0 12.6 32.0\" 8 8")
    (page-key-down! p "w")
    (page-advance! p 600)
    (page-key-up! p "w")
    (page-advance! p 100)
    (expect-drawn p (nth (by-css "canvas") 2) "fill-text \"at 32.0 13.8 33.8\" 8 8")
    (page-click! p (nth (by-css "canvas") 1))
    (page-advance! p 100)
    (expect-drawn p (nth (by-css "canvas") 2)
                  "fill-text \"WASD walk, mouse look, left dig, right place stone (1-6 choose), Escape frees the mouse\" 8 340")
    (expect-missing p (by-css ".game-stopped"))
    (expect-equal (page-console p) "")))

(test valley
  (with-page (p "../examples/valley/valley.sub")
    (page-advance! p 500)
    (expect-drawn p (nth (by-css "canvas") 2) "fill-text \"morning, at 161 34\" 8 8")
    (page-key-down! p "w")
    (page-advance! p 1000)
    (page-key-up! p "w")
    (expect-drawn p (nth (by-css "canvas") 2) "fill-text \"morning, at 160 39\" 8 8")
    (expect-missing p (by-css ".game-stopped"))
    (expect-equal (page-console p) "")))
