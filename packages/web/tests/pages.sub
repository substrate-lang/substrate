;; The examples' pages, used as a user would use them, in the simulated browser.
(require-unqualified page std/test/page)

(test counter
  (with-page (p "../examples/counter.sub")
    (expect-text p (by-css ".count") "0")
    (page-click! p (by-role "button" "+"))
    (page-click! p (by-role "button" "+"))
    (expect-text p (by-css ".count") "2")
    (expect-html p (by-css ".counter")
                 "<div class=\"counter\"><button>-</button><span class=\"count\">2</span><button>+</button><button>reset</button><!--a--></div>")
    (page-click! p (by-role "button" "-"))
    (page-click! p (by-role "button" "-"))
    (page-click! p (by-role "button" "-"))
    (expect-attribute p (by-text "-1") "class" "negative")
    (page-click! p (by-role "button" "reset"))
    (expect-text p (by-css ".count") "0")
    (expect-missing p (by-role "button" "reset"))))

(test rows
  (with-page (p "../examples/rows.sub")
    (page-click! p (by-role "button" "create 1,000 rows"))
    (expect-count p (by-css "tbody tr") 1000)
    (expect-text p (by-css "tbody tr:last-child td.id") "1000")
    (page-click! p (by-role "button" "swap rows"))
    (expect-text p (by-css "tbody tr:nth-child(2) td.id") "999")
    (expect-text p (by-css "tbody tr:nth-child(999) td.id") "2")
    (page-click! p (within (nth (by-css "tbody tr") 500) (by-text "remove")))
    (expect-count p (by-css "tbody tr") 999)
    (page-click! p (within (nth (by-css "tbody tr") 3) (by-css "td:nth-child(2) a")))
    (expect-text p (by-css "tr.selected td.id") "3")
    (page-click! p (by-role "button" "update every 10th row"))
    (expect-count p (by-text-containing "!!!") 100)
    (page-click! p (by-role "button" "append 1,000 rows"))
    (expect-count p (by-css "tbody tr") 1999)
    (expect-text p (by-css "tbody tr:last-child td.id") "2000")
    (page-click! p (by-role "button" "clear"))
    (expect-missing p (by-css "tbody tr"))))
