;; The game library's keyboard and mouse state, and its list of sounds to play.
(require-unqualified std/test/test)
(require-unqualified web/game/input)
(require-unqualified web/game/sound)

(define keys input)

(define (see [what string] [code u32])
  (printf "  ~a:" what)
  (when (held? (& keys) code) (printf " held"))
  (when (pressed? (& keys) code) (printf " pressed"))
  (when (released? (& keys) code) (printf " released"))
  (unless (or (held? (& keys) code) (pressed? (& keys) code) (released? (& keys) code)) (printf " nothing"))
  (printf "\n"))

(define (number [n u32]) (printf "~a" n))

(define (see-mouse [what string] [button u32])
  (printf "  ~a:" what)
  (when (mouse-held? (& keys) button) (printf " held"))
  (when (mouse-pressed? (& keys) button) (printf " pressed"))
  (when (mouse-released? (& keys) button) (printf " released"))
  (unless (or (mouse-held? (& keys) button) (mouse-pressed? (& keys) button) (mouse-released? (& keys) button)) (printf " nothing"))
  (printf "; moved ~a ~a\n" (cast i32 (mouse-dx (& keys))) (cast i32 (mouse-dy (& keys)))))

(define (main)
  (printf "key codes\n")
  (printf "  the arrows: ")
  (number (key-code "ArrowLeft")) (printf " ")
  (number (key-code "ArrowRight")) (printf " ")
  (number (key-code "ArrowUp")) (printf " ")
  (number (key-code "ArrowDown")) (printf "\n")
  (printf "  space, Enter, Escape, Shift: ")
  (number (key-code " ")) (printf " ")
  (number (key-code "Enter")) (printf " ")
  (number (key-code "Escape")) (printf " ")
  (number (key-code "Shift")) (printf "\n")
  (printf "  a and A are the same key: ")
  (number (key-code "a")) (printf " ")
  (number (key-code "A")) (printf "\n")
  (printf "  keys without a code: ")
  (number (key-code "Control")) (printf " ")
  (number (key-code "F5")) (printf " ")
  (number (key-code "")) (printf "\n")

  (printf "a key goes down: pressed during the first step only, held until it comes up\n")
  (input-key-down! (& keys) key-right)
  (see "step 1" key-right)
  (input-end-step! (& keys))
  (see "step 2" key-right)
  (input-key-down! (& keys) key-right)
  (input-end-step! (& keys))
  (see "step 3, after an auto-repeat" key-right)
  (input-key-up! (& keys) key-right)
  (see "step 4, after it came up" key-right)
  (input-end-step! (& keys))
  (see "step 5" key-right)

  (printf "a tap that is over before the step still counts as a press\n")
  (input-key-down! (& keys) key-space)
  (input-key-up! (& keys) key-space)
  (see "the step after the tap" key-space)
  (input-end-step! (& keys))
  (see "the step after that" key-space)

  (printf "a key without a code is never recorded\n")
  (input-key-down! (& keys) (key-code "Control"))
  (see "key-none" key-none)

  (printf "clearing forgets held keys\n")
  (input-key-down! (& keys) key-left)
  (input-key-down! (& keys) #\a)
  (input-clear! (& keys))
  (see "left" key-left)
  (see "a" #\a)

  (printf "the mouse: buttons like keys, movement added up over a step\n")
  (input-mouse-down! (& keys) mouse-left)
  (input-mouse-move! (& keys) 12.0 -3.0)
  (input-mouse-move! (& keys) 8.0 -2.0)
  (see-mouse "step 1" mouse-left)
  (input-end-step! (& keys))
  (see-mouse "step 2" mouse-left)
  (input-mouse-up! (& keys) mouse-left)
  (input-mouse-down! (& keys) mouse-right)
  (see-mouse "step 3, left" mouse-left)
  (see-mouse "step 3, right" mouse-right)
  (input-end-step! (& keys))
  (printf "  a button that is not a button: ") (number (cast u32 (mouse-held? (& keys) 7))) (printf "\n")
  (printf "  locked: ") (number (cast u32 (mouse-locked? (& keys))))
  (input-mouse-lock! (& keys) #t)
  (printf ", then ") (number (cast u32 (mouse-locked? (& keys))))
  (input-clear! (& keys))
  (printf ", and after clearing still ") (number (cast u32 (mouse-locked? (& keys)))) (printf "\n")
  (see-mouse "after clearing, right" mouse-right)

  (printf "sounds wait in a list until the game loop plays them\n")
  (play-tone square-wave 300.0 600.0 120.0 0.2)
  (play-tone sawtooth-wave 300.0 60.0 400.0 0.3)
  (printf "  waiting: ") (number (tones-waiting)) (printf "\n")
  (let ([t (tone-at 1)])
    (printf "  the second: wave ") (number (-> t wave))
    (printf ", from ") (number (cast u32 (-> t from)))
    (printf " to ") (number (cast u32 (-> t to)))
    (printf " hertz, ") (number (cast u32 (-> t ms)))
    (printf " ms\n"))
  (tones-clear!)
  (printf "  after clearing: ") (number (tones-waiting)) (printf "\n")
  (for ([i u32 0]) (< i 40) (+= i 1) (play-tone sine-wave 440.0 440.0 50.0 0.1))
  (printf "  of 40 tones in one frame, kept: ") (number (tones-waiting)) (printf "\n"))

(test game-input (expect-output-file "game-input.out" (main)))
