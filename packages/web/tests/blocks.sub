;; The blocks example without a browser: walking, jumping, looking, digging and building.
(require-unqualified std/test/test)
(require-unqualified web/game/format)
(require-unqualified web/game/input)
(require-unqualified web/game/voxels)
(require-unqualified std/web/gpu)
(require-unqualified world web/examples/blocks/world)

(define game world)
(define keys input)

(define (step)
  (world-step! (& game) (& keys))
  (input-end-step! (& keys)))

(define (where)
  (print-format "  the player is at ~.2f ~.2f ~.2f~s, looking ~s\n"
                (-> game player x) (-> game player y) (-> game player z)
                (if (-> game player on-ground) ", on the ground" ", in the air")
                (if (-> game targeted) "at a block" "at nothing")))

(define (target)
  (if (-> game targeted)
      (print-format "  looking at block ~d ~d ~d (~d) through face ~d\n"
                    (-> game target x) (-> game target y) (-> game target z)
                    (block-at (& (-> game grid)) (-> game target x) (-> game target y) (-> game target z)) (-> game target face))
      (printf "  looking at nothing\n")))

(define (gpu-commands-written [what string])
  (let ([b (gpu-commands)])
    (print-format "  ~s: ~d bytes of GPU commands\n" what (-> b length))
    (gpu-commands-done!)))

(define (main)
  (world-init! (& game))
  (printf "the world:\n")
  (print-format "  ~d by ~d by ~d blocks; the land at (0, 0) is ~d high, at (32, 32) ~d, at (63, 63) ~d\n"
                world-width world-height world-depth (top-at (& game) 0 0) (top-at (& game) 32 32) (top-at (& game) 63 63))
  (let ([solid u32 0] [trees u32 0])
    (for ([x i32 0]) (< x world-width) (+= x 1)
      (for ([z i32 0]) (< z world-depth) (+= z 1)
        (for ([y i32 0]) (< y world-height) (+= y 1)
          (when (solid-at? (& (-> game grid)) x y z) (+= solid 1)))
        (when (== (block-at (& (-> game grid)) x (+ (top-at (& game) x z) 0) z) 6) (+= trees 1))))
    (print-format "  ~d solid blocks, ~d columns topped by leaves\n" solid trees))
  (where)
  (gpu-commands-written "setting up")

  (world-draw (& game))
  (gpu-commands-written "the first frame")
  (let ([faces u32 0])
    (for ([i u32 0]) (< i 16) (+= i 1) (+= faces (/ (-> (@ (-> game chunks) i) vertices length) 176)))
    (print-format "  the meshes hold ~d faces\n" faces))
  (world-draw (& game))
  (gpu-commands-written "a frame with nothing changed")

  (printf "falling onto the ground:\n")
  (for ([i u32 0]) (< i 30) (+= i 1) (step))
  (where)

  (printf "walking forward for a second:\n")
  (input-key-down! (& keys) #\w)
  (for ([i u32 0]) (< i 60) (+= i 1) (step))
  (input-key-up! (& keys) #\w)
  (where)

  (printf "a jump:\n")
  (input-key-down! (& keys) key-space)
  (step)
  (input-key-up! (& keys) key-space)
  (where)
  (for ([i u32 0]) (< i 10) (+= i 1) (step))
  (where)
  (for ([i u32 0]) (< i 30) (+= i 1) (step))
  (where)

  (printf "looking down at the ground, and digging:\n")
  (input-key-down! (& keys) key-down)
  (for ([i u32 0]) (< i 40) (+= i 1) (step))
  (input-key-up! (& keys) key-down)
  (target)
  (let ([x (-> game target x)] [y (-> game target y)] [z (-> game target z)])
    (input-key-down! (& keys) #\x)
    (step)
    (input-key-up! (& keys) #\x)
    (print-format "  block ~d ~d ~d is now ~d\n" x y z (block-at (& (-> game grid)) x y z))
    (target)
    (world-draw (& game))
    (gpu-commands-written "the frame after digging")
    (printf "placing sand (key 4):\n")
    (input-key-down! (& keys) #\4)
    (step)
    (input-key-up! (& keys) #\4)
    (input-key-down! (& keys) #\c)
    (step)
    (input-key-up! (& keys) #\c)
    (print-format "  block ~d ~d ~d is now ~d\n" x y z (block-at (& (-> game grid)) x y z))
    (target))

  (printf "the mouse: moving it right turns right, and the left button digs:\n")
  (set! (-> game pitch) 0.0)
  (print-format "  yaw ~.3f" (-> game yaw))
  (input-mouse-lock! (& keys) #t)
  (input-mouse-move! (& keys) 100.0 0.0)
  (step)
  (print-format ", after the mouse moved 100 to the right ~.3f\n" (-> game yaw))
  (input-mouse-move! (& keys) 0.0 300.0)
  (step)
  (target)
  (let ([x (-> game target x)] [y (-> game target y)] [z (-> game target z)])
    (input-mouse-down! (& keys) mouse-left)
    (step)
    (input-mouse-up! (& keys) mouse-left)
    (print-format "  block ~d ~d ~d is now ~d\n" x y z (block-at (& (-> game grid)) x y z)))
  (set! (-> game yaw) 0.0)

  (printf "walking into the trunk of a tree stops the player:\n")
  (set! (-> game pitch) 0.0)
  (let* ([x (cast i32 (floor (-> game player x)))] [z (+ (cast i32 (floor (-> game player z))) 3)]
         [ground (top-at (& game) x z)])
    (for ([y i32 1]) (<= y 4) (+= y 1) (block-set! (& (-> game grid)) x (+ ground y) z 5))
    (input-key-down! (& keys) #\w)
    (for ([i u32 0]) (< i 60) (+= i 1) (step))
    (input-key-up! (& keys) #\w)
    (where)
    (print-format "  hit a wall: ~d\n" (-> game player hit-wall))))

(test blocks (expect-output-file "blocks.out" (main)))
