;; store-get of a removed object stops the program with a message.
(require-unqualified store web/game/store)

(struct enemy [health i32])
(define enemies (store enemy))

(define (main)
  (let ([h (store-handle (& enemies) (store-add! (& enemies)))])
    (set! (-> (store-get (& enemies) h) health) 3)
    (store-remove! (& enemies) h)
    (printf "before\n")
    (set! (-> (store-get (& enemies) h) health) 2)
    (printf "not reached\n")))

(test err-store-gone #:traps "store-get: the object that this handle refers to has been removed" (main))
