;; The valley, a landscape to walk through, as a web page.
(require-unqualified "../../game/game.sub")
(require-unqualified "world.sub")

(game world [size 640 360] [renderer gpu] [pointer lock] world-init! world-step! world-draw)

;; For the browser's console and the tests: window.app.call('look', x, z, yaw, pitch) puts
;; the player there, and window.app.call('clock', seconds) sets the time of day.
(define (look [x f64] [z f64] [yaw f64] [pitch f64]) (world-look! x z yaw pitch))

(define (clock [seconds f64]) (world-time! seconds))
