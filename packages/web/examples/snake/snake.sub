;; Snake, as a web page: the page around rules.sub's game.
(require-unqualified web "../../web.sub")
(require-unqualified canvas "../../canvas.sub")
(require-unqualified rules "rules.sub")
(require-unqualified storage host/web/storage)
(require-unqualified format "../../game/format.sub")

(struct model
  [head event-head]
  [game snake]
  [best u32]
  [redraw u32]
  [seeded bool])

(variant message
  [tick [time f64]]
  [key-pressed [key string]]
  [new-game]
  [best-kept [best u32]])
(messages message)

(define (digits [s string]) -> u32
  (let ([n u32 0] [i u32 0])
    (while (and (< i (-> s length)) (>= (@ s i) #\0) (<= (@ s i) #\9))
      (set! n (+ (* n 10) (- (@ s i) #\0)))
      (+= i 1))
    n))

(define (kept [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (when (and (== kind storage-got) (== value 1))
    (let* ([text (events-take-text)] [e message (best-kept (digits text))])
      (free (-> text bytes))
      (send! (& e)))))

(define (keep-best! [m (ptr model)])
  (let ([text (array u8 16)])
    (storage-set-text "best" (format-into (slice text) "~d" (cast i32 (-> m best))) (cast (ptr void) m))))

(define (restart! [m (ptr model)] [seed u32])
  (snake-reset! (& (-> m game)) seed)
  (+= (-> m redraw) 1))

(define (next-seed [m (ptr model)]) -> u32 (+ (* (-> m redraw) 2654435761) (-> m game score)))

(define (tick! [m (ptr model)] [time f64])
  (unless (-> m seeded)
    (set! (-> m seeded) #t)
    (restart! m (cast u32 (* time 1000.0))))
  (when (snake-advance! (& (-> m game)) time)
    (when (> (-> m game score) (-> m best))
      (set! (-> m best) (-> m game score))
      (keep-best! m))
    (+= (-> m redraw) 1)))

(const no-direction u32 4)

(define (direction-of [key string]) -> u32
  (cond [(or (== key "ArrowUp") (== key "w") (== key "W")) snake-up]
        [(or (== key "ArrowRight") (== key "d") (== key "D")) snake-right]
        [(or (== key "ArrowDown") (== key "s") (== key "S")) snake-down]
        [(or (== key "ArrowLeft") (== key "a") (== key "A")) snake-left]
        [else no-direction]))

(define (key! [m (ptr model)] [key string])
  (let ([direction (direction-of key)])
    (cond [(!= direction no-direction)
           (prevent-default!)
           (snake-turn! (& (-> m game)) direction)]
          [(== key " ")
           (prevent-default!)
           (snake-toggle-pause! (& (-> m game)))]
          [(== key "Enter")
           (prevent-default!)
           (restart! m (next-seed m))])
    (+= (-> m redraw) 1)))

(define (update [m (ptr model)] [e (ptr message)])
  (match e
    [(tick time) (tick! m time)]
    [(key-pressed key) (key! m key)]
    [new-game (restart! m (next-seed m))]
    [(best-kept best) (set! (-> m best) best)]))

(define (init [m (ptr model)])
  (set! (-> m head handle) kept)
  (storage-get "best" (cast (ptr void) m))
  (restart! m 1))

(define (draw-game [m (ptr model)])
  (let* ([g (& (-> m game))] [state (-> g state)])
    (fill-style "#10141a")
    (fill-rect 0 0 400 400)

    (fill-style "#e5534b")
    (fill-circle (+ (* (-> g food x) 20) 10) (+ (* (-> g food y) 20) 10) 7)

    (fill-style "#57ab5a")
    (for ([i u32 1]) (< i (-> g length)) (+= i 1)
      (let ([c (snake-segment g i)])
        (fill-rect (+ (* (-> c x) 20) 1) (+ (* (-> c y) 20) 1) 18 18)))
    (let ([head (snake-segment g 0)])
      (fill-style "#b4f1a7")
      (fill-rect (+ (* (-> head x) 20) 1) (+ (* (-> head y) 20) 1) 18 18))

    (when (or (== state snake-paused) (== state snake-over) (== state snake-won))
      (global-alpha 0.55)
      (fill-style "#10141a")
      (fill-rect 0 0 400 400)
      (global-alpha 1))))

(define (status [m (ptr model)]) -> string
  (let ([state (-> m game state)])
    (cond [(== state snake-waiting) "Press an arrow key to start."]
          [(== state snake-paused) "Paused. Press Space to continue."]
          [(== state snake-over) "Game over. Press Enter to play again."]
          [(== state snake-won) "You filled the board! Press Enter to play again."]
          [else "Arrow keys or W A S D to turn. Space to pause."])))

(view (page [m (ptr model)])
  (div ([class "snake"])
    (header
      (h1 "snake")
      (p "Score " (span ([id "score"]) (int (-> m game score)))
         "  Best " (span ([id "best"]) (int (-> m best)))))
    (canvas ([id "board"] [width 400] [height 400]
             [on-window frame (tick (event time))]
             [on-window keydown (key-pressed (event key))]
             [draw (-> m redraw) (draw-game m)]))
    (p ([id "status"]) (text (status m)))
    (button ([id "new-game"] [on click new-game]) "New game")))

(app model message init update page)
