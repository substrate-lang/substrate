;; Land as a height map: meshed for the scene, asked for its height and slope, walked on.
(require-unqualified std/web/gpu)
(require-unqualified "../scene/meshes.sub")

(provide terrain terrain-init! terrain-free! terrain-set! terrain-height terrain-slope terrain-mesh! terrain-texture!
         walker walker-move!)

(struct terrain [columns i32] [rows i32] [spacing f64] [heights (ptr f32)])

(define (terrain-init! [t (ptr terrain)] [columns i32] [rows i32] [spacing f64])
  (set! (-> t columns) columns)
  (set! (-> t rows) rows)
  (set! (-> t spacing) spacing)
  (set! (-> t heights) (cast (ptr f32) (calloc (cast u32 (* columns rows)) 4))))

(define (terrain-free! [t (ptr terrain)])
  (free (-> t heights))
  (set! (-> t heights) 0))

(define (clamp-index [i i32] [n i32]) -> i32 (if (< i 0) 0 (if (>= i n) (- n 1) i)))

(define (height-at [t (ptr terrain)] [column i32] [row i32]) -> f64
  (cast f64 (@ (-> t heights) (cast u32 (+ (* (clamp-index row (-> t rows)) (-> t columns)) (clamp-index column (-> t columns)))))))

(define (terrain-set! [t (ptr terrain)] [column i32] [row i32] [height f64])
  (set! (@ (-> t heights) (cast u32 (+ (* row (-> t columns)) column))) (cast f32 height)))

(define (terrain-height [t (ptr terrain)] [x f64] [z f64]) -> f64
  (let* ([u (/ x (-> t spacing))] [v (/ z (-> t spacing))]
         [c (cast i32 (floor u))] [r (cast i32 (floor v))]
         [fu (- u (floor u))] [fv (- v (floor v))]
         [top (+ (* (height-at t c r) (- 1.0 fu)) (* (height-at t (+ c 1) r) fu))]
         [bottom (+ (* (height-at t c (+ r 1)) (- 1.0 fu)) (* (height-at t (+ c 1) (+ r 1)) fu))])
    (+ (* top (- 1.0 fv)) (* bottom fv))))

(define (terrain-slope [t (ptr terrain)] [x f64] [z f64]) -> f64
  (let ([d (* (-> t spacing) 0.5)])
    (let ([dx (/ (- (terrain-height t (+ x d) z) (terrain-height t (- x d) z)) (* 2.0 d))]
          [dz (/ (- (terrain-height t x (+ z d)) (terrain-height t x (- z d))) (* 2.0 d))])
      (sqrt (+ (* dx dx) (* dz dz))))))

(define (terrain-mesh! [t (ptr terrain)] [vertices (ptr buffer)] [indices (ptr buffer)] [tile-x f64] [tile-y f64] [material u32]
                       [color-of (fn (f64 f64 f64 f64) -> u32)])
  (let ([spacing (-> t spacing)])
    (for ([row i32 0]) (< row (-> t rows)) (+= row 1)
      (for ([column i32 0]) (< column (-> t columns)) (+= column 1)
        (let* ([x (* (cast f64 column) spacing)] [z (* (cast f64 row) spacing)]
               [h (height-at t column row)]
               [dx (/ (- (height-at t (+ column 1) row) (height-at t (- column 1) row)) (* 2.0 spacing))]
               [dz (/ (- (height-at t column (+ row 1)) (height-at t column (- row 1))) (* 2.0 spacing))]
               [length (sqrt (+ (* dx dx) 1.0 (* dz dz)))]
               [slope (sqrt (+ (* dx dx) (* dz dz)))])
          (buffer-add-f32! vertices x)
          (buffer-add-f32! vertices h)
          (buffer-add-f32! vertices z)
          (buffer-add-f32! vertices (/ (- 0.0 dx) length))
          (buffer-add-f32! vertices (/ 1.0 length))
          (buffer-add-f32! vertices (/ (- 0.0 dz) length))
          (buffer-add-f32! vertices tile-x)
          (buffer-add-f32! vertices tile-y)
          (buffer-add-f32! vertices 1.0)
          (buffer-add-f32! vertices (cast f64 material))
          (buffer-add-u32! vertices (mesh-color (color-of x z h slope) 0.0)))))
    ;; Two triangles per cell, counter-clockwise seen from above.
    (for ([row i32 0]) (< row (- (-> t rows) 1)) (+= row 1)
      (for ([column i32 0]) (< column (- (-> t columns) 1)) (+= column 1)
        (let* ([a (cast u32 (+ (* row (-> t columns)) column))]
               [b (+ a 1)]
               [c (+ a (cast u32 (-> t columns)))]
               [d (+ c 1)])
          (buffer-add-u32! indices a) (buffer-add-u32! indices c) (buffer-add-u32! indices b)
          (buffer-add-u32! indices b) (buffer-add-u32! indices c) (buffer-add-u32! indices d))))))

(define (half [x f32]) -> u32
  (let* ([bits (cast u32 (f32-bits x))]
         [sign (bit-and (>> bits 16) #x8000)]
         [exponent (- (cast i32 (bit-and (>> bits 23) 255)) 127)]
         [mantissa (bit-and bits #x7fffff)])
    (cond [(> exponent 15) (bit-or sign #x7c00)]
          [(< exponent -14) sign]
          [else
           (let ([h (bit-or sign (<< (cast u32 (+ exponent 15)) 10) (>> mantissa 13))])
             (if (!= (bit-and mantissa #x1000) 0) (+ h 1) h))])))

(define (terrain-texture! [t (ptr terrain)]) -> u32
  (let* ([n (cast u32 (* (-> t columns) (-> t rows)))]
         [texels (cast (ptr u16) (gpu-frame-alloc (* n 8)))]
         [texture (gpu-texture! (cast u32 (-> t columns)) (cast u32 (-> t rows)) 1 1 gpu-rgba16f gpu-sampled)])
    (for ([i u32 0]) (< i n) (+= i 1)
      (set! (@ texels (* i 4)) (cast u16 (half (@ (-> t heights) i))))
      (set! (@ texels (+ (* i 4) 1)) 0)
      (set! (@ texels (+ (* i 4) 2)) 0)
      (set! (@ texels (+ (* i 4) 3)) (cast u16 #x3c00)))
    (gpu-write-texture! texture 0 0 0 0 (cast u32 (-> t columns)) (cast u32 (-> t rows)) texels (* n 8))
    texture))

(struct walker [x f64] [y f64] [z f64] [vy f64] [on-ground bool])

(define (walker-move! [t (ptr terrain)] [w (ptr walker)] [dx f64] [dz f64])
  (+= (-> w x) dx)
  (+= (-> w z) dz)
  (+= (-> w y) (-> w vy))
  (let ([ground (terrain-height t (-> w x) (-> w z))])
    (if (<= (-> w y) ground)
        (begin
          (set! (-> w y) ground)
          (set! (-> w vy) 0.0)
          (set! (-> w on-ground) #t))
        (set! (-> w on-ground) #f))))
