;; SQLite's files, on the host's (host/fs.sub): the VFS sqlite3_os_init registers as SQLite starts, with locks between the
;; connections of one instance of the program.
(require-unqualified fs host/fs)
(require-unqualified clock host/modules/clock)
(require-unqualified random host/modules/random)
(require sqlite3 "sqlite3.wasm" sqlite3_initialize sqlite3_vfs_register)

(provide vfs-start! c-string c-copy)

;; SQLite's result codes, open flags and lock levels.
(const ok i32 0)
(const busy i32 5)
(const not-found i32 12)
(const cannot-open i32 14)
(const read-error i32 266)
(const short-read i32 522)
(const write-error i32 778)
(const sync-error i32 1034)
(const truncate-error i32 1546)
(const size-error i32 1802)
(const delete-error i32 2570)
(const close-error i32 4106)
(const deleted-missing i32 5898)

(const open-read-only i32 1)
(const open-read-write i32 2)
(const open-create i32 4)
(const open-delete-on-close i32 8)
(const open-exclusive i32 16)

(const shared i32 1)
(const pending i32 3)
(const exclusive i32 4)

;; sqlite3_io_methods, version 1, and sqlite3_vfs, version 2.
(struct io-methods [version i32] [close i32] [read i32] [write i32] [truncate i32] [sync i32] [size i32] [lock i32]
  [unlock i32] [check-reserved-lock i32] [file-control i32] [sector-size i32] [device-characteristics i32])

(struct vfs [version i32] [file-size i32] [max-pathname i32] [next i32] [name i32] [app-data i32] [open i32]
  [delete i32] [access i32] [full-pathname i32] [dl-open i32] [dl-error i32] [dl-sym i32] [dl-close i32]
  [randomness i32] [sleep i32] [current-time i32] [last-error i32] [current-time-int64 i32])

;; A path's lock, which its open files share: the strongest any holds, and how many hold a shared lock or more.
(struct lock-node [next (ptr lock-node)] [path string] [lock i32] [shared i32] [files i32])

(struct vfs-file [methods (ptr io-methods)] [handle u32] [lock i32] [node (ptr lock-node)] [delete bool] [path string])

(define methods io-methods)
(define the-vfs vfs)
(define nodes (ptr lock-node) 0)

(define (c-string [p (ptr u8)]) -> string
  (let ([n u32 0])
    (while (!= (@ p n) 0) (+= n 1))
    (cast string (slice p n))))

;; c-copy gives s with a 0 after it, from malloc.
(define (c-copy [s string]) -> (ptr u8)
  (let ([p (cast (ptr u8) (malloc (+ (-> s length) 1)))])
    (memcpy p (-> s bytes) (-> s length))
    (set! (@ p (-> s length)) 0)
    p))

(define (node-of [path string]) -> (ptr lock-node)
  (let ([n nodes])
    (while (!= n 0)
      (when (== (-> n path) path)
        (+= (-> n files) 1)
        (return n))
      (set! n (-> n next)))
    (set! n (cast (ptr lock-node) (calloc 1 (sizeof lock-node))))
    (set! (-> n path) (string-copy path))
    (set! (-> n files) 1)
    (set! (-> n next) nodes)
    (set! nodes n)
    n))

(define (node-done! [n (ptr lock-node)])
  (-= (-> n files) 1)
  (when (== (-> n files) 0)
    (if (== nodes n)
        (set! nodes (-> n next))
        (let ([p nodes])
          (while (!= (-> p next) n) (set! p (-> p next)))
          (set! (-> p next) (-> n next))))
    (free (cast (ptr void) (-> n path bytes)))
    (free (cast (ptr void) n))))

;; ---- files ----

(define (file-close [f (ptr vfs-file)]) -> i32
  (let ([r (fs-close-file (-> f handle) 0)])
    (file-unlock f 0)
    (node-done! (-> f node))
    (when (-> f delete) (fs-remove (-> f path) #f 0))
    (free (cast (ptr void) (-> f path bytes)))
    (if (< r 0) close-error ok)))

(define (file-read [f (ptr vfs-file)] [buf (ptr u8)] [n i32] [at i64]) -> i32
  (let ([got (fs-read-at (-> f handle) (slice buf (cast u32 n)) at 0)])
    (cond [(< got 0) read-error]
          [(< got n)
           (memset (+ buf got) 0 (cast u32 (- n got)))
           short-read]
          [else ok])))

(define (file-write [f (ptr vfs-file)] [buf (ptr u8)] [n i32] [at i64]) -> i32
  (if (< (fs-write-at (-> f handle) (slice buf (cast u32 n)) at 0) 0) write-error ok))

(define (file-truncate [f (ptr vfs-file)] [n i64]) -> i32
  (if (< (fs-set-size (-> f handle) n 0) 0) truncate-error ok))

(define (file-sync [f (ptr vfs-file)] [flags i32]) -> i32
  (if (< (fs-sync (-> f handle) 0) 0) sync-error ok))

(define (file-size [f (ptr vfs-file)] [out (ptr i64)]) -> i32
  (let ([n (fs-size (-> f handle) 0)])
    (when (< n 0) (return size-error))
    (set! (@ out 0) n)
    ok))

;; The locks of unixLock and posixUnlock, within the program.
(define (file-lock [f (ptr vfs-file)] [level i32]) -> i32
  (let ([n (-> f node)])
    (cond [(>= (-> f lock) level) ok]
          [(and (!= (-> f lock) (-> n lock)) (or (>= (-> n lock) pending) (> level shared))) busy]
          [(== level shared)
           (if (== (-> n lock) 0)
               (begin (set! (-> n lock) shared) (set! (-> n shared) 1))
               (+= (-> n shared) 1))
           (set! (-> f lock) shared)
           ok]
          [(and (== level exclusive) (> (-> n shared) 1))
           (set! (-> f lock) pending)
           (set! (-> n lock) pending)
           busy]
          [else
           (set! (-> f lock) level)
           (set! (-> n lock) level)
           ok])))

(define (file-unlock [f (ptr vfs-file)] [level i32]) -> i32
  (let ([n (-> f node)])
    (when (> (-> f lock) level)
      (when (> (-> f lock) shared) (set! (-> n lock) shared))
      (when (== level 0)
        (-= (-> n shared) 1)
        (when (== (-> n shared) 0) (set! (-> n lock) 0)))
      (set! (-> f lock) level))
    ok))

(define (file-check-reserved-lock [f (ptr vfs-file)] [out (ptr i32)]) -> i32
  (set! (@ out 0) (if (> (-> f node lock) shared) 1 0))
  ok)

(define (file-control [f (ptr vfs-file)] [op i32] [arg i32]) -> i32 not-found)

(define (file-sector-size [f (ptr vfs-file)]) -> i32 4096)

(define (file-device-characteristics [f (ptr vfs-file)]) -> i32 0)

;; ---- the VFS ----

;; A file opened to read and write is opened to read only when it cannot be.
(define (vfs-open [v i32] [name (ptr u8)] [f (ptr vfs-file)] [flags i32] [out (ptr i32)]) -> i32
  (let ([path string] [h u32 0] [write (!= (bit-and flags open-read-write) 0)])
    (set! (-> f methods) 0)
    (if (== name 0)
        (when (< (fs-make-temp-file "" "sqlite-" "" (& path) 0) 0) (return cannot-open))
        (set! path (string-copy (c-string name))))
    (set! h (fs-open-file path
                          (bit-or fs-read-flag
                                  (if write fs-write-flag 0)
                                  (if (!= (bit-and flags open-create) 0) fs-create-flag 0)
                                  (if (!= (bit-and flags open-exclusive) 0) fs-create-new-flag 0))
                          0))
    (when (and (== h 0) write)
      (set! h (fs-open-file path fs-read-flag 0))
      (set! flags (bit-or (bit-and flags (bit-not (bit-or open-read-write open-create))) open-read-only)))
    (when (== h 0)
      (free (cast (ptr void) (-> path bytes)))
      (return cannot-open))
    (set! (-> f handle) h)
    (set! (-> f lock) 0)
    (set! (-> f node) (node-of path))
    (set! (-> f delete) (or (== name 0) (!= (bit-and flags open-delete-on-close) 0)))
    (set! (-> f path) path)
    (set! (-> f methods) (& methods))
    (when (!= out 0) (set! (@ out 0) flags))
    ok))

(define (vfs-delete [v i32] [name (ptr u8)] [sync-directory i32]) -> i32
  (let ([path (c-string name)] [info fs-info])
    (cond [(== (fs-remove path #f 0) 0) ok]
          [(< (fs-stat path (& info) 0) 0) deleted-missing]
          [else delete-error])))

;; A file exists for SQLite when it is not empty.
(define (vfs-access [v i32] [name (ptr u8)] [flags i32] [out (ptr i32)]) -> i32
  (let ([info fs-info])
    (set! (@ out 0) (if (and (== (fs-stat (c-string name) (& info) 0) 0)
                             (or (!= flags 0) (!= (-> info kind) fs-file) (> (-> info size) 0)))
                        1
                        0))
    ok))

(define (vfs-full-pathname [v i32] [name (ptr u8)] [room i32] [out (ptr u8)]) -> i32
  (let ([path (c-string name)] [b (make-buffer)] [cwd string] [n u32 0])
    (unless (and (> (-> path length) 0) (== (@ path 0) 47))
      (when (< (fs-cwd (& cwd) 0) 0) (return cannot-open))
      (buffer-add-string! (& b) cwd)
      (buffer-add-byte! (& b) 47)
      (free (cast (ptr void) (-> cwd bytes))))
    (buffer-add-string! (& b) path)
    (set! n (-> b length))
    (when (< n (cast u32 room))
      (memcpy out (-> b bytes) n)
      (set! (@ out n) 0))
    (buffer-free! (& b))
    (if (< n (cast u32 room)) ok cannot-open)))

(define (vfs-randomness [v i32] [n i32] [out (ptr u8)]) -> i32
  (random-fill (slice out (cast u32 n)))
  n)

(define (vfs-sleep [v i32] [microseconds i32]) -> i32 0)

;; The current time as a Julian day number, and in milliseconds since the Julian epoch.
(define (vfs-current-time [v i32] [out (ptr f64)]) -> i32
  (set! (@ out 0) (+ (/ (clock-now) 86400000.0) 2440587.5))
  ok)

(define (vfs-current-time-int64 [v i32] [out (ptr i64)]) -> i32
  (set! (@ out 0) (+ (cast i64 (clock-now)) 210866760000000))
  ok)

(define (vfs-last-error [v i32] [n i32] [out (ptr u8)]) -> i32 0)

;; os-init is sqlite3_os_init: it fills the VFS's structs and registers it as the default.
(define (os-init) -> i32
  (set! (-> methods version) 1)
  (set! (-> methods close) (cast i32 file-close))
  (set! (-> methods read) (cast i32 file-read))
  (set! (-> methods write) (cast i32 file-write))
  (set! (-> methods truncate) (cast i32 file-truncate))
  (set! (-> methods sync) (cast i32 file-sync))
  (set! (-> methods size) (cast i32 file-size))
  (set! (-> methods lock) (cast i32 file-lock))
  (set! (-> methods unlock) (cast i32 file-unlock))
  (set! (-> methods check-reserved-lock) (cast i32 file-check-reserved-lock))
  (set! (-> methods file-control) (cast i32 file-control))
  (set! (-> methods sector-size) (cast i32 file-sector-size))
  (set! (-> methods device-characteristics) (cast i32 file-device-characteristics))
  (set! (-> the-vfs version) 2)
  (set! (-> the-vfs file-size) (cast i32 (sizeof vfs-file)))
  (set! (-> the-vfs max-pathname) 1024)
  (set! (-> the-vfs name) (cast i32 (c-copy "substrate")))
  (set! (-> the-vfs open) (cast i32 vfs-open))
  (set! (-> the-vfs delete) (cast i32 vfs-delete))
  (set! (-> the-vfs access) (cast i32 vfs-access))
  (set! (-> the-vfs full-pathname) (cast i32 vfs-full-pathname))
  (set! (-> the-vfs randomness) (cast i32 vfs-randomness))
  (set! (-> the-vfs sleep) (cast i32 vfs-sleep))
  (set! (-> the-vfs current-time) (cast i32 vfs-current-time))
  (set! (-> the-vfs last-error) (cast i32 vfs-last-error))
  (set! (-> the-vfs current-time-int64) (cast i32 vfs-current-time-int64))
  (sqlite3_vfs_register (cast i32 (& the-vfs)) 1))

(define (os-end) -> i32 ok)

(supply sqlite3:sqlite3_os_init os-init)
(supply sqlite3:sqlite3_os_end os-end)

;; vfs-start! starts SQLite, returning its result.
(define (vfs-start!) -> i32 (sqlite3_initialize))
