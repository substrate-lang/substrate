;; A page with SQLite: a database in the page's files, written, closed, and read again.
(require-unqualified std/web/dom)
(require-unqualified sqlite)

(define (main)
  (let ([page (dom-add! (dom-template "<p id=\"version\"><!--t--></p><p id=\"rows\"><!--t--></p><p id=\"error\"><!--t--></p>") 0 0)]
        [why string] [db (sqlite-open "notes.db" 0)] [b (make-buffer)] [st (ptr sqlite-statement) 0] [error string ""])
    (dom-set-text! (+ page 1) (sqlite-version))
    (when (< (sqlite-exec db "create table notes (s text); insert into notes values ('one'), ('two'), ('three')" (& why)) 0)
      (set! error why))
    (sqlite-close db)
    (set! db (sqlite-open "notes.db" 0))
    (set! st (sqlite-prepare db "select count(*), group_concat(s, ' ') from notes" (& why)))
    (when (== st 0) (set! error why))
    (when (== (sqlite-step st 0) sqlite-row)
      (write-digits (& b) (cast u64 (sqlite-column-i64 st 0)) 10)
      (buffer-add-byte! (& b) 32)
      (buffer-add-string! (& b) (sqlite-column-text st 1)))
    (sqlite-finalize st)
    (sqlite-close db)
    (dom-set-text! (+ page 2) (buffer-string (& b)))
    (dom-set-text! (+ page 3) error)
    (dom-flush!)))
