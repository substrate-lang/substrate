;; SQLite on the host's files: a database made, filled and read again, a transaction rolled back, and a second
;; connection.
(require-unqualified sqlite)
(require-unqualified host/fs)
(provide main)

(define root string "")

(define (in-build [name string]) -> string
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) root)
    (buffer-add-string! (& b) "/sqlite-files/")
    (buffer-add-string! (& b) name)
    (buffer-string (& b))))

(define (rows [db (ptr sqlite)]) -> i64
  (let ([st (sqlite-prepare db "select count(*) from t" 0)] [n i64 0])
    (sqlite-step st 0)
    (set! n (sqlite-column-i64 st 0))
    (sqlite-finalize st)
    n))

(define (exists? [path string]) -> bool (let ([info fs-info]) (== (fs-stat path (& info) 0) 0)))

(define (main [dir string])
  (set! root dir)
  (let ([why string] [path (in-build "test.db")] [db (ptr sqlite) 0] [other (ptr sqlite) 0] [st (ptr sqlite-statement) 0])
    (fs-remove (in-build "") #t 0)
    (fs-make-dir (in-build "") 0)
    (set! db (sqlite-open path (& why)))
    (printf "open: ~a\n" (if (== db 0) why "done"))
    (sqlite-exec db "create table t (n integer, s text)" 0)
    (sqlite-exec db "begin" 0)
    (set! st (sqlite-prepare db "insert into t values (?, ?)" 0))
    (for ([i 0]) (< i 1000) (+= i 1)
      (sqlite-bind! st 1 i)
      (sqlite-bind! st 2 "a row of text")
      (sqlite-step st 0)
      (sqlite-reset st))
    (sqlite-finalize st)
    (printf "commit: ~a\n" (if (< (sqlite-exec db "commit" (& why)) 0) why "done"))
    (sqlite-close db)
    (printf "database file: ~a, journal: ~a\n" (if (exists? path) "kept" "missing")
            (if (exists? (in-build "test.db-journal")) "kept" "removed"))
    (set! db (sqlite-open path 0))
    (printf "rows after reopening: ~a\n" (rows db))
    (sqlite-exec db "begin; delete from t" 0)
    (printf "rows within a transaction that deleted them: ~a\n" (rows db))
    (sqlite-exec db "rollback" 0)
    (printf "rows after rolling it back: ~a\n" (rows db))
    (set! other (sqlite-open path 0))
    (set! st (sqlite-prepare other "select n from t" 0))
    (sqlite-step st 0)
    (printf "insert while the other reads: ~a\n" (if (< (sqlite-exec db "insert into t values (1000, 'more')" (& why)) 0) why "done"))
    (sqlite-finalize st)
    (printf "insert after: ~a\n" (if (< (sqlite-exec db "insert into t values (1000, 'more')" (& why)) 0) why "done"))
    (printf "rows the other sees: ~a\n" (rows other))
    (sqlite-close other)
    (sqlite-close db)
    (fs-remove (in-build "") #t 0)))
