;; SQLite in a page, in Chromium.
(require-unqualified std/test/browser)

(test page
  (with-browser (b "pages/sqlite.sub")
    (expect-text b (by-css "#version") "3.51.2")
    (expect-text b (by-css "#rows") "3 one two three")
    (expect-text b (by-css "#error") "")
    (expect-equal (browser-console b) "")))
