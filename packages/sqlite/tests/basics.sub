;; SQLite in memory: bound values of each type read back, a statement reset and run again, several statements at once,
;; JSON, and failures.
(require-unqualified tests std/test/test)
(require-unqualified sqlite sqlite)

(define (type-name [t i32]) -> string
  (cond [(== t sqlite-integer) "integer"]
        [(== t sqlite-float) "float"]
        [(== t sqlite-text) "text"]
        [(== t sqlite-blob) "blob"]
        [else "null"]))

(define (show-rows [db (ptr sqlite)] [sql string])
  (let* ([why string] [st (sqlite-prepare db sql (& why))] [n (sqlite-column-count st)])
    (while (== (sqlite-step st (& why)) sqlite-row)
      (for ([i 0]) (< i n) (+= i 1)
        (let ([t (sqlite-column-type st i)])
          (printf "~a~a ~a" (if (== i 0) "" ", ") (sqlite-column-name st i) (type-name t))
          (cond [(== t sqlite-integer) (printf " ~a" (sqlite-column-i64 st i))]
                [(== t sqlite-float) (printf " ~a" (sqlite-column-f64 st i))]
                [(== t sqlite-text) (printf " ~s" (sqlite-column-text st i))]
                [(== t sqlite-blob) (printf " ~s" (cast string (sqlite-column-blob st i)))])))
      (printf "\n"))
    (sqlite-finalize st)))

(define (main)
  (let* ([why string] [db (sqlite-open ":memory:" (& why))] [st (ptr sqlite-statement) 0])
    (printf "version ~a\n" (sqlite-version))
    (sqlite-exec db "create table t (id integer primary key, name text, score real, data blob, note text)" 0)
    (set! st (sqlite-prepare db "insert into t (name, score, data, note) values (?, ?, ?, ?)" (& why)))
    (sqlite-bind! st 1 "ada")
    (sqlite-bind! st 2 9.5)
    (sqlite-bind! st 3 (cast (slice u8) "abc"))
    (sqlite-bind-null st 4)
    (sqlite-step st 0)
    (printf "inserted row ~a\n" (sqlite-last-insert-rowid db))
    (sqlite-reset st)
    (sqlite-bind! st 1 "")
    (sqlite-bind! st 2 7)
    (sqlite-bind! st 3 (cast (slice u8) ""))
    (sqlite-bind! st 4 "héllo")
    (sqlite-step st 0)
    (printf "inserted row ~a\n" (sqlite-last-insert-rowid db))
    (sqlite-finalize st)
    (show-rows db "select id, name, score, data, note, length(note) as letters from t order by id")
    (sqlite-exec db "update t set score = score + 1" 0)
    (printf "updated ~a rows\n" (sqlite-changes db))
    (printf "several statements: ~a\n" (sqlite-exec db "insert into t (name) values ('x'); insert into t (name) values ('y');" 0))
    (show-rows db "select count(*) as rows, json_extract('{\"a\": [1, 2]}', '$.a[1]') as second from t")
    (printf "incomplete: ~a\n" (if (< (sqlite-exec db "create table" (& why)) 0) why "ran"))
    (printf "constraint: ~a\n" (if (< (sqlite-exec db "insert into t (id) values (1)" (& why)) 0) why "ran"))
    (printf "missing: ~a\n" (if (== (sqlite-prepare db "select * from absent" (& why)) 0) why "prepared"))
    (printf "no statement: ~a\n" (if (== (sqlite-prepare db "-- only a comment" (& why)) 0) why "prepared"))
    (sqlite-close db)))

(test basics (expect-output-file "basics.out" (main)))
