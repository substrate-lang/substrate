;; An eq? hash table's key must carry a hash; a pair does not.
(language scheme scheme)
(define (run) (hash-set! (make-hasheq) (list 1 2) 'x))
(define (main) (run))

(test err-scheme-eq-key #:traps "hash-set!: expected a key with a hash (a symbol, keyword, struct, number, character, boolean or ()); make-hash takes others, got (1 2)" (main))
