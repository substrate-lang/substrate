;; The programs in programs/, each built and run in a process of its own.
(require-unqualified build std/test/build)

(test constants (expect-run "programs/constants.sub" #:output-file "programs/constants.out"))
(test err-scheme-exit (expect-run "programs/err-scheme-exit.sub" #:fails "leaving"))
(test err-scheme-file (expect-run "programs/err-scheme-file.sub" #:grants ("-R=.") #:fails "error: trap: file->bytes: no-such-file.txt: No such file or directory"))
(test err-wind-foreign (expect-run "programs/err-wind-foreign.sub" #:fails "the after thunk ran"))
(test scheme-exceptions (expect-run "programs/scheme-exceptions.sub" #:grants ("-R=.") #:output-file "programs/scheme-exceptions.out"))
(test scheme-files (expect-run "programs/scheme-files.sub" #:grants ("-R=@build" "-W=@build") #:args ("@build/scheme-files.txt" "second") #:output-file "programs/scheme-files.out"))
