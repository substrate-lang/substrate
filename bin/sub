#!/usr/bin/env bash
# The command for programs: build, eval and expand run the compiler, first building it from the seed if its
# sources changed; run and site are the host's; serve and pack build and run lib/http/serve.sub and lib/web/pack.sub.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
here="$PWD"

case "${1:-}" in
  run) shift; exec "$root/host/subhost.mjs" "$@" ;;
  site) shift; exec "$root/host/web/site.sh" "$@" ;;
  serve)
    shift
    grant=net
    if [ "${1:-}" = -t ] && [ $# -ge 3 ]; then grant="net=tls:$2:$3"; fi
    "$root/bin/sub" build "$root/lib/http/serve.sub" -o "$root/build/serve" || exit 1
    exec "$root/host/subhost.mjs" -g "$grant,fs" "$root/build/serve" "$@" ;;
  pack)
    shift
    "$root/bin/sub" build "$root/lib/web/pack.sub" -o "$root/build/pack" || exit 1
    exec "$root/host/subhost.mjs" -g fs "$root/build/pack" "$@" ;;
esac

stage() {
  rm -rf "${2:?}"
  (cd "$root" && "$root/host/subhost.mjs" "$1" "$root" build compiler/main.sub -o "$2" -p "$root" -d "$root")
}

out="$root/build/sub"
if [ ! -f "$out/program" ] ||
   [ -n "$(find "$root/compiler" "$root/host/fs.sub" "$root/seed/program" -newer "$out/program" | head -1)" ]; then
  stage "$root/seed" "$root/build/sub-1"
  stage "$root/build/sub-1" "$out"
fi

package="$root"
n=$#
for ((k = 0; k < n; k++)); do
  if [ "$1" = -p ] && [ $((k + 1)) -lt $n ]; then package="$(cd "$2" && pwd)"; shift 2; k=$((k + 1))
  else set -- "$@" "$1"; shift; fi
done

case " $* " in *" -c "*) ;; *) set -- "$@" -c "$root/build/cache" ;; esac

cd "$package"
exec "$root/host/subhost.mjs" "$out" "$root" "$@" -p "$package" -d "$here"
