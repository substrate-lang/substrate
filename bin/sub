#!/usr/bin/env bash
# The command for programs: builds the compiler from the seed and sub, cmd/sub/sub.sub, with it when their sources
# changed, then runs sub with every grant, which does the rest.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

stage() {
  rm -rf "${2:?}"
  (cd "$root" && "$root/host/subhost.mjs" -R="${root//,/,,}" -W="${2//,/,,}" "$1" "$root" build compiler/main.sub -o "$2" \
                   -d "$root")
}

compiler="$root/build/compiler"
if [ ! -f "$compiler/program" ] ||
   [ -n "$(find "$root/compiler" "$root/host/fs.sub" "$root/seed/program" -newer "$compiler/program" | head -1)" ]; then
  stage "$root/seed" "$root/build/compiler-1"
  stage "$root/build/compiler-1" "$compiler"
fi

tool="$root/build/sub"
if [ ! -f "$tool/program" ] ||
   [ -n "$(find "$compiler/program" "$root/cmd" "$root/std" "$root/host" -newer "$tool/program" | head -1)" ]; then
  rm -rf "${tool:?}"
  "$root/host/subhost.mjs" -R="${root//,/,,}" -W="${tool//,/,,},${root//,/,,}/build/sub-cache" "$compiler" "$root" \
    build cmd/sub/sub.sub -o "$tool" -c "$root/build/sub-cache" -d "$root"
fi

exec "$root/host/subhost.mjs" -A "$tool" "$root" "$@"
