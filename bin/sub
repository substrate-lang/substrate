#!/usr/bin/env bash
# The command for programs: build, eval and expand run the compiler, first building it from the seed if its
# sources changed; run, site and serve are the host's.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
here="$PWD"

case "${1:-}" in
  run) shift; exec "$root/host/subhost.mjs" "$@" ;;
  site) shift; exec "$root/host/web/site.sh" "$@" ;;
  serve) shift; exec "$root/host/web/serve.mjs" "$@" ;;
esac

stage() {
  rm -rf "${2:?}"
  (cd "$root" && "$root/host/subhost.mjs" "$1" "$root" build compiler/main.sub -o "$2" -p "$root" -d "$root")
}

out="$root/build/sub"
if [ ! -f "$out/program" ] ||
   [ -n "$(find "$root/compiler" "$root/host/host.sub" "$root/host/fs.sub" "$root/seed/program" -newer "$out/program" | head -1)" ]; then
  stage "$root/seed" "$root/build/sub-1"
  stage "$root/build/sub-1" "$out"
fi

package="$root"
n=$#
for ((k = 0; k < n; k++)); do
  if [ "$1" = -p ] && [ $((k + 1)) -lt $n ]; then package="$(cd "$2" && pwd)"; shift 2; k=$((k + 1))
  else set -- "$@" "$1"; shift; fi
done

case " $* " in *" -c "*) ;; *) set -- "$@" -c "$root/build/cache" ;; esac

cd "$package"
exec "$root/host/subhost.mjs" "$out" "$root" "$@" -p "$package" -d "$here"
