#!/usr/bin/env bash
# The command for programs. It builds the compiler from the seed when the compiler's sources change, and builds sub with
# the seed's sub and that compiler when sub's sources change. Then it runs sub with every grant.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

stage() {
  rm -rf "${2:?}"
  (cd "$root" && "$root/substrate/host/subhost.mjs" -R="${root//,/,,}" -W="${2//,/,,}" "$1" "$root/substrate" \
                   build substrate/compiler/main.sub -o "$2" -d "$root")
}

inputs() {
  (cd "$root" && find "$@" bin/sub -type d -name build -prune -o -type f -print0 | sort -z | xargs -0 sha256sum |
                   sha256sum | cut -c1-64)
}

built() { printf '%s\n' "$2" > "$1/inputs.tmp" && mv "$1/inputs.tmp" "$1/inputs"; }

compiler="$root/build/compiler"
from="$(inputs substrate seed/program)"
if [ "$(cat "$compiler/inputs" 2>/dev/null)" != "$from" ]; then
  stage "$root/seed" "$root/build/compiler-1"
  stage "$root/build/compiler-1" "$compiler"
  built "$compiler" "$from"
fi

tool="$root/build/sub"
from="$(inputs build/compiler/program cmd std substrate/host seed/sub)"
if [ "$(cat "$tool/inputs" 2>/dev/null)" != "$from" ]; then
  rm -rf "${tool:?}"
  "$root/substrate/host/subhost.mjs" -A "$root/seed/sub" "$root" build "$root/cmd/sub/sub.sub" -o "$tool" \
    -c "$root/build/sub-cache"
  built "$tool" "$from"
fi

exec "$root/substrate/host/subhost.mjs" -A "$tool" "$root" "$@"
