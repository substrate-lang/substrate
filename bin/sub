#!/usr/bin/env bash
# The command for programs: build, eval and expand run the compiler, first building it from the seed if its
# sources changed; run and site are the host's; serve and pack build and run cmd/serve.sub and cmd/pack.sub.
# The compiler, and so eval, has every grant, as deno eval does; code it runs while compiling may use no host module.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
here="$PWD"

# A path as a grant's list, in which a comma is written twice.
paths() { printf '%s' "${1//,/,,}"; }

case "${1:-}" in
  run) shift; exec "$root/host/subhost.mjs" "$@" ;;
  site) shift; exec "$root/host/web/site.sh" "$@" ;;
  serve)
    shift
    tls=()
    address=127.0.0.1
    k=1
    while [ $k -le $# ]; do
      case "${!k}" in
        -l) k=$((k + 1)); address="${!k:-127.0.0.1}" ;;
        -t) cert=$((k + 1)); key=$((k + 2)); tls=("--tls-cert=${!cert:-}" "--tls-key=${!key:-}"); k=$((k + 2)) ;;
        -z) k=$((k + 1)) ;;
        *) break ;;
      esac
      k=$((k + 1))
    done
    dir="${!k:-.}"
    case "$address" in *:*) address="[${address#[}"; address="${address%]}]" ;; esac
    "$root/bin/sub" build "$root/cmd/serve.sub" -o "$root/build/serve" || exit 1
    exec "$root/host/subhost.mjs" -R="$(paths "$dir")" -N="$address" ${tls[@]+"${tls[@]}"} "$root/build/serve" "$@" ;;
  pack)
    shift
    to=.
    from=.
    for ((k = 1; k < $#; k++)); do
      case "${!k}" in
        -o) k=$((k + 1)); to="${!k}" ;;
        -C) k=$((k + 1)); from="${!k}" ;;
      esac
    done
    "$root/bin/sub" build "$root/cmd/pack.sub" -o "$root/build/pack" || exit 1
    exec "$root/host/subhost.mjs" -R="$(paths "$from")" -W="$(paths "$to")" "$root/build/pack" "$@" ;;
esac

stage() {
  rm -rf "${2:?}"
  (cd "$root" && "$root/host/subhost.mjs" -A "$1" "$root" build compiler/main.sub -o "$2" -d "$root")
}

out="$root/build/sub"
if [ ! -f "$out/program" ] ||
   [ -n "$(find "$root/compiler" "$root/host/fs.sub" "$root/seed/program" -newer "$out/program" | head -1)" ]; then
  stage "$root/seed" "$root/build/sub-1"
  stage "$root/build/sub-1" "$out"
fi

case " $* " in *" -c "*) ;; *) set -- "$@" -c "$root/build/cache" ;; esac

exec "$root/host/subhost.mjs" -A "$out" "$root" "$@" -d "$here"
