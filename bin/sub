#!/usr/bin/env bash
# The command for programs: builds the compiler from the seed and sub, cmd/sub/sub.sub, with it when the SHA-256 of
# what each is built from changed, then runs sub with every grant, which does the rest.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

stage() {
  rm -rf "${2:?}"
  (cd "$root" && "$root/host/subhost.mjs" -R="${root//,/,,}" -W="${2//,/,,}" "$1" "$root" build compiler/main.sub -o "$2" \
                   -d "$root")
}

inputs() { (cd "$root" && find "$@" bin/sub -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -c1-64); }

built() { printf '%s\n' "$2" > "$1/inputs.tmp" && mv "$1/inputs.tmp" "$1/inputs"; }

compiler="$root/build/compiler"
from="$(inputs compiler host seed/program)"
if [ "$(cat "$compiler/inputs" 2>/dev/null)" != "$from" ]; then
  stage "$root/seed" "$root/build/compiler-1"
  stage "$root/build/compiler-1" "$compiler"
  built "$compiler" "$from"
fi

tool="$root/build/sub"
from="$(inputs build/compiler/program cmd std host)"
if [ "$(cat "$tool/inputs" 2>/dev/null)" != "$from" ]; then
  rm -rf "${tool:?}"
  "$root/host/subhost.mjs" -R="${root//,/,,}" -W="${tool//,/,,},${root//,/,,}/build/sub-cache" "$compiler" "$root" \
    build cmd/sub/sub.sub -o "$tool" -c "$root/build/sub-cache" -d "$root"
  built "$tool" "$from"
fi

exec "$root/host/subhost.mjs" -A "$tool" "$root" "$@"
