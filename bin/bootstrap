#!/usr/bin/env bash
# Checks that build/compiler builds itself into the same bytes; with `seed`, makes it the seed.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

empty="build/empty.sub"
mkdir -p build
: > "$empty"
bin/sub expand "$empty" -c build/cache > /dev/null

out=build/compiler-2
rm -rf "${out:?}"
host/subhost.mjs -R="${root//,/,,}" -W="${root//,/,,}/$out" "$root/build/compiler" "$root" build compiler/main.sub -o "$out" \
  -d "$root"
cmp -s build/compiler/program "$out/program" || { echo "bootstrap: the program lists differ"; exit 1; }
while read -r l; do
  cmp -s "build/compiler/$l.wasm" "$out/$l.wasm" || { echo "bootstrap: $l differs"; exit 1; }
done < build/compiler/program
echo "bootstrap: build/compiler builds itself"

if [ "${1:-}" = seed ]; then
  rm -rf seed
  mkdir seed
  cp build/compiler/program build/compiler/*.wasm seed/
  echo "bootstrap: build/compiler is the seed"
fi
