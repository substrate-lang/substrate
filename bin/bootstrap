#!/usr/bin/env bash
# Checks that build/compiler builds itself into the same bytes. With `seed`, it then copies build/compiler and build/sub
# into seed/.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

empty="build/empty.sub"
mkdir -p build
: > "$empty"
bin/substrate expand "$empty" -c build/cache > /dev/null

out=build/compiler-2
rm -rf "${out:?}"
substrate/host/subhost.mjs --grant read . --grant write "$out" \
  build/compiler substrate build substrate/compiler/main.sub -o "$out" -d .
cmp -s build/compiler/program "$out/program" || { echo "bootstrap: the program lists differ"; exit 1; }
while read -r l; do
  cmp -s "build/compiler/$l.wasm" "$out/$l.wasm" || { echo "bootstrap: $l differs"; exit 1; }
done < build/compiler/program
echo "bootstrap: build/compiler builds itself"

if [ "${1:-}" = seed ]; then
  rm -rf seed
  mkdir -p seed/sub
  cp build/compiler/program build/compiler/*.wasm seed/
  cp build/sub/program build/sub/*.wasm seed/sub/
  echo "bootstrap: build/compiler and build/sub are the seed"
fi
