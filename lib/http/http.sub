;; HTTP/1.1 messages, parsed and written. The parser calls on-head, then on-body for each piece of the body, then
;; on-end, for each message it is fed. Header names are lowercased, and the head's names and values last until on-end.
(provide http-head http-header http-header-count http-parser http-parser-init! http-feed! http-parser-closed!
         http-parser-stop! http-parser-resume! http-parser-refuse! http-parser-no-body! http-write-request!
         http-write-status! http-write-date! http-write-header! http-write-number! http-write-end! http-write-chunk!
         http-write-last-chunk! http-reason http-decimal http-header-has? http-same? http-add-decimal!)

;; Beyond these, a message is malformed.
(const max-headers u32 100)
(const max-head u32 16384)
(const max-line u32 1024)
(const max-excess i64 16384)

(struct http-head [line buffer] [names (array string 100)] [values (array string 100)] [count u32]
  [method string] [target string] [version string] [status i32] [reason string])

(const state-head i32 0)
(const state-length i32 1)
(const state-chunk-size i32 2)
(const state-chunk-data i32 3)
(const state-chunk-end i32 4)
(const state-trailers i32 5)
(const state-until-close i32 6)
(const state-stopped i32 7)
(const state-refused i32 8)
(const state-no-body i32 9)

(struct http-parser [head http-head] [line buffer] [state i32] [remaining i64] [excess i64] [user (ptr void)]
  [on-head (fn ((ptr http-parser)))] [on-body (fn ((ptr http-parser) (slice u8)))] [on-end (fn ((ptr http-parser)))])

;; ---- text ----

(define (lower! [b (slice u8)])
  (for ([i u32 0]) (< i (-> b length)) (+= i 1)
    (when (and (>= (@ b i) 65) (<= (@ b i) 90)) (set! (@ b i) (+ (@ b i) 32)))))

(define (lowered [c i32]) -> i32 (if (and (>= c 65) (<= c 90)) (+ c 32) c))

(define (http-same? [a string] [b string]) -> bool
  (unless (== (-> a length) (-> b length)) (return #f))
  (for ([i u32 0]) (< i (-> a length)) (+= i 1)
    (when (!= (lowered (@ a i)) (lowered (@ b i))) (return #f)))
  #t)

;; has-token? tells whether part is one of the comma-separated tokens in s, ignoring case.
(define (has-token? [s string] [part string]) -> bool
  (let ([n (-> s length)] [i u32 0] [start u32 0] [end u32 0])
    (while #t
      (while (and (< i n) (or (== (@ s i) 32) (== (@ s i) 9))) (+= i 1))
      (set! start i)
      (while (and (< i n) (!= (@ s i) 44)) (+= i 1))
      (set! end i)
      (while (and (> end start) (or (== (@ s (- end 1)) 32) (== (@ s (- end 1)) 9))) (-= end 1))
      (when (http-same? (slice s start end) part) (return #t))
      (when (== i n) (return #f))
      (+= i 1))
    #f))

;; http-header-has? tells whether any header of that name has part among its tokens.
(define (http-header-has? [h (ptr http-head)] [name string] [part string]) -> bool
  (for ([i u32 0]) (< i (-> h count)) (+= i 1)
    (when (and (== (@ (-> h names) i) name) (has-token? (@ (-> h values) i) part)) (return #t)))
  #f)

(define (http-header-count [h (ptr http-head)] [name string]) -> u32
  (let ([n u32 0])
    (for ([i u32 0]) (< i (-> h count)) (+= i 1)
      (when (== (@ (-> h names) i) name) (+= n 1)))
    n))

(define (last-header [h (ptr http-head)] [name string]) -> string
  (let ([found string])
    (for ([i u32 0]) (< i (-> h count)) (+= i 1)
      (when (== (@ (-> h names) i) name) (set! found (@ (-> h values) i))))
    found))

(define (chunked-last? [s string]) -> bool
  (let* ([end (-> s length)] [start end])
    (while (and (> start 0) (!= (@ s (- start 1)) 44)) (-= start 1))
    (while (and (< start end) (or (== (@ s start) 32) (== (@ s start) 9))) (+= start 1))
    (http-same? (slice s start end) "chunked")))

(define (token-char? [c u8]) -> bool
  (or (and (>= c 97) (<= c 122)) (and (>= c 65) (<= c 90)) (and (>= c 48) (<= c 57))
      (case c [(#\! #\# #\$ #\% #\& #\' #\* #\+ #\- #\. #\^ #\_ #\` #\| #\~) #t] [else #f])))

(define (token? [s string]) -> bool
  (for ([i u32 0]) (< i (-> s length)) (+= i 1) (unless (token-char? (@ s i)) (return #f)))
  (> (-> s length) 0))

(define (visible? [s string]) -> bool
  (for ([i u32 0]) (< i (-> s length)) (+= i 1) (unless (and (> (@ s i) 32) (!= (@ s i) 127)) (return #f)))
  (> (-> s length) 0))

(define (field-value? [s string]) -> bool
  (for ([i u32 0]) (< i (-> s length)) (+= i 1)
    (when (or (and (< (@ s i) 32) (!= (@ s i) 9)) (== (@ s i) 127)) (return #f)))
  #t)

(define (version? [s string]) -> bool
  (and (== (-> s length) 8) (== (slice s 0 7) "HTTP/1.") (>= (@ s 7) 48) (<= (@ s 7) 57)))

(define (http-decimal [s string]) -> i64
  (let ([n i64 0] [i u32 0])
    (while (and (< i (-> s length)) (>= (@ s i) 48) (<= (@ s i) 57))
      (set! n (+ (* n 10) (- (@ s i) 48)))
      (+= i 1))
    (if (or (== i 0) (> i 18) (< i (-> s length))) -1 n)))

(define (hex-digit [c u8]) -> i32
  (cond [(and (>= c 48) (<= c 57)) (- c 48)]
        [(and (>= c 97) (<= c 102)) (+ (- c 97) 10)]
        [(and (>= c 65) (<= c 70)) (+ (- c 65) 10)]
        [else -1]))

;; The index of the first space in s from i, or s's length.
(define (space-from [s string] [i u32]) -> u32
  (while (and (< i (-> s length)) (!= (@ s i) 32)) (+= i 1))
  i)

;; The index of the first byte in s from i that is not a space, or s's length.
(define (word-from [s string] [i u32]) -> u32
  (while (and (< i (-> s length)) (== (@ s i) 32)) (+= i 1))
  i)

(define (http-add-decimal! [b (ptr buffer)] [n i64])
  (when (< n 0) (buffer-add-byte! b 45) (set! n (- 0 n)))
  (when (>= n 10) (http-add-decimal! b (/ n 10)))
  (buffer-add-byte! b (cast i32 (+ 48 (% n 10)))))

(define (add-hex! [b (ptr buffer)] [n u32])
  (when (>= n 16) (add-hex! b (/ n 16)))
  (let ([d (% n 16)]) (buffer-add-byte! b (cast i32 (if (< d 10) (+ 48 d) (+ 87 d))))))

;; ---- the head ----

(define (http-header [h (ptr http-head)] [name string]) -> string
  (for ([i u32 0]) (< i (-> h count)) (+= i 1)
    (when (== (@ (-> h names) i) name) (return (@ (-> h values) i))))
  0)

(define (parse-first-line! [h (ptr http-head)] [line string]) -> bool
  (let* ([n (-> line length)] [e1 (space-from line 0)] [s2 (word-from line e1)] [e2 (space-from line s2)]
         [first (slice line 0 e1)] [second (slice line s2 e2)] [third (slice line (word-from line e2))])
    (when (== e1 n) (return #f))
    (if (and (>= e1 5) (== (slice first 0 5) "HTTP/"))
        (begin
          (set! (-> h version) first)
          (set! (-> h status) (cast i32 (http-decimal second)))
          (set! (-> h reason) third)
          (set! (-> h method) 0)
          (set! (-> h target) 0)
          (and (version? first) (>= (-> h status) 100) (<= (-> h status) 999)))
        (begin
          (when (or (== e2 n) (not (token? first)) (not (visible? second)) (not (version? third))) (return #f))
          (set! (-> h method) first)
          (set! (-> h target) second)
          (set! (-> h version) third)
          (set! (-> h status) 0)
          (set! (-> h reason) 0)
          #t))))

(define (parse-header-line! [h (ptr http-head)] [line string]) -> bool
  (let ([n (-> line length)] [i u32 0])
    (while (and (< i n) (!= (@ line i) 58))
      (unless (token-char? (@ line i)) (return #f))
      (+= i 1))
    (when (or (== i n) (== i 0) (>= (-> h count) max-headers)) (return #f))
    (let* ([name (slice line 0 i)] [value (slice line (+ i 1))] [start u32 0] [end (-> value length)])
      (unless (field-value? value) (return #f))
      (while (and (< start end) (or (== (@ value start) 32) (== (@ value start) 9))) (+= start 1))
      (while (and (> end start) (or (== (@ value (- end 1)) 32) (== (@ value (- end 1)) 9))) (-= end 1))
      (lower! (cast (slice u8) name))
      (set! (@ (-> h names) (-> h count)) name)
      (set! (@ (-> h values) (-> h count)) (slice value start end))
      (+= (-> h count) 1)
      #t)))

(define (parse-head! [h (ptr http-head)]) -> bool
  (let* ([text (buffer-string (& (-> h line)))] [n (-> text length)] [line-start u32 0] [first #t])
    (set! (-> h count) 0)
    (for ([i u32 0]) (< i n) (+= i 1)
      (when (== (@ text i) 0) (return #f))
      (when (== (@ text i) 10)
        (let ([end i])
          (when (and (> end line-start) (== (@ text (- end 1)) 13)) (-= end 1))
          (cond [(== end line-start) (begin)]
                [first
                 (set! first #f)
                 (unless (parse-first-line! h (slice text line-start end)) (return #f))]
                [else (unless (parse-header-line! h (slice text line-start end)) (return #f))])
          (set! line-start (+ i 1)))))
    (not first)))

(define (head-complete? [b (ptr buffer)]) -> bool
  (let ([n (-> b length)] [s (-> b bytes)])
    (or (and (>= n 2) (== (@ s (- n 1)) 10) (== (@ s (- n 2)) 10))
        (and (>= n 4) (== (@ s (- n 1)) 10) (== (@ s (- n 2)) 13) (== (@ s (- n 3)) 10) (== (@ s (- n 4)) 13)))))

;; ---- the parser ----

(define (http-parser-init! [p (ptr http-parser)] [user (ptr void)] [on-head (fn ((ptr http-parser)))]
                           [on-body (fn ((ptr http-parser) (slice u8)))] [on-end (fn ((ptr http-parser)))])
  (set! (-> p head line) (make-buffer))
  (set! (-> p head count) 0)
  (set! (-> p line) (make-buffer))
  (set! (-> p state) state-head)
  (set! (-> p remaining) 0)
  (set! (-> p excess) 0)
  (set! (-> p user) user)
  (set! (-> p on-head) on-head)
  (set! (-> p on-body) on-body)
  (set! (-> p on-end) on-end))

(define (end! [p (ptr http-parser)])
  (set! (-> p state) state-head)
  ((-> p on-end) p)
  (set! (-> p head line length) 0)
  (set! (-> p head count) 0)
  (set! (-> p line length) 0)
  (set! (-> p remaining) 0)
  (set! (-> p excess) 0))

(define (body-expected? [status i32]) -> bool
  (not (or (< status 200) (== status 204) (== status 304))))

(define (framing! [p (ptr http-parser)]) -> bool
  (let* ([h (& (-> p head))] [encoding (last-header h "transfer-encoding")] [length (http-header h "content-length")]
         [encoded (!= (-> encoding bytes) 0)] [sized (!= (-> length bytes) 0)] [chunked (and encoded (chunked-last? encoding))]
         [request (== (-> h status) 0)])
    (when (or (and encoded sized) (> (http-header-count h "content-length") 1)) (return #f))
    (when (and encoded request
               (or (not chunked) (!= (-> encoding length) 7) (> (http-header-count h "transfer-encoding") 1)))
      (return #f))
    ((-> p on-head) p)
    (when (== (-> p state) state-refused) (return #f))
    (when (== (-> p state) state-stopped) (return #t))
    (when (== (-> p state) state-no-body)
      (end! p)
      (return #t))
    (cond [(and (not request) (not (body-expected? (-> h status)))) (end! p)]
          [chunked (set! (-> p state) state-chunk-size)]
          [sized
           (let ([n (http-decimal length)])
             (when (< n 0) (return #f))
             (if (== n 0)
                 (end! p)
                 (begin
                   (set! (-> p remaining) n)
                   (set! (-> p state) state-length))))]
          [(not request) (set! (-> p state) state-until-close)]
          [else (end! p)])
    #t))

(define (crlf-line? [b (ptr buffer)]) -> bool
  (let ([i u32 0])
    (while (and (< i (-> b length)) (!= (@ (-> b bytes) i) 13)) (+= i 1))
    (== (+ i 2) (-> b length))))

(define (chunk-size [b (ptr buffer)]) -> i64
  (let ([n i64 0] [i u32 0] [s (-> b bytes)] [digits u32 0])
    (unless (crlf-line? b) (return -1))
    (while (>= (hex-digit (@ s i)) 0)
      (set! n (+ (* n 16) (hex-digit (@ s i))))
      (+= i 1))
    (set! digits i)
    (while (or (== (@ s i) 32) (== (@ s i) 9)) (+= i 1))
    (if (or (== digits 0) (> digits 15) (and (!= (@ s i) 59) (!= (@ s i) 13))) -1 n)))

;; overhead! counts a chunked body's bytes besides its data toward max-excess, allowing 16 for each chunk and twice
;; the chunk's data, as Go's net/http does.
(define (overhead! [p (ptr http-parser)] [n i64]) -> bool
  (+= (-> p excess) n)
  (when (< (-> p excess) 0) (set! (-> p excess) 0))
  (<= (-> p excess) max-excess))

(define (take-body! [p (ptr http-parser)] [bytes (ptr u8)] [i u32] [n u32]) -> u32
  (let ([take (if (< (cast i64 (- n i)) (-> p remaining)) (- n i) (cast u32 (-> p remaining)))])
    ((-> p on-body) p (slice (+ bytes i) take))
    (-= (-> p remaining) (cast i64 take))
    take))

(define (http-feed! [p (ptr http-parser)] [b (slice u8)]) -> i32
  (let ([bytes (-> b items)] [n (-> b length)] [i u32 0])
    (while (< i n)
      (let ([c (@ bytes i)] [state (-> p state)])
        (cond
          [(== state state-head)
           (buffer-add-byte! (& (-> p head line)) c)
           (when (> (-> p head line length) max-head) (return -1))
           (+= i 1)
           (when (head-complete? (& (-> p head line)))
             (unless (parse-head! (& (-> p head))) (return -1))
             (unless (framing! p) (return -1)))]
          [(== state state-length)
           (+= i (take-body! p bytes i n))
           (when (== (-> p remaining) 0) (end! p))]
          [(== state state-chunk-size)
           (buffer-add-byte! (& (-> p line)) c)
           (when (> (-> p line length) max-line) (return -1))
           (+= i 1)
           (when (== c 10)
             (let ([size (chunk-size (& (-> p line)))])
               (unless (and (>= size 0) (overhead! p (- (cast i64 (+ (-> p line length) 2)) (+ 16 (* 2 size)))))
                 (return -1))
               (set! (-> p line length) 0)
               (if (== size 0)
                   (set! (-> p state) state-trailers)
                   (begin
                     (set! (-> p remaining) size)
                     (set! (-> p state) state-chunk-data)))))]
          [(== state state-chunk-data)
           (+= i (take-body! p bytes i n))
           (when (== (-> p remaining) 0) (set! (-> p state) state-chunk-end))]
          [(== state state-chunk-end)
           (+= i 1)
           (cond [(and (== c 13) (== (-> p line length) 0)) (buffer-add-byte! (& (-> p line)) c)]
                 [(and (== c 10) (== (-> p line length) 1))
                  (set! (-> p line length) 0)
                  (set! (-> p state) state-chunk-size)]
                 [else (return -1)])]
          [(== state state-trailers)
           (buffer-add-byte! (& (-> p line)) c)
           (when (> (-> p line length) max-line) (return -1))
           (+= i 1)
           (when (== c 10)
             (unless (and (crlf-line? (& (-> p line))) (overhead! p (cast i64 (-> p line length)))) (return -1))
             (if (== (-> p line length) 2) (end! p) (set! (-> p line length) 0)))]
          [(== state state-until-close)
           ((-> p on-body) p (slice (+ bytes i) (- n i)))
           (set! i n)]
          [(== state state-stopped) (return (cast i32 i))]
          [else (return -1)])))
    (cast i32 n)))

(define (http-parser-closed! [p (ptr http-parser)])
  (when (== (-> p state) state-until-close) (end! p)))

;; Called from on-head or on-end, http-parser-stop! makes http-feed! return how many bytes it took. After on-end,
;; http-parser-resume! starts on the next message.
(define (http-parser-stop! [p (ptr http-parser)]) (set! (-> p state) state-stopped))

(define (http-parser-resume! [p (ptr http-parser)]) (set! (-> p state) state-head))

;; Called from on-head, http-parser-refuse! makes http-feed! return -1, as for a malformed message.
(define (http-parser-refuse! [p (ptr http-parser)]) (set! (-> p state) state-refused))

;; Called from on-head, http-parser-no-body! ends the message at its head, as for a response to HEAD.
(define (http-parser-no-body! [p (ptr http-parser)]) (set! (-> p state) state-no-body))

;; ---- writing heads ----

(define (http-reason [status i32]) -> string
  (case status
    [(100) "Continue"]
    [(101) "Switching Protocols"]
    [(103) "Early Hints"]
    [(200) "OK"]
    [(201) "Created"]
    [(202) "Accepted"]
    [(203) "Non-Authoritative Information"]
    [(204) "No Content"]
    [(205) "Reset Content"]
    [(206) "Partial Content"]
    [(300) "Multiple Choices"]
    [(301) "Moved Permanently"]
    [(302) "Found"]
    [(303) "See Other"]
    [(304) "Not Modified"]
    [(307) "Temporary Redirect"]
    [(308) "Permanent Redirect"]
    [(400) "Bad Request"]
    [(401) "Unauthorized"]
    [(402) "Payment Required"]
    [(403) "Forbidden"]
    [(404) "Not Found"]
    [(405) "Method Not Allowed"]
    [(406) "Not Acceptable"]
    [(407) "Proxy Authentication Required"]
    [(408) "Request Timeout"]
    [(409) "Conflict"]
    [(410) "Gone"]
    [(411) "Length Required"]
    [(412) "Precondition Failed"]
    [(413) "Content Too Large"]
    [(414) "URI Too Long"]
    [(415) "Unsupported Media Type"]
    [(416) "Range Not Satisfiable"]
    [(417) "Expectation Failed"]
    [(421) "Misdirected Request"]
    [(422) "Unprocessable Content"]
    [(426) "Upgrade Required"]
    [(428) "Precondition Required"]
    [(429) "Too Many Requests"]
    [(431) "Request Header Fields Too Large"]
    [(451) "Unavailable For Legal Reasons"]
    [(500) "Internal Server Error"]
    [(501) "Not Implemented"]
    [(502) "Bad Gateway"]
    [(503) "Service Unavailable"]
    [(504) "Gateway Timeout"]
    [(505) "HTTP Version Not Supported"]
    [(511) "Network Authentication Required"]
    [else "Unknown"]))

(define (http-write-request! [b (ptr buffer)] [method string] [target string])
  (unless (and (token? method) (visible? target))
    (host-trap "http: a request line whose method is not a token or whose target has a space or control byte"))
  (buffer-add-string! b method)
  (buffer-add-byte! b 32)
  (buffer-add-string! b target)
  (buffer-add-string! b " HTTP/1.1\r\n"))

(define (http-write-status! [b (ptr buffer)] [status i32])
  (unless (and (>= status 100) (<= status 999)) (host-trap "http: a status outside 100 to 999"))
  (buffer-add-string! b "HTTP/1.1 ")
  (http-add-decimal! b status)
  (buffer-add-byte! b 32)
  (buffer-add-string! b (http-reason status))
  (buffer-add-string! b "\r\n"))

(define (http-write-header! [b (ptr buffer)] [name string] [value string])
  (unless (and (token? name) (field-value? value))
    (host-trap "http: a header whose name is not a token or whose value has a control byte"))
  (buffer-add-string! b name)
  (buffer-add-string! b ": ")
  (buffer-add-string! b value)
  (buffer-add-string! b "\r\n"))

(define (http-write-number! [b (ptr buffer)] [name string] [n i64])
  (unless (token? name) (host-trap "http: a header whose name is not a token"))
  (buffer-add-string! b name)
  (buffer-add-string! b ": ")
  (http-add-decimal! b n)
  (buffer-add-string! b "\r\n"))

(define (two-digits! [b (ptr buffer)] [n i64])
  (buffer-add-byte! b (cast i32 (+ 48 (/ n 10))))
  (buffer-add-byte! b (cast i32 (+ 48 (% n 10)))))

;; http-write-date! writes the date header for ms milliseconds since 1970, as in Tue, 14 Nov 2023 22:13:20 GMT.
(define (http-write-date! [b (ptr buffer)] [ms f64])
  (let* ([seconds (cast i64 (/ ms 1000.0))] [days (/ seconds 86400)] [rest (% seconds 86400)]
         [z (+ days 719468)] [era (/ z 146097)] [doe (- z (* era 146097))]
         [yoe (/ (- (+ (- doe (/ doe 1460)) (/ doe 36524)) (/ doe 146096)) 365)]
         [doy (- doe (- (+ (* 365 yoe) (/ yoe 4)) (/ yoe 100)))] [mp (/ (+ (* 5 doy) 2) 153)]
         [day (+ (- doy (/ (+ (* 153 mp) 2) 5)) 1)] [month (if (< mp 10) (+ mp 3) (- mp 9))]
         [year (+ yoe (* era 400) (if (<= month 2) 1 0))])
    (buffer-add-string! b "date: ")
    (buffer-add! b (+ "SunMonTueWedThuFriSat" (cast u32 (* 3 (% (+ days 4) 7)))) 3)
    (buffer-add-string! b ", ")
    (two-digits! b day)
    (buffer-add-byte! b 32)
    (buffer-add! b (+ "JanFebMarAprMayJunJulAugSepOctNovDec" (cast u32 (* 3 (- month 1)))) 3)
    (buffer-add-byte! b 32)
    (http-add-decimal! b year)
    (buffer-add-byte! b 32)
    (two-digits! b (/ rest 3600))
    (buffer-add-byte! b 58)
    (two-digits! b (% (/ rest 60) 60))
    (buffer-add-byte! b 58)
    (two-digits! b (% rest 60))
    (buffer-add-string! b " GMT\r\n")))

(define (http-write-end! [b (ptr buffer)]) (buffer-add-string! b "\r\n"))

;; http-write-chunk! writes nothing for an empty chunk, and http-write-last-chunk! ends the body.
(define (http-write-chunk! [b (ptr buffer)] [bytes (slice u8)])
  (when (> (-> bytes length) 0)
    (add-hex! b (-> bytes length))
    (buffer-add-string! b "\r\n")
    (buffer-add! b (-> bytes items) (-> bytes length))
    (buffer-add-string! b "\r\n")))

(define (http-write-last-chunk! [b (ptr buffer)]) (buffer-add-string! b "0\r\n\r\n"))
