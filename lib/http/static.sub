;; Static files: http-static! answers with the file at the request's path under root, or a directory's index.html,
;; and redirects a directory named without its slash. Answers carry cache-control: no-store.
(require-unqualified fs "../../host/fs.sub")
(require-unqualified http "http.sub")
(require-unqualified server "server.sub")

(provide http-static!)

;; Files up to this size are read and sent whole; larger ones are piped.
(const whole i64 262144)

(define (extension [path string]) -> string
  (let ([i (-> path length)])
    (while (and (> i 0) (!= (@ path (- i 1)) 46) (!= (@ path (- i 1)) 47)) (-= i 1))
    (if (and (> i 0) (== (@ path (- i 1)) 46)) (slice path i) "")))

(define (content-type [path string]) -> string
  (let ([e (extension path)])
    (cond [(== e "html") "text/html; charset=utf-8"]
          [(or (== e "mjs") (== e "js")) "text/javascript; charset=utf-8"]
          [(== e "css") "text/css; charset=utf-8"]
          [(== e "wasm") "application/wasm"]
          [(== e "json") "application/json"]
          [(or (== e "txt") (== e "sub")) "text/plain; charset=utf-8"]
          [(== e "svg") "image/svg+xml"]
          [(== e "png") "image/png"]
          [(or (== e "jpg") (== e "jpeg")) "image/jpeg"]
          [(== e "gif") "image/gif"]
          [(== e "webp") "image/webp"]
          [(== e "wav") "audio/wav"]
          [(== e "mp3") "audio/mpeg"]
          [(== e "ogg") "audio/ogg"]
          [(== e "woff2") "font/woff2"]
          [else "application/octet-stream"])))

(define (hex-digit [c u8]) -> i32
  (cond [(and (>= c 48) (<= c 57)) (- c 48)]
        [(and (>= c 97) (<= c 102)) (+ (- c 97) 10)]
        [(and (>= c 65) (<= c 70)) (+ (- c 65) 10)]
        [else -1]))

;; add-path! adds the target's decoded path to the buffer, and returns #f when it is malformed or leaves the root.
(define (add-path! [b (ptr buffer)] [target string]) -> bool
  (let ([n (-> target length)] [i u32 0] [start (-> b length)])
    (while (and (< i n) (!= (@ target i) 63))
      (let ([c (@ target i)])
        (if (== c 37)
            (let ([high (if (< (+ i 1) n) (hex-digit (@ target (+ i 1))) -1)]
                  [low (if (< (+ i 2) n) (hex-digit (@ target (+ i 2))) -1)])
              (when (or (< high 0) (< low 0) (== (+ high low) 0)) (return #f))
              (buffer-add-byte! b (+ (* high 16) low))
              (+= i 3))
            (begin
              (buffer-add-byte! b c)
              (+= i 1)))))
    (let* ([path (slice (buffer-string b) start)] [m (-> path length)])
      (when (or (== m 0) (!= (@ path 0) 47)) (return #f))
      (for ([j u32 0]) (< j m) (+= j 1)
        (when (and (== (@ path j) 47) (< (+ j 2) m) (== (@ path (+ j 1)) 46) (== (@ path (+ j 2)) 46)
                   (or (== (+ j 3) m) (== (@ path (+ j 3)) 47)))
          (return #f))))
    #t))

(define (moved! [r (ptr http-request)])
  (let ([t (-> r target)] [i u32 0] [last u32 0] [to (make-buffer)])
    (while (and (< i (-> t length)) (!= (@ t i) 63))
      (when (== (@ t i) 47) (set! last (+ i 1)))
      (+= i 1))
    (buffer-add-string! (& to) "./")
    (buffer-add-string! (& to) (slice t last i))
    (buffer-add-byte! (& to) 47)
    (buffer-add-string! (& to) (slice t i))
    (http-respond! r 301)
    (http-header! r "location" (buffer-string (& to)))
    (http-finish! r)
    (buffer-free! (& to))))

(define (found! [r (ptr http-request)] [path string])
  (http-respond! r 200)
  (http-header! r "content-type" (content-type path))
  (http-header! r "cache-control" "no-store"))

(define (http-static! [r (ptr http-request)] [root string])
  (let ([path (make-buffer)] [head? (== (-> r method) "HEAD")] [slash #f])
    (buffer-add-string! (& path) root)
    (cond
      [(not (or head? (== (-> r method) "GET")))
       (http-respond! r 405)
       (http-header! r "allow" "GET, HEAD")
       (http-header! r "content-type" "text/plain; charset=utf-8")
       (http-send-text! r "method not allowed")]
      [(not (add-path! (& path) (-> r target))) (http-answer-text! r 400 "bad request")]
      [else
       (set! slash (== (@ (-> path bytes) (- (-> path length) 1)) 47))
       (when slash (buffer-add-string! (& path) "index.html"))
       (let* ([name (buffer-string (& path))] [info fs-info] [found (>= (fs-stat name (& info) 0) 0)] [size (-> info size)])
         (cond [(and found (== (-> info kind) fs-directory) (not slash)) (moved! r)]
               [(or (not found) (!= (-> info kind) fs-file)) (http-answer-text! r 404 "not found")]
               [head?
                (found! r name)
                (http-length! r size)
                (http-finish! r)]
               [(<= size whole)
                (let ([f (slice u8)])
                  (if (< (fs-read-file name (& f) 0) 0)
                      (http-answer-text! r 500 "cannot read the file")
                      (begin
                        (found! r name)
                        (http-send! r f)
                        (free (-> f items)))))]
               [else
                (let ([file (fs-open name fs-read-mode 0 0)])
                  (if (== file 0)
                      (http-answer-text! r 500 "cannot read the file")
                      (begin
                        (found! r name)
                        (http-send-stream! r file size))))]))])
    (buffer-free! (& path))))
