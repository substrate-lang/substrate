;; An HTTP/1.1 server over net. A handler answers each request with bytes, a stream, pieces written as they come or
;; nothing, and the server frames the body by its length or in chunks; or the handler takes the connection's stream.
;; Each connection's requests are answered one at a time. Before serving, set host to the address to listen on,
;; 127.0.0.1 when empty; secure for TLS; most to the most connections at once, no limit when 0; and the timeouts, in
;; milliseconds, Node's when 0 and none when below 0: idle-timeout for the next request on a connection, 5 s, or 130 s
;; behind proxies; head-timeout for a whole head, 60 s; request-timeout for a whole request, 300 s; and send-timeout
;; for an answer that cannot be sent, 60 s. body-limit bounds http-read-body!, 1 MiB when 0. compress, a level from 1
;; to 9, has answers gzipped for clients that take gzip, as Express's compression does it: those of a type that
;; compresses and 1 KB or more, whole or as they are written, and an event stream one event at a time. proxies is how
;; many proxies stand in front of the server, whose X-Forwarded headers it believes, and checks run in order before
;; handle.
;; When listening fails, problem holds the reason. A request lasts until it is answered and its body has ended, and
;; while its own code runs; on-done is called as it ends, and must not trap. A trap in that code answers it with 500, or
;; ends its connection once its answer has begun, and on-trap is told, or else the log at the error level, or else
;; stderr. A body left unread is read and dropped, up to 256 KB, as Go does, and a closing connection reads on for a
;; while, as nginx's do, so that the client sees its answer.
(require-unqualified events "../../host/events.sub")
(require-unqualified stream "../../host/stream.sub")
(require-unqualified net "../../host/node/net.sub")
(require-unqualified signal "../../host/node/signal.sub")
(require-unqualified timer "../../host/modules/timer.sub")
(require-unqualified clock "../../host/modules/clock.sub")
(require-unqualified random "../../host/modules/random.sub")
(require-unqualified http "http.sub")
(require-unqualified log "../log/log.sub")
(require-unqualified deflate "../compress/deflate.sub")
(require-unqualified gzip "../compress/gzip.sub")

(provide http-server http-request http-check http-hook http-serve! http-server-close! http-server-shutdown!
         http-stop-on-signals! http-hook! http-unhook! http-log-access http-request-header http-request-server
         http-request-gone? http-request-address http-request-https? http-request-deadline! http-add-header!
         http-respond! http-header! http-length! http-write! http-send! http-send-text! http-send-stream! http-finish!
         http-take! http-read-body! http-answer-text! http-redirect! http-trapped http-connect! http-connection-feed!
         http-connection-close!)

(const default-body-limit u32 1048576)
(const most-dropped u64 262144)

;; A request's on-body gets each piece of its body, and its on-end sees failed set when the body was malformed. on-gone
;; is called once if its client leaves, or ends its side, before its answer is finished, and on-drained when the
;; connection has room again after http-write! returned #f. peer is the address the connection came from. Its arena
;; is freed with it. A successful or 304 answer carries etag, unless empty, and the date modified, unless 0, and says
;; that ranges are accepted when ranges is set.
(struct http-request [connection (ptr void)] [server (ptr void)] [method string] [target string] [head (ptr http-head)]
  [arena arena] [user (ptr void)] [route (ptr void)] [peer string] [ended bool] [failed bool] [answered bool]
  [sent bool] [done bool] [gone bool] [chunked bool] [depth u32] [outer (ptr http-request)] [status i32] [length i64]
  [written i64] [began f64] [deadline f64] [on-body (fn ((ptr http-request) (slice u8)))]
  [on-end (fn ((ptr http-request)))]
  [on-gone (fn ((ptr http-request)))] [on-drained (fn ((ptr http-request)))] [body buffer] [limit u32]
  [taken (fn ((ptr http-request) (slice u8)))] [added buffer] [own-head http-head] [etag string] [modified f64]
  [ranges bool] [compressible bool] [events bool] [encoded bool] [gzip i32] [deflater (ptr deflater)] [crc u32]
  [size u32])

;; A check runs before the handler with its settings, and returns #t when it has answered the request.
(struct http-check [run (fn ((ptr http-request) (ptr void)) -> bool)] [settings (ptr void)])

(typedef taker (fn ((ptr void) u32 (slice u8))))

;; A relay sends a stream as an answer's body.
(struct relay [head event-head] [from u32] [left i64] [connection (ptr void)] [waiting bool])

;; A connection from http-connect! has no stream: its bytes go to sink, and sink-ended is called when the server ends
;; it. It is freed by http-connection-close!. block holds the bytes of its last read until they are used. started is
;; when its head began, or it was accepted, and 0 between requests; discarded counts body bytes thrown away after the
;; answer; lingering is set once the server has ended its side, until linger-end; and doomed once it is dropped while
;; the parser has its bytes.
(struct http-connection [head event-head] [server (ptr void)] [stream u32] [parser http-parser]
  [request (ptr http-request)] [block (ptr u8)] [out buffer] [relay (ptr relay)] [reading bool] [busy bool]
  [closing bool] [half-closed bool] [feeding bool] [full bool] [dropped bool] [take taker] [taken (ptr void)]
  [timer u32] [rest (slice u8)] [next (ptr http-connection)] [peer string] [started f64] [discarded u64]
  [lingering bool] [linger-end f64] [doomed bool]
  [sink (fn ((ptr void) (slice u8)))] [sink-ended (fn ((ptr void)))] [sink-tag (ptr void)])

;; A hook's run is called with its tag when its server shuts down, and again, forced, once the time to finish is up, as
;; Go's RegisterOnShutdown functions are; event streams and WebSockets end with one.
(struct http-hook [run (fn ((ptr void) bool))] [tag (ptr void)] [server (ptr void)] [next (ptr http-hook)]
  [previous (ptr http-hook)])

(struct http-server [head event-head] [listener u32] [port u32] [host string] [secure bool] [most u32]
  [idle-timeout f64] [head-timeout f64] [request-timeout f64] [send-timeout f64] [body-limit u32] [compress i32]
  [proxies u32] [checks (slice http-check)] [problem string] [user (ptr void)] [connections (ptr http-connection)]
  [hooks (ptr http-hook)] [stopping bool] [stop-timer u32] [stopped (fn ((ptr http-server)))] [log (ptr logger)]
  [handle (fn ((ptr http-request)))] [listening (fn ((ptr http-server)))] [on-trap (fn ((ptr http-request) string))]
  [on-done (fn ((ptr http-request)))])

;; ---- requests ----

;; The request whose code runs, linked by outer to any it runs within.
(define running (ptr http-request) 0)

(define (connection-of [r (ptr http-request)]) -> (ptr http-connection) (cast (ptr http-connection) (-> r connection)))

(define (server-of [c (ptr http-connection)]) -> (ptr http-server) (cast (ptr http-server) (-> c server)))

(define (http-request-server [r (ptr http-request)]) -> (ptr http-server) (cast (ptr http-server) (-> r server)))

(define (http-request-gone? [r (ptr http-request)]) -> bool (-> r gone))

(define (http-request-header [r (ptr http-request)] [name string]) -> string (http-header (-> r head) name))

;; ---- the client ----

;; forwarded counts the entries of the X-Forwarded-For headers, or gives the one at index from the left.
(define (forwarded [r (ptr http-request)] [index i64] [entry (ptr string)]) -> i64
  (let ([h (-> r head)] [n i64 0])
    (for ([k u32 0]) (< k (-> h count)) (+= k 1)
      (when (== (@ (-> h names) k) "x-forwarded-for")
        (let ([v (@ (-> h values) k)] [start u32 0])
          (for ([i u32 0]) (<= i (-> v length)) (+= i 1)
            (when (or (== i (-> v length)) (== (@ v i) 44))
              (when (== n index) (set! (@ entry) (http-trimmed (slice v start i))))
              (+= n 1)
              (set! start (+ i 1)))))))
    n))

;; http-request-address gives the client's address: the peer's, or behind the server's proxies, that many hops back
;; along X-Forwarded-For, as Express's trust proxy counts them.
(define (http-request-address [r (ptr http-request)]) -> string
  (let* ([hops (cast i64 (-> (http-request-server r) proxies))] [entry (-> r peer)] [n (forwarded r -1 (& entry))])
    (when (or (== hops 0) (== n 0)) (return entry))
    (forwarded r (if (> hops n) 0 (- n hops)) (& entry))
    (unported entry)))

;; unported gives an address without the port some proxies put after it, as Azure's Application Gateway writes
;; 1.2.3.4:5678 or [2001:db8::1]:5678.
(define (unported [a string]) -> string
  (let ([n (-> a length)] [colons u32 0] [last u32 0] [close u32 1])
    (when (and (> n 0) (== (@ a 0) 91))
      (while (and (< close n) (!= (@ a close) 93)) (+= close 1))
      (return (if (< close n) (slice a 1 close) a)))
    (for ([i u32 0]) (< i n) (+= i 1)
      (when (== (@ a i) 58)
        (+= colons 1)
        (set! last i)))
    (if (== colons 1) (slice a 0 last) a)))

;; http-request-https? tells whether the client asked over https: the server's TLS, or behind its proxies, the first
;; X-Forwarded-Proto.
(define (http-request-https? [r (ptr http-request)]) -> bool
  (let ([s (http-request-server r)] [proto (http-request-header r "x-forwarded-proto")] [i u32 0])
    (when (or (== (-> s proxies) 0) (== (-> proto length) 0)) (return (-> s secure)))
    (while (and (< i (-> proto length)) (!= (@ proto i) 44)) (+= i 1))
    (http-same? (http-trimmed (slice proto 0 i)) "https")))

;; http-log-access, as a server's on-done, logs each request at the info level to the server's log, or log-default: its
;; method and target; its status, or 499 when its client left before any answer, as nginx logs it; its body's bytes;
;; the milliseconds it took; and its client's address.
(define (http-log-access [r (ptr http-request)])
  (let ([s (http-request-server r)] [e log-entry] [ms (- (clock-monotonic) (-> r began))])
    (log-begin! (& e) (if (== (-> s log) 0) (& log-default) (-> s log)) log-info "request")
    (log-string! (& e) "method" (-> r method))
    (log-string! (& e) "target" (-> r target))
    (log-int! (& e) "status" (cast i64 (if (and (-> r gone) (not (-> r sent))) 499 (-> r status))))
    (log-int! (& e) "bytes" (-> r written))
    (log-float! (& e) "ms" (/ (nearbyint (* ms 1000.0)) 1000.0))
    (log-string! (& e) "address" (http-request-address r))
    (log-end! (& e))))

;; http-add-header! adds a header to the request's answer, for a check to add before the handler answers.
(define (http-add-header! [r (ptr http-request)] [name string] [value string])
  (http-write-header! (& (-> r added)) name value))

(define (new-request! [c (ptr http-connection)] [h (ptr http-head)]) -> (ptr http-request)
  (let ([r (cast (ptr http-request) (calloc 1 (sizeof http-request)))])
    (set! (-> r connection) (cast (ptr void) c))
    (set! (-> r server) (-> c server))
    (set! (-> r length) -1)
    (set! (-> r peer) (cast string (slice (cast (ptr u8) (arena-alloc (& (-> r arena)) (-> c peer length)))
                                           (-> c peer length))))
    (memcpy (-> r peer bytes) (-> c peer bytes) (-> c peer length))
    (http-head-copy! (& (-> r own-head)) h)
    (set! (-> r head) (& (-> r own-head)))
    (set! (-> r method) (-> r own-head method))
    (set! (-> r target) (-> r own-head target))
    (set! (-> r began) (if (> (-> c started) 0.0) (-> c started) (clock-monotonic)))
    (let ([t (timeout (-> (server-of c) request-timeout) 300000.0)])
      (set! (-> r deadline) (if (< t 0.0) 0.0 (+ (-> r began) t))))
    (set! (-> c request) r)
    r))

;; http-request-deadline! gives the rest of the request's body ms milliseconds from now to come, or as long as it takes
;; when ms is below 0, as an upload's handler may.
(define (http-request-deadline! [r (ptr http-request)] [ms f64])
  (set! (-> r deadline) (if (< ms 0.0) 0.0 (+ (clock-monotonic) ms)))
  (unless (== (-> r connection) 0) (time! (connection-of r))))

(define (release! [r (ptr http-request)])
  (let ([done (-> (http-request-server r) on-done)]) (unless (== done 0) (done r)))
  (arena-free (& (-> r arena)))
  (unzip! r)
  (buffer-free! (& (-> r body)))
  (buffer-free! (& (-> r added)))
  (http-head-free! (& (-> r own-head)))
  (free r))

(define (finished! [r (ptr http-request)])
  (if (> (-> r depth) 0) (set! (-> r done) #t) (release! r)))

(define (enter! [r (ptr http-request)]) -> (ptr http-request)
  (let ([previous running])
    (set! (-> r outer) previous)
    (set! running r)
    (+= (-> r depth) 1)
    previous))

(define (leave! [r (ptr http-request)] [previous (ptr http-request)])
  (set! running previous)
  (-= (-> r depth) 1)
  (when (and (== (-> r depth) 0) (-> r done)) (release! r)))

(define (run-handle! [r (ptr http-request)] [continue bool])
  (let ([previous (enter! r)] [s (http-request-server r)] [stopped #f])
    (for ([i u32 0]) (and (not stopped) (< i (-> s checks length))) (+= i 1)
      (let ([check (& (@ (-> s checks) i))]) (set! stopped ((-> check run) r (-> check settings)))))
    (unless stopped ((-> s handle) r))
    (when (and continue (not (-> r sent)) (!= (-> r connection) 0))
      (out! (connection-of r) (cast (slice u8) "HTTP/1.1 100 Continue\r\n\r\n")))
    (leave! r previous)))

(define (run-body! [r (ptr http-request)] [b (slice u8)])
  (let ([previous (enter! r)])
    ((-> r on-body) r b)
    (leave! r previous)))

(define (run-end! [r (ptr http-request)])
  (let ([previous (enter! r)])
    ((-> r on-end) r)
    (leave! r previous)))

;; gone! calls on-gone at most once.
(define (gone! [r (ptr http-request)])
  (let ([f (-> r on-gone)])
    (set! (-> r gone) #t)
    (set! (-> r on-gone) 0)
    (unless (== f 0)
      (let ([previous (enter! r)])
        (f r)
        (leave! r previous)))))

(define (run-drained! [r (ptr http-request)])
  (let ([previous (enter! r)])
    ((-> r on-drained) r)
    (leave! r previous)))

;; ---- traps ----

;; The trap handler http-serve! sets, which a program with its own calls from it. With no request's code running, the
;; program ends as with no handler.
(define (http-trapped [why string])
  (let ([r running])
    (when (== r 0)
      (host-write 2 (cast (slice u8) "error: "))
      (host-write 2 (cast (slice u8) why))
      (host-write 2 (cast (slice u8) "\n"))
      (host-exit 2))
    (set! running 0)
    (told! r why)
    (while (!= r 0)
      (let ([outer (-> r outer)])
        (set! (-> r depth) 0)
        (fail! r)
        (set! r outer)))))

(define (told! [r (ptr http-request)] [why string])
  (let ([s (http-request-server r)] [e log-entry])
    (cond [(!= (-> s on-trap) 0) ((-> s on-trap) r why)]
          [(!= (-> s log) 0)
           (log-begin! (& e) (-> s log) log-error "trap")
           (log-string! (& e) "method" (-> r method))
           (log-string! (& e) "target" (-> r target))
           (log-string! (& e) "reason" why)
           (log-end! (& e))]
          [else
           (let ([b (make-buffer)])
             (buffer-add-string! (& b) "error: ")
             (buffer-add-string! (& b) (-> r method))
             (buffer-add-byte! (& b) 32)
             (buffer-add-string! (& b) (-> r target))
             (buffer-add-string! (& b) ": ")
             (buffer-add-string! (& b) why)
             (buffer-add-byte! (& b) 10)
             (host-write 2 (buffer-bytes (& b)))
             (buffer-free! (& b)))])))

(define (fail! [r (ptr http-request)])
  (let ([c (connection-of r)])
    (cond [(== c 0) (when (-> r answered) (release! r))]
          [else
           (set! (-> r ended) #t)
           (set! (-> r on-body) 0)
           (set! (-> r on-end) 0)
           (set! (-> c feeding) #f)
           (set! (-> c closing) #t)
           (cond [(-> r answered) (settle! c)]
                 [(-> r sent)
                  (+= (-> r depth) 1)
                  (drop! c)
                  (-= (-> r depth) 1)
                  (set! (-> r answered) #t)
                  (release! r)]
                 [else (http-answer-text! r 500 "internal server error")])])))

;; ---- connections ----

(define (memory? [c (ptr http-connection)]) -> bool (!= (-> c sink) 0))

(define (out! [c (ptr http-connection)] [b (slice u8)]) -> i32
  (if (memory? c)
      (begin ((-> c sink) (-> c sink-tag) b) 0)
      (stream-write (-> c stream) b)))

(define (finish-out! [c (ptr http-connection)])
  (if (memory? c) ((-> c sink-ended) (-> c sink-tag)) (stream-finish (-> c stream))))

;; timeout gives one of a server's timeouts: the default when 0, and -1, none, when below 0.
(define (timeout [ms f64] [default f64]) -> f64 (cond [(< ms 0.0) -1.0] [(== ms 0.0) default] [else ms]))

(define (arm! [c (ptr http-connection)] [ms f64])
  (set! (-> c timer) (timer-after (if (< ms 0.0) 0.0 ms) (cast (ptr void) c))))

;; time! sets the connection's timer for what it waits for: the client to send after the server has ended its side, or
;; to read an answer; the rest of a request; the rest of a head; or the next request.
(define (time! [c (ptr http-connection)])
  (let* ([s (server-of c)] [r (-> c request)] [now (clock-monotonic)] [head (timeout (-> s head-timeout) 60000.0)]
         [send (timeout (-> s send-timeout) 60000.0)]
         [idle (timeout (-> s idle-timeout) (if (> (-> s proxies) 0) 130000.0 5000.0))])
    (disarm! c)
    (cond [(memory? c) (begin)]
          [(-> c lingering) (arm! c (if (< (- (-> c linger-end) now) 5000.0) (- (-> c linger-end) now) 5000.0))]
          [(-> c full) (unless (< send 0.0) (arm! c send))]
          [(-> c busy) (unless (or (== r 0) (-> r ended) (<= (-> r deadline) 0.0)) (arm! c (- (-> r deadline) now)))]
          [(-> c closing) (begin)]
          [(> (-> c started) 0.0) (unless (< head 0.0) (arm! c (- (+ (-> c started) head) now)))]
          [else (unless (< idle 0.0) (arm! c idle))])))

(define (read-more! [c (ptr http-connection)])
  (unless (or (memory? c) (-> c reading))
    (set! (-> c reading) #t)
    (stream-take! (-> c stream) 65536)))

;; listen! reads while a request waits for its answer, without a timer, to hear its client leave.
(define (listen! [c (ptr http-connection)])
  (unless (or (-> c reading) (memory? c) (-> c half-closed) (> (-> c rest length) 0))
    (set! (-> c reading) #t)
    (stream-take! (-> c stream) 65536)))

(define (free-block! [c (ptr http-connection)])
  (free (-> c block))
  (set! (-> c block) 0))

;; taken! gives the bytes of the read that has come, kept as the connection's block.
(define (taken! [c (ptr http-connection)]) -> (slice u8)
  (let ([b (events-take)])
    (free-block! c)
    (set! (-> c block) (-> b items))
    b))

(define (disarm! [c (ptr http-connection)])
  (when (!= (-> c timer) 0)
    (timer-cancel (-> c timer))
    (set! (-> c timer) 0)))

(define (may-read! [c (ptr http-connection)])
  (if (or (not (-> c busy)) (not (-> c request ended))) (read-more! c) (listen! c)))

(define (unlink! [c (ptr http-connection)])
  (let ([s (server-of c)])
    (disarm! c)
    (if (== (-> s connections) c)
        (set! (-> s connections) (-> c next))
        (let ([before (-> s connections)])
          (while (and (!= before 0) (!= (-> before next) c)) (set! before (-> before next)))
          (when (!= before 0) (set! (-> before next) (-> c next)))))))

;; drop! ends the connection, or, while the parser has its bytes, takes it from the server's list and has feed! end it
;; once the parser returns.
(define (drop! [c (ptr http-connection)])
  (cond [(not (-> c feeding)) (discard! c)]
        [(not (-> c doomed))
         (set! (-> c doomed) #t)
         (unlink! c)
         (http-parser-stop! (& (-> c parser)))]))

(define (discard! [c (ptr http-connection)])
  (let ([r (-> c request)] [relaying (!= (-> c relay) 0)] [s (server-of c)])
    (set! (-> c request) 0)
    (when relaying
      (stream-close (-> c relay from))
      (free (-> c relay)))
    (unlink! c)
    (buffer-free! (& (-> c out)))
    (http-head-free! (& (-> c parser head)))
    (buffer-free! (& (-> c parser line)))
    (free (-> c peer bytes))
    (set! (-> c peer) "")
    (free-block! c)
    (cond [(not (memory? c))
           (stream-close (-> c stream))
           (free c)]
          [else
           (set! (-> c dropped) #t)
           (unless (== (-> c sink-ended) 0) ((-> c sink-ended) (-> c sink-tag)))])
    (unless (== r 0)
      (set! (-> r connection) 0)
      (when relaying (set! (-> r answered) #t))
      (if (-> r answered) (finished! r) (gone! r)))
    (stopped? s)))

(define (settle! [c (ptr http-connection)])
  (let ([r (-> c request)])
    (when (and (-> c busy) (!= r 0) (-> r ended) (-> r answered))
      (set! (-> c busy) #f)
      (set! (-> c request) 0)
      (set! (-> c started) 0.0)
      (set! (-> c discarded) 0)
      (set! (-> r connection) 0)
      (finished! r)
      (cond [(-> c closing) (finish-out! c)]
            [(not (or (-> c feeding) (-> c full))) (resume! c)]))))

(define (resume! [c (ptr http-connection)])
  (http-parser-resume! (& (-> c parser)))
  (feed! c (-> c rest)))

(define (bad-request! [c (ptr http-connection)])
  (set! (-> c closing) #t)
  (let ([r (-> c request)])
    (cond [(not (-> c busy))
           (let ([b (& (-> c out))])
             (set! (-> b length) 0)
             (http-write-status! b 400)
             (http-write-date! b (clock-now))
             (buffer-add-string! b "content-length: 0\r\nconnection: close\r\n\r\n")
             (out! c (buffer-bytes b))
             (set! (-> b length) 0))
           (finish-out! c)]
          [(not (-> r ended))
           (set! (-> r failed) #t)
           (set! (-> r ended) #t)
           (set! (-> r on-body) 0)
           (unless (== (-> r on-end) 0) (run-end! r))
           (settle! c)]
          [else (settle! c)])))

;; origin-form! turns a target in absolute form, scheme://host/path?query, into its path and query, and makes its host
;; the Host header's value. It returns #f when the host is empty or has user information.
(define (origin-form! [h (ptr http-head)]) -> bool
  (let* ([t (-> h target)] [n (-> t length)] [p (-> t bytes)] [i u32 0] [start u32 0] [host string])
    (while (and (< i n) (or (and (>= (@ t i) 97) (<= (@ t i) 122)) (and (>= (@ t i) 65) (<= (@ t i) 90)))) (+= i 1))
    (unless (and (> i 0) (< (+ i 2) n) (== (@ t i) 58) (== (@ t (+ i 1)) 47) (== (@ t (+ i 2)) 47)) (return #t))
    (set! start (+ i 3))
    (set! i start)
    (while (and (< i n) (!= (@ t i) 47) (!= (@ t i) 63))
      (when (== (@ t i) 64) (return #f))
      (+= i 1))
    (when (== i start) (return #f))
    (if (and (< i n) (== (@ t i) 47))
        (set! host (slice t start i))
        (begin
          (memcpy (+ p (- start 1)) (+ p start) (- i start))
          (set! (@ p (- i 1)) 47)
          (set! host (slice t (- start 1) (- i 1)))
          (-= i 1)))
    (for ([k u32 0]) (< k (-> h count)) (+= k 1)
      (when (== (@ (-> h names) k) "host") (set! (@ (-> h values) k) host)))
    (set! (-> h target) (slice t i))
    #t))

(define (on-head [p (ptr http-parser)])
  (let* ([c (cast (ptr http-connection) (-> p user))] [h (& (-> p head))]
         [old (== (-> h version) "HTTP/1.0")] [hosts (http-header-count h "host")])
    (if (or (!= (-> h status) 0) (> hosts 1) (and (== hosts 0) (not old)) (not (origin-form! h)))
        (http-parser-refuse! p)
        (let ([r (new-request! c h)])
          (set! (-> c busy) #t)
          (when (or old (http-header-has? h "connection" "close")) (set! (-> c closing) #t))
          (run-handle! r (and (not old) (http-header-has? h "expect" "100-continue")))))))

(define (on-body [p (ptr http-parser)] [b (slice u8)])
  (let* ([c (cast (ptr http-connection) (-> p user))] [r (-> c request)])
    (cond [(== r 0) (begin)]
          [(!= (-> r on-body) 0) (run-body! r b)]
          [(-> r answered)
           (+= (-> c discarded) (cast u64 (-> b length)))
           (when (or (> (-> c discarded) most-dropped)
                     (> (- (-> p remaining) (cast i64 (-> b length))) (cast i64 most-dropped)))
             (abandon! c))])))

;; abandon! closes the connection of a request answered before its body came, rather than read the rest.
(define (abandon! [c (ptr http-connection)])
  (set! (-> c closing) #t)
  (http-parser-stop! (& (-> c parser)))
  (set! (-> c request ended) #t)
  (settle! c))

(define (on-end [p (ptr http-parser)])
  (let* ([c (cast (ptr http-connection) (-> p user))] [r (-> c request)])
    (if (== r 0)
        (http-parser-stop! p)
        (begin
          (set! (-> r ended) #t)
          (unless (== (-> r on-end) 0) (run-end! r))
          (when (or (and (== (-> c request) r) (not (-> r answered))) (-> c closing) (-> c full)) (http-parser-stop! p))
          (settle! c)))))

;; hand-over! gives the connection's stream to its taker, with the bytes read beyond the request.
(define (hand-over! [c (ptr http-connection)] [b (slice u8)])
  (let ([take (-> c take)] [held (& (-> c parser head line))] [r (-> c request)] [s (server-of c)])
    (set! (-> c take) 0)
    (set! (-> c request) 0)
    (unless (and (!= r 0) (-> r ended)) (set! (-> held length) 0))
    (buffer-add! held b)
    (free-block! c)
    (unlink! c)
    (stream-tag! (-> c stream) 0)
    (take (-> c taken) (-> c stream) (buffer-bytes held))
    (buffer-free! (& (-> c out)))
    (http-head-free! (& (-> c parser head)))
    (buffer-free! (& (-> c parser line)))
    (free (-> c peer bytes))
    (free c)
    (unless (== r 0)
      (set! (-> r connection) 0)
      (set! (-> r answered) #t)
      (finished! r))
    (stopped? s)))

(define (feed! [c (ptr http-connection)] [b (slice u8)])
  (set! (-> c rest) 0)
  (set! (-> c feeding) #t)
  (when (and (not (-> c busy)) (== (-> c started) 0.0) (> (-> b length) 0)) (set! (-> c started) (clock-monotonic)))
  (let ([used (http-feed! (& (-> c parser)) b)])
    (set! (-> c feeding) #f)
    (when (-> c doomed)
      (discard! c)
      (return))
    (when (and (not (-> c busy)) (== (-> c started) 0.0) (> (-> c parser head line length) 0))
      (set! (-> c started) (clock-monotonic)))
    (cond [(< used 0) (bad-request! c)]
          [(!= (-> c take) 0) (hand-over! c (slice b (cast u32 used)))]
          [(< (cast u32 used) (-> b length))
           (set! (-> c rest) (slice b (cast u32 used)))
           (time! c)]
          [else
           (free-block! c)
           (when (and (not (-> c busy)) (== (-> c parser head line length) 0))
             (http-head-free! (& (-> c parser head)))
             (buffer-free! (& (-> c parser line)))
             (buffer-trim! (& (-> c out)) 0))
           (may-read! c)
           (time! c)])))

;; half-closed! hears a client end its side once its request has come: the answer still goes, then the connection
;; closes. An answer that a relay sends is not told.
(define (half-closed! [c (ptr http-connection)])
  (set! (-> c half-closed) #t)
  (set! (-> c closing) #t)
  (when (== (-> c relay) 0) (gone! (-> c request))))

(define (drained! [c (ptr http-connection)])
  (let ([waited (-> c full)] [r (-> c request)] [p (-> c relay)])
    (set! (-> c full) #f)
    (time! c)
    (cond [(!= p 0)
           (when (-> p waiting)
             (set! (-> p waiting) #f)
             (relay-read! p))]
          [(and (!= r 0) (-> r sent) (not (-> r answered)) (!= (-> r on-drained) 0)) (run-drained! r)]
          [(and waited (not (or (-> c busy) (-> c closing)))) (resume! c)])))

;; linger! reads on once the server has ended its side, dropping what comes, until the client ends its side, 5 s pass
;; without bytes, or 30 s in all, as nginx's lingering close does.
(define (linger! [c (ptr http-connection)])
  (set! (-> c lingering) #t)
  (set! (-> c linger-end) (+ (clock-monotonic) 30000.0))
  (set! (-> c rest) 0)
  (free-block! c)
  (read-more! c)
  (time! c))

(define (connection-heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([c (cast (ptr http-connection) tag)])
    (when (and (== source stream-source) (== kind stream-read)) (set! (-> c reading) #f))
    (cond [(== source timer-source) (when (== id (-> c timer)) (drop! c))]
          [(-> c lingering)
           (cond [(and (== kind stream-read) (> value 0))
                  (free (-> (events-take) items))
                  (read-more! c)
                  (time! c)]
                 [(or (== kind stream-read) (== kind stream-failed)) (drop! c)])]
          [(and (== kind stream-read) (> value 0)) (feed! c (taken! c))]
          [(and (!= (-> c take) 0) (not (-> c reading))) (hand-over! c 0)]
          [(and (== kind stream-read) (-> c busy) (-> c request ended)) (half-closed! c)]
          [(and (== kind stream-read) (-> c busy)) (drop! c)]
          [(== kind stream-read)
           (set! (-> c half-closed) #t)
           (set! (-> c closing) #t)
           (stream-finish (-> c stream))]
          [(== kind stream-drained) (drained! c)]
          [(== kind stream-finished) (if (-> c half-closed) (drop! c) (linger! c))]
          [(== kind stream-failed) (drop! c)])))

(define (new-connection! [s (ptr http-server)] [stream u32]) -> (ptr http-connection)
  (let ([c (cast (ptr http-connection) (calloc 1 (sizeof http-connection)))])
    (set! (-> c head handle) connection-heard)
    (set! (-> c server) (cast (ptr void) s))
    (set! (-> c stream) stream)
    (http-parser-init! (& (-> c parser)) (cast (ptr void) c) on-head on-body on-end)
    (set! (-> c out) (make-buffer))
    (set! (-> c next) (-> s connections))
    (set! (-> s connections) c)
    c))

;; unmapped gives an IPv4 address that Node gives mapped into IPv6, as ::ffff:1.2.3.4, as 1.2.3.4, in the same block.
(define (unmapped [peer string]) -> string
  (let ([n (-> peer length)] [dotted #f])
    (unless (and (> n 7) (== (slice peer 0 7) "::ffff:")) (return peer))
    (for ([i u32 7]) (< i n) (+= i 1) (when (== (@ peer i) 46) (set! dotted #t)))
    (unless dotted (return peer))
    (memcpy (-> peer bytes) (+ (-> peer bytes) 7) (- n 7))
    (slice peer 0 (- n 7))))

(define (accept! [s (ptr http-server)] [stream u32])
  (let ([c (new-connection! s stream)])
    (set! (-> c peer) (unmapped (events-take-text)))
    (set! (-> c started) (clock-monotonic))
    (stream-tag! stream (cast (ptr void) c))
    (read-more! c)
    (time! c)))

;; ---- compression ----

;; How an answer is compressed: not, whole by http-send!, as each piece is written, or each event alone.
(const zip-none i32 0)
(const zip-whole i32 1)
(const zip-pieces i32 2)
(const zip-events i32 3)

;; Bodies shorter than this are sent as they are, as Express's compression leaves them.
(const zip-least i64 1024)

;; compressible? tells whether a content type compresses: text, JSON, JavaScript, XML, SVG, wasm and two kinds of font.
(define (compressible? [value string]) -> bool
  (let* ([t (http-media-type value)] [n (-> t length)])
    (or (and (>= n 5) (http-same? (slice t 0 5) "text/")) (http-same? t "application/json")
        (http-same? t "application/javascript") (http-same? t "application/xml") (http-same? t "application/wasm")
        (http-same? t "image/svg+xml") (http-same? t "font/ttf") (http-same? t "font/otf")
        (and (>= n 5) (http-same? (slice t (- n 5)) "+json")) (and (>= n 4) (http-same? (slice t (- n 4)) "+xml")))))

;; weightless? tells whether the value of a q parameter is 0.
(define (weightless? [q string]) -> bool
  (when (or (== (-> q length) 0) (!= (@ q 0) #\0)) (return #f))
  (for ([i u32 1]) (< i (-> q length)) (+= i 1)
    (unless (or (== (@ q i) #\.) (== (@ q i) #\0)) (return #f)))
  #t)

;; accepts-gzip? reads Accept-Encoding: gzip, or else *, with a weight above 0.
(define (accepts-gzip? [r (ptr http-request)]) -> bool
  (let ([v (http-request-header r "accept-encoding")] [i u32 0] [gzip i32 -1] [any i32 -1])
    (while (< i (-> v length))
      (let ([end i] [k i])
        (while (and (< end (-> v length)) (!= (@ v end) 44)) (+= end 1))
        (while (and (< k end) (!= (@ v k) #\;)) (+= k 1))
        (let ([coding (http-trimmed (slice v i k))] [taken i32 1])
          (while (< k end)
            (let ([start (+ k 1)])
              (set! k start)
              (while (and (< k end) (!= (@ v k) #\;)) (+= k 1))
              (let ([p (http-trimmed (slice v start k))])
                (when (and (>= (-> p length) 2) (http-same? (slice p 0 2) "q=")
                           (weightless? (http-trimmed (slice p 2))))
                  (set! taken 0)))))
          (cond [(or (http-same? coding "gzip") (http-same? coding "x-gzip")) (set! gzip taken)]
                [(== coding "*") (set! any taken)]))
        (set! i (+ end 1))))
    (if (>= gzip 0) (== gzip 1) (== any 1))))

;; zip? tells whether to compress the answer: compression is on, the body's type compresses, nothing has encoded it
;; or forbids that, it is not a range, and the client takes gzip.
(define (zip? [r (ptr http-request)]) -> bool
  (and (> (-> (http-request-server r) compress) 0) (-> r compressible) (not (-> r encoded)) (has-body? r)
       (!= (-> r status) 206) (accepts-gzip? r)))

;; One deflater compresses every whole answer and event, each in turn, since each is done before the next begins; zipped
;; holds what it gives.
(define shared deflater)
(define shared-level i32 0)
(define zipped buffer)

(define (shared-at [level i32]) -> (ptr deflater)
  (unless (== shared-level level)
    (unless (== shared-level 0) (deflater-free! (& shared)))
    (deflater-init! (& shared) level)
    (set! shared-level level))
  (& shared))

;; padded-start! begins a gzip member named by 1 to 100 random letters, so that the sizes of answers vary, as Django's
;; GZipMiddleware does against BREACH.
(define (padded-start! [b (ptr buffer)])
  (let ([name (array u8 101)])
    (random-fill (slice (& (@ name 0)) 101))
    (let ([n (+ 1 (% (cast u32 (@ name 0)) 100))])
      (for ([i u32 1]) (<= i n) (+= i 1) (set! (@ name i) (cast u8 (+ 97 (% (cast u32 (@ name i)) 26)))))
      (gzip-start! b (cast string (slice (& (@ name 1)) n))))))

;; zip-piece! sends a piece of the body compressed: an event alone, or else after what came before, ending at a whole
;; byte so that the client can read all of it.
(define (zip-piece! [r (ptr http-request)] [c (ptr http-connection)] [b (slice u8)])
  (set! (-> zipped length) 0)
  (set! (-> r crc) (crc32 (-> r crc) b))
  (+= (-> r size) (-> b length))
  (if (== (-> r gzip) zip-events)
      (deflate-alone! (shared-at (-> (http-request-server r) compress)) (& zipped) b)
      (deflate! (-> r deflater) (& zipped) b deflate-sync))
  (piece! r c (buffer-bytes (& zipped)))
  (set! (-> zipped length) 0)
  (buffer-trim! (& zipped) 65536))

;; zip-end! ends the compressed body and its gzip member.
(define (zip-end! [r (ptr http-request)] [c (ptr http-connection)])
  (set! (-> zipped length) 0)
  (if (== (-> r gzip) zip-events)
      (begin
        (buffer-add-byte! (& zipped) 3)
        (buffer-add-byte! (& zipped) 0))
      (deflate! (-> r deflater) (& zipped) (cast (slice u8) "") deflate-finish))
  (gzip-end! (& zipped) (-> r crc) (-> r size))
  (piece! r c (buffer-bytes (& zipped)))
  (set! (-> zipped length) 0)
  (unzip! r))

;; unzip! frees the deflater of an answer compressed as it is written.
(define (unzip! [r (ptr http-request)])
  (unless (== (-> r deflater) 0)
    (deflater-free! (-> r deflater))
    (free (-> r deflater))
    (set! (-> r deflater) 0)))

;; ---- answering ----

(define (http-respond! [r (ptr http-request)] [status i32])
  (let ([c (connection-of r)])
    (set! (-> r status) status)
    (set! (-> r length) -1)
    (unless (== c 0)
      (set! (-> c out length) 0)
      (buffer-reserve (& (-> c out)) 512)
      (http-write-status! (& (-> c out)) status)
      (http-write-date! (& (-> c out)) (clock-now))
      (when (-> c closing) (http-write-header! (& (-> c out)) "connection" "close"))
      (buffer-add! (& (-> c out)) (buffer-bytes (& (-> r added)))))))

(define (http-header! [r (ptr http-request)] [name string] [value string])
  (let ([c (connection-of r)])
    (cond [(http-same? name "content-type")
           (set! (-> r compressible) (compressible? value))
           (set! (-> r events) (http-media-type? value "text/event-stream"))]
          [(http-same? name "content-encoding") (set! (-> r encoded) #t)]
          [(and (http-same? name "cache-control") (http-has-token? value "no-transform")) (set! (-> r encoded) #t)])
    (unless (== c 0) (http-write-header! (& (-> c out)) name value))))

;; http-length! declares the length of the body, which the head gives as it ends.
(define (http-length! [r (ptr http-request)] [n i64]) (set! (-> r length) n))

(define (has-length? [r (ptr http-request)]) -> bool
  (not (or (< (-> r status) 200) (== (-> r status) 204) (== (-> r status) 304))))

(define (has-body? [r (ptr http-request)]) -> bool (and (has-length? r) (!= (-> r method) "HEAD")))

;; validators! writes the answer's validators: Last-Modified only without an ETag on a 304, as Go writes them, and the
;; ETag made weak on an answer compressed here, as nginx makes it, which takes no ranges.
(define (validators! [r (ptr http-request)] [b (ptr buffer)])
  (let ([status (-> r status)] [etag (-> r etag)])
    (when (or (and (>= status 200) (< status 300)) (== status 304))
      (cond [(== (-> etag length) 0) (begin)]
            [(and (!= (-> r gzip) zip-none) (not (and (>= (-> etag length) 2) (== (slice etag 0 2) "W/"))))
             (buffer-add-string! b "etag: W/")
             (buffer-add-string! b etag)
             (buffer-add-string! b "\r\n")]
            [else (http-write-header! b "etag" etag)])
      (when (and (> (-> r modified) 0.0) (not (and (== status 304) (> (-> etag length) 0))))
        (buffer-add-string! b "last-modified: ")
        (http-add-date! b (-> r modified))
        (buffer-add-string! b "\r\n"))
      (when (and (-> r ranges) (!= status 304) (== (-> r gzip) zip-none))
        (http-write-header! b "accept-ranges" "bytes")))))

;; head! ends the head, framing the body by its declared length, in chunks for HTTP/1.1, or else by closing the
;; connection. A body that it compresses as it is written goes in chunks too, after a gzip header.
(define (head! [r (ptr http-request)] [c (ptr http-connection)])
  (let ([s (http-request-server r)] [b (& (-> c out))])
    (when (and (== (-> r gzip) zip-none) (or (< (-> r length) 0) (>= (-> r length) zip-least)) (zip? r))
      (set! (-> r gzip) (if (-> r events) zip-events zip-pieces))
      (when (== (-> r gzip) zip-pieces)
        (set! (-> r deflater) (cast (ptr deflater) (malloc (sizeof deflater))))
        (deflater-init! (-> r deflater) (-> s compress))))
    (when (and (has-length? r) (>= (-> r length) 0) (< (-> r gzip) zip-pieces))
      (http-write-number! b "content-length" (-> r length)))
    (unless (== (-> r gzip) zip-none) (http-write-header! b "content-encoding" "gzip"))
    (when (and (> (-> s compress) 0) (not (-> r encoded)) (or (-> r compressible) (== (-> r status) 304)))
      (http-write-header! b "vary" "accept-encoding"))
    (validators! r b)
    (set! (-> r sent) #t)
    (when (and (has-body? r) (or (< (-> r length) 0) (>= (-> r gzip) zip-pieces)))
      (if (== (-> r head version) "HTTP/1.0")
          (set! (-> c closing) #t)
          (begin
            (set! (-> r chunked) #t)
            (http-write-header! b "transfer-encoding" "chunked"))))
    (http-write-end! b)
    (when (>= (-> r gzip) zip-pieces)
      (set! (-> zipped length) 0)
      (padded-start! (& zipped))
      (piece! r c (buffer-bytes (& zipped)))
      (set! (-> zipped length) 0))))

(define (flush! [c (ptr http-connection)]) -> bool
  (let ([full (== (out! c (buffer-bytes (& (-> c out)))) 1)])
    (set! (-> c out length) 0)
    (buffer-trim! (& (-> c out)) 4096)
    (when full
      (set! (-> c full) #t)
      (time! c))
    (not full)))

;; answered! gives up at once a body left unread with over 256 KB to come, or that the client was to send only once
;; told to continue, as Go does.
(define (answered! [r (ptr http-request)])
  (set! (-> r answered) #t)
  (let ([c (connection-of r)])
    (cond [(== c 0) (finished! r)]
          [(and (not (-> r ended)) (== (-> r on-body) 0)
                (or (> (-> c parser remaining) (cast i64 most-dropped))
                    (http-header-has? (-> r head) "expect" "100-continue")))
           (abandon! c)]
          [else (settle! c)])))

;; http-write! sends a piece of the body, after the head the first time. With no declared length the body goes in
;; chunks, or to an HTTP/1.0 client until the connection closes; http-finish! ends it. It returns #f when the request is
;; gone or the connection is full, when on-drained is called once it has room. A piece over 1 KB is written from where
;; it is.
(define (http-write! [r (ptr http-request)] [b (slice u8)]) -> bool
  (let ([c (connection-of r)] [n (-> b length)])
    (when (== c 0) (return #f))
    (when (-> r answered) (host-trap "http: a write after the answer"))
    (when (and (>= (-> r length) 0) (> (+ (-> r written) (cast i64 n)) (-> r length)) (has-body? r))
      (host-trap "http: a body longer than its content-length"))
    (unless (-> r sent) (head! r c))
    (when (and (has-body? r) (> n 0))
      (+= (-> r written) (cast i64 n))
      (if (>= (-> r gzip) zip-pieces) (zip-piece! r c b) (piece! r c b)))
    (if (> (-> c out length) 0) (flush! c) (not (-> c full)))))

;; piece! sends bytes of the body as they go out: in a chunk when chunked, and from where they are when over 1 KB.
(define (piece! [r (ptr http-request)] [c (ptr http-connection)] [b (slice u8)])
  (let ([n (-> b length)])
    (cond [(== n 0) (begin)]
          [(<= n 1024) (if (-> r chunked) (http-write-chunk! (& (-> c out)) b) (buffer-add! (& (-> c out)) b))]
          [else
           (when (-> r chunked) (http-write-chunk-size! (& (-> c out)) n))
           (when (> (-> c out length) 0) (flush! c))
           (when (== (out! c b) 1) (set! (-> c full) #t))
           (when (-> r chunked) (http-write-end! (& (-> c out))))])))

;; http-finish! ends the answer, with no body when nothing was written. A body shorter than its declared length closes
;; the connection.
(define (http-finish! [r (ptr http-request)])
  (let ([c (connection-of r)])
    (unless (or (== c 0) (-> r answered))
      (unless (-> r sent)
        (when (and (has-body? r) (< (-> r length) 0)) (http-length! r 0))
        (head! r c))
      (when (>= (-> r gzip) zip-pieces) (zip-end! r c))
      (cond [(-> r chunked) (http-write-last-chunk! (& (-> c out)))]
            [(and (has-body? r) (< (-> r written) (-> r length)) (< (-> r gzip) zip-pieces)) (set! (-> c closing) #t)])
      (when (> (-> c out length) 0) (flush! c))))
  (answered! r))

;; http-send! sends the body whole, compressed at once when it compresses, with its length either way.
(define (http-send! [r (ptr http-request)] [b (slice u8)])
  (if (and (!= (-> r connection) 0) (not (-> r sent)) (>= (-> b length) zip-least) (zip? r))
      (let ([d (shared-at (-> (http-request-server r) compress))] [z (make-buffer)])
        (padded-start! (& z))
        (deflater-reset! d)
        (deflate! d (& z) b deflate-finish)
        (gzip-end! (& z) (crc32 0 b) (-> b length))
        (set! (-> r gzip) zip-whole)
        (set! (-> r length) (cast i64 (-> z length)))
        (http-write! r (buffer-bytes (& z)))
        (http-finish! r)
        (buffer-free! (& z)))
      (begin
        (when (and (has-length? r) (< (-> r length) 0)) (http-length! r (cast i64 (-> b length))))
        (http-write! r b)
        (http-finish! r))))

(define (http-send-text! [r (ptr http-request)] [text string]) (http-send! r (cast (slice u8) text)))

(define (http-answer-text! [r (ptr http-request)] [status i32] [text string])
  (http-respond! r status)
  (http-header! r "content-type" "text/plain; charset=utf-8")
  (http-send-text! r text))

(define (http-redirect! [r (ptr http-request)] [status i32] [location string])
  (http-respond! r status)
  (http-header! r "location" location)
  (http-finish! r))

;; ---- relays ----

(define (relay-read! [p (ptr relay)])
  (let ([left (-> p left)])
    (if (== left 0)
        (relayed! p #f)
        (stream-take! (-> p from) (if (and (> left 0) (< left 65536)) (cast u32 left) 65536)))))

(define (relayed! [p (ptr relay)] [failed bool])
  (let* ([c (cast (ptr http-connection) (-> p connection))] [r (-> c request)])
    (set! (-> c relay) 0)
    (stream-close (-> p from))
    (free p)
    (if failed
        (begin
          (set! (-> r answered) #t)
          (drop! c))
        (http-finish! r))))

(define (relay-heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let* ([p (cast (ptr relay) tag)] [r (-> (cast (ptr http-connection) (-> p connection)) request)])
    (cond [(and (== kind stream-read) (> value 0))
           (when (> (-> p left) 0) (-= (-> p left) (cast i64 value)))
           (let* ([b (events-take)] [room (http-write! r b)])
             (free (-> b items))
             (if room (relay-read! p) (set! (-> p waiting) #t)))]
          [(== kind stream-read) (relayed! p #f)]
          [(== kind stream-failed) (relayed! p #t)])))

;; http-send-stream! sends n bytes of the stream as the body, or all of it when n is -1. A stream that ends before n
;; bytes closes the connection.
(define (http-send-stream! [r (ptr http-request)] [from u32] [n i64])
  (let ([c (connection-of r)])
    (when (and (>= n 0) (has-length? r) (< (-> r length) 0)) (http-length! r n))
    (if (or (== c 0) (not (has-body? r)))
        (begin
          (stream-close from)
          (http-finish! r))
        (let ([p (cast (ptr relay) (malloc (sizeof relay)))])
          (http-write! r 0)
          (set! (-> p head handle) relay-heard)
          (set! (-> p from) from)
          (set! (-> p left) n)
          (set! (-> p connection) (cast (ptr void) c))
          (set! (-> p waiting) #f)
          (set! (-> c relay) p)
          (stream-tag! from (cast (ptr void) p))
          (relay-read! p)))))

;; http-take! sends the head alone, and gives the connection's stream, untagged, to the taker once the handler has
;; returned. The connection counts toward most until the stream closes.
(define (http-take! [r (ptr http-request)] [take taker] [tag (ptr void)])
  (let ([c (connection-of r)])
    (cond [(== c 0) (answered! r)]
          [(memory? c) (host-trap "http: a connection without a stream cannot be taken")]
          [else
           (set! (-> r sent) #t)
           (http-write-end! (& (-> c out)))
           (flush! c)
           (set! (-> c take) take)
           (set! (-> c taken) tag)
           (http-parser-stop! (& (-> c parser)))
           (unless (or (-> c feeding) (-> c reading)) (hand-over! c (-> c rest)))])))

;; ---- reading bodies ----

;; http-read-body! gives taken the whole body once it has come. A body longer than limit, the server's when 0, is
;; answered with 413 and its connection closed; a malformed one with 400.
(define (http-read-body! [r (ptr http-request)] [limit u32] [taken (fn ((ptr http-request) (slice u8)))])
  (let* ([s (http-request-server r)]
         [most (cond [(> limit 0) limit] [(> (-> s body-limit) 0) (-> s body-limit)] [else default-body-limit])]
         [length (http-request-header r "content-length")])
    (set! (-> r limit) most)
    (set! (-> r taken) taken)
    (cond [(and (> (-> length length) 0) (> (http-decimal length) (cast i64 most))) (too-large! r)]
          [(-> r ended) (taken r (buffer-bytes (& (-> r body))))]
          [else
           (set! (-> r on-body) body-piece)
           (set! (-> r on-end) body-ended)])))

(define (body-piece [r (ptr http-request)] [b (slice u8)])
  (if (> (+ (cast u64 (-> r body length)) (cast u64 (-> b length))) (cast u64 (-> r limit)))
      (too-large! r)
      (buffer-add! (& (-> r body)) b)))

(define (body-ended [r (ptr http-request)])
  (cond [(-> r failed) (http-answer-text! r 400 "bad request")]
        [else ((-> r taken) r (buffer-bytes (& (-> r body))))]))

(define (too-large! [r (ptr http-request)])
  (let ([c (connection-of r)])
    (set! (-> r on-body) 0)
    (set! (-> r on-end) 0)
    (set! (-> r ended) #t)
    (unless (== c 0)
      (set! (-> c closing) #t)
      (http-parser-stop! (& (-> c parser))))
    (http-answer-text! r 413 "content too large")))

;; ---- the server ----

(define (server-heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([s (cast (ptr http-server) tag)])
    (cond [(== source timer-source) (when (== id (-> s stop-timer)) (stop-now! s))]
          [(== kind net-listening)
           (set! (-> s port) (cast u32 value))
           (when (!= (-> s listening) 0) ((-> s listening) s))]
          [(== kind net-accept) (if (-> s stopping) (stream-close (cast u32 value)) (accept! s (cast u32 value)))]
          [(== kind net-failed)
           (set! (-> s port) 0)
           (set! (-> s problem) (events-take-text))
           (when (!= (-> s listening) 0) ((-> s listening) s))])))

(define (http-serve! [s (ptr http-server)] [port u32] [handle (fn ((ptr http-request)))]) -> u32
  (trap-handler! http-trapped)
  (set! (-> s head handle) server-heard)
  (set! (-> s handle) handle)
  (set! (-> s connections) 0)
  (set! (-> s port) 0)
  (set! (-> s problem) "")
  (set! (-> s listener) (net-listen port (-> s host) (-> s secure) (-> s most) (cast (ptr void) s) (& (-> s problem))))
  (-> s listener))

;; http-server-close! stops listening and drops every connection at once, and runs the hooks forced.
(define (http-server-close! [s (ptr http-server)])
  (unless (== (-> s listener) 0) (net-close (-> s listener)))
  (set! (-> s listener) 0)
  (while (!= (-> s connections) 0) (drop! (-> s connections)))
  (run-hooks! s #t))

;; ---- shutting down ----

;; http-hook! has the hook run when the server shuts down; http-unhook! takes it back as its owner ends.
(define (http-hook! [s (ptr http-server)] [h (ptr http-hook)])
  (set! (-> h server) (cast (ptr void) s))
  (set! (-> h previous) 0)
  (set! (-> h next) (-> s hooks))
  (unless (== (-> s hooks) 0) (set! (-> s hooks previous) h))
  (set! (-> s hooks) h))

(define (http-unhook! [h (ptr http-hook)])
  (let ([s (cast (ptr http-server) (-> h server))])
    (unless (== s 0)
      (if (== (-> h previous) 0) (set! (-> s hooks) (-> h next)) (set! (-> h previous next) (-> h next)))
      (unless (== (-> h next) 0) (set! (-> h next previous) (-> h previous)))
      (set! (-> h server) 0)
      (stopped? s))))

(define (run-hooks! [s (ptr http-server)] [forced bool])
  (let ([h (-> s hooks)])
    (while (!= h 0)
      (let ([next (-> h next)])
        ((-> h run) (-> h tag) forced)
        (set! h next)))))

(define (stopped! [s (ptr http-server)])
  (let ([done (-> s stopped)])
    (timer-cancel (-> s stop-timer))
    (set! (-> s stop-timer) 0)
    (set! (-> s stopped) 0)
    (unless (== done 0) (done s))))

(define (stopped? [s (ptr http-server)])
  (when (and (-> s stopping) (!= (-> s stop-timer) 0) (== (-> s connections) 0) (== (-> s hooks) 0)) (stopped! s)))

;; stop-now! ends what remains once the time to finish is up.
(define (stop-now! [s (ptr http-server)])
  (set! (-> s stop-timer) 0)
  (while (!= (-> s connections) 0) (drop! (-> s connections)))
  (run-hooks! s #t)
  (while (!= (-> s hooks) 0) (http-unhook! (-> s hooks)))
  (stopped! s))

;; http-server-shutdown! stops listening, drops idle connections, has the others close once their answers are done, and
;; runs the hooks; after ms milliseconds it drops what remains and runs the hooks forced. done is called once nothing
;; remains, as Go's Server.Shutdown returns.
(define (http-server-shutdown! [s (ptr http-server)] [ms f64] [done (fn ((ptr http-server)))])
  (unless (-> s stopping)
    (set! (-> s stopping) #t)
    (set! (-> s stopped) done)
    (unless (== (-> s listener) 0) (net-close (-> s listener)))
    (set! (-> s listener) 0)
    (set! (-> s stop-timer) (timer-after ms (cast (ptr void) s)))
    (let ([c (-> s connections)])
      (while (!= c 0)
        (let ([next (-> c next)])
          (set! (-> c closing) #t)
          (when (and (not (-> c busy)) (not (-> c lingering)) (== (-> c parser head line length) 0)
                     (== (-> c rest length) 0))
            (drop! c))
          (set! c next))))
    (run-hooks! s #f)
    (stopped? s)))

;; ---- signals ----

(struct signals [head event-head] [server (ptr http-server)] [ms f64] [done (fn ((ptr http-server)))] [count u32]
  [term u32])

(define stopper signals)

(define (exit-once-stopped [s (ptr http-server)]) (host-exit 0))

(define (signalled [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (+= (-> stopper count) 1)
  (if (> (-> stopper count) 1)
      (host-exit (if (== id (-> stopper term)) 143 130))
      (http-server-shutdown! (-> stopper server) (-> stopper ms)
                             (if (== (-> stopper done) 0) exit-once-stopped (-> stopper done)))))

;; http-stop-on-signals! shuts the server down at SIGTERM or SIGINT, with ms milliseconds to finish, then calls done,
;; or exits when done is 0; a second signal exits at once.
(define (http-stop-on-signals! [s (ptr http-server)] [ms f64] [done (fn ((ptr http-server)))])
  (set! (-> stopper head handle) signalled)
  (set! (-> stopper server) s)
  (set! (-> stopper ms) ms)
  (set! (-> stopper done) done)
  (set! (-> stopper term) (signal-listen "SIGTERM" (cast (ptr void) (& stopper)) 0))
  (signal-listen "SIGINT" (cast (ptr void) (& stopper)) 0))

;; ---- connections without streams ----

;; For tests: a connection to the server without a stream. The server need not be listening.
(define (http-connect! [s (ptr http-server)] [sink (fn ((ptr void) (slice u8)))] [sink-ended (fn ((ptr void)))]
                       [tag (ptr void)]) -> (ptr void)
  (trap-handler! http-trapped)
  (let ([c (new-connection! s 0)])
    (set! (-> c sink) sink)
    (set! (-> c sink-ended) sink-ended)
    (set! (-> c sink-tag) tag)
    (cast (ptr void) c)))

;; The bytes must stay unchanged until the connection ends.
(define (http-connection-feed! [c (ptr void)] [b (slice u8)]) (feed! (cast (ptr http-connection) c) b))

(define (http-connection-close! [c (ptr void)])
  (let ([k (cast (ptr http-connection) c)])
    (unless (-> k dropped)
      (set! (-> k sink-ended) 0)
      (drop! k))
    (free k)))
