;; An HTTP/1.1 server over net. A handler answers each request with bytes, a stream or nothing, and the server adds
;; the length; or the handler takes the connection's stream. Each connection's requests are answered one at a time.
;; Before serving, set secure for TLS, idle to the milliseconds a connection may wait for bytes or a whole head, and
;; most to the most connections at once; 0 means no limit. When listening fails, problem holds the reason.
(require-unqualified events "../../host/events.sub")
(require-unqualified stream "../../host/stream.sub")
(require-unqualified net "../../host/node/net.sub")
(require-unqualified timer "../../host/modules/timer.sub")
(require-unqualified clock "../../host/modules/clock.sub")
(require-unqualified http "http.sub")

(provide http-server http-request http-serve! http-server-close! http-request-header
         http-request-server http-respond! http-header! http-length! http-send! http-send-text! http-send-stream!
         http-finish! http-take!)

;; A request's on-body gets each piece of its body, and its on-end sees failed set when the body was malformed.
(struct http-request [connection (ptr void)] [method string] [target string] [head (ptr http-head)]
  [user (ptr void)] [ended bool] [failed bool] [answered bool] [status i32]
  [on-body (fn ((ptr http-request) (slice u8)))] [on-end (fn ((ptr http-request)))])

(typedef taker (fn ((ptr void) u32 (slice u8))))

(struct sending [pipe stream-pipe] [connection (ptr void)])

(struct http-connection [head event-head] [server (ptr void)] [stream u32] [parser http-parser]
  [request http-request] [buf (array u8 16384)] [out buffer] [sending (ptr sending)]
  [reading bool] [busy bool] [closing bool] [feeding bool] [full bool] [take taker] [taken (ptr void)] [timer u32]
  [rest (slice u8)] [next (ptr http-connection)])

(struct http-server [head event-head] [listener u32] [port u32] [secure bool] [idle f64] [most u32]
  [problem string] [user (ptr void)] [connections (ptr http-connection)]
  [handle (fn ((ptr http-request)))] [listening (fn ((ptr http-server)))])

;; ---- connections ----

(define (connection-of [r (ptr http-request)]) -> (ptr http-connection) (cast (ptr http-connection) (-> r connection)))

(define (server-of [c (ptr http-connection)]) -> (ptr http-server) (cast (ptr http-server) (-> c server)))

(define (arm! [c (ptr http-connection)])
  (when (> (-> (server-of c) idle) 0.0)
    (set! (-> c timer) (timer-after (-> (server-of c) idle) (cast (ptr void) c)))))

(define (read-more! [c (ptr http-connection)])
  (unless (-> c reading)
    (set! (-> c reading) #t)
    (when (== (-> c timer) 0) (arm! c))
    (stream-read! (-> c stream) (slice (-> c buf)))))

(define (disarm! [c (ptr http-connection)])
  (when (!= (-> c timer) 0)
    (timer-cancel (-> c timer))
    (set! (-> c timer) 0)))

(define (may-read! [c (ptr http-connection)])
  (when (or (not (-> c busy)) (not (-> c request ended))) (read-more! c)))

(define (unlink! [c (ptr http-connection)])
  (let ([s (server-of c)])
    (disarm! c)
    (if (== (-> s connections) c)
        (set! (-> s connections) (-> c next))
        (let ([before (-> s connections)])
          (while (and (!= before 0) (!= (-> before next) c)) (set! before (-> before next)))
          (when (!= before 0) (set! (-> before next) (-> c next)))))))

(define (drop! [c (ptr http-connection)])
  (unless (== (-> c sending) 0)
    (stream-close (-> c sending pipe from))
    (free (-> c sending)))
  (stream-close (-> c stream))
  (unlink! c)
  (buffer-free! (& (-> c out)))
  (buffer-free! (& (-> c parser head line)))
  (buffer-free! (& (-> c parser line)))
  (free c))

(define (settle! [c (ptr http-connection)])
  (when (and (-> c busy) (-> c request ended) (-> c request answered))
    (set! (-> c busy) #f)
    (cond [(-> c closing) (stream-finish (-> c stream))]
          [(not (or (-> c feeding) (-> c full))) (resume! c)])))

(define (resume! [c (ptr http-connection)])
  (http-parser-resume! (& (-> c parser)))
  (feed! c (-> c rest)))

(define (bad-request! [c (ptr http-connection)])
  (set! (-> c closing) #t)
  (cond [(not (-> c busy))
         (let ([b (& (-> c out))])
           (set! (-> b length) 0)
           (http-write-status! b 400)
           (http-write-date! b (clock-now))
           (buffer-add-string! b "content-length: 0\r\nconnection: close\r\n\r\n")
           (stream-write (-> c stream) (buffer-bytes b))
           (set! (-> b length) 0))
         (stream-finish (-> c stream))]
        [(not (-> c request ended))
         (let ([r (& (-> c request))])
           (set! (-> r failed) #t)
           (set! (-> r ended) #t)
           (set! (-> r on-body) 0)
           (when (!= (-> r on-end) 0) ((-> r on-end) r))
           (settle! c))]
        [else (settle! c)]))

;; origin-form! turns a target in absolute form, scheme://host/path?query, into its path and query, and makes its host
;; the Host header's value. It returns #f when the host is empty or has user information.
(define (origin-form! [h (ptr http-head)]) -> bool
  (let* ([t (-> h target)] [n (-> t length)] [p (-> t bytes)] [i u32 0] [start u32 0] [host string])
    (while (and (< i n) (or (and (>= (@ t i) 97) (<= (@ t i) 122)) (and (>= (@ t i) 65) (<= (@ t i) 90)))) (+= i 1))
    (unless (and (> i 0) (< (+ i 2) n) (== (@ t i) 58) (== (@ t (+ i 1)) 47) (== (@ t (+ i 2)) 47)) (return #t))
    (set! start (+ i 3))
    (set! i start)
    (while (and (< i n) (!= (@ t i) 47) (!= (@ t i) 63))
      (when (== (@ t i) 64) (return #f))
      (+= i 1))
    (when (== i start) (return #f))
    (if (and (< i n) (== (@ t i) 47))
        (set! host (slice t start i))
        (begin
          (memcpy (+ p (- start 1)) (+ p start) (- i start))
          (set! (@ p (- i 1)) 47)
          (set! host (slice t (- start 1) (- i 1)))
          (-= i 1)))
    (for ([k u32 0]) (< k (-> h count)) (+= k 1)
      (when (== (@ (-> h names) k) "host") (set! (@ (-> h values) k) host)))
    (set! (-> h target) (slice t i))
    #t))

(define (on-head [p (ptr http-parser)])
  (let* ([c (cast (ptr http-connection) (-> p user))] [r (& (-> c request))] [h (& (-> p head))]
         [old (== (-> h version) "HTTP/1.0")] [hosts (http-header-count h "host")])
    (if (or (!= (-> h status) 0) (> hosts 1) (and (== hosts 0) (not old)) (not (origin-form! h)))
        (http-parser-refuse! p)
        (begin
          (set! (-> c busy) #t)
          (set! (-> r method) (-> h method))
          (set! (-> r target) (-> h target))
          (set! (-> r head) h)
          (set! (-> r user) 0)
          (set! (-> r ended) #f)
          (set! (-> r failed) #f)
          (set! (-> r answered) #f)
          (set! (-> r on-body) 0)
          (set! (-> r on-end) 0)
          (when (or old (http-header-has? h "connection" "close")) (set! (-> c closing) #t))
          (when (and (not old) (http-header-has? h "expect" "100-continue"))
            (stream-write-text (-> c stream) "HTTP/1.1 100 Continue\r\n\r\n"))
          ((-> (server-of c) handle) r)))))

(define (on-body [p (ptr http-parser)] [b (slice u8)])
  (let* ([c (cast (ptr http-connection) (-> p user))] [r (& (-> c request))])
    (when (!= (-> r on-body) 0) ((-> r on-body) r b))))

(define (on-end [p (ptr http-parser)])
  (let* ([c (cast (ptr http-connection) (-> p user))] [r (& (-> c request))])
    (set! (-> r ended) #t)
    (when (!= (-> r on-end) 0) ((-> r on-end) r))
    (when (or (not (-> r answered)) (-> c closing) (-> c full)) (http-parser-stop! p))
    (settle! c)))

;; hand-over! gives the connection's stream to its taker, with the bytes read beyond the request.
(define (hand-over! [c (ptr http-connection)] [b (slice u8)])
  (let ([take (-> c take)] [held (& (-> c parser head line))])
    (set! (-> c take) 0)
    (unless (-> c request ended) (set! (-> held length) 0))
    (buffer-add! held b)
    (unlink! c)
    (stream-tag! (-> c stream) 0)
    (take (-> c taken) (-> c stream) (buffer-bytes held))
    (buffer-free! (& (-> c out)))
    (buffer-free! held)
    (buffer-free! (& (-> c parser line)))
    (free c)))

(define (feed! [c (ptr http-connection)] [b (slice u8)])
  (set! (-> c rest) 0)
  (set! (-> c feeding) #t)
  (let ([used (http-feed! (& (-> c parser)) b)])
    (set! (-> c feeding) #f)
    (unless (and (not (-> c busy)) (> (-> c parser head line length) 0))
      (disarm! c)
      (when (-> c reading) (arm! c)))
    (cond [(< used 0) (bad-request! c)]
          [(!= (-> c take) 0) (hand-over! c (slice b (cast u32 used)))]
          [(< (cast u32 used) (-> b length)) (set! (-> c rest) (slice b (cast u32 used)))]
          [else (may-read! c)])))

(define (connection-heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([c (cast (ptr http-connection) tag)])
    (when (and (== source stream-source) (== kind stream-read)) (set! (-> c reading) #f))
    (cond [(== source timer-source) (when (== id (-> c timer)) (drop! c))]
          [(and (== kind stream-read) (> value 0)) (feed! c (slice (-> c buf) (cast u32 value)))]
          [(and (!= (-> c take) 0) (not (-> c reading))) (hand-over! c 0)]
          [(and (== kind stream-read) (-> c busy)) (drop! c)]
          [(== kind stream-read)
           (set! (-> c closing) #t)
           (stream-finish (-> c stream))]
          [(== kind stream-drained)
           (let ([waited (-> c full)])
             (set! (-> c full) #f)
             (cond [(!= (-> c sending) 0) (stream-pipe-drained! (& (-> c sending pipe)))]
                   [(and waited (not (or (-> c busy) (-> c closing)))) (resume! c)]))]
          [(== kind stream-finished) (drop! c)]
          [(== kind stream-failed) (drop! c)])))

(define (accept! [s (ptr http-server)] [stream u32])
  (let ([c (cast (ptr http-connection) (calloc 1 (sizeof http-connection)))])
    (set! (-> c head handle) connection-heard)
    (set! (-> c server) (cast (ptr void) s))
    (set! (-> c stream) stream)
    (http-parser-init! (& (-> c parser)) (cast (ptr void) c) on-head on-body on-end)
    (set! (-> c out) (make-buffer))
    (set! (-> c request connection) (cast (ptr void) c))
    (set! (-> c next) (-> s connections))
    (set! (-> s connections) c)
    (stream-tag! stream (cast (ptr void) c))
    (read-more! c)))

;; ---- answering ----

(define (http-request-header [r (ptr http-request)] [name string]) -> string (http-header (-> r head) name))

(define (http-request-server [r (ptr http-request)]) -> (ptr http-server) (server-of (connection-of r)))

(define (http-respond! [r (ptr http-request)] [status i32])
  (let ([c (connection-of r)])
    (set! (-> r status) status)
    (set! (-> c out length) 0)
    (http-write-status! (& (-> c out)) status)
    (http-write-date! (& (-> c out)) (clock-now))
    (when (-> c closing) (http-write-header! (& (-> c out)) "connection" "close"))))

(define (http-header! [r (ptr http-request)] [name string] [value string])
  (http-write-header! (& (-> (connection-of r) out)) name value))

(define (http-length! [r (ptr http-request)] [n i64]) (http-write-number! (& (-> (connection-of r) out)) "content-length" n))

(define (has-length? [r (ptr http-request)]) -> bool (not (or (== (-> r status) 204) (== (-> r status) 304))))

(define (has-body? [r (ptr http-request)]) -> bool (and (has-length? r) (!= (-> r method) "HEAD")))

(define (send! [c (ptr http-connection)] [b (slice u8)])
  (http-write-end! (& (-> c out)))
  (buffer-add! (& (-> c out)) b)
  (when (== (stream-write (-> c stream) (buffer-bytes (& (-> c out)))) 1) (set! (-> c full) #t))
  (set! (-> c out length) 0))

(define (answered! [c (ptr http-connection)])
  (set! (-> c request answered) #t)
  (settle! c))

(define (http-finish! [r (ptr http-request)])
  (let ([c (connection-of r)])
    (when (has-body? r) (http-length! r 0))
    (send! c 0)
    (answered! c)))

(define (http-send! [r (ptr http-request)] [b (slice u8)])
  (let ([c (connection-of r)])
    (when (has-length? r) (http-length! r (cast i64 (-> b length))))
    (send! c (slice (-> b items) (if (has-body? r) (-> b length) 0)))
    (answered! c)))

(define (http-send-text! [r (ptr http-request)] [text string]) (http-send! r (cast (slice u8) text)))

(define (piped [p (ptr stream-pipe)])
  (let ([c (cast (ptr http-connection) (-> (cast (ptr sending) p) connection))] [failed (-> p failed)])
    (free (-> c sending))
    (set! (-> c sending) 0)
    (if (!= failed 0) (drop! c) (answered! c))))

;; http-send-stream! sends n bytes of the stream. With n of -1 it sends all of it and closes the connection to end the
;; body. A stream that ends before n bytes also closes the connection.
(define (http-send-stream! [r (ptr http-request)] [from u32] [n i64])
  (let ([c (connection-of r)])
    (cond [(>= n 0) (when (has-length? r) (http-length! r n))]
          [(not (-> c closing))
           (set! (-> c closing) #t)
           (http-write-header! (& (-> c out)) "connection" "close")])
    (send! c 0)
    (if (has-body? r)
        (let ([s (cast (ptr sending) (malloc (sizeof sending)))])
          (set! (-> s connection) (cast (ptr void) c))
          (set! (-> c sending) s)
          (stream-pipe-start! (& (-> s pipe)) from (-> c stream) n #f piped))
        (begin
          (stream-close from)
          (answered! c)))))

;; http-take! sends the head alone, and gives the connection's stream, untagged, to the taker once the handler has
;; returned. The connection counts toward most until the stream closes.
(define (http-take! [r (ptr http-request)] [take taker] [tag (ptr void)])
  (let ([c (connection-of r)])
    (send! c 0)
    (set! (-> c take) take)
    (set! (-> c taken) tag)
    (http-parser-stop! (& (-> c parser)))
    (unless (or (-> c feeding) (-> c reading)) (hand-over! c (-> c rest)))))

;; ---- the server ----

(define (server-heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([s (cast (ptr http-server) tag)])
    (cond [(== kind net-listening)
           (set! (-> s port) (cast u32 value))
           (when (!= (-> s listening) 0) ((-> s listening) s))]
          [(== kind net-accept) (accept! s (cast u32 value))]
          [(== kind net-failed)
           (set! (-> s port) 0)
           (set! (-> s problem) (events-take-text))
           (when (!= (-> s listening) 0) ((-> s listening) s))])))

(define (http-serve! [s (ptr http-server)] [port u32] [handle (fn ((ptr http-request)))]) -> u32
  (set! (-> s head handle) server-heard)
  (set! (-> s handle) handle)
  (set! (-> s connections) 0)
  (set! (-> s port) 0)
  (set! (-> s problem) "")
  (set! (-> s listener) (net-listen port "" (-> s secure) (-> s most) (cast (ptr void) s) (& (-> s problem))))
  (-> s listener))

(define (http-server-close! [s (ptr http-server)])
  (net-close (-> s listener))
  (while (!= (-> s connections) 0) (drop! (-> s connections))))
