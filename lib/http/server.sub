;; An HTTP server over net: a listener whose connections are parsed, each request handed to a handler, which
;; answers with a head and then bytes, a stream, or nothing, or takes the connection's stream for itself. The server
;; adds the length of an answer's bytes or stream, or 0 when it has nothing, except that an answer to HEAD with
;; nothing has only the length the handler gives. No body is sent for HEAD, and neither length nor body for 204 or
;; 304. A connection's requests are answered one at a time, in order: one that comes early waits for the answer
;; before it, and for that answer to drain when the stream is full. A request's on-body gets each piece of its body
;; and on-end its end, with failed set when the body was malformed, which also closes the connection after the
;; answer. A head that is not a request, or has two Hosts, or none in HTTP/1.1, is malformed. A target in absolute
;; form, http://host/path, is given as its path, its host taking the Host's place. A request that expects
;; 100-continue is sent 100 Continue before its handler is called. Answers are dated by the clock. Set before
;; serving: whether to use TLS, how many milliseconds a connection may wait for bytes or for a whole head, and how
;; many connections there may be, the last two unlimited when 0. When listening fails, at once or later, problem
;; holds the reason.
(require-unqualified events "../../host/events.sub")
(require-unqualified stream "../../host/stream.sub")
(require-unqualified net "../../host/node/net.sub")
(require-unqualified timer "../../host/modules/timer.sub")
(require-unqualified clock "../../host/modules/clock.sub")
(require-unqualified http "http.sub")

(provide http-server http-request http-serve! http-server-close! http-request-header
         http-request-server http-respond! http-header! http-length! http-send! http-send-text! http-send-stream!
         http-finish! http-take!)

(struct http-request [connection (ptr void)] [method (ptr u8)] [target (ptr u8)] [head (ptr http-head)]
  [user (ptr void)] [ended i32] [failed i32] [answered i32] [status i32]
  [on-body (fn ((ptr http-request) (ptr u8) u32))] [on-end (fn ((ptr http-request)))])

(typedef taker (fn ((ptr void) u32 (ptr u8) u32)))

(struct sending [pipe stream-pipe] [connection (ptr void)])

(struct http-connection [head event-head] [server (ptr void)] [stream u32] [parser http-parser]
  [request http-request] [buf (array u8 16384)] [out buffer] [sending (ptr sending)]
  [reading i32] [busy i32] [closing i32] [feeding i32] [full i32] [take taker] [taken (ptr void)] [timer u32]
  [rest (ptr u8)] [rest-length u32] [next (ptr http-connection)])

(struct http-server [head event-head] [listener u32] [port u32] [secure i32] [idle f64] [most u32]
  [problem (ptr u8)] [user (ptr void)] [connections (ptr http-connection)]
  [handle (fn ((ptr http-request)))] [listening (fn ((ptr http-server)))])

;; ---- connections ----

(define (connection-of [r (ptr http-request)]) -> (ptr http-connection) (cast (ptr http-connection) (-> r connection)))

(define (server-of [c (ptr http-connection)]) -> (ptr http-server) (cast (ptr http-server) (-> c server)))

(define (arm! [c (ptr http-connection)])
  (when (> (-> (server-of c) idle) 0.0)
    (set! (-> c timer) (timer-after (-> (server-of c) idle) (cast (ptr void) c)))))

(define (read-more! [c (ptr http-connection)])
  (unless (-> c reading)
    (set! (-> c reading) 1)
    (when (== (-> c timer) 0) (arm! c))
    (stream-read! (-> c stream) (-> c buf) 16384)))

(define (disarm! [c (ptr http-connection)])
  (when (!= (-> c timer) 0)
    (timer-cancel (-> c timer))
    (set! (-> c timer) 0)))

(define (may-read! [c (ptr http-connection)])
  (when (or (not (-> c busy)) (not (-> c request ended))) (read-more! c)))

(define (unlink! [c (ptr http-connection)])
  (let ([s (server-of c)])
    (disarm! c)
    (if (== (-> s connections) c)
        (set! (-> s connections) (-> c next))
        (let ([before (-> s connections)])
          (while (and (!= before 0) (!= (-> before next) c)) (set! before (-> before next)))
          (when (!= before 0) (set! (-> before next) (-> c next)))))))

(define (drop! [c (ptr http-connection)])
  (unless (== (-> c sending) 0)
    (stream-close (-> c sending pipe from))
    (free (-> c sending)))
  (stream-close (-> c stream))
  (unlink! c)
  (buffer-free! (& (-> c out)))
  (buffer-free! (& (-> c parser head line)))
  (buffer-free! (& (-> c parser line)))
  (free c))

(define (settle! [c (ptr http-connection)])
  (when (and (-> c busy) (-> c request ended) (-> c request answered))
    (set! (-> c busy) 0)
    (cond [(-> c closing) (stream-finish (-> c stream))]
          [(not (or (-> c feeding) (-> c full))) (resume! c)])))

(define (resume! [c (ptr http-connection)])
  (http-parser-resume! (& (-> c parser)))
  (feed! c (-> c rest) (-> c rest-length)))

(define (bad-request! [c (ptr http-connection)])
  (set! (-> c closing) 1)
  (cond [(not (-> c busy))
         (let ([b (& (-> c out))])
           (set! (-> b length) 0)
           (http-write-status! b 400)
           (http-write-date! b (clock-now))
           (buffer-add-string! b "content-length: 0\r\nconnection: close\r\n\r\n")
           (stream-write (-> c stream) (-> b bytes) (-> b length))
           (set! (-> b length) 0))
         (stream-finish (-> c stream))]
        [(not (-> c request ended))
         (let ([r (& (-> c request))])
           (set! (-> r failed) 1)
           (set! (-> r ended) 1)
           (set! (-> r on-body) 0)
           (when (!= (-> r on-end) 0) ((-> r on-end) r))
           (settle! c))]
        [else (settle! c)]))

;; A target in absolute form, scheme://host/path?query, made its path and query, its host becoming the Host's value:
;; 0 when the host is empty or has user information.
(define (origin-form! [h (ptr http-head)]) -> i32
  (let ([t (-> h target)] [i u32 0] [start u32 0])
    (while (or (and (>= (@ t i) 97) (<= (@ t i) 122)) (and (>= (@ t i) 65) (<= (@ t i) 90))) (+= i 1))
    (unless (and (> i 0) (== (@ t i) 58) (== (@ t (+ i 1)) 47) (== (@ t (+ i 2)) 47)) (return 1))
    (set! start (+ i 3))
    (set! i start)
    (while (and (!= (@ t i) 0) (!= (@ t i) 47) (!= (@ t i) 63))
      (when (== (@ t i) 64) (return 0))
      (+= i 1))
    (when (== i start) (return 0))
    (memcpy (+ t (- start 2)) (+ t start) (- i start))
    (set! (@ t (- i 2)) 0)
    (for ([k u32 0]) (< k (-> h count)) (+= k 1)
      (when (== (strcmp (@ (-> h names) k) "host") 0) (set! (@ (-> h values) k) (+ t (- start 2)))))
    (unless (== (@ t i) 47)
      (-= i 1)
      (set! (@ t i) 47))
    (set! (-> h target) (+ t i))
    1))

(define (on-head [p (ptr http-parser)])
  (let* ([c (cast (ptr http-connection) (-> p user))] [r (& (-> c request))] [h (& (-> p head))]
         [old (== (strcmp (-> h version) "HTTP/1.0") 0)] [hosts (http-header-count h "host")])
    (if (or (== (-> h method) 0) (> hosts 1) (and (== hosts 0) (not old)) (not (origin-form! h)))
        (http-parser-refuse! p)
        (let ([wish (http-header h "connection")] [expect (http-header h "expect")])
          (set! (-> c busy) 1)
          (set! (-> r method) (-> h method))
          (set! (-> r target) (-> h target))
          (set! (-> r head) h)
          (set! (-> r user) 0)
          (set! (-> r ended) 0)
          (set! (-> r failed) 0)
          (set! (-> r answered) 0)
          (set! (-> r on-body) 0)
          (set! (-> r on-end) 0)
          (when (or (and (!= wish 0) (http-has? wish "close")) old) (set! (-> c closing) 1))
          (when (and (!= expect 0) (not old) (http-has? expect "100-continue"))
            (stream-write-text (-> c stream) "HTTP/1.1 100 Continue\r\n\r\n"))
          ((-> (server-of c) handle) r)))))

(define (on-body [p (ptr http-parser)] [bytes (ptr u8)] [n u32])
  (let* ([c (cast (ptr http-connection) (-> p user))] [r (& (-> c request))])
    (when (!= (-> r on-body) 0) ((-> r on-body) r bytes n))))

(define (on-end [p (ptr http-parser)])
  (let* ([c (cast (ptr http-connection) (-> p user))] [r (& (-> c request))])
    (set! (-> r ended) 1)
    (when (!= (-> r on-end) 0) ((-> r on-end) r))
    (when (or (not (-> r answered)) (-> c closing) (-> c full)) (http-parser-stop! p))
    (settle! c)))

;; The stream goes to its taker with the bytes read beyond the request: those the parser holds of a next
;; message, when the request has ended, then these.
(define (hand-over! [c (ptr http-connection)] [bytes (ptr u8)] [n u32])
  (let ([take (-> c take)] [held (& (-> c parser head line))])
    (set! (-> c take) 0)
    (unless (-> c request ended) (set! (-> held length) 0))
    (buffer-add! held bytes n)
    (unlink! c)
    (stream-tag! (-> c stream) 0)
    (take (-> c taken) (-> c stream) (-> held bytes) (-> held length))
    (buffer-free! (& (-> c out)))
    (buffer-free! held)
    (buffer-free! (& (-> c parser line)))
    (free c)))

(define (feed! [c (ptr http-connection)] [p (ptr u8)] [n u32])
  (set! (-> c rest-length) 0)
  (set! (-> c feeding) 1)
  (let ([used (http-feed! (& (-> c parser)) p n)])
    (set! (-> c feeding) 0)
    (unless (and (not (-> c busy)) (> (-> c parser head line length) 0))
      (disarm! c)
      (when (-> c reading) (arm! c)))
    (cond [(< used 0) (bad-request! c)]
          [(!= (-> c take) 0) (hand-over! c (+ p used) (- n (cast u32 used)))]
          [(< (cast u32 used) n)
           (set! (-> c rest) (+ p used))
           (set! (-> c rest-length) (- n (cast u32 used)))]
          [else (may-read! c)])))

(define (connection-heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([c (cast (ptr http-connection) tag)])
    (when (and (== source stream-source) (== kind stream-read)) (set! (-> c reading) 0))
    (cond [(== source timer-source) (when (== id (-> c timer)) (drop! c))]
          [(and (== kind stream-read) (> value 0)) (feed! c (-> c buf) (cast u32 value))]
          [(and (!= (-> c take) 0) (not (-> c reading))) (hand-over! c 0 0)]
          [(and (== kind stream-read) (-> c busy)) (drop! c)]
          [(== kind stream-read)
           (set! (-> c closing) 1)
           (stream-finish (-> c stream))]
          [(== kind stream-drained)
           (let ([waited (-> c full)])
             (set! (-> c full) 0)
             (cond [(!= (-> c sending) 0) (stream-pipe-drained! (& (-> c sending pipe)))]
                   [(and waited (not (or (-> c busy) (-> c closing)))) (resume! c)]))]
          [(== kind stream-finished) (drop! c)]
          [(== kind stream-failed) (drop! c)])))

(define (accept! [s (ptr http-server)] [stream u32])
  (let ([c (cast (ptr http-connection) (calloc 1 (sizeof http-connection)))])
    (set! (-> c head handle) connection-heard)
    (set! (-> c server) (cast (ptr void) s))
    (set! (-> c stream) stream)
    (http-parser-init! (& (-> c parser)) (cast (ptr void) c) on-head on-body on-end)
    (set! (-> c out) (make-buffer))
    (set! (-> c request connection) (cast (ptr void) c))
    (set! (-> c next) (-> s connections))
    (set! (-> s connections) c)
    (stream-tag! stream (cast (ptr void) c))
    (read-more! c)))

;; ---- answering ----

(define (http-request-header [r (ptr http-request)] [name (ptr u8)]) -> (ptr u8) (http-header (-> r head) name))

(define (http-request-server [r (ptr http-request)]) -> (ptr http-server) (server-of (connection-of r)))

(define (http-respond! [r (ptr http-request)] [status i32])
  (let ([c (connection-of r)])
    (set! (-> r status) status)
    (set! (-> c out length) 0)
    (http-write-status! (& (-> c out)) status)
    (http-write-date! (& (-> c out)) (clock-now))
    (when (-> c closing) (http-write-header! (& (-> c out)) "connection" "close"))))

(define (http-header! [r (ptr http-request)] [name (ptr u8)] [value (ptr u8)])
  (http-write-header! (& (-> (connection-of r) out)) name value))

(define (http-length! [r (ptr http-request)] [n i64]) (http-write-number! (& (-> (connection-of r) out)) "content-length" n))

(define (has-length? [r (ptr http-request)]) -> i32 (not (or (== (-> r status) 204) (== (-> r status) 304))))

(define (has-body? [r (ptr http-request)]) -> i32 (and (has-length? r) (!= (strcmp (-> r method) "HEAD") 0)))

(define (send! [c (ptr http-connection)] [bytes (ptr u8)] [n u32])
  (http-write-end! (& (-> c out)))
  (buffer-add! (& (-> c out)) bytes n)
  (when (== (stream-write (-> c stream) (-> c out bytes) (-> c out length)) 1) (set! (-> c full) 1))
  (set! (-> c out length) 0))

(define (answered! [c (ptr http-connection)])
  (set! (-> c request answered) 1)
  (settle! c))

(define (http-finish! [r (ptr http-request)])
  (let ([c (connection-of r)])
    (when (has-body? r) (http-length! r 0))
    (send! c 0 0)
    (answered! c)))

(define (http-send! [r (ptr http-request)] [bytes (ptr u8)] [n u32])
  (let ([c (connection-of r)])
    (when (has-length? r) (http-length! r (cast i64 n)))
    (send! c bytes (if (has-body? r) n 0))
    (answered! c)))

(define (http-send-text! [r (ptr http-request)] [text (ptr u8)]) (http-send! r text (strlen text)))

(define (piped [p (ptr stream-pipe)])
  (let ([c (cast (ptr http-connection) (-> (cast (ptr sending) p) connection))] [failed (-> p failed)])
    (free (-> c sending))
    (set! (-> c sending) 0)
    (if (!= failed 0) (drop! c) (answered! c))))

;; n bytes of the stream, or when n is -1 all of them, ended by closing the connection; a stream that ends before n
;; bytes closes it too.
(define (http-send-stream! [r (ptr http-request)] [from u32] [n i64])
  (let ([c (connection-of r)])
    (cond [(>= n 0) (when (has-length? r) (http-length! r n))]
          [(not (-> c closing))
           (set! (-> c closing) 1)
           (http-write-header! (& (-> c out)) "connection" "close")])
    (send! c 0 0)
    (if (has-body? r)
        (let ([s (cast (ptr sending) (malloc (sizeof sending)))])
          (set! (-> s connection) (cast (ptr void) c))
          (set! (-> c sending) s)
          (stream-pipe-start! (& (-> s pipe)) from (-> c stream) n 0 piped))
        (begin
          (stream-close from)
          (answered! c)))))

;; The head alone is sent, and the connection's stream is the taker's, untagged, with the bytes read beyond the
;; request: once the handler returns, or at once when called later. It counts among the server's connections until
;; the stream closes.
(define (http-take! [r (ptr http-request)] [take taker] [tag (ptr void)])
  (let ([c (connection-of r)])
    (send! c 0 0)
    (set! (-> c take) take)
    (set! (-> c taken) tag)
    (http-parser-stop! (& (-> c parser)))
    (unless (or (-> c feeding) (-> c reading)) (hand-over! c (-> c rest) (-> c rest-length)))))

;; ---- the server ----

(define (server-heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([s (cast (ptr http-server) tag)])
    (cond [(== kind net-listening)
           (set! (-> s port) (cast u32 value))
           (when (!= (-> s listening) 0) ((-> s listening) s))]
          [(== kind net-accept) (accept! s (cast u32 value))]
          [(== kind net-failed)
           (set! (-> s port) 0)
           (set! (-> s problem) (events-take-text))
           (when (!= (-> s listening) 0) ((-> s listening) s))])))

(define (http-serve! [s (ptr http-server)] [port u32] [handle (fn ((ptr http-request)))]) -> u32
  (set! (-> s head handle) server-heard)
  (set! (-> s handle) handle)
  (set! (-> s connections) 0)
  (set! (-> s port) 0)
  (set! (-> s problem) 0)
  (set! (-> s listener) (net-listen port "" (-> s secure) (-> s most) (cast (ptr void) s) (& (-> s problem))))
  (-> s listener))

(define (http-server-close! [s (ptr http-server)])
  (net-close (-> s listener))
  (while (!= (-> s connections) 0) (drop! (-> s connections))))
