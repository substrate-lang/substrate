;; sub serve [-t CERT KEY] DIR [PORT]: DIR's files on 127.0.0.1, with index.html for a directory, over TLS with
;; a certificate; a request whose Host is not an address or localhost is refused. The URL is printed once the
;; server listens.
(require-unqualified events "../../host/events.sub")
(require-unqualified http "http.sub")
(require-unqualified server "server.sub")
(require-unqualified static "static.sub")

(define server http-server)
(define root (ptr u8) 0)
(define scheme (ptr u8) "http://")

(define (say [fd i32] [s (ptr u8)]) (host-write fd s (cast i32 (strlen s))))

(define (local? [host (ptr u8)]) -> i32
  (let ([n u32 0] [address 1])
    (when (or (== host 0) (== (@ host 0) 91)) (return 1))
    (while (and (!= (@ host n) 0) (!= (@ host n) 58))
      (unless (or (== (@ host n) 46) (and (>= (@ host n) 48) (<= (@ host n) 57))) (set! address 0))
      (+= n 1))
    (or (and address (> n 0))
        (and (== n 9) (== (memcmp host "localhost" 9) 0))
        (and (> n 10) (== (memcmp (+ host (- n 10)) ".localhost" 10) 0)))))

(define (handle [r (ptr http-request)])
  (if (local? (http-request-header r "host"))
      (http-static! r root)
      (http-answer-text! r 403 "this host is not allowed")))

(define (listening [s (ptr http-server)])
  (if (== (-> s port) 0)
      (begin
        (say 2 "serve: ")
        (say 2 (-> s problem))
        (say 2 "\n")
        (host-exit 1))
      (let ([line (make-buffer)])
        (buffer-add-string! (& line) scheme)
        (buffer-add-string! (& line) "127.0.0.1:")
        (http-add-decimal! (& line) (cast i64 (-> s port)))
        (buffer-add-string! (& line) "/\n")
        (host-write 1 (-> line bytes) (cast i32 (-> line length)))
        (buffer-free! (& line)))))

(define (argument [i i32]) -> (ptr u8) (host-arg-text i))

(define (main)
  (let* ([tls (and (== (strcmp (argument 0) "-t") 0) (!= (argument 2) 0))] [at (if tls 3 0)]
         [dir (argument at)] [port (argument (+ at 1))] [number i64 8000])
    (when (!= port 0) (set! number (http-decimal port)))
    (when (or (== dir 0) (< number 0) (> number 65535) (!= (argument (+ at 2)) 0))
      (say 2 "usage: sub serve [-t CERT KEY] DIR [PORT]\n")
      (host-exit 64))
    (set! root dir)
    (set! (-> server idle) 60000.0)
    (set! (-> server most) 1024)
    (when tls
      (set! scheme "https://")
      (set! (-> server secure) 1))
    (set! (-> server listening) listening)
    (when (== (http-serve! (& server) (cast u32 number) handle) 0)
      (say 2 "serve: ")
      (say 2 (-> server problem))
      (say 2 "\n")
      (host-exit 1))))
