;; API tokens: random, shown to their owner once and kept as their SHA-256, so that a stolen table of them gives no
;; token, and presented in an Authorization: Bearer header (RFC 6750).
(require-unqualified random "../../host/modules/random.sub")
(require-unqualified sha256 "../crypto/sha256.sub")
(require-unqualified base64 "../encoding/base64.sub")
(require-unqualified http "http.sub")
(require-unqualified server "server.sub")

(provide http-token-new! http-token-hash! http-request-bearer)

;; http-token-new! adds a new token to b: the prefix, then 32 random bytes in base64url.
(define (http-token-new! [b (ptr buffer)] [prefix string])
  (let ([bytes (array u8 32)])
    (random-fill (slice bytes))
    (buffer-add-string! b prefix)
    (base64url-encode! b (slice bytes))
    (memset bytes 0 32)))

;; http-token-hash! gives the token's SHA-256, the 32 bytes to keep.
(define (http-token-hash! [token string] [into (slice u8)]) (sha256-of (cast (slice u8) token) into))

;; http-request-bearer gives the token of the request's Authorization header, or "".
(define (http-request-bearer [r (ptr http-request)]) -> string
  (let ([a (http-trimmed (http-request-header r "authorization"))])
    (if (and (> (-> a length) 7) (http-same? (slice a 0 7) "bearer ")) (http-trimmed (slice a 7)) "")))
