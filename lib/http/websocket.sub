;; WebSockets (RFC 6455) on the server: a request upgraded, then messages framed over its stream. The peer's
;; messages and the end are calls; ws-close! starts the closing handshake, which the peer's close completes. A peer
;; silent for the server's idle limit is pinged, and ended after a second.
(require-unqualified events "../../host/events.sub")
(require-unqualified stream "../../host/stream.sub")
(require-unqualified timer "../../host/modules/timer.sub")
(require-unqualified http "http.sub")
(require-unqualified server "server.sub")
(require-unqualified sha1 "../crypto/sha1.sub")
(require-unqualified base64 "../encoding/base64.sub")

(provide ws-connection ws-text ws-binary ws-upgrade? ws-accept! ws-send! ws-send-text! ws-close!)

(const ws-text i32 1)
(const ws-binary i32 2)

;; A message beyond this many bytes closes the connection with 1009.
(const largest u32 16777216)

(const state-open i32 0)
(const state-closing i32 1)
(const state-finishing i32 2)
(const state-closed i32 3)

(struct ws-connection [head event-head] [stream u32] [user (ptr void)] [server (ptr http-server)]
  [in (array u8 16384)] [frames buffer] [message buffer] [out buffer]
  [kind i32] [state i32] [code i32] [reading i32] [timer u32] [pinged i32]
  [on-message (fn ((ptr ws-connection) (ptr u8) u32 i32))]
  [on-closed (fn ((ptr ws-connection) i32))]
  [on-drained (fn ((ptr ws-connection)))])

(define guid (ptr u8) "258EAFA5-E914-47DA-95CA-C5AB0DC85B11")

(define (lower [c u8]) -> i32 (if (and (>= c 65) (<= c 90)) (+ c 32) c))

(define (has-word? [s (ptr u8)] [word (ptr u8)]) -> i32
  (let ([n (strlen word)] [i u32 0])
    (while (>= (strlen (+ s i)) n)
      (let ([j u32 0])
        (while (and (< j n) (== (lower (@ s (+ i j))) (@ word j))) (+= j 1))
        (when (== j n) (return 1)))
      (+= i 1))
    0))

(define (ws-upgrade? [r (ptr http-request)]) -> i32
  (let ([upgrade (http-request-header r "upgrade")])
    (and (!= upgrade 0) (has-word? upgrade "websocket") (!= (http-request-header r "sec-websocket-key") 0))))

;; ---- frames out ----

(define (write-frame! [w (ptr ws-connection)] [opcode i32] [p (ptr u8)] [n u32]) -> i32
  (let ([out (& (-> w out))])
    (set! (-> out length) 0)
    (buffer-add-byte! out (bit-or 128 opcode))
    (cond [(< n 126) (buffer-add-byte! out (cast i32 n))]
          [(< n 65536)
           (buffer-add-byte! out 126)
           (buffer-add-byte! out (cast i32 (>> n 8)))
           (buffer-add-byte! out (cast i32 (bit-and n 255)))]
          [else
           (buffer-add-byte! out 127)
           (for ([i u32 0]) (< i 8) (+= i 1)
             (buffer-add-byte! out (cast i32 (bit-and (>> (cast u64 n) (* 8 (- 7 i))) 255))))])
    (buffer-add! out p n)
    (stream-write (-> w stream) (-> out bytes) (-> out length))))

(define (write-close! [w (ptr ws-connection)] [code i32])
  (let ([pair (array u8 2)])
    (set! (@ pair 0) (cast u8 (>> code 8)))
    (set! (@ pair 1) (cast u8 code))
    (write-frame! w 8 pair (if (== code 1005) 0 2))))

(define (disarm! [w (ptr ws-connection)])
  (when (!= (-> w timer) 0)
    (timer-cancel (-> w timer))
    (set! (-> w timer) 0)))

(define (ended! [w (ptr ws-connection)] [code i32])
  (unless (== (-> w state) state-closed)
    (set! (-> w state) state-closed)
    (disarm! w)
    (stream-close (-> w stream))
    (buffer-free! (& (-> w frames)))
    (buffer-free! (& (-> w message)))
    (buffer-free! (& (-> w out)))
    (when (!= (-> w on-closed) 0) ((-> w on-closed) w code))))

(define (finish! [w (ptr ws-connection)] [code i32])
  (set! (-> w state) state-finishing)
  (set! (-> w code) code)
  (stream-finish (-> w stream)))

;; The peer broke the protocol: a close is sent and the stream finished without waiting for its answer.
(define (fail! [w (ptr ws-connection)] [code i32])
  (when (< (-> w state) state-finishing)
    (when (== (-> w state) state-open) (write-close! w code))
    (finish! w code)))

;; ---- frames in ----

(define (deliver! [w (ptr ws-connection)] [p (ptr u8)] [n u32] [kind i32])
  (when (and (== (-> w state) state-open) (!= (-> w on-message) 0)) ((-> w on-message) w p n kind)))

(define (frame! [w (ptr ws-connection)] [fin i32] [opcode i32] [p (ptr u8)] [n u32])
  (cond [(== opcode 8)
         (let ([code (if (>= n 2) (bit-or (<< (cast i32 (@ p 0)) 8) (cast i32 (@ p 1))) 1005)])
           (when (== (-> w state) state-open) (write-close! w code))
           (finish! w (if (== (-> w state) state-closing) (-> w code) code)))]
        [(== opcode 9) (when (== (-> w state) state-open) (write-frame! w 10 p n))]
        [(== opcode 10) (begin)]
        [(or (== opcode 1) (== opcode 2))
         (cond [(!= (-> w kind) 0) (fail! w 1002)]
               [fin (deliver! w p n opcode)]
               [else
                (set! (-> w kind) opcode)
                (set! (-> w message length) 0)
                (buffer-add! (& (-> w message)) p n)])]
        [(== opcode 0)
         (cond [(== (-> w kind) 0) (fail! w 1002)]
               [(> (+ (-> w message length) n) largest) (fail! w 1009)]
               [else
                (buffer-add! (& (-> w message)) p n)
                (when fin
                  (let ([kind (-> w kind)])
                    (set! (-> w kind) 0)
                    (deliver! w (-> w message bytes) (-> w message length) kind)))])]
        [else (fail! w 1002)]))

;; The frame at p, when complete: unmasked and handled, its size is returned; 0 otherwise.
(define (next-frame! [w (ptr ws-connection)] [p (ptr u8)] [avail u32]) -> u32
  (when (or (< avail 2) (>= (-> w state) state-finishing)) (return 0))
  (let* ([first (@ p 0)] [opcode (bit-and first 15)] [fin (bit-and first 128)] [len (cast u64 (bit-and (@ p 1) 127))]
         [head u32 6])
    (cond [(== len 126)
           (when (< avail 4) (return 0))
           (set! len (bit-or (<< (cast u64 (@ p 2)) 8) (cast u64 (@ p 3))))
           (set! head 8)]
          [(== len 127)
           (when (< avail 10) (return 0))
           (set! len 0)
           (for ([i u32 2]) (< i 10) (+= i 1) (set! len (bit-or (<< len 8) (cast u64 (@ p i)))))
           (set! head 14)])
    (cond [(or (!= (bit-and first 112) 0) (== (bit-and (@ p 1) 128) 0)
               (and (>= opcode 8) (or (== fin 0) (> len 125))))
           (fail! w 1002)
           0]
          [(> len (cast u64 largest))
           (fail! w 1009)
           0]
          [(< (cast u64 avail) (+ (cast u64 head) len)) 0]
          [else
           (let ([n (cast u32 len)] [payload (+ p head)] [mask (+ p (- head 4))])
             (for ([i u32 0]) (< i n) (+= i 1)
               (set! (@ payload i) (bit-xor (@ payload i) (@ mask (bit-and i 3)))))
             (frame! w fin opcode payload n)
             (+ head n))])))

(define (unframe! [w (ptr ws-connection)])
  (let* ([b (& (-> w frames))] [at u32 0] [size (next-frame! w (-> b bytes) (-> b length))])
    (while (> size 0)
      (+= at size)
      (set! size (next-frame! w (+ (-> b bytes) at) (- (-> b length) at))))
    (when (> at 0)
      (memcpy (-> b bytes) (+ (-> b bytes) at) (- (-> b length) at))
      (-= (-> b length) at))))

(define (arm! [w (ptr ws-connection)])
  (when (> (-> w server idle) 0.0) (set! (-> w timer) (timer-after (-> w server idle) (cast (ptr void) w)))))

(define (read-more! [w (ptr ws-connection)])
  (when (and (< (-> w state) state-closed) (not (-> w reading)))
    (set! (-> w reading) 1)
    (when (== (-> w timer) 0) (arm! w))
    (when (< (stream-read! (-> w stream) (-> w in) 16384) 0) (ended! w 1006))))

(define (silent! [w (ptr ws-connection)])
  (set! (-> w timer) 0)
  (if (or (-> w pinged) (!= (-> w state) state-open))
      (ended! w 1006)
      (begin
        (set! (-> w pinged) 1)
        (write-frame! w 9 0 0)
        (arm! w))))

(define (ws-heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([w (cast (ptr ws-connection) tag)])
    (cond [(== source timer-source) (when (== id (-> w timer)) (silent! w))]
          [(and (== kind stream-read) (> value 0))
           (set! (-> w reading) 0)
           (set! (-> w pinged) 0)
           (disarm! w)
           (buffer-add! (& (-> w frames)) (-> w in) (cast u32 value))
           (unframe! w)
           (read-more! w)]
          [(== kind stream-read) (ended! w (if (== (-> w state) state-finishing) (-> w code) 1006))]
          [(== kind stream-finished) (ended! w (-> w code))]
          [(== kind stream-failed) (ended! w (if (== (-> w state) state-finishing) (-> w code) 1006))]
          [(== kind stream-drained) (when (!= (-> w on-drained) 0) ((-> w on-drained) w))])))

(define (taken [tag (ptr void)] [stream u32] [bytes (ptr u8)] [n u32])
  (let ([w (cast (ptr ws-connection) tag)])
    (set! (-> w stream) stream)
    (stream-tag! stream (cast (ptr void) w))
    (buffer-add! (& (-> w frames)) bytes n)
    (unframe! w)
    (read-more! w)))

;; ---- the connection ----

;; 1 when the request asks for an upgrade, which is then answered and the stream taken; the callbacks and user
;; are the caller's to set.
(define (ws-accept! [w (ptr ws-connection)] [r (ptr http-request)]) -> i32
  (unless (ws-upgrade? r) (return 0))
  (let ([key (http-request-header r "sec-websocket-key")] [s sha1] [digest (array u8 20)] [accept (make-buffer)])
    (sha1-init! (& s))
    (sha1-add! (& s) key (strlen key))
    (sha1-add! (& s) guid 36)
    (sha1-end! (& s) digest)
    (base64-encode! (& accept) digest 20)
    (buffer-add-byte! (& accept) 0)
    (set! (-> w head handle) ws-heard)
    (set! (-> w server) (http-request-server r))
    (set! (-> w timer) 0)
    (set! (-> w pinged) 0)
    (set! (-> w frames) (make-buffer))
    (set! (-> w message) (make-buffer))
    (set! (-> w out) (make-buffer))
    (set! (-> w kind) 0)
    (set! (-> w state) state-open)
    (set! (-> w code) 1005)
    (set! (-> w reading) 0)
    (http-respond! r 101)
    (http-header! r "upgrade" "websocket")
    (http-header! r "connection" "upgrade")
    (http-header! r "sec-websocket-accept" (-> accept bytes))
    (buffer-free! (& accept))
    (http-take! r taken (cast (ptr void) w))
    1))

;; As stream-write: 0, 1 when the stream is full until drained, -1 when the connection is not open.
(define (ws-send! [w (ptr ws-connection)] [p (ptr u8)] [n u32] [kind i32]) -> i32
  (if (== (-> w state) state-open) (write-frame! w kind p n) -1))

(define (ws-send-text! [w (ptr ws-connection)] [s (ptr u8)]) -> i32 (ws-send! w s (strlen s) ws-text))

(define (ws-close! [w (ptr ws-connection)] [code i32])
  (when (== (-> w state) state-open)
    (set! (-> w state) state-closing)
    (set! (-> w code) code)
    (write-close! w code)))
