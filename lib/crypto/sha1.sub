;; SHA-1 (RFC 3174), over bytes added in pieces or given at once.
(provide sha1 sha1-init! sha1-add! sha1-end! sha1-of)

(struct sha1 [h (array u32 5)] [block (array u8 64)] [filled u32] [length u64])

(define (rotl [x u32] [k u32]) #:inline -> u32 (bit-or (<< x k) (>> x (- 32 k))))

(define (word [p (ptr u8)]) -> u32
  (bit-or (<< (cast u32 (@ p 0)) 24) (<< (cast u32 (@ p 1)) 16) (<< (cast u32 (@ p 2)) 8) (cast u32 (@ p 3))))

(define (compress! [s (ptr sha1)] [p (ptr u8)])
  (let ([w (array u32 80)] [a (@ (-> s h) 0)] [b (@ (-> s h) 1)] [c (@ (-> s h) 2)] [d (@ (-> s h) 3)] [e (@ (-> s h) 4)])
    (for ([i u32 0]) (< i 16) (+= i 1) (set! (@ w i) (word (+ p (* i 4)))))
    (for ([i u32 16]) (< i 80) (+= i 1)
      (set! (@ w i) (rotl (bit-xor (@ w (- i 3)) (@ w (- i 8)) (@ w (- i 14)) (@ w (- i 16))) 1)))
    (for ([i u32 0]) (< i 80) (+= i 1)
      (let ([f u32 0] [k u32 0])
        (cond [(< i 20) (set! f (bit-or (bit-and b c) (bit-and (bit-not b) d))) (set! k 1518500249)]
              [(< i 40) (set! f (bit-xor b c d)) (set! k 1859775393)]
              [(< i 60) (set! f (bit-or (bit-and b c) (bit-and b d) (bit-and c d))) (set! k 2400959708)]
              [else (set! f (bit-xor b c d)) (set! k 3395469782)])
        (let ([t (+ (rotl a 5) f e k (@ w i))])
          (set! e d)
          (set! d c)
          (set! c (rotl b 30))
          (set! b a)
          (set! a t))))
    (+= (@ (-> s h) 0) a)
    (+= (@ (-> s h) 1) b)
    (+= (@ (-> s h) 2) c)
    (+= (@ (-> s h) 3) d)
    (+= (@ (-> s h) 4) e)))

(define (sha1-init! [s (ptr sha1)])
  (set! (@ (-> s h) 0) 1732584193)
  (set! (@ (-> s h) 1) 4023233417)
  (set! (@ (-> s h) 2) 2562383102)
  (set! (@ (-> s h) 3) 271733878)
  (set! (@ (-> s h) 4) 3285377520)
  (set! (-> s filled) 0)
  (set! (-> s length) 0))

(define (sha1-add! [s (ptr sha1)] [p (ptr u8)] [n u32])
  (let ([i u32 0])
    (+= (-> s length) (cast u64 n))
    (when (> (-> s filled) 0)
      (while (and (< i n) (< (-> s filled) 64))
        (set! (@ (-> s block) (-> s filled)) (@ p i))
        (+= (-> s filled) 1)
        (+= i 1))
      (when (== (-> s filled) 64)
        (compress! s (-> s block))
        (set! (-> s filled) 0)))
    (while (<= (+ i 64) n)
      (compress! s (+ p i))
      (+= i 64))
    (while (< i n)
      (set! (@ (-> s block) (-> s filled)) (@ p i))
      (+= (-> s filled) 1)
      (+= i 1))))

(define (sha1-end! [s (ptr sha1)] [out (ptr u8)])
  (let ([bits (* (-> s length) 8)])
    (set! (@ (-> s block) (-> s filled)) 128)
    (+= (-> s filled) 1)
    (when (> (-> s filled) 56)
      (while (< (-> s filled) 64)
        (set! (@ (-> s block) (-> s filled)) 0)
        (+= (-> s filled) 1))
      (compress! s (-> s block))
      (set! (-> s filled) 0))
    (while (< (-> s filled) 56)
      (set! (@ (-> s block) (-> s filled)) 0)
      (+= (-> s filled) 1))
    (for ([i u32 0]) (< i 8) (+= i 1)
      (set! (@ (-> s block) (+ 56 i)) (cast u8 (>> bits (* 8 (- 7 i))))))
    (compress! s (-> s block))
    (for ([i u32 0]) (< i 5) (+= i 1)
      (let ([h (@ (-> s h) i)])
        (set! (@ out (* i 4)) (cast u8 (>> h 24)))
        (set! (@ out (+ (* i 4) 1)) (cast u8 (>> h 16)))
        (set! (@ out (+ (* i 4) 2)) (cast u8 (>> h 8)))
        (set! (@ out (+ (* i 4) 3)) (cast u8 h))))))

(define (sha1-of [p (ptr u8)] [n u32] [out (ptr u8)])
  (let ([s sha1])
    (sha1-init! (& s))
    (sha1-add! (& s) p n)
    (sha1-end! (& s) out)))
