;; HTTP requests: the host module "fetch", answered as events.
(provide fetch-source fetch-head fetch-read fetch-failed fetch-start fetch-get fetch-read! fetch-abort)

(import start "fetch" "start" (i32 i32 i32 -> i32))
(import read "fetch" "read" (i32 i32 i32 -> i32))
(import abort "fetch" "abort" (i32 ->))

(const fetch-source u32 6)
(const fetch-head u32 1)
(const fetch-read u32 2)
(const fetch-failed u32 3)

(define (fetch-start [request (ptr u8)] [n u32] [tag (ptr void)]) -> u32
  (cast u32 (start (cast i32 request) (cast i32 n) (cast i32 tag))))

(define (fetch-get [url (ptr u8)] [tag (ptr void)]) -> u32
  (let ([b (make-buffer)] [id u32 0])
    (buffer-add-string! (& b) "GET ")
    (buffer-add-string! (& b) url)
    (buffer-add-string! (& b) "\n\n")
    (set! id (fetch-start (-> b bytes) (-> b length) tag))
    (buffer-free! (& b))
    id))

(define (fetch-read! [id u32] [p (ptr u8)] [cap u32]) -> i32 (read (cast i32 id) (cast i32 p) (cast i32 cap)))

(define (fetch-abort [id u32]) (abort (cast i32 id)))
