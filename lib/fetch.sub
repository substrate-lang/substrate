;; HTTP requests: the host module "fetch", answered as events. A request's id is its response body's stream.
;; Events: head 1 (value: the status, bytes: the header lines), failed 2 (value: the error code).
(provide fetch-source fetch-head fetch-failed fetch-start fetch-get)

(import start "fetch" "start" (i32 i32 i32 -> i32))

(const fetch-source u32 6)
(const fetch-head u32 1)
(const fetch-failed u32 2)

(define (fetch-start [request (ptr u8)] [n u32] [tag (ptr void)]) -> u32
  (cast u32 (start (cast i32 request) (cast i32 n) (cast i32 tag))))

(define (fetch-get [url (ptr u8)] [tag (ptr void)]) -> u32
  (let ([b (make-buffer)] [id u32 0])
    (buffer-add-string! (& b) "GET ")
    (buffer-add-string! (& b) url)
    (buffer-add-string! (& b) "\n\n")
    (set! id (fetch-start (-> b bytes) (-> b length) tag))
    (buffer-free! (& b))
    id))
