;; Events from the host: the current event's bytes, and the handlers of each source.
(provide events-take events-take! events-take-text event-handler event-handler! events-dispatch)

(import take "events" "take" (i32 i32 -> i32))

(typedef event-handler (fn (u32 u32 u32 i32 u32 (ptr void))))

(struct handler [source u32] [id u32] [f event-handler] [context (ptr void)])

(define handlers (array handler 64))
(define handler-count u32 0)

(define (handler-at [source u32] [id u32]) -> (ptr handler)
  (for ([i u32 0]) (< i handler-count) (+= i 1)
    (let ([h (+ handlers i)])
      (when (and (== (-> h source) source) (== (-> h id) id)) (return h))))
  0)

(define (event-handler! [source u32] [id u32] [f event-handler] [context (ptr void)])
  (let ([h (handler-at source id)])
    (when (and (== h 0) (< handler-count 64))
      (set! h (+ handlers handler-count))
      (+= handler-count 1)
      (set! (-> h source) source)
      (set! (-> h id) id))
    (unless (== h 0)
      (set! (-> h f) f)
      (set! (-> h context) context))))

(define (events-dispatch [source u32] [kind u32] [id u32] [value i32] [size u32])
  (let ([h (handler-at source id)])
    (when (== h 0) (set! h (handler-at source 0)))
    (when (and (!= h 0) (!= (-> h f) 0))
      ((-> h f) source kind id value size (-> h context)))))

(define (events-take [p (ptr u8)] [cap u32]) -> u32 (cast u32 (take (cast i32 p) (cast i32 cap))))

(define (events-take-text) -> (ptr u8)
  (let* ([n (events-take 0 0)] [p (cast (ptr u8) (malloc (+ n 1)))])
    (events-take p n)
    (set! (@ p n) 0)
    p))

(define (events-take! [b (ptr buffer)]) -> u32
  (let ([n (events-take 0 0)] [p (events-take-text)])
    (buffer-add! b p n)
    (free p)
    n))
