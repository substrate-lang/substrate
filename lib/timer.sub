;; Timers: the host module "timer", each firing once as an event.
(provide timer-source timer-fired timer-after timer-cancel)

(import after "timer" "after" (f64 -> i32))
(import cancel "timer" "cancel" (i32 ->))

(const timer-source u32 5)
(const timer-fired u32 1)

(define (timer-after [ms f64]) -> u32 (cast u32 (after ms)))

(define (timer-cancel [id u32]) (cancel (cast i32 id)))
