;; Types as data at compile time, for macros that write code from a type's fields.
(require-unqualified macros "../../compiler/macros.sub")

(provide type-info)

;; (kind name items parameters), kind struct, union or variant, or 0 when t names none. A struct's or union's items are
;; (field . type), a variant's (case (field . type) ...). A type is i8 to u64, f32, f64, bool or string, (ptr type),
;; (slice type), (array type n), a struct's, union's or variant's identifier, or (other type).
(define (type-info [t datum]) -> datum
  (syntax-match (binding-of t)
    [('substrate-struct name (item ...) kind (p ...))
     (let ([k (syntax-e kind)])
       `(,k ,name ,(for/list ([i item]) (if (== k 'variant) (case-info i) (field-info i))) ,p))]
    [('substrate-typedef u) (let ([d (parsed-type (syntax->datum u))]) (if (identifier? d) (type-info d) 0))]
    [_ 0]))

(define (binding-of [t datum]) -> datum
  (if (and (identifier? t) (== (identifier-binding-kind t) 'compile-time-value)) (syntax-local-value t) 0))

(define (case-info [c datum]) -> datum
  (let ([l (syntax->list c)]) (cons (car l) (for/list ([f (cdr l)]) (field-info f)))))

(define (field-info [f datum]) -> datum
  (let ([l (syntax->list f)]) (cons (car l) (type-of (cadr l)))))

(define scalars datum '(i8 u8 i16 u16 i32 u32 i64 u64 f32 f64 bool string))

(define (type-of [t datum]) -> datum
  (syntax-match t
    [(? identifier? x)
     (if (!= (memq (syntax-e x) scalars) 0)
         (syntax-e x)
         (syntax-match (binding-of x)
           [('substrate-struct _ _ _ ()) x]
           [('substrate-typedef u) (parsed-type (syntax->datum u))]
           [_ `(other ,t)]))]
    [('ptr u) `(ptr ,(type-of u))]
    [('slice u) `(slice ,(type-of u))]
    [('array u n) `(array ,(type-of u) ,(syntax-e n))]
    [('quote u) (parsed-type (syntax->datum u))]
    [_ `(other ,t)]))

;; A type as the checker holds it.
(define (parsed-type [d datum]) -> datum
  (cond [(and (symbol? d) (!= (memq d scalars) 0)) d]
        [(and (pair? d) (!= (memq (car d) '(ptr slice)) 0)) `(,(car d) ,(parsed-type (cadr d)))]
        [(and (pair? d) (== (car d) 'array)) `(array ,(parsed-type (cadr d)) ,(caddr d))]
        [(and (pair? d) (== (car d) 'struct) (null? (cdddr d))) (name-identifier (cadr d))]
        [else `(other ,d)]))
