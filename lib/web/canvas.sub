;; Drawing on a <canvas> element: rectangles, paths, circles and text.
(require-unqualified ui "ui.sub")

(provide fill-style stroke-style line-width global-alpha
         fill-rect stroke-rect clear-rect
         begin-path move-to line-to arc close-path fill-path stroke-path
         fill-circle draw-line
         set-font text-align text-baseline fill-text
         load-image draw-sprite
         translate rotate scale save-state restore-state)

(define (command! [op u32]) -> bool
  (if (ui-canvas-drawing?)
      (begin
        (words! (slice (array-of u32 op)))
        #t)
      #f))

(define (words! [w (slice u32)]) (buffer-add! (ui-patches) (slice (cast (ptr u8) (-> w items)) (* 4 (-> w length)))))

(define (numbers! [v (slice f32)]) (buffer-add! (ui-patches) (slice (cast (ptr u8) (-> v items)) (* 4 (-> v length)))))

(define (text! [s string])
  (let ([copy (cast (ptr u8) (ui-frame-alloc (+ (-> s length) 1)))])
    (memcpy copy (-> s bytes) (-> s length))
    (words! (slice (array-of u32 (cast u32 copy) (-> s length))))))

(define (plain! [op u32]) (command! op))
(define (one! [op u32] [a f64]) (when (command! op) (numbers! (slice (array-of f32 (cast f32 a))))))
(define (two! [op u32] [a f64] [b f64]) (when (command! op) (numbers! (slice (array-of f32 (cast f32 a) (cast f32 b))))))
(define (four! [op u32] [a f64] [b f64] [c f64] [d f64])
  (when (command! op) (numbers! (slice (array-of f32 (cast f32 a) (cast f32 b) (cast f32 c) (cast f32 d))))))
(define (named! [op u32] [s string]) (when (command! op) (text! s)))

(define (fill-style [color string]) (named! 2 color))
(define (stroke-style [color string]) (named! 3 color))
(define (line-width [w f64]) (one! 4 w))
(define (global-alpha [a f64]) (one! 23 a))

(define (fill-rect [x f64] [y f64] [w f64] [h f64]) (four! 5 x y w h))
(define (stroke-rect [x f64] [y f64] [w f64] [h f64]) (four! 6 x y w h))
(define (clear-rect [x f64] [y f64] [w f64] [h f64]) (four! 1 x y w h))

(define (begin-path) (plain! 7))
(define (move-to [x f64] [y f64]) (two! 8 x y))
(define (line-to [x f64] [y f64]) (two! 9 x y))
(define (arc [x f64] [y f64] [radius f64] [start f64] [end f64])
  (when (command! 10)
    (numbers! (slice (array-of f32 (cast f32 x) (cast f32 y) (cast f32 radius) (cast f32 start) (cast f32 end))))))
(define (close-path) (plain! 11))
(define (fill-path) (plain! 12))
(define (stroke-path) (plain! 13))

(define (fill-circle [x f64] [y f64] [radius f64])
  (begin-path)
  (arc x y radius 0.0 6.283185307179586)
  (fill-path))

(define (draw-line [x1 f64] [y1 f64] [x2 f64] [y2 f64])
  (begin-path)
  (move-to x1 y1)
  (line-to x2 y2)
  (stroke-path))

(define (set-font [font string]) (named! 14 font))
(define (text-align [align string]) (named! 16 align))
(define (text-baseline [baseline string]) (named! 17 baseline))
(define (fill-text [text string] [x f64] [y f64])
  (when (command! 15)
    (text! text)
    (numbers! (slice (array-of f32 (cast f32 x) (cast f32 y))))))

(define next-image u32 1)

(define (load-image [path string]) -> u32
  (if (ui-canvas-drawing?)
      0
      (let ([copy (cast (ptr u8) (ui-frame-alloc (+ (-> path length) 1)))] [id next-image])
        (memcpy copy (-> path bytes) (-> path length))
        (+= next-image 1)
        (ui-image id (cast string (slice copy (-> path length))))
        id)))

(define (draw-sprite [image u32] [cell-width f64] [cell-height f64] [frame u32] [x f64] [y f64] [flip bool])
  (when (command! 24)
    (words! (slice (array-of u32 image frame (if flip 1 0))))
    (numbers! (slice (array-of f32 (cast f32 cell-width) (cast f32 cell-height) (cast f32 x) (cast f32 y))))))

(define (translate [x f64] [y f64]) (two! 20 x y))
(define (rotate [angle f64]) (one! 21 angle))
(define (scale [x f64] [y f64]) (two! 22 x y))
(define (save-state) (plain! 18))
(define (restore-state) (plain! 19))
