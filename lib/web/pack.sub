;; sub pack -o OUT [-C DIR] PATH ... packs the files under the PATHs for a page's host, which subhost-web.mjs
;; unpacks. Each file's name and bytes follow their lengths as little-endian u32s, in name order.
(require-unqualified fs "../../host/fs.sub")

(define names (ptr string) 0)
(define count u32 0)
(define room u32 0)

(define (say [fd i32] [s string]) (host-write fd (cast (slice u8) s)))

(define (joined [dir string] [name string]) -> string
  (let ([b (make-buffer)])
    (unless (== dir ".")
      (buffer-add-string! (& b) dir)
      (buffer-add-byte! (& b) 47))
    (buffer-add-string! (& b) name)
    (buffer-string (& b))))

(define (remember! [name string])
  (when (== count room)
    (set! room (if (== room 0) 64 (* 2 room)))
    (set! names (cast (ptr string) (realloc names (* room (sizeof string))))))
  (let ([i count])
    (while (and (> i 0) (< name (@ names (- i 1))))
      (set! (@ names i) (@ names (- i 1)))
      (-= i 1))
    (set! (@ names i) name))
  (+= count 1))

(define (failed! [what string] [why string])
  (say 2 "pack: ")
  (say 2 what)
  (say 2 why)
  (say 2 "\n")
  (host-exit 1))

(define (add! [dir string] [name string])
  (let* ([full (joined dir name)] [why string] [info fs-info])
    (cond [(< (fs-stat full (& info) (& why)) 0) (failed! "cannot read " why)]
          [(== (-> info kind) fs-directory)
           (let ([listed (fs-list full (& why))])
             (when (== (-> listed items) 0) (failed! "cannot read " why))
             (for ([j u32 0]) (< j (-> listed length)) (+= j 1) (add! dir (joined name (@ listed j))))
             (free (-> listed items)))]
          [else (remember! name)])
    (free (-> full bytes))))

(define (add-u32! [b (ptr buffer)] [n u32])
  (buffer-add-byte! b (cast i32 (bit-and n 255)))
  (buffer-add-byte! b (cast i32 (bit-and (>> n 8) 255)))
  (buffer-add-byte! b (cast i32 (bit-and (>> n 16) 255)))
  (buffer-add-byte! b (cast i32 (>> n 24))))

(define (main)
  (let ([out string] [dir string "."] [i i32 0] [given #f] [pack (make-buffer)] [a (host-arg 0)])
    (while (!= (-> a bytes) 0)
      (let ([next (host-arg (+ i 1))])
        (cond [(and (== a "-o") (!= (-> next bytes) 0)) (set! out next) (+= i 2)]
              [(and (== a "-C") (!= (-> next bytes) 0)) (set! dir next) (+= i 2)]
              [else (set! given #t) (add! dir a) (+= i 1)])
        (set! a (host-arg i))))
    (when (or (== (-> out bytes) 0) (not given))
      (say 2 "usage: sub pack -o OUT [-C DIR] PATH ...\n")
      (host-exit 64))
    (for ([k u32 0]) (< k count) (+= k 1)
      (let* ([name (@ names k)] [full (joined dir name)] [why string] [bytes (fs-read-file full (& why))])
        (when (== (-> bytes items) 0) (failed! "cannot read " why))
        (add-u32! (& pack) (-> name length))
        (buffer-add-string! (& pack) name)
        (add-u32! (& pack) (-> bytes length))
        (buffer-add! (& pack) (-> bytes items) (-> bytes length))
        (free (-> bytes items))
        (free (-> full bytes))))
    (let ([why string])
      (when (< (fs-write-file out (buffer-bytes (& pack)) (& why)) 0) (failed! "cannot write " why)))))
