;; sub pack -o OUT [-C DIR] PATH ...: the files under the PATHs, in one pack for a page's host (subhost-web.mjs
;; unpacks it): each file's name and bytes, each after its length as a little-endian u32, in name order.
(require-unqualified fs "../../host/fs.sub")

(define names (ptr (ptr u8)) 0)
(define count u32 0)
(define room u32 0)

(define (say [fd i32] [s (ptr u8)]) (host-write fd s (cast i32 (strlen s))))

(define (argument [i i32]) -> (ptr u8)
  (let ([n (host-arg i 0 0)])
    (if (< n 0)
        0
        (let ([p (cast (ptr u8) (malloc (+ n 1)))])
          (host-arg i p n)
          (set! (@ p n) 0)
          p))))

(define (same? [a (ptr u8)] [b (ptr u8)]) -> i32
  (let ([i u32 0])
    (while (and (== (@ a i) (@ b i)) (!= (@ a i) 0)) (+= i 1))
    (== (@ a i) (@ b i))))

(define (before? [a (ptr u8)] [b (ptr u8)]) -> i32
  (let ([i u32 0])
    (while (and (== (@ a i) (@ b i)) (!= (@ a i) 0)) (+= i 1))
    (< (@ a i) (@ b i))))

(define (joined [dir (ptr u8)] [name (ptr u8)]) -> (ptr u8)
  (let ([b (make-buffer)])
    (unless (same? dir ".")
      (buffer-add-string! (& b) dir)
      (buffer-add-byte! (& b) 47))
    (buffer-add-string! (& b) name)
    (buffer-add-byte! (& b) 0)
    (-> b bytes)))

(define (remember! [name (ptr u8)])
  (when (== count room)
    (set! room (if (== room 0) 64 (* 2 room)))
    (set! names (cast (ptr (ptr u8)) (realloc names (* room (sizeof (ptr u8)))))))
  (let ([i count])
    (while (and (> i 0) (before? name (@ names (- i 1))))
      (set! (@ names i) (@ names (- i 1)))
      (-= i 1))
    (set! (@ names i) name))
  (+= count 1))

(define (add! [dir (ptr u8)] [name (ptr u8)])
  (let* ([full (joined dir name)] [size (fs-stat full)])
    (cond [(== size -1)
           (say 2 "pack: no file ")
           (say 2 full)
           (say 2 "\n")
           (host-exit 1)]
          [(== size -2)
           (let ([listed (fs-list full)] [start u32 0] [i u32 0])
             (while (!= (@ listed i) 0)
               (when (== (@ listed i) 10)
                 (set! (@ listed i) 0)
                 (add! dir (joined name (+ listed start)))
                 (set! start (+ i 1)))
               (+= i 1))
             (free listed))]
          [else (remember! name)])
    (free full)))

(define (add-u32! [b (ptr buffer)] [n u32])
  (buffer-add-byte! b (cast i32 (bit-and n 255)))
  (buffer-add-byte! b (cast i32 (bit-and (>> n 8) 255)))
  (buffer-add-byte! b (cast i32 (bit-and (>> n 16) 255)))
  (buffer-add-byte! b (cast i32 (>> n 24))))

(define (main)
  (let ([out (ptr u8) 0] [dir "."] [i i32 0] [given 0] [pack (make-buffer)])
    (while (!= (argument i) 0)
      (let ([a (argument i)])
        (cond [(and (same? a "-o") (!= (argument (+ i 1)) 0)) (set! out (argument (+ i 1))) (+= i 2)]
              [(and (same? a "-C") (!= (argument (+ i 1)) 0)) (set! dir (argument (+ i 1))) (+= i 2)]
              [else (set! given 1) (add! dir a) (+= i 1)])))
    (when (or (== out 0) (not given))
      (say 2 "usage: sub pack -o OUT [-C DIR] PATH ...\n")
      (host-exit 64))
    (for ([k u32 0]) (< k count) (+= k 1)
      (let* ([name (@ names k)] [full (joined dir name)] [size u32 0] [bytes (fs-read-file full (& size))])
        (when (== bytes 0)
          (say 2 "pack: cannot read ")
          (say 2 full)
          (say 2 "\n")
          (host-exit 1))
        (add-u32! (& pack) (strlen name))
        (buffer-add-string! (& pack) name)
        (add-u32! (& pack) size)
        (buffer-add! (& pack) bytes size)
        (free bytes)
        (free full)))
    (when (< (fs-write-file out (-> pack bytes) (-> pack length)) 0)
      (say 2 "pack: cannot write ")
      (say 2 out)
      (say 2 "\n")
      (host-exit 1))))
