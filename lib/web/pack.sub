;; sub pack -o OUT [-C DIR] PATH ... packs the files under the PATHs for a page's host, which subhost-web.mjs
;; unpacks. Each file's name and bytes follow their lengths as little-endian u32s, in name order.
(require-unqualified fs "../../host/fs.sub")

(define names (ptr (ptr u8)) 0)
(define count u32 0)
(define room u32 0)

(define (say [fd i32] [s (ptr u8)]) (host-write fd s (cast i32 (strlen s))))

(define (argument [i i32]) -> (ptr u8) (host-arg-text i))

(define (before? [a (ptr u8)] [b (ptr u8)]) -> i32
  (let ([i u32 0])
    (while (and (== (@ a i) (@ b i)) (!= (@ a i) 0)) (+= i 1))
    (< (@ a i) (@ b i))))

(define (joined [dir (ptr u8)] [name (ptr u8)]) -> (ptr u8)
  (let ([b (make-buffer)])
    (unless (== (strcmp dir ".") 0)
      (buffer-add-string! (& b) dir)
      (buffer-add-byte! (& b) 47))
    (buffer-add-string! (& b) name)
    (buffer-add-byte! (& b) 0)
    (-> b bytes)))

(define (remember! [name (ptr u8)])
  (when (== count room)
    (set! room (if (== room 0) 64 (* 2 room)))
    (set! names (cast (ptr (ptr u8)) (realloc names (* room (sizeof (ptr u8)))))))
  (let ([i count])
    (while (and (> i 0) (before? name (@ names (- i 1))))
      (set! (@ names i) (@ names (- i 1)))
      (-= i 1))
    (set! (@ names i) name))
  (+= count 1))

(define (failed! [what (ptr u8)] [why (ptr u8)])
  (say 2 "pack: ")
  (say 2 what)
  (say 2 why)
  (say 2 "\n")
  (host-exit 1))

(define (add! [dir (ptr u8)] [name (ptr u8)])
  (let* ([full (joined dir name)] [why (ptr u8) 0] [info fs-info])
    (cond [(< (fs-stat full (& info) (& why)) 0) (failed! "cannot read " why)]
          [(== (-> info kind) fs-directory)
           (let* ([n u32 0] [listed (fs-list full (& n) (& why))] [e listed])
             (when (== listed 0) (failed! "cannot read " why))
             (while (< e (+ listed n))
               (add! dir (joined name e))
               (set! e (entry-after e)))
             (free listed))]
          [else (remember! name)])
    (free full)))

(define (add-u32! [b (ptr buffer)] [n u32])
  (buffer-add-byte! b (cast i32 (bit-and n 255)))
  (buffer-add-byte! b (cast i32 (bit-and (>> n 8) 255)))
  (buffer-add-byte! b (cast i32 (bit-and (>> n 16) 255)))
  (buffer-add-byte! b (cast i32 (>> n 24))))

(define (main)
  (let ([out (ptr u8) 0] [dir "."] [i i32 0] [given 0] [pack (make-buffer)])
    (while (!= (argument i) 0)
      (let ([a (argument i)])
        (cond [(and (== (strcmp a "-o") 0) (!= (argument (+ i 1)) 0)) (set! out (argument (+ i 1))) (+= i 2)]
              [(and (== (strcmp a "-C") 0) (!= (argument (+ i 1)) 0)) (set! dir (argument (+ i 1))) (+= i 2)]
              [else (set! given 1) (add! dir a) (+= i 1)])))
    (when (or (== out 0) (not given))
      (say 2 "usage: sub pack -o OUT [-C DIR] PATH ...\n")
      (host-exit 64))
    (for ([k u32 0]) (< k count) (+= k 1)
      (let* ([name (@ names k)] [full (joined dir name)] [size u32 0] [why (ptr u8) 0]
             [bytes (fs-read-file full (& size) (& why))])
        (when (== bytes 0) (failed! "cannot read " why))
        (add-u32! (& pack) (strlen name))
        (buffer-add-string! (& pack) name)
        (add-u32! (& pack) size)
        (buffer-add! (& pack) bytes size)
        (free bytes)
        (free full)))
    (let ([why (ptr u8) 0])
      (when (< (fs-write-file out (-> pack bytes) (-> pack length) (& why)) 0) (failed! "cannot write " why)))))
