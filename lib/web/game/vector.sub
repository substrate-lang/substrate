;; A vector: a row of items of one type, numbered from 0, that grows as items are added.
(require-unqualified trap "trap.sub")

(provide vector vector-add! vector-push! vector-at vector-at-unchecked vector-count vector-remove-last!
         vector-clear! vector-free! vector-each)

(struct #:forall (T) vector [blocks (ptr (ptr T))] [count u32] [block-count u32] [room u32])

(define (block-of [i u32]) -> u32 (>> i 5))
(define (place-of [i u32]) -> u32 (bit-and i 31))

(define (no-such-item [function string] [i u32] [count u32])
  (trap-format "~s: there is no item ~d: the vector holds ~d" function i count))

(define #:forall (T) (vector-count [v (ptr (vector T))]) -> u32 (-> v count))

(define #:forall (T) (vector-at-unchecked [v (ptr (vector T))] [i u32]) -> (ptr T)
  (+ (@ (-> v blocks) (block-of i)) (place-of i)))

(define #:forall (T) (vector-at [v (ptr (vector T))] [i u32]) -> (ptr T)
  (when (>= i (-> v count)) (no-such-item "vector-at" i (-> v count)))
  (vector-at-unchecked v i))

(define #:forall (T) (vector-add! [v (ptr (vector T))]) -> (ptr T)
  (let ([i (-> v count)])
    (when (== (block-of i) (-> v block-count))
      (when (== (-> v block-count) (-> v room))
        (set! (-> v room) (if (== (-> v room) 0) 4 (* 2 (-> v room))))
        (set! (-> v blocks) (cast (ptr (ptr T)) (realloc (-> v blocks) (* (-> v room) (sizeof (ptr void)))))))
      (set! (@ (-> v blocks) (-> v block-count)) (cast (ptr T) (malloc (* 32 (sizeof T)))))
      (+= (-> v block-count) 1))
    (+= (-> v count) 1)
    (let ([item (vector-at-unchecked v i)])
      (memset item 0 (sizeof T))
      item)))

(define #:forall (T) (vector-push! [v (ptr (vector T))] [x T])
  (set! (@ (vector-add! v)) x))

(define #:forall (T) (vector-remove-last! [v (ptr (vector T))])
  (when (== (-> v count) 0) (trap "vector-remove-last!: the vector is empty"))
  (-= (-> v count) 1))

(define #:forall (T) (vector-clear! [v (ptr (vector T))])
  (set! (-> v count) 0))

(define #:forall (T) (vector-free! [v (ptr (vector T))])
  (for ([i u32 0]) (< i (-> v block-count)) (+= i 1) (free (@ (-> v blocks) i)))
  (free (-> v blocks))
  (set! (-> v blocks) 0)
  (set! (-> v count) 0)
  (set! (-> v block-count) 0)
  (set! (-> v room) 0))

(begin-for-syntax
  (require-unqualified macros "../../../compiler/macros.sub")

  (define (vector-each-form [s datum]) -> datum
    (syntax-match s
      [(_ (((? identifier? x) v)) body0 body ...)
       #`(let ([the-vector #,v])
           (for ([i u32 0]) (< i (vector-count the-vector)) (+= i 1)
             (let ([#,x (vector-at-unchecked the-vector i)]) #,body0 #,@body)))]
      [(_ (((? identifier? x) (? identifier? i) v)) body0 body ...)
       #`(let ([the-vector #,v])
           (for ([#,i u32 0]) (< #,i (vector-count the-vector)) (+= #,i 1)
             (let ([#,x (vector-at-unchecked the-vector #,i)]) #,body0 #,@body)))]
      [_ (raise-syntax-error
          'vector-each
          '"expected (vector-each ([item vector]) body ...) or (vector-each ([item index vector]) body ...)"
          s)])))

(define-syntax vector-each vector-each-form)
