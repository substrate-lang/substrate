;; Formatting text, for games: numbers and strings put into text by a pattern.

(provide format-into buffer-add-format! format-string print-format)

;; ---- where the text goes ----

(struct format-writer [bytes (ptr u8)] [room u32] [buffer (ptr buffer)] [own buffer] [length u32] [cut i32])

(define (format-start! [w (ptr format-writer)] [into (slice u8)])
  (set! (-> w bytes) (-> into items))
  (set! (-> w room) (-> into length))
  (set! (-> w buffer) 0)
  (set! (-> w length) 0)
  (set! (-> w cut) 0))

(define (format-start-buffer! [w (ptr format-writer)] [b (ptr buffer)])
  (set! (-> w buffer) b)
  (set! (-> w length) 0)
  (set! (-> w cut) 0))

(define (format-start-own! [w (ptr format-writer)])
  (set! (-> w own) (make-buffer))
  (format-start-buffer! w (& (-> w own))))

(define (format-add! [w (ptr format-writer)] [part string])
  (let ([n (-> part length)])
    (if (!= (-> w buffer) 0)
        (buffer-add-string! (-> w buffer) part)
        (let ([fits (- (-> w room) (-> w length))])
          (when (> n fits)
            (set! n fits)
            (set! (-> w cut) 1))
          (memcpy (+ (-> w bytes) (-> w length)) (-> part bytes) n)))
    (+= (-> w length) n)))

(define (format-fill! [w (ptr format-writer)] [byte u32] [count u32])
  (let ([one (array u8 1)])
    (set! (@ one 0) (cast u8 byte))
    (for ([i u32 0]) (< i count) (+= i 1) (format-add! w (cast string (slice one))))))

(define (format-finish! [w (ptr format-writer)]) -> u32
  (when (!= (-> w buffer) 0) (return (-> w length)))
  (when (and (-> w cut) (> (-> w length) 0))
    (let ([at (- (-> w length) 1)])
      (while (and (> at 0) (== (bit-and (@ (-> w bytes) at) 192) 128)) (-= at 1))
      (let* ([first (cast u32 (@ (-> w bytes) at))]
             [needs (cond [(< first 128) 1] [(>= first 240) 4] [(>= first 224) 3] [(>= first 192) 2] [else 1])])
        (when (< (- (-> w length) at) needs) (set! (-> w length) at)))))
  (-> w length))

(define (format-finish-text! [w (ptr format-writer)]) -> string
  (let ([n (format-finish! w)]) (cast string (slice (-> w bytes) n))))

(define (format-finish-string! [w (ptr format-writer)]) -> string (buffer-string (& (-> w own))))

(define (format-finish-print! [w (ptr format-writer)])
  (host-write 1 (buffer-bytes (& (-> w own))))
  (buffer-free! (& (-> w own))))

;; ---- the directives ----

(const flag-left u32 1)
(const flag-zeros u32 2)

(define (format-padded! [w (ptr format-writer)] [negative bool] [text string] [width u32] [flags u32])
  (let* ([length (+ (-> text length) (if negative 1 0))] [pad (if (> width length) (- width length) 0)])
    (cond [(bit-and flags flag-left)
           (when negative (format-fill! w #\- 1))
           (format-add! w text)
           (format-fill! w 32 pad)]
          [(bit-and flags flag-zeros)
           (when negative (format-fill! w #\- 1))
           (format-fill! w #\0 pad)
           (format-add! w text)]
          [else
           (format-fill! w 32 pad)
           (when negative (format-fill! w #\- 1))
           (format-add! w text)])))

(define (digits! [into (slice u8)] [n u64] [base u64]) -> string
  (let ([at (-> into length)])
    (while 1
      (-= at 1)
      (let ([digit (cast u32 (% n base))])
        (set! (@ into at) (cast u8 (if (< digit 10) (+ 48 digit) (+ 87 digit)))))
      (set! n (/ n base))
      (when (== n 0) (break)))
    (cast string (slice into at))))

(define (format-unsigned! [w (ptr format-writer)] [n u64] [base u32] [width u32] [flags u32])
  (let ([text (array u8 24)])
    (format-padded! w #f (digits! (slice text) n (cast u64 base)) width flags)))

(define (format-integer! [w (ptr format-writer)] [n i64] [width u32] [flags u32])
  (let ([text (array u8 24)] [negative (< n 0)])
    (format-padded! w negative (digits! (slice text) (if negative (cast u64 (- 0 n)) (cast u64 n)) 10) width flags)))

(define (format-text! [w (ptr format-writer)] [s string] [width u32] [flags u32])
  (format-padded! w #f s width (bit-and flags flag-left)))

(define (format-character! [w (ptr format-writer)] [c u32])
  (let ([text (array u8 4)] [n u32 0])
    (cond [(< c 128)
           (set! (@ text 0) (cast u8 c))
           (set! n 1)]
          [(< c 2048)
           (set! (@ text 0) (cast u8 (bit-or 192 (>> c 6))))
           (set! (@ text 1) (cast u8 (bit-or 128 (bit-and c 63))))
           (set! n 2)]
          [(< c 65536)
           (set! (@ text 0) (cast u8 (bit-or 224 (>> c 12))))
           (set! (@ text 1) (cast u8 (bit-or 128 (bit-and (>> c 6) 63))))
           (set! (@ text 2) (cast u8 (bit-or 128 (bit-and c 63))))
           (set! n 3)]
          [else
           (set! (@ text 0) (cast u8 (bit-or 240 (bit-and (>> c 18) 7))))
           (set! (@ text 1) (cast u8 (bit-or 128 (bit-and (>> c 12) 63))))
           (set! (@ text 2) (cast u8 (bit-or 128 (bit-and (>> c 6) 63))))
           (set! (@ text 3) (cast u8 (bit-or 128 (bit-and c 63))))
           (set! n 4)])
    (format-add! w (cast string (slice text n)))))

(define (float-digits! [text (ptr u8)] [x f64] [decimals i32] [zero (ptr i32)]) -> u32
  (let ([places (if (< decimals 0) 6 (if (> decimals 15) 15 decimals))] [power u32 0] [scale u64 1] [n u32 0]
        [digits (array u8 24)])
    (when (>= x 1000000000000000000.0)
      (while (>= x 10.0)
        (set! x (/ x 10.0))
        (+= power 1)))
    (for ([i 0]) (< i places) (+= i 1) (*= scale 10))
    (let* ([whole (floor x)] [units (cast u64 whole)]
           [part (cast u64 (+ (* (- x whole) (cast f64 scale)) 0.5))])
      (when (>= part scale)
        (+= units 1)
        (-= part scale))
      (when (and (> power 0) (>= units 10))
        (set! units 1)
        (+= power 1))
      (set! (@ zero) (and (== units 0) (== part 0)))
      (let ([d (digits! (slice digits) units 10)])
        (memcpy text (-> d bytes) (-> d length))
        (set! n (-> d length)))
      (when (> places 0)
        (set! (@ text n) #\.)
        (+= n 1)
        (let ([d (digits! (slice digits) part 10)])
          (for ([i (-> d length)]) (< i (cast u32 places)) (+= i 1)
            (set! (@ text n) #\0)
            (+= n 1))
          (memcpy (+ text n) (-> d bytes) (-> d length))
          (+= n (-> d length)))
        (when (< decimals 0)
          (while (== (@ text (- n 1)) #\0) (-= n 1))
          (when (== (@ text (- n 1)) #\.) (-= n 1)))))
    (when (> power 0)
      (set! (@ text n) #\e)
      (set! (@ text (+ n 1)) #\+)
      (+= n 2)
      (let ([d (digits! (slice digits) (cast u64 power) 10)])
        (memcpy (+ text n) (-> d bytes) (-> d length))
        (+= n (-> d length))))
    n))

(define (format-float! [w (ptr format-writer)] [x f64] [decimals i32] [width u32] [flags u32])
  (let ([text (array u8 64)] [negative (< x 0.0)] [zero 0])
    (cond [(!= x x) (format-padded! w #f "nan" width (bit-and flags flag-left))]
          [else
           (when negative (set! x (- 0.0 x)))
           (if (and (!= x 0.0) (== x (* x 2.0)))
               (format-padded! w negative "inf" width (bit-and flags flag-left))
               (let ([n (float-digits! text x decimals (& zero))])
                 (format-padded! w (and negative (not zero)) (cast string (slice text n)) width flags)))])))

;; ---- the forms ----
(begin-for-syntax
  (require-unqualified macros "../../../compiler/macros.sub")

  (define (fail [where datum] [message datum]) -> datum (raise-syntax-error 'format (datum->string message) where))

  (define (literal [d datum]) -> datum (datum->syntax #'here d 0))
  (define (number [n i64]) -> datum (literal (make-integer n)))

  (define (byte-at [s string] [i u32]) -> u32 (if (< i (-> s length)) (cast u32 (@ s i)) 0))

  (define (digit? [c u32]) -> bool (and (>= c #\0) (<= c #\9)))

  (define (statements [pattern datum] [arguments datum]) -> datum
    (unless (string? (syntax-e pattern))
      (fail pattern '"the pattern must be written as a string, so that it can be read when the program is compiled"))
    (let* ([text (datum->string (syntax-e pattern))] [n (-> text length)]
           [code nil] [left arguments] [start u32 0] [i u32 0])
      (while (< i n)
        (if (!= (@ text i) #\~)
            (+= i 1)
            (let ([flags u32 0] [width u32 0] [decimals i32 -1] [j (+ i 1)])
              (when (> i start)
                (set! code (cons #`(format-add! (& w) #,(literal (string->datum (slice text start i)))) code)))
              (when (== (byte-at text j) #\-)
                (set! flags (bit-or flags 1))
                (+= j 1))
              (when (== (byte-at text j) #\0)
                (set! flags (bit-or flags 2))
                (+= j 1))
              (while (digit? (byte-at text j))
                (set! width (+ (* width 10) (- (byte-at text j) #\0)))
                (+= j 1))
              (when (== (byte-at text j) #\.)
                (set! decimals 0)
                (+= j 1)
                (while (digit? (byte-at text j))
                  (set! decimals (+ (* decimals 10) (cast i32 (- (byte-at text j) #\0))))
                  (+= j 1)))
              (let ([letter (byte-at text j)])
                (when (== letter 0) (fail pattern '"the pattern ends in the middle of a directive"))
                (when (and (>= decimals 0) (!= letter #\f))
                  (fail pattern '"a number of decimals, such as the .2 of ~.2f, can only be given to ~f"))
                (if (== letter #\~)
                    (set! code (cons #'(format-add! (& w) "~") code))
                    (begin
                      (unless (or (== letter #\d) (== letter #\u) (== letter #\x) (== letter #\f) (== letter #\s) (== letter #\c))
                        (fail pattern
                              (format "~a~a is not a formatting directive. The directives are ~d, ~u, ~x, ~f, ~s, ~c and ~~"
                                      `("~" ,(string->datum (slice text j (+ j 1)))))))
                      (when (null? left) (fail pattern '"the pattern has more directives than there are arguments"))
                      (let ([a (car left)] [wide (number width)] [how (number flags)])
                        (set! left (cdr left))
                        (set! code
                              (cons (cond [(== letter #\d) #`(format-integer! (& w) #,a #,wide #,how)]
                                          [(== letter #\u) #`(format-unsigned! (& w) #,a 10 #,wide #,how)]
                                          [(== letter #\x) #`(format-unsigned! (& w) #,a 16 #,wide #,how)]
                                          [(== letter #\f) #`(format-float! (& w) #,a #,(number decimals) #,wide #,how)]
                                          [(== letter #\s) #`(format-text! (& w) #,a #,wide #,how)]
                                          [else #`(format-character! (& w) #,a)])
                                    code))))))
              (set! i (+ j 1))
              (set! start i))))
      (when (> n start)
        (set! code (cons #`(format-add! (& w) #,(literal (string->datum (slice text start n)))) code)))
      (unless (null? left) (fail (car left) '"there are more arguments than directives in the pattern"))
      (reverse code)))

  (define (format-into-form [s datum]) -> datum
    (syntax-match s
      [(_ into pattern argument ...)
       #`(let ([w format-writer])
           (format-start! (& w) #,into)
           #,@(statements pattern argument)
           (format-finish-text! (& w)))]
      [_ (fail s '"expected (format-into bytes pattern argument ...)")]))

  (define (buffer-add-format-form [s datum]) -> datum
    (syntax-match s
      [(_ buffer pattern argument ...)
       #`(let ([w format-writer])
           (format-start-buffer! (& w) #,buffer)
           #,@(statements pattern argument)
           (format-finish! (& w)))]
      [_ (fail s '"expected (buffer-add-format! buffer pattern argument ...)")]))

  (define (format-string-form [s datum]) -> datum
    (syntax-match s
      [(_ pattern argument ...)
       #`(let ([w format-writer])
           (format-start-own! (& w))
           #,@(statements pattern argument)
           (format-finish-string! (& w)))]
      [_ (fail s '"expected (format-string pattern argument ...)")]))

  (define (print-format-form [s datum]) -> datum
    (syntax-match s
      [(_ pattern argument ...)
       #`(let ([w format-writer])
           (format-start-own! (& w))
           #,@(statements pattern argument)
           (format-finish-print! (& w)))]
      [_ (fail s '"expected (print-format pattern argument ...)")])))

(define-syntax format-into format-into-form)
(define-syntax buffer-add-format! buffer-add-format-form)
(define-syntax format-string format-string-form)
(define-syntax print-format print-format-form)
