;; Space: a grid of cells over the world, for what is near, in the way, or hit by a line.
(require-unqualified trap "trap.sub")
(require-unqualified vector "vector.sub")
(require-unqualified store "store.sub")
(require-unqualified math "../scene/math.sub")

(provide space space-init! space-free! shape disc box walkway entry
         space-add! space-move! space-remove! space-entry space-count
         kinds-all kind-mask space-gather! space-nearest space-touching! space-ray)

(variant shape
  [disc [r f64] [height f64]]
  [box [half-x f64] [half-z f64] [yaw f64] [height f64]]
  [walkway [half-x f64] [half-z f64] [yaw f64] [deck f64] [rails bool]])

(struct entry [shape shape] [kind u32] [id u32] [x f64] [y f64] [z f64] [cell i32] [slot u32])

(struct space
  [cell f64] [columns i32] [rows i32]
  [cells (ptr (vector (handle entry)))]
  [entries (store entry)])

(define (space-init! [s (ptr space)] [width f64] [depth f64] [cell f64])
  (memset s 0 (sizeof space))
  (set! (-> s cell) cell)
  (set! (-> s columns) (+ (cast i32 (/ width cell)) 1))
  (set! (-> s rows) (+ (cast i32 (/ depth cell)) 1))
  (let ([n (* (-> s columns) (-> s rows))])
    (set! (-> s cells) (cast (ptr (vector (handle entry))) (malloc (* (cast u32 n) (sizeof (vector (handle entry)))))))
    (memset (-> s cells) 0 (* (cast u32 n) (sizeof (vector (handle entry)))))))

(define (space-free! [s (ptr space)])
  (let ([n (* (-> s columns) (-> s rows))])
    (for ([i i32 0]) (< i n) (+= i 1) (vector-free! (+ (-> s cells) i)))
    (free (-> s cells))
    (store-free! (& (-> s entries)))
    (memset s 0 (sizeof space))))

(define (space-count [s (ptr space)]) -> u32 (store-count (& (-> s entries))))

(define (column-of [s (ptr space)] [x f64]) -> i32
  (cast i32 (clamp (floor (/ x (-> s cell))) 0.0 (cast f64 (- (-> s columns) 1)))))

(define (row-of [s (ptr space)] [z f64]) -> i32
  (cast i32 (clamp (floor (/ z (-> s cell))) 0.0 (cast f64 (- (-> s rows) 1)))))

(define (cell-of [s (ptr space)] [x f64] [z f64]) -> i32
  (+ (* (row-of s z) (-> s columns)) (column-of s x)))

(define (file! [s (ptr space)] [e (ptr entry)] [h (handle entry)] [cell i32])
  (let ([v (+ (-> s cells) cell)])
    (set! (-> e cell) cell)
    (set! (-> e slot) (vector-count v))
    (vector-push! v h)))

(define (unfile! [s (ptr space)] [e (ptr entry)])
  (let* ([v (+ (-> s cells) (-> e cell))] [last (- (vector-count v) 1)])
    (when (!= (-> e slot) last)
      (let* ([moved (@ (vector-at v last))] [m (store-get (& (-> s entries)) moved)])
        (set! (@ (vector-at v (-> e slot))) moved)
        (set! (-> m slot) (-> e slot))))
    (vector-remove-last! v)))

(define (space-add! [s (ptr space)] [shape shape] [kind u32] [id u32] [x f64] [y f64] [z f64]) -> (handle entry)
  (when (>= kind 32) (trap "space: a kind is 0 to 31"))
  (let* ([e (store-add! (& (-> s entries)))] [h (store-handle (& (-> s entries)) e)])
    (set! (-> e shape) shape)
    (set! (-> e kind) kind)
    (set! (-> e id) id)
    (set! (-> e x) x)
    (set! (-> e y) y)
    (set! (-> e z) z)
    (file! s e h (cell-of s x z))
    h))

(define (space-move! [s (ptr space)] [h (handle entry)] [x f64] [y f64] [z f64])
  (let ([e (store-get (& (-> s entries)) h)] [cell (cell-of s x z)])
    (set! (-> e x) x)
    (set! (-> e y) y)
    (set! (-> e z) z)
    (when (!= cell (-> e cell))
      (unfile! s e)
      (file! s e h cell))))

(define (space-remove! [s (ptr space)] [h (handle entry)])
  (let ([e (store-find (& (-> s entries)) h)])
    (when (!= e 0)
      (unfile! s e)
      (store-remove! (& (-> s entries)) h))))

(define (space-entry [s (ptr space)] [h (handle entry)]) -> (ptr entry) (store-find (& (-> s entries)) h))

(define (kinds-all) -> u32 #xffffffff)
(define (kind-mask [k u32]) -> u32 (<< 1 k))

(begin-for-syntax
  (require-unqualified macros "../../../compiler/macros.sub")

  (define (cells-around-form [stx datum]) -> datum
    (syntax-match stx
      [(_ (s x z r e h) body0 body ...)
       #`(let* ([the-space #,s] [around-x #,x] [around-z #,z] [around-r #,r]
                [c0 (column-of the-space (- around-x around-r))] [c1 (column-of the-space (+ around-x around-r))]
                [r0 (row-of the-space (- around-z around-r))] [r1 (row-of the-space (+ around-z around-r))])
           (for ([row i32 r0]) (<= row r1) (+= row 1)
             (for ([column i32 c0]) (<= column c1) (+= column 1)
               (let ([v (+ (-> the-space cells) (+ (* row (-> the-space columns)) column))])
                 (vector-each ([slot v])
                   (let* ([#,h (@ slot)] [#,e (store-get (& (-> the-space entries)) #,h)])
                     #,body0 #,@body))))))]
      [_ (raise-syntax-error 'cells-around "expected (cells-around (space x z r entry handle) body ...)" stx)])))

(define-syntax cells-around cells-around-form)

(define (wanted? [e (ptr entry)] [kinds u32]) -> bool (!= (bit-and kinds (<< 1 (-> e kind))) 0))

(define (space-gather! [s (ptr space)] [x f64] [z f64] [r f64] [kinds u32] [results (ptr (vector (handle entry)))])
  (cells-around (s x z r e h)
    (when (wanted? e kinds)
      (let ([dx (- (-> e x) x)] [dz (- (-> e z) z)])
        (when (<= (+ (* dx dx) (* dz dz)) (* r r))
          (vector-push! results h))))))

(define (space-nearest [s (ptr space)] [x f64] [z f64] [r f64] [kinds u32]) -> (handle entry)
  (let ([best (handle entry)] [best-distance (* r r)])
    (memset (& best) 0 (sizeof (handle entry)))
    (cells-around (s x z r e h)
      (when (wanted? e kinds)
        (let* ([dx (- (-> e x) x)] [dz (- (-> e z) z)] [d (+ (* dx dx) (* dz dz))])
          (when (<= d best-distance)
            (set! best-distance d)
            (set! best h)))))
    best))

(define (touches? [e (ptr entry)] [x f64] [y f64] [z f64] [r f64] [height f64]) -> bool
  (let ([dx (- x (-> e x))] [dz (- z (-> e z))])
    (match (-> e shape)
      [(disc er eh)
       (and (< (+ (* dx dx) (* dz dz)) (* (+ r er) (+ r er)))
            (< y (+ (-> e y) eh)) (> (+ y height) (-> e y)))]
      [(box half-x half-z yaw eh)
       (let* ([c (cos yaw)] [s (sin yaw)]
              [lx (+ (* c dx) (* s dz))] [lz (- (* c dz) (* s dx))])
         (and (< (fabs lx) (+ half-x r)) (< (fabs lz) (+ half-z r))
              (< y (+ (-> e y) eh)) (> (+ y height) (-> e y))))]
      [(walkway half-x half-z yaw deck rails)
       (let* ([c (cos yaw)] [s (sin yaw)]
              [lx (+ (* c dx) (* s dz))] [lz (- (* c dz) (* s dx))])
         (and (< (fabs lx) (+ half-x r)) (< (fabs lz) (+ half-z r))))])))

(define (space-touching! [s (ptr space)] [x f64] [z f64] [y f64] [r f64] [height f64] [kinds u32]
                         [results (ptr (vector (handle entry)))])
  (let ([reach 16.0])
    (cells-around (s x z (+ r reach) e h)
      (when (and (wanted? e kinds) (touches? e x y z r height))
        (vector-push! results h)))))

(define (inside? [e (ptr entry)] [x f64] [y f64] [z f64]) -> bool
  (let ([dx (- x (-> e x))] [dz (- z (-> e z))])
    (match (-> e shape)
      [(disc r height)
       (and (< (+ (* dx dx) (* dz dz)) (* r r)) (>= y (-> e y)) (< y (+ (-> e y) height)))]
      [(box half-x half-z yaw height)
       (let* ([c (cos yaw)] [s (sin yaw)]
              [lx (+ (* c dx) (* s dz))] [lz (- (* c dz) (* s dx))])
         (and (< (fabs lx) half-x) (< (fabs lz) half-z) (>= y (-> e y)) (< y (+ (-> e y) height))))]
      [(walkway half-x half-z yaw deck rails)
       (let* ([c (cos yaw)] [s (sin yaw)]
              [lx (+ (* c dx) (* s dz))] [lz (- (* c dz) (* s dx))])
         (and (< (fabs lx) half-x) (< (fabs lz) half-z) (>= y (- (+ (-> e y) deck) 0.3)) (< y (+ (-> e y) deck))))])))

(define (space-ray [s (ptr space)] [x f64] [y f64] [z f64] [dx f64] [dy f64] [dz f64] [reach f64] [kinds u32]
                   [distance (ptr f64)]) -> (handle entry)
  (let ([none (handle entry)] [step 0.25] [t 0.0])
    (memset (& none) 0 (sizeof (handle entry)))
    (while (<= t reach)
      (let ([px (+ x (* dx t))] [py (+ y (* dy t))] [pz (+ z (* dz t))] [hit none])
        (cells-around (s px pz 16.0 e h)
          (when (and (wanted? e kinds) (inside? e px py pz))
            (set! hit h)))
        (when (!= (-> hit generation) 0)
          (set! (@ distance) t)
          (return hit)))
      (+= t step))
    (set! (@ distance) reach)
    none))
