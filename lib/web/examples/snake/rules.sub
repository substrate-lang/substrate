;; The game snake, without its page: the rules, the timing and the placing of food.

(provide snake cell snake-columns snake-rows
         snake-waiting snake-playing snake-paused snake-over snake-won
         snake-up snake-right snake-down snake-left
         snake-reset! snake-turn! snake-toggle-pause! snake-advance! snake-step!
         snake-segment snake-occupied?)

;; A snake is at most 400 cells long, the size of the body array.
(const snake-columns i32 20)
(const snake-rows i32 20)

(struct cell [x i32] [y i32])

(const snake-waiting u32 0)
(const snake-playing u32 1)
(const snake-paused u32 2)
(const snake-over u32 3)
(const snake-won u32 4)

;; Directions, in clockwise order.
(const snake-up u32 0)
(const snake-right u32 1)
(const snake-down u32 2)
(const snake-left u32 3)

(struct snake
  [body (array cell 400)] [head u32] [length u32]
  [direction u32]
  [turns (array u32 2)] [turn-count u32]
  [food cell]
  [score u32]
  [state u32]
  [random u32]
  [timed bool] [last-time f64] [pending f64])

(define (dx [direction u32]) -> i32
  (case direction
    [(1) 1]
    [(3) -1]
    [else 0]))

(define (dy [direction u32]) -> i32
  (case direction
    [(0) -1]
    [(2) 1]
    [else 0]))

(define (opposite [direction u32]) -> u32 (% (+ direction 2) 4))

(define (snake-segment [s (ptr snake)] [i u32]) -> (ptr cell)
  (+ (-> s body) (% (- (+ (-> s head) 400) i) 400)))

(define (covers? [s (ptr snake)] [x i32] [y i32] [n u32]) -> bool
  (for ([i u32 0]) (< i n) (+= i 1)
    (let ([c (snake-segment s i)])
      (when (and (== (-> c x) x) (== (-> c y) y)) (return #t))))
  #f)

(define (snake-occupied? [s (ptr snake)] [x i32] [y i32]) -> bool (covers? s x y (-> s length)))

(define (next-random! [s (ptr snake)]) -> u32
  (let ([x (-> s random)])
    (set! x (bit-xor x (<< x 13)))
    (set! x (bit-xor x (>> x 17)))
    (set! x (bit-xor x (<< x 5)))
    (set! (-> s random) x)
    x))

(define (place-food! [s (ptr snake)])
  (let ([k (% (next-random! s) (- 400 (-> s length)))])
    (for ([y i32 0]) (< y snake-rows) (+= y 1)
      (for ([x i32 0]) (< x snake-columns) (+= x 1)
        (unless (snake-occupied? s x y)
          (when (== k 0)
            (set! (-> s food x) x)
            (set! (-> s food y) y)
            (return))
          (-= k 1))))))

(define (reverse! [s (ptr snake)])
  (let ([n (-> s length)])
    (for ([i u32 0]) (< i (/ n 2)) (+= i 1)
      (let ([a (snake-segment s i)] [b (snake-segment s (- n 1 i))] [t cell])
        (set! t (@ a))
        (set! (@ a) (@ b))
        (set! (@ b) t)))))

(define (snake-reset! [s (ptr snake)] [seed u32])
  (for ([i u32 0]) (< i 3) (+= i 1)
    (set! (-> (+ (-> s body) i) x) (+ 8 (cast i32 i)))
    (set! (-> (+ (-> s body) i) y) 10))
  (set! (-> s head) 2)
  (set! (-> s length) 3)
  (set! (-> s direction) snake-right)
  (set! (-> s turn-count) 0)
  (set! (-> s score) 0)
  (set! (-> s state) snake-waiting)
  (set! (-> s timed) #f)
  (set! (-> s random) (if (== seed 0) 2654435769 seed))
  (place-food! s))

(define (snake-turn! [s (ptr snake)] [direction u32])
  (cond
    [(== (-> s state) snake-waiting)
     (when (== direction (opposite (-> s direction))) (reverse! s))
     (set! (-> s direction) direction)
     (set! (-> s state) snake-playing)]
    [(== (-> s state) snake-playing)
     (let ([heading (if (> (-> s turn-count) 0) (@ (-> s turns) (- (-> s turn-count) 1)) (-> s direction))])
       (when (and (< (-> s turn-count) 2) (!= direction heading) (!= direction (opposite heading)))
         (set! (@ (-> s turns) (-> s turn-count)) direction)
         (+= (-> s turn-count) 1)))]))

(define (snake-toggle-pause! [s (ptr snake)])
  (cond [(== (-> s state) snake-playing) (set! (-> s state) snake-paused)]
        [(== (-> s state) snake-paused) (set! (-> s state) snake-playing)]))

(define (snake-step! [s (ptr snake)])
  (when (== (-> s state) snake-playing)
    (when (> (-> s turn-count) 0)
      (set! (-> s direction) (@ (-> s turns) 0))
      (set! (@ (-> s turns) 0) (@ (-> s turns) 1))
      (-= (-> s turn-count) 1))
    (let* ([head (snake-segment s 0)]
           [x (+ (-> head x) (dx (-> s direction)))]
           [y (+ (-> head y) (dy (-> s direction)))]
           [eats (and (== x (-> s food x)) (== y (-> s food y)))])
      (cond
        [(or (< x 0) (>= x snake-columns) (< y 0) (>= y snake-rows)) (set! (-> s state) snake-over)]
        [(covers? s x y (if eats (-> s length) (- (-> s length) 1))) (set! (-> s state) snake-over)]
        [else
         (set! (-> s head) (% (+ (-> s head) 1) 400))
         (let ([new (snake-segment s 0)])
           (set! (-> new x) x)
           (set! (-> new y) y))
         (when eats
           (+= (-> s length) 1)
           (+= (-> s score) 1)
           (if (== (-> s length) 400)
               (set! (-> s state) snake-won)
               (place-food! s)))]))))

(define (step-length [score u32]) -> f64
  (let ([ms (- 130 (* 3 (cast i32 score)))])
    (if (< ms 60) 60.0 (cast f64 ms))))

(const max-steps u32 5)

(define (snake-advance! [s (ptr snake)] [now f64]) -> i32
  (cond
    [(!= (-> s state) snake-playing)
     (set! (-> s timed) #f)
     0]
    [(not (-> s timed))
     (set! (-> s timed) #t)
     (set! (-> s last-time) now)
     (set! (-> s pending) 0.0)
     0]
    [else
     (let ([steps u32 0])
       (+= (-> s pending) (- now (-> s last-time)))
       (set! (-> s last-time) now)
       (while (and (== (-> s state) snake-playing) (< steps max-steps)
                   (>= (-> s pending) (step-length (-> s score))))
         (-= (-> s pending) (step-length (-> s score)))
         (snake-step! s)
         (+= steps 1))
       (when (>= (-> s pending) (step-length (-> s score))) (set! (-> s pending) 0.0))
       (> steps 0))]))
