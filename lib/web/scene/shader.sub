;; The shader form: a shader's bindings, buffers and stages written once, checked when compiled.
(require-unqualified gpu "../gpu.sub")

(provide shader render-settings render-settings-init! vec2! vec3! vec4! color! linear-color! gpu-write-copy!)

;; ---- run-time support ----

(struct render-settings [topology u32] [cull u32] [front u32] [blend u32]
  [depth-format u32] [depth-compare u32] [depth-write bool]
  [target-count u32] [targets (array u32 4)]
  [groups u32])

(define (render-settings-init! [s (ptr render-settings)])
  (memset s 0 (sizeof render-settings))
  (set! (-> s topology) gpu-triangles)
  (set! (-> s target-count) 1)
  (set! (@ (-> s targets) 0) gpu-format-surface))

(define (vec2! [p (ptr f32)] [x f64] [y f64])
  (set! (@ p 0) (cast f32 x))
  (set! (@ p 1) (cast f32 y)))

(define (vec3! [p (ptr f32)] [x f64] [y f64] [z f64])
  (set! (@ p 0) (cast f32 x))
  (set! (@ p 1) (cast f32 y))
  (set! (@ p 2) (cast f32 z)))

(define (vec4! [p (ptr f32)] [x f64] [y f64] [z f64] [w f64])
  (set! (@ p 0) (cast f32 x))
  (set! (@ p 1) (cast f32 y))
  (set! (@ p 2) (cast f32 z))
  (set! (@ p 3) (cast f32 w)))

(define (part [color u32] [shift u32]) -> f64 (/ (cast f64 (bit-and (>> color shift) 255)) 255.0))

(define (color! [p (ptr f32)] [c u32]) (vec4! p (part c 24) (part c 16) (part c 8) (part c 0)))

;; sRGB to linear: x to the power 2.25 (x squared times its fourth root).
(define (linear [x f64]) -> f64 (* x x (sqrt (sqrt x))))

(define (linear-color! [p (ptr f32)] [c u32])
  (vec4! p (linear (part c 24)) (linear (part c 16)) (linear (part c 8)) (part c 0)))

(define (gpu-write-copy! [buffer u32] [offset u32] [p (ptr void)] [n u32])
  (gpu-write-buffer! buffer offset (gpu-frame-copy p n) n))

;; ---- the form ----
;; A clause is kept as a list: (kind name group binding visibility fields extra).
(begin-for-syntax
  (require-unqualified macros "../../../compiler/macros.sub")
  (require-unqualified shade "../shade/core.sub")

  (define (fail [where datum] [message datum]) -> datum (raise-syntax-error 'shader (datum->string message) where))

  (define (shade-field-type [t datum]) -> datum
    (if (and (identifier? t) (== (syntax-e t) 'unorm8x4)) '(vec 4 f32) (shade-type t)))

  (define (shade-fields [fields datum]) -> datum
    (let ([result nil])
      (while (pair? fields)
        (set! result (cons (cons (syntax-e (car (car fields))) (shade-field-type (cadr (car fields)))) result))
        (set! fields (cdr fields)))
      (reverse result)))

  (define (literal [d datum]) -> datum (datum->syntax #'here d 0))
  (define (number [n i64]) -> datum (literal (make-integer n)))

  (define (join [pieces datum]) -> datum
    (let ([b (make-buffer)] [s datum 0])
      (while (pair? pieces)
        (let ([p (car pieces)])
          (cond [(string? p) (buffer-add-string! (& b) (datum->string p))]
                [(symbol? p) (buffer-add-string! (& b) (symbol->string p))]
                [else (write-to (& b) p 1)]))
        (set! pieces (cdr pieces)))
      (set! s (string->datum (buffer-string (& b))))
      (buffer-free! (& b))
      s))

  (define (wgsl-name [s datum]) -> datum
    (let* ([name (symbol->string s)] [n (-> name length)] [bytes (cast (ptr u8) (malloc n))] [d datum 0])
      (memcpy bytes (-> name bytes) n)
      (for ([i u32 0]) (< i n) (+= i 1)
        (when (== (@ bytes i) #\-) (set! (@ bytes i) #\_)))
      (set! d (string->datum (cast string (slice bytes n))))
      (free bytes)
      d))

  (define (wgsl-struct-name [s datum]) -> datum
    (let* ([name (datum->string (wgsl-name s))] [n (-> name length)] [bytes (cast (ptr u8) (malloc n))] [d datum 0])
      (memcpy bytes (-> name bytes) n)
      (when (and (> n 0) (>= (@ bytes 0) #\a) (<= (@ bytes 0) #\z)) (set! (@ bytes 0) (cast u8 (- (@ bytes 0) 32))))
      (set! d (string->datum (cast string (slice bytes n))))
      (free bytes)
      d))

  (define (named [name datum] [rest datum]) -> datum
    (datum->syntax name (string->symbol (datum->string (join `(,(syntax-e name) "-" ,rest)))) name))

  (define (integer-of [d datum]) -> i64 (integer-value d))

  ;; ---- types ----
  (define types datum
    '((f32 4 4 "f32" 0 1)
      (i32 4 4 "i32" 0 8)
      (u32 4 4 "u32" 0 5)
      (vec2 8 8 "vec2f" 2 2)
      (vec3 12 16 "vec3f" 3 3)
      (vec4 16 16 "vec4f" 4 4)
      (mat3 48 16 "mat3x3f" 12 0)
      (mat4 64 16 "mat4x4f" 16 0)
      (unorm8x4 4 4 "vec4f" 0 9)))

  (define (type-info [t datum] [where datum]) -> datum
    (let ([info (if (symbol? t) (assq t types) 0)])
      (when (== info 0)
        (fail where '"unknown type: expected f32, i32, u32, vec2, vec3, vec4, mat3, mat4, unorm8x4 or (array T n)"))
      info))

  (define (type-size [info datum]) -> i64 (integer-of (list-ref info 1)))
  (define (type-align [info datum]) -> i64 (integer-of (list-ref info 2)))
  (define (type-wgsl [info datum]) -> datum (list-ref info 3))
  (define (type-floats [info datum]) -> i64 (integer-of (list-ref info 4)))
  (define (type-format [info datum]) -> i64 (integer-of (list-ref info 5)))

  (define (program-type [t datum] [count i64]) -> datum
    (let ([info (type-info (syntax-e t) t)])
      (if (== (type-floats info) 0)
          (if (== count 1)
              (if (== (syntax-e t) 'unorm8x4) #'u32 t)
              #`(array #,t #,(number count)))
          #`(array f32 #,(number (* (type-floats info) count))))))

  (define (round-up [n i64] [to i64]) -> i64 (* (/ (+ n (- to 1)) to) to))

  (define (element-of [t datum]) -> datum
    (let ([l (syntax->list t)])
      (if (== l 0)
          t
          (begin
            (unless (and (== (length l) 3) (identifier? (car l)) (== (syntax-e (car l)) 'array))
              (fail t '"expected a type, or (array T n)"))
            (cadr l)))))

  (define (count-of [t datum]) -> i64
    (let ([l (syntax->list t)])
      (if (== l 0)
          1
          (begin
            (unless (and (integer? (syntax-e (caddr l))) (> (integer-value (syntax-e (caddr l))) 0))
              (fail (caddr l) '"the count of an array must be a positive number"))
            (integer-value (syntax-e (caddr l)))))))

  ;; Returns a list of (name offset size align wgsl-type program-type), then the struct's
  ;; size and alignment as the last two elements.
  (define (layout [fields datum] [space datum]) -> datum
    (let ([offset i64 0] [biggest i64 4] [laid nil])
      (while (pair? fields)
        (let* ([f (car fields)] [fname (car f)] [t (cadr f)]
               [element (element-of t)] [count (count-of t)] [array (!= element t)]
               [info (type-info (syntax-e element) element)])
          (when (== (syntax-e element) 'unorm8x4) (fail element '"unorm8x4 is only for vertex attributes; a buffer holds vec4 or u32"))
          (when (and array (equal? space '"uniform") (< (type-size info) 16))
            (fail t '"an array in a uniform must have a stride that is a multiple of 16 (WGSL's rule): use vec4, mat3 or mat4 elements, or a storage buffer"))
          (let* ([align (type-align info)]
                 [stride (round-up (type-size info) align)]
                 [size (if array (* stride count) (type-size info))]
                 [wgsl (if array
                           (join `("array<" ,(type-wgsl info) ", " ,(make-integer count) ">"))
                           (type-wgsl info))])
            (set! offset (round-up offset align))
            (when (> align biggest) (set! biggest align))
            (set! laid (cons `(,fname ,(make-integer offset) ,(make-integer size) ,(make-integer align) ,wgsl ,(program-type element count)) laid))
            (set! offset (+ offset size))))
        (set! fields (cdr fields)))
      (append (reverse laid) `(,(make-integer (round-up offset biggest)) ,(make-integer biggest)))))

  (define (laid-size [laid datum]) -> i64 (integer-of (list-ref laid (- (length laid) 2))))

  (define (program-struct [name datum] [laid datum]) -> datum
    (let ([fields nil] [cursor i64 0] [pads i64 0])
      (while (pair? (cddr laid))
        (let* ([f (car laid)] [offset (integer-of (list-ref f 1))] [size (integer-of (list-ref f 2))])
          (when (> offset cursor)
            (set! fields (cons #`[#,(literal (string->symbol (datum->string (join `("pad" ,(make-integer pads)))))) (array u8 #,(number (- offset cursor)))] fields))
            (set! pads (+ pads 1)))
          (set! fields (cons #`[#,(car f) #,(list-ref f 5)] fields))
          (set! cursor (+ offset size)))
        (set! laid (cdr laid)))
      (let ([size (integer-of (car laid))])
        (when (> size cursor)
          (set! fields (cons #`[#,(literal (string->symbol (datum->string (join `("pad" ,(make-integer pads)))))) (array u8 #,(number (- size cursor)))] fields))))
      #`(struct #,name #,@(reverse fields))))

  (define (wgsl-struct [name datum] [laid datum]) -> datum
    (let ([s (join `("struct " ,name " {"))])
      (while (pair? (cddr laid))
        (let ([f (car laid)])
          (set! s (join `(,s " " ,(wgsl-name (syntax-e (car f))) ": " ,(list-ref f 4) ","))))
        (set! laid (cdr laid)))
      (join `(,s " }\n"))))

  ;; ---- clauses ----

  (define (visibility [stages datum]) -> i64
    (let ([l (syntax->list stages)] [bits i64 0])
      (when (or (== l 0) (null? l)) (fail stages '"expected the stages that see the binding: (vertex), (fragment), (compute), or several"))
      (while (pair? l)
        (let ([s (syntax-e (car l))])
          (unless (or (== s 'vertex) (== s 'fragment) (== s 'compute)) (fail (car l) '"a stage is vertex, fragment or compute"))
          (set! bits (bit-or bits (cond [(== s 'vertex) 1] [(== s 'fragment) 2] [else 4]))))
        (set! l (cdr l)))
      bits))

  (define (fields-of [forms datum] [where datum]) -> datum
    (let ([fields nil] [names nil])
      (while (pair? forms)
        (let ([l (syntax->list (car forms))])
          (unless (and (!= l 0) (== (length l) 2) (identifier? (car l)))
            (fail (car forms) '"expected a field, [name type]"))
          (when (memq (syntax-e (car l)) names) (fail (car l) '"this field is named twice"))
          (set! names (cons (syntax-e (car l)) names))
          (set! fields (cons `(,(car l) ,(cadr l)) fields)))
        (set! forms (cdr forms)))
      (when (null? fields) (fail where '"a struct needs at least one field"))
      (reverse fields)))

  (define (small-number [x datum] [what datum]) -> datum
    (unless (and (integer? (syntax-e x)) (>= (integer-value (syntax-e x)) 0)) (fail x (join `("expected the " ,what " number"))))
    (syntax-e x))

  (define (clause [c datum]) -> datum
    (let ([l (syntax->list c)])
      (unless (and (!= l 0) (pair? l) (identifier? (car l))) (fail c '"expected a clause, such as [uniform name group binding (stages) field ...]"))
      (let ([kind (syntax-e (car l))])
        (cond
          [(or (== kind 'uniform) (== kind 'uniform-array) (== kind 'storage))
           (let ([storage (== kind 'storage)])
             (unless (>= (length l) (if storage 7 6)) (fail c '"expected [uniform name group binding (stages) field ...], or with an access, read or read-write, before the fields of a storage buffer"))
             (unless (identifier? (cadr l)) (fail (cadr l) '"expected the buffer's name"))
             (let ([access (if storage (syntax-e (list-ref l 5)) 0)])
               (when (and storage (not (or (== access 'read) (== access 'read-write))))
                 (fail (list-ref l 5) '"a storage buffer's access is read or read-write"))
               `(,kind ,(cadr l) ,(small-number (caddr l) '"group") ,(small-number (cadddr l) '"binding")
                 ,(make-integer (visibility (list-ref l 4))) ,(fields-of (list-tail l (if storage 6 5)) c) ,access)))]
          [(or (== kind 'sampler) (== kind 'comparison-sampler) (== kind 'texture) (== kind 'depth-texture)
               (== kind 'texture-array) (== kind 'depth-texture-array))
           (unless (and (== (length l) 5) (identifier? (cadr l))) (fail c '"expected [kind name group binding (stages)]"))
           `(,kind ,(cadr l) ,(small-number (caddr l) '"group") ,(small-number (cadddr l) '"binding") ,(make-integer (visibility (list-ref l 4))) () 0)]
          [(== kind 'vertex-input)
           (unless (and (>= (length l) 4) (identifier? (cadr l))) (fail c '"expected [vertex-input name per-vertex|per-instance field ...]"))
           (let ([step (syntax-e (caddr l))])
             (unless (or (== step 'per-vertex) (== step 'per-instance)) (fail (caddr l) '"the step is per-vertex or per-instance"))
             `(,kind ,(cadr l) ,(make-integer -1) ,(make-integer -1) ,(make-integer 0) ,(fields-of (list-tail l 3) c) ,(make-integer (if (== step 'per-vertex) 0 1))))]
          [else 0]))))

  (define (clause-kind [c datum]) -> datum (list-ref c 0))
  (define (clause-name [c datum]) -> datum (list-ref c 1))
  (define (clause-group [c datum]) -> i64 (integer-of (list-ref c 2)))
  (define (clause-binding [c datum]) -> i64 (integer-of (list-ref c 3)))
  (define (clause-visibility [c datum]) -> i64 (integer-of (list-ref c 4)))
  (define (clause-fields [c datum]) -> datum (list-ref c 5))
  (define (clause-extra [c datum]) -> datum (list-ref c 6))

  (define (buffer-clause? [c datum]) -> bool
    (let ([k (clause-kind c)]) (or (== k 'uniform) (== k 'uniform-array) (== k 'storage))))

  (define (entry-kind [c datum]) -> i64
    (let ([k (clause-kind c)])
      (cond [(== k 'uniform) 1]
            [(== k 'uniform-array) 4]
            [(== k 'storage) (if (== (clause-extra c) 'read) 3 2)]
            [(== k 'sampler) 7]
            [(== k 'comparison-sampler) 8]
            [(== k 'texture) 9]
            [(== k 'depth-texture) 10]
            [(== k 'texture-array) 12]
            [else 13])))

  (define (wgsl-binding [c datum] [struct-name datum]) -> datum
    (let ([k (clause-kind c)] [name (wgsl-name (syntax-e (clause-name c)))])
      (join `("@group(" ,(make-integer (clause-group c)) ") @binding(" ,(make-integer (clause-binding c)) ") var"
              ,(cond [(or (== k 'uniform) (== k 'uniform-array)) (join `("<uniform> " ,name ": " ,struct-name))]
                     [(== k 'storage) (join `("<storage, " ,(if (== (clause-extra c) 'read) '"read" '"read_write") "> " ,name ": array<" ,struct-name ">"))]
                     [(== k 'sampler) (join `(" " ,name ": sampler"))]
                     [(== k 'comparison-sampler) (join `(" " ,name ": sampler_comparison"))]
                     [(== k 'texture) (join `(" " ,name ": texture_2d<f32>"))]
                     [(== k 'depth-texture) (join `(" " ,name ": texture_depth_2d"))]
                     [(== k 'texture-array) (join `(" " ,name ": texture_2d_array<f32>"))]
                     [else (join `(" " ,name ": texture_depth_2d_array"))])
              ";\n"))))

  ;; ---- the form ----

  (define (shader-form [s datum]) -> datum
    (syntax-match s
      [(_ (? identifier? name) c ...)
       (let ([bindings nil] [inputs nil] [varyings nil] [varied #f] [builtins nil] [code '""] [names nil]
             [definitions nil] [wgsl '""] [groups i64 0]
             [outputs nil] [shaded nil] [entries nil] [libraries nil])
         (while (pair? c)
           (let* ([form (car c)] [l (syntax->list form)] [read (clause form)])
             (cond
               [(!= read 0)
                (when (memq (syntax-e (clause-name read)) names) (fail (cadr l) '"this name is used twice"))
                (set! names (cons (syntax-e (clause-name read)) names))
                (if (== (clause-kind read) 'vertex-input)
                    (set! inputs (cons read inputs))
                    (set! bindings (cons read bindings)))]
               [(== (syntax-e (car l)) 'varyings)
                (when varied (fail form '"there can be one varyings clause"))
                (set! varied #t)
                (unless (null? (cdr l)) (set! varyings (fields-of (cdr l) form)))]
               [(== (syntax-e (car l)) 'builtins)
                (let ([bl (cdr l)])
                  (while (pair? bl)
                    (let ([b (syntax-e (car bl))])
                      (unless (or (== b 'vertex-index) (== b 'instance-index)) (fail (car bl) '"the built-ins are vertex-index and instance-index"))
                      (set! builtins (cons b builtins)))
                    (set! bl (cdr bl))))]
               [(== (syntax-e (car l)) 'outputs)
                (when (pair? outputs) (fail form '"there can be one outputs clause"))
                (set! outputs (fields-of (cdr l) form))]
               [(or (== (syntax-e (car l)) 'define) (== (syntax-e (car l)) 'struct) (== (syntax-e (car l)) 'const))
                (set! shaded (cons form shaded))]
               [(== (syntax-e (car l)) 'use)
                (unless (and (== (length l) 2) (identifier? (cadr l))) (fail form '"expected [use library]"))
                (unless (== (identifier-binding-kind (cadr l)) 'compile-time-value)
                  (fail (cadr l) '"this is not a Shade library: a library is made with shade-library, and required"))
                (let ([v (syntax-local-value (cadr l))])
                  (unless (and (pair? v) (== (car v) 'shade-library)) (fail (cadr l) '"this is not a Shade library"))
                  (set! libraries (append libraries (syntax->list (cadr v)))))]
               [(or (== (syntax-e (car l)) 'vertex) (== (syntax-e (car l)) 'fragment))
                (set! entries (cons `(,(syntax-e (car l)) ,form "") entries))]
               [(== (syntax-e (car l)) 'compute)
                (unless (>= (length l) 4) (fail form '"expected [compute size (name [id value] ...) body ...]"))
                (let* ([size (cadr l)] [sl (syntax->list size)]
                       [text (if (== sl 0)
                                 (begin (unless (integer? (syntax-e size)) (fail size '"expected the workgroup's size, a number or (x y z)"))
                                        (format "~a" `(,(syntax-e size))))
                                 (let ([t '""] [first 1])
                                   (unless (and (>= (length sl) 1) (<= (length sl) 3)) (fail size '"expected the workgroup's size, a number or (x y z)"))
                                   (while (pair? sl)
                                     (unless (integer? (syntax-e (car sl))) (fail (car sl) '"expected a number"))
                                     (set! t (join `(,t ,(if first '"" '", ") ,(syntax-e (car sl)))))
                                     (set! first 0)
                                     (set! sl (cdr sl)))
                                   t))])
                  (set! entries (cons `(compute ,(datum->syntax form `(,(car l) ,@(cddr l)) form) ,text) entries)))]
               [(== (syntax-e (car l)) 'code)
                (unless (and (== (length l) 2) (string? (syntax-e (cadr l)))) (fail form '"expected [code \"WGSL\"]"))
                (set! code (join `(,code ,(syntax-e (cadr l)) "\n")))]
               [else (fail form '"unknown clause: the clauses are uniform, uniform-array, storage, sampler, comparison-sampler, texture, depth-texture, texture-array, depth-texture-array, vertex-input, builtins, varyings, outputs, define, struct, const, use, vertex, fragment, compute and code")]))
           (set! c (cdr c)))
         (set! bindings (reverse bindings))
         (set! inputs (reverse inputs))
         (set! builtins (reverse builtins))
         (set! shaded (append libraries (reverse shaded)))
         (set! entries (reverse entries))
         (shade-begin!)

         (let ([b bindings])
           (while (pair? b)
             (when (>= (clause-group (car b)) groups) (set! groups (+ (clause-group (car b)) 1)))
             (set! b (cdr b))))
         (for ([g i64 0]) (< g groups) (+= g 1)
           (let ([found #f] [seen nil] [b bindings])
             (while (pair? b)
               (when (== (clause-group (car b)) g)
                 (set! found #t)
                 (when (member (make-integer (clause-binding (car b))) seen)
                   (fail (clause-name (car b)) '"this binding number is used twice in its group"))
                 (set! seen (cons (make-integer (clause-binding (car b))) seen)))
               (set! b (cdr b)))
             (unless found (fail name (join `("group " ,(make-integer g) " has no bindings: groups are numbered from 0 without gaps"))))))

         (let ([b bindings])
           (while (pair? b)
             (let ([cl (car b)])
               (if (buffer-clause? cl)
                   (let* ([space (if (== (clause-kind cl) 'storage) '"storage" '"uniform")]
                          [laid (layout (clause-fields cl) space)]
                          [struct-name (wgsl-struct-name (syntax-e (clause-name cl)))]
                          [size (laid-size laid)])
                     (shade-struct! (syntax-e (clause-name cl)) struct-name (shade-fields (clause-fields cl)))
                     (shade-global! (syntax-e (clause-name cl))
                                    (if (== (clause-kind cl) 'storage) `(array (struct ,(syntax-e (clause-name cl)))) `(struct ,(syntax-e (clause-name cl)))))
                     (set! wgsl (join `(,wgsl ,(wgsl-struct struct-name laid))))
                     (set! definitions (cons (program-struct (named name (syntax-e (clause-name cl))) laid) definitions))
                     (when (== (clause-kind cl) 'uniform-array)
                       (set! definitions (cons #`(define #,(named name (join `(,(syntax-e (clause-name cl)) "-stride"))) u32 #,(number (round-up size 256))) definitions)))
                     (when (== (clause-kind cl) 'storage)
                       (set! definitions (cons #`(define #,(named name (join `(,(syntax-e (clause-name cl)) "-stride"))) u32 #,(number size)) definitions)))
                     (set! wgsl (join `(,wgsl ,(wgsl-binding cl struct-name)))))
                   (begin
                     (shade-global! (syntax-e (clause-name cl))
                                    (let ([k (clause-kind cl)])
                                      (cond [(== k 'sampler) 'sampler] [(== k 'comparison-sampler) 'sampler-comparison]
                                            [(== k 'texture) 'texture-2d] [(== k 'depth-texture) 'texture-depth-2d]
                                            [(== k 'texture-array) 'texture-2d-array] [else 'texture-depth-2d-array])))
                     (set! wgsl (join `(,wgsl ,(wgsl-binding cl '"")))))))
             (set! b (cdr b))))

         (let ([location i64 0] [vertex-wgsl '"struct Vertex {"] [buffers nil] [i inputs])
           (while (pair? i)
             (let* ([cl (car i)] [fields (clause-fields cl)] [offset i64 0] [attributes nil] [program-fields nil])
               (while (pair? fields)
                 (let* ([f (car fields)] [t (cadr f)] [info (type-info (syntax-e t) t)])
                   (when (== (type-format info) 0) (fail t '"a matrix cannot be a vertex attribute: use four vec4 fields"))
                   (set! vertex-wgsl (join `(,vertex-wgsl " @location(" ,(make-integer location) ") " ,(wgsl-name (syntax-e (car f))) ": " ,(type-wgsl info) ",")))
                   (set! attributes (cons #`(gpu-attribute! #,(number location) #,(number offset) #,(number (type-format info))) attributes))
                   (set! program-fields (cons #`[#,(car f) #,(program-type t 1)] program-fields))
                   (set! location (+ location 1))
                   (set! offset (+ offset (type-size info))))
                 (set! fields (cdr fields)))
               (set! definitions (cons #`(struct #,(named name (syntax-e (clause-name cl))) #,@(reverse program-fields)) definitions))
               (set! buffers (cons #`(begin (gpu-vertex-buffer-layout! #,(number offset) #,(number (integer-of (clause-extra cl))) #,(number (length attributes)))
                                            #,@(reverse attributes))
                                   buffers)))
             (set! i (cdr i)))
           (let ([b builtins] [fields nil] [i inputs])
             (while (pair? i)
               (set! fields (append fields (shade-fields (clause-fields (car i)))))
               (set! i (cdr i)))
             (while (pair? b)
               (set! vertex-wgsl (join `(,vertex-wgsl " @builtin(" ,(wgsl-name (car b)) ") " ,(wgsl-name (car b)) ": u32,")))
               (set! fields (append fields `((,(car b) . u32))))
               (set! b (cdr b)))
             (shade-struct! 'vertex '"Vertex" fields)
             (unless (and (null? inputs) (null? builtins))
               (set! wgsl (join `(,wgsl ,vertex-wgsl " }\n")))))

           (let ([v-wgsl '"struct Varyings { @builtin(position) position: vec4f,"] [loc i64 0] [v varyings])
             (while (pair? v)
               (let* ([f (car v)] [t (cadr f)] [info (type-info (syntax-e t) t)])
                 (when (or (== (type-floats info) 12) (== (syntax-e t) 'unorm8x4)) (fail t '"a varying is a scalar, a vector or a mat4"))
                 (set! v-wgsl (join `(,v-wgsl " @location(" ,(make-integer loc) ") " ,(wgsl-name (syntax-e (car f))) ": " ,(type-wgsl info) ",")))
                 (set! loc (+ loc 1)))
               (set! v (cdr v)))
             (shade-struct! 'varyings '"Varyings" (append '((position . (vec 4 f32))) (shade-fields varyings)))
             (set! wgsl (join `(,wgsl ,v-wgsl " }\n"))))
           (when (pair? outputs)
             (let ([o-wgsl '"struct Outputs {"] [loc i64 0] [o outputs])
               (while (pair? o)
                 (let* ([f (car o)] [t (cadr f)] [info (type-info (syntax-e t) t)])
                   (when (or (== (type-floats info) 12) (== (type-floats info) 16) (== (syntax-e t) 'unorm8x4)) (fail t '"an output is a scalar or a vector"))
                   (set! o-wgsl (join `(,o-wgsl " @location(" ,(make-integer loc) ") " ,(wgsl-name (syntax-e (car f))) ": " ,(type-wgsl info) ",")))
                   (set! loc (+ loc 1)))
                 (set! o (cdr o)))
               (shade-struct! 'outputs '"Outputs" (shade-fields outputs))
               (set! wgsl (join `(,wgsl ,o-wgsl " }\n")))))
           (shade-compile! shaded entries)
           (set! wgsl (join `(,wgsl ,(shade-text) ,code)))

           (let ([shader-struct (named name '"shader")] [entries nil] [group-functions nil] [layout-items nil])
             (for ([g i64 0]) (< g groups) (+= g 1)
               (let ([group-entries nil] [parameters nil] [binds nil] [count i64 0] [b bindings])
                 (while (pair? b)
                   (let ([cl (car b)])
                     (when (== (clause-group cl) g)
                       (set! count (+ count 1))
                       (set! group-entries (cons #`(gpu-layout-entry! #,(number (clause-binding cl)) #,(number (clause-visibility cl)) #,(number (entry-kind cl))) group-entries))
                       (let ([p (clause-name cl)] [k (clause-kind cl)])
                         (set! parameters (cons #`[#,p u32] parameters))
                         (set! binds (cons (cond [(== k 'uniform-array)
                                                  #`(gpu-bind-buffer! #,(number (clause-binding cl)) #,p 0 (sizeof #,(named name (syntax-e p))))]
                                                 [(buffer-clause? cl) #`(gpu-bind-buffer! #,(number (clause-binding cl)) #,p 0 0)]
                                                 [(or (== k 'sampler) (== k 'comparison-sampler)) #`(gpu-bind-sampler! #,(number (clause-binding cl)) #,p)]
                                                 [else #`(gpu-bind-texture! #,(number (clause-binding cl)) #,p)])
                                           binds))))
                     (set! b (cdr b))))
                 (set! entries (cons #`(begin (set! (@ (-> s layouts) #,(number g)) (gpu-layout! #,(number count))) #,@(reverse group-entries)) entries))
                 (set! layout-items (cons #`(when (> used #,(number g)) (gpu-layout-item! (@ (-> s layouts) #,(number g)))) layout-items))
                 (set! group-functions
                       (cons #`(define (#,(named name (join `("bind-group-" ,(make-integer g) "!"))) [s (ptr #,shader-struct)] #,@(reverse parameters)) -> u32
                                 (let ([group (gpu-bind-group! (@ (-> s layouts) #,(number g)) 0 #,(number g) #,(number count))])
                                   #,@(reverse binds)
                                   group))
                             group-functions))))
             (set! layout-items (reverse layout-items))
             #`(begin
                 (define #,(named name '"code") string #,(literal wgsl))
                 #,@(reverse definitions)
                 (struct #,shader-struct [shader u32] [layouts (array u32 #,(number (if (== groups 0) 1 groups)))])
                 (define (#,(named name '"init!") [s (ptr #,shader-struct)])
                   (set! (-> s shader) (gpu-shader! #,(named name '"code")))
                   #,@(reverse entries))
                 (define (#,(named name '"render-pipeline!") [s (ptr #,shader-struct)] [vertex string] [fragment string] [settings (ptr render-settings)]) -> u32
                   (let* ([used (if (== (-> settings groups) 0) #,(number groups) (-> settings groups))]
                          [pipeline (gpu-render-pipeline! (-> s shader) vertex fragment
                                                          (-> settings topology) (-> settings cull) (-> settings front) (-> settings blend)
                                                          (-> settings depth-format) (-> settings depth-compare) (-> settings depth-write)
                                                          used (-> settings target-count) #,(number (length buffers)))])
                     #,@layout-items
                     (for ([i u32 0]) (< i (-> settings target-count)) (+= i 1) (gpu-target! (@ (-> settings targets) i)))
                     #,@(reverse buffers)
                     pipeline))
                 (define (#,(named name '"compute-pipeline!") [s (ptr #,shader-struct)] [entry string]) -> u32
                   (let* ([used u32 #,(number groups)] [pipeline (gpu-compute-pipeline! (-> s shader) entry used)])
                     #,@layout-items
                     pipeline))
                 #,@(reverse group-functions)))))]
      [_ (fail s '"expected (shader name clause ...)")])))

(define-syntax shader shader-form)
