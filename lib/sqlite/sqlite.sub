;; SQLite, from sqlite3.wasm (build.sh), on the host's files (vfs.sub), after SQLite's C calls. A call that fails
;; returns -1, or 0 for a database or statement, and stores SQLite's message at err. A row's text and blobs are
;; SQLite's until its statement steps again, is reset or is finalized.
(require-unqualified vfs "vfs.sub")

(provide sqlite sqlite-statement sqlite-open sqlite-close sqlite-exec sqlite-prepare sqlite-step sqlite-reset
         sqlite-finalize sqlite-bind-null sqlite-bind-i64 sqlite-bind-f64 sqlite-bind-text sqlite-bind-blob
         sqlite-column-count sqlite-column-type sqlite-column-name sqlite-column-i64 sqlite-column-f64
         sqlite-column-text sqlite-column-blob sqlite-changes sqlite-last-insert-rowid sqlite-version sqlite-row
         sqlite-done sqlite-integer sqlite-float sqlite-text sqlite-blob sqlite-null)

(import sqlite3_open_v2 "sqlite" "sqlite3_open_v2" (i32 i32 i32 i32 -> i32))
(import sqlite3_close_v2 "sqlite" "sqlite3_close_v2" (i32 -> i32))
(import sqlite3_errmsg "sqlite" "sqlite3_errmsg" (i32 -> i32))
(import sqlite3_prepare_v2 "sqlite" "sqlite3_prepare_v2" (i32 i32 i32 i32 i32 -> i32))
(import sqlite3_step "sqlite" "sqlite3_step" (i32 -> i32))
(import sqlite3_reset "sqlite" "sqlite3_reset" (i32 -> i32))
(import sqlite3_finalize "sqlite" "sqlite3_finalize" (i32 -> i32))
(import sqlite3_db_handle "sqlite" "sqlite3_db_handle" (i32 -> i32))
(import sqlite3_bind_null "sqlite" "sqlite3_bind_null" (i32 i32 -> i32))
(import sqlite3_bind_int64 "sqlite" "sqlite3_bind_int64" (i32 i32 i64 -> i32))
(import sqlite3_bind_double "sqlite" "sqlite3_bind_double" (i32 i32 f64 -> i32))
(import sqlite3_bind_text "sqlite" "sqlite3_bind_text" (i32 i32 i32 i32 i32 -> i32))
(import sqlite3_bind_blob "sqlite" "sqlite3_bind_blob" (i32 i32 i32 i32 i32 -> i32))
(import sqlite3_column_count "sqlite" "sqlite3_column_count" (i32 -> i32))
(import sqlite3_column_type "sqlite" "sqlite3_column_type" (i32 i32 -> i32))
(import sqlite3_column_name "sqlite" "sqlite3_column_name" (i32 i32 -> i32))
(import sqlite3_column_int64 "sqlite" "sqlite3_column_int64" (i32 i32 -> i64))
(import sqlite3_column_double "sqlite" "sqlite3_column_double" (i32 i32 -> f64))
(import sqlite3_column_text "sqlite" "sqlite3_column_text" (i32 i32 -> i32))
(import sqlite3_column_blob "sqlite" "sqlite3_column_blob" (i32 i32 -> i32))
(import sqlite3_column_bytes "sqlite" "sqlite3_column_bytes" (i32 i32 -> i32))
(import sqlite3_changes64 "sqlite" "sqlite3_changes64" (i32 -> i64))
(import sqlite3_last_insert_rowid "sqlite" "sqlite3_last_insert_rowid" (i32 -> i64))
(import sqlite3_libversion "sqlite" "sqlite3_libversion" (-> i32))

(struct sqlite)
(struct sqlite-statement)

(const sqlite-row i32 100)
(const sqlite-done i32 101)

;; A column's type.
(const sqlite-integer i32 1)
(const sqlite-float i32 2)
(const sqlite-text i32 3)
(const sqlite-blob i32 4)
(const sqlite-null i32 5)

(const read-write-create i32 6)
(const transient i32 -1)

;; The bytes of empty text or an empty blob, which bound at address 0 would be NULL.
(define empty (array u8 1))

(define (failure [db i32] [err (ptr string)]) -> i32
  (when (!= err 0) (set! (@ err 0) (string-copy (c-string (cast (ptr u8) (sqlite3_errmsg db))))))
  -1)

(define (sqlite-open [path string] [err (ptr string)]) -> (ptr sqlite)
  (let ([name (c-copy path)] [db i32 0] [r (vfs-start!)])
    (when (== r 0) (set! r (sqlite3_open_v2 (cast i32 name) (cast i32 (& db)) read-write-create 0)))
    (free (cast (ptr void) name))
    (when (== r 0) (return (cast (ptr sqlite) db)))
    (failure db err)
    (sqlite3_close_v2 db)
    0))

(define (sqlite-close [db (ptr sqlite)]) (sqlite3_close_v2 (cast i32 db)))

;; sqlite-exec runs each statement of sql to its end. SQLite copies the rest of text with no 0 at its end each time it
;; prepares a statement, so sql is copied once, with one.
(define (sqlite-exec [db (ptr sqlite)] [sql string] [err (ptr string)]) -> i32
  (let* ([text (c-copy sql)] [rest (cast i32 text)] [st i32 0] [r i32 0])
    (while (!= (@ (cast (ptr u8) rest) 0) 0)
      (unless (== (sqlite3_prepare_v2 (cast i32 db) rest -1 (cast i32 (& st)) (cast i32 (& rest))) 0)
        (free (cast (ptr void) text))
        (return (failure (cast i32 db) err)))
      (unless (== st 0)
        (set! r (sqlite3_step st))
        (while (== r sqlite-row) (set! r (sqlite3_step st)))
        (unless (== r sqlite-done)
          (failure (cast i32 db) err)
          (sqlite3_finalize st)
          (free (cast (ptr void) text))
          (return -1))
        (sqlite3_finalize st)))
    (free (cast (ptr void) text))
    0))

(define (sqlite-prepare [db (ptr sqlite)] [sql string] [err (ptr string)]) -> (ptr sqlite-statement)
  (let ([st i32 0])
    (unless (== (sqlite3_prepare_v2 (cast i32 db) (cast i32 (-> sql bytes)) (cast i32 (-> sql length)) (cast i32 (& st)) 0)
                0)
      (failure (cast i32 db) err)
      (return 0))
    (when (and (== st 0) (!= err 0)) (set! (@ err 0) (string-copy "the text holds no statement")))
    (cast (ptr sqlite-statement) st)))

;; sqlite-step gives sqlite-row or sqlite-done.
(define (sqlite-step [st (ptr sqlite-statement)] [err (ptr string)]) -> i32
  (let ([r (sqlite3_step (cast i32 st))])
    (if (or (== r sqlite-row) (== r sqlite-done)) r (failure (sqlite3_db_handle (cast i32 st)) err))))

(define (sqlite-reset [st (ptr sqlite-statement)]) (sqlite3_reset (cast i32 st)))

(define (sqlite-finalize [st (ptr sqlite-statement)]) (sqlite3_finalize (cast i32 st)))

;; ---- binding, from 1 ----

(define (bound [r i32]) -> i32 (if (== r 0) 0 -1))

(define (bytes-at [b (slice u8)]) -> i32
  (if (== (-> b length) 0) (cast i32 (-> (slice empty) items)) (cast i32 (-> b items))))

(define (sqlite-bind-null [st (ptr sqlite-statement)] [i i32]) -> i32 (bound (sqlite3_bind_null (cast i32 st) i)))

(define (sqlite-bind-i64 [st (ptr sqlite-statement)] [i i32] [v i64]) -> i32
  (bound (sqlite3_bind_int64 (cast i32 st) i v)))

(define (sqlite-bind-f64 [st (ptr sqlite-statement)] [i i32] [v f64]) -> i32
  (bound (sqlite3_bind_double (cast i32 st) i v)))

(define (sqlite-bind-text [st (ptr sqlite-statement)] [i i32] [s string]) -> i32
  (bound (sqlite3_bind_text (cast i32 st) i (bytes-at (cast (slice u8) s)) (cast i32 (-> s length)) transient)))

(define (sqlite-bind-blob [st (ptr sqlite-statement)] [i i32] [b (slice u8)]) -> i32
  (bound (sqlite3_bind_blob (cast i32 st) i (bytes-at b) (cast i32 (-> b length)) transient)))

;; ---- columns, from 0 ----

(define (sqlite-column-count [st (ptr sqlite-statement)]) -> i32 (sqlite3_column_count (cast i32 st)))

(define (sqlite-column-type [st (ptr sqlite-statement)] [i i32]) -> i32 (sqlite3_column_type (cast i32 st) i))

(define (sqlite-column-name [st (ptr sqlite-statement)] [i i32]) -> string
  (c-string (cast (ptr u8) (sqlite3_column_name (cast i32 st) i))))

(define (sqlite-column-i64 [st (ptr sqlite-statement)] [i i32]) -> i64 (sqlite3_column_int64 (cast i32 st) i))

(define (sqlite-column-f64 [st (ptr sqlite-statement)] [i i32]) -> f64 (sqlite3_column_double (cast i32 st) i))

(define (sqlite-column-text [st (ptr sqlite-statement)] [i i32]) -> string
  (let ([p (sqlite3_column_text (cast i32 st) i)])
    (cast string (slice (cast (ptr u8) p) (cast u32 (sqlite3_column_bytes (cast i32 st) i))))))

(define (sqlite-column-blob [st (ptr sqlite-statement)] [i i32]) -> (slice u8)
  (let ([p (sqlite3_column_blob (cast i32 st) i)])
    (slice (cast (ptr u8) p) (cast u32 (sqlite3_column_bytes (cast i32 st) i)))))

;; ---- the database ----

(define (sqlite-changes [db (ptr sqlite)]) -> i64 (sqlite3_changes64 (cast i32 db)))

(define (sqlite-last-insert-rowid [db (ptr sqlite)]) -> i64 (sqlite3_last_insert_rowid (cast i32 db)))

(define (sqlite-version) -> string (c-string (cast (ptr u8) (sqlite3_libversion))))
