;; The environment's variables: the host module "env".
(provide env-get env-text)

(import get "env" "get" (i32 i32 i32 i32 -> i32))

(define (env-get [name (ptr u8)] [buf (ptr u8)] [cap u32]) -> i32
  (get (cast i32 name) (cast i32 (strlen name)) (cast i32 buf) (cast i32 cap)))

(define (env-text [name (ptr u8)]) -> (ptr u8)
  (let ([n (env-get name 0 0)])
    (if (< n 0)
        0
        (let ([p (cast (ptr u8) (malloc (+ (cast u32 n) 1)))])
          (env-get name p (cast u32 n))
          (set! (@ p n) 0)
          p))))
