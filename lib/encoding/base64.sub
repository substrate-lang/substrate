;; Base64 (RFC 4648), with padding, and base64url, its URL and file name alphabet without padding.
(provide base64-encode! base64-decode! base64url-encode! base64url-decode!)

(define standard string "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
(define url string "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_")

(define (base64-encode! [b (ptr buffer)] [bytes (slice u8)]) (encode! b bytes standard #t))

(define (base64url-encode! [b (ptr buffer)] [bytes (slice u8)]) (encode! b bytes url #f))

(define (encode! [b (ptr buffer)] [bytes (slice u8)] [digits string] [padded bool])
  (let ([p (-> bytes items)] [n (-> bytes length)] [i u32 0])
    (while (<= (+ i 3) n)
      (let ([v (bit-or (<< (cast u32 (@ p i)) 16) (<< (cast u32 (@ p (+ i 1))) 8) (cast u32 (@ p (+ i 2))))])
        (buffer-add-byte! b (@ digits (bit-and (>> v 18) 63)))
        (buffer-add-byte! b (@ digits (bit-and (>> v 12) 63)))
        (buffer-add-byte! b (@ digits (bit-and (>> v 6) 63)))
        (buffer-add-byte! b (@ digits (bit-and v 63))))
      (+= i 3))
    (when (< i n)
      (let ([v (<< (cast u32 (@ p i)) 16)] [two (< (+ i 1) n)])
        (when two (set! v (bit-or v (<< (cast u32 (@ p (+ i 1))) 8))))
        (buffer-add-byte! b (@ digits (bit-and (>> v 18) 63)))
        (buffer-add-byte! b (@ digits (bit-and (>> v 12) 63)))
        (cond [two (buffer-add-byte! b (@ digits (bit-and (>> v 6) 63)))]
              [padded (buffer-add-byte! b 61)])
        (when padded (buffer-add-byte! b 61))))))

(define (digit-value [c u8] [digits string]) -> i32
  (cond [(and (>= c 65) (<= c 90)) (- c 65)]
        [(and (>= c 97) (<= c 122)) (+ (- c 97) 26)]
        [(and (>= c 48) (<= c 57)) (+ (- c 48) 52)]
        [(== c (@ digits 62)) 62]
        [(== c (@ digits 63)) 63]
        [else -1]))

;; base64url-decode! returns #t when the text is base64url without padding, its spare bits zero, and #f otherwise.
(define (base64url-decode! [b (ptr buffer)] [text string]) -> bool
  (let ([v u32 0] [count u32 0])
    (for ([i u32 0]) (< i (-> text length)) (+= i 1)
      (let ([d (digit-value (@ text i) url)])
        (when (< d 0) (return #f))
        (set! v (bit-or (<< v 6) (cast u32 d)))
        (+= count 1)
        (when (== count 4)
          (buffer-add-byte! b (bit-and (>> v 16) 255))
          (buffer-add-byte! b (bit-and (>> v 8) 255))
          (buffer-add-byte! b (bit-and v 255))
          (set! v 0)
          (set! count 0))))
    (cond [(== count 0) #t]
          [(and (== count 2) (== (bit-and v 15) 0))
           (buffer-add-byte! b (bit-and (>> v 4) 255))
           #t]
          [(and (== count 3) (== (bit-and v 3) 0))
           (buffer-add-byte! b (bit-and (>> v 10) 255))
           (buffer-add-byte! b (bit-and (>> v 2) 255))
           #t]
          [else #f])))

;; base64-decode! returns #t when the text is groups of four digits, the last padded with =, and #f otherwise.
(define (base64-decode! [b (ptr buffer)] [text string]) -> bool
  (let ([v u32 0] [count u32 0] [pad u32 0] [ended #f])
    (for ([i u32 0]) (< i (-> text length)) (+= i 1)
      (let ([c (@ text i)])
        (when ended (return #f))
        (if (== c 61)
            (+= pad 1)
            (let ([d (digit-value c standard)])
              (when (or (< d 0) (> pad 0)) (return #f))
              (set! v (bit-or (<< v 6) (cast u32 d)))))
        (+= count 1)
        (when (== count 4)
          (cond [(== pad 0)
                 (buffer-add-byte! b (bit-and (>> v 16) 255))
                 (buffer-add-byte! b (bit-and (>> v 8) 255))
                 (buffer-add-byte! b (bit-and v 255))]
                [(== pad 1)
                 (buffer-add-byte! b (bit-and (>> v 10) 255))
                 (buffer-add-byte! b (bit-and (>> v 2) 255))]
                [(== pad 2) (buffer-add-byte! b (bit-and (>> v 4) 255))]
                [else (return #f)])
          (when (> pad 0) (set! ended #t))
          (set! v 0)
          (set! count 0)
          (set! pad 0))))
    (== count 0)))
