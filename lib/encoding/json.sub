;; JSON (RFC 8259): values after cJSON's, in an arena; a token reader after Go's Decoder.Token; writing as JavaScript's
;; JSON.stringify writes.
(require-unqualified utf8 "utf8.sub")

(provide json-value json-null json-boolean json-number json-string json-array json-object json-member json-error
         json-parse json-write! json-get json-at json-count json-as-i64 json-as-f64 json-as-string json-as-bool
         json-push! json-add! json-insert! json-replace! json-replace-at! json-remove! json-remove-at! json-copy
         json-equal? json-reader json-reader-start! json-reader-free! json-next! json-skip!
         json-token-error json-token-end json-token-start-array json-token-end-array json-token-start-object
         json-token-end-object json-token-key json-token-string json-token-number json-token-true json-token-false
         json-token-null)

(variant json-value
  [json-null]
  [json-boolean [value i32]]
  [json-number [value f64] [text (ptr u8)] [length u32]]
  [json-string [bytes (ptr u8)] [length u32]]
  [json-array [items (ptr json-value)] [count u32] [room u32]]
  [json-object [members (ptr json-member)] [count u32] [room u32]])

(struct json-member [key (ptr u8)] [key-length u32] [value json-value])

(struct json-error [message (ptr u8)] [offset u32] [line u32] [column u32])

;; ---- the token reader ----

(const json-token-error u32 0)
(const json-token-end u32 1)
(const json-token-start-array u32 2)
(const json-token-end-array u32 3)
(const json-token-start-object u32 4)
(const json-token-end-object u32 5)
(const json-token-key u32 6)
(const json-token-string u32 7)
(const json-token-number u32 8)
(const json-token-true u32 9)
(const json-token-false u32 10)
(const json-token-null u32 11)

;; What may come next, after Go's tokenState.
(const top-value u32 0)
(const top-end u32 1)
(const array-start u32 2)
(const array-value u32 3)
(const array-comma u32 4)
(const object-start u32 5)
(const object-key u32 6)
(const object-colon u32 7)
(const object-value u32 8)
(const object-comma u32 9)
(const failed u32 10)

(const depth-limit u32 1000)

(struct json-reader [text (ptr u8)] [at u32] [end u32] [state u32] [depth u32] [kinds (array u8 1000)]
        [bytes (ptr u8)] [length u32] [number f64] [scratch buffer] [error json-error])

(define (json-reader-start! [r (ptr json-reader)] [text (ptr u8)] [n u32])
  (set! (-> r text) text)
  (set! (-> r end) n)
  (set! (-> r at) (if (and (>= n 3) (== (@ text 0) 239) (== (@ text 1) 187) (== (@ text 2) 191)) 3 0))
  (set! (-> r state) top-value)
  (set! (-> r depth) 0)
  (set! (-> r bytes) 0)
  (set! (-> r length) 0)
  (set! (-> r number) 0.0)
  (set! (-> r scratch) (make-buffer))
  (set! (-> r error message) 0)
  (set! (-> r error offset) 0)
  (set! (-> r error line) 0)
  (set! (-> r error column) 0))

(define (json-reader-free! [r (ptr json-reader)]) (buffer-free! (& (-> r scratch))))

(define (json-next! [r (ptr json-reader)]) -> u32
  (let ([s (-> r state)] [c (space! r)])
    (cond [(or (== s array-value) (== s object-value))
           (cond [(== c #\,)
                  (+= (-> r at) 1)
                  (set! c (space! r))
                  (set! s (if (== s array-value) array-comma object-comma))]
                 [(== c (if (== s array-value) #\] #\})) (+= (-> r at) 1) (return (close! r))]
                 [(== c 256) (return (ended! r))]
                 [else (return (fail! r (if (== s array-value) "expected , or ]" "expected , or }")))])]
          [(== s object-key)
           (unless (== c #\:) (return (if (== c 256) (ended! r) (fail! r "expected : after a key"))))
           (+= (-> r at) 1)
           (set! c (space! r))
           (set! s object-colon)]
          [(== s top-end) (return (if (== c 256) json-token-end (fail! r "text after the value")))]
          [(== s failed) (return json-token-error)])
    (cond [(or (== s object-start) (== s object-comma))
           (cond [(== c #\")
                  (+= (-> r at) 1)
                  (if (string! r)
                      (begin (set! (-> r state) object-key) json-token-key)
                      json-token-error)]
                 [(and (== c #\}) (== s object-start)) (+= (-> r at) 1) (close! r)]
                 [(== c #\}) (fail! r "a comma before }")]
                 [(== c 256) (ended! r)]
                 [else (fail! r "a key must be a string")])]
          [(and (== c #\]) (== s array-start)) (+= (-> r at) 1) (close! r)]
          [(and (== c #\]) (== s array-comma)) (fail! r "a comma before ]")]
          [else (value! r c)])))

(define (json-skip! [r (ptr json-reader)]) -> i32
  (let ([d (-> r depth)] [t (json-next! r)])
    (when (or (== t json-token-start-array) (== t json-token-start-object))
      (while (> (-> r depth) d)
        (when (== (json-next! r) json-token-error) (return 0))))
    (and (!= t json-token-error) (!= t json-token-end) (!= t json-token-end-array) (!= t json-token-end-object))))

(define (space! [r (ptr json-reader)]) -> u32
  (let ([p (-> r text)] [i (-> r at)] [end (-> r end)] [c u32 0])
    (while (< i end)
      (set! c (@ p i))
      (unless (or (== c 32) (== c 10) (== c 13) (== c 9))
        (set! (-> r at) i)
        (return c))
      (+= i 1))
    (set! (-> r at) i)
    256))

(define (value! [r (ptr json-reader)] [c u32]) -> u32
  (cond [(== c #\")
         (+= (-> r at) 1)
         (if (string! r) (after-value! r json-token-string) json-token-error)]
        [(or (== c #\-) (and (>= c #\0) (<= c #\9))) (if (number! r) (after-value! r json-token-number) json-token-error)]
        [(== c #\[) (open! r 1 json-token-start-array)]
        [(== c #\{) (open! r 2 json-token-start-object)]
        [(== c #\t) (word! r "true" 4 json-token-true)]
        [(== c #\f) (word! r "false" 5 json-token-false)]
        [(== c #\n) (word! r "null" 4 json-token-null)]
        [(== c 256) (if (== (-> r depth) 0) (fail! r "the text has no value") (ended! r))]
        [else (fail! r "expected a value")]))

(define (word! [r (ptr json-reader)] [w (ptr u8)] [n u32] [t u32]) -> u32
  (if (and (<= (+ (-> r at) n) (-> r end)) (== (memcmp (+ (-> r text) (-> r at)) w n) 0))
      (begin
        (+= (-> r at) n)
        (after-value! r t))
      (fail! r "expected a value")))

(define (after-value! [r (ptr json-reader)] [t u32]) -> u32
  (set! (-> r state) (cond [(== (-> r depth) 0) top-end]
                           [(== (@ (-> r kinds) (- (-> r depth) 1)) 1) array-value]
                           [else object-value]))
  t)

(define (open! [r (ptr json-reader)] [kind u32] [t u32]) -> u32
  (when (== (-> r depth) depth-limit) (return (fail! r "nested too deeply")))
  (set! (@ (-> r kinds) (-> r depth)) kind)
  (+= (-> r depth) 1)
  (+= (-> r at) 1)
  (set! (-> r state) (if (== kind 1) array-start object-start))
  t)

(define (close! [r (ptr json-reader)]) -> u32
  (-= (-> r depth) 1)
  (after-value! r (if (== (@ (-> r kinds) (-> r depth)) 1) json-token-end-array json-token-end-object)))

(define (ended! [r (ptr json-reader)]) -> u32
  (fail! r (if (== (@ (-> r kinds) (- (-> r depth) 1)) 1) "the text ends inside an array" "the text ends inside an object")))

(define (fail! [r (ptr json-reader)] [message (ptr u8)]) -> u32
  (let ([p (-> r text)] [line u32 1] [from u32 0])
    (for ([i u32 0]) (< i (-> r at)) (+= i 1)
      (when (== (@ p i) 10)
        (+= line 1)
        (set! from (+ i 1))))
    (set! (-> r error message) message)
    (set! (-> r error offset) (-> r at))
    (set! (-> r error line) line)
    (set! (-> r error column) (+ (- (-> r at) from) 1))
    (set! (-> r state) failed)
    json-token-error))

(define (string! [r (ptr json-reader)]) -> i32
  (let ([p (-> r text)] [start (-> r at)] [i (-> r at)] [end (-> r end)] [c u32 0] [k u32 0])
    (while (< i end)
      (set! c (@ p i))
      (cond [(== c #\")
             (set! (-> r bytes) (+ p start))
             (set! (-> r length) (- i start))
             (set! (-> r at) (+ i 1))
             (return 1)]
            [(== c #\\) (return (escaped! r start i))]
            [(< c 32)
             (set! (-> r at) i)
             (return (fail! r "a control character in a string"))]
            [(< c 128) (+= i 1)]
            [else
             (set! k (utf-8-length p i end))
             (when (== k 0)
               (set! (-> r at) i)
               (return (fail! r "invalid UTF-8 in a string")))
             (+= i k)]))
    (set! (-> r at) i)
    (fail! r "the text ends inside a string")))

;; escaped! is string! for a string with escapes, from its first one at i, unescaped into the reader's scratch.
(define (escaped! [r (ptr json-reader)] [start u32] [i u32]) -> i32
  (let ([p (-> r text)] [end (-> r end)] [b (& (-> r scratch))] [c u32 0] [k u32 0] [u i32 0] [low i32 0])
    (set! (-> b length) 0)
    (buffer-add! b (+ p start) (- i start))
    (while (< i end)
      (set! c (@ p i))
      (cond [(== c #\")
             (set! (-> r bytes) (-> b bytes))
             (set! (-> r length) (-> b length))
             (set! (-> r at) (+ i 1))
             (return 1)]
            [(== c #\\)
             (set! (-> r at) i)
             (when (>= (+ i 1) end) (return (fail! r "the text ends inside a string")))
             (set! c (@ p (+ i 1)))
             (if (== c #\u)
                 (begin
                   (set! u (hex4 p (+ i 2) end))
                   (when (< u 0) (return (fail! r "invalid \\u escape")))
                   (+= i 6)
                   (when (and (>= u #xDC00) (<= u #xDFFF)) (return (fail! r "a lone surrogate in a \\u escape")))
                   (when (and (>= u #xD800) (<= u #xDBFF))
                     (set! low (if (and (< (+ i 1) end) (== (@ p i) #\\) (== (@ p (+ i 1)) #\u)) (hex4 p (+ i 2) end) -1))
                     (unless (and (>= low #xDC00) (<= low #xDFFF)) (return (fail! r "a lone surrogate in a \\u escape")))
                     (set! u (+ #x10000 (<< (- u #xD800) 10) (- low #xDC00)))
                     (+= i 6))
                   (add-utf-8! b (cast u32 u)))
                 (begin
                   (set! k (escape-byte c))
                   (when (== k 0) (return (fail! r "invalid escape")))
                   (buffer-add-byte! b k)
                   (+= i 2)))]
            [(< c 32)
             (set! (-> r at) i)
             (return (fail! r "a control character in a string"))]
            [(< c 128)
             (buffer-add-byte! b c)
             (+= i 1)]
            [else
             (set! k (utf-8-length p i end))
             (when (== k 0)
               (set! (-> r at) i)
               (return (fail! r "invalid UTF-8 in a string")))
             (buffer-add! b (+ p i) k)
             (+= i k)]))
    (set! (-> r at) i)
    (fail! r "the text ends inside a string")))

(define (escape-byte [c u32]) -> u32
  (case c
    [(34 92 47) c]
    [(98) 8]
    [(102) 12]
    [(110) 10]
    [(114) 13]
    [(116) 9]
    [else 0]))

(define (hex4 [p (ptr u8)] [i u32] [end u32]) -> i32
  (let ([v 0] [d 0])
    (when (> (+ i 4) end) (return -1))
    (for ([j u32 0]) (< j 4) (+= j 1)
      (set! d (digit-value (@ p (+ i j)) 16))
      (when (< d 0) (return -1))
      (set! v (+ (* v 16) d)))
    v))

(define (add-utf-8! [b (ptr buffer)] [u u32])
  (cond [(< u #x80) (buffer-add-byte! b u)]
        [(< u #x800)
         (buffer-add-byte! b (bit-or #xC0 (>> u 6)))
         (buffer-add-byte! b (bit-or #x80 (bit-and u 63)))]
        [(< u #x10000)
         (buffer-add-byte! b (bit-or #xE0 (>> u 12)))
         (buffer-add-byte! b (bit-or #x80 (bit-and (>> u 6) 63)))
         (buffer-add-byte! b (bit-or #x80 (bit-and u 63)))]
        [else
         (buffer-add-byte! b (bit-or #xF0 (>> u 18)))
         (buffer-add-byte! b (bit-or #x80 (bit-and (>> u 12) 63)))
         (buffer-add-byte! b (bit-or #x80 (bit-and (>> u 6) 63)))
         (buffer-add-byte! b (bit-or #x80 (bit-and u 63)))]))

(define (digit? [c u32]) -> i32 (and (>= c #\0) (<= c #\9)))

;; number! reads -?(0|[1-9][0-9]*)(.[0-9]+)?([eE][+-]?[0-9]+)?, its value by the prelude's decimal-flonum.
(define (number! [r (ptr json-reader)]) -> i32
  (let ([p (-> r text)] [start (-> r at)] [i (-> r at)] [j (-> r at)] [end (-> r end)] [c u32 0]
        [small (array u8 64)] [ds (ptr u8) 0] [nd 0] [fraction 0] [e 0] [negative 0] [e-negative 0])
    (while (and (< j end) (or (digit? (@ p j)) (== (@ p j) #\.) (== (@ p j) #\e) (== (@ p j) #\E) (== (@ p j) #\+)
                              (== (@ p j) #\-)))
      (+= j 1))
    (set! ds (if (<= (- j start) 64)
                 small
                 (begin
                   (set! (-> r scratch length) 0)
                   (buffer-add! (& (-> r scratch)) (+ p start) (- j start))
                   (-> r scratch bytes))))
    (when (== (@ p i) #\-)
      (set! negative 1)
      (+= i 1))
    (cond [(and (< i j) (== (@ p i) #\0))
           (set! (@ ds 0) 0)
           (set! nd 1)
           (+= i 1)]
          [(and (< i j) (digit? (@ p i)))
           (while (and (< i j) (digit? (@ p i)))
             (set! (@ ds nd) (- (@ p i) #\0))
             (+= nd 1)
             (+= i 1))]
          [else (return (fail! r "invalid number"))])
    (when (and (< i j) (== (@ p i) #\.))
      (+= i 1)
      (unless (and (< i j) (digit? (@ p i))) (return (fail! r "invalid number")))
      (while (and (< i j) (digit? (@ p i)))
        (set! (@ ds nd) (- (@ p i) #\0))
        (+= nd 1)
        (+= fraction 1)
        (+= i 1)))
    (when (and (< i j) (or (== (@ p i) #\e) (== (@ p i) #\E)))
      (+= i 1)
      (when (and (< i j) (or (== (@ p i) #\+) (== (@ p i) #\-)))
        (set! e-negative (== (@ p i) #\-))
        (+= i 1))
      (unless (and (< i j) (digit? (@ p i))) (return (fail! r "invalid number")))
      (while (and (< i j) (digit? (@ p i)))
        (when (< e 100000) (set! e (+ (* e 10) (- (@ p i) #\0))))
        (+= i 1)))
    (unless (== i j) (return (fail! r "invalid number")))
    (set! (-> r number) (decimal-flonum ds nd (- (if e-negative (- e) e) fraction) negative))
    (set! (-> r bytes) (+ p start))
    (set! (-> r length) (- j start))
    (set! (-> r at) j)
    1))

;; ---- parsing ----

(define (arena-text [a (ptr arena)] [p (ptr u8)] [n u32]) -> (ptr u8)
  (let ([q (cast (ptr u8) (arena-alloc a (+ n 1)))])
    (memcpy q p n)
    (set! (@ q n) 0)
    q))

(define (json-parse [a (ptr arena)] [text (ptr u8)] [n u32] [err (ptr json-error)]) -> (ptr json-value)
  (let ([r json-reader] [values (make-buffer)] [members (make-buffer)] [starts (array u32 1000)]
        [root (ptr json-value) 0] [t u32 0] [v json-value (json-null)] [k u32 0] [m json-member] [placed 0])
    (json-reader-start! (& r) text n)
    (while 1
      (set! t (json-next! (& r)))
      (set! placed 1)
      (cond [(== t json-token-start-array)
             (set! (@ starts (- (-> r depth) 1)) (/ (-> values length) (sizeof json-value)))
             (set! placed 0)]
            [(== t json-token-start-object)
             (set! (@ starts (- (-> r depth) 1)) (/ (-> members length) (sizeof json-member)))
             (set! placed 0)]
            [(== t json-token-key)
             (set! (-> m key) (arena-text a (-> r bytes) (-> r length)))
             (set! (-> m key-length) (-> r length))
             (set! (-> m value) (json-null))
             (buffer-add! (& members) (cast (ptr u8) (& m)) (sizeof json-member))
             (set! placed 0)]
            [(== t json-token-string) (set! v (json-string (arena-text a (-> r bytes) (-> r length)) (-> r length)))]
            [(== t json-token-number)
             (set! v (json-number (-> r number) (arena-text a (-> r bytes) (-> r length)) (-> r length)))]
            [(== t json-token-true) (set! v (json-boolean 1))]
            [(== t json-token-false) (set! v (json-boolean 0))]
            [(== t json-token-null) (set! v (json-null))]
            [(== t json-token-end-array)
             (set! k (- (/ (-> values length) (sizeof json-value)) (@ starts (-> r depth))))
             (set! v (json-array (cast (ptr json-value) (block a (-> values bytes) (@ starts (-> r depth)) k (sizeof json-value)))
                                 k k))
             (set! (-> values length) (* (@ starts (-> r depth)) (sizeof json-value)))]
            [(== t json-token-end-object)
             (set! k (- (/ (-> members length) (sizeof json-member)) (@ starts (-> r depth))))
             (set! v (json-object (cast (ptr json-member) (block a (-> members bytes) (@ starts (-> r depth)) k
                                                               (sizeof json-member)))
                                  k k))
             (set! (-> members length) (* (@ starts (-> r depth)) (sizeof json-member)))]
            [(== t json-token-end) (break)]
            [else
             (when (!= err 0) (set! (@ err) (-> r error)))
             (set! root 0)
             (break)])
      (when placed
        (cond [(== (-> r depth) 0)
               (set! root (cast (ptr json-value) (arena-alloc a (sizeof json-value))))
               (set! (@ root) v)]
              [(== (@ (-> r kinds) (- (-> r depth) 1)) 1)
               (buffer-add! (& values) (cast (ptr u8) (& v)) (sizeof json-value))]
              [else
               (set! (-> (cast (ptr json-member) (+ (-> members bytes) (- (-> members length) (sizeof json-member)))) value)
                     v)])))
    (json-reader-free! (& r))
    (buffer-free! (& values))
    (buffer-free! (& members))
    root))

;; The k items of size bytes from index from of bytes, copied into a, or 0 for none.
(define (block [a (ptr arena)] [bytes (ptr u8)] [from u32] [k u32] [size u32]) -> (ptr void)
  (if (== k 0)
      0
      (memcpy (arena-alloc a (* k size)) (+ bytes (* from size)) (* k size))))

;; ---- writing ----

;; A newline and indent as many times as the deepest line written yet needs.
(struct padding [bytes buffer] [indent (ptr u8)] [width u32])

(define (json-write! [b (ptr buffer)] [v (ptr json-value)] [indent (ptr u8)])
  (if (or (== indent 0) (== (@ indent 0) 0))
      (write-value! b v 0 0)
      (let ([pad padding])
        (set! (-> pad bytes) (make-buffer))
        (buffer-add-byte! (& (-> pad bytes)) 10)
        (set! (-> pad indent) indent)
        (set! (-> pad width) (strlen indent))
        (write-value! b v (& pad) 0)
        (buffer-free! (& (-> pad bytes))))))

(define (write-value! [b (ptr buffer)] [v (ptr json-value)] [pad (ptr padding)] [depth u32])
  (match v
    [#f (buffer-add! b "null" 4)]
    [(json-null) (buffer-add! b "null" 4)]
    [(json-boolean x) (if x (buffer-add! b "true" 4) (buffer-add! b "false" 5))]
    [(json-number x text length) (if (!= text 0) (buffer-add! b text length) (write-number! b x))]
    [(json-string bytes length) (write-text! b bytes length)]
    [(json-array items count room)
     (if (== count 0)
         (buffer-add! b "[]" 2)
         (begin
           (buffer-add-byte! b #\[)
           (for ([i u32 0]) (< i count) (+= i 1)
             (when (> i 0) (buffer-add-byte! b #\,))
             (line! b pad (+ depth 1))
             (write-value! b (+ items i) pad (+ depth 1)))
           (line! b pad depth)
           (buffer-add-byte! b #\])))]
    [(json-object members count room)
     (if (== count 0)
         (buffer-add! b "{}" 2)
         (begin
           (buffer-add-byte! b #\{)
           (for ([i u32 0]) (< i count) (+= i 1)
             (let ([m (+ members i)])
               (when (> i 0) (buffer-add-byte! b #\,))
               (line! b pad (+ depth 1))
               (write-text! b (-> m key) (-> m key-length))
               (if (== pad 0) (buffer-add-byte! b #\:) (buffer-add! b ": " 2))
               (write-value! b (& (-> m value)) pad (+ depth 1))))
           (line! b pad depth)
           (buffer-add-byte! b #\})))]))

(define (line! [b (ptr buffer)] [pad (ptr padding)] [depth u32])
  (unless (== pad 0)
    (let ([need (+ 1 (* depth (-> pad width)))])
      (while (< (-> pad bytes length) need) (buffer-add! (& (-> pad bytes)) (-> pad indent) (-> pad width)))
      (buffer-add! b (-> pad bytes bytes) need))))

;; write-number! writes x as JavaScript's Number::toString does.
(define (write-number! [b (ptr buffer)] [x f64])
  (when (or (!= x x) (== x (/ 1.0 0.0)) (== x (/ -1.0 0.0)))
    (buffer-add! b "null" 4)
    (return))
  (when (== x 0.0)
    (buffer-add-byte! b #\0)
    (return))
  (let* ([ds (array u8 24)] [k (shortest-digits (fabs x) 0 ds)] [n (cast i32 (strlen ds))])
    (when (< x 0.0) (buffer-add-byte! b #\-))
    (cond [(and (<= n k) (<= k 21))
           (buffer-add! b ds (cast u32 n))
           (for ([i n]) (< i k) (+= i 1) (buffer-add-byte! b #\0))]
          [(and (> k 0) (<= k 21))
           (buffer-add! b ds (cast u32 k))
           (buffer-add-byte! b #\.)
           (buffer-add! b (+ ds k) (cast u32 (- n k)))]
          [(and (> k -6) (<= k 0))
           (buffer-add! b "0." 2)
           (for ([i k]) (< i 0) (+= i 1) (buffer-add-byte! b #\0))
           (buffer-add! b ds (cast u32 n))]
          [else
           (buffer-add-byte! b (@ ds 0))
           (when (> n 1)
             (buffer-add-byte! b #\.)
             (buffer-add! b (+ ds 1) (cast u32 (- n 1))))
           (buffer-add-byte! b #\e)
           (buffer-add-byte! b (if (>= k 1) #\+ #\-))
           (write-digits b (cast u64 (if (>= k 1) (- k 1) (- 1 k))) 10)])))

;; write-text! writes bytes as a JSON string, escaped as JSON.stringify escapes, and an invalid UTF-8 byte as �.
(define (write-text! [b (ptr buffer)] [p (ptr u8)] [n u32])
  (let ([i u32 0] [run u32 0] [c u32 0] [k u32 0])
    (buffer-add-byte! b #\")
    (while (< i n)
      (set! c (@ p i))
      (if (and (>= c 32) (< c 128) (!= c #\") (!= c #\\))
          (+= i 1)
          (begin
            (set! k (if (>= c 128) (utf-8-length p i n) 0))
            (if (!= k 0)
                (+= i k)
                (begin
                  (buffer-add! b (+ p run) (- i run))
                  (if (>= c 128) (buffer-add! b "\\ufffd" 6) (escape! b c))
                  (+= i 1)
                  (set! run i))))))
    (buffer-add! b (+ p run) (- i run))
    (buffer-add-byte! b #\")))

(define (escape! [b (ptr buffer)] [c u32])
  (buffer-add-byte! b #\\)
  (case c
    [(34 92) (buffer-add-byte! b c)]
    [(8) (buffer-add-byte! b #\b)]
    [(12) (buffer-add-byte! b #\f)]
    [(10) (buffer-add-byte! b #\n)]
    [(13) (buffer-add-byte! b #\r)]
    [(9) (buffer-add-byte! b #\t)]
    [else
     (buffer-add! b "u00" 3)
     (buffer-add-byte! b (+ 48 (>> c 4)))
     (buffer-add-byte! b (let ([d (bit-and c 15)]) (if (< d 10) (+ 48 d) (+ 87 d))))]))

;; ---- reading values ----

(define (json-get [v (ptr json-value)] [key (ptr u8)]) -> (ptr json-value) (member-value v key (strlen key)))

(define (member-value [v (ptr json-value)] [key (ptr u8)] [n u32]) -> (ptr json-value)
  (let ([i (member-index v key n)])
    (match v
      [(json-object members count room) (if (< i 0) 0 (& (-> (+ members i) value)))]
      [_ 0])))

;; The index of the last member of v with key, or -1.
(define (member-index [v (ptr json-value)] [key (ptr u8)] [n u32]) -> i32
  (match v
    [(json-object members count room)
     (let ([i (cast i32 count)] [m (ptr json-member) 0])
       (while (> i 0)
         (-= i 1)
         (set! m (+ members i))
         (when (and (== (-> m key-length) n) (== (memcmp (-> m key) key n) 0)) (return i)))
       -1)]
    [_ -1]))

(define (json-at [v (ptr json-value)] [i u32]) -> (ptr json-value)
  (match v
    [(json-array items count room) (if (< i count) (+ items i) 0)]
    [_ 0]))

(define (json-count [v (ptr json-value)]) -> u32
  (match v
    [(json-array items count room) count]
    [(json-object members count room) count]
    [_ 0]))

;; json-as-i64 reads a number written as an integer, exactly from its text, as serde_json's as_i64.
(define (json-as-i64 [v (ptr json-value)] [to (ptr i64)]) -> i32
  (match v
    [(json-number x text length)
     (let ([negative (and (> length 0) (== (@ text 0) #\-))] [n u64 0])
       (and (!= text 0) (digits? text (if negative 1 0) length 10)
            (digits-integer text (if negative 1 0) length 10 negative (& n))
            (begin
              (set! (@ to) (cast i64 n))
              1)))]
    [_ 0]))

(define (json-as-f64 [v (ptr json-value)] [to (ptr f64)]) -> i32
  (match v
    [(json-number x text length)
     (set! (@ to) x)
     1]
    [_ 0]))

(define (json-as-string [v (ptr json-value)] [n (ptr u32)]) -> (ptr u8)
  (match v
    [(json-string bytes length)
     (when (!= n 0) (set! (@ n) length))
     bytes]
    [_ 0]))

(define (json-as-bool [v (ptr json-value)] [to (ptr i32)]) -> i32
  (match v
    [(json-boolean x)
     (set! (@ to) x)
     1]
    [_ 0]))

;; ---- building and changing values ----

;; own! copies the bytes of the string or number at v into a.
(define (own! [a (ptr arena)] [v (ptr json-value)])
  (match v
    [(json-number x text length) (when (!= text 0) (set! text (arena-text a text length)))]
    [(json-string bytes length) (set! bytes (arena-text a bytes length))]
    [_ (begin)]))

(define (json-push! [a (ptr arena)] [array (ptr json-value)] [v json-value]) -> i32
  (json-insert! a array (json-count array) v))

(define (json-insert! [a (ptr arena)] [array (ptr json-value)] [i u32] [v json-value]) -> i32
  (match array
    [(json-array items count room)
     (when (> i count) (return 0))
     (when (== count room)
       (set! room (if (== room 0) 4 (* 2 room)))
       (let ([p (cast (ptr json-value) (arena-alloc a (* room (sizeof json-value))))])
         (when (> count 0) (memcpy p items (* count (sizeof json-value))))
         (set! items p)))
     (memcpy (+ items i 1) (+ items i) (* (- count i) (sizeof json-value)))
     (set! (@ (+ items i)) v)
     (own! a (+ items i))
     (+= count 1)
     1]
    [_ 0]))

(define (json-add! [a (ptr arena)] [object (ptr json-value)] [key (ptr u8)] [v json-value]) -> i32
  (match object
    [(json-object members count room)
     (when (== count room)
       (set! room (if (== room 0) 4 (* 2 room)))
       (let ([p (cast (ptr json-member) (arena-alloc a (* room (sizeof json-member))))])
         (when (> count 0) (memcpy p members (* count (sizeof json-member))))
         (set! members p)))
     (let ([m (+ members count)])
       (set! (-> m key-length) (strlen key))
       (set! (-> m key) (arena-text a key (-> m key-length)))
       (set! (-> m value) v)
       (own! a (& (-> m value))))
     (+= count 1)
     1]
    [_ 0]))

(define (json-replace! [a (ptr arena)] [object (ptr json-value)] [key (ptr u8)] [v json-value]) -> i32
  (let ([p (json-get object key)])
    (when (== p 0) (return 0))
    (set! (@ p) v)
    (own! a p)
    1))

(define (json-replace-at! [a (ptr arena)] [array (ptr json-value)] [i u32] [v json-value]) -> i32
  (let ([p (json-at array i)])
    (when (== p 0) (return 0))
    (set! (@ p) v)
    (own! a p)
    1))

(define (json-remove! [object (ptr json-value)] [key (ptr u8)]) -> i32
  (let ([i (member-index object key (strlen key))])
    (match object
      [(json-object members count room)
       (when (< i 0) (return 0))
       (memcpy (+ members i) (+ members i 1) (* (- count (cast u32 i) 1) (sizeof json-member)))
       (-= count 1)
       1]
      [_ 0])))

(define (json-remove-at! [array (ptr json-value)] [i u32]) -> i32
  (match array
    [(json-array items count room)
     (when (>= i count) (return 0))
     (memcpy (+ items i) (+ items i 1) (* (- count i 1) (sizeof json-value)))
     (-= count 1)
     1]
    [_ 0]))

(define (json-copy [a (ptr arena)] [v (ptr json-value)]) -> (ptr json-value)
  (let ([out (cast (ptr json-value) (arena-alloc a (sizeof json-value)))])
    (copy-into! a out v)
    out))

(define (copy-into! [a (ptr arena)] [out (ptr json-value)] [v (ptr json-value)])
  (if (== v 0) (set! (@ out) (json-null)) (set! (@ out) (@ v)))
  (match out
    [(json-array items count room)
     (let ([p (cast (ptr json-value) (arena-alloc a (* count (sizeof json-value))))])
       (for ([i u32 0]) (< i count) (+= i 1) (copy-into! a (+ p i) (+ items i)))
       (set! items (if (== count 0) 0 p))
       (set! room count))]
    [(json-object members count room)
     (let ([p (cast (ptr json-member) (arena-alloc a (* count (sizeof json-member))))])
       (for ([i u32 0]) (< i count) (+= i 1)
         (let ([m (+ members i)] [q (+ p i)])
           (set! (-> q key) (arena-text a (-> m key) (-> m key-length)))
           (set! (-> q key-length) (-> m key-length))
           (copy-into! a (& (-> q value)) (& (-> m value)))))
       (set! members (if (== count 0) 0 p))
       (set! room count))]
    [_ (own! a out)]))

(define (json-equal? [x (ptr json-value)] [y (ptr json-value)]) -> i32
  (match x
    [#f (== y 0)]
    [(json-null) (match y [(json-null) 1] [_ 0])]
    [(json-boolean p) (match y [(json-boolean q) (== p q)] [_ 0])]
    [(json-number p pt pl) (match y [(json-number q qt ql) (== p q)] [_ 0])]
    [(json-string pb pl) (match y [(json-string qb ql) (and (== pl ql) (== (memcmp pb qb pl) 0))] [_ 0])]
    [(json-array pi pc pr)
     (match y
       [(json-array qi qc qr)
        (unless (== pc qc) (return 0))
        (for ([i u32 0]) (< i pc) (+= i 1) (unless (json-equal? (+ pi i) (+ qi i)) (return 0)))
        1]
       [_ 0])]
    [(json-object pm pc pr)
     (match y
       [(json-object qm qc qr)
        (unless (== pc qc) (return 0))
        (for ([i u32 0]) (< i pc) (+= i 1)
          (let ([m (+ pm i)] [o (+ qm i)])
            (unless (json-equal? (& (-> m value))
                                 (if (and (== (-> m key-length) (-> o key-length)) (== (memcmp (-> m key) (-> o key) (-> m key-length)) 0))
                                     (& (-> o value))
                                     (member-value y (-> m key) (-> m key-length))))
              (return 0))))
        1]
       [_ 0])]))
