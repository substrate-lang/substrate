;; UTF-8 (RFC 3629). utf-8? rejects overlong forms, surrogates and values beyond U+10FFFF; utf-8-length is the length
;; of the sequence that starts with p's byte i, a byte of 128 or more, or 0 when there is none.
(provide utf-8? utf-8-length)

(define (utf-8? [p (ptr u8)] [n u32]) -> i32
  (let ([i u32 0] [k u32 0])
    (while (< i n)
      (if (< (@ p i) 128)
          (+= i 1)
          (begin
            (set! k (utf-8-length p i n))
            (when (== k 0) (return 0))
            (+= i k))))
    1))

(define (utf-8-length [p (ptr u8)] [i u32] [n u32]) -> u32
  (let ([b (cast u32 (@ p i))] [k u32 0] [lo u32 128] [hi u32 191])
    (cond [(< b 194) (return 0)]
          [(< b 224) (set! k 1)]
          [(< b 240) (set! k 2) (when (== b 224) (set! lo 160)) (when (== b 237) (set! hi 159))]
          [(< b 245) (set! k 3) (when (== b 240) (set! lo 144)) (when (== b 244) (set! hi 143))]
          [else (return 0)])
    (when (>= (+ i k) n) (return 0))
    (for ([j u32 1]) (<= j k) (+= j 1)
      (let ([c (cast u32 (@ p (+ i j)))])
        (when (or (< c lo) (> c hi)) (return 0))
        (set! lo 128)
        (set! hi 191)))
    (+ k 1)))
