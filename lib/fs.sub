;; The file system: the host module "fs", beside host.read_file, write_file and make_dir.
;; stat: the size, -1 if missing, -2 for a directory. open gives a stream; its modes: read 0, write 1, append 2.
(provide fs-stat fs-list fs-remove fs-rename fs-open fs-read-mode fs-write-mode fs-append-mode)

(import stat "fs" "stat" (i32 i32 -> i64))
(import list "fs" "list" (i32 i32 i32 i32 -> i32))
(import remove "fs" "remove" (i32 i32 -> i32))
(import rename "fs" "rename" (i32 i32 i32 i32 -> i32))
(import open "fs" "open" (i32 i32 i32 i32 -> i32))

(const fs-read-mode u32 0)
(const fs-write-mode u32 1)
(const fs-append-mode u32 2)

(define (fs-stat [path (ptr u8)]) -> i64 (stat (cast i32 path) (cast i32 (strlen path))))

(define (fs-list [path (ptr u8)]) -> (ptr u8)
  (let ([n (list (cast i32 path) (cast i32 (strlen path)) 0 0)])
    (if (< n 0)
        0
        (let ([p (cast (ptr u8) (malloc (+ (cast u32 n) 1)))])
          (list (cast i32 path) (cast i32 (strlen path)) (cast i32 p) n)
          (set! (@ p n) 0)
          p))))

(define (fs-remove [path (ptr u8)]) -> i32 (remove (cast i32 path) (cast i32 (strlen path))))

(define (fs-rename [from (ptr u8)] [to (ptr u8)]) -> i32
  (rename (cast i32 from) (cast i32 (strlen from)) (cast i32 to) (cast i32 (strlen to))))

(define (fs-open [path (ptr u8)] [mode u32] [tag (ptr void)]) -> u32
  (cast u32 (open (cast i32 path) (cast i32 (strlen path)) (cast i32 mode) (cast i32 tag))))
