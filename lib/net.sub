;; TCP: the host module "net", whose connections are streams.
;; Events: listening 1 (value: the port), accept 2 (value: the new connection's stream), connected 3,
;; failed 4 (value: the error code). Options are lines: tls, host NAME.
(provide net-source net-listening net-accept net-connected net-failed net-listen net-connect net-close)

(import listen "net" "listen" (i32 i32 i32 i32 -> i32))
(import connect "net" "connect" (i32 i32 i32 i32 i32 i32 -> i32))
(import close "net" "close" (i32 ->))

(const net-source u32 9)
(const net-listening u32 1)
(const net-accept u32 2)
(const net-connected u32 3)
(const net-failed u32 4)

(define (net-listen [port u32] [options (ptr u8)] [tag (ptr void)]) -> u32
  (cast u32 (listen (cast i32 port) (cast i32 options) (cast i32 (strlen options)) (cast i32 tag))))

(define (net-connect [host (ptr u8)] [port u32] [options (ptr u8)] [tag (ptr void)]) -> u32
  (cast u32 (connect (cast i32 host) (cast i32 (strlen host)) (cast i32 port) (cast i32 options) (cast i32 (strlen options))
                     (cast i32 tag))))

(define (net-close [id u32]) (close (cast i32 id)))
