;; lib/compress on each file, as zlib.c reports zlib: deflate at levels 1, 6 and 9 and inflate of level 6, the best of
;; N runs of each in ms, with the sizes; each level's output written to OUT as ours-NAME-LEVEL.deflate, and zlib's,
;; when zlib.c has written them there, inflated and compared with the file.
(require-unqualified fs "../../host/fs.sub")
(require-unqualified clock "../../host/modules/clock.sub")
(require-unqualified inflate "../../lib/compress/inflate.sub")
(require-unqualified deflate "../../lib/compress/deflate.sub")

(define d deflater)

(define (base-name [path string]) -> string
  (let ([i (-> path length)])
    (while (and (> i 0) (!= (@ path (- i 1)) 47)) (-= i 1))
    (slice path i)))

(define (output-name [b (ptr buffer)] [dir string] [who string] [name string] [level i32]) -> string
  (set! (-> b length) 0)
  (buffer-add-string! b dir)
  (buffer-add-byte! b 47)
  (buffer-add-string! b who)
  (buffer-add-byte! b 45)
  (buffer-add-string! b name)
  (buffer-add-byte! b 45)
  (write-digits b (cast u64 level) 10)
  (buffer-add-string! b ".deflate")
  (buffer-string b))

;; back tells whether packed inflates to data.
(define (back [packed (slice u8)] [data (slice u8)]) -> bool
  (let ([out (make-buffer)] [used u32 0])
    (let ([same (and (== (inflate! (& out) packed (-> data length) (& used)) 0) (== used (-> packed length))
                     (== (buffer-string (& out)) (cast string data)))])
      (buffer-free! (& out))
      same)))

(define (main)
  (let ([args (host-args)] [reps u64 0] [path (make-buffer)])
    (digits-integer (@ args 0) 10 #f (& reps))
    (for ([a u32 2]) (< a (-> args length)) (+= a 1)
      (let ([data (slice u8)] [packed (make-buffer)] [name (base-name (@ args a))])
        (fs-read-file (@ args a) (& data) 0)
        (printf "~a ~a" name (-> data length))
        (for ([k u32 0]) (< k 3) (+= k 1)
          (let ([level (case k [(0) 1] [(1) 6] [else 9])] [best f64 1e9] [t f64 0] [theirs (slice u8)])
            (deflater-init! (& d) level)
            (for ([r u64 0]) (< r reps) (+= r 1)
              (set! (-> packed length) 0)
              (deflater-reset! (& d))
              (set! t (clock-monotonic))
              (deflate! (& d) (& packed) data deflate-finish)
              (set! t (- (clock-monotonic) t))
              (when (< t best) (set! best t)))
            (deflater-free! (& d))
            (printf " d~a ~a ~a" level best (-> packed length))
            (fs-write-file (output-name (& path) (@ args 1) "ours" name level) (buffer-bytes (& packed)) 0)
            (when (== level 6)
              (let ([out (make-buffer)] [used u32 0] [same #f])
                (set! best 1e9)
                (for ([r u64 0]) (< r reps) (+= r 1)
                  (set! (-> out length) 0)
                  (set! t (clock-monotonic))
                  (inflate! (& out) (buffer-bytes (& packed)) (-> data length) (& used))
                  (set! t (- (clock-monotonic) t))
                  (when (< t best) (set! best t)))
                (set! same (== (buffer-string (& out)) (cast string data)))
                (printf " i6 ~a ~a" best (if same "same" "differs"))
                (buffer-free! (& out))))
            (when (>= (fs-read-file (output-name (& path) (@ args 1) "zlib" name level) (& theirs) 0) 0)
              (printf " x~a ~a" level (if (back theirs data) "ok" "bad"))
              (free (-> theirs items)))))
        (printf "\n")
        (buffer-free! (& packed))
        (free (-> data items))))
    (buffer-free! (& path))))
