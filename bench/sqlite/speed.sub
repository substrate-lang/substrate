;; speedtest1's script on packages/sqlite, SCRIPT DATABASE, as native.c runs it on SQLite: from each "-- begin test" line to
;; the next in one exec, printed as its time in ms and the line's test.
(require-unqualified fs host/fs)
(require-unqualified clock host/modules/clock)
(require-unqualified sqlite sqlite)

(define mark string "-- begin test ")

(define (marked? [text string] [i u32]) -> bool
  (and (<= (+ i (-> mark length)) (-> text length)) (== (slice text i (+ i (-> mark length))) mark)))

(define (next-test [text string] [i u32]) -> u32
  (let ([n (-> text length)])
    (while (< (+ i 1) n)
      (when (and (== (@ text i) 10) (marked? text (+ i 1))) (return (+ i 1)))
      (+= i 1))
    n))

(define (main)
  (let ([args (host-args)] [bytes (slice u8)] [why string] [db (ptr sqlite) 0] [failed #f])
    (when (< (fs-read-file (@ args 0) (& bytes) (& why)) 0)
      (printf "~a\n" why)
      (host-exit 1))
    (set! db (sqlite-open (@ args 1) (& why)))
    (when (== db 0)
      (printf "~a\n" why)
      (host-exit 1))
    (let ([text (cast string bytes)] [at u32 0] [next u32 0] [t f64 0.0] [line u32 0])
      (while (< at (-> text length))
        (set! next (next-test text at))
        (set! t (clock-monotonic))
        (when (< (sqlite-exec db (slice text at next) (& why)) 0)
          (set! failed #t)
          (set! line at)
          (while (and (< line next) (!= (@ text line) 10)) (+= line 1))
          (host-write 2 (cast (slice u8) (slice text at line)))
          (host-write 2 (cast (slice u8) ": "))
          (host-write 2 (cast (slice u8) why))
          (host-write 2 (cast (slice u8) "\n")))
        (set! t (- (clock-monotonic) t))
        (when (marked? text at)
          (set! line (+ at (-> mark length)))
          (while (and (< line next) (!= (@ text line) 10)) (+= line 1))
          (printf "~a ~a\n" t (slice text (+ at (-> mark length)) line)))
        (set! at next)))
    (sqlite-close db)
    (when failed (host-exit 1))))
