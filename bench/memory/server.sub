;; The server run.mjs measures: / answers a few bytes, /large a megabyte, /events and /ws open a stream and a WebSocket
;; that stay open, and /memory gives the heap's size. It compresses answers and prints its URL once it listens.
(require-unqualified events host/events)
(require-unqualified http std/http)
(require-unqualified server std/http/server)
(require-unqualified sse std/http/sse)
(require-unqualified ws std/http/websocket)

(define server http-server)
(define large (ptr u8) 0)

(define (handle [r (ptr http-request)])
  (let ([path (-> r target)])
    (cond [(== path "/") (http-answer-text! r 200 "ok")]
          [(== path "/large")
           (http-respond! r 200)
           (http-send! r (slice large 1048576))]
          [(== path "/events")
           (let ([s (cast (ptr sse-stream) (calloc 1 (sizeof sse-stream)))])
             (set! (-> s compress) #t)
             (when (sse-accept! s r) (sse-send! s "" "1" "open")))]
          [(== path "/ws") (ws-accept! (cast (ptr ws-connection) (calloc 1 (sizeof ws-connection))) r "")]
          [(== path "/memory")
           (let ([b (make-buffer)])
             (write-digits (& b) (cast u64 (cast u32 (sbrk 0))) 10)
             (http-answer-text! r 200 (buffer-string (& b)))
             (buffer-free! (& b)))]
          [else (http-answer-text! r 404 "not found")])))

(define (listening [s (ptr http-server)])
  (let ([line (make-buffer)])
    (buffer-add-string! (& line) "http://127.0.0.1:")
    (http-add-decimal! (& line) (cast i64 (-> s port)))
    (buffer-add-string! (& line) "/\n")
    (host-write 1 (buffer-bytes (& line)))
    (buffer-free! (& line))))

(define (main)
  (set! large (cast (ptr u8) (calloc 1048576 1)))
  (set! (-> server compress) 6)
  (set! (-> server listening) listening)
  (http-serve! (& server) 0 handle))
