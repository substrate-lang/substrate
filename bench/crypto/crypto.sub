;; lib/crypto on three phases, the best of N runs of each in ms, as mbedtls.c reports mbedTLS: SHA-256 over 16 MiB,
;; 100000 HMACs of 100 bytes, each with its key, and PBKDF2 at 600000 iterations; each with its result's first bytes.
(require-unqualified sha256 "../../lib/crypto/sha256.sub")
(require-unqualified hmac "../../lib/crypto/hmac.sub")
(require-unqualified clock "../../host/modules/clock.sub")

(define (check [b (ptr u8)])
  (let ([pair (array u8 2)])
    (for ([i u32 0]) (< i 4) (+= i 1)
      (set! (@ pair 0) (@ "0123456789abcdef" (>> (@ b i) 4)))
      (set! (@ pair 1) (@ "0123456789abcdef" (bit-and (@ b i) 15)))
      (host-write 1 (slice pair))))
  (printf "\n"))

(define (main)
  (let* ([given (@ (host-args) 0)] [count u64 0] [reps u64 0] [n u32 16777216]
         [data (cast (ptr u8) (malloc n))] [out (array u8 32)] [key (array u8 32)] [best f64 1e9] [t f64 0])
    (digits-integer given 10 #f (& count))
    (set! reps count)
    (for ([i u32 0]) (< i n) (+= i 1) (set! (@ data i) (cast u8 (% i 251))))
    (for ([i u32 0]) (< i 32) (+= i 1) (set! (@ key i) (cast u8 i)))
    (for ([r u64 0]) (< r reps) (+= r 1)
      (set! t (clock-monotonic))
      (sha256-of (slice data n) (slice out))
      (set! t (- (clock-monotonic) t))
      (when (< t best) (set! best t)))
    (printf "sha256 ~a " best)
    (check out)
    (set! best 1e9)
    (for ([r u64 0]) (< r reps) (+= r 1)
      (set! t (clock-monotonic))
      (for ([i u32 0]) (< i 100000) (+= i 1) (hmac-of (slice key) (slice (+ data i) 100) (slice out)))
      (set! t (- (clock-monotonic) t))
      (when (< t best) (set! best t)))
    (printf "hmac ~a " best)
    (check out)
    (set! best 1e9)
    (for ([r u64 0]) (< r reps) (+= r 1)
      (set! t (clock-monotonic))
      (pbkdf2! (cast (slice u8) "correct horse battery staple") (slice key 16) 600000 (slice out))
      (set! t (- (clock-monotonic) t))
      (when (< t best) (set! best t)))
    (printf "pbkdf2 ~a " best)
    (check out)))
