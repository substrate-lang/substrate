;; 50 binary trees of depth 16 made, counted and freed, in Bend.
(language bend std/languages/bend)

(type Tree Data [Leaf] [Node [left : Tree] [right : Tree]])

(def (make [+ d : Nat]) Tree
  (match d
    [Zero Leaf]
    [(Succ p) (Node (make p) (make p))]))

(def (check [t : Tree]) U32
  (match t
    [Leaf 1]
    [(Node l r) (U32.add 1 (U32.add (check l) (check r)))]))

(def (rounds [+ k : Nat] [+ d : Nat] [acc : U32]) U32
  (match k
    [Zero acc]
    [(Succ p) (rounds p d (U32.add acc (check (make d))))]))

(define (main) (print (rounds (nat 50) (nat 16) 0)))
