;; lib/encoding/json.sub on each file: the best of N runs of each phase in ms, as cjson.c reports cJSON. numbers is
;; writing with every number's text dropped, so that each is written from its f64.
(require-unqualified json "../../lib/encoding/json.sub")
(require-unqualified fs "../../host/fs.sub")
(require-unqualified clock "../../host/modules/clock.sub")

(define (sum [v (ptr json-value)]) -> f64
  (match v
    [(json-number x text) (+ 1.0 x)]
    [(json-string text) (+ 1.0 (cast f64 (-> text length)))]
    [(json-array items room)
     (let ([s 1.0])
       (for ([i u32 0]) (< i (-> items length)) (+= i 1) (+= s (sum (& (@ items i)))))
       s)]
    [(json-object members room)
     (let ([s 1.0])
       (for ([i u32 0]) (< i (-> members length)) (+= i 1) (+= s (sum (& (-> (@ members i) value)))))
       s)]
    [_ 1.0]))

(define (drop-texts! [v (ptr json-value)])
  (match v
    [(json-number x text) (set! text "")]
    [(json-array items room) (for ([i u32 0]) (< i (-> items length)) (+= i 1) (drop-texts! (& (@ items i))))]
    [(json-object members room)
     (for ([i u32 0]) (< i (-> members length)) (+= i 1) (drop-texts! (& (-> (@ members i) value))))]
    [_ (begin)]))

;; The best of reps runs of writing v, and the length written.
(define (write-best [v (ptr json-value)] [indent string] [reps i32] [length (ptr u32)]) -> f64
  (let ([best f64 1e9] [t f64 0] [b (make-buffer)])
    (for ([r 0]) (< r reps) (+= r 1)
      (set! b (make-buffer))
      (set! t (clock-monotonic))
      (json-write! (& b) v indent)
      (set! t (- (clock-monotonic) t))
      (when (< t best) (set! best t))
      (set! (@ length) (-> b length))
      (buffer-free! (& b)))
    best))

(define (main)
  (let* ([count u64 0] [reps 0] [i 1] [given (host-arg 0)] [path (host-arg i)])
    (digits-integer (-> given bytes) 0 (-> given length) 10 0 (& count))
    (set! reps (cast i32 count))
    (while (!= (-> path bytes) 0)
      (let* ([err string] [text (cast string (fs-read-file path (& err)))] [best f64 1e9] [t f64 0] [a (make-arena)]
             [v (ptr json-value) 0] [written u32 0] [indented u32 0] [numbers u32 0] [name path])
        (when (== (-> text bytes) 0)
          (printf "~a\n" err)
          (return))
        (for ([r 0]) (< r reps) (+= r 1)
          (set! a (make-arena))
          (set! t (clock-monotonic))
          (json-parse (& a) text 0)
          (arena-free (& a))
          (set! t (- (clock-monotonic) t))
          (when (< t best) (set! best t)))
        (set! a (make-arena))
        (set! v (json-parse (& a) text 0))
        (for ([j u32 0]) (< j (-> path length)) (+= j 1) (when (== (@ path j) #\/) (set! name (slice path (+ j 1)))))
        (printf "~a sum ~a parse ~a" name (sum v) best)
        (printf " write ~a ~a" (write-best v 0 reps (& written)) written)
        (printf " indented ~a ~a" (write-best v "  " reps (& indented)) indented)
        (drop-texts! v)
        (printf " numbers ~a ~a\n" (write-best v 0 reps (& numbers)) numbers)
        (arena-free (& a))
        (free (-> text bytes)))
      (+= i 1)
      (set! path (host-arg i)))))
