;; An array that grows, for i32 and for a struct: 10 million items pushed and summed.
(require-unqualified std/vector)

(struct point [x i32] [y i32])

(define-vector ints i32)
(define-vector points point)

(define (main)
  (let ([is ints] [ps points] [p point] [sum i64 0] [n 10000000])
    (for ([i 0]) (< i n) (+= i 1)
      (vector-push! (& is) i)
      (set! (-> p x) i)
      (set! (-> p y) (* 2 i))
      (vector-push! (& ps) p))
    (let ([count (vector-count (& is))])
      (for ([i u32 0]) (< i count) (+= i 1)
        (+= sum (@ (vector-at-unchecked (& is) i)))
        (+= sum (-> (vector-at-unchecked (& ps) i) y))))
    (printf "~a\n" sum)))
